+[{"id":32501,"word":"痴儿呆女","pinyin":"chī ér dāi nǚ","abbr":"cedn","explanation":"指天真无知的少男少女。","source":{"text":"巧拙岂关今夕事？奈痴儿呆女流传谬。","book":"宋·秦观《贺新郎》词"},"usage":"作主语、宾语；用于儿童"},{"id":32502,"word":"痴儿说梦","pinyin":"chī ér shuō mèng","abbr":"cesm","explanation":"痴：呆，傻。原指对傻子说梦话而傻子信以为真。比喻凭妄想说不可靠或根本办不到的话。","source":{"text":"莫向痴儿说梦，且作山人索价，颇怪鹤书迟。","book":"宋·辛弃疾《水调歌头》"},"example":{"text":"清·贪梦道人《彭公案》第35回：“你真是坐井观天，～，只知有己，不知有人。”"},"similar":["痴人说梦"],"usage":"作宾语、定语；用于讥讽人"},{"id":32503,"word":"痴呆懵懂","pinyin":"chī dāi měng dǒng","abbr":"cdmd","explanation":"懵懂：糊涂，不明事理。愚笨糊涂，资质低下。","source":{"text":"倒不如痴呆懵懂，甘守着陋巷的这箪瓢。","book":"元·无名氏《一枝花》"},"example":{"text":"他是一个～的家伙。"},"similar":["愚不可及"],"opposite":["聪明伶俐"],"usage":"作谓语、定语；指人愚笨"},{"id":32504,"word":"痴心女子负心汉","pinyin":"chī xīn nǚ zǐ fù xīn hàn","abbr":"cxnzfxh","explanation":"沉迷于爱情中的女子碰上无情无意的男子。","source":{"text":"自古人云：痴心女子负心汉，今日反其事了。","book":"元·王实甫《西厢记》第三本第四折"},"example":{"text":"～，谁也没办法让他们复合。"},"similar":["痴心妇人负心汉"],"usage":"作宾语、定语、分句；用于男女关系"},{"id":32505,"word":"痴心妄想","pinyin":"chī xīn wàng xiǎng","abbr":"cxwx","explanation":"痴心：沉迷于某人或某事的心思；妄想：荒诞的打算。一心想着不可能实现的事。也指愚蠢荒唐的想法。","source":{"text":"谁知那道也自痴心妄想，魂颠梦倒，分明是癞蛤蟆想着天鹅肉吃。","book":"明·罗贯中《平妖传》第五回"},"example":{"text":"大凡人不做指望，到也不在心上；一做指望，便～，时刻难过。","book":"明·冯梦龙《古今小说·蒋兴哥重会珍珠衫》"},"similar":["胡思乱想","痴人说梦","想入非非"],"opposite":["切中事理"],"usage":"作谓语、主语、宾语；指胡思乱想"},{"id":32506,"word":"痴心妇人负心汉","pinyin":"chī xīn fù rén fù xīn hàn","abbr":"cxfrfxh","explanation":"痴：入迷；负心：对爱情不忠。痴迷爱情的女子碰上无情无义的男人。","source":{"text":"痴心妇人负心汉，这等相思空好看。","book":"明·陆采《怀香记·引示池楼》"},"example":{"text":"他们这对～是没有好结果的。"},"similar":["痴心女子负心汉"],"usage":"作宾语、定语、分句；用于男女关系"},{"id":32507,"word":"痴思妄想","pinyin":"chī sī wàng xiǎng","abbr":"cswx","explanation":"妄：胡乱，虚妄；妄想：荒唐的想法。指一门心思想着无法实现的事情。","source":{"text":"我不免痴思妄想——假如有一天我能当面碰见，亲眼看见这些立功的勇敢的空军战士，那该是多么大的满足和兴奋呢！","book":"洪深《飞将军》"},"similar":["痴心妄想"],"usage":"作谓语、主语、宾语；指胡思乱想"},{"id":32508,"word":"痴男怨女","pinyin":"chī nán yuàn nǚ","abbr":"cnyn","explanation":"旧指爱恋极深但感情上得不到满足的男女。","source":{"text":"厚地高天，堪叹古今情不尽；痴男怨女，可怜风月债难酬。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"因数十年前，误办一宗公案，害许多～，都湮没在这恨水愁山，泉泪冤海。","book":"清·魏子安《花月痕》第四十三回"},"usage":"作宾语、定语；指专情的人"},{"id":32509,"word":"痴痴迷迷","pinyin":"chī chī mí mí","abbr":"ccmm","explanation":"入迷到呆傻的程度，有些执迷不悟。","source":{"text":"终日痴痴迷迷，愁眉泪眼。","book":"清·褚人获《隋唐演义》第20回"},"usage":"作定语、状语；用于处事"},{"id":32510,"word":"痴鼠拖姜","pinyin":"chī shǔ tuō jiāng","abbr":"cstj","explanation":"痴：无知；拖：拉。比喻人不聪明，还自找麻烦。","source":{"text":"按俗语说便叫作‘卖盆的自寻的’；掉句文便叫作‘痴鼠拖姜，春蚕自缚’！","book":"清·文康《儿女英雄传》第22回"},"usage":"作宾语、定语；用于比喻句"},{"id":32511,"word":"痼疾烟霞","pinyin":"gù jí yān xiá","abbr":"gjyx","explanation":"痼疾：久治不愈的病，比喻积久成习，不易改变的嗜好、习惯；烟霞：指山水。指爱好山水成癖。","source":{"text":"臣所谓泉石膏肓，烟霞痼疾，既逢圣代，幸得逍遥。","book":"《旧唐书·田游岩传》"},"example":{"text":"脱略世故累，～深。","book":"清·方薰《寒山访赵凡夫故居》"}},{"id":32512,"word":"痿不忘起","pinyin":"wěi bù wàng qǐ","abbr":"wbwq","explanation":"痿：肢体萎弱。肢体萎弱的人不忘起行。比喻意志坚强。","source":{"text":"仆之思归，如痿人不忘起，盲者不忘视也。","book":"西汉·司马迁《史记·韩信列传》"},"usage":"作谓语；指意志坚强"},{"id":32513,"word":"痿人念起","pinyin":"wěi rén niàn qǐ","abbr":"wrnq","explanation":"下肢瘫痪的人总想着能够站起来走路。比喻某种念头十分强烈而无法实现。","source":{"text":"望故国而未归，如痿人之念起。","book":"唐·刘禹锡《谢窦相公启》"}},{"id":32514,"word":"痿痿羸羸","pinyin":"wěi wěi léi léi","abbr":"wwll","explanation":"痿：肢体麻木；羸：瘦弱。形容身体瘦弱不堪。","source":{"text":"吾曰：‘和尚上世曾为甚么？’师曰：‘我痿痿羸羸，且恁么过时。’吾曰：‘凭何如此？’师曰：‘我不曾展他书卷。’","book":"宋·释普济《五灯会元》卷五"}},{"id":32515,"word":"瘅恶彰善","pinyin":"dàn è zhāng shàn","abbr":"dezs","explanation":"瘅：憎恨；彰：表扬。憎恨恶的，表扬善的。","source":{"text":"瘅恶彰善，夷凶靖难。","book":"隋·薛道衡《隋唐祖颂》"},"example":{"text":"我们要培养～的社会风尚。"},"similar":["彰善瘅恶"],"usage":"作谓语、定语；指人的情绪"},{"id":32516,"word":"瘈狗噬人","pinyin":"zhì gǒu shì rén","abbr":"cgsr","explanation":"瘈：疯狂；噬：咬。疯狗咬人。比喻疯狂的恶人。","source":{"text":"吴方无道，国无道，必弃疾于人。吴虽无道，犹足以患卫。往也！长木之毙，无不瘈也；国狗之瘈，无不噬也，而况大国乎！","book":"《左传·哀公十二年》"},"usage":"作宾语、定语；用于比喻句"},{"id":32517,"word":"瘏口哓音","pinyin":"tú kǒu xiāo yīn","abbr":"tkxy","explanation":"犹言舌敝唇焦。形容说话之多，费尽口舌。","source":{"text":"语出《诗经·豳风·鸱枭》“予口卒瘏”、“予维音哓哓”二语。"}},{"id":32518,"word":"瘗玉埋香","pinyin":"yì yù mái xiāng","abbr":"yymx","explanation":"瘗：埋藏；玉、香：泛指美貌的女子。指美丽的女子死亡。","source":{"text":"加减乐事浮云改，瘗玉埋者今几载？","book":"明·高启《听教坊旧妓郭芳卿弟子陈氏歌》"},"similar":["埋香瘗玉"],"usage":"作谓语；指美丽女子的死亡"},{"id":32519,"word":"瘠义肥辞","pinyin":"jí yì féi cí","abbr":"jyfc","explanation":"内容贫乏而辞句堆砌冗长。","source":{"text":"捶子坚而难移，结响凝而不滞，此风骨之力也。若瘠义肥辞，繁杂失统，则无骨之征也。","book":"南朝·梁·刘勰《文心雕龙·风骨》"},"example":{"text":"范文澜《中国通史》第二编第五章第三节：“但冗长堆砌，意少语多（所谓‘～’），也是这一派的通病。”"},"usage":"作谓语、定语；用于文章等"},{"id":32520,"word":"瘠人肥己","pinyin":"jí rén féi jǐ","abbr":"jrfj","explanation":"瘠：瘦，引申为悭吝；肥：胖，引申为贪婪。对待别人很吝啬，而自己却很贪婪。","source":{"text":"众生多犯悭贪谋夺强占，瘠人肥己，毫厘不舍，共若干起。","book":"明·屠隆《昙花记·冥司断案》"},"similar":["损人利己"],"opposite":["大公无私"],"usage":"作谓语、宾语、定语；指损人利己"},{"id":32521,"word":"瘠己肥人","pinyin":"jí jǐ féi rén","abbr":"jjfr","explanation":"瘠：瘦，引申为约束；肥：胖，引申为宽大。严以律己宽以待人。","source":{"text":"僚属争言用度将不足，善俊曰：‘吾将瘠己肥人。’","book":"《宋史·赵善俊传》"},"similar":["严以律己，宽以待人"],"opposite":["损人利己"],"usage":"作谓语、定语；指严以律己宽以待人"},{"id":32522,"word":"瘠牛偾豚","pinyin":"jí niú fèn tún","abbr":"jnft","explanation":"瘠：瘦弱；偾：扑倒，压垮；豚：猪。再瘦的牛也能把猪压垮。比喻以强欺弱。","source":{"text":"牛虽瘠，偾于豚上，其畏不死？","book":"《左传·昭公十三年》"},"example":{"text":"他们都明白～的道理，所以不能得罪秦国"},"usage":"作宾语、定语；用于比喻句"},{"id":32523,"word":"瘠牛羸豚","pinyin":"jí niú léi tún","abbr":"jnlt","explanation":"瘠：瘠瘦；羸：病弱的。瘦弱的牛和猪。比喻弱小的民族或国家。","source":{"text":"杜兰斯哇人，撒逊人等，亦随其所敌视之马哥耶族，同成灰烬。瘠牛羸豚，坐待割。","book":"清·梁启超《匈加利爱国者噶苏士传》"},"usage":"作宾语；指弱小的民族或国家"},{"id":32524,"word":"瘦童羸马","pinyin":"shòu tóng léi mǎ","abbr":"stlm","explanation":"羸：瘦弱。体弱的儿童，瘦弱的马匹。比喻力量单薄。","source":{"text":"诗词寒苦，每有瘦童羸马之叹。","book":"《南齐书·伍乔传》"},"usage":"作宾语、定语；多用于比喻句"},{"id":32525,"word":"瘦羊博士","pinyin":"shòu yáng bó shì","abbr":"sybs","explanation":"指能克己让人的人。","source":{"text":"建武中每腊，诏书赐博士一羊。羊有大小肥瘦。时博士祭酒议，欲杀羊分肉，……宇因先自取其最瘦者，由是不复有争讼。","book":"《后汉书甄宇传》：“建武中，[甄宇]为州从事，征拜博士。”李贤注引《东观汉记》"},"example":{"text":"多少长安苦吟客，～擅风流。","book":"清王士禛《渔洋诗话》卷上"},"usage":"作宾语、定语；用于书面语","story":["汉朝建武年间，甄宇担任州从事，后来被拜为博士。皇帝每年腊月，下诏赐博士一只羊，羊有大小肥瘦，当时博士们为了分羊争议不休，建议杀羊分肉，将羊挂钩备杀。甄宇觉得可耻，就自取一只最瘦的，别的博士就不再争执了，给甄宇取名“瘦羊博士”"]},{"id":32526,"word":"瘦骨伶仃","pinyin":"shòu gǔ líng dīng","abbr":"sgld","explanation":"形容人或动物瘦得皮包骨的样子。亦作“瘦骨零丁”。","source":{"text":"这牢房比较大点、亮点，里面关着一个瘦骨伶仃的老头儿。","book":"高云览《小城春秋》第二六章"},"example":{"text":"尤其是那些和善得很的，又加上～；吹口气就会跌倒似的，那简直干不了。","book":"叶圣陶《夜》"},"similar":["瘦骨零丁"],"opposite":["膘肥体壮"],"usage":"作谓语、状语、定语；指瘦弱孤单"},{"id":32527,"word":"瘦骨如柴","pinyin":"shòu gǔ rú chái","abbr":"sgrc","explanation":"形容消瘦到极点。","source":{"text":"瘦如豺。豺，柴也。豺体瘦，故谓之豺。","book":"宋·陆佃《埤雅·释兽》"},"example":{"text":"我千辛万苦，有甚疑猜。可不道我脸儿黄～。","book":"明·高则诚《琵琶记·勉食姑嫜》"}},{"id":32528,"word":"瘦骨嶙峋","pinyin":"shòu gǔ lín xún","abbr":"sglx","explanation":"形容人或动物消瘦露骨。","source":{"text":"秀苇看见一个光着上身、瘦骨嶙峋的童工，提着一簸箕的泥灰，在一条悬空吊着的跳板上，吃力的走着。","book":"高云览《小城春秋》第十八章"},"example":{"text":"这次，这只～的黑狗的干嗥竟然使形神枯槁的老马也竖了一下耳朵。","book":"王蒙《杂色》"},"similar":["瘦骨嶙嶙","瘦骨棱棱"],"opposite":["膘肥体壮"],"usage":"作谓语、定语；指十分消瘦"},{"id":32529,"word":"瘦骨嶙嶙","pinyin":"shòu gǔ lín lín","abbr":"sgll","explanation":"形容人或动物消瘦露骨。","source":{"text":"两只瘦骨嶙嶙的长手，亲昵昵地抚摸着站在她身前寸步不离娘的宝娃的头。","book":"柳青《创业史》第一部题叙"},"example":{"text":"我们可怜的、小小的沈阿四，仅仅为了三个铜子，就脱掉了破褂子，露出～的肋腓骨，‘扑通’一声，跳进黄浦江。","book":"胡万春《生长在黄浦江边的人》"},"similar":["瘦骨嶙峋","瘦骨棱棱"],"usage":"作谓语、定语；指十分消瘦"},{"id":32530,"word":"瘦骨梭棱","pinyin":"shòu gǔ léng léng","abbr":"sgsl","explanation":"形容人或动物消瘦露骨。","source":{"text":"他屋里的，瘦骨梭梭的，一天愁到黑，愁米、愁柴又愁盐。","book":"周立波《暴风骤雨》第一部九"},"example":{"text":"木木姐惊慌地赶进门去，正好撞见那个白面鬼耸着～的肩膀，气虎虎地跨着大步跑出来。","book":"王西彦《古城的忧郁》"}},{"id":32531,"word":"瘦骨棱棱","pinyin":"shòu gǔ léng léng","abbr":"sgll","explanation":"瘦得连骨头都露出来，形容十分消瘦。","source":{"text":"他屋里的，瘦骨棱棱的，一天愁到黑，愁米，愁柴又愁盐。","book":"周立波《暴风骤雨》第一部"},"similar":["瘦骨嶙峋","瘦骨嶙嶙"],"usage":"作谓语、定语；指十分消瘦"},{"id":32532,"word":"瘦骨穷骸","pinyin":"shòu gǔ qióng hái","abbr":"sgqh","explanation":"骸：骨头。形容衰老瘦弱的身体。","source":{"text":"马嵬坡血污了天姿国色，江南路哭杀了瘦骨穷骸。","book":"清·洪昇《长生殿·弹词》"},"usage":"作宾语、定语；用于书面语"},{"id":32533,"word":"瘦骨零丁","pinyin":"shòu gǔ líng dīng","abbr":"sgld","explanation":"形容人瘦弱孤单的样子。","source":{"text":"牧人看见奶牛瘦骨零丁的样子，很生气。","book":"《中国民间故事选·老爷和奴才》"},"similar":["瘦骨伶仃"],"opposite":["膘肥体壮"],"usage":"作谓语、状语、定语；指瘦弱孤单"},{"id":32534,"word":"瘴乡恶土","pinyin":"zhàng xiāng è tǔ","abbr":"zxet","explanation":"瘴：瘴气。指瘴气、瘴疠流行的贫瘠和落后的地方。","source":{"text":"有知己者荐为端州巡官，念瘴乡恶土，实不愿行。","book":"元·无名氏《猿听经》第三折"},"similar":["穷山恶水"],"usage":"作宾语、定语；用于书面语"},{"id":32535,"word":"瘴雨蛮云","pinyin":"zhàng yǔ mán yún","abbr":"zymy","explanation":"指南方有瘴气的烟雨。也泛指十分荒凉的地方。","source":{"text":"瘴雨蛮烟朝暮景，平芜野草古今愁。","book":"唐·殷尧藩《九日》"},"example":{"text":"使君不用勤留客，～我欲愁。（宋·陆游《涪州》诗）"},"usage":"作宾语、定语；用于书面语"},{"id":32536,"word":"瘴雨蛮烟","pinyin":"zhàng yǔ mán yān","abbr":"zymy","explanation":"指南方有瘴气的烟雨。也泛指十分荒凉的地方。","source":{"text":"瘴雨蛮烟，十年梦，尊前休说。","book":"宋·辛弃疾《满江红·送汤朝美自便归》词"},"example":{"text":"殒于～之地。","book":"清·王韬《宜索归澳门议》"},"similar":["瘴雨蛮云"],"usage":"作宾语、定语；泛指十分荒凉的地方"},{"id":32537,"word":"癞狗扶不上墙","pinyin":"lài gǒu fú bù shàng qiáng","abbr":"lgfbsq","explanation":"比喻没出息的人，没办法扶助他长进。","source":{"text":"怨不得俗语说：‘癞狗扶不上墙’的！","book":"清·曹雪芹《红楼梦》第68回"},"usage":"作宾语、定语、分句；用于叹息等"},{"id":32538,"word":"癞虾蟆想吃天鹅肉","pinyin":"lài xiā má xiǎng chī tiān é ròu","abbr":"lhmxcter","explanation":"比喻人没有自知之明，一心想得到不能到手的东西。痴心妄想。","source":{"text":"平儿说道：‘癞虾蟆想吃天鹅肉，没人伦的混帐东西，起这样念头，叫他不得好死。’","book":"清·曹雪芹《红楼梦》第11回"},"similar":["癞蛤蟆想吃天鹅肉"],"usage":"作宾语、定语；指痴心妄想"},{"id":32539,"word":"癞蛤蟆想吃天鹅肉","pinyin":"lài há ma xiǎng chī tiān é ròu","abbr":"lhmxcter","explanation":"比喻人没有自知之明，一心想谋取不可能到手的东西。","source":{"text":"平儿说道：‘癞蛤蟆想吃天鹅肉’，没人伦的混账东西，起这样念头，叫他不得好死！","book":"清·曹雪芹《红楼梦》第十一回"},"example":{"text":"小弟撺空离地不过五六丈，此树高不可攀，何能摘他？这是‘～’了。","book":"清·李汝珍《镜花缘》第九回"},"similar":["不自量力","痴心妄想"],"opposite":["量力而行"],"usage":"作宾语、定语；指痴心妄想"},{"id":32540,"word":"癣疥之疾","pinyin":"xuǎn jiè zhī jí","abbr":"xjzj","explanation":"癣疥：两种皮肤病。比喻无关紧要的小问题和小毛病。","source":{"text":"夫齐之于吴也，疥癣之病也。","book":"《吕氏春秋·直谏》"},"example":{"text":"东伯侯姜文焕、南伯侯鄂顺、北伯侯崇黑虎，此三路不过～。","book":"明·许仲琳《封神演义》第六十六回"},"similar":["纤介之疾","疥癣之疾","疥癞之患"],"opposite":["心腹之患"],"usage":"作宾语；用于书面语"},{"id":32541,"word":"癫头癫脑","pinyin":"diān tóu diān nǎo","abbr":"dtdn","explanation":"疯疯癫癫，精神不正常。","source":{"text":"你在这里癫头癫脑的，看你这样子，就猜得到你干了什么事回来。","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"她生了一个～的丫头。"},"similar":["疯疯癫癫"],"usage":"作谓语、定语；指人不清醒"},{"id":32542,"word":"登台拜将","pinyin":"dēng tái bài jiàng","abbr":"dtbj","explanation":"指任命将帅或委以重任。同“登坛拜将”。","source":{"text":"这沥泉原是神物，令郎定有登台拜将之荣。","book":"清·钱彩《说岳全传》第四回"},"example":{"text":"依照古礼，举行～，授旗授印。","book":"诸义平《第29标首义纪实》"},"similar":["登坛拜将"],"usage":"作谓语、定语；指任命官员"},{"id":32543,"word":"登坛拜将","pinyin":"dēng tán bài jiàng","abbr":"dtbj","explanation":"比喻指任命将帅以及其他主持工作的首脑人物。","source":{"text":"何曰：‘王素慢无礼，今拜大将如呼小儿耳，此乃信所以去也。王必欲拜之，择良日，斋戒，没坛场，具礼乃耳。’王许之。","book":"《史记·淮阴侯列传》"},"example":{"text":"这沥泉原是神物，令郎定有登台拜将之荣。","book":"清·钱彩《说岳全传》第四回"},"similar":["登台拜将"],"usage":"作谓语、定语；指任命将帅"},{"id":32544,"word":"登堂入室","pinyin":"dēng táng rù shì","abbr":"dtrs","explanation":"堂、室：古代宫室，前面是堂，后面是室。登上厅堂，进入内室。比喻学问或技能从浅到深，达到很高的水平。","source":{"text":"如徐师川、余荀龙、洪玉父昆弟、欧阳元老，皆黄门登堂入室者，实自足以名家。","book":"宋·吴坰《五总志》"},"example":{"text":"听其翻阅，则书非书也，不怒不威而引人～之明师也。","book":"清·李渔《闲情偶寄·声容·习技》"},"similar":["登峰造极","当行出色","炉火纯青"],"opposite":["浅尝辄止","一窍不通","一无所知"],"usage":"作谓语、宾语、定语；用于称颂人","story":["春秋时期，孔子的弟子子路为人直率，喜欢弹瑟，不爱读书，孔子开导他，他决定认真读书与弹瑟。他弹瑟的声音充满杀气，孔子给予纠正并表扬他：“子路弹瑟的本领已经登上厅堂，但尚未进入内室，已经有一定成就，但没到最高境界。”"]},{"id":32545,"word":"登山临水","pinyin":"dēng shān lín shuǐ","abbr":"dsls","explanation":"形容旅途遥远。也指游山玩水。","source":{"text":"憭慓兮若在远行，登山临水兮送将归。","book":"战国·楚·宋玉《九辩》"},"example":{"text":"每～，惹起平生心事。","book":"宋·柳永《曲玉管》词"},"similar":["游山玩水","临水登山"],"usage":"作谓语、宾语；指游山玩水"},{"id":32546,"word":"登山小鲁","pinyin":"dēng shān xiǎo lǔ","abbr":"dsxl","explanation":"比喻学问既高便能融会贯通，眼光远大。","source":{"text":"孔子登东山而小鲁，登泰山而小天下。","book":"《孟子·尽心上》"},"example":{"text":"三皇内文，九鼎丹法，莫不究其条贯，犹登山而小鲁；践其户庭，若披云而见日。","book":"唐·岑文本《京师至德观法主孟法师碑铭序》"},"usage":"作谓语；指登高望远"},{"id":32547,"word":"登山涉水","pinyin":"dēng shān shè shuǐ","abbr":"dsss","explanation":"爬山过水。比喻历尽艰难。","source":{"text":"［宋江兄弟］两个商量了，径望沧州路上来。途中免不得登山涉水，过府冲州。","book":"明·施耐庵《水浒传》第二十二回"},"example":{"text":"我因归正释门，秉诚僧教，这一向～，把我那幼时的朋友也都疏失，未及拜访，少识尊颜。","book":"明·吴承恩《西游记》第五十三回"},"similar":["爬山涉水"],"usage":"作谓语、宾语；用于翻山过海走长路"},{"id":32548,"word":"登山蓦岭","pinyin":"dēng shān mò lǐng","abbr":"dsml","explanation":"蓦：超越。形容长途跋涉，路途辛苦。","source":{"text":"今日亲将头领差，登山蓦岭践尘埃。","book":"明·无名氏《大劫牢》第三折"},"similar":["登山踄岭"],"usage":"作谓语、定语、宾语；形容长途跋涉的辛苦"},{"id":32549,"word":"登山越岭","pinyin":"dēng shān yuè lǐng","abbr":"dsyl","explanation":"形容长途跋涉，旅途艰辛。","source":{"text":"幸亏他登山越岭，跋涉崎岖，去时骑坐，来时驮经，亦甚赖其力也。","book":"明·吴承恩《西游记》第一百回"},"example":{"text":"明·无名氏《杨家将演义》第三卷：“又要多张旗帜，使敌人不敢～。”"},"similar":["翻山越岭","登山踄岭","登山蓦岭"],"usage":"作谓语、宾语；形容长途跋涉"},{"id":32550,"word":"登山踄岭","pinyin":"dēng shān bù lǐng","abbr":"dsbl","explanation":"踄：同“步”，蹈，走。形容长途跋涉，路途辛苦。","source":{"text":"我那顽徒，俱是山野庸才，只会挑包背马，转涧寻波，带领贫僧登山踄岭。","book":"明·吴承恩《西游记》第68回"},"similar":["长途跋涉","翻山越岭","登山越岭"],"usage":"作谓语、定语、宾语；形容长途跋涉的辛苦"},{"id":32551,"word":"登山逾岭","pinyin":"dēng shān yú lǐng","abbr":"dsyl","explanation":"形容长途跋涉，旅途艰辛","source":{"text":"且说陈友定从厕中跳墙而逃，恐大路上或有军马追赶，也向东南角上登山逾岭，径寻鹤鸣山一路行走。","book":"明·郭勋《英烈传》第42回"},"similar":["登山越岭","登山跋岭"],"usage":"作谓语、宾语；形容长途跋涉"},{"id":32552,"word":"登山陟岭","pinyin":"dēng shān zhì lǐng","abbr":"dszl","explanation":"陟：蹈、踏。即翻山越岭。形容旅途艰辛劳累。"},{"id":32553,"word":"登峰造极","pinyin":"dēng fēng zào jí","abbr":"dfzj","explanation":"登：上；峰：山顶；造：到达；极：最高点。比喻学问、技能等达到最高的境界或成就。","source":{"text":"不知便可登峰造极不？然陶练之功，尚不可诬。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"到了清末，梁启超先生的“新文体”可算～。","book":"朱自清《经典常谈·文第十三》"},"similar":["叹为观止","空前绝后","超群绝伦"],"opposite":["屡见不鲜","平淡无奇"],"usage":"作谓语、宾语、定语；比喻到达极高的境地"},{"id":32554,"word":"登崇俊良","pinyin":"dēng chóng jùn liáng","abbr":"dcjl","explanation":"登：举荐，推举；崇：尊崇，尊重；俊良：才智优秀的人。推举尊重有才识的人。","source":{"text":"拔去凶邪，登崇俊良。","book":"唐·韩愈《进学解》"}},{"id":32555,"word":"登庸纳揆","pinyin":"dēng yōng nà kuī","abbr":"dynk","explanation":"登庸：皇帝登基；纳揆：任命宰相。皇帝登基，任命宰相。比喻政权刚刚建立。","source":{"text":"登庸纳揆之时，草昧经纶之日。","book":"《隋书·高祖纪》"}},{"id":32556,"word":"登手登脚","pinyin":"dēng shǒu dēng jiǎo","abbr":"dsdj","explanation":"用力地伸缩蹬动手脚。","source":{"text":"孩子便躺在席上登手登脚的怪哭，并不知金莲在那里。","book":"明·兰陵笑笑生《金瓶梅词话》第五十二回"}},{"id":32557,"word":"登明选公","pinyin":"dēng míng xuǎn gōng","abbr":"dmxg","explanation":"登：升，推举；明：明察；选：选拔；公：公正。选拔和推荐明察而公正的人才。","source":{"text":"登明先公，杂进巧拙。","book":"唐·韩愈《进学解》"}},{"id":32558,"word":"登木求鱼","pinyin":"déng mù qiú yú","abbr":"dmqy","explanation":"登：攀；木：树。爬到树上找鱼。比喻方向、方法不对，无法达到目的。","source":{"text":"登木求鱼知我掘，循巢觅兔笑君疏。","book":"宋·苏辙《次韵吴厚秀才见录》"},"similar":["缘木求鱼"],"usage":"作谓语、宾语、定语；指方法不对头"},{"id":32559,"word":"登界游方","pinyin":"dēng jiè yóu fāng","abbr":"djyf","explanation":"登上天界，游历四方。指周游世界。","source":{"text":"猴王叩头道：‘弟子飘洋过海，登界游方，有十数个年头，方才访到此处。’","book":"明·吴承恩《西游记》第一回"},"usage":"作谓语、宾语；指周游世界"},{"id":32560,"word":"登车揽辔","pinyin":"dēng chē lǎn pèi","abbr":"dclp","explanation":"揽辔：掌握马缰绳。指巡行各地监察吏治。","source":{"text":"陈仲举言为士则，行为世范，登车揽辔，有澄清天下之志。","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"滂～，有志澄清，行入州郡，墨吏不待举劾，便已辞去。","book":"蔡东藩《后汉演义》第五十回"}},{"id":32561,"word":"登锋履刃","pinyin":"dēng fēng lǚ rèn","abbr":"dflr","explanation":"踩踏刀剑的锋刃。比喻冲锋陷阵在最前头。","source":{"text":"又臣所上将校，率皆清英宿德，令名显达，登锋履刃，死者过半。","book":"《后汉书·袁绍传》"},"usage":"作谓语；指人勇敢"},{"id":32562,"word":"登锋陷阵","pinyin":"dēng fēng xiàn zhèn","abbr":"dfxz","explanation":"冲锋陷阵。形容作战英勇。","source":{"text":"帝以试左右，数十人常为先，登锋陷阵，皆终身不伤也。","book":"晋·葛洪《抱朴子·杂应》"},"similar":["冲锋陷阵"],"usage":"作谓语、宾语、定语；形容作战勇敢"},{"id":32563,"word":"登高一呼","pinyin":"dēng gāo yī hū","abbr":"dgyh","explanation":"比喻有影响的人物发出倡议。","source":{"text":"登高而招，臂非加长也，而见者远。","book":"《荀子·劝学》"},"example":{"text":"一省之内，惟彼独尊，自然是～，众山响应。","book":"清·李宝嘉《官场现形记》第五回"},"similar":["振臂一呼"],"usage":"作谓语、宾语；比喻有影响的人物发出倡议"},{"id":32564,"word":"登高去梯","pinyin":"dēng gāo qù tī","abbr":"dgqt","explanation":"攀登到高处后把梯子拿掉。表示已无退路。","source":{"text":"帅与之期，如登高而去其梯。","book":"《孙子·九地》"},"example":{"text":"盖如～，与之生死，投醪均味，忘其饥渴。","book":"唐·李翰《苏州嘉兴屯田纪绩颂序》"},"usage":"作宾语、定语；用于境遇"},{"id":32565,"word":"登高履危","pinyin":"dēng gāo lǚ wēi","abbr":"dglw","explanation":"比喻诚惶诚恐。","source":{"text":"登高临下，无失所秉，履危行险，无忘玄伏，能存之此，其德不亏。","book":"《淮南子·原道训》"},"example":{"text":"汉庭卿士如云屯，结绶弹冠朝至尊。～足在外，神色不变惟伯昏。","book":"宋·秦观《雪浪石》诗"},"similar":["诚惶诚恐"],"usage":"作宾语、定语；用于人生"},{"id":32566,"word":"登高必自卑，行远必自迩","pinyin":"dēng gāo bì zì bēi，xíng yuǎn bì zì ěr","abbr":"dgbzbxybze","explanation":"卑：低；迩：近。登高山须从低处开始，走远路要从近处开始。比喻做事要扎扎实实，循序渐进。","source":{"text":"君子之道，辟如行远必自迩，辟如登高必自卑。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"这也是‘～’的意思。","book":"苏雪林《玉溪诗迷·引论》"},"similar":["陟遐自迩"],"usage":"作宾语、定语、分句；用于书面语"},{"id":32567,"word":"登高必赋","pinyin":"dēng gāo bì fù","abbr":"dgbf","explanation":"古代指大夫必须具备的九种才能之一。指登高见广，能赋诗述其感受。","source":{"text":"孔子曰：‘君子登高必赋，小子愿者何？’","book":"西汉·韩婴《韩诗外传》第七卷"},"example":{"text":"御军三十余年，手不舍书，昼则讲武策，夜则思经传，～。","book":"晋·王沈《魏书》"},"similar":["登高能赋"],"usage":"作谓语、定语；指作文"},{"id":32568,"word":"登高望远","pinyin":"dēng gāo wàng yuǎn","abbr":"dgwy","explanation":"登上高处，看得更远。也比喻思想境界高，目光远大。","source":{"text":"我尝跂高而望矣，不如登高之博见也。","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"～，人人怀故国之悲；抚景伤情，处处洒穷途之泣。","book":"元·郑光祖《王粲登楼》"},"usage":"作谓语、定语；指人的思想"},{"id":32569,"word":"登高而招","pinyin":"dēng gāo ér zhāo","abbr":"dgez","explanation":"登高：登上高处；招：挥手招呼人。登到高处招呼人，看到的远。比喻声望高的人发出号召，响应的人必然会多。","source":{"text":"登高而招，臂非加长也，而见者远；顺风而呼，声非加疾也，而闻者彰。","book":"《荀子·勤学》"}},{"id":32570,"word":"登高能赋","pinyin":"dēng gāo néng fù","abbr":"dgnf","explanation":"赋：写作。登得高，看得远，能够描绘形状，铺陈事势。指国家的有用人才。","source":{"text":"不歌而诵谓之赋，登高能赋可以为大夫。","book":"东汉·班固《汉书·艺文志》"},"example":{"text":"古者～，山川能祭，师旅能誓。","book":"《隋书·经籍志》"},"similar":["登高必赋"],"usage":"作谓语、定语；指作文"},{"id":32571,"word":"登高自卑","pinyin":"dēng gāo zì bēi","abbr":"dgzb","explanation":"比喻事情的进行有一定的顺序。","source":{"text":"譬如行远必自迩，譬如登高必自卑。","book":"《礼记·中庸》"},"example":{"text":"学者当～，不可躐等。","book":"清·黄子云《野鸿诗的》卷六十五"},"similar":["循序渐进"],"usage":"作谓语、宾语；比喻事情必须循序渐进"},{"id":32572,"word":"登龙有术","pinyin":"déng lóng yǒu shù","abbr":"dlys","explanation":"登龙：登龙门；有术：有谋略，有飞黄腾达，致身显贵的谋术。即有一套钻营高升的本领。"},{"id":32573,"word":"白丁俗客","pinyin":"bái dīng sú kè","abbr":"bdsk","explanation":"白丁：没有功名的平民。泛指粗俗之辈。","source":{"text":"往来无白丁俗客，谈笑有上士高宾》","book":"明·无名氏《庞掠四郡》一折"},"similar":["平民百姓"],"opposite":["文人雅士"],"usage":"作主语、宾语；指粗俗人"},{"id":32574,"word":"白云亲舍","pinyin":"bái yún qīn shè","abbr":"byqs","explanation":"亲：指父母；舍：居住。比喻思念父母的话。","source":{"text":"荐授并州法曹参军，亲在河阳。仁杰登太行山，反顾，见白云孤飞，谓左右曰：‘吾亲舍其下。’瞻怅久之。云移，乃得去。","book":"《新唐书·狄仁杰传》"},"example":{"text":"南望～在，故乡回首凄凄。","book":"清·秋谨《临江仙·题李艺垣〈慕莱堂集〉》词"},"similar":["白云孤飞","暮云亲舍"],"usage":"作主语、定语；指思念亲人","story":["唐朝时期，狄仁杰任并州法曹参军，与父母相隔很远，不能相见。一天他登上太行山，转身朝河阳方向遥望，对左右人说自己的父母就住在远方的那白云之下。他久久地注视那块白云，直至它从视野中消逝"]},{"id":32575,"word":"白云孤飞","pinyin":"bái yún gū fēi","abbr":"bygf","explanation":"比喻客居他乡，思念父母。","source":{"text":"荐授并州法曹参军，亲在河阳。仁杰登太行山，反顾，见白云孤飞，谓左右曰：‘吾亲舍其下。’瞻怅久之。云移，乃得去。","book":"《新唐书·狄仁杰传》"},"example":{"text":"客中思亲云～。","book":"宋·胡继宗《书言故事·天文类》"},"similar":["白云亲舍"],"usage":"作宾语、定语；指思念父母亲人","story":["唐朝时期，狄仁杰任并州法曹参军，与父母相隔很远，不能相见。一天他登上太行山，转身朝河阳方向遥望，对左右人说自己的父母就住在远方的那白云之下。他久久地注视那块白云，直至它从视野中消逝"]},{"id":32576,"word":"白云苍狗","pinyin":"bái yún cāng gǒu","abbr":"bycg","explanation":"苍：灰白色。浮云象白衣裳，顷刻又变得象苍狗。比喻事物变化不定。","source":{"text":"天上浮云似白衣，斯须改变如苍狗。","book":"唐·杜甫《可叹诗》"},"example":{"text":"真是世事～，不禁感慨系之矣！","book":"鲁迅《华盖集后记》"},"similar":["变化无常","瞬息万变","白衣苍狗"],"opposite":["一成不变"],"usage":"作谓语、定语；比喻世事变幻无定，不易揣测","story":["唐朝书生王季友的妻子柳氏不堪家境贫寒，抛弃了丈夫而去，外界不明真相，纷纷指责王季友。杜甫为王季友鸣不平，特作《可叹》诗一首：“天上浮云似白衣，斯须改变如苍狗。”感叹世事变化莫测"]},{"id":32577,"word":"白云青舍","pinyin":"bái yún qīng shè","abbr":"byqs","explanation":"比喻在异乡思念亲人。","example":{"text":"游子长年在外，不免有～之感。"},"similar":["白云亲舍"],"usage":"作宾语、定语；用于书面语"},{"id":32578,"word":"白俗元轻","pinyin":"bái sú yuán qīng","abbr":"bsyq","explanation":"白：指白居易；元：指元稹。泛指文笔粗俗浅近，轻浮靡丽。","source":{"text":"元轻白俗，郊寒岛瘦。","book":"宋·苏轼《祭柳子玉文》"}},{"id":32579,"word":"白兔赤乌","pinyin":"bái tù chì wū","abbr":"btcw","explanation":"月亮和太阳的代称。多借指时间。","source":{"text":"天地迢迢自长久，白兔赤乌相趁走。","book":"唐·白居易《劝酒》诗"},"usage":"作宾语、定语；指时间"},{"id":32580,"word":"白刀子进，红刀子出","pinyin":"bái dāo zǐ jìn，hóng dāo zǐ chū","abbr":"bdzjhdzc","explanation":"指要杀人见血、动手拼命。红刀子：带血的刀子。","source":{"text":"不和我说别的还可；再说别的，咱们白刀子进去，红刀子出来！","book":"清·曹雪芹《红楼梦》第七回"},"example":{"text":"战场上经常可以见到～的场面。"},"usage":"作宾语、定语、分句；用于行凶"},{"id":32581,"word":"白华之怨","pinyin":"bái huá zhī yuàn","abbr":"bhzy","explanation":"指女子失宠之哀怨。","source":{"text":"白华，周人刺幽后也。幽王取申女以为后，故下国化之，以妾为妻，以孽代宗，而王弗能治。","book":"《诗·小雅·白华》序"},"example":{"text":"贱者咸得秩进，各得厥职，以广继嗣之统，息～。","book":"《汉书·谷永传》"},"usage":"作宾语；指女子失宠"},{"id":32582,"word":"白发丹心","pinyin":"bái fà dān xīn","abbr":"bfdx","explanation":"丹心：赤诚之心。形容年迈苍老，仍然怀有一颗赤诚之心。","source":{"text":"《汉书·苏武传》记载苏武出使匈奴，被扣十九年，丹心一片，及还，须发皆白的故事。"},"example":{"text":"牧羊驱马虽戎服，～尽汉臣。","book":"唐·杜牧《河湟》诗"},"usage":"作宾语、定语；用于老年人"},{"id":32583,"word":"白发偕老","pinyin":"bái fà xié lǎo","abbr":"bfxl","explanation":"白头：头发白。指夫妻相爱相守一直到老。","source":{"text":"淑娴抱着与孙若西白发偕老的贞操节烈的决心，等待着孙若西的花轿。","book":"冯德英《迎春花》第20章"},"similar":["白头偕老","白头到老"],"opposite":["白头不终"],"usage":"作谓语；用于夫妻"},{"id":32584,"word":"白发千丈","pinyin":"bái fà qiān zhàng","abbr":"bfqz","explanation":"形容头发既白且长，表示人因愁思过重而容颜衰老。","source":{"text":"白发三千丈，缘愁似个长。不知明镜里，何处得秋霜。","book":"唐·李白《秋浦歌》诗"},"example":{"text":"凡此诸人，今皆安往？我虽独存，～。","book":"宋·刘克庄《后村全集·祭林寒斋文》第一百三十八卷"},"similar":["老态龙钟"],"usage":"作定语；形容老人"},{"id":32585,"word":"白发婆娑","pinyin":"bái fā pó suō","abbr":"bfps","explanation":"婆娑：纷披的样子。形容满头白发的老年人的样子。","source":{"text":"早申以后，悠悠忽忽，既不能觅死，又不能聊生，白发婆娑，犹视息人世。","book":"明·张岱《自为墓志铭》"},"example":{"text":"焚香夜对灯如豆，～苦校雠。","book":"邓雅声《〈养拙园诗文合抄〉刻成，喜吟四章》"},"similar":["白发苍苍"],"usage":"作谓语、定语；指老人"},{"id":32586,"word":"白发朱颜","pinyin":"bái fà zhū yán","abbr":"bfzy","explanation":"颜：脸色。头发斑白，脸色通红。形容老人容光焕发。","source":{"text":"绿衣黄里颠倒用，白发朱颜喜怒看。","book":"明·无名氏《渔樵闲话》第二折"},"similar":["白发红颜"],"opposite":["老气横秋"],"usage":"作主语、定语；形容老人的容貌"},{"id":32587,"word":"白发相守","pinyin":"bái fà xiāng shǒu","abbr":"bfxs","explanation":"白头：头发白。指夫妻相爱相守一直到老。","source":{"text":"但小女无暇之玉被汝点破，端期白发相守，慎毋见弃可也。","book":"《杨家将演义》第48回"},"similar":["白头到老"],"opposite":["白头不终"],"usage":"作谓语；用于夫妻"},{"id":32588,"word":"白发红颜","pinyin":"bái fà hóng yán","abbr":"bfhy","explanation":"头发斑白而脸色红润。形容老年人容光焕发的样子。","source":{"text":"（徐知常）旧尝有痼疾，遇异人得修炼之术，却药谢医，以至引年，白发红颜，真有所得。","book":"宋·佚名《宣和画谱·道释四》"},"example":{"text":"路遥《平凡的世界》第一卷第21章：“顾老和大部分中医一样，～，戴一幅老花镜，认真地给田福堂号脉。”"},"similar":["白发朱颜"],"opposite":["老气横秋"],"usage":"作主语、定语；形容老人的容貌"},{"id":32589,"word":"白发苍苍","pinyin":"bái fà cāng cāng","abbr":"bfcc","explanation":"苍苍：灰白色。头发灰白。形容人的苍老。","source":{"text":"吾年未四十，而视茫茫，白发苍苍，而齿牙摇动。","book":"唐·韩愈《祭十二郎文》"},"example":{"text":"～的李四光硖硖眼睛，笑了一笑。","book":"徐迟《地质之光》"},"similar":["须发皆白"],"opposite":["朱颜绿鬓"],"usage":"作谓语、状语；多用于指老人的头发变白"},{"id":32590,"word":"白发苍颜","pinyin":"bái fà cāng yán","abbr":"bfcy","explanation":"头发已白，脸色灰暗。形容老人的容貌。","source":{"text":"白发苍颜五十三，家人强遣试春衫。","book":"宋·洪迈《容斋五笔·白苏诗纪年岁》"},"similar":["白发苍苍"],"usage":"作谓语、定语；形容老人"},{"id":32591,"word":"白发郎官","pinyin":"bái fà láng guān","abbr":"bflg","explanation":"指直到年老也没晋升的人。","source":{"text":"陛下好少而臣已老，是以三世不遇，故老于郎署。","book":"东汉·班固《汉武故事》"},"similar":["白首为郎"],"usage":"作宾语、定语；指年老没有地位","story":["西汉时期，汉武帝去巡视郎署，见到两鬓斑白的郎官颜驷，就问他何时为郎官。颜驷说汉文帝时就当郎官了，汉武帝问他为什么老而不遇？他说：“文帝好文而臣尚武，景帝好老而臣尚少，陛下好少而臣已老，所以我至今还是一个郎官。”"]},{"id":32592,"word":"白发青衫","pinyin":"bái fà qīng shān","abbr":"bfqs","explanation":"青衫：无功名者的服饰。谓年老而功名未就。","source":{"text":"琼林宴罢作诗曰：‘白发青衫晚得官，琼林顿觉酒肠宽。’","book":"宋·赵令畤《侯鲭录》第七卷"},"example":{"text":"～无限感，不关弹出四弦秋。","book":"清·韩泰华《无事为福斋随笔》下卷"},"usage":"作状语、宾语、定语；指小官"},{"id":32593,"word":"白叟黄童","pinyin":"bái sǒu huáng tóng","abbr":"bsht","explanation":"白头发的老人和黄头发的孩子。泛指老老少少。","source":{"text":"仰赖圣德仁慈，白叟黄童，焚香顶礼，俺永享快乐也。","book":"明·无名氏《衣锦还乡》第四折"},"example":{"text":"城乡内外，红男绿女，～，联袂往观者，何止千万人！","book":"清·壮者《扫迷帚》第九回"},"similar":["老老少少"],"usage":"作主语、宾语、定语；指老少"},{"id":32594,"word":"白吃干饭","pinyin":"bái chī gān fàn","abbr":"bcgf","explanation":"只会吃饭不会干活。","source":{"text":"我从小就不安于现状，我总是在想改变我的现状，因为我不愿意白吃干饭混日子。","book":"巴金《探索集·探索》"},"example":{"text":"我怎么会有你这个～的儿子？"},"usage":"作谓语、宾语、定语；用于口语"},{"id":32595,"word":"白商素节","pinyin":"bái shāng sù jié","abbr":"bssj","explanation":"白商：按五色分秋属白，按五音分秋属商，故称秋天为白商；素节：节气。指秋天的季节。","source":{"text":"若乃白商素节，月既授衣，天凝地闭，风厉霜飞，柔条夕劲，密叶晨稀，将固气以效杀，临金郊而讲师。","book":"晋·张协《七命》"}},{"id":32596,"word":"白圭之玷","pinyin":"bái guī zhī diàn","abbr":"bgzd","explanation":"白玉圭上的一个斑点。比喻人或物大体很好，只是有些小缺点。","source":{"text":"白圭之玷，尚可磨也；斯言之玷，不可为也。","book":"《诗经·大雅·抑》"},"example":{"text":"也不过～，并非晚节不终。","book":"鲁迅《且介亭杂文末编·关于太炎先生二三事》"},"similar":["金无足赤","人无完人"],"opposite":["十全十美"],"usage":"作主语、宾语；形容美好的人或事存在小毛病"},{"id":32597,"word":"白圭可磨","pinyin":"bái guī kě mó","abbr":"bgkm","explanation":"圭：古代玉器名，长条形，上端作三角状。白圭上的斑点还可以磨去，人说错话就没有办法了。","source":{"text":"白圭之玷，尚可磨也；斯言之玷，不可为也。","book":"《诗经·大雅·抑》"}},{"id":32598,"word":"白圭无玷","pinyin":"bái guī wú diàn","abbr":"bgwd","explanation":"玷：玉上的斑点。洁白的玉上没有斑点。比喻人或事物完美，没有缺点。","source":{"text":"如彼白圭，质无尘玷。","book":"晋·袁宏《三国名臣序赞》"},"example":{"text":"或华发产衰，或～。","book":"唐·张九龄《勅授十道使》"}},{"id":32599,"word":"白天见鬼","pinyin":"bái tiān jiàn guǐ","abbr":"btjg","explanation":"比喻虚妄荒诞，不可能出现的事。同“白日见鬼”。","source":{"text":"他太注意老二的无聊了，而始终以为老二的不敢到学校去是白天见鬼。","book":"老舍《四世同堂》二九"},"example":{"text":"周炳一面说：‘我的时运太低，～！’说罢回身想走。","book":"欧阳山《苦斗》十二"},"similar":["白日见鬼"],"usage":"作定语、宾语；形容不可能出现的事"},{"id":32600,"word":"白头不终","pinyin":"bái tóu bù zhōng","abbr":"btbz","explanation":"指夫妇不能偕老。","source":{"text":"剔灯入帐，芸已寒热大作，余亦继之，困顿两旬。真所谓乐极灾生亦是白头不终之兆。","book":"清·沈复《浮生六记·闺房记乐》"},"opposite":["白头偕老"],"usage":"作谓语、定语；用于夫妻"},{"id":32601,"word":"白头之叹","pinyin":"bái tóu zhī tàn","abbr":"btzt","explanation":"指妇女被遗弃而作晚景凄凉之叹。","source":{"text":"此身皆托于足下，勿以他日见弃，使妾有白头之叹。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"妾蒙陛下宠眷，六宫无比，只怕日久恩疏，不免～。","book":"清·洪昇《长生殿·密誓》"},"usage":"作宾语；多用于女性"},{"id":32602,"word":"白头偕老","pinyin":"bái tóu xié lǎo","abbr":"btxl","explanation":"白头：头发白；偕：共同。夫妻相亲相爱，一直到老。","source":{"text":"孩儿，我与你母亲白头偕老，富贵双全。","book":"《诗经·卫风·氓》：“及尔偕老。”明·陆采《怀香记·奉诏班师》"},"example":{"text":"我原说过，她不会跟你～的。","book":"巴金《寒夜》"},"similar":["白头到老","白头相守"],"opposite":["分道扬镳"],"usage":"作谓语、宾语、定语；用作祝颂之辞"},{"id":32603,"word":"白头到老","pinyin":"bái tóu dào lǎo","abbr":"btdl","explanation":"白头：头发白。夫妻相亲相爱，一直到老。","source":{"text":"孩儿，我与你母亲白头偕老，富贵双全。","book":"《诗经·卫风·氓》：“及尔偕老。”明·陆采《怀香记·奉诏班师》"},"example":{"text":"小娘半老之际，风波历尽，刚好遇到个老成的孤老，两下志同道合，收绳卷索，～。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["白头偕老"],"opposite":["白头不终"],"usage":"作谓语、定语；用于夫妻"},{"id":32604,"word":"白头如新","pinyin":"bái tóu rú xīn","abbr":"btrx","explanation":"白头：头发白了；新：新交。指交朋友彼此不能了解，时间虽久，仍跟刚认识一样。","source":{"text":"谚曰：‘有白头如新，倾盖如故。’何则？知与不知也。","book":"汉·邹阳《狱中上书自明》：“语曰：白头如新，倾盖如故，何则？”《史记·鲁仲连邹阳列传》"},"example":{"text":"而八年之间，语言不接，吉凶不相问吊，反有～之嫌。","book":"宋·陈亮《与应仲书》"},"similar":["白头而新"],"usage":"作谓语、定语；形容人相识已久但不相知","story":["西汉时期，邹阳受人诬陷被梁孝王关入死囚牢，他在狱中给梁孝王写信表明忠心。他列举了荆轲、卞和、李斯等事例，说“有白头如新，倾盖如故”，双方不了解，即使交往一辈子，到老了还是像刚认识一样。梁孝王深受感动并释放了他"]},{"id":32605,"word":"白头如新，倾盖如故","pinyin":"bái tóu rú xīn，qīng gài rú gù","abbr":"btrxqgrg","explanation":"倾盖：停下车子，指初次相逢。指相识虽久，仍跟刚认识一样，有的刚认识，却象老友一样。比喻感情的厚薄是不以时间长短来衡量的。","source":{"text":"谚曰：‘有白头如新，倾盖如故。’何则？知与不知也。","book":"汉·邹阳《狱中上书自明》：“语曰：白头如新，倾盖如故，何则？”《史记·鲁仲连邹阳列传》"},"similar":["白头如新，倾盖如旧"],"usage":"作宾语、定语、分句；指人的交情","story":["西汉时期，邹阳受人诬陷被梁孝王关入死囚牢，他在狱中给梁孝王写信表明忠心。他列举了荆轲、卞和、李斯等事例，说“有白头如新，倾盖如故”，双方不了解，即使交往一辈子，到老了还是像刚认识一样。梁孝王深受感动并释放了他"]},{"id":32606,"word":"白头相守","pinyin":"bái tóu xiāng shǒu","abbr":"btxs","explanation":"指夫妻恩爱相守到老。","source":{"text":"我的哥哥，奴承望和你白头相守，谁知奴今日死去也。","book":"明·兰陵笑笑生《金瓶梅词话》第六十二回"},"example":{"text":"我与李固～，便是我平生愿足。","book":"明·无名氏《闹铜台》第一折"},"similar":["白头偕老"],"opposite":["白头不终"],"usage":"作谓语；用于夫妻"},{"id":32607,"word":"白头相并","pinyin":"bái tóu xiāng bìng","abbr":"btxb","explanation":"犹言白头偕老。夫妻相亲相爱，一直到老。","source":{"text":"木梳儿，我爱你齿牙干净……向妆台设个誓：愿得白头相并！","book":"明·冯梦龙《挂枝儿·木梳》"},"similar":["白头偕老"],"usage":"作谓语、定语；同“白头偕老”"},{"id":32608,"word":"白头而新","pinyin":"bái tóu ér xīn","abbr":"btex","explanation":"指相交虽久而并不知己，像新知一样。同“白头如新”。","source":{"text":"《汉书》：‘白头如新，倾盖如故。’《说苑》作‘白头而新，倾盖而故’。‘而’、‘如’，古字通用。白头而新，虽至老而交犹新。","book":"明·杨慎《白头而新》"},"similar":["白头如新"],"usage":"作谓语、定语；形容人相识已久但不相知"},{"id":32609,"word":"白屋之士","pinyin":"bái wū zhī shì","abbr":"bwzs","explanation":"指贫寒的士人。","source":{"text":"周公执贽下白屋之士。","book":"汉·王充《论衡·语增》"},"example":{"text":"是所工也多，故传书甚少；其转徙也艰，故受毁甚易；其为费也不资，故～不能得书者甚众。","book":"严复《论八股存亡之关系》"},"usage":"作主语、宾语；指贫寒的士人"},{"id":32610,"word":"白屋寒门","pinyin":"bái wū hán mén","abbr":"bwhm","explanation":"白屋：用白茅草盖的屋；寒门：清贫人家。泛指贫士的住屋。形容出身贫寒。","source":{"text":"未亨通，遭穷困，身居在白屋寒门。","book":"元·高文秀《谇范叔》第三折"},"usage":"作宾语；指穷苦人"},{"id":32611,"word":"白山黑水","pinyin":"bái shān hēi shuǐ","abbr":"bshs","explanation":"长白山和黑龙江。泛指我国东北地区。","source":{"text":"生女之地有混同江、长白山。混同江亦号黑龙江，所谓‘白山黑水’是也。","book":"《金史·世纪》"},"example":{"text":"～之间，是我大清发祥地，你们去看看体验一下也好。","book":"唐明浩《曾国藩》第三部第四章"},"usage":"作主语、宾语；指中国东北地区"},{"id":32612,"word":"白帢青衫","pinyin":"bái jiá qīng shān","abbr":"bqqs","explanation":"旧时士人的服装。亦借指尚未取得功名的士人。同“白袷蓝衫”。","source":{"text":"风帆送客到夷州，白帢青衫谈不朽。","book":"宋·谢翱《送袁太初归剡原》诗"},"similar":["白袷蓝衫"],"usage":"作宾语、定语；指读书人"},{"id":32613,"word":"白往黑归","pinyin":"bái wǎng hēi guī","abbr":"bwhg","explanation":"比喻只看表面不看本质。","example":{"text":"你不能抱～的态度看问题。"},"usage":"作宾语、定语；指人前后不一","story":["战国时期，思想家杨朱认为人都是自私自利的，杨朱的弟弟杨布说他的小白狗对他特别亲热，杨朱认为狗对他亲热是在骗吃的。一天杨布穿白衣外出，因雨而变成黑衣，小狗就对他狂吠。杨布对此不解，杨朱则讽刺他对换角色白往黑归的感觉"]},{"id":32614,"word":"白往黑来","pinyin":"bái wǎng hēi lái","abbr":"bwhl","explanation":"比喻变化极大。","source":{"text":"向者，使汝狗白而往，黑而来，岂能无怪哉？","book":"《列子·说符》"}},{"id":32615,"word":"白恰青衫","pinyin":"bái qià qīng shān","abbr":"bqqs","explanation":"白恰：尖顶无檐的白布帽；青衫：青色袍衫。指没有取得功名的士人。","source":{"text":"风帆送客到夷州，白恰青衫谈不朽。","book":"宋·谢翱《送袁太初归剡原》"},"similar":["白袷蓝衫"],"usage":"作宾语、定语；指读书人"},{"id":32616,"word":"白手兴家","pinyin":"bái shǒu xīng jiā","abbr":"bsxj","explanation":"形容原来无基础或条件很差而创出一番事业。同“白手起家”。","source":{"text":"联络参谋极力称赞这些同志都是白手兴家的能手。","book":"沙汀《记贺龙》十一"},"similar":["白手成家","白手起家"],"opposite":["根基深厚"],"usage":"作谓语、宾语、定语；指在很差的条件下创业"},{"id":32617,"word":"白手成家","pinyin":"bái shǒu chéng jiā","abbr":"bscj","explanation":"没有依恃，而独立兴起的家业或事业。","source":{"text":"朱延年是商人的儿子，他的福佑药房是白手成家的。","book":"周而复《上海的早晨》第一部十二"},"example":{"text":"他过去家徒四壁，但由于肯努力，所以能～。"},"similar":["白手起家"],"opposite":["根基深厚"],"usage":"作谓语、宾语、定语；指在很差的条件下创业"},{"id":32618,"word":"白手空拳","pinyin":"bái shǒu kōng quán","abbr":"bskq","explanation":"形容手中一无所有。","source":{"text":"我从十几岁上，拿了一双白手空拳，和吴继之两个混；我们两个向没分家，挣到了一百多万。","book":"清·吴研人《二十年目睹之怪现状》第一百八回"},"example":{"text":"以我所见，我的那干儿子杭阿宝，我去年才荐他做一个洋布式拉夫，他一得了这件事，～的，先就做了两票小货，居然叫他赚了一千多。","book":"《发财秘诀》第十回"},"similar":["赤手空拳"],"opposite":["坚甲利兵"],"usage":"作宾语、定语、状语；比喻办事缺乏物质基础"},{"id":32619,"word":"白手起家","pinyin":"bái shǒu qǐ jiā","abbr":"bsqj","explanation":"白手：空手；起家：创建家业。形容在没有基础和条件很差的情况下自力更生，艰苦创业。","source":{"text":"今士大夫白屋起家，以致荣显。","book":"《朱子语类》卷一０七"},"example":{"text":"你看，他发了多少财，～，靠的是谁？如今也忘了水源头了，墙上的草，两边倒着呢。","book":"丁玲《太阳照在桑干河上》"},"similar":["自力更生","成家立业"],"opposite":["根基深厚","寄人篱下"],"usage":"作谓语、宾语、定语；用于生活"},{"id":32620,"word":"白旄黄钺","pinyin":"bái máo huáng yuè","abbr":"bmhy","explanation":"比喻有关征战的事。","source":{"text":"王左仗黄钺，右秉白旄以麾。","book":"《尚书·牧誓》"},"example":{"text":"某十八岁同父起义，～，平定两京。","book":"明·无名氏《智降秦叔宝》第一折"},"usage":"作主语、宾语；指出师打仗"},{"id":32621,"word":"白日上升","pinyin":"bái rì shàng shēng","abbr":"brss","explanation":"犹言白日升天。道教谓人修炼得道后，白昼飞升天界成仙。","source":{"text":"常言吃药全胜饭，华岳松边采茯神。不遣髭须一茎白，拟为白日上升人。","book":"唐·贾岛《赠丘先生》诗"},"similar":["白日飞升"],"usage":"作谓语、宾语；指修道成仙"},{"id":32622,"word":"白日作梦","pinyin":"bái rì zuò mèng","abbr":"brzm","explanation":"大白天做起梦来。比喻幻想根本不能实现","source":{"text":"你这不是明明白白的痴心妄想，白日作梦么？","book":"《小说选刊》1981年第4期"},"example":{"text":"你不要～了，现实点吧"},"similar":["白日做梦","痴心妄想"],"opposite":["脚踏实地"],"usage":"作谓语、宾语；多用在斥责、谴责的场合"},{"id":32623,"word":"白日做梦","pinyin":"bái rì zuò mèng","abbr":"brzm","explanation":"比喻幻想不可能实现。同“白日做梦”。","source":{"text":"金镶玉走进舱去，嘻笑道：‘老昏君白日作梦，自以为是九五之尊，不肯有失万岁爷的身份，迎接一位七品县令。’","book":"刘绍棠《狼烟》二十二"},"example":{"text":"他们有时间顾得上你么？你这不是明明白白的痴心妄想，～么？","book":"《小说选刊》1981年第4期"},"similar":["黄粱美梦","痴人说梦","痴心妄想"],"opposite":["脚踏实地"],"usage":"作谓语、宾语；多用在斥责、谴责的场合"},{"id":32624,"word":"白日升天","pinyin":"bái rì shēng tiān","abbr":"brst","explanation":"原是道教指白昼升天成为神仙。后比喻一下子富贵起来。","source":{"text":"俗说淮南王安招致宾客方术之士数千人，作《鸿宝苑祕》枕中之书，铸成黄白，白日升天。","book":"汉·应劭《风俗通·正失》"},"example":{"text":"遂去，悉度其妻妾，于是“金氏门中两代～。”","book":"鲁迅《中国文学史略》第二十六篇"},"similar":["白日上升"],"usage":"作谓语；指修道成仙"},{"id":32625,"word":"白日梦","pinyin":"bái rì mèng","abbr":"brm","explanation":"白日做梦。比喻不切实际的、不可能实现的幻想","source":{"text":"我在做白日梦。","book":"王朔《橡皮人》"},"example":{"text":"你又在做～了"},"similar":["白日做梦"],"usage":"作宾语、定语；多用于口语"},{"id":32626,"word":"白日绣衣","pinyin":"bái rì xiù yī","abbr":"brxy","explanation":"旧时比喻富贵后还乡，向乡亲们夸耀。","source":{"text":"（张辽）以二千石之尊过乡里，荐祝祖考。白日绣衣，荣羡如此。","book":"汉·应劭《风俗通·怪神·世间多有伐木血出以为怪者》"},"similar":["衣锦还乡"],"usage":"作谓语；同“衣锦还乡”"},{"id":32627,"word":"白日衣绣","pinyin":"bái rì yì xiù","abbr":"bryx","explanation":"衣：穿；绣：五彩制绣的官服。白天身着华贵官服，使人看见。旧时比喻富贵后还乡，向乡亲们夸耀。","source":{"text":"（张辽）以二千石之尊过乡里，，荐祝祖考。白日衣绣，荣羡如此。","book":"汉·应劭《风俗通·怪神》"}},{"id":32628,"word":"白日见鬼","pinyin":"bái rì jiàn guǐ","abbr":"brjg","explanation":"大白天看见鬼。指工部四曹无事可做，非常清闲。后泛指事情离奇古怪或无中生有。","source":{"text":"工、屯、虞、水，白日见鬼。","book":"宋·陆游《老学庵笔记》"},"example":{"text":"八戒道：“哥啊，我们连日造化低了。这两日～！那个化风去的老儿是谁？”","book":"明·吴承恩《西游记》第二十一回"},"similar":["白日做梦","白天见鬼"],"usage":"作谓语、定语、宾语；形容不可能出现的事"},{"id":32629,"word":"白日说梦","pinyin":"bái rì shuō mèng","abbr":"brsm","explanation":"大白天说梦话。比喻毫无根据地说话。"},{"id":32630,"word":"白日青天","pinyin":"bái rì qīng tiān","abbr":"brqt","explanation":"白天。表示强调。","source":{"text":"太史留题快阁诗，旧碑未必是真题。六丁搜出严家墨，白日青天横紫蜺。","book":"宋·杨万里《题太和宰卓士直寄新刻〈山谷快阁诗真迹〉》诗"},"example":{"text":"～，睽睽万目，欲加之罪，何患无辞。","book":"彭芬《辛亥逊清政变记》第二编"},"similar":["青天白日"],"usage":"作宾语、分句；指大白天"},{"id":32631,"word":"白日飞升","pinyin":"bái rì fēi shēng","abbr":"brfs","explanation":"犹白日升天。道教谓人修炼得道后，白昼飞升天界成仙。后喻指一朝显贵。","source":{"text":"黄金转世人何在，白日飞升谁见来。","book":"《全元散曲·喜春来》"},"example":{"text":"左壁挂‘黄鹤楼～’，右壁悬‘洞庭湖三番渡过’。","book":"明·兰陵笑笑生《金瓶梅词话》第三九回"},"similar":["白日升天"],"usage":"作谓语、宾语；指修道成仙"},{"id":32632,"word":"白昼做梦","pinyin":"bái zhòu zuò mèng","abbr":"bzzm","explanation":"大白天做起梦来。比喻幻想根本不能实现。","source":{"text":"我们真是白昼做梦！","book":"郭沫若《洪波曲》第11章"},"similar":["白日做梦"],"opposite":["脚踏实地"],"usage":"作谓语、宾语；多用在斥责、谴责的场合"},{"id":32633,"word":"白昼见鬼","pinyin":"bái zhòu jiàn guǐ","abbr":"bzjg","explanation":"泛指虚妄荒诞、不可能出现的事。","source":{"text":"龙香嘻的一笑道：‘白日见鬼！枉着人急了这许多时。","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"similar":["白日见鬼"],"usage":"作定语、宾语；形容不可能出现的事"},{"id":32634,"word":"白板天子","pinyin":"bái bǎn tiān zǐ","abbr":"bbtz","explanation":"没有国玺的皇帝。","source":{"text":"乘舆传国玺，秦玺也。晋中原乱没胡，江左初无之，北方人呼晋家为‘白板天子’。","book":"《南齐书·舆服志》"},"similar":["光杆司令"],"usage":"作主语、宾语；指孤家寡人"},{"id":32635,"word":"白毫之赐","pinyin":"bái háo zhī cì","abbr":"bhzc","explanation":"白毫：佛家指如来三十二相之一，其眉间白色毫毛，放有光明，称白毫相。指供养僧徒之物。","source":{"text":"如来灭后，白毫相中百千亿分，其中一分供养舍利及诸弟子，……设使一切世间人皆共出家，随顺法行，于白毫相百千亿分，不尽其一。","book":"《佛藏经·了戒品》"},"usage":"作宾语；指供养僧徒之物"},{"id":32636,"word":"白水盟心","pinyin":"bái shǒu méng xīn","abbr":"bsmx","explanation":"盟：旧指盟誓订约。指着水起誓。泛指对人盟誓。"},{"id":32637,"word":"白水鉴心","pinyin":"bái shuǐ jiàn xīn","abbr":"bsjx","explanation":"白水：清水；鉴：照。清澈的水能照见人的心。形容人心像明净的水一样纯洁。","example":{"text":"这孩子朴实勤奋，白水鉴心，是个品学兼优的好孩子。"}},{"id":32638,"word":"白沙在涅，与之俱黑","pinyin":"bái shān zài niè，yǔ zhī jù hēi","abbr":"bsznyzjh","explanation":"涅：黑土。白色的细沙混在黑土中，也会跟它一起变黑。比喻好的人或物处在污秽环境里，也会随着污秽环境而变坏。","source":{"text":"白沙在涅，与之俱黑。","book":"《荀子·劝学》"},"opposite":["出污泥而不染"],"usage":"作分句；指环境对人的影响"},{"id":32639,"word":"白浪掀天","pinyin":"bái làng xiān tiān","abbr":"blxt","explanation":"掀：翻腾。形容风大浪高。","source":{"text":"青苔扑地连春雨，白浪掀天尽日风。","book":"唐·白居易《风雨晚泊》诗"},"example":{"text":"这朵云一出现，洱海上就狂风大作，～。","book":"曹靖华《洱海一枝春》"},"usage":"作宾语、定语；形容风浪"},{"id":32640,"word":"白玉微瑕","pinyin":"bái yù wēi xiá","abbr":"bywx","explanation":"洁白的玉上有些小斑点。比喻很好的人或物有些小缺点，美中不足。","source":{"text":"白璧微瑕，惟在《闲情》一赋。","book":"南朝·梁·萧统《陶渊明集序》"},"similar":["美中不足"],"opposite":["白玉无瑕"],"usage":"作宾语、定语；指美中不足"},{"id":32641,"word":"白玉无瑕","pinyin":"bái yù wú xiá","abbr":"bywx","explanation":"洁白的美玉上面没有一点小斑。比喻人或事物完美无缺。","source":{"text":"问：‘不曾博览空王教略，借玄机试道看。’师曰：‘白玉无瑕，卞和刖足。’","book":"宋·释道原《景德传灯录·吉州福寿和尚》"},"example":{"text":"我是个～，怎肯使青蝇相累。","book":"明·胡文焕《群音类选·势逼改嫁》"},"similar":["完美无缺"],"opposite":["白玉微瑕"],"usage":"作宾语、定语；指人或事物"},{"id":32642,"word":"白玉映沙","pinyin":"bái yù yìng shā","abbr":"byys","explanation":"像白玉的光映照在沙土上。比喻诗文出类拔萃。","source":{"text":"譬犹青松之拔灌木，白玉之映尘沙，未足贬其高洁也。","book":"南朝·梁·钟嵘《诗品》"}},{"id":32643,"word":"白璧三献","pinyin":"bái bì sān xiàn","abbr":"bbsx","explanation":"楚人和氏得玉璞，两献楚王，两遭刖足。第三次王使治璞，得白玉，琢以为璧，世称“和氏璧”。比喻不识良材或怀才不遇。","source":{"text":"见《韩非子·和氏》。"},"example":{"text":"明珠暗投反按剑，～还遭刖。","book":"明·何景明《田子行》"},"similar":["怀才不遇"],"opposite":["将遇良才"],"usage":"作宾语、定语；指怀才不遇","story":["春秋时期，楚国珠宝匠卞和从山中发现一块璞玉原料，兴高采烈跑到宫里去进献给楚厉王，楚厉王认为这根本就是石头，就命人砍了他的左脚；进献给楚武王，楚武王也同样砍了他的右脚。只有楚文王识货，命人加工成为有名的和氏璧"]},{"id":32644,"word":"白璧微瑕","pinyin":"bái bì wēi xiá","abbr":"bbwx","explanation":"洁白的玉上有些小斑点。比喻很好的人或物有些小缺点，美中不足。","source":{"text":"白璧微瑕，惟在《闲情》一赋。","book":"南朝·梁·萧统《陶渊明集序》"},"example":{"text":"智者千虑，必有一失，然而这小毛病只是～而已。"},"similar":["美中不足","遐不掩瑜"],"opposite":["完美无缺","白璧无瑕"],"usage":"作主语、宾语、分句；表示缺点不足掩盖优点"},{"id":32645,"word":"白璧无瑕","pinyin":"bái bì wú xiá","abbr":"bbwx","explanation":"洁白的美玉上面没有一点小斑。比喻人或事物完美无缺。","source":{"text":"问：‘不曾博览空王教略，借玄机试道看。’师曰：‘白玉无瑕，卞和刖足。’","book":"宋·释道原《景德传灯录》卷十三"},"example":{"text":"虽以小姐～，何畏乎青蝇，然青蝇日集亦可憎恨耳。","book":"明·名教中人《好俅传》第七回"},"similar":["尽善尽美","十全十美"],"opposite":["白壁微瑕","瑕瑜互见"],"usage":"作谓语、定语；比喻人或事物十全十美"},{"id":32646,"word":"白璧青蝇","pinyin":"bái bì qīng yíng","abbr":"bbqy","explanation":"白璧：洁白的玉，比喻清白的人。青蝇：比喻佞人。比喻善恶忠佞。","source":{"text":"青蝇一相点，白璧遂成冤。","book":"唐·陈子昴《胡楚真禁所》诗"},"example":{"text":"为臣子莫贵忠和孝，继美于今有凤毛，～何足较。","book":"《群音类选》"},"usage":"作主语、宾语；指好人与坏人"},{"id":32647,"word":"白白朱朱","pinyin":"bái bái zhū zhū","abbr":"bbzz","explanation":"白的白，红的红。形容不同种类、色彩各异的花木。","source":{"text":"晨游百花林，朱朱兼白白。","book":"唐·韩愈《感春三首》诗"},"example":{"text":"风风雨雨又春穷，～已眼空。","book":"宋·杨万里《又和风雨二首》"},"similar":["朱朱白白"],"usage":"作谓语、定语；用于颜色"},{"id":32648,"word":"白眉赤眼","pinyin":"bái méi chì yǎn","abbr":"bmcy","explanation":"比喻平白无故。","source":{"text":"京师相詈，指其人曰白眉赤眼儿者，必大恨，其猥贱可知。","book":"明·沈德福《敝帚轩剩语·神名讹称》"},"example":{"text":"～的，作什么去呢？倒底说句话儿，也象件事啊。","book":"清·曹雪芹《红楼梦》第三十四回"},"similar":["平白无故"],"usage":"作定语；指平白无故"},{"id":32649,"word":"白眼相看","pinyin":"bái yǎn xiāng kàn","abbr":"byxk","explanation":"看别人时眼睛朝上或旁边，现出白眼珠，表示轻蔑，不屑一顾，对人不礼貌。","source":{"text":"尽今俗客不妨来，白眼相看勿分剖。","book":"宋·杨万里《诚斋集·都下和同舍李元老承信赠诗之韵》第四卷"},"usage":"作谓语、定语；用于对人的态度"},{"id":32650,"word":"白磨嘴皮","pinyin":"bái mó zuǐ pí","abbr":"bmzp","explanation":"指说了一些无用的话，不能说动对方。","example":{"text":"我这是～，对牛弹琴。"},"similar":["白费口舌"],"usage":"作谓语、宾语；指无用的谈话"},{"id":32651,"word":"白纸黑字","pinyin":"bái zhǐ hēi zì","abbr":"bzhz","explanation":"白纸上写下了黑字。比喻有确凿的文字凭据，不容抵赖或悔改。","source":{"text":"不要闲说，白纸上写着黑字哩。若有反悔之人，罚宝钞一千贯与不反悔之人使用。","book":"元·无名氏《看钱奴买冤家债主》第二折"},"example":{"text":"～贴在墙上，你还昧得了？”（赵树理《锻炼锻炼》）"},"similar":["证据确凿"],"opposite":["无凭无据"],"usage":"作谓语、定语、补语；形容有文字凭证"},{"id":32652,"word":"白绢斜封","pinyin":"bái juān xié fēng","abbr":"bjxf","explanation":"bái  juān  xié  fēng","source":{"text":"日高丈五睡正浓，军将打门惊周公。口传谏议送书信，白绢斜封三道印。","book":"唐·卢仝《谢孟谏议惠茶歌》"}},{"id":32653,"word":"白色恐怖","pinyin":"bái sè kǒng bù","abbr":"bskb","explanation":"白：惨白。指反动派残酷镇压人民的恐怖气氛。","source":{"text":"然而他们却深知道新文字对于劳苦大众有利，所以在弥漫着白色恐怖的地方，这新文字是一定要受摧残的。","book":"鲁迅《且介亭杂文·关于新文字》"},"example":{"text":"鲁迅先生对于白色恐怖毫不畏惧，一直把密信和文稿珍藏着。"},"similar":["腥风血雨"],"opposite":["红色风暴"],"usage":"作谓语、宾语；形容极其恐怖的气氛"},{"id":32654,"word":"白花心血","pinyin":"bái huā xīn xuè","abbr":"bhxx","explanation":"白白浪费自己的精力与心血。","example":{"text":"你不必为他～了。"},"similar":["白花心思","徒劳无益"],"usage":"作谓语、宾语；用于徒劳"},{"id":32655,"word":"白苋紫茄","pinyin":"bái xiàn zǐ qié","abbr":"bxzj","explanation":"白色的苋菜，紫色的茄子。比喻潞秘普通的蔬菜，生活俭朴。","source":{"text":"撙，字景节，为吴兴太守，不饮郡井，斋前自种白苋紫茄以为常饵，诏褒其清。","book":"《南史·蔡撙传》"}},{"id":32656,"word":"白草黄云","pinyin":"bái cǎo huáng yún","abbr":"bchy","explanation":"形容边塞秋季的荒凉景象。","source":{"text":"白草黄云塞上秋，曾随骠骑出并州。","book":"唐·权德舆《赠老将》诗"},"example":{"text":"急觅是人，不知何往，惟独立沙碛中，～，四边无际。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"similar":["黄云白草"],"usage":"作宾语、定语；指荒凉的地方"},{"id":32657,"word":"白藋同心","pinyin":"bái diào tóng xīn","abbr":"bdtx","explanation":"犹言心如野草。形容不羡荣华的品节。","source":{"text":"秋藜促节，白藋同心。终堪荷蓧，自足驱禽。","book":"北周·庾信《竹杖赋》"},"example":{"text":"他的旁艺，如制缠枝杖，独运匠心，修短适度，且刻铭识，以贻朋友，大有庾子三所谓‘秋藜促节，～’之致。","book":"郑逸梅《艺坛百影·陈从周与纽约明轩》"},"usage":"作宾语、分句；用于书面语"},{"id":32658,"word":"白虹贯日","pinyin":"bái hóng guàn rì","abbr":"bhgr","explanation":"白色的长虹穿日而过。古人认为人间有不平凡的事，就会引起这种天象的变化。实际上这不是虹而是晕，是一种大气光学现象。","source":{"text":"昔者荆轲慕燕丹之义，白虹贯日，太子畏之。","book":"《战国策·魏策四》：“聂政之刺韩傀也，白虹贯日。”《史记·鲁仲连邹阳列传》"},"example":{"text":"且休说～，青龙藏池。","book":"元·王实甫《丽春堂》第二折"},"usage":"作谓语、定语；形容异常的现象","story":["战国时期，韩国大臣严遂与相国韩傀结下怨仇，他到齐国去找屠狗为业的聂政去刺杀韩傀。聂政待母亲去世后，为报答严遂的知遇之恩，就独身仗剑闯入戒备森严的韩傀府并刺杀了他，然后自我毁容自杀，传说当时有白色的长虹穿日而过"]},{"id":32659,"word":"白蚁争穴","pinyin":"bái yǐ zhēng xué","abbr":"byzx","explanation":"比喻竞逐名利。","source":{"text":"取富贵青蝇竞血，进功名白蚁争穴。","book":"元·马谦斋《沉醉东风·自悟》曲"},"similar":["争名逐利"],"usage":"作宾语、定语；指争名逐利"},{"id":32660,"word":"白蜡明经","pinyin":"bái là míng jīng","abbr":"blmj","explanation":"白蜡：比喻光秃空白。明经：科举制度中科目之一。比喻屡试不中。","source":{"text":"张鷟号青钱学士，以其万选万中。时有明经董万九上不第，号白蜡明经，与鷟为对。","book":"唐·张鷟《朝野佥载》"},"similar":["名落孙山"],"opposite":["金榜题名"],"usage":"作宾语；比喻屡试不中"},{"id":32661,"word":"白衣公卿","pinyin":"bái yī gōng qīng","abbr":"bygq","explanation":"古时指进士。唐代人极看重进士，宰相多由进士出身，故推重进士为白衣卿相，是说虽是白衣之士，但享有卿相的资望。","source":{"text":"缙绅虽位极人臣，不由进士者，终不为美，以至岁贡常不减八九百人，其推重谓之‘白衣公卿’，又曰‘一品白衫’。","book":"五代·王定保《唐摭言·卷一·散序进士》"},"similar":["白衣卿相"],"usage":"作宾语；指古代读书人"},{"id":32662,"word":"白衣卿相","pinyin":"bái yī qīng xiàng","abbr":"byqx","explanation":"古时指进士。唐代人极看重进士，宰相多由进士出身，故推重进士为白衣卿相，是说虽是白衣之士，但享有卿相的资望。","source":{"text":"缙绅虽位极人臣，不由进士者，终不为美，以至岁贡常不减八九百人，其推重谓之‘白衣公卿’，又曰‘一品白衫’。","book":"五代·王定保《唐摭言·卷一·散序进士》"},"example":{"text":"小生不才杀者波，也是国家～。","book":"元·吴昌龄《张天师》第二折"},"similar":["白衣秀士"],"usage":"作宾语；指没有发迹的书生"},{"id":32663,"word":"白衣天使","pinyin":"bái yī tiān shǐ","abbr":"byts","explanation":"指护士。","example":{"text":"我很喜欢～。"},"usage":"作主语、宾语、定语；指护士"},{"id":32664,"word":"白衣宰相","pinyin":"bái yī zǎi xiàng","abbr":"byzx","explanation":"指宰相家属中身无名位而仗势擅权的人。","source":{"text":"且滈居当时，谓之‘白衣宰相’。滈未尝举进士，而妄言已解，使天下谓无解及第，不已罔乎？","book":"《新唐书·令狐滈传》"},"example":{"text":"令狐綯为相，其子怙势，人称为‘～’。","book":"明·郎瑛《七修类稿·辩证六·称相》"},"usage":"作主语、宾语、定语；指仗势的人"},{"id":32665,"word":"白衣秀士","pinyin":"bái yī xiù shì","abbr":"byxs","explanation":"指未曾获得功名的书生。","source":{"text":"至如吕岩，当初是个白衣秀士、未遇书生，上朝求官。","book":"元·马致远《岳阳楼》第二折"},"example":{"text":"寡人扮作～，私行径投丞相府里，商量下江南收川广之策。","book":"明·罗贯中《风云会》第三折"},"similar":["白衣卿相"],"usage":"作宾语；指没有发迹的书生"},{"id":32666,"word":"白衣苍狗","pinyin":"bái yī cāng gǒu","abbr":"bycg","explanation":"苍：灰白色。浮云象白衣裳，顷刻又变得象苍狗。比喻事物变化不定。","source":{"text":"天上浮云似白衣，斯须改变如苍狗。","book":"唐·杜甫《可叹诗》"},"example":{"text":"正是～多翻覆，沧海桑田几变更。","book":"明·张景《飞丸记·梨园鼓吹》"},"similar":["白云苍狗"],"usage":"作主语、宾语；比喻事物变化不定","story":["唐朝书生王季友的妻子柳氏不堪家境贫寒，毅然抛弃了丈夫而去，外界不明真相，纷纷指责王季友的不道德。只有杜甫为王季友鸣不平，特作《可叹》诗一首：“天上浮云似白衣，斯须改变如苍狗。”感叹世事变化莫测"]},{"id":32667,"word":"白衣送酒","pinyin":"bái yī sòng jiǔ","abbr":"bysj","explanation":"身穿白衣的人前来送酒。后泛指送酒的人。也比喻自己所渴望的东西朋友正好送来，遂心所愿。","source":{"text":"白衣送酒侮渊明，急扫风轩洗破觥。","book":"宋·苏轼《章质夫送酒六壶书至而酒不达戏作问之》诗"},"example":{"text":"～，只当闰重阳。","book":"清·李渔《怜香伴·狂喜》"},"usage":"作宾语、定语；指心想事成","story":["晋朝时期，彭泽令陶渊明看不惯官场的黑暗，不为五斗米而折腰毅然辞官归隐，从此躬耕终生。有一年重阳节，因为家贫没酒喝，心情特别烦闷，独自在篱笆边散步，忽见一个穿白衣的人说奉王弘之命前来送酒，陶渊明心中大喜，接过酒立即尽饮至醉"]},{"id":32668,"word":"白袷蓝衫","pinyin":"bái jiá lán shān","abbr":"bjls","explanation":"旧时士人的服装。亦借指尚未取得功名的士人。","source":{"text":"大抵青天碧海，不少峨眉见嫉之伤；谁知白袷蓝衫，亦多鼠思难言之痛。","book":"清·魏秀仁《花月痕》第五回"},"similar":["白恰青衫"],"usage":"作宾语、定语；指读书人"},{"id":32669,"word":"白话八股","pinyin":"bái huà bā gǔ","abbr":"bhbg","explanation":"用白话写的类似旧时八股式的文章。比喻指应命而写的刻板文章。","source":{"text":"说是《论语》办到一年了，语堂先生命令我做文章。这实在好像出了‘《学而》一章’的题目，叫我做一篇白话八股一样。","book":"鲁迅《南腔北调·“论语一年”》"},"usage":"作主语、宾语、定语；指刻板文章"},{"id":32670,"word":"白费口舌","pinyin":"bái fèi kǒu shé","abbr":"bfks","explanation":"谈话一无所获。","example":{"text":"这是～。"},"similar":["空费词说","白费唇舌"],"usage":"作谓语、宾语；指无用的谈话"},{"id":32671,"word":"白费心机","pinyin":"bái fèi xīn jī","abbr":"bfxj","explanation":"白费心思，形容徒劳无益。","example":{"text":"你不要～了。"},"similar":["枉费心机"],"usage":"作谓语、宾语；指白费心思"},{"id":32672,"word":"白费蜡","pinyin":"bái fèi là","abbr":"bfl","explanation":"白白浪费。","example":{"text":"你这是“瞎子点灯——～”。"},"usage":"作谓语、宾语；指作无用功"},{"id":32673,"word":"白跑一趟","pinyin":"bái pǎo yī tàng","abbr":"bpyt","explanation":"白白地去了一次无功而返。","source":{"text":"我们白跑一趟，偷鸡不着蚀把米，就是了。","book":"叶圣陶《一个练习生》"},"example":{"text":"叶圣陶《一个练习生》：“我们白跑一趟，偷鸡不着蚀把米，就是了。”"},"similar":["无功而返"],"opposite":["满载而归"],"usage":"作谓语、宾语；用于无功而返"},{"id":32674,"word":"白雪皑皑","pinyin":"bái xuě ái ái","abbr":"bxaa","explanation":"皑皑：洁白的样子，多用来形容霜雪。洁白的积雪银光耀眼。","source":{"text":"白雪皑皑的山峰，当阳光照耀的时候……大概总以为是灿烂得很，大可观赏的吧。","book":"秦牧《鲜荔枝和干荔枝》"},"example":{"text":"王朔《许爷》：“日本风景都是那么秀丽，天空都是那么清澈，他看到～的富士山了么？”"},"similar":["银妆素裹"],"usage":"作宾语、定语；多用来形容霜雪"},{"id":32675,"word":"白雪阳春","pinyin":"bái xuě yáng chūn","abbr":"bxyc","explanation":"原指战国时代楚国的一种较高级的歌曲。比喻高深的不通俗的文学艺术。","source":{"text":"其为《阳阿》、《薤露》，国中属而和者数百人，其为《阳春》、《白雪》，国中属而和者不过数十人而已。","book":"战国·楚·宋玉《对楚王问》"},"example":{"text":"高山流水千年调，～万古情。","book":"崔时佩《西厢记·琴心写恨》"},"similar":["阳春白雪"],"usage":"作主语、宾语；指文学作品"},{"id":32676,"word":"白雪难和","pinyin":"bái xuě nán hé","abbr":"bxnh","explanation":"白雪：指楚国一首歌曲名。比喻高深的不通俗的艺术。","source":{"text":"闻道仙郎歌白雪，由来此曲和人稀。","book":"唐·岑参《和祠部王员外雪后早朝邵事》"},"example":{"text":"这幅抽象画，对一般人来说都是～。"}},{"id":32677,"word":"白面书生","pinyin":"bái miàn shū shēng","abbr":"bmss","explanation":"指缺乏阅历经验的读书人。也指面孔白净的读书人。","source":{"text":"陛下今欲伐国，而与白面书生辈谋之，事何由济。","book":"《宋书·沈庆之传》"},"example":{"text":"雪儿呵，偏则把～奚落。","book":"明·汤显祖《牡丹亭》第二十二出"},"similar":["文弱书生"],"opposite":["彪形大汉"],"usage":"作谓语、宾语、定语；形容人阅历少","story":["南北朝时期，宋文帝要向北方扩展疆土，派王云谟等人督师北伐，沈庆之一再向文帝规劝，力陈以前北伐失败的教训，文帝很扫兴，便叫几个文官与他争辩出兵事宜。沈庆之说治国与治家一样，耕当问奴，织当访婢，跟白面书生说这些没有用的"]},{"id":32678,"word":"白面书郎","pinyin":"bái miàn shū láng","abbr":"bmsl","explanation":"犹白面书生。指只知读书，阅历少，见识浅的读书人。有时含贬义。亦泛指读书人。","source":{"text":"昔为白面书郎去，今作苍颜赞善来。","book":"唐·白居易《重过秘书旧房因题长句》"},"similar":["白面书生"],"usage":"作主语、宾语、定语；同“白面书生”"},{"id":32679,"word":"白面儒冠","pinyin":"bái miàn rú guān","abbr":"bmrg","explanation":"犹白面书生。指只知读书，阅历少，见识浅的读书人。有时含贬义。亦泛指读书人。","source":{"text":"白面儒冠已问津，生涯只羡五侯宾。萧萧黄叶空村畔，可有摊书闭户人？","book":"清·龚自珍《己亥杂诗》之八四"},"similar":["白面书生"],"usage":"作主语、宾语、定语；同“白面书生”"},{"id":32680,"word":"白面儒生","pinyin":"bái miàn rú shēng","abbr":"bmrs","explanation":"犹白面书生。指只知读书，阅历少，见识浅的读书人。有时含贬义。亦泛指读书人。","source":{"text":"温详之徒，皆白面儒生，乌合为群，徒恃长河以自固；若大军济河，必望旗震坏，不待战也。","book":"《资治通鉴·晋孝武帝太元十二年》"},"similar":["白面儒冠","白面书生"],"usage":"作主语、宾语、定语；同“白面书生”"},{"id":32681,"word":"白饭青刍","pinyin":"bái fàn qīng chú","abbr":"bfqc","explanation":"白饭供客，青草喂马。比喻主人招待周到。","source":{"text":"白饭青刍。赤脚长须。客来时、酒尽重沽。","book":"唐·杜甫《入奏行赠西山检察使窦侍御诗》：“为君酤酒满眼酤，与奴白饭马青刍。”宋·辛弃疾《行香子》词"},"example":{"text":"～，待仆马之厚；炊金爨玉，谢款客之隆。","book":"明·程登吉《幼学琼林·饮食》"}},{"id":32682,"word":"白首一节","pinyin":"bái shǒu yī jié","abbr":"bsyj","explanation":"指年虽老而志节不衰。","source":{"text":"窃见臣府西曹掾齐国吴良资质敦固，公方廉恪，躬俭安贫，白首一节。","book":"《后汉书·吴良传》"},"opposite":["晚节不终"],"usage":"作谓语、定语；指人的志向"},{"id":32683,"word":"白首不渝","pinyin":"bái shǒu bù yú","abbr":"bsby","explanation":"渝：改变。白头到老也不变。形容人一生忠诚、坚定。","source":{"text":"新除侍中何点，栖迟衡泌，白首不渝。","book":"《梁书·何点传》"},"usage":"作谓语、宾语；用于人的信念等"},{"id":32684,"word":"白首为郎","pinyin":"bái shǒu wéi láng","abbr":"bswl","explanation":"慨叹虽有才能而至老不遇。","source":{"text":"《汉武故事》载：武帝尝至郎署，见郎官颜驷“须鬓皓白，衣服不整”。武帝问他：“何时为郎？”答道：“以文帝时为郎。”武帝又问为什么“老而不遇”？他回答说：“文帝好文而臣尚武，景帝好老而臣尚少，陛下好少而臣已老，是以三世不遇。"},"example":{"text":"孤臣曾趣龙墀对，～只自伤。","book":"宋·陆游《史院书事》诗"},"similar":["白首郎官"],"usage":"作宾语、定语；指怀才不遇","story":["西汉时期，汉武帝去巡视郎署，见到两鬓斑白的郎官颜驷，就问他何时为郎官。颜驷说汉文帝时就当郎官了，汉武帝问他为什么老而不遇？他说：“文帝好文而臣尚武，景帝好老而臣尚少，陛下好少而臣已老，所以我至今还是一个郎官。”"]},{"id":32685,"word":"白首之心","pinyin":"bái shǒu zhī xīn","abbr":"bszx","explanation":"老年时的壮志。","source":{"text":"老当益壮，宁移白首之心？穷且益坚，不坠青云之志。","book":"唐·王勃《滕王阁序》"},"example":{"text":"你不会明白他的～的。"},"similar":["老当益壮"],"usage":"作宾语；用于老年人"},{"id":32686,"word":"白首北面","pinyin":"bái shǒu běi miàn","abbr":"bsbm","explanation":"北面：古以南面为尊，北面为卑，此指学生敬师之礼。谓年老犹拜师受业。","source":{"text":"夫子十五为人师焉，陈留王孝逸先达之傲者也，然白首北面岂以年乎？","book":"《文中子·立命》"},"similar":["好学不倦"],"usage":"作谓语；形容好学不倦"},{"id":32687,"word":"白首同归","pinyin":"bái shǒu tóng guī","abbr":"bstg","explanation":"归：归向、归宿。一直到头发白了，志趣依然相投。形容友谊长久，始终不渝。后用以表示都是老人而同时去世。","source":{"text":"春荣谁不慕，岁寒良独希；投分寄石友，白首同所归。","book":"晋·潘岳《金谷集作诗》"},"example":{"text":"当君～日，是我青山独往时。","book":"唐·白居易《九年十一月十一日感事而作》诗"},"usage":"作谓语、定语；指同死","story":["晋朝时期，中书令孙秀看中大富豪石崇的爱妾绿珠，想要占为己有。绿珠至死不从。孙秀假传诏书逮捕石崇。孙秀记恨潘岳小时用鞭子打过他，于是将潘岳也逮捕与石崇一并处死。正中了潘岳《金谷集作诗》：“投分寄石友，白首同所归。”"]},{"id":32688,"word":"白首如新","pinyin":"bái shǒu rú xīn","abbr":"bsrx","explanation":"指相交虽久而并不知己，像新知一样。同“白头如新”。","source":{"text":"古人有言曰：‘白首如新，倾盖如故。’言以身托人，必择所安。孟德视仆，岂惜此尺寸之士哉，特以公非所托故也。","book":"宋·苏轼《拟孙权答曹操书》"},"similar":["白头如新"],"usage":"作谓语、定语；形容人相识已久但不相知"},{"id":32689,"word":"白首如新，倾盖如故","pinyin":"bái shǒu rú xīn，qīng gài rú gù","abbr":"bsrxqgrg","explanation":"白首：老年；倾盖：停车，初见。有人相识到老还是不怎么了解，有人初次见面却一见如故。","source":{"text":"古人有言曰：‘白首如新，倾盖如故。’言以身托人，必择所安。","book":"宋·苏轼《拟孙权答曹操书》"},"similar":["白头如新，倾盖如旧"],"usage":"作宾语、定语、分句；指人的交情"},{"id":32690,"word":"白首无成","pinyin":"bái shǒu wú chéng","abbr":"bswc","explanation":"白首：白头，指年老。头发白了，一事无成。指到老没有成就。","source":{"text":"名场蹭蹬，几白首以无成，宦海漂流，顾青衫而自笑。","book":"宋·陆游《谢钱参政启》"},"similar":["白首空归"],"usage":"作谓语、定语；指人没作为"},{"id":32691,"word":"白首相庄","pinyin":"bái shǒu xiāng zhuāng","abbr":"bsxz","explanation":"指夫妇到老犹相敬爱。","source":{"text":"近年吴中申王二相公，亦于夫人白首相庄，不敢有二色。","book":"明·沈德符《野获编·勋戚·惧内》"},"example":{"text":"承德公老于场屋，不事生产，朝齑暮盐，黾勉有无，～，有鸡鸣馌耕之德，此夫人之为妻也。","book":"清·钱谦益《诰封安人熊母皮夫人墓志铭》"},"similar":["白首齐眉"],"usage":"作谓语、定语；指老年夫妻"},{"id":32692,"word":"白首相知","pinyin":"bái shǒu xiāng zhī","abbr":"bsxz","explanation":"白首：白头发，引申为时间长。意谓老年知己。","source":{"text":"君家朋友何须道，翻腾云雨都常套，抵多少白发相知，按剑同袍。","book":"明·孙仁儒《东郭记·顽夫廉》"},"example":{"text":"他终于找到了他的～。"},"usage":"作宾语；指老年知己"},{"id":32693,"word":"白首穷经","pinyin":"bái shǒu qióng jīng","abbr":"bsqj","explanation":"直至年纪老了还在钻研经籍，犹言活到老，学到老。","source":{"text":"白首穷经通秘义，青山养老度危时。","book":"唐·韩偓《赠易卜崔江处士》"},"example":{"text":"兹予绩服之初，日思讲议之益，谓～之乐，尚可推以与人。","book":"宋·苏辙《范镇可侍读太一宫使告词》"},"similar":["好学不倦"],"usage":"作谓语、定语；指勤学"},{"id":32694,"word":"白首空归","pinyin":"bái shǒu kōng guī","abbr":"bskg","explanation":"白了头发，空手回来。比喻年纪已老，学无成就。","source":{"text":"今耆儒年逾六十，去离本土，营求粮资，不得专业。结童入学，白首空归。","book":"《后汉书·献帝纪》"},"similar":["老而无成","白首无成"],"usage":"作谓语；指没有作为"},{"id":32695,"word":"白首黄童","pinyin":"bái shǒu háng tóng","abbr":"bsht","explanation":"白首：老人；黄童：儿童。指老老少少。","source":{"text":"卿士庶人，黄童白叟，踊跃欢呀，失熹噎欧。","book":"唐·韩愈《元和圣德诗》"},"example":{"text":"仰赖圣德仁慈，～，焚香顶礼，俺永享快乐也。","book":"明·无名氏《衣锦还乡》第四折"}},{"id":32696,"word":"白首齐眉","pinyin":"bái shǒu qí méi","abbr":"bsqm","explanation":"犹白首相庄。指夫妇到老犹相敬爱。","source":{"text":"邹夫人白首齐眉，然晚岁丧明，家计亦薄。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录二》"},"similar":["白首相庄"],"usage":"作谓语、定语；指老年夫妻"},{"id":32697,"word":"白马素车","pinyin":"bái mǎ sù chē","abbr":"bmsc","explanation":"驾白马，乘素车。传说伍子胥被害后，化作涛神，其魂魄常驾白马素车来往于江水之中。后一般来代称“钱塘潮”。也指丧事用的车马。","source":{"text":"子婴即系颈以组，白马素车，奉天子玺符降轵道旁。","book":"《史记·秦始皇本纪》"},"example":{"text":"滔天力倦知何事，～东去。","book":"宋·辛弃疾《摸鱼儿·观潮上叶丞相》"},"similar":["素车白马"],"usage":"作宾语、定语；指钱塘江潮","story":["春秋时期，吴王夫差不听伍子胥的劝告，同越王勾践和好，并且听信谗言，赐剑让伍子胥自尽，将他的尸首抛入江中，从此江中波涛汹涌，从海门山滚滚而来，越过钱塘鱼浦，波浪才减弱。早晚有时可以看到伍子胥乘白马素车站在潮头"]},{"id":32698,"word":"白驹空谷","pinyin":"bái jū kōng gǔ","abbr":"bjkg","explanation":"白驹：白色骏马，比喻贤能者。比喻贤能之人在野而不能出仕。后也比喻贤能者出仕而谷空。","source":{"text":"皎皎白驹，在彼空谷。","book":"《诗经·小雅·白驹》"},"example":{"text":"我本渔樵，不是～。 （元·刘因《风中柳·饮山亭留宿》）"},"usage":"作宾语；指能人不得志"},{"id":32699,"word":"白驹过隙","pinyin":"bái jū guò xì","abbr":"bjgx","explanation":"白驹：白色骏马，比喻太阳；隙：缝隙。象小白马在细小的缝隙前跑过一样。形容时间过得极快。","source":{"text":"《庄子·知北游》“人生天地之间，若白驹之过卻，忽然而已。”"},"example":{"text":"～，日月穿梭，才见梅开腊底，又早天气回阳。","book":"明·兰陵笑笑生《金瓶梅词话》第二回"},"similar":["光阴似箭","日月如梭"],"opposite":["度日如年"],"usage":"作宾语；比喻时光飞快流逝","story":["古代圣人孔子一次专程去向老子请教什么是“至道”，老子要孔子斋戒沐浴，说道：“人的寿命是极为短暂的，好像白马驰过狭窄的空隙，一闪即逝。死是人从有形转化为无形，道即精神可以永远留在人世之间。”"]},{"id":32700,"word":"白骨再肉","pinyin":"bái gǔ zài ròu","abbr":"bgzr","explanation":"白骨上再生出肉来。比喻起死回生。","source":{"text":"十娘怜悯客人，存其死命，可谓白骨再肉，枯树重花。","book":"唐·张文成《游仙窟》"},"example":{"text":"清·荻岸山人《平山冷燕》第五回：“乃复辱令爱小姐疏救，霁天子之威，使～，此天地父母所不能施之恩。”"},"similar":["起死回生"],"usage":"作宾语、定语；用于书面语"},{"id":32701,"word":"白骨露野","pinyin":"bái gǔ lù yě","abbr":"bgly","explanation":"露：暴露。死人的白骨暴露在野外。形容战争或灾难所赞成的悲剧景象。","source":{"text":"白骨露于野，千里无鸡鸣。","book":"三国·魏·曹操《蒿里行》诗"},"similar":["尸横遍野","白骨累累"],"usage":"作宾语、定语；指死人多"},{"id":32702,"word":"白鱼入舟","pinyin":"bái yú rù zhōu","abbr":"byrz","explanation":"比喻用兵必胜的征兆。","source":{"text":"武王渡河，中流，白鱼跃入王舟中，武王俯取以祭……诸侯皆曰：‘纣可伐矣。’","book":"《史记·周本纪》"},"example":{"text":"武王～，君臣变色。","book":"《三国志·魏书·杨阜传》"},"similar":["白鱼登舟"],"usage":"作定语、分句；形容好兆头开始"},{"id":32703,"word":"白鱼登舟","pinyin":"bái yú dēng zhōu","abbr":"bydz","explanation":"为殷亡周兴之兆。同“白鱼入舟”。","source":{"text":"谓武王伐殷而鱼入王舟，象征而必获，故曰顺也。","book":"《汉书·终军传》：“盖六鶂退飞，逆也；白鱼登舟，顺也。”颜师古注引臣瓒曰"},"similar":["白鱼入舟"],"usage":"作定语、分句；形容好兆头开始"},{"id":32704,"word":"白鱼赤乌","pinyin":"bái yú chì wū","abbr":"bycw","explanation":"为祥瑞之兆。","source":{"text":"武王渡河，中流，白鱼跃入王舟中，武王俯取以祭。既渡，有火自上复于下，至于王屋，流为乌，其色赤，其声魄云。","book":"《史记·周本纪》"},"example":{"text":"～之符，黄金紫玉之瑞，事丰奇伟，辞富膏腴，无益经典而有助文章。","book":"南朝·梁·刘勰《文心雕龙·正纬》"},"similar":["白鱼入舟"],"usage":"作宾语、定语；指好兆头"},{"id":32705,"word":"白鹤晾翅","pinyin":"bái hè liàng chì","abbr":"bhlc","explanation":"太极拳的一个拳式，动作像站定的白鹤张开翅膀晾着。","example":{"text":"她来了一个～的动作。"},"similar":["白鹤展翅"],"usage":"作宾语、定语；形容人的动作"},{"id":32706,"word":"白黑不分","pinyin":"bái hēi bù fēn","abbr":"bhbf","explanation":"比喻清浊混乱，是非不明。","source":{"text":"今贤不肖浑淆，白黑不分，邪正杂糅，忠谗并进。","book":"东汉·班固《汉书·刘向传》"},"example":{"text":"你不能这样～吧。"},"similar":["是非不分","黑白不分","泾渭不分"],"opposite":["黑白分明","是非分明","泾渭分明"],"usage":"作谓语、定语；指是非不分"},{"id":32707,"word":"白黑分明","pinyin":"bái hēi fēn míng","abbr":"bhfm","explanation":"比喻是非分得清楚。","source":{"text":"所贬退称进，白黑分明。","book":"汉·董仲舒《春秋繁露·保位权》：“黑白分明，然后民知所去就。”《汉书·薛宣传》"},"example":{"text":"经过辩论，事情谁是谁非，已经～。"},"similar":["黑白分明"],"opposite":["黑白不分"],"usage":"作谓语、定语；指界限分明"},{"id":32708,"word":"白黑颠倒","pinyin":"bái hēi diān dǎo","abbr":"bhdd","explanation":"颠倒：错乱。指白黑不分、是非颠倒。","source":{"text":"王不明察，遂辜无罪，是白黑颠倒，上下错谬也。","book":"西汉·刘向《列女传·楚成郑瞀》"},"example":{"text":"他经常是～、混淆是非。"},"similar":["白黑不分"],"opposite":["黑白分明"],"usage":"作宾语、定语；指人缺乏判断能力或故意所为"},{"id":32709,"word":"白齿青眉","pinyin":"bái chǐ qīng méi","abbr":"bcqm","explanation":"指青少年时期。","source":{"text":"忆昨与君发长安，白齿青眉吐肺肝。","book":"明·袁宏道《哭临漳令王子声》诗"},"usage":"作宾语、定语；指青少年时期"},{"id":32710,"word":"白龙微服","pinyin":"bái lóng wēi fú","abbr":"blwf","explanation":"比喻贵人微服出行，恐有估计不到的灾祸。","source":{"text":"昔白龙下清泠之渊，化为鱼。渔者豫且射中其目。","book":"西汉·刘向《说苑·正谏》"},"example":{"text":"秋草木兰驰道静，～记为鱼。","book":"清·黄遵宪《和钟西耘庶常津门感怀诗》"},"similar":["白龙鱼服"],"usage":"作谓语；指贵人微服出巡","story":["传说白龙下到清凉的深渊里，变成一条鱼。渔人豫且用鱼叉射中它的眼睛。白龙负伤，去向天帝告状。天帝问他当时在何处是什么样的状态，白龙回答自己在深渊里歇凉时变成鱼的形状受伤的。天帝说鱼本来就是让人射的，不能怪罪豫且"]},{"id":32711,"word":"白龙鱼服","pinyin":"bái lóng yú fú","abbr":"blyf","explanation":"鱼服：穿起鱼的外衣。白龙化为鱼在渊中游。比喻帝王或大官吏隐藏身分，改装出行。","source":{"text":"白龙鱼服，见困豫且。","book":"汉·刘向《说苑·正谏》：“昔日龙下清冷之渊，化为鱼，渔者豫且射中其目。” 汉·张衡《东京赋》"},"example":{"text":"相公～，隐姓潜名。倘或途中小辈不识高低，有毁相公者，何以处之？","book":"明·冯梦龙《警世通言》卷四"},"similar":["微服私巡","白龙微服"],"usage":"作谓语；指贵人微服出巡","story":["传说白龙下到清凉的深渊里，变成一条鱼。渔人豫且用鱼叉射中它的眼睛。白龙负伤，去向天帝告状。天帝问他当时在何处是什么样的状态，白龙回答自己在深渊里歇凉时变成鱼的形状受伤的。天帝说鱼本来就是让人射的，不能怪罪豫且"]},{"id":32712,"word":"百万买宅，千万买邻","pinyin":"bǎ wàn mǎi zhái，qiān wàn mǎi lín","abbr":"bwmzqwml","explanation":"比喻好邻居千金难买。","source":{"text":"宋季雅罢南康郡，市宅居僧珍宅侧。僧珍问宅价。曰：‘一千一百万。’怪其贵。季雅曰：‘一百万买宅，千万买邻。’","book":"《南史·吕僧珍传》"},"example":{"text":"～，人生孰若安居之乐？","book":"宋·辛弃疾《新居上梁》"},"similar":["千金买邻"],"usage":"作分句；指好邻居很难得","story":["南朝梁萧衍时期，平固侯吕僧珍非常有学问，对人谦虚诚恳，很多人愿意与他交往。南康郡太守宋季雅任期已到回京城等待安排，就花1100万钱买下吕僧珍旁边的宅子。吕僧珍问他为什么出此高价，宋说“一百万买宅，千万买你这个邻居。”"]},{"id":32713,"word":"百万雄兵","pinyin":"bǎi wàn xióng bīng","abbr":"bwxb","explanation":"人数众多、威武雄壮的军队。同“百万雄师”。","source":{"text":"束发领西藩。百万雄兵掌握间，召到庙堂无一事，遭弹。","book":"宋·赵葵《南乡子》词"},"similar":["百万雄师"],"opposite":["兵微将寡"],"usage":"作主语、宾语、定语；形容人数多"},{"id":32714,"word":"百万雄师","pinyin":"bǎi wàn xióng shī","abbr":"bwxs","explanation":"为数众多、威武雄壮的军队。","source":{"text":"百万雄师，莫可以前。","book":"宋·张载《庆州大顺城记》"},"example":{"text":"钟山风雨起苍茫，～过大江。","book":"毛泽东《七律·人民解放军占领南京》"},"similar":["百万雄兵"],"opposite":["兵微将寡","残兵败将"],"usage":"作主语、宾语、定语；形容人数多"},{"id":32715,"word":"百丈竿头","pinyin":"bǎi zhàng gān tóu","abbr":"bzgt","explanation":"佛教语，百丈高的竿子，比喻道行达到很高境界。","source":{"text":"百丈竿头须进步，十方世界是全身。","book":"宋·释道原《景德传灯录·景岑禅师》"},"example":{"text":"～，不进则退。"},"similar":["百尺竿头"],"usage":"作宾语、定语；指人的技艺、修行等","story":["宋朝时期长沙高僧景岑佛学造诣高深，时常到各地去传道讲经，他讲得深入浅出，娓娓动听，听众与他谈论有关佛教的最高境界。他拿出偈帖给大家念道：“百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。”"]},{"id":32716,"word":"百下百全","pinyin":"bǎi xià bǎi quán","abbr":"bxbq","explanation":"犹言百发百中，万无一失。","source":{"text":"以将军材质之美，奋精兵，诛不轨，百下百全之道也。","book":"汉·班固《汉书·冯奉世传》"},"example":{"text":"虽孽竖跳梁，士力未完，宜厉兵粟马，乘无备，击不意，～。","book":"《新唐书·刘仁轨传》"},"similar":["百下百着","百发百中"],"opposite":["无的放矢"],"usage":"作谓语、定语；形容万无一失"},{"id":32717,"word":"百下百着","pinyin":"bǎi xià bǎi zháo","abbr":"bxbz","explanation":"犹言百发百中，万无一失。同“百下百全”。","source":{"text":"我每日送他一尾金色鲤，他就与我袖传一课。依方位，百下百着。","book":"明·吴承恩《西游记》第九回"},"similar":["百下百全"],"opposite":["无的放矢"],"usage":"作谓语、定语、补语；形容万无一失"},{"id":32718,"word":"百不一存","pinyin":"bǎi bù yī dài","abbr":"bbyc","explanation":"犹言无一宽免。","source":{"text":"后信之，诏于丽景门别置狱，敕俊臣等颛按事，百不一贷。","book":"《新唐书·酷吏传·来俊臣》"},"example":{"text":"《南史·蔡廓传附蔡兴宗》：“时士庶危惧，衣冠咸欲远徒，后皆流离外难，～。”"},"similar":["百无一存"],"opposite":["完好无损","安然无恙"],"usage":"作宾语、定语；指全部丧失"},{"id":32719,"word":"百不一爽","pinyin":"bǎi bù yī shuǎng","abbr":"bbys","explanation":"爽：失，差。形容做事有充分把握，绝不会失误。","source":{"text":"爽：失，差。形容做事有充分把握，绝不会失误。"},"similar":["百不失一"],"usage":"作谓语、定语；指很有把握"},{"id":32720,"word":"百不一贷","pinyin":"bǎi bù yī dài","abbr":"bbyd","explanation":"贷：饶恕，宽免。无一宽免","source":{"text":"后信之，诏于丽景门别置狱，敕俊臣等颛按事，百不一贷。","book":"《新唐书·来俊臣》"},"similar":["无一幸免"],"usage":"作谓语、定语；指全部"},{"id":32721,"word":"百不一遇","pinyin":"bǎi bù yī yù","abbr":"bbyy","explanation":"一百次中遇不到一次。形容极其难得。","source":{"text":"言立策成，终无咎悔，若此之事，百不一遇，其知之所见，万不及一也。","book":"汉·荀悦《汉纪·哀帝纪下》"},"similar":["百年难遇"],"opposite":["唾手可得"],"usage":"作谓语、定语；指难得"},{"id":32722,"word":"百不为多，一不为少","pinyin":"bǎi bù wéi duō，yī bù wéi shǎo","abbr":"bbwdybws","explanation":"指难得的好人或好东西。","source":{"text":"褚彦回尝谓遥曰：‘闻卿有令子，相为喜之。所谓百不为多，一不为少。’由是闻声藉甚。","book":"《南史·任昉传》"},"example":{"text":"然不难得则不足为佳物，古人亦云‘～’者，谓此也。","book":"宋·赵彦卫《云麓漫钞》卷十四"},"usage":"作谓语、定语、宾语；指好东西或人"},{"id":32723,"word":"百不失一","pinyin":"bǎi bù shī yī","abbr":"bbsy","explanation":"一百次中无一次失误。表示射箭或打枪命中率高，或做事有充分把握。","source":{"text":"从门应庭，听堂室之言，什而失九，如升堂窥室，百不失一。","book":"汉·王充《论衡·须颂》"},"example":{"text":"他把算子一动，便晓得这人姓名，穷通寿夭，～。","book":"明·凌濛初《初刻拍案惊奇》卷七"},"similar":["万无一失","百不一爽"],"usage":"作谓语、定语；指有十足的把握"},{"id":32724,"word":"百不当一","pinyin":"bǎi bù dāng yī","abbr":"bbdy","explanation":"当：抵挡。一百个抵挡不住一个。","source":{"text":"平易相远，山谷幽涧，仰高临下，此弓弩之地也，短兵百不当一。","book":"汉·荀悦《汉纪·文帝纪下》"},"opposite":["以一当百"],"usage":"作谓语、宾语；指无能之辈"},{"id":32725,"word":"百不得一","pinyin":"bǎi bù dé yī","abbr":"bbdy","explanation":"一百个里面也得不到一个。形容人或物的难得或所得极少。","source":{"text":"求其百首和鸣者，百不得一，何造物不均若是哉。","book":"清·李渔《笠翁文集·〈和鸣集〉序》"}},{"id":32726,"word":"百不获一","pinyin":"bǎi bù huò yī","abbr":"bbhy","explanation":"一百个里面也得不到一个。形容人或物的难得或所得极少。","source":{"text":"人品自会端正，文移自会清顺，晓畅，然着实是百不获一的。","book":"清·李绿园《歧路灯》第一百五回"},"usage":"作宾语、定语；指极其难得"},{"id":32727,"word":"百世一人","pinyin":"bǎi shì yī rén","abbr":"bsyr","explanation":"指极难得的人才。","source":{"text":"百世一人，千载一时，惟时与人，鲜偶常奇。","book":"宋·苏轼《祭司马君实文》"},"usage":"作宾语；指人才"},{"id":32728,"word":"百世不易","pinyin":"bǎi shì bù yì","abbr":"bsby","explanation":"千秋万代永不改变。","source":{"text":"积德累行，不知其善，有时而用；弃义背理，不知其恶，有时而亡。臣愿大王孰计而身行之，此百世不易之道也。","book":"《汉书·邹阳传》"},"similar":["一成不变"],"usage":"作谓语、定语；指永恒"},{"id":32729,"word":"百世不磨","pinyin":"bǎi shì bù mó","abbr":"bsbm","explanation":"名垂久远，永不磨灭。","source":{"text":"千里之差，兴自毫端，失得之源，百世不磨矣。","book":"《后汉书·南匈奴传论》"},"example":{"text":"吾立子名，百世不磨。","book":"唐·韩愈《送穷文》"},"similar":["永不磨灭"],"usage":"作谓语、宾语；指人的业绩及功劳"},{"id":32730,"word":"百世之利","pinyin":"bǎi shì zhī lì","abbr":"bszl","explanation":"世世代代长远的利益。","source":{"text":"文公曰：‘雍季之言，百世之利也。","book":"《吕氏春秋·义赏》"},"example":{"text":"然而为大王计者，皆为一时之说，不顾～。","book":"《史记·张仪列传》"},"usage":"作宾语；指长远利益"},{"id":32731,"word":"百世之师","pinyin":"bǎi shì zhī shī","abbr":"bszs","explanation":"世世代代的老师，指才德高尚而永远可为人师表的人。","source":{"text":"圣人，百世之师也，伯夷、柳下惠是也。","book":"先秦·孟轲《孟子·尽心下》"},"example":{"text":"卓为～；杰作雄辞，散落四夷之远。","book":"宋·陆游《贺薛安抚兼制置启》"},"similar":["百世师"],"usage":"作主语、宾语；指人的品行等"},{"id":32732,"word":"百世师","pinyin":"bǎi shì shī","abbr":"bss","explanation":"品德学问可以做为百代的表率。","source":{"text":"圣人，百世之师也。","book":"《孟子·尽心下》"},"example":{"text":"匹夫而为～，一言而为天下法。","book":"宋·苏轼《东坡后集·卷十五·潮州韩文公庙碑》"},"similar":["百世之师"],"usage":"作宾语、定语；指人的品行等"},{"id":32733,"word":"百世流芬","pinyin":"bǎi shì liú fēn","abbr":"bslf","explanation":"美名永传于后世。同“百世流芳”。","source":{"text":"予以生花之笔，撰为倒峡之词，使人人赞美，百世流芬。","book":"清·李渔《闲情偶寄·词曲·结构》"},"similar":["百世流芳"],"opposite":["遗臭万年"],"usage":"作谓语；指好名声"},{"id":32734,"word":"百世流芳","pinyin":"bǎi shì liú fāng","abbr":"bslf","explanation":"美名永传于后世。","source":{"text":"贱人不思忖，良家且淫奔。你既落烟花寨，休思百世流芳也。","book":"明·徐霖《绣襦记·逼娃逢迎》"},"example":{"text":"红旗半下悼英雄，～建大功。","book":"《杭州日报》1977.1.6"},"similar":["流芳百世","百世流芬"],"opposite":["遗臭万年"],"usage":"作谓语；指好名声"},{"id":32735,"word":"百业凋敝","pinyin":"bǎi yè diāo bì","abbr":"bydb","explanation":"百业：一切行业。指各行各业都很萧条，不兴旺。形容社会的衰败。"},{"id":32736,"word":"百业萧条","pinyin":"bǎi yè xiāo tiáo","abbr":"byxt","explanation":"萧条：冷落、凋敝。指各行各业都很冷落、不兴旺。形容社会的衰败。","source":{"text":"在一切蒋介石统治区域，贪污遍地，特务横行，捐税繁重，物价高涨，经济破产，百业萧条，征兵征粮，怨声载道。","book":"毛泽东《中国人民解放军宣言》"},"example":{"text":"东南亚的金融危机造成的～一时难以起死回生。"},"opposite":["百业兴旺"],"usage":"作谓语、定语；用于社会"},{"id":32737,"word":"百两烂盈","pinyin":"bǎi liàng làn yíng","abbr":"blly","explanation":"两：同“辆”；百辆：一百辆车；烂：灿烂；盈：充满。指妆奁有一百辆车，光彩耀眼，极其丰光。形容婚娶的铺张奢侈。","source":{"text":"百两彭彭，八鸾锵锵，不显其光。","book":"《诗经·大雅·韩奕》"},"example":{"text":"宋·胡继宗《书言故事·婚姻类》：“驾成婚得行奁，日～。”"},"usage":"作谓语、定语；指婚嫁盛况"},{"id":32738,"word":"百中百发","pinyin":"bǎi zhòng bǎi fā","abbr":"bzbf","explanation":"中：射中目标。发：发射。形容射箭、投掷或射击准确，每次都命中目标。也比喻做事有充分把握，从不落空。同“百发百中”。","source":{"text":"回陈桐闻脑后鸾铃响处，料是飞虎赶来，挂下画戟，取火龙标掌在手中，此标乃异人秘授，出手烟生，百中百发。","book":"明·许仲琳《封神演义》第三十一"},"similar":["百发百中"],"opposite":["无的放矢"],"usage":"作谓语、定语、补语；形容射击技术高明"},{"id":32739,"word":"百举百全","pinyin":"bǎi jǔ bǎi quán","abbr":"bjbq","explanation":"百：形容多；举：行动；全：完成。每次行动都能完成其事，形容事事得心应手，都能取得好的效果。","source":{"text":"百举百全，而功名可立也。","book":"《三国志·魏志·郭嘉传》"},"example":{"text":"圣人相时而动，～。","book":"《晋书·慕容德载记》"},"similar":["百举百捷"],"opposite":["屡战屡败"],"usage":"作谓语、宾语；指人很能干"},{"id":32740,"word":"百举百捷","pinyin":"bǎi jǔ bǎi jié","abbr":"bjbj","explanation":"做一百件事，成功一百件。指办事万无一失。同“百举百全”。","source":{"text":"鲂生在江淮，长于时事，见其便利，百举百捷。","book":"《三国志·吴志·周鲂传》"},"similar":["百举百全"],"opposite":["屡战屡败"],"usage":"作谓语、宾语；指人很能干"},{"id":32741,"word":"百乘之家","pinyin":"bǎi shèng zhī jiā","abbr":"bczj","explanation":"百乘：兵车百辆。指古代士大夫之家。","source":{"text":"百乘之家，不畜聚敛之臣。","book":"《礼记·大学》"}},{"id":32742,"word":"百了千当","pinyin":"bǎi liǎo qiān dāng","abbr":"blqd","explanation":"了：了结；当：妥当；百、千：指一切事。比喻事事妥贴，有着落。","source":{"text":"问：‘百了千当时如何？’师曰：‘不许夜行，投明须到。’","book":"宋·释道原《景德传灯录》卷十三"},"example":{"text":"不如屏净尘缘，竖起脊梁骨，著些精彩，究教七川八穴，～，向水边林下，长养圣胎，亦不枉受人天供养。","book":"宋·释惟白《续传灯录》"},"similar":["千当百了"],"usage":"作主语、宾语；指做事"},{"id":32743,"word":"百事大吉","pinyin":"bǎi shì dà jí","abbr":"bsdj","explanation":"指一切顺利；平安无事。","source":{"text":"宜入新年怎生呵，百事大吉那般者。","book":"宋·周密《癸辛杂识续集下·桃符获罪》"},"example":{"text":"然而献出了粟米麻线，果真就天下太平，～了么？","book":"聂绀弩《鲁迅——思想革命与民族革命的创导者》"},"similar":["万事大吉"],"opposite":["艰难曲折"],"usage":"作谓语、宾语、分句；带讽刺意味"},{"id":32744,"word":"百事无成","pinyin":"bǎi shì wú chéng","abbr":"bswc","explanation":"犹言一事无成。什么事情都没成功。","source":{"text":"更将何面上春台，百事无成老又催。","book":"唐·刘禹锡《陪崔大尚书及诸阁老宴杏园》诗"},"similar":["一事无成"],"opposite":["功成名就"],"usage":"作谓语、定语、状语；指毫无成就"},{"id":32745,"word":"百二关山","pinyin":"bǎi èr guān shān","abbr":"begs","explanation":"百二：以二敌百。指边防稳固的国家。","source":{"text":"百二关山扶玉座，五千文字闭瑶缄。","book":"唐·温庭筠《老君庙》"},"similar":["百二关河"],"usage":"作主语、宾语；指河山"},{"id":32746,"word":"百二关河","pinyin":"bǎi èr guān hé","abbr":"begh","explanation":"比喻山河险固之地。同“百二山河”。","source":{"text":"百二关河草不横，十年戎马暗秦京。","book":"金·元好问《岐阳》诗之二"},"similar":["百二山河"],"usage":"作主语、宾语；指河山"},{"id":32747,"word":"百二山川","pinyin":"bǎi èr shān chuān","abbr":"besc","explanation":"比喻山河险固之地。同“百二山河”。","source":{"text":"随人愿、照百二山川，照百二山川，一点金星瑞云里现。","book":"《全元散曲·新水令》"},"similar":["百二山河"],"usage":"作宾语、定语；指山河险固的地方"},{"id":32748,"word":"百二山河","pinyin":"bǎi èr shān hé","abbr":"besh","explanation":"百二：以二敌百。比喻山河险固之地。","source":{"text":"秦，形胜之国，带河山之险，县隔千里，持戟百万，秦得百二马。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"～同败絮，两三亲友各飘萍。","book":"宁调元《清明忆亡友姚宏业》"},"similar":["百二山川"],"usage":"作宾语、定语；指山河险固的地方"},{"id":32749,"word":"百二河山","pinyin":"bǎi èr hé shān","abbr":"behs","explanation":"百二：以二敌百。指山河险固，可以二敌百。后指国力强盛，边防稳固的国家。","source":{"text":"秦，形胜之国，带河山之险，悬隔千里，持戟百万，秦得百二焉。","book":"《史记·高祖本纪》"},"example":{"text":"护～，掌七十四司。","book":"元·郑廷玉《看钱奴》第四折"},"similar":["百二山河"],"usage":"作宾语；指边防稳固的国家"},{"id":32750,"word":"百二金瓯","pinyin":"bǎi èr jīn ōu","abbr":"bejo","explanation":"比喻山河险固之地。同“百二山河”。","source":{"text":"五千貂锦张旗鼓，百二金瓯资栋梁。","book":"宁调元《壬子感事》诗之三"},"similar":["百二关山"],"usage":"作主语、宾语；指河山"},{"id":32751,"word":"百代文宗","pinyin":"bǎi dài wén zōng","abbr":"bdwz","explanation":"宗：被人所效法的人物。在久远的年代里堪为文人楷模的人物。","source":{"text":"制曰：‘故足远超枚（枚乘）马（司马相如），……百代文宗，一人而已。’","book":"《晋书·陆机传》"},"usage":"作宾语；指文人"},{"id":32752,"word":"百代过客","pinyin":"bǎi dài guò kè","abbr":"bdgk","explanation":"指时间永远流逝。","source":{"text":"夫天地者，万物直逆旅也；光阴者，百代直过客也。","book":"唐·李白《春夜宴从弟桃花园序》"},"usage":"作宾语；指流逝的时光"},{"id":32753,"word":"百伶百俐","pinyin":"bǎi líng bǎi lì","abbr":"blbl","explanation":"形容非常聪明乖巧。","source":{"text":"那焦氏生得有六七分颜色，女工针指，却也百伶百俐；只是心有些狠素。","book":"明·马梦龙《醒世恒言》第二十七卷"},"similar":["聪明伶俐"],"opposite":["笨手笨脚"],"usage":"作谓语、定语；用于女性及儿童"},{"id":32754,"word":"百依百从","pinyin":"bǎi yī bǎi cóng","abbr":"bybc","explanation":"百：比喻很多；依：顺从；从：跟从。什么都依从。形容一味顺从。","source":{"text":"讨厌他过于粗暴鲁莽，常办错事，喜爱他忠实听话，百依百从。","book":"杨纤如《伞》"},"example":{"text":"对孩子～是不行的。"},"similar":["百依百顺","百依百随"],"opposite":["我行我素"],"usage":"作谓语、状语；形容无原则的迁就别人"},{"id":32755,"word":"百依百随","pinyin":"bǎi yī bǎi suí","abbr":"bybs","explanation":"形容什么都顺从。","source":{"text":"这颜婆惜被那张三小意儿百依百随，轻怜重惜，卖俏迎奸。","book":"明·施耐庵《水浒传》第21回"},"example":{"text":"茅大早摸透了七爷脾气，表面上各事～，且对金钱事尤其坦白分明。","book":"沈从文《王谢子弟》"},"similar":["百依百顺","服服贴贴"],"usage":"作谓语、定语；形容一切都顺从别人"},{"id":32756,"word":"百依百顺","pinyin":"bǎi yī bǎi shùn","abbr":"bybs","explanation":"依、顺：顺从。什么都依从。形容一切都顺从别人。","source":{"text":"做爷娘的百依百顺，没一事违拗了他。","book":"明·凌濛初《初刻拍案惊奇》第十三卷"},"example":{"text":"这安公子是那女孩儿一般～的人。","book":"清·文康《儿女英雄传》第三回"},"similar":["言听计从","千随百顺","唯命是从"],"opposite":["我行我素","刚愎自用","毫不迁就"],"usage":"作谓语、定语、状语；形容无原则迁就别人"},{"id":32757,"word":"百六阳九","pinyin":"bǎi liù yáng jiǔ","abbr":"blyj","explanation":"泛指灾难之年或厄运。","source":{"text":"《易》九厄曰：初入元，百六阳九。","book":"东汉·班固《汉书·律历志上》"},"example":{"text":"若夫后夫之政，未遭～，而于今日望之，一则晞民主，一则张议院，此无异于行未三十里而责其百里也。","book":"清·章炳麟《变法箴言》"},"usage":"作主语、宾语、定语；指厄运"},{"id":32758,"word":"百兽率舞","pinyin":"bǎi shòu shuài wǔ","abbr":"bssw","explanation":"各种野兽，相率起舞。旧指帝王修德，时代清平。","source":{"text":"於！予击石拊石，百兽率舞。","book":"《尚书·舜典》"},"example":{"text":"大礼告成，伺候各官，循例三呼，国乐以外，杂以军乐，仿佛有凤凰来仪，～景象。","book":"蔡东藩、许廑父《民国通俗演义》第三四回"},"similar":["歌舞升平"],"usage":"作谓语、定语；形容局面"},{"id":32759,"word":"百凡待举","pinyin":"bǎi fán dài jǔ","abbr":"bfdj","explanation":"无数事情都等待兴办。","source":{"text":"而沪军陈都督，复以民军倡义伊始，百凡待举，无总机关以代表全国，外人疑虑，交涉为难。","book":"平佚《临时政府成立记》"},"similar":["百端待举"],"usage":"作谓语、定语；用于事业刚举办或刚接办时"},{"id":32760,"word":"百务具举","pinyin":"bǎi wù jù jǔ","abbr":"bwjj","explanation":"各种事务全都兴办。","source":{"text":"在滇，百务具举。","book":"《明史·沐英传》"},"usage":"作谓语、定语；指局面"},{"id":32761,"word":"百动不如一静","pinyin":"bǎi dòng bù rú yī jìng","abbr":"bdbryj","explanation":"指多动不如静待有效。","source":{"text":"你去了，我又寻思，百动不如一静的。","book":"清·西周生《醒世姻缘传》第三十四回"},"similar":["以静制动"],"opposite":["以攻为守"],"usage":"作宾语、定语；指以静制动"},{"id":32762,"word":"百卉千葩","pinyin":"bǎi huì qiān pā","abbr":"bhqp","explanation":"常比喻事物丰富多彩，景象繁荣兴盛。","source":{"text":"仲冬佳节景堪褒，百卉千葩逞艳妖。","book":"明·无名氏《紫微宫》第二折"},"example":{"text":"公园内～争相吸引游人的目光。"},"usage":"作主语、宾语；形容景象繁荣兴盛"},{"id":32763,"word":"百卉含英","pinyin":"bǎi huì hán yīng","abbr":"bhhy","explanation":"卉：草的总称；英：花。各种各样的草都含着花朵。形容冬去春回，花草争妍的景色。","source":{"text":"开岁发春兮，百卉含英。","book":"《后汉书·冯愆传》"},"similar":["百花盛开"],"usage":"作谓语、定语；指春天"},{"id":32764,"word":"百发百中","pinyin":"bǎi fā bǎi zhòng","abbr":"bfbz","explanation":"形容射箭或打枪准确，每次都命中目标。也比喻做事有充分把握。","source":{"text":"楚有养由基者，善射，去柳叶百步而射之，百发百中。","book":"《战国策·西周策》"},"example":{"text":"回见子牙，叩头在地：“丞相妙计，～。”","book":"明·许仲琳《封神演义》第三十六回"},"similar":["弹无虚发","百步穿杨","百无一失"],"opposite":["无的放矢","百不一存"],"usage":"作谓语、定语、状语；形容射击技术高明","story":["春秋时期，楚国名将养由基跟随楚共王出兵援助郑国，楚共王要养由基用两枝箭射死晋国国君魏武，养由基一箭就结束。同行潘党不服，养由基三箭分别射中他们约定百步之外的三片杨树叶，让人不得不佩服"]},{"id":32765,"word":"百口同声","pinyin":"bǎi kǒu tóng shēng","abbr":"bkts","explanation":"大家所说的都一样。","source":{"text":"时已亭午，小珠跌坐坟下，哭个不住。末后秃头与跟人劝止，大众百口同声，小珠方停了哭，谢了善人村父老，就到秃头家来。","book":"清·魏秀仁《花月痕》第五十一回"},"example":{"text":"他们～，一致推选你为救险队长。"},"similar":["异口同声","众口一词"],"usage":"作谓语、状语；指说法一致"},{"id":32766,"word":"百口莫辩","pinyin":"bǎi kǒu mò biàn","abbr":"bkmb","explanation":"莫：不能；辩：辩白。即使有一百张嘴也辩白不清。形容不管怎样辩白也说不清楚。","source":{"text":"虽有百口而莫辩其辜。","book":"宋·刘过《建康狱中上吴居父》"},"example":{"text":"玉林和忠和醒悟了，一打便是祸事，若是李三顺身上有了伤，便～，“官司”非输不可。","book":"高阳《清宫外史》上册"},"similar":["有口难辩"],"usage":"作谓语；形容有口难辩"},{"id":32767,"word":"百口难分","pinyin":"bǎi kǒu nán fēn","abbr":"bknf","explanation":"即使有一百张嘴也辩白不清。形容不管怎样辩白也说不清楚。","source":{"text":"虽有百口而莫辩其辜。","book":"宋·刘过《建康狱中上吴居父》"},"example":{"text":"这薄幸两字，我也～了。","book":"清·魏子安《花月痕》第三回"},"similar":["百喙莫辩"],"usage":"作谓语；形容有口难辩"},{"id":32768,"word":"百听不厌","pinyin":"bǎi tīng bù yàn","abbr":"btby","explanation":"形容乐曲或歌曲好听，使人听多少遍也不厌烦。","source":{"text":"这首歌真是～。"},"example":{"text":"这首歌真是～"},"similar":["脍炙人口"],"usage":"作谓语、定语；指诗歌、故事、歌曲等"},{"id":32769,"word":"百品千条","pinyin":"bǎi pǐn qiān tiáo","abbr":"bpqt","explanation":"指繁多的名目。","source":{"text":"又订出雄雉头、鹤氅、白鹭縗，百品千条，无复穷已。","book":"《南史·齐纪下·废帝东昏侯》"},"similar":["名目繁多"],"usage":"作宾语、定语；指种类多"},{"id":32770,"word":"百啭千声","pinyin":"bǎi zhuàn qiān shēng","abbr":"bzqs","explanation":"形容鸟鸣声婉转多样。","source":{"text":"百啭千声随意移，山花红紫树高低。始知锁向金笼听，不及林间自在啼。","book":"宋·欧阳修《画眉鸟》诗"},"usage":"作主语、宾语；指鸟叫声"},{"id":32771,"word":"百喙一词","pinyin":"bǎi huì yī cí","abbr":"bhyc","explanation":"犹言众口一辞。同“百喙如一”。","source":{"text":"儒者百喙一词，言伏生《尚书》二十八篇。","book":"清·龚自珍《大誓答问第一》"},"similar":["百喙如一","众口一词"],"opposite":["众说纷纭"],"usage":"作谓语、定语；指众口一词"},{"id":32772,"word":"百喙如一","pinyin":"bǎi huì rú yī","abbr":"bhry","explanation":"犹言众口一辞。许多人都说同样的话，看法或意见一致。","source":{"text":"唯习闻湘人之言，百喙如一者若此。","book":"清·王夫之《孝烈传》"},"similar":["百喙一词"],"opposite":["众说纷纭"],"usage":"作谓语、定语；指众口一词"},{"id":32773,"word":"百喙莫明","pinyin":"bǎi huì mò míng","abbr":"bhmm","explanation":"喙：嘴；莫：不能。即使有一百张嘴也辩白不清。形容有冤难伸。","source":{"text":"谤出事情之外，百喙莫明。","book":"宋·陈亮《谢何正言启》"}},{"id":32774,"word":"百喙莫辩","pinyin":"bǎi huì mò biàn","abbr":"bhmb","explanation":"喙：嘴，借指人的嘴。指纵有众多的嘴也不能辩解。同“百口莫辩”。","source":{"text":"谤出事情之外，百喙莫辩；变生意料之余，三肱并折。","book":"宋·陈亮《谢何正言启》"},"example":{"text":"素臣一段议论，如老吏断狱，使刘邦～。","book":"清·夏敬渠《野叟曝言》第七十一回"},"similar":["百口莫辩"],"usage":"作谓语；形容有口难辩"},{"id":32775,"word":"百喙难辞","pinyin":"bǎi huì nán cí","abbr":"bhnc","explanation":"喙：嘴，借指人的嘴。指纵有众多百口也很难解释。","source":{"text":"江自以卖城之罪百喙难辞，因乘间自尽。","book":"清·夏燮《中西纪事·江上议款》"},"example":{"text":"刘棻等已被扳入，～，遂都连坐罔上不道的罪名，谳成死罪。","book":"蔡东藩《后汉演义》第一回"},"similar":["百喙莫辩"],"usage":"作谓语、定语；指不好推辞"},{"id":32776,"word":"百喙难辩","pinyin":"bǎi huì nán biàn","abbr":"bhnb","explanation":"喙：嘴，借指人的嘴。指纵有众多百口也很难辩解。同“百口莫辩”。","source":{"text":"此时证据显然，百喙难辩。荣复证成延广罪案十条，每服一事，即授一筹。","book":"蔡东藩《五代史演义》第三十六回"},"example":{"text":"这事真让～。"},"similar":["百喙莫辩"],"usage":"作谓语、定语；形容有口难辩"},{"id":32777,"word":"百城之富","pinyin":"bǎi chéng zhī fù","abbr":"bczf","explanation":"形容藏书极多，似拥有许多城市那样富有。","source":{"text":"丈夫拥书万卷，何假南面百城。","book":"语出《魏书·李谧传》"},"example":{"text":"强解事者，以数百金捆载坊书，便称～。","book":"清·黄宗羲《天一阁藏书记》"},"similar":["坐拥百城"],"usage":"作宾语；指藏书多"},{"id":32778,"word":"百堕俱举","pinyin":"bǎi huī jù jǔ","abbr":"bhjj","explanation":"堕：荒废；废弃。指一切废置的事都兴办起来。同“百废俱兴”。","source":{"text":"在边三年，百堕俱举，而刊有《延吉边务报告》四册，则其客江阴章钟祚搜辑禄贞在边之书牍也。","book":"钱基博《吴禄贞传》"},"similar":["百废俱兴","百废咸举"],"usage":"作谓语、定语；形容建设事业兴旺发达"},{"id":32779,"word":"百堵皆作","pinyin":"bǎi dǔ jiē zuò","abbr":"bdjz","explanation":"堵：墙；作：兴建。许多房屋同时建造。","source":{"text":"之子于垣，百堵皆作。虽则劬劳，其究安宅。","book":"《诗经·小雅·鸿雁》"},"usage":"作宾语；指许多房屋同时兴建"},{"id":32780,"word":"百堵皆兴","pinyin":"bǎi dǔ jiē xīng","abbr":"bdjx","explanation":"堵：墙。许多房屋同时建造。","source":{"text":"之子于垣，百堵皆作。虽则劬劳，其究安宅。","book":"《诗经·小雅·鸿雁》"}},{"id":32781,"word":"百媚千娇","pinyin":"bǎi mèi qiān jiāo","abbr":"bmqj","explanation":"媚、娇：美好。形容女子姿态美好。","source":{"text":"千娇百媚，造次无可比方；弱体轻身，谈之不能备尽。","book":"南朝·陈·徐陵《杂曲》诗：“绿黛红颜两相发，千娇百态情无歇。”唐·张文成《游仙窟》"},"example":{"text":"倾国倾城，～。","book":"元·孔文昇《折桂令·赠千金奴》"},"similar":["千娇百媚"],"opposite":["面目可憎"],"usage":"作谓语、定语、状语；形容貌美可爱"},{"id":32782,"word":"百孔千创","pinyin":"bǎi kǒng qiān chuāng","abbr":"bkqc","explanation":"比喻困苦不堪。同“百孔千疮”。","source":{"text":"黎庶凋瘵，百孔千创。","book":"宋·周必大《跋宋运判昞奏稿》"},"example":{"text":"一方赛会，万户供张，竟有勉强支持，百端借贷而入会者；亦有典衣粜米，～而入会者。","book":"清·钱泳《履园丛话·笑柄·恶俗》"},"similar":["百孔千疮"],"opposite":["完美无缺"],"usage":"作谓语、定语、状语；形容社会受到严重破坏"},{"id":32783,"word":"百孔千疮","pinyin":"bǎi kǒng qiān chuāng","abbr":"bkqc","explanation":"比喻毛病很多，问题严重，已经到了难以收拾的地步。","source":{"text":"汉室以来，群儒区区修补，百孔千疮，随乱随失，其危如一发引千钧。","book":"唐·韩愈《与孟尚书书》"},"example":{"text":"他身上的缺点虽然不少，但却不是～，不可救药。"},"similar":["满目疮痍","遍体鳞伤","残缺不全"],"opposite":["完美无缺","十全十美","无懈可击"],"usage":"作谓语、定语；形容社会受到严重破坏"},{"id":32784,"word":"百宝万货","pinyin":"bǎi bǎo wàn huò","abbr":"bbwh","explanation":"指大量珍宝财物。","source":{"text":"天下法宗礼，族归心，鬼归祀，大川归道，百宝万货，人功精英，不翼而飞，府于京师。","book":"清·龚自珍《尊隐》"},"usage":"作主语、宾语、定语；指财物"},{"id":32785,"word":"百家争鸣","pinyin":"bǎi jiā zhēng míng","abbr":"bjzm","explanation":"指各种学术流派的自由争论互相批评。也指不同意见的争论。百家，这种观点的人或各种学术派别。鸣，发表见解。","source":{"text":"《汉书·艺文志》“凡诸子百八十九家……蜂出并作，各引一端，崇其所说，以此弛说，取舍诸候。”"},"example":{"text":"自春秋末年以来，中国的思想得到一个极大的开放，呈现出一个～的局面。","book":"郭沫若《吕不韦与秦王政的批判》"},"similar":["各抒己见","畅所欲言"],"opposite":["噤若寒蝉","强求一律","一家之言"],"usage":"作谓语、宾语、定语；比喻允许各种学术流派"},{"id":32786,"word":"百家诸子","pinyin":"bǎi jiā zhū zǐ","abbr":"bjzz","explanation":"百家：指儒家、道家、墨家、法家等流派；诸子：指孔子、老子、庄子、荀子等。后来对先秦学术思想派别的总称。","source":{"text":"自五经四部、百家诸子、伎艺算计、卜数医术。","book":"晋·常璩《华阳国志·梓橦人士》"},"similar":["诸子百家"],"usage":"作宾语、定语；指各种学术流派"},{"id":32787,"word":"百密一疏","pinyin":"bǎi mì yī shū","abbr":"bmys","explanation":"在极周密的考虑中偶然出现了一点疏忽。","source":{"text":"至道问学之有知无行，分温故为存心，知新为致知，而敦厚为存心，崇礼为致知，此皆百密一疏。","book":"清·魏源《庸易通义》"},"example":{"text":"深知杜竹斋为人的吴荪甫此时却～，竟没有看透竹斋的心曲。他一而再，再而三的，用鼓励，用反激。","book":"茅盾《子夜》十"},"usage":"作谓语、定语；指计划或谋略"},{"id":32788,"word":"百尺无枝","pinyin":"bǎi chǐ wú zhī","abbr":"bcwz","explanation":"比喻罕见的大而有用之材。","source":{"text":"龙门之桐，高百尺而无枝。","book":"汉·枚乘《七发》"},"example":{"text":"其风韵遒正，神峰标映，千里绝迹，～。","book":"《梁书·王规传》"},"usage":"作宾语、定语；指罕见的人才"},{"id":32789,"word":"百尺竿头","pinyin":"bǎi chǐ gān tóu","abbr":"bcgt","explanation":"桅杆或杂技长竿的顶端。比喻极高的官位和功名，或学问、事业有很高的成就。","source":{"text":"百尺竿头五两斜，此生何处不为家。","book":"唐·吴融《商人》诗"},"example":{"text":"功名～，自古及今，有几个干休。","book":"元·张养浩《折桂令》曲"},"similar":["百丈竿头"],"usage":"作谓语、定语；形容很高的境界","story":["宋朝时期长沙高僧景岑佛学造诣高深，时常到各地去传道讲经，他讲得深入浅出，娓娓动听，听众与他谈论有关佛教的最高境界。他拿出偈帖给大家念道：“百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。”"]},{"id":32790,"word":"百尺竿头，更进一步","pinyin":"bǎi chǐ gān tóu，gèng jìn yī bù","abbr":"bcgtgjyb","explanation":"佛家语，比喻道行、造诣虽深，仍需修炼提高。比喻虽已达到很高的境地，但不能满足，还要进一步努力。","source":{"text":"师示一偈曰：‘百丈竿头不动人，虽然得入未为真，百尺竿头须进步，十方世界是全身。’","book":"宋·释道原《景德传灯录》卷十"},"example":{"text":"故聊复言之，恐或可以少助～之势也。","book":"宋·朱熹《答巩仲至书》"},"similar":["再接再厉"],"opposite":["每况愈下","固步自封"],"usage":"作谓语、状语；比喻即使取得好成绩还要努力","story":["宋朝时期长沙高僧景岑佛学造诣高深，时常到各地去传道讲经，他讲得深入浅出，娓娓动听，听众与他谈论有关佛教的最高境界。他拿出偈帖给大家念道：“百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。”"]},{"id":32791,"word":"百岁之后","pinyin":"bǎi suì zhī hòu","abbr":"bszh","explanation":"死的讳称。","source":{"text":"百岁之后，归于其居。","book":"《诗经·唐风·葛生》"},"example":{"text":"夫在则重尊，夫～，所子者为王，终不失势，此所谓一言而万世之利也。","book":"西汉·司马迁《史记·吕不韦列传》"},"similar":["百年之后"],"opposite":["人生在世"],"usage":"作谓语、宾语、定语；用于老年人死亡的婉言"},{"id":32792,"word":"百岁之好","pinyin":"bǎi suì zhī hǎo","abbr":"bszh","explanation":"好：友爱。永久的好合。指男女结为夫妻。","source":{"text":"亦雅慕其才藻，故将图百岁之好，非仅邀一夕之欢。","book":"明·屠隆《昙花记·士女私奔》"},"example":{"text":"他们历经磨难，终于结成～。"},"similar":["百年之好"],"usage":"作宾语；指结为夫妻"},{"id":32793,"word":"百岁之盟","pinyin":"bǎi suì zhī méng","abbr":"bszm","explanation":"同“百年之约”。即婚约。","source":{"text":"他要与小娘子订百岁之盟，不知可肯相许。","book":"清·李渔《意中缘·先订》"},"similar":["百年之约"],"usage":"作主语、宾语；指婚约"},{"id":32794,"word":"百岁千秋","pinyin":"bǎi suì qiān qiū","abbr":"bsqq","explanation":"一百年，一千载。形容岁月漫长，历时很久。","source":{"text":"今巫祝之祝人曰：‘使若千秋万岁。’千秋万岁之声恬耳，而一日之寿无征于人，此人所以简巫祝也。","book":"《韩非子·显学》"},"example":{"text":"明·康海《王兰卿》第三折：“便活到百岁千秋索一死，则不如另寻个身计。”"},"similar":["千秋万代"],"usage":"作宾语、定语；形容岁月漫长"},{"id":32795,"word":"百川归海","pinyin":"bǎi chuān guī hǎi","abbr":"bcgh","explanation":"川：江河。许多江河流入大海。比喻大势所趋或众望所归。也比喻许多分散的事物汇集到一个地方。","source":{"text":"百川异源，而皆归于海。","book":"《淮南子·氾论训》"},"example":{"text":"一自～后，长留风雨在江东。 （清·毛奇龄《禹庙》诗）"},"similar":["大势所趋","众望所盼"],"opposite":["四分五裂","众叛亲离"],"usage":"作宾语、定语；指分散的事物聚积在一起","story":["西汉文学家淮南王刘安组织数千人集体编写《淮南子》，书中讲道：人类社会是在不断前进的，从住山洞到建房屋，从捕食到耕种，从无序到今天的礼节与约束，这一切说明，像千百条不同源头的江河最终流入大海一样不可避免"]},{"id":32796,"word":"百川朝海","pinyin":"bǎi chuān cháo hǎi","abbr":"bcch","explanation":"众水奔流趋向大海。多比喻无数分散的事物都汇集到一处。","source":{"text":"百川朝海，流行不止，道虽辽远，无不到者。","book":"汉·焦赣《易林·谦之无妄》"},"similar":["百川归海"],"opposite":["四分五裂"],"usage":"作宾语、定语；形容分散的事物聚积在一起"},{"id":32797,"word":"百川灌河","pinyin":"bǎi chuān guàn hé","abbr":"bcgh","explanation":"河：黄河。所有的河流都流向黄河。比喻人心所向，大势所趋。","source":{"text":"秋水时至，百川灌河。","book":"《庄子·秋水》"}},{"id":32798,"word":"百川赴海","pinyin":"bǎi chuān fù hǎi","abbr":"bcfh","explanation":"百：表示多。川：江河。所有江河都流归大海。比喻众望所归或大势所趋。也比喻许多事物由分散而汇集到一处。","source":{"text":"百川赴海而海不溢。","book":"《朱子语类·卷二·理气下》"},"example":{"text":"许多文士在饱经战乱之苦后，如～，相继奔往邺城，归附到曹氏（曹操）周围。","book":"《建安文学》"}},{"id":32799,"word":"百巧千穷","pinyin":"bǎi qiǎo qiān qióng","abbr":"bqqq","explanation":"指有才能者境遇反而不好。","source":{"text":"有家无食违高枕，百巧千穷只短檠。","book":"宋·陈师道《早起》诗"},"similar":["百巧成穷"],"usage":"作谓语；指有才能但很贫穷"},{"id":32800,"word":"百巧成穷","pinyin":"bǎi qiǎo chéng qióng","abbr":"bqcq","explanation":"指有多种才能的人反而贫困不堪。同“百巧千穷”。","source":{"text":"一言悟主心犹壮，百巧成穷发自新。","book":"宋·陈师道《寄单州张朝请》诗"},"similar":["百巧千穷"],"usage":"作主语、宾语、定语；指艺多不养家"},{"id":32801,"word":"百年不遇","pinyin":"bǎi nián bù yù","abbr":"bnby","explanation":"一百年也碰不到一次。形容很少见到过或少有的机会。","source":{"text":"不是要开大会吗？百年不遇的事，我歇半天工，好开会去。","book":"老舍《龙须沟》第三幕"},"example":{"text":"松花江万万不会来这么一次～的武开江。","book":"《花城》1981年第1期"},"similar":["千载难逢"],"opposite":["屡见不鲜","司空见惯"],"usage":"作谓语、定语；形容事情很难遇见"},{"id":32802,"word":"百年之业","pinyin":"bǎi nián zhī yè","abbr":"bnzy","explanation":"业：事业。比喻宏伟而长久的事业。","source":{"text":"国藉十世之基，家承百年之业。","book":"东汉·班固《西都赋》"},"example":{"text":"汝幸能出崔家妾，我遗汝五百缣，归乡足成～。","book":"宋·李昉《太平广记》卷第四百九十四"},"similar":["千秋大业"],"usage":"作主语、宾语；指事业"},{"id":32803,"word":"百年之后","pinyin":"bǎi nián zhī hòu","abbr":"bnzh","explanation":"死的讳称。","source":{"text":"俺女儿百年之后，可往俺刘家坟里埋也，去他张家坟里埋？","book":"《曹操集·卷二·军谯令》：“为存者立庙，使视其先人。魂而有灵，吾百年之后何恨哉！”元·武汉臣《老生儿》第三折"},"example":{"text":"您～，安葬何处？","book":"鲁讯《“题未定”草·五》"},"similar":["百岁之后"],"opposite":["转眼之间"],"usage":"作谓语、宾语、定语；用于老年人死亡的婉言"},{"id":32804,"word":"百年之好","pinyin":"bǎi nián zhī hǎo","abbr":"bnzh","explanation":"永久的好合。指男女结为夫妇。","source":{"text":"我方壮年，未曾娶妻。倘蒙不弃，当与子缔百年之好。","book":"宋·罗烨《醉翁谈录·张氏夜奔吕星哥》：“今宁随君远奔，以结百年之好。”明·凌濛初《初刻拍案惊奇》卷三十二"},"example":{"text":"忙了几时，到了重阳吉期，小峰同红蕖成了～。","book":"清·李汝珍《镜花缘》第九四回"},"similar":["美满良缘","百年好合","白头偕老"],"opposite":["夫妻反目","破镜难圆"],"usage":"作宾语；用于新婚祝颂赞辞"},{"id":32805,"word":"百年之柄","pinyin":"bǎi nián zhī bǐng","abbr":"bnzb","explanation":"柄：权柄。形容长久的大权。","source":{"text":"主有专己之威，臣无百年之柄。","book":"《后汉书·班彪传》"},"usage":"作宾语；指长久的大权"},{"id":32806,"word":"百年之欢","pinyin":"bǎi nián zhī huān","abbr":"bnzh","explanation":"指男女结为夫妇。","source":{"text":"兹谓好逑，盖将缔百年之欢。","book":"宋·楼钥《攻媿集·不愚弟请婚冯氏书》"}},{"id":32807,"word":"百年之约","pinyin":"bǎi nián zhī yuē","abbr":"bnzy","explanation":"即婚约。","source":{"text":"小生不揣，要与小姐订百年之约，不知可肯俯从。","book":"清·李渔《蜃中楼·双订》"},"similar":["百岁之盟"],"usage":"作主语、宾语；指婚约"},{"id":32808,"word":"百年偕老","pinyin":"bǎi nián xié lǎo","abbr":"bnxl","explanation":"偕：共同。指夫妻共同白头到老。","source":{"text":"俺衙内大财大礼，娶将你来，指望百年偕老，你只是不肯随顺，可是为何？","book":"元·武汉臣《生金阁》第二折"},"example":{"text":"恩深义重，誓必图～。","book":"明·冯梦龙《醒世恒》卷八"},"similar":["白头偕老"],"opposite":["白头不终"],"usage":"作谓语、宾语；祝人新婚"},{"id":32809,"word":"百年到老","pinyin":"bǎi nián dào lǎo","abbr":"bndl","explanation":"指夫妻共同生活到老。","source":{"text":"只愿他过了门，两口子和和顺顺的百年到老，我就心安了。","book":"清·曹雪芹《红楼梦》第106回"},"example":{"text":"清·曹雪芹《红楼梦》第106回：“只愿他过了门，两口子和和顺顺的百年到老，我就心安了。”"},"similar":["百年偕老"],"opposite":["白头不终"],"usage":"作谓语、宾语；祝人新婚"},{"id":32810,"word":"百年大业","pinyin":"bǎi nián dà yè","abbr":"bndy","explanation":"指关系到长远利益的重要计划或措施。同“百年大计”。","source":{"text":"百年大业，教育为本。"},"example":{"text":"三峡工程是造福人类的～"},"usage":"作宾语、定语；用于业绩等"},{"id":32811,"word":"百年大计","pinyin":"bǎi nián dà jì","abbr":"bndj","explanation":"大计：长远的重要的计划。指关系到长远利益的计划或措施。","source":{"text":"数月之间，而其权力已深入巩固，而百年大计于以定矣。","book":"清·梁启超《论民族竞争之大势》"},"example":{"text":"～，教育为本。"},"similar":["长计远虑","千秋大业"],"opposite":["权宜之计"],"usage":"作主语、宾语；指关系到长远利益的重大策略"},{"id":32812,"word":"百年好事","pinyin":"bǎi nián hǎo shì","abbr":"bnhs","explanation":"指婚姻喜事。","source":{"text":"我与你姐姐百年好事，千金重担只在此两件上面了！万望龙香姐竭力周全，讨个回音则个。","book":"明·凌濛初《二刻拍案惊奇》卷九"},"example":{"text":"你还是牺牲一切，替浪子做撮合山，你还是使浪子少犯几层罪过，成就你自己的～呢？","book":"郭沫若《卓文君》第三景"},"similar":["婚姻大事"],"usage":"作主语、宾语；指婚姻"},{"id":32813,"word":"百年好合","pinyin":"bǎi nián hǎo hé","abbr":"bnhh","explanation":"夫妻永远和好之意。","source":{"text":"今日你们缔结了良缘，祝福你们～，万事如意。"},"example":{"text":"一般结婚的对联少不了“～”的字眼"},"similar":["白头偕老"],"usage":"作谓语、宾语、定语；用于祝福"},{"id":32814,"word":"百年归寿","pinyin":"bǎi nián guī shòu","abbr":"bngs","explanation":"百年：指人去世。指人死的婉称。","source":{"text":"你百年归寿时，我却再与你些送终之资。","book":"明·施耐庵《水浒传》第21回"},"similar":["寿终正寝"],"usage":"作谓语、宾语；用于书面语"},{"id":32815,"word":"百年树人","pinyin":"bǎi nián shù rén","abbr":"bnsr","explanation":"树：种植，栽培。比喻培养人才是长期而艰巨的事。","source":{"text":"一年之计，莫如树谷；十年之计，莫如树木，终身之计，莫如树人。","book":"《管子·权修》"},"example":{"text":"古人都知道～的道理，我们更应该把培养人才这件大事抓好。"},"similar":["百载树人"],"usage":"作谓语、定语；指表达人才造就不易"},{"id":32816,"word":"百年谐老","pinyin":"bǎi nián xié lǎo","abbr":"bnxl","explanation":"指夫妻共同生活到老。","source":{"text":"美满恩深情厚，原百年谐老，共守白头。","book":"《全元散曲·集贤宾·皂罗袍》"},"example":{"text":"总只是朝云暮潮。呀，总不如～。","book":"明·顾大典《青衫记·坐湿青衫》"},"similar":["百年偕老"],"opposite":["白头不终"],"usage":"作谓语、宾语；祝人新婚"},{"id":32817,"word":"百年难遇","pinyin":"bǎi nián nán yù","abbr":"bnny","explanation":"百年也碰不到。形容罕见或很不容易碰到。","source":{"text":"若说一样的动心，把这等终身要紧的大事、百年难遇的良缘，倒扔开自己，双手送给我这样一个初次见面旁不相干的张金凤，尤其不是情理。","book":"清·文康《儿女英雄传》第九回"},"example":{"text":"这种怪事～，今天倒开了眼界。"},"similar":["百年不遇","千载难逢"],"opposite":["屡见不鲜"],"usage":"作谓语、定语；形容事情很难遇见"},{"id":32818,"word":"百废俱举","pinyin":"bǎi fèi jù jǔ","abbr":"bfjj","explanation":"指一切废置的事都兴办起来。同“百废俱兴”。","source":{"text":"了翁（魏了翁）乃葺其城楼橹雉堞，增置器械，教习牌手，申严军律……居数月，百废俱举。","book":"《续资治通鉴·宋理宗绍定五年》"},"example":{"text":"‘～’的平均主义思想，以及与此相关联着的不合边区实际的‘正规化’思想，成了贯彻精简政策与集中力量于两大任务的绊脚石。","book":"《解放日报》1942.12.23"},"similar":["百废俱兴","百废具作"],"usage":"作谓语、定语；形容建设事业兴旺发达"},{"id":32819,"word":"百废俱兴","pinyin":"bǎi fèi jù xīng","abbr":"bfjx","explanation":"俱：全，都。许多已经荒废了的事情一下子都兴办起来。","source":{"text":"俱：全，都。许多已经荒废了的事情一下子都兴办起来。"},"example":{"text":"四川屡经兵燹，廷相莅任，～，民不知扰。","book":"《清史稿·郎廷佐传》"},"similar":["万象更新","蒸蒸日上","百废俱举"],"opposite":["百废不举","每况愈下"],"usage":"作谓语、宾语、分句；形容建设事业恢复","story":["宋朝时期，滕子京被贬到岳州作知州。第二年政务办得很顺利，上下和协，一切荒废的事情都兴办了起来，重修了岳阳楼，并扩大了规模，把唐朝名人作品刻上，好友范仲淹作《岳阳楼记》评价：“政通人和，百废俱兴，乃重修岳阳楼。”"]},{"id":32820,"word":"百废具举","pinyin":"bǎi fèi jù jǔ","abbr":"bfjj","explanation":"指许多被废置的事业都等着兴办。同“百废俱举”。","source":{"text":"吴明可帅会稽，百废具举，独不传书。","book":"宋·王明清《挥麈录》卷一"},"example":{"text":"宋·王明清《挥麈录》卷一：“吴明可帅会稽，百废具举，独不传书。”"},"similar":["百废俱举"],"usage":"作谓语、定语；形容建设事业兴旺发达"},{"id":32821,"word":"百废具作","pinyin":"bǎi fèi jù zuò","abbr":"bfjz","explanation":"指一切废置的事都兴办起来。同“百废俱兴”。","source":{"text":"阳湖孙使君督粮山东，起痿瞭矇，百废具作。","book":"清·管同《恩县四女祠碑》"},"similar":["百废备举"],"usage":"作谓语、定语、分句；形容建设事业兴旺发达"},{"id":32822,"word":"百废具兴","pinyin":"bǎi fèi jù xīng","abbr":"bfjx","explanation":"指一切废置的事都兴办起来。同“百废俱兴”。","source":{"text":"建原庙以安祖考，正六宫而修典刑，百废具兴，多士爰集。","book":"宋·苏轼《谢量移汝州表》"},"similar":["百废俱兴"],"usage":"作谓语、宾语、分句；形容建设事业恢复"},{"id":32823,"word":"百废咸举","pinyin":"bǎi fèi xián jǔ","abbr":"bfxj","explanation":"指一切废置的事都兴办起来。同“百废俱兴”。","source":{"text":"公受命来杭未及期月，威惠大行，百废咸举。吏民顺令，如臂使指。","book":"明·刘基《杭州路重修府治记》"},"similar":["百废俱举","百废俱兴"],"usage":"作谓语、定语；形容建设事业兴旺发达"},{"id":32824,"word":"百废备举","pinyin":"bǎi fèi bèi jǔ","abbr":"bfbj","explanation":"举：兴办。一切被废置的事情全部都兴办起来。形容建设事业兴旺发达。","source":{"text":"明年六月，百废备举，庙有新室，学有新含。","book":"明·刘基《杭州富阳县重修文庙学宫记》"},"similar":["百废待举","百废俱兴"],"usage":"作谓语、定语、分句；形容建设事业兴旺发达"},{"id":32825,"word":"百废待举","pinyin":"bǎi fèi dài jǔ","abbr":"bfdj","explanation":"废：被废置的事情；待：等待；举：兴办。许多被搁置的事情等着要兴办。","source":{"text":"百废待举，他不出头做主，实在令人着急。","book":"吴晗《海瑞罢官》"},"example":{"text":"惟荆州素称重镇，军兴以来，～。","book":"李一《荆宜施鹤光复记》"},"similar":["百端待举","千头万绪"],"opposite":["百废俱兴","井井有条"],"usage":"作谓语、定语、分句；形容一切事重新做"},{"id":32826,"word":"百废待兴","pinyin":"bǎi fèi dài xīng","abbr":"bfdx","explanation":"废：被废置的事情；待：等待；兴：兴办。许多被搁置的事情等着要兴办。","source":{"text":"百废待兴，一下子怎么能抓得过来？","book":"王颖《海外赤子》"},"example":{"text":"开国之初，生机蓬勃。虽然～，已经是万紫千红的局面。","book":"徐迟《哥德巴赫猜想·地质之光》"},"similar":["百废待举"],"opposite":["百废俱兴"],"usage":"作谓语、定语；形容事情都有待重新做起"},{"id":32827,"word":"百弊丛生","pinyin":"bǎi bì cóng shēng","abbr":"bbcs","explanation":"百：形容多；弊：弊端，害处。各种弊害都产生出来了。","source":{"text":"而此等异论，何以能容喙焉？何以能动人焉？则以智慧程度未达于大多数，而欲幸福之程度进于大多数，未有不百弊丛生，而贻反对之徒以口实者也。","book":"梁启超《政治学学理摭言》"},"example":{"text":"今以十当一，是反以四钱八分铜作一钱二分用也。民间私镕改铸，～。","book":"柯劭忞《清史稿·袁希祖传》"},"usage":"作谓语、定语；用于社会等"},{"id":32828,"word":"百忍成金","pinyin":"bǎi rěn chéng jīn","abbr":"brcj","explanation":"形容忍耐的可贵。","source":{"text":"郓州寿张人张公艺，九代同居……麟德中，高宗有事泰山，路过郓州，亲幸其宅，问其义由。其人请纸笔，但书百余‘忍’字。","book":"《旧唐书·孝友传·张公艺》"},"example":{"text":"如所谓～，所谓唾面自干，岂非世俗传为佳话者耶……今乃欲举全国人而为无骨无血无气之怪物，吾不知如之何而可也！","book":"梁启超《新民说》八"},"usage":"作宾语、定语；用于劝诫人"},{"id":32829,"word":"百念皆灰","pinyin":"bǎi niàn jiē huī","abbr":"bnjh","explanation":"种种念头都已消失成了灰。比喻心灰意冷。","source":{"text":"我如今百念皆灰，只求归见老母。","book":"清·魏子安《花月痕》第38回"},"example":{"text":"你不能～了。"},"similar":["万念俱灰"],"opposite":["欣喜若狂"],"usage":"作谓语；指人的心情"},{"id":32830,"word":"百态横生","pinyin":"bǎ tài héng shēng","abbr":"bths","explanation":"各种姿态自如地呈现出来。","source":{"text":"淋漓挥洒，或妍或丑，百态横生。","book":"宋·欧阳修《跋王献之法贴》"}},{"id":32831,"word":"百思不得其故","pinyin":"bǎi sī bù dé qí gù","abbr":"bsbdqg","explanation":"百：多次；思：考虑，思考；故：原因。指经过百般思索仍旧不能找到其原因。","source":{"text":"鸡不代伏，又何以传种至今也。此真百思不得其故矣。","book":"清·纪昀《阅微草堂笔记·槐西杂志三》"},"example":{"text":"我～，请解释一下吧。"},"similar":["百思不得其解"],"opposite":["理所当然","理应如此"],"usage":"作谓语、宾语；指不可思议"},{"id":32832,"word":"百思不得其解","pinyin":"bǎi sī bù dé qí jiě","abbr":"bsbdqj","explanation":"百：多次；解：理解。百般思索也无法理解。","source":{"text":"此真百思不得其故矣。","book":"清·纪昀《阅微草堂笔记》卷十三"},"example":{"text":"至诚于国至诚于道而流血成仁，若此者皆不诚之人所～也。","book":"清·梁启超《论宗教家与哲学家之长短得失》"},"similar":["百思不解"],"opposite":["理所当然"],"usage":"作谓语、宾语；指不可思议"},{"id":32833,"word":"百思不解","pinyin":"bǎi sī bù jiě","abbr":"bsbj","explanation":"百：多次；解：理解。百般思索也无法理解。","source":{"text":"此真百思不得其故矣。","book":"清·纪昀《阅微草堂笔记》卷十三"},"example":{"text":"～，五夜踌蹰，故乘隙邀君一面，以决中疑。","book":"清·无名氏《葛仙翁全传》"},"similar":["高深莫测","大惑不解","玄之又玄"],"opposite":["恍然大悟","通俗易懂","老妪能解"],"usage":"作谓语、定语；指对事情感到意外，不可思议"},{"id":32834,"word":"百思莫解","pinyin":"bǎi sī mò jiě","abbr":"bsmj","explanation":"百思：百般思索。形容反复思索也不能理解。","source":{"text":"此真百思不得其故矣。","book":"清·纪昀《阅微草堂笔记》卷十三"},"example":{"text":"这真是令人～。","book":"邹韬奋《抗战以来·审查老爷对文艺的贡献》"},"similar":["百思不解"],"usage":"作谓语、定语；指不能理解"},{"id":32835,"word":"百怪千奇","pinyin":"bǎi guài qiān qí","abbr":"bgqq","explanation":"形容花样繁多。","source":{"text":"世人制菜之法，可称百怪千奇。自新鲜以至于腌糟酱腊，无一不曲尽奇能，务求至美。","book":"清·李渔《闲情偶寄·饮馔·蔬食》"},"similar":["千奇百怪"],"opposite":["千篇一律"],"usage":"作谓语、定语、宾语；指稀奇古怪的事物"},{"id":32836,"word":"百感交集","pinyin":"bǎi gǎn jiāo jí","abbr":"bgjj","explanation":"感：感想；交：同时发生。各种感触交织在一起。形容感触很多，心情复杂。","source":{"text":"见此茫茫，不觉百端交集，苟未免有情，亦复谁能遣此。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"我是上一个世纪出生的人，能参加这样的盛会，～，思绪万千。","book":"郭沫若《科学的春天》"},"similar":["悲喜交集","感慨万端"],"opposite":["无动于衷","铁石心肠"],"usage":"作谓语、状语；用于有许多感想不知如何表达","story":["西晋时期，统治集团内部战争频发，“八王之乱”给国家和人民带来了深重的灾难。太子洗马卫玠面对动荡不安的时局，决心把家迁往南方，说服母亲南下，在将要渡长江时，他百感交集，思绪万千，始终牵挂着朝廷的安危"]},{"id":32837,"word":"百战不殆","pinyin":"bǎi zhàn bù dài","abbr":"bzbd","explanation":"经历许多次战役，都没有遭到危险。形容善于用兵。","source":{"text":"知彼知己者百战不殆。","book":"《孙子·谋攻》"},"example":{"text":"自古名将料敌制胜，训练士兵，故可使赴汤蹈火，～。","book":"《金史·刘炳传》"},"similar":["百战百胜","所向无敌","所向披靡"],"opposite":["一败涂地","每战必殆","一触即溃"],"usage":"作谓语、宾语、定语；形容每次战斗都取胜"},{"id":32838,"word":"百战无前","pinyin":"bǎi zhàn wú qián","abbr":"bzwq","explanation":"所向无敌，形容人英勇善战。","source":{"text":"故使三军勇锐，百战无前。","book":"南朝·陈·徐陵《陈公九锡文》"},"similar":["所向无敌"],"usage":"作谓语、定语；指人善战"},{"id":32839,"word":"百战百胜","pinyin":"bǎi zhàn bǎi shèng","abbr":"bzbs","explanation":"每战必胜。形容所向无敌。","source":{"text":"百战百胜，非善之善者也。","book":"《孙子·谋攻》"},"example":{"text":"项籍唯不能忍，是以～而轻用其锋。","book":"宋·苏轼《留侯论》"},"similar":["战无不胜","所向无敌"],"opposite":["一触即溃","望风披靡","屡战屡败"],"usage":"作谓语、定语；形容善于作战，所向无敌","story":["春秋时期，军事家孙武认为使敌人举国完整的屈服就是上策，出兵打破那个国家就要差一些。要善于运用计谋不战而屈人之兵，同时做到知己知彼、百战不殆。百战百胜还不是高明中最高明的，只有不通过战斗而使敌人屈服才高明"]},{"id":32840,"word":"百战百败","pinyin":"bǎi zhàn bǎi bài","abbr":"bzbb","explanation":"指每战必败。","source":{"text":"汉王曰：‘何为乃死也？’何曰：‘今众弗如，百战百败，不死何为？’","book":"《汉书·萧何传》"},"example":{"text":"即论残明时局，亦已～，元气日凋，傥赫斯一怒，早著戎衣，势必如摧枯拉朽。","book":"清·陈康祺《郎潜纪闻》卷十一"},"similar":["屡战屡败"],"opposite":["百战百胜"],"usage":"作谓语、定语；指每战必败"},{"id":32841,"word":"百折不回","pinyin":"bǎi zhé bù huí","abbr":"bzbh","explanation":"折：挫折。比喻意志坚强，无论受到多少次挫折，毫不动摇退缩。","source":{"text":"其性庄，疾华尚朴，有百折不挠，临大节而不可夺之风。","book":"汉·蔡邕《太尉乔玄碑》"},"example":{"text":"耿耿自始，～。","book":"清·姚莹《复杨君论诗文书》"},"similar":["百折不挠","坚强不屈"],"usage":"作谓语、定语；形容意志坚强"},{"id":32842,"word":"百折不屈","pinyin":"bǎi zhé bù qū","abbr":"bzbq","explanation":"受到无数挫折都不屈服、动摇。形容意志坚强。","source":{"text":"一旦竟成其名，史书及府县志纪录则有之，必不能千百年之后，人人变色动容，有一百折不屈之人，如在其心，如出其口，如忠毅、方学士、铁尚书者也。","book":"清·恽敬《〈卓忠毅公遗稿〉书后》"},"example":{"text":"要像总理那样……奋不顾身，～。","book":"郭小川《痛悼敬爱的周总理》诗"},"similar":["百折不挠","百折不摧"],"opposite":["知难而退"],"usage":"作谓语、定语、状语；形容意志坚定"},{"id":32843,"word":"百折不挠","pinyin":"bǎi zhé bù náo","abbr":"bzbn","explanation":"折：挫折；挠：弯曲。比喻意志坚强，无论受到多少次挫折，毫不动摇退缩。","source":{"text":"其性庄，疾华尚朴，有百折不挠，临大节而不可夺之风。","book":"汉·蔡邕《太尉乔玄碑》"},"example":{"text":"汉阳民军总司令黄兴，系湖南长沙县人，向来主张革命，屡仆屡起，～。","book":"蔡东藩、许廑父《民国通俗演义》第三回"},"similar":["百折不回","不屈不挠","坚韧不拔"],"opposite":["知难而退","一蹶不振","半途而废"],"usage":"作谓语、定语、状语；形容意志坚定","story":["东汉时期司徒长史桥玄为官清廉，刚正不阿，不惜牺牲自己的儿子同强盗作斗争，建议朝廷颁布律法杜绝绑架事件。因弹劾南阳太守盖升而辞官回乡，深得曹操的赏识，称他“有百折而不挠，临大节而不可奇之风。”"]},{"id":32844,"word":"百折不摧","pinyin":"bǎi zhé bù cuī","abbr":"bzbc","explanation":"受到无数挫折都不屈服、动摇。形容意志坚强。","source":{"text":"义气外强，道心内全，百折不摧，如有待然。","book":"宋·苏辙《祭亡兄端明文》"},"similar":["百折不挠"],"opposite":["一蹶不振"],"usage":"作谓语、定语、状语；形容意志坚定"},{"id":32845,"word":"百折不移","pinyin":"bǎi zhé bù yí","abbr":"bzby","explanation":"屡遭挫折亦不改变其操守。","source":{"text":"即其可名状者言之，则本之一毫不染之真，而加之百折不移之守。","book":"明·吴承恩《赠郡伯古愚邵公报政序》"},"similar":["百折不挠"],"opposite":["半途而废"],"usage":"作谓语、定语、状语；形容意志坚定"},{"id":32846,"word":"百折千回","pinyin":"bǎi zhé qiān huí","abbr":"bzqh","explanation":"形容经过种种曲折和纡回。","source":{"text":"百折千回心不退，无畏方能施无畏。","book":"赵朴初《与日本佛教友人谈时事为拈一偈》"},"example":{"text":"赵朴初《与日本佛教友人谈时事为拈一偈》：“～心不退，无畏方能施无畏。”"},"similar":["迂回曲折"],"usage":"作宾语、定语；指人的情绪等"},{"id":32847,"word":"百拙千丑","pinyin":"bǎi zhuō qiān chǒu","abbr":"bzqc","explanation":"极言拙劣丑陋。","source":{"text":"黄龙鼻下无口，当然所见颟顸，至今百拙千丑。","book":"宋·晓莹《罗湖野录·辩禅师》"},"usage":"作主语、宾语；指丑陋"},{"id":32848,"word":"百无一二","pinyin":"bǎi wú yī èr","abbr":"bwye","explanation":"一百个中找不出一两个。指某一类人或事物所占比例极少。","source":{"text":"每年贡生至千余人，或与之游，或得其文，若权生者，百无一二焉。","book":"唐·韩愈《送权秀才序》"}},{"id":32849,"word":"百无一堪","pinyin":"bǎi wú yī kān","abbr":"bwyk","explanation":"指百人中无一人能胜任。","source":{"text":"盖以六军之兵，素非精练，皆市肆屠沽之人，务挂虚名，苟避征赋，及驱以就战，百无一堪。","book":"《旧唐书·郭子仪传》"},"usage":"作谓语、定语；指无人可胜任"},{"id":32850,"word":"百无一失","pinyin":"bǎi wú yī shī","abbr":"bwys","explanation":"形容有充分把握，绝对不会出差错。","source":{"text":"从门应庭，听堂室之言，什而失九，如升堂窥室，百不失一。","book":"汉·王充《论衡·须颂》"},"example":{"text":"这项任务很重要，不仅要完成，还要做到～。"},"similar":["万无一失","毫发不爽","稳操胜券"],"opposite":["漏洞百出","百无一是"],"usage":"作谓语、宾语、定语；形容做事很有把握"},{"id":32851,"word":"百无一存","pinyin":"bǎi wú yī cún","abbr":"bwyc","explanation":"存：存在。一百个里面没有留下一个。指丧失殆尽。","source":{"text":"多被王仙其作寇残灭，里闾人物，百无一存。","book":"明·凌濛初《初刻拍案惊奇》第22卷"},"similar":["百不一存"],"opposite":["完好无损"],"usage":"作宾语、定语；指全部丧失"},{"id":32852,"word":"百无一成","pinyin":"bǎi wú yī chéng","abbr":"bwyc","explanation":"百：一切。形容一切的努力和作为没有一样成功，即毫无成就。","source":{"text":"今学者旷废隳惰，玩岁愒时而百无所成，皆由于志未立耳。","book":"明·王守仁《教条示龙场诸生》"},"example":{"text":"志学不早……驽缓多病，～。","book":"清·曾国藩《圣哲画象记》"},"similar":["一事无成","百无所成"],"opposite":["功成名就"],"usage":"作谓语、定语；指人没有成就"},{"id":32853,"word":"百无一是","pinyin":"bǎi wú yī shì","abbr":"bwys","explanation":"干一百件事，也没有做对一件。形容全都做错了，一无是处。","source":{"text":"至于百无一是，且朝夕以此相临，极为难处。","book":"宋·袁采《袁氏世范》"},"example":{"text":"此人做事百无一是，如若重用应当三思而后行。"},"similar":["百无一用","一无可取","一无是处"],"opposite":["超凡入圣","完美无缺"],"usage":"作谓语；形容全都做错了，一无是处"},{"id":32854,"word":"百无一漏","pinyin":"bǎi wú yī lòu","abbr":"bwyl","explanation":"干一百件事，没有一件疏漏。形容有完全把握，不会失手。","source":{"text":"麞鹿狐兔，走马遮截，放索踏之，百无一漏。","book":"唐·张鷟《朝野佥载》"}},{"id":32855,"word":"百无一用","pinyin":"bǎi wú yī yòng","abbr":"bwyy","explanation":"百样之中无一有用的。形容毫无用处。","source":{"text":"十有九人堪白眼，百无一用是书生。","book":"清·黄景仁《杂感》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“在外面～，只有帮着操持家务。”"},"opposite":["价值连城"],"usage":"作谓语、定语；指没有用处"},{"id":32856,"word":"百无一能","pinyin":"bǎi wú yī néng","abbr":"bwyn","explanation":"能：能力，胜任。什么都不会做。","source":{"text":"宋江道：‘我自百无一能，虽有忠心，不能得进步。’","book":"明·施耐庵《水浒全传》第三十二回"},"similar":["一无所能"],"usage":"作谓语、定语；指人无能"},{"id":32857,"word":"百无失一","pinyin":"bǎi wú shī yī","abbr":"bwsy","explanation":"百：很多；失：差错。指非常有把握，绝对不会出差错。","source":{"text":"成败在于决断，以此参之，万不失一。","book":"西汉·司马迁《史记·淮阴侯列传》"},"similar":["万不失一","万无一失"],"opposite":["挂一漏万"],"usage":"作谓语、定语、状语；形容有绝对把握"},{"id":32858,"word":"百无所忌","pinyin":"bǎi wú suǒ jì","abbr":"bwsj","explanation":"百：所有的，不论什么；忌：忌讳。什么都不忌讳。","source":{"text":"药成之后，百无所忌。","book":"宋·张君房《云笈七签》卷七十五"},"similar":["百无禁忌"],"opposite":["谨言慎行"],"usage":"作谓语、宾语；形容一切不忌讳"},{"id":32859,"word":"百无所成","pinyin":"bǎi wú suǒ chéng","abbr":"bwsc","explanation":"犹言一事无成。","source":{"text":"今学者旷废隳惰，玩岁愒时而百无所成，皆由于志之未立耳。","book":"明·王守仁《教条示龙场诸生》"},"similar":["一无所成","一事无成"],"opposite":["功成名就"],"usage":"作谓语、宾语、补语；指人没有出息"},{"id":32860,"word":"百无是处","pinyin":"bǎi wú shì chù","abbr":"bwsc","explanation":"犹言一无是处。形容全都是错的，没有一点对的地方。","source":{"text":"一似旧时春意思，百无是处老形骸，也曾头上带花来。","book":"宋·辛弃疾《浣溪沙·漫兴作》词"},"example":{"text":"每日价茶不茶，饭不饭，～。","book":"元·王氏《粉蝶儿·寄情人》套曲"},"similar":["一无是处"],"opposite":["十全十美"],"usage":"作谓语、补语、宾语；指没有一点好的地方"},{"id":32861,"word":"百无禁忌","pinyin":"bǎi wú jìn jì","abbr":"bwjj","explanation":"百：所有的，不论什么；禁忌：忌讳。什么都不忌讳。","source":{"text":"清·范寅《越谚·名物·风俗》“百无禁忌，诸邪回避。”"},"example":{"text":"则知太公封神，古有此说。今人于门户每书姜太公在此，～，亦非无所本矣。","book":"鲁迅《小说旧闻钞·封神传衍义》"},"similar":["直言不讳","肆无忌惮","随心所欲"],"opposite":["谨言慎行","畏首畏尾","清规戒律"],"usage":"作谓语、宾语；形容一切不忌讳"},{"id":32862,"word":"百无聊赖","pinyin":"bǎi wú liáo lài","abbr":"bwll","explanation":"聊赖：依赖。精神上无所寄托，感到什么都没意思。","source":{"text":"为复强视息，虽生何聊赖。","book":"汉·蔡琰《悲愤》诗"},"example":{"text":"在～中，随手抓过一本书来，科学也好，文学也好，横竖什么都一样。","book":"鲁迅《彷徨·伤逝》"},"similar":["兴味索然","心灰意冷","万念俱灰"],"opposite":["兴高采烈","怡然自得"],"usage":"作谓语、定语、状语；形容人空虚无聊","story":["东汉末年，军阀公孙瓒盘踞蓟州，袁绍想消灭公孙瓒，故意散布谣言说易州城易守难攻，公孙瓒迁都易州城，大量修筑工事。袁绍大军围困易州，公孙瓒暗中庆幸占据了有利地形，但时间一长就百无聊赖，士气低落，被袁绍挖通地道进城占领"]},{"id":32863,"word":"百星不如一月","pinyin":"bǎi xīng bù rú yī yuè","abbr":"bxbryy","explanation":"一百颗星星发出的亮光不如一个月亮发出的光明亮。比喻量多不如质优。","source":{"text":"百星之明，不如一月之光；十牖之开，不如一户之明。","book":"《淮南子·说林训》"},"usage":"作宾语、定语；用于书面语"},{"id":32864,"word":"百样玲珑","pinyin":"bǎi yàng líng lóng","abbr":"byll","explanation":"玲珑：灵活敏捷。各方面都表现的灵活敏捷。","source":{"text":"他情性多骄纵，恃天生百样玲珑。","book":"清·洪昇《长生殿·倖恩》"},"usage":"作谓语、定语；用于人"},{"id":32865,"word":"百步无轻担","pinyin":"bǎi bù wú qīng dàn","abbr":"bbwqd","explanation":"百步：指长途。跑长路，担子再轻也感到很沉重。比喻道远而任重。","source":{"text":"早起路到日头晏，方知百步无轻担。","book":"明·张景《飞丸记·交投设械》"},"similar":["任重道远"],"usage":"作宾语、定语；用于劝诫人"},{"id":32866,"word":"百步穿杨","pinyin":"bǎi bù chuān yáng","abbr":"bbcy","explanation":"在一百步远以外射中杨柳的叶子。形容箭法或枪法十分高明。","source":{"text":"楚有养由基者，善射；去柳叶百步而射之，百发百中。","book":"《史记·周本纪》：“楚有养由基者，善射者也，去柳叶百步而射之，百发而百中之。”《战国策·西周策》"},"example":{"text":"（关羽）带箭回寨，方知黄忠有百步穿杨之能。","book":"明·罗贯中《三国演义》第五十三回"},"similar":["穿杨射柳","百发百中"],"opposite":["无的放矢"],"usage":"作谓语、宾语、定语；形容射击技术高明","story":["春秋战国，楚国名将养由基从小喜欢射箭，他学射箭非常专心，每天坚持练习，终于炼成极高的射箭本领，他能在百步远的地方射中杨柳的叶子，而且射一百次，中一百次。晋军进犯楚国，他用箭射晋军，百发百中，立下赫赫战功"]},{"id":32867,"word":"百死一生","pinyin":"bǎi sǐ yī shēng","abbr":"bsys","explanation":"形容生命极其危险，处于死亡的边缘。","source":{"text":"诸勋人身触锋刃，百死一生，纵其贪鄙，所取处大，不可同之循常例也。","book":"《北齐书·杜弼传》"},"example":{"text":"地无医巫，药石万里，病者有～之虑。","book":"唐·元稹《叙诗寄乐天书》"},"similar":["九死一生"],"opposite":["安若泰山"],"usage":"作谓语、定语；表示人的经历"},{"id":32868,"word":"百治百效","pinyin":"bǎi zhì bǎi xiào","abbr":"bzbx","explanation":"效：效果，功用。形容医术高明，效果很好。","source":{"text":"来了一个摇串铃的道士，说是曾受异人传授，能治百病，街上人找他治病，百治百效。","book":"清·刘鹗《老残游记》第一回"},"similar":["百灵百验"],"usage":"作宾语、定语；指效果好"},{"id":32869,"word":"百灵百验","pinyin":"bǎi líng bǎi yàn","abbr":"blby","explanation":"测算预测非常灵验。","source":{"text":"人多晓得柳庄神相，却不知其子志彻传了父术，也是一个百灵百验的。","book":"明·凌濛初《初刻拍案惊奇》卷二十一"},"similar":["灵丹妙药"],"usage":"作谓语、定语；指十分灵验"},{"id":32870,"word":"百炼之钢","pinyin":"bǎi liàn zhī gāng","abbr":"blzg","explanation":"比喻久经锻炼，坚强不屈的优秀人物。","source":{"text":"铠则东胡阙巩，百炼精刚。","book":"汉·陈琳《武军赋》"},"example":{"text":"萧若～，不可屈仰。","book":"五代·王定保《唐摭言·知己》"},"usage":"作宾语；指坚强不屈的人"},{"id":32871,"word":"百炼成刚","pinyin":"bǎi liàn chéng gāng","abbr":"blcg","explanation":"刚通钢。铁经过反复锤炼便成为坚韧的钢。比喻人经过多次磨炼而成为有用之才。","source":{"text":"点起斗争的烈火，使人在烈火中百炼成刚。","book":"郭小川《保卫我们的党》诗"},"example":{"text":"有人身经百战，～，炉火纯青，喜于心而不形于色。","book":"徐迟《火中凤凰·凤翔》"}},{"id":32872,"word":"百炼成钢","pinyin":"bǎi liàn chéng gāng","abbr":"blcg","explanation":"比喻经过长期锻炼，变得非常坚强。","source":{"text":"铠则东胡阙巩，百炼精刚。","book":"汉·陈琳《武军赋》"},"example":{"text":"他周大勇的战士却在战争中～，精通了打击敌人的本领。","book":"杜鹏程《保卫延安》第七章"},"similar":["千锤百炼","坚强不屈"],"opposite":["娇生惯养","脆而不坚"],"usage":"作谓语、定语；比喻不怕失败，意志坚强"},{"id":32873,"word":"百炼钢化为绕指柔","pinyin":"bǎi liàn gāng huà wéi rào zhǐ róu","abbr":"blghwrzr","explanation":"绕指柔：柔软得能在手指上缠绕。经过百炼的钢，竟然变成可以绕指的柔软之物。比喻经历失败后变得无能为力。后用来比喻使火爆强硬的性情变得柔顺。","source":{"text":"自从花翠琴嫁来后，竟把他这百炼钢化为绕指柔了。","book":"清·曾朴《孽海花》第三十五回"}},{"id":32874,"word":"百爪挠心","pinyin":"bǎi zhǎo náo xīn","abbr":"bznx","explanation":"像有一百只脚爪在抓心一样。形容人心情错综复杂，心神不定。","example":{"text":"我感觉到像～一样难受。"},"usage":"作宾语、定语；用于人的心情"},{"id":32875,"word":"百福具臻","pinyin":"bǎi fú jù zhēn","abbr":"bfjz","explanation":"形容各种福运一齐来到。","source":{"text":"伏望陛下每以汉文孔子之意为准，则百福具臻。","book":"《旧唐书·李藩传》"},"opposite":["厄运当头"],"usage":"作谓语、定语；指人的运气"},{"id":32876,"word":"百端交集","pinyin":"bǎi duān jiāo jí","abbr":"bdjj","explanation":"bǎi  duān  jiāo  jí","source":{"text":"卫洗马初欲渡江，形神惨悴，语左右云：‘见此芒芒，不觉百端交集，苟未免有情，亦复谁能遣此！’","book":"南朝·宋·刘义庆《世说新语·言语》"},"similar":["百感交集"],"opposite":["无动于衷"],"usage":"作谓语、定语；指让人感慨","story":["西晋时期，统治集团内部战争频发，“八王之乱”给国家和人民带来了深重的灾难。太子洗马卫玠面对动荡不安的时局，决心把家迁往南方，说服母亲南下，在将要渡长江时，他百感交集，思绪万千，始终牵挂着朝廷的安危"]},{"id":32877,"word":"百端待举","pinyin":"bǎi duān dài jǔ","abbr":"bddj","explanation":"面端：百种；举：举办。有很多事情等着要兴办。","source":{"text":"经济建设是百端待举，但须有缓急轻重之分。","book":"周恩来《人民政协共同纲领草案的要点》"},"example":{"text":"地震过后，～，大家要齐心协力，克服各种困难。"},"similar":["百废待举","千头万绪"],"opposite":["井井有条","百废待兴"],"usage":"作谓语、定语；用于事业刚举办或刚接办时"},{"id":32878,"word":"百紫千红","pinyin":"bǎi zǐ qiān hóng","abbr":"bzqh","explanation":"形容繁花似锦，色彩繁多。","source":{"text":"百紫千红过了春，杜鹃声苦不堪闻。","book":"宋·王安石《越人以幕养花因游其下》诗之一：“幕天无日地无尘，百紫千红占得春。”宋·辛弃疾《定风波·赋杜鹃花》词"},"similar":["万紫千红","万红千紫","千红万紫"],"opposite":["落花流水"],"usage":"作谓语、定语；指事物丰富多彩"},{"id":32879,"word":"百约百叛","pinyin":"bǎi yuē bǎi pàn","abbr":"bybp","explanation":"约：约定。多次订约，多次背叛。形容毫无信用。","source":{"text":"反复无信，百约百叛。","book":"汉·桓宽《盐铁论·和亲》"},"similar":["言而无信"],"opposite":["言而有信","言出必行"],"usage":"作谓语、定语；指人没有信用"},{"id":32880,"word":"百纵千随","pinyin":"bǎi zòng qiān suí","abbr":"bzqs","explanation":"什么都顺从。形容一切都顺从别人。","source":{"text":"元关汉卿《窦娥冤》第二折：“怎不记旧日夫妻情意，也曾有百纵千随。“"},"example":{"text":"卢郎，自招你在此，成了夫妇，和你朝欢暮乐，～，真人间得意之事也。","book":"明·汤显祖《邯郸记》第六出"},"similar":["百依百顺"],"usage":"作谓语、宾语；指对人的态度"},{"id":32881,"word":"百结悬鹑","pinyin":"bǎi jié xuán chún","abbr":"bjxc","explanation":"比喻衣衫破烂。鹑鸟尾秃，像补缀百结，故云。","source":{"text":"乞丐身上，破衣褴褛，百结悬鹑，怎抵得住那一天风雪？","book":"《黑籍冤魂》第二十回"},"similar":["悬鹑百结"],"usage":"作谓语、定语；指生活贫困"},{"id":32882,"word":"百结愁肠","pinyin":"bǎi jié chóu cháng","abbr":"bjcc","explanation":"指愁绪如结无法解开。","source":{"text":"飞鸿过也，百结愁肠无昼夜。","book":"宋·蒋兴祖女《减字木兰花·题雄州驿》词"},"example":{"text":"可怜我神思恍然饮食废，我为你～解不开。","book":"越剧《梁山泊与祝英台》第十场"},"similar":["愁肠百结"],"usage":"作谓语、定语；形容非常烦恼、忧愁"},{"id":32883,"word":"百舌之声","pinyin":"bǎi shé zhī shēng","abbr":"bszs","explanation":"比喻唠叨、多嘴。","source":{"text":"人有多言者，犹百舌之声；人有少言者，犹不脂之户。","book":"《淮南子·说山训》"},"usage":"作宾语；指人嘴多"},{"id":32884,"word":"百舍重茧","pinyin":"bǎi shè chóng jiǎn","abbr":"bscj","explanation":"形容走远道的辛苦。","source":{"text":"公输盘为楚设机，将以攻宋。墨子闻之，百舍重茧，往见公输盘。","book":"《战国策·宋策》"},"similar":["百舍重趼"],"usage":"作分句、定语；形容旅途劳累"},{"id":32885,"word":"百舍重趼","pinyin":"bǎi shè chóng jiǎn","abbr":"bscj","explanation":"百里一舍，足底老皮上又生出硬皮。形容长途奔走，十分辛劳。亦作“百舍重茧”。","source":{"text":"昔南荣畴耻圣道之独亡于己身……百舍重趼，不敢休息，南见老聃。","book":"《庄子·天道》：“吾闻夫子圣人也。吾固不辞远道而来愿见，百舍重趼而不敢息。”《淮南子·修务训》"},"similar":["百舍重茧"],"usage":"作分句、定语；形容旅途劳累"},{"id":32886,"word":"百般刁难","pinyin":"bǎi bān diāo nàn","abbr":"bbdn","explanation":"用各种手段使对方过不去。","source":{"text":"柔玉不便道出自己身世，编个话儿与她道：‘奴家父母早逝，自幼跟哥嫂度日。只是嫂嫂容不得，百般刁难，与其受人凌辱，倒不如自寻清净，避开人世烦恼。’","book":"郭戈《金瓶梅传奇》第十一回"},"example":{"text":"在谈判过程中，对方～，所以未能达成协议。"},"similar":["故意刁难"],"opposite":["与人方便"],"usage":"作谓语、宾语；形容用各种手段使对方为难"},{"id":32887,"word":"百般奉承","pinyin":"bǎi bān fèng chéng","abbr":"bbfc","explanation":"用各种方式来恭维讨好人。","source":{"text":"巴不得接着子弟，就是钱龙入门，百般奉承他，常怕一个留他不住，怎么刚刚三日，便要赶他出门？","book":"元·关汉卿《金线池》"},"example":{"text":"你要注意他的～，他是有所求的。"},"opposite":["百般刁难"],"usage":"作谓语、宾语；指讨好他人"},{"id":32888,"word":"百般折磨","pinyin":"bǎi bān zhé mó","abbr":"bbzm","explanation":"用各种方式使人在肉体上、精神上遭受痛苦。","source":{"text":"土豪又叫村里的二十多个妇女……然后揪着她的头发把头往地上碰，百般折磨污辱，包君的妻子本来就瘦弱多病，并且怀有身孕，回到船上就死了。","book":"宋·李昉《太平广记·精察二·孟简》"},"example":{"text":"她任凭酷刑～，紧咬着牙关，始终坚贞不屈。","book":"《言行和心理》"},"usage":"作谓语、宾语、定语；用于整人"},{"id":32889,"word":"百般抚慰","pinyin":"bǎi bān fǔ wèi","abbr":"bbfw","explanation":"用各种方式进行安慰。抚慰：安慰。","source":{"text":"代宗对于河北安史降将虽然一味姑息，百般抚慰，但他们并未感恩戴德，反而视为软弱可欺。","book":"《中国通史》(第九册)第十一章第三节"},"example":{"text":"老妇人于是～，把自己年轻时抚慰孩子的语句，一一背了出来。","book":"《九夜》"}},{"id":32890,"word":"百般无赖","pinyin":"bǎi bān wú lài","abbr":"bbwl","explanation":"采用所有卑鄙的方法。","example":{"text":"这个人～，十分可恶。"},"usage":"作谓语、定语；指使坏"},{"id":32891,"word":"百般责难","pinyin":"bǎi bān zé nàn","abbr":"bbzn","explanation":"配电盘：指采取各种办法；责难：指责非难。指用各种办法指责非难人。"},{"id":32892,"word":"百花争妍","pinyin":"bǎi huā zhēng yàn","abbr":"bhzy","explanation":"妍：美、艳。形容繁华盛开，生气勃勃的景象。","example":{"text":"春风一到，公园里百花争妍。"},"similar":["繁花似锦"],"opposite":["残花败柳"],"usage":"作谓语、定语；比喻各种美好事物竞相媲美"},{"id":32893,"word":"百花争艳","pinyin":"bǎi huā zhēng yàn","abbr":"bhzy","explanation":"各种花草树木竞相开放出艳丽的花朵。","source":{"text":"整个晚会都用小演员，儿童演儿童看，台上台下天真烂漫，百花争艳。","book":"王朔《懵然无知》"},"example":{"text":"北方的夏天绿树成荫，百花争艳。"},"similar":["百花齐放","欣欣向荣","生气勃勃"],"opposite":["百花凋零"],"usage":"作谓语、定语；比喻新事物层出不穷"},{"id":32894,"word":"百花凋零","pinyin":"bǎi huā diāo líng","abbr":"bhdl","explanation":"百：表示多；凋零：凋残衰落。各种各样的鲜花都凋残衰落了。形容秋霜严酷，触目伤怀的情景。"},{"id":32895,"word":"百花生日","pinyin":"bǎi huā shēng rì","abbr":"bhsr","explanation":"旧指阴历二月十二日，即花朝。","source":{"text":"《陶朱公书》：‘二月十二日为百花生日。无雨，百花熟。’","book":"清·秦味芸《月令粹编》卷五"},"example":{"text":"每年二月十二日，相传是～。","book":"清·吴趼人《情变》第八回"},"usage":"作宾语、定语；指花朝"},{"id":32896,"word":"百花齐放","pinyin":"bǎi huā qí fàng","abbr":"bhqf","explanation":"形容百花盛开，丰富多彩。比喻各种不同形式和风格的艺术自由发展。也形容艺术界的繁荣景象。","source":{"text":"百花仙子只顾在此著棋，那知下界帝王忽有御旨命他百花齐放。","book":"清·李汝珍《镜花缘》第三回"},"example":{"text":"美术展览会上展出了许多新作品，～，各具风格。"},"similar":["万紫千红","姹紫嫣红"],"opposite":["残花败柳","一花独放"],"usage":"作谓语、定语；比喻鼓励不同流派和风格自由"},{"id":32897,"word":"百花齐放，百家争鸣","pinyin":"bǎi huā qí fàng，bǎi jiā zhēng míng","abbr":"bhqfbjzm","explanation":"比喻艺术及科学的不同派别及风格自由发展与争论。","source":{"text":"百花齐放、百家争鸣的方针，是促进艺术发展和科学进步的方针，是促进我国的社会主义文化繁荣的方针。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"example":{"text":"章诒和《往事并不如烟·正在有情无思间》：“在科学文化领域实行‘～’。”"},"usage":"作补语、定语、分句；指文艺等繁荣兴旺"},{"id":32898,"word":"百草权舆","pinyin":"bǎi cǎo quán yú","abbr":"bcqy","explanation":"权舆：草木萌芽状态。指花草萌芽，春天到来。","source":{"text":"于时冰泮发蛰，百草权舆。","book":"《大戴礼记·诰志》第九卷"},"usage":"作谓语、定语；指春天到来"},{"id":32899,"word":"百虑一致","pinyin":"bǎi lǜ yī zhì","abbr":"blyz","explanation":"指使各种不同的思想归于一致。","source":{"text":"天下何思何虑，天下同归而殊涂，一致而百虑。","book":"语出《易·系辞下》"},"example":{"text":"及躬总大政，一日万机，十许年间，曾不暇给，殊涂同归，～。","book":"《北史·魏纪三·孝文帝纪论》"},"usage":"作宾语、定语；指想法一致"},{"id":32900,"word":"百虑攒心","pinyin":"bǎi lǜ cuán xīn","abbr":"blzx","explanation":"各种思虑一齐聚集在心头。","source":{"text":"情怀恍惚，百虑攒心。","book":"唐·赵元一《奉天录》二"},"example":{"text":"人生何苦要多才，～摘不开。","book":"宋·李觏《自解》"}},{"id":32901,"word":"百衣百随","pinyin":"bǎi yī bǎi suí","abbr":"bybs","explanation":"什么都依从。形容一切都顺从别人。","source":{"text":"做爷娘的百依百顺，没一事违拗了他。","book":"明·凌濛初《初刻拍案惊奇》第十三卷"},"example":{"text":"自此～的，不敢倔强了。","book":"清·曹雪芹《红楼梦》第六十回"}},{"id":32902,"word":"百计千心","pinyin":"bǎi jì qiān xīn","abbr":"bjqx","explanation":"想尽或用尽一切办法。","source":{"text":"想尽或用尽一切办法。"},"example":{"text":"到如今，用尽了～，只落得泪珠儿罗衫湿浸。","book":"明·陆采《明珠记·授计》"},"similar":["百计千谋"],"usage":"作状语、宾语；指想尽一切办法"},{"id":32903,"word":"百计千方","pinyin":"bǎi jì qiān fāng","abbr":"bjqf","explanation":"想尽或用尽一切办法。","source":{"text":"百计千方久，似斗草儿童，赢个他家偏有。","book":"宋·辛弃疾《一枝花·醉中戏作》"},"example":{"text":"而忧中国之富，～，必尽括其财而后已。","book":"清·俞樾《恤商论》"},"similar":["千方百计"],"opposite":["束手无策"],"usage":"作状语、宾语；指想尽一切办法"},{"id":32904,"word":"百计千谋","pinyin":"bǎi jì qiān móu","abbr":"bjqm","explanation":"想尽或用尽一切办法。同“千方百计”。","source":{"text":"据着他全忠尽孝真良将，怎肯做背义忘恩那死囚，干费了百计千谋。","book":"元·尚仲贤《单鞭夺槊》第二折"},"similar":["千方百计","想方设法"],"usage":"作状语、宾语；指想尽一切办法"},{"id":32905,"word":"百读不厌","pinyin":"bǎi dú bù yàn","abbr":"bdby","explanation":"厌：厌烦，厌倦。读一百遍也不会感到厌烦。形容诗文或书籍写得非常好，不论读多少遍也不感到厌倦。","source":{"text":"旧书不厌百回读，熟读深思子自知。","book":"宋·苏轼《送安惇秀才失解西归》诗"},"example":{"text":"为什么一些作品有人“～”，另一些却有人不想读第二遍呢？","book":"朱自清《论百读不厌》"},"similar":["百闻不厌","手不释卷"],"opposite":["味同嚼蜡","索然无味"],"usage":"作谓语、定语；用于喜爱读的书或文章"},{"id":32906,"word":"百谋千计","pinyin":"bǎi móu qiān jì","abbr":"bmqj","explanation":"犹千方百计。","source":{"text":"这其间详细，索用心机，要搜寻百谋千计。","book":"元·关汉卿《魔合罗》第四折"},"similar":["千方百计"],"usage":"作宾语、状语；指想方设法"},{"id":32907,"word":"百败不折","pinyin":"bǎi bài bù zhé","abbr":"bbbz","explanation":"折：屈服。即使失败100次也绝不屈服。形容意志坚强。","source":{"text":"百败而不折者，诚有以合于天人之心也。","book":"宋·陈亮《上孝宗皇帝第二书》"},"similar":["百折不挠"],"usage":"作谓语、定语；指人的意志"},{"id":32908,"word":"百足不僵","pinyin":"bǎi zú bù jiāng","abbr":"bzbj","explanation":"比喻势力雄厚的集体或个人一时不易垮台。","source":{"text":"即观今日缅甸，已并于英，而本邦土司，以弹丸黑子之地，犹足自保，非人自为首、百足不僵之势耶！","book":"章炳麟《政闻社社员大会破坏状》"},"similar":["百足之虫，死而不僵"],"usage":"作宾语、定语；指垂死"},{"id":32909,"word":"百足之虫","pinyin":"bǎi zú zhī chóng","abbr":"bzzc","explanation":"百足：一种多节多足的爬虫，即马陆。比喻有实力基础的势力，虽一时败落，但不会很快彻底垮台。也指某一恶势力被摧垮后余孽尚存。","source":{"text":"吝者自能致富，然一有事则为过街老鼠；侠者或致破家，然一有事则为百足之虫。","book":"明·徐学谟《归有园尘谈》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“也知道松江漕帮是‘～，死而不僵’，不愿多事。”"},"usage":"作宾语、定语；形容坏势力"},{"id":32910,"word":"百足之虫，断而不蹶","pinyin":"bǎi zú zhī chóng，duàn ér bù jué","abbr":"bzzcdebj","explanation":"比喻势力雄厚的集体或个人一时不易垮台。同“百足之虫，至死不僵”。","source":{"text":"百足之虫，断而不蹶。","book":"唐·马总《意林》卷一"},"similar":["百足之虫，至断不蹶"],"usage":"作分句、宾语；指坏势力等不容易被清除"},{"id":32911,"word":"百足之虫，死而不僵","pinyin":"bǎi zú zhī chóng，sǐ ér bù jiāng","abbr":"bzzcsebj","explanation":"百足：虫名，又名马陆或马蚿，有十二环节，切断后仍能蠕动。比喻势家豪族，虽已衰败，但因势力大，基础厚，还不致完全破产。","source":{"text":"百足之虫，至死不僵，以扶之者众也。","book":"三国·魏·曹冏《六代论》"},"example":{"text":"古人有言：“～”，如今虽说不似先年那样兴盛，较之平常仕宦人家，到底气象不同。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["百足之虫，至死不僵"],"usage":"作宾语、分句；形容坏势力等不容易被清除"},{"id":32912,"word":"百足之虫，至断不僵","pinyin":"bǎi zú zhī chóng，zhì duàn bù jiāng","abbr":"bzzczdbj","explanation":"百足：虫名，马陆，多足虫；僵：倒。比喻势力雄厚的集体或个人一时不易垮台。","source":{"text":"百足之虫，至死不僵，以扶之者众也。","book":"三国·魏·曹冏《六代论》"},"similar":["百足之虫，至死不僵"],"usage":"作分句、宾语；形容坏势力等不容易被清除"},{"id":32913,"word":"百足之虫，至断不蹶","pinyin":"bǎi zú zhī chóng，zhì duàn bù jué","abbr":"bzzczdbj","explanation":"比喻势力雄厚的集体或个人一时不易垮台。同“百足之虫，至死不僵”。","source":{"text":"百足之虫，至断不蹶者，持之者众也。","book":"《文选·曹冏〈六代论〉》：“百足之虫，至死不僵。”李善注引《鲁连子》"},"similar":["百足之虫，断而不蹶"],"usage":"作分句、宾语；指坏势力等不容易被清除"},{"id":32914,"word":"百足之虫，至死不僵","pinyin":"bǎi zú zhī chóng，zhì sǐ bù jiāng","abbr":"bzzczsbj","explanation":"百足：虫名，躯干计二十节，切断后仍能蠕动。僵：肢体僵硬不能活动。比喻势力雄厚的集体或个人一时不易垮台。","source":{"text":"故语曰：‘百足之虫，至死不僵’，以扶之者众也。此言虽小，可以譬大。","book":"三国·魏·曹冏《六代论》"},"example":{"text":"又道是～，跌扑不多时，转眼就高官大禄，仍旧贵显。","book":"明·凌濛初《初刻拍案惊奇》卷二十九"},"similar":["百足之虫，死而不僵"],"usage":"作分句、宾语；形容坏势力等不容易被清除"},{"id":32915,"word":"百身何赎","pinyin":"bǎi shēn hé shú","abbr":"bshs","explanation":"百身：自身死一百次；赎：抵。拿一百个我，也无法把你换回来了。表示极沉痛地悼念。","source":{"text":"如可赎兮，人百其身。","book":"《诗经·秦风·黄鸟》"},"example":{"text":"一见无期，～。","book":"南朝·梁·刘令娴《祭夫徐敬业文》"},"similar":["百身莫赎"],"usage":"作主语、分句；用于表达对死去亲人的悲痛"},{"id":32916,"word":"百身莫赎","pinyin":"bǎi shēn mò shú","abbr":"bsms","explanation":"百身：自身死一百次；赎：抵。拿一百个我，也无法把你换回来了。表示极沉痛地悼念。","source":{"text":"如可赎兮，人百其身。","book":"《诗经·秦风·黄鸟》"},"example":{"text":"旷官之罪，职～矣。","book":"明·袁宏道《去吴七牍·乞改稿一》"},"similar":["百身何赎"],"usage":"作主语、分句；用于表达对死去亲人的悲痛"},{"id":32917,"word":"百载树人","pinyin":"bǎi zǎi shù rén","abbr":"bzsr","explanation":"培育人才需要百年。指育才是百年大计，要付出艰苦的劳动。同“百年树人”。","source":{"text":"百载树人是我一生抱负。","book":"粤剧《搜书院》第五幕第二场"},"similar":["百年树人"],"usage":"作主语、宾语、定语；指人才培养难"},{"id":32918,"word":"百辞莫辩","pinyin":"bǎi cí mò biàn","abbr":"bcmb","explanation":"用任何话语都无法辩白。","source":{"text":"被责难者处于时势潮流之下，百辞莫辩，辩则反动更为证实。","book":"鲁迅《准风月谈·后记》"},"similar":["百口莫辩"],"usage":"作谓语；形容有口难辩"},{"id":32919,"word":"百里不同风，千里不同俗","pinyin":"bǎi lǐ bù tóng fēng，qiān lǐ bù tóng sú","abbr":"blbtfqlbts","explanation":"形容不同的地方有不同的风俗习惯。","source":{"text":"百里而异习，千里而殊俗。","book":"《晏子春秋·问上》"}},{"id":32920,"word":"百里之任","pinyin":"bǎi lǐ zhī rèn","abbr":"blzr","explanation":"旧指一县的长官，如县宰、县令等。","source":{"text":"百里之任，以是叨居。","book":"晋·干宝《搜神记》"}},{"id":32921,"word":"百里之命","pinyin":"bǎi lǐ zhī mìng","abbr":"blzm","explanation":"指诸侯的政令。","source":{"text":"曾子曰：‘可以托六尺之孤，可以寄百里之命，临大节而不可夺也。君子人与，君子人也。’","book":"《论语·泰伯》"}},{"id":32922,"word":"百里之才","pinyin":"bǎi lǐ zhī cái","abbr":"blzc","explanation":"百里：方圆百里之地。指能治理方圆百里地区的人才。后称才能平常的人。","source":{"text":"蒋琬，社稷之器，非百里之才也。","book":"《三国志·蜀志·蒋琬传》"},"similar":["百里才"],"usage":"作宾语；称才能平常的人"},{"id":32923,"word":"百里异习","pinyin":"bǎi lǐ yì xí","abbr":"blyx","explanation":"异：不一样；习：风俗习惯。相隔百里远的地方就有不同的风俗习惯。","source":{"text":"百里而异习，千里而殊俗。","book":"《晏子春秋·问上》"},"usage":"作宾语、定语；指异地风俗"},{"id":32924,"word":"百里才","pinyin":"bǎi lǐ cái","abbr":"blc","explanation":"百里：方圆百里之地；才：才能。指能治理方圆百里地区的人才。","source":{"text":"庞士元非百里才也，使处治中，别驾之任。","book":"晋·陈寿《三国志·蜀志·庞统传》"},"example":{"text":"庞士元非～。","book":"明·罗贯中《三国演义》第57回"},"similar":["百里之才"],"usage":"作宾语；称才能平常的人"},{"id":32925,"word":"百里挑一","pinyin":"bǎi lǐ tiāo yī","abbr":"blty","explanation":"一百个当中就挑出这一个来。形容人才出众。","source":{"text":"姑爷年纪略大几岁，并没有娶过的，况且人物儿长的是百里挑一的。","book":"清·曹雪芹《红楼梦》第一百二十回"},"example":{"text":"对报名参军的人挑选很严格，可以说是～。"},"similar":["数一数二","凤毛麟角","出类拔萃"],"opposite":["比比皆是","俯拾即是","多如牛毛"],"usage":"作定语；形容人才出众","story":["贾宝玉中举后失踪，全家上下都找不到他，估计希望不大，就把他房内的丫鬟除伺候薛宝钗的人外，其余都打发出去，袭人的哥哥花自芳为袭人找一个百里挑一的女婿蒋玉菡，并派她嫂子去贾府接袭人回家。袭人抱定不嫁的决心，但兄命难违只得出嫁"]},{"id":32926,"word":"百里风趠","pinyin":"bǎi lǐ fēng chào","abbr":"blfc","explanation":"趠：腾跃。百里的路，顺风而行，就象腾跃一样。形容远程航行的迅速。","source":{"text":"趠：腾跃。百里的路，顺风而行，就象腾跃一样。形容远程航行的迅速。"},"example":{"text":"趠：腾跃。百里的路，顺风而行，就象腾跃一样。形容远程航行的迅速。"}},{"id":32927,"word":"百金之士","pinyin":"bǎi jīn zhī shì","abbr":"bjzs","explanation":"指有都能有作为的人。也指有功而受到重赏的人。","source":{"text":"百金之士十万。","book":"《史记·冯唐列传》"}},{"id":32928,"word":"百锻千炼","pinyin":"bǎi duàn qiān liàn","abbr":"bdql","explanation":"形容写作时一字一句多次推敲、琢磨。","source":{"text":"牢奇笼怪，百锻为字，千炼成句，虽不在镯太白，也后来之佳作也。","book":"唐·皮日休《刘枣强碑》"},"example":{"text":"他的文章是经过～才写出来的。"},"similar":["千锤百炼"],"usage":"作宾语、定语；用于人的品行或文章等","story":["唐朝时期，王武俊节制冀州，书生刘言史（人称刘枣强）以他的诗才成为他的幕客。外出打猎时，王武俊一箭射中一对野鸭，刘言史顿时写就一篇《射鸭歌》，人们认为他是继李白、李贺以后的有名诗人，他的诗是“牢奇笼怪，百锻为字，千炼成句”"]},{"id":32929,"word":"百闻不如一见","pinyin":"bǎi wén bù rú yī jiàn","abbr":"bwbryj","explanation":"闻：听见。听得再多，也不如亲眼见到一次。","source":{"text":"百闻不如一见，兵难遥度，臣愿驰至金城，图上方略。","book":"《荀子·儒效》：“闻之不若见之。”《汉书·赵充国传》"},"example":{"text":"从前画师所绘的狮子形，统是全身有毛，我观现在这狮子并不是这么样子，所以～。","book":"《慈禧太后演义》第三十六回"},"similar":["耳闻不如目见"],"opposite":["道听途说"],"usage":"作宾语、定语；形容了解事物不如亲自观察","story":["汉宣帝时西北边境羌人不断骚乱，老将赵光国请求带兵围剿，到了边境后，他深入了解各方面的情况，最后向汉宣帝建议采取友好的政策，只驻军不攻打，从此羌再也不敢轻举妄动了"]},{"id":32930,"word":"百顺千随","pinyin":"bǎi shùn qiān suí","abbr":"bsqs","explanation":"形容什么都顺从。同“百依百随”。","source":{"text":"李将军见他聪明伶俐，知书晓事，爱得他如珠似玉一般，十分抬举，百顺千随。","book":"明·凌濛初《二刻拍案惊奇》卷六"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第六卷：“爱得他如珠似玉一般，十分抬举，～。”"},"similar":["百顺百依"],"opposite":["刚愎自用"],"usage":"作谓语、定语、状语；形容无原则的迁就别人"},{"id":32931,"word":"百顺百依","pinyin":"bǎi shùn bǎi yī","abbr":"bsby","explanation":"形容什么都顺从。同“百依百随”。","source":{"text":"果然哄得李雄千欢万喜，百顺百依。","book":"明·冯梦龙《醒世恒言》第27卷"},"example":{"text":"对长辈的话不能无原则地～。"},"similar":["百依百顺"],"opposite":["我行我素"],"usage":"作谓语、定语、状语；形容无原则的迁就别人"},{"id":32932,"word":"百马伐骥","pinyin":"bǎi mǎ fá jì","abbr":"bmfj","explanation":"许多马围攻一匹好马。比喻许多小国围攻一个强国或许多愚笨的人攻击一个有贤德的人。","source":{"text":"诸侯合则强，孤则弱。骥之材，而百马伐之，骥必罢矣。","book":"《管子·霸言》"}},{"id":32933,"word":"百鬼众魅","pinyin":"bǎi guǐ zhòng mèi","abbr":"bgzm","explanation":"各种妖魔鬼怪。","source":{"text":"章帝时有寿光侯者，能劾百鬼众魅，令自缚见形。","book":"《后汉书·方术传下·解奴辜》"},"similar":["妖魔鬼怪"],"usage":"作主语、宾语、定语；指坏人"},{"id":32934,"word":"百鸟朝凤","pinyin":"bǎi niǎo cháo fèng","abbr":"bncf","explanation":"朝：朝见；凤：凤凰，古代传说中的鸟王。旧时喻指君主圣明而天下依附，后也比喻德高望重者众望所归。","source":{"text":"海州言凤见于城上，群鸟数百随之，东北飞向苍梧山。","book":"宋·李昉等《太平御览》九百一十五卷引《唐书》"},"example":{"text":"那些玉斝中的长春露酒也都由站在身边侍候的宫女接过去倾入一只绘着～的大瓷缸中。","book":"姚雪垠《李自成》第二卷第三十一章"},"similar":["众星捧月"],"usage":"作宾语、定语；用于书面语"},{"id":32935,"word":"百龄眉寿","pinyin":"bǎi líng méi shòu","abbr":"blms","explanation":"眉寿：长寿。祝人高寿的颂辞。","source":{"text":"愿百龄兮眉寿，重千金之巧笑。","book":"唐·虞世南《琵琶赋》"},"usage":"作谓语；用于祝寿"},{"id":32936,"word":"百龙之智","pinyin":"bǎi lóng zhī zhì","abbr":"blzz","explanation":"龙：公孙龙，战国时人，著有《公孙龙子》。一百个公孙龙的智慧。形容非常聪明。","source":{"text":"虽百龙之智，固不能当其前也。","book":"《孔丛子·公孙龙》"},"usage":"作主语、宾语；指人聪明"},{"id":32937,"word":"皂丝麻线","pinyin":"zào sī má xiàn","abbr":"zsmx","explanation":"皂：黑。黑色的丝线与白色的丝线搀杂在一起。比喻不清不白，关系混乱。","source":{"text":"若是停丧在家，待武松归来出殡，这个便没甚么皂丝麻线。","book":"明·施耐庵《水浒全传》第二十六回"},"example":{"text":"我在家中，我自照管着他，有甚～？（明·冯梦龙《警世通言》卷三十三）"},"usage":"作宾语、定语；指是非混乱"},{"id":32938,"word":"皂白不分","pinyin":"zào bái bù fēn","abbr":"zbbf","explanation":"不分黑白，不分是非。","source":{"text":"胡之言何也，贤者见此事之是是非非，不能分别皂白言之于王也。","book":"《诗经·大雅·桑柔》：“匪言不能，胡思畏忌。”笺"},"similar":["是非不分","黑白不分","泾渭不分"],"opposite":["黑白分明","是非分明","泾渭分明"],"usage":"作谓语、定语；指不分黑白"},{"id":32939,"word":"皂白沟分","pinyin":"zào bái gōu fēn","abbr":"zbgf","explanation":"皂：黑。比喻界限非常分明","source":{"text":"清·王夫之《读四书大全说·论语·述而篇四》：\"此是圣学极至处，亦是圣学、异端皂白沟分处。\""},"similar":["黑白分明"],"opposite":["皂白不分"],"usage":"作宾语、定语；用于书面语"},{"id":32940,"word":"皂白难分","pinyin":"zào bái nán fēn","abbr":"zbnf","explanation":"皂：黑。黑白很难分辨，比喻是非不易辨别","source":{"text":"穿钉鞋的，你二天来，不要穿钉鞋，要穿草鞋嘛，免得我们秀才要评什么足迹，给他做个皂白难分。","book":"川剧《评雪辨踪》"},"usage":"作宾语、定语；用于书面语"},{"id":32941,"word":"皂白须分","pinyin":"zào bái xū fēn","abbr":"zbxf","explanation":"皂：黑色。黑白要分清楚。比喻必须明辨是非。","source":{"text":"朕之有天下者，本公所推，今岂有贰心？皂白须分，所以推究耳。","book":"《旧唐书·裴寂传》"}},{"id":32942,"word":"的一确二","pinyin":"dí yī què èr","abbr":"dyqe","explanation":"形容明明白白，确确实实。","source":{"text":"怕不待的一确二，早招承死罪无辞。","book":"元·关汉卿《蝴蝶梦》第一折"},"example":{"text":"这是～的事情。"},"similar":["确确实实"],"usage":"作定语、状语；指的确"},{"id":32943,"word":"的的确确","pinyin":"dí dí què què","abbr":"ddqq","explanation":"指真实的，毫无疑问。","source":{"text":"他还是的的确确的一位候补县太爷呢，还是个老班子，不然，早就补了缺了。","book":"清·吴趼人《二十年目睹之怪现状》第四回"},"example":{"text":"她是～有话要对我讲，还是句对我生死攸关的话。","book":"王朔《空中小姐》"},"similar":["确确实实"],"usage":"作定语、状语；多用于口语"},{"id":32944,"word":"皆大欢喜","pinyin":"jiē dà huān xǐ","abbr":"jdhx","explanation":"皆：都。人人都高兴满意。","source":{"text":"皆大欢喜，信守奉行。","book":"《金刚经》"},"example":{"text":"正在～间，忽然太后密诏了清帝的本生父贤王来宫。","book":"清·曾朴《孽海花》第二十六回"},"similar":["欢天喜地","尽如人意"],"opposite":["怨声载道","大失所望"],"usage":"作谓语、宾语、定语；指人人都高兴满意"},{"id":32945,"word":"皇亲国戚","pinyin":"huáng qīn guó qī","abbr":"hqgq","explanation":"皇帝的亲戚。指极有权势的人。","source":{"text":"刀斧手且住者，不知是那个皇亲国戚来了也，等他过去了，才好杀人那！","book":"元·无名氏《谢金吾》第三折"},"example":{"text":"告爹妈，儿为两个朋友是～，要我陪宿，不免依他。","book":"明·冯梦龙《警世通言》卷三十"},"similar":["高官厚禄","公卿大臣","达官贵人"],"opposite":["平民百姓","芸芸众生","贩夫走卒"],"usage":"作主语、宾语、定语；形容有权有势的人"},{"id":32946,"word":"皇天不负有心人","pinyin":"huáng tiān bù fù yǒu xīn rén","abbr":"htbfyxr","explanation":"上天不会辜负有恒心的人。","source":{"text":"纷纷成败无凭准，自古道皇天不负有心人，伫看起陆龙蛇演出风云阵。","book":"梁启超《新罗马·侠感》"},"example":{"text":"这真是～，他终于取得成功。"},"similar":["锲而不舍"],"usage":"作宾语；用于口语","story":["鉴真18岁出家为僧，刻苦学习佛法。742年日本派荣壑、普照来华邀请鉴真高僧去日本担任佛教传戒师，鉴真先后三次东渡失败，船被漂到海南岛。753年，日本第十次派使者来华，鉴真终于随日本使团东渡到了日本九州"]},{"id":32947,"word":"皇天不负苦心人","pinyin":"huáng tiān bù fù kǔ xīn rén","abbr":"htbfkxr","explanation":"天公不会辜负苦心人的意愿。意谓只要肯下苦功，坚持干下去，愿望一定能实现。","source":{"text":"再说一句笑话，内人保的寿险后天满期，要是当真今天出了事，就算皇天不负苦心人。","book":"茅盾《子夜》十六"},"example":{"text":"真是皇天不负苦心人，如今他总算熬出头了！"},"similar":["皇天不负有心人"],"usage":"作宾语、定语；用于口语"},{"id":32948,"word":"皇天后土","pinyin":"huáng tiān hòu tǔ","abbr":"htht","explanation":"皇天：古代称天；后土：古代称地。指天地。旧时迷信天地能主持公道，主宰万物。","source":{"text":"君履后土而戴皇天。","book":"《尚书·武成》：“予小子其承厥志，底商之罪，告于皇天后土。”《左传·僖公十五年》"},"example":{"text":"这话～，实所共鉴，有渝此盟，神明殛之。","book":"清·文康《儿女英雄传》第十回"},"similar":["天神地祗"],"usage":"作宾语；常用于盟誓"},{"id":32949,"word":"皇天无亲，唯德是辅","pinyin":"huáng tiān wú qīn，wéi dé shì fǔ","abbr":"htwqwdsf","explanation":"皇天：上天；辅：辅助。老天爷公正无私，总帮助有德行的人。","source":{"text":"皇天无亲，唯德是辅。民心无常，惟惠之怀。","book":"《尚书·蔡仲之命》"},"example":{"text":"夫～。民咏德政，则延期过历，下有怨叹，掇录授能。","book":"晋·陈寿《三国志·魏志·高堂隆传》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":32950,"word":"皇天无亲，惟德是辅","pinyin":"huáng tiān wú qīn，wéi dé shì fǔ","abbr":"htwqwdsf","explanation":"亲：亲近；辅：帮助。指老天爷公正无私，总是帮助品德高尚的人。","source":{"text":"皇天无亲，惟德是辅。民心无常，惟惠之怀。","book":"《尚书·蔡仲之命》"},"example":{"text":"夫～。民咏德政，则延期过历，下有怨叹，掇录授能。","book":"《三国志·魏志·高堂隆传》"}},{"id":32951,"word":"皇天无老眼","pinyin":"huáng tiān wú lǎo yǎn","abbr":"htwly","explanation":"老天爷没有眼睛。旧时常用作对世事不平的愤懑语。","source":{"text":"惠子白驹瘦，归溪唯病身。皇天无老眼，空谷滞斯人。","book":"唐·杜甫《送惠二归故居》诗"},"example":{"text":"莫恨～，请看白骨有青苔。","book":"宋·陆游《夜饮》诗"},"opposite":["皇天有眼"],"usage":"作宾语、定语；用于感慨不公"},{"id":32952,"word":"皇天有眼","pinyin":"huáng tiān yǒu yǎn","abbr":"htyy","explanation":"皇天：上天。老天爷长着眼睛公正对待世事。","source":{"text":"倘或有了不测，我们真不知如何是好，只望皇天有眼。","book":"清·羽衣女士《东欧女豪杰》"},"example":{"text":"她总相信～能公正对待她。"},"similar":["苍天有眼"],"opposite":["皇天无老眼"],"usage":"作宾语、定语；用于感慨"},{"id":32953,"word":"皇皇不可终日","pinyin":"huáng huáng bù kě zhōng rì","abbr":"hhbkzr","explanation":"惊慌地连一天都过不下去。形容惊恐不安到了极点。","source":{"text":"如果我们认识了以上这些矛盾，就知道中国是处在怎样一种皇皇不可终日的局面之下。","book":"毛泽东《星星之火，可以燎原》"},"similar":["惶惶不可终日"],"usage":"作谓语、状语、定语；形容担心害怕"},{"id":32954,"word":"皈依三宝","pinyin":"guī yī sān bǎo","abbr":"gysb","explanation":"皈依：归顺；三宝：指佛教里的佛、法、僧。信仰并遵守佛教的戒。","source":{"text":"自此之后，陕右多皈依三宝、诵经念佛之人。","book":"明·周楫《西湖二集·邢君瑞五载幽期》"},"example":{"text":"那法海要我撇下你娘子，～进佛门。","book":"越剧《白蛇传》第九场"},"similar":["皈依佛门","皈依佛法"],"usage":"作谓语、宾语、定语；指信佛"},{"id":32955,"word":"皈依佛法","pinyin":"guī yī fó fǎ","abbr":"gyff","explanation":"信仰佛教，谨遵佛法。比喻对人百依百顺。","source":{"text":"平日打三个擒五个，啥都不怕，歪得像一只老虎，如今武松进门，就皈依佛法了。","book":"李劼人《暴风雨前》"},"similar":["皈依三宝"],"usage":"作谓语；指信佛"},{"id":32956,"word":"皎如日星","pinyin":"jiǎo rú rì xīng","abbr":"jrrx","explanation":"皎：洁折光亮。像太阳、星星一样洁白光亮。形容十分明显。","source":{"text":"春秋大义数十，皎如日星，不容遗忘。","book":"宋·邵伯温《邵氏闻见后录》第五卷"},"usage":"作宾语；指非常洁白"},{"id":32957,"word":"皎阳似火","pinyin":"jiǎo yáng shì huǒ","abbr":"jysh","explanation":"皎：白而亮。太阳像火一样燃烧。多形容夏日的炎热。"},{"id":32958,"word":"皓月千里","pinyin":"hào yuè qiān lǐ","abbr":"hyql","explanation":"范围极为广阔的千山万水都处于皎洁的月光照射之下。形容月光皎洁，天气暗和。","source":{"text":"长烟一空，皓月千里，浮光耀金，静影沉璧。","book":"宋·范仲淹《岳阳楼记》"},"usage":"作宾语、定语；用于描写景物"},{"id":32959,"word":"皓月当空","pinyin":"hào yuè dāng kōng","abbr":"hydk","explanation":"皎洁的月亮高高地挂在天空。","similar":["月明如昼"],"opposite":["月黑风高"]},{"id":32960,"word":"皓首庞眉","pinyin":"hào shǒu páng méi","abbr":"hspm","explanation":"皓：白的样子；庞：杂色。头发和眉毛花白。","source":{"text":"余皓首庞眉，叨叨于过去之间，感慨系之，无乃为轮庵之所笑乎？","book":"清·黄宗羲《序》"},"similar":["庞眉皓首"],"usage":"作谓语、定语；用于老年人"},{"id":32961,"word":"皓首穷经","pinyin":"hào shǒu qióng jīng","abbr":"hsqj","explanation":"皓：白；首：头发；穷经：专心研究经书和古籍。一直到年老头白之时还在深入钻研经书和古籍。","source":{"text":"白首穷经通秘义，青山养老度危时。","book":"唐·韩偓《赠易卜崔江处士》"},"example":{"text":"青春作赋，～；笔下虽有千言，胸中实无一策。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["白首穷经","学而不厌","老当益壮"],"usage":"作谓语、定语；指学到老"},{"id":32962,"word":"皓首苍颜","pinyin":"hào shǒu cāng yán","abbr":"hscy","explanation":"皓：白色的样子；首：头发；颜：面孔。雪白的头发，灰暗的面孔。形容老年人的容貌。","source":{"text":"相当初太公垂钓，伊尹耕锄，垂钓的皓首苍颜安社稷，耕锄的尽心竭力定寰区。","book":"明·无名氏《午时牌》第一折"},"example":{"text":"今日归拜慈帏，忽觉～，须信人生如白驹之过隙也。","book":"明·无名氏《杨家将演义》第三十八回"},"similar":["白发苍颜"],"usage":"作宾语、定语；形容老年人的容貌"},{"id":32963,"word":"皓齿娥眉","pinyin":"hào chǐ é méi","abbr":"hcem","explanation":"皓：白的样子。洁白的牙齿，修美的眉毛。形容女子容貌端庄美丽。","source":{"text":"皓齿娥眉，美女的代称。","book":"汉·枚乘《七发》：“皓齿蛾眉，命曰伐性之斧。”瞿蜕园注"},"similar":["皓齿蛾眉"],"usage":"作宾语、定语；喻称美女"},{"id":32964,"word":"皓齿明眸","pinyin":"hào chǐ míng móu","abbr":"hcmm","explanation":"皓：白色的样子；眸：眼珠，泛指眼睛。洁白的牙齿，明亮的眼睛。形容女子容貌美丽，亦喻指美女。","source":{"text":"丹唇外朗，皓齿内鲜，明眸善睐，靥辅承权。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"都为他～，不由我使心作幸。","book":"元·关汉卿《玉镜台》第二折"},"similar":["聪明伶俐"],"usage":"作宾语、定语；形容女子的美貌"},{"id":32965,"word":"皓齿星眸","pinyin":"hào chǐ xīng móu","abbr":"hcxm","explanation":"皓：白的样子；眸：眼珠。洁白的牙齿，明亮的眼睛。形容女子容貌美丽。比喻美女。","source":{"text":"守着那皓齿星眸，争忍的虚白昼。","book":"元·马致远《汉宫秋》第二折"},"similar":["星眸皓齿"],"usage":"作宾语、定语、状语；用于女性"},{"id":32966,"word":"皓齿朱唇","pinyin":"hào chǐ zhū chún","abbr":"hczc","explanation":"洁白的牙齿，彤红的嘴唇。形容女子容貌美丽。","source":{"text":"丹唇外朗，皓齿内鲜，明眸善睐，靥辅承权。","book":"三国·魏·曹植《洛神赋》"},"example":{"text":"打扮粉妆玉琢，～。","book":"明·兰陵笑笑生《金瓶梅词话》第十二回"},"similar":["皓齿红唇"],"usage":"作宾语、定语、状语；多用于女性"},{"id":32967,"word":"皓齿红唇","pinyin":"hào chǐ hóng chún","abbr":"hchc","explanation":"皓：白色的样子。齿白唇红。形容女子容貌的娇美。","source":{"text":"那头是秀眉长眼，皓齿红唇；头发蓬松，正如青烟一样。","book":"鲁迅《故事新编·铸剑》"},"similar":["皓齿朱唇"],"usage":"作宾语、定语、状语；多用于女性"},{"id":32968,"word":"皓齿蛾眉","pinyin":"hào chǐ é méi","abbr":"hcem","explanation":"皓：白色的样子；蛾眉：女子修长而美丽的眉毛。洁白的牙齿，修美的眉毛。形容女子容貌端庄美丽，也喻称美女。","source":{"text":"皓齿蛾眉，命曰伐性之斧。","book":"汉·枚乘《七发》"},"example":{"text":"人间～斧，筝笛纷纷君未许。","book":"宋·辛弃疾《和赵国兴知录赠琴》"},"similar":["蛾眉皓齿","皓齿娥眉"],"usage":"作宾语、定语；喻称美女"},{"id":32969,"word":"皓齿青蛾","pinyin":"hào chǐ qīng é","abbr":"hcqe","explanation":"皓：白的样子；青蛾：指女子用青黛画的眉。比喻美女或美好的人才。","source":{"text":"美人勿用伤迟暮，皓齿青蛾宁久微。","book":"清·方文《寄怀倪臣北初度》"},"similar":["皓齿青娥"],"usage":"作宾语、定语；多用于女性"},{"id":32970,"word":"皮不存而毛焉附","pinyin":"pí bù cún ér máo yān fù","abbr":"pbcemyf","explanation":"存：存留；焉：哪里；附：附着。皮都没有了，毛往哪里依附呢？比喻事物失去了借以生存的基础，就不能存在。","source":{"text":"然此果足为有命说之根据乎？一旦以力破此制度，则皮不存而毛焉附矣。","book":"梁启超《墨学微》第一章"},"similar":["皮之不存，毛将焉附"],"usage":"作宾语、定语、分句；形容两者的关系"},{"id":32971,"word":"皮之不存，毛将安傅","pinyin":"pí zhī bù cún，máo jiāng ān fù","abbr":"pzbcmjaf","explanation":"存：存留；附：附着。皮都没有了，毛往哪里依附呢？比喻事物失去了借以生存的基础，就不能存在。","source":{"text":"皮之不存，毛将安傅？","book":"春秋·鲁·左丘明《左传·僖公十四年》"},"example":{"text":"今云欲预九锡之庆，乃甘心促寿愈疾以从之，所谓～，岂不愚惑之甚哉！","book":"宋·罗大经《鹤林玉露》第五卷"},"similar":["皮之不存，毛将焉附"],"usage":"作宾语、定语、分句；形容两者的关系","story":["春秋时，晋国的公子夷吾求秦国帮他登上王位，并答应给五座城池。夷吾成为晋惠公后就违背诺言。后来秦国遇饥荒向晋国借粮，晋惠公也没答应。大臣虢射对晋惠公说：“我们借粮也不能改善关系，就好比‘皮之不存，毛将安傅？’”"]},{"id":32972,"word":"皮之不存，毛将焉附","pinyin":"pí zhī bù cún，máo jiāng yān fù","abbr":"pzbcmjyf","explanation":"焉：哪儿；附：依附。皮都没有了，毛往哪里依附呢？比喻事物失去了借以生存的基础，就不能存在。","source":{"text":"皮之不存，毛将安傅？","book":"《左传·僖公十四年》"},"example":{"text":"倘若朕的江山不保，你们不是也跟着家破人亡？～。","book":"姚雪垠《李自成》第二卷第三十二章"},"similar":["相辅相成","皮之不存，毛将安附"],"usage":"作宾语、定语、分句；形容两者的关系","story":["春秋时，晋国的公子夷吾求秦国帮他登上王位，并答应给五座城池。夷吾成为晋惠公后就违背诺言。后来秦国遇饥荒向晋国借粮，晋惠公也没答应。大臣虢射对晋惠公说：“我们借粮也不能改善关系，就好比‘皮之不存，毛将安傅？’”"]},{"id":32973,"word":"皮伤肉绽","pinyin":"pí shāng ròu zhàn","abbr":"psrz","explanation":"绽：裂开。皮肉都裂开了。形容被打伤势严重。","source":{"text":"只一石子飞来，正中面门，皮伤肉绽，鲜血迸流，翻身落马。","book":"明·施耐庵《水浒传》第107回"},"similar":["皮开肉绽","皮开肉破"],"opposite":["完好无损"],"usage":"作谓语、定语；用于严刑拷打"},{"id":32974,"word":"皮开肉破","pinyin":"pí kāi ròu pò","abbr":"pkrp","explanation":"皮肉都裂开了。形容被打伤势严重。","source":{"text":"四个喽啰听了，那敢怠慢，登时上来两个，把大盗紧紧按住；那两个举起大板，打的皮开肉破，喊叫连声。","book":"清·李汝珍《镜花缘》第51回"},"similar":["皮开肉绽"],"usage":"作谓语、定语；用于严刑拷打"},{"id":32975,"word":"皮开肉绽","pinyin":"pí kāi ròu zhàn","abbr":"pkrz","explanation":"皮肉都裂开了。形容伤势严重。多指受残酷拷打。","source":{"text":"浑身是口怎支吾，恰似个没嘴的葫芦，打的来皮开肉绽损肌肤。","book":"元·关汉卿《包待制三勘蝴蝶梦》第二折"},"example":{"text":"那两个举起大板，打的～，喊叫连声。","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["遍体鳞伤","体无完肤","皮伤肉绽"],"opposite":["完美无缺"],"usage":"作谓语、定语；用于严刑拷打"},{"id":32976,"word":"皮弁素绩","pinyin":"pí biàn sù jī","abbr":"pbsj","explanation":"皮弁：古冠名，以白鹿皮制成；素绩：未染色的丝织品制成的衣服。鹿皮帽子，白色衣服。","source":{"text":"刘歆四十九人，赐皮弁素绩。","book":"《汉书·平王后传》"}},{"id":32977,"word":"皮松肉紧","pinyin":"pí sōng ròu jǐn","abbr":"psrj","explanation":"形容漫不经心，宽泛而无关紧要。","source":{"text":"怎的又合他皮松肉紧的谈了会子道学，又指东说西的打了会子闷葫芦呢？","book":"清·文康《儿女英雄传》第25回"},"usage":"作定语、状语；用于人的心情"},{"id":32978,"word":"皮松骨痒","pinyin":"pí sōng gǔ yǎng","abbr":"psgy","explanation":"形容表面轻松自如而内心急切盼望。","source":{"text":"用金花彩币为纳聘之仪，选了吉期，皮松骨痒，整备做转运使的女婿。","book":"明·冯梦龙《古今小说·金玉奴棒打薄情郎》"},"usage":"作谓语、定语；用于人的心情"},{"id":32979,"word":"皮相之士","pinyin":"pí xiàng zhī shì","abbr":"pxzs","explanation":"皮相：从表面看。指仅看外表不察内情、见识肤浅的人。","source":{"text":"牧者曰：‘子乃皮相之士，何足语姓字哉！’","book":"西汉·韩婴《韩诗外传》第一卷"},"usage":"作主语、宾语；用于鄙视"},{"id":32980,"word":"皮相之见","pinyin":"pí xiàng zhī jiàn","abbr":"pxzj","explanation":"皮相：从表面上看。没有说到点子上的肤浅看法。","source":{"text":"本回全叙亡金事迹，而金之所以致亡，已跃然纸上。徒谓其录述之详，犹皮相之见也。","book":"蔡东藩《元史演义》第十六回"},"example":{"text":"这种～，不识何以竟能深入人心而牢不可拔。","book":"郭沫若《序引》"},"similar":["皮相之谈"],"usage":"作宾语；指肤浅看法"},{"id":32981,"word":"皮相之谈","pinyin":"pí xiàng zhī tán","abbr":"pxzt","explanation":"皮相：从表面上看。没有说到点子上的肤浅看法。","source":{"text":"钟嵘说他“源出于《小雅》”，似乎是皮相之谈。","book":"朱自清《经典常谈·诗》"},"similar":["皮相之见"],"usage":"作主语、宾语；指肤浅看法"},{"id":32982,"word":"皮破肉烂","pinyin":"pí pò ròu làn","abbr":"pprl","explanation":"形容伤势很重。","source":{"text":"满脸浑身血道道，皮破肉烂不忍瞧。","book":"李季《王贵与李香香》第二部"},"similar":["皮开肉绽","皮破血流"],"usage":"作谓语、定语；多用于受伤"},{"id":32983,"word":"皮破血流","pinyin":"pí pò xuè liú","abbr":"ppxl","explanation":"形容伤势很重。","source":{"text":"饿得慌了，到人家地里劈一穗苞米，被人抓住，打得皮破血流，昏倒在地上。","book":"周立波《暴风骤雨》第二部"},"example":{"text":"他的手被磨得～。"},"similar":["皮破肉烂"],"usage":"作谓语、定语；多用于受伤"},{"id":32984,"word":"皮笑肉不笑","pinyin":"pí xiào ròu bù xiào","abbr":"pxrbx","explanation":"极其不自然地装出一副笑脸。形容虚伪或心怀恶意的样子。","source":{"text":"不得已见了面，皮笑肉不笑，说话慢慢吞吞，爱说不说。","book":"柳青《创业史》"},"example":{"text":"他经常～的，让人讨厌。"},"usage":"作分句、状语；指假笑"},{"id":32985,"word":"皮肉之苦","pinyin":"pí ròu zhī kǔ","abbr":"przk","explanation":"泛指身体所遭受的痛苦。","source":{"text":"河南人除过受了点皮肉之苦，屁也没损失——他带着预支的一个月高薪落荒而逃了。","book":"路遥《平凡的世界》第五卷第20章"},"example":{"text":"你还是老实交代吧，免受～。"},"similar":["皮肉之痛"],"usage":"作宾语；指身体所遭受的痛苦"},{"id":32986,"word":"皮肤之见","pinyin":"pí fū zhī jiàn","abbr":"pfzj","explanation":"比喻肤浅的见识。","source":{"text":"或有执文昧理，以模范《论语》为病，此皮肤之见，非心解也。","book":"宋·阮逸《序》"},"example":{"text":"或言山谷所拟胜东坡，此～也。","book":"金·王若虚《滹南诗话》中卷"},"usage":"作主语、宾语；指肤浅的见解"},{"id":32987,"word":"皮里抽肉","pinyin":"pí lǐ chōu ròu","abbr":"plcr","explanation":"形容身体变瘦。","source":{"text":"你觑我皮里抽肉，你休问我可怎生骨岩岩脸儿黄瘦。","book":"元·关汉卿《谢天香》第四折"},"usage":"作谓语、定语；指身体消瘦"},{"id":32988,"word":"皮里春秋","pinyin":"pí lǐ chūn qiū","abbr":"plcq","explanation":"指藏在心里不说出来的言论。","source":{"text":"曰：‘季野有皮里春秋。’言其外无臧否，而内有所褒贬也。","book":"《晋书·褚裒传》"},"example":{"text":"眼前道路无经纬，～空黑黄。","book":"清·曹雪芹《红楼梦》第38回"},"similar":["皮里阳秋"],"usage":"作定语、状语；用于书面语","story":["东晋时期，谢安经常在众人面前夸奖褚裒风度不凡，尚书吏部郎桓彝见他后也夸他名不虚传，有皮里春秋。口头上不说什么，心里是非分明很有主见。褚裒为官清廉，生活也很简朴，从不假公济私、仗势欺人"]},{"id":32989,"word":"皮里晋书","pinyin":"pí lǐ jìn shū","abbr":"pljs","explanation":"晋书：唐朝房玄龄等撰写的一部史书。比喻博学。","source":{"text":"孝绰子谅，字求信，少好学，有文才，尤博悉晋代故事，时人号曰‘皮里晋书’。","book":"《梁书·刘孝绰传》"}},{"id":32990,"word":"皮里膜外","pinyin":"pí lǐ mó wài","abbr":"plmw","explanation":"膜：生物内部薄皮形的组织。形容肤浅浮泛未能触及实质。","source":{"text":"虎镜在当心，皮里膜外，若脆骨然，取而佩之，临官而能威众，常人则无憎疾矣。","book":"明·郎瑛《七修类稿·事物类》"},"example":{"text":"如今同了你，虽见得太尊一面，到底是个～的帐，有甚么意思。","book":"清·吴敬梓《儒林外史》第四十一回"},"usage":"作定语；用于比喻句"},{"id":32991,"word":"皮里阳秋","pinyin":"pí lǐ yáng qiū","abbr":"plyq","explanation":"指藏在心里不说出来的言论。","source":{"text":"谯国桓彝见而目之曰：‘季野有皮里阳秋。’言其外无臧否，而内有所褒贬也。","book":"《晋书·褚裒传》"},"example":{"text":"胸中褒贬，曰～。","book":"宋·胡继宗《书言故事·事物譬类》"},"similar":["指桑骂槐","委婉曲折"],"opposite":["说一不二","心直口快","开门见山"],"usage":"作定语、状语；用于书面语"},{"id":32992,"word":"皱眉蹙眼","pinyin":"zhòu méi cù yǎn","abbr":"zmcy","explanation":"蹙：收缩。皱眉头，眯眼睛。形容不满的神态。","source":{"text":"安老爷便皱眉蹙眼的问道：‘那里去了？’何小姐答道：‘只怕在书房里罢！’","book":"清·文康《儿女英雄传》第32回"},"example":{"text":"他气得～。"},"usage":"作定语、状语；指不满"},{"id":32993,"word":"皱眉蹙额","pinyin":"zhòu méi cù é","abbr":"zmce","explanation":"蹙：收缩。布满皱纹的样子。","example":{"text":"从他那～的外表看来至少有70岁了。"},"usage":"作定语、状语；指年老的样子"},{"id":32994,"word":"皲手茧足","pinyin":"jūn shǒu jiǎn zú","abbr":"jsjz","explanation":"手皲裂，足生茧。形容竭尽全力。","source":{"text":"凡可以愈愚者，将竭力近气、皲手茧足以求之。","book":"清·严复《与主人论教育书》"},"usage":"作宾语、定语；指竭尽全力"},{"id":32995,"word":"盂方水方","pinyin":"yú fāng shuǐ fāng","abbr":"yfsf","explanation":"盛水的器皿是什么形状，水也成为什么形状。比喻在上的人言行影响风气。","source":{"text":"君者盘也，盘圆而水圆；君者盂也，盂方而水方。","book":"《荀子·君道》"},"similar":["上行下效"],"usage":"作宾语、定语；比喻在上的人言行影响风气"},{"id":32996,"word":"盅虿之谗","pinyin":"gǔ chài zhī chán","abbr":"zczc","explanation":"盅、虿：有毒的虫子；谗：诽谤人的话。像毒虫一样害人的谗言。比喻极为恶毒的毁谤人的话。","source":{"text":"偶遭盅虿之谗，遂抱膏肓之疾。","book":"清·曹雪芹《红楼梦》第七十八回"}},{"id":32997,"word":"盆倾瓮倒","pinyin":"pén qīng wèng dǎo","abbr":"pqwd","explanation":"盆瓮都倾倒过来。形容水、酒等液体急速下泻。","source":{"text":"如今下盆倾瓮瀽的大雨，可也不怕，看有什么人来。","book":"明·无名氏《水篱赏菊》第一折"},"example":{"text":"众人～向口中乱灌，都有了半酣光景，定要珍珠串唱曲子。","book":"清·李绿园《歧路灯》第五十八回"},"similar":["盆倾瓮瀽"],"usage":"作定语、状语；用于液体等"},{"id":32998,"word":"盆倾瓮瀽","pinyin":"pén qīng wèng jiǎn","abbr":"pqwj","explanation":"瀽：倒。盆瓮都倾倒过来。形容水、酒等液体急速下泻。","source":{"text":"如今下盆倾瓮瀽的大雨，可也不怕，看有什么人来。","book":"明·无名氏《水篱赏菊》第一折"},"similar":["盆倾瓮倒"],"usage":"作定语、状语；用于液体等"},{"id":32999,"word":"盆朝天，碗朝地","pinyin":"pén cháo tiān，wǎn cháo dì","abbr":"pctwcd","explanation":"形容家庭中杂乱无条理。","source":{"text":"她们都疯了，我还没疯！看，这里盆朝天碗朝地，没人管。火灭了，开水没有一点，我连碗热茶都喝不到嘴！","book":"老舍《方珍珠》第四幕"},"example":{"text":"紫云看着大夫又要看病，又要伺候老伴，～，家也不像个家。","book":"邓友梅《那五》二"},"usage":"作宾语、定语、状语；指杂乱"},{"id":33000,"word":"盆满钵满","pinyin":"pén mǎn bō mǎn","abbr":"pmbm","explanation":"钵：一种像盆而较小的容器。指取得丰厚的收入。"},{"id":33001,"word":"盈则必亏","pinyin":"yíng zé bì kuī","abbr":"yzbk","explanation":"盈：圆。亏：缺。月圆的时候就是月缺的时候。形容物极必反。","source":{"text":"全则必缺，极则必反，盈则必亏。","book":"战国·卫·吕不韦《吕氏春秋·博志》"},"similar":["月盈则食"],"usage":"作谓语、定语；用于劝诫人"},{"id":33002,"word":"盈千累万","pinyin":"yíng qiān lěi wàn","abbr":"yqlw","explanation":"盈：满；累：积。成千上万。形容数量非常多。","source":{"text":"菜果至贱之物，花亦卑卑不数之花，无如积至贱至卑者而至盈千累万，则贱者贵而卑者尊矣。","book":"清·李渔《闲情偶记·种植·草木》"},"example":{"text":"你看，前一回我们打得九死一生，弟兄们伤得～的。","book":"艾芜《荣归》"},"similar":["成千上万","盈千累百"],"usage":"作定语、状语；形容数量非常多"},{"id":33003,"word":"盈千累百","pinyin":"yíng qiān lěi bǎi","abbr":"yqlb","explanation":"盈：满；累：积。成百上千。形容数量非常多。","source":{"text":"医者若无此橱，药石之名盈千累百，用一物寻一物，则卢医、扁鹊无暇疗病，止能为刻舟求剑之人矣。","book":"清·李渔《闲情偶寄·器玩部·橱柜》"},"example":{"text":"名器之滥，至今已极。～，徒形冗杂。","book":"《清史稿·选举志》"},"similar":["盈千累万"],"usage":"作定语、状语；形容数量非常多"},{"id":33004,"word":"盈尺之地","pinyin":"yǐng chǐ zhī dì","abbr":"yczd","explanation":"几尺大的地方。形容地方非常狭小。","source":{"text":"而君侯何惜阶前盈尺之地，不使白扬眉吐气，激昂青云耶。","book":"唐·李白《与韩荆州书》"},"usage":"作宾语；用于书面语"},{"id":33005,"word":"盈帙满笥","pinyin":"yíng yì mǎn sì","abbr":"yzms","explanation":"帙：装书画的布套；笥：盛衣物的方形竹器。指布套和器物都快装不下了。形容著述或书籍很多。","source":{"text":"文章之美，得之天然，好学不倦，居无尘杂，多所著述，盈帙满笥，淡然得失之际，不见喜愠之容。","book":"《梁书·徐勉传》"}},{"id":33006,"word":"盈把之木","pinyin":"yǐng bà zhī mù","abbr":"ybzm","explanation":"盈：满；木：树。用一把手能握住的小树。比喻仅有小才能的人。","source":{"text":"传曰：骄溢之君寡忠，口惠之人鲜信。故盈把之木无合拱之枝，荣泽之水无吞舟之鱼，根浅则枝叶短，本绝则枝叶枯。","book":"汉·韩婴《韩诗外传》卷五"}},{"id":33007,"word":"盈满之咎","pinyin":"yíng mǎn zhī jiù","abbr":"ymzj","explanation":"财富过于充足会招致祸患。","source":{"text":"吾门户殖财日久，盈满之咎，道家所忌。","book":"南朝·宋·范晔《后汉书·折像传》"},"usage":"作宾语；用于劝诫人"},{"id":33008,"word":"盈盈一水","pinyin":"yíng yíng yī shuǐ","abbr":"yyys","explanation":"盈盈：水清而浅的样子。又清又浅的一片水。比喻相隔不远。","source":{"text":"盈盈一水间，脉脉不得语。","book":"《古诗十九首》之十"},"example":{"text":"其爱妾与吾目成，虽一语未通，而两心相照。但门庭深邃，～，徒怅望耳。","book":"清·纪昀《阅微草堂笔记·滦阳续录》五"},"usage":"作宾语、定语；指小河"},{"id":33009,"word":"盈盈伫立","pinyin":"yíng yíng zhù lì","abbr":"yyzl","explanation":"盈盈：仪态美好的样子；伫立：长时间地站立。体态优美的女子长问题时站立着。","source":{"text":"千娇面、盈盈伫立，无言有泪，断肠争忍回顾。","book":"宋·柳永《采莲令》词"}},{"id":33010,"word":"盈盈在目","pinyin":"yíng yíng zài mù","abbr":"yyzm","explanation":"盈盈：美好的样子。指美好的形象犹在眼前。","source":{"text":"于舟中见一女子，美而艳，来桡去楫，一瞬即过，然思之盈盈在目也。","book":"清·俞樾《楚士吕凤梧》"},"similar":["历历在目"],"usage":"作谓语；指人的记忆"},{"id":33011,"word":"盈盈带水","pinyin":"yíng yíng dài shuǐ","abbr":"yyds","explanation":"盈盈：水清而浅的样子。像一条一带那样不很宽阔但很清澈的水。形容一水之隔，相距不远。","source":{"text":"盈盈带水，翩翩舞雪，相逢解语。","book":"清·朱昂《水龙吟·白莲》词"}},{"id":33012,"word":"盈盈欲笑","pinyin":"yíng yíng yù xiào","abbr":"yyyx","explanation":"盈盈：充满的样子。满脸含着微笑。","source":{"text":"一日见镜中人忽现正面，盈盈欲笑，益重爱之。","book":"清·蒲松龄《聊斋志异·凤仙》"},"example":{"text":"只见他媚眼流波，～，纤腰约素，款款随风，真个是清丽天然，丰姿绝俗。","book":"清·张春帆《九尾龟》第二十七回"},"usage":"作谓语、状语；用于书面语"},{"id":33013,"word":"盈盈秋水","pinyin":"yíng yíng shuǐ qiū","abbr":"yyqs","explanation":"秋水：比喻美女的眼睛象秋天明净的水波一样。形容女子眼神饱含感情。","source":{"text":"望穿他盈盈秋水，蹙损他淡淡春山。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"一般情况，几回断肠，只落得～泪汪汪。","book":"明·张凤翼《红拂记·华夷一统》"},"similar":["秋波盈盈"],"usage":"作宾语、定语；指美女的眼睛"},{"id":33014,"word":"盈科后进","pinyin":"yíng kē hòu jìn","abbr":"ykhj","explanation":"泉水遇到坑洼，要充满之后才继续向前流。比喻学习应步步落实，不能只图虚名。","source":{"text":"原泉混混，不舍昼夜，盈科而后进，放乎四海。","book":"《孟子·离娄下》"},"usage":"作宾语、定语；用于学习与工作"},{"id":33015,"word":"盈箱溢箧","pinyin":"yíng xiāng yì qiè","abbr":"yxyq","explanation":"溢：充满；箧：小箱子。大小箱子都装得满满的，形容东西很多。","source":{"text":"至靖康丙午岁，侯守淄川。闻金人犯京师。四顾茫然，盈箱溢箧，且恋恋，且怅怅，知其必不为己物矣。","book":"宋·李清照《金石录后序》"}},{"id":33016,"word":"盈箱满笥","pinyin":"yíng xiāng mǎn sì","abbr":"yxms","explanation":"笥：盛衣物的方形竹器。指箱子和器物都快装不下了。形容著述或书籍很多。","source":{"text":"文章之美，得之天然，好学不倦，居无尘杂，多所著述，盈帙满笥，淡然得失之际，不见喜愠之容。","book":"南朝·梁·徐勉《答客喻》"},"example":{"text":"今人解书，～，此某之所深惧也。","book":"宋·吴泳《答吴毅夫书》"}},{"id":33017,"word":"盈箱累箧","pinyin":"yíng xiāng lěi qiè","abbr":"yxlq","explanation":"箧：小箱子。大小箱子都装得满满的，形容东西很多。","source":{"text":"至靖康丙午岁，侯守淄川。闻金人犯京师。四顾茫然，盈箱溢箧，且恋恋，且怅怅，知其必不为己物矣。","book":"宋·李清照《金石录后序》"}},{"id":33018,"word":"盈篇累牍","pinyin":"yíng piān lěi dú","abbr":"ypld","explanation":"形容文辞冗长。","source":{"text":"盈篇累牍，而不知其谫陋，此其大蔽欤！","book":"田北湖《论文章源流》"},"usage":"作宾语、定语；用于书面语"},{"id":33019,"word":"盈缩卷舒","pinyin":"yíng suō juǎn shū","abbr":"ysjs","explanation":"有余、不足、弯曲、伸展。泛指余亏、伸屈、进退、长寿、夭折等意。","source":{"text":"至道无为，一龙一蛇，盈缩卷舒，与时变化。","book":"《淮南子·俶真训》"}},{"id":33020,"word":"盈车之鱼","pinyin":"yǐng chē zhī yú","abbr":"yczy","explanation":"盈：满。一条鱼能装满一辆车。形容鱼儿特别大而肥。","source":{"text":"詹何以独茧丝为纶，芒针为钩， 荆筱为竿，剖粒为饵，引盈车之鱼于百仞之渊、汨流之中，纶不绝，钩不伸，竿不挠。","book":"《列子·汤问》"}},{"id":33021,"word":"盈车嘉穗","pinyin":"yǐng chē jiā suì","abbr":"ycjs","explanation":"盈：满。稻重长得茁壮，一棵就能装满一车。形容粮食丰收。","source":{"text":"成王五年，有因祗之国，去王都九万里，又贡嘉禾，一茎盈车。","book":"晋·王嘉《拾遗记·周》"},"example":{"text":"时有白鸾孤翔，衔千茎穗于空中，自生花实，落地则生根叶，一岁百获，一茎满车，故曰～。","book":"明·王世贞《艳异编》卷五"}},{"id":33022,"word":"益上损下","pinyin":"yì shàng sǔn xià","abbr":"yssx","explanation":"使当官的得益，而使百姓利益受损。","source":{"text":"厚己薄人，益上损下，是朕之罪一也。","book":"《清史稿·世祖本纪》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":33023,"word":"益人神智","pinyin":"yì rén shén zhì","abbr":"yrsz","explanation":"使人心灵开窍，增加知识。","source":{"text":"益人神智者，惟书而已。","book":"清·沈尚杰《〈读书敏求记〉序》"}},{"id":33024,"word":"益国利民","pinyin":"yì guó lì mín","abbr":"yglm","explanation":"对国家、对人民都有利。","source":{"text":"参考变通，可以益国利民便时适治者，为二十四新制。","book":"《周书·文帝纪下》"},"example":{"text":"这是～的大好事。"},"similar":["利国利民"],"opposite":["祸国殃民"],"usage":"作谓语、定语；指利国利民"},{"id":33025,"word":"益寿延年","pinyin":"yì shòu yán nián","abbr":"ysyn","explanation":"增加岁数，延长寿命。多用作颂词。","source":{"text":"九窍通郁，精神察滞，延年益寿千万岁。","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"南阳有菊潭，又有甘谷泉，人饮其水，皆得～。","book":"明·无名氏《东篱赏菊》第三折"},"similar":["延年益寿"],"usage":"作谓语、定语、宾语；多用于祝颂"},{"id":33026,"word":"益无忌惮","pinyin":"yì wú jì dàn","abbr":"ywjd","explanation":"益：更加；忌：顾忌；惮：害怕。非常放肆，一点没有顾忌。","source":{"text":"小人之（反）中庸也，小人而无忌惮也。","book":"《礼记·中庸》"},"example":{"text":"适所以使之窥见我之底蕴，知我之无谋，而益无忌惮耳。","book":"宋·朱熹《壬午应诏封事》"},"similar":["肆无忌惮"],"usage":"作谓语、状语；用于处事"},{"id":33027,"word":"益谦亏盈","pinyin":"yì qiān kuī yíng","abbr":"yqky","explanation":"犹谦受益，满招损。","source":{"text":"君咨臣儆，治世之休风，益谦亏盈，检身之至理。","book":"《清史稿·柴潮生传》"},"similar":["谦受益，满招损"],"usage":"作宾语、定语；用于书面语"},{"id":33028,"word":"盎盂相击","pinyin":"àng yú xiāng jī","abbr":"ayxj","explanation":"比喻一家人争吵。","source":{"text":"只就他夫妻三个这番外面情形讲，此后自然该益发合成一片性情，加上几分伉俪，把午间那番盎盂相击化得水乳无痕。","book":"清·文康《儿女英雄传》第31回"},"example":{"text":"每个家庭都不可避免～。"},"similar":["盎盂相敲"],"usage":"作谓语；指家庭纠纷"},{"id":33029,"word":"盎盂相敲","pinyin":"àng yú xiāng qiāo","abbr":"ayxq","explanation":"比喻一家人争吵。","source":{"text":"且盎盂相敲，皆臣所为，无所涉于父母。","book":"清·蒲松龄《聊斋志异·卷十一·青蛙神》"},"similar":["盎盂相击"],"usage":"作谓语；指家庭纠纷"},{"id":33030,"word":"盐梅之寄","pinyin":"yán méi zhī jì","abbr":"ymzj","explanation":"比喻可托付重任。","source":{"text":"盐咸梅醋，羹须咸醋以和之。","book":"语出《书·说命下》：“若作和羹，乐惟盐梅。”孔传"},"example":{"text":"暨夫帝迁明德，义非简在，～，自有攸归。","book":"《隋书·刘虻郑译等到传论》"},"usage":"作主语、宾语；用于比喻句"},{"id":33031,"word":"盐梅相成","pinyin":"yán méi xiāng chéng","abbr":"ymxc","explanation":"盐味与酸味相调和。比喻济世的贤臣。","source":{"text":"窃意二老（太公、伯夷）受文王之养，平居暇日，同堂合席，念王室之如毁，固欲起而救乱；思冠冕裂，又恐因而阶乱，故水火相济，盐梅相成，各以一事自任。","book":"宋罗大经《鹤林玉露》卷十二"},"similar":["相辅相成"],"usage":"作宾语、定语；指相辅相成"},{"id":33032,"word":"盐梅舟楫","pinyin":"yán méi zhōu jí","abbr":"ymzj","explanation":"盐和梅调和，舟和楫配合。比喻辅佐的贤臣。","source":{"text":"际风云，盐梅舟楫，一德务臣君。","book":"元柯丹邱《荆钗记·春科》"},"usage":"作宾语、定语；用于比喻句"},{"id":33033,"word":"盐香风色","pinyin":"yán xiāng fēng sè","abbr":"yxfs","explanation":"盐的香味，风的颜色。盐本无香，风本无色，佛家用以比喻法本无有。","source":{"text":"及世间事中兔角龟毛蛇足盐香风色等。","book":"《成实论》卷一"}},{"id":33034,"word":"监临自盗","pinyin":"jiān lín zì dào","abbr":"jlzd","explanation":"窃取公务上自己看管的财物。同“监主自盗”。","source":{"text":"衍在中书，权幸欲去之，以舜钦监进奏院市故纸监临自盗除名，以撼动衍，衍亦以此求退。","book":"曾慥《类说》卷二引《名臣传·杜衍》"},"example":{"text":"监公使库皇寘坐狱，嗣昌奏请之，遂以～责安化军节度副使，安置郢州。","book":"《宋史·薛嗣昌传》"},"similar":["监守自盗","监主自盗"],"opposite":["以身作则"],"usage":"作谓语、宾语、定语；指盗窃自己看守之物"},{"id":33035,"word":"监主自盗","pinyin":"jiān zhǔ zì dào","abbr":"jzzd","explanation":"窃取公务上自己看管的财物。同“监守自盗”。","source":{"text":"杞怒，谪晋衡州司马，更召他吏绳之，曰：‘监主自盗，罪绞。’","book":"《旧唐书·杨炎传》"},"example":{"text":"我们要坚决打击～的现象。"},"similar":["监守自盗"],"opposite":["以身作则"],"usage":"作谓语、宾语、定语；指盗窃自己看守之物","story":["唐朝时期，杨炎因家族以孝出名而被唐德宗选拔为宰相，他上任把个人恩怨看得很重，引起朝中ん臣的不满，宰相卢杞寻机报复，把他的私宅购作官署，弹劾他“强迫官吏代卖私第，高估房价，同时还监守自盗。”唐德宗下令处死杨炎"]},{"id":33036,"word":"监守自盗","pinyin":"jiān shǒu zì dào","abbr":"jszd","explanation":"监守：监管；盗：偷窃。窃取公务上自己看管的财物。","source":{"text":"即今律所谓主守自盗者也。","book":"《汉书·刑法志》：“守县官财物而即盗之。已论命复有笞罪者，皆弃市。”颜师古注"},"example":{"text":"总之少了谷石，却无案卷可凭，这就是～的匮空。","book":"清·李绿园《歧路灯》第九十四回"},"similar":["见利忘义","知法犯法","贼喊捉贼"],"opposite":["以身作则","两袖清风","克己奉公"],"usage":"作谓语、宾语、定语；指盗窃自己看守之物","story":["唐朝时期，杨炎因家族以孝出名而被唐德宗选拔为宰相，他上任把个人恩怨看得很重，引起朝中大臣的不满，宰相卢杞寻机报复，把他的私宅购作官署，弹劾他“强迫官吏代卖私第，高估房价，同时还监守自盗。”唐德宗下令处死杨炎"]},{"id":33037,"word":"监市履狶","pinyin":"jiān shì lǚ xī","abbr":"jslx","explanation":"比喻善于体察事物。","source":{"text":"正获之问于监市履狶也，每下愈况。”王先谦集解引李颐曰：‘市魁履豕，履其股脚狶难肥处，故知豕肥耳。","book":"《庄子·知北游》"},"example":{"text":"少年有功翰墨林，中岁作吏几陆沉，庖丁解牛妙世故，～知民心。","book":"宋·黄庭坚《寄上叔父夷仲》诗之一"},"usage":"作宾语、定语；用于比喻句"},{"id":33038,"word":"监市履猯","pinyin":"jiān shì lǚ xī","abbr":"jslx","explanation":"比喻善于体察事物。","source":{"text":"正获之问于监市履猯也，每下愈况。王先谦集解引李颐曰‘市魁履豕，履其股脚猯难肥处，故知豕肥耳。","book":"《庄子·知北游》"},"quote":{"text":"少年有功翰墨林，中岁作吏几陆沉，庖丁解牛妙世故，～知民心。","book":"宋·黄庭坚《寄上叔父夷仲》诗之一"}},{"id":33039,"word":"监貌辨色","pinyin":"jiàn mào biàn sè","abbr":"jmbs","explanation":"监：通“鉴”，照，察；貌：容色，外表；辨：辨别，明察；色：脸色。通过观察脸色来辨别对方的心思。形容为人机灵。","source":{"text":"那知乌龟鸨子，是世上第一等精明不过的东西，监貌辨色，早已猜透了九分。","book":"清·夏敬渠《野叟曝言》第33回"},"similar":["见貌辨色","鉴貌辨色"],"usage":"作谓语、宾语、定语；指根据对方的脸色行事"},{"id":33040,"word":"监门之养","pinyin":"jiān mén zhī yǎng","abbr":"jmzy","explanation":"监门：看门人；养：衣食供应。比喻困窘、节俭的生活。","source":{"text":"虽监门之服养，不亏于此矣。","book":"《韩非子·五蠹》"},"example":{"text":"然则夫所贵于有天下者，岂欲苦形劳神，身处逆旅之宿，口食～，手持臣虏之作哉？","book":"《史记·李斯列传》"},"usage":"作宾语；用于书面语"},{"id":33041,"word":"盖不由己","pinyin":"gài bù yóu jǐ","abbr":"gbyj","explanation":"盖：承上文申说理由和原因；由：听命，顺从。不能按照自己的意愿行事。","source":{"text":"上命差遣，盖不由己。","book":"元·无名氏《谢金吾》"},"similar":["身不由己"],"usage":"作谓语；同“身不由己”"},{"id":33042,"word":"盖世之才","pinyin":"gài shì zhī cái","abbr":"gszc","explanation":"盖世：压倒当世，超出世上所有的；才：才能。形容超出当代、无与伦比的才能。","source":{"text":"子房以盖世之才，不为伊尹、太公之谋，而特出于荆轲、聂政之计，以侥幸于不死，此圯上老人所为深惜者也。","book":"宋·苏轼《留侯论》"},"example":{"text":"其人皆有出人之志，～。","book":"明·方孝儒《深虑论》"},"similar":["盖世英雄"],"usage":"作宾语；指无与伦比的英才"},{"id":33043,"word":"盖世无双","pinyin":"gài shì wú shuāng","abbr":"gsws","explanation":"盖：压倒，超过。才能或武艺当代第一，没有人能比得上。","source":{"text":"能御万物则战易胜敌，战易胜敌而论必盖世。","book":"《韩非子·解老》"},"example":{"text":"说得那岳飞人间少有，～。","book":"清·钱彩《说岳全传》第九回"},"similar":["举世无双","绝无仅有"],"opposite":["无独有偶","屡见不鲜"],"usage":"作谓语、定语；形容独一无二","story":["秦朝末年，项羽少年时不喜欢读书，叔父项梁教他击剑，他想学抵敌万人的本事，项梁教他兵法，他不肯认真钻研，但力气大盖世无双，能举起几百斤重的鼎。同刘邦争天下8年，最后被迫在垓下乌江边自刎，感慨自己“力拔山兮气盖世”"]},{"id":33044,"word":"盖世英雄","pinyin":"gài shì yīng xióng","abbr":"gsyx","explanation":"盖世：压倒当世。超出当代所有的人。用以形容非常杰出的英雄人物。","source":{"text":"遮莫他盖世英雄，驱兵拥众。","book":"元·无名氏《马陵道》第一折"},"example":{"text":"是～，始信短如春梦。","book":"清·文康《儿女英雄传》第三十九回"},"similar":["盖世之才"],"usage":"作主语、宾语、定语；指非常杰出人物"},{"id":33045,"word":"盖地而来","pinyin":"gài dì ér lái","abbr":"gdel","explanation":"多指暴风雪、大队人马、飞沙走石等奔涌而至，把大地遮盖起来。用来形容来势凶猛，声势浩大。","source":{"text":"汉军大败，后面漫山塞野，黄巾盖地而来，旗上大写‘天公将军’。","book":"明·罗贯中《三国演义》第一回"},"example":{"text":"玄德登高而望，但见军马～。","book":"明·罗贯中《三国演义》第五十五回"},"usage":"作谓语、状语；用于人或事物等"},{"id":33046,"word":"盖头换面","pinyin":"gài tóu huàn miàn","abbr":"gthm","explanation":"犹改头换面。比喻只改外表和形式，内容实质不变。","source":{"text":"仆窃诵吾兄前后见惠两书，知吾兄痛惩既往之悔，直欲洗刷肠胃，不肯若世之盖头换面做好人者。","book":"明·唐顺之《答王南江提学书》"},"similar":["换汤不换药"],"opposite":["洗心革面"],"usage":"作谓语、宾语、状语；用于变化等"},{"id":33047,"word":"盖棺事定","pinyin":"gài guān shì dìng","abbr":"ggsd","explanation":"犹盖棺论定。指人死后对其一生作出评价。","source":{"text":"自古道盖棺事定，入土为安。","book":"明·冯惟敏《耍孩儿·骷髅诉冤》曲"},"similar":["盖棺论定"],"usage":"作谓语、定语；多用于比喻句"},{"id":33048,"word":"盖棺事已","pinyin":"gài guān shì yǐ","abbr":"ggsy","explanation":"盖：遮盖；已：停止。人死了，事情才算完结。泛指终身坚持或追求某种事业。","source":{"text":"盖棺事则已，此志常觊豁。","book":"唐·杜甫《自京赴奉先县咏怀五百字》"},"usage":"作宾语、定语；用于书面语"},{"id":33049,"word":"盖棺定论","pinyin":"gài guān dìng lùn","abbr":"ggdl","explanation":"盖上棺材盖，才能下结论。指人死后对其一生作出评价。","source":{"text":"行矣且无然，盖棺事乃了。","book":"唐·韩愈《同冠峡》诗"},"example":{"text":"莫道古人多玉碎，～未嫌迟。","book":"明·张煌言《甲辰九月狱中感怀三首》其二"},"similar":["盖棺事定","盖棺论定"],"usage":"作谓语、定语；多用于比喻句"},{"id":33050,"word":"盖棺定谥","pinyin":"gài guān dìng shì","abbr":"ggds","explanation":"谥：谥号。中国帝制时代为死去的帝王或臣僚按其生前表现给予的称号。指人死后才能对他的功过做结论。","source":{"text":"盖棺定谥，先典成功，激扬清浊，治道明范。","book":"《魏书·郑羲传》"}},{"id":33051,"word":"盖棺论定","pinyin":"gài guān lùn dìng","abbr":"ggld","explanation":"论定：下结论。盖上棺材盖，才能下结论。人死后对其一生作出评价。","source":{"text":"行矣且无然，盖棺事乃了。","book":"唐·韩愈《同冠峡》诗"},"example":{"text":"在过去说来，她这个小命运已是被～了，然而在今天，这一切都要重新估计。","book":"茹志娟《在果树园里》"},"similar":["盖棺定论"],"opposite":["未了公案"],"usage":"作谓语、定语；指人死后对其一生作出评价"},{"id":33052,"word":"盗亦有道","pinyin":"dào yì yǒu dào","abbr":"dyyd","explanation":"道：道理。盗贼也有他们的那一套道理。","source":{"text":"盗跖之徒问于跖曰：‘盗亦有道乎？’跖曰：‘何适而无有道耶？夫妄意室中之藏，圣也；入先，勇也；出后，义也；知可否，知也；分均，仁也。……’","book":"《庄子·胠箧》"},"example":{"text":"尝举以告姚安公，谓～也。","book":"清·纪昀《阅微草堂笔记》卷九"},"usage":"作宾语、分句；指小偷也有偷盗的道义"},{"id":33053,"word":"盗名暗世","pinyin":"dào míng àn shì","abbr":"dmas","explanation":"盗：窃取；名：名誉、名称；暗：黑暗。在黑暗时代窃取好的名誉。指奸佞之人在乱世乘机骗取声誉。","source":{"text":"是奸人将以盗名暗世者也。","book":"《荀子·不苟》"},"usage":"作谓语、定语；用于坏人"},{"id":33054,"word":"盗名欺世","pinyin":"dào míng qī shì","abbr":"dmqs","explanation":"盗：窃取；名：名誉；欺：欺骗。窃取名誉，欺骗世人。","source":{"text":"夫贫贱者则求柔之，是非仁人之情也，是奸人将以盗名于暗世者也，险莫大焉。","book":"战国·赵·荀况《荀子·不苟》"},"example":{"text":"伪书却日见风行，我看那些考据学家都是～的。","book":"郁达夫《采石矶》"},"similar":["盗名窃誉","弄虚作假"],"opposite":["实事求是","忠诚老实"],"usage":"作谓语、宾语、定语；指欺骗"},{"id":33055,"word":"盗嫂受金","pinyin":"dào sǎo shòu jīn","abbr":"dssj","explanation":"以之为因小眚而遭谗被疑的典实。","source":{"text":"《史记·陈丞相世家》载，绛侯、灌婴等咸谗陈平曰：臣闻平居家时，盗其嫂；臣闻平受诸将金，金多者得善处，金少者得恶处。于是汉王疑之。"},"example":{"text":"今天下得无有被褐怀玉而钓于渭滨者乎？又得无～而未遇无知者乎？","book":"《三国志·魏志·武帝纪》"},"usage":"作宾语、定语；指贪财乱伦","story":["西汉早期，陈平投降刘邦，被任命为丞相。大将绛侯、灌婴等不服，就向刘邦进谗言攻击陈平，故意捏造陈平在家偷嫂子的丑事和收受手下的金钱，送得多的就给好处，送得少的就给予打击。于是刘邦对陈平产生了怀疑，不在重用他"]},{"id":33056,"word":"盗怨主人","pinyin":"dào yuàn zhǔ rén","abbr":"dyzr","explanation":"比喻奸恶的人怨恨正直的人。同“盗憎主人”。","source":{"text":"盗怨主人，民害其贵，君子知天下之不可盖也。","book":"汉·刘向《说苑·敬慎》"},"similar":["盗憎主人"],"usage":"作谓语、宾语；比喻奸恶者憎恨正直者"},{"id":33057,"word":"盗憎主人","pinyin":"dào zēng zhǔ rén","abbr":"dzzr","explanation":"主人：物主。盗贼憎恨被他所盗窃的物主。比喻邪恶的人憎恨正直的人。","source":{"text":"盗憎主人，民恶其上。子好直言，必及于难。","book":"《左传·成公十五年》"},"example":{"text":"逆胡挑衅，兴此大狱，～，固亦其所。","book":"清·章炳麟《狱中答新闻报》"},"similar":["盗怨主人"],"usage":"作谓语、宾语；比喻奸恶者憎恨正直者"},{"id":33058,"word":"盗玉窃钩","pinyin":"dào yù qiè gōu","abbr":"dyqg","explanation":"玉：贵物。钩：贱物。比喻一切大小窃取之事。","source":{"text":"盛宣怀不过邮传部大臣耳，倘使处于总协理大臣地位，则盗玉窃钩，何事尚不可为。","book":"中国近代史资料丛刊《辛亥革命·武昌起义·清吏条陈》"},"usage":"作宾语、定语；指偷盗"},{"id":33059,"word":"盗贼公行","pinyin":"dào zéi gōng xíng","abbr":"dzgx","explanation":"指社会治安差，盗贼公开行窃，无所顾忌。","source":{"text":"盗贼公行，而夭厉不戒。","book":"《左传·襄公三十一年》"},"example":{"text":"潼关将军才且武，五千士卒健于虎；朝廷养汝为阿谁，～如不睹。","book":"明·方孝孺《潼关》"}},{"id":33060,"word":"盗跖之物","pinyin":"dào zhí zhī wù","abbr":"dzzw","explanation":"跖：人名，传说是先秦时起义军领袖，封建社会称之为盗跖，代指坏人；物：物品。指盗贼抢劫来的东西。","source":{"text":"这银子是我们江南这几个人的，并非盗跖之物，先生如何不受？","book":"清·吴敬梓《儒林外史》第三十八回"},"usage":"作宾语；用于赃物"},{"id":33061,"word":"盗钟掩耳","pinyin":"dào zhōng yǎn ěr","abbr":"dzye","explanation":"盗：盗窃；钟：古代一种乐器。偷钟时捂住自己的耳朵。比喻自欺欺人。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负。以椎毁之，钟况然有音。恐人闻之而夺己也，遽掩其耳。","book":"战国·卫·吕不韦《吕氏春秋·自知》"},"example":{"text":"复又～，嫁祸于人。","book":"《旧唐书·哀帝纪论》"},"similar":["掩耳盗铃","自欺欺人"],"usage":"作定语、宾语；指自欺欺人","story":["从前有个小偷发现人家家门口挂着一口很大的铜钟，他想偷但一个人搬不动，想把他敲碎卖碎铜，担心敲钟时别人听到声音而偷不成，终于想出一个绝妙的主意，就是把自己的耳朵用棉花塞住听不到声音，结果偷窃时被当场逮住"]},{"id":33062,"word":"盗铃掩耳","pinyin":"dào líng yǎn ěr","abbr":"dlye","explanation":"比喻自己欺骗自己。同“盗钟掩耳”。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负。以椎毁之，钟况然有声。恐人闻之而夺己也，遽掩其耳。","book":"战国·卫·吕不韦《吕氏春秋·自知》"},"example":{"text":"你看他～欺天下，卖国甘心作帝皇，有甚商量。","book":"清·伤时子《苍鹰击·戕藩》"},"similar":["掩耳盗铃"],"usage":"作谓语、定语、状语；指自欺欺人"},{"id":33063,"word":"盗食致饱","pinyin":"dào shí zhì bǎo","abbr":"dszb","explanation":"比喻以不正当手段获益。","source":{"text":"或有劫持宰相瑕疵而获酬谢，或有喧聒时人视听求见发遣，以此得官谓为才力，何异盗食致饱，窃衣取温哉！","book":"北齐·颜之推《颜氏家训·省事》"},"usage":"作宾语、定语；用于谋生"},{"id":33064,"word":"盘互交错","pinyin":"pán hù jiāo cuò","abbr":"phjc","explanation":"盘互：交结。比喻彼此相互交结在一起。","source":{"text":"百官盘互，亲疏相错。","book":"东汉·班固《汉书·谷永传》"},"example":{"text":"高山大河，～。","book":"唐·杜牧《战论》"},"similar":["盘根错节"],"usage":"作谓语、定语；指关系复杂"},{"id":33065,"word":"盘古开天地","pinyin":"pán gǔ kāi tiān dì","abbr":"pgktd","explanation":"指人类开始有了历史。","source":{"text":"自从盘古开天地，三皇五帝夏商君。","book":"《明成化说唱词话·花关索出身传》"},"example":{"text":"自从～，三皇五帝到于今。","book":"毛泽东《论反对日本帝国主义的策略》"},"similar":["开天辟地"],"usage":"作宾语；比喻历史的开端"},{"id":33066,"word":"盘山涉涧","pinyin":"pán shān shè jiàn","abbr":"pssj","explanation":"盘：回旋，缠绕；涉：徒步过水；涧：山间流水的沟。形容远行的艰辛。","source":{"text":"吃辛吃苦，盘山涉涧。","book":"宋·释道原《景德传灯录》卷二十二"}},{"id":33067,"word":"盘木朽株","pinyin":"pán mù xiǔ zhū","abbr":"pmxz","explanation":"不成材的曲木朽木。比喻劣材。","source":{"text":"盘木朽株，为万乘用者，左右为之容耳。王者取士，宜拔众之所贵。","book":"《后汉书·循史传·孟尝》"}},{"id":33068,"word":"盘根究底","pinyin":"pán gēn jiū dǐ","abbr":"pgjd","explanation":"盘：仔细查问；究：追究。盘问、追究事情的根由。","source":{"text":"无如林之洋虽在海外走过几次，诸事并不留心，究竟见闻不广，被小山盘根问底，今日也谈，明日也谈，腹中所有若干典故，久已告竣。","book":"清·李汝珍《镜花缘》第四十四回"},"example":{"text":"我失悔我不应该～，这样地苦了她。（郭沫若《牧羊哀话》）"},"similar":["寻根究底","盘根问底"],"usage":"作谓语、宾语；指盘问、追究事情的根由"},{"id":33069,"word":"盘根错节","pinyin":"pán gēn cuò jié","abbr":"pgcj","explanation":"盘：盘曲；错：交错；节：枝节。树木的根枝盘旋交错。比喻事情纷难复杂。","source":{"text":"志不求易，事不避难，臣之职也；不遇盘根错节，何以别利器乎？","book":"《后汉书·虞诩传》"},"example":{"text":"莫谓乡村阻力多，～须能手。","book":"徐特立《毕业歌》"},"similar":["错综复杂","根深蒂固"],"opposite":["简明扼要"],"usage":"作谓语、宾语、定语；比喻事情复杂","story":["东汉读书人虞诩应太尉李修的聘请为官，西羌突然入侵，他与大将军邓骘的用兵存在分歧而产生矛盾。邓后来找机会报复性调他去朝歌任职。虞诩则认为这是好事，就像砍树应砍那些坚硬的盘根错节，这样才显出斧头的锋利"]},{"id":33070,"word":"盘根问底","pinyin":"pán gēn wèn dǐ","abbr":"pgwd","explanation":"盘：仔细查问；问：寻问。盘问、追究事情的根由。","source":{"text":"被小山盘根问底，今日也谈，明日也谈，腹中所有若干故典，久己告竣。","book":"清·李汝珍《镜花缘》"},"example":{"text":"他～，一定要弄明白。"},"similar":["盘根究底","刨根问底"],"usage":"作谓语、宾语；同“盘根究底”"},{"id":33071,"word":"盘水加剑","pinyin":"pán shuǐ jiā jiàn","abbr":"psjj","explanation":"汉代大臣自杀处死的一种表示。加剑：自杀。","source":{"text":"故其在大谴大何之域者，闻谴何则白冠氂缨，盘水加剑，造请室而请罪耳，上不执缚系引而行也。","book":"《汉书·贾谊传》"},"example":{"text":"太祖常与侍臣论待大臣之礼，太史令刘基曰：‘古者公卿有罪，～，诣请室自裁，未尝轻折辱之，所以存大臣之体。’","book":"《明史·刑法志三》"},"usage":"作宾语、定语；指甘愿请罪"},{"id":33072,"word":"盘游无度","pinyin":"pán yóu wú dù","abbr":"pywd","explanation":"盘游：游乐；度：限度。耽于游乐，没有限度。","source":{"text":"乃盘游无度，畋于有洛之表，十旬弗反。","book":"《尚书·五子之歌》"},"example":{"text":"天柱念帝～，廷臣虽谏，帝意不回，思所以感动之者，乃刺血草疏。","book":"《明史·石天柱传》"},"usage":"作谓语、宾语；指游乐没有限度"},{"id":33073,"word":"盘石之固","pinyin":"pán shí zhī gù","abbr":"pszg","explanation":"比喻坚固不可动摇。","source":{"text":"于是乎立其封疆之典，裁其亲疏之宜，使万国相难，以成盘石之固。","book":"《晋书·陆机传》"},"similar":["盘石之安","磐石之固"],"usage":"作宾语；形容极其安定稳固"},{"id":33074,"word":"盘石之安","pinyin":"pán shí zhī ān","abbr":"psza","explanation":"形容极其安定稳固。","source":{"text":"为名者否，为利者否，为忿者否，则国安于盘石，寿于旗翼。","book":"先秦·荀况《荀子·富国》"},"example":{"text":"某有一计，令西蜀之兵不犯东吴，荆州如～。","book":"明·罗贯中《三国演义》第77回"},"similar":["盘石之固","磐石之安"],"usage":"作宾语；形容极其安定稳固"},{"id":33075,"word":"盘石桑苞","pinyin":"pán shí sāng bāo","abbr":"pssb","explanation":"盘石：大石；桑苞：即苞桑，根深柢固的桑树。比喻安稳牢固。","source":{"text":"苞，本也。凡物系于桑之苞本则牢固也……桑之为物，其根众也，众则牢固之义。","book":"《易·否》：“系于苞桑。”孔颖达疏"},"example":{"text":"盖惩于鬼方之叛殷，莱夷之争齐，而早为～之固也。","book":"清·方苞《周公论》"},"usage":"作定语、宾语；用于比喻句"},{"id":33076,"word":"盘石犬牙","pinyin":"pán shí quǎn yá","abbr":"psqy","explanation":"盘石：巨石。指分封宗室以巩固其统治。","source":{"text":"文昭武穆，方驾于鲁、卫、应、韩；盘石犬牙，连衡于吴、楚、齐、代。","book":"《晋书·武十三王等传论》"},"similar":["犬牙盘石"],"usage":"作宾语、定语；用于比喻句"},{"id":33077,"word":"盘空硬语","pinyin":"pán kōng yìng yǔ","abbr":"pkyy","explanation":"硬：指行文遒劲有力。语言遒劲有力像能在空中盘旋一样。形容诗文气势磅礴，矫健雄浑。","source":{"text":"横空盘硬语，妥贴力排奡。","book":"唐·韩愈《荐士》"},"example":{"text":"昌黎极有古音，惜其不由正道，反为～，以文入诗，欲自成一有言，难矣。","book":"清·黄子云《野鸿诗的》九十六"},"usage":"作宾语、定语；用于文章等"},{"id":33078,"word":"盘踞要津","pinyin":"pán jù yào jīn","abbr":"pjyj","explanation":"津：渡口；要津：比喻关键职务或重要位置。指占据显要的位置。","source":{"text":"今观安石汲引亲党，盘踞要津，挤排异己。","book":"宋·邵伯温《闻见前录》卷十一"},"example":{"text":"嘉靖中年，有一位大奸臣，乘时得志，～，秉政二十余年，害得明朝元气，剥削殆尽，几乎亡国败家。","book":"蔡东藩《明史演义》第六十回"},"usage":"作谓语、宾语；用于处事"},{"id":33079,"word":"盘马弯弓","pinyin":"pán mǎ wān gōng","abbr":"pmwg","explanation":"驰马盘旋，张弓要射。形容摆开架势，准备作战。后比喻故做惊人的姿态，实际上并不立即行动。","source":{"text":"将军欲以巧伏人，盘马弯弓惜不发。","book":"唐·韩愈《雉带箭》诗"},"example":{"text":"不知道袁世凯这种～，适可而止，就是对民军一打一拉。","book":"李六如《六十年代的变迁》第六章"},"similar":["故作姿态"],"opposite":["立竿见影","不得不发"],"usage":"作谓语、宾语、定语；指故做姿态","story":["唐朝时期，从小失去父母的韩愈在嫂子扶养下，刻苦好学，25岁考中进士，当时不能安排做大官，只能在武军节度使张建手下做推官，他随张建去打野鸡，即兴作《雉带箭》诗：“原头火猎静兀兀，野雉畏鹰出复没。将军欲以巧伏人，盘马弯弓惜不发。”"]},{"id":33080,"word":"盘龙之癖","pinyin":"pán lóng zhī pǐ","abbr":"plzp","explanation":"指爱好赌博的恶习。","source":{"text":"《晋书·刘毅传》记载：晋朝人刘毅，字盘龙，好赌博，每次下注达数百万"},"example":{"text":"《晋书·刘毅传》记载：刘毅小名盘龙，好赌博，每次下注达数百万。"},"usage":"作宾语；指爱好赌博的恶习","story":["晋朝时期，刘毅，字盘龙，是一个有名的赌徒，特别好赌博。他的癖好就是每次下注达数百万之上，赌注之大，让人目瞪口呆，因此很多人都怕他，不敢与他赌，他只好到东府去聚众赌博"]},{"id":33081,"word":"盘龙卧虎","pinyin":"pán lóng wò hǔ","abbr":"plwh","explanation":"盘：盘旋，弯曲。盘曲的龙，卧居的虎。比喻隐藏的人才。","example":{"text":"这里是盘龙卧虎，人才济济。"},"similar":["藏龙卧虎"],"usage":"作定语、状语；比喻隐藏的人才"},{"id":33082,"word":"盛不忘衰","pinyin":"shèng bù wàng shuāi","abbr":"sbws","explanation":"兴盛时不忘记衰败时。形容安不忘危，能深谋远虑。","source":{"text":"及孝元时，仪罢守塞之备，侯应以为不可，可谓盛不忘衰，安必思危，远见识微之明矣。","book":"《汉书·匈奴传》"},"similar":["盛必虑衰"],"usage":"作宾语、定语；用于处事"},{"id":33083,"word":"盛况空前","pinyin":"shèng kuàng kōng qián","abbr":"skkq","explanation":"形容热闹至极。","source":{"text":"今日在广场上有数万人参加国庆游行，真是～。"},"example":{"text":"我们村这次大比赛真是～"},"usage":"作谓语、定语；用于口语"},{"id":33084,"word":"盛名之下，其实难副","pinyin":"shèng míng zhī xià，qí shí nán fù","abbr":"smzxqsnf","explanation":"盛：大；副：相称，符合。名望很大的人，实际的才德常是很难跟名声相符。指名声常常可能大于实际。用来表示谦虚或自我警戒。","source":{"text":"阳春之曲，和者必寡；盛名之下，其实难副。","book":"《后汉书·黄琼传》"},"example":{"text":"可是闯王知兄虚名，推诚相待，献策等又过为吹嘘。古人云：“～。”","book":"姚雪垠《李自成》第二卷第四十七章"},"similar":["盛名难副"],"opposite":["名副其实"],"usage":"作宾语、分句；表示谦虚或自我警戒","story":["东汉时期，知识分子经过举荐和征召进入仕途，黄琼出身于宦官世家，由众多公卿推荐入京应召，他到洛阳附近的嵩阳县时装病不去，好友李固给他写信，劝他应聘做官。如果不去就会让人说“盛名之下，其实难副”，黄琼决心用行动证明名副其实"]},{"id":33085,"word":"盛名之下，其实难符","pinyin":"shèng míng zhī xià，qí shí nán fù","abbr":"smzxqsnf","explanation":"名望很大的人，实际的才德常是很难跟名声相符。指名声常常可能大于实际。用来表示谦虚或自我警戒。","source":{"text":"阳春之曲，和者必寡；盛名之下，其实难副。","book":"《后汉书·黄琼传》"}},{"id":33086,"word":"盛名难副","pinyin":"shèng míng nán fù","abbr":"smnf","explanation":"盛：大；副：相称，符合。名望很大的人，实际的才德常是很难跟名声相符。指名声常常可能大于实际。用来表示谦虚或自我警戒。","source":{"text":"阳春之曲，和者必寡；盛名之下，其实难副。","book":"《后汉书·黄琼传》"},"example":{"text":"外国的东西并不是都好，就是那些称之为好的东西中，也有些是～。"},"similar":["名不副实","名过其实"],"opposite":["名副其实"],"usage":"作谓语、定语；表示自我谦虚","story":["东汉时期，知识分子经过举荐和征召进入仕途，黄琼出身于宦官世家，由众多公卿推荐入京应召，他到洛阳附近的嵩阳县时装病不去，好友李固给他写信，劝他应聘做官。如果不去就会让人说“盛名之下，其实难副”，黄琼决心用行动证明名副其实"]},{"id":33087,"word":"盛宴难再","pinyin":"shèng yàn nán zài","abbr":"synz","explanation":"筵：酒席。盛大的宴会难再遇到。比喻美好的光景不可多得。","source":{"text":"胜地不常，盛筵难再。","book":"唐·王勃《滕王阁序》"}},{"id":33088,"word":"盛年不再","pinyin":"shèng nián bù zài","abbr":"snbz","explanation":"盛年：壮年；不再：一去不再来。指要珍惜壮年的大好时光。","source":{"text":"盛年不重来，一日难再晨，及时当勉励，岁月不待人。","book":"晋·陶潜《杂诗》"},"example":{"text":"～得，高枝难重攀。","book":"唐·王勃《落花落》"}},{"id":33089,"word":"盛年不重来","pinyin":"shèng nián bù chóng lái","abbr":"snbzl","explanation":"盛年：壮年；重：重新。指要珍惜壮年的大好时光。","source":{"text":"盛年不重来，一日难再晨，及时当勉励，岁月不待人。","book":"晋·陶潜《杂诗》"}},{"id":33090,"word":"盛德不泯","pinyin":"shèng dé bù mǐn","abbr":"sdbm","explanation":"盛大的德行永远不会泯灭。指大德者永世受人崇敬。","source":{"text":"夫盛德不泯，义存祀典。","book":"南朝·宋·傅亮《为宋公修张良庙教》"},"usage":"作谓语、定语；用于书面语"},{"id":33091,"word":"盛德若愚","pinyin":"shèng dé ruò yú","abbr":"sdry","explanation":"盛德：极高的品德；愚：愚笨。形容品德高尚的人谦逊朴实，外表看来好像愚笨的样子。","source":{"text":"良贾深藏若虚，君子盛德，其容貌谦退有若愚鲁之人然。","book":"《史记·老子韩非列传》"},"example":{"text":"良贾深藏若虚，君子～。去子之骄气与多欲淫志，是皆无益于子也。","book":"宋·李昉《太平广记》卷一"}},{"id":33092,"word":"盛德遗范","pinyin":"shèng dé yí fàn","abbr":"sdyf","explanation":"指先人的美德懿范。","source":{"text":"宋璟见陟叹曰：‘盛德遗范，尽在是矣。’","book":"《新唐书·韦陟传》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":33093,"word":"盛必虑衰","pinyin":"shèng bì lǜ shuāi","abbr":"sbls","explanation":"兴盛之时必须考虑衰微之时。","source":{"text":"且安不忘危，盛必虑衰。今国家素无文帝累年节俭富饶之畜，又无武帝荐延枭俊禽敌之臣，独有一陈汤耳。","book":"汉·耿育《上书言便宜因冤讼陈汤》"},"similar":["安不忘危","盛不忘衰"],"usage":"作宾语、定语；用于处事"},{"id":33094,"word":"盛情难却","pinyin":"shèng qíng nán què","abbr":"sqnq","explanation":"浓厚的情意难以推辞。","source":{"text":"为了盛情难却，王有龄跟着去了。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"朋友们再三要为我饯行，因～，我只好接受了。"},"similar":["情意难却"],"usage":"作谓语、定语、宾语；用于交往"},{"id":33095,"word":"盛暑祁寒","pinyin":"shèng shǔ qí hán","abbr":"ssqh","explanation":"祁：大。炎热的夏天，严寒的冬季。形容气候条件恶劣的时节。","source":{"text":"指命仆役，亦用礼节，盛暑祁寒，不使冒犯。","book":"《旧五代史·晋书·崔棁传》"},"example":{"text":"《清史稿·圣祖本纪》：“军兴以来，将士披坚执锐，～，备极劳苦。”"},"similar":["严寒酷暑"],"usage":"作主语、宾语、定语；用于气候等"},{"id":33096,"word":"盛服先生","pinyin":"shèng féi xiān shēng","abbr":"sfxs","explanation":"指戴儒冠，穿儒装，衣冠齐整的文人。","source":{"text":"故盛服先生，不用于世，忠良切言，皆郁于胸，誉谀之声，日满于耳，虚美熏心，实祸蔽塞，此乃秦之所以亡天下也。","book":"汉·刘向《说苑·贵德》"},"example":{"text":"～，谓儒绅也，秦之时，羞文学，好武勇，故称。","book":"明·田艺蘅《留青日札》"}},{"id":33097,"word":"盛极一时","pinyin":"shèng jí yī shí","abbr":"sjys","explanation":"形容一时特别兴盛或流行。","source":{"text":"刘氏名弗耀于远，而其说盛行一时。","book":"清·方东树《刘悌堂诗集序》"},"example":{"text":"侨胞亦知崇拜本国至圣，保存东方文明，故能发扬光大，～也。","book":"鲁迅《三闲集·述香港恭祝圣诞》"},"similar":["烜赫一时","方兴未艾"],"opposite":["每况愈下","一落千丈"],"usage":"作谓语、宾语；指一时特别流行"},{"id":33098,"word":"盛极必衰","pinyin":"shèng jí bì shuāi","abbr":"sjbs","explanation":"兴盛到了极点就会衰败。","source":{"text":"任何事情都是盛极必衰。","book":"章诒和《往事并不如烟·君子之交》"},"similar":["物极必反"],"usage":"作宾语、定语；用于事物等"},{"id":33099,"word":"盛气临人","pinyin":"shèng qì lín rén","abbr":"sqlr","explanation":"形容傲慢自大，气势逼人。亦作“盛气凌人”。","source":{"text":"时户部待郎李公椿年建议行经界，选公为龙游县覆实官，约束严峻，已量之田隐藏亩步，不以多寡率至黥配，盛气临人，无敢忤者。","book":"宋·楼钥《敷文阁学士宣奉大夫汪公行状》"},"similar":["盛气临人"],"usage":"作谓语、定语、状语；指傲慢自大"},{"id":33100,"word":"盛气凌人","pinyin":"shèng qì líng rén","abbr":"sqlr","explanation":"盛气：骄横的气焰；凌：欺凌。以骄横的气势压人。形容傲慢自大，气势逼人。","source":{"text":"不得盛气凌人，自取耻辱。","book":"宋·朱熹《朱子全书·学五·教人》"},"example":{"text":"共产党员决不可自以为是，～，以为自己是什么都好，别人是什么都不好。","book":"毛泽东《在陕甘宁边区参议会的演说》"},"similar":["目中无人","盛气临人","咄咄逼人"],"opposite":["虚怀若谷","谦虚谨慎"],"usage":"作谓语、宾语、定语、状语；指傲慢自大","story":["战国时赵太后辅佐年幼的赵孝成王执政，秦国趁机进攻赵国。赵国向齐国求救，齐国要求赵太后的小儿子长安君到齐国当人质，赵太后不肯。大臣触龙求见，赵太后装出一幅盛气凌人的样子，触龙入情入理的开导终于使赵太后同意齐国要求"]},{"id":33101,"word":"盛水不漏","pinyin":"chéng shuǐ bù lòu","abbr":"csbl","explanation":"比喻说理严密。","source":{"text":"霍氏之哲学，理论极密，前呼后应，几有盛水不漏之观。","book":"梁启超《霍布士学案》"},"example":{"text":"我觉得他这句话说得真好，真正是～，真正把共产主义运动说穿了。","book":"郭沫若《盲肠炎·穷汉的穷谈》"},"similar":["滴水不漏"],"usage":"作宾语、定语；用于口语"},{"id":33102,"word":"盛筵必散","pinyin":"shèng yán bì sàn","abbr":"sybs","explanation":"比喻无论怎样美好的事物，终必消散。","source":{"text":"要知道也不过是瞬息的繁华，一时的欢乐，万不可忘了那‘盛筵必散’的俗语。","book":"清·曹雪芹《红楼梦》第十三回"},"example":{"text":"少年欢乐事，鸾笙凤管，曲能宵分。怪～，青鬓难存。","book":"清·王嗣槐《满庭芳》词"},"similar":["盛筵易散"],"usage":"作宾语、定语；多用于比喻句"},{"id":33103,"word":"盛筵易散","pinyin":"shèng yàn yì sàn","abbr":"syys","explanation":"盛大的宴会容易散席。比喻良辰美景不会长存，容易消失。","source":{"text":"胜地不常，盛筵难再。","book":"唐·王勃《滕王阁序》"},"example":{"text":"少年欢乐事，鸾笙凤管，曲罢宵分。怪～，青髩难存。","book":"清·王嗣槐《满庭芳》词"},"similar":["盛筵必散"],"usage":"作宾语、定语；多用于比喻句"},{"id":33104,"word":"盛筵难再","pinyin":"shèng yàn nán zài","abbr":"synz","explanation":"筵：酒席。盛大的宴会难再遇到。比喻美好的光景不可多得。","source":{"text":"胜地不常，盛筵难再。","book":"唐·王勃《滕王阁序》"},"example":{"text":"知道明年，重逢此日，萍踪飘转在谁边？多应向，山程水驿，茸帽控丝鞭。花知识，～，也合潸然。","book":"清·曹直《多丽·桂花下作》"},"similar":["盛筵必散"],"usage":"作谓语、宾语；指良机不易重逢","story":["唐朝时期，“初唐四杰”的王勃因为他的《檄英王鸡》得罪了唐高宗而被放逐，他到交趾探望父亲，路经洪州，恰好是重阳节，洪州都督阎伯屿大宴宾客，吟诗作乐，场面非常壮观。王勃起兴作《滕王阁诗序》“胜地不常，盛筵难再。”"]},{"id":33105,"word":"盛肥丁瘦","pinyin":"shèng féi dīng shòu","abbr":"sfds","explanation":"宋代文人盛度休胖而为文粗疏，丁谓体瘦而作诗精优。比喻文如其人。","source":{"text":"盛文肃公丰肥，丁晋公疏瘦，时语：盛肥丁瘦。","book":"宋·欧阳修《归田录》卷二"}},{"id":33106,"word":"盛行一时","pinyin":"shèng xíng yī shí","abbr":"sxys","explanation":"盛：兴旺、兴盛。形容一时特别兴盛或流行。","source":{"text":"极一时之盛。","book":"明·归有光《沧浪亭记》"},"example":{"text":"刘氏名弗耀于远，而其说～。","book":"清·方东树《刘悌堂诗集序》"}},{"id":33107,"word":"盛行于世","pinyin":"shèng xíng yú shì","abbr":"sxys","explanation":"盛：广泛。在社会上特别流行。","source":{"text":"后著《正道歌》，盛行于世。","book":"唐·释惠能《六祖大师法宝坛经·机缘品第八》"},"example":{"text":"然韩、柳、曾、王之全集，自李汉、刘禹锡、赵汝砺、危素之所编次，皆已传刻，至今～。","book":"明·李绍《重刊苏文忠公全集序》"}},{"id":33108,"word":"盛衰兴废","pinyin":"shèng shuāi xīng fèi","abbr":"ssxf","explanation":"盛：兴盛；衰：衰败；兴：兴旺；废：废弃。指人与事变化发展的各种情况。","source":{"text":"呜呼！盛衰兴废之理，自古如此。","book":"宋·王安石《祭欧阳文忠文》"},"example":{"text":"人都会有～的时候，犹如生老病死一样。"},"usage":"作主语、宾语；指人与事变化发展的各种情况"},{"id":33109,"word":"盛衰利害","pinyin":"shèng shuāi lì hài","abbr":"sslh","explanation":"兴盛、衰落、利益、损害。指世间人事发展的诸多情况。","source":{"text":"盛衰利害不能易，哀乐不能移。","book":"《列子·仲尼》"},"usage":"作宾语、定语；用于人或事物等"},{"id":33110,"word":"盛衰相乘","pinyin":"shèng shuāi xiāng chéng","abbr":"ssxc","explanation":"乘：乘除之缩略，本指乘法和除法，比喻消长。人事的兴盛和衰微互相消长。","source":{"text":"以古准今，盛衰相乘，物理变化，圣人处之，岂非粟粟危惧，不敢自暇之时乎？","book":"宋·辛弃疾《论荆襄上流为东南重地》"},"usage":"作宾语、定语；用于书面语"},{"id":33111,"word":"盛衰荣辱","pinyin":"shèng shuāi róng rǔ","abbr":"ssrr","explanation":"兴盛、衰败、荣耀、耻辱。指人事变化发展的各种情况。","source":{"text":"枢机之发，荣辱之主也。","book":"《周易·杂卦》：“损、益，盛衰之始也。”《周易·系辞上》"},"example":{"text":"虽～，所遇难齐，而道德文章，俱垂不朽。（明·方孝孺《文会疏》）"},"usage":"作主语、宾语、定语；用于人和事物"},{"id":33112,"word":"盛食厉兵","pinyin":"shèng shí lì bīng","abbr":"sslb","explanation":"吃饱饭，磨快兵器。比喻做好战斗准备。","source":{"text":"壮男之军，使励食厉兵，陈而待敌。","book":"《商君书·兵守》"},"usage":"作谓语；指准备战斗"},{"id":33113,"word":"盟山誓海","pinyin":"méng shān shì hǎi","abbr":"mssh","explanation":"犹海誓山盟。对着山海盟誓。极言男女相爱，坚贞不渝。","source":{"text":"我则怕梁山伯不恋我这祝英台。他若是背义忘恩寻罪责，我将这盟山誓海说的明白。","book":"元王实甫《四块玉》套曲"},"example":{"text":"谁知覆地翻天际，别有～情。佳人少小生南国，玉娇小字传乡邑。","book":"柳亚子《玉娇曲为钝赋》"},"similar":["山盟海誓","誓海盟山","誓山盟海"],"opposite":["见异思迁"],"usage":"作宾语、定语；用于男女之间"},{"id":33114,"word":"盥耳山栖","pinyin":"guàn ěr shān qī","abbr":"gesq","explanation":"盥：洗；栖：居住。相传远古时隐士许由，不愿接受尧帝的封让，躲到山里，用颖水洗耳，以免受传言的污染。比喻隐居不仕。","source":{"text":"入士或掩目而渊潜，或盥耳而山栖。","book":"《后汉书·崔骃传》"},"similar":["许由洗耳"],"usage":"作宾语、定语；指隐居","story":["远古时期，尧听说德高望重的贤士许由很有本事，就想传位给他。许由听说后连夜逃走到箕山隐栖。他喜欢过清静的隐居生活。尧派人四处寻找，终于在箕山找到了他，请他出山为王。许由坚决不从，觉得耳朵被弄脏就跑到河边反复冲洗耳朵"]},{"id":33115,"word":"目下十行","pinyin":"mù xià shí háng","abbr":"mxsh","explanation":"形容看书速度极快。","source":{"text":"一个首相姓王名安石，临川人也。此人目下十行，书穷万卷。","book":"《京本通俗小说·拗相公》"},"example":{"text":"明·冯梦龙《警世通言》第四卷：“此人～，书穷万卷。”"},"similar":["一目十行"],"usage":"作谓语；指读书"},{"id":33116,"word":"目不交睫","pinyin":"mù bù jiāo jié","abbr":"mbjj","explanation":"交睫：上下睫毛相交接，即闭眼。没有合上眼皮。形容夜间不睡觉或睡不着。","source":{"text":"陛下居代时，太后尝病，三年，陛下不交睫，不解衣。","book":"《史记·袁盎晁错列传》"},"example":{"text":"生恚怒方甚，自昏达旦，目不交睫。","book":"唐·白行简《李娃传》"},"similar":["长夜不眠"],"usage":"作谓语、状语；指夜间不睡觉或睡不着"},{"id":33117,"word":"目不别视","pinyin":"mù bù bié shì","abbr":"mbbs","explanation":"mù  bù  bié  shì","source":{"text":"眼睛不往别处看。形容神情十分专注的样子。"},"example":{"text":"清·曹雪芹《红楼梦》第四十八回：“因见他姐妹们说笑，便自己走到阶下竹前，挖心搜胆的耳不旁听，目不别视。”"},"similar":["目不斜视"],"usage":"作谓语、定语、状语；指神情严肃"},{"id":33118,"word":"目不妄视","pinyin":"mù bù wàng shì","abbr":"mbws","explanation":"妄：胡乱。不随便乱看。形容遵守礼制。","source":{"text":"为人耳不邪听，目不妄视。","book":"《后汉书·陶谦传》"},"example":{"text":"善聪～，足不乱移。","book":"明·冯梦龙《喻世明言》卷二十八"},"similar":["目不斜视"],"usage":"作谓语、状语；指有礼貌"},{"id":33119,"word":"目不忍睹","pinyin":"mù bù rěn dǔ","abbr":"mbrd","explanation":"眼睛不忍看，形容景象很凄惨。","source":{"text":"而军士之折臂断足，血流殷地，偃仰僵仆者，令人目不忍睹。","book":"清·薛福成《观巴黎油画记》"},"example":{"text":"尸横遍野、白骨累累，令人～。"},"similar":["惨不忍睹"],"opposite":["赏心悦目"],"usage":"作谓语、定语、补语；指景象很凄惨"},{"id":33120,"word":"目不忍见","pinyin":"mù bù rěn jiàn","abbr":"mbrj","explanation":"形容景象极其悲惨。同“目不忍视”。","source":{"text":"真为目不忍见。","book":"《广东军务记》"},"example":{"text":"地震过后，到处都是～的惨象。"},"similar":["目不忍睹"],"opposite":["赏心悦目"],"usage":"作谓语、定语、状语；指情景很凄惨"},{"id":33121,"word":"目不忍见，耳不堪闻","pinyin":"mù bù rěn jiàn，ěr bù kān wén","abbr":"mbrjebkw","explanation":"堪：可。不忍心看，不忍心听。形容情景十分凄惨。","source":{"text":"想其时，陈言为之祸，必有出于目不忍见，耳不堪闻者。","book":"清·叶燮《原诗·内篇》"},"similar":["目不忍视，耳不忍闻"],"usage":"作谓语、定语、宾语；用于事件或局面等"},{"id":33122,"word":"目不忍视","pinyin":"mù bù rěn shì","abbr":"mbrs","explanation":"凄惨得叫人不忍心看。","source":{"text":"钦宗听罢，不好回言，只是暗暗泪落，目不忍视，好好打发了他出去。","book":"唐·李华《吊古战场文》：“伤心惨目，有如是耶！”明·凌濛初《二刻拍案惊奇》卷七"},"example":{"text":"惨象，已使我～了；流言，尤使我耳不忍闻。","book":"鲁迅《华盖集续编·记念刘和珍君》"},"similar":["目不忍见","惨不忍睹"],"opposite":["赏心悦目"],"usage":"作谓语、定语、状语；指情景很凄惨"},{"id":33123,"word":"目不忍视，耳不忍闻","pinyin":"mù bù rěn shì，ěr bù rěn wén","abbr":"mbrsebrw","explanation":"眼睛不忍看，耳朵不忍听。形容景象极其悲惨。","source":{"text":"想其时，陈言为之祸，必有出于目不忍见，耳不忍闻者。","book":"清·叶燮《原诗·内篇》"},"example":{"text":"若将其坑降之迹演以杂剧，累一月描写之，当无人不恻其心，哀矜涕泗，～矣。","book":"清·康有为《大同书》乙部"},"similar":["目不忍见，耳不堪闻"],"usage":"作谓语、定语、宾语；用于事件或局面等"},{"id":33124,"word":"目不斜视","pinyin":"mù bù xié shì","abbr":"mbxs","explanation":"眼睛不偷看旁边。比喻为人行止端方。也形容只朝一个方向看。","source":{"text":"古者圣王有胎教之法，怀子三月，出居别宫，目不邪视，耳不妄听，音声滋味，以礼节之。","book":"北齐·颜之推《颜氏家训·教子》"},"example":{"text":"在些在走过以后，还要扭头看一看，但改霞～。","book":"柳青《创业史》第一部第六章"},"similar":["目不转睛"],"opposite":["左顾右盼"],"usage":"作谓语、定语、状语；指神情严肃"},{"id":33125,"word":"目不旁视","pinyin":"mù bù páng shì","abbr":"mbps","explanation":"视：看。形容对身边的事物不关心或不愿看。","source":{"text":"因见他姐妹们说笑，便自己走到阶下竹前，挖心搜胆的耳不旁听，目不别视。","book":"清·曹雪芹《红楼梦》第四十八回"},"example":{"text":"老舍《骆驼祥子》：“他～，仿佛街上没有人，也没有东西。”"},"similar":["目不别视","目不斜视"],"usage":"作谓语、定语、状语；指人的神情"},{"id":33126,"word":"目不暇接","pinyin":"mù bù xiá jiē","abbr":"mbxj","explanation":"指东西多，眼睛都看不过来。","source":{"text":"从山阴道上行，山川自相映发，使人应接不暇。","book":"南朝宋·刘义庆《世说新语·言语》"},"example":{"text":"一切艺术的道理也是这样，单一必然导致枯燥。而丰富多采、～则是绝大多数人所欢迎的。","book":"秦牧《菊花与金鱼》"},"similar":["应接不暇"],"opposite":["目不忍睹"],"usage":"作谓语、定语、状语；用于“令人”后"},{"id":33127,"word":"目不暇给","pinyin":"mù bù xiá jǐ","abbr":"mbxj","explanation":"暇：空闲；给：供给。指东西多，眼睛都看不过来。","source":{"text":"从山阴道上行，山川自相映发，使人应接不暇。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"见其扬翚振彩，倏往倏来，～，固非一笼一羽之乐而已。","book":"清·郑燮《潍县署中与舍弟墨》"},"similar":["目不暇接"],"usage":"作谓语、定语、状语；用于“令人”后"},{"id":33128,"word":"目不知书","pinyin":"mù bù zhī shū","abbr":"mbzs","explanation":"指不会读书写文章。","source":{"text":"楷目不知书，手仅能执笔，其文罗衮作也。","book":"《旧唐书·哀帝纪》"},"example":{"text":"禄山～，虽有军功，岂即可升为宰相？此制若下，臣恐四夷将轻视朝廷呢。","book":"蔡东藩《唐史演义》第四十九回"},"similar":["目不识书"],"opposite":["满腹经纶"],"usage":"作谓语、定语；指人不识字"},{"id":33129,"word":"目不窥园","pinyin":"mù bù kuī yuán","abbr":"mbky","explanation":"形容专心致志，埋头苦读。","source":{"text":"少治《春秋》，孝景时为博士。下帏讲诵，弟子传以久次相授业，或莫见其面。盖三年不窥园，其精如此。","book":"《汉书·董仲书传》"},"example":{"text":"董江都～，隐居求志，天人三策，伟大光明。","book":"清·陶曾佑《中国文学之概况》"},"similar":["专心致志"],"opposite":["心猿意马"],"usage":"作谓语、定语、状语；指学习认真","story":["西汉时期，广汉学者董仲舒年少时读书非常刻苦，经常是夜以继日地读书，他的书房紧靠着姹紫嫣红的花园，他三年没有进过花园，甚至连一眼都没瞧过。后来他被征为博士，公开聚众讲学，弟子遍布四方"]},{"id":33130,"word":"目不给视","pinyin":"mù bù jǐ shì","abbr":"mbgs","explanation":"给：供给。眼睛来不及观赏。形容景物又美又多。","source":{"text":"沉沙栖陆，异域所至，殊形妙状，目不给视，无所不有。","book":"宋·周邦彦《汴都赋》"},"similar":["目不给赏","目不暇接"],"usage":"作谓语、定语；用于美景等"},{"id":33131,"word":"目不给赏","pinyin":"mù bù gěi shǎng","abbr":"mbgs","explanation":"眼睛来不及观赏。形容景物优美繁多。","source":{"text":"环左右前后而列者，争奇献怪，目不给赏。","book":"清·戴名士《雁荡记》"},"example":{"text":"洋洋洒洒，一气读去，几于千岩竞秀，万壑争流，～矣。","book":"清·爱新觉罗弘历《唐宋诗醇·游悟真寺诗》"},"similar":["目不给视"],"usage":"作谓语、定语；用于美景等"},{"id":33132,"word":"目不苟视","pinyin":"mù bù gǒu shì","abbr":"mbgs","explanation":"眼睛不随便乱看。形容为人正派。","source":{"text":"吾大人何如人哉？身长七尺，目不苟视。","book":"明·李贽《卓吾论略》"},"similar":["目不邪视","目不斜视"],"opposite":["左顾右盼"],"usage":"作谓语、状语；指为人正派"},{"id":33133,"word":"目不见睫","pinyin":"mù bù jiàn jié","abbr":"mbjj","explanation":"自己的眼睛看不到自己的睫毛。比喻没有自知之明。也比喻只见远处，不见近处。","source":{"text":"智如目也，能见百步之外而不能自见其睫。","book":"《韩非子·喻老》"},"example":{"text":"远求而近遗，如～。","book":"宋·王安石《再寄蔡天启》诗"},"similar":["目空一切"],"opposite":["谦虚谨慎"],"usage":"作谓语、宾语；指人无自知之明","story":["春秋时期，楚庄王想趁越国内乱出兵占领越国。杜子听说后去见楚庄王说：“人的智慧往往就同人的眼睛一样，能看见百步以外的东西，却看不见自己的睫毛。楚国曾被秦、晋国打败，国内又不安定，此时出兵攻打越国就像目不见睫一样。”"]},{"id":33134,"word":"目不识丁","pinyin":"mù bù shí dīng","abbr":"mbsd","explanation":"连最普通的“丁”字也不认识。形容一个字也不认得。","source":{"text":"今天下无事，汝辈挽得两石力弓，不如识一丁字。","book":"《旧唐书·张弘靖传》"},"example":{"text":"我试问如果你母亲要把你嫁给一个～的俗商，或者一个中年官僚，或者一个纨袴子弟，你难产也不反抗？","book":"巴金《家》二十五"},"similar":["胸无点墨","不识之无"],"opposite":["学富五车","满腹经纶"],"usage":"作谓语、定语；形容一个字也不认得","story":["唐朝幽州节度使张弘靖的部将韦雍和张宗厚经常在一起喝酒，那时天下太平，边关没有战事，这些将士没有事做。他们感慨：“如今天下太平，练武不如练文，你们能拉满两石的弓，还不如识一个字”。由于“个”与“丁”接近演变而成"]},{"id":33135,"word":"目不识书","pinyin":"mù bù shí shū","abbr":"mbss","explanation":"指读书很少或没读过书；不甚识字或不识字。","source":{"text":"李士宁者，蓬州人，自言学多诡数，善为巧发奇中，目不识书，而能口占作诗，颇有才思。","book":"宋·司马光《涑水记闻》卷十六"},"example":{"text":"伯之～，一切予夺，俱取决幕僚。","book":"蔡东藩《南北史演义》第四十回"},"similar":["目不知书"],"opposite":["学富五车"],"usage":"作谓语、定语；指人不识字"},{"id":33136,"word":"目不识字","pinyin":"mù bù shí zì","abbr":"mbsz","explanation":"指一个字也不认得。","source":{"text":"矧纳赀之例行，而目不识字者可为郡邑博士。","book":"清·顾炎武《与友人论门人书》"},"similar":["目不识丁"],"opposite":["满腹经纶"],"usage":"作谓语、定语；用于文盲"},{"id":33137,"word":"目不转睛","pinyin":"mù bù zhuǎn jīng","abbr":"mbzj","explanation":"眼珠子一动不动地盯着看。形容注意力集中。","source":{"text":"子义燃烛危坐通晓，目不转睛，膝不移处。","book":"晋·杨泉《物理论》"},"example":{"text":"老婆婆看着小官人，～，不觉两泪交流。","book":"明·冯梦龙《警世通言》卷十一"},"similar":["目不斜视","聚精会神","全神贯注"],"opposite":["左顾右盼"],"usage":"作状语；形容注意力集中"},{"id":33138,"word":"目不转视","pinyin":"mù bù zhuǎn shì","abbr":"mbzs","explanation":"眼珠一转不转。形容注意力集中，看得出神。","source":{"text":"某树下某石可置某所，目不转视，手不再指，若金在冶，不假斧凿。","book":"清·黄宗羲《张南垣传》"},"similar":["目不转睛"],"opposite":["左顾右盼"],"usage":"作状语；形容注意力集中"},{"id":33139,"word":"目不邪视","pinyin":"mù bù xié shì","abbr":"mbxs","explanation":"邪：通“斜”。眼睛不偷看旁边。比喻为人行止端方。也形容只朝一个方向看。","source":{"text":"古者圣王有胎教之法，怀子三月，出居别宫，目不邪视，耳不妄听，音声滋味，以礼节之。","book":"北齐·颜之推《颜氏家训·教子》"},"example":{"text":"妇人请竺同载。竺上车端坐，～。","book":"明·罗贯中《三国演义》第十一回"},"similar":["目不斜视","目不苟视"],"opposite":["左顾右盼"],"usage":"作谓语、状语；指为人正派"},{"id":33140,"word":"目中无人","pinyin":"mù zhōng wú rén","abbr":"mzwr","explanation":"眼里没有别人。形容骄傲自大，看不起人。","source":{"text":"赵奢子赵括，自少喜谈兵法，家传《六韬》、《三略》之书，一览而尽；尝与父奢论兵，指天画地，目中无人，虽奢亦不能难也。","book":"明·冯梦龙《东周列国志》第九十六回"},"example":{"text":"盖欲使执事知区区布衣亦有不可犯者，毋遂～而慨凌轹之也。","book":"清·归庄《再答汪苕文》"},"similar":["目空一切","狂妄自大"],"opposite":["谦虚敬慎"],"usage":"作谓语、定语；指人狂妄"},{"id":33141,"word":"目乱睛迷","pinyin":"mù luàn jīng mí","abbr":"mljm","explanation":"形容所见情景复杂纷繁或怪异多变，令人惊异。同“目乱精迷”。","source":{"text":"异端奇术，总萃其中。剥驴投井，植枣种瓜，须臾之间皆得食。士女观者，目乱精迷。","book":"北魏·杨衒之《洛阳伽蓝记·景乐寺》"},"similar":["目乱精迷"],"usage":"作谓语、定语；用于书面语"},{"id":33142,"word":"目乱精迷","pinyin":"mù luàn jīng mí","abbr":"mljm","explanation":"眼花缭乱，神情迷惑。形容所见情景复杂纷繁或怪异多变，令人惊异。","source":{"text":"北魏·杨衒之《洛阳伽蓝记·景乐寺》：“异端奇术，总萃其中。剥驴投井，植枣种瓜，须臾之间皆得食。士女观者，目乱精迷。”精，一本作“睛”。"},"similar":["目乱睛迷"],"usage":"作谓语、定语；指人对事物的看法"},{"id":33143,"word":"目交心通","pinyin":"mù jiāo xīn tōng","abbr":"mjxt","explanation":"以眼色传情，心中相互沟通。","source":{"text":"卜居西湖，邻邸有白衣少妇来寓，艳冶而慧，始见犹自匿，稍久，目交心通。","book":"宋·无名氏《鬼董》第二卷"},"similar":["心领神会"],"usage":"作谓语、定语；指彼此心意相通"},{"id":33144,"word":"目使颐令","pinyin":"mù shǐ yí lìng","abbr":"msyl","explanation":"用眼睛、用下巴指使人。形容自命尊贵，摆大架子。","source":{"text":"家畜声伎，目使颐令，自视王侯，人莫不恶之。","book":"《新唐书·王翰传》"},"example":{"text":"你不能～命令别人。"},"similar":["目指气使"],"usage":"作谓语、定语；形容自命尊贵"},{"id":33145,"word":"目光如炬","pinyin":"mù guāng rú jù","abbr":"mgrj","explanation":"目光发亮象火炬。形容愤怒地注视着。也形容见识远大。","source":{"text":"道济见收，愤怒气盛，目光如炬。","book":"《南史·檀道济传》"},"example":{"text":"中间坐着一位神道，面阔尺余，须髯满颊，～，肩臂启动，象个活的一般。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"similar":["目光炯炯"],"opposite":["黯然失色"],"usage":"作谓语、定语；指人的眼光","story":["南朝宋国大将檀道济智勇双全，曾跟随宋武帝刘裕北伐，屡立战功，北魏军队对他惧怕三分。宋文帝手下的近臣担心檀道济的权力太大，就谗言他谋反。檀道济在被捕时愤恨得目光如炬。魏军听说檀道济已死就加紧进攻，很快灭了宋国"]},{"id":33146,"word":"目光如电","pinyin":"mù guāng rú diàn","abbr":"mgrd","explanation":"目光：眼光。目光发亮像闪电。形容愤怒地注视着。也形容见识远大。","source":{"text":"焕子佩其一剑，过延平津，剑鸣飞入水。及入水中，但见双龙缠屈于潭下，目光如电，遂不敢前取矣。","book":"晋·王嘉《拾遗记·昆吾山》"},"example":{"text":"那女本家见了章秋谷丰裁凛凛，相貌堂堂，言语惊人，～，先就觉得有几分怕他。","book":"清·张春帆《九尾龟》第一百三十六回"}},{"id":33147,"word":"目光如豆","pinyin":"mù guāng rú dòu","abbr":"mgrd","explanation":"目光：眼光。眼光象豆子那样小。形容目光短浅，缺乏远见。","source":{"text":"世所推名流正人，深衷厚貌，修饰边幅，眼光如豆，宁足与论天下士哉。","book":"清·钱谦益《列朝诗集小传·丁集下·茅待诏元仪》"},"example":{"text":"不图彼国政府～，深忌中国之强，尤畏民党得志而碍其蚕食之谋。","book":"孙中山《行易知难》"},"similar":["目光短浅","鼠目寸光"],"opposite":["深谋远虑"],"usage":"作谓语、定语；指缺乏远见"},{"id":33148,"word":"目光如镜","pinyin":"mù guāng rú jìng","abbr":"mgrj","explanation":"眼光像镜子一般明亮。","source":{"text":"生日到，转精神。目光如镜步如云。年年长侍华堂宴，子子孙孙孙又孙。","book":"宋·邹应龙《鹧鸪天》"},"similar":["目光锐利"],"usage":"作谓语、定语；指人的眼神"},{"id":33149,"word":"目光如鼠","pinyin":"mù guāng rú shǔ","abbr":"mgrs","explanation":"鼠目寸光，形容目光短浅或行为不正。","source":{"text":"虽然他的目光如鼠，各处乱翻，我有时也有些觉得讨厌。","book":"鲁迅《两地书·致许广平112》"},"example":{"text":"谁愿意做～的人，只是嗅着鼻子前面的一点油香！","book":"袁鹰《篝火之歌·彩色的幻想》"},"similar":["鼠目寸光"],"opposite":["高瞻远瞩"],"usage":"作谓语、定语；指缺乏远见"},{"id":33150,"word":"目光炯炯","pinyin":"mù guāng jiǒng jiǒng","abbr":"mgjj","explanation":"炯炯：明亮的样子。两眼明亮有神。","source":{"text":"目光炯炯射牛车，何至随人作浪愁。身处江湖如富贵，心亲鱼鸟等朋俦。","book":"晋·潘岳《寡妇赋》：“目炯炯而不寝。”宋·陆游《醉题》诗"},"example":{"text":"先达葛苍公讳麟，号瞿庵，性敏多才，状奇伟，～有英气，胆力过人。","book":"清·叶廷琯《鸥陂渔话·葛苍公传》"},"similar":["目光如炬","炯炯有神"],"opposite":["黯然失色"],"usage":"作谓语、定语、补语；指人的眼光"},{"id":33151,"word":"目光短浅","pinyin":"mù guāng duǎn qiǎn","abbr":"mgdq","explanation":"缺乏远见卓识的、只顾眼前利益的性质或状态。","source":{"text":"‘不是这个意思，我确实是想象力有限。’我解释说，‘可能因为我太唯物了所以目光短浅。’","book":"王朔《痴人》"},"example":{"text":"他是一个～的人。"},"similar":["鼠目寸光"],"opposite":["深谋远虑"],"usage":"作谓语、定语；指人缺乏远见"},{"id":33152,"word":"目光远大","pinyin":"mù guāng yuǎn dà","abbr":"mgyd","explanation":"指一个人的见解及处世观高远而伟大。","example":{"text":"他是一个～的人。"},"opposite":["目光短浅"],"usage":"作谓语、定语；指人的世界观等"},{"id":33153,"word":"目兔顾犬","pinyin":"mù tù gù quǎn","abbr":"mtgq","explanation":"看见兔子而呼猎犬。比喻及时补救。","source":{"text":"见兔而顾犬，未为晚也。","book":"语出《战国策·楚策四》"}},{"id":33154,"word":"目击耳闻","pinyin":"mù jī ěr wén","abbr":"mjew","explanation":"亲眼看到，亲耳听到。","source":{"text":"口说不如身逢，耳闻不如目睹。","book":"《资治通鉴·唐纪睿宗景云二年》"},"example":{"text":"我又愿意知道一点十七年前的三月二十九日的情形，但一时找不到～的耆老。","book":"鲁迅《而已集·黄花节的杂感》"},"similar":["目见耳闻","耳闻目睹"],"opposite":["道听途说"],"usage":"作定语；指亲自见闻"},{"id":33155,"word":"目击道存","pinyin":"mù jī dào cún","abbr":"mjdc","explanation":"眼睛一看便知道“道”存在着。后指声气相求，志同道合。","source":{"text":"仲尼曰：‘若夫人者，目击而道存矣，亦不可以容声矣。’","book":"《庄子·田子方》"},"example":{"text":"与天下公共，必有～者矣。","book":"元·一虚叟《题四子赞》"},"usage":"作谓语、定语；用于书面语"},{"id":33156,"word":"目别汇分","pinyin":"mù bié huì fēn","abbr":"mbhf","explanation":"指分门别类。","source":{"text":"习五经约知其说，尤深于《易》，旁通诸家言，目别汇分，咸得其统绪。","book":"明·宋濂《丽水黄府君墓铭》"},"similar":["分门别类"],"usage":"作谓语；指分门别类"},{"id":33157,"word":"目动言肆","pinyin":"mù dòng yán sì","abbr":"mdys","explanation":"指神色不安，语调失常。","source":{"text":"使者目动而言肆，懼我也，将遁矣。","book":"《左传·文公十二年》"},"example":{"text":"尽忠～，满口糊涂，承晖自知不妙，即辞家庙作遗表，抗论穆延尽忠及左副元帅高琪罪状。","book":"蔡东藩《元史演义》第十二回"},"usage":"作谓语、定语；用于人的神态等"},{"id":33158,"word":"目可瞻马","pinyin":"mù kě zhān mǎ","abbr":"mkzm","explanation":"眼睛只能看到远处的马。比喻见大不见小。","source":{"text":"且徐偃王之状，目可瞻马；仲尼之状，面如蒙倛。","book":"《荀子·非相》"}},{"id":33159,"word":"目呆口咂","pinyin":"mù dāi kǒu zā","abbr":"mdkz","explanation":"咂：用舌抵齿发声。目光发呆，口中发出啧啧之声。形容惊呆的样子。","source":{"text":"寨中这些兵卒，多是强盗出身，何曾看见如此礼物，见了个个目呆口咂。","book":"清·褚人获《隋唐演义》第五十二回"},"similar":["目瞪口哆","目瞪口呆"],"usage":"作谓语、定语、状语；用于吃惊时"},{"id":33160,"word":"目大不睹","pinyin":"mù dà bù dǔ","abbr":"mdbd","explanation":"眼睛虽大，但看不见东西。比喻徒具形式而没有作用。","source":{"text":"此何鸟哉？翼殷不逝，目大不睹，蹇裳躩步，执弹而留之。","book":"《庄子·山木》"},"similar":["有眼无珠"],"usage":"作谓语、定语；用于骂人等"},{"id":33161,"word":"目如悬珠","pinyin":"mù rú xuán zhū","abbr":"mrxz","explanation":"眼睛像一对悬挂着的珠子。形容眼睛明亮，有光彩。","source":{"text":"臣朔年二十二，长九尺三寸，目若悬珠，齿若编贝。","book":"《汉书·东方朔传》"}},{"id":33162,"word":"目定口呆","pinyin":"mù dìng kǒu dāi","abbr":"mdkd","explanation":"睁大眼睛直盯着不动，张着嘴说不出话。形容因吃惊或害怕而发楞的样子。","source":{"text":"惊得王小二目定口呆，眼巴巴看他把三十枝毛竹拖去了。","book":"《说唐》第二一回"},"example":{"text":"那伙计听说，抬头一看，只见不是同仁堂了，不禁气得～。","book":"清·吴研人《二十年目睹之怪现状》第二十九回"},"similar":["目瞪口结","目瞪口呆","目睁口呆"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33163,"word":"目往神受","pinyin":"mù wǎng shén shòu","abbr":"mwss","explanation":"往：过；受：感受。看一眼便心领神会。形容人机智灵敏。","source":{"text":"意会心谋，目往神受，乐在声色犬马上。","book":"清《济南府志·列女传·李清照》"}},{"id":33164,"word":"目怔口呆","pinyin":"mù zhēng kǒu dāi","abbr":"mzkd","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"当下那霹雳似的一声，真把所有在场的贵客都吓得目怔口呆。","book":"茅盾《惊蛰》"},"similar":["目瞪口结","目瞪口呆","目睁口呆"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33165,"word":"目想心存","pinyin":"mù xiǎng xīn cún","abbr":"mxxc","explanation":"凝思想象。多指追忆故人或往事。","source":{"text":"窃冥兮潜翳，心存兮目想。","book":"晋·陆机《赠弟士龙诗十首》其十：“企佇朔路，言送尔归。心存言宴，目想容晖。”晋·潘岳《寡妇赋》"},"example":{"text":"～妙尤极，研巧核能状不得。","book":"唐·徐光溥《题黄居寀秋山图》"}},{"id":33166,"word":"目成心授","pinyin":"mù chéng xīn shòu","abbr":"mcxs","explanation":"目成：用眼光传情达意。指男女相爱，目光传情，两心相许。","source":{"text":"有个人人，袅娜灵和柳。君知否，目成心授，何日同携手。","book":"宋·王之道《点绛唇·和张文伯》"}},{"id":33167,"word":"目成心许","pinyin":"mù chéng xīn xǔ","abbr":"mcxx","explanation":"目成：用眼光传情达意。指男女相爱，目光传情，两心相许。","source":{"text":"掌上香罗六寸弓，雍容胡旋一盘中，目成心许两匆匆。","book":"宋·贺铸《换追风》词"},"example":{"text":"罗敷知他有夫，不着紧～，虽多梦见，此生应见稀。","book":"明·梅鼎祚《玉合记·缘合》"},"similar":["目窕心与"],"usage":"作谓语；用于男女之间"},{"id":33168,"word":"目成眉语","pinyin":"mù chéng méi yǔ","abbr":"mcmy","explanation":"目成：用眼光传情达意。指男女相爱，目光传情，两心相许。","source":{"text":"一样骊山怀古。古今朝暮云雨。六郎夫妇三生梦，肠断目成眉语。","book":"元·李治《摸鱼儿》词"},"example":{"text":"有时云生不在栈中，姨太太见了秋谷也并不回避，彼此～，差不多要学那红拂私奔。","book":"清·张春帆《九尾龟》第十八回"}},{"id":33169,"word":"目所履历","pinyin":"mù suǒ lǚ lì","abbr":"msll","explanation":"履历：经历。眼睛所看到的。","source":{"text":"目所履历，未尝有也。","book":"北魏·郦道元《水经注·江水》"}},{"id":33170,"word":"目所未睹","pinyin":"mù suǒ wèi dǔ","abbr":"mswd","explanation":"睹：看。从来没有看见过。","source":{"text":"小童入报有女子往来室中，妻遽出视之，韶颜丽态，目所未睹。","book":"唐·白行简《李娃传》：“与之拜毕，叙寒燠，触类妍媚，目所未睹。”宋·洪迈《夷坚乙志·杨戬二怪》"},"example":{"text":"幽王抬头观看，姿容态度，～，流盼之际，光艳照人。","book":"明·冯梦龙《东周列国志》第二回"},"similar":["见所未见"],"usage":"作谓语、定语；用于新奇的事物"},{"id":33171,"word":"目披手抄","pinyin":"mù pī shǒu chāo","abbr":"mpsc","explanation":"边看书边抄录。形容勤奋攻读。","source":{"text":"终日明窗净几，目披手抄，诚心好之，遂忘其劳。","book":"宋·胡仔《苕溪渔隐丛话后集序》"},"usage":"作谓语、定语；用于读书"},{"id":33172,"word":"目指气使","pinyin":"mù zhǐ qì shǐ","abbr":"mzqs","explanation":"目指：动一下眼睛来指物；气使：用嘘气声支使人。用眼神和气色指使人。形容骄横傲慢的样子。","source":{"text":"今王将东面目指气使以求臣，则厮役之材至矣；南面听朝不失揖让之礼以求臣，则人臣之材至矣。","book":"西汉·刘向《说苑·君道》"},"example":{"text":"行虽犬彘，家富势足，～，是为贤耳。","book":"东汉·班固《汉书·贡禹传》"},"similar":["目指颐令"],"usage":"作谓语；指态度傲慢"},{"id":33173,"word":"目挑心与","pinyin":"mù tiǎo xīn yǔ","abbr":"mtxy","explanation":"用眼神挑逗，内心相许。","source":{"text":"使先施、征舒、阳文、段干、吴娃、闾娵、傅予之徒，杂裾垂鬋，目窕心与。","book":"汉·枚乘《七发》"}},{"id":33174,"word":"目挑心悦","pinyin":"mù tiāo xīn yuè","abbr":"mtxy","explanation":"指眉眼传情，两心相悦。","source":{"text":"说甚么目挑心悦；便教他毛嫱、西子，总非同列。","book":"明·汪道昆《高唐梦》"},"usage":"作谓语、定语；用于情人等"},{"id":33175,"word":"目挑心招","pinyin":"mù tiǎo xīn zhāo","abbr":"mtxz","explanation":"挑：挑逗；招：指勾引。眉目传情，心神招引。","source":{"text":"今夫赵女郑姬，设形容，揳鸣琴，揄长袂，蹑利屐，目挑心招，出不远千里，不择老少者，奔富厚也。","book":"《史记·货殖列传》"},"example":{"text":"～，捭阖以为术焉，则可以钳塞天下之游士。","book":"清·龚自珍《京师乐籍说》"},"usage":"作谓语、定语；形容女子诱惑人的情态"},{"id":33176,"word":"目挑眉语","pinyin":"mù tiāo méi yǔ","abbr":"mtmy","explanation":"以眉目挑逗传情。","source":{"text":"彼此目挑眉语，心许已久，苦不得间。","book":"清·王韬《淞滨琐话·魏月波》"},"example":{"text":"清秋见燕西如此，脸色也就动了一动。偏是乌二小姐对这事是留了心的，见他二人目～，越发奇怪。","book":"张恨水《金粉世家》第十九回"},"similar":["眉目传情"],"usage":"作谓语、宾语；用于情人间"},{"id":33177,"word":"目擩耳染","pinyin":"mù rù ěr rǎn","abbr":"mrer","explanation":"擩：通“濡”，沾染。因耳目经常接触而受到感染，影响。亦作“耳濡目染”、“耳染目濡”、“目染耳濡”、“目濡耳染”。","source":{"text":"目擩耳染，不学以能。","book":"唐·韩愈《清河郡公房公墓碣铭》"},"similar":["目染耳擩","耳濡目染"],"usage":"作定语、宾语；指不知不觉地受到影响"},{"id":33178,"word":"目攋耳染","pinyin":"mù rù ěr rǎn","abbr":"mrer","explanation":"?焙通濡”，沾染。因耳目经常接触而受到感染，影响。亦作耳濡目染”、耳染目濡”、目染耳濡”、目濡耳染”。"},{"id":33179,"word":"目断飞鸿","pinyin":"mù duàn fēi hóng","abbr":"mdfh","explanation":"断：断绝；鸿：鸿雁。目送大雁飞去，直到看不见。形容离别的悲凄之情。","source":{"text":"此情未语泪先溶，自今别去，目断飞鸿。","book":"明·无名氏《鸣凤记·邹慰夏孤》"},"example":{"text":"他～，不忍离开码头。"},"usage":"作谓语；用于送行离别等"},{"id":33180,"word":"目断魂消","pinyin":"mù duàn hún xiāo","abbr":"mdhx","explanation":"因望不到而内心伤悲。形容离别的悲伤愁苦。","source":{"text":"只今别去，山长水遥，意匆匆远离膝下，目断魂消。","book":"明·无名氏《精忠记·辞母》"},"similar":["目断魂销"],"usage":"作谓语、定语；用于书面语"},{"id":33181,"word":"目断魂销","pinyin":"mù duàn hún xiāo","abbr":"mdhx","explanation":"目断：竭尽目力所见。指竭尽目力而看望不到，因而内心悲痛。多形容因离别而伤心之极。","source":{"text":"臣自离京国，目断魂销，每至五更朝谒之时，臣实制泪不得。","book":"唐·元稹《同州刺史谢上表》"},"example":{"text":"归雁下平桥，～。夕阳无限江皋，杨柳杏花相对晚，各自无聊。","book":"宋·陈亮《浪淘沙》词"},"similar":["目断魂消"],"usage":"作谓语、定语；用于书面语"},{"id":33182,"word":"目断鳞鸿","pinyin":"mù duàn lín hóng","abbr":"mdlh","explanation":"鳞鸿：鱼和雁，比喻书信。形容望眼欲穿，盼望书信到来。","source":{"text":"妆台目断鳞鸿信，山隐隐水粼粼，方知人远天涯近。","book":"元·无名氏《南吕·骂玉郎过感皇恩采茶歌》"},"example":{"text":"小姐，看你背里沉吟，想是心中明白，何不口传信息，免他目～。","book":"明·张景《飞丸记·誓盟牛女》"},"usage":"作谓语、定语；用于书面语"},{"id":33183,"word":"目无三尺","pinyin":"mù wú sān chǐ","abbr":"mwsc","explanation":"不把法制放在眼里。形容违法乱纪，胡作非为。三尺，指法律。古代把法律写在三尺长的竹简上，故称。古代把法律写在三尺长的竹简上，故称。","source":{"text":"光天化日之下，岂容奸孽余党，胆大泼天，目无三尺。","book":"清·王士祯《居易录续谈》"},"similar":["目无王法"],"opposite":["遵纪守法"],"usage":"作谓语、定语；指无法无天"},{"id":33184,"word":"目无下尘","pinyin":"mù wú xià chén","abbr":"mwxc","explanation":"下尘：佛家语，凡尘，尘世，比喻地位低下者。眼睛不往下看。形容态度傲慢，看不起地位低的人。","source":{"text":"那宝钗却又行为豁达，随分从时，不比黛玉孤高自许，目无下尘，故深得下人之心。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"一帆风顺不晓得收敛，忘了日月盈亏这个大道理，在皇上跟前卖弄学问，脾视同僚～，垮台只是早晚的事。","book":"二月河《乾隆皇帝》八"},"usage":"作谓语、定语；指人眼光向上"},{"id":33185,"word":"目无余子","pinyin":"mù wú yú zǐ","abbr":"mwyz","explanation":"余子：其他的人。眼里没有旁人。形容自高自大，目中无人。","source":{"text":"唯善鲁国孔融及弘农杨修。常称曰：‘大儿孔文举，小儿杨德祖。余子碌碌，莫足数也。’","book":"《后汉书·祢衡传》"},"example":{"text":"听他口气，已是～。","book":"蔡东藩、许廑父《民国通俗演义》第八回"},"similar":["目中无人","自高自大"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指人自高自大"},{"id":33186,"word":"目无全牛","pinyin":"mù wú quán niú","abbr":"mwqn","explanation":"全牛：整个一头牛。眼中没有完整的牛，只有牛的筋骨结构。比喻技术熟练到了得心应手的境地。","source":{"text":"始臣之解牛之时，所见无非牛者；三年之后，未尝见全牛也。","book":"《庄子·养生说》"},"example":{"text":"操利柄而～，执其吭如刍豢悦口。","book":"唐·杨承和《梁守谦功德铭》"},"similar":["游刃有余"],"usage":"作谓语、定语；指人的技艺","story":["战国时期道家代表庄周讲一个故事：有个厨师替梁惠王宰牛，他的宰牛技术十分娴熟，刀子在牛骨缝里灵活地移动，没有一点障碍，而且很有节奏。梁惠王看呆了，一个劲夸他技术高超。厨师说他解牛已经19年了，对牛的结构完全了解"]},{"id":33187,"word":"目无尊长","pinyin":"mù wú zūn zhǎng","abbr":"mwzz","explanation":"不把尊长放在眼里。形容狂妄无礼。","source":{"text":"她不满意觉慧的目无尊长的态度，更不满意觉民的反抗家长、实行逃婚的手段。","book":"巴金《家》"},"example":{"text":"～的行为应该批评。"},"similar":["没大没小"],"opposite":["尊老爱幼"],"usage":"作谓语、定语；指人无礼"},{"id":33188,"word":"目无法纪","pinyin":"mù wú fǎ jì","abbr":"mwfj","explanation":"不把国家法律放在眼里。形容胡作非为，无法无天。","source":{"text":"今天要检查日货，明天又捉商人游街，简直目无法纪。","book":"巴金《家》"},"example":{"text":"～的人应该受到法律的制裁。"},"similar":["目无王法","无法无天"],"opposite":["遵纪守法"],"usage":"作谓语、定语；指无法无天"},{"id":33189,"word":"目无流视","pinyin":"mù wú liú shì","abbr":"mwls","explanation":"眼睛不往四处看。形容人品行端正。","source":{"text":"正春风度峻整，终日无狎语，倦不倾倚，署不裸裎，目无流视，见者肃然。","book":"《明史·翁正春传》"}},{"id":33190,"word":"目无王法","pinyin":"mù wú wáng fǎ","abbr":"mwwf","explanation":"不把国家的法律放在眼里。指人不受约束地胡作非为。","source":{"text":"关系朝廷体统，他如何敢拿了去，要起赎身的价银来，目无王法已极。","book":"清·吴敬梓《儒林外史》第43回"},"example":{"text":"这样做简直是～了。"},"similar":["无法无天"],"opposite":["遵纪守法"],"usage":"作谓语、定语；指无法无天"},{"id":33191,"word":"目无组织","pinyin":"mù wú zǔ zhī","abbr":"mwzz","explanation":"不顾组织纪律的规定。","example":{"text":"他～，是个彻底的自由主义。"},"usage":"作谓语、定语；指人没有王法"},{"id":33192,"word":"目染耳濡","pinyin":"mù rǎn ěr rǔ","abbr":"mrer","explanation":"染：沾染；濡：沾湿。眼睛经常看到，耳朵经常听到，不知不觉地受到影响。","source":{"text":"目濡耳染，不学以能。","book":"唐·韩愈《清河郡公房公墓碣铭》"},"example":{"text":"伏原皇太后崇俭黜奢，时以民生为念，俾皇上知稼穑之艰难，～，圣功自懋。","book":"《清史稿·廖寿恒传》"},"similar":["目擩耳染","耳濡目染"],"usage":"作定语、宾语；指不知不觉地受到影响"},{"id":33193,"word":"目治手营","pinyin":"mù zhì shǒu yíng","abbr":"mzsy","explanation":"亲眼观察，亲手试验。","source":{"text":"先后间出，目治手营，穷探审论，知有生之物，始于同，终于异。","book":"严复《天演论·导言》"},"usage":"作谓语、定语；指亲为"},{"id":33194,"word":"目注心凝","pinyin":"mù zhù xīn níng","abbr":"mzxn","explanation":"犹言全神贯注。形容注意力高度集中。","source":{"text":"阳目注心凝，对烛自鼓；久之，顿得妙悟，不觉起舞。","book":"清·蒲松龄《聊斋志异·粉蝶》"},"similar":["目注心营"],"usage":"作谓语、定语；指思想集中"},{"id":33195,"word":"目注心营","pinyin":"mù zhù xīn yíng","abbr":"mzxy","explanation":"指竭尽心力以赴。","source":{"text":"凡其自毁齿至于白首，终其百年之身，所目注心营，劳苦险难，几死而后得之者，其间大事，不过与禽兽争饮食，与禽兽争居处而已。","book":"严复《国闻报馆附印说部缘起》"},"example":{"text":"及时代之精神，日夜埋头故纸堆中，所～者，不越帝王、权贵、鬼怪、神仙与夫个人之穷通利达。","book":"陈独秀《文学革命论》"},"similar":["目注心凝"],"usage":"作谓语、定语；指思想集中"},{"id":33196,"word":"目濡耳染","pinyin":"mù rǔ ěr rǎn","abbr":"mrer","explanation":"濡：沾湿；染：沾染。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"目濡耳染，不学以能。","book":"唐·韩愈《清河郡公房公墓碣铭》"}},{"id":33197,"word":"目牛无全","pinyin":"mù niú wú quán","abbr":"mnwq","explanation":"比喻技艺纯熟或谋划高明。","source":{"text":"始臣之解牛之时，所见无非牛者；三年之后，未尝见全牛也。","book":"《庄子·养生主》"},"example":{"text":"害马已去，世事都捐；投刃皆虚，～。","book":"晋·孙绰《游天台山赋》"},"similar":["目无全牛","游刃有余"],"usage":"作谓语、定语；用于比喻句","story":["战国时期，道家代表庄周讲一个故事：有个厨师替梁惠王宰牛，他的宰牛技术十分娴熟，刀子在牛骨缝里灵活地移动，没有一点障碍，而且很有节奏。梁惠王看呆了，一个劲夸他技术高超。厨师说他解牛已经19年，宰牛时已经看不到一头全牛了"]},{"id":33198,"word":"目牛游刃","pinyin":"mù niú yóu rèn","abbr":"mnyr","explanation":"游刃：游刃有余。指技艺精熟，行事胜任轻松。","source":{"text":"诸公清才绮靡，皆是目牛游刃。","book":"唐·王洙《东阳夜怪录》"},"similar":["目牛无全","游刃有余"],"usage":"作宾语、定语；用于比喻句"},{"id":33199,"word":"目目相觑","pinyin":"mù mù xiāng qù","abbr":"mmxq","explanation":"形容人们因惊惧或无可奈何而互相望着，都不说话。同“面面相觑”。","source":{"text":"我恰才见阿妈和四个叔叔都目目相觑，其中必然暗昧。","book":"元·关汉卿《五侯宴》第四折"},"similar":["面面相觑"],"usage":"作谓语、定语、状语；形容惊慌的表情"},{"id":33200,"word":"目盼心思","pinyin":"mù pàn xīn sī","abbr":"mpxs","explanation":"双眼盼望，内心思念。形容企盼想念之切。","source":{"text":"你那时好风光，目盼心思，时刻何曾放。","book":"明·胡文焕《群音类选·余庆记·深闺幽思》"},"usage":"作谓语、定语；指十分思念"},{"id":33201,"word":"目眐心骇","pinyin":"mù zhēng xīn hài","abbr":"mzxh","explanation":"因惊恐而楞住的样子。","source":{"text":"六人从容就戮，不多时将六人尽数斩了，刽子手将血淋淋六个头颅献上，看的人都目眐心骇。","book":"清·藤谷古香《轰天雷》第八回"},"similar":["目瞪心骇"],"opposite":["从容不迫"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":33202,"word":"目眢心忳","pinyin":"mù yuān xīn wǎng","abbr":"myxt","explanation":"犹言泪竭神伤。形容悲痛之甚。","source":{"text":"四瀛茫茫，日月何遒，目眢心忳，已矣谁俦。","book":"清·恽敬《祭张皋文文》"},"usage":"作谓语、定语；指人很悲伤"},{"id":33203,"word":"目眦尽裂","pinyin":"mù zì jìn liè","abbr":"mzjl","explanation":"目眦：眼眶。眼眶都瞪裂了。形容愤怒到了极点。","source":{"text":"哙遂入，披帷西向立，瞋目视项王，头发上指，目眦尽裂。","book":"《史记·项羽本纪》"},"example":{"text":"老张怒气填胸，把胃的容量扩大，越吃越勇，直到“～”，“怒发冲冠”！","book":"老舍《老张的哲学》十六"}},{"id":33204,"word":"目眩头昏","pinyin":"mù xuàn tóu hūn","abbr":"mxth","explanation":"犹头昏眼花。眼睛发花，头脑昏晕。","source":{"text":"这种的枪花，不但是外国人所无，就是中国的宝贝武人耍出来之后，还要弄得外国记者目眩头昏，眼花缭乱。","book":"林语堂《机器与精神》"},"similar":["目眩头晕","头昏眼花"],"usage":"作谓语、定语、状语；指人不清醒"},{"id":33205,"word":"目眩头晕","pinyin":"mù xuàn tóu yūn","abbr":"mxty","explanation":"眼睛发花，头脑昏晕。同“目眩头昏”。","source":{"text":"仿佛石坡和楼阁，都会一下子冲倒似的，令人有些目眩头晕。","book":"艾芜《都江堰的神话故事》"},"example":{"text":"由于这是比转磨还更叫人～的，不多工夫狐狸就倒在地上了。","book":"冯雪峰《雪峰寓言·狐狸和猴子们的铜铃》"},"similar":["目眩头昏"],"usage":"作谓语、定语、状语；指人不清醒"},{"id":33206,"word":"目眩心花","pinyin":"mù xuàn xīn huā","abbr":"mxxh","explanation":"眩：眼花；花：模糊不清。眼花缭乱，心神迷乱。","source":{"text":"任道元抬头起来看见，惊得目眩心花，魂不附体。","book":"明·凌濛初《初刻拍案惊奇》第17卷"},"similar":["目眩神摇"],"usage":"作定语、状语；指人的心神"},{"id":33207,"word":"目眩神夺","pinyin":"mù xuàn shén duó","abbr":"mxsd","explanation":"眼花缭乱，心神摇荡。多形容所见情景令人惊异。","source":{"text":"今来宝刹，得睹人间未见之珍，令人目眩神摇，不知身在何世。","book":"明·徐渭《英烈传》第四十回"},"example":{"text":"见车幔洞开，内坐二八女郎，红妆艳丽，尤生平所未睹。～，瞻恋弗舍。","book":"清·蒲松龄《聊斋志异·瞳人语》"},"similar":["目眩神摇","目眩神迷","目眩魂摇"],"usage":"作谓语、定语；用于人或事物等"},{"id":33208,"word":"目眩神摇","pinyin":"mù xuàn shé yáo","abbr":"mxsy","explanation":"眼花缭乱，心神摇荡。多形容所见情景令人惊异。","source":{"text":"今来宝刹，得睹人间未见之珍，令人目眩神摇，不知身在何世。","book":"明·徐渭《英烈传》第四十回"},"example":{"text":"背后三四个妇女嘻嘻笑笑跟着，两边看的人～，不敢仰视。","book":"清·吴敬梓《儒林外史》第三十三回"},"similar":["目眩神夺","目眩神迷","目眩魂摇"],"usage":"作谓语、定语；用于人或事物等"},{"id":33209,"word":"目眩神迷","pinyin":"mù xuàn shén mí","abbr":"mxsm","explanation":"眼花缭乱，心神摇荡。多形容所见情景令人惊异。","source":{"text":"今来宝刹，得睹人间未见之珍，令人目眩神摇，不知身在何世。","book":"明·徐渭《英烈传》第四十回"},"example":{"text":"场上陈列着有锦绣的，我金银的，五光十色，～，顿时吓得出神。","book":"清·曾朴《孽海花》第十回"},"similar":["目眩神摇","目眩神夺","目眩魂摇"],"usage":"作谓语、定语；用于人或事物等"},{"id":33210,"word":"目眩魂摇","pinyin":"mù xuàn hún yáo","abbr":"mxhy","explanation":"眩：眼花；摇：摆动。眼花缭乱，心神不定。形容看到某种景象令人吃惊的样子。","source":{"text":"顾盼之间，目眩魂摇。","book":"明·顾大典《青衫记·郊游访兴》"},"similar":["目眩神夺","目眩神迷","目眩神摇"],"usage":"作谓语、定语；用于人或事物等"},{"id":33211,"word":"目睁口呆","pinyin":"mù zhēng kǒu dāi","abbr":"mzkd","explanation":"惊惧得睁大双眼说不出话来。形容因吃惊或受气而发楞。","source":{"text":"四方混杀，人人束手，个个归心。定安国舅气的目睁口呆，罔知所措。与众等侍郎束手被擒。","book":"明·施耐庵《水浒传》第八十五回"},"example":{"text":"众人看了，惊得～，伸了舌头，收不进来。","book":"《初刻拍案惊奇》卷一"},"similar":["目定口呆","目瞪口呆"],"opposite":["镇定自若"],"usage":"作谓语、状语；指吃惊"},{"id":33212,"word":"目睫之论","pinyin":"mù jié zhī lùn","abbr":"mjzl","explanation":"比喻肤浅的见解。","source":{"text":"雄作《太玄》以拟《周易》，或者比之吴楚僭王，顾非伪乎，此目睫之论也。","book":"汉·扬雄《法言·太玄经》"},"example":{"text":"学者于涑水、新安奉为丹书，独反唇于于河汾之元经，则～也。","book":"清·钱谦益《汲古阁毛氏新刻十七史序》"},"usage":"作宾语；用于自谦等"},{"id":33213,"word":"目睹耳闻","pinyin":"mù dǔ ěr wén","abbr":"mdew","explanation":"睹：看见；闻：听见。亲耳听到，亲眼看见。","source":{"text":"口说不如身逢，耳闻不如目睹。","book":"《资治通鉴·唐纪睿宗景云二年》"},"example":{"text":"仆遭遇明时，寓游京国，～，殆非一日，不得不为集录。","book":"宋·耐得翁《都城纪胜》序"},"similar":["耳闻目睹"],"opposite":["道听途说"],"usage":"作谓语、定语、宾语；用于亲眼所见"},{"id":33214,"word":"目瞠口哆","pinyin":"mù chēng kǒu duō","abbr":"mckd","explanation":"哆：张口的样子。瞪大眼睛，张开嘴巴。形容因惊吓或害怕而发愣。","source":{"text":"亟回韩店，径趍卧室内，翻揭席存，无所见而出，面色如墨，目瞠口哆，不复能言。","book":"宋·洪迈《夷坚丁志·荆山客邸》"}},{"id":33215,"word":"目瞪口僵","pinyin":"mù dèng kǒu jiāng","abbr":"mdkj","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"我那忠厚老实的娘……一听了媒人的这一番说话，目瞪口僵，立刻就滚下了几颗眼泪来。","book":"郁达夫《迟桂花》"},"similar":["目瞪口结","目瞪口呆","目定口呆"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33216,"word":"目瞪口呆","pinyin":"mù dèng kǒu dāi","abbr":"mdkd","explanation":"目瞪：睁大眼睛直视；口呆：嘴里说不出话来。形容因吃惊或害怕而发愣的样子。","source":{"text":"吓得项王目瞪口呆，动弹不得。","book":"元·无名氏《赚蒯通》第一折"},"example":{"text":"殷、雷二将见众官激变，不复朝仪，吓得～，不知所出。","book":"明·许仲琳《封神演义》第九回"},"similar":["瞠目结舌","目瞪口哆"],"opposite":["从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态","story":["西汉初年，韩信被封为齐王，丞相萧何担心韩信兵权太大，就找樊哙共商计策。樊哙自鸣得意，连夸自己是如何斗败项羽，吓得他目瞪口呆，从而保住主公。面对这淮阴一饿夫且手无缚鸡之力的韩信，只须叫一两个人就可以把他一刀两断"]},{"id":33217,"word":"目瞪口哆","pinyin":"mù dèng kǒu duō","abbr":"mdkd","explanation":"瞪：眼睛发愣；哆：张口的样子。瞪着眼睛说不出话来。形容吃惊的样子。","source":{"text":"翻揭席荐，无所见而出，面色如墨，目瞪口哆，不能复言。","book":"宋·洪迈《夷坚丁志·荆山客邸》"},"similar":["目瞪口呆"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33218,"word":"目瞪口噤","pinyin":"mù dèng kǒu jìn","abbr":"mdkj","explanation":"目瞪：睁大眼睛直视；口噤：嘴里说不出话来。形容因吃惊或害怕而发愣的样子。","source":{"text":"其夕，夏侯生惝恍不寐，若为阴物所中。其仆来告，枚走视之，则目瞪口噤，不能言矣。","book":"唐·皇甫枚《三水小牍·夏侯桢》"}},{"id":33219,"word":"目瞪口张","pinyin":"mù dèng kǒu zhāng","abbr":"mdkz","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"江泰登时甩开手，曾文彩目瞪口张地望着他。","book":"曹禺《北京人》第一幕"},"similar":["目瞪口结","目瞪口呆","目定口呆"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33220,"word":"目瞪口歪","pinyin":"mù dèng kǒu wāi","abbr":"mdkw","explanation":"形容气极时的神情。","source":{"text":"贾政此时气得目瞪口歪，一面送那官员，一面回头命宝玉：‘不许动！回头有话问你！’","book":"清·曹雪芹《红楼梦》第33回"},"similar":["目瞪口呆"],"usage":"作状语；指十分气愤"},{"id":33221,"word":"目瞪口结","pinyin":"mù dèng kǒu jié","abbr":"mdkj","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"当他们要我在那张表上填写着我的职业和来杭的目的时，我真是目瞪口结的呆住了。","book":"王以仁《流浪》"},"similar":["目瞪口张","目瞪口呆","目定口呆"],"opposite":["镇定自若","从容不迫"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33222,"word":"目瞪心骇","pinyin":"mù dèng xīn hài","abbr":"mdxh","explanation":"因惊恐而楞住的样子。同“目眐心骇”。","source":{"text":"当时土木工匠们弄得目瞪心骇，不知所为，都停着工看。","book":"《轰天雷》第十回"},"similar":["目眐心骇"],"usage":"作谓语、定语、状语；用于惊恐时"},{"id":33223,"word":"目瞪神呆","pinyin":"mù dèng shén dāi","abbr":"mdsd","explanation":"瞪：眼睛发愣。眼睛发愣，神情呆滞。形容吃惊的样子。","source":{"text":"登时惊得目瞪神呆，惟恐他们盘问，就要出丑。","book":"清·李汝珍《镜花缘》第18回"},"similar":["目瞪口呆"],"usage":"作定语、状语；指人的神情"},{"id":33224,"word":"目瞪舌强","pinyin":"mù dèng shé qiáng","abbr":"mdsq","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"俄而于朋辈之中夺其一人而去，使其徒回皇四望，而目瞪舌强，不知所以为策。","book":"宋·陈亮《众祭潘用和文》"},"similar":["目瞪口呆","目瞪舌挢"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33225,"word":"目瞪舌彊","pinyin":"mù dèng shé jiàng","abbr":"mdsj","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。"},{"id":33226,"word":"目瞪舌挢","pinyin":"mù dèng shé jiǎo","abbr":"mdsj","explanation":"形容因吃惊或害怕而发愣的样子。同“目瞪口呆”。","source":{"text":"向之主战者，乃始目瞪舌挢，神丧胆落，不敢出一语。","book":"谭嗣同《思纬氤氲台短书一报元征》"},"similar":["目瞪舌强"],"usage":"作谓语、定语、状语；形容吃惊的神态"},{"id":33227,"word":"目知眼见","pinyin":"mù zhī yǎn jiàn","abbr":"mzyj","explanation":"亲眼所见。形容熟悉了解。","source":{"text":"放着恁般目知眼见的倒不嫁，难道到在那些酒包饭袋里去搜觅？","book":"明·冯梦龙《醒世恒言》第20卷"},"opposite":["道听途说"],"usage":"作宾语、定语；指很了解的事物或人"},{"id":33228,"word":"目短于自见","pinyin":"mù duǎn yú zì jiàn","abbr":"mdyzj","explanation":"短：短处，局限；自见：自己看见自己。眼睛的短处在于自己看不见自己。比喻人难有自知之明。","source":{"text":"古之人目短于自见，故以镜观面。智短于自知，故以道正己。","book":"《韩非子·观行》"}},{"id":33229,"word":"目秀眉清","pinyin":"mù xiù méi qīng","abbr":"mxmq","explanation":"目：眼睛；秀：秀丽；眉：眉毛；清：清新。形容人容貌清秀俊美。","source":{"text":"渐渐到了十六七岁，出落得唇红齿白，目秀眉清。","book":"清·西周生《醒世姻缘传》第一回"},"example":{"text":"《鼓掌绝尘》：“～，口方耳大，丰姿俊雅，气度幽闲。”"},"similar":["眉清目秀"],"usage":"作谓语、定语、补语；指人的外貌"},{"id":33230,"word":"目空一世","pinyin":"mù kōng yī shì","abbr":"mkys","explanation":"什么都不放在眼里。形容骄傲自大。","source":{"text":"宏甫快口直肠，目空一世，愤激过甚，不顾人有忏者。","book":"明·焦竑《李氏焚书序》"},"example":{"text":"但以余之生平负其气节文章，～，即谈理家有不合者，辄争急辨岳岳，不为之屈。","book":"清·归庄《陆道思辨录集》"},"similar":["目空一切"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语、状语；指骄傲自大"},{"id":33231,"word":"目空一切","pinyin":"mù kōng yī qiè","abbr":"mkyq","explanation":"什么都不放在眼里。形容极端骄傲自大。","source":{"text":"何茂恭目空一切，独能降意于一世豪杰，而士亦乐亲之。","book":"宋·陈亮《题俞季直文编》"},"example":{"text":"但他恃著自己学问，～，每每把人不放在眼内。","book":"清·李汝珍《镜花缘》第五十二回"},"similar":["目中无人"],"opposite":["虚怀若谷"],"usage":"作谓语、定语、状语；指骄傲自大","story":["唐朝末年，朱温杀了宰相崔胤，强迫唐昭宗迁都洛阳，朱温不放心，派李振到洛阳去监视唐昭宗及百官。李振仗着朱温的权势，趾高气扬，目空一切，他经常用动动下巴和盛气凌人的态度去指使别人，遇到不顺眼的就训斥"]},{"id":33232,"word":"目空余子","pinyin":"mù kōng yú zǐ","abbr":"mkyz","explanation":"眼里没有别人。形容骄傲自大，看不起人。同“目中无人”。","source":{"text":"如果遇到对方有弱点，就更加盛气凌人，目空余子。","book":"马南邨《燕山夜话·交友待客之道》"},"similar":["目中无人","目无余子"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指人狂妄"},{"id":33233,"word":"目空四海","pinyin":"mù kōng sì hǎi","abbr":"mksh","explanation":"四海：指全国各地。眼看四海之内皆空。比喻目中无人、狂妄或自负之甚。","source":{"text":"何茂恭目空四海，独能降意于一世豪杰。","book":"宋·陈亮《题喻季直文编》"},"example":{"text":"你不要～，比你能干的人有的是。"},"similar":["目空一切","目空天下"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语、宾语；指人很狂妄"},{"id":33234,"word":"目空天下","pinyin":"mù kōng tiān xià","abbr":"mktx","explanation":"比喻目中无人、狂妄或自负之甚。","source":{"text":"何茂恭目空四海，独能降意于一世豪杰，而士亦乐亲之。","book":"宋·陈亮《题俞季直文编》"},"example":{"text":"则亿而中，为而成，心无顾恤而～。","book":"清·王夫之《读通鉴论·隋炀帝》"},"similar":["目空四海"],"usage":"作谓语、定语、宾语；指人很狂妄"},{"id":33235,"word":"目窕心与","pinyin":"mù tiǎo xīn yǔ","abbr":"mtxy","explanation":"指眉目传情，内心相许。","source":{"text":"杂裾垂髾，目窕心与。","book":"汉·枚乘《七发》"},"similar":["目成心许"],"usage":"作谓语；用于男女之间"},{"id":33236,"word":"目若悬珠","pinyin":"mù ruò xuán zhū","abbr":"mrxz","explanation":"眼睛象一对悬挂的珠子。形容眼睛明亮有光彩。","source":{"text":"臣朔年二十二，长九尺三寸，目若悬珠，齿若编贝。","book":"《汉书·东方朔传》"},"usage":"作谓语、定语；用于人的眼睛"},{"id":33237,"word":"目营心匠","pinyin":"mù yíng xīn jiàng","abbr":"myxj","explanation":"仔细观察测量，巧妙构思设计。","source":{"text":"皆出其目营心匠。","book":"宋·李格非《洛阳名园记·富郑公园》"}},{"id":33238,"word":"目见耳闻","pinyin":"mù jiàn ěr wén","abbr":"mjew","explanation":"指亲眼看见，亲耳听到。","source":{"text":"事不目见耳闻，而臆断其有无，可乎？","book":"宋·苏轼《石钟山记》"},"example":{"text":"因他父兄都是个大才子，朝谈夕讲，无非子史经书，～，不少，诗词歌赋。","book":"明·冯梦龙《醒世恒言》第11卷"},"similar":["目击耳闻"],"usage":"作谓语、定语；指亲自见闻"},{"id":33239,"word":"目论浅识","pinyin":"mù lùn qiǎn shí","abbr":"mlqs","explanation":"目论：眼前之论。比喻见识短浅。"},{"id":33240,"word":"目语心计","pinyin":"mù yǔ xīn jì","abbr":"myxj","explanation":"语：谈话；计：计算。用眼睛示意，在心里盘算。","source":{"text":"目语心计，不宜唇齿。","book":"晋·陈寿《三国志·吴志·周鲂传》"},"usage":"作谓语；指人的神态"},{"id":33241,"word":"目语额瞬","pinyin":"mù yǔ é shùn","abbr":"myes","explanation":"眉毛眼睛能作态示意。形容处事精明狡猾。","source":{"text":"目语额瞬，动頞塞鼻，谈智于尺寸之间，窥窬于分毫之际。","book":"晋·成粲《平乐市赋》"},"example":{"text":"～，言市人黠也。","book":"明·王志坚《表异录·邑里》"},"usage":"作谓语、主语；指人的为人"},{"id":33242,"word":"目达耳通","pinyin":"mù dá ěr tōng","abbr":"mdet","explanation":"形容感觉灵敏，非常聪明。","source":{"text":"噽为人览闻辩见，目达耳通，诸事无所不知。","book":"汉·袁康《越绝书·外传记策考》"},"similar":["耳聪目明"],"usage":"作谓语、定语；指人聪明"},{"id":33243,"word":"目迷五色","pinyin":"mù mí wǔ sè","abbr":"mmws","explanation":"五色：各种颜色。形容颜色既多又杂，因而看不清。比喻事物措综复杂，不易分辨清楚。","source":{"text":"五色令人目盲。","book":"《老子》"},"example":{"text":"慎卿先生此一番评骘，可云至公至明；只怕立朝之后，做主考房官，又要～，奈何？","book":"清·吴敬梓《儒林外史》第四十六回"},"similar":["五彩缤纷","眼花缭乱"],"opposite":["漆黑一团"],"usage":"作谓语；比喻事物错综复杂，分辨不清楚"},{"id":33244,"word":"目送手挥","pinyin":"mù sòng shǒu huī","abbr":"mssh","explanation":"手眼并用，怎么想就怎么用。也比喻语言文字的意义双关，意在言外。","source":{"text":"目送归鸿，手挥五弦，俯仰自得，游心太玄。","book":"三国·魏·嵇康《兄弟才公穆入军赠诗》"},"example":{"text":"毛泽东不愧谈判的高手，无论情况多么复杂艰巨，他都可以～，渡过难关。","book":"《人物》"},"similar":["手挥目送"],"usage":"作谓语；指人的谈吐"},{"id":33245,"word":"目逆而送","pinyin":"mù nì ér sòng","abbr":"mnes","explanation":"逆：迎。目逆：眼睛迎着当面走过来的人。眼睛注视着迎来，注视着送走。形容对所见的人十分关注或敬佩。","source":{"text":"宋华父督见孔父之妻于路，目逆而送之，曰：‘美而艳。’","book":"《左传·恒公元年》"},"example":{"text":"五日，学生五千余人身背包袱出发，沿途市民泪眼模糊地～。","book":"陶菊隐《北洋军阀统治时期史话》第四十三章"},"usage":"作谓语、定语；用于书面语"},{"id":33246,"word":"目酣神醉","pinyin":"mù hān shén zuì","abbr":"mhsz","explanation":"形容景色优美令人陶醉。","source":{"text":"山色如娥，花光如颊，温风如酒，波纹如绫，才一举头，已不觉目酣神醉。","book":"明·袁宏道《西湖》"},"usage":"作谓语、宾语；用于欣赏风景"},{"id":33247,"word":"目量意营","pinyin":"mù liàng yì yíng","abbr":"mlyy","explanation":"以目测量，用心经营。形容精心勘测设计。","source":{"text":"阮安有巧思，奉成祖命营北京城池宫殿及百司府廨，目量意营，悉中规制，工部奉行而已。","book":"《明史·宦官传一·阮安》"},"usage":"作谓语、宾语；用于处世"},{"id":33248,"word":"目食耳视","pinyin":"mù shí ěr shì","abbr":"mses","explanation":"用眼睛吃，用耳朵看。比喻颠倒错乱。","source":{"text":"世之人不以耳视而目食者，鲜矣。","book":"宋·司马光《迂书·官失》"},"similar":["耳视目食"],"usage":"作宾语、定语；用于书面语"},{"id":33249,"word":"盱衡厉色","pinyin":"xū héng lì sè","abbr":"xhls","explanation":"盱衡：举眉扬目；厉：严厉；色：面色。横眉怒目，面色严厉。","source":{"text":"当此之时，公运独见之明，奋亡前之威，盱衡厉色，振扬武怒。","book":"《汉书·王莽传》"},"example":{"text":"今也，骏特俶党之士，丁时未至，～，悍然而为之，志固不遂，且危其身矣。","book":"章炳麟《变法箴言》"},"similar":["横眉怒目"],"opposite":["慈眉善目"],"usage":"作谓语、定语；形容人愤怒的样子"},{"id":33250,"word":"盱衡大局","pinyin":"xū héng dà jú","abbr":"xhdj","explanation":"盱衡：扬眉举目。指纵观全局。","example":{"text":"我们～来考虑问题。"},"similar":["纵观全局"],"usage":"作谓语；指纵观全局"},{"id":33251,"word":"盲人扪烛","pinyin":"máng rén mén zhú","abbr":"mrmz","explanation":"比喻只凭片面了解或局部经验就对事物妄加判断。同“盲翁扪籥”。","source":{"text":"盲人扪烛，而以为日，欲正告之，则不能免于词费。","book":"民意《告非难民生主义者》第三节"},"similar":["盲翁扪钥","盲翁扪龠","盲人摸象"],"usage":"作宾语、定语；指看问题以偏概全","story":["古时一个天生瞎子问人太阳是什么样的，人家说太阳像铜盘，瞎子回家发现铜盘是可以敲响的，就把敲钟的声音误以为是太阳，人家告诉他太阳不发声而像蜡烛一样有热量，他回家把蜡烛当成了太阳。一天他发现乐器籥跟蜡烛很像，也以为是太阳"]},{"id":33252,"word":"盲人把烛","pinyin":"máng rén bǎ zhú","abbr":"mrbz","explanation":"瞎子手擎烛火照亮。比喻不起任何作用。","source":{"text":"古人每以陈寿帝魏不帝蜀，议者蜂起，皆盲人把烛之谈也。","book":"《野叟曝言》七五回"},"similar":["瞎子点灯"],"usage":"作宾语、定语；指没有任何作用"},{"id":33253,"word":"盲人摸象","pinyin":"máng rén mō xiàng","abbr":"mrmx","explanation":"比喻对事物只凭片面的了解或局部的经验，就乱加猜测，想做出全面的判断。","source":{"text":"其触牙者即言象形如芦菔根，其触耳者言象如箕，其触头者言象如石，其触鼻者言象如杵，其触脚者言象如木臼，其触脊者言象如床，其触腹者言象如甕，其触尾者言象如绳。","book":"《大般涅槃经》三二"},"example":{"text":"于是所见的人或事，就如～，摸着了脚，即以为象的样子象柱子。","book":"鲁迅《这也是生活》"},"similar":["管中窥豹","坐井观天"],"opposite":["洞察一切","仰视观察"],"usage":"作宾语、定语、分句；指看问题以偏概全","story":["古代佛经里讲到有几个盲人去摸大象，一个瞎子摸到大象的腿就说大象像棍子，一个摸到大象的耳朵就说大象像扇子，一个摸到大象的尾巴说像绳子。因为他们摸到的都是大象的一部分而没有看到大象的整体形象"]},{"id":33254,"word":"盲人瞎马","pinyin":"máng rén xiā mǎ","abbr":"mrxm","explanation":"盲人骑着瞎马。比喻盲目行动，后果十分危险。","source":{"text":"盲人骑瞎马，夜半临深池。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"我不能叫你～地去乱闯。","book":"杨沫《青春之歌》第一部第十四章"},"similar":["履冰临渊","履薄临深"],"usage":"作宾语、定语、状语；指十分危险","story":["东晋文学家顾恺之到殷仲堪家中做客，恒温的儿子恒玄也在，三人高兴抽签玩文字游戏，就“危”字他们说道：“矛头淅米剑头炊”、“百岁老翁攀枯枝”、“井上辘轳卧婴儿”，旁人道“盲人骑瞎马，夜半临深池”，独眼的殷仲堪十分不悦"]},{"id":33255,"word":"盲人说象","pinyin":"máng rén shuō xiàng","abbr":"mrsx","explanation":"比喻看问题以偏概全。","source":{"text":"吾侪碌碌，从俗浮沉，与先生相去远甚，而欲强加评品，正如盲人说象。","book":"元·黄溍《书袁通甫诗后》"},"example":{"text":"不深入调查研究就会闹出～的笑话来的。"},"similar":["盲人摸象"],"opposite":["洞察一切"],"usage":"作宾语、定语；指看问题以偏概全","story":["古代佛经里讲到有几个盲人去摸大象，一个瞎子摸到大象的腿就说大象像棍子，一个摸到大象的耳朵就说大象像扇子，一个摸到大象的尾巴说像绳子。因为他们摸到的都是大象的一部分而没有看到大象的整体形象"]},{"id":33256,"word":"盲人骑瞎马","pinyin":"máng rén qí xiā mǎ","abbr":"mrqxm","explanation":"瞎子骑着瞎马。形容乱闯瞎撞，非常危险。","source":{"text":"桓南郡与殷荆州语次，因共作了语……复作危语。桓曰：‘矛头淅米剑头炊。’殷曰：‘百岁老翁攀枯枝。’顾曰：‘井上辘轳卧婴儿。’殷有一参军在坐云：‘盲人骑瞎马，夜半临深池。’","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"但是你们老兄，几几乎入新党的那件事，要果真照你这样说起来，岂不是～，夜半临深池，也算他冒险一次么？","book":"《冷眼观》第十七回"},"similar":["盲人瞎马"],"usage":"作宾语、定语；指十分危险","story":["东晋文学家顾恺之到殷仲堪家中做客，恒温的儿子恒玄也在，三人高兴抽签玩文字游戏，就“危”字他们说道：“矛头淅米剑头炊”、“百岁老翁攀枯枝”、“井上辘轳卧婴儿”，旁人道“盲人骑瞎马，夜半临深池”，独眼的殷仲堪十分不悦"]},{"id":33257,"word":"盲目乐观","pinyin":"máng mù lè guān","abbr":"mmlg","explanation":"盲：瞎，盲从。指不根据实际情况高兴得太早。","example":{"text":"我们不能～，形势还很严峻。"},"usage":"作主语、谓语、宾语；指高兴得太早"},{"id":33258,"word":"盲目崇拜","pinyin":"máng mù chóng bài","abbr":"mmcb","explanation":"指盲从崇拜别人。","example":{"text":"我不会～的。"},"usage":"作谓语、宾语；指盲从崇拜别人"},{"id":33259,"word":"盲眼无珠","pinyin":"máng yǎn wú zhū","abbr":"mywz","explanation":"瞎了眼，没了眼珠子。形容对眼前的事物一无所知。也比喻不识事理。","source":{"text":"多因我盲眼无珠，怎识他笔端藏意。","book":"明·胡文焕《群音类选·东厢记·传情惹恨》"},"similar":["有眼无珠"],"usage":"作谓语、定语；用于骂人"},{"id":33260,"word":"盲瞽之言","pinyin":"máng gǔ zhī yán","abbr":"mgzy","explanation":"盲瞽：眼睛瞎，比喻不明事理。指见识短浅或没有分寸的话。常用作自谦语。","source":{"text":"然则儒生所谓盲瞽者也。","book":"汉·王充《论衡·谢短》"},"example":{"text":"如不见怪，小弟也有一句～。","book":"清·吴敬梓《儒林外史》第二十九回"}},{"id":33261,"word":"盲翁扪籥","pinyin":"máng wēng mén yuè","abbr":"mwmy","explanation":"比喻只凭片面了解或局部经验就对事物妄加判断。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜槃。’扣槃而得其声。他日闻锺以为日也。或告之曰：‘日之光如烛。’扪烛而得其形，他日揣籥以为日也。日之与锺籥亦远矣，而眇者不知其异，以其未尝见而求之人也。","book":"宋·苏轼《日喻》"},"example":{"text":"～但取似，叶公好龙固为名。","book":"清·赵翼《岣嵝碑歌》"},"similar":["盲人扪烛","盲翁扪龠"],"usage":"作宾语、定语；指看问题以偏概全","story":["古时一个天生瞎子问人太阳是什么样的，人家说太阳像铜盘，瞎子回家发现铜盘是可以敲响的，就把敲钟的声音误以为是太阳，人家告诉他太阳不发声而像蜡烛一样有热量，他回家把蜡烛当成了太阳。一天他发现乐器籥跟蜡烛很像，也以为是太阳"]},{"id":33262,"word":"盲翁扪钥","pinyin":"máng wēng mén yào","abbr":"mwmy","explanation":"比喻只凭片面了解或局部经验就对事物妄加判断。亦作“盲翁扪籥”。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜盘。’扣盘而得其声。他日闻锺以为日也。或告之曰：‘日之光如烛。’扪烛而得其形，他日揣钥以为日也。日之与锺钥亦远矣，而眇者不知其异，以其未尝见而求之人也。","book":"宋·苏轼《日喻》"}},{"id":33263,"word":"盲者失杖","pinyin":"máng zhě shī zhàng","abbr":"mzsz","explanation":"杖：手杖，拐杖。瞎子失去了拐杖。比喻失去依靠。"},{"id":33264,"word":"盲者得镜","pinyin":"máng zhě dé jìng","abbr":"mzdj","explanation":"形容事物不能发挥正常作用。也比喻埋没人才。","source":{"text":"盲者得镜，则以盖卮。","book":"《淮南子·人间训》"},"usage":"作宾语、定语；指埋没人才"},{"id":33265,"word":"盲风妒雨","pinyin":"máng fēng dù yǔ","abbr":"mfdy","explanation":"指非常急骤凶猛的风雨。同“盲风怪雨”。","source":{"text":"而盲风妒雨，夜半陡作，瓣瓣沾泥矣。","book":"明·魏大中《答方孩未》"},"similar":["盲风怪雨","狂风暴雨"],"usage":"作宾语、定语；用于天气等"},{"id":33266,"word":"盲风怪云","pinyin":"máng fēng guài yún","abbr":"mfgy","explanation":"指急骤的风云。","source":{"text":"五领之君，盲风怪云，毒蛇臻臻，相其不仁。","book":"宋·姜夔《圣宋铙歌吹曲·时雨霈》"},"similar":["盲风怪雨"],"opposite":["和风细雨"],"usage":"作宾语；指急骤的风云"},{"id":33267,"word":"盲风怪雨","pinyin":"máng fēng guài yǔ","abbr":"mfgy","explanation":"指非常急骤凶猛的风雨。","source":{"text":"盲风怪雨日纵横，纸阁芦帘拽水行。","book":"清·钱泳《履园丛话·题壁诗》"},"example":{"text":"清·钱泳《履园丛话·题壁诗》：“～日纵横，纸阁芦帘拽水行。”"},"similar":["狂风暴雨","盲风暴雨"],"usage":"作宾语、定语；用于天气等"},{"id":33268,"word":"盲风晦雨","pinyin":"máng fēng huì yǔ","abbr":"mfhy","explanation":"指非常急骤凶猛的风雨。比喻困境。同“盲风怪雨”。","source":{"text":"愈挫愈奋，愤盈旁魄，几使俄政府权力威命之所及，俱陷于盲风晦雨之途焉。","book":"杨笃生《新湖南》第五篇"},"example":{"text":"～凄其夜，起读先生《正气歌》。","book":"柳亚子《题〈张苍水集〉》诗"},"similar":["盲风暴雨","狂风暴雨"],"usage":"作宾语、定语；用于天气等"},{"id":33269,"word":"盲风暴雨","pinyin":"máng fēng bào yǔ","abbr":"mfby","explanation":"指非常急骤的风雨。","source":{"text":"尔时诸天昏暗，盲风暴雨，震荡川陆。","book":"苏曼殊《遁迹记》"},"similar":["盲风怪雨"],"usage":"作宾语；形容风雨"},{"id":33270,"word":"盲风涩雨","pinyin":"máng fēng sè yǔ","abbr":"mfsy","explanation":"犹盲风怪雨。比喻晦涩的诗风。","source":{"text":"宁为长天晴日，无为盲风涩雨；宁为清渠细流，无为浊沙恶潦。","book":"清·钱谦益《徐元叹诗序》"},"similar":["盲风晦雨"],"usage":"作宾语、定语；用于天气等"},{"id":33271,"word":"直上直下","pinyin":"zhí shàng zhí xià","abbr":"zszx","explanation":"①上下一贯。②从上到下，从头到脚。③形容陡直。","source":{"text":"凡事都分做两边，是底放一边，非底放一边。是底是天理，非底是人欲。是即守而勿失，非即去而不留：此治一身之法也。治一家则分别一家之是非，治一邑则分别一邑之邪正，推而一州一路以至天下，莫不皆然：此～之道。","book":"《朱子全书》卷四"},"example":{"text":"②明·施耐庵《水浒传》第六十七回“官道旁边，只见走过一条大汉，直上直下相李逵。”③这楼梯～，不好走。"},"usage":"作谓语、宾语、定语；指上下笔直"},{"id":33272,"word":"直上青云","pinyin":"zhí shàng qīng yún","abbr":"zsqy","explanation":"直上：直线上升。比喻官运亨通，直登高位。","source":{"text":"一朝君王垂拂拭，剖心输丹雪胸臆。忽蒙白日回景光，直上青云生羽翼。","book":"唐·李白《驾去温泉宫后赠杨山人》诗"},"example":{"text":"一朝～路，锦衣还眉扬气吐。","book":"明·谢谠《四喜记·诗礼趋庭》"},"similar":["青云直上"],"usage":"作谓语、定语；同“青云直上”","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相。范雎含冤被打伤，改名张禄逃到秦国青云直上当上宰相。须贾出使秦国，范雎扮作穷人去见他。须贾见他一寒如此送他绨袍，待发现他是秦相时吓得一再谢罪。范雎没有杀他"]},{"id":33273,"word":"直入云霄","pinyin":"zhí rù yún xiāo","abbr":"zryx","explanation":"云霄：指天空。直冲云天。形容歌声高亢嘹亮。","source":{"text":"点起几百盏明角灯来，高高下下，照耀如同白日；歌声缥缈，直入云霄。","book":"清·吴敬梓《儒林外史》第34回"},"similar":["高耸入云"],"usage":"作谓语、定语；指歌声或山、建筑等"},{"id":33274,"word":"直入公堂","pinyin":"zhí rù gōng táng","abbr":"zrgt","explanation":"比喻言行直截了当，不绕弯子。","source":{"text":"到这几家去！别直入公堂的跟人家求事，明白吗？要顺口答应的探听有什么路子可走！","book":"老舍《骆驼祥子》九：“可是，咱们就这么直入公堂的去说，还是不行。”又《四世同堂》七"},"similar":["直捷了当"],"opposite":["转弯抹角"],"usage":"作定语、状语；用于处事"},{"id":33275,"word":"直内方外","pinyin":"zhí nèi fāng wài","abbr":"znfw","explanation":"形容内心正直、做事方正。","source":{"text":"君子敬以直内，义以方外。","book":"《周易·坤》"},"example":{"text":"只要体当自家～之实事，乃是为已之切。","book":"宋·朱熹《朱子全书·论语》"},"usage":"作谓语、定语；指人的品行"},{"id":33276,"word":"直写胸臆","pinyin":"zhí xiě xiōng yì","abbr":"zxxy","explanation":"胸臆：胸腔，内心，引申为心意。直率地抒发自己的思想感情。","source":{"text":"杜公七律，正以其负力之大，寄悰之深，能直抒胸臆，广酬事物之变而无碍。","book":"明·胡震亨《唐音癸签》第十回"}},{"id":33277,"word":"直冲横撞","pinyin":"zhí chōng héng zhuàng","abbr":"zchz","explanation":"任意乱冲乱撞，毫无顾忌。","source":{"text":"凡作文皆从外面攻进里去，我为文章只就里面攻打出来，直冲横撞，就他城池，食他粮草，搅得他粉碎，故不费一毫气力而自然有余也。","book":"明·李贽《续焚书·与友人论文》"},"similar":["横冲直撞","直撞横冲","横冲直闯"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":33278,"word":"直口无言","pinyin":"zhí kǒu wú yán","abbr":"zkwy","explanation":"犹言哑口无言。","source":{"text":"众人被他骂的直口无言。","book":"清·刘鹗《老残游记》第一回"},"similar":["哑口无言"],"opposite":["口若悬河"],"usage":"作定语、状语；指无话可说"},{"id":33279,"word":"直吐胸怀","pinyin":"zhí tǔ xiōng huái","abbr":"ztxh","explanation":"直：直爽；抒：抒发。坦率地发表自己的意见。","source":{"text":"予观诗不以格律体裁为论,惟求直吐胸怀、实叙景象，妇人小子皆晓所谓者，然后定为好诗。","book":"明·杨循吉《论诗》"},"similar":["直抒胸臆"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":33280,"word":"直壮曲老","pinyin":"zhí zhuàng qū lǎo","abbr":"zzql","explanation":"老：引申为衰，气馁。理直气壮，理曲气馁","source":{"text":"师直为壮，曲为老，岂在之乎？","book":"春秋·鲁·左丘明《左传·僖公二十八年》"},"usage":"作定语；用于书面语"},{"id":33281,"word":"直奔主题","pinyin":"zhí bèn zhǔ tí","abbr":"zbzt","explanation":"径直、直接地投入主要问题，不拐弯抹角。"},{"id":33282,"word":"直如弦","pinyin":"zhí rú xián","abbr":"zrx","explanation":"像弓弦一样直。形容为人正直。","source":{"text":"顺帝之末，京都童谣曰：‘直如弦，死道边。曲如钩，反封侯。’","book":"《后汉书·五行志》"},"example":{"text":"常知生似幻，维重～。(唐·贯休《和韦相公见示闲卧》)"},"usage":"作谓语、定语；用于比喻句"},{"id":33283,"word":"直待雨淋头","pinyin":"zhí dài yǔ lín tóu","abbr":"zdylt","explanation":"待；等到。直到下雨时方要做某事。比喻不能及早动手或毫无准备。","source":{"text":"僧问：‘一言合道时如何？’师曰：‘七颠八倒。’曰：‘学人礼拜。’师曰：‘教休不肯休，直待雨淋头。’","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"三巧儿晚丫鬟开看，只见薛婆衣衫半湿，提个破伞进来，口儿道：“睛千不肯走，～。”（明·冯梦龙《喻世明言》卷一）"},"opposite":["未雨绸缪"],"usage":"作谓语、定语；用于比喻句"},{"id":33284,"word":"直性狭中","pinyin":"zhí xìng xiá zhōng","abbr":"zxxz","explanation":"性：性格；狭：狭隘。性格直爽，但心胸狭隘，不能容人容事。","source":{"text":"足下傍通，多可而少怪，吾直性狭中，多所不堪，偶与足下相知耳。","book":"三国·魏·嵇康《与山巨源绝交书》"},"usage":"作谓语、定语；用于书面语"},{"id":33285,"word":"直情径行","pinyin":"zhí qíng jìng xíng","abbr":"zqjx","explanation":"径：直；行：从事。凭着自己的意思径直地去做。比喻想怎么干就怎么干。","source":{"text":"有直情而径行者，戎狄之道也。","book":"《礼记·檀弓下》"},"example":{"text":"～，视毁誉如风而不恤。","book":"宋·陈亮《谢罗尚书启》"},"similar":["随心所欲"],"usage":"作谓语；指随心所欲"},{"id":33286,"word":"直截了当","pinyin":"zhí jié liǎo dàng","abbr":"zjld","explanation":"形容说话做事爽快、干脆。","source":{"text":"紫芝妹妹嘴虽利害，好在心口如一，直截了当，倒是一个极爽快的。","book":"清·李汝珍《镜花缘》第六十五回"},"example":{"text":"他说话、办事～，认真干脆。"},"similar":["开门见山","单刀直入"],"opposite":["转弯抹角","旁敲侧击","指桑骂槐"],"usage":"作状语、定语；指干脆"},{"id":33287,"word":"直扑无华","pinyin":"zhí pǔ wú huá","abbr":"zpwh","explanation":"质朴无文采。","source":{"text":"至于《易》著《文言》，词尚整饰，《书》垂《典》《诰》，尤多叶韵，群言之祖，排偶尤繁，匪日直扑无华，遂称复古也。","book":"罗惇曧《文学源流》"}},{"id":33288,"word":"直抒己见","pinyin":"zhí shū jǐ jiàn","abbr":"zsjj","explanation":"直：直爽；抒：抒发。坦率地发表自己的意见。","source":{"text":"倘鉴愚诚，取平生所述訾敖朱子之语，一切薙芟，而直抒己见，以共明孔子之道。","book":"清·方苞《与李纲主书》"},"example":{"text":"讨论会上，大家热涌跃发言，～。"},"similar":["直言不讳","直截了当","开门见山"],"opposite":["转弯抹角","指桑骂槐","旁敲侧击"],"usage":"作谓语、定语；指发表看法"},{"id":33289,"word":"直抒胸臆","pinyin":"zhí shū xiōng yì","abbr":"zsxy","explanation":"胸臆：胸腔，内心，引申为心意。直率地抒发自己的思想感情。","source":{"text":"杜公七律，正以其负力之大，寄悰之深，能直抒胸臆，广酬事物之变而无碍。","book":"明·胡震亨《唐音癸签》第十回"},"example":{"text":"古诗章节未谐，尤多趁韵；然～，语皆有物。","book":"清·李慈铭《越缦堂诗话》卷中"},"similar":["直吐胸怀"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":33290,"word":"直捣黄龙","pinyin":"zhí dǎo huáng lóng","abbr":"zdhl","explanation":"黄龙：即黄龙府，辖地在今吉林一带，为金人的腹了。一直打到黄龙府。指捣毁敌人的巢穴。","source":{"text":"金将军韩常欲以五万众内附。飞大喜，语其下曰：‘直抵黄龙府，与诸君痛饮尔！’","book":"《宋史·岳飞传》"},"example":{"text":"～君莫懈，福星高照古神州。","book":"吴玉章《和印泉老兄“七七”三年抗战纪念感赋原韵》"},"similar":["深入虎穴"],"usage":"作主语、谓语、定语；指杀敌取胜","story":["北宋末年，北方女真族建立金国大举进攻北宋，消灭了北宋。宋钦宗的弟弟宋高宗建立南宋，南宋朝廷软弱无能，步步退让。岳飞指挥岳家军英勇抗金，金国士兵闻风丧胆，岳飞乘胜追击，他对将士们说：“我一定要直捣黄龙和你们痛饮。”"]},{"id":33291,"word":"直捷了当","pinyin":"zhí jié liǎo dàng","abbr":"zjld","explanation":"形容说话、做事不绕弯子，干脆爽快。同“直截了当”。","source":{"text":"但措施太绕弯子了。有更其直捷了当的说法在这里。","book":"鲁迅《坟·灯下漫笔》"},"example":{"text":"才见一面我就～，把我的情况告诉了他们了！","book":"沙汀《困兽记》十五"},"similar":["直接了当","直截了当"],"usage":"作定语、状语；用于处事"},{"id":33292,"word":"直接了当","pinyin":"zhí jiē liǎo dàng","abbr":"zjld","explanation":"了当：干脆，爽快。形容说话做事爽快、不绕弯子","source":{"text":"因为反正无法挽救，倒不如各人知趣，早点‘卖身投靠’的直接了当。","book":"聂绀弩《关于知识分子》"},"example":{"text":"王朔《过把瘾就死》：“别拐弯抹角，直接了当……怎么就这么难呢？比要你命还难？”"},"similar":["直截了当","直捷了当"],"usage":"作谓语、定语、状语；用于处事"},{"id":33293,"word":"直撞横冲","pinyin":"zhí zhuàng héng chōng","abbr":"zzhc","explanation":"形容向前突破，不可阻挡或毫无顾忌地乱冲乱闯。","source":{"text":"这些随来的精勇，个个持死杀来，真个是摧枯拉朽，直撞横冲，杀得友谅远走二十里之地。","book":"《英烈传》第二十八回"},"similar":["横冲直撞","直冲横撞","横冲直闯"],"usage":"作谓语、定语、状语；形容肆意行动"},{"id":33294,"word":"直木先伐","pinyin":"zhí mù xiān fá","abbr":"zmxf","explanation":"直：挺直。挺直成材的树木，最先被砍伐。比喻有才能的人会遭到迫害。亦作“直木必伐”。","source":{"text":"是故其行列不斥，而外人卒不得害，是以免于患。直木先伐，甘井先竭。","book":"《庄子·山木》"},"example":{"text":"伏望陛下思～之义者，众恶必察之。","book":"宋·王禹偁《滁州谢上表》"},"similar":["直木必伐"],"usage":"作宾语、定语；用于劝诫人"},{"id":33295,"word":"直木必伐","pinyin":"zhí mù bì fá","abbr":"zmbf","explanation":"直木：笔直的树木；伐：砍。成材的树必被砍伐。比喻正直的人容易招怨。","source":{"text":"是故其行列不斥，而外人卒不得害，是以免于患。直木先伐，甘井先竭。","book":"《逸周书·周祝》：“甘泉必竭，直木必伐。”《庄子·山木》"},"similar":["直木先伐"],"usage":"作宾语、定语；用于劝诫人"},{"id":33296,"word":"直朴无华","pinyin":"zhí pǔ wú huá","abbr":"zpwh","explanation":"华：文采。质朴而没有文采","source":{"text":"至于《易》著《文言》，词尚整饰，《书》垂《典》《诰》，尤多叶韵，群言之祖，排偶尤繁，匪曰直朴无华，遂称复古也。","book":"罗悴悬《文学源流》"},"similar":["质朴无华"],"usage":"作宾语、定语；用于书面语"},{"id":33297,"word":"直权无华","pinyin":"zhí quán wú huá","abbr":"zqwh","explanation":"质朴无文采。"},{"id":33298,"word":"直来直去","pinyin":"zhí lái zhí qù","abbr":"zlzq","explanation":"指来去途中不绕道、不停留，或指说话、做事不绕弯子。","source":{"text":"我就喜欢你说话～。"},"example":{"text":"我就喜欢你说话～"},"similar":["直言不讳","直截了当"],"opposite":["拐弯抹角"],"usage":"作宾语、定语；指说话、做事不绕弯子"},{"id":33299,"word":"直眉怒目","pinyin":"zhí méi nù mù","abbr":"zmnm","explanation":"形容发怒的样子。","source":{"text":"孔二老婆并不上他的当，直眉怒目骂他。","book":"端木蕻良《科尔沁旗草原》十七"},"usage":"作定语、状语；用于处事"},{"id":33300,"word":"直眉楞眼","pinyin":"zhí méi léng yǎn","abbr":"zmly","explanation":"形容眼神发直。","source":{"text":"老矿工直眉楞眼地坐了半天，想起了自己的女儿。","book":"邓十喆《活矿工和死把头》"},"similar":["直眉瞪眼","直眉睖眼"],"usage":"作定语、状语；用于方言"},{"id":33301,"word":"直眉睖眼","pinyin":"zhí méi lèng yǎn","abbr":"zmly","explanation":"竖眉瞪眼。","source":{"text":"那个直眉睖眼的小子是他们的炮手呵！","book":"端木蕻良《科尔沁旗草原》十七"},"similar":["直眉楞眼","直眉瞪眼"],"usage":"作定语、状语；用于书面语"},{"id":33302,"word":"直眉瞪眼","pinyin":"zhí méi dèng yǎn","abbr":"zmdy","explanation":"形容发脾气或发呆的样子。","source":{"text":"连司棋也都气了个直眉瞪眼。","book":"清·曹雪芹《红楼梦》第62回"},"example":{"text":"忙住口低头瞧一眼脚底下，然后～楞怔着。","book":"管桦《一幅画》"},"similar":["横眉竖眼"],"usage":"作谓语、定语；指发怒的样子"},{"id":33303,"word":"直而不挺","pinyin":"zhí ér bù tǐng","abbr":"zebt","explanation":"指作事按正直之道而行，但有变通。","source":{"text":"夫君子进而不挺，曲而不诎。","book":"《汉书·盖宽饶传》"},"usage":"作谓语、定语；用于书面语"},{"id":33304,"word":"直而不肆","pinyin":"zhí ér bù sì","abbr":"zebs","explanation":"直：正直；肆：放肆。虽然耿直却不放肆。","source":{"text":"是以圣人方而不割，廉而不刿，直而不肆，光而不耀。","book":"《老子》第五十八章"},"example":{"text":"其文章一以气为主，博而敏，～，自成一家言。（《元史·杨载传》）"},"usage":"作谓语、定语；用于书面语"},{"id":33305,"word":"直节劲气","pinyin":"zhí jié jìn qì","abbr":"zjjq","explanation":"气节正直，操守刚劲。","source":{"text":"廷守苏州时，人比之赵清献，直节劲气，始终无改。","book":"《明史·王廷传》"},"usage":"作谓语、定语；用于书面语"},{"id":33306,"word":"直言不讳","pinyin":"zhí yán bù huì","abbr":"zybh","explanation":"讳：避忌，隐讳。说话坦率，毫无顾忌。","source":{"text":"臣鉴先征，窃惟今事，是以敢肆狂瞽，直言无讳。","book":"《晋书·刘隗传》"},"example":{"text":"这倒不必多心，我是个无党无派的人，才敢这样～。","book":"梁斌《红旗谱》五十二"},"similar":["直抒己见","心直口快","单刀直入"],"opposite":["隐晦曲折","旁敲侧击","隐约其辞"],"usage":"作定语、状语；指直说","story":["公元383年，东晋军在淝水之战大败前秦军，孝武帝命刘波坐镇北方。刘波身患重病，估计不久就要离开人世，已经无能为力了。他上一道奏疏，直言不讳地把自己的情况与治国建议讲出来，希望孝武帝重用能人守疆土"]},{"id":33307,"word":"直言切谏","pinyin":"zhí yán qiē jiàn","abbr":"zyqj","explanation":"谓以正直的言论谏诤。古时多用于臣下对君主。同“直言极谏”。","source":{"text":"朔虽诙笑，然时观察颜色，直言切谏，上常用之。","book":"汉·班固《汉书·东方朔传》"},"similar":["直言极谏"],"usage":"作谓语、定语、宾语；用于处事"},{"id":33308,"word":"直言勿讳","pinyin":"zhí yán wù huì","abbr":"zywh","explanation":"直率地说话，无所隐讳。同“直言无讳”。","source":{"text":"尔群臣勿以前事为戒，于国家利弊、政令未当者，直言勿讳。","book":"清·张廷玉《明史·弋谦传》"},"similar":["直言无隐","直言无讳","直言不讳"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33309,"word":"直言危行","pinyin":"zhí yán wēi xíng","abbr":"zywx","explanation":"危行：直行。正直的言论和行为。","source":{"text":"以直言危行者为狂愚，以中立守道者为凝滞。","book":"唐·白居易《使百职修皇纲振》"},"usage":"作宾语、定语；用于书面语"},{"id":33310,"word":"直言取祸","pinyin":"zhí yán qǔ huò","abbr":"zyqh","explanation":"《左传·成公十五年》：“子好直言，必及于难。”","source":{"text":"下官目睹其奸，不容不奏，岂不知～。 ★明·王士桢《鸣凤记·幼海议本》"},"example":{"text":"清·褚人获《隋唐演义》第95回：“臣因禄山有此不祥之二梦，知其必败，故不与～，只以巧言对之，正欲留此微躯，再睹天颜耳。”"},"similar":["直言贾祸"],"usage":"作宾语、定语；用于处事"},{"id":33311,"word":"直言尽意","pinyin":"zhí yán jìn yì","abbr":"zyjy","explanation":"爽直地说出全部的意思。","source":{"text":"直言尽意，无有所讳。","book":"《汉书·元帝纪》"},"usage":"作谓语、定语；用于书面语"},{"id":33312,"word":"直言无讳","pinyin":"zhí yán wú huì","abbr":"zywh","explanation":"直率地说话，无所隐讳。","source":{"text":"晏子相景公，其论人也，见贤而进士，不同君所欲；见不善而废之，不辟君所爱；行已而无私，直言而无讳。","book":"语出《晏子春秋·外篇上二二》"},"example":{"text":"臣鉴先征，窃惟今事，是以敢肆狂瞽，～。","book":"《晋书·刘波传》"},"similar":["直言无隐","直言勿讳"],"usage":"作谓语、定语、状语；用于处事"},{"id":33313,"word":"直言无隐","pinyin":"zhí yán wú yǐn","abbr":"zywy","explanation":"直率地说话，无所隐讳。同“直言无讳”。","source":{"text":"年兄宜直言无隐，某亦有肺腑相通。","book":"明·冯梦龙《东周列国志》第五十回：“臣不忍坐视君国之危亡，故敢直言无隐。”清·李百川《绿野仙踪》第三回"},"example":{"text":"旋用御史徐启文奏，今中外臣工于时事阙失，～。","book":"柯劭忞《清史稿·后妃传·文宗孝贞显皇后》"},"similar":["直言不讳","直言无讳","直言勿讳"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33314,"word":"直言极谏","pinyin":"zhí yán jí jiàn","abbr":"zyjj","explanation":"①谓以正直的言论谏诤。古时多用于臣下对君主。②直言极谏科的省称。","source":{"text":"救主之失，补主之过，扬主之美，明主之功，使主内无邪辟之行，外无骞污之名。事君若此，可谓直言极谏之士矣。","book":"汉·晁错《举贤良对策》"},"example":{"text":"直说遭怨，直言遭忌，就为刺了别人的心——小之被人骂为‘臭嘴’，大之可以杀身。所以不折不扣的‘～’之臣，到底是寥寥可数的。","book":"朱自清《论老实话》"},"similar":["直言切谏"],"usage":"作谓语、定语、宾语；用于处事"},{"id":33315,"word":"直言正色","pinyin":"zhí yán zhèng sè","abbr":"zyzs","explanation":"谓言语正直，仪容严肃。","source":{"text":"每于公朝论议，常直言正色，退无私焉。","book":"《三国志·魏志·国渊传》"},"example":{"text":"～，论不阿谄。","book":"明·罗贯中《三国演义》第二十二回"},"usage":"作谓语、定语、状语；用于处事"},{"id":33316,"word":"直言正论","pinyin":"zhí yán zhèng lùn","abbr":"zyzl","explanation":"正直公道的言论。","source":{"text":"王荆公始用事，公以直言正论折之，不能胜。","book":"宋·邵伯温《闻见前录》"},"similar":["正言正谏","直言无隐"],"opposite":["恶言恶语","冷言冷语"],"usage":"作主语、宾语；指公道话"},{"id":33317,"word":"直言正谏","pinyin":"zhí yán zhèng jiàn","abbr":"zyzj","explanation":"指以正直的言论谏诤。古时多用于臣下对君主。","source":{"text":"寡人奉先君之宗庙，守社稷，闻先生直言正谏不讳。","book":"《战国策·齐策四》"},"example":{"text":"其有～之士，敢决徇义之夫，二十五日，悉集华林东门，人别引见，共论得失。","book":"《北史·魏纪四·肃宗孝明帝》"},"similar":["直言极谏","直言切谏"],"usage":"作谓语、定语、宾语；用于处事"},{"id":33318,"word":"直言谠议","pinyin":"zhí yán bù yì","abbr":"zydy","explanation":"谠：正直。正直的言论。","source":{"text":"每侍臣赐对，则左右悉去，故直言谠议，尽得上达。","book":"宋·钱易《南部新书》甲"},"usage":"作宾语、定语；用于书面语"},{"id":33319,"word":"直言贾祸","pinyin":"zhí yán gǔ huò","abbr":"zygh","explanation":"直：坦率、直爽；贾：买，引申为招致。指说话直率的人会惹祸。","source":{"text":"子好直言，必及于难。","book":"《左传·成公十五年》"},"example":{"text":"文太夫人早知文郎必以～，潜避至此。","book":"清·夏敬渠《野叟曝言》第四十一回"},"similar":["直言取祸"],"opposite":["明哲保身","缄口不言"],"usage":"作宾语、定语；指说直话的人会惹祸","story":["春秋时期，晋国大臣伯宗为人正派耿直，敢讲敢为，不怕得罪权势。他的妻子每次在他上朝时提醒他不要讲直话，避免直言贾祸，晋厉公是一个昏庸暴虐的君主，喜欢溜须拍马之徒，他看不惯伯宗的正直，就听信谗言将伯宗处死"]},{"id":33320,"word":"直言骨鲠","pinyin":"zhí yán gǔ gěng","abbr":"zygg","explanation":"言辞正直，气节刚劲。","source":{"text":"知朝廷有直言骨鲠之臣，天子有不僭赏从谏如流之美。","book":"唐·韩愈《争臣论》"},"usage":"作定语；用于书面语"},{"id":33321,"word":"直认不讳","pinyin":"zhí rèn bù huì","abbr":"zrbh","explanation":"直截了当承认，毫不回避隐瞒。","source":{"text":"马子畦一犯即现获之黄福诡名，亦经质讯明确，直认不讳。","book":"中国近台史资料丛刊《辛亥革命·徐锡麟安庆起义清方档案》"},"example":{"text":"这几条罪案，本社同人当然～。","book":"陈独秀《新青年·罪案之答辩书》"},"similar":["自认不讳"],"usage":"作谓语、定语；用于书面语"},{"id":33322,"word":"直谅多闻","pinyin":"zhí liàng duō wén","abbr":"zldw","explanation":"直：正直；谅：信实；多闻：学识渊博。为人正直信实，学识广博。","source":{"text":"益者三友，损者三友。友直，友谅，友多闻，益矣。友便辟，友善柔，友便佞，损也。","book":"《论语·季氏》"},"example":{"text":"文章经国之大业，不朽之盛事；世有～，引绳墨经纠余不逮者，祷祀求之矣。","book":"清·黎庶昌《续古文辞类篡序》"},"usage":"作谓语、定语；指有学问的正直人"},{"id":33323,"word":"直道不容","pinyin":"zhí dào bù róng","abbr":"zdbr","explanation":"按正直的道理行事而不被社会容纳。","source":{"text":"公祖大人直道不容，以致忤时，敝乡士民迄今廑想明德。","book":"明·凌濛初《二刻拍案惊奇》卷四"},"opposite":["八面玲珑"],"usage":"作谓语、定语；用于处事"},{"id":33324,"word":"直道事人","pinyin":"zhí dào shì rén","abbr":"zdsr","explanation":"正直无私地对待人。","source":{"text":"慈明直道事人，有死而已。不义之言，非所敢对。","book":"《隋书·冯慈明传》"},"usage":"作谓语、定语；用于处事"},{"id":33325,"word":"直道守节","pinyin":"zhí dào shǒu jié","abbr":"zdsj","explanation":"节：节操。处事公正，遵守节操。","example":{"text":"我喜欢与～的人交往。"},"usage":"作谓语、定语；指人正直"},{"id":33326,"word":"直道而行","pinyin":"zhí dào ér xíng","abbr":"zdex","explanation":"直道：正路。沿着直的道路走。比喻办事公正。","source":{"text":"斯民也，三代之所以直道而行也。","book":"《论语·卫灵公》"},"example":{"text":"君子寡欲则不役于物，可以～。","book":"宋·司马光《训俭示康》"},"similar":["正道直行"],"usage":"作谓语、宾语、定语；比喻办事公正"},{"id":33327,"word":"相与一口","pinyin":"xiāng yǔ yī kǒu","abbr":"xyyk","explanation":"串通一气，异口同声。","source":{"text":"朋党比周，相与一口，惑主败法，以乱士民。","book":"战国·韩·韩非《韩非子·孤愤》"},"similar":["异口同声"],"usage":"作谓语、定语；用于书面语"},{"id":33328,"word":"相与为一","pinyin":"xiāng yǔ wéi yī","abbr":"xywy","explanation":"相与：相互。相互结合成为一体。","source":{"text":"谓之性情，性情相与为一瞑，情亦性也，谓性已善，奈其情何？","book":"汉·贾谊《过秦论》：“诸侯恐惧，同盟而谋弱秦，不爱珍器重宝肥饶之地，以致天下之士，合从缔交，相与为一。”汉·董仲舒《春秋繁露》卷第十"},"example":{"text":"崔胤本留卫兵，欲以制敕使也，今敕使、卫兵～，将若之何！","book":"宋·司马光《资治通鉴》卷第二百六十二"}},{"id":33329,"word":"相与为命","pinyin":"xiāng yǔ wéi mìng","abbr":"xywm","explanation":"互相依靠着过日子。泛指互相依靠，谁也离不开谁。","source":{"text":"臣无祖母，无以至今日；祖母无臣，无以终余年。母孙二人，更相依为命。","book":"晋·李密《陈情表》"},"example":{"text":"夫君既没，整齐家道，母子～。","book":"宋·陈亮《祭蔡行之母太恭人文》"},"similar":["相依为命"],"usage":"作谓语、定语；用于人或事物"},{"id":33330,"word":"相与有成","pinyin":"xiāng yǔ yǒu chéng","abbr":"xyyc","explanation":"相互交往协助而有所成就。","source":{"text":"公实心任事，念念皆经国长计，郡邑大政，无不毕举。一时良二千石及丞以下，皆卓卓有民誉，故能相与有成。","book":"明·袁宏道《荆州修复北城碑记》"},"example":{"text":"贤弟素有壮志，且自勇略胜人，今又幸得与南官人交契，同往投张公，自可～，实当竭力报国。","book":"清·褚人获《隋唐演义》第八十九回"}},{"id":33331,"word":"相为表里","pinyin":"xiāng wéi biǎo lǐ","abbr":"xwbl","explanation":"表里：外表和内里。指相互间配合为外表和内里。","source":{"text":"彼惩往年之败，将惧而结亲，相为表里。","book":"《三国志·魏志·荀彧传》"},"example":{"text":"明·徐复祚《投梭记·渡江》：“每事与大将军～，眼见得大事可成。”"},"similar":["互为表里"],"usage":"作谓语；用于两者之间等"},{"id":33332,"word":"相习成俗","pinyin":"xiāng xí chéng sú","abbr":"xxcs","explanation":"习：习惯于。相互因袭，而形成一种习俗。","source":{"text":"今虽至愚人，悖戾恣睢，其处断一事，责诘一人，莫不辄曰理者，自宋以来，始相习成俗。","book":"清·戴震《孟子字义疏证·理》"},"similar":["相习成风","相沿成俗"],"usage":"作谓语、定语；用于书面语"},{"id":33333,"word":"相习成风","pinyin":"xiāng xí chéng fēng","abbr":"xxcf","explanation":"习：习惯。指都习惯于某种做法或看法，而成为一种风习。","source":{"text":"各挟所能以媒进，阿谀软熟，相习成风。","book":"宋·高登《高东溪集·蔽主下》"},"example":{"text":"永乐以还，崇台阁体，诸大老倡之，众人应之，～，靡然不觉。","book":"清·沈德潜《说诗晬语》卷二十"},"similar":["相习成俗"],"usage":"作谓语、定语；用于书面语"},{"id":33334,"word":"相互尊重","pinyin":"xiāng hù zūn zhòng","abbr":"xhzz","explanation":"尊重：敬重，重视。指互相重视。","example":{"text":"我们要～。"},"similar":["互相尊重"],"usage":"作谓语；指互相重视","story":["战国时期，齐国宰相晏婴听说贤人越石文被主人卖给别人当奴隶，就花钱将他赎了出来。与他乘车回府，没有给越石文让座，下车时也自己先回家。越石文见晏婴不尊重自己就要离开。晏婴意识到这点，立即请他进屋作得力助手"]},{"id":33335,"word":"相交有年","pinyin":"xiāng jiāo yǒu nián","abbr":"xjyn","explanation":"互相交往已经很多年了。形容交情很深。","example":{"text":"受了屈辱的董福祥，自然心有不甘，回到营里，先找“军师”，正是～，不久才翩然来访的李来中。","book":"高阳《慈禧全传》八十"},"opposite":["一面之缘","点头之交"],"usage":"作谓语、定语；用于交往"},{"id":33336,"word":"相亲相爱","pinyin":"xiāng qīn xiāng ài","abbr":"xqxa","explanation":"形容关系密切，感情深厚。","source":{"text":"与严家大相自幼往往来来，嘻嘻哈哈，同眠同坐，相亲相爱，就是一个人相交，不放下怀。","book":"明·王世贞《鸣凤记·拜谒忠灵》"},"example":{"text":"想起昨天晚上，还是有说有笑，～的何等有趣，今天晚上变了这个情形。","book":"清·吴趼人《情变》第五回"},"similar":["如鱼得水","如胶似漆"],"opposite":["反目成仇"],"usage":"作谓语、定语；用于夫妻间"},{"id":33337,"word":"相亲相近","pinyin":"xiāng qīn xiāng jìn","abbr":"xqxj","explanation":"形容彼此亲爱和好。","source":{"text":"自来自去堂上燕，相亲相近水中鸥。","book":"唐·杜甫《江村》"},"usage":"作谓语、定语；用于交往等"},{"id":33338,"word":"相仿相效","pinyin":"xiāng fǎng xiāng xiào","abbr":"xfxx","explanation":"仿：模仿；效：效法。相互模仿效法。","source":{"text":"遂以芜塞相仿相效，日求所以富强之说，倾诈之谋，攻伐之计。","book":"明·王守仁《传习录》中卷"},"similar":["上行下效"],"usage":"作谓语、定语；用于处事"},{"id":33339,"word":"相体裁衣","pinyin":"xiàng tǐ cái yī","abbr":"xtcy","explanation":"相：视。量体裁衣，比喻根据实际具体情况而做出计划和行事。","source":{"text":"且把他性情伎俩数说一番，看他做得什么事来，然后相体裁衣，把个地位安顿他便了。","book":"清·李渔《巧团圆·认母》"},"example":{"text":"我现在只好～了。"},"similar":["量体裁衣"],"usage":"作谓语、宾语、定语；同“量体裁衣”"},{"id":33340,"word":"相依为命","pinyin":"xiāng yī wéi mìng","abbr":"xywm","explanation":"互相依靠着过日子。泛指互相依靠，谁也离不开谁。","source":{"text":"臣无祖母，无以至今日；祖母无臣，无以终余年。母孙二人，更相依为命。","book":"晋·李密《陈情表》"},"example":{"text":"死而复生的只有这些杂乱的败草。永逝不返的却是我们～的慈母。","book":"郭沫若《棠棣之花》"},"similar":["患难与共","相须为命"],"opposite":["不共戴天","各奔前程"],"usage":"作谓语、定语；用于人或事物","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说自己与祖母形影相吊、相依为命，待伺候祖母后再出来做官"]},{"id":33341,"word":"相倚为命","pinyin":"xiāng yǐ wéi mìng","abbr":"xywm","explanation":"互相依靠着过日子。泛指互相依靠，谁也离不开谁。","source":{"text":"臣无祖母，无以至今日；祖母无臣，无以终余年。母孙二人，更相依为命。","book":"晋·李密《陈情表》"},"example":{"text":"平生～兮，未尝轻去吾亲之傍。","book":"宋·陆游《青阳夫人墓志铭》"},"similar":["相依为命","相须为命"],"usage":"作谓语、定语；用于人或事物"},{"id":33342,"word":"相倚为强","pinyin":"xiāng yǐ wéi qiáng","abbr":"xywq","explanation":"互相倚靠帮助而强大。形容团结一致而有力量。","source":{"text":"正赖汝辈兄弟，相倚为强，庶使天下不敢闚觇王室。","book":"南朝·宋·刘彧《宣旨永嘉王子仁》"},"usage":"作谓语、定语；用于书面语"},{"id":33343,"word":"相克相济","pinyin":"xiāng kè xiāng jì","abbr":"xkxj","explanation":"互相制约而又互相促进。","source":{"text":"其下则水火相克相济之说也。","book":"明·瞿佑《归田诗话·陆浑山火》"},"usage":"作谓语、定语；用于书面语"},{"id":33344,"word":"相关休戚","pinyin":"xiāng guān xiū qī","abbr":"xgxq","explanation":"休：欢乐，吉庆；戚：悲哀，忧愁。忧喜、福祸彼此相关联。形容关系密切，利害相关。","source":{"text":"晋国有忧，未尝不戚，有庆，未尝不怡。……为晋休戚，不背本也。","book":"《国语·周语下》"},"example":{"text":"王亲信重臣，～，期望既厚，责备不得不严。","book":"《清史稿·恭忠亲王奕传》"}},{"id":33345,"word":"相切相磋","pinyin":"xiāng qiē xiāng cuō","abbr":"xqxc","explanation":"指相互研讨。","source":{"text":"先生既息，各就其友，相切相磋，各长其仪。","book":"春秋·齐·管仲《管子·弟子职》"},"similar":["互相切磋"],"usage":"作谓语；用于学术等"},{"id":33346,"word":"相判云泥","pinyin":"xiāng pàn yún ní","abbr":"xpyn","explanation":"判：分辨；云泥：天上的云彩，地上的泥土。高低差别就象天上的云彩和地下的泥土那样悬殊。形容相差极远。","source":{"text":"夫子歘通贵，云泥相望悬。","book":"唐·杜甫《送韦书记赴西安》诗"},"example":{"text":"只因先君见背太早，耳少正训，遂至今日与世兄～。","book":"清·李绿园《歧路灯》第六十三回"},"similar":["云泥之判","天差地别"],"opposite":["彼此彼此"],"usage":"作谓语、定语；用于比喻句"},{"id":33347,"word":"相助为理","pinyin":"xiāng zhù wéi lǐ","abbr":"xzwl","explanation":"理：料理。指帮助料理事物。","source":{"text":"光卧不起，帝即其卧所，抚光腹曰：‘咄咄子陵，不可相助为理邪？’","book":"《后汉书·严光传》"},"example":{"text":"我们是莫逆之交，相约倘若国家有用我辈的日子，凡我同人，俱要出来～的。","book":"清·刘鹗《老残游记》第七回"},"usage":"作谓语、定语；用于书面语"},{"id":33348,"word":"相去万里","pinyin":"xiāng qù wàn lǐ","abbr":"xqwl","explanation":"比喻距离很远或差距极大。","source":{"text":"相去万里，小大不变，方今天下得地之广少矣。","book":"汉·王充《论衡·谈天》"},"example":{"text":"成都与维扬，～地。","book":"唐·岑参《万里桥》"}},{"id":33349,"word":"相去几何","pinyin":"xiāng qù jǐ hé","abbr":"xqjh","explanation":"去：距离；几何：多少。彼此之间相关多远呢？表示差别不大。","source":{"text":"唯之与阿，相去几何？美之与恶，相去何若？","book":"《老子》第二十章"},"example":{"text":"使法而无变政之震荡，则奄奄一息，其于支那～矣。","book":"李群《杀人篇》"},"similar":["相去无几","彼此彼此"],"opposite":["相去天渊","天渊之别"],"usage":"作谓语、定语；用于书面语"},{"id":33350,"word":"相去咫尺","pinyin":"xiāng qù zhǐ chǐ","abbr":"xqzc","explanation":"咫尺：很短的距离。指相差很少。","source":{"text":"相去咫尺，而莫见其形貌。","book":"宋·洪迈《夷坚丙志·饶氏妇》"},"similar":["相去几何","相去无几"],"opposite":["相去天渊","天渊之别","相判云泥"],"usage":"作谓语、定语；用于比较等"},{"id":33351,"word":"相去天渊","pinyin":"xiāng qù tiān yuān","abbr":"xqty","explanation":"天渊：高天和深渊。比喻二者相隔极远，差别极大。","source":{"text":"一敬一肆，相去天渊；一圣一狂，亦判若黑白矣。","book":"清·夏敬渠《野叟曝言》第五十九回"},"similar":["相判云泥","天渊之别"],"opposite":["相去几何"],"usage":"作谓语、定语；用于比较等"},{"id":33352,"word":"相去悬殊","pinyin":"xiāng qù xuán shū","abbr":"xqxs","explanation":"比喻相差很远。","example":{"text":"张家没落后的生活与昔日豪华享受真是～。"}},{"id":33353,"word":"相去无几","pinyin":"xiāng qù wú jǐ","abbr":"xqwj","explanation":"去：距离；无几：没有多少。指二者距离不远或差别不大。","source":{"text":"是今之税与周之税轻重之相去无几也。","book":"宋·苏洵《嘉祐集·衡论下·田制》"},"example":{"text":"二者皆非良法，～也。（宋·苏轼《乞不给散青苗钱斛状》）"},"similar":["相差无几"],"opposite":["天壤之别"],"usage":"作谓语；指彼此没有多大差别"},{"id":33354,"word":"相反相成","pinyin":"xiāng fǎn xiāng chéng","abbr":"xfxc","explanation":"两个看起来是相反的事物，实际上是互相依赖，互相促进的。指相反的东西有同一性。","source":{"text":"仁之与义，敬之与和，相反而皆相成也。","book":"《汉书·艺文志》"},"example":{"text":"“诗教”原是“温柔敦厚”，宋人又以“无邪”为“诗教”；这却不是～的。","book":"朱自清《诗言志辨·序》"},"similar":["相辅相成","相得益彰"],"usage":"作谓语；指相反的东西有同一性"},{"id":33355,"word":"相呴以湿","pinyin":"xiāng xǔ yǐ shī","abbr":"xxys","explanation":"彼此以呼出的气湿润对方。后比喻在困难时以微小的力量，竭力互相帮助。","source":{"text":"呴气相湿。","book":"《庄子·大宗师》：“泉涸，鱼相与处于陆，相呴以湿，相濡以沫。”成玄英疏"},"similar":["相濡以沫","相呴相济","相呴相濡"],"usage":"作谓语、定语、状语；指互相帮助"},{"id":33356,"word":"相呴相济","pinyin":"xiāng xǔ xiāng jì","abbr":"xxxj","explanation":"指互相救助。","source":{"text":"相呴以湿。","book":"语出《庄子·大宗师》"},"similar":["相濡以沫","相濡相呴"],"usage":"作谓语、定语、状语；指互相帮助"},{"id":33357,"word":"相呴相濡","pinyin":"xiāng xū xiāng rú","abbr":"xxxr","explanation":"呴：吐口水；濡：沾湿。原指泉水干竭，鱼儿互相吐口水以沾湿求生。后比喻处于困境之中，互相竭力救助。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。","book":"《庄子·大宗师》"},"similar":["相呴相济","相濡以沫","相呴以湿"],"usage":"作谓语、定语、状语；指互相帮助"},{"id":33358,"word":"相喣以沫","pinyin":"xiāng xǔ yǐ mò","abbr":"xxym","explanation":"喣：吐口水。彼此吐口水来湿润对方。比喻在困境中以微薄的力量竭力互相帮助。","source":{"text":"俭以率物，以为美谈，所谓盗跖分财，取少为让，陆处之鱼，相喣以沫也。","book":"晋·葛洪《抱朴子·诘鲍》"},"example":{"text":"展转无穷，～，盖皆分利之人也。","book":"严复《论沪上创兴女学堂事》"},"similar":["相呴相濡","相濡以沫"],"usage":"作谓语、定语、状语；指互相帮助"},{"id":33359,"word":"相因相生","pinyin":"xiāng yīn xiāng shēng","abbr":"xyxs","explanation":"互相承袭，互相促进。","source":{"text":"夫因朴生文，因拙生巧，相因相生，以至今日。","book":"明·谢榛《四溟诗话》第四卷"},"usage":"作谓语、定语；用于书面语"},{"id":33360,"word":"相失交臂","pinyin":"xiāng shī jiāo bì","abbr":"xsjb","explanation":"比喻机会错过。","source":{"text":"吾终身与汝交一臂而失之。","book":"《庄子·田子方》"},"example":{"text":"梁启超《新中国未来记》第四回：“蒹葭秋水，～。”"},"similar":["交臂失之"],"usage":"作谓语、定语；用于书面语"},{"id":33361,"word":"相女配夫","pinyin":"xiàng nǚ pèi fū","abbr":"xnpf","explanation":"指衡量女儿的情况，选择合适的女婿。","source":{"text":"窃以因材而笃，乃天道之常，相女配夫，实人事之正。","book":"明·周楫《西湖二集·月下老错配本属前缘》"},"example":{"text":"曾朴《孽海花》第14回：“～，真是天下第一难事！何况女公子这样才貌呢！”"},"usage":"作宾语、定语；用于婚姻等"},{"id":33362,"word":"相如病渴","pinyin":"xiāng rú bìng kě","abbr":"xrbk","explanation":"病渴：有消渴的病。司马相如借口有消渴病，不去作官。比喻对作官没有兴趣。","source":{"text":"相如口吃而善著书，常有消渴疾。与卓氏婚，饶于财。其进仕宦，未尝肯与公卿国家之事，称病闲居，不慕官爵。","book":"《史记·司马相如列传》"},"example":{"text":"～年来剧，酿酒倾家畏不供。","book":"宋·陆游《秋思》"}},{"id":33363,"word":"相如题柱","pinyin":"xiāng rú tí zhù","abbr":"xrtz","explanation":"司马相如前往西安途经升仙桥时，在门柱上写下的誓言。形容立志求取功名的行为。","source":{"text":"司马相如初入长安，题市门曰：‘不乘赤车驷马，不过汝下也。’","book":"晋·常璩《华阳国志·蜀志》"},"example":{"text":"～，终军弃繻。","book":"唐·李翰《蒙求》"}},{"id":33364,"word":"相安无事","pinyin":"xiāng ān wú shì","abbr":"xaws","explanation":"相：互相；安：安稳。指彼此相处没有什么争执或冲突，还过得去。","source":{"text":"古者君民间相安无事者，固不得无吏，而为员不多。","book":"宋·邓牧《伯牙琴·吏道》"},"example":{"text":"难民母子～地在史太太家里住了两天两夜。","book":"郭沫若《金刚坡下》"},"similar":["风平浪静","天下太平"],"opposite":["动荡不安","多灾多难"],"usage":"作谓语、定语、状语；指和平共处"},{"id":33365,"word":"相安相受","pinyin":"xiāng ān xiāng shòu","abbr":"xaxs","explanation":"指互相帮助，使彼此安居。"},{"id":33366,"word":"相对如宾","pinyin":"xiāng duì rú bīn","abbr":"xdrb","explanation":"形容夫妻互相尊敬，象对待宾客一样。","source":{"text":"臼季使过冀，见冀缺耨，其妻馌之，敬，相待如宾。","book":"《左传·僖公三十三年》"},"similar":["相敬如宾","相待如宾"],"usage":"作谓语、定语、状语；用于夫妻间"},{"id":33367,"word":"相对无言","pinyin":"xiāng duì wú yán","abbr":"xdwy","explanation":"指彼此相对说不出话来。","source":{"text":"夜来幽梦忽还乡，小轩窗，正梳妆，相顾无言，唯有泪千行。","book":"宋·苏轼《江城子·乙卯正月二十日夜记梦》词"},"example":{"text":"蓁的官员只有～，不敢回答一语。","book":"清·李宝嘉《官场现形记》第二十回"},"usage":"作谓语、定语；用于交往"},{"id":33368,"word":"相差无几","pinyin":"xiāng chā wú jǐ","abbr":"xcwj","explanation":"彼此没有多大差别。","source":{"text":"唯之与阿，相去几何？美之与恶，相去何若？","book":"春秋·楚·李耳《老子》"},"example":{"text":"这两个方案～，大同小异。"},"similar":["大同小异","不相上下"],"opposite":["截然不同","天差地别"],"usage":"作谓语；指彼此没有多大差别"},{"id":33369,"word":"相帅成风","pinyin":"xiāng shuài chéng fēng","abbr":"xscf","explanation":"层层影响成为风气。帅，同“率”。","source":{"text":"臣恐自今以往，相帅成风，虽直言之科，亦无敢以直言进者。","book":"宋·苏轼《拟进士对御试策引状》"},"usage":"作谓语、定语；用于书面语"},{"id":33370,"word":"相庄如宾","pinyin":"xiāng zhuāng rú bīn","abbr":"xzrb","explanation":"相处如待宾客。形容夫妻互相尊敬。","source":{"text":"苟儿心之所好，虽相庄如宾，性与之洽也。","book":"清·余怀《班桥杂记·丽品》"},"similar":["相敬如宾","相待如宾","相对如宾"],"usage":"作谓语、定语；用于夫妻间"},{"id":33371,"word":"相庆弹冠","pinyin":"xiāng qìng tán guān","abbr":"xqdg","explanation":"弹冠：掸去帽子上的灰尘，准备做官。指官场中一人当了官或升了官，同伙就互相庆贺将有官可做。","source":{"text":"一日无促，则三子者，可以弹冠而相庆矣。","book":"汉书·王吉传》：“吉与贡禹为友，世称‘王阳在位，贡禹弹冠。’”宋·苏洵《管仲论》"},"example":{"text":"喜入朝～，应须颂当年蓄怨，把遗忠弃节，图绘凌烟。","book":"明·王世贞《鸣凤记·忠良会边》"},"similar":["弹冠相庆"],"usage":"作谓语、状语；指坏人得意的样子","story":["汉宣帝时，琅琊人王吉和贡禹是很好的朋友，贡禹多次被免职，王吉在官场也很不得志。汉元帝时，王吉被召去当谏议大夫，贡禹听到这个消息很高兴，就把自己的官帽取出，弹去灰尘，准备戴用。果然没多久贡禹也被任命为谏议大夫"]},{"id":33372,"word":"相应不理","pinyin":"xiāng yìng bù lǐ","abbr":"xybl","explanation":"应：回应。指对别人的劝告、要求等一概不予理睬。","source":{"text":"这是调虎离山之计，冯当然不会中计，来一个相应不理。","book":"丁中江《北洋军阀史话》一○五"},"usage":"作谓语、定语；用于处事"},{"id":33373,"word":"相形失色","pinyin":"xiāng xíng shī sè","abbr":"xxss","explanation":"失色：失去光彩。和同类的事物相比较，显得大大不如。","source":{"text":"仙人掌终于锻炼出现在这样一种使普通植物为之相形失色的倔强性格和卓特风貌。","book":"秦牧《在仙人掌丛生的地方》"},"similar":["相形见绌"],"usage":"作谓语、宾语；指不能对比"},{"id":33374,"word":"相形见拙","pinyin":"xiāng xíng jiàn zhuō","abbr":"xxjz","explanation":"和同类的事物相比较，显出不足。同“相形见绌”。","source":{"text":"皮簧剧在戏剧构成上也占着超越的地位，但把来和近代小说与近代话剧比较，由于内容的陈旧，是不免相形见拙的。","book":"郭沫若《蒲剑集·“民族形式”商兑》"},"similar":["相形见绌"],"usage":"作谓语、定语；用于人或事"},{"id":33375,"word":"相形见绌","pinyin":"xiāng xíng jiàn chù","abbr":"xxjc","explanation":"形：对照；绌：不够，不足。和同类的事物相比较，显出不足。","source":{"text":"又见娄朴，同窗共砚，今日相形见绌。","book":"清·李绿园《歧路灯》第十四回"},"example":{"text":"他一个部曹，戴了个水晶顶子去当会办，比着那红蓝色的顶子，未免～。","book":"清·吴趼人《二十年目睹之怪现状》第九十回"},"similar":["相形失色","黯然失色"],"opposite":["出人头地","鹤立鸡群"],"usage":"作谓语、定语；用于人或事"},{"id":33376,"word":"相待如宾","pinyin":"xiāng dài rú bīn","abbr":"xdrb","explanation":"相处如待宾客。形容夫妻互相尊敬。","source":{"text":"初，臼季使，过冀，见冀缺耨，其妻馌之，敬，相待如宾。","book":"《左传·僖公三十三年》"},"example":{"text":"年老之后，与妻相见，皆正衣冠，～。","book":"唐·房玄龄《晋书·何曾传》"},"similar":["相敬如宾","相对如宾","相庄如宾"],"usage":"作谓语、定语；用于夫妻间","story":["春秋时期，晋国大夫胥臣奉命出使，路过冀地，遇见一农夫正在田间除草，他妻子把午饭送到田头，恭恭敬敬双手捧给丈夫。丈夫庄重地接过进食，妻子立在一旁等他吃完。胥臣被他们夫妻相敬如宾的举动所感动，就把他推荐给晋文公"]},{"id":33377,"word":"相待而成","pinyin":"xiāng dài ér chéng","abbr":"xdec","explanation":"互相辅助以取得成功。","source":{"text":"故经谓君为元首，臣为股肱，明其一体，相待而成也。","book":"《汉书·魏相丙吉传赞》"},"usage":"作谓语、定语；用于书面语"},{"id":33378,"word":"相得恨晚","pinyin":"xiāng dé hèn wǎn","abbr":"xdhw","explanation":"认识太晚了。形容新交的朋友十分投合。","source":{"text":"二人纵饮甚欢，相得恨晚。","book":"清·蒲松龄《聊斋志异·黄英》"},"similar":["相知恨晚","恨相见晚","恨相知晚"],"usage":"作谓语、定语；指彼此投合"},{"id":33379,"word":"相得无间","pinyin":"xiāng dé wú jiàn","abbr":"xdwj","explanation":"间：隔阂。形容相互之间相处得很融洽，没有一点隔阂。","source":{"text":"一旦相遇，遂不觉胶之投漆，相得无间，宜其倾倒之至也。","book":"清·赵翼《瓯北诗话·韩昌黎诗》"},"example":{"text":"此皆阴阳五行之所为，外之盈天地之间，内之备于吾身，外内～而养道备。","book":"清·戴震《孟子字义疏证》卷上"},"similar":["亲密无间"],"usage":"作谓语、定语、状语；用于交往等"},{"id":33380,"word":"相得甚欢","pinyin":"xiāng dé shèn huān","abbr":"xdsh","explanation":"得：投合。形容双方相处融洽，非常快乐。","source":{"text":"两人相为引重，其游如父子然，相得甚欢。","book":"《史记·魏其武安侯列传》"},"example":{"text":"逾岁，择吉迎女归，夫妻～。","book":"清·蒲松龄《聊斋志异·江城》"},"usage":"作谓语、定语；指人际交往","story":["五代后唐时期，河南太守张全义勤劳节俭，善于领导军队安抚百姓，经常鼓励农民发展生产，军粮充足，与另一守将李罕之相得甚欢。李罕之贪污成性，经常向张全义要钱要粮，李罕之忍无可忍，最后出兵消灭了李罕之全军"]},{"id":33381,"word":"相得益彰","pinyin":"xiāng dé yì zhāng","abbr":"xdyz","explanation":"相行：互相配合、映衬；益：更加；彰：显著。指两个人或两件事物互相配合，双方的能力和作用更能显示出来。","source":{"text":"聚精会神，相得益章（彰）。","book":"《史记·伯夷列传》：“伯夷、叔齐虽贤，得夫子而名益彰。”汉·王褒《圣主得贤臣颂》"},"example":{"text":"由于它的内容太卓越了，朴拙的形式并不造成不良影响；相反的，却使它们～。","book":"秦牧《茅台·花雕瓶子》"},"similar":["相辅相成"],"opposite":["势不两立","两败俱伤"],"usage":"作谓语、定语；指相互配合"},{"id":33382,"word":"相得益章","pinyin":"xiāng dé yì zhāng","abbr":"xdyz","explanation":"指互相配合、补充、更能显出各自的长处。","source":{"text":"明明在朝，穆穆列布，聚精会神，相得益章。","book":"汉·王褒《圣主得贤臣颂》"},"similar":["相得益彰"],"usage":"作谓语、定语；指相互配合"},{"id":33383,"word":"相忍为国","pinyin":"xiāng rěn wèi guó","abbr":"xrwg","explanation":"为了国家的利益而作一定的让步。","source":{"text":"鲁以相忍为国也，忍其外不忍其内，焉用之。","book":"《左传·昭公元年》"},"example":{"text":"我们除向国民党提出抗议和善后条件外，仍然～。","book":"毛泽东《评国民党十一中全会和三届二次国民参政会》"},"similar":["委曲求全"],"opposite":["针锋相对"],"usage":"作谓语、定语；指顾全大局"},{"id":33384,"word":"相忘形骸","pinyin":"xiāng wàng xíng hái","abbr":"xwxh","explanation":"指彼此不拘形迹，无所顾忌。","source":{"text":"答云：‘小梅事我年余，相忘形骸，我已婉求之矣。’","book":"清·蒲松龄《聊斋志异·小梅》"},"usage":"作谓语；用于书面语"},{"id":33385,"word":"相忘江湖","pinyin":"xiāng wàng jiāng hú","abbr":"xwjh","explanation":"鱼在江湖里彼此相忘。形容彼此由于没有急切的需要而相忘，各不关心。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。","book":"《庄子·大宗师》"},"example":{"text":"见面唯唯循礼如对大宾，退如游鱼～。","book":"二月河《乾隆皇帝》十七"},"usage":"作谓语、定语；用于书面语"},{"id":33386,"word":"相恃为命","pinyin":"xiāng shì wéi mìng","abbr":"xswm","explanation":"互相依靠着过日子。泛指互相依靠，谁也离不开谁。","source":{"text":"臣无祖母，无以至今日；祖母无臣，无以终余年。母孙二人，更相依为命。","book":"晋·李密《陈情表》"},"example":{"text":"赓与母氏，～。","book":"宋·陆游《留夫人墓志铭》"}},{"id":33387,"word":"相惊伯有","pinyin":"xiāng jīng bó yǒu","abbr":"xjby","explanation":"伯有：春秋时郑国大夫良霄的字，相传他死后鬼魂作祟。形容无缘无故自相惊扰。","source":{"text":"郑人相惊以伯有，曰：‘伯有至矣。’则皆走，不知所往。","book":"春秋·鲁·左丘明《左传·昭公七年》"},"example":{"text":"请不要～了。"},"similar":["自相惊扰"],"usage":"作谓语；指自相惊扰","story":["春秋时期，郑国大夫良霄字伯有，他为人奢侈又刚愎自用，嗜酒如命，与大臣子皙矛盾很深，被子皙的侄子子驷杀死，变成一个厉鬼。人们听说伯有来了吓得撒腿就跑。子产立了公孙泄和伯有的儿子良止后，厉鬼就立刻安息了"]},{"id":33388,"word":"相持不下","pinyin":"xiāng chí bù xià","abbr":"xcbx","explanation":"持：对抗。双方对立，彼此相持，不肯让步。","source":{"text":"燕、齐相持而不下，则刘、项之权未有所分也。","book":"《史记·淮阴侯列传》"},"example":{"text":"直隶议员籍忠寅，主张守旧，湖北议员刘成禺，主张维新，彼此～。","book":"蔡东藩、许厪父《民国通俗演义》第八十回"},"similar":["势均力敌","难解难分"],"opposite":["迎刃而解"],"usage":"作谓语、定语、补语；指各不相让"},{"id":33389,"word":"相提并论","pinyin":"xiāng tí bìng lùn","abbr":"xtbl","explanation":"相提：相对照；并：齐。把不同的人或不同的事放在一起谈论或看待。","source":{"text":"相提并论，是自明扬主上之过。","book":"《史记·魏其武安侯列传》"},"example":{"text":"二者～，则陈张两公之捐躯殉难，均有所迫而然也。","book":"清·淮阴百一居士《壶天录》"},"similar":["混为一谈","同日而语"],"opposite":["一分为二"],"usage":"作谓语、宾语；指同等对待"},{"id":33390,"word":"相提而论","pinyin":"xiāng tí ér lùn","abbr":"xtel","explanation":"把不同的人或不同的事放在一起谈论或看待。","source":{"text":"相提而论，是自明扬主上之过。","book":"西汉·司马迁《史记·魏其武安侯列传》"},"similar":["相提并论"],"usage":"作谓语、宾语；指同等对待"},{"id":33391,"word":"相敬如宾","pinyin":"xiāng jìng rú bīn","abbr":"xjrb","explanation":"形容夫妻互相尊敬，象对待宾客一样。","source":{"text":"臼季使过冀，见冀缺耨，其妻饁之，敬，相待如宾。","book":"《左传·僖公三十三年》"},"example":{"text":"夫耕于前，妻耘于后，同甘共苦，～。","book":"明·李昌祺《剪灯余话·鸾鸾传》"},"similar":["相亲相爱","互敬互爱"],"opposite":["敬而远之"],"usage":"作谓语、定语、状语；用于夫妻间","story":["春秋时期，晋国大夫胥臣奉命出使，路过冀地，遇见一农夫正在田间除草，他妻子把午饭送到田头，恭恭敬敬双手捧给丈夫。丈夫庄重地接过进食，妻子立在一旁等他吃完。胥臣被他们夫妻相敬如宾的举动所感动，就把他推荐给晋文公"]},{"id":33392,"word":"相时度力","pinyin":"xiàng shí duó lì","abbr":"xsdl","explanation":"相：察看。观察时机，估算力量。","source":{"text":"君子救时虽切，必相时度力，以致其用。","book":"唐·司空图《题东汉传后》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":33393,"word":"相时而动","pinyin":"xiàng shí ér dòng","abbr":"xsed","explanation":"观察时机，针对具体情况采取行动。","source":{"text":"许无刑而伐之，服而舍之，度德而处之，量力而行之，相时而动，无累后人，可谓知礼矣。","book":"《左传·隐公十一年》"},"example":{"text":"显和具陈宜杜门晦迹，～，孝武深纳焉。","book":"《周书·宇文神举传》"},"similar":["相机而行"],"usage":"作谓语、定语；用于处事"},{"id":33394,"word":"相映成趣","pinyin":"xiāng yìng chéng qù","abbr":"xycq","explanation":"映：对照，映衬。相互衬托着，显得很有趣味，很有意思。","source":{"text":"写冯云卿等三人作公债而失败，那不过点缀点缀，取其与吴赵两巨头相映成趣，觉得热闹些。","book":"朱自清《“子夜”》"},"example":{"text":"草木浓绿一片，点缀着三两朵红花，～。"},"similar":["相映生辉","妙趣横生"],"usage":"作谓语；指两者事物之间"},{"id":33395,"word":"相机而动","pinyin":"xiàng jī ér dòng","abbr":"xjed","explanation":"观察时机，看到适当机会立即行动。","source":{"text":"宜刚宜柔，相机而动。","book":"明·冯梦龙《东周列国志》第69回"},"example":{"text":"等到了那里，你们可以～。"},"similar":["相机行事"],"usage":"作谓语、状语；同“见机行事”"},{"id":33396,"word":"相机而行","pinyin":"xiàng jī ér xíng","abbr":"xjex","explanation":"相机：观察当时情况。看当时的具体情况而决定自己的行动。","source":{"text":"某当与主公同往，相机而行，自有良策。","book":"明·罗贯中《三国演义》第39回"},"example":{"text":"～，大概以坚守为主，必贼人实有间可乘。","book":"清·夏敬渠《野叟曝言》第104回"},"similar":["相机行事"],"usage":"作谓语；同“见机行事”"},{"id":33397,"word":"相机而言","pinyin":"xiàng jī ér yán","abbr":"xjey","explanation":"观察适当时机而说话。","source":{"text":"倘若吾王问及，不免相机而言。","book":"明·汤显祖《南柯记·象谴》"},"usage":"作谓语、宾语；用于处事"},{"id":33398,"word":"相机行事","pinyin":"xiàng jī xíng shì","abbr":"xjxs","explanation":"相：察看；机：机会。观察时机，看具体情况灵活办事。","source":{"text":"如此依计，往花荣军前，密传将令，相机行事。","book":"明·施耐庵《水浒全传》第九十二回"},"example":{"text":"遣黄绾之大同，～。","book":"《明史·张璁传》"},"similar":["相机而动","见机行事","看风使舵"],"opposite":["生搬硬套"],"usage":"作谓语、宾语；用于人或事"},{"id":33399,"word":"相机观变","pinyin":"xiàng jī guān biàn","abbr":"xjgb","explanation":"等待时机，观察变化。","source":{"text":"元帅屯兵于郝山矶，相机观变，可以万全。","book":"明·冯梦龙《东周列国志》第六十回"},"usage":"作谓语、定语；用于处事"},{"id":33400,"word":"相沿成习","pinyin":"xiāng yán chéng xí","abbr":"xycx","explanation":"依照相传下来的一套慢慢地成了习惯。","source":{"text":"这虽有假公济私之嫌，相沿成习，变做军机章京的一种特权。","book":"高阳《慈禧前传》"},"example":{"text":"这条风俗就是～下来的。"},"similar":["相沿成俗"],"usage":"作谓语；指成为习惯"},{"id":33401,"word":"相沿成例","pinyin":"xiāng yán chéng lì","abbr":"xycl","explanation":"依照相传下来的一套慢慢地成了示例。","source":{"text":"其实四川的大员，无论到任卸任，出境入境，夹带私货是相沿成例的了。","book":"清·吴趼人《二十年目睹之怪现状》第七十一回"},"example":{"text":"这一名不符实的情况～，是出于国际上一个罕见的错误。","book":"高阳《草莽英雄》第一章"}},{"id":33402,"word":"相沿成俗","pinyin":"xiāng yán chéng sú","abbr":"xycs","explanation":"因袭某种做法传下来，形成风俗习惯。","source":{"text":"乃为角黍投于江中以祭之，系以彩线，恐为蛟龙所撄食也，又龙舟竞渡之戏，亦因拯救屈原而起，至今自楚至吴，相沿成俗。","book":"明·冯梦龙《东周列国志》第九十三回"},"example":{"text":"剃头一事，本国～。今大兵所到，剃武不剃文，剃兵不剃民，尔等毋得不遵法度，自行剃之。","book":"凌力《少年天子》第一章"},"similar":["相习成俗"],"usage":"作谓语、定语；用于书面语"},{"id":33403,"word":"相激相荡","pinyin":"xiāng jī xiāng dàng","abbr":"xjxd","explanation":"激：冲击；荡：震荡。形容事物之间相互冲击、震荡。","source":{"text":"内容以成都城外一个小乡镇为主要背景，具体写出那时内地社会上两种恶势力的相激相荡。","book":"李劼人《死水微澜》前记"},"example":{"text":"切忌煎迫太甚，～，演成两败俱伤之局，既非中央之本心，复违德等之始愿。","book":"毛泽东《朱德等给何应钦、白崇禧的电报》"},"usage":"作谓语、定语；用于书面语"},{"id":33404,"word":"相濡以沫","pinyin":"xiāng rú yǐ mò","abbr":"xrym","explanation":"濡：沾湿；沫：唾沫。泉水干了，鱼吐沫互相润湿。比喻一同在困难的处境里，用微薄的力量互相帮助。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。","book":"《庄子·大宗师》"},"example":{"text":"或低首下心，求其民之～。","book":"清·梁启超《外债平议》"},"similar":["同甘共苦","生死与共"],"opposite":["自私自利"],"usage":"作谓语、定语、宾语、状语；指互相帮助","story":["战国时期，庄子家贫经常吃了上顿没下顿，妻子叫他外出借粮食，他去找监河侯借粮。监河侯许诺秋后再借，庄子说这是远水不解近渴就回家。妻子让他再去别的地方借，他说要像车辙里的鲫鱼一样相濡以沫过日子，妻子只好偷偷地流泪"]},{"id":33405,"word":"相濡以泽","pinyin":"xiāng rú yǐ zé","abbr":"xryz","explanation":"濡：沾湿；泽：唾液或汗水。水干了，鱼吐沫互相润湿。比喻在困难的处境中用微薄的力量互相帮助。","source":{"text":"嘘枯养瘠，相濡以泽。","book":"清·曾国藩《广东嘉应州知州刘君事状》"},"similar":["相濡以沫","相濡相呴"],"usage":"作谓语、定语、宾语、状语；指互相帮助"},{"id":33406,"word":"相濡相呴","pinyin":"xiāng rú xiāng xǔ","abbr":"xrxx","explanation":"濡：湿润；呴：吐口水。互相吐口水，湿润对方。比喻在困境中相互救助。","source":{"text":"泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。","book":"战国·宋·庄周《庄子·大宗师》"},"example":{"text":"～尚可活，轹釜何曾厌求索。","book":"金·元好问《女儿山避兵送李长源归关中》诗"},"similar":["相呴相濡","相濡以沫"],"usage":"作谓语、定语、状语；指互相帮助","story":["战国时期，庄子家贫经常吃了上顿没下顿，妻子叫他外出借粮食，他去找监河侯借粮。监河侯许诺秋后再借，庄子说这是远水不解近渴就回家。妻子让他再去别的地方借，他说要像车辙里的鲫鱼一样相濡以沫过日子，妻子只好偷偷地流泪"]},{"id":33407,"word":"相灭相生","pinyin":"xiāng miè xiāng shēng","abbr":"xmxs","explanation":"指金、木、水、火、土五种物质的互相生发以互相克制的关系。后引申为一般物质之间的辩证关系。","source":{"text":"其言虽殊，辟犹水火，相灭亦相生也；仁之与义，敬之与和，相反而皆相成也。","book":"《汉书·艺文志》"},"example":{"text":"同业相感，因有感业，～，由是故有，众生颠倒。","book":"《楞严经》"},"similar":["相生相克"],"usage":"作谓语、定语；用于书面语"},{"id":33408,"word":"相煎何急","pinyin":"xiāng jiān hé jí","abbr":"xjhj","explanation":"煎：煎熬。煎煮得为什么那样急。比喻兄弟间自相残害。","source":{"text":"文帝尝令东阿王七步中作诗，不成者行大法。应声便为诗曰：‘煮豆持作羹，漉菽以为汁。萁在釜下然，豆在釜中泣。本是同根生，相煎何太急’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"千古奇冤，江南一叶，同室操戈，～。","book":"周恩来因皖南事变在《新华日报》上题词"},"similar":["煮豆燃萁","同室操戈"],"opposite":["和睦相处"],"usage":"作谓语、定语；指兄弟间自相残害","story":["三国时期，魏文帝曹丕很妒忌兄弟曹植的才华，想找一个借口把他杀死，命令他在七步之内作出一首诗，否则处死。曹植作诗：“煮豆持作羹，漉菽以为汁，萁在釜下然，豆在釜中泣。本是同根生，相煎何太急。”曹丕只好贬他去镇守边疆"]},{"id":33409,"word":"相煎太急","pinyin":"xiāng jiān tài jí","abbr":"xjtj","explanation":"煎：煮。煮得为什么那样急。比喻兄弟间自相残害。","source":{"text":"煮豆持作羹，漉菽以为汁；萁在釜下燃，豆在釜中泣；本自同根生，相煎何太急！","book":"三国·魏·曹植《七步诗》"},"example":{"text":"现在正是公司危机之时，每个部门都要团结一致，何必～呢？"},"similar":["相煎何急"],"usage":"作宾语、定语；用于内部争斗","story":["三国时期，魏文帝曹丕很妒忌兄弟曹植的才华，想找一个借口把他杀死，命令他在七步之内作出一首诗，否则处死。曹植作诗：“煮豆持作羹，漉菽以为汁，萁在釜下然，豆在釜中泣。本是同根生，相煎何太急。”曹丕只好贬他去镇守边疆"]},{"id":33410,"word":"相煎益急","pinyin":"xiāng jiān yì jí","abbr":"xjyj","explanation":"煎：煎熬。煎煮得为什么那样急。比喻兄弟间自相残害。","source":{"text":"文帝尝令东阿王七步中作诗，不成者行大法。应声便为诗曰：‘煮豆持作羹，漉菽以为汁。萁在釜下然，豆在釜中泣。本是同根生，相煎何太急’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"原来都是弟兄，而且现正“～”，像曹操的儿子阿丕和阿植似的。","book":"鲁迅《华盖集·咬文嚼字》"}},{"id":33411,"word":"相生相克","pinyin":"xiāng shēng xiāng kè","abbr":"xsxk","explanation":"指金、木、水、火、土五种物质的互相生发以互相克制的关系。后引申为一般物质之间的辩证关系。","source":{"text":"便有五行金木，相生相克。","book":"宋·释普济《五灯会元》卷四十六"},"example":{"text":"五色旗按金、木、水、火、土，～。","book":"清·钱彩《说岳全传》第七十九回"},"usage":"作谓语、定语、定语；用于书面语"},{"id":33412,"word":"相生相成","pinyin":"xiāng shēng xiāng chéng","abbr":"xsxc","explanation":"互相转化，互相促进。","source":{"text":"律生而为度量权衡，制器以尽天下之变，是岂可以常法而论其相生相成之义乎！","book":"宋·陈亮《量度权衡策》"},"usage":"作谓语、定语；用于书面语"},{"id":33413,"word":"相知恨晚","pinyin":"xiāng zhī hèn wǎn","abbr":"xzhw","explanation":"相知：相互了解。认识太晚了。形容新交的朋友十分投合。","source":{"text":"两人相为引重，共游如父子然。相得欢甚，无厌，恨相知晚也。","book":"西汉·司马迁《史记·魏其武安侯列传》"},"example":{"text":"我们都有～之感。"},"similar":["相见恨晚"],"usage":"作谓语、定语；指彼此投合"},{"id":33414,"word":"相知有素","pinyin":"xiāng zhī yǒu sù","abbr":"xzys","explanation":"素：向来。指一向互相了解的好朋友。","source":{"text":"他人不必论，就是段芝泉等，随从总统多年，相知有素，今日亦未免生疑。","book":"蔡东藩、许廑父《民国通俗演义》第四六回"},"usage":"作谓语；指一向互相了解的好朋友"},{"id":33415,"word":"相类相从","pinyin":"xiāng lèi xiāng cóng","abbr":"xlxc","explanation":"同类的事物能相互感应。","source":{"text":"物遇相类相从，此龙吟云起，虎啸风生，道之交感，非类不可。","book":"宋·张君房《云笈七签》卷六十六"},"usage":"作谓语、定语；用于书面语"},{"id":33416,"word":"相继而至","pinyin":"xiāng jì ér zhì","abbr":"xjez","explanation":"接连不断地到来。","source":{"text":"涪诸军及大将军费祎自成都相继而至，魏军退还，如平本策。","book":"《三国志·蜀志·王平传》"},"example":{"text":"以至天亡汉祚，兵散梁郊，降将败军，～，卿即便回马首，径返龟阴。","book":"蔡东藩《五代史演义》第四十九回"},"similar":["接踵而至"],"usage":"作谓语、定语；用于书面语"},{"id":33417,"word":"相见以诚","pinyin":"xiāng jiàn yǐ chéng","abbr":"xjyc","explanation":"以真心诚意相待。","source":{"text":"与吏民相见以诚，屏绝请讬，政声大起。","book":"《清史稿·贾朴传》"},"example":{"text":"元洪不敏，惟与诸君子～，合力同心，共匡大局。","book":"丁中江《北洋军阀史话》一○二"},"similar":["赤诚相见"],"usage":"作谓语、定语；用于交往等"},{"id":33418,"word":"相见恨晚","pinyin":"xiāng jiàn hèn wǎn","abbr":"xjhw","explanation":"恨：遗憾。只恨相见得太晚。形容一见如故，意气极其相投。","source":{"text":"天子召见三人，谓曰：‘公等皆安在？何相见之晚也。’","book":"《史记·平津侯主父列传》"},"example":{"text":"女界伟人，久震耳鼓，真～了。","book":"清·萧山湘灵子《轩亭冤》第五出"},"similar":["相知恨晚","相识恨晚"],"opposite":["白头如新"],"usage":"作谓语、宾语、定语；指彼此投合","story":["汉武帝时期，齐国人主父偃饱学多才，游历于诸侯之间，没有得到任用。他穷困潦倒时只好上书给汉武帝，得到汉武帝的赏识。汉武帝召集他与徐乐、严安三人议事，大有相见恨晚之感，主父偃建议汉武帝推行推恩令以巩固政权"]},{"id":33419,"word":"相见无日","pinyin":"xiāng jiàn wú rì","abbr":"xjwr","explanation":"没有再见面的日子了。","source":{"text":"绍兴二年冬，虞之子并甫过辉，辉曰：‘与君相见无日矣。’","book":"宋·洪迈《夷坚甲志·倪辉方技》"},"similar":["后会无期"],"opposite":["后会有期"],"usage":"作谓语、定语；用于书面语"},{"id":33420,"word":"相视失色","pinyin":"xiāng shì shī sè","abbr":"xsss","explanation":"彼此相看，变了脸色。多形容惊慌、惊诧的情状。","source":{"text":"时良弼、姚锡光在座，相视失色。","book":"钱基博《吴禄贞传》"},"similar":["相顾失色"],"usage":"作谓语；指惊讶"},{"id":33421,"word":"相视无言","pinyin":"xiāng shì wú yán","abbr":"xswy","explanation":"指彼此相对说不出话来。","source":{"text":"引刘至一厅，朱紫数十，有相识者，有已殁者，各相视无言。","book":"宋·李昉《太平广记》卷三百六十三"},"example":{"text":"这样一想，便慢慢的回过脸来，握着秋谷的手，含情带愧，～。","book":"清·张春帆《九尾龟》第三十三回"}},{"id":33422,"word":"相视而笑","pinyin":"xiāng shì ér xiào","abbr":"xsex","explanation":"双方互相看着，发出会心的微笑。形容二者情合意洽的情态。","source":{"text":"子祀、子舆、子犁、子来四人相与语曰：‘孰能以无为首，以生为脊，以死为尻，孰知生死存亡之一体者，吾与之友矣。’四人相视而笑，莫逆于心，遂相与为友。","book":"《庄子·大宗师》"},"example":{"text":"两人屈指算了一下，～。","book":"钱钟书《围城》第九章"},"usage":"作谓语、定语；用于交往等"},{"id":33423,"word":"相视而笑，莫逆于心","pinyin":"xiāng shì ér xiào，mò nì yú xīn","abbr":"xsexmnyx","explanation":"莫逆：彼此情投意合，非常相好。形容彼此间友谊深厚，无所违逆于心。","source":{"text":"子祀、子舆、子犁、子来四人相与语曰：‘孰能以无为首，以生为脊，以死为尻，孰知生死存亡之一体者，吾与之友矣。’四人相视而笑，莫逆于心，遂相与为友。","book":"《庄子·大宗师》"},"example":{"text":"只要摊出我的杂感来，便可以做他们的“蓝谱”，“～”了。","book":"鲁迅《而已集·“意表之外”》"},"similar":["相视莫逆"],"usage":"作分句；指朋友深交"},{"id":33424,"word":"相视莫逆","pinyin":"xiāng shì mò nì","abbr":"xsmn","explanation":"莫逆：彼此情投意合，非常相好。形容彼此间友谊深厚，无所违逆于心。","source":{"text":"战国·宋·庄周《庄子·大宗师》：“子祀、子舆、子犁、子来四人相与语曰：‘……以生为脊，以死为尻，孰知生死存亡之一体者，吾与之友矣。’四人相视而笑，莫逆于心，遂相与为友。"},"example":{"text":"公卿大夫～，如出一辙。","book":"清·侯方域《南省试策五》"},"similar":["相视而笑，莫逆于心"],"usage":"作谓语、定语；指朋友等"},{"id":33425,"word":"相貌堂堂","pinyin":"xiàng mào táng táng","abbr":"xmtt","explanation":"形容长相端正，身材魁梧。","source":{"text":"第二要相貌堂堂，威仪出众。","book":"明·罗贯中《三国演义》第五十二回"},"example":{"text":"但见伍尚志威风凛凛，～。","book":"清·钱彩《说岳全传》第五十一回"},"similar":["仪表堂堂"],"usage":"作谓语、定语、状语；指人的仪表"},{"id":33426,"word":"相辅相成","pinyin":"xiāng fǔ xiāng chéng","abbr":"xfxc","explanation":"辅：辅助。指两件事物互相配合，互相辅助，缺一不可。","source":{"text":"二派所用手段虽有不同，然何尝不相辅相成。","book":"清·梁启超《初归国演说辞》"},"example":{"text":"学习和复习，是用以掌握知识和巩固知识的两个方面，～，缺一不可。"},"similar":["相得益彰","相反相成"],"usage":"作谓语、定语；指事物相互依存"},{"id":33427,"word":"相辅而成","pinyin":"xiāng fǔ ér chéng","abbr":"xfec","explanation":"辅：辅助。指两件事物互相配合，互相辅助，缺一不可。","source":{"text":"有你的勇猛进取，就不能无我的审慎周详，这就叫做相辅而成。","book":"清·颐琐《黄绣球》第七回"},"example":{"text":"文王的大德，武王的功绩，～，～！","book":"老舍《新时代的旧悲剧》"},"similar":["相辅相成"],"usage":"作谓语、定语、宾语；指事物相互依存"},{"id":33428,"word":"相辅而行","pinyin":"xiāng fǔ ér xíng","abbr":"xfex","explanation":"互相协助进行或互相配合使用。","source":{"text":"诹日者与推命者必相辅而行，而后两者之说始得无蔽。","book":"清·张岱《历书眼序》"},"example":{"text":"与革命之建设，必～，犹人之两足，鸟之双翼也。","book":"孙中山《心理建设》第六章"},"similar":["相辅相成"],"usage":"作谓语；指互相配合"},{"id":33429,"word":"相逐心生","pinyin":"xiàng zhú xīn shēng","abbr":"xzxs","explanation":"相：相貌；逐：随着。其貌不扬的人，会因他的德才而使人对他的相貌产生好感。","source":{"text":"相逐心生相术真。心能生相，原牛理也。","book":"宋·陈抟《神相全编》二"},"example":{"text":"夫相者，有心无相，～；有相无心，相随心往。","book":"明·兰陵笑笑生《金瓶梅词话》第二十九回"}},{"id":33430,"word":"相逢恨晚","pinyin":"xiāng féng hèn wǎn","abbr":"xfhw","explanation":"形容一同如故，意气极其相投。见“相见恨晚”。","source":{"text":"天子召见三人，谓曰：‘公等皆安在？何相见之晚也。’","book":"《史记·平津侯主父列传》"},"example":{"text":"～，人谁道、早有轻离轻折。","book":"宋·吴儆《念奴娇》词"},"similar":["相见恨晚"],"usage":"作谓语、宾语、定语；指彼此投合"},{"id":33431,"word":"相逢狭路","pinyin":"xiāng féng xiá lù","abbr":"xfxl","explanation":"在很窄的路上相遇，没有地方可让。后多用来指仇人相见，彼此都不肯轻易放过。","source":{"text":"相逢狭路间，道隘不容车。","book":"汉·乐府诗《相逢行》"},"example":{"text":"非是我人前卖弄忒装，人前卖弄忒装乔，也只是～难推调。","book":"明·屠隆《彩毫记·乘醉骑驴》"},"similar":["狭路相逢"],"usage":"作宾语、定语；用于书面语"},{"id":33432,"word":"相门出相","pinyin":"xiàng mén chū xiàng","abbr":"xmcx","explanation":"宰相门里还出宰相。旧指名门子弟能继承父兄事业。","source":{"text":"文闻将门必有将，相门必有相。","book":"《史记·孟尝君列传》"},"example":{"text":"元·刘时中《上高监司》：“～前人奖，官上加官后代昌。”"},"similar":["相门有相"],"usage":"作宾语、定语；指子承父业"},{"id":33433,"word":"相门有相","pinyin":"xiàng mén yǒu xiàng","abbr":"xmyx","explanation":"宰相门里还出宰相。旧指名门子弟能继承父兄事业。","source":{"text":"文闻将门必有将，相门必有相。","book":"《史记·孟尝君列传》"},"example":{"text":"上目送之久，谓朱异曰：“可谓相门有相。”","book":"《南史·王训传》"},"similar":["将门有将"],"usage":"作宾语、定语；指子承父业"},{"id":33434,"word":"相门有相，将门有将","pinyin":"xiàng mén yǒu xiàng，jiàng mén yǒu jiàng","abbr":"xmyxjmyj","explanation":"相：宰相、丞相、相国。指宰相和大将之家的子孙能够继承父业，有将相的才能。","source":{"text":"文闻将门必有将，相门必有相。","book":"西汉·司马迁《史记·孟尝君列传》"},"example":{"text":"谚曰：‘～。’斯不唯其性，盖言习之所得也。","book":"《魏书·李彪传》"},"similar":["相门有相","将门有将"],"usage":"作宾语、定语；可分开使用"},{"id":33435,"word":"相门洒扫","pinyin":"xiàng mén sǎ sǎo","abbr":"xmss","explanation":"相：宰相、丞相、相国。在宰相门前扫地。形容干求有术。","source":{"text":"魏勃少时，欲求见齐相曹参，家贫无以自通，乃常独早夜扫齐相舍人门外。","book":"西汉·司马迁《史记·齐悼惠王世家》"},"example":{"text":"世路揶揄诚有鬼，～岂无人。","book":"清·钱谦益《吉水公总宪诣阙》诗"},"usage":"作宾语、定语；用于处事","story":["西汉时期，魏勃年轻时想求见齐相曹参，因为家里很穷，无钱去买通曹参的门人，只有靠自己想办法。于是他经常很早起来到曹参相府门口去洒水扫地，曹相府里的人以为魏勃是相府的小人，就让他进入相府，后来他终于见到曹参，达到了他的目的"]},{"id":33436,"word":"相门相种","pinyin":"xiàng mén xiàng zhǒng","abbr":"xmxz","explanation":"相：宰相、丞相、相国。指宰相的子孙能够继承父业，有将相的才能。","source":{"text":"多应是相门相种，可惜不做厮儿。","book":"明·高明《琵琶记·牛氏规奴》"},"similar":["相门有相"],"usage":"作宾语、定语；用于书面语"},{"id":33437,"word":"相须为命","pinyin":"xiāng xū wéi mìng","abbr":"xxwm","explanation":"互相依靠着过日子。泛指互相依靠，谁也离不开谁。","source":{"text":"臣无祖母，无以至今日；祖母无臣，无以终余年。母孙二人，更相依为命。","book":"晋·李密《陈情表》"},"example":{"text":"而直方以进士及第，母子二人～。","book":"·苏轼《乞将合转一官与李直方酬奖状》"},"similar":["相依为命"],"usage":"作谓语、定语；用于人或事物"},{"id":33438,"word":"相须而行","pinyin":"xiāng xū ér xíng","abbr":"xxex","explanation":"互相依存而行动一致。","source":{"text":"夫天之与帝，帝之与人，犹头之与足，相须而行也。","book":"《后汉书·刘陶传》"},"usage":"作谓语；用于书面语"},{"id":33439,"word":"相顾失色","pinyin":"xiāng gù shī sè","abbr":"xgss","explanation":"顾：看；失色：因惊恐而变了脸色。你看我，我看你，吓得脸色都变了。","source":{"text":"使于吴越，及乘舟泛海，风涛暴起，楫师仆从，皆相顾失色。","book":"《旧五代史·周书·段希尧传》"},"example":{"text":"五人～，悔饮其酒。","book":"宋·张君房《云笈七签》卷一百一十三"},"similar":["相视失色"],"usage":"作谓语；指惊讶","story":["五代时期，段希尧为人勤恳，为政勤勉，吃苦耐劳，德行很好。他从后唐时一个录事参军做到后晋的右谏大夫。他被派到吴越办事，乘船在大海航行时，天色大变，狂风大作，随从相顾失色，唯有他镇定自若"]},{"id":33440,"word":"相顾无言","pinyin":"xiāng gù wú yán","abbr":"xgwy","explanation":"指彼此相对说不出话来。","source":{"text":"夜来幽梦忽还乡，小轩窗，正梳妆，相顾无言，唯有泪千行。","book":"宋·苏轼《江城子·乙卯正月二十日夜记梦》词"},"example":{"text":"群臣～，都觉得这是必须慎重考虑的一件事。","book":"高阳《王昭君》第十五章"},"similar":["相对无言"],"usage":"作谓语、定语；用于处事"},{"id":33441,"word":"相风使帆","pinyin":"xiàng fēng shǐ fán","abbr":"xfsf","explanation":"比喻做事随机应变。","source":{"text":"看风使帆，正是随波逐浪。","book":"宋·释道元《五灯会元·圆通禅师》"},"similar":["见风使舵"],"usage":"作谓语、宾语、定语；用于处事"},{"id":33442,"word":"相鼠之刺","pinyin":"xiàng shǔ zhī cì","abbr":"xszc","explanation":"相：视。旧指人须知廉耻，要讲礼义。","source":{"text":"相鼠有皮，人而无仪；人而无仪，不死何为！","book":"《诗经·鄘风·相鼠》"},"example":{"text":"人惟有礼，庶可免～；若徒能言，夫何异禽兽之心。","book":"清·程允升《幼学琼林·鸟兽》"},"similar":["相鼠有皮"],"usage":"作宾语、定语；用于劝诫人"},{"id":33443,"word":"相鼠有皮","pinyin":"xiàng shǔ yǒu pí","abbr":"xsyp","explanation":"相：视。看看老鼠尚且还有皮。旧指人须知廉耻，要讲礼义。","source":{"text":"相鼠有皮，人而无仪（通“义”）；人而无仪，不死何为！","book":"《诗经·鄘风·相鼠》"},"similar":["相鼠之刺"],"usage":"作宾语、定语；用于劝诫人"},{"id":33444,"word":"省事宁人","pinyin":"shěng shì níng rén","abbr":"ssnr","explanation":"减少事务，使人安宁。","source":{"text":"[御制]诗云：‘锦缆无劳列画艭，桡自受倚船窗，勤民不惮周行远，早又观风向浙江。’此诗尤可仰见省事宁人之意。","book":"清·王士禛《居易录谈》卷上"},"usage":"作谓语、定语；用于处事"},{"id":33445,"word":"省俗观风","pinyin":"xǐng sú guān fēng","abbr":"ssgf","explanation":"省：察看。观察各地民情风俗。","source":{"text":"省俗观风，爰屈幽朔，吊人问罪，无俟再驾。","book":"《隋书·炀帝纪》"},"similar":["省方观俗","省方观民"],"usage":"作宾语、定语；用于书面语"},{"id":33446,"word":"省刑薄敛","pinyin":"shèng xíng bó liǎn","abbr":"sxbl","explanation":"减省刑法，薄收赋税。","source":{"text":"勤于国政，省刑薄敛，养士训武，修复关隘。","book":"明·冯梦龙《东周列国志》第七十七回"},"similar":["省役薄赋"],"usage":"作谓语、宾语、定语；用于治政等"},{"id":33447,"word":"省吃俭用","pinyin":"shěng chī jiǎn yòng","abbr":"scjy","explanation":"省、俭：节约，不浪费。形容生活简朴，吃用节俭。","source":{"text":"虽不及得盛三时，却是省吃俭用，勤心苦胝，衣食尽不缺了。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"example":{"text":"虞华轩在家，～，积起几两银子。","book":"清·吴敬梓《儒林外史》第四十七回"},"similar":["节衣缩食","克勤克俭","省吃细用"],"opposite":["铺张浪费","大手大脚"],"usage":"作谓语、定语、状语；指节俭"},{"id":33448,"word":"省吃细用","pinyin":"shěng chī xì yòng","abbr":"scxy","explanation":"形容生活简朴，吃用节俭。同“省吃俭用”。","source":{"text":"省吃细用勤劳动，好吃懒做不是人。","book":"《中国歌谣资料·香花蜡烛迎红军》"},"similar":["省吃俭用"],"opposite":["大手大脚"],"usage":"作谓语、定语、状语；指节俭"},{"id":33449,"word":"省吃节用","pinyin":"shěng chī jié yòng","abbr":"scjy","explanation":"省：节约。形容生活非常节俭。","source":{"text":"贫困山区的农民尽管眼下大都少吃缺穿，但孩子既然到大地方去念书，家长们就是咬着牙关省吃节用，也要给他们做几件见人衣裳。","book":"路遥《平凡的世界》第一卷第一章"},"similar":["省吃俭用","节衣缩食","省吃细用"],"opposite":["铺张浪费","大手大脚"],"usage":"作谓语、定语、状语；指节俭"},{"id":33450,"word":"省役薄赋","pinyin":"shěng yì bó fù","abbr":"sybf","explanation":"减轻徭役和赋税。指施行仁政。","source":{"text":"省役薄赋，百姓殷昌。","book":"三国·魏·曹植《汉景帝赞》"},"similar":["省刑薄敛"],"usage":"作谓语、宾语、定语；用于治政等"},{"id":33451,"word":"省愆寡过","pinyin":"shěng qiān guǎ guò","abbr":"sqgg","explanation":"指减少过错。","source":{"text":"要知早结一日，少拖一人，皆可省愆寡过，复何惮而不为乎？","book":"清·林则徐《通饬各属命盗各案赶紧审解札》"},"usage":"作谓语、定语；用于处事"},{"id":33452,"word":"省方观俗","pinyin":"xǐng fāng guān sú","abbr":"sfgs","explanation":"省：察看。观察各地民情风俗。","source":{"text":"先王以省方观民设教。","book":"《周易·观》"},"similar":["省方观民","省俗观风"],"usage":"作宾语、定语；用于书面语"},{"id":33453,"word":"省方观民","pinyin":"xǐng fāng guān mín","abbr":"sfgm","explanation":"省：察看。观察各地民情风俗。","source":{"text":"先王以省方观民设教。","book":"《周易·观》"},"similar":["省方观俗","省俗观风"],"usage":"作宾语、定语；用于书面语"},{"id":33454,"word":"省欲去奢","pinyin":"shèng yù qù shē","abbr":"syqs","explanation":"免掉过分的欲念，去除奢侈。","source":{"text":"又闻宫中立黄老浮屠之祠，此道清虚，贵尚无为，好生恶死，省欲去奢。","book":"汉·襄楷《复上书》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":33455,"word":"省油灯","pinyin":"shěng yóu dēng","abbr":"syd","explanation":"比喻老实、不惹是生非的人。","source":{"text":"他家的那口子可不是～。"},"example":{"text":"他家的那口子可不是～"},"usage":"作宾语、定语；用于方言，多用于否定"},{"id":33456,"word":"省烦从简","pinyin":"shěng fán cóng jiǎn","abbr":"sfcj","explanation":"省去烦杂的手续而采取简单的方法。","source":{"text":"穷奢竭费谓之忠义，省烦从简呼为薄俗。","book":"《晋书·虞预传》"},"similar":["删繁就简"],"usage":"作谓语、定语；用于处事"},{"id":33457,"word":"省用足财","pinyin":"shèng yòng zú cái","abbr":"syzc","explanation":"减省费用，积聚财富。","source":{"text":"轻关易道，通商宽农。懋穑劝分，省用足财。","book":"《国语·晋语四》"},"usage":"作谓语、定语；用于处事"},{"id":33458,"word":"省衣节食","pinyin":"shěng yī jié shí","abbr":"syjs","explanation":"犹言节衣缩食。指生活节俭。","source":{"text":"劝世人，只须得省衣节食，早早的送你爹娘入土，这就是造福之门。","book":"清·徐大椿《洄溪道情·劝葬亲》"},"similar":["节衣缩食"],"opposite":["穷奢极欲"],"usage":"作主语、谓语、宾语、定语、状语；用于生活"},{"id":33459,"word":"省身克己","pinyin":"xǐng shēn kè jǐ","abbr":"sskj","explanation":"检查自身过失，克制自己非分之想。","source":{"text":"吾党各以己见立说，学者稍见本体，即好为径超顿悟之说，无复有省身克己之功。","book":"明·钱德洪《王文成公〈大学问〉跋》"},"usage":"作谓语、定语；用于处事等"},{"id":33460,"word":"眄视指使","pinyin":"miǎn shǐ zhǐ shǐ","abbr":"mszs","explanation":"形容骄傲的神态。","source":{"text":"冯几据杖，眄视指使，则厮役之人至矣。","book":"《战国策·燕策一》"},"usage":"作谓语、定语；指骄傲的神态"},{"id":33461,"word":"眇乎其小","pinyin":"miǎo hū qí xiǎo","abbr":"mhqx","explanation":"眇：微小。形容非常微小。","source":{"text":"眇乎小哉！所以属于人也。","book":"战国·宋·庄周《庄子·德充符》"},"example":{"text":"战国·宋·庄周《庄子·德充符》：“眇乎小哉！所以属于人也。”"},"usage":"作谓语、定语；指微小"},{"id":33462,"word":"眇乎小哉","pinyin":"miǎo hū xiǎo zāi","abbr":"mhxz","explanation":"眇：微小；乎、哉：感叹语气词。感叹十分微小。","source":{"text":"眇乎小哉！所以属于人也。謷乎大哉，独成其天!","book":"《庄子·德充符》"}},{"id":33463,"word":"眇小丈夫","pinyin":"miǎo xiǎo zhàng fū","abbr":"mxzf","explanation":"眇：微小。指身材矮小瘦弱的男人。也指见识短浅的男人。","source":{"text":"赵人闻孟尝君贤，出观之，皆笑曰：‘始以薛公为魁然也，今视之，乃眇小丈夫耳。’","book":"《史记·孟尝君传》"},"example":{"text":"是何眇小丈夫，乃能直言若此？","book":"《清史稿·李慎修传》"}},{"id":33464,"word":"眇眇之身","pinyin":"miǎo miǎo zhī shēn","abbr":"mmzs","explanation":"眇眇：微小。指一个人的身躯和力量是微不足道的。","source":{"text":"遗诏曰：朕获保宗庙，以眇眇之身托于天下君王之上，二十有余年矣。","book":"《汉书·文帝纪》"},"example":{"text":"发是时也，加富尔以～，兼任总理大臣、外务大臣、军务大臣之各要职。","book":"清·梁启超《意大利建国三杰传》第十六节"}},{"id":33465,"word":"眇眇忽忽","pinyin":"miǎo miǎo hū hū","abbr":"mmhh","explanation":"眇眇：辽远；忽忽：印象模糊。隐隐约约，看不清楚。","source":{"text":"眇眇忽忽，若神仙之仿佛。","book":"汉·司马相如《子虚赋》"},"example":{"text":"或云幽幽冥冥莫识其精，～罔知所出。","book":"《南海寄归内法传》卷一"},"similar":["隐隐约约"],"usage":"作谓语、定语、状语；指模糊"},{"id":33466,"word":"眈眈虎视","pinyin":"dān dān hǔ shì","abbr":"ddhs","explanation":"眈眈：注视的样子。像老虎那样凶狠地盯着。","source":{"text":"渔阳突骑，燕歌壮气。赳赳元戎，眈眈虎视。","book":"《旧唐书·张仲武传》"},"example":{"text":"一时工厂林立，销数日增，使～的邻邦的日本人曾瞠目地惊赞不置。","book":"郭沫若《盲肠炎·一个伟大的教训》"},"similar":["虎视眈眈"],"usage":"作定语、状语；形容心怀不善"},{"id":33467,"word":"眈眈逐逐","pinyin":"dān dān zhú zhú","abbr":"ddzz","explanation":"贪婪注视，急于攫取的样子。","source":{"text":"虎视耽耽，其欲逐逐。","book":"《周易·颐》"},"example":{"text":"顾吾窃睨夫～于吾旁者，为斯巴达还魂者若干国，为雅典还魂者若干国。","book":"清·梁启超《斯巴达小志》"},"usage":"作定语；指人贪婪的神态"},{"id":33468,"word":"眉下添眉","pinyin":"méi xià tiān méi","abbr":"mxtm","explanation":"在眉毛下面再画一道眉。比喻多余重复。","source":{"text":"则第一章释‘明明德’，第二章释‘新民’，是本来已释过了，何必又释‘本末’？无乃眉下添眉耶？","book":"明·李贽《四书评·大学》"},"similar":["床上安床","屋下架屋"],"usage":"作宾语、定语、状语；用于处事"},{"id":33469,"word":"眉低眼慢","pinyin":"méi dī yǎn màn","abbr":"mdym","explanation":"形容精神散漫，懒得动弹的样子。","source":{"text":"覆恩王，近日新荷眉低眼慢，乳大腹高，出来不得。","book":"明·冯梦龙《警世通言》卷七"},"example":{"text":"自此以后，严娘子便觉得～，乳涨腹高，有了身孕。","book":"明·凌濛初《初刻拍案惊奇》卷十三"}},{"id":33470,"word":"眉南面北","pinyin":"méi nán miàn běi","abbr":"mnmb","explanation":"形容相处不合，彼此各不照面。","source":{"text":"你见了这李廉使都眉南面北，多管是那相公每饥嗔的这饱喜，则为我无过犯难投宰相机。","book":"元·无名氏《延安府》第二折"},"example":{"text":"你休等得我恩断意绝，～，恁时节水尽鹅飞。","book":"张晓风《河飞记》"},"usage":"作谓语、定语；用于书面语"},{"id":33471,"word":"眉头一皱，计上心来","pinyin":"méi tóu yī zhòu，jì shàng xīn lái","abbr":"mtyzjsxl","explanation":"形容略一思考，猛然想出了一个主意。","source":{"text":"韩厥为何自刎了，必然走了赵氏孤儿，怎生是好？眉头一皱，计上心来！","book":"元·纪君祥《赵氏孤儿》第二折"},"example":{"text":"《三国演义》上所谓“～”，我们普通说话所谓“让我想一想”，就是人在脑子中运用概念以作判断和推理的工夫。","book":"毛泽东《实践论》"},"similar":["眉头一蹙，计上心来"],"usage":"作谓语、分句；指猛然想出了一个主意"},{"id":33472,"word":"眉头一纵，计上心来","pinyin":"méi tóu yī zòng，jì shàng xīn lái","abbr":"mtyzjsxl","explanation":"形容一下子想出了一个计策。","source":{"text":"王四只管叫苦，寻思道：‘银子不打紧，这封回书却怎生好！正不知被甚人拿去了？’眉头一纵，计上心来。","book":"明·施耐庵《水浒传》第二回"},"similar":["眉头一皱，计上心来"],"usage":"作谓语、分句；指猛然想出了一个主意"},{"id":33473,"word":"眉头一蹙，计上心来","pinyin":"méi tóu yī cù，jì shàng xīn lái","abbr":"mtycjsxl","explanation":"形容一下子想出了一个计策。","source":{"text":"素姐见打了龙氏，知道往庙里去不成的，眉头一蹙，计上心来。","book":"清·西周生《醒世姻缘传》第56回"},"example":{"text":"清·西周生《醒世姻缘传》第56回：“素姐见打了龙氏，知道往庙里去不成的，～。”"},"similar":["眉头一纵，计上心来"],"usage":"作谓语、分句；指猛然想出了一个主意"},{"id":33474,"word":"眉头不伸","pinyin":"méi tóu bù shēn","abbr":"mtbs","explanation":"形容忧愁烦闷的样子。","source":{"text":"郭崇韬眉头不伸，常为租庸惜财用，陛下虽欲有作，其可得乎？","book":"《新唐书·郭崇韬传》"}},{"id":33475,"word":"眉头不展","pinyin":"méi tóu bù zhǎn","abbr":"mtbz","explanation":"展：舒展。紧皱着眉头，愁闷不乐的样子。形容忧愁烦闷的样子。","source":{"text":"郭崇韬眉头不伸，常为租庸惜财用，陛下虽欲有作，其可得乎？","book":"《新唐书·郭崇韬传》"},"example":{"text":"宋江～，面带忧容。","book":"明·施耐庵《水浒全传》第五十回"}},{"id":33476,"word":"眉头眼后","pinyin":"méi tóu yǎn hòu","abbr":"mtyh","explanation":"指眉眼间的神色。","source":{"text":"是日那里还有心想看春会？只个个撺哄赵娘子，看他眉头眼后罢了。","book":"明·凌濛初《初刻拍案惊奇》第29卷"},"similar":["眉头眼尾","眉头眼脑"],"usage":"作宾语；指人的眼色"},{"id":33477,"word":"眉头眼尾","pinyin":"méi tóu yǎn wěi","abbr":"mtyw","explanation":"指眉眼间的神色。","source":{"text":"乡原是个无骨肋底人，东倒西擂，东边去取奉人，西边去周全人，看人眉头眼尾。","book":"宋·朱熹《朱子语类》第61卷"},"similar":["眉头眼后"],"usage":"作宾语；指人的眼色"},{"id":33478,"word":"眉头眼脑","pinyin":"méi tóu yǎn nǎo","abbr":"mtyn","explanation":"指眉眼间的神色。","source":{"text":"思量也胜，看个眉头眼脑。","book":"宋·周紫芝《感皇恩》词"},"similar":["眉头眼后","眉尖眼尾"],"usage":"作宾语；指人的眼色"},{"id":33479,"word":"眉尖眼尾","pinyin":"méi jiān yǎn wěi","abbr":"mjyw","explanation":"指眉眼间的神色。","source":{"text":"一剪艳波横，两点愁山重。收拾眉尖眼尾情，作个鸳鸯梦。","book":"宋·石孝友《卜算子》"},"similar":["眉头眼脑"],"usage":"作宾语；指人的眼色"},{"id":33480,"word":"眉开眼笑","pinyin":"méi kāi yǎn xiào","abbr":"mkyx","explanation":"眉头舒展，眼含笑意。形容高兴愉快的样子。","source":{"text":"彼见昨日惊魂魂魄，今日眉花眼笑。","book":"元·王实甫《西厢记》第二本第二折"},"example":{"text":"等他吃足了烟，他坐起来，～。","book":"清·彭养鸥《黑籍冤魂》第三回"},"similar":["笑逐颜开","眉花眼笑"],"opposite":["愁眉不展"],"usage":"作谓语、定语、状语；形容高兴的样子"},{"id":33481,"word":"眉扬气吐","pinyin":"méi yáng qì tǔ","abbr":"myqt","explanation":"扬起眉头，吐出怨气。形容摆脱了长期受压状态后高兴痛快的样子。","source":{"text":"何惜阶前盈尺之地，不使白扬眉吐气，激昂青云耶？","book":"唐·李白《与韩荆州书》"}},{"id":33482,"word":"眉扬目展","pinyin":"méi yáng mù zhǎn","abbr":"mymz","explanation":"展：伸张。形容神采飞扬，精神振奋。","source":{"text":"同一话也，以尖新出之，则令人眉扬目展，有如闻所未闻。","book":"清·李渔《闲情偶寄·宾白》"},"similar":["眉舒目展"],"opposite":["心灰意冷"],"usage":"作谓语、定语、状语；用于人高兴时"},{"id":33483,"word":"眉来眼去","pinyin":"méi lái yǎn qù","abbr":"mlyq","explanation":"形容用眉眼传情。","source":{"text":"落日苍茫，风才定，片帆无力。还记得眉来眼去，水光山色。","book":"宋·辛弃疾《满江红·赣州席上呈太守陈季陵侍郎》"},"example":{"text":"日渐情熟，～，情不能已。","book":"明·冯梦龙《警世通言》卷二"},"similar":["暗送秋波"],"usage":"作谓语、定语、状语；指眉目传情"},{"id":33484,"word":"眉来语去","pinyin":"méi lái yù qù","abbr":"mlyq","explanation":"眉目传情，话语示意。多形容男女之间的传情达意。","source":{"text":"天竺见他来，顺稍儿到讲台，眉来语去情儿在。","book":"明·汤显祖《南柯记·决婿》"},"similar":["眉来眼去"],"usage":"作谓语、定语、状语；指眉目传情"},{"id":33485,"word":"眉梢眼角","pinyin":"méi shāo yǎn jiǎo","abbr":"msyj","explanation":"眉梢：眉毛的末尾部分；眼角：上下眼睑的接合处。形容眉眼含情示意的神态。","source":{"text":"若说是有情，如何眉梢眼角，不见些些光景，只是恁等板板地往来，有何了结。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"example":{"text":"芳官吃得两腮胭脂一般，～，添了许多丰韵，身子图不得，便睡在袭人身上。","book":"清·曹雪芹《红楼梦》第六十三回"},"similar":["眼角眉梢"],"usage":"作宾语、定语；用于人"},{"id":33486,"word":"眉欢眼笑","pinyin":"méi huān yǎn xiào","abbr":"mhyx","explanation":"形容非常兴奋、高兴。","source":{"text":"到次日，与了潘姥姥一件葱白绫袄儿，两双缎子鞋面，二百文钱。把婆子欢喜的眉欢眼笑，过这边来，拿与金莲瞧。","book":"明·兰陵笑笑生《金瓶梅词话》第三十三回"},"example":{"text":"炀帝与萧后看了，喜得～，拍手称好。","book":"清·褚人获《隋唐演义》第三十一回"},"similar":["眉飞眼笑","眉花眼笑"],"opposite":["愁眉苦脸"],"usage":"作谓语、状语；指非常高兴"},{"id":33487,"word":"眉毛胡子一把抓","pinyin":"méi máo hú zi yī bǎ zhuā","abbr":"mmhzybz","explanation":"俗语。比喻做事不分轻重缓急。","example":{"text":"我们办事不能～。"},"similar":["主次不分"],"usage":"作宾语、定语；指主次不分"},{"id":33488,"word":"眉清目朗","pinyin":"méi qīng mù lǎng","abbr":"mqml","explanation":"眉：眉毛；清：清新；目：眼睛。形容人容貌清秀俊美。","source":{"text":"真乃是眉清目朗，可怎生流落在村庄深巷。","book":"元·郑光祖《伊尹耕莘》第一折"},"similar":["眉清目秀"],"usage":"作谓语、定语、补语；指人的外貌"},{"id":33489,"word":"眉清目秀","pinyin":"méi qīng mù xiù","abbr":"mqmx","explanation":"眉、目：眉毛和眼睛，泛指容貌。形容人容貌清秀不俗气。","source":{"text":"有个小孩唤做按住，今年三岁，生得眉清目秀，是好一个孩儿也。","book":"元·无名氏《合同文学》第一折"},"example":{"text":"元·无名氏《合同文学》第一折：“有个小孩唤做按住，今年三岁，生得眉清目秀，是好一个孩儿也。”"},"similar":["眉目如画","眉清目朗"],"opposite":["其貌不扬"],"usage":"作谓语、定语、状语；指人的外貌"},{"id":33490,"word":"眉留目乱","pinyin":"méi liú mù luàn","abbr":"mlml","explanation":"神色不宁的情状。","source":{"text":"空使我意沉吟，眉留目乱羞难道。","book":"元·施惠《幽闺记·招商谐偶》"},"usage":"作定语、状语；用于人的神色"},{"id":33491,"word":"眉目不清","pinyin":"méi mù bù qīng","abbr":"mmbq","explanation":"眉目：指事情的条理、状况。比喻事情的状况不清楚。","source":{"text":"交代不明，眉目不清，也是常见的缺点。","book":"《人民日报》1951.6.6"},"usage":"作主语、宾语、定语；用于文章等"},{"id":33492,"word":"眉目传情","pinyin":"méi mù chuán qíng","abbr":"mmcq","explanation":"用眼色传递情意。多用于男女之间。","source":{"text":"只你那眉眼传情未了时。","book":"元·王实甫《西厢记》第三本第一折"},"example":{"text":"因而乘机百般撩拨，～。","book":"清·曹雪芹《红楼梦》第六十四回"},"similar":["眉眼传情"],"usage":"作谓语、宾语；用于男女之间"},{"id":33493,"word":"眉目分明","pinyin":"méi mù fēn míng","abbr":"mmfm","explanation":"眉目：眉毛和眼睛，泛指容貌。容貌清楚。形容面容端正清晰。","source":{"text":"万里长空，云彩丝儿都不见，素常雾腾腾的山头，显得眉目分明。","book":"杨朔《泰山极顶》"},"opposite":["眉目不清"],"usage":"作定语、状语、谓语；用于总体面目"},{"id":33494,"word":"眉目如画","pinyin":"méi mù rú huà","abbr":"mmrh","explanation":"形容容貌端正秀丽。","source":{"text":"援自还京师，数被进见。为人明须发，眉目如画。","book":"《后汉书·马援传》"},"example":{"text":"帝姿貌端华，～。","book":"《南史·宋顺帝纪》"},"similar":["眉清目秀","眉眼如画"],"opposite":["其貌不扬"],"usage":"作谓语、定语；形容容貌端正秀丽"},{"id":33495,"word":"眉眼传情","pinyin":"méi yǎn chuán qíng","abbr":"mycq","explanation":"用眼色传递情意。多用于男女之间。","source":{"text":"只你那眉眼传情未了时。","book":"元·王实甫《西厢记》第三本第一折"},"example":{"text":"清·李宝嘉《官场现形记》第36回：“面孔虽然生得肥胖，却是～，异常流动。”"},"similar":["眉目传情"],"usage":"作谓语、宾语；同“眉目传情”"},{"id":33496,"word":"眉眼如画","pinyin":"méi yǎn rú huà","abbr":"myrh","explanation":"形容容貌端正秀丽。","source":{"text":"姆抱幼子立侧，眉眼如画，发漆黑，肌肉玉雪可念，殿中君也。","book":"唐·韩愈《殿中少监马君墓志》"},"similar":["眉目如画"],"usage":"作谓语、定语；形容容貌端正秀丽"},{"id":33497,"word":"眉眼高低","pinyin":"méi yǎn gāo dī","abbr":"mygd","explanation":"脸上的表情变化。泛指为人处世的方法。","source":{"text":"只是跟着奶奶，我们学些眉眼高低，出入上下，大小的事儿，也得见识见识。","book":"清·曹雪芹《红楼梦》第27回"},"similar":["眉高眼低"],"usage":"作宾语、定语；指为人处世的方法"},{"id":33498,"word":"眉睫之内","pinyin":"méi jié zhī nèi","abbr":"mjzn","explanation":"形容近在眼前。","source":{"text":"远在八荒之外，近在眉睫之内。","book":"《列子·仲尼》"},"similar":["迫在眉睫","眉睫之间"],"opposite":["海角天涯"],"usage":"作宾语、定语；形容近在眼前"},{"id":33499,"word":"眉睫之利","pinyin":"méi jié zhī lì","abbr":"mjzl","explanation":"眼前微小的利益。","source":{"text":"图眉睫之利，不顾冲要。","book":"清·龚自珍《乙丙之际塾议第二十》"},"usage":"作主语、宾语；指小利"},{"id":33500,"word":"眉睫之祸","pinyin":"méi jié zhī huò","abbr":"mjzh","explanation":"眉睫：眉毛和眼睫毛，比喻近在眼前。近在眼前的祸患。","source":{"text":"不去眉睫之祸，而慕贲、育之死。","book":"战国·韩·韩非《韩非子·用人》"},"example":{"text":"我们必须先解决～。"},"similar":["祸在眉睫"],"usage":"作宾语；指眼前的祸患"},{"id":33501,"word":"眉睫之间","pinyin":"méi jié zhī jiān","abbr":"mjzj","explanation":"就在眉毛和睫毛之间。比喻极近的距离。","source":{"text":"向吾见若眉睫之间，吾因以得汝矣。","book":"战国·宋·庄周《庄子·庚桑楚》"},"similar":["眉睫之内"],"usage":"作宾语、定语；形容近在眼前"},{"id":33502,"word":"眉笑眼开","pinyin":"méi xiào yǎn kāi","abbr":"mxyk","explanation":"眉头舒展，眼含笑意。形容高兴愉快的样子。","source":{"text":"彼见昨日惊魂魂魄，今日眉花眼笑。","book":"元·王实甫《西厢记》第二本第二折"},"example":{"text":"大家一起喊起来，围绕著这位～的老人。","book":"曲波《林海雪原》第八章"}},{"id":33503,"word":"眉舒目展","pinyin":"méi shū mù zhǎn","abbr":"msmz","explanation":"展：伸张。形容神采飞扬，精神振奋。","source":{"text":"暗夜中见光明眉舒目展，三天前子弟兵回到平川。","book":"京剧《平原作战》第三场"},"similar":["眉扬目展"],"usage":"作谓语、定语、状语；用于人高兴时"},{"id":33504,"word":"眉花眼笑","pinyin":"méi huā yǎn xiào","abbr":"mhyx","explanation":"形容非常高兴、兴奋的样子。","source":{"text":"孙悟空在旁闻讲，喜得他抓耳挠腮，眉花眼笑。","book":"明·吴承恩《西游记》第二回"},"example":{"text":"他听了人家的祝贺语，～地答谢。","book":"叶圣陶《一个朋友》"},"similar":["眉飞眼笑","眉欢眼笑"],"opposite":["愁眉苦脸"],"usage":"作定语、状语；指非常高兴"},{"id":33505,"word":"眉语目笑","pinyin":"méi yǔ mù xiào","abbr":"mymx","explanation":"指以眉目传情。","source":{"text":"今朝何幸聚多娇，偏称是粒面乌纱年少，记歌娘子，与周郎眉语目笑。","book":"清·袁于令《双莺传》第七折"},"similar":["眉目传情"],"usage":"作谓语；指以眉目传情"},{"id":33506,"word":"眉飞目舞","pinyin":"méi fēi mù wǔ","abbr":"mfmw","explanation":"形容人非常得意兴奋的样子。","source":{"text":"岑公子听了，不禁眉飞目舞。","book":"清·陈朗《雪月梅传》卷二十三"},"example":{"text":"说到此际，韦扬隐～。","book":"清·俞万春《荡寇志》第一百二十一回"},"similar":["眉飞色舞","眉飞色悦"],"opposite":["愁眉苦脸"],"usage":"作谓语、状语、补语；形容人得意的神态"},{"id":33507,"word":"眉飞眼笑","pinyin":"méi fēi yǎn xiào","abbr":"mfyx","explanation":"形容非常高兴。","source":{"text":"他眉飞眼笑，高兴地跳着，大声喊道：‘解放啦！’","book":"柳青《创业史》第一部"},"example":{"text":"这事让他～。"},"similar":["眉花眼笑"],"opposite":["愁眉苦脸"],"usage":"作谓语、定语；指高兴"},{"id":33508,"word":"眉飞色悦","pinyin":"méi fēi sè yuè","abbr":"mfsy","explanation":"形容人非常得意兴奋的样子。","source":{"text":"大伙儿聚在一块把希望叙说，激情满怀，眉飞色悦，打倒了‘四人帮’，心里多么快活！","book":"臧克家《迎春辞》"},"similar":["眉飞色舞"],"usage":"作谓语、状语、补语；形容人得意的神态"},{"id":33509,"word":"眉飞色舞","pinyin":"méi fēi sè wǔ","abbr":"mfsw","explanation":"色：脸色。形容人得意兴奋的样子。","source":{"text":"余荩臣一听‘明保’二字，正是他心上最为关切之事，不禁眉飞色舞。","book":"清·李宝嘉《官场现形记》第三十二回"},"example":{"text":"譬如“郭巨埋儿”，无论如何总难以画到引得孩子～，自愿躺到坑里去。","book":"鲁迅《朝花夕拾·后记》"},"similar":["眉开眼笑","喜形于色","扬眉吐气"],"opposite":["愁眉苦脸"],"usage":"作谓语、状语、定语；形容人得意的神态"},{"id":33510,"word":"眉高眼下","pinyin":"méi gāo yǎn xià","abbr":"mgyx","explanation":"脸上的表情变化。泛指为人处世的方法。","source":{"text":"世态炎凉如作戏，眉高眼下，且自不提。","book":"《白雪遗音·世态炎凉》"},"similar":["眉高眼低","眉眼高低"],"usage":"作宾语、定语；指为人处世的方法"},{"id":33511,"word":"眉高眼低","pinyin":"méi gāo yǎn dī","abbr":"mgyd","explanation":"脸上的表情。泛指为人处世的道理或辨貌观色的本领。","source":{"text":"大夫四海为家，那里不去了，怎肯受你家眉高眼低，干言湿语。","book":"明·张四维《双烈记·计遣》"},"example":{"text":"慢说走路，什么处儿的风俗，遇事～，那算瞒不过小人的了。","book":"清·石玉昆《三侠五义》第三十二回"},"similar":["眼高手低"],"usage":"作宾语、定语；指为人处世的方法"},{"id":33512,"word":"眉黛青颦","pinyin":"méi dài qīng pín","abbr":"mdqp","explanation":"黛：青黑色的颜料，古代女子用来画眉；青颦：古人用青黛染眉，故称青颦。形容女子容貌美丽。","source":{"text":"眉黛青颦，莲脸生春，有倾国倾城之容，西子、太真之颜。","book":"元·王实甫《西厢记》第二本第一折"}},{"id":33513,"word":"看不上眼","pinyin":"kàn bù shàng yǎn","abbr":"kbsy","explanation":"看不过眼，不合己意。","example":{"text":"这个东西让人～。"},"similar":["不屑一顾"],"usage":"作谓语、定语；用于不屑一顾"},{"id":33514,"word":"看人下菜","pinyin":"kàn rén xià cài","abbr":"krxc","explanation":"比喻对不同的人用不同的方式对待。","source":{"text":"你都会看人下菜碟，宝玉要给东西，你拦在里头。","book":"清·曹雪芹《红楼梦》第六十回"},"example":{"text":"戏班子的嘴澡堂子的水，旧艺人的坏习气是～碟儿。","book":"刘绍棠《孤村》四"},"similar":["见机行事","看人下菜碟儿"],"opposite":["一视同仁"],"usage":"作谓语、定语；指因人而异"},{"id":33515,"word":"看人下菜碟","pinyin":"kàn rén xià cài dié","abbr":"krxcd","explanation":"比喻不能一视同仁，而是因人不同而采取不同的态度，给人不同的待遇。","source":{"text":"你都会看人下菜碟，宝玉要给东西，你拦在里头。","book":"清·曹雪芹《红楼梦》第六十回"},"example":{"text":"韩太太尽管不懂得国家招大学生是不是凭着家庭“～”，但她本能地认为这样说屈了新月。","book":"霍达《穆斯林的葬礼》第四章"}},{"id":33516,"word":"看人下菜碟儿","pinyin":"kàn rén xià cài dié ér","abbr":"krxcde","explanation":"比喻待人因人而异。","source":{"text":"我家里下三等奴才也比你高贵些的，你都会看人下菜碟儿。宝玉要给东西，你拦在头里，莫不是要了你的了？拿这个哄他，你只当他不认得呢！","book":"清·曹雪芹《红楼梦》第六十回"}},{"id":33517,"word":"看人眉眼","pinyin":"kàn rén méi yǎn","abbr":"krmy","explanation":"比喻看人脸色。","source":{"text":"弟妹饥寒，岂容独饱？自可观书于市，安能看人眉睫乎？","book":"《北史·崔亮传》"},"similar":["看人眉睫"],"usage":"作谓语、状语；比喻看人眼色"},{"id":33518,"word":"看人眉睫","pinyin":"kàn rén méi jié","abbr":"krmj","explanation":"睫：眼睑边缘上生的细毛。比喻看人脸色。","source":{"text":"亮曰：‘弟妹饥寒，岂容独饱？自可观书于市，安能看人眉睫乎！’","book":"《北史·崔亮传》"},"example":{"text":"焉能趋炎附势，～，以冀推挽乎？","book":"《宋史·李垂传》"},"similar":["看人脸色"],"usage":"作谓语、状语；比喻看人眼色"},{"id":33519,"word":"看人行事","pinyin":"kàn rén xíng shì","abbr":"krxs","explanation":"根据对方与自己的关系及身分的高低来处理事情。","source":{"text":"他这个黑店与别人不同，不是进来就死，看人行事。","book":"清·石玉昆《小五义》第八十三回"},"example":{"text":"大概他也～，咱平日不招惹他，他怎好意思赶尽杀绝。","book":"老舍《离婚》"},"similar":["见人行事"],"usage":"作谓语；指随机应变"},{"id":33520,"word":"看人说话","pinyin":"kàn rén shuō huà","abbr":"krsh","explanation":"指不按规矩办事，处理问题因人而异。","example":{"text":"你们～，没有什么道理可讲。"},"similar":["见人说人话，见鬼说鬼话"],"usage":"作谓语、宾语；指因人而异"},{"id":33521,"word":"看家本事","pinyin":"kān jiā běn shì","abbr":"kjbs","explanation":"指自己特别擅长的本领。","source":{"text":"这场吵，真吵到都老爷把个看家本事拿出来了，大家才得安静。","book":"清·文康《儿女英雄传》第34回"},"example":{"text":"她不等他说真心话，她的～就拿出来了。","book":"李劼人《天魔舞》第13章"},"similar":["看家本领"],"usage":"作宾语；指特长"},{"id":33522,"word":"看家本领","pinyin":"kān jiā běn lǐng","abbr":"kjbl","explanation":"指特别擅长的技能。","source":{"text":"为民兄，您再教它几句您的看家本领。","book":"茅盾《清明前后》第三幕"},"example":{"text":"没有配角或“下手”，主角的好多～都使不出来。"},"similar":["看家本事","拿手好戏"],"usage":"作宾语；指特长"},{"id":33523,"word":"看得见，摸得着","pinyin":"kàn dé jiàn，mō dé zhuó","abbr":"kdjmdz","explanation":"指能看见的实实在在的事物。","example":{"text":"他的预期效果是～的。"},"usage":"作谓语、定语；用于口语"},{"id":33524,"word":"看文巨眼","pinyin":"kàn wén jù yǎn","abbr":"kwjy","explanation":"形容评论文章的高手。","source":{"text":"现在看文巨眼，应推印伯伯当代第一。","book":"清·李汝珍《镜花缘》第56回"},"similar":["看文老眼"],"usage":"作宾语、定语；用于阅读文章等"},{"id":33525,"word":"看文老眼","pinyin":"kàn wén lǎo yǎn","abbr":"kwly","explanation":"指评论文章的高手。","source":{"text":"如品论讹错，以后再不敢自居看文老眼。","book":"清·李汝珍《镜花缘》第五十六回"},"similar":["看文巨眼"],"usage":"作宾语、定语；用于阅读文章等"},{"id":33526,"word":"看景生情","pinyin":"kàn jǐng shēng qíng","abbr":"kjsq","explanation":"指见机行事。","source":{"text":"不由我见景生情，睹物伤怀。","book":"元·宫大用《七里滩》第四折"},"example":{"text":"毛烈也晓得陈祈有三个幼弟，却独掌着家事，必有欺心毛病，他日可以在里头～，得些渔人之利。","book":"明·凌濛初《二刻拍案惊奇》卷十"},"similar":["见机行事"],"usage":"作谓语、定语；指随机应变"},{"id":33527,"word":"看朱成碧","pinyin":"kàn zhū chéng bì","abbr":"kzcb","explanation":"朱：大红色；碧：翠绿色。将红的看成绿的。形容眼睛发花，视觉模糊。","source":{"text":"谁知心眼乱，看朱忽成碧。","book":"南朝·梁·王僧孺《夜愁示诸宾》诗"},"example":{"text":"催弦拂柱与君饮，～眼始红。","book":"唐·李白《前有樽酒行》"},"similar":["看碧成朱"],"usage":"作谓语、定语；形容眼花不辨五色"},{"id":33528,"word":"看杀卫玠","pinyin":"kàn shā wèi jiè","abbr":"kswj","explanation":"卫玠：晋人，字叔宝，风采极佳，为众人所仰慕。卫玠被人看死。比喻为群众所仰慕的人。","source":{"text":"京师人士闻其姿容，观者如堵。玠劳疾遂甚，永嘉六年卒，时年二十七，时人谓玠被看杀。","book":"《晋书·卫玠传》"},"example":{"text":"卫玠从豫章至下都，人久闻其名，观者如堵墙。玠先有羸疾，体不堪劳，遂成病而死，时人谓～。","book":"明·李贽《初潭集·师友十》"},"usage":"作谓语、定语；指为群众所仰慕的人","story":["西晋时期，太子洗马卫玠很有才华，而且相貌堂堂，眉清目秀，堪称一个美男子，少年时跟随母亲到京城投奔舅父，舅父经常在别人面前夸耀他，一时他的名声很大，很多人前来争相观看与请教问题，27岁时因疲劳过度而死"]},{"id":33529,"word":"看生见长","pinyin":"kàn shēng jiàn zhǎng","abbr":"ksjz","explanation":"亲眼看着某人的出生和长大。形容对某人非常熟悉。","source":{"text":"他在我隔壁住，从小里看生见长的。","book":"元·王晔《桃花女》楔子"},"usage":"作谓语、定语；多用于长辈"},{"id":33530,"word":"看破红尘","pinyin":"kàn pò hóng chén","abbr":"kphc","explanation":"旧指看透人生，把生死哀乐都不放在心上的消极的生活态度。现也指受挫折后消极回避、无所作为的生活态度。","source":{"text":"阗城溢郭，旁流百廛，红尘四合，烟云相连。","book":"汉·班固《西都赋》"},"example":{"text":"～的老汉，要求全家人都不必难受。","book":"柳青《创业史·题叙》"},"similar":["四大皆空","与世无争","超然物外"],"opposite":["天伦之乐"],"usage":"作谓语、定语；指出家为僧","story":["清初金陵歌妓董小宛与冒辟疆结为夫妻，清兵攻陷杭州后，两江总督洪承畴抢走她并进贡给顺治皇帝。顺治特别喜欢她，并把她养在兰馨宫，给她荣华富贵，但还是赢不了她的心，孝庄皇太后杀了董小宛，顺治皇帝看破红尘毅然出家当和尚"]},{"id":33531,"word":"看碧成朱","pinyin":"kàn bì chéng zhū","abbr":"kbcz","explanation":"碧：翠绿色；朱：大红色。将绿的看成红的。形容眼睛发花，视觉模糊。","source":{"text":"谁知心眼乱，看朱忽成碧。","book":"南朝·梁·王僧孺《夜愁示诸宾》诗"},"example":{"text":"倚栏～，等闲褪了香袍粉。","book":"宋·辛弃疾《水龙吟》词"},"similar":["看朱成碧"],"usage":"作谓语、定语；形容眼花不辨五色"},{"id":33532,"word":"看菜吃饭","pinyin":"kàn cài chī fàn","abbr":"kccf","explanation":"比喻根据具体情况办事。","source":{"text":"'看菜吃饭，量体裁衣。'我们无论做什么事都要看情形办理，文章和演说也是这样。","book":"毛泽东《反对党八股》"},"example":{"text":"俗话说：“～，量体裁衣。”"},"similar":["量体裁衣"],"usage":"作谓语；比喻根据具体情况办事"},{"id":33533,"word":"看菜吃饭，量体裁衣","pinyin":"kàn cài chī fàn，liàng tǐ cái yī","abbr":"kccfltcy","explanation":"量体：用尺量身材的大小长短。裁：裁剪。比喻根据具体情况办事。","source":{"text":"‘看菜吃饭，量体裁衣。’我们无论做什么事都要看情形办事。","book":"毛泽东《反对党八股》"},"usage":"作宾语、定语、分句；可分开使用"},{"id":33534,"word":"看风使帆","pinyin":"kàn fēng shǐ fān","abbr":"kfsf","explanation":"看风向掌握船帆。比喻随机应变，看情况办事。亦作“看风使船”、“看风使舵”、“见风使舵”、“看风驶篷”、“看风转舵”、“随风使船”、“看风行事”。","source":{"text":"看风使帆，正是随波逐浪。","book":"宋·释普济《五灯会元·天依怀禅师法嗣·法云法秀禅师》"},"similar":["看风使舵","看风使船","看风驶篷"],"opposite":["墨守成规"],"usage":"作谓语、定语、宾语；指随机应变"},{"id":33535,"word":"看风使舵","pinyin":"kàn fēng shǐ duò","abbr":"kfsd","explanation":"看风向转发动舵柄。比喻看势头或看别人的眼色行事。","source":{"text":"看风使舵，正是随波逐流。","book":"宋·释普济《五灯会元》"},"example":{"text":"有些人惯于～，看领导眼色行事。"},"similar":["见风使舵"],"opposite":["刻舟求剑","墨守成规"],"usage":"作谓语、定语、宾语；指随机应变"},{"id":33536,"word":"看风使船","pinyin":"kàn fēng shǐ chuán","abbr":"kfsc","explanation":"比喻跟着时势转变方向，随机应变。","source":{"text":"老娘是个走千家，踏万户，极聪明的人，须看风使船，且待他口声如何。","book":"《西湖佳话·断桥情迹》"},"example":{"text":"下半截话，他故意憋在肚子里，为的是～。","book":"段荃法《凌红蝶》"},"similar":["看风使舵"],"usage":"作谓语、宾语；指见风使舵"},{"id":33537,"word":"看风行事","pinyin":"kàn fēng xíng shì","abbr":"kfxs","explanation":"看：观察，估量。比喻做事灵活机动。","source":{"text":"许多专制国家，都是顺应潮流去看风行事。","book":"孙中山《民权主义第四讲》"},"example":{"text":"只打发老婆，白天在村里打听点消息，～。","book":"马烽《吕梁英雄传》第二十回"},"similar":["随机应变","见机行事"],"usage":"作谓语、定语；指人做事灵活"},{"id":33538,"word":"看风行船","pinyin":"kàn fēng xíng chuán","abbr":"kfxc","explanation":"看：观察。比喻做事随机应变。","source":{"text":"俺看这位皇帝不像享福之器，况北兵过江，人人投顺，元帅也要看风行船才好。","book":"清·孔尚任《桃花扇》"},"similar":["看风使帆","看风转舵"],"usage":"作宾语、定语；用于见机行事"},{"id":33539,"word":"看风转舵","pinyin":"kàn fēng zhuǎn duò","abbr":"kfzd","explanation":"看：观察；舵：船控制方向的装置。看着风向掌握船舵。比喻随着形势转变方向，调整对策。","source":{"text":"不要紧，看风转舵，主意多着呢！","book":"老舍《老张的哲学》"},"example":{"text":"他见人说人话，见鬼说鬼话，很会～。"},"similar":["看风使舵"],"usage":"作谓语、宾语、定语；用于见机行事"},{"id":33540,"word":"看风驶篷","pinyin":"kàn fēng shǐ péng","abbr":"kfsp","explanation":"看：观察，估量；篷：船帆。看风向转动舵柄。比喻跟着情势转变方向，随机应变。","source":{"text":"傻孩子，这也要问呀！要你自己看风驶篷！","book":"茅盾《子夜》"},"similar":["看风使船","看风使舵","看风使帆"],"usage":"作谓语、定语、宾语；指随机应变"},{"id":33541,"word":"看风驶船","pinyin":"kàn fēng shǐ chuán","abbr":"kfsc","explanation":"指随机应变，见机行事。","source":{"text":"他暗自决定：先应下，事到临头，再看风驶船，见机行事。","book":"郭澄清《大刀记》第17章"},"similar":["看风使船","看风使舵","见机行事"],"usage":"作谓语、定语；指见机行事"},{"id":33542,"word":"真人不露相","pinyin":"zhēn rén bù lòu xiàng","abbr":"zrblx","explanation":"指得道的人不以形相现于人前。借喻不在人前露脸或暴露身分。","source":{"text":"悟空，这里人家，识得我们道成事完了。自古道，真人不露相，露相不真人。恐为久淹，失了大事。","book":"明·吴承恩《西游记》第九十九回"},"example":{"text":"俗语说的：‘～。’我且用话探他一探。","book":"清·李汝珍《镜花缘》第四十四回"},"similar":["藏而不露"],"opposite":["锋芒毕露"],"usage":"作宾语、定语；用于口语"},{"id":33543,"word":"真人真事","pinyin":"zhēn rén zhēn shì","abbr":"zrzs","explanation":"生活中的实际人和实际事。","source":{"text":"这部影片取材于海南的～。"},"example":{"text":"这部影片取材于海南的～"},"opposite":["纯属虚构"],"usage":"作宾语、定语；指实际人和实际事"},{"id":33544,"word":"真人面前不说假","pinyin":"zhēn rén miàn qián bù shuō jiǎ","abbr":"zrmqbsj","explanation":"真人：真诚的人或了解事实的人。在知情人面前不说谎话。","source":{"text":"佛也打，祖也打，真人面前不说假。","book":"宋·释普济《五灯会元》卷十六"},"usage":"作宾语、定语、分句；用于处事等"},{"id":33545,"word":"真人面前不说假话","pinyin":"zhēn rén miàn qián bù shuō jiǎ huà","abbr":"zrmqbsjh","explanation":"真人：真诚的人或了解事实的人。在知情人面前不说谎话。","source":{"text":"佛也打，祖也打，真人面前不说假。","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"咱们～，兄弟今日特地来求贵会交还玉瓶。（金庸《书剑恩仇录》第九回）"}},{"id":33546,"word":"真伪莫辨","pinyin":"zhēn wěi mò biàn","abbr":"zwmb","explanation":"莫：不。真假分辨不清。","source":{"text":"战国纵横，真伪莫辨，诸子之言，纷然淆乱。","book":"《隋书·经籍志一》"},"example":{"text":"上午，空六来谈；全谈些报纸上所载的事，～。","book":"鲁迅《华盖集续编·马上支日记》"},"similar":["真伪难辨","真假难辨"],"usage":"作宾语、定语；指难以分辨"},{"id":33547,"word":"真伪难辨","pinyin":"zhēn wěi nán biàn","abbr":"zwnb","explanation":"辨：辨别。真假分辨不清","example":{"text":"现代的造假技术让人～"},"similar":["真伪莫辨","真假难辨"],"usage":"作谓语、定语；指难以分辨"},{"id":33548,"word":"真假难辨","pinyin":"zhēn jiǎ nán biàn","abbr":"zjnb","explanation":"真假难以分辨清楚。","source":{"text":"战国纵横，真伪莫辨，诸子之言，纷然淆乱。","book":"《隋书·经籍志一》"},"example":{"text":"妾身奏闻陛下，亚相所奏，～。（明·许仲琳《封神演义》第十六回）"},"similar":["真伪难辨","真伪莫辨"],"usage":"作宾语、定语；指难以分辨"},{"id":33549,"word":"真凭实据","pinyin":"zhēn píng shí jù","abbr":"zpsj","explanation":"确凿的凭据。","source":{"text":"我本是个安分良民，人家说我私贬鸦片，都是雠扳，没有什么真凭实据。","book":"清·彭养鸥《黑籍冤魂》第五回"},"example":{"text":"处理任何案件，都必须有～。"},"similar":["铁证如山","信而有征","有目共睹"],"opposite":["荒谬之谈","无稽之谈","捕风捉影"],"usage":"作主语、宾语、定语；指证据"},{"id":33550,"word":"真凶实犯","pinyin":"zhēn xiōng shí fàn","abbr":"zxsf","explanation":"真正的罪犯。","source":{"text":"快快出去查明受害的百姓，赶紧指出真凶实犯，本县立刻就要办人！","book":"清·李宝嘉《官场现形记》第十五回"},"usage":"作宾语、定语；用于书面语"},{"id":33551,"word":"真刀真枪","pinyin":"zhēn dāo zhēn qiāng","abbr":"zdzq","explanation":"①真实的刀枪。②比喻毫不作假，实实在在。","source":{"text":"你知道么？人家是拿真刀真枪的。不比我们光拿铁笔、扁担。","book":"老舍《龙须沟》第二幕：“他们在这儿，不是先给孩子们糖吃，然后才真刀真枪的一杀杀一大片？”欧阳山《苦斗》三八"},"example":{"text":"我的意思是大敌当前，民族危亡，一个热血男儿就应当～地干，光搞这些意思不大！","book":"魏巍《火凤凰》一七"},"similar":["真枪实弹"],"usage":"作宾语、定语、状语；指动真格"},{"id":33552,"word":"真命天子","pinyin":"zhēn mìng tiān zǐ","abbr":"zmtz","explanation":"旧时所谓秉承天命降世的皇帝。","source":{"text":"先生二十五六年前，便识透宋朝的真命天子了。","book":"明·冯梦龙《喻世明言》第十四卷"},"example":{"text":"我早就算定～已经降世。","book":"《二十年目睹之怪现象》第八十回"},"similar":["九五之尊"],"usage":"作主语、宾语；指皇帝"},{"id":33553,"word":"真实无妄","pinyin":"zhēn shí wú wàng","abbr":"zsww","explanation":"妄：荒谬，不合理。真实可靠，不荒谬。","source":{"text":"然诚者，真实无妄，安得有恶！","book":"宋·朱熹《朱子语类》卷十六"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33554,"word":"真山真水","pinyin":"zhēn shān zhēn shuǐ","abbr":"zszs","explanation":"形容风景特别优美的山水","source":{"text":"你看庐山，果然好景致也，端的真山真水。","book":"元·吴昌龄《东坡梦》第一折"},"example":{"text":"明·施耐庵《水浒传》第39回：“我虽是犯罪远流到此，却也看了些～。”"},"usage":"作宾语、定语；用于书面语"},{"id":33555,"word":"真心实意","pinyin":"zhēn xīn shí yì","abbr":"zxsy","explanation":"心意真实诚恳，没有虚假。","source":{"text":"常言道海深须见底，各办着个真心实意。","book":"元·无名氏《百花亭》第三折"},"example":{"text":"～，才能找到知己。"},"similar":["诚心诚意"],"opposite":["虚情假意","三心二意"],"usage":"作主语、定语、状语；指真诚"},{"id":33556,"word":"真心真意","pinyin":"zhēn xīn zhēn yì","abbr":"zxzy","explanation":"犹真心实意。","source":{"text":"那黛玉偏生也是个有些痴病的，也每用假情试探。因你也将真心真意瞒起来，我也将真心真意瞒起来，都只用假意试探。","book":"清·曹雪芹《红楼梦》第二十九回"},"example":{"text":"你猜炳哥怎么说的？他说他从前～爱过的，只有一个人。真心真意好过的，也只有一个人。","book":"欧阳山《苦斗》第二十二章"},"similar":["真心实意","真心诚意"],"opposite":["虚情假意"],"usage":"作宾语、定语、状语；指真诚"},{"id":33557,"word":"真心诚意","pinyin":"zhēn xīn chéng yì","abbr":"zxcy","explanation":"心意真实诚恳，没有虚假。","source":{"text":"常言道海深须见底，各办着个真心实意。","book":"元·无名氏《百花亭》第三折"},"example":{"text":"他相信献忠确实是～地归顺朝廷。","book":"姚雪垠《李自成》第一卷第十六章"},"similar":["真心实意"],"opposite":["虚情假意"],"usage":"作主语、宾语、定语；同“真心实意”"},{"id":33558,"word":"真情实意","pinyin":"zhēn qíng shí yì","abbr":"zqsy","explanation":"真实的情意。","source":{"text":"诗有别材，非关书也，诗有别趣，非关理也……彼小夫贱隶妇人女子真情实意，喑合而偶中，固不待于教。","book":"明·李东阳《求退录·诗话》"},"example":{"text":"她有时觉得他是～地爱她，但有时却怪他既然爱她为什么不肯和妻子离婚？","book":"草明《乘风破浪》九"},"similar":["真心实意"],"opposite":["虚情假意"],"usage":"作宾语、定语、状语；指真心"},{"id":33559,"word":"真情实感","pinyin":"zhēn qíng shí gǎn","abbr":"zqsg","explanation":"真挚的感情，实在的感受。","source":{"text":"散文如无具体约束，无真情实感，，就会枝蔓无边。","book":"孙犁《秀露集·欧阳修的散文》"},"example":{"text":"古老的神话，未必没有～。","book":"郭小川《昆仑行》诗"},"usage":"作宾语、定语；用于书面语"},{"id":33560,"word":"真才实学","pinyin":"zhēn cái shí xué","abbr":"zcsx","explanation":"真正的才能和学识。","source":{"text":"这一扑，有名唤做‘玉环步，鸳鸯脚’。——这是武松平生的真才实学。","book":"明·施耐庵《水浒全传》第二十九回"},"example":{"text":"一百个说空话的人，不如一个有～的实干家。"},"similar":["真知灼见"],"opposite":["不学无术"],"usage":"作宾语、定语；指真本事"},{"id":33561,"word":"真枪实弹","pinyin":"zhēn qiāng shí dàn","abbr":"zqsd","explanation":"战场上使用的武器弹药。多比喻实战。","source":{"text":"尽管有真枪实弹与纸上硝烟的不同，却同样要以活鲜鲜的生命相搏击的。","book":"柯灵《〈阿英散文选〉序》"},"usage":"作宾语、定语；多用于比喻句"},{"id":33562,"word":"真独简贵","pinyin":"zhēn dú jiǎn guì","abbr":"zdjg","explanation":"独处时谨慎，富贵时简省。","source":{"text":"真独简贵，不减父祖。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"example":{"text":"恭惟某官，躬～之资，蕴笃实诚形之学。","book":"宋·陆游《贺新提举启》"},"usage":"作宾语、定语；用于书面语"},{"id":33563,"word":"真相大白","pinyin":"zhēn xiàng dà bái","abbr":"zxdb","explanation":"大白：彻底弄清楚。真实情况完全弄明白了。","source":{"text":"要是能把他的疯病治好了，就可以真相大白了。","book":"《花城》1981年第1期"},"example":{"text":"经过严密的侦察，这个案件终于～。"},"similar":["原形毕露","真相毕露"],"opposite":["深不可测","真伪莫辨"],"usage":"作谓语、宾语；指真实情况完全弄明白了"},{"id":33564,"word":"真相毕露","pinyin":"zhēn xiāng bì lù","abbr":"zxbl","explanation":"真面目完全显露出来。","source":{"text":"两书辨析详明，证据确凿，教伪孔体无完肤，真相毕露。","book":"朱自清《经典常谈·尚书第三》"},"example":{"text":"原先他还想狡辩，但后来～，才使他哑口无言。"},"similar":["原形毕露"],"usage":"作谓语、定语；用于书面语"},{"id":33565,"word":"真真假假","pinyin":"zhēn zhēn jiǎ jiǎ","abbr":"zzjj","explanation":"指真假难辨。","source":{"text":"现在党内外小道消息很多，真真假假，这是对长期缺乏政治民主的一种惩罚。","book":"邓小平《解放思想，实事求是，团结一致向前看》"},"example":{"text":"报纸上～的娱乐新闻实在不值得一读。"},"similar":["虚虚实实"],"usage":"作谓语、定语、状语；指真假难辨"},{"id":33566,"word":"真真实实","pinyin":"zhēn zhēn shí shí","abbr":"zzss","explanation":"指十分真实可靠。","source":{"text":"我弟兄三个，真真实实地并没半点儿假！","book":"明·施耐庵《水浒传》第15回"},"example":{"text":"清·荻岸山人《平山冷燕》第五回：“若说～，落笔便成，虽斩头沥血，吾不信也！”"},"similar":["实实在在","确确实实"],"usage":"作定语、状语；用于口语等"},{"id":33567,"word":"真知卓见","pinyin":"zhēn zhī zhuó jiàn","abbr":"zzzj","explanation":"指正确而深刻的认识和高明的见解。同“真知灼见”。","source":{"text":"我的旧信稿，不敢说是甚么真知卓见，不过在此提供出来，聊以供朋友们的讨论罢了。","book":"郭沫若《盲肠炎·向自由王国飞跃》"},"similar":["真知灼见","灼见真知"],"opposite":["一孔之见"],"usage":"作宾语、定语；用于评论人的看法"},{"id":33568,"word":"真知灼见","pinyin":"zhēn zhī zhuó jiàn","abbr":"zzzj","explanation":"灼：明白，透彻。正确而透彻的见解。","source":{"text":"真知灼见者，尚且有误，何况其他！","book":"明·冯梦龙《警世通言》卷三"},"example":{"text":"两家之学皆深入宋儒之室，但以汉学为不可废耳，多倚墙之见，依违之言，岂～者哉！","book":"江藩《汉学师承记·顾炎武》"},"similar":["深知灼见","真知卓见","灼见真知"],"opposite":["一孔之见","一得之见"],"usage":"作宾语、定语；用于评论人的看法"},{"id":33569,"word":"真脏实犯","pinyin":"zhēn zāng shí fàn","abbr":"zzsf","explanation":"脏物上真的，罪犯是确实的。泛指犯罪的证据确凿。"},{"id":33570,"word":"真赃实犯","pinyin":"zhēn zāng shí fàn","abbr":"zzsf","explanation":"赃物是真的，罪犯是确实的。泛指犯罪的证据确凿。","source":{"text":"你今真赃实犯，有何理说。","book":"明·无名氏《开诏救忠》第三折"},"usage":"作宾语；泛指犯罪的证据确凿"},{"id":33571,"word":"真赃实证","pinyin":"zhēn zāng shí zhèng","abbr":"zzsz","explanation":"赃物是真的，证据是确实的。泛指犯罪的证据确凿。","source":{"text":"你今真赃实犯，有何理说。","book":"明·无名氏《开诏救忠》第三折"},"example":{"text":"难为你寻得出前人许多～，来做我们歪诗的护法。（清·魏子安《花月痕》第十六回）"}},{"id":33572,"word":"真赃真贼","pinyin":"zhēn zāng zhēn zéi","abbr":"zzzz","explanation":"赃物、罪犯都确凿无疑。指犯罪的证据确凿。","source":{"text":"黄信道：‘还你一个证见，教你看真赃真贼，我不屈你。左右，与我推将来。’","book":"明·施耐庵《水浒传》第三十三回"}},{"id":33573,"word":"真金不怕火","pinyin":"zhēn jīn bù pà huǒ","abbr":"zjbph","explanation":"比喻正确的事物经得住考验。","source":{"text":"姓刘的说要调查，你就陪他去，真金不怕火，查好了！","book":"高晓声《大好人江坤大》"},"example":{"text":"高晓声《大好人江坤大》：“姓刘的说要调查，你就陪他去，～，查好了！”"},"similar":["真金不怕火炼"],"usage":"作宾语、定语、分句；用于口语"},{"id":33574,"word":"真金不怕火来烧","pinyin":"zhēn jīn bù pà huǒ lái shāo","abbr":"zjbphls","explanation":"比喻真理或立身、行事正直的人经得起实践检验，不怕任何非议。","source":{"text":"有诚便能有勇，所谓‘真金不怕火来烧’。","book":"郭沫若《相见以诚》"},"example":{"text":"～，他的谣言会不攻自破的。"},"similar":["真金不怕火炼"],"usage":"作宾语、分句；指真理"},{"id":33575,"word":"真金不怕火炼","pinyin":"zhēn jīn bù pà huǒ liàn","abbr":"zjbphl","explanation":"比喻品质好、意志坚强的人经得起任何考验。","source":{"text":"乌云遮不住太阳，真金不怕火炼，东山坞永远会是太阳当空，永远是我们人民的天下！","book":"浩然《艳阳天》第一一五章"},"example":{"text":"真金不怕火炼，中国人民解放军战士经过血与火的考验，更加英勇无畏了。"},"similar":["真金不怕火"],"usage":"作宾语、分句；指真理"},{"id":33576,"word":"真金不镀","pinyin":"zhēn jīn bù dù","abbr":"zjbd","explanation":"真的黄金上用不着再镀金。比喻有真才实学的人用不到装饰。","source":{"text":"假金方用真金镀，若是真金不镀金，十载长安得一第，何须空腹用高心。","book":"唐·李绅《答章孝标》"},"example":{"text":"～，用不着担心，我们肯定会成功的。"},"usage":"作宾语、定语；指人有真才实学"},{"id":33577,"word":"真金烈火","pinyin":"zhēn jīn liè huǒ","abbr":"zjlh　","explanation":"真金不怕在烈火中烧。比喻保持英雄本色不变。","source":{"text":"非自奖真金烈火，傥好比浊水红莲。","book":"明·徐渭《四声猿·雌木兰替父从军》"},"usage":"作宾语、定语；用于比喻句"},{"id":33578,"word":"真龙天子","pinyin":"zhēn lóng tiān zǐ","abbr":"zltz","explanation":"旧时认为皇帝是天上的真龙下凡，因以为皇帝的代称。","source":{"text":"她想，既然人们都说明朝的气数完了，真龙天子已经出世，说不定这真龙天子就是李闯王。","book":"姚雪垠《李自成》第一卷第二十八章"},"example":{"text":"～一出世，天下也许就太平了。","book":"萧军《八月的乡村》九"},"usage":"作宾语、定语；用于口语"},{"id":33579,"word":"真龙活现","pinyin":"zhēn lóng huó xiàn","abbr":"zlhx","explanation":"形容逼真。","source":{"text":"他每一次所做的传单，都是说的真龙活现也似的。","book":"蒋光慈《短裤党》二"},"example":{"text":"计策的内容和保证是：要求每个前去执行任务的小伙子大胆说谎话，而且谎话要说得有鼻子有眼，～，毫不含糊。","book":"柳杞《好年胜景》四"},"usage":"作定语、状语；用于比喻句"},{"id":33580,"word":"眠云卧石","pinyin":"mián yún wò shí","abbr":"myws","explanation":"比喻山居生活。","source":{"text":"欲知花乳清泠味，须是眠云卧石人。","book":"唐刘禹锡《西山半若试茶歌》"},"usage":"作宾语、定语；用于山居生活"},{"id":33581,"word":"眠思梦想","pinyin":"mián sī mèng xiǎng","abbr":"msmx","explanation":"睡梦中也在想念。形容思念之甚。","source":{"text":"且说那禁子贪爱玉英容貌，眠思梦想，要去奸他。","book":"《醒世悟言·李玉英狱中讼冤》"},"example":{"text":"两兄这些时到那里去来？令我～，望眼欲穿。","book":"《黄金世界》第六回"},"usage":"作谓语、定语、宾语；用于思念"},{"id":33582,"word":"眠花卧柳","pinyin":"mián huā wò liǔ","abbr":"mhwl","explanation":"比喻狎妓。同“眠花宿柳”。","source":{"text":"我见此人有些行为欠端，在外眠花卧柳，又里虚外实。","book":"《金瓶梅词话》第七回"},"example":{"text":"那柳湘莲原系世家子弟，读书不成，父母早丧，素性爽侠，不拘细事，酷好耍枪舞剑，赌博吃酒，以至～，吹笛弹筝，无所不为。","book":"《红楼梦》第四七回"},"similar":["眠花宿柳"],"usage":"作谓语、定语；指嫖妓"},{"id":33583,"word":"眠花宿柳","pinyin":"mián huā sù liǔ","abbr":"mhsl","explanation":"比喻狎妓。","source":{"text":"终日闲游浪荡，一自父母亡后，专一在外眠花宿柳，惹草招风。","book":"《金瓶梅词话》第一回"},"example":{"text":"把他逼得房帏以内，生趣毫无，荆棘满眼，就不免在外～，荡检逾闲。","book":"《儿女英雄传》第五回"},"similar":["眠花藉柳"],"usage":"作谓语、定语；指狎妓"},{"id":33584,"word":"眠花藉柳","pinyin":"mián huā jiè liǔ","abbr":"mhjl","explanation":"比喻狎妓。同“眠花宿柳”。","source":{"text":"予一介寒生，终身落魄……而敢谬次音容，侈谈歌舞，贻笑于眠花藉柳之人哉！","book":"清李渔《闲情偶寄·声容·选姿》"},"example":{"text":"～，实惬人心，惜是幻化，意中终隔一膜耳。","book":"清纪昀《阅微草堂笔记滦阳消夏录一》"},"similar":["眠花卧柳","眠花醉柳"],"usage":"作谓语、定语；指嫖妓"},{"id":33585,"word":"眠花醉柳","pinyin":"mián huā zuì liǔ","abbr":"mhzl","explanation":"比喻狎妓。同“眠花宿柳”。","source":{"text":"终日眠花醉柳，喝五呼幺。","book":"清李渔《怜香伴·贿荐》"},"similar":["眠花卧柳"],"usage":"作谓语、定语、宾语；指嫖妓"},{"id":33586,"word":"眠霜卧雪","pinyin":"mián shuāng wò xuě","abbr":"mswx","explanation":"卧于霜雪之中。形容在外奔波的劳苦。","source":{"text":"问：‘久战沙场，为甚么功名不就？’师曰：‘只为眠霜卧雪深。’","book":"宋·释普济《五灯会元》卷十五"},"example":{"text":"我也曾苦征恶战，～，多有功勋。","book":"元·关汉卿《哭存孝》第二折"},"usage":"作宾语、定语；用于旅途辛劳"},{"id":33587,"word":"眢井瞽人","pinyin":"yuān jǐng gǔ rén","abbr":"yjgr","explanation":"眢井：枯井；瞽：瞎子。处于枯井中的瞎子。比喻毫无见识的庸人","source":{"text":"盖非西学洋文，则无以为耳目，而舍格致之事，将仅得其皮毛，眢井瞽人，其无救于亡也审矣。","book":"严复《救亡决论》"},"usage":"作宾语、定语；用于比喻句"},{"id":33588,"word":"眦睚杀人","pinyin":"zì yá shā rén","abbr":"zysr","explanation":"眦：眼角；睚：眼眶。因为别人瞪眼就杀了他。形容为人狭窄骄横","source":{"text":"程一日果以眦睚杀人。上大怒，立命斥出，付京兆。","book":"宋·王谠《唐语林·政事》"},"similar":["睚眦杀人"],"usage":"作谓语、宾语；用于书面语"},{"id":33589,"word":"眦裂发指","pinyin":"zì liè fà zhǐ","abbr":"zlfz","explanation":"眼角裂开，头发上竖。形容愤怒到极点。","source":{"text":"瞋目视项王，头发上指，目眦尽裂。","book":"《史记·项羽本纪》"},"usage":"作谓语、状语；指十分愤怒"},{"id":33590,"word":"眩目惊心","pinyin":"xuàn mù jīng xīn","abbr":"xmjx","explanation":"使人眼花心惊。","source":{"text":"增华崇丽，眩止惊心。","book":"宋刘氏《重修文宣王庙记》"},"usage":"作谓语、定语；用于书面语"},{"id":33591,"word":"眩目震耳","pinyin":"xuàn mù zhèn ěr","abbr":"xmze","explanation":"眩：眼花，迷乱；眩目：耀眼。形容色彩繁多使人眼花，声音巨大震耳欲聋。","source":{"text":"有一些虔诚的佛教徒到了那个地方就会‘眩目震耳，悖魄堕魂。’","book":"巴金《旅途随笔·游了佛国》"},"usage":"作谓语、定语；形容声色"},{"id":33592,"word":"眩碧成朱","pinyin":"xuàn bì chéng zhū","abbr":"xbcz","explanation":"比喻颠倒是非。","source":{"text":"宫闱萋菲，眩碧成朱，圣主应投杼。","book":"明屠隆《彩毫记·知幾引退》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":33593,"word":"眩视惑听","pinyin":"xuàn shì huò tīng","abbr":"xsht","explanation":"迷惑人的视听。","source":{"text":"章炳麟《*书订文》附《正名杂义》；“樊（樊宗师）卢（卢仝）诸子，憙为险怪，以眩视惑听邪？”"},"usage":"作宾语、定语；用于书面语"},{"id":33594,"word":"眷眷不忘","pinyin":"juàn juàn bù wàng","abbr":"jjbw","explanation":"眷眷：爱恋。眷恋不已，难以忘怀。","source":{"text":"念彼共人，眷眷怀顾。","book":"《诗经·小雅·小明》"},"example":{"text":"代宗推心以任怀恩，至于已叛，犹～，养其母，鞠其女，且曰：“朕负怀恩。”","book":"清·王夫之《读通鉴论》卷二十三"}},{"id":33595,"word":"眷眷之心","pinyin":"juàn juàn zhī xīn","abbr":"jjzx","explanation":"眷眷：爱恋。依恋不舍之心。","source":{"text":"既定汉室，建立明主，眷眷之心，岂有异哉。","book":"汉·荀悦《汉纪·文帝纪下》"},"example":{"text":"～何所依，来日相聚终有期。"},"usage":"作宾语；指依恋不舍的心"},{"id":33596,"word":"眷红偎翠","pinyin":"juàn hóng wēi cuì","abbr":"jhwc","explanation":"形容对春色的依恋。","source":{"text":"处处踏青斗草，人人眷红偎翠。","book":"宋·柳永《内家娇》词"},"usage":"作谓语、定语；指人贪色"},{"id":33597,"word":"眼不交睫","pinyin":"yǎn bù jiāo jié","abbr":"ybjj","explanation":"睫：眼睫毛。眼睛一眨也不眨。形容心情不安而长夜不眠","source":{"text":"吴氏倍加扫兴，忿怒不已，眼不交睫，直到天明。","book":"明·凌濛初《初刻拍案惊奇》第17卷"},"similar":["目不交睫"],"usage":"作谓语、状语；指夜间不睡觉或睡不着"},{"id":33598,"word":"眼不回睛","pinyin":"yǎn bù huí jīng","abbr":"ybhj","explanation":"眼珠一转不转。形容注意力集中，看得出神","source":{"text":"国英看得酥麻了，眼不回睛出了神。","book":"清·陶贞怀《天雨花》第二回"},"similar":["目不转睛"],"usage":"作谓语、状语；用于书面语"},{"id":33599,"word":"眼不著砂","pinyin":"yǎn bù zhuó shā","abbr":"ybzs","explanation":"著：同“着”，着落。眼睛里不能容一点沙子。指对坏人坏事不能容忍","source":{"text":"渊明不肯束带见乡里小儿，所谓眼不著砂。","book":"宋·陈善《扪虱新话·陶渊明不见督邮》"},"similar":["眼里揉不下沙子"],"usage":"作宾语、定语；用于比喻句"},{"id":33600,"word":"眼不见为净","pinyin":"yǎn bù jiàn wéi jìng","abbr":"ybjwj","explanation":"指心里不以为然，但又没有办法，只好撇开不管。也在怀疑食品不干净时，用作自我安慰的话。","source":{"text":"凡贩卖虾米及甘蔗者，每用人溺洒之，则鲜美可爱，所谓眼不见为净也。","book":"宋·赵希鹄《调燮类编·虫鱼》"},"example":{"text":"她想出去，离了这里，～。","book":"茹志鹃《静静的产院》"},"similar":["眼不见，心不烦"],"opposite":["眼见心烦"],"usage":"作谓语、定语、宾语；指采取回避态度"},{"id":33601,"word":"眼不见，心不烦","pinyin":"yǎn bù jiàn，xīn bù fán","abbr":"ybjxbf","explanation":"比喻只要没有看见或不在眼前，也就不会为这操心或烦恼。","source":{"text":"任凭你们两个冤家闹上天去，我‘眼不见，心不烦’，也就罢了。","book":"清·曹雪芹《红楼梦》第29回"},"example":{"text":"～，由他去吧。"},"similar":["眼不见为净"],"usage":"作谓语、定语、分句；用于劝诫人"},{"id":33602,"word":"眼不识丁","pinyin":"yǎn bù shí dīng","abbr":"ybsd","explanation":"连最普通的“丁”字也不认识。形容一个字也不认得。","source":{"text":"今天下无事，汝辈挽得两石力弓，不如识一丁字。","book":"《旧唐书·张弘靖传》"},"example":{"text":"～马前卒，隔床鼾鼻正陶然。","book":"宋·文天祥《不睡》诗"},"similar":["目不识丁"],"usage":"作谓语、定语；形容一个字也不认得"},{"id":33603,"word":"眼不转睛","pinyin":"yǎn bù zhuǎn jīng","abbr":"ybzj","explanation":"睛：眼珠。眼珠一转不转。形容注意力集中，看得出神","source":{"text":"只有一只老白猫坐在地板上，冷冷的嘲笑的神态，眼不转睛的望着我。","book":"瞿秋白《赤都心史》第34回"},"similar":["目不转睛"],"usage":"作状语；形容注意力集中"},{"id":33604,"word":"眼中之钉","pinyin":"yǎn zhōng zhī dīng","abbr":"yzzd","explanation":"比喻极其厌恶憎恨的人。","source":{"text":"宋人喜而相谓曰：‘眼中拔钉，岂不乐哉！’","book":"《新五代史·赵在礼传》"},"example":{"text":"我把他们视为～。"},"similar":["眼中钉"],"usage":"作主语、宾语；指特别厌恶的人","story":["五代时期，后唐效节指挥使赵在礼起兵反后唐庄宗，拥立明宗，被任命为义成军节度使，他滥用职权，欺压民众，经常搜刮民脂民膏。他率军去攻打当时人们认为是眼中之钉的契丹，下令宋州百姓每人交1000钱的“拔钉费”，违者处死"]},{"id":33605,"word":"眼中刺","pinyin":"yǎn zhōng cì","abbr":"yzc","explanation":"形容最痛恨、最厌恶的人","source":{"text":"新人迎来旧人弃，掌上莲花眼中刺。迎新去旧未足悲，悲在君家留两儿。","book":"唐·白居易《母别子》"},"similar":["眼中钉"],"usage":"作宾语、定语；用于比喻句"},{"id":33606,"word":"眼中拔钉","pinyin":"yǎn zhōng bá dīng","abbr":"yzbd","explanation":"比喻除去心中最痛恨的人。","source":{"text":"在礼在宋州，人尤苦之；已而罢去，宋人喜而相谓曰：‘眼中拔钉，岂不乐哉？’","book":"《新五代史·杂传八·赵在礼》"},"usage":"作谓语、宾语；比喻除去心中最痛恨的人","story":["五代时期，后唐效节指挥使赵在礼起兵反后唐庄宗，拥立明宗，被任命为义成军节度使，他滥用职权，欺压民众，经常搜刮民脂民膏。他率军去攻打当时人们认为是眼中之钉的契丹，下令宋州百姓每人交1000钱的“拔钉费”，违者处死"]},{"id":33607,"word":"眼中有铁","pinyin":"yǎn zhōng yǒu tiě","abbr":"yzyt","explanation":"比喻军容整肃。","source":{"text":"春，正月，庚申朔，齐主登北城，军容甚整。突厥咎周人曰：‘尔言齐乱，故来伐之：今齐人眼中亦有铁，何可当耶！’","book":"《资治通鉴·陈世祖天嘉五年》"},"usage":"作谓语；定语；指纪律严明"},{"id":33608,"word":"眼中疔，肉中刺","pinyin":"yǎn zhōng dīng，ròu zhōng cì","abbr":"yzdrzc","explanation":"疔：疔疮。眼睛里面的疔疮，肌肉中的刺。比喻心目中最痛恨、最讨厌的人","source":{"text":"我见了那穷汉，似眼中疔，肉中刺。","book":"元·无名氏《陈州粜米》第一折"},"similar":["眼中钉，肉中刺"],"usage":"作宾语、定语；用于比喻句"},{"id":33609,"word":"眼中钉","pinyin":"yǎn zhōng dīng","abbr":"yzd","explanation":"比喻心中最厌恶、最痛恨的人。","source":{"text":"在礼在宋州，人尤苦之。已而罢去，宋人喜而相谓曰：‘眼中拔钉，岂不乐哉？’","book":"《新五代史·赵在礼传》"},"example":{"text":"我们娘儿俩今儿一齐死给他看，替他拔去～，肉中刺，好等他们来过现成日子。","book":"清·李宝嘉《官场现形记》第二十二回"},"similar":["眼中刺"],"usage":"作宾语；指最痛恨的人","story":["五代时期，后唐效节指挥使赵在礼起兵反后唐庄宗，拥立明宗，被任命为义成军节度使，他滥用职权，欺压民众，经常搜刮民脂民膏。他率军去攻打当时人们认为是眼中之钉的契丹，下令宋州百姓每人交1000钱的“拔钉费”，违者处死"]},{"id":33610,"word":"眼中钉，肉中刺","pinyin":"yǎn zhōng dīng，ròu zhōng ì","abbr":"yzdrzc","explanation":"比喻心中最厌恶、最痛恨的人。","source":{"text":"我见了那穷汉，似眼中疔，肉中刺。","book":"元·无名氏《陈州粜米》第一折"},"example":{"text":"清·石玉昆《小五义》第55回：“除了他们～，从此没人讹诈，愿给多少就多少。”"},"similar":["眼中疔，肉中刺"],"usage":"作宾语、定语；用于比喻句"},{"id":33611,"word":"眼乖手疾","pinyin":"yǎn guāi shǒu jí","abbr":"ygsj","explanation":"眼睛明亮，手脚利落。形容看得准，动作敏捷。","source":{"text":"原来是那大圣故意教他中了，却眼乖手疾，一把接住那箭头，把箭翎花落在前边，丢开脚步跑了。","book":"明·吴承恩《西游记》第三十七回"}},{"id":33612,"word":"眼光如豆","pinyin":"yǎn guāng rú dòu","abbr":"ygrd","explanation":"指目光短浅，缺乏深远的见解","source":{"text":"昔人谓东坡词非正声，此特拘于音调言之，而不究本原所在；眼光如豆，不足与之辩也。","book":"清·陈廷焯《白雨斋词话》第一卷"},"example":{"text":"鲁迅《且介亭杂文二集·“题未定”草》：“但可怕的是大抵～，抹杀了作者真相的居多。”"},"similar":["鼠目寸光"],"usage":"作谓语、定语；用于书面语"},{"id":33613,"word":"眼内无珠","pinyin":"yǎn nèi wú zhū","abbr":"ynwz","explanation":"比喻不识货或看不出好坏。","source":{"text":"妾椟中有玉，恨郎眼内无珠。","book":"明·冯梦龙《警世通言》第32卷"},"similar":["有眼无珠"],"usage":"作谓语、定语；同“有眼无珠”"},{"id":33614,"word":"眼去眉来","pinyin":"yǎn qù méi lái","abbr":"yqml","explanation":"原指眼前见到的。后形容用眉眼传情。","source":{"text":"落日苍茫，风才定，片帆无力。还记得眉来眼去，水光山色。","book":"宋·辛弃疾《满江红·赣州席上呈太守陈季陵侍郎》"},"example":{"text":"～常骋俊，前攀后拽夸身分。","book":"元·王哲《渔父咏》词"},"similar":["眉来眼去"],"usage":"作谓语、定语、状语；指眉目传情"},{"id":33615,"word":"眼大肚小","pinyin":"yǎn dà dù xiǎo","abbr":"yddx","explanation":"比喻人眼光高，肚量小。","example":{"text":"他～，我们不必计较那么多。"},"usage":"作谓语、定语；用于比喻句"},{"id":33616,"word":"眼尖手快","pinyin":"yǎn jiān shǒu kuài","abbr":"yjsk","explanation":"眼力好，动作快。","source":{"text":"地保眼尖手快，隔桌子一手把阿金捞着。","book":"沈从文《阿金》"},"similar":["眼明手快","眼明手捷"],"usage":"作谓语、定语、宾语；指人反应快"},{"id":33617,"word":"眼底无人","pinyin":"yǎn dǐ wú rén","abbr":"ydwr","explanation":"眼睛里没有别人。形容狂傲自大，瞧不起人","source":{"text":"那两个是嫡亲兄弟……多是少年豪气，眼底无人之辈。","book":"明·凌濛初《二刻拍案惊奇》第九卷"},"example":{"text":"清·吴璿《飞龙全传》第31回：“他自恃斧精力勇，惯战能征，～，藐视天下没有好汉。”"},"similar":["目中无人"],"usage":"作谓语、定语、状语；用于处事"},{"id":33618,"word":"眼开眉展","pinyin":"yǎn kāi méi zhǎn","abbr":"ykmz","explanation":"形容极度高兴。","source":{"text":"坐在船上摇动着，也可以说‘五步一小变，十步一大变’的，却处处使人眼开眉展，爽神悦目。","book":"许钦文《鉴湖风景如画》"},"usage":"作谓语、定语；用于处事"},{"id":33619,"word":"眼张失落","pinyin":"yǎn zhāng shī luò","abbr":"yzsl","explanation":"形容神色慌张。","source":{"text":"严贡生转身走进舱来，眼张失落的，四面看了一遭。","book":"清·吴敬梓《儒林外史》第六回"},"example":{"text":"横头坐着一个少年，白净面皮，微微几根胡子，～在船上两边看女人。","book":"清·吴敬梓《儒林外史》第四十一回"},"usage":"作定语、状语；用于书面语"},{"id":33620,"word":"眼急手快","pinyin":"yǎn jí shǒu kuài","abbr":"yjsk","explanation":"形容做事机警敏捷。","source":{"text":"协达娃在旁边眼急手快……没等糌粑团子落到银娃错的身上，一伸手就把糌粑团子抢在手中。","book":"陈石峻《泽玛姬·金娃错和银娃错》"},"similar":["眼疾手快","眼尖手快"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33621,"word":"眼想心思","pinyin":"yǎn xiǎng xīn sī","abbr":"yxxs","explanation":"心中思念，眼中流露出思念的神情","source":{"text":"眼想心思梦里惊，无人知我此时情。","book":"唐·无名氏《杂词》"},"usage":"作宾语、定语；用于书面语"},{"id":33622,"word":"眼意心期","pinyin":"yǎn yì xīn qī","abbr":"yyxq","explanation":"双方以眼传情，心期相许。","source":{"text":"眼意心期卒未休，暗中终拟约秦楼。","book":"唐·韩偓《香奁集·青春》"},"example":{"text":"两个～，已在不言之表。","book":"明·兰陵笑笑生《金瓶梅词话》第十三回"},"similar":["眼约心期"],"usage":"作谓语、定语；用于书面语"},{"id":33623,"word":"眼明心亮","pinyin":"yǎn míng xīn liàng","abbr":"ymxl","explanation":"心里明白，眼睛雪亮。形容看问题敏锐，能辨别是非。","example":{"text":"他～，不会上你的当的。"},"similar":["心明眼亮"],"usage":"作谓语、定语；同“心明眼亮”"},{"id":33624,"word":"眼明手快","pinyin":"yǎn míng shǒu kuài","abbr":"ymsk","explanation":"看得准，动作敏捷。","source":{"text":"想起俺少时节，眼明手捷，体快身轻。","book":"元·无名氏《盆儿鬼》第三折"},"example":{"text":"到了此时，我方才佩服那广东人的～，机警非常。","book":"清·吴趼人《二十年目睹之怪现状》第二回"},"similar":["手疾眼快","眼疾手快"],"opposite":["愚笨如驴","呆头呆脑"],"usage":"作谓语、定语、宾语；指人反应快"},{"id":33625,"word":"眼明手挗","pinyin":"yǎn míng shǒu jié","abbr":"ymsj","explanation":"眼睛明亮，手脚利落。形容看得准，动作敏捷。","source":{"text":"想起俺少时节，眼明手捷，体快身轻。","book":"元·无名氏《盆儿鬼》第三折"}},{"id":33626,"word":"眼明手捷","pinyin":"yǎn míng shǒu jié","abbr":"ymsj","explanation":"看得准，下手快。形容人反应快，动作敏捷。","source":{"text":"想起俺少时节，眼明手捷，体快身轻。","book":"元·无名氏《盆儿鬼》第三折"},"similar":["眼明手快","眼尖手快"],"usage":"作谓语、定语；指人反应快"},{"id":33627,"word":"眼泪汪汪","pinyin":"yǎn lèi wāng wāng","abbr":"ylww","explanation":"眼中饱含泪水。形容人十分激动或悲痛。","source":{"text":"那史湘云只是眼泪汪汪的，见有他家人在跟前，又不敢十分委曲。","book":"清·曹雪芹《红楼梦》第36回"},"example":{"text":"余华《活着》：“他和我一样～，赤着皮肉裂开的脚走过来。”"},"similar":["泪眼朦朦"],"opposite":["喜笑颜开"],"usage":"作谓语、定语、状语；用于激动、悲痛时"},{"id":33628,"word":"眼泪洗面","pinyin":"yǎn lèi xǐ miàn","abbr":"ylxm","explanation":"形容忧愁悲伤，泪流满面。","source":{"text":"又韩玉汝家，有李国主归朝后与金陵旧宫人书云：‘此中日夕，只以眼泪洗面。’","book":"宋·陆游《避暑漫抄》"},"similar":["泪流满面"],"usage":"作谓语、定语；用于处事"},{"id":33629,"word":"眼疾手快","pinyin":"yǎn jí shǒu kuài","abbr":"yjsk","explanation":"形容做事机警敏捷。","source":{"text":"倘或被眼疾手快的拿了送官，如之奈何？","book":"明·施耐庵《水浒传》第四十三回"},"example":{"text":"走在他旁边的郭根泉～，一把将它抱住。","book":"袁静《伏虎记》第十四回"},"similar":["手疾眼快"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33630,"word":"眼皮子浅","pinyin":"yǎn pí zǐ qiǎn","abbr":"ypzq","explanation":"见识浅，眼光短。","example":{"text":"～的人是没有大的收益的。"},"similar":["目光短浅"],"opposite":["深谋远虑"],"usage":"作谓语、定语；用于口语"},{"id":33631,"word":"眼皮子薄","pinyin":"yǎn pí zǐ báo","abbr":"ypzb","explanation":"比喻气量小，喜欢斤斤计较。","example":{"text":"他这个人～，过分计较个人得失。"},"usage":"作谓语、定语；用于口语"},{"id":33632,"word":"眼瞎耳聋","pinyin":"yǎn xiā ěr lóng","abbr":"yxel","explanation":"看不见也听不到。比喻对周围情况完全不了解","source":{"text":"日本鬼子眼瞎耳聋，就靠汉奸给他当拐棍。","book":"京剧《平原作战》第八场"},"usage":"作谓语、定语；用于口语"},{"id":33633,"word":"眼福不浅","pinyin":"yǎn fú bù qiǎn","abbr":"yfbq","explanation":"指有幸能见到许多珍奇事物。","example":{"text":"就算清凉寺中真有几位美貌娘子，让大伙瞻仰瞻仰，那也是～哪。","book":"金庸《鹿鼎记》第十七回"}},{"id":33634,"word":"眼空一世","pinyin":"yǎn kōng yī shì","abbr":"ykys","explanation":"整个时代的人都不放在眼里","source":{"text":"腹饱万言，眼空一世。","book":"明·冯梦龙《醒世恒言》第11卷"},"similar":["目空一切"],"usage":"作谓语、定语；用于处事"},{"id":33635,"word":"眼空四海","pinyin":"yǎn kōng sì hǎi","abbr":"yksh","explanation":"形容自高自大，什么都看不见。","source":{"text":"渠眼空四海，而又肯随人脚跟走乎？","book":"明·李贽《答耿司寇书》"},"example":{"text":"谁要说五老爷情性总是～，目中无人。","book":"《小五义》第112回"},"similar":["目空一切"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指人自高自大"},{"id":33636,"word":"眼空心大","pinyin":"yǎn kōng xīn dà","abbr":"ykxd","explanation":"形容骄傲自大，目中无人。","source":{"text":"他素昔眼空心大，是个头等刁钻古怪东西。","book":"清·曹雪芹《红楼梦》第二十七回"}},{"id":33637,"word":"眼穿心死","pinyin":"yǎn chuān xīn sǐ","abbr":"ycxs","explanation":"眼穿：望眼欲穿；心死：心如死灰。眼睛望穿，心也死了。形容殷切的盼望落空而极度失望。","source":{"text":"西忆岐阳信，无人遂却回。眼穿当落日，心死着寒灰。","book":"唐·杜甫《喜达行在所三首》诗"},"example":{"text":"职无任～之至。","book":"明·袁宏道《去吴七牍·乞改稿二》"},"usage":"作定语、状语；用于书面语"},{"id":33638,"word":"眼穿肠断","pinyin":"yǎn chuān cháng duàn","abbr":"yccd","explanation":"眼穿：望眼欲穿。眼欲望穿，肠欲盼断。形容盼望、相思之极。","source":{"text":"当初不合轻分散，及至厌厌独自个，却眼穿肠断。","book":"宋·柳永《安公子》词"},"example":{"text":"～，如今千种，思量无奈。","book":"宋·欧阳修《鼓笛慢》词"},"usage":"作定语、状语；形容盼望之极"},{"id":33639,"word":"眼笑眉舒","pinyin":"yǎn xiào méi shū","abbr":"yxms","explanation":"舒：伸展。眼里流露出欢笑的神情，眉毛舒展。形容非常高兴","source":{"text":"渔得鱼心满愿足，樵得樵眼笑眉舒。","book":"元·胡祗遹《沉醉东风》曲"},"similar":["眼笑眉飞"],"usage":"作谓语、定语、状语；用于处事"},{"id":33640,"word":"眼笑眉飞","pinyin":"yǎn xiào méi fēi","abbr":"yxmf","explanation":"形容极度高兴。","source":{"text":"只乐得他手舞足蹈，眼笑眉飞。褚一官等在旁看了，也自欢喜。","book":"清·文康《儿女英雄传》第十五回"},"similar":["眼笑眉舒"],"usage":"作谓语、定语、状语；用于处事"},{"id":33641,"word":"眼约心期","pinyin":"yǎn yuē xīn qī","abbr":"yyxq","explanation":"期：期望。眼中意会，心中期许。指嘴上虽然没说话，但双方的目光交流，心意相通","source":{"text":"玉纤寒试调筝雁，眼约心期不暂闲。","book":"元·张可久《沉醉东风·夜宴即事》曲"},"similar":["眼意心期"],"usage":"作谓语、定语；用于书面语"},{"id":33642,"word":"眼腰黄赤","pinyin":"yǎn yāo huáng chì","abbr":"yyhc","explanation":"黄：金色的腰带；赤：红色的官服。眼前是红色的官服，腰中是金色的腰带。指荣华富贵","source":{"text":"雪鬓霜髭不管，管眼腰黄赤。","book":"宋·刘克庄《好事近·壬戍生日和居厚弟》词"},"usage":"作宾语、定语；用于书面语"},{"id":33643,"word":"眼花历乱","pinyin":"yǎn huā lì luàn","abbr":"yhll","explanation":"历乱：不清楚，混乱。形容看见美丽、复杂的色彩或繁复的事物而感到迷乱","source":{"text":"参成世界总游魂，错认讹闻各有因。最是天公施巧处，眼花历乱使人浑。","book":"明·凌濛初《初刻拍案惊奇》第36卷"},"usage":"作谓语、定语；用于书面语"},{"id":33644,"word":"眼花心乱","pinyin":"yǎn huā xīn luàn","abbr":"yhxl","explanation":"形容心神迷惑不定。","source":{"text":"这厮虽然奸猾，也骗得他眼花心乱了。","book":"明·施耐庵《水浒传》第五十九回"},"usage":"作定语、状语；用于书面语"},{"id":33645,"word":"眼花撩乱","pinyin":"yǎn huā liáo luàn","abbr":"yhll","explanation":"撩乱：同“缭乱”，纷乱。形容看见美丽、复杂的色彩或繁复的事物而感到迷乱","source":{"text":"颠不刺的见了万千，似这般可喜娘的宠儿罕曾见，则着人眼花撩乱口难言，魂灵飞在半天。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"清·李汝珍《镜花缘》第38回：“小弟看来看去，只觉～，辨不明白。”"},"similar":["眼花缭乱"],"usage":"作谓语、定语、状语；形容事物纷杂"},{"id":33646,"word":"眼花缭乱","pinyin":"yǎn huā liáo luàn","abbr":"yhll","explanation":"形容看见美色或繁复新奇的事物而感到迷乱。","source":{"text":"颠不刺的见了万千，似这般可喜娘的庞儿罕曾见，则着人眼花撩乱口难言，魂灵儿飞在半天。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"其余这些国王，除了我们到过的，内中许多奇形怪状，小弟看来看去，只觉～，辨不明白。","book":"清·李汝珍《镜花缘》第三十八回"},"similar":["目不暇接","头昏眼花","扑朔迷离"],"opposite":["一目了然"],"usage":"作谓语、定语、状语；形容事物纷杂"},{"id":33647,"word":"眼花耳热","pinyin":"yǎn huā ěr rè","abbr":"yher","explanation":"两眼昏眩，双耳燥热。形容饮酒微醉时的感觉。","source":{"text":"眼花耳热后，意气素霓生。","book":"唐·李白《侠客行》诗"},"example":{"text":"～言语多，霍然已醒如过烧。","book":"宋·陆游《野饮》诗"},"similar":["耳热眼花"],"usage":"作谓语、状语；用于书面语"},{"id":33648,"word":"眼花雀乱","pinyin":"yǎn huā què luàn","abbr":"yhql","explanation":"形容看见美色或繁复新奇的事物而感到迷乱。","source":{"text":"行者急回头，炒得眼花雀乱，忍不住泪落如雨。","book":"明·吴承恩《西游记》第四十一回"},"similar":["眼花缭乱","眼花撩乱"],"usage":"作谓语、定语、状语；形容事物纷杂"},{"id":33649,"word":"眼见为实，耳听为虚","pinyin":"yǎn jiàn wéi shí，ěr tīng wéi xū","abbr":"yjwsetwx","explanation":"亲眼看到才算是真实的，听来的传闻是靠不住的。","source":{"text":"夫耳闻之，不如目见之；目见之，不如足践之。","book":"汉·刘向《说苑·政理》"}},{"id":33650,"word":"眼观六路","pinyin":"yǎn guān liù lù","abbr":"ygll","explanation":"眼睛看到四面八方。形容机智灵活，遇事能多方观察，全面了解。","source":{"text":"为将之道，身临战场，务要眼观四处，耳听八方。","book":"明·许仲琳《封神演义》第53回"},"example":{"text":"要是没有一种～，耳听八方到处显出精明强干的能力，任凭你有天好的本事，满肚子的学问。","book":"老舍《赵子曰》"},"similar":["八面玲珑","高瞻远瞩"],"opposite":["坐井观天","管中窥豹"],"usage":"作谓语、定语；指能全面了解"},{"id":33651,"word":"眼观六路，耳听八方","pinyin":"yǎn guān liù lù，ěr tīng bā fāng","abbr":"yglletbf","explanation":"六路：指上、下、四方；八方：指东、南、西、北、东南、西南、西北、东北。形容人机智灵活，遇事能多方观察分析。","source":{"text":"我不是笨人，眼观六路，耳听八方，不如咱走吧。","book":"清·李绿园《歧路灯》第43回"},"example":{"text":"要是没有一种～，到处显出精明强干的能力，任凭有天大的本事。","book":"老舍《赵子曰》"},"similar":["眼观四处，耳听八方"],"usage":"作定语、分句；可分开使用"},{"id":33652,"word":"眼观四处，耳听八方","pinyin":"yǎn guān sì chù，ěr tīng bā fāng","abbr":"ygscetbf","explanation":"形容人机智灵活，遇事能多方观察分析。","source":{"text":"为将之道，身临战场，务要眼观四处，耳听八方。","book":"明·许仲琳《封神演义》第53回"},"example":{"text":"他得有灵敏的感觉，～。","book":"洪深《电影戏剧表演术》第六章"},"similar":["眼观六路，耳听八方"],"usage":"作定语、分句；指遇事能多方观察分析"},{"id":33653,"word":"眼观四路，耳听八方","pinyin":"yǎn guān sì lù，ěr tīng bā fāng","abbr":"ygsletbf","explanation":"形容人机智灵活，遇事能多方观察分析。","source":{"text":"强盗的本领，讲的是观六路，耳听八方。","book":"清·文康《新儿女英雄传》"},"example":{"text":"金香，你捡煤核要放聪明点，得～，……碰见了那些嘎七马八的日本腿子们就躲开。","book":"吴祖光《闯江湖》"}},{"id":33654,"word":"眼观鼻，鼻观心","pinyin":"yǎn guān bí，bí guān xīn","abbr":"ygbbgx","explanation":"古代静坐集中注意力的方法。指精神集中，心不旁骛的神态","source":{"text":"那安公子羞得面红过耳，眼观鼻，鼻观心的答应了一声。","book":"清·文康《儿女英雄传》第四回"},"example":{"text":"《花城》1981年第3期：“做丈夫的低着头，～，只管抽烟。”"},"usage":"作定语、状语；用于处事"},{"id":33655,"word":"眼角眉梢","pinyin":"yǎn jiǎo méi shāo","abbr":"yjms","explanation":"指面部的细微表情。","source":{"text":"眼角眉梢都似恨，热泪欲零还住。","book":"毛泽东《贺新郎·别友》"},"similar":["眼角眉梢"],"usage":"作宾语、定语；用于人"},{"id":33656,"word":"眼语颐指","pinyin":"yǎn yǔ yí zhǐ","abbr":"yyyz","explanation":"颐指：以下巴的动向示意。用眼色或下巴的动向示意","source":{"text":"监不开口明说，止于膝上或案下用右手食指作画字写字形，或眼语颐指，非久侍者不能通其意。","book":"明·刘若愚《酌中志·正监蒙难纪略》"},"similar":["目指颐使"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33657,"word":"眼跳心惊","pinyin":"yǎn tiào xīn jīng","abbr":"ytxj","explanation":"眼皮跳动，内心惊恐。形容感到不安、害怕","source":{"text":"好生奇怪，吓得眼跳心惊，把个舌头伸出，半晌还缩不进去。","book":"明·冯梦龙《醒世恒言》第25卷"},"usage":"作定语、状语；用于处事"},{"id":33658,"word":"眼跳耳热","pinyin":"yǎn tiào ěr rè","abbr":"yter","explanation":"眼皮跳动，耳根发热。迷信的人认为是不祥之兆。","source":{"text":"姬昌眼跳耳热，心神不安。姬昌忧占一课，占一亲人合有大祸临身。","book":"元·无名氏《武王伐纣平话》卷中"},"usage":"作谓语、定语、状语；用于处事"},{"id":33659,"word":"眼迷心荡","pinyin":"yǎn mí xīn dàng","abbr":"ymxd","explanation":"眼光迷乱，心神摇荡。形容见到美色而不能自持的神情","source":{"text":"那院判一见了小娟，真个眼迷心荡。","book":"明·凌濛初《初刻拍案惊奇》第25卷"},"usage":"作谓语、定语；用于处事"},{"id":33660,"word":"眼里揉不下沙子","pinyin":"yǎn lǐ róu bù xià shā zi","abbr":"ylrbxsz","explanation":"眼睛里不能揉下去沙子。比喻不能容忍不合理、不公平的事。","source":{"text":"奶奶宽洪大量，我却眼里揉不下沙子去。","book":"清·曹雪芹《红楼梦》第六十九回"},"similar":["眼不著砂"],"usage":"作谓语、定语；用于处事"},{"id":33661,"word":"眼错不见","pinyin":"yǎn cuò bù jiàn","abbr":"ycbj","explanation":"错：交错。一眨眼的功夫没看见。","source":{"text":"想那日我眼错不见一会，不知是那一个没调教的，只图讨你的好儿，不管别人死活，给了你一口酒吃，葬送的我挨了两日骂。","book":"清·曹雪芹《红楼梦》第八回"},"example":{"text":"老太太的一个新新的大红猩猩毡斗篷放在那里，谁知～他就披了，又大又长。","book":"清·曹雪芹《红楼梦》第三十一回"}},{"id":33662,"word":"眼饧耳热","pinyin":"yǎn xíng ěr rè","abbr":"yter","explanation":"两眼半睁半闭，朦胧而视，双耳燥热。形容饮酒微醉时的感觉。","source":{"text":"至晚饭后，宝玉因吃了两杯酒，眼饧耳热之际，若往日则有袭人等大家喜笑有兴，今日却冷清清的一人对灯，好没兴趣。","book":"清·曹雪芹《红楼梦》第二十一回"}},{"id":33663,"word":"眼饧骨软","pinyin":"yǎn xíng gǔ ruǎn","abbr":"ytgr","explanation":"眼饧：眼色朦胧。视觉模糊，骨节酥软。形容迷矇疲倦的神态。","source":{"text":"刚至房中，便有一股细细的甜香。宝玉此时便觉眼饧骨软，连说：‘好香！’","book":"清·曹雪芹《红楼梦》第五回"}},{"id":33664,"word":"眼饱肚饥","pinyin":"yǎn bǎo dù jī","abbr":"ybdj","explanation":"眼睛看个够，肚子依然饿得慌。比喻只能饱饱眼福，不解决实际问题。","source":{"text":"那孙家里摆的好席面，只是我刘封没造化，单只看的一看，做了眼饱肚中饥哩。","book":"元·无名氏《隔江斗智》第四折"},"example":{"text":"若只如此空砑光，～，有何用处！","book":"明·冯梦龙《醒世恒言》卷十六"}},{"id":33665,"word":"眼馋肚饱","pinyin":"yǎn chán dù bǎo","abbr":"ycdb","explanation":"形容人贪得无厌。","source":{"text":"往苏州走了一趟回来，也该见点世面了，还是这幺眼馋肚饱的。","book":"清·曹雪芹《红楼梦》第16回"},"similar":["贪得无厌"],"usage":"作谓语、定语；指人贪得无厌"},{"id":33666,"word":"眼高于天","pinyin":"yǎn gāo yú tiān","abbr":"ygyt","explanation":"眼高：眼界很高。眼界高过天。比喻眼界极高。也比喻骄傲自大，目中无人。","source":{"text":"你们这一班军装大买办，平日眼高于天，何尝有个朋友在心上！","book":"清·吴趼人《二十年目睹之怪现状》第六十六回"},"similar":["目中无人"],"usage":"作谓语、定语；用于书面语"},{"id":33667,"word":"眼高于顶","pinyin":"yǎn gāo yú dǐng","abbr":"ygyd","explanation":"眼界高过头顶。比喻眼光锐利，识别能力非常高强。也比喻骄傲自大，目中无人。","source":{"text":"令爱惟聪明，所以能为聪明之事；惟有礼，所以能为守礼之人。故其眼高于顶，所择之人，不惟自己得所，并小女俱得其所。","book":"清·烟霞散人《凤凰池》第十五回"},"example":{"text":"你自今以后须要处处留心，不要这样的～，终久没有什么好处的。","book":"清·张春帆《九尾龟》第一百八十九回"}},{"id":33668,"word":"眼高手低","pinyin":"yǎn gāo shǒu dī","abbr":"ygsd","explanation":"眼力过高，手法过低。指要求的标准很高（甚至不切实际），但实际上自己也做不到。","source":{"text":"譬操觚家一味研穷休理，不轻下笔，终是眼高手生，鲜能入彀。","book":"清·陈确《与吴仲木书》"},"example":{"text":"这叫做～，志大才疏，没有结果的。","book":"毛泽东《反对党八股》"},"similar":["志大才疏","不自量力","好高骛远"],"opposite":["实事求是","量力而行"],"usage":"作谓语、宾语、定语；指人动手能力差"},{"id":33669,"word":"眼高手拙","pinyin":"yǎn gāo shǒu zhuō","abbr":"ygsz","explanation":"眼高：眼界很高，观察事物的水平高；拙：低劣，笨。指人徒有眼力，而实际能力低下。","source":{"text":"大抵此老学淹才短，眼高手拙，每求甚佳处不可得，辄恨恨不已。","book":"清·张谦宜《絸斋诗谈·毛稚黄》"}},{"id":33670,"word":"眼高手生","pinyin":"yǎn gāo shǒu shēng","abbr":"ygss","explanation":"眼界高但能力低。","source":{"text":"譬操觚家一味研穷体理，不轻下笔，终是眼高手生，鲜能入彀。","book":"清·陈确《与吴仲木书》"},"similar":["眼高手低"],"usage":"作谓语、定语；用于书面语"},{"id":33671,"word":"着三不着两","pinyin":"zháo sān bù zháo liǎng","abbr":"zsbzl","explanation":"指说话或做事轻重不当，考虑欠周，注意这里，顾不到那里。","source":{"text":"那珍大爷管儿子，倒也象当日老祖宗的规矩，只是着三不着两的。","book":"清·曹雪芹《红楼梦》第四十五回"},"usage":"作谓语、定语、状语；用于口语"},{"id":33672,"word":"着书立说","pinyin":"zhù shū lì shuō","abbr":"zsls","explanation":"着：写作；立：成就；说：学说。写书或文章，创立自己的学说。","source":{"text":"将南京元（玄）武湖赐与庄尚志着书立说，鼓吹休明。","book":"清·吴敬梓《儒林外史》第35回"},"example":{"text":"乃吾一切先哲～之宗旨。","book":"冯友兰《自序》"}},{"id":33673,"word":"着人先鞭","pinyin":"zhuó rén xiān biān","abbr":"zrxb","explanation":"比喻做事情比别人抢先一步。","source":{"text":"与范阳祖逖为友。闻逖被用，与亲故书曰：‘吾枕戈待旦，志枭逆虏；常恐祖生先吾着鞭。’","book":"《晋书·刘琨传》"},"similar":["先人着鞭"],"usage":"作谓语；指比别人快"},{"id":33674,"word":"着屐登山","pinyin":"zhuó jī dēng shān","abbr":"zjds","explanation":"屐：木头鞋。穿着木头鞋登山。形容历尽艰辛","source":{"text":"寻山陟岭，必造幽峻，岩嶂千重，莫不备尽。登蹑常着木屐，上山则去前齿，下山去其后齿。","book":"《宋书·谢灵运传》"},"usage":"作宾语、定语；用于比喻句"},{"id":33675,"word":"着意栽花花不发，无意插柳柳成荫","pinyin":"zhuó yì zāi huā huā bù fā，wú yì chā liǔ liǔ chéng yīn","abbr":"zyzhhbfwycllcy","explanation":"着意：用心。有心栽种的花没开，无意插下的柳枝却成了一片柳荫。比喻存心想求得的没得到，不经意的却意外地取得了收获","source":{"text":"着意栽花花不发，等闲插柳柳成荫。","book":"元·关汉卿《鲁斋郎》第二折"},"similar":["有意栽花花不发，无意插柳柳成荫"],"usage":"作宾语、定语、分句；用于书面语"},{"id":33676,"word":"着手回春","pinyin":"zhuó shǒu huí chūn","abbr":"zshc","explanation":"指诗歌格调自然清新。也比喻医术高明。","source":{"text":"他想起来高一功的情况不妙，尚炯回来也许会着手回春。","book":"姚雪垠《李自成》第一卷第13章"},"similar":["妙手回春"],"usage":"作谓语、定语、宾语；指医术"},{"id":33677,"word":"着手成春","pinyin":"zhuó shǒu chéng chūn","abbr":"zscc","explanation":"着手：动手。一着手就转成春天。原指诗歌要自然清新。后比喻医术高明，刚一动手病情就好转了。","source":{"text":"俯拾即是，不取诸邻，俱道适往，著手成春。如逢花开，如瞻岁新。","book":"唐·司空图《二十四诗品·自然》"},"example":{"text":"不仅难治的病～，而且还有起死回生的大力。","book":"郭沫若《孔墨的批判》"},"similar":["妙手回春","手到病除","起死回生"],"usage":"作谓语、定语、宾语；指医术"},{"id":33678,"word":"睁一只眼，闭一只眼","pinyin":"zhēng yī zhī yǎn，bì yī zhī yǎn","abbr":"zyzybyzy","explanation":"比喻对应该阻止的事情佯装没见，姑息纵容。","source":{"text":"你老人家乡里姐姐嫁郑恩──睁着个眼儿，闭着个眼儿罢了。","book":"明·兰陵笑笑生《金瓶梅词话》第三十九回"}},{"id":33679,"word":"睁只眼，闭只眼","pinyin":"zhēng zhī yǎn，bì zhī yǎn","abbr":"zzybzy","explanation":"佯为不见，故意不睬，比喻遇事容忍迁就，逃避斗争。","example":{"text":"我们不能对他经常旷课～。"},"opposite":["擦亮眼睛"],"usage":"作谓语、宾语、分句；指假装没看见"},{"id":33680,"word":"睁目张须","pinyin":"zhēng mù zhāng xū","abbr":"zmzx","explanation":"瞪起眼，胡须竖起。形容怒气冲天的神态。","example":{"text":"他已被我气得～了。"},"usage":"作定语、状语；用于人愤怒的神态"},{"id":33681,"word":"睁眼瞎子","pinyin":"zhēng yǎn xiā zǐ","abbr":"zyxz","explanation":"比喻文盲。","source":{"text":"他家人老几辈子没出过一个先生，睁眼瞎受了多少气啊！","book":"路遥《平凡的世界》第一卷第八章"},"example":{"text":"我们要普及扫盲教育，尽快消灭那些～。"},"similar":["睁眼瞎"],"usage":"作主语、宾语、定语；用于口语"},{"id":33682,"word":"睚眦之嫌","pinyin":"yá zì zhī xián","abbr":"yzzx","explanation":"睚：眼眶；眦：眼角；睚眦：生气瞪眼。别人瞪眼这样小的怨恨","source":{"text":"冀四娘念手足之义，而忘睚眦之嫌。","book":"清·蒲松龄《聊斋志异·胡四娘》"},"similar":["睚眦之隙","睚眦之怨","睚眦之恨"],"usage":"作主语、宾语；用于书面语"},{"id":33683,"word":"睚眦之忿","pinyin":"yá zì zhī fèn","abbr":"yzzf","explanation":"睚：眼眶；眦：眼角；睚眦：生气瞪眼。别人瞪眼这样小的怨恨","source":{"text":"自此诸为怨隙者，因相陷害，睚眦之忿，滥入党中。","book":"南朝·宋·范晔《后汉书·党锢传序》"},"similar":["睚眦之恨","睚眦之怨","睚眦之隙"],"usage":"作主语、宾语；用于书面语"},{"id":33684,"word":"睚眦之怒","pinyin":"yá zì zhī nù","abbr":"yzzn","explanation":"睚：眼眶；眦：眼角；睚眦：生气瞪眼；怒：生气。生点小气","source":{"text":"台谏李知孝、莫泽奉承风旨，凡平日睚眦之怒，悉指以从伪，弹劾无虚日。","book":"宋·周密《齐东野语·巴陵本末》"},"usage":"作主语、宾语；用于书面语"},{"id":33685,"word":"睚眦之怨","pinyin":"yá zì zhī yuàn","abbr":"yzzy","explanation":"睚眦：发怒时瞪眼睛。像瞪眼看人这样的小怨。引申为极小的怨恨。","source":{"text":"一饭之德必偿，睚眦之怨必报。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"鲁迅《华盖集续编·再来一次》：“我那时和这位后来称为‘孤桐先生’的，也毫无‘～’。”"},"similar":["睚眦之恨","睚眦之隙","睚眦之嫌"],"usage":"作主语、宾语；用于书面语","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相魏齐。范雎含冤被打伤，改名张禄逃到秦国当上宰相。须贾出使秦国，范雎扮作穷人去见他。须贾见状就送他一件绨袍，发现他是秦相时吓得谢罪，范雎说对魏齐要睚眦必报"]},{"id":33686,"word":"睚眦之恨","pinyin":"yá zì zhī hèn","abbr":"yzzh","explanation":"睚眦：发怒时瞪眼睛。像瞪眼看人这样的小怨恨。比喻极小的怨恨。","source":{"text":"武伯南身为雅士，往者将军称之不容於口，今以睚眦之恨，乃成嫌隙。","book":"《三国志·魏志·胡质传》"},"example":{"text":"冤家路窄、积恨难消，令人不敢复念～也。","book":"清·陈忱《水浒后传》第二回"},"similar":["睚眦之忿","睚眦之怨","睚眦之隙"],"usage":"作主语、宾语；用于书面语"},{"id":33687,"word":"睚眦之私","pinyin":"yá zì zhī sī","abbr":"yzzs","explanation":"睚眦：发怒时瞪眼睛。像瞪眼看人这样的私怨。比喻极小的怨恨。","source":{"text":"一饭之德必偿，睚眦之怨必报。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"特们德尔恃其权宠，乘间肆毒，～，无不报复。","book":"清·毕沅《续资治通鉴》卷二百"}},{"id":33688,"word":"睚眦之隙","pinyin":"yá zì zhī xì","abbr":"yzzx","explanation":"睚眦：发怒时瞪眼睛；隙：嫌隙。像瞪眼看人这样的小嫌隙。比喻极小的怨恨。","source":{"text":"今争睚眦之隙，以成千钧之绚，民在涂炭，各不聊生，曾不改寤，遂成祸乱。","book":"《三国志·魏志·董卓传》"},"example":{"text":"当此南北交讧，奈何与市井细民，申勃谿之谈，修～乎。","book":"《明史·黄道周传》"},"similar":["睚眦之怨","睚眦之嫌","睚眦之忿"],"usage":"作主语、宾语；用于书面语"},{"id":33689,"word":"睚眦小忿","pinyin":"yá zì xiǎo fèn","abbr":"yzxf","explanation":"睚眦：发怒时瞪眼睛，引申为极小的怨恨。比喻极小的怨恨。","source":{"text":"一饭之德必偿，睚眦之怨必报。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"～久难忘，牙角频争雀鼠伤，一抹腮红还旧好，解纷惟有送槟榔。","book":"清·张湄《槟榔》"}},{"id":33690,"word":"睚眦必报","pinyin":"yá zì bì bào","abbr":"yzbb","explanation":"睚眦：发怒时瞪眼睛，借指极小的仇恨。象瞪一下眼睛那样极小的怨仇也要报复。比喻心胸极狭窄。","source":{"text":"一饭之德必偿，睚眦之怨必报。","book":"《史记·范睢蔡泽列传》"},"example":{"text":"瓒恃其才力，不恤百姓，记过忘善，～。","book":"《后汉书·公孙瓒传》"},"similar":["小肚鸡肠","睚眦小忿"],"opposite":["大度包容"],"usage":"作谓语、定语；指心胸狭隘","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相魏齐。范雎含冤被打伤，改名张禄逃到秦国当上宰相。须贾出使秦国，范雎扮作穷人去见他。须贾见状就送他一件绨袍，发现他是秦相时吓得一再谢罪。范雎说对魏齐要睚眦必报"]},{"id":33691,"word":"睚眦杀人","pinyin":"yá zì shā rén","abbr":"yzsr","explanation":"睚眦：发怒时瞪眼睛，引申为极小的怨恨。因极小的怨恨而行凶杀人。形容骄横不法。","source":{"text":"解布衣，为任侠行权，以睚眦杀人。","book":"《史记·游侠列传》"},"example":{"text":"解全未预闻，似应免罪，独公孙弘主张罪解，且说他私结党羽，～，大逆不道，例当族诛。","book":"蔡东藩《前汉演义》第六十六回"},"similar":["眦睚杀人"],"usage":"作谓语、宾语；用于书面语"},{"id":33692,"word":"睟面盎背","pinyin":"suì miàn àng bèi","abbr":"smab","explanation":"指德性表现于外，而有温润之貌，敦厚之态。指有德者的仪态。","source":{"text":"君子所性，仁义利智根於心。其生色也，睟然见於面，盎於背，施於四体，四体不言而喻。","book":"《孟子·尽心上》"},"example":{"text":"～，阳发其华，归根复命，阴结其根也。","book":"宋·袁甫《马实夫君子堂记》"},"usage":"作谓语、定语；指道德修养到家"},{"id":33693,"word":"睠顾回隐","pinyin":"juàn gù huí yǐn","abbr":"jghy","explanation":"睠：留恋。既眷恋世俗生活又想逃隐。","source":{"text":"乃欲睠顾回隐以市于世，其可乎？","book":"宋·曾巩《抚州颜鲁公祠堂记》"}},{"id":33694,"word":"睡卧不宁","pinyin":"shuì wò bù níng","abbr":"swbn","explanation":"形容心绪繁乱，不能安定。","source":{"text":"这几日睡卧不宁，饮食少进，给假在驿亭中将息。","book":"元·王实甫《西厢记》第五本第二折"},"similar":["坐立不安"],"usage":"作谓语、定语、状语；用于处事"},{"id":33695,"word":"睡意朦胧","pinyin":"shuì yì méng lóng","abbr":"syml","explanation":"朦胧：模糊不清。形容双眼模糊不清的样子。","source":{"text":"间或有一、二家小商店的学徒在睡意朦胧的半张着眼去下那门板。","book":"丁玲《1930年春上海》"},"similar":["睡眼朦胧"],"usage":"作谓语、定语、状语；指没睡醒"},{"id":33696,"word":"睡生梦死","pinyin":"shuì shēng mèng sǐ","abbr":"ssms","explanation":"整天像在睡梦里一样。形容糊里糊涂地生活。","source":{"text":"妇人道：‘他逐日睡生梦死，奴那里耐烦和他干这营生。’","book":"《金瓶梅词话》第十七回"},"similar":["醉生梦死"],"usage":"作谓语、定语、状语；指人的处世态度"},{"id":33697,"word":"睡眼惺忪","pinyin":"shuì yǎn xīng sōng","abbr":"syxs","explanation":"惺忪：刚苏醒的样子。形容睡觉的人刚睡醒，还没有完全清醒。","source":{"text":"街道上的行人还不多；所遇见的不过是睡眼惺忪的女人，在井边打水。","book":"鲁迅《故事新编·采薇》"},"example":{"text":"都十点了，你还～的。"},"similar":["睡眼朦胧"],"usage":"作谓语、定语；指人刚睡醒"},{"id":33698,"word":"睡眼朦胧","pinyin":"shuì yǎn méng lóng","abbr":"syml","explanation":"朦胧：模糊不清。形容双眼模糊不清的样子。","source":{"text":"宝玉睡眼朦胧，接在手里也没瞧，便往地下一撂道：‘你们又来哄我了。’","book":"清·曹雪芹《红楼梦》第95回"},"example":{"text":"魏翩仞～，也没有听清，只是揉眼睛。","book":"清·李宝嘉《官场现形记》第八回"},"similar":["睡意朦胧"],"usage":"作谓语、定语、状语；指没睡醒"},{"id":33699,"word":"睡长梦多","pinyin":"shuì cháng mèng duō","abbr":"szmd","explanation":"犹夜长梦多。比喻时间长，事情易生变化。","source":{"text":"所长，毛遂自荐，我当大媒好了！事情是越快越好，睡长梦多！","book":"老舍《四世同堂》四四"},"similar":["夜长梦多"],"usage":"作谓语、定语、宾语；用于口语"},{"id":33700,"word":"睥睨一世","pinyin":"pì nì yī shì","abbr":"pnys","explanation":"睨：斜视，有傲慢的意思。形容目空一切，不可一世。","source":{"text":"与达者数子，论道讲书，俯仰二仪，错综人物，弹《南风》之雅操，发商之妙曲。消摇一世之上，睥睨天地之间。","book":"《后汉书·仲长统传》"},"example":{"text":"雱气豪，～，不能作小官。","book":"《宋史·王雱传》"}},{"id":33701,"word":"睥睨一切","pinyin":"pì nì yī qiè","abbr":"pnyq","explanation":"形容非常高傲，看不起任何人。","source":{"text":"惟性气高傲，不欲下人，才具素长，睥睨一切，当世名公巨卿，鲜有入其目者。","book":"清·张集馨《道咸宦海见闻录》"},"example":{"text":"毛仲系官奴出身，也居然得此美官，怎能不趾高气扬，～？","book":"蔡东蕃《唐史演义》第四十五回"},"similar":["目空一切"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语、状语；用于处世等"},{"id":33702,"word":"睥睨物表","pinyin":"pì nì wù biǎo","abbr":"pnwb","explanation":"睥睨：斜视，有傲慢的意思；物表：物外，世俗之外。傲视一切，超然物外。","source":{"text":"文身跣足，欣然而立，睥睨物表，真是眼高四海而游方之外者。","book":"宋·无名氏《宣和画谱·草书七·神仙钟离权》"},"similar":["傲睨一切"],"usage":"作谓语、定语；指人高傲"},{"id":33703,"word":"睥睨窥觎","pinyin":"bì nì kuī yú","abbr":"pnky","explanation":"睥睨：侧目观察；窥觎：偷视可乘之机。暗中察看，希图乘机得手。","source":{"text":"总戎马之权，居形势之地，有睥睨窥觎之意。","book":"《宣和书谱·秋月帖》"},"usage":"作定语；指寻找可乘之机"},{"id":33704,"word":"睹始知终","pinyin":"dǔ shǐ zhī zhōng","abbr":"dszz","explanation":"指看见事物的开始阶段就预见到它的最终结果。","source":{"text":"故圣人见微知著，睹始知终。","book":"汉·袁康《越绝书·德序外传记》"},"similar":["见微知著"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":33705,"word":"睹影知竿","pinyin":"dǔ yǐng zhī gān","abbr":"dyzg","explanation":"看竹竿的影子，便知道竹竿的曲直长短。比喻从侧面的现象，便可了解事情的真貌。","source":{"text":"下面不写写反面，本面不写写对面、旁面，须知睹影知竿乃妙。","book":"清·刘熙载《艺概·诗概》"},"usage":"作谓语、宾语、定语；用于看待事物"},{"id":33706,"word":"睹微知著","pinyin":"dǔ wēi zhī zhù","abbr":"dwzz","explanation":"微：细小；著：显著。看到细小的征兆便知道其性质及发展趋势。","source":{"text":"仆中不敏，又素不能原始见终，睹微知著，窃度主人之心，岂谓三子宜死，罚当刑中哉？","book":"晋·陈寿《三国志·吕布臧洪传》"},"example":{"text":"崔苏～，自同奔走。","book":"《南史·荀伯玉崔祖思苏侃等传论》"},"similar":["见微知著"],"usage":"作谓语、宾语；指人的分析能力"},{"id":33707,"word":"睹景伤情","pinyin":"dǔ jǐng shāng qíng","abbr":"djsq","explanation":"睹：看到。看到景物触发起伤感之情。","source":{"text":"今日杜丽娘有些侥幸也。偶到后花园中，百花开遍，睹景伤情，没兴而归。","book":"明·汤显祖《还魂记·惊梦》"},"example":{"text":"请不要在这儿～了。"},"similar":["触景伤情"],"usage":"作谓语、定语；用于见物伤感"},{"id":33708,"word":"睹物伤情","pinyin":"dǔ wù shāng qíng","abbr":"dwsq","explanation":"看到东西就因想起它的主人而伤感动情。形容深切的怀念。睹：看见。","source":{"text":"今虽年久，尚然记忆。睹物伤情，不觉哀泣。","book":"明·冯梦龙《醒世恒言》第一卷"},"example":{"text":"文隐看了，不觉～，一时触动自己心事，更觉凄怆不已。","book":"清·李汝珍《镜花缘》第57回"},"similar":["睹物兴情"],"usage":"作谓语、定语；形容怀念之深切"},{"id":33709,"word":"睹物兴悲","pinyin":"dǔ wù xīng bēi","abbr":"dwxb","explanation":"见到与故人有关的东西而引起悲伤。","source":{"text":"猛然间睹物兴悲，早不觉潸然涕流。","book":"明·朱鼎《玉镜台记·新亭流涕》"},"similar":["睹物伤情"],"usage":"作谓语、宾语、定语；用于感怀"},{"id":33710,"word":"睹物兴情","pinyin":"dǔ wù xīng qíng","abbr":"dwxq","explanation":"见到眼前景物便激起某种感情。","source":{"text":"原夫登高之旨，盖睹物兴情，情以物兴，故义必明雅。","book":"南朝·梁·刘勰《文心雕龙·诠赋》"},"example":{"text":"他～，即兴作诗一首。"},"similar":["睹物伤情","睹物生情"],"usage":"作谓语；指即景生情"},{"id":33711,"word":"睹物怀人","pinyin":"dǔ wù huái rén","abbr":"dwhr","explanation":"睹：看见；怀：想念。看见死去或离去的人留下的东西就想起了这个人。形容深切的怀念。","source":{"text":"睹物怀人，人去物华销尽，道的个仙果难成、名花易殒。","book":"明·汤显祖《还魂记·忆女》"},"similar":["睹物思人"],"usage":"作谓语、宾语、分句；形容对故人的怀念"},{"id":33712,"word":"睹物思人","pinyin":"dǔ wù sī rén","abbr":"dwsr","explanation":"睹：看；思：思念。看见死去或离别的人留下的东西就想起了这个人。","source":{"text":"贵妃赠辟（避）尘犀簪一枚，曰：‘异日睹物思人。’","book":"唐·裴铏《传奇·颜睿》"},"example":{"text":"俗语说：“～”，天下的水总归一源，不拘那里的水舀一碗，看着哭去，也就尽情了。","book":"清·曹雪芹《红楼梦》第四十四回"},"similar":["触景生情","人亡物在"],"opposite":["无动于衷"],"usage":"作谓语、宾语、分句；形容对故人的怀念"},{"id":33713,"word":"睹着知微","pinyin":"dǔ zhe zhī wēi","abbr":"dzzw","explanation":"从明显的表象，推知到隐微的内情。"},{"id":33714,"word":"睹著知微","pinyin":"dǔ zhù zhī wēi","abbr":"dzzw","explanation":"从明显的表象，推知到隐微的内情。","source":{"text":"《越绝书》：‘子胥曰：圣人见微知著，睹始知己。’","book":"《文选·王粲〈赠文叔良〉诗》：“探情以华，睹著知微。”李善注"},"usage":"作谓语、定语；用于处事"},{"id":33715,"word":"睹貌献飧","pinyin":"dǔ mào xiàn sūn","abbr":"dmxs","explanation":"貌：脸色；飧：晚餐。观察脸色，献上晚餐。形容眼光敏锐，举止适合。","source":{"text":"长傲宾于柏谷，妻睹貌而献飧。","book":"晋·潘岳《西征赋》"}},{"id":33716,"word":"瞋目切齿","pinyin":"chēn mù qiè chǐ","abbr":"cmqc","explanation":"瞋目：发怒时睁大眼睛。瞪大眼睛，咬紧牙齿。形容极端愤怒的样子。","source":{"text":"是故天下之游谈士莫不日夜搤腕瞋目切齿以言从之便，以说人主。","book":"西汉·司马迁《史记·张仪列传》"},"example":{"text":"而举国无论为官为士为农为工为商为僧为俗莫不～，攘臂扼腕，风起云涌。","book":"梁启超《新民说》"},"similar":["咬牙切齿"],"opposite":["和颜悦色"],"usage":"作谓语、定语、状语；形容愤怒的样子"},{"id":33717,"word":"瞋目张胆","pinyin":"chēn mù zhāng dǎn","abbr":"cmzd","explanation":"瞋目：发怒时瞪大眼睛。有胆识，无所畏惧。","source":{"text":"将军瞋目张胆，出万死不顾一生之计。","book":"西汉·司马迁《史记·陈余列传》"},"example":{"text":"昔大齐之雄，三晋之士，尝胆与～，分别此矣。","book":"三国·魏·阮籍《达庄论》"},"similar":["明目张胆"],"usage":"作谓语、定语、状语；指肆无忌惮"},{"id":33718,"word":"瞋目扼腕","pinyin":"chēn mù è wàn","abbr":"cmew","explanation":"形容愤怒、勇敢的样子。","source":{"text":"瞋目扼腕而语勇者得；垂衣裳而谈说者得；迟日旷久积劳私门者得。尊向三者，无功而皆可以得。","book":"商鞅《商君书·君臣》"},"example":{"text":"小人之论也，专意自是。言人之非，～，疾言喷喷，口沸目赤。","book":"西汉·韩婴《韩诗外传》第九卷"},"usage":"作谓语、定语、状语；形容愤怒、勇敢的样子"},{"id":33719,"word":"瞋目案剑","pinyin":"chēn mù àn jiàn","abbr":"cmaj","explanation":"瞋目：瞪大眼睛；案：通“按”，握住。瞪圆双眼，握着宝剑。形容带剑者怒目圆睁的样子。","source":{"text":"郦生瞋目案剑叱使者曰：‘走！’复入言沛公，吾高阳酒徒也。","book":"西汉·司马迁《史记·郦生陆贾列传》"},"similar":["案剑瞋目"],"usage":"作谓语、状语；指人发怒的样子","story":["秦朝末年，刘邦驻守陈留县，当地穷书生郦食其才学过人，前去投奔刘邦，刘邦听说来者是儒生就不接见。郦食其气愤地握剑对侍者说自己是高阳酒徒，刘邦一听赶忙接见。后来郦食其成为刘邦的得力谋士，为刘邦一统天下而出谋划策"]},{"id":33720,"word":"瞋目竖眉","pinyin":"chēn mù shù méi","abbr":"cmsm","explanation":"瞋目：瞪大眼睛。瞪大眼睛，竖起眉毛。形容极其愤怒的样子。","source":{"text":"上坐官貌颇温良，闻土神话即怒，瞋目竖眉厉声索二青衣。","book":"清·袁枚《新齐谐·狮子大王》"},"similar":["横眉竖目"],"usage":"作谓语、定语、状语；用于愤怒时"},{"id":33721,"word":"瞋目裂眦","pinyin":"chēn mù liè zì","abbr":"cmlz","explanation":"愤怒地睁大眼睛，显出盛怒的模样。","source":{"text":"高渐离为之击筑，而歌于易水之上，闻者莫不瞋目裂眦，发直穿冠。","book":"西汉·刘安《淮南子·秦族训》"},"usage":"作谓语、宾语；指十分愤怒","story":["战国末期，燕太子丹从秦国逃回，访到义士荆轲与高渐离，请他们去刺杀秦王嬴政。一切准备就绪，太子丹率手下着白装送他们到易水边，高渐离击筑，荆轲高唱：“风萧萧兮易水寒，壮士一去兮不复还！”听到的人都瞋目裂眦，慷慨激昂"]},{"id":33722,"word":"瞎子摸象","pinyin":"xiā zǐ mō xiàng","abbr":"xzmx","explanation":"比喻对事物一知半解，不对全局作判断。","source":{"text":"不弄清楚，而要判断这经济的总趋势，岂不等于瞎子摸象？","book":"李劼人《天魔舞》第26章"},"example":{"text":"你不能学～的做法。"},"similar":["盲人摸象"],"opposite":["洞察一切"],"usage":"作宾语、定语；指盲目争执","story":["古代佛经里讲到有几个盲人去摸大象，一个瞎子摸到大象的腿就说大象像棍子，一个摸到大象的耳朵就说大象像扇子，一个摸到大象的尾巴说像绳子。因为他们摸到的都是大象的一部分而没有看到大象的整体形象"]},{"id":33723,"word":"瞎子摸鱼","pinyin":"xiā zi mō yú","abbr":"xzmy","explanation":"比喻做事盲目，缺乏调查研究。","source":{"text":"闭塞眼睛捉麻雀”，“瞎子摸鱼”，粗枝大叶，夸夸其谈，满足于一知半解，这种极坏的作风，这种完全违反马克思列宁主义基本精神的作风，还在我党许多同志中继续存存在着。","book":"毛泽东《改造我们的学习》二"},"example":{"text":"认不清道路，找不到目标，真是～一般，只能伏在地面上缓缓爬行。","book":"吴强《红日》第七章二五"},"opposite":["实事求是"],"usage":"作宾语、定语；指做事盲目"},{"id":33724,"word":"瞎子断匾","pinyin":"xiā zǐ duàn biǎn","abbr":"xzdb","explanation":"瞎子批判匾额上的字。指各说各的，无法得出正确的结论。","source":{"text":"于是《诗》有齐、鲁、韩、毛四家，而四家之说，也就像瞎子断匾一样，各是其所是。","book":"郭绍虞《中国文学批评史》第二章第十节"},"usage":"作宾语、定语；用于比喻句"},{"id":33725,"word":"瞎字不识","pinyin":"xiā zì bù shí","abbr":"xzbs","explanation":"讥嘲人是睁眼瞎子，一个字也不认识。","source":{"text":"汝纥字不识，或以为瞎字不识，误矣。","book":"宋·马永卿《嫩真子》"},"example":{"text":"我～，要我给儿子、姑娘取名字，可为难得很了。","book":"金庸《鹿鼎记》第四十五回"}},{"id":33726,"word":"瞎灯灭火","pinyin":"xiā dēng miè huǒ","abbr":"xdmh","explanation":"灯不亮，火灭了。形容夜十分漆黑。","source":{"text":"阴天涝雨刮大风，瞎灯灭火屋子空，闺女媳妇牛棚坐，专听老毛子啦清兵。","book":"《捻军歌谣·听老毛子啦清兵》"},"similar":["瞎灯黑火"],"usage":"作定语、状语；用于口语"},{"id":33727,"word":"瞎灯黑火","pinyin":"xiā dēng hēi huǒ","abbr":"xdhh","explanation":"灯不亮，火灭了。形容十分漆黑。","source":{"text":"村剧团就要开始演出了，散戏时瞎灯黑火不好走，那路还得加宽！","book":"《人民日报》1976.1.17"},"similar":["黑火瞎灯","瞎灯灭火"],"usage":"作定语、状语；用于口语"},{"id":33728,"word":"瞎说八道","pinyin":"xiā shuō bā dào","abbr":"xsbd","explanation":"失去理智说胡话或毫无根据地瞎说一气。","source":{"text":"‘瞎说八道！’螺蛳太太跳了起来，大声说道：‘胡大先生，你不要让我看不起你！’","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"～！甚么自刎了结，饶了我们满观道士的性命？","book":"金庸《神雕侠侣》第五回"},"similar":["瞎说白道","胡说八道","胡言乱语"],"opposite":["言之有据"],"usage":"作谓语、宾语、定语；形容说话没根据"},{"id":33729,"word":"瞎说白道","pinyin":"xiā shuō bái dào","abbr":"xsbd","explanation":"失去理智说胡话或毫无根据地瞎说一气。","source":{"text":"李氏听了，哼道：‘呸！没的瞎说白道的了。’","book":"清·石玉昆《三侠五义》第九十一回"},"example":{"text":"你～，当爹的穷了一辈子倒是情真，可没有鬻过儿卖过女！","book":"梁斌《红旗谱》三十一"},"similar":["瞎说八道","胡说八道"],"opposite":["言之有据"],"usage":"作谓语、宾语、定语；用于说话"},{"id":33730,"word":"瞎马临池","pinyin":"xiā mǎ lín chí","abbr":"xmlc","explanation":"盲人骑着瞎马。比喻盲目行动，后果十分危险。","source":{"text":"盲人骑瞎马，夜半临深池。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"夜行无烛，～，今日大患，莫大于昧。","book":"康有为《上清帝第五书》"},"usage":"作宾语、定语；指盲目行动"},{"id":33731,"word":"瞑思苦想","pinyin":"míng sī kǔ xiǎng","abbr":"mskx","explanation":"绞尽脑汁，苦思苦想","source":{"text":"这会儿你在这儿瞑思苦想，脑子里一定在盘算：怎么样再？","book":"《十月》1981年第2期"},"example":{"text":"我～了很久，还是得不到答案"},"similar":["冥思苦索"],"usage":"作谓语；指思索"},{"id":33732,"word":"瞒上不瞒下","pinyin":"mán shàng bù mán xià","abbr":"msbmx","explanation":"瞒：也作“漫”，欺骗，蒙蔽。瞒着上面，不瞒下面。指通同作弊，不使上级知道。","source":{"text":"如今且说现在的，倒是把他的东西，作瞒上不瞒下，悄悄的打发人送出去与了他。","book":"清·曹雪芹《红楼梦》第77回"},"example":{"text":"不瞒老哥说：这些事情原是～，常常有的。","book":"清·李宝嘉《官场现形记》第36回"},"similar":["谩上不谩下"],"usage":"作谓语、宾语、定语；用于中层人物"},{"id":33733,"word":"瞒上欺下","pinyin":"mán shàng qī xià","abbr":"msqx","explanation":"蒙骗上级，压迫下属和人民。","source":{"text":"至今还不能替老百姓想，瞒上欺下，咱简直不是个人啦！","book":"丁玲《太阳照在桑乾河上》"},"example":{"text":"他一贯～，玩弄手法，今日落得如此下场，真是罪有应得。"},"similar":["瞒天过海"],"opposite":["瞒上不欺下"],"usage":"作谓语、定语；指上下欺骗"},{"id":33734,"word":"瞒天大谎","pinyin":"mán tiān dà huǎng","abbr":"mtdh","explanation":"指天大的谎话。形容漫无边际的假话。","source":{"text":"把偏房说成正房，一味瞒天大谎，全无半点真实。","book":"明·兰陵笑笑生《金瓶梅词话》第七回"},"example":{"text":"要晓得从来的假话，都出在媒人口里，这～，不是我说起的。","book":"清·李渔《奈何天·媒欺》"},"similar":["弥天大谎"],"opposite":["肺腑之言"],"usage":"作宾语；指天大的谎话"},{"id":33735,"word":"瞒天席地","pinyin":"mán tiān xí dì","abbr":"mtxd","explanation":"瞒：隐瞒实情。指瞒上欺下，一手遮天。","source":{"text":"说邻封安然无事，那日问环球公法，谁是谁非。他瞒天席地，不令主知。","book":"清·洪楝园《警黄钟》第三出"},"similar":["瞒天瞒地"],"usage":"作谓语、宾语；指欺骗"},{"id":33736,"word":"瞒天昧地","pinyin":"mán tiān mèi dì","abbr":"mtmd","explanation":"瞒、昧：隐瞒，欺骗。昧着良心隐瞒真实情况，以谎言骗人。","source":{"text":"昧地谩天，多能已会，以巧翻为拙。","book":"金·侯善渊《酹江月》词"},"example":{"text":"我那日离山营，到铜城，见仓官坏法胡行径，专～不公平。","book":"明·无名氏《闹铜台》第一折"},"similar":["瞒天瞒地"],"usage":"作谓语、宾语；指欺骗"},{"id":33737,"word":"瞒天瞒地","pinyin":"mán tiān mán dì","abbr":"mtmd","explanation":"指瞒上欺下。","source":{"text":"你便休得要瞒天瞒地，你则会帐房里闲坐的，咱可便委其实。","book":"元·关汉卿《哭存孝》第一折"},"example":{"text":"不要～了，我们已经取得足够的证据来证明你有罪。"},"similar":["瞒上瞒下","瞒天昧地"],"usage":"作谓语、宾语；指欺骗"},{"id":33738,"word":"瞒天要价","pinyin":"mán tiān yào jià","abbr":"mtyj","explanation":"指无限度地要高价。","source":{"text":"泰州一丢，你们到哪儿去占山为王？算啦！二位不必再瞒天要价了。","book":"《人民戏剧》1978年第4期"},"example":{"text":"你～，谁会要你的？"},"similar":["瞒天讨价"],"opposite":["童叟无欺"],"usage":"作谓语；指无限度地要高价"},{"id":33739,"word":"瞒天讨价","pinyin":"mán tiān tǎo jià","abbr":"mttj","explanation":"瞒天：漫天，指无限度；讨价：指卖东西的人要价钱。没有限度的要高价。","source":{"text":"这个正合着古语，‘瞒天讨价，就地还钱’，我说二三百银子，你就说二三十两！","book":"清·吴敬梓《儒林外史》第14回"},"example":{"text":"你这样～是行不通的。"},"similar":["漫天讨价","漫天要价"],"opposite":["童叟无欺"],"usage":"作谓语、宾语；指没有限度的要高价"},{"id":33740,"word":"瞒天过海","pinyin":"mán tiān guò hǎi","abbr":"mtgh","explanation":"用欺骗的手段在暗地里活动。","source":{"text":"我做提控最有名，瞒天过海无人问，今年大比期又临。","book":"明·阮大铖《燕子笺·购幸》"},"example":{"text":"明·阮大铖《燕子笺·购幸》：“我做提控最有名，瞒天过海无人问，今年大比期又临。”"},"similar":["掩人耳目","瞒天昧地","瞒上欺下"],"opposite":["实事求是","以诚相待","光明磊落"],"usage":"作谓语、宾语、定语；指欺骗"},{"id":33741,"word":"瞒心昧己","pinyin":"mán xīn mèi jǐ","abbr":"mxmj","explanation":"昧：欺瞒。违背良心干坏事。","source":{"text":"欺天负人，瞒心昧己，神明也不保佑。","book":"元·石君宝《曲江池》第三折"},"example":{"text":"叵耐这秃厮！恁般可恶！僧家四大俱空，反要～，图人财利。","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"usage":"作谓语、定语；指违背自己良心做坏事"},{"id":33742,"word":"瞒神吓鬼","pinyin":"mán shén xià guǐ","abbr":"msxg","explanation":"瞒：隐瞒实情。又欺骗又暗中捣鬼。","source":{"text":"尽热衷瞒神吓鬼，扮花面走肉行尸。","book":"清·华伟生《开国奇冤》第四出"},"similar":["瞒神唬鬼"],"usage":"作谓语、宾语、定语；用于欺骗"},{"id":33743,"word":"瞒神唬鬼","pinyin":"mán shén xià guǐ","abbr":"mshg","explanation":"形容会耍花招。","source":{"text":"这厮瞒神唬鬼，钢筋铁骨，火眼金睛。","book":"元·杨景贤《西游记》第二本第十出"},"example":{"text":"王丞相因姐姐不从，亦发恼起来，把温存情况，变做了～乔模样。","book":"明·徐复祚《红梨记·赴约》"},"similar":["瞒神吓鬼"],"usage":"作谓语、宾语、定语；用于欺骗"},{"id":33744,"word":"瞒神弄鬼","pinyin":"mán shén nòng guǐ","abbr":"msng","explanation":"欺骗摆弄别人，背着人在暗中捣鬼。","source":{"text":"你又护着他了！你们瞒神弄鬼的，打是我不知道呢！","book":"清·曹雪芹《红楼梦》第20回"},"example":{"text":"靠～是骗不了我的。"},"similar":["装神弄鬼"],"usage":"作谓语；指欺骗"},{"id":33745,"word":"瞓面盎背","pinyin":"suì miàn àng bèi","abbr":"smab","explanation":"指德性表现于外，而有温润之貌，敦厚之态。指有德者的仪态。","source":{"text":"君子所性，仁义利智根於心。其生色也，瞓然见於面，盎於背，施於四体，四体不言而喻。","book":"《孟子·尽心上》"},"quote":{"text":"～，阳发其华，归根复命，阴结其根也。","book":"宋·袁甫《马实夫君子堂记》"}},{"id":33746,"word":"瞠乎其后","pinyin":"chēng hū qí hòu","abbr":"chqh","explanation":"瞠：瞪着眼看；其：代词，他。在别人后面干瞪眼赶不上。形容远远落在后面。","source":{"text":"夫子奔逸绝尘，而回瞠若乎后矣。","book":"《庄子·田子方》"},"example":{"text":"乾隆朝的“十全武功”固然～，就是康熙朝的平三藩之乱，论规模、论艰难，也都不如。","book":"高阳《玉座珠帘》上册"},"similar":["望尘莫及","不可企及"],"opposite":["并驾齐驱"],"usage":"作谓语；用于书面语"},{"id":33747,"word":"瞠乎后已","pinyin":"chēng hū hòu yǐ","abbr":"chhy","explanation":"瞠：瞪眼。在别人后面干瞪眼，追赶不上。","source":{"text":"经天纬地，专门名家，更瞠乎后已。","book":"清·陈康祺《郎潜纪闻·初笔》"},"similar":["瞠乎后矣","瞠乎其后"],"usage":"作谓语；用于书面语"},{"id":33748,"word":"瞠乎后矣","pinyin":"chēng hū hòu yǐ","abbr":"chhy","explanation":"瞠：瞪眼。在别人后面干瞪眼，追赶不上。","source":{"text":"即贾逵、服虔亦瞠乎后矣，况不及贾服者哉。","book":"清·江藩《汉学师承记·钱大昕》"},"similar":["瞠乎后已"],"usage":"作谓语；用于书面语"},{"id":33749,"word":"瞠呼其后","pinyin":"chēng hū qí hòu","abbr":"chqh","explanation":"在别人后面干瞪眼赶不上。形容远远落在后面。","source":{"text":"夫子奔逸绝尘，而回瞠若乎后矣。","book":"《庄子·田子方》"}},{"id":33750,"word":"瞠然自失","pinyin":"chēng rán zì shī","abbr":"crzs","explanation":"瞠：瞪着眼睛。瞪着眼睛好像丢了东西一样。形容失神的神态。","source":{"text":"瞠：瞪着眼睛。瞪着眼睛好像丢了东西一样。形容失神的神态。"},"example":{"text":"然而我现在却成为被人说是最爱用舞台效果的人，真是有点～。","book":"郭沫若《孔雀胆》附录"},"usage":"作谓语、定语；用于人的表情"},{"id":33751,"word":"瞠目伸舌","pinyin":"chēng mù shēn shé","abbr":"cmss","explanation":"瞠：瞪着眼睛。瞪眼伸出舌头说不出话来。形容窘迫或惊呆的样子。","source":{"text":"吓得瞠目伸舌，险些儿成了痴呆病。","book":"蔡东藩《民国通俗演义》第16回"},"similar":["瞠目咋舌","瞠目挢舌"],"usage":"作谓语、定语、状语；用于惊讶等"},{"id":33752,"word":"瞠目咋舌","pinyin":"chēng mù zé shé","abbr":"cmzs","explanation":"瞠：瞪着眼睛。瞪眼伸出舌头说不出话来。形容窘迫或惊呆的样子。","source":{"text":"为述所遇于太守，太守瞠目咋舌者久之。","book":"清·和邦额《夜谭随录·冯勰》"},"example":{"text":"当然，大家不管是谁挨骂，都只能～。","book":"王士美《铁旋风》第一部第五章"},"similar":["瞠目伸舌","瞠目结舌"],"usage":"作谓语、定语、状语；用于惊讶等"},{"id":33753,"word":"瞠目挢舌","pinyin":"chēng mù jiǎo shé","abbr":"cmjs","explanation":"瞠：瞪着眼睛；挢：翘起。瞪眼翘舌说不出话来。形容窘迫或惊呆的样子。","source":{"text":"我有时谈到外国诗，大家无不瞠目挢舌，认为诗是中国的专有品。","book":"曾朴《答胡适之书》"},"similar":["瞠目结舌","瞠目伸舌"],"usage":"作谓语、定语、状语；用于书面语"},{"id":33754,"word":"瞠目结舌","pinyin":"chēng mù jié shé","abbr":"cmjs","explanation":"瞪：瞪着眼；结舌：说不出话来。瞪着眼睛说不出话来。形容窘困或惊呆的样子。","source":{"text":"因耳语其故，公子大骇，入舱隐叩细君，细君结舌瞠目。","book":"清·霁园主人《夜谭随录·梨花》"},"example":{"text":"他问每个同学的时候，别的同学也不得不倾耳静听，注意前后情节的线索，否则突然问到，便不免～，不知所答。","book":"邹韬奋《经历》"},"similar":["张目结舌","张口结舌","目瞪口呆"],"opposite":["应对如流"],"usage":"作谓语、补语、状语；用于书面语"},{"id":33755,"word":"瞠目而视","pinyin":"chēng mù ér shì","abbr":"cmes","explanation":"瞪大眼睛看着。","source":{"text":"西边房门又开，一妇人衫裙俱青，抱婴儿以出，亦瞠目而视。","book":"宋·洪迈《夷坚丁志·金陵邸》"},"example":{"text":"王春宇听众人说话，也不甚解，只是～，不敢搀言。","book":"清·李绿园《歧路灯》第14回"},"similar":["惊恐万状","大惊失色"],"opposite":["和颜悦色","慈眉善目"],"usage":"作谓语、定语；形容十分惊异或恐惧"},{"id":33756,"word":"瞪目哆口","pinyin":"dèng mù chǐ kǒu","abbr":"dmdk","explanation":"睁大眼睛，张开嘴巴。形容惊呆的样子。","source":{"text":"诸名士且摇玉柄麈尾，擎铁如意，瞪目哆口如木鸡。","book":"清·无名氏《帝城花样·春珊传》"},"example":{"text":"清·韩邦庆《海上花列传》第37回：“翠凤气的～。”"},"similar":["目瞪口张"],"usage":"作谓语、状语；指惊呆"},{"id":33757,"word":"瞪目结舌","pinyin":"dèng mù jié shé","abbr":"dmjs","explanation":"睁着眼睛，说不出话来。形容神情紧张或很吃惊。","source":{"text":"群知为广文子，异而询之，瞪目结舌不能对。","book":"清·黄轩祖《游梁琐记·顾嘉蘅》"},"example":{"text":"男男女女的发型，不是教那些跑遍世界各大港口的国际海员，也～吗？","book":"《花城》1981年第5期"},"similar":["目瞪口呆"],"usage":"作谓语、状语；指人吃惊的样子"},{"id":33758,"word":"瞪眼咋舌","pinyin":"dèng yǎn zé shé","abbr":"dyzs","explanation":"睁着眼睛，说不出话来。形容神情紧张或很吃惊。同“瞪目结舌”。","source":{"text":"睁着眼睛，说不出话来。形容神情紧张或很吃惊。同“瞪目结舌”。"},"similar":["瞪目结舌"],"usage":"作谓语、状语；指人吃惊的样子"},{"id":33759,"word":"瞬息万变","pinyin":"shùn xī wàn biàn","abbr":"sxwb","explanation":"瞬：一眨眼；息：呼吸。在极短的时间内就有很多变化。形容变化很多很快。","source":{"text":"军情瞬息万变，莫说我们到南边还要好几天，就是此时，文丞相也不知在那里不在了？","book":"清·吴趼人《痛史》第十六回"},"example":{"text":"两个星期来形势的发展真如天际风云，～，表现了一个历史转折时期特有的复杂关系。","book":"方纪《挥手之间》"},"similar":["千变万化","风云变幻","瞬息万状"],"opposite":["一成不变","停滞不前"],"usage":"作谓语、定语；用于书面语"},{"id":33760,"word":"瞬息万状","pinyin":"shùn xī wàn zhuàng","abbr":"sxwz","explanation":"形容变化很多很快。同“瞬息万变”。","source":{"text":"盖时事瞬息万状，而尤以军队情形为然，非日夕与各方消息接触，恐少逊随机应变之妙用。","book":"廖仲恺《致蒋介石函电》之五"},"similar":["瞬息万变","一息万变","瞬息千变"],"opposite":["一成不变","停滞不前"],"usage":"作谓语、定语；用于书面语"},{"id":33761,"word":"瞬息之间","pinyin":"shùn xī zhī jiān","abbr":"sxzj","explanation":"极短暂的时间内。","source":{"text":"雅长听察，瞬息之间，下无以措其奸隐。","book":"《北史·魏世祖太武帝本纪》"},"example":{"text":"且说刘有才那日哄了女婿上岸，拨转船头，顺风而下，～，已行百里。","book":"明·冯梦龙《警世通言》卷二十二"},"similar":["转瞬之间"],"usage":"作宾语；指很短暂的时间"},{"id":33762,"word":"瞬息千变","pinyin":"shùn xī qiān biàn","abbr":"sxqb","explanation":"形容变化很多很快。同“瞬息万变”。","source":{"text":"军情瞬息千变，莫说我们到南边还要好几天。","book":"清·吴趼人《痛史》第16回"},"example":{"text":"当今社会～，得及时抓住机会。"},"similar":["瞬息万变"],"opposite":["一成不变"],"usage":"作谓语、定语；用于书面语"},{"id":33763,"word":"瞬息千里","pinyin":"shùn xī qiān lǐ","abbr":"sxql","explanation":"瞬：一眨眼；瞬息：极短的时间。形容非常迅速。后用来形容进步很快或行动迅速。","source":{"text":"夜叉在水中，推行如矢，瞬息千里，过一宵已达北岸，见一少年临流瞻望。","book":"清·蒲松龄《聊斋志异·夜叉国》"},"example":{"text":"轮船电报，～，军火机器，工力百倍，又为数千年来未有之强敌。","book":"《清史稿·李鸿章传》"}},{"id":33764,"word":"瞬息即逝","pinyin":"shùn xī jí shì","abbr":"sxjs","explanation":"瞬：一眨眼；瞬息：一眨眼一呼吸的极短时间；逝：消逝。形容在极短的时间内就消逝了。","example":{"text":"但这破绽～，待得见到破绽，破绽已然不知去向，决计无法批亢捋虚攻敌之弱。","book":"金庸《笑傲江湖》第三十六回"}},{"id":33765,"word":"瞰亡往拜","pinyin":"kàn wáng wǎng bài","abbr":"kwwb","explanation":"瞰：窥看；亡：外出。看到对方不在家时前去拜访。形容本来不想拜见，却又要走一趟拜访的过场。","source":{"text":"孔子亦瞰其亡也，而往拜之。","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"‘～’……最巧玩艺儿，经上都有，我都熟过的。","book":"鲁迅《十四年的“读经”》"},"usage":"作宾语；用于书面语"},{"id":33766,"word":"瞰瑕伺隙","pinyin":"kàn xiá sì xì","abbr":"kxsx","explanation":"窥伺对方空隙。","source":{"text":"各国莫不欲夺我所不争，乘我所不备，瞰瑕伺隙，事端遂百出而不穷。","book":"清·薛福成《论不勤远略之误》"},"usage":"作谓语；指寻找机会"},{"id":33767,"word":"瞻予马首","pinyin":"zhān yú mǎ shǒu","abbr":"zyms","explanation":"看我马头，指听我的指挥，跟着行事。","source":{"text":"荀偃令曰：‘鸡鸣而驾，塞井夷灶，唯余马首是瞻。’","book":"春秋·鲁·左丘明《左传·襄公十四年》"},"similar":["马首是瞻"],"usage":"作谓语；指听我的指挥","story":["春秋时期，秦景公一举打败第二代霸主晋文公的后代晋悼公。晋国为了复仇就联合齐鲁卫郑曹等12国组成伐秦联军。联军一举进攻到秦国的咸阳北，遭到秦军的顽强抵抗，晋军统帅栾偃要求联军看他的马头指向行动，由于各有私心而败北"]},{"id":33768,"word":"瞻云就日","pinyin":"zhān yún jiù rì","abbr":"zyjr","explanation":"原指贤明的君主恩泽施及尤民。后多比喻得近天子。","source":{"text":"其仁如天，其知如神。就之如日，望之如云。","book":"西汉·司马迁《史记·五帝本纪》"},"example":{"text":"是以一时智谋之士，英杰之俦，无不～，望风景从。","book":"太平天国·洪仁玕《诛妖檄文》"},"usage":"作谓语、定语；比喻德近天子"},{"id":33769,"word":"瞻云望日","pinyin":"zhān yún wàng rì","abbr":"zywr","explanation":"原指贤明的君主恩泽施及尤民。后多比喻得近天子。","source":{"text":"猛将鹰扬，不豫告成之次，瞻云望日，孤愤义伤，弹剑慷慨，中情蕴结。","book":"《史记·五帝本纪》：“就之如日，望之如云。”《晋书·张重华传》"},"example":{"text":"迩来将士～，以桂林为杓枢。（明·瞿共美《天南逸史·秋八月》）"}},{"id":33770,"word":"瞻云陟屺","pinyin":"zhān yún zhì qǐ","abbr":"zyzq","explanation":"陟：升，登；屺：没有草木的山。望云登山。比喻非常思念亲人","source":{"text":"陟彼屺兮，瞻望母兮。","book":"《诗经·魏风·陟岵》"},"example":{"text":"明·张居正《寿李母杜夫人七十序》：“正尝观览古人～事，盖伤之焉。”"},"usage":"作谓语、定语；用于书面语"},{"id":33771,"word":"瞻前忽后","pinyin":"zhān qián hū hòu","abbr":"zqhh","explanation":"瞻：向前看。看看前面，又看看后面。形容办事谨慎。","source":{"text":"瞻前而顾后兮，相观民之计极。","book":"战国·楚·屈原《离骚》"},"example":{"text":"仰高弥远钻坚，瞻前忽后，一点元无缺。（元·无名氏《无俗念》词）"},"usage":"作谓语、定语；用于书面语"},{"id":33772,"word":"瞻前思后","pinyin":"zhān qián sī hòu","abbr":"zqsh","explanation":"思前想后，反复思考","source":{"text":"又缘道途修阻，不能趋侍膝前，仰承教训，遂致孤身流落，有堕家声。瞻前思后，惭愧何堪！","book":"清·无名氏《玉娇梨》第14回"},"usage":"作谓语、定语；用于书面语"},{"id":33773,"word":"瞻前虑后","pinyin":"zhān qián lǜ hòu","abbr":"zqlh","explanation":"瞻：向前看。看看前面，又想想后面。形容做事之前考虑周密慎重。也形容顾虑太多，犹豫不决。","source":{"text":"瞻前而顾后兮，相观民之计极。","book":"战国·楚·屈原《离骚》"},"example":{"text":"你们小孩子家，只顾得眼前一点，不晓得～，这点算盘都不会打，我看你们将来怎样好啊！（清·李宝嘉《官场现形记》第四十七回）"},"similar":["瞻前顾后"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":33774,"word":"瞻前顾后","pinyin":"zhān qián gù hòu","abbr":"zqgh","explanation":"瞻：向前看；顾：回头看。看看前面，又看看后面。形容做事之前考虑周密慎重。也形容顾虑太多，犹豫不决。","source":{"text":"瞻前而顾后兮，相观民之计极。","book":"战国楚·屈原《离骚》"},"example":{"text":"有些事情看准了就马上去做，不要总是～，畏首畏尾。"},"similar":["左顾右盼"],"opposite":["一往直前"],"usage":"作谓语、宾语、定语、状语；指顾虑太多","story":["战国时期，楚国诗人屈原怀才不遇，在官场上屡遭排斥，楚怀王对他的提议置之不理，他内心十分痛苦，他只有通过诗歌来宣泄自己，在《离骚》中他写道：“夫惟圣哲以茂行兮，苟得用此下士。瞻前而顾后兮，相观民之计极。”"]},{"id":33775,"word":"瞻天恋阙","pinyin":"zhān tiān liàn què","abbr":"ztlq","explanation":"阙：古代宫殿外的高建筑物；天、阙：均借指帝王。指仰望与依恋帝王。形容臣下留恋朝廷。","source":{"text":"臣无任瞻天恋阙，激切屏营之至。","book":"清·洪楝园《警黄钟》第五出"},"usage":"作谓语、定语；用于书面语"},{"id":33776,"word":"瞻情顾意","pinyin":"zhān qíng gù yì","abbr":"zqgy","explanation":"因有交情而互相照应或通融。","source":{"text":"我们阴间上下都是铁面无私的，不比你们阳间瞻情顾意，有许多关碍处。","book":"清·曹雪芹《红楼梦》第十六回"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33777,"word":"瞻望咨嗟","pinyin":"zhān wàng zī jiē","abbr":"zwzj","explanation":"咨嗟：赞叹。左顾右看，不停地赞美。形容感触颇深。","source":{"text":"夹道之人，相与骈肩累迹，瞻望咨嗟。","book":"宋·欧阳修《相州昼锦堂记》"},"usage":"作谓语、定语；用于书面语"},{"id":33778,"word":"瞻顾前后","pinyin":"zhān gù qián hòu","abbr":"zgqh","explanation":"瞻：向前望；顾：回头看。兼顾前后。形容做事之前考虑周密慎重","source":{"text":"故其平生，如狂涛，如厉风，举一切伪饰陋习，悉与荡涤，瞻顾前后，素所不知。","book":"鲁迅《坟·摩罗诗力说》"},"similar":["瞻前顾后"],"usage":"作谓语、宾语、定语；用于处事"},{"id":33779,"word":"瞽旷之耳","pinyin":"gǔ kuàng zhī ěr","abbr":"gkze","explanation":"瞽：眼睛瞎；瞽旷：春秋时晋国乐师，天生的盲人，能辨别五音六律。形容听觉十分灵敏。","source":{"text":"擢乱六律，铄绝竽瑟，塞瞽旷之耳，而天下始人含其聪也。","book":"《庄子·胠箧》"}},{"id":33780,"word":"瞽瞍不移","pinyin":"gǔ sǒu bù yí","abbr":"gsby","explanation":"瞽、瞍：眼睛瞎了的人；移：移动。眼睛瞎了的人对事物没有反应。比喻恶劣成性的人不可能迁善改过。","source":{"text":"盲者不可示以文绣，聋者不可语以调声，瞽瞍不移，商均不化。","book":"汉·袁康《越绝书·越绝篇叙外传记》"}},{"id":33781,"word":"瞽言刍议","pinyin":"gǔ yán chú yì","abbr":"gycy","explanation":"瞽：瞎眼；刍议：草野平民的言论。盲人和草野平民的言论。","source":{"text":"不识忌讳，谨陈愚管，瞽言刍议，伏待斧钺。","book":"《南齐书·刘善明传》"},"usage":"作宾语、定语；用于自谦"},{"id":33782,"word":"瞽言妄举","pinyin":"gǔ yán wàng jǔ","abbr":"gywj","explanation":"指随便乱说，轻率行动。","source":{"text":"臣生长筚门，不逮异物，虽有贤才，所未接识，不敢瞽言妄举，无以畴答圣问。","book":"《晋书·挚虞传》"},"usage":"作宾语、定语；指人轻率"},{"id":33783,"word":"瞽言萏议","pinyin":"gǔ yán dàn yì","abbr":"gydy","explanation":"萏议：草野之人的议论。盲人和草野平民的言论。常用作自谦之辞。"},{"id":33784,"word":"瞽言蒭议","pinyin":"gǔ yán chú yì","abbr":"gycy","explanation":"瞽言：不达事理的议论；蒭议：草野之人的议论。水平不够，见解不深的言论。常用作自谦之辞。","source":{"text":"不识忌讳，谨陈愚管，瞽言蒭议，伏待斧钺。","book":"《南齐书·刘善明传》"}},{"id":33785,"word":"矛盾相向","pinyin":"máo dùn xiāng xiàng","abbr":"mdxx","explanation":"向：对着。形容针锋相对。","source":{"text":"初若矛楯相向，后类江海同归。","book":"宋·钱易《南部新书》"},"similar":["针锋相对"],"usage":"作宾语、定语；同“针锋相对”"},{"id":33786,"word":"矛盾重重","pinyin":"máo dùn chóng chóng","abbr":"mdcc","explanation":"重重：层层。彼此间的冲突、意见很多。","source":{"text":"帝国主义各国在国际关系上虽然各怀鬼胎，矛盾重重，但是……","book":"陶菊隐《北洋军阀统治时期史话》第68章"},"example":{"text":"其成员之间的关系很不简单，～。","book":"王朝闻《论凤姐》第十二章"},"usage":"作谓语、定语；指冲突多"},{"id":33787,"word":"矜世取宠","pinyin":"jīn shì qǔ chǒng","abbr":"jsqc","explanation":"矜：夸耀；宠：荣耀。炫耀才华，博取时誉。","source":{"text":"归于退求诸己，不矜世取宠，余论次复事，颇采其意云。","book":"宋·曾巩《徐复传赞》"},"usage":"作谓语、定语；指为人处世"},{"id":33788,"word":"矜功不立","pinyin":"jīn gōng bù lì","abbr":"jgbl","explanation":"矜：自夸。自以为能立大功而大功必不成。","source":{"text":"故曰：‘矜功不立，虚愿不至。’此皆幸乐其名，华而无其实德者也。","book":"《战国策·齐策四》"},"usage":"作宾语、定语；指自以为能耐"},{"id":33789,"word":"矜功伐善","pinyin":"jīn gōng fá shàn","abbr":"jgfs","explanation":"矜、伐：自夸。夸耀自己的功劳和才能。形容极不虚心。","source":{"text":"勇性雄猛，为当时骁将。然矜功伐善，好扬人之恶，时论亦以此鄙之。","book":"《周书·王勇传》"},"example":{"text":"艾性刚急，～，而不能协同朋类，轻犯雅俗，失君子之心。","book":"《晋书·段灼传》"},"similar":["自吹自擂"],"usage":"作谓语、宾语；指夸耀自己"},{"id":33790,"word":"矜功伐能","pinyin":"jīn gōng fá néng","abbr":"jgfn","explanation":"矜、伐：自夸。夸耀自己的功劳和才能。","source":{"text":"彼小人则不然，矜功伐能，好以陵人。","book":"三国·魏·刘劭《人物志·卷下·释陵人》"},"similar":["自吹自擂"],"usage":"作谓语、宾语；指夸耀自己"},{"id":33791,"word":"矜功恃宠","pinyin":"jīn gōng shì chǒng","abbr":"jgsc","explanation":"矜：自高自大。自夸功高，依仗恩宠。","source":{"text":"太祖以仪器望，待之尤重，数幸其第，如家人礼。仪矜功恃宠，遂与宜都公穆崇谋为乱。","book":"《魏书·王卫仪传》"},"example":{"text":"仪～，遂与宜都公穆崇伏甲谋乱。","book":"《北史·魏诸宗室》"},"usage":"作谓语、宾语；指自夸功高，依仗恩宠"},{"id":33792,"word":"矜功自伐","pinyin":"jīn gōng zì fá","abbr":"jgzf","explanation":"矜：骄傲，自夸；伐：自夸。自以为有功劳而夸耀。","source":{"text":"艾深自矜伐。谓蜀士大夫曰：‘……如遇吴汉之徒，已殄灭矣。’","book":"《三国志·魏书·邓艾传》"},"example":{"text":"他们天天乏了，倒说你们连日新时期；倒不是那～的。","book":"清·曹雪芹《红楼梦》第五十四回"},"similar":["自吹自擂"],"usage":"作谓语；指自以为有功劳而夸耀"},{"id":33793,"word":"矜功负气","pinyin":"jīn gōng fǔ qì","abbr":"jgfq","explanation":"矜：自恃。自以为有功而赌气。","source":{"text":"或矜功负气，或恃势骄陵，竞构南箕，成兹贝锦。","book":"《晋书·王浑王濬唐彬传论》"},"similar":["居功自傲"],"usage":"作谓语；指居功自傲"},{"id":33794,"word":"矜功负胜","pinyin":"jīn gōng fù shèng","abbr":"jgfs","explanation":"矜：自恃。自恃有战功，自信可以取胜。","source":{"text":"丑奴置营泾州西北七十里，当原城，时或轻骑暂来挑战，大兵未交，便示奔北。延伯矜功负胜，遂唱议先驱。","book":"《魏书·崔延伯传》"},"usage":"作谓语、宾语；用于书面语"},{"id":33795,"word":"矜句饰字","pinyin":"jīn jù shì zì","abbr":"jjsz","explanation":"矜：慎重；饰：整饰。形容写文章时字斟句酌，十分慎重。","source":{"text":"彼以句字为辞，而不知古之所谓辞命辞章者，指其首尾结撰，而通谓之辞，非如今人以矜句饰字为辞也。","book":"清·周亮工《书影》第六卷"},"similar":["字斟句酌","雕章琢句"],"usage":"作谓语、宾语、定语；用于说话或写作等"},{"id":33796,"word":"矜名妒能","pinyin":"jīn míng dù néng","abbr":"jmdn","explanation":"矜：夸耀；妒：嫉妒。夸耀自己的名声而嫉妒贤能。","source":{"text":"其达者或矜名妒能，耻策非己，舞笔奋辞，以破其义。","book":"《后汉书·崔骃传》"},"similar":["矜名嫉能"],"usage":"作谓语、定语；指自以为了不起"},{"id":33797,"word":"矜名嫉能","pinyin":"jīn míng jì néng","abbr":"jmjn","explanation":"矜：夸耀；嫉：嫉妒。夸耀自己的名声而嫉妒贤能。","source":{"text":"其达者或矜名嫉能，耻善策不从己出，则舞笔奋辞，以破其义。","book":"汉·崔寔《政论》"},"similar":["矜名妒能"],"usage":"作谓语、定语；指自以为是"},{"id":33798,"word":"矜夸凌上","pinyin":"jīn kuā líng shàng","abbr":"jkls","explanation":"矜：自夸；凌：凌辱。炫耀自夸，凌辱上司。","source":{"text":"孙楚矜夸凌上，陆机犯顺履险。","book":"北齐·颜之推《颜氏家训·文章》"},"usage":"作谓语、定语；用于处世"},{"id":33799,"word":"矜奇炫博","pinyin":"jīn qí xuàn bó","abbr":"jqxb","explanation":"以奇异和渊博而夸耀、自负。","source":{"text":"自余诗文杂著率尚体要，不为浮夸，虽世之矜奇炫博者，反若有所不逮。","book":"宋·魏了翁《黄侍郎定胜堂文集序》"},"example":{"text":"王子年著书皆杜撰，韩、马特引此以～，非事实也。","book":"清·王士慎《迠经堂诗话·遗迹类下》"}},{"id":33800,"word":"矜奇立异","pinyin":"jīn qí lì yì","abbr":"jqly","explanation":"夸耀奇特，标榜新异。","source":{"text":"我现在说这个话，或许有人以为矜奇立异。但不管大家承认不承认，而我的见解并不是信口开河。","book":"郭沫若《论古代文学》"},"example":{"text":"郭沫若《今昔集·论古代文学》：“我现在说这个话，或许有人以为～。”"},"similar":["标新立异"],"opposite":["人云亦云"],"usage":"作谓语、定语、宾语；形容故意显示与众不同"},{"id":33801,"word":"矜寡孤独","pinyin":"guān guǎ gū dú","abbr":"jggd","explanation":"矜：同“鳏”，老而无妻的人；寡：寡妇；孤：孤儿；独：独身。泛指没有劳动力而又独居无靠的人。","source":{"text":"使老有所终，壮有所用，幼有所长，矜寡孤独废疾者，皆有所养。","book":"西汉·戴圣《礼记·礼运》"},"similar":["鳏寡孤独"],"usage":"作主语、宾语、定语；不专指一个"},{"id":33802,"word":"矜己任智","pinyin":"jīn jǐ rèn zhì","abbr":"jjrz","explanation":"矜：夸耀；智：聪明。夸耀自己，显示才智。","source":{"text":"矜己任智，是蔽是欺。","book":"晋·陆机《丞相箴》"},"usage":"作谓语、宾语；指人爱显示自己"},{"id":33803,"word":"矜己自饰","pinyin":"jīn jǐ zhì shì","abbr":"jjzs","explanation":"矜：夸耀；自饰：自己颂扬。夸耀称赞自己。","source":{"text":"嚣矜己自饰，常以为西伯复作，乃与诸将议自立为王。","book":"《后汉书·郑兴传》"},"similar":["矜智负能"],"usage":"作谓语；指夸耀自己"},{"id":33804,"word":"矜平躁释","pinyin":"jīn píng zào shì","abbr":"jpzs","explanation":"指心平气和，有涵养。","source":{"text":"就以陈铁血这样的矜平躁释，也要被他们鼓动起来，其余初出茅庐的少年子弟，是更不用说了。","book":"《负曝闲谈》第十三回"},"example":{"text":"得坐光风霁月中，～百忧空。","book":"柳亚子《毛主席招谈于红岩嘴办事处归后有作》诗之二"},"usage":"作宾语、定语；用于为人"},{"id":33805,"word":"矜情作态","pinyin":"jīn qíng zuò tài","abbr":"jqzt","explanation":"作态：故意作出一种姿态。故意做作。","source":{"text":"此子矜情作态，局面太小。","book":"清·袁枚《随园诗话》第九卷"},"similar":["矫揉造作"],"usage":"作谓语、宾语、定语；指人做作"},{"id":33806,"word":"矜愚饰智","pinyin":"jīn yú shì zhì","abbr":"jysz","explanation":"装作有智慧，在愚人面前夸耀自己。","source":{"text":"饰知（智）以惊愚。","book":"战国·宋·庄周《庄子·山木》"},"example":{"text":"岂尝有庐陵之《新五代史》、晦庵之《通鉴纲目》咬文嚼字，～。","book":"梁启超《论书法》"},"usage":"作谓语、定语；指装作有智慧，在愚人面前夸"},{"id":33807,"word":"矜才使气","pinyin":"jīn cái shǐ qì","abbr":"jcsq","explanation":"矜：自夸；使气：意气用事。倚仗自己的才能，使意气，不谦虚。","source":{"text":"先生学问渊博，矜才使气，医卜艺术之书，无不周览。","book":"清·夏敬渠《野叟曝言》第十五回"},"example":{"text":"一个个字都象幽静的处女，没有点点儿～的意味。","book":"叶圣陶《乡里善人》"},"similar":["恃才傲物","目空一切"],"opposite":["胆小如鼠","小心谨慎"],"usage":"作定语；指意气用事"},{"id":33808,"word":"矜持不苟","pinyin":"jīn chí bù gǒu","abbr":"jcbg","explanation":"矜持：保持庄严的态度；不苟：不草率。端庄严谨，毫不马虎。","source":{"text":"而矜持不苟，舍己为公，却是每个共产党员具备的美德。","book":"方志敏《清贫》"},"usage":"作谓语、定语；指处事认真"},{"id":33809,"word":"矜智负能","pinyin":"jīn zhì fù néng","abbr":"jzfn","explanation":"矜：夸耀。夸耀智慧和才能。","source":{"text":"此理苟明，则矜智负能之人，皆将失其窟宅。","book":"宋·陆九渊《与包显道书》"},"similar":["矜功伐能"],"usage":"作谓语、定语、宾语；指夸耀自己"},{"id":33810,"word":"矜牙舞爪","pinyin":"jīn yá wǔ zhǎo","abbr":"jywz","explanation":"矜：通“兢”，动。形容狰狞凶猛。","source":{"text":"峡外六龙狞以凶，矜牙舞爪趹战攻。","book":"明·刘基《题群龙图》"},"similar":["张牙舞爪"],"usage":"作谓语、状语、定语；指人的神态"},{"id":33811,"word":"矜矜业业","pinyin":"jīn jīn yè yè","abbr":"jjyy","explanation":"认真踏实，一丝不苟。","source":{"text":"是以古先哲王，畏上天之明命，循阴阳之逆顺，矜矜业业，惟恐有违。","book":"晋·陈寿《三国志·高堂隆传》"},"similar":["兢兢业业"],"opposite":["敷衍了事"],"usage":"作谓语、定语、状语；指人做事踏实"},{"id":33812,"word":"矜纠收缭","pinyin":"jīn jiū shōu liáo","abbr":"jjsl","explanation":"形容骄傲、急躁、暴戾。","source":{"text":"旁辟曲私之属为化而公，矜纠收缭之属皆为之化而凋。","book":"《荀子·议兵》"},"example":{"text":"～，皆急戾之意，故与调和相反。","book":"王念孙《读书杂志·荀子》"},"usage":"作谓语、定语；指人的性格"},{"id":33813,"word":"矜能负才","pinyin":"jīn néng fù cái","abbr":"jnfc","explanation":"自认为才能很高。","source":{"text":"邓艾忌克诡狭，矜能负才，顺从者谓为见事，直言者谓之触迕。","book":"《晋书·唐彬传》"},"similar":["矜智负能"],"usage":"作谓语、定语；指人自以为是"},{"id":33814,"word":"矜贫恤独","pinyin":"jīn pín xù dú","abbr":"jpxd","explanation":"矜：怜悯；恤：周济；独：老年无子的人。怜悯救助贫苦和孤独的人。","source":{"text":"甄忠明孝，矜贫恤独，开纳谠言，抑绝谗佞。","book":"《魏书·高闾传》"},"similar":["矜贫救厄"],"usage":"作谓语、宾语；指帮助贫苦人"},{"id":33815,"word":"矜贫救厄","pinyin":"jīn pín jiù è","abbr":"jpje","explanation":"矜：怜悯。怜悯救济遭受贫穷苦难的人。","source":{"text":"与穷恤寡是一药，矜贫救厄是一药。","book":"宋·张君房《云笈七签》卷四十"},"similar":["矜贫恤独"],"usage":"作谓语、宾语；指帮助穷苦人"},{"id":33816,"word":"矢下如雨","pinyin":"shǐ xià rú yǔ","abbr":"sxry","explanation":"箭密的像雨一样射过来。","source":{"text":"广为圜陈外乡，胡急击之，矢下如雨。汉兵死者过半，汉矢且尽。","book":"《史记·李将军列传》"},"example":{"text":"翌晨天甫黎明，蒙古军大举攻城，～，石落似雹，纷纷向城中打去。","book":"金庸《神雕侠侣》第二十回"},"similar":["矢如雨下","矢如雨集"],"usage":"作谓语、定语；用于战争等"},{"id":33817,"word":"矢不虚发","pinyin":"shǐ bù xū fā","abbr":"sbxf","explanation":"每一箭都命中目标。形容射箭本领极高。","source":{"text":"车驾还，诏健殿后，蠕蠕万骑追之，健与数十骑击之，矢不虚发，所中皆应弦而毙。","book":"《魏书·明元六王传》"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第17卷：“仔细看那箭杆上，有两行细字道：‘～，发必应弦。’”"},"similar":["箭不虚发","矢无虚发"],"usage":"作谓语、宾语；形容办事有充分的把握"},{"id":33818,"word":"矢人惟恐不伤人","pinyin":"shǐ rén wéi kǒng bù shāng rén","abbr":"srwkbsr","explanation":"矢人：造箭的人。造箭的人就怕他造的箭不能伤人。比喻人的立场决定他对待事物的态度。","source":{"text":"矢人惟恐不伤人，函人惟恐伤人。","book":"《孟子·公孙丑上》"}},{"id":33819,"word":"矢力同心","pinyin":"shǐ lì tóng xīn","abbr":"sltx","explanation":"指齐心合力。","source":{"text":"方今人心趋向共和，决无第二问题，不独东南十数省矢力同心，即西北各省闻亦均表同意。","book":"中国近代史资料丛刊《辛亥革命·关于南北议和的清方档案》"},"similar":["齐心合力"],"usage":"作谓语、状语；指共同努力"},{"id":33820,"word":"矢口否认","pinyin":"shǐ kǒu fǒu rèn","abbr":"skfr","explanation":"一口咬定，死不承认。","source":{"text":"他为着面子上光彩，矢口否认他的妹妹是‘如夫人’。","book":"姚雪垠《李自成》第一卷第16章"},"example":{"text":"却是含含糊糊，避重就轻，甚至～。","book":"陈残云《山谷风烟》第30章"},"similar":["矢口抵赖"],"opposite":["供认不讳"],"usage":"作谓语；指拒不承认"},{"id":33821,"word":"矢口抵赖","pinyin":"shǐ kǒu dǐ lài","abbr":"skdl","explanation":"一口咬定，死不承认。","example":{"text":"裕顺吓了一跳，连忙～，咬定绝无此事。","book":"叶兆言《花煞》卷一第一章"},"similar":["矢口否认","矢口狡赖"],"usage":"作谓语、定语；用于口语"},{"id":33822,"word":"矢口狡赖","pinyin":"shǐ kǒu jiǎo lài","abbr":"skjl","explanation":"死也不肯承认。","example":{"text":"虽然人证物证俱在，他还是～。"}},{"id":33823,"word":"矢口猖言","pinyin":"shǐ kǒu chāng yán","abbr":"skcy","explanation":"犹言信口胡说。","source":{"text":"安国佚书较伏生更多三十篇，不止十六，何以史迁问故，不传一字，而卫、贾、马、郑传古文者，即十六篇亦不传一字乎？矢口猖言，不顾其后，其不可信者二。","book":"清·魏源《〈书古微〉序》"},"similar":["信口开河","胡言乱语"],"opposite":["有理有据"],"usage":"作谓语、宾语；指信口胡说"},{"id":33824,"word":"矢在弦上","pinyin":"shǐ zài xián shàng","abbr":"szxs","explanation":"箭已搭在弦上。比喻为形势所迫，不得不采取某种行动。","source":{"text":"矢在弦上，不可不发。","book":"三国·魏·陈琳《为袁绍檄豫州》注引《魏志》"},"similar":["箭在弦上","矢在弦上，不得不发"],"usage":"作宾语、定语；指情况危急","story":["东汉末年，袁绍为了攻打曹操，让陈琳写一篇《为袁绍檄豫州》的檄文，列举曹操的罪状，大骂曹操祖宗三代。袁绍官渡之战败给曹操，陈琳也趁机投靠曹操。曹操问陈琳为什么写那篇檄文，陈琳说那时箭在弦上被袁绍所逼而写"]},{"id":33825,"word":"矢在弦上，不得不发","pinyin":"shǐ zài xián shàng，bù dé bù fā","abbr":"szxsbdbf","explanation":"箭已搭在弦上，不得不发出。比喻为形势所迫，不得不采取某种行动。","source":{"text":"陈琳作檄，草成，呈太祖。太祖先苦头风，是日疾发，卧读琳所作，翕然而起，曰：‘此愈我疾病。’太祖平邺，谓陈琳曰：‘君昔为本初作檄书，但罪孤而已，何乃上及父祖乎！’琳谢曰：‘矢在弦上，不得不发。’","book":"《太平御览》卷五九七引晋·王沈《魏书》"},"similar":["箭在弦上，不得不发"],"usage":"作宾语、定语；用于处事","story":["东汉末年，袁绍为了攻打曹操，让陈琳写一篇《为袁绍檄豫州》的檄文，列举曹操的罪状，大骂曹操祖宗三代。袁绍官渡之战败给曹操，陈琳也趁机投靠曹操。曹操问陈琳为什么写那篇檄文，陈琳说那时箭在弦上被袁绍所逼而写"]},{"id":33826,"word":"矢如雨下","pinyin":"shǐ rú yǔ xià","abbr":"sryx","explanation":"箭像雨一样射来。极言其多。","source":{"text":"陵在谷中，虏在山上，四面射，矢如雨下。","book":"《汉书·李陵传》"},"example":{"text":"[刘子南]卒遇虏，大战败绩，士众奔溃，独为寇所围，～。","book":"《云笈七签》卷七七"},"similar":["矢下如雨","矢如雨集"],"usage":"作谓语、定语；用于战争等"},{"id":33827,"word":"矢如雨集","pinyin":"shǐ rú yǔ jí","abbr":"sryj","explanation":"箭像雨一样的射下。","source":{"text":"持弓回射，矢如雨集，俱向众兵头面掠过。","book":"清·林云铭《林四娘记》"},"similar":["矢下如雨","矢如雨下"],"usage":"作谓语、定语；用于战争等"},{"id":33828,"word":"矢尽兵穷","pinyin":"shǐ jìn bīng qióng","abbr":"sjbq","explanation":"箭已用完，兵已打光。形容战斗到兵力丧尽。","source":{"text":"申胥乃衰楚之大夫，而以矢尽兵穷，委身折节，肝脑涂地，感动于强秦。","book":"唐·孙揆《灵应传》"},"similar":["弹尽粮绝"],"usage":"作宾语、定语；用于书面语"},{"id":33829,"word":"矢尽援绝","pinyin":"shǐ jìn yuán jué","abbr":"sjyj","explanation":"作战中箭矢都用完了，援兵断绝了。也比喻处境非常困难。","source":{"text":"企拒守旬余，矢尽援绝，城乃陷焉。","book":"《周书·泉企传》"},"example":{"text":"最后投降，从这边说，是～，这才罢战的南方之强，从那边说，却是不识顺逆，久梗王师的贼。","book":"鲁迅《花边文学·北人与南人》"}},{"id":33830,"word":"矢心不二","pinyin":"shǐ xīn bù èr","abbr":"sxbe","explanation":"立誓无二心。","source":{"text":"我待年之媵，例不登诸策简，徒以矢心不二，故仲尼有是特笔。","book":"清·纪昀《阅微草堂笔记·槐西杂志二》"},"similar":["矢死无贰"],"usage":"作谓语、定语、状语；用于处事等"},{"id":33831,"word":"矢志不屈","pinyin":"shǐ zhì bù qū","abbr":"szbq","explanation":"矢：誓。指立志决不屈服。","source":{"text":"义哉髯也，见义必为，矢志不屈，求之士人中，亦几几难之。","book":"清·顾彩《髯樵传》"},"similar":["坚贞不屈"],"usage":"作谓语、定语；用于处事"},{"id":33832,"word":"矢志不摇","pinyin":"shǐ zhì bù yáo","abbr":"szby","explanation":"发誓立志，决不改变。表示永远不变心。","source":{"text":"仲叔尚廉利其嫁，屡劝驾，而邵氏矢志不摇。","book":"清·蒲松龄《聊斋志异·仇大娘》"},"similar":["矢志不渝","矢志不移"],"usage":"作谓语、状语；用于发誓立志"},{"id":33833,"word":"矢志不渝","pinyin":"shǐ zhì bù yú","abbr":"szby","explanation":"表示永远不变心。","source":{"text":"安虽受朝寄，然东山之志始末不渝，每形于言色。","book":"《晋书·谢安传》"},"example":{"text":"她爱的是四敏！～的爱着。","book":"高云览《小城春秋》第17章"},"similar":["矢志不移"],"opposite":["朝三暮四","见异思迁"],"usage":"作谓语、状语；指永远不变心"},{"id":33834,"word":"矢志不移","pinyin":"shǐ zhì bù yí","abbr":"szby","explanation":"发誓立志，决不改变。","source":{"text":"仲叔尚廉利其嫁，屡劝驾，邵氏矢志不摇。","book":"清·蒲松龄《聊斋志异·仇大娘》"},"example":{"text":"他是以这样的精神品质来～地为人民服务。","book":"冯雪峰《论》"},"similar":["矢志不渝","矢志不摇"],"opposite":["朝三暮四","见异思迁"],"usage":"作谓语、状语；用于发誓立志"},{"id":33835,"word":"矢志捐躯","pinyin":"shǐ zhì juān qū","abbr":"szjq","explanation":"矢：誓。立志牺牲而不屈从。","source":{"text":"惟知矢志捐躯，保固岭南，以表臣始终之诚。","book":"《清史稿·尚可喜传》"},"usage":"作谓语、宾语；用于书面语"},{"id":33836,"word":"矢忠不二","pinyin":"shǐ zhōng bù èr","abbr":"szbe","explanation":"立誓忠心到底决不改变。","source":{"text":"妾今日归，为君守贞，矢死不二，君果有灵，当饮此。","book":"清·吴应逵《书钟锡明》"},"example":{"text":"他们的友谊～。"},"similar":["忠心耿耿","忠贞不渝"],"opposite":["逢场作戏","虚与委蛇"],"usage":"作谓语、定语；用于人"},{"id":33837,"word":"矢无虚发","pinyin":"shǐ wú xū fā","abbr":"swxf","explanation":"形容射箭本领极高。同“矢不虚发”。","source":{"text":"轻鸾微动，密翳徐张，黄间所彀，矢无虚发。","book":"《艺文类聚》卷六六引南朝·梁·沈约《为皇太子谢赐御所谢雉启》"},"example":{"text":"清·褚人获《隋唐演义》第94回：“霁云直冲其众，左射右射，～，贼皆披靡。”"},"similar":["箭无虚发","矢不虚发"],"opposite":["无的放矢"],"usage":"作谓语、宾语；形容办事有充分的把握"},{"id":33838,"word":"矢死不二","pinyin":"shǐ sǐ bù èr","abbr":"ssbe","explanation":"发誓宁死不变。同“矢死无贰”。","source":{"text":"媪得鸦头，横施楚掠。既北徙，又欲夺其志，女矢死不二，因囚置之。","book":"清·蒲松龄《聊斋志异·鸦头》"},"example":{"text":"他已经有了～的决心"},"similar":["誓死不二","矢心不二"],"usage":"作谓语、定语；指至死也不变心"},{"id":33839,"word":"矢死无贰","pinyin":"shǐ sǐ wú èr","abbr":"sswe","explanation":"发誓宁死不变。","source":{"text":"茶笼守彭困孤城，矢死无贰。","book":"《明史·忠义传一·琴彭》"},"similar":["誓死无贰","矢心不二","矢死不二"],"opposite":["朝秦暮楚"],"usage":"作谓语、定语、状语；用于处事等"},{"id":33840,"word":"矢石之间","pinyin":"shǐ shí zhī jiā","abbr":"sszj","explanation":"矢石：箭与礧石，作战的武器。比喻战场。","source":{"text":"天下士大夫捐亲戚，弃土壤，从大王于矢石之间，其计固望其攀龙鳞，附凤翼，以成其所志耳。","book":"《后汉书·光武帝纪上》"},"usage":"作宾语；指战场"},{"id":33841,"word":"矢石之难","pinyin":"shǐ shí zhī nàn","abbr":"sszn","explanation":"矢石：箭与石，作战的武器。指在战争中受到矢石的袭击。","source":{"text":"辅我以行，卒以成立，此受此赏。矢石之难，汗马之劳，此复受次赏。","book":"《史记·晋世家》"},"example":{"text":"东汉·班固《汉书·萧何传》：“上暴露于外，而君守于内，非被～，而益君封置卫者。”"},"usage":"作宾语；用于战争等"},{"id":33842,"word":"知一万毕","pinyin":"zhī yī wàn bì","abbr":"zywb","explanation":"指理解本质，万事尽通。","source":{"text":"通于一而万事毕。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"振本而末从，～矣。","book":"南朝·梁·刘勰《文心雕龙·章句》"},"similar":["触类旁通"],"usage":"作谓语、定语；指触类旁通"},{"id":33843,"word":"知一不知十","pinyin":"zhī yī bù zhī shí","abbr":"zybzs","explanation":"知道一是什么，却不知道十是怎么回事。形容了解事物不够全面。","source":{"text":"秦知进取之利，而不知鸿门之难，是知一而不知十也。","book":"汉·桓宽《盐铁论·结和》"},"usage":"作宾语、定语；用于书面语"},{"id":33844,"word":"知一而不知二","pinyin":"zhī yī ér bù zhī èr","abbr":"zyebze","explanation":"知道一是什么，却不知道二是怎么回事。形容了解事物不够全面。","source":{"text":"昔徐偃王行义而灭，鲁哀公好儒而削。知文而不知武，知一而不知二。","book":"汉·桓宽《盐铁论·和亲》"},"example":{"text":"若～，知大而不知细，知高远而不知幽深，皆非知之至也。（宋·朱熹《论语集注·大学》）"},"similar":["知其一不知其二"],"usage":"作谓语、定语；指了解片面"},{"id":33845,"word":"知不诈愚","pinyin":"zhì bù zhà yú","abbr":"zbzy","explanation":"知：通“智”。指聪明人不欺诈老实愚昧的人。","source":{"text":"政约令行，强不暴寡，知不诈愚。","book":"汉·无名氏《西狭颂》"},"usage":"作宾语、定语；用于书面语"},{"id":33846,"word":"知义多情","pinyin":"zhī yì duō qíng","abbr":"zydq","explanation":"义：情义；情：感情。重义气，有感情。","source":{"text":"谁知那张家父母如此爱势贪财，却养了一个知义多情的女儿，闻得父母退了前夫，他便一条麻绳悄悄的自缢了。","book":"清·曹雪芹《红楼梦》第十六回"},"usage":"作谓语、定语；用于书面语"},{"id":33847,"word":"知之为知之","pinyin":"zhī zhǐ wéi zhī zhī","abbr":"zzwzz","explanation":"为：是。懂就是懂。指要诚实。","source":{"text":"知之为知之，不知为不知，是知也。","book":"《论语·为政》"}},{"id":33848,"word":"知之为知之，不知为不知","pinyin":"zhī zhǐ wéi zhī zhī，bù zhī wéi bù zhǐ","abbr":"zzwzzbzwbz","explanation":"懂就是懂，不懂就是不懂。","source":{"text":"知之为知之，不知为不知，是知也。","book":"《论语·为政》"},"example":{"text":"古人质实，不尚智巧，言论未详，事实先著。～。","book":"宋·陆九渊《与朱元晦书》"},"usage":"作宾语、定语；用于书面语"},{"id":33849,"word":"知之非艰，行之惟艰","pinyin":"zhī zhī fēi jiān，xíng zhī wéi jiān","abbr":"zzfjxzwj","explanation":"惟：惟独。懂得道理并不难，实际做起来就难了。","source":{"text":"知之非艰，行之惟艰。","book":"《尚书·说命中》"},"example":{"text":"郭沫若《论国内的评坛及我对于创作上的态度》：“想起古人‘～’的一句话上来，真不免要汗流浃背了。”"},"similar":["知之非难，行之不易"],"usage":"作宾语、定语；用于劝诫人"},{"id":33850,"word":"知之非难，行之不易","pinyin":"zhī zhī fēi nán，xíng zhī bù yì","abbr":"zzfnxzby","explanation":"惟：惟独。懂得道理并不难，实际做起来就不那么容易了。","source":{"text":"惟恐知之非难，行之不易，志骄于业泰，体逸于时安。","book":"唐·徐惠《谏太宗息兵罢役疏》"},"similar":["知易行难","行之惟艰"],"usage":"作宾语、定语；用于劝诫人"},{"id":33851,"word":"知书明理","pinyin":"zhī shū míng lǐ","abbr":"zsml","explanation":"有文化，懂礼仪。形容有教养。同“知书达礼”。","source":{"text":"那素秋本是知书明理之人，见郑氏说的很好，自己也愿意。","book":"清·坑余生《续济公传》第三回"},"example":{"text":"仿佛谁都是混帐，只有他自己是～的君子人。","book":"老舍《骆驼祥子》二一"},"similar":["知书识礼","知书通礼","知书知礼"],"usage":"作谓语、定语；指人有修养"},{"id":33852,"word":"知书知礼","pinyin":"zhī shū zhī lǐ","abbr":"zszl","explanation":"有文化，懂礼仪。形容有教养。同“知书达礼”。","source":{"text":"更羡他知书知礼，是一个不趋跄的秀才。","book":"明·高明《琵琶记·牛氏规奴》"},"example":{"text":"他日到人家，～，父母光辉。这都是你娘亲失教也。","book":"明·汤显祖《牡丹亭·训女》"},"similar":["知书达礼","知书识礼","知书通礼"],"usage":"作谓语、定语；指人有修养"},{"id":33853,"word":"知书识字","pinyin":"zhī shū shí zì","abbr":"zssz","explanation":"指有文化修养。","source":{"text":"海翁，命穷，百不会，千无用。知书识字总成空。","book":"明·冯惟敏《朝天子·自遣》曲"},"example":{"text":"你是个～之人，难道‘覆水难收’四个字也不知道么？","book":"清·李渔《奈何天·计左》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33854,"word":"知书识礼","pinyin":"zhī shū shí lǐ","abbr":"zssl","explanation":"有文化，懂礼仪。形容有教养。同“知书达礼”。","source":{"text":"媳妇虽不敢说知书识礼，然而‘嫁鸡随鸡，嫁狗随狗’这句俗话，是从小儿听到大的。","book":"清·吴研人《二十年目睹之怪现状》第九十一回"},"example":{"text":"文君，你是～的人，我万不想出你，替我卓门闹出这样伤风败俗的丑事！","book":"郭沫若《卓文君》第三景"},"similar":["知书达礼","知书明理","知书通礼"],"usage":"作谓语、定语；指人有修养"},{"id":33855,"word":"知书达理","pinyin":"zhī shū dá lǐ","abbr":"zsdl","explanation":"知、达：懂得。有文化，讲道理。形容有教养。","source":{"text":"只我这知书达礼当恭谨，怎肯着出乖露丑遭谈论。","book":"元·无名氏《冯玉兰》第一折"},"example":{"text":"一个人知书达理，就该往上巴结才是。（清·曹雪芹《红楼梦》第八十六回）"}},{"id":33856,"word":"知书达礼","pinyin":"zhī shū dá lǐ","abbr":"zsdl","explanation":"知、达：懂得。有文化，懂礼貌。形容有教养。","source":{"text":"只我这知书达礼当恭谨，怎肯着出乖露丑遭谈论。","book":"元·无名氏《冯玉兰》第一折"},"example":{"text":"老师希望我们健康成长，要～，全面发展。"},"similar":["知书识礼","知书明理","通情达理"],"opposite":["愚昧无知"],"usage":"作谓语、定语；指人有修养"},{"id":33857,"word":"知书通礼","pinyin":"zhī shū tōng lǐ","abbr":"zstl","explanation":"有文化，懂礼仪。形容有教养。同“知书达礼”。","source":{"text":"看了柴进、燕青出言不俗，知书通礼，先自有八分欢喜。","book":"明·施耐庵《水浒传》第一百十六回"},"similar":["知书明理","知书达礼","知书知礼"],"usage":"作谓语、定语；指人有修养"},{"id":33858,"word":"知二五而不知十","pinyin":"zhī èr wǔ ér bù zhī shí","abbr":"zewebzs","explanation":"知道两个五是多少，却不知十是什么意思。比喻看问题片面孤立。","source":{"text":"且王之所求者，斗晋楚也；晋楚不斗，越兵不起，是知二五而不知十也。","book":"《史记·越王勾践世家》"},"example":{"text":"独疑孔子不应自作自解，是～也。（清·皮锡瑞《经学通论》上）"},"similar":["知二五而未识于十"],"usage":"作宾语、定语；用于处事"},{"id":33859,"word":"知二五而未识于十","pinyin":"zhī èr wǔ ér wèi shí yú shí","abbr":"zewewsys","explanation":"知道两个五是多少，却不知十是什么意思。比喻看问题片面孤立。","source":{"text":"固知三者定乎造化，荣辱之境，独曰由人。是知二五而未识于十，其蔽一也。","book":"南朝·梁·刘孝标《辩命论》"},"similar":["知二五而不知十"],"usage":"作宾语、定语；用于处事"},{"id":33860,"word":"知人下士","pinyin":"zhī rén xià shì","abbr":"zrxs","explanation":"知：识别。下士：屈己尊人。能识别人才并礼贤下士。","source":{"text":"以此见真正高阳酒徒之能知人下士，识才尊贤又如此，故吾以为真正高阳酒徒可敬也。","book":"明·李贽《焚书·复麻城人书》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":33861,"word":"知人之明","pinyin":"zhī rén zhī míng","abbr":"zrzm","explanation":"明：指眼光。能看出人的品行才能的眼力。","source":{"text":"功曹以祐倨，请黜之。太守曰：‘吴季英有知人之明，卿且勿言。’","book":"《后汉书·吴佑传》"},"example":{"text":"前任督宪是兄弟同门世好，最有～。阁下不以兄弟不才，时加教诲，为幸多矣！（清·吴趼人《二十年目睹之怪现状》第七十二回）"},"similar":["知人之鉴"],"usage":"作宾语；指看人的眼力"},{"id":33862,"word":"知人之术","pinyin":"zhī rén zhī shù","abbr":"zrzs","explanation":"能看出人的品行才能的能力。","source":{"text":"即屈轶已自生于庭之末，佞人来辄指知之，则舜何难于知佞人，而使皋陶陈知人之术？","book":"汉·王充《论衡·是应篇》"},"example":{"text":"那段故事是说曹操童年时曾向一位有～、会品评人物的许劭请教自己的未来。（丁中江《北洋军阀史话》二）"},"similar":["知人之明","知人之鉴"],"usage":"作宾语；指看人的眼力"},{"id":33863,"word":"知人之鉴","pinyin":"zhī rén zhī jiàn","abbr":"zrzj","explanation":"能看出人的品行才能的眼力。同“知人之明”。","source":{"text":"颖川司马徽清雅有知人之鉴。","book":"《三国志·蜀志·庞统传》"},"example":{"text":"时称勣有～。","book":"唐·刘肃《大唐新语·知微》"},"similar":["知人之明","知人之术"],"usage":"作宾语；指看人的眼力"},{"id":33864,"word":"知人则哲","pinyin":"zhī rén zé zhé","abbr":"zrzz","explanation":"指能鉴察人的品行才能，即可谓之明智。","source":{"text":"哲，智；官，任……言知人则能器使。","book":"《书·皋陶谟》：“知人则哲，能官人。”曾运乾正读"},"example":{"text":"～，振古所难。","book":"《魏书·肃宗纪》"},"usage":"作宾语、定语；用于书面语"},{"id":33865,"word":"知人善任","pinyin":"zhī rén shàn rèn","abbr":"zrsr","explanation":"知：了解，知道；任：任用，使用。善于认识人的品德和才能，最合理地使用。","source":{"text":"盖在高祖，其兴也有五：一曰帝尧之功裔，二曰体貌多奇异，三曰神武有征应，四曰宽明而仁恕，五曰知人善任使。","book":"汉·班彪《王命论》"},"example":{"text":"只有～，才能人尽其才。"},"similar":["任人唯贤"],"opposite":["妒贤嫉能","任人唯亲"],"usage":"作谓语、宾语；指用人"},{"id":33866,"word":"知人善察","pinyin":"zhī rén shàn chá","abbr":"zrsc","explanation":"善于识别观察人才。","source":{"text":"知人善察，难眩以伪。","book":"《三国志·魏志·武帝纪》裴松之注引《魏书》"},"usage":"作谓语、定语；用于处事"},{"id":33867,"word":"知人待士","pinyin":"zhī rén dài shì","abbr":"zrds","explanation":"指对待人的态度好。","source":{"text":"先主之弘毅宽厚，知人待士。盖有高祖之风。","book":"清·夏敬渠《野叟曝言》第75回"},"usage":"作谓语、定语；指对待人的态度"},{"id":33868,"word":"知人料事","pinyin":"zhī rén liào shì","abbr":"zrls","explanation":"能识别人才，预料事情的变化。","source":{"text":"知人料事，尤其所难。","book":"宋·胡仔《苕溪渔隐丛话前集·李谪仙》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33869,"word":"知人知面不知心","pinyin":"zhī rén zhī miàn bù zhī xīn","abbr":"zrzmbzx","explanation":"旧时俗语。指认识一个人容易，但要了解一个人的内心却很困难。","source":{"text":"哥也，知人知面不知心，你道无二心呵，他怎生背了刘武周，投降了俺来。","book":"元·尚仲贤《单鞭夺槊》第二折"},"example":{"text":"这才是‘～’呢。那里有这样禽兽的人？”（清·曹雪芹《红楼梦》第十一回","book":"凤姐儿故意的把脚放迟了，见他远去了，心里暗忖道"},"similar":["知人知面","画虎画皮难画骨"],"usage":"作宾语、分句；指难于识人"},{"id":33870,"word":"知人论世","pinyin":"zhī rén lùn shì","abbr":"zrls","explanation":"原指了解一个人并研究他所处的时代背景。现也指鉴别人物的好坏，议论世事的得失。","source":{"text":"颂其诗，读其书，不知其人可乎？是以论其世也。","book":"《孟子·万章下》"},"example":{"text":"不过倘要研究文学或某一作家，所谓“～”，那么，足以应用的选本就很难得。","book":"鲁迅《且介亭杂文二集·“题未定”草》"},"similar":["知人论事"],"usage":"作谓语；指鉴别人物的好坏"},{"id":33871,"word":"知今博古","pinyin":"zhī jīn bó gǔ","abbr":"zjbg","explanation":"贯通古今。形容知识渊博。","source":{"text":"知今博古通三教，铁石人一见了也魂消。","book":"元·赵彦晖《点绛唇·席上咏妓》曲"},"similar":["博古通今"],"usage":"作谓语、定语；用于书面语"},{"id":33872,"word":"知以藏往","pinyin":"zhì yǐ cáng wǎng","abbr":"zycw","explanation":"知：同“智”，才智；以：已经；藏：包含。人的智慧包含在过去的事物中。比喻聪明才智来源于过去的经验教训。","source":{"text":"神以知来，知以藏往。","book":"《周易·系辞上》"},"usage":"作宾语、定语；用于书面语"},{"id":33873,"word":"知其一不知其二","pinyin":"zhī qí yī bù zhī qí èr","abbr":"zqybzqe","explanation":"只了解事物的一方面，而不了解其他方面。形容对事物的了解不全面。","source":{"text":"知其一不知其二，治其内而不治其外。","book":"战国·宋·庄周《庄子·天地》"},"example":{"text":"什么事情都不能只～。","book":"叶圣陶《倪焕之》"},"similar":["知其然而不知其所以然"],"opposite":["知根知底"],"usage":"作谓语、分句；指了解片面"},{"id":33874,"word":"知其一不达其二","pinyin":"zhī qí yī bù dá qí èr","abbr":"zqybdqe","explanation":"只了解事物的一方面，而不了解其他方面。形容对事物的了解不全面","source":{"text":"知其一，不达其二；见其利，不睹其害。","book":"宋·苏轼《汉武帝论》"},"similar":["知其一不知其二","知其一未睹其二"],"usage":"作谓语、分句；指了解片面"},{"id":33875,"word":"知其一未睹其二","pinyin":"zhī qí yī wèi dǔ qí èr","abbr":"zqywdqe","explanation":"只了解事物的一方面，而不了解其他方面。形容对事物的了解不全面","source":{"text":"若客所谓知其一未睹其二，见其外不识其内也。","book":"汉·扬雄《长扬斌》"},"similar":["知其一未知其二","知其一不达其二"],"usage":"作谓语、分句；指了解片面"},{"id":33876,"word":"知其一未知其二","pinyin":"zhī qí yī wèi zhī qí èr","abbr":"zqywzqe","explanation":"只了解事物的一方面，而不了解其他方面。形容对事物的了解不全面","source":{"text":"公知其一，未知其二。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"茅盾《创造》：“娴娴，你的话正象你的思想和行动：～。”"},"similar":["知其一未睹其二","知其一不知其二"],"usage":"作谓语、分句；指了解片面"},{"id":33877,"word":"知其一，不知其二","pinyin":"zhī qí yī，bù zhī qí èr","abbr":"zqybzqe","explanation":"知道事物的一方面，不知道还有另一方面。形容对事物的了解不全面。","source":{"text":"不敢暴虎，不敢冯河，人知其一，莫知其它。","book":"《诗经·小雅·小旻》"},"example":{"text":"你只～，如今路多险峻，我挑着重担，着实难走。","book":"明·吴承恩《西游记》第四十七回"},"similar":["只知其一，不知其二"],"usage":"作谓语、定语；用于处事等"},{"id":33878,"word":"知其一，未睹其二","pinyin":"zhī qí yī，wèi dǔ qí èr","abbr":"zqywdqe","explanation":"知道事物的一方面，不知道还有另一方面。形容对事物的了解不全面。","source":{"text":"不敢暴虎，不敢冯河，人知其一，莫知其它。","book":"《诗经·小雅·小旻》"},"example":{"text":"若客，所谓～，见其外不识其内也。（汉·扬雄《长杨赋》）"}},{"id":33879,"word":"知其一，未知其二","pinyin":"zhī qí yī，wèi zhī qí èr","abbr":"zqywzqe","explanation":"知道事物的一方面，不知道还有另一方面。形容对事物的了解不全面。","source":{"text":"识其一不识其二，治其内而不治其外。","book":"《诗经·小雅·小旻》：“不敢暴虎，不敢冯河，人知其一，莫知其它。”《庄子·天地》"},"example":{"text":"你这个话儿虽然不错，却是只～。（清·张春帆《九尾龟》第一百七十九回）"}},{"id":33880,"word":"知其不可为而为","pinyin":"zhī qí bù kě wéi ér wéi","abbr":"zqbkwew","explanation":"为：做。明知做不到却偏要去做，指意志坚决或倔强固执","source":{"text":"许多事情明明是知其不可为而为，但却丝毫也不能放松，不肯放松。","book":"郭沫若《南京印象》"},"similar":["知其不可为而为之"],"usage":"作谓语、宾语；用于处事"},{"id":33881,"word":"知其不可为而为之","pinyin":"zhī qí bù kě wéi ér wéi zhī","abbr":"zqbkwewz","explanation":"为：做。明知做不到却偏要去做，指意志坚决或倔强固执","source":{"text":"在明末诸忠臣中，我对于瞿式耜的评价，比史可法还高些……因为瞿比史更富于‘知其不可为而为之’的精神。","book":"茅盾《从说起》"},"similar":["知其不可而为之","知其不可为而为"],"usage":"作谓语、宾语；用于处事"},{"id":33882,"word":"知其不可而为之","pinyin":"zhī qí bù kě ér wéi zhī","abbr":"zqbkewz","explanation":"明知做不到却偏要去做。表示意志坚决。有时也表示倔强固执。","source":{"text":"子路宿于石门。晨门曰：‘奚自？’子路曰：‘自孔氏。’曰：‘是知其不可而为之者与？’","book":"《论语·宪问》"},"example":{"text":"吾辈固～耳。","book":"章炳麟《致伯中书十四》"},"similar":["知其不可为而为之"],"usage":"作谓语、宾语；指意志坚决"},{"id":33883,"word":"知其然而不知其所以然","pinyin":"zhī qí rán ér bù zhī qí suǒ yǐ rán","abbr":"zqrebzqsyr","explanation":"然：这样，如此。知道是这样，但不知道为什么是这样。只知道事物的表面现象，不知事物的本质及其产生的原因","source":{"text":"无论为哀为乐，为怨为怒，为恋为骇，为忧为惭，常若知其然而不知其所以然。","book":"梁启超《论小说与群治之关系》"},"similar":["只知其然，而不知其所以然"],"usage":"作谓语、宾语；用于书面语"},{"id":33884,"word":"知其然，不知其所以然","pinyin":"zhī qí rán，bù zhī qí suǒ yǐ rán","abbr":"zqrbzqsyr","explanation":"然：这样。知道是这样，却不知道为什么是这样。形容只了解表面现象，不了解事物的本质或事情的根底。","source":{"text":"自然者，物见其然，不知所以然；同焉皆得，不知所以得。","book":"《庄子·秋水》：“今予动吾天机，而不知其所以然。”南朝·梁·刘孝标《辩命论》"},"example":{"text":"只是当时知其然而不知其所以然，自不免惊世骇俗。（金庸《射雕英雄传》第二十八回）"}},{"id":33885,"word":"知冷知热","pinyin":"zhī lěng zhī rè","abbr":"zlzr","explanation":"关心痛养起居，照顾周到细致。","example":{"text":"这样～的朋友难找。"},"similar":["知疼着热"],"usage":"作谓语、定语；指对人的关心"},{"id":33886,"word":"知几其神","pinyin":"zhī jī qí shén","abbr":"zjqs","explanation":"几：几微。指人能预知事情萌发的细微迹象，就能与神道相合。","source":{"text":"子曰：知几其神乎？","book":"《周易·系辞下》"}},{"id":33887,"word":"知出乎争","pinyin":"zhì chū hū zhēng","abbr":"zchz","explanation":"智：同“智”；争：斗争。聪明才智是在反复斗争中锻炼出来的。比喻智慧来源于实践。","source":{"text":"德荡乎名，知出乎争。名也者，相轧也；知也者，争之器也。","book":"《庄子·人间世》"},"usage":"作宾语、定语；用于书面语"},{"id":33888,"word":"知名当世","pinyin":"zhī míng dāng shì","abbr":"zmds","explanation":"知名：著名、有名。在当代很著名。","source":{"text":"图画相次于未央宫，第一曰大司马大将军博陆侯霍光，次曰卫将军富平侯张安世……皆有功德，知名当世。","book":"汉·荀悦《汉纪·宣帝纪四》"},"example":{"text":"石曼卿磊落奇才，～。","book":"宋·欧阳修《归田录》卷二"},"usage":"作谓语、定语；用于书面语"},{"id":33889,"word":"知命不忧","pinyin":"zhī mìng bù yōu","abbr":"zmby","explanation":"识天命者无忧虑。","source":{"text":"乐天知命，故不忧。","book":"《周易·系辞上》"},"example":{"text":"达人大观，～。","book":"明·刘基《愁鬼言》"},"usage":"作宾语；指识天命者无忧虑"},{"id":33890,"word":"知命不惑","pinyin":"zhī mìng bù huò","abbr":"zmbh","explanation":"对生命、自然有了很好的了解，随遇而安，不迷惑。","source":{"text":"以己之不直，而谓人皆然。其植之也固久，其除之也实难，非百年必世，不可得而化也，非知命不惑，不可得而改也。","book":"覣·韩愈《送齐下第序》"}},{"id":33891,"word":"知命之年","pinyin":"zhī mìng zhī nián","abbr":"zmzn","explanation":"知道自己命运的年龄。指50岁。","source":{"text":"～，有一子，始弱冠矣。 ★唐·白行简《李娃传》"},"example":{"text":"唐·白行简《李娃传》：“～，有一子，始弱冠矣。”"},"usage":"作宾语；指50岁，用于男性","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，经历知命之年以致现在快七十岁没能推销出仁政，感慨万千……宰予立即过来安慰孔子"]},{"id":33892,"word":"知命乐天","pinyin":"zhī mìng lè tiān","abbr":"zmlt","explanation":"命：命运；天：天意。安于自己的处境，由命运安排。这是相信宿命论的人生观。","source":{"text":"乐天知命，故不忧。","book":"《周易·系辞上》"},"example":{"text":"道既不行，复不能～，又不能隐于山薮。","book":"唐·陈子昂《无端贴》"},"similar":["乐天知命"],"usage":"作谓语、定语、宾语；用于处事"},{"id":33893,"word":"知命安身","pinyin":"zhī mìng ān shēn","abbr":"zmas","explanation":"服从命运，安于自身所处的地位。","source":{"text":"量范雎是一愚瞽之夫，则可待时守分，知命安身，未敢希望功名也。","book":"元·无名氏《滓范叔》第一折"},"usage":"作谓语、宾语、定语；用于处事"},{"id":33894,"word":"知地知天","pinyin":"zhī dì zhī tiān","abbr":"zdzt","explanation":"地：地形：天：天气。了解地形，了解气候。","source":{"text":"知彼知己，胜乃不殆；知天知地，胜乃可全。","book":"《孙子·地形》"},"similar":["知天知地"],"usage":"作谓语、宾语；用于书面语"},{"id":33895,"word":"知天知地","pinyin":"zhī tiān zhī dì","abbr":"ztzd","explanation":"天：天气；地：地形。了解地形，了解气候。","source":{"text":"知地知天，胜乃可全。","book":"《孙子·地形》"},"similar":["知地知天"],"usage":"作谓语、宾语；用于书面语"},{"id":33896,"word":"知奸亦有大罗","pinyin":"zhī jiān yì yǒu dà luó","abbr":"zjyydl","explanation":"罗：网。捉拿奸贼需要有大罗网。比喻治理国家要靠大众的力量。","source":{"text":"故宋人语曰：‘一雀过羿，羿必得之，则羿诬矣。以天下为之罗，则雀不失矣。’夫知奸亦有大罗，不失其一而已矣。","book":"《韩非子·难三》"},"usage":"作宾语、定语；用于书面语"},{"id":33897,"word":"知子莫若父","pinyin":"zhī zǐ mò ruò fù","abbr":"zzmrf","explanation":"没有比父亲更了解儿子的了。","source":{"text":"知子莫若父，知臣莫若君。","book":"《管子·大匡》"},"example":{"text":"他的事，最好问他父亲，～嘛！"},"similar":["知女莫若母"],"usage":"作宾语、分句；指父亲最了解自己的儿子"},{"id":33898,"word":"知安忘危","pinyin":"zhī ān wàng wēi","abbr":"zaww","explanation":"只知道过太平日子而忘记危险的时候。","source":{"text":"彼知安而忘危兮，故出生而入死。","book":"晋·潘岳《秋兴赋》"},"opposite":["居安思危"],"usage":"作宾语、定语；用于书面语"},{"id":33899,"word":"知小言大","pinyin":"zhì xiǎo yán dà","abbr":"zxyd","explanation":"知：通“智”。聪明才智不济，说话口气却很大","source":{"text":"侯君集破高昌还，颇怨望。道宗尝从容奏言：‘君集知小言大，且为戎首。’……既而君集反，帝笑曰：‘如公素揣。’","book":"《新唐书·李道宗传》"},"similar":["智小言大"],"usage":"作谓语、定语；用于书面语"},{"id":33900,"word":"知小谋大","pinyin":"zhī xiǎo móu dà","abbr":"zxmd","explanation":"指能力太差，不能胜任重大的任务。","source":{"text":"德薄而位尊，知小而谋大，力小而任重，鲜不及也。","book":"《易·系辞下》"},"example":{"text":"唐·刘知畿《思慎赋》序：“每思才轻任重之诫，～之忧……庶几全父母之发肤，保先人之丘墓。”"},"similar":["智小谋大","知小言大"],"usage":"作谓语、定语；用于书面语"},{"id":33901,"word":"知尽能索","pinyin":"zhī jìn néng suǒ","abbr":"zjns","explanation":"比喻智慧能力都竭尽了。","source":{"text":"农工商贾畜长，固求富益货也。此有知尽能索耳，终不余力而让财矣。","book":"《史记·货殖列传》"},"similar":["智尽能索","智尽力穷"],"usage":"作谓语、定语；用于书面语"},{"id":33902,"word":"知己之遇","pinyin":"zhī jǐ zhī yù","abbr":"zjzy","explanation":"遇：待遇。像对知己一样的待遇。形容受到赏识。","source":{"text":"公生于扰攘之时，感知己之遇。","book":"《旧唐书·魏徵传》"},"example":{"text":"吾以羁旅亡命，受齐侯～，今日不能出力，反害偻堙，殆天意也！","book":"《东周列国志》第六十五回"},"usage":"作宾语；用于书面语"},{"id":33903,"word":"知己知彼","pinyin":"zhī jǐ zhī bǐ","abbr":"zjzb","explanation":"原意是如果对敌我双方的情况都能了解透彻，打起仗来就可以立于不败之地。泛指对双方情况都很了解。","source":{"text":"知己知彼，百战不殆。","book":"《孙子·谋攻》"},"example":{"text":"对付敌人，一定要～，才能百战百胜。","book":"曲波《林海雪原》十一"},"similar":["了如指掌","明察秋毫","自知之明"],"opposite":["心中无数","不得要领","雾里看花"],"usage":"作谓语、宾语；用于军事、商业等","story":["春秋时期，军事家孙武著书《兵法》，认为使敌人举国完整的屈服就是上策，出兵打破那个国家就要差一些。要善于运用计谋不战而屈人之兵，同时做到知己知彼、百战不殆。百战百胜还不是最高明的，只有不通过战斗而使敌人屈服才高明"]},{"id":33904,"word":"知希之贵","pinyin":"zhī xī zhī guì","abbr":"zxzg","explanation":"希：少；贵：珍贵。了解的人少，就会显得珍贵。","source":{"text":"知我者希，则我者贵。","book":"《老子》第七十章"},"example":{"text":"此～，贤豪所以感结而不能自已也。（清·蒲松龄《聊斋志异·连城》）"},"usage":"作宾语；用于书面语"},{"id":33905,"word":"知希则贵","pinyin":"zhī xī zé guì","abbr":"zxzg","explanation":"希：少；贵：珍贵。了解的人少，就会显得珍贵。","source":{"text":"知我者希，则我者贵。","book":"《老子》第七十章"}},{"id":33906,"word":"知幾其神","pinyin":"zhī jī qí shén","abbr":"zjqs","explanation":"幾：幾微，细微。指人能够预知事情萌发的细微迹象，就能与神道相合","source":{"text":"子曰：‘知幾其神乎。’","book":"《周易·系辞下》"},"example":{"text":"唐·权德舆《幾铭》：“～，孔父、周文去圣远矣，时无其人，见幾而作。”"},"usage":"作宾语、定语；用于书面语"},{"id":33907,"word":"知彼知己","pinyin":"zhī bǐ zhī jǐ","abbr":"zbzj","explanation":"原意是如果对敌我双方的情况都能了解透彻，打起仗来就可以立于不败之地。泛指对双方情况都很了解。","source":{"text":"知己知彼，百战不殆。","book":"《孙子·谋攻》"},"example":{"text":"对付敌人，一定要～，才能百战百胜。"},"similar":["知己知彼"],"opposite":["一问三不知"],"usage":"作谓语、宾语、定语；用于军事、商业等","story":["春秋时期，军事家孙武著书《兵法》，认为使敌人举国完整的屈服就是上策，出兵打破那个国家就要差一些。要善于运用计谋不战而屈人之兵，同时做到知己知彼、百战不殆。百战百胜还不是最高明的，只有不通过战斗而使敌人屈服才高明"]},{"id":33908,"word":"知往鉴今","pinyin":"zhī wǎng jiàn jīn","abbr":"zwjj","explanation":"鉴：借鉴。了解过去作为今天的借鉴。","source":{"text":"知往鉴今，驱曹荡吴，非同小可也。","book":"明·无名氏《太平宴》第一折"},"similar":["借古鉴今"],"usage":"作谓语、宾语、定语；指借鉴以往的经验"},{"id":33909,"word":"知微知彰","pinyin":"zhī wēi zhī zhāng","abbr":"zwzz","explanation":"微：细小。彰：明显。既了解细小的萌芽状态，又了解发展起来后的显着特征。形容了解事物发展的始末。亦作“知微知章”、“知章知微”。","source":{"text":"相兼二八，知微知彰；将称四七，如貔如虎。","book":"《易·系辞下》：“君子知微知彰，知柔知刚，万夫之望。”南朝·梁元帝《法宝朕璧序》"},"example":{"text":"南朝·梁·梁元帝《法宝联壁序》：“相兼二八，～；将称四七，如狴如虎。”"},"similar":["知微知章","知章知微"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":33910,"word":"知微知章","pinyin":"zhī wēi zhī zhāng","abbr":"zwzz","explanation":"既了解细小的萌芽状态，又了解发展起来后的显着特征。形容了解事物发展的始末。同“知微知彰”。","source":{"text":"圣人淳耀，能兼二美，知微知章。自非圣人，莫能两遂。","book":"三国·魏·刘劭《人物志·九徵》"},"example":{"text":"圣人～，不可不慎。","book":"《旧唐书·儒学传下·卢粲》"},"similar":["知微知彰","知章知微"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":33911,"word":"知心可腹","pinyin":"zhī xīn kě fù","abbr":"zxkf","explanation":"犹言情投意合。","source":{"text":"知心可腹，牵肠割肚，不枉了用工夫。","book":"元·王晔《折桂令·问黄肇》曲：“怕不你身上知心可腹，争知他根前似水如鱼。”元·贯云石《小桃红》曲"},"usage":"作谓语、定语；用于书面语"},{"id":33912,"word":"知心着意","pinyin":"zhī xīn zháo yì","abbr":"zxzy","explanation":"指彼此了解，心意投合。","source":{"text":"等我团熟了他，牵与师父，包你像意。老和尚道：‘这才是知心着意的肉。’","book":"元·吴昌龄《张天师》第二折：“那仓公扁鹊成何济，也无过草树根皮，怎比得玉天仙知心着意。”明·凌蒙初《初刻拍案惊奇》卷二十六"},"example":{"text":"我只怨着我死了，再没一个～的人服伺你了！","book":"清·曾朴《孽海花》第二十三回"},"similar":["知心知意"],"usage":"作谓语、定语；用于书面语"},{"id":33913,"word":"知心知意","pinyin":"zhī xīn zhī yì","abbr":"zxzy","explanation":"指彼此了解，心意投合。同“知心着意”。","source":{"text":"抬眼看时，只见两个人并肩而坐，正在那里知心知意的商量。","book":"明·凌濛初《二刻拍案惊奇》卷三十五"},"example":{"text":"如今宝姐姐家去了，连香菱也不能过来，二姐姐又出了门子了，几个～的人都不在一处，弄得这样光景。","book":"清·曹雪芹《红楼梦》第八十一回"},"similar":["知心着意"],"usage":"作谓语、定语；用于书面语"},{"id":33914,"word":"知必言，言必尽","pinyin":"zhī bì yán，yán bì jìn","abbr":"zbyybj","explanation":"知道的就说，要说就毫无保留。","source":{"text":"知无不言，言无不尽，百人誉之不加密，百人毁之不加疏。","book":"宋·苏洵《衡论·远虑》"},"example":{"text":"使贤于天下之事～。陛下于贤之言闻必行，行必力。（《明史·罗伦传》）"},"similar":["知无不言，言无不尽"],"usage":"作宾语、分句；用于处事"},{"id":33915,"word":"知恩必报","pinyin":"zhī ēn bì bào","abbr":"zebb","explanation":"知道受了恩惠就一定要报答。","source":{"text":"小生我怀旧意无私志，小姐白玉带知恩必报恩。","book":"元·关汉卿《裴度还带》第四折"},"example":{"text":"铭心镂骨，感德难忘；结草衔环，～。（明·程登吉《幼学琼林·人事》）"},"usage":"作谓语、定语；用于处事"},{"id":33916,"word":"知恩报德","pinyin":"zhī ēn bào dé","abbr":"zebd","explanation":"知道了受人家的恩惠就报答人家的恩惠。同“知恩报恩”。","source":{"text":"可怜见咱魂销尽，知恩报德情难混。","book":"《群英类选·〈红蕖记·触身谐配〉》"},"similar":["知恩报恩"],"usage":"作谓语、宾语；指知恩图报"},{"id":33917,"word":"知恩报恩","pinyin":"zhī ēn bào ēn","abbr":"zebe","explanation":"知道了受人家的恩惠就报答人家的恩惠。","source":{"text":"掩家里有信行，知恩报恩。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"这虽是小事，也可见得他～的诚心。","book":"清·吴趼人《二十年目睹之怪现状》第四十二回"},"similar":["知恩图报","知恩报德"],"opposite":["恩将仇报"],"usage":"作谓语、宾语；指知恩图报"},{"id":33918,"word":"知情不举","pinyin":"zhī qíng bù jǔ","abbr":"zqbj","explanation":"举：检举。了解情况而不揭发。","source":{"text":"我为巡城之职，理宜奏闻；若为朋友之情，匿而不奏，这知情不举的罪名，亦所不免。","book":"清·吴璿《飞龙全传》第一回"},"example":{"text":"迨后听得连自己参劾了，道是通同作弊，～的罪名，就知自己有些不便，镇日将大门紧关。","book":"清·黄小配《廿载繁华梦》第三十六回"},"usage":"作谓语、定语、宾语；用于处事"},{"id":33919,"word":"知情不报","pinyin":"zhī qíng bù bào","abbr":"zqbb","explanation":"知道情况而不报告，特指没有犯罪的人主动地或被动地对当局隐匿别人的叛逆罪或重罪的行为。","example":{"text":"～同样有罪。"},"similar":["知情不举"],"usage":"作主语、谓语、定语；指瞒而不报"},{"id":33920,"word":"知情识趣","pinyin":"zhī qíng shí qù","abbr":"zqsq","explanation":"懂情意，善体贴。","source":{"text":"难得这好人，又忠厚，又老实，又且知情识趣，隐恶扬善，千百中难遇此一人。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"要仔细看看这个婆娘……到底像不像陆茂林所说的那样又规规矩矩、又～？","book":"李劼人《死水微澜》第六部分二"},"similar":["知音识趣"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":33921,"word":"知情达理","pinyin":"zhī qíng dá lǐ","abbr":"zqdl","explanation":"通、达：懂得；情：人之常情；理：道理。通人情，懂道理。","source":{"text":"二小姐知情达理，自有同心，当商量出一个主意来，不可徒作楚囚之泣。","book":"清·夏敬渠《野叟曝言》第四十回"},"example":{"text":"他是个～的人，从来不胡搅蛮缠。"},"similar":["通情达理"],"usage":"作谓语、定语；指人明事理"},{"id":33922,"word":"知我罪我","pinyin":"zhī wǒ zuì wǒ","abbr":"zwzw","explanation":"形容别人对自己的毁誉。","source":{"text":"《春秋》，天子之事也。是故孔子曰：‘知我者，其惟《春秋》乎！罪我者，其惟《春秋》乎！’","book":"战国·邹·孟轲《孟子·滕文公下》"},"example":{"text":"～，怜我杀我，悉听世人，不复能顾其后矣。","book":"清·李渔《闲情偶寄·词曲·结构》"},"usage":"作谓语、宾语；形容别人对自己的毁誉"},{"id":33923,"word":"知效一官","pinyin":"zhì xiào yī guān","abbr":"zxyg","explanation":"知：同“智”，才智；效：胜任。才智能力可以胜任一官之职","source":{"text":"故夫知效一官，行比一乡，德合一君，而征一国者，其自视也，亦若此矣。","book":"战国·宋·庄周《庄子·逍遥游》"},"usage":"作宾语、定语；用于书面语"},{"id":33924,"word":"知文达理","pinyin":"zhī wén dá lǐ","abbr":"zwdl","explanation":"知、达：懂得。有文化，讲道理。形容有教养。","source":{"text":"只我这知书达礼当恭谨，怎肯着出乖露丑遭谈论。","book":"元·无名氏《冯玉兰》第一折"},"example":{"text":"你既这等～，晓得敬重我，若肯住在这里，与我做个好淘伴，便饶你性命。（清·张南庄《何典》第十回）"}},{"id":33925,"word":"知文达礼","pinyin":"zhī wén dá lǐ","abbr":"zwdl","explanation":"有文化，懂礼仪。形容有教养。同“知书达礼”。","source":{"text":"你既这等知文达礼，晓得敬重我……便饶你性命。","book":"清·张南庄《何典》第十回"},"example":{"text":"我们喜欢那些～的君子"},"similar":["知书达礼","知书知礼","知书通礼"],"usage":"作谓语、定语；指人有修养"},{"id":33926,"word":"知无不为","pinyin":"zhī wú bù wéi","abbr":"zwbw","explanation":"知道是应该做的，就一定去做。形容尽心竭力。","source":{"text":"凡可以利益国家者，苟知其事，莫不尽心力而为之。","book":"《左传·僖公九年》：“公家之利，知无不为，忠也。”林尧叟注"},"example":{"text":"其人自以旷世遭遇，莫不悉心竭力，～，言无不尽。","book":"宋·秦观《任臣上》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":33927,"word":"知无不尽","pinyin":"zhī wú bù jìn","abbr":"zwbj","explanation":"犹知无不言。只要知道，就没有不说出来的。","source":{"text":"冲竭忠奉上，知无不尽，出入忧勤，形于颜色。","book":"《魏书·李冲传》"},"similar":["知无不言，言无不尽"],"usage":"作谓语、定语；指发表看法"},{"id":33928,"word":"知无不言","pinyin":"zhī wú bù yán","abbr":"zwby","explanation":"凡是知道的没有不说的。","source":{"text":"知无不言，言无不尽，百人誉之不加密，百人毁之不加疏。","book":"宋·苏洵《衡论·远虑》"},"example":{"text":"他非常直爽，别人对向他请教，他总是～。"},"similar":["畅所欲言"],"opposite":["默不做声","吞吞吐吐","闪烁其辞"],"usage":"作谓语、定语；指发表看法"},{"id":33929,"word":"知无不言，言无不听","pinyin":"zhī wú bù yán，yán wú bù tīng","abbr":"zwbyywbt","explanation":"知道的就毫无保留全说出来，听的则一句不差全部接受采纳。","source":{"text":"后与董文忠居中事上，同志协力，知无不言，言无不听，多所裨益，而言不外泄，帝深爱重之。","book":"《元史·贺仁杰传》"},"example":{"text":"此时素 臣正在得君，真个～。旬月之内，把在京在外贪官污吏参劾殆尽。（清·夏敬渠《野叟曝言》第四十九回）"},"usage":"作谓语、定语；用于处事"},{"id":33930,"word":"知无不言，言无不尽","pinyin":"zhī wú bù yán，yán wú bù jìn","abbr":"zwbyywbj","explanation":"知道的就说，要说就毫无保留。","source":{"text":"知无不言，言无不尽，百人誉之不加密，百人毁之不加疏。","book":"宋·苏洵《衡论·远虑》"},"example":{"text":"他非常直爽，别人对向他请教，他总是～。"},"similar":["知无不尽"],"usage":"作宾语、分句；指看问题"},{"id":33931,"word":"知时识务","pinyin":"zhī shí shí wù","abbr":"zssw","explanation":"务：事。能看清当时的大势和了解世事，不去违背。","source":{"text":"这是佛天面上好看的事，况我每知时识务，正该如此。","book":"明·凌濛初《二刻拍案惊奇》卷三十六"},"usage":"作谓语、定语、状语；用于处事"},{"id":33932,"word":"知易行难","pinyin":"zhī yì xíng nán","abbr":"zyxn","explanation":"知：懂得。认识事情的道理较易，实行其事较难。","source":{"text":"言知之易，行之难。","book":"《尚书·说命中》：“说拜稽首曰：‘非知之艰，行之惟艰。’”孔传"},"example":{"text":"现在提出这问题，盖亦～，遂只得空口说白话，而望垦辟于健者也。","book":"鲁迅《准风月谈·我们怎样教育儿童的？》"},"similar":["知之非艰，行之惟艰"],"opposite":["行易知难"],"usage":"作宾语、定语；指看似容易做时难"},{"id":33933,"word":"知机识变","pinyin":"zhī jī shí biàn","abbr":"zjsb","explanation":"指能了解、掌握时机，识别、适应时局的变化。","source":{"text":"皆谓猛将谋臣，知机识变，有唐之盛，斯实赖焉。","book":"《旧唐书·尉迟敬德等传论》"},"usage":"作宾语、定语；用于书面语"},{"id":33934,"word":"知机识窍","pinyin":"zhī jī shí qiào","abbr":"zjsq","explanation":"掌握时机和窍门。形容人机灵。","source":{"text":"你又知机识窍，见景生情，这事大有可成。","book":"清·夏敬渠《野叟曝言》第三十回"},"usage":"作谓语、定语；用于书面语"},{"id":33935,"word":"知来藏往","pinyin":"zhī lái cáng wǎng","abbr":"zlcw","explanation":"指对未来有所预见，对已往心中了然。","source":{"text":"神以知来，知以藏往。","book":"《周易·系辞上》"},"example":{"text":"有训诂事实以为之迹，有～以为之神。","book":"清·龚自珍《江子屏所著书叙》"},"usage":"作谓语；用于人"},{"id":33936,"word":"知根知底","pinyin":"zhī gēn zhī dǐ","abbr":"zgzd","explanation":"指有较深入的了解。","example":{"text":"我们是老朋友，彼此都～。"},"similar":["知根达底"],"usage":"作谓语、宾语；指相互了解"},{"id":33937,"word":"知止不殆","pinyin":"zhī zhǐ bù dài","abbr":"zzbd","explanation":"殆：危险。知道适可而止的人就不会遇到危险。旧时劝人行事不要过分。","source":{"text":"知足不辱，知止不殆，可以长久。","book":"《老子》第四十四章"},"example":{"text":"甚爱必大费，多藏必厚仁，知足不辱，～。","book":"明·赵弼《两教辨》"},"similar":["知足不殆"],"usage":"作谓语、定语；劝人行事不要过分"},{"id":33938,"word":"知止不辱","pinyin":"zhī zhǐ bù rǔ","abbr":"zzbr","explanation":"知道满足就不会受到羞辱。表示不要有贪心。同“知足不辱”。","source":{"text":"太傅疏广谓少傅受曰：‘吾闻“知止不辱，知足不殆”，功成名遂而身退，天之道也。’","book":"汉·荀悦《汉纪·宣帝纪二》"},"example":{"text":"［察罕］尝以病请告……顾李孟曰：“～，今见其人。”","book":"《元史·察罕传》"},"similar":["知足不辱，知止不殆"],"usage":"作谓语、定语；劝人行事不要过分"},{"id":33939,"word":"知水仁山","pinyin":"zhì shuǐ rén shān","abbr":"zsrs","explanation":"有人喜爱山，有人喜爱水。比喻各人的爱好不同。","source":{"text":"知者乐山，仁者乐水。","book":"《论语·雍也》"}},{"id":33940,"word":"知法犯法","pinyin":"zhī fǎ fàn fǎ","abbr":"zfff","explanation":"知道法律，又违反法律。指明知故犯。","source":{"text":"好僧官老爷！知法犯法！","book":"清·吴敬梓《儒林外史》第四回"},"example":{"text":"对～的人，应该严惩不贷。"},"similar":["明知故犯","执法犯法","以身试法"],"opposite":["遵纪守法"],"usage":"作谓语、分句；指明知故犯"},{"id":33941,"word":"知物由学","pinyin":"zhī wù yóu xué","abbr":"zwyx","explanation":"由：通过。要了解事物就必须通过认真的学习。","source":{"text":"人才有高下，知物由学，学之乃知，不问不识。","book":"汉·王充《论衡·实知》"},"usage":"作宾语、定语；用于书面语"},{"id":33942,"word":"知生之民","pinyin":"zhī shēng zhī mín","abbr":"zszm","explanation":"知生：求生存。指在与自然界斗争中求生存的远古人民","source":{"text":"古者民不知衣服，夏多积薪，冬则炀之，故命之曰知生之民。","book":"战国·宋·庄周《庄子·盗跖》"},"usage":"作宾语；用于书面语"},{"id":33943,"word":"知疼着热","pinyin":"zhī téng zháo rè","abbr":"ztzr","explanation":"着：感受。形容对人十分关心爱护（多指亲人）。","source":{"text":"亲生的，正在乎知疼着热，才是儿子。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"example":{"text":"无奈二姐儿倒是个多情人，以为贾琏是终身之主了，凡事倒还～。","book":"清·曹雪芹《红楼梦》第六十五回"},"similar":["知疼着痒"],"usage":"作谓语、定语；多指亲人或夫妻之间"},{"id":33944,"word":"知疼着痒","pinyin":"zhī téng zháo yǎng","abbr":"ztzy","explanation":"形容对亲人的关怀、体贴。","source":{"text":"无奈二姐倒是个多情的人，以为贾琏是终身之主了，凡事倒还知疼着痒。","book":"清·曹雪芹《红楼梦》第65回"},"similar":["知疼着热"],"usage":"作谓语、定语；指关心人"},{"id":33945,"word":"知白守辱","pinyin":"zhī bái shǒu rǔ","abbr":"zbsr","explanation":"守：保持。意思是对是非黑白，虽然明白，还当保持暗昧，如无所见。这是道家的消极处世态度。","source":{"text":"知其白，守其辱，为天下谷。","book":"《庄子·天下》"},"similar":["知白守黑"],"usage":"作谓语、定语；用于书面语"},{"id":33946,"word":"知白守黑","pinyin":"zhī bái shǒu hēi","abbr":"zbsh","explanation":"守：保持。意思是对是非黑白，虽然明白，还当保持暗昧，如无所见。这是道家的消极处世态度。","source":{"text":"知其白，守其黑，为天下式。","book":"《老子》"},"example":{"text":"孔公之堂名虚白，苏子堂后作圆屋。堂虽白关庵自黑，～名曰谷。","book":"宋·胡仔《苕溪渔隐丛话后集·东坡二》"},"similar":["知白守辱"],"usage":"作谓语、定语；这是道家的消极处世态度"},{"id":33947,"word":"知章知微","pinyin":"zhī zhāng zhī wēi","abbr":"zzzw","explanation":"既了解细小的萌芽状态，又了解发展起来后的显着特征。形容了解事物发展的始末。同“知微知彰”。","source":{"text":"克岐克嶷，知章知微。","book":"晋·潘岳《杨仲武诔》"},"similar":["知微知章","知微知彰"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":33948,"word":"知羞识廉","pinyin":"zhī xiū shí lián","abbr":"zxsl","explanation":"羞：羞愧。廉：廉耻。指人知道羞愧、廉耻。形容有修养。","source":{"text":"小妮子非抛闪，知羞识廉。","book":"明·汤显祖《紫钗记》第四十五出"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33949,"word":"知而不争","pinyin":"zhī ér bù zhēng","abbr":"zebz","explanation":"争：争辩。了解是非却不据理力争。形容不坚持原则。","source":{"text":"知而不争，不可谓忠。","book":"《墨子·公输》"},"example":{"text":"庆闻君蔽于事为不明，臣～为不忠。（《资治通鉴·梁纪·高祖太清二年》）"},"usage":"作谓语、定语；用于处事"},{"id":33950,"word":"知而不言","pinyin":"zhī ér bù yán","abbr":"zeby","explanation":"明明知道而不说。","source":{"text":"知道易，勿言难。知而不言，所以之天也；知而言之，所以之人也。","book":"《庄子·列御寇》"},"example":{"text":"《周书·侯植传》：“兄既受人任使，安得～。”"},"usage":"作宾语、定语；用于处事"},{"id":33951,"word":"知而故犯","pinyin":"zhī ér gù fàn","abbr":"zegf","explanation":"明明知道不能做，却故意违犯。","source":{"text":"问：‘一切含灵具有佛性，既有佛性，为甚么却撞入驴胎马腹？’师曰：‘知而故犯。’","book":"宋·释普济《五灯会元》卷十九"},"similar":["明知故犯"],"usage":"作谓语、宾语；用于处事"},{"id":33952,"word":"知耻近乎勇","pinyin":"zhī chǐ jìn hū yǒng","abbr":"zcjhy","explanation":"知道羞耻，已经接近了勇敢","source":{"text":"好学近乎知，力行近乎仁，知耻近乎勇，知斯三者，则知所以修身。","book":"西汉·戴圣《礼记·中庸》"},"usage":"作宾语、定语；用于书面语"},{"id":33953,"word":"知荣守辱","pinyin":"zhī róng shǒu rǔ","abbr":"zrsr","explanation":"守：安于。虽然知道怎样可得到荣誉，却安于受屈辱的地位。","source":{"text":"知其荣，守其辱，为天下谷。","book":"《老子》第二十八章"},"usage":"作谓语；道家的一种处世方式"},{"id":33954,"word":"知行合一","pinyin":"zhī xíng hé yī","abbr":"zxhy","explanation":"指认识事物的道理与实行其事，是密不可分的一回事。","source":{"text":"只说一个知，已自有行在；只说一个行，已自有知在。古人所以既说一个知，又说一个行者，只为世间有一种人懵懵懂懂的任意去做，全不解思惟省察也，只是个冥行妄作，所以必说个知，方才行得……某今说个知行合一，正是对病的药。","book":"明·王守仁《传习录》卷上"},"example":{"text":"从晓庄师范到山海工学团，陶先生一以贯之的精神是‘～’、‘教学做合一’，力求培养学生从整体上驾驭知识的能力。","book":"《文汇报》1990.3.11"},"usage":"作宾语、定语；用于书面语"},{"id":33955,"word":"知表不知里","pinyin":"zhī biǎo bù zhī lǐ","abbr":"zbbzl","explanation":"表：外表；里：本质。只看到了人或事物的表面，并不了解其本质。"},{"id":33956,"word":"知足不殆","pinyin":"zhī zú bù dài","abbr":"zzbd","explanation":"指适可而止，就不会遇到危险。旧时劝人行事不要过分。同“知止不殆”。","source":{"text":"太傅疏广谓少傅受曰：‘吾闻“知止不辱，知足不殆”，功成名遂而身退，天之道也。’","book":"汉·荀悦《汉纪·宣帝纪二》"},"similar":["知足不辱，知止不殆"],"usage":"作宾语、定语；用于劝诫人"},{"id":33957,"word":"知足不辱","pinyin":"zhī zú bù rǔ","abbr":"zzbr","explanation":"知道满足就不会受到羞辱。表示不要有贪心。","source":{"text":"吾闻知足不辱，知止不殆。","book":"《老子》第四十四章：“知足不辱，知止不殆，可以长久。”《汉书·疏广传》"},"example":{"text":"常言：“～。”官人宜急流勇退，为山林娱老之计。","book":"明·冯梦龙《警世通言》卷三十一"},"similar":["知止不辱"],"usage":"作谓语、宾语；表示不要有贪心"},{"id":33958,"word":"知足不辱，知止不殆","pinyin":"zhī zú bù rǔ，zhī zhǐ bù dài","abbr":"zzbrzzbd","explanation":"殆：危险。知道满足就不会受到羞辱，知道适可而止的人就不会遇到危险。多用以劝诫人不要贪得无厌。","source":{"text":"知足不辱，知止不殆，可以长久。","book":"《老子》第四十四章"},"example":{"text":"二疏有言：“～。”既无出类拔萃之才，宜急流勇退，以避贤路。（明·冯梦龙《醒世恒言》卷二）"},"similar":["知止不辱","知足不殆"],"usage":"作宾语、定语；用于劝诫人"},{"id":33959,"word":"知足之计","pinyin":"zhī zú zhī jì","abbr":"zzzj","explanation":"指以知道满足为处世应变的计策。","source":{"text":"德持老子知足之计。","book":"东汉·班固《汉书·强德传》"},"usage":"作宾语；指人的处世原则"},{"id":33960,"word":"知足常乐","pinyin":"zhī zú cháng lè","abbr":"zzcl","explanation":"知道满足，就总是快乐。形容安于已经得到的利益、地位。","source":{"text":"祸莫大于不知足，咎莫大于欲得，故知足之足常足矣。","book":"先秦·李耳《老子》"},"example":{"text":"一个快乐主义者首先得有知足的修养，就是古训所谓‘～’。","book":"王西彦《古屋》第一部"},"similar":["乐无知命","自得其乐","心满意足"],"opposite":["愤愤不平","郁郁寡欢","忧天悯人"],"usage":"作谓语、宾语；指人的处世态度"},{"id":33961,"word":"知足常足","pinyin":"zhī zú cháng zú","abbr":"zzcz","explanation":"人没有过多的要求就能时常觉得满足。","source":{"text":"祸莫大于不知足，咎莫大于欲得。故知足之足常足矣。","book":"《老子》第四十六章"},"similar":["知足常乐"],"usage":"作宾语、定语；用于处事"},{"id":33962,"word":"知足无求","pinyin":"zhī zú wú qiú","abbr":"zzwq","explanation":"人知道满足就不会有过多的贪求。","source":{"text":"车服咸仪，知足无求。","book":"晋·葛洪《神仙传》"},"similar":["知足常乐"],"usage":"作谓语、定语；指人的欲望"},{"id":33963,"word":"知足知止","pinyin":"zhī zú zhī zhǐ","abbr":"zzzz","explanation":"知道满足知道适可而止。","source":{"text":"况乎智不逸群，行不高物，而欲辛苦一生，何其僻也，岂如知足知止，萧然无累。","book":"《周书·萧大圜传》"},"example":{"text":"两弟在朝居位之时,吾曾讽以～。我若今日复出应诏，是自食其吾了。","book":"明·冯梦龙《醒世恒言》第二卷"},"similar":["知足不辱，知止不殆"],"usage":"作宾语、定语；用于处事"},{"id":33964,"word":"知足长乐","pinyin":"zhī zú cháng lè","abbr":"zzcl","explanation":"人没有过多的要求就能长时间觉得满足。","source":{"text":"祸莫大于不知足，咎莫大于欲得。故知足之足常足矣。","book":"《老子》第四十六章"},"example":{"text":"委心任运，不失其为我。～，不愿乎其外。（清·况周颐《蕙风词话》卷二）"}},{"id":33965,"word":"知过必改","pinyin":"zhī guò bì gǎi","abbr":"zgbg","explanation":"认识到自己错了就一定要改。","source":{"text":"知过必改，得能莫忘。","book":"《论语·子罕》：“过则勿惮改。”南朝梁·周兴嗣《千字文》"},"example":{"text":"是呀，我是个旧脑瓜子，我是个夹生饭，往后我～。","book":"周立波《暴风骤雨》第二部·十"},"similar":["知过能改","过而能改"],"opposite":["将错就错"],"usage":"作谓语、定语；指人谦虚"},{"id":33966,"word":"知过能改","pinyin":"zhī guò néng gǎi","abbr":"zgng","explanation":"认识到自己错了就能够改正。","source":{"text":"知过必改，得能莫忘。","book":"《论语·子罕》：“过则勿惮改。”南朝·梁·周兴嗣《千字文》"},"example":{"text":"然一诗之感动于人，而冢宰亦～，皆可以示后，故录之。","book":"明·黄溥《闲中古录》"},"similar":["知过必改"],"usage":"作谓语、定语；指人谦虚"},{"id":33967,"word":"知遇之恩","pinyin":"zhī yù zhī ēn","abbr":"zyze","explanation":"给予赏识和重用的恩情。","source":{"text":"只因一时知遇之感，不觉为之一哭。","book":"明·罗贯中《三国演义》"},"example":{"text":"大帅的～，卑职终身难报。","book":"刘章仪《枭雄吴佩孚》"},"similar":["大恩大德","雨露之恩","知遇之感"],"opposite":["切骨之恨","血海深仇"],"usage":"作主语、宾语；指发现人才"},{"id":33968,"word":"知遇之感","pinyin":"zhī yù zhī gǎn","abbr":"zyzg","explanation":"知遇：得到赏识或重用；感：感激。对给予赏识和重用的感激。","source":{"text":"只因一时知遇之感，不觉为之一哭。","book":"明·罗贯中《三国演义》第九回"},"similar":["知遇之恩"],"opposite":["刻骨仇恨"],"usage":"作主语、宾语；指对发现人才的人的感激"},{"id":33969,"word":"知遇之荣","pinyin":"zhī yù zhī róng","abbr":"zyzr","explanation":"知遇：得到赏识或重用。指受到赏识和重用的荣宠。","source":{"text":"臣子遭缝明圣之主，知遇之荣，不要说六尺之躯。","book":"清·褚人获《隋唐演义》第71回"},"usage":"作主语、宾语；指受到赏识和重用的荣宠"},{"id":33970,"word":"知错就改","pinyin":"zhī cuò jiù gǎi","abbr":"zcjg","explanation":"知道自己错了就立即改正。","source":{"text":"我这人缺点很多，知错就改便是其中之一。","book":"王朔《刘慧芳》"},"example":{"text":"真正做到～是不容易的。"},"similar":["知过必改"],"opposite":["屡教不改"],"usage":"作谓语、宾语；指人谦虚","story":["尚书令左雄曾推荐冀州刺史周举为尚书，又推荐冀州刺史冯直为将帅。冯直因分赃而犯法。周举因此上书弹劾左雄。左雄不解，就问周举为何要这样。周举列举出赵宣子支持韩厥杀自己的仆人的例子。左雄立即知错就改，原谅了周举"]},{"id":33971,"word":"知难而行","pinyin":"zhī nán ér xíng","abbr":"znex","explanation":"知道困难而仍然去做。","source":{"text":"知道困难而仍然去做。"},"similar":["知难而进"],"usage":"作谓语、宾语；指不怕困难"},{"id":33972,"word":"知难而进","pinyin":"zhī nán ér jìn","abbr":"znej","explanation":"明知困难，却敢于向前。指迎着困难上。","source":{"text":"子立而后行，吾室亦不亡。唯君亦以我为知难而行也。","book":"《左传·定公六年》"},"example":{"text":"我们在学习中要～，绝不可知难而退。"},"similar":["力争上游","再接再厉"],"opposite":["知难而退","畏葸不前","望而却步"],"usage":"作谓语、宾语；指不怕困难"},{"id":33973,"word":"知难而退","pinyin":"zhī nán ér tuì","abbr":"znet","explanation":"原指作战要见机而行，不要做实际上无法办到的事。后泛指知道事情困难就后退。","source":{"text":"见可而行，知难而退，军之善政也。","book":"《左传·宣公十二年》"},"example":{"text":"尤其是因为在那一级里有三、四个“吵客”，弄得那位英文教员不得不～。","book":"邹韬奋《经历·新饭碗问题》"},"similar":["听天由命","畏葸不前","望而却步"],"opposite":["知难而进","力争上游","再接再厉"],"usage":"作谓语、宾语；指人的态度","story":["春秋时期，晋国和楚国为争夺霸权相互进行战争，郑国处于他们之间，他依附晋国，楚国就派兵征服它。晋国听说楚国出兵就派荀林父、士会、先榖等率军讨伐楚国，听到他们已经结盟，士会同意荀林父知难而退的做法，先榖不同意造成兵败"]},{"id":33974,"word":"知难行易","pinyin":"zhī nán xíng yì","abbr":"znxy","explanation":"懂得事情的道理难，而实行却比较容易。","source":{"text":"诸君要知道知难行易的道理，可以参考我的学说。","book":"孙中山《民族主义》第五讲"},"example":{"text":"诸君要知道～的道理，可以参考我的学说。","book":"孙中山《民族主义第五讲》"},"usage":"作宾语、定语；用于书面语"},{"id":33975,"word":"知雄守雌","pinyin":"zhī xióng shǒu cí","abbr":"zxsc","explanation":"雄：雄强；雌：雌伏，不倔强。弃刚守柔。比喻与人无争。","source":{"text":"知其雄，守其雌，为天下奚。","book":"《老子》第二十八章"},"example":{"text":"～，宛訝存身之际；绝圣弃智，潜疑勿用之时。","book":"宋·范仲淹《老子犹龙赋》"},"usage":"作谓语、定语；指人的处世态度"},{"id":33976,"word":"知音识曲","pinyin":"zhī yīn shí qǔ","abbr":"zysq","explanation":"指通晓音乐。","source":{"text":"有美一人，婉如清扬。知音识曲，善为乐方。","book":"《乐府诗集·相和歌辞十一·秋胡行》"},"similar":["知音谙吕"],"usage":"作谓语、定语；用于书面语"},{"id":33977,"word":"知音识趣","pinyin":"zhī yīn shí qù","abbr":"zysq","explanation":"犹知情识趣。懂情意，善体贴。","source":{"text":"你平时那一班同欢同赏、知音识趣的朋友，怎没一个来瞅睬你一瞅睬？","book":"明·凌濛初《初刻拍案惊奇》卷十五"},"similar":["知情识趣"],"usage":"作谓语、定语；用于交往等"},{"id":33978,"word":"知音谙吕","pinyin":"zhī yīn ān lǚ","abbr":"zyal","explanation":"吕：国古代音乐十二律中的阴律，此处泛指音乐。指深通乐律。","source":{"text":"一个家知音谙吕，一个家唾玉喷珠。","book":"明·桑绍良《独乐园》第三折"},"similar":["知音识曲"],"usage":"作谓语、定语；用于书面语"},{"id":33979,"word":"知高识低","pinyin":"zhī gāo shí dī","abbr":"zgsd","explanation":"指说话、做事情得掌握分寸。","source":{"text":"金生是个聪明的人，在他门下，知高识低，温和待人。","book":"明·凌濛初《二刻拍案惊奇》卷六"},"example":{"text":"你小小年纪，倒～，晓得事务，先念皇恩，又不敢夸张，真可谓淑女矣！","book":"清·褚人获《隋唐演义》第三十回"},"opposite":["不知天高地厚"],"usage":"作谓语、定语、宾语；用于处事"},{"id":33980,"word":"知鱼之乐","pinyin":"zhī yú zhī lè","abbr":"zyzl","explanation":"了解鱼的快乐。比喻善于体会物情。","source":{"text":"庄子曰：‘儵鱼出游从容，是鱼之乐也。’惠子曰：‘子非鱼，安知鱼之乐？’庄子曰：‘子非我，安知我不知鱼之乐？’","book":"《庄子·秋水》"},"usage":"作宾语；用于书面语"},{"id":33981,"word":"矩周规值","pinyin":"jǔ zhōu guī zhí","abbr":"jzgz","explanation":"矩：曲尺，古代画方的工具；周：密合；规：即圆规，画圆的工具；值：适当。形容结合的周密适当，一点也无差缺。","source":{"text":"逷彼前文，矩周规值。","book":"晋·颜延之《皇太子释奠会作》"}},{"id":33982,"word":"矩步方行","pinyin":"jǔ bù fāng xíng","abbr":"jbfx","explanation":"行走时步伐端方合度。指行为举止合乎礼仪规范。","source":{"text":"……这样先生，断不能矩步方行，不过东家西席，聊存名目而已。","book":"清·李绿园《歧路灯》第二回"},"similar":["方行矩步"],"usage":"作谓语、宾语；指行为举止合乎礼仪规范"},{"id":33983,"word":"矩矱绳尺","pinyin":"jǔ huò shéng chǐ","abbr":"jysc","explanation":"矩、矱、绳、尺，为画方形及直线时的工具，引申为规矩，法度。","source":{"text":"分体制之正变，范围广，勿使逸出矩矱绳尺之外。","book":"清·朱彝尊《沈明府不羁集序》"},"usage":"作宾语、定语；用于书面语"},{"id":33984,"word":"矫世励俗","pinyin":"jiǎo shì lì sú","abbr":"jsls","explanation":"矫世：纠正世风。纠正颓废的世风，勉励淳厚的民俗。","source":{"text":"远害全身，矫世励俗。清泉小船坞耳，紫芝充腹。","book":"宋·王禹偁《四皓庙碑》"},"similar":["矫世厉俗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":33985,"word":"矫世厉俗","pinyin":"jiǎo shì lì sú","abbr":"jsls","explanation":"改变颓废的世风，鼓励淳厚的民俗。同“矫世励俗”。","source":{"text":"矫世厉俗、捐私奉公、崭崖狷洁之行，可以无谴诃憎疾于鬼神，然或不免谴诃憎疾于人。","book":"明·唐顺之《莆田林氏先墓表》"},"similar":["矫世励俗"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":33986,"word":"矫世变俗","pinyin":"jiǎo shì biàn sú","abbr":"jsbs","explanation":"指纠正和改变不良的世风民俗。","source":{"text":"安石议论高奇，能以辨博济其说，果于自用，慨然有矫世变俗之志。","book":"《宋史·王安石传》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33987,"word":"矫国更俗","pinyin":"jiǎo guó gēng sú","abbr":"jggs","explanation":"匡正国事，改革敝俗。同“矫国革俗”。","source":{"text":"矫正国事，改更弊俗也。","book":"《战国策·齐策六》：“矫国革俗于天下，功名可立也。”《史记·鲁仲连邹阳列传》作“矫国更俗”。司马贞索隐"},"similar":["矫国革俗"],"usage":"作谓语、定语；用于改变风俗"},{"id":33988,"word":"矫国革俗","pinyin":"jiǎo guó gé sú","abbr":"jggs","explanation":"匡正国事，改革敝俗。","source":{"text":"矫正国事，改更弊俗也。","book":"《战国策·齐策六》：“矫国革俗于天下，功名可立也。”司马贞索隐"},"similar":["矫国更俗"],"usage":"作谓语、定语；用于改变风俗"},{"id":33989,"word":"矫尾厉角","pinyin":"jiǎo wěi lì jiǎo","abbr":"jwlj","explanation":"形容逞强好胜、趾高气扬的模样。矫尾，翘尾巴。厉角，磨头角。","source":{"text":"宾筵客座，辩论锋起，援古证今，矫尾厉角，自以为冯氏一家之学，论者无以难也。","book":"清·钱谦益《冯巳苍诗序》"},"example":{"text":"印累绶若之徒，其必～，而与天地之机为难者，其用心盖见矣！","book":"严复《论世变之亟》"},"usage":"作谓语、定语；用于书面语"},{"id":33990,"word":"矫心饰貌","pinyin":"jiǎo xīn shì mào","abbr":"jxsm","explanation":"矫心：违背本意。故意违背本意，故作姿态以掩饰真情。","source":{"text":"而寸衿所滞，近蔽耳目，深浅清浊，岂有能预。加以矫心饰貌，酷非所闲，不喜俗人，与之共事。","book":"南朝·梁·张缵《让尚书仆射表》"},"example":{"text":"习骥厉驽，既非所任，～，又违所安，以是中寐怀惊。","book":"清·张明弼《侯蒋八座主》"}},{"id":33991,"word":"矫情干誉","pinyin":"jiǎo qíng gān yù","abbr":"jqgy","explanation":"故违常情，以求美誉。","source":{"text":"其余凡贪官、污吏……及矫情干誉、欺世盗名种种之人，无不随业得报，一一不爽。","book":"《二刻拍案惊奇》卷二四"},"example":{"text":"既不是惹祸招非，难道是～？","book":"明·无名氏《鸣凤记·鹤楼赴义》"},"usage":"作谓语、定语；用于书面语"},{"id":33992,"word":"矫情自饰","pinyin":"jiǎo qíng zì shì","abbr":"jqzs","explanation":"矫情：掩饰真情。掩饰真情，粉饰自己。","source":{"text":"文帝御之以术，矫情自饰，宫人左右，并为之说，故遂定为嗣。","book":"《三国志·魏志·陈思王植传》"},"example":{"text":"初，义之专政，～，劳谦待士，时事得失，颇以关怀。","book":"《魏书·道武七王列传》"},"usage":"作谓语、定语；用于处事"},{"id":33993,"word":"矫情镇物","pinyin":"jiǎo qíng zhèn wù","abbr":"jqzw","explanation":"矫情：克制情感。比喻故作镇静，使人无法猜度。","source":{"text":"既罢，还内，过户限，心喜甚，不觉屐齿之折，其矫情镇物如此。","book":"《晋书·谢安传》"},"example":{"text":"仿佛羽扇纶巾，谈笑可以退敌，强学谢安的～，只怕真到紧急关头，拿不出谢安的那一份修养。","book":"高阳《清宫外史》下册"},"usage":"作谓语；比喻故作镇静，使人无法猜度"},{"id":33994,"word":"矫情饰行","pinyin":"jiǎo qíng shì xíng","abbr":"jqsx","explanation":"掩饰实情，故作姿态。同“矫情饰貌”。","source":{"text":"夫令色巧言，矫情饰貌，邀眄睐之利，射咳唾之私，此盖苟进之常也。","book":"《魏书·恩倖传序》"},"example":{"text":"每～，以钓虚名，阴有夺宗之计。","book":"《隋书·炀帝纪下》"},"similar":["矫情饰貌"],"usage":"作谓语、定语；用于书面语"},{"id":33995,"word":"矫情饰诈","pinyin":"jiǎo qíng shì zhà","abbr":"jqsz","explanation":"以虚假的现象伪装欺骗别人。","source":{"text":"伏念熹昨以蒙思进职，辄具辞免，非敢矫情饰诈，罔上盗名。","book":"宋·朱熹《与宰执札子》"},"example":{"text":"至谓海瑞～，种种奸伪，卖器皿以易袍，用敝靴以易带，此真公孙弘布被中梦想所不能到者。","book":"明·沈德符《野获编·台省·房心宇侍郎》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":33996,"word":"矫情饰貌","pinyin":"jiǎo qíng shì mào","abbr":"jqsm","explanation":"矫情：掩饰真情。掩饰真情，故作姿态。","source":{"text":"夫令色巧言，矫情饰貌，邀眄睐之利，射咳唾之私，此盖苟进之常也。","book":"《魏书·恩倖传序》"},"example":{"text":"于是～，肆厥奸回，故得献后忠心。","book":"《隋书·炀帝纪下》"},"similar":["矫情饰行"],"usage":"作谓语、定语；用于书面语"},{"id":33997,"word":"矫揉造作","pinyin":"jiǎo róu zào zuò","abbr":"jrzz","explanation":"矫：使弯的变成直的；揉：使直的变成弯的。比喻故意做作，不自然。","source":{"text":"坎，为矫揉，为引轮。","book":"《周易·说卦》"},"example":{"text":"他们原是好好妇人，却要装作男人，可谓～了。","book":"清·李汝珍《镜花缘》第三十二回"},"similar":["装模作样","装腔作势"],"opposite":["天真烂漫"],"usage":"作谓语、定语、宾语、状语；指故意做作"},{"id":33998,"word":"矫时慢物","pinyin":"jiǎo shí màn wù","abbr":"jsmw","explanation":"矫时：矫正时俗。慢，傲慢。指对现实不满，态度傲慢。","source":{"text":"少有才辩，而尚气刚傲，好矫时慢物。","book":"《后汉书·弥衡传》"},"example":{"text":"青年才子难免～，多经磨练之后将会成为栋梁之材的。"},"usage":"作谓语、宾语、定语；用于处事"},{"id":33999,"word":"矫枉过中","pinyin":"jiǎo wǎng guò zhōng","abbr":"jwgz","explanation":"比喻纠正错误超过了应有的限度。同“矫枉过正”。","source":{"text":"矫枉过中，斯害也已。","book":"唐·张说《吊陈司马书》"},"example":{"text":"他有更张，随事谏止，不少循默。然无～之失，故能不亟有徐，进退有道，在元祐诸臣中，身名俱全，亦难矣哉！","book":"《宋史·王存孙固等传论》"},"similar":["矫枉过当","矫枉过正","矫枉过直"],"usage":"作谓语、宾语、定语；比喻纠正错误过度"},{"id":34000,"word":"矫枉过当","pinyin":"jiǎo wǎng guò dāng","abbr":"jwgd","explanation":"比喻纠正错误超过了应有的限度。同“矫枉过正”。","source":{"text":"石公此论，未为不是；惜乎矫枉过当，遂开后人口实。","book":"清·周亮工《书影》卷四"},"example":{"text":"盖文人～，有为而言也。","book":"清·施闰章《重刻〈何大复诗集〉序》"},"similar":["矫枉过正","矫枉过中"],"usage":"作谓语、宾语、定语；比喻纠正错误过度"},{"id":34001,"word":"矫枉过正","pinyin":"jiǎo wǎng guò zhèng","abbr":"jwgz","explanation":"矫：扭转；枉：弯曲。把弯的东西扳正，又歪到了另一边。比喻纠正错误超过了应有的限度。","source":{"text":"逮至清世，则复入矫枉过正之检。","book":"《后汉书·仲长统传》"},"example":{"text":"或有避其谤者，又每～，至坐视儿女之放纵，而不一置问。","book":"清·蒲松龄《聊斋志异·细柳》"},"similar":["矫枉过直","过犹不及"],"opposite":["差之千里"],"usage":"作谓语、宾语、分句；比喻纠正错误过度","story":["汉景帝担心诸侯势力过大会自己称王，出现中央管不住地方的矫枉过正的局面，就采用晁错的建议，借故削了几个诸侯王的封地。吴王刘濞竟借清君侧的名义企图谋反，迫使汉景帝杀死晁错，从而出现历史上的“七国之乱”"]},{"id":34002,"word":"矫枉过直","pinyin":"jiǎo wǎng guò zhí","abbr":"jwgz","explanation":"比喻纠正错误超过了应有的限度。同“矫枉过正”。","source":{"text":"子之复仇，臣之讨贼，至诚感天，矫枉过直，乳狗哺虎，不计祸福。","book":"汉·袁康《越绝书·篇叙外传记》"},"example":{"text":"学问之汩没性灵，至是已极，物极必反，～。","book":"梁启超《中国学术思想变迁之大势》第四章第四节"},"similar":["矫枉过当","矫枉过正","矫枉过中"],"usage":"作谓语、宾语、定语；比喻纠正错误过度"},{"id":34003,"word":"矫激奇诡","pinyin":"jiǎo jī qí guǐ","abbr":"jjqg","explanation":"指人的行为动作矫异激烈。","source":{"text":"侔志节刚果，不为矫激奇诡之行，而气貌足以动人。","book":"宋·林希《孙少述传》"},"usage":"作谓语、定语；用于书面语"},{"id":34004,"word":"矫矫不群","pinyin":"jiǎo jiǎo bù qùn","abbr":"jjbq","explanation":"矫矫：翘然出众的样子；群：与众不同。形容高超出众，不同一般。","source":{"text":"落落欲往，矫矫不群。","book":"唐·司空图《二十四诗品·飘逸》"},"example":{"text":"至于诗界，则李杜诸家，岂非～，阐扬《风》《雅》者哉？","book":"陶曾佑《中国文学之概观》"},"similar":["超卓出众"],"usage":"作定语；指卓异出众"},{"id":34005,"word":"矫若惊龙","pinyin":"jiǎo ruò jīng lóng","abbr":"jrjl","explanation":"矫：矫健。常用于形容书法笔势刚健，或舞姿婀娜。","source":{"text":"尤善隶书，为古今之冠，论者称其笔势，以为飘若浮云，矫若惊龙。","book":"《晋书·王羲之传》"},"similar":["身强力壮","矫若游龙"],"usage":"作谓语、定语；形容书法舞姿强劲灵活"},{"id":34006,"word":"矫若游龙","pinyin":"jiǎo ruò yóu lóng","abbr":"jryl","explanation":"常用于形容书法笔势刚健，或舞姿婀娜。同“矫若惊龙”。","source":{"text":"尤善隶书，为古今之冠，论者称其笔势，以为飘若浮云，矫若惊龙。","book":"《晋书·王羲之传》"},"example":{"text":"看他～，超逾集鸟。","book":"明·梅鼎祚《玉合记·义姤》"},"similar":["矫若惊龙"],"usage":"作谓语、定语；形容书法舞姿强劲灵活"},{"id":34007,"word":"矫言伪行","pinyin":"jiǎo yán wěi xíng","abbr":"jywx","explanation":"虚假的议论行为。","source":{"text":"缝衣浅带，矫言伪行，以迷惑天下之主，而欲求富贵焉。","book":"《庄子·杂篇》"},"example":{"text":"～之人，弊车羸马窜伏宕冗，以幸上之爵禄。","book":"宋·秦观《论议下》"},"usage":"作宾语、定语；用于书面语"},{"id":34008,"word":"矫邪归正","pinyin":"jiǎo xié guī zhèng","abbr":"jxgz","explanation":"矫邪：纠正邪恶、邪念；归正：归于正路。改正错误，走上正道。","source":{"text":"向使矫邪归正，革伪为忠，……则燕秦之地可定，桓文之功可立。","book":"《晋书·吕光等载记论》"},"similar":["改邪归正"],"usage":"作谓语、宾语；指改正错误"},{"id":34009,"word":"矫饰伪行","pinyin":"jiǎo shì wěi xíng","abbr":"jswx","explanation":"关于掩饰，行为虚伪。","source":{"text":"某公用事，排斥端士，矫饰伪行。","book":"宋·陈师道《后山诗话》"},"usage":"作宾语、定语；用于书面语"},{"id":34010,"word":"矫首昂视","pinyin":"jiǎo shǒu áng shì","abbr":"jsas","explanation":"矫：抬举。抬头仰望。形容人很高傲的样子。","source":{"text":"矫首昂视。","book":"明·魏学洢《核舟记》"},"similar":["挢枉过正"],"usage":"作谓语、状语；用于书面语"},{"id":34011,"word":"短中取长","pinyin":"duǎn zhōng qǔ cháng","abbr":"dzqc","explanation":"指于一般中选择比较好的。","source":{"text":"臣愚不足以计边务，伏乞圣断。于短中取长而行之。","book":"明·于谦《备边保民疏》"},"usage":"作宾语、定语；用于选择"},{"id":34012,"word":"短兵接战","pinyin":"duǎn bīng jiē zhàn","abbr":"dbjz","explanation":"短兵：刀剑等短兵器；接：交战。指近距离搏斗。比喻面对面地进行激烈的斗争。","source":{"text":"韦被数十创，短兵接战，贼前搏之。","book":"晋·陈寿《三国志·魏志·典韦传》"},"example":{"text":"在～的时刻，勇者胜。"},"similar":["短兵相接"],"usage":"作宾语、分句；比喻面对面地进行激烈的斗争"},{"id":34013,"word":"短兵相接","pinyin":"duǎn bīng xiāng jiē","abbr":"dbxj","explanation":"短兵：刀剑等短兵器；接：交战。指近距离搏斗。比喻面对面地进行激烈的斗争。","source":{"text":"车错毂兮短兵接。","book":"战国·楚·屈原《九歌·国殇》"},"example":{"text":"但恐怕也有时会逼到非～不可的，这时候，没有法子，就～。","book":"鲁迅《两地书·二》"},"similar":["兵戎相见","针锋相对","唇枪舌剑"],"opposite":["和风细雨","拐弯抹角","指桑骂槐"],"usage":"作谓语、宾语、状语；用于军事、斗争","story":["战国时期，楚国诗人屈原写《九歌》热情讴歌那些为国捐躯的战士，祭祀他们，歌颂他们的忠毅。诗文内容为：“操吴戈兮披犀甲，车错毂兮短兵接。旌蔽日兮敌若云，矢交坠兮士争光。”"]},{"id":34014,"word":"短刀直入","pinyin":"duǎn dāo zhí rù","abbr":"ddzr","explanation":"比喻开门见山，直截爽快。","source":{"text":"我们可以短刀直入地便看定一个社会的真实相，而且还可借以判明以前的旧史料一多半都是虚伪。","book":"郭沫若《中国古代社会研究》第四篇一"},"similar":["开门见山","直截了当","单刀直入"],"opposite":["转弯抹角"],"usage":"作宾语、定语、状语；用于处事"},{"id":34015,"word":"短叹长吁","pinyin":"duǎn tàn cháng xū","abbr":"dtcx","explanation":"吁：叹息。短一声、长一声不停地叹气。","source":{"text":"雨乍晴，绣针停，短叹长吁几声。","book":"元·吴弘道《梧叶儿曲》"},"example":{"text":"陈秀才一肚皮的鸟气，没处出豁，捶台拍凳，～。","book":"明·凌濛初《初刻拍案惊奇》第15卷"},"similar":["长嘘短叹","长吁短叹"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":34016,"word":"短吁长叹","pinyin":"duǎn xū cháng tàn","abbr":"dxct","explanation":"吁：叹气。长声、短声不住地叹息不止。","source":{"text":"我今日得救还，草舍间、免了些短吁长叹。","book":"元·杨暹《西游记》第四本第15出"},"similar":["短叹长吁"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":34017,"word":"短吃少穿","pinyin":"duǎn chī shǎo chuān","abbr":"dcsc","explanation":"指衣食困乏。","source":{"text":"穷人起早贪黑，手不离活，成年溜辈，短吃少穿，你说这不是命是啥？","book":"周立波《暴风骤雨》第二部"},"example":{"text":"我们不会再过那种～的日子了。"},"similar":["饥寒交迫"],"opposite":["丰衣足食"],"usage":"作谓语、宾语、定语；指贫困"},{"id":34018,"word":"短垣自逾","pinyin":"duǎn yuán zì yú","abbr":"dyzy","explanation":"垣：短墙；逾：越过。自己越过短墙。旧比喻亲身违背礼制法度。","source":{"text":"今君掩王东海，以淫名闻于天下，君有短垣而自逾之。","book":"《国语·吴语》"},"usage":"作宾语；指违背制度"},{"id":34019,"word":"短寿促命","pinyin":"duǎn shòu cù mìng","abbr":"dscm","explanation":"短命早死。","source":{"text":"我周帝臣若负了左秀贞，将来不得死在家中，必当短寿促命。","book":"清·陶贞怀《天雨花》第十回"},"example":{"text":"寿泉这家伙只会对我发脾气，只会说几句～的话。","book":"叶圣陶《线下·外国旗》"},"opposite":["长命百岁"],"usage":"作谓语、宾语、定语；指早死"},{"id":34020,"word":"短小精干","pinyin":"duǎn xiǎo jīng gàn","abbr":"dxjg","explanation":"形容人身材短小而精明强干。也形容文章、言论等简短有力。","example":{"text":"这篇文章是篇～的好作品。"},"similar":["短小精悍","矮小精悍","精悍短小"],"opposite":["五大三粗"],"usage":"作谓语、定语；用于文章等"},{"id":34021,"word":"短小精悍","pinyin":"duǎn xiǎo jīng hàn","abbr":"dxjh","explanation":"形容人身躯短小，精明强悍。也形容文章或发言简短而有力。","source":{"text":"解为人短小精悍。","book":"《史记·游侠列传》"},"example":{"text":"一位～的人来了。一眼看去便知道他是广东人，哨兵向他敬礼，称呼他是排长。","book":"郭沫若《涂家埠》"},"similar":["言简意赅","简明扼要","要言不烦"],"opposite":["五大三粗","人高马大","长篇大论"],"usage":"作谓语、定语；用于文章等"},{"id":34022,"word":"短平快","pinyin":"duǎn píng kuài","abbr":"dpk","explanation":"排球比赛中“快攻”战术的一种。形容技术开发项目投资少、周期短、见效快、效益高。","example":{"text":"我们尽量引进那些～的项目。"},"usage":"作谓语、定语；用于口语等"},{"id":34023,"word":"短斤缺两","pinyin":"duǎn jīn quē liǎng","abbr":"djql","explanation":"做买卖时货物短缺分量。","example":{"text":"～的现象十分普遍，我们得来一次大检查。"},"similar":["缺斤短两"],"opposite":["童叟无欺"],"usage":"作谓语、宾语、定语；指分量不足"},{"id":34024,"word":"短章醉墨","pinyin":"duǎn zhāng zuì mò","abbr":"dzzm","explanation":"短章：指篇幅较短的诗文篇章。指酒后信笔所写的简短文字。","source":{"text":"又喜行狎书，皆可爱，故其虽短章醉墨，落笔争为人所传。","book":"宋·欧阳修《湖州长史苏君墓志铭》"}},{"id":34025,"word":"短绠汲深","pinyin":"duǎn gěng jí shēn","abbr":"dgjs","explanation":"绠：汲水用的绳子；汲：从井里打水。吊桶的绳子短，打不了深井里的水。比喻能力薄弱，难以担任艰巨的任务。","source":{"text":"故曰：短绠不可以汲深井之泉，知不几者不可与及圣人之言。","book":"战国·赵·荀况《荀子·荣辱》"},"example":{"text":"顾才不称物，～。","book":"唐·严挺之《大智禅师碑铭》"},"similar":["绠短汲深"],"usage":"作宾语、定语；比喻能力难以担任艰巨的任务","story":["春秋时期，孔子的弟子颜渊从鲁国到齐国去，准备与齐国的国君谈治理国家的大道理。孔子不放心，子贡问何故，孔子说：“我想起管子的一句话‘褚小者不可以怀大，绠短者不可以汲深’，对待具体问题要具体分析，颜渊难以做到。”"]},{"id":34026,"word":"短衣匹马","pinyin":"duǎn yī pǐ mǎ","abbr":"dypm","explanation":"短衣：短装。古代为平民、士兵等服装。穿着短衣，骑一匹骏马。形容士兵英姿矫健的样子。","source":{"text":"短衣匹马随李广，看射猛虎终残年。","book":"唐·杜甫《曲江》"},"example":{"text":"～去从军，努力戎行誓树勋。","book":"刘复《代某君寿某将军夫妇》"},"usage":"作宾语、定语；形容战士英姿矫健的样子"},{"id":34027,"word":"短衣窄袖","pinyin":"duǎn yī zhǎi xiù","abbr":"dyzx","explanation":"古代指北方少数民族服饰。","source":{"text":"中国衣冠，自北齐以来，乃全用胡服。窄袖，绯绿短衣，长靿靴，有靿鞢带，皆胡服也。","book":"宋·沈括《梦溪笔谈·故事一》"},"example":{"text":"燕姬白马青丝韁，～银光镫。","book":"元·萨都刺《京城春日》"}},{"id":34028,"word":"短褐不全","pinyin":"duǎn hè bù quán","abbr":"dhbq","explanation":"短褐：粗麻布短衣。粗布短衣还破旧不完整。形容生活贫苦。","source":{"text":"藜羹不厌，短褐不全，庸非贫贱乎？","book":"唐·卢照邻《对蜀父老问》"},"similar":["短褐不完","裋褐不完"],"usage":"作谓语、定语；指生活贫困"},{"id":34029,"word":"短褐不完","pinyin":"duān hè bù wán","abbr":"dhbw","explanation":"短褐：粗布短衣，古代贫贱者或僮竖之服；完：完整。粗布短衣还破旧不完整。形容生活贫苦，衣衫破烂。","source":{"text":"糟糠不饱者不务梁肉，短褐不完者不待文绣。","book":"战国·韩·韩非子《韩非子·五蠹》"},"example":{"text":"富者木土被文锦，犬马余肉粟，而贫者～，含菽饮水。","book":"东汉·班固《汉书·货殖传》"},"similar":["短褐不全"],"usage":"作谓语、定语；指生活贫困"},{"id":34030,"word":"短褐椎结","pinyin":"duǎn hè zhuī jié","abbr":"dhcj","explanation":"短褐：粗布短衣；椎结：把头发挽成椎形。穿着粗布短衣，挽着椎形发髻。指古代贫苦劳动人民的装束。","source":{"text":"妻乃更为椎髻，着布衣，操作而前。","book":"《后汉书·梁鸿传》"},"example":{"text":"国画呢，方巾长袍，或短褐椎结，从没见过一条我所记得的辫子。","book":"鲁迅《病后杂谈之余》"}},{"id":34031,"word":"短褐穿结","pinyin":"duǎn hè chuān jié","abbr":"dhcj","explanation":"短褐：粗布短衣；穿：破；结：打结。形容衣衫褴褛。","source":{"text":"短褐穿结，箪瓢屡空，晏如也。","book":"晋·陶潜《五柳先生传》"},"usage":"作宾语、定语；指人贫穷"},{"id":34032,"word":"短见薄识","pinyin":"duǎn jiàn bó shí","abbr":"djbs","explanation":"指见识短浅。","source":{"text":"庞涓久后得地呵！此人是个短见薄识、绝恩绝义的人。","book":"元·无名氏《马陵道》楔子"},"example":{"text":"浑家李氏却有些～，要做些小便宜勾当。","book":"明·凌濛初《初刻拍案惊奇》第三十五卷"},"similar":["孤陋寡闻"],"opposite":["深谋远虑","见多识广"],"usage":"作宾语、定语；用于谦词"},{"id":34033,"word":"短针攻疽","pinyin":"duǎn zhēn gōng jū","abbr":"dzgj","explanation":"攻：医治；疽：毒疮。用短针治疗毒疮。形容措施不当，难以奏效。","source":{"text":"设礼修文，有似穷医，欲以短针而攻疽。","book":"汉·桓宽《盐铁论·大论》"},"usage":"作宾语、定语；多用于比喻句"},{"id":34034,"word":"矮人看场","pinyin":"ǎi rén kàn chǎng","abbr":"arkc","explanation":"比喻只知道附和别人，自己没有主见。也比喻见识不广。","source":{"text":"正如矮人看戏一般，见前面人笑，他也笑，他虽眼不曾见，想必是好笑，便随他笑。","book":"《朱子语类》卷二十七"},"example":{"text":"是真是假，要弄个明白，不能～，人云亦云。"},"similar":["矮子看戏","人云亦云"],"opposite":["自成一家","自有主见"],"usage":"作谓语、定语；形容没见识、人云亦云"},{"id":34035,"word":"矮人看戏","pinyin":"ǎi rén kàn xì","abbr":"arkx","explanation":"比喻只知道附和别人，自己没有主见。也比喻见识不广。","source":{"text":"矮人看戏何曾见，都是随人说短长。","book":"清·赵翼《论诗》诗"},"example":{"text":"他的观点就像～一般。"},"similar":["随声附和","矮子看戏","侏儒看戏"],"opposite":["独立思考"],"usage":"作谓语、定语、宾语；指人没见识"},{"id":34036,"word":"矮人观场","pinyin":"ǎi rén guān cháng","abbr":"argc","explanation":"比喻只知道附和别人，自己没有主见。也比喻见识不广。","source":{"text":"予观宋景文近体，无一字无来历，而对仗精确，非读万卷者不能，迥非南渡以后所及。今人耳食，誉者毁者，皆矮人观场，未之或知也。","book":"清·王士禛《香祖笔记》卷十"},"example":{"text":"最有识见之客，亦作～。","book":"清·李渔《闲情偶寄·演习·选剧》"},"similar":["矮子看戏","矮人看场","人云亦云"],"opposite":["见多识广"],"usage":"作宾语、定语；形容没见识、人云亦云"},{"id":34037,"word":"矮子看戏","pinyin":"ǎi zǐ kàn xì","abbr":"azkx","explanation":"比喻只知道附和别人，自己没有主见。也比喻见识不广。","source":{"text":"正如矮人看戏一般，见前面人笑，他也笑，他虽眼不曾见，想必是好笑，便随他笑。","book":"《朱子语类》卷二十七"},"example":{"text":"～何曾见，都是随人说短长。","book":"清·赵翼《诗论》诗"},"similar":["矮人观场"],"usage":"作谓语、定语；形容没见识、人云亦云"},{"id":34038,"word":"矮子观场","pinyin":"ǎi zǐ guān cháng","abbr":"azgc","explanation":"比喻只知道附和别人，自己没有主见。也比喻见识不广。","source":{"text":"全心即佛，全佛即人，直是饥人见饭；心不是佛，智不是道，何殊矮子观场。","book":"明·徐复祚《一文钱》第三出"},"example":{"text":"所以意味索然，何尝不众口极力铺张，却如～，痴人说梦。","book":"清·夏敬渠《野叟曝言》第一回"},"similar":["矮子看戏","痴人说梦"],"usage":"作谓语、定语；形容没见识、人云亦云"},{"id":34039,"word":"矮子里拔将军","pinyin":"ǎi zǐ lǐ bá jiāng jūn","abbr":"azlbjj","explanation":"从现有的并不出色的人中选择最佳者","source":{"text":"常言一句俗话说：‘矮子里选将军。’","book":"清·石玉昆《小五义》第53回"},"example":{"text":"我们也只有～，挑选几个稍微满意的就行"},"usage":"作宾语、定语；用于口语"},{"id":34040,"word":"矮子队里选将军","pinyin":"ǎi zi duì lǐ xuǎn jiāng jūn","abbr":"azdlxjj","explanation":"指勉强挑选。比喻挑选余地小，难以选出合适的人。","source":{"text":"矮子队里选将军，叫我如何选得出？","book":"清·李渔《十二楼·夺锦楼》"}},{"id":34041,"word":"矮小精悍","pinyin":"ǎi xiǎo jīng hàn","abbr":"axjh","explanation":"悍：勇敢。形容人身材短小而精明强干。","source":{"text":"一个最勇敢的叫徐骧，生得矮小精悍，膂力过人。","book":"曾朴《孽海花》第33回"},"example":{"text":"他就是～的个子。"},"similar":["短小精悍"],"opposite":["五大三粗"],"usage":"作谓语、定语；用于人的身材等"},{"id":34042,"word":"矮矮实实","pinyin":"ǎi ǎi shí shí","abbr":"aass","explanation":"身材不高但长得壮实。","example":{"text":"李逵是一个～的黑汉子。"},"similar":["矮矮胖胖"],"usage":"作定语、状语；用于人的形貌"},{"id":34043,"word":"矮矮胖胖","pinyin":"ǎi ǎi pàng pàng","abbr":"aapp","explanation":"又矮又胖的样子。","source":{"text":"这是一位矮矮胖胖的女生，大概是小时候得过小儿麻痹一类的病，留下了痼疾。","book":"路遥《平凡的世界》第一卷第一章"},"similar":["矮矮实实"],"usage":"作定语、状语；用于人的形貌等"},{"id":34044,"word":"石人石马","pinyin":"shí qìng shí mǎ","abbr":"srsm","explanation":"石人：石头刻的人，多放置在墓道旁。石刻的人，石刻的马。比喻毫无感情，徒有外表。","source":{"text":"在茂陵旁，冢上有竖石，冢前有石人石马者是也。","book":"《汉书·霍去病传》：“为冢象祁连山。”颜师古注"},"example":{"text":"又走了五六里路，迎面的坟茔里，出现了成行的柏树和～。","book":"李英儒《野火春风斗古城》第一章三"}},{"id":34045,"word":"石压笋斜出","pinyin":"shí yā sǔn xié chū","abbr":"sysxc","explanation":"比喻强暴的力量压制不住新生力量的生长。","source":{"text":"时衡州天庆观主石道士有《春夜泛舟》诗云：‘石压笋斜出，崖悬花倒生。’","book":"宋·刘斧《青琐高议前集·诗谶》"},"example":{"text":"诸佛出身处，东山水上行。～，岸悬花倒生。","book":"宋·释普济《五灯会元》卷二十"}},{"id":34046,"word":"石城汤池","pinyin":"shí chéng tāng chí","abbr":"sctc","explanation":"比喻防守坚固不易攻破的城池。","source":{"text":"兵法称有石城汤池带甲百万而无粟者，不能守也。","book":"晋·陈寿《三国志·魏志·辛毗传》"},"example":{"text":"我们有～，敌人是没法通过的。"},"similar":["固若金汤","金城汤池"],"usage":"作宾语；形容十分坚固"},{"id":34047,"word":"石室金匮","pinyin":"shí shì jīn guì","abbr":"ssjg","explanation":"亦作“石室金鐀”。古代国家收藏重要文献的地方。","source":{"text":"石室、金匮皆国家藏书之处。","book":"《史记·太史公自序》：“紬史记石室金匮之书。”司马贞索隐"},"example":{"text":"次则搜采异本，上则补～之遗亡，下可备通人博士之浏览。","book":"清·李慈铭《越缦堂读书记·北江诗话》"},"similar":["金匮石室"],"usage":"作主语、宾语、定语；用于书面语"},{"id":34048,"word":"石室金鐀","pinyin":"shí shì jīn guì","abbr":"ssjg","explanation":"古代国家收藏重要文献的地方。同“石室金匮”。"},{"id":34049,"word":"石尤风","pinyin":"shí yóu fēng","abbr":"syf","explanation":"指打头逆风。","source":{"text":"故乡今日友，欢会坐应同。宁知巴峡路，辛苦石尤风。","book":"唐·司空曙《留卢秦卿》诗：“知有前期在，难分此夜中。无将故人酒，不及石尤风。”唐·陈子昂《初入峡苦风寄故乡亲友》诗"},"example":{"text":"倒霉时节偏遇到这～"},"usage":"作宾语、定语；指逆风"},{"id":34050,"word":"石崇斗奢","pinyin":"shí chóng dòu shē","abbr":"scds","explanation":"石崇：晋朝人名。石崇与王恺比赛奢侈。形容奢侈浪费。","example":{"text":"我们不能学～。"},"usage":"作宾语、定语；指奢侈浪费","story":["西晋时期，荆州刺史石崇靠抢劫外地商人而积累了万贯家财，被调至京城做卫尉，大肆挥霍。晋武帝的舅舅王恺也极力铺张浪费，想办法与石崇比富。王恺得到一株珊瑚十分得意，拿到石崇家。石崇拿出六七株送给王恺。王恺自叹不如"]},{"id":34051,"word":"石庆数马","pinyin":"shí qìng shǔ mǎ","abbr":"sqsm","explanation":"指在最简单的事情上也非常细心谨慎，一点也不马虎。","source":{"text":"万石君少子庆为太仆。御出，上问车中几马。庆以策数马毕，举手曰：‘六马。’庆于诸子中最简易矣，然犹如此。","book":"《史记·万石张叔列传》"},"example":{"text":"～，孔光温树。","book":"唐·李瀚《蒙求》"}},{"id":34052,"word":"石心木肠","pinyin":"shí xīn mù cháng","abbr":"sxmc","explanation":"石、木均为硬物，形容坚定不动摇。","source":{"text":"布衣蔬食，或未死于饥寒，石心木肠，誓不忘于忠义。","book":"宋·苏轼《谢失察妖贼表》"},"similar":["木肠石心"],"usage":"作宾语、定语；多用于比喻句"},{"id":34053,"word":"石心铁肠","pinyin":"shí xīn tiě cháng","abbr":"sxtc","explanation":"比喻人的心肠象石头一样硬，不容易为感情或言语所动。","source":{"text":"余常慕宋广平之为相，贞姿劲质，刚态毅状，疑其铁肠石心，不能吐婉媚辞。","book":"唐·皮日休《桃花赋序》"}},{"id":34054,"word":"石投大海","pinyin":"shí tóu dà hǎi","abbr":"stdh","explanation":"石投海中迅速没入，比喻毫无反响或杳无音信。","source":{"text":"吕岳闻杨瑨之言，如石投大海，半晌无言。","book":"明·许仲琳《封神演义》第80回"},"example":{"text":"这样做就是～，没有下文。"},"similar":["石沉大海"],"usage":"作定语、宾语；指没有音信"},{"id":34055,"word":"石敢当","pinyin":"shí gǎn dāng","abbr":"sgd","explanation":"旧时住宅正门如正对桥梁、巷口，常立一块小石牌，刻“石敢当”三字，以为可以降恶避邪，禁压不祥。","source":{"text":"师猛虎，石敢当，所不侵，龙未央。","book":"汉·史游《急救篇》"},"example":{"text":"咱们本钱厚，泰山～，沉得住气，输了钱，只当是借给他的。","book":"金庸《鹿鼎记》第四十二回"}},{"id":34056,"word":"石枯松老","pinyin":"shí kū sōng lǎo","abbr":"sksl","explanation":"石头干裂，松树老朽。形容历时极久。","source":{"text":"海移山变，石枯松老。","book":"金·丘处机《水龙吟·道运》词"},"similar":["海枯石烂"],"usage":"作宾语、定语；用于比喻句"},{"id":34057,"word":"石榴裙底","pinyin":"shí liú qún dǐ","abbr":"slqd","explanation":"石榴裙：大红裙。借指美女。也指某一类出色的女子脚下，多就男子应拜倒在她面前而言。","source":{"text":"黄口金多，乌纱势横。古今多少男子，缘此摧磨傲骨，不谓闺阁中有此诙谐人也！石榴裙底，当叩首三千下矣！","book":"清·沈起凤《谐铎》卷九"}},{"id":34058,"word":"石沉大海","pinyin":"shí chén dà hǎi","abbr":"scdh","explanation":"石头沉到海底。比喻从此没有消息。","source":{"text":"他若是不来，似石沉大海。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"至第三日，又带了几个水手，分头寻找，也是枉然。一连找了数日，竟似～。","book":"清·李汝珍《镜花缘》第三十二回"},"similar":["杳无音信"],"opposite":["一封家书"],"usage":"作谓语、定语、宾语；指没有下文"},{"id":34059,"word":"石沉海底","pinyin":"shí chén hǎi dǐ","abbr":"schd","explanation":"石头沉到海底。比喻从此没有消息。","source":{"text":"他若是不来，似石沉大海。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"典型的恩将仇报，从此便犹如～，至使我那老岳丈癖瘾大发，顶着鸭舌帽从此一蹶不振。","book":"冯苓植《与死共舞——“鞭杆”的故事》"}},{"id":34060,"word":"石泐海枯","pinyin":"shí lè hǎi kū","abbr":"slhk","explanation":"直到石头碎裂，海水干涸。形容经历极长的时间。","source":{"text":"倘邀数行，与贵通家商此数种，传之通邑大都，此为寿我先人，虽石泐海枯，义存无斁。","book":"清·倪会鼎《与人书》"},"similar":["海枯石烂"],"usage":"作定语、宾语；多用于比喻句"},{"id":34061,"word":"石火光阴","pinyin":"shí huǒ guāng yīn","abbr":"shgy","explanation":"表示光阴之迅速，一眨眼就要过去。","example":{"text":"青春时光，有如～，我们应把握时间多加学习。"}},{"id":34062,"word":"石火电光","pinyin":"shí huǒ diàn guāng","abbr":"shdg","explanation":"形容事物象闪电和石火一样一瞬间就消逝。","source":{"text":"僧问：‘如何是佛法大意？’……师曰：‘石火电光，已经尘劫。’","book":"宋·释道原《景德传灯录·怀楚禅师法嗣》"},"example":{"text":"夫心外心，镜中镜，奚啻～，转眼已尽。","book":"清·嶷如居士《西游补》序"},"similar":["电光石火"],"usage":"作宾语；比喻人生或时光的短暂"},{"id":34063,"word":"石火风灯","pinyin":"shí huǒ fēng dēng","abbr":"shfd","explanation":"比喻为时短暂。","source":{"text":"无常迅速，念念迁移，石火风灯，逝波残照，露华电影，不足为喻。","book":"《万善同归集》卷五"},"similar":["石火风烛"],"usage":"作宾语、定语；多用于比喻句"},{"id":34064,"word":"石火风烛","pinyin":"shí huǒ fēng zhú","abbr":"shfz","explanation":"比喻为时短暂。","source":{"text":"石火风烛，惊波逝水，诚修短之无改矣，奈痛伤之有等焉。","book":"唐·黄滔《祭宋员外》"},"similar":["石火风灯"],"usage":"作宾语、定语；多用于比喻句"},{"id":34065,"word":"石烂江枯","pinyin":"shí làn jiāng kū","abbr":"sljk","explanation":"直到石头变土，江水干涸。比喻不可能发生的事情。","source":{"text":"［王骥］乃与思禄约，许土目得部勒诸蛮，居孟养如故，立石金沙江为界，誓曰：‘石烂江枯，尔乃得渡。’","book":"《明史·云南土司传二·麓川》"},"similar":["石烂海枯"],"usage":"作定语、宾语；用于盟誓"},{"id":34066,"word":"石烂海枯","pinyin":"shí làn hǎi kū","abbr":"slhk","explanation":"直到石头变土，海水干涸。比喻永久。","source":{"text":"报施适当非为过，虎头蛇尾事可耻，石烂海枯团体固。","book":"清·王维城《新乐府》之二"},"example":{"text":"鸡鸣剑吼心疑碎，～志不磨。","book":"谢树琼《自嘲》诗"},"similar":["石烂江枯","海枯石烂"],"usage":"作定语、宾语、状语；用于盟誓"},{"id":34067,"word":"石破天惊","pinyin":"shí pò tiān jīng","abbr":"sptj","explanation":"原形容箜篌的声音，忽而高亢，忽而低沉，出人意外，有能以形容的奇境。后多比喻文章议论新奇惊人。","source":{"text":"女娲炼石补天处，石破天惊逗秋雨。","book":"唐·李贺诗《李凭箜篌引》"},"example":{"text":"陈继泰被他们这样的一来，好似那雷霆乍震，～，只吓得个肺腑皆崩，神魂出窍。","book":"清·张春帆《宦海》第十九回"},"similar":["惊天动地","天翻地覆"],"opposite":["默默无闻"],"usage":"作谓语、定语、状语；形容震惊"},{"id":34068,"word":"石缄金匮","pinyin":"shí jiān jīn kuì","abbr":"sjjk","explanation":"古代国家收藏重要文献的地方。同“石室金匮”。"},{"id":34069,"word":"石赤不夺","pinyin":"shí chì bù duó","abbr":"scbd","explanation":"石质坚硬，丹砂色鲜红，均不可改变。比喻意志坚定不移。","source":{"text":"石赤不夺，节士之必。测曰：石赤不夺，可与有要也。","book":"汉·杨雄《太玄·度》"},"usage":"作宾语、定语；多用于比喻句"},{"id":34070,"word":"石韬玉而山晖","pinyin":"shí tāo yù ér shān huī","abbr":"styesh","explanation":"韬：掩藏。石藏美玉，其山必有光辉。","source":{"text":"石韬玉而山晖，水怀珠而川媚。","book":"晋·陆机《文赋》"}},{"id":34071,"word":"砂里淘金","pinyin":"shā lǐ táo jīn","abbr":"sltj","explanation":"从砂子里淘出黄金。比喻从大量材料中选取精华。同“沙里淘金”。","source":{"text":"他曾经废寝忘食捞砂样，砂里淘金喜见一组一组新油层。","book":"《诗刊》1977年第9期"},"similar":["沙里淘金"],"usage":"作宾语、定语；形容工作困难"},{"id":34072,"word":"砌红堆绿","pinyin":"qì hóng duī lǜ","abbr":"qhdl","explanation":"形容春日花木繁荣的景象。","source":{"text":"想一年好处，砌红堆绿。","book":"宋·张孝祥《满江红·思归寄柳州》"},"usage":"作谓语、宾语；指春天的景象"},{"id":34073,"word":"砌词捏控","pinyin":"qì cí niē kòng","abbr":"qcnk","explanation":"捏造事实来控告。"},{"id":34074,"word":"砍一枝，损百枝","pinyin":"kàn yī zhī，sǔn bǎi zhī","abbr":"kyzsbz","explanation":"砍掉一根树枝，可能会损坏百根树枝。比喻得罪了一个人，可能会牵连到许多人。","source":{"text":"老公公砍一枝，损百枝，兔死狐悲，物伤其类。","book":"明·兰陵笑笑生《金瓶梅词话》第六十四回"},"example":{"text":"众人讲得是一笔写不出俩绿林来，～，好看了海马周三，就如同好看众人一样。","book":"清·文康《儿女英雄传》第二十一回"}},{"id":34075,"word":"砍瓜切菜","pinyin":"kǎn guā qiē cài","abbr":"kgqc","explanation":"形容操刀利落爽快。","source":{"text":"所过之地，杀人如砍瓜切菜，百姓哭声震天，四散奔走。","book":"明·周楫《西湖二集·姚伯子至孝受显荣》"},"example":{"text":"落后番兵，无船可渡，岳元帅追至江口，犹如～一般。","book":"清·钱彩《说岳全传》第四十三回"},"similar":["手起刀落"],"usage":"作定语、宾语；指动作利索"},{"id":34076,"word":"研京练都","pinyin":"yán jīng liàn dōu","abbr":"yjld","explanation":"指文思缜密而迟缓。","source":{"text":"语出南朝梁刘勰《文心雕龙·神思》：“张衡研京以十年，左思练都以一纪，虽有巨文，亦思之缓也。”言张衡作《二京赋》构思十年乃成，左思作《三都赋》构思十二年（《晋书·左思传》作“十年”）乃成。"},"usage":"作宾语、定语；用于书面语"},{"id":34077,"word":"研几探赜","pinyin":"yán jī tàn zé","abbr":"yjtz","explanation":"几：细微；赜：幽深。指研讨细微深奥的学问。","source":{"text":"虽未能研几探赜，穷极幽隐，庶乎弘道设教可以无遗阙焉。","book":"《隋书·经籍志一》"}},{"id":34078,"word":"研幾探赜","pinyin":"yán jī tàn zé","abbr":"yjtz","explanation":"幾：隐微，事物苗头；赜：幽深。研讨隐微深奥的学问","source":{"text":"虽未能研幾探赜，穷极幽隐，庶乎弘道设教可以无遗阙焉。","book":"《隋书·经籍志》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":34079,"word":"研幾析理","pinyin":"yán jī xī lǐ","abbr":"yjxl","explanation":"幾：隐微，事物苗头。研究隐微的现象，分析精深的义理","source":{"text":"凡所论著，皆研幾析理，弘雅夷远。","book":"唐·权德舆《齐成公神道碑铭序》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":34080,"word":"研机析理","pinyin":"yán jī xī lǐ","abbr":"yjxl","explanation":"几：细微。研究分析精微的义理。","source":{"text":"凡所论著，皆研几析理，弘雅夷远。","book":"唐·权德舆《齐成公神道碑铭序》"}},{"id":34081,"word":"研机综微","pinyin":"yán jī zōng wēi","abbr":"yjzw","explanation":"研究综合事理的深奥精微之处。","source":{"text":"犹朝夕恪勤，游情六艺，研机综微，靡不审核。","book":"《后汉书·贾逵伟》"},"usage":"作谓语、定语；用于书面语"},{"id":34082,"word":"研核是非","pinyin":"yán hé shì fēi","abbr":"yhsf","explanation":"核：对照，考核。研究考核什么是对，什么是错。","source":{"text":"温故知新，研核是非。","book":"汉·张衡《东京赋》"},"usage":"作谓语、宾语；指考究对错"},{"id":34083,"word":"研桑心计","pinyin":"yán sāng xīn jì","abbr":"ysxj","explanation":"研：计研，一名计然，春秋时越国范蠡的老师，善经商；桑：桑弘羊，汉武帝时的御史大夫，长于理财。形容善于经商致富。","source":{"text":"研桑心计于无垠。","book":"汉·班固《答宾戏》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":34084,"word":"研深覃精","pinyin":"yán shēn tán jīng","abbr":"ystj","explanation":"覃：深入。研究学问深入精到。","source":{"text":"潜心国史，博闻强记，研深覃精，至于前言往行。","book":"宋·钱易《南部新书·序》"},"usage":"作谓语、定语；用于书面语"},{"id":34085,"word":"研精极虑","pinyin":"yán jīng jí lǜ","abbr":"yjjl","explanation":"研：研究；精：细密；极：深入；虑：思考。精心研究，深入思考。","source":{"text":"臣既无他事，得以研精极虑，穷竭所有，日力不足，继之以夜。","book":"《资治通鉴》卷二百九十四"}},{"id":34086,"word":"研精殚力","pinyin":"yán jīng dān lì","abbr":"yjdl","explanation":"专心研究，尽力思考。同“研精竭虑”。","source":{"text":"历观古人作，亦有不尽佳，要其研精殚力，积数年十年而后成，自有一家面目在，夫岂徒以絺章饰句为事哉？","book":"清·王韬《〈蘅花馆诗录〉自序》"},"similar":["研精毕智"],"usage":"作谓语、定语；用于处事"},{"id":34087,"word":"研精殚思","pinyin":"yán jīng dān sī","abbr":"yjds","explanation":"专心研究，尽力思考。同“研精竭虑”。","source":{"text":"金华郑君彦渊，其尊吴氏不下于则章，昼夜研精殚思，正其句读，观其会通，探其旨趣。","book":"明·宋濂《〈葬书新注〉序》"},"example":{"text":"或谓诗不应苦思，苦思则丧其天真，殆不然。方其收视反听，～，寸心几呕，修髯尽枯，深湛守默，鬼神将通之。","book":"明·王世贞《艺苑卮言》卷一"},"similar":["研精殚力"],"usage":"作谓语、定语；用于处事"},{"id":34088,"word":"研精毕智","pinyin":"yán jīng bì zhì","abbr":"yjbz","explanation":"犹研精竭虑。专心研究，尽力思考。","source":{"text":"经国之士，研精毕智，所以因势而曲为之虑者，虽不可为典要，而亦未尝无典要也。","book":"明·唐顺之《〈右编〉序》"},"usage":"作谓语、定语；用于处事"},{"id":34089,"word":"研精究微","pinyin":"yán jīng jiū wēi","abbr":"yjjw","explanation":"研究事理深奥微妙之处。同“研精阐微”。","source":{"text":"余谓研精究微之学，乃宇宙间公共之理，不必辨其孰为传习。","book":"清·薛福成《出使四国日记·光绪十六年十一月二十一日》"},"similar":["研精阐微"],"usage":"作谓语、定语；用于书面语"},{"id":34090,"word":"研精竭虑","pinyin":"yán jīng jié lǜ","abbr":"yjjl","explanation":"专心研究，尽力思考。","source":{"text":"司马温公酷好扬子云《太玄》……自云：‘少好其书，研精竭虑，历年已多，始敢为注。’","book":"宋·张淏《云谷杂记·前辈读书》"},"usage":"作谓语、定语、状语；用于处事"},{"id":34091,"word":"研精致思","pinyin":"yán jīng zhì sī","abbr":"yjzs","explanation":"专心研究，尽力思考。","source":{"text":"愿陛下亲自劳恤，研精致思，勉求忠贞之臣，诛远佞谄之党，损玉堂之盛，尊天爵之重，割情欲之欢，罢宴私之好。","book":"《后汉书·翟酺传》"},"usage":"作谓语、定语；用于书面语"},{"id":34092,"word":"研精苦思","pinyin":"yán jīng kǔ sī","abbr":"yjks","explanation":"精心研究，深入思考。同“研精覃思”。","source":{"text":"研精苦思，扪隙发罅，以窥求门户。","book":"宋·王令《答刘公著微之书》"},"similar":["研精覃思"],"usage":"作谓语；指精心研究，深入思考"},{"id":34093,"word":"研精覃奥","pinyin":"yán jīng tán ào","abbr":"yjta","explanation":"覃奥：深奥。研究精微深奥的义理。","source":{"text":"窃痛友人沛国刘显，韫椟艺文，研精覃奥，聪明特达，出类拔群。","book":"《染书·刘显传》"},"usage":"作谓语、定语；用于书面语"},{"id":34094,"word":"研精覃思","pinyin":"yán jīng tán sī","abbr":"yjts","explanation":"研：研究；精：细密；覃：深入；思：思考。精心研究，深入思考。","source":{"text":"承诏为五十九篇作传，于是遂研精覃思，博考经籍，采摭群言，以立训传。","book":"唐·孔颖达《尚书序》"},"example":{"text":"若其～，则专门之学，斯固未暇。","book":"章炳麟《正学报缘起》"},"similar":["研精殚思"],"usage":"作谓语；指精心研究，深入思考"},{"id":34095,"word":"研精钩深","pinyin":"yán jīng gōu shēn","abbr":"yjgs","explanation":"钩深：探取深沉的东西。研究探索精微的道理，探求深奥的学问。","source":{"text":"虽言微旨远，而学者苟能研精钩深，优柔而求之，则壼奥指趣，将焉廋哉！","book":"唐·白居易《礼部试策·第三道》"},"usage":"作谓语、定语；用于书面语"},{"id":34096,"word":"研精阐微","pinyin":"yán jīng chǎn wēi","abbr":"yjcw","explanation":"研究阐明精深微妙之理。","source":{"text":"而一二千年以来，亦竟无一人研精阐微，为斯民辟妙用，为天下扩美利者，此无他，政权不足以鼓舞之也。","book":"清·薛福成《书工商核给凭单之例》"},"similar":["研精究微"],"usage":"作谓语、定语；用于书面语"},{"id":34097,"word":"研精静虑","pinyin":"yán jīng jìng lǜ","abbr":"yjjl","explanation":"研究精微，冷静思考。","source":{"text":"研精静虑，贞观厥美。怀秋成章，含笑奏理。","book":"南朝·宋·谢灵运《山居赋》"},"usage":"作谓语、宾语；用于书面语"},{"id":34098,"word":"研经铸史","pinyin":"yán jīng zhù shǐ","abbr":"yjzs","explanation":"精研经史。形容学问渊博。","source":{"text":"安老爷虽是研经铸史的通品，却是个秤薪量水的外行。","book":"《儿女英雄传》第三三回"},"usage":"作宾语、定语；用于书面语"},{"id":34099,"word":"砥兵砺伍","pinyin":"dǐ bīng lì wǔ","abbr":"dblw","explanation":"砥：细的磨刀石；砺：粗的磨刀石，指磨练；伍：队伍。磨练军队。","source":{"text":"足下砥兵砺伍，总厉豪彦，师请一奋，氓无贰情。","book":"《宋书·沈约自序》"},"usage":"作谓语；指磨练军队"},{"id":34100,"word":"砥厉名号","pinyin":"dǐ lì míng hào","abbr":"dlmh","explanation":"指自修品节，以保令名。","source":{"text":"臣闻盛饰入朝者，不以利污义；砥厉名号者，不以欲行。","book":"《史记·鲁仲连邹阳列传》"},"similar":["砥砺名号","砥砺名节"],"usage":"作谓语、宾语；用于处世"},{"id":34101,"word":"砥厉廉隅","pinyin":"dǐ lì lián yú","abbr":"dlly","explanation":"指磨练节操。廉隅，棱角，比喻指方正的操守。","source":{"text":"文儒者习近文章，以自磨厉，使成己廉隅也。","book":"《礼记·儒行》：“近文章，砥厉廉隅。”孔颖达疏"},"example":{"text":"志不在小，则不可度，～，则不可越，行高体卑，则不可阶。","book":"《孔丛子·连丛子下》"},"similar":["砥砺廉隅"],"usage":"作谓语、宾语；用于处世"},{"id":34102,"word":"砥名励节","pinyin":"dǐ míng lì jié","abbr":"dmlj","explanation":"砥：磨刀石，引申为磨砺；名：名誉；励：通“砺”，磨炼；节：节操。砥砺磨炼自己，立名立节。","source":{"text":"砥名励节，易地改辙，冀桑榆之未晚，得雌雄之一决。","book":"唐·高迈《济河焚舟赋》"},"similar":["砥砺名节"],"usage":"作谓语、宾语；指磨炼自己"},{"id":34103,"word":"砥名砺节","pinyin":"dǐ míng lì jié","abbr":"dmlj","explanation":"名：名誉；节：节操。磨炼自己，以保持名誉和节操。","source":{"text":"砥名砺节，易地改辙，冀桑榆之未晚，得雌雄之一决。","book":"汉·蔡邕《郭泰碑》：“若乃砥节砺行，直道正辞，贞固足以干事，隐括足以矫时。”唐·高迈《济河焚舟赋》"}},{"id":34104,"word":"砥平绳直","pinyin":"dǐ píng shéng zhí","abbr":"dpsz","explanation":"砥：磨刀石；绳：墨线。磨刀石极平，墨线绷直。形容十分平直。","source":{"text":"或穹窿恢廓，或栉比针列，或砥平绳直，或蜿蜒缪戾。","book":"汉·蔡邕《隶势》"},"usage":"作宾语、定语；用于事物等"},{"id":34105,"word":"砥廉峻隅","pinyin":"dǐ lián jùn yú","abbr":"dljy","explanation":"峻：高峭。通过磨砺，使可分解更加分明。比喻磨炼自己使品行更加端正。","source":{"text":"近文章，砥砺廉隅。","book":"《礼记·儒行》"},"example":{"text":"汝之守，足以～，而不刓于玩也。","book":"明·唐顺之《方砚铭》"},"similar":["砥砺廉隅"],"usage":"作谓语、宾语；用于处世"},{"id":34106,"word":"砥志研思","pinyin":"dǐ zhì yán sī","abbr":"dzys","explanation":"专心致志，深思钻研。","source":{"text":"程入闱，砥志研思，以求必售。","book":"清·蒲松龄《聊斋志异·胡四娘》"},"usage":"作谓语、定语；用于思考"},{"id":34107,"word":"砥柱中流","pinyin":"dǐ zhù zhōng liú","abbr":"dzzl","explanation":"就象屹立在黄河急流中的砥柱山一样。比喻坚强独立的人能在动荡艰难的环境中起支柱作用。","source":{"text":"吾尝从君济于河，鼋衔左骖，以入砥柱之中流。","book":"春秋·齐·晏婴《晏子春秋·内篇谏下》"},"example":{"text":"青年乎！其以中立不倚之精神，肩兹～之责任。","book":"李大钊《青春》"},"similar":["中流砥柱","坚定不移","力挽狂澜"],"opposite":["独木难支"],"usage":"作谓语、定语；指起重要作用","story":["上古时代，黄河三门峡河道狭窄处有一座山矗立在黄河的急流中，影响河水的通行，大禹治水时把两边的河道凿宽，这样这座砥柱山就像一根柱子一样立在急流之中。三门峡分人门、神门及鬼门，其中鬼门最险，而砥柱却巍然屹立在急流中"]},{"id":34108,"word":"砥砺名号","pinyin":"dǐ lì míng hào","abbr":"dlmh","explanation":"指自修品节，以保令名。同“砥厉名号”。","source":{"text":"砥砺名号者，不以利伤行。","book":"汉·刘向《新序·杂事三》"},"similar":["砥厉名号"],"usage":"作谓语、宾语；用于处世"},{"id":34109,"word":"砥砺名节","pinyin":"dǐ lì míng jié","abbr":"dlmj","explanation":"砥砺磨炼，立名立节。","source":{"text":"论者谓湛虽生不砥砺名节，死则俭约令终，是深达存亡之理。","book":"《晋书·夏侯湛传》"},"example":{"text":"吾辈读圣贤书，论居官治民之法，孰不欲～哉。","book":"明·刘元卿《贤奕编·廉淡》"},"similar":["砥砺风节"],"usage":"作谓语、宾语；指磨炼自己"},{"id":34110,"word":"砥砺名行","pinyin":"dǐ lì míng xíng","abbr":"dlmx","explanation":"砥砺：磨砺；名行：名誉和品行。砥砺磨炼自己的名誉和品行。","source":{"text":"丰砥砺名行以要世誉，而恕诞节直意，与丰殊趣。","book":"晋·陈寿《三国志·魏志·杜畿传》裴松之注引《杜氏新书》曰"},"similar":["砥砺名节"],"usage":"作谓语；指磨炼自己"},{"id":34111,"word":"砥砺廉隅","pinyin":"dǐ lì lián yú","abbr":"dlly","explanation":"砥砺：磨炼；廉隅：品德端正。通过磨炼而使品德端正不苟。","source":{"text":"近文章，砥砺廉隅。","book":"《礼记·儒行》"},"example":{"text":"本大臣～，一介不取，所到之处，一概不许办差。","book":"清·李宝嘉《官场现形记》第四十六回"},"similar":["砥厉廉隅"],"usage":"作谓语、宾语；用于处世"},{"id":34112,"word":"砥砺德行","pinyin":"dǐ lì dé xíng","abbr":"dldx","explanation":"磨炼品德行为。形容对自己要求严格，奋发向上。"},{"id":34113,"word":"砥砺清节","pinyin":"dǐ lì qīng jié","abbr":"dlqj","explanation":"磨炼自己，以保持清廉名节。","source":{"text":"虞文绣砥砺清节，耽学好古。","book":"汉·陈琳《檄吴将校部曲文》"},"similar":["砥砺名节","砥砺风节"],"usage":"作谓语；指磨炼自己"},{"id":34114,"word":"砥砺琢磨","pinyin":"dǐ lì zhuó mó","abbr":"dlzm","explanation":"琢磨：雕刻和打磨玉石。比喻磨练自己的品德，在学业上不断上进。","source":{"text":"政府于诸生期许之重，凡兹再三申谕，固期有所鉴戒，勉为成材。其各砥砺琢磨，毋负谆谆告诫之意。","book":"蔡东潘《民国通俗演义》第108回"},"example":{"text":"在学术研究方面，我们要不断～。"},"usage":"作谓语；用于学业方面"},{"id":34115,"word":"砥砺风节","pinyin":"dǐ lì fēng jié","abbr":"dlfj","explanation":"磨炼品格、节操。","source":{"text":"请自今监察御史按察司官，在任一岁，各举一人自代。所举不当，有罚。不惟砥砺风节，亦可为国得人。","book":"《元史·魏初传》"},"similar":["砥砺名节"],"usage":"作谓语；指磨炼自己"},{"id":34116,"word":"砥节励行","pinyin":"dǐ jié lì xíng","abbr":"djlx","explanation":"指磨砺操守和品行。砥，磨练。励，振奋；振作。","source":{"text":"鲁人有公仪休者，砥节励行，乐道好古，恬于荣利，不事诸侯。","book":"《孔丛子·公仪》"},"similar":["砥节厉行","砥节砺行"],"usage":"作谓语、定语；用于书面语"},{"id":34117,"word":"砥节厉行","pinyin":"dǐ jié lì xíng","abbr":"djlx","explanation":"指磨砺操守和品行。同“砥节励行”。","source":{"text":"若乃砥节厉行，直道正辞。","book":"汉·蔡邕《郭有道碑文》"},"example":{"text":"故中郎西平郭修，～，秉心不回。","book":"《三国志·魏志·齐王芳传》"},"similar":["砥节励行","砥节砺行"],"usage":"作谓语、定语；用于书面语"},{"id":34118,"word":"砥节奉公","pinyin":"dǐ jié fèng gōng","abbr":"djfg","explanation":"磨砺名节，奉行公事。","source":{"text":"砥节守公如一日，帝眷亦甚厚。","book":"《明史·周延传》：“延颜面寒峭，砥节奉公。权臣用事，政以贿成，延未尝有染。”《明史·梁材传》"},"similar":["廉洁奉公","砥节守公"],"usage":"作谓语；指人有气节"},{"id":34119,"word":"砥节守公","pinyin":"dǐ jié shǒu gōng","abbr":"djsg","explanation":"砥：磨刀石；节：节操。磨砺名节，奉行公事。","source":{"text":"砥节守公如一日，帝眷亦甚厚。","book":"《明史·梁材传》"},"similar":["砥节奉公"],"usage":"作谓语；指人有气节"},{"id":34120,"word":"砥节砺行","pinyin":"dǐ jié lì xíng","abbr":"djlx","explanation":"砥：细的磨刀石；砺：粗的磨刀石。磨炼节操与德行。","source":{"text":"若乃砥节砺行，直道正辞，贞固足以干事，隐括足以矫时。","book":"汉·蔡邕《郭泰碑》"},"example":{"text":"纪僧珍～，终始无瑕。","book":"唐·刘知己《史通·品藻》"},"similar":["砥节厉行"],"usage":"作谓语、定语；用于书面语"},{"id":34121,"word":"砥行磨名","pinyin":"dǐ xíng mó míng","abbr":"dxmm","explanation":"磨砺德行与名节。","source":{"text":"夫下之士，砥行磨名，欲不辱其志气，运奇蓄异，将进善于所灭。","book":"南朝·宋·周朗《报羊希书》"},"similar":["砥行立名"],"usage":"作谓语；用于书面语"},{"id":34122,"word":"砥行立名","pinyin":"dǐ xíng lì míng","abbr":"dxlm","explanation":"磨砺德行，建树功名。","source":{"text":"闾巷之人，欲砥行立名者，非附青云之士，恶能施于后世哉？","book":"《史记·伯夷列传》"},"similar":["砥行磨名"],"usage":"作谓语；指磨炼自己的德行"},{"id":34123,"word":"砥身砺行","pinyin":"dǐ shēn lì xíng","abbr":"dslx","explanation":"犹言砥节砺行。指磨砺操守和品行。","source":{"text":"建国君民，立教为首，砥身砺行，由乎经术。","book":"《梁书·儒林传序》"},"usage":"作谓语、宾语；用于处世"},{"id":34124,"word":"砥锋挺锷","pinyin":"dǐ fēng tǐng è","abbr":"dfte","explanation":"磨刀拔剑。指以武力反抗。","source":{"text":"《宋书·傅隆传》；“向使石厚之子、日磾之孙，砥锋挺锷，不与二祖同戴天日，则石碏、秺侯何得流名百代以为美谈者哉？”"},"usage":"作谓语；用于反抗"},{"id":34125,"word":"砭庸针俗","pinyin":"biān yōng zhén sú","abbr":"byzs","explanation":"指救治凡庸鄙陋。砭：刺。古代用石针扎皮肉治病。","source":{"text":"其文足以砭庸针俗，卓识大力，一空当世作者。","book":"清·龚炜《巢林笔谈·双忠寺碑文》"},"usage":"作谓语、定语；形容针对时局采取对策"},{"id":34126,"word":"砲凤烹龙","pinyin":"pào fèng pēng lóng","abbr":"pfpl","explanation":"①形容豪奢珍奇的肴馔。②指一种肴馔名。"},{"id":34127,"word":"砲龙烹凤","pinyin":"pào lóng pēng fèng","abbr":"plpf","explanation":"形容豪奢珍奇的肴馔。也指一种肴馔名。同“砲凤烹龙”。"},{"id":34128,"word":"破业失产","pinyin":"pò yè shī chǎn","abbr":"pysc","explanation":"破：毁坏。家业破败财产散失。","source":{"text":"今百姓远弃先祖坟墓，破业失产，亲戚分离，人怀思慕之心。","book":"汉·荀悦《汉纪·元帝纪中》"},"similar":["破家散业"],"usage":"作谓语、宾语、定语；用于失败"},{"id":34129,"word":"破产荡业","pinyin":"pò chǎn dàng yè","abbr":"pcdy","explanation":"指耗尽家产。同“破家荡产”。","source":{"text":"成化间，吴中大水，郡守刘瑀酷虐子民，督征粮税，乡民苦楚，破产荡业，不胜拷掠。","book":"明·俞弁《逸老堂诗话》下卷"},"similar":["破家荡产","破家荡业"],"opposite":["兴家立业"],"usage":"作谓语、定语、宾语；指破产"},{"id":34130,"word":"破军杀将","pinyin":"pò jūn shā jiāng","abbr":"pjsj","explanation":"①军被破，将被杀。指全军覆没。②攻破敌军，杀死敌将。","source":{"text":"昔者，齐人伐楚，战胜，破军杀将，再辟千里。","book":"西汉·刘向《战国策·秦策》"},"example":{"text":"西汉·刘向《战国策·秦策》：“昔者，齐人伐楚，战胜，破军杀将，再辟千里。”"},"usage":"作谓语、定语；用于书面语"},{"id":34131,"word":"破卵倾巢","pinyin":"pò luǎn qīng cháo","abbr":"plqc","explanation":"碎裂鸟卵，倾覆鸟窠。比喻斩草除根，手段残忍。","source":{"text":"却原来分属师生，曾受深恩也。破卵倾巢太不仁。","book":"明·陈与郊《义犬记》第三折"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":34132,"word":"破口大骂","pinyin":"pò kǒu dà mà","abbr":"pkdm","explanation":"口出恶语大声骂人。","source":{"text":"茶房未及开口，那女人已经破口大骂起来。","book":"清·李宝嘉《官场现形记》第十回"},"example":{"text":"沙龙～，所有十一家猎户俱是他一人承当。","book":"清·石玉昆《三侠五义》第九十三回"},"similar":["口出不逊","含血喷人"],"opposite":["温文尔雅","彬彬有礼"],"usage":"作谓语、宾语；指骂人"},{"id":34133,"word":"破口怒骂","pinyin":"pò kǒu nù mà","abbr":"pknm","explanation":"破口：恶语。满口恶语骂人。","source":{"text":"他竭力挣脱，挣脱不开，连连求饶，陶二嫂还是拳打脚踢，破口怒骂。","book":"《红日》第12章"},"similar":["破口痛骂"],"usage":"作谓语、宾语；指骂人"},{"id":34134,"word":"破口痛骂","pinyin":"pò kǒu tòng mà","abbr":"pktm","explanation":"破口：恶语。满口恶语骂人。","source":{"text":"老太婆坐在窗下，指着丈夫就破口痛骂：‘你这个蠢货，真是个地道的傻瓜！’","book":"《渔夫和金鱼的故事》"},"similar":["破口大骂","破口怒骂"],"usage":"作谓语、宾语；指骂人"},{"id":34135,"word":"破国亡宗","pinyin":"pò guó wáng zōng","abbr":"pgwz","explanation":"国家破灭，宗族不存。","source":{"text":"用商鞅桑宏羊之术，破国亡宗者皆是也。","book":"宋·苏轼《东坡志林》卷五"},"similar":["破国亡家"],"usage":"作谓语、定语、宾语；用于战乱"},{"id":34136,"word":"破国亡家","pinyin":"pò guó wáng jiā","abbr":"pgwj","explanation":"国家覆灭、家庭毁灭。","source":{"text":"后人不识前贤意，破国亡家事甚多。","book":"唐·汪遵《咏酒二首》诗"},"example":{"text":"世事纷纷难诉陈，知机端不误终身。若论～者，尽是贪花恋色人。","book":"明·冯梦龙《警世通言》第三十三卷"},"similar":["破国亡宗","国破家亡"],"usage":"作谓语、定语；指国家覆灭、家人离散"},{"id":34137,"word":"破坚摧刚","pinyin":"pò jiān cuī gāng","abbr":"pjcg","explanation":"指攻破摧毁强敌。","source":{"text":"尔其则有谋臣武将，皆能攫戾执猛，破坚摧刚。","book":"汉·张衡《南都赋》"},"usage":"作谓语、宾语；用于战争等"},{"id":34138,"word":"破壁燎火","pinyin":"pò bì liáo huǒ","abbr":"pblh","explanation":"推倒墙壁，点燃灯火。形容作，形容作风正派，不好女色。","source":{"text":"鲁男子夜大雨，有邻之嫠妇因风雨坏屋投栖睛。男子乃破壁，燎火以达旦。","book":"清·张英《渊鉴类函·墙壁三》"}},{"id":34139,"word":"破壁飞去","pinyin":"pò bì fēi qù","abbr":"pbfq","explanation":"传说梁代画家张僧繇在壁上画龙，点上眼睛后龙即飞云。比喻人突然有钱有势或官职地位一下子升得很快。","source":{"text":"金陵安乐寺四白龙不点眼睛，每云：‘点睛即飞去。’人以为妄诞，因请点之。须臾，雷电破壁，两龙乘云腾去上天，二龙未点眼者见在。","book":"唐·张彦远《历代名画记》"},"example":{"text":"即使把黎软禁在北京，段还怕他会有一天～。","book":"陶菊隐《北洋军阀统治时期史话》第31章"},"similar":["画龙点睛"],"usage":"作谓语、定语；指画龙点睛","story":["南朝梁代著名书画家张僧繇特别擅长画龙，梁武帝在金陵建安乐寺，让张僧繇在墙上画龙，他画了四条龙栩栩如生，但都没有点眼睛。众人不解，怂恿他点上龙眼，他刚刚点了两条龙的眼睛，顿时闪电四起，两条龙腾空而去"]},{"id":34140,"word":"破壳而出","pinyin":"pò ké ér chū","abbr":"pkec","explanation":"带壳的动植物冲破其外壳而生长。形容新生事物十分顽强。","example":{"text":"带壳的动植物冲破其外壳而生长。形容新生事物十分顽强。"},"usage":"作谓语、状语；多用于比喻句"},{"id":34141,"word":"破天荒","pinyin":"pò tiān huāng","abbr":"pth","explanation":"指从来没有出现过的事。","source":{"text":"唐荆州衣冠薮泽，每岁解送举人，多不成名，号日天荒解。刘蜕舍人以荆解及第，号为‘破天荒’。","book":"宋·孙光宪《北梦琐言》第四卷"},"example":{"text":"这局子里向来的总办都是道班，这一位是～的。","book":"清·吴趼人《二十年目睹之怪现状》第64回"},"similar":["前所未有"],"opposite":["司空见惯"],"usage":"作宾语、定语、状语；指从未出现过的事","story":["唐朝时期，荆州地区50多年没有举人到京城应考中过进士，因此被称为“天荒”，直到唐宣宗时期，有一个荆州举人刘蜕中了进士，破了天荒。荆州魏国公崔铉特地奖励他70万钱。刘蜕不受并回信说：“五十年来，自是人废；一千里外，岂曰天荒。”"]},{"id":34142,"word":"破头烂额","pinyin":"pò tóu làn é","abbr":"ptle","explanation":"犹言头破血流。多用来形容惨败。","source":{"text":"两争不决，操戈相向，两人破头烂额而赴公庭焉。","book":"清·蒲松龄《聊斋志异·爱奴》"},"similar":["焦头烂额"],"usage":"作谓语、定语、状语；用于惨败时"},{"id":34143,"word":"破奸发伏","pinyin":"pò jiān fā fú","abbr":"pjff","explanation":"揭露隐藏的坏人。","source":{"text":"徙陇城郡，历比、驾二部外郎，在郡未几，破奸发伏，有神明之号。","book":"宋·范仲淹《宋故卫尉少卿分司西京胡公神道铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":34144,"word":"破家丧产","pinyin":"pò jiā sàng chǎn","abbr":"pjsc","explanation":"全部家产都被弄光了。同“破家败产”。","source":{"text":"带领无名子弟动计三五十，执把军器，勾忧平民，监锁吊打，抢夺财物，破家丧产，民甚苦之。","book":"《元典章·刑部·听讼》"},"similar":["破家竭产","破家败产"],"opposite":["兴家立业"],"usage":"作谓语、定语、宾语；指破产"},{"id":34145,"word":"破家为国","pinyin":"pò jiā wèi guó","abbr":"pjwg","explanation":"为了国家，不惜损毁自己的家庭。","source":{"text":"扶助神灵，辅成圣德，破家为国，忘身奉主。","book":"汉·侯霸《李通辞位议》"},"example":{"text":"再对贼锋，父子并命，可谓～，守死勤事。","book":"《晋书·卞壶传》"},"usage":"作谓语；指一心为国"},{"id":34146,"word":"破家亡国","pinyin":"pò jiā wáng guó","abbr":"pjwg","explanation":"国家覆灭、家庭毁灭。","source":{"text":"却笑丘墟隋炀帝，破家亡国誊谁人？","book":"唐·杜牧《隋苑（红霞一抹广陵春）》诗"},"example":{"text":"却笑吃虚隋炀帝，～为何人。","book":"唐·李商隐《定子（檀槽一抹广陵春）》诗"}},{"id":34147,"word":"破家危国","pinyin":"pò jiā wēi guó","abbr":"pjwg","explanation":"不但损毁自己的家庭，而且危害国家。","source":{"text":"嫡庶相害，破家危国，古今以为鉴诫。","book":"三国·魏·钟会《母夫人张氏传》"},"usage":"作谓语、定语；指危害大"},{"id":34148,"word":"破家县令","pinyin":"pò jiā xiàn lìng","abbr":"pjxl","explanation":"指横暴的地方官。","source":{"text":"人有恒言，破家县令，灭门刺史。","book":"明·敖英《东谷赘言》上"},"example":{"text":"钱钟联《黄公度先生年谱》笺注：“至于晚明，有～之称，民反以官为忧，而乐于无官。”"},"similar":["灭门刺史"],"usage":"作宾语、定语；指横暴的地方官"},{"id":34149,"word":"破家散业","pinyin":"pò jiā sàn yè","abbr":"pjsy","explanation":"家庭破坏，财产散失。","source":{"text":"亲老涕泣，孤子啼号，破家散业，迎尸千里之外，裹骸骨而归。","book":"《汉书·严助传》"},"example":{"text":"一旦失职，凛凛有破家散业，流离死亡之忧也。","book":"宋·陆九渊《与苏宰书》"},"similar":["破家荡产"],"opposite":["成家立业"],"usage":"作谓语、定语、补语；指破产"},{"id":34150,"word":"破家竭产","pinyin":"pò jiā jié chǎn","abbr":"pjjc","explanation":"全部家产都被弄光了。同“破家败产”。","source":{"text":"后唐明宗尝入仓观受纳……曰：‘仓禀宿藏，动经数岁，若取之如此，后岂免销折乎？’吏因诉曰：‘自来主藏者所以至破家竭产以偿欠，正为是。’","book":"宋·叶梦得《石林燕语》卷三"},"similar":["破家荡业","破家丧产","破家败产"],"opposite":["兴家立业"],"usage":"作谓语、定语、宾语；指破产"},{"id":34151,"word":"破家荡业","pinyin":"pò jiā dàng yè","abbr":"pjdy","explanation":"指耗尽家产。同“破家荡产”。","source":{"text":"必须督责补买，及供给一切诸物。因而逼临，破家荡业，无可展免。","book":"《元典章·刑部·禁诱略》"},"similar":["破产荡业","破家荡产"],"opposite":["兴家立业"],"usage":"作谓语、定语、宾语；指破产"},{"id":34152,"word":"破家荡产","pinyin":"pò jiā dàng chǎn","abbr":"pjdc","explanation":"指耗尽家产。","source":{"text":"狭乡富家，靳靳自足，一被应役，无不破家荡产。","book":"宋·朱熹《朱子语类》第111卷"},"example":{"text":"触着他的，风波立至，必要弄得那人～，方才罢手。","book":"明·冯梦龙《醒世恒言》第四卷"},"similar":["倾家荡产","破家散业","拆家荡产"],"opposite":["兴家立业"],"usage":"作谓语、定语、补语；指破产"},{"id":34153,"word":"破家败产","pinyin":"pò jiā bài chǎn","abbr":"pjbc","explanation":"犹言倾家荡产。全部家产都被弄光了。","source":{"text":"坐与先生为党而被罪者不可胜数，其相欢而奉先生者，或至于破家败产而不悔。","book":"宋·秦观《清和先生传》"},"similar":["倾家荡产","破家丧产","破家荡业"],"opposite":["兴家立业"],"usage":"作谓语、定语、宾语；指破产"},{"id":34154,"word":"破家鬻子","pinyin":"pò jiā yù zǐ","abbr":"pjyz","explanation":"鬻：卖。家族毁坏，卖儿卖女。比喻困苦之极。","source":{"text":"上赋其民以十，则吏因以赋其百。朝廷喜其办而不知有破家鬻子之民。","book":"宋·杨万里《民政上》"},"usage":"作谓语、定语；用于生活"},{"id":34155,"word":"破屋更遭连夜雨，漏船又遭打头风","pinyin":"pò wū gēng zāo lián yè yǔ，lòu chuán yòu zāo dǎ tóu fēng","abbr":"pwgzlyylcyzdtf","explanation":"打头风：逆风。比喻祸不单行，接连遭受意外打击。","source":{"text":"祸从天降，灾向地上。恰似破屋更遭连夜雨，漏船又遭打头风。","book":"明·施耐庵《水浒传》第45回"},"usage":"作宾语、定语、分句；用于人的境遇"},{"id":34156,"word":"破崖绝角","pinyin":"pò yá jué jiǎo","abbr":"pyjj","explanation":"磨除棱角。比喻处事圆滑。","source":{"text":"彼中人之性，利害不出于一身，莫不破崖绝角以阿陛下之所好。","book":"清·陈忱《续资治通鉴·宋理宗嘉熙元年》"},"usage":"作谓语、定语、状语；用于处事"},{"id":34157,"word":"破巢余卵","pinyin":"pò cháo yú luǎn","abbr":"pcyl","explanation":"比喻破家或被祸后幸存的人。","source":{"text":"破巢余卵，旦夕待命。","book":"明·夏完淳《〈续幸存录〉自序》"},"similar":["破巢完卵"],"usage":"作宾语、定语；用于灾后"},{"id":34158,"word":"破巢完卵","pinyin":"pò cháo wán luǎn","abbr":"pcwl","explanation":"比喻破家或被祸后幸存的人。","source":{"text":"抱蔓摘瓜余我在，破巢完卵似君稀。","book":"清·钱谦益《临城驿壁见方侍御孩未题诗》诗"},"similar":["破巢余卵"],"usage":"作宾语、定语；用于灾后"},{"id":34159,"word":"破愁为笑","pinyin":"pò chóu wéi xiào","abbr":"pcwx","explanation":"犹言转忧为喜。由忧愁转为欢喜。","source":{"text":"又承书札，银钩甚丽，玉疏依然，开封伸纸，破愁为笑。","book":"南朝·陈·徐陵《答族人梁东海太守长孺书》"},"similar":["破涕为笑","转忧为喜"],"usage":"作谓语；指转忧为喜"},{"id":34160,"word":"破斧缺斨","pinyin":"pò fǔ quē zhōu","abbr":"pfqq","explanation":"斧、斨，泛指兵器。形容战争中必须付出的代价。","source":{"text":"既破我斧，又缺我斨。","book":"《诗·豳风·破斧》"},"example":{"text":"故～之后，衮衣绣裳，驻大师于徐兖之间，俾东夏无摇心。","book":"清·方苞《周公论》"},"usage":"作宾语、定语；用于书面语"},{"id":34161,"word":"破旧立新","pinyin":"pò jiù lì xīn","abbr":"pjlx","explanation":"破除旧的，建立新的。","example":{"text":"我们要～改变封建意识。"},"similar":["移风易俗"],"opposite":["墨守成规"],"usage":"作谓语、定语；用于思想、观念等"},{"id":34162,"word":"破柱埋轮","pinyin":"pò zhù mái kún","abbr":"pzml","explanation":"指汉朝李膺破柱搜捕张让之弟张朔和张纲埋轮洛阳都亭弹劾梁冀之典。比喻刚正不阿，不畏权贵。","source":{"text":"《后汉书·张纲传》；《后汉书·党锢传·李膺》"}},{"id":34163,"word":"破柱求奸","pinyin":"pò zhù qiú jiān","abbr":"pzqj","explanation":"为不畏权贵，搜索坏人，以正国法的典故。","source":{"text":"时张让弟朔为野王令，贪残无道，至乃杀孕妇，闻膺厉威严，惧罪逃还京师，因匿兄让弟舍，藏于合柱中。膺知其状，率将吏卒破柱取朔，付洛阳狱。受辞毕，即杀之。","book":"《后汉书·党锢传·李膺》"},"example":{"text":"如或纶言既降，丹慊莫从，则当～，碎首请事。死而后已，义不苟然。","book":"唐·元稹《代李中丞谢官表》"},"usage":"作谓语、定语；用于书面语","story":["汉朝时期，权臣张让的弟弟张朔担任野王令，贫残无道，甚至还杀害孕妇，他听说李膺执法威严，就逃回京师，就藏到张让家的合柱中。李膺听说后，立即带领官吏与士卒到张让家，劈开柱子抓取张朔，投入洛阳监狱，上报皇帝后，立即将其正法"]},{"id":34164,"word":"破格任用","pinyin":"pò gé rèn yòng","abbr":"pgry","explanation":"格：规格，标准。突破原来的标准任用人才。","source":{"text":"皇上对天下知府中权其繁剧难治者三十，许二品以上官荐举，破格任用。","book":"《清史稿·选举志五》"},"example":{"text":"嗣昌即奏良玉有大将才，请～，应拜为平贼将军，有旨报可。","book":"蔡东蕃《明史演义》第九十六回"},"similar":["破格录用"],"usage":"作谓语、宾语；用于选拔人才"},{"id":34165,"word":"破格录用","pinyin":"pò gé lù yòng","abbr":"pgly","explanation":"格：规格，标准；录用：任用。突破原来的标准任用人才。","source":{"text":"此外新进之士，有奇才异能的，亦应时破格录用。","book":"曾朴《孽海花》第27回"},"example":{"text":"季交恕写了一道上黎元洪‘自愿投笔从戎，请求～’的半万言书。","book":"李六如《六十年的变迁》第三章"},"similar":["破格任用"],"usage":"作谓语、宾语；用于选拔人才"},{"id":34166,"word":"破格提拔","pinyin":"pò gé tí bá","abbr":"pgtb","explanation":"不遵常规选拔提升。","source":{"text":"打破那些关于台阶的过时的观念，创造一些适合新形势新任务的台阶，这才能大胆破格提拔。","book":"邓小平《党和国家领导制度的改革》"},"usage":"作谓语、定语、宾语；用于选择"},{"id":34167,"word":"破桐之叶","pinyin":"pò tóng zhī yè","abbr":"ptzy","explanation":"比喻已分不可复合的事物。","source":{"text":"时李怀光叛，岁又蝗旱，议者欲赦怀光。帝博问群臣，泌破一桐叶附使以进，曰：‘陛下与怀光，君臣之分不可复合，如此叶矣。’由是不赦。","book":"《新唐书·李泌传》"},"example":{"text":"《新唐书·李泌传》：“时李怀光叛，岁又蝗旱，议者欲赦怀光。帝博问群臣，泌破一桐叶附使以进，曰：‘陛下与怀光，君臣之分不可复合，如此叶矣。’由是不赦。”"},"usage":"作宾语；比喻已分不可复合的事物"},{"id":34168,"word":"破死忘生","pinyin":"pò sǐ wàng shēng","abbr":"psws","explanation":"不顾性命危险；不顾一切。","source":{"text":"[张太太]今日在舅太太屋里听得姑爷果然中了，便如飞的从西过道儿里直奔到这里来，破死忘生的大着胆子上去，要当面叩谢魁星的保佑。","book":"《儿女英雄传》第三五回"},"usage":"作定语、状语；用于书面语"},{"id":34169,"word":"破浪乘风","pinyin":"pò làng chéng fēng","abbr":"plcf","explanation":"比喻排除困难，奋勇前进。同“乘风破浪”","source":{"text":"悫年少时，炳问其志，悫曰：‘愿乘长风破万里浪。’","book":"《宋书·宗悫传》"},"example":{"text":"感此独心忡。羡中流先我，～。","book":"秋瑾《望海潮·惜别多时)》"},"similar":["乘风破浪"],"usage":"作谓语、定语；形容事业迅速发展","story":["南朝时期，宋国著名将领宗悫从小就有雄心壮志，喜欢舞枪弄剑，他的叔父宗炳问他的志向，他回答说：“愿乘长风破万里浪！”，后来他带兵攻打林邑国，运用计谋取胜，被封为左卫将军"]},{"id":34170,"word":"破涕为欢","pinyin":"pò tì wéi huān","abbr":"ptwh","explanation":"涕：眼泪。一下子停止了哭泣，露出笑容。形容转悲为喜。","source":{"text":"时复相与举觞对膝，破涕为笑。","book":"晋·刘琨《答卢堪书》"},"example":{"text":"高、杨二相，与隋主虽然异席，却是相隔不远，又各出婉言和解，隋主始～。","book":"蔡东蕃《南北史演义》第八十七回"},"similar":["破涕为笑"],"usage":"作谓语、定语、状语；形容人的表情"},{"id":34171,"word":"破涕为笑","pinyin":"pò tì wéi xiào","abbr":"ptwx","explanation":"涕：眼泪。一下子停止了哭泣，露出笑容。形容转悲为喜。","source":{"text":"时复相与举觞对膝，破涕为笑。","book":"晋·刘琨《答卢堪书》"},"example":{"text":"她很高兴地赞同这个计划，并且～地说她有逃的办法。","book":"巴金《家》二十八"},"similar":["转悲为喜","破颜一笑"],"opposite":["泪如泉涌","泣不成声","饮泣吞声"],"usage":"作谓语、定语、状语；形容人的表情"},{"id":34172,"word":"破涕成笑","pinyin":"pò tì chéng xiào","abbr":"ptcx","explanation":"形容转悲为喜。同“破涕为笑”。","source":{"text":"纵李兄言太刻毒，适足破涕成笑，何须芥蒂。","book":"清·和邦额《夜谭随录·阮龙光》"},"similar":["破涕为笑"],"usage":"作谓语、定语、状语；形容人的表情"},{"id":34173,"word":"破烂不堪","pinyin":"pò làn bù kān","abbr":"plbk","explanation":"破破烂烂的不成样子。","source":{"text":"一时风气大变，没有一个不是穿的极破烂不堪的。","book":"清·李宝嘉《官场现形记》第二十回"},"example":{"text":"路遥《平凡的世界》第一卷第二章：“两年下来，润生的车子还是新的，金波的车子已经～了。”"},"similar":["破破烂烂"],"usage":"作谓语、定语、状语；用于口语"},{"id":34174,"word":"破烂流丢","pinyin":"pò làn liú diū","abbr":"plld","explanation":"破烂不堪的样子。","source":{"text":"当驾官即开了，捧出丹盘来看，果然是件破烂流丢一口钟。","book":"明·吴承恩《西游记》第四十六回"},"example":{"text":"他看不上这些～的东西"},"usage":"作谓语、定语、状语；用于口语"},{"id":34175,"word":"破烂货","pinyin":"pò làn huò","abbr":"plh","explanation":"指荡妇或丧失贞操的女人。","example":{"text":"骂女性为～是不尊重女性的表现。"},"usage":"作宾语、定语；用于骂女性"},{"id":34176,"word":"破玉锤珠","pinyin":"pò yù chuí zhū","abbr":"pycz","explanation":"碎美玉毁明珠。比喻能人死去。","source":{"text":"破玉锤珠可惜人，天何言哉无知也。","book":"明·袁宏道《哭临漳令王子声》"},"usage":"作宾语、定语；用于惋惜"},{"id":34177,"word":"破玩意儿","pinyin":"pò wán yì ér","abbr":"pwye","explanation":"低劣的技艺；低劣的对象。","example":{"text":"请把这个～拿开。"},"usage":"作主语、宾语；用于口语"},{"id":34178,"word":"破琴示绝","pinyin":"pò qín shì jué","abbr":"pqsj","explanation":"把琴摔破，表示绝裂。指不媚权贵。","example":{"text":"做出～的举动是不容易的。"},"usage":"作宾语、定语；指不媚权贵","story":["晋朝时期，才华横溢的戴逵很会弹琴，名声很大。他看不惯官场的黑暗，坚决不入朝为官，隐居在会稽弹琴作画自娱。武陵威王司马道叔派人请他去王府弹琴。戴逵在使者面前把琴摔破坚决不从，司马道叔拿他也没有办法"]},{"id":34179,"word":"破琴绝弦","pinyin":"pò qín jué xián","abbr":"pqjx","explanation":"比喻知音断绝。","source":{"text":"钟子期死，伯牙破琴绝弦，终身不复鼓琴。","book":"《吕氏春秋·本味》"},"usage":"作谓语、宾语；用于书面语"},{"id":34180,"word":"破璧毁珪","pinyin":"pò bì huǐ guī","abbr":"pbhg","explanation":"璧、珪：均为玉。比喻破坏美好的东西。","source":{"text":"铜马竞驰，金虎乱噬，九婴暴起，十日并出，破璧毁珪，人物既尽。","book":"北魏·温鹏举《寒陵山寺碑》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":34181,"word":"破瓜之年","pinyin":"pò guā zhī nián","abbr":"pgzn","explanation":"瓜字可以分割成两个八字，所以旧诗文称女子十六岁时为“破瓜之年”。","source":{"text":"独东川卢八座送一歌姬，未当破瓜之年亦以玉箫为好。","book":"唐·范虑《云溪友议·韦皋》"},"example":{"text":"她到了～已长得婷婷玉立。"},"similar":["破瓜年纪"],"usage":"作宾语；指女子16岁"},{"id":34182,"word":"破瓜年纪","pinyin":"pò guā nián jì","abbr":"pgnj","explanation":"破：劈开。瓜字可以分割成两个八字，指少女十六岁时。","source":{"text":"按俗以女子破身为破瓜，非也。瓜字破之为二八字，言其二八十六岁耳。","book":"清·翟灏《通俗编·妇女》"},"similar":["破瓜之年"],"usage":"作宾语；指女子16岁"},{"id":34183,"word":"破瓦寒窑","pinyin":"pò wǎ hán yáo","abbr":"pwhy","explanation":"指穷苦人住的简陋破旧的房屋。","example":{"text":"你能来我这～，我真高兴。"},"similar":["蓬门荜户"],"usage":"作主语、宾语、定语；指破旧的房屋"},{"id":34184,"word":"破瓦颓垣","pinyin":"pò wǎ tuí yuán","abbr":"pwty","explanation":"屋瓦破损，墙垣坍塌。形容破败的景象。","source":{"text":"计其一时之盛，宏杰诡丽坚固而不可动者，岂特百倍于台而已哉！然而数世之后，欲求其仿佛而破瓦颓垣无复存者。","book":"宋·苏轼《凌虚台记》"},"example":{"text":"宋·苏轼《凌虚台记》：“计其一时之盛，宏杰诡丽坚固而不可动者，岂特百倍于台而已哉！然而数世之后，欲求其仿佛而破瓦颓垣无复存者。”"},"usage":"作宾语、定语；用于战后或灾难后等"},{"id":34185,"word":"破甑不顾","pinyin":"pò zèng bù gù","abbr":"pzbg","explanation":"甑：古代一种瓦制炊器；顾：回头看。甑落地已破，不再看它。比喻既成事实，不再追悔。","source":{"text":"客居太原，荷甑堕地，不顾而去。林宗见而问其意，对曰：‘甑已破矣，视之何益。’","book":"《后汉书·郭泰传》"}},{"id":34186,"word":"破甑生尘","pinyin":"pò zēng shēng chén","abbr":"pzsc","explanation":"甑：蒸食器。食器既破而且满积尘土。形容极其穷困。","source":{"text":"若有此变，未免漂流别境。那里呵，餐风宿水乡，恐破甑生尘愁范丹。","book":"明·王士桢《鸣凤记·林公避兵》"},"example":{"text":"范丹土灶生娃，～；曾子捉襟见肘，纳履决踵，贫不胜言。","book":"明·程允升《幼学琼林·贫富》"},"similar":["釜中生鱼"],"usage":"作宾语、定语；用于生活"},{"id":34187,"word":"破矩为圆","pinyin":"pò jǔ wéi yuán","abbr":"pjwy","explanation":"把方的改成圆的。比喻将刑法去严从简。","source":{"text":"大汉初兴，详览失得，故破矩为圆，斫  为朴，蠲除苛政，更立疏网。","book":"《后汉书·杜林传》"},"similar":["破觚为圜"],"usage":"作谓语；比喻将刑法去严从简"},{"id":34188,"word":"破矩为圜","pinyin":"pò jǔ wéi yuán","abbr":"pjwh","explanation":"矩：画方形的工具；圜：圆。毁方为圆。比喻去严刑而从简政。","source":{"text":"大汉初兴，详览失得，故破矩为圜，斫雕为朴，蠲除苛政，更立疏网，海内欢欣，人怀宽德。","book":"南朝·宋·范晔《后汉书·杜林传》"},"similar":["破觚为圜"],"usage":"作谓语、宾语；用于治理国家"},{"id":34189,"word":"破破烂烂","pinyin":"pò pò làn làn","abbr":"ppll","explanation":"破旧霉烂。","source":{"text":"穿的衣裳虽然是号褂子，挂一块、飘一块，破破烂烂，竟同叫化子不相上下。","book":"清·李宝嘉《官场现形记》第55回"},"example":{"text":"这街道虽然也～，但比石圪节多了许多铺子门面，看起来像个城镇的街道。","book":"路遥《平凡的世界》第一卷第十章"},"similar":["破旧不堪"],"usage":"作定语、状语；用于口语"},{"id":34190,"word":"破碎支离","pinyin":"pò suì zhī lí","abbr":"pszl","explanation":"支离：分散。形容事物零散破碎，不成整体。","source":{"text":"一类可以说是毛、郑的影响，不过破碎支离，变本加厉。","book":"朱自清《比兴》"},"similar":["支离破碎"],"usage":"作谓语、定语、补语；指不成整体"},{"id":34191,"word":"破碗破摔","pinyin":"pò wǎn pò shuāi","abbr":"pwps","explanation":"比喻已经弄坏了的事就干脆不顾。","example":{"text":"他索性就～，谁的话都听不进去。"},"similar":["破罐子破摔"],"usage":"作谓语、定语；指不负责任"},{"id":34192,"word":"破竹之势","pinyin":"pò zhú zhī shì","abbr":"pzzs","explanation":"比喻节节胜利，毫无阻碍。","source":{"text":"今兵威已振，譬如破竹，数节之后，皆迎刃而解。","book":"《晋书·杜预传》"},"example":{"text":"我军以～进逼武昌，今闻已进展到离武昌城仅中国里百五十里之地。","book":"郭沫若《革命春秋·北伐途次》"},"similar":["势如破竹"],"usage":"作宾语；比喻节节胜利，毫无阻碍"},{"id":34193,"word":"破竹建瓴","pinyin":"pò zhú jiàn líng","abbr":"pzjl","explanation":"破竹：指顺利无阻；建瓴：把瓶水向下倾倒，指不可阻挡。比喻极其顺利，不可阻遏的形势。","source":{"text":"由昔岭中峰直抵葛尔崖，实有破竹建瓴之势。","book":"清·魏源《圣武记》第七卷"},"example":{"text":"我们已经形成～之势，胜利在望。"},"usage":"作定语；指不可阻挡之势"},{"id":34194,"word":"破绽百出","pinyin":"pò zhàn bǎi chū","abbr":"pzbc","explanation":"比喻说话做事漏洞非常多。","source":{"text":"却回头看释氏之书，渐渐破绽百出。","book":"宋·李侗《李廷平集·答问下》"},"example":{"text":"他的话～不值得一信。"},"similar":["漏洞百出","错误百出"],"opposite":["无懈可击"],"usage":"作谓语、补语；指漏洞非常多"},{"id":34195,"word":"破罐子破摔","pinyin":"pò guàn zǐ pò shuāi","abbr":"pgzps","explanation":"破罐子：比喻坏了贞操的女人或名声不好的人。比喻已经弄坏了的事就干脆不顾。","source":{"text":"娘们走了以后，好些年来，他自轻自贱，成了习惯，破罐子破摔，不想学好了。","book":"周立波《暴风骤雨》"},"example":{"text":"你不要有～的念头，要积极上进。"},"similar":["以滥为滥"],"usage":"作谓语、宾语、定语；指不负责任"},{"id":34196,"word":"破罐破摔","pinyin":"pò guàn pò shuāi","abbr":"pgps","explanation":"比喻有了缺点、错误或受到挫折以后，任其自流，不加改正，反而有意向更坏的方向发展。","source":{"text":"好些年来，他自轻自贱，成了习惯，破罐子破摔，不想学好了。","book":"周立波《暴风骤雨》第二部第十七章"},"example":{"text":"我真想～，自暴自弃，可是一想到您，我就又觉得不应该那样做。","book":"陶斯亮《一封终于发出的信》"},"similar":["破罐子破摔"],"usage":"作谓语、定语、宾语；指不负责任"},{"id":34197,"word":"破肝糜胃","pinyin":"pò gān mí wèi","abbr":"pgmw","explanation":"形容竭尽忠诚。","source":{"text":"形容竭尽忠诚。"},"similar":["披肝沥胆"],"usage":"作定语、状语；用于比喻句"},{"id":34198,"word":"破胆丧魂","pinyin":"pò dǎn sàng hún","abbr":"pdsh","explanation":"形容极其害怕。","source":{"text":"北齐张和思，断狱囚，无问善恶贵贱，必被枷锁杻械，困苦备极。囚徒见者，破胆丧魂，号生罗刹。","book":"宋·李昉《太平御览》卷一百十二六《张和思》"},"usage":"作谓语、定语；用于恐惧等"},{"id":34199,"word":"破胆寒心","pinyin":"pò dǎn hán xīn","abbr":"pdhx","explanation":"吓破了胆，心为之寒。形容非常担心害怕。","source":{"text":"臣永所以破胆寒心，豫言之累年。","book":"东汉·班固《汉书·谷永传》"},"example":{"text":"危言抵禁，～。","book":"唐·张说《词标文苑科策》"},"similar":["胆破心惊"],"usage":"作谓语、定语；指十分害怕"},{"id":34200,"word":"破脑刳心","pinyin":"pò nǎo kū xīn","abbr":"pnkx","explanation":"犹剖心沥血。比喻竭尽忠诚。","source":{"text":"既免刑诛，又获禄食，圣恩弘大，天地莫量，破脑刳心，岂足为谢。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"唐·韩愈《潮州刺史谢上表》：“既免刑诛，又获禄食，圣恩弘大，天地莫量，破脑刳心，岂足为谢。”"},"similar":["披肝沥胆"],"usage":"作谓语、宾语、定语；用于处事"},{"id":34201,"word":"破落户","pinyin":"pò luò hù","abbr":"plh","explanation":"指先前有钱有势而后败落的人家。也指这种人家的子弟。","source":{"text":"近令临安府收捕破落户，编置外州，本为民间除害，而所谓小火下者，乃为人诉其恐吓取钱，妄有供县，甚非为　除害之本意。","book":"宋·潜说友《咸淳临安志》"},"example":{"text":"只有酸枣门外退居廨宇后那片菜园时被营内军健们并门外那二十来个～侵害，纵放羊马，好生罗噪。","book":"明·施耐庵《水浒全传》第五回"},"usage":"作宾语、定语；用于口语"},{"id":34202,"word":"破衲疏羹","pinyin":"pò nà shū gēng","abbr":"pnsg","explanation":"破衣素食。形容生活简朴。","source":{"text":"嘉靖中，杨用修衣服起居穷极华洁；同时唐荆川破衲疏羹，垢敝不堪。","book":"明·沈德符《野获编·吏部·士大夫癖性》"},"opposite":["锦衣玉食"],"usage":"作宾语、定语；用于生活"},{"id":34203,"word":"破觚为圆","pinyin":"pò gū wéi yuán","abbr":"pgwy","explanation":"觚：方。毁方为圆。比喻去严刑而从简政。","source":{"text":"汉兴，破觚而为圜，斫雕而为朴，网漏于吞舟之鱼，而吏治烝烝，不至于奸，黎民艾安。","book":"《史记·酷吏列传》"},"example":{"text":"梁兴，～，斫雕为朴，教民以孝悌，劝之以农桑，于是桀黠化为由余，轻薄变为忠厚。","book":"《梁书·良吏传后序》"},"similar":["破觚为圜"],"usage":"作谓语、宾语；指治理国家"},{"id":34204,"word":"破觚为圆，斫雕为朴","pinyin":"pò gū wéi yuán，zhuó diāo wéi pǔ","abbr":"pgwyzdwp","explanation":"觚：方；斫：砍，削；雕：华丽；朴：朴实。去掉棱角，变成圆形；去掉雕饰，变为质朴。比喻去严刑而从简政，去浮华而返质朴。","source":{"text":"汉兴，破觚而为圜，斫雕而为朴，网漏于吞舟之鱼，而吏治烝烝，不至于奸，黎民艾安。","book":"《史记·酷吏列传》"},"example":{"text":"梁兴，～，教民以孝悌，劝之以农桑，于是桀黠化为由余，轻薄变为忠厚。","book":"《梁书·良吏传后序》"},"similar":["破觚斫雕"],"usage":"作宾语、定语、分句；用于书面语"},{"id":34205,"word":"破觚为圜","pinyin":"pò gū wéi yuán","abbr":"pgwy","explanation":"觚：主；圜：圆。毁方为圆。比喻去严刑而从简政。","source":{"text":"汉兴，破觚而为圜，斫雕而为朴，网漏于吞舟之鱼。","book":"西汉·司马迁《史记·酷吏传序》"},"example":{"text":"高祖反秦之政，～，谓除其严法，约三章耳。","book":"唐·司马贞《索隐》"},"similar":["破觚为圜，斫雕为朴"],"usage":"作谓语、宾语；指治理国家"},{"id":34206,"word":"破觚斫雕","pinyin":"pò gū zhuó diāo","abbr":"pgzd","explanation":"斫，大锄；引申为用刀、斧等砍。比喻删繁杂而从简易，去浮华而尚质朴。","source":{"text":"汉兴，破觚而为圜，斫雕而为朴。","book":"语出《史记·酷吏列传》"},"example":{"text":"语出《史记·酷吏列传》：“汉兴，破觚而为圜，斫雕而为朴。”"},"similar":["破觚为圆，斫雕为朴"],"usage":"作谓语、宾语；指治理国家"},{"id":34207,"word":"破釜沉舟","pinyin":"pò fǔ chén zhōu","abbr":"pfcz","explanation":"比喻下决心不顾一切地干到底。","source":{"text":"项羽乃悉引兵渡河，皆沉船，破釜甑，烧庐舍，持三日粮，以示士卒必死，无一还心。","book":"《史记·项羽本纪》"},"example":{"text":"只要我们有～的决心，就能克服学习上的各种困难。"},"similar":["义无反顾","背水一战","决一死战"],"opposite":["优柔寡断","瞻前顾后","举棋不定"],"usage":"作谓语、宾语、状语；形容做事的决心很大","story":["秦朝末年，秦王派大将章邯带20万大军进攻诸侯国赵国，赵王派人向楚王求援，楚王让宋义挂帅，项羽辅佐率军救援，宋义故意拖延时机，项羽杀了宋义并率军渡过漳水去援赵，他们把锅砸了，把船沉入江底，作生死决战，终于击败秦军"]},{"id":34208,"word":"破釜沉船","pinyin":"pò fǔ chén chuán","abbr":"pfcc","explanation":"破：打破；釜：锅；沉：击沉。比喻下定必死的决心，不顾一切地战斗到底。","source":{"text":"震撼精神，致心昄命，破釜沉船，以图自保于万一。","book":"梁启超《南学会叙》"},"similar":["破釜沉舟"],"opposite":["瞻前顾后"],"usage":"作谓语、宾语、状语；形容做事的决心很大"},{"id":34209,"word":"破釜焚舟","pinyin":"pò fǔ fén zhōu","abbr":"pffz","explanation":"犹破釜沉舟。比喻下决心不顾一切地干到底。","source":{"text":"帅与之深入诸侯之地，而发其机，焚舟破釜，若驱群羊。","book":"语出《孙子·九地》"},"example":{"text":"激起英雄，～，转败成功，试看他年烈烈轰轰。","book":"清·李渔《怜香伴·议迁》"},"similar":["破釜沉舟","破釜沉船"],"opposite":["举棋不定"],"usage":"作谓语、宾语、状语；形容做事的决心很大"},{"id":34210,"word":"破铜烂铁","pinyin":"pò tóng làn tiě","abbr":"ptlt","explanation":"①破旧锈烂无用的铜铁器。②泛指各种破旧无用的器物。","source":{"text":"买破铜烂铁，陈于地卖之。","book":"清·龚自珍《杭大宗逸事状》"},"example":{"text":"票子花够一河滩，啥也没置买个啥，就收了那么些～。","book":"王汶石《大木匠》"},"similar":["废铜烂铁"],"usage":"作主语、宾语、定语；指破旧的东西","story":["清朝时期，皇帝南巡，杭大宗前去迎驾被召见。皇帝问他靠什么生活？他说自己开旧货摊。皇帝问怎样开旧货摊？他回答是收一些破铜烂铁然后去卖掉。皇帝大笑，就亲笔书写“买卖破铜烂铁”六个大字赐给他作招牌"]},{"id":34211,"word":"破镜不重照","pinyin":"pò jìng bù chóng zhào","abbr":"pjbzz","explanation":"打碎的镜子不能再重新使用。比喻夫妻关系破裂，无法恢复。","source":{"text":"破镜不重照，落花难上枝。","book":"宋·释道原《景德传灯录》卷十七"}},{"id":34212,"word":"破镜分钗","pinyin":"pò jìng fēn chāi","abbr":"pjfc","explanation":"比喻夫妻分离。","source":{"text":"破镜重圆，分钗合钿，重寻绣户珠箔。","book":"宋·李致远《碧牡丹》词"},"example":{"text":"岂料如今，翻成做～，剩雨残云。","book":"明·胡文焕《群音类选·清腔类·好事近》"},"similar":["镜破钗分"],"opposite":["破镜重圆"],"usage":"作宾语、定语；用于夫妻、情侣等"},{"id":34213,"word":"破镜重合","pinyin":"pò jìng zhòng hé","abbr":"pjzh","explanation":"比喻夫妻失散或离婚后重新团聚。同“破镜重圆”。","source":{"text":"破镜重合，古有其事，若夫再娶而仍元配，妇再嫁而未失节，载籍以来，未之闻也。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"example":{"text":"清·纪昀《阅微草堂笔记·滦阳续录》：“～，古有其事，若夫再娶而仍元配，妇再嫁而未失节，载籍以来，未之闻也。”"},"similar":["破镜重圆","破镜重归"],"usage":"作谓语、宾语、定语；指重新团聚"},{"id":34214,"word":"破镜重圆","pinyin":"pò jìng chóng yuán","abbr":"pjcy","explanation":"比喻夫妻失散或离婚后重新团聚。","source":{"text":"唐·韦述《两京新记》卷三"},"example":{"text":"破镜重圆从古有，何须疑虑反生愁？","book":"元·施君美《幽闺记·推就红丝》"},"similar":["和好如初","言归于好"],"opposite":["覆水难收","一去不返"],"usage":"作谓语、宾语、定语；指重新团聚","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至长安，找到卖破镜的妻子，夫妻团聚"]},{"id":34215,"word":"破镜重归","pinyin":"pò jìng chóng guī","abbr":"pjzg","explanation":"比喻夫妻失散或决裂后重新团聚与和好。","source":{"text":"破镜重归，盟心不改，义实可嘉。","book":"清·蒲松龄《聊斋志异·细侯》"},"similar":["破镜重合","破镜重圆"],"usage":"作谓语、宾语、定语；指重新团聚"},{"id":34216,"word":"破门而入","pinyin":"pò mén ér rù","abbr":"pmer","explanation":"砸开门进去。多指盗贼行为。","source":{"text":"烛溪湖胡家，有群盗破门而入，见其家堂上有三四老人会饮。","book":"明·田艺蘅《留青日札·家神却盗》"},"example":{"text":"小偷～，偷走了值钱的物品。"},"opposite":["破门而出"],"usage":"作谓语、状语；指闯入他人住宅"},{"id":34217,"word":"破门而出","pinyin":"pò mén ér chū","abbr":"pmec","explanation":"把门砸破冲出来。形容坏人迫不及待地跳出来做坏事。也比喻摆脱束缚或限制。","source":{"text":"而你却开始‘破门而出’了，历史家，却来写戏。","book":"廖沫沙《“史”和“戏”》"},"example":{"text":"他～，离家出走。"},"similar":["夺门而出"],"opposite":["破门而入","蜂拥而入"],"usage":"作谓语；指出门"},{"id":34218,"word":"破除迷信","pinyin":"pò chú mí xìn","abbr":"pcmx","explanation":"原指从宗教迷信的束缚中解脱出来。现也指解放思想，扫除自卑感，树立敢想、敢说、敢干的新风格。","source":{"text":"要破除迷信。不论古代的也好，现代的也好。","book":"毛泽东《关于中华人民共和国宪法草案》"},"example":{"text":"我们要～，解放思想。"},"usage":"作谓语、宾语、定语；指消除迷信思想"},{"id":34219,"word":"破题儿","pinyin":"pò tí er","abbr":"pte","explanation":"旧时试帖诗及八股文形状用一两句话说破题目的要旨。比喻第一次做某件事。","source":{"text":"马儿迍迍的行，车儿快快的随，却告了相思回避，破题儿又早别离。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"私窝子潘三谋胠箧，～姚二宿勾栏。","book":"清·韩邦庆《海上花列传》第五十六回"},"similar":["破题儿头一遭","破题儿第一遭"],"usage":"作宾语；指第一次"},{"id":34220,"word":"破题儿头一遭","pinyin":"pò tí ér tóu yī zāo","abbr":"ptetyz","explanation":"破题：八股文的第一股；遭：次。比喻第一次做某件事或事情开头。","source":{"text":"一个堂堂督抚的女公子，跟着戏子逃跑，要首县办供给，已是破题儿头一遭。","book":"王浚卿《冷眼观》"},"similar":["破题儿","破题儿第一遭"],"usage":"作宾语；指第一次"},{"id":34221,"word":"破题儿第一遭","pinyin":"pò tí ér dì yī zāo","abbr":"ptedyz","explanation":"比喻第一次做某件事。","source":{"text":"马儿迍迍的行，车儿快快的随，却告了相思回避，破题儿又早别离。","book":"元·王实甫《西厢记》第四本第三折"},"example":{"text":"但把请安折子驳回去，这还是～，竟不知如何着笔？","book":"高阳《慈禧全传》七"},"similar":["破题儿头一遭"],"usage":"作宾语；指第一次"},{"id":34222,"word":"破颜一笑","pinyin":"pò yán yī xiào","abbr":"pyyx","explanation":"颜：面容。愁苦的神态一下子笑起来。","source":{"text":"那么，我也来‘破颜一笑’吧——哈！","book":"鲁迅《奇怪》"},"example":{"text":"慈禧太后转过身来，放眼遥望，一片锦绣江山，太平盛世的景象，不由得～。","book":"高阳《慈禧全传》八十九"},"usage":"作谓语、宾语；指破涕为笑"},{"id":34223,"word":"破颜微笑","pinyin":"pò yán wēi xiào","abbr":"pywx","explanation":"形容心领神会。","source":{"text":"尔时大梵天王即引若干眷属来奉献世尊于金婆罗华，各各顶礼佛足，退坐一面。尔时世尊即拈奉献金色婆罗华，瞬目扬眉，示诸大众，默然毋措。有迦叶破颜微笑。","book":"《大梵天王问佛决疑经》"},"example":{"text":"据禅宗历来传说，释迦牟尼在灵山会上说法，手拈金色波罗花遍示诸众，众人默然不语，只迦叶尊者～。","book":"金庸《天龙八部》第十章"},"usage":"作谓语、定语；用于书面语"},{"id":34224,"word":"破鼓乱人捶","pinyin":"pò gǔ luàn rén chuí","abbr":"pglrc","explanation":"比喻人失势受到大家的欺侮。","example":{"text":"好啊！～呀！等三爷把傻巴儿的辫子揪下来，就砸你的铺子！","book":"冯骥才《神鞭》四"},"usage":"作宾语、定语、分句；用于口语"},{"id":34225,"word":"砸锅卖铁","pinyin":"zá guō mài tiě","abbr":"zgmt","explanation":"砸了锅去卖废铁。表示穷极无聊，不留后路。也比喻把所的都拿出来了。","source":{"text":"老人家真当是儿媳妇有了喜，满街满巷奔告亲朋好友，说她只要抱上孙子，哪怕砸锅卖铁，典尽当光，也要请亲朋好友们吃一顿风风光光的喜酒。","book":"刘绍棠《蒲柳人家》八"},"example":{"text":"欠你的账，即使砸锅卖铁我也要给你还上。"},"usage":"作谓语、宾语；指变卖家产"},{"id":34226,"word":"砺世摩钝","pinyin":"lì shì mó dùn","abbr":"lsmd","explanation":"激励世俗，磨炼愚钝。同“砺世磨钝”。","source":{"text":"使天下之士能如庄周齐死生，一毁誉，轻富贵，安贫贱，则人主之名器爵禄，所以砺世摩钝者废矣。","book":"宋·苏轼《议学校贡举状》"},"similar":["砺世磨钝"],"usage":"作谓语、定语；指启蒙世人"},{"id":34227,"word":"砺世磨钝","pinyin":"lì shì mó dùn","abbr":"lsmd","explanation":"激励世俗，磨炼愚钝。","source":{"text":"爵禄者，天下之砥石，圣人所以砺世磨钝者也。","book":"宋·秦观《官制下》"},"example":{"text":"仰见我皇上右文之至意，～，鼓舞激劝。","book":"清·戴名世《序》"},"similar":["砺世摩钝"],"usage":"作谓语、定语；指启蒙世人"},{"id":34228,"word":"砺兵秣马","pinyin":"lì bīng mò mǎ","abbr":"lbmm","explanation":"砺：磨砺；兵：兵器；秣：喂。磨好兵器，喂饱马匹。指准备战斗。","source":{"text":"砺兵秣马，静看颉颃。群雄自乎声教，戈矛天下铿锵。","book":"明·朱元璋《皇陵碑》"},"similar":["厉兵秣马","砺戈秣马","励兵秣马"],"usage":"作谓语；指准备战斗"},{"id":34229,"word":"砺山带河","pinyin":"lì shān dài hé","abbr":"lsdh","explanation":"砺：磨刀石；山：泰山；带：衣带；河：黄河。黄河细得象条衣带，泰山小得象块磨刀石。比喻时间久远，任何动荡也决不变心。","source":{"text":"封爵之誓曰：‘使河如带，泰山若砺，国以永宁，爱及苗裔。’","book":"《史记·高祖功臣侯者年表》"},"example":{"text":"乃者袁逆世凯，谋叛民国，复兴帝制，黄屋大纛，遽兴非分之思，～，无复未寒之约。","book":"蔡东藩、许廑父《民国通俗演义》第五八回"},"similar":["砺带河山"],"usage":"作宾语、分句；比喻时间久远"},{"id":34230,"word":"砺岳盟河","pinyin":"lì yuè méng hé","abbr":"lymh","explanation":"比喻封爵与国共存，传之无穷。同“砺带河山”。","source":{"text":"夷凶戡难，尔既立于殊庸；砺岳盟河，予岂忘于丰报。","book":"宋·王禹偁《右卫上将军赠侍中宋公神道碑》"},"similar":["砺山带河"],"usage":"作宾语、分句；比喻时间久远"},{"id":34231,"word":"砺带河山","pinyin":"lì dài hé shān","abbr":"ldhs","explanation":"黄河细得像衣带，泰山小得像磨刀石。比喻封爵与国共存，传之无穷。","source":{"text":"封爵之誓曰：‘使河如带，泰山若厉，国以永宁，爰及苗裔。’","book":"西汉·司马迁《史记·高祖功臣侯者年表序》"},"example":{"text":"已闻帝王自有真，更说南阳多贵人，戈矛貔虎三千士，～十八臣。","book":"明·唐顺之《皇陵行》"},"similar":["砺山带河"],"usage":"作谓语、宾语；比喻封爵与国共存，传之无穷"},{"id":34232,"word":"砺戈秣马","pinyin":"lì gē mò mǎ","abbr":"lgmm","explanation":"磨戈喂马。比喻作好战斗准备。","source":{"text":"虽妖孽充斥，而备预甚严，宜砺戈秣马，击其不意，彼既无备，何攻不克？","book":"《旧唐书·刘仁轨传》"},"similar":["励兵秣马","厉兵秣马","砺兵秣马"],"usage":"作谓语；指准备战斗"},{"id":34233,"word":"础泣而雨","pinyin":"chǔ qì ér yǔ","abbr":"cqey","explanation":"柱子的基石泣湿了，就是要下雨的征候。比喻见到一点迹象，就能知道它的发展方向。","source":{"text":"月晕而风，础润而雨。","book":"宋·苏洵《辨奸论》"}},{"id":34234,"word":"础润而雨","pinyin":"chǔ rùn ér yǔ","abbr":"crey","explanation":"柱子的基石润湿了，就是要下雨的征候。比喻见到一点迹象，就能知道它的发展方向。","source":{"text":"山云蒸，柱础润。","book":"西汉·刘安《淮南子·说林训》"},"example":{"text":"事有必至，理有固然。惟天下之静者，乃能见微而知著。月晕而风，～，人人知之。","book":"宋·苏洵《辨奸论》"},"similar":["月晕而风"],"usage":"作宾语、定语；比喻从小事预测未来"},{"id":34235,"word":"硁硁之信","pinyin":"kēng kēng zhī xìn","abbr":"kkzx","explanation":"固执的信念。","source":{"text":"子击磬于卫，有荷蒉而过孔氏之门者，曰：‘有心哉，击磬乎！’既而曰：‘鄙哉！硁硁乎莫己知也，斯已而已矣。’","book":"《论语·宪问》"},"example":{"text":"相国之专，予所知也。主公犹执～，隐忍不言。","book":"明·冯梦龙《东周列国志》第六十六回"},"usage":"作宾语；指人很固执"},{"id":34236,"word":"硁硁之愚","pinyin":"kēng kēng zhī yú","abbr":"kkzy","explanation":"硁硁：浅陋而又固执的样子。坚持自己看法的谦词。","source":{"text":"子击磬于卫，有荷蒉而过孔氏之门者，曰：‘有心哉，击磬乎！’既而曰：‘鄙哉！硁硁乎莫己知也，斯已而已矣。’","book":"《论语·宪问》"},"similar":["硁硁之见"],"usage":"作主语、宾语；用于自谦"},{"id":34237,"word":"硁硁之见","pinyin":"kēng kēng zhī jiàn","abbr":"kkzj","explanation":"硁硁：浅陋而又固执的样子。坚持自己看法的谦词。","source":{"text":"子击磬于卫，有荷蒉而过孔氏之门者，曰：‘有心哉，击磬乎！’既而曰：‘鄙哉！硁硁乎！莫己知也，斯已而已矣。’","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"此仆平日～，如董生来，即以此言告之。","book":"清·袁枚《小仓山房尺牍》第21首"},"similar":["硁硁之愚"],"usage":"作主语、宾语；用于自谦"},{"id":34238,"word":"硎发新刃","pinyin":"xíng fā xīn rèn","abbr":"xfxr","explanation":"硎：磨刀石。象新磨的刀那样锋利。比喻刚参加工作就显露出出色的才干。","source":{"text":"是以十九年而刀刃若新发于硎。","book":"《庄子·养生主》"},"example":{"text":"赵侯旷世才，～初，十八取高第，姓名登石渠。","book":"清·查慎行《赵秋谷编修见示并门集辄题其后》"}},{"id":34239,"word":"硕大无朋","pinyin":"shuò dà wú péng","abbr":"sdwp","explanation":"硕：大；朋：比。大得没有可以与之相比的。形容极大。","source":{"text":"椒聊之实，蕃衍盈升。彼其之子，硕大无朋。","book":"《诗经·唐风·椒聊》"},"example":{"text":"这只南瓜重达２００余斤，真是～。"},"similar":["庞然大物","硕大无比"],"opposite":["小巧玲珑"],"usage":"作谓语、定语；用于物与物比较"},{"id":34240,"word":"硕大无比","pinyin":"shuò dà wú bǐ","abbr":"sdwb","explanation":"形容极大。同“硕大无朋”。","source":{"text":"下面的裤子也硕大无比，裤管总在地上磨擦着。","book":"曹禺《日出》第一幕"},"similar":["硕大无朋"],"opposite":["小巧玲珑"],"usage":"作谓语、定语；用于物与物比较"},{"id":34241,"word":"硕学通儒","pinyin":"shuò xué tōng rú","abbr":"sxtr","explanation":"儒：指读书人。学问渊博，通达事理的学者。","source":{"text":"弱冠游学都下，通儒硕学，必造门质疑，讨论无倦。","book":"《后汉书·杜林传》：“博洽多闻，时称通儒。”《南史·顾越传》"},"usage":"作宾语、定语；用于书面语"},{"id":34242,"word":"硕彦名儒","pinyin":"shuò yàn míng rú","abbr":"symr","explanation":"硕：大；彦：有才学的人；名：有名声的；儒：读书人。指非常有名气的大学者。","source":{"text":"公子好客，结多少硕彦名儒；相府开筵，常聚些布衣韦带。","book":"清·吴敬梓《儒林外史》第八回"},"usage":"作宾语、定语；用于书面语"},{"id":34243,"word":"硕望宿德","pinyin":"shuò wàng xiǔ dé","abbr":"swxd","explanation":"犹言德高望重。道德高尚，名望很大。","source":{"text":"净觉大师以硕望宿德为释子所宗，亦以上人为法器，俾出世于菩提律夺。","book":"明·宋濂《送用明上人还四明序》"},"similar":["德高望重"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":34244,"word":"硕果仅存","pinyin":"shuò guǒ jǐn cún","abbr":"sgjc","explanation":"唯一留存下来的大果子。比喻由于时间的推移，留存下来仅存的人或事物。","source":{"text":"上九，硕果不食。","book":"《易·剥》"},"example":{"text":"我只得随手把这个～的银角子交给他们。","book":"邹韬奋《经历·再被羁押》"},"similar":["九牛一毛","凤毛麟角"],"opposite":["多如牛毛","比比皆是"],"usage":"作定语；用于书面语"},{"id":34245,"word":"硕果独存","pinyin":"shuò guǒ dú cún","abbr":"sgdc","explanation":"唯一留存下来的大果子。比喻由于时间的推移，留存下来仅存的人或事物。","source":{"text":"上九，硕果不食。","book":"《周易·剥》"},"example":{"text":"今则曾未须臾，而生死聚敬，升沉显晦之变不可胜穷，而彭子获以～，岂非天哉。","book":"清·侯方域《彭容园文序》"}},{"id":34246,"word":"硕果累累","pinyin":"shuò guǒ lěi lěi","abbr":"sgll","explanation":"硕果：大的果实；累累：形容积累很多。指结的大的果实特别多。也比喻取得的优异成绩相当多。","example":{"text":"七百年来，子孙不息，人才辈出，历代科举，～。","book":"霍达《补天裂》第十三章"}},{"id":34247,"word":"硝云弹雨","pinyin":"xiāo yún dàn yǔ","abbr":"xydy","explanation":"硝烟如云，子弹像雨。形容激烈的战斗。","source":{"text":"然则岂待与西人相遇于硝云弹雨之中，而后知其胜败之数也？","book":"梁启超《论自治》"},"similar":["枪林弹雨"],"usage":"作宾语、定语；用于战争等"},{"id":34248,"word":"硝烟弥漫","pinyin":"xiāo yān mí màn","abbr":"xymm","explanation":"弥漫：充满。指战场上炮火充满了整个空间。","source":{"text":"掌子面炮声轰响，硝烟弥漫，成千上万的人二十四小时三班倒，轮番在地下作业。","book":"路遥《平凡的世界》第五卷第一章"},"example":{"text":"在那～的年代，想读书是太难了。"},"similar":["战火纷飞"],"usage":"作谓语、定语；指战场"},{"id":34249,"word":"硝烟弹雨","pinyin":"xiāo yān dàn yǔ","abbr":"xydy","explanation":"形容战场上非常紧张激烈的战斗。","source":{"text":"那些日军刚离了硝烟弹雨之中，倏进了酒绿灯红之境。","book":"曾朴《孽海花》第33回"},"example":{"text":"他光荣牺牲在～之中。"},"similar":["枪林弹雨","硝云弹雨"],"usage":"作宾语、定语；形容战争"},{"id":34250,"word":"硬撑门面","pinyin":"yìng chēng mén miàn","abbr":"ycmm","explanation":"装体面，假充上流。保持高等或中等阶级社会地位的风度、架子或门面。","example":{"text":"他家道凄凉还要～。"},"similar":["死要面子"],"usage":"作谓语、宾语；指面临着衰败的情况"},{"id":34251,"word":"硬着头皮","pinyin":"yìng zhe tóu pí","abbr":"yztp","explanation":"勉强去做难度较大的事。","source":{"text":"以后更难相处，只好硬着头皮，老着脸子，追踪前往，不管太后的款待如何，照旧的殷勤伺候。","book":"曾朴《孽海花》第27回"},"example":{"text":"他～去见老板。"},"usage":"作宾语、状语；指无奈"},{"id":34252,"word":"硬语盘空","pinyin":"yìng yǔ pán kōng","abbr":"yypk","explanation":"硬：遒劲有力的语句；盘：盘旋。遒劲有力的语文盘旋在天空中。形容文章的气势雄伟，矫健有力。","source":{"text":"横空盘硬语，妥贴力排奡。","book":"唐·韩愈《荐士》诗"},"example":{"text":"舌富贵千钧如发，～论语来听？记当时，只有西窗月。","book":"宋·辛弃疾《贺新郎·同父见和再用韵答之》"},"usage":"作谓语、定语；形容文章"},{"id":34253,"word":"硬门槛子","pinyin":"yìng mén kǎn zǐ","abbr":"ymkz","explanation":"比喻不易克服的困难。","example":{"text":"我碰上了这个～。"},"usage":"作宾语、定语；指困难"},{"id":34254,"word":"硬骨头","pinyin":"yìng gǔ tóu","abbr":"ygt","explanation":"坚强不屈，毫不让步的人。","source":{"text":"我原以为你是个正视现实眼睛眨也不眨的硬骨头。","book":"王朔《人莫予毒》"},"example":{"text":"他就是典型的～，十分难对付。"},"similar":["硬汉子"],"usage":"作宾语、定语；用于口语"},{"id":34255,"word":"确乎不拔","pinyin":"què hū bù bá","abbr":"qhbb","explanation":"刚强坚决，不可动摇。","source":{"text":"确乎其不可拔。","book":"《周易·乾》"},"example":{"text":"不以富贵妨其道，不以隐约易其心，～，浩然自守。","book":"唐·韩愈《颜子不贰过论》"},"similar":["确固不拔"],"usage":"作谓语；指不可动摇"},{"id":34256,"word":"确凿不移","pinyin":"què záo bù yí","abbr":"qzby","explanation":"确实可靠，不容怀疑。","source":{"text":"‘诗经’上这两句我还记得，是‘我送舅氏，曰至渭阳’。如今用这个典故，可称确切不移。","book":"清·李宝嘉《官场现形记》第四十二回"},"example":{"text":"虚心使人进步，骄傲使人落后，这是～的真理。"},"similar":["千真万确","天经地义"],"opposite":["捕风捉影","荒诞不经"],"usage":"作谓语、定语、状语；指确实可靠"},{"id":34257,"word":"确切不移","pinyin":"què qiè bù yí","abbr":"qqby","explanation":"形容真实可靠，不容怀疑。","source":{"text":"‘诗经’上这两句我还记得，是‘我送舅氏，曰至渭阳’。如今用这个典故，可称确切不移。","book":"清·李宝嘉《官场现形记》第四十二回"},"example":{"text":"了那一顿西菜出的考语，自然是～的了。","book":"清·吴趼人《二十年目睹之怪现状》第七十八回"}},{"id":34258,"word":"确固不拔","pinyin":"què gù bù bá","abbr":"qgbb","explanation":"刚强坚决，不可动摇。同“确乎不拔”。","source":{"text":"因他们都有确固不拔的自信，所以决不会理会偶像保护者的嘲骂。","book":"鲁迅《热风·随感录四十六》"},"similar":["确乎不拔"],"usage":"作谓语、定语；指不可动摇"},{"id":34259,"word":"确然不群","pinyin":"què rán bù qún","abbr":"qrbq","explanation":"指坚守志操，不同流俗。","source":{"text":"少而修德雅正，确然不群。","book":"晋·张方《楚国先贤传》"},"usage":"作谓语、定语；用于人"},{"id":34260,"word":"确确实实","pinyin":"què què shí shí","abbr":"qqss","explanation":"确切信实，的的确确。","source":{"text":"现在不但对于和平谈判毫无建树，而且确确实实地是在不断地节外生枝。","book":"毛泽东《中共发言人关于和平条件必须包括惩办日本战犯和国民党战犯的声明》"},"example":{"text":"我们自己也～需要一个和平的环境。","book":"邓小平《目前的形势和任务》"},"similar":["切切实实"],"usage":"作定语、状语；用于加强语气等"},{"id":34261,"word":"碌碌寡合","pinyin":"lù lù guǎ hé","abbr":"llgh","explanation":"形容性情孤僻，与人合不来。","source":{"text":"其系善良，只因碌碌寡合，以致结保无人。","book":"清·林则徐《札各学教官严查生员有无吸烟造册互保》"},"similar":["落落寡合"],"opposite":["同舟共济"],"usage":"作谓语、定语；指人性情孤僻"},{"id":34262,"word":"碌碌庸庸","pinyin":"lù lù yōng yōng","abbr":"llyy","explanation":"碌碌：辛苦，繁忙；庸庸：平庸。指平庸而忙碌的人或平庸的生活方式。","source":{"text":"碌碌：辛苦，繁忙；庸庸：平庸。指平庸而忙碌的人或平庸的生活方式。"},"similar":["庸庸碌碌"],"opposite":["大有作为"],"usage":"作谓语、定语、状语；指平庸的人"},{"id":34263,"word":"碌碌庸才","pinyin":"lù lù yōng cái","abbr":"llyc","explanation":"碌碌：平庸的样子。形容才能平庸。","source":{"text":"汝碌碌庸才，非经济之具，不可滥厕冠裳也。","book":"明·冯梦龙《东周列国志》第五十四回"},"example":{"text":"肃～，误蒙公瑾重荐，其实不称所职，愿举一人以助主公。","book":"明·罗贯中《三国演义》第五十七回"},"similar":["碌碌庸流"],"usage":"作宾语、定语；指平庸的人"},{"id":34264,"word":"碌碌庸流","pinyin":"lù lù yōng liú","abbr":"llyl","explanation":"碌碌：平庸的样子。指才能平庸无能之辈。","source":{"text":"遍观都下从事，皆碌碌庸流，琐琐凡辈。","book":"明·吾邱瑞《运甓记》"},"similar":["碌碌庸才"],"usage":"作宾语、定语；指平庸的人"},{"id":34265,"word":"碌碌无为","pinyin":"lù lù wú wéi","abbr":"llww","explanation":"平平庸庸，无所作为。","source":{"text":"我早就这样想：与其碌碌无为地混这一生，不如壮烈去死！","book":"杨沫《青春之歌》第一部第21章"},"example":{"text":"几十年来，虽然不能说完全～，但是回忆起进城之前，见到那些老战士时心里曾经涌起的感情。","book":"秦牧《序》"},"similar":["碌碌无能","无所作为"],"opposite":["大有可为","大显身手","大有作为"],"usage":"作谓语、宾语；指人平庸"},{"id":34266,"word":"碌碌无奇","pinyin":"lù lù wú qí","abbr":"llwq","explanation":"平凡，无特殊才能。","source":{"text":"但闻负天下之大名，心有高天下之大才，方足以当之。若碌碌无奇，未免取天下之笑。","book":"《平山冷燕》第十八回"},"example":{"text":"《平山冷燕》第十八回：“但闻负天下之大名，心有高天下之大才，方足以当之。若碌碌无奇，未免取天下之笑。”"},"similar":["碌碌无才"],"usage":"作谓语、定语；多用于人","story":["战国时期，赵国平原君要向楚王求救兵，想带二十名门客，只得十九名，毛遂自荐参加，在与楚王谈判陷于僵局时，毛遂按剑上前，迫使楚王立誓与赵国联合抗秦。事后毛遂讥笑同去的那些门客庸庸碌碌，靠别人才办成事"]},{"id":34267,"word":"碌碌无才","pinyin":"lù lù wú cái","abbr":"llwc","explanation":"碌碌：平庸、无能的。形容人平平庸庸，没有能力。","source":{"text":"上书昭王，切而不迫；君臣纵谈，观得色变，此岂碌碌无能之人？","book":"《史记·平原君虞卿列传》：“公等録録（碌碌），所谓因人成事者也。”宋·吴箕《常谈》卷八"},"example":{"text":"瑜～，诚不足数。","book":"明·朱之瑜《上长崎镇巡揭》"}},{"id":34268,"word":"碌碌无能","pinyin":"lù lù wú néng","abbr":"llwn","explanation":"碌碌：平庸、无能的。平平庸庸，没有能力。","source":{"text":"上书昭王，切而不迫；君臣纵谈，观者色变，此岂碌碌无能之人？","book":"宋·吴箕《常说》"},"example":{"text":"宋·吴箕《常说》：“上书昭王，切而不迫；君臣纵谈，观者色变，此岂碌碌无能之人？”"},"similar":["碌碌无为","无所作为"],"opposite":["大有可为","大显身手"],"usage":"作谓语、宾语；指人平庸"},{"id":34269,"word":"碌碌无闻","pinyin":"lù lù wú wén","abbr":"llww","explanation":"碌碌：平庸的样子。形容人平平庸庸，没有名望。","source":{"text":"君以诸生崛兴，名动海内，其视碌碌无闻而殁者，亦可以无憾。","book":"宋·秦观《李状元墓铭》"},"example":{"text":"我不想成为～的人。"},"similar":["默默无闻"],"opposite":["赫赫有名"],"usage":"作谓语、定语；指没有名望"},{"id":34270,"word":"碌碌终身","pinyin":"lù lù zhōng shēn","abbr":"llzs","explanation":"碌碌：平庸。一辈子庸庸碌碌，没有成就。","source":{"text":"修之于家而献之于国者，又未知其何若也，微论碌碌终身，纵一旦博青紫，苟富贵，驰骋当路，嚣然得志于时者之所为。","book":"《韩山书院碑记》"},"example":{"text":"逗留在他记忆里的是那些～、默默无闻的艺术家，或筵前卖笑的妓女，戏院里卖糖的孩子。","book":"杨逄《读〈柯灵选集〉》"}},{"id":34271,"word":"碍上碍下","pinyin":"ài shàng ài xià","abbr":"asax","explanation":"碍：妨碍。妨碍做事，使人感到不方便。","example":{"text":"请不要在这儿～的，影响我们的工作。"},"similar":["碍手碍脚"],"usage":"作谓语、定语；用于影响行动"},{"id":34272,"word":"碍口识羞","pinyin":"ài kǒu shí xiū","abbr":"aksx","explanation":"碍口：说不出口。指怕羞而不说话。","source":{"text":"文若虚终是碍口识羞，待说又止。","book":"明·凌濛初《初刻拍案惊奇·转运汉巧遇洞庭红》"},"example":{"text":"这事关系你终身，肯与不肯，明白说出，莫要～，两相耽误。","book":"《石点头·潘文子契合鸳鸯冢》"},"similar":["爱口识羞"],"usage":"作谓语、补语；指怕羞"},{"id":34273,"word":"碍手碍脚","pinyin":"ài shǒu ài jiǎo","abbr":"asaj","explanation":"碍：阻碍。妨碍别人做事。","source":{"text":"后边有些嫌忌起来，碍手碍脚，到底不妙。","book":"明·凌濛初《初刻拍案惊奇》第三十二卷"},"example":{"text":"宝钗因说道：“咱们别在这里～。”说着，和宝玉等便往迎春房中来。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["触手碍脚"],"opposite":["顺顺当当"],"usage":"作谓语、定语；形容影响他人做事"},{"id":34274,"word":"碍足碍手","pinyin":"ài zú ài shǒu","abbr":"azas","explanation":"碍：阻碍。妨碍别人做事。同“碍手碍脚”。","example":{"text":"如果你不想好好干的话，就别在这儿～。"},"similar":["碍手碍脚"],"usage":"作谓语、定语；形容影响他人做事"},{"id":34275,"word":"碍难从命","pinyin":"ài nán cóng mìng","abbr":"ancm","explanation":"碍：妨碍；从：听从。由于有所妨碍，难以遵从吩咐，是委婉拒绝对方要求的话。","source":{"text":"你回去复李大官人，本当将时迁放回，怎奈他是梁山贼党，碍难从命。","book":"《三打祝家庄》第一幕第一场"},"example":{"text":"请原谅我～。"},"similar":["碍难遵命"],"usage":"作谓语；委婉拒绝对方要求的话"},{"id":34276,"word":"碍难遵命","pinyin":"ài nán zūn mìng","abbr":"anzm","explanation":"碍：妨碍；遵：遵从。由于有所妨碍，难以遵从命令或吩咐。","source":{"text":"防务吃紧，兵不敷用，职守所在，碍难遵命。","book":"蔡东藩《民国通俗演义》第64回"},"example":{"text":"请恕我～。"},"similar":["碍难从命"],"usage":"作谓语；委婉拒绝对方要求的话"},{"id":34277,"word":"碎尸万段","pinyin":"suì shī wàn duàn","abbr":"sswd","explanation":"极言对罪大恶极者予以严厉的惩罚。","source":{"text":"我若拿住你时，碎尸万段，骨肉为泥。","book":"明·施耐庵《水浒传》第119回"},"example":{"text":"我恨不得把你～。"},"similar":["千刀万剐"],"usage":"作谓语、定语；指严厉的惩罚"},{"id":34278,"word":"碎心裂胆","pinyin":"suì xīn liè dǎn","abbr":"sxld","explanation":"形容异常恐惧。","source":{"text":"仗臣平生所学，排上南天七十二阵，宋之君臣，必茫然莫知，将碎心裂胆，无计所出矣。","book":"《四游记·萧后吕客谈兵》"},"similar":["胆战心惊"],"usage":"作谓语、状语；用于书面语"},{"id":34279,"word":"碎玉零玑","pinyin":"suì yù líng jī","abbr":"sylj","explanation":"比喻精美简短的诗文。","source":{"text":"当时汪柳门吴清卿等诸名士，时时自苏来常，诗酒流连，吟余醉后，碎玉零玑，文壁绮窗，墨痕狼藉。","book":"燕谷老人《续孽海花》楔子"},"usage":"作宾语、定语；多用于比喻句"},{"id":34280,"word":"碎琼乱玉","pinyin":"suì qióng luàn yù","abbr":"sqly","explanation":"指雪花。","source":{"text":"雪地里踏着碎琼乱玉，迤逦背着北风而行。","book":"明·施耐庵《水浒传》第十回"},"example":{"text":"天上飘下～，大地瞬间披上素妆。"},"usage":"作主语、宾语、定语；指雪花"},{"id":34281,"word":"碎瓦颓垣","pinyin":"suì wǎ tuí yuán","abbr":"swty","explanation":"形容残破、毁废的建筑。","source":{"text":"是故碎瓦颓垣，昔日之歌楼舞馆也；荒榛断梗，昔日之琼蕤玉树也。","book":"《郁离子·治国篇》"},"similar":["颓垣碎瓦","残垣断壁"],"usage":"作宾语、定语；用于战后或灾后"},{"id":34282,"word":"碎身粉骨","pinyin":"suì shēn fěn gǔ","abbr":"ssfg","explanation":"身体粉碎。指死亡。多指为某种目的而献身。","source":{"text":"暂愿不为（违）于说者，碎身粉骨效驱驰。","book":"《敦煌变文集·妙法莲华经讲经文》"},"example":{"text":"北苑研膏，方圭圆璧，万里名动京关，～，功合上凌烟。","book":"宋·秦观《满庭芳·咏茶》词"},"similar":["碎骨粉身","粉身碎骨"],"usage":"作谓语、定语、状语、宾语；用于处事"},{"id":34283,"word":"碎身糜躯","pinyin":"suì shēn mí qū","abbr":"ssmq","explanation":"犹碎首糜躯。多指为某种目的而献身。","source":{"text":"人谓豫让曰：子不死中行，而反事其仇，何无耻之甚也？今必碎身糜躯，以为智伯，何其与前异也？","book":"汉·贾谊《新书·谕诚》"},"similar":["粉身碎骨"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":34284,"word":"碎首糜躯","pinyin":"suì shǒu mǐ qū","abbr":"ssmq","explanation":"头颅粉碎，身躯糜烂。旧时臣下报效皇上，多用此语。","source":{"text":"三月之中，充历三台，光荣昭显，非臣愚蔽不才所当盗窃，非臣碎首糜躯所能补报。","book":"汉·蔡邕《让尚书乞民闲冗表》"},"example":{"text":"宋·王禹偁《为宰臣上尊号表》：“跼天蹐地，罔敢自安；～，期于必遂。”"},"similar":["粉身碎骨","碎首縻躯"],"usage":"作谓语、宾语、定语；多用于发誓"},{"id":34285,"word":"碎首縻躯","pinyin":"suì shǒu mí qū","abbr":"ssmq","explanation":"犹言粉身碎骨。多指为某种目的而献身。同“碎首糜躯”。","source":{"text":"碎首縻躯，万一冀伸于臣节。","book":"宋·王禹偁《又谢恩表》"},"similar":["碎首糜躯"],"usage":"作谓语、宾语、定语；多用于发誓"},{"id":34286,"word":"碎骨粉尸","pinyin":"suì gǔ fěn shī","abbr":"sgfs","explanation":"比喻把事物彻底打碎、摧毁。","source":{"text":"八十年前腐朽的中国，用浓黑的幕布迎接了您，哪知道迎来的是这样一位巨人，他将挥起铁拳把旧世界打个碎骨粉尸。","book":"《诗刊》1978年第3期"},"similar":["粉身碎骨"],"usage":"作定语、状语；用于处事"},{"id":34287,"word":"碎骨粉身","pinyin":"suì gǔ fěn shēn","abbr":"sgfs","explanation":"指死亡。多指为某种目的而献身。同“碎身粉骨”。","source":{"text":"崇黑虎大怒骂曰：‘好匹夫！苏护违犯天条，有碎骨粉身之祸；你皆是反贼逆党，敢如此大胆，妄出狂言。’","book":"明·许仲琳《封神演义》第三回"},"example":{"text":"夫人遇妾，谊逾所生，常恨～，不足为报。（清·徐瑶《太恨生传》）"},"similar":["粉身碎骨","碎身粉骨"],"usage":"作谓语、定语、状语、宾语；用于处事"},{"id":34288,"word":"碔砆混玉","pinyin":"zhì fū hùn yù","abbr":"wfhy","explanation":"比喻以假乱真，似是实非。"},{"id":34289,"word":"碧波滚滚","pinyin":"bì bō gǔn gǔn","abbr":"bbgg","explanation":"碧波：碧绿的波涛。滚滚：形容汹涌澎湃之势。碧绿的波涛滚滚而来，汹涌澎湃。","example":{"text":"我站在甲板上眺望，只见～，一望无际。"}},{"id":34290,"word":"碧波荡漾","pinyin":"bì bō dàng yàng","abbr":"bbdy","explanation":"碧：青绿色。青绿色的波浪起伏不定。","source":{"text":"灿烂的阳光，美丽的野花，碧波荡漾的原西河，凹凸不平的石板街……","book":"路遥《平凡的世界》第四卷第49章"},"usage":"作谓语、定语；用于描写水"},{"id":34291,"word":"碧海青天","pinyin":"bì hǎi qīng tiān","abbr":"bhqt","explanation":"原是形容嫦娥在广寒宫夜夜看着空阔的碧海青天，心情孤寂凄凉。后比喻女子对爱情的坚贞。","source":{"text":"嫦娥应悔偷灵药，碧海青天夜夜心。","book":"唐·李商隐《嫦娥》"},"example":{"text":"次句写牛渚夜景，大处落墨，展现出一片碧海青天、万里无云的境界。","book":"《唐诗鉴赏·夜泊牛渚怀古》"},"opposite":["碧海兰天"],"usage":"作宾语；形容夜色"},{"id":34292,"word":"碧瓦朱檐","pinyin":"bì wǎ zhū yán","abbr":"bwzy","explanation":"碧瓦：青绿色的瓦；檐：屋檐。青色的瓦，红色的檐。形容建筑的华美。","source":{"text":"雕梁画栋，碧瓦朱檐。","book":"明·施耐庵《水浒传》第74回"},"similar":["碧瓦朱甍"],"usage":"作宾语、定语；用于书面语"},{"id":34293,"word":"碧瓦朱甍","pinyin":"bì wǎ zhū méng","abbr":"bwzm","explanation":"甍：屋脊。形容建筑物的华丽美观。","source":{"text":"孤城西北起高楼，碧瓦朱甍照城郭。","book":"唐·杜甫《越王楼歌》"},"example":{"text":"光闪闪贝阙珠宫，齐臻臻～。","book":"元·王子一《误入桃源》第一折"},"similar":["碧瓦朱檐"],"usage":"作宾语、定语；指建筑物"},{"id":34294,"word":"碧空万里","pinyin":"bì kōng wàn lǐ","abbr":"bkwl","explanation":"万里：指面积大，距离长。形容天气晴朗。","source":{"text":"冰峰林立，白云徜徉其间；碧空万里，与皑皑白雪上下辉映，幻化流转着七彩光芒。","book":"权延赤《走下圣坛的周恩来·休息与娱乐》"},"example":{"text":"二百万年前的一天，～无云，太阳炙烤着大地。","book":"《黄河象》"},"similar":["晴空万里"],"opposite":["乌云密布"],"usage":"作谓语、定语；指晴朗天气"},{"id":34295,"word":"碧空如洗","pinyin":"bì kōng rú xǐ","abbr":"bkrx","explanation":"碧空：浅蓝色的天空。蓝色的天空明净得像洗过一样。形容天气晴朗。","source":{"text":"万里碧空如洗，寒浸十分明月，帘卷玉波流。","book":"宋·张元干《水调歌头》词"},"example":{"text":"其时～，有一群大雁鹅正排成人字从高空中飞过。","book":"沈从文《长河·秋（动中有静）》"},"similar":["晴空如洗","碧空万里"],"opposite":["乌云密布"],"usage":"作谓语、状语；用于天气等"},{"id":34296,"word":"碧草如茵","pinyin":"bì cǎo rú yīn","abbr":"bcry","explanation":"绿油油的草好像地上铺的褥子。常指可供临时休憩的草地。","source":{"text":"须拚醉，回首夕阳流水，碧草如茵。","book":"宋·黄载《昼锦堂》词"},"example":{"text":"环湖四顾，这儿花木繁茂，～，是个休闲渡假的好地方。"}},{"id":34297,"word":"碧草舅茵","pinyin":"bì cǎo rú yīn","abbr":"bcjy","explanation":"绿油油的草好像地上铺着的褥子。常指可供临时休息的的草地。","source":{"text":"早晚高台共同醉，绿萝如帐草舅茵。","book":"唐·许浑《移摄太平寄前李明府》"},"example":{"text":"须拚醉，回首夕阳流水，～。","book":"宋·黄载《昼锦堂·牡丹》词"}},{"id":34298,"word":"碧落黄泉","pinyin":"bì luò huáng quán","abbr":"blhq","explanation":"碧落：天上、天界。黄泉：地下。天上和地下。泛指宇宙的各个角落。","source":{"text":"上穷碧落下黄泉，两处茫茫皆不见。","book":"唐·白居易《长恨歌》"},"example":{"text":"荷君王不弃，念切思专，～为奴寻遍。","book":"清·洪昇《长生殿·重圆》"},"similar":["天上地下"],"usage":"作宾语、定语；形容范围很广"},{"id":34299,"word":"碧血丹心","pinyin":"bì xuè dān xīn","abbr":"bxdx","explanation":"满腔正义的热血，一颗赤诚的红心。形容十分忠诚坚定。","source":{"text":"苌弘死于蜀，藏其血，三年而化为碧。","book":"《庄子·外物》"},"example":{"text":"南来未尽支天策，～留片石。","book":"清·丘逢甲《和平里行》"},"similar":["赤胆忠心","披肝沥胆","赤子之心"],"opposite":["叵测之心","包藏祸心","背信弃义"],"usage":"作谓语、宾语；形容为正义事业而牺牲的烈士","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他被杀的当时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":34300,"word":"碧鬟红袖","pinyin":"bì huán hóng xiù","abbr":"bhhx","explanation":"指代年轻貌美的女子。"},{"id":34301,"word":"碰一鼻子灰","pinyin":"pèng yī bí zǐ huī","abbr":"pybzh","explanation":"想讨好而结果落个没趣。","source":{"text":"你们可能碰一鼻子灰，或者对你们提出的问题不重视，或者对问题见解不同。","book":"邓小平《关于西南少数民族问题》"},"example":{"text":"他在凤姐那里～，只好悻悻而回。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":34302,"word":"碰钉子","pinyin":"pèng dìng zǐ","abbr":"pdz","explanation":"指遭到拒绝。","source":{"text":"何况给别人说话，怎么好冒冒昧昧的去碰钉子？","book":"清·吴趼人《二十年目睹之怪现状》第八回"},"example":{"text":"他连日奔波募款，却四处～，深感懊恼沮丧。"},"usage":"作谓语、定语、宾语；用于做事等"},{"id":34303,"word":"磇硄混玉","pinyin":"zhì fū hùn yù","abbr":"zfhy","explanation":"比喻以假乱真，似是实非。"},{"id":34304,"word":"磊浪不羁","pinyin":"lěi làng bù jī","abbr":"llbj","explanation":"形容胸怀坦荡，举止不受约束。同“磊落不羁”。","source":{"text":"工诗，性磊浪不羁，爱奇务险，远出常性之外。","book":"元·辛文房《唐才子传·王季友》"},"similar":["放浪不羁"],"opposite":["循规蹈矩"],"usage":"作定语、宾语；指行为放纵"},{"id":34305,"word":"磊瑰不羁","pinyin":"lěi guī bù jī","abbr":"lgbj","explanation":"形容胸怀坦荡，举止不受约束。","source":{"text":"退而从磊瑰不羁之士，接杯酒之欢，笑歌起舞，往往自以为一世之雄。","book":"宋·陈亮《祭薛士隆知府文》"},"similar":["磊落不羁"],"usage":"作谓语、定语；指人豪放不羁"},{"id":34306,"word":"磊磊落落","pinyin":"lěi lěi luò luò","abbr":"llll","explanation":"一一分明的样子。也形容胸怀坦荡。","source":{"text":"大丈夫行事，磊磊落落，如日月皎然。","book":"《晋书·石勒载记下》"},"example":{"text":"腷腷膊膊鸡初鸣，～向曙星。","book":"元·左克明《古乐府·两头纤纤诗》"},"similar":["光明磊落"],"usage":"作谓语、定语；指人光明正大"},{"id":34307,"word":"磊落不凡","pinyin":"lěi luò bù fán","abbr":"llbf","explanation":"心胸坦荡，不同凡响。","source":{"text":"及与语，磊落不凡，问其姓，乃王琚也。","book":"《太平广记·杂录二·王琚》"},"example":{"text":"老爷主意甚好。小的们也看这长老～，若为此寺住持，决替朝廷出力，老爷必定高升。","book":"明·方汝浩《禅真逸史》第三回"},"usage":"作谓语、定语；用于夸奖人"},{"id":34308,"word":"磊落不羁","pinyin":"lěi luò bù jī","abbr":"llbj","explanation":"形容胸怀坦荡，举止不受约束。","source":{"text":"不泥于古，不牵于今，非有苛碎难知之文，将观磊落不羁之士，使天下知文章诚可以致治。","book":"宋·苏轼《及第后谢秋赋试官启》"},"example":{"text":"今夫天下～之人，雅量高致之士，于世间之嗜好一切不以屑意，而其性情必有所寄托，未有泊然颓然绝无所寓意者也。","book":"清·戴名世《曹氏怪石记》"},"similar":["磊浪不羁"],"usage":"作谓语、定语；用于人的性格"},{"id":34309,"word":"磊落光明","pinyin":"lěi luò guāng míng","abbr":"llgm","explanation":"襟怀坦白，光明正大。","source":{"text":"绸缪庶务，数进谠言，迹其居心行已，磊落光明，刚言鲠亮，有古大臣节概。","book":"《明史·王恕马文升刘大夏传赞》"},"example":{"text":"自问～，未有行差半点，夫人严拷重打，只为一首诗篇。","book":"粤剧《搜书院》第二场"},"similar":["光明磊落"],"opposite":["阴谋诡计"],"usage":"作谓语、定语、状语；指人很正直"},{"id":34310,"word":"磊落奇伟","pinyin":"lěi luò qí wěi","abbr":"llqw　","explanation":"磊落：心地光明；奇伟：奇特伟大。形容人心地光明，品德高尚。","source":{"text":"世之龊者既不足以语之，磊落奇伟之人又不能听焉，则信乎命之穷也。","book":"唐·韩愈《与于襄阳书》"},"usage":"作谓语、定语；用于书面语"},{"id":34311,"word":"磊落豪横","pinyin":"lěi luò háo héng","abbr":"llhh","explanation":"形容言辞明快而奔放自如。","source":{"text":"其实《石鼓歌》等杰作，何尝有一语奥涩，而磊落豪横，自然挫笼万有。","book":"清·赵翼《瓯北诗话·韩昌黎诗》"},"usage":"作谓语、定语；用于书面语"},{"id":34312,"word":"磊落跌荡","pinyin":"lěi luò diē dàng","abbr":"lldd","explanation":"磊落：形容胸怀坦白；跌荡：超然而无所拘忌。胸怀坦白，行为无所拘忌。","source":{"text":"英雄豪悍之士，磊落跌荡，出于法度之外，为君者亦当度外待之。","book":"宋·吕祖谦《东莱博议》第一卷"},"usage":"作谓语、定语；用于为人"},{"id":34313,"word":"磊落轶荡","pinyin":"lěi luò yì dàng","abbr":"llyd","explanation":"轶荡：旷达。心胸坦白，行为无所拘忌。","source":{"text":"英雄豪悍之士，磊落轶荡，出于法度之外，为君者亦当以度外待之。","book":"宋·吕祖谦《东莱博议》卷一"}},{"id":34314,"word":"磊落飒爽","pinyin":"lěi luò sà shuǎng","abbr":"llss","explanation":"形容人豪迈开朗。","source":{"text":"不然，以磊落飒爽之袁督师，而何以自危至是。","book":"梁启超《袁崇焕传》第七节"},"usage":"作谓语、定语；用于书面语"},{"id":34315,"word":"磐石之固","pinyin":"pán shí zhī gù","abbr":"pszg","explanation":"磐石：巨石。比喻坚固不可动摇。","source":{"text":"为名者否，为利者否，为忿者否，则国安于磐石，筹于旗翼。","book":"《荀子·富国》"},"example":{"text":"清·褚人获《隋唐演义》第37回：“又着朱贵儿迁在宝林院去一同抚养赵王，自以为～。”"},"similar":["磐石之安"],"usage":"作宾语；指十分坚固"},{"id":34316,"word":"磐石之安","pinyin":"pán shí zhī ān","abbr":"psza","explanation":"磐石：巨石。象巨石那样的稳固。形容极其稳固。","source":{"text":"为名者否，为利者否，为忿者否，则国安于磐石，筹于旗翼。","book":"《荀子·富国》"},"example":{"text":"某有一计，令西蜀之兵不犯东吴，荆州如～。","book":"明·罗贯中《三国演义》第七十七回"},"similar":["盘石之安","盘石之固"],"usage":"作宾语；形容极其安定稳固"},{"id":34317,"word":"磕头如捣","pinyin":"kē tóu rú dǎo","abbr":"ktrd","explanation":"磕头：跪在地上头碰地。捣：捶打。磕头快得像捶打东西一样。","source":{"text":"可汗磕头如捣蒜的说道：‘我等肉眼凡夫，不知天使系何等神佛。’","book":"清·夏敬渠《野叟曝言》第114回"},"example":{"text":"他～蒜，一味求饶。"},"similar":["磕头如捣蒜"],"usage":"作谓语、状语；形容求饶的样子"},{"id":34318,"word":"磕头如捣蒜","pinyin":"kē tóu rú dǎo suàn","abbr":"ktrds","explanation":"磕头如同蒜锤捣蒜那么快。形容求饶的狼狈相。","source":{"text":"可汗磕头如捣蒜的说道：‘我等肉眼凡夫，不知天使系何等神佛。’","book":"清·夏敬渠《野叟曝言》"},"example":{"text":"他吓得～般地求饶。"},"similar":["磕头如捣"],"usage":"作谓语、状语；形容求饶的样子"},{"id":34319,"word":"磕头撞脑","pinyin":"kē tóu zhuàng nǎo","abbr":"ktzn","explanation":"磕、撞：碰。跑在地上叩头行礼。也指用头顶撞他人，表明不肯善罢干休。也形容由于人多，人与人之间相互拥挤碰撞。","source":{"text":"自家扬州奴，我往常但出门，磕头碰脑的都是我那朋友兄弟；今日见我穷了，见了我都躲去了。","book":"元·秦简夫《东堂老》第三折"},"example":{"text":"那些僧越加悚惧，～，各顾性命，通跑净了。","book":"明·吴承恩《西游记》第四十七回"}},{"id":34320,"word":"磕头烧香","pinyin":"kē tóu shāo xiāng","abbr":"ktsx","explanation":"比喻求人说好话。","example":{"text":"当官的都喜欢百姓给他～。"},"usage":"作谓语、宾语、定语；指求人"},{"id":34321,"word":"磕头碰脑","pinyin":"kē tóu pèng nǎo","abbr":"ktpn","explanation":"形容人多而相挤磕碰，或东西多而处处碰人。","source":{"text":"磕头碰脑，又都是些树木，不能动步，头盔早已落地，万缕青丝披散，绕住了枪杆。","book":"清·俞万春《荡寇志》第八十五回"},"example":{"text":"这有何难？放着相大爷一个名进士，～，满路都是同年，这有甚么难处！","book":"清·西周生《醒世姻缘传》第八十三回"},"similar":["磕磕碰碰"],"usage":"作宾语；形容人多而拥挤"},{"id":34322,"word":"磕头礼拜","pinyin":"kē tóu lǐ bài","abbr":"ktlb","explanation":"磕头：旧时礼节，跪在地上头碰地。礼拜：向尊敬的人或神行礼。恭敬地跪在地上叩头行礼。","source":{"text":"你只望着大安州磕头礼拜。","book":"元·无名氏《小张屠》第三折"},"example":{"text":"乜宁礼再三央人，～，他舅恨极，发誓再不上他的门。","book":"清·李绿园《歧路灯》第13回"},"similar":["顶礼膜拜"],"usage":"作谓语、宾语；指跪拜"},{"id":34323,"word":"磕牙料嘴","pinyin":"kē yá liào zuǐ","abbr":"kylz","explanation":"多嘴多舌。","source":{"text":"咱与你甚班辈，自来不相会，走将来嗑牙料嘴。","book":"元·无名氏《举案齐眉》第三折"},"similar":["多嘴多舌","嗑牙料嘴"],"usage":"作宾语、定语；指多嘴多舌"},{"id":34324,"word":"磕牙磕嘴","pinyin":"kē yá kē zuǐ","abbr":"kykz","explanation":"指谈些无聊的话。","source":{"text":"咱与你甚班辈，自来不相会，走将来磕牙料嘴。","book":"元·无名氏《举案齐眉》第三折"}},{"id":34325,"word":"磕磕绊绊","pinyin":"kē kē bàn bàn","abbr":"kkbb","explanation":"跌跌撞撞，指不太顺利。","source":{"text":"到后来两目如漆，只得磕磕绊绊，勉强下了山坡。","book":"清·褚人获《野叟曝言》"},"example":{"text":"人生道路难免会有～的。"},"similar":["跌跌撞撞"],"opposite":["一帆风顺"],"usage":"作宾语、状语；指不十分顺利"},{"id":34326,"word":"磨不磷，涅不缁","pinyin":"mó bù lín，niè bù zī","abbr":"mblnbz","explanation":"比喻意志坚定的人不会受环境的影响。同“磨而不磷，涅而不缁”。","source":{"text":"孰知铁中玉正以持己，礼以洁身，闻臣言怒以为污辱，竟不俟驾而行。其磨不磷，涅不缁，豪杰之士也。","book":"清·名教中人《好逑传》第18回"},"similar":["磨而不磷，涅而不缁"],"usage":"作定语、宾语、分句；用于处世等"},{"id":34327,"word":"磨乾轧坤","pinyin":"mó qián yà kūn","abbr":"mqyk","explanation":"乾：天；轧：碾压；坤：地。磨着天，擦着地。形容顶天立地，十分高大。","source":{"text":"于赫龙虎之台，磨乾轧坤。","book":"明·刘基《龙虎台赋》"},"similar":["顶天立地"],"usage":"作谓语；同“顶天立地”"},{"id":34328,"word":"磨刀不误砍柴工","pinyin":"mó dāo bù wù kǎn chái gōng","abbr":"mdbwkcg","explanation":"磨刀花费时间，但不耽误砍柴。比喻事先充分做好准备，就能使工作加快。","example":{"text":"我们都知道～，但行动时难以做到。"},"usage":"作宾语、定语；用于教诲人"},{"id":34329,"word":"磨刀擦枪","pinyin":"mó dāo cā qiāng","abbr":"mdcq","explanation":"形容作战前的准备工作。","example":{"text":"他又在磨刀擦枪准备战斗。"},"opposite":["高枕无忧"],"usage":"作谓语；形容作战前的准备工作"},{"id":34330,"word":"磨刀霍霍","pinyin":"mó dāo huò huò","abbr":"mdhh","explanation":"霍霍：磨刀的声音。磨刀发出霍霍的响亮的声音。现多形容敌人在行动前频繁活动。","source":{"text":"小弟闻姊来，磨刀霍霍向猪羊。","book":"《乐府诗集·木兰诗》"},"example":{"text":"公知夜来危乎！所共饭矿夫，～者，意在公也。","book":"明·朱国桢《涌潼小品·笃行》"},"usage":"作谓语、宾语、状语；指发动战争"},{"id":34331,"word":"磨动","pinyin":"mo dong","abbr":"md","explanation":"作圆圈式的挥舞。"},{"id":34332,"word":"磨厉以须","pinyin":"mó lì yǐ xū","abbr":"mlyx","explanation":"指磨刀以待。比喻作好准备，等待时机。亦作“磨砺以须”。","source":{"text":"檄文到日，磨厉以须，车马临时，市肆勿变。","book":"明·冯梦龙《东周列国志》第103回"},"similar":["摩厉以需","摩厉以须","摩砺以须"],"usage":"作谓语；比喻做好准备，等待时机"},{"id":34333,"word":"磨嘴皮子","pinyin":"mó zuǐ pí zǐ","abbr":"mzpz","explanation":"说废话。","example":{"text":"我不想跟你～。"},"similar":["耍嘴皮子"],"usage":"作谓语；用于口语"},{"id":34334,"word":"磨墨吮毫","pinyin":"mó mò shǔn háo","abbr":"mmsh","explanation":"毫：毛笔。磨好墨，把毛笔润湿。指动手写文章。","source":{"text":"各生童磨墨吮毫，发笔快的，早已有了破题、承题、小讲。","book":"清·李绿园《歧路灯》第90回"},"similar":["磨墨濡毫"],"usage":"作谓语；指准备写字书法"},{"id":34335,"word":"磨墨濡毫","pinyin":"mó mò rú háo","abbr":"mmrh","explanation":"濡：湿；毫：毛笔。磨好墨，把毛笔润湿。指动手写文章。","source":{"text":"亭亭正在磨墨濡毫，忽见红红、婉如从外面走来。","book":"清·李汝珍《镜花缘》第五十三回"},"example":{"text":"～作歌行，歌山河山之壮丽兮日新日昌，歌吾民之勤劳兮事业无疆。","book":"赵朴初《盘砚歌》"},"similar":["磨墨吮毫"],"usage":"作谓语；指准备写字书法"},{"id":34336,"word":"磨形炼性","pinyin":"mó xíng liàn xìng","abbr":"mxlx","explanation":"指锻炼身心。","source":{"text":"使我规避不得，只得用些磨形炼性之法，做一个老头陀去对付他。","book":"清·李渔《慎鸾交·情访》"},"usage":"作谓语、定语；指锻炼人的身心"},{"id":34337,"word":"磨拳擦掌","pinyin":"mó quán cā zhǎng","abbr":"mqcz","explanation":"形容战斗或劳动之前，人们精神振奋，跃跃欲试的样子","source":{"text":"俺可也磨拳擦掌，行行里按不住莽撞心头气。","book":"元·康进之《李逵负荆》第二折"},"example":{"text":"梁斌《红旗谱》：“这是第一次出马，人们都～，心里突突跳着准备战斗。”"},"similar":["摩拳擦掌"],"usage":"作谓语、状语、补语；指跃跃欲试的样子"},{"id":34338,"word":"磨揉迁革","pinyin":"mó róu qiān gé","abbr":"mrqg","explanation":"迁革：变化。通过磨练引导使人的思想发生变化。","source":{"text":"予闻教学之法本于人性，磨揉迁革使趋于善。","book":"宋·欧阳修《吉州学记》"},"usage":"作谓语；用于教育等"},{"id":34339,"word":"磨搅讹绷","pinyin":"mó jiǎo é bēng","abbr":"mjeb","explanation":"绷：骗。指纠缠捣乱，欺骗讹诈。","source":{"text":"讲到咱们这行啊，全仗的是磨搅讹绷，涎皮赖脸，长支短欠，摸点儿赚点儿才剩的下钱呢。","book":"清·文康《儿女英雄传》第四回"}},{"id":34340,"word":"磨昏抉聩","pinyin":"mó hūn jué kuì","abbr":"mhjk","explanation":"抉：撬开；聩：糊涂。启发教育愚昧糊涂的人。","source":{"text":"长老继作，磨昏抉聩。","book":"唐·司空图《泽州灵泉院记》"},"usage":"作谓语、定语；用于教师等"},{"id":34341,"word":"磨昬抉聩","pinyin":"mó hūn jué kuì","abbr":"mhjk","explanation":"救治教化愚昧糊涂的人。"},{"id":34342,"word":"磨杵作针","pinyin":"mó chǔ zuò zhēn","abbr":"mczz","explanation":"形容只要肯下功夫，再难的事也能成。","source":{"text":"彭山象耳山下，相传李白读书山中。学未成，弃去。过是溪，逢老媪方磨铁杵。白问：‘何为？’媪曰：‘欲作针耳。’白感其言，还，卒业。","book":"宋·祝穆《方舆胜览·磨针溪》"},"example":{"text":"耐心持久，如～，不计岁月，此用功样子也。","book":"明·黄淳耀《陶庵集·自监录一》"},"similar":["磨杵成针"],"usage":"作谓语、定语、宾语；指功到自然成"},{"id":34343,"word":"磨杵成针","pinyin":"mó chǔ chéng zhēn","abbr":"mccz","explanation":"把铁棒磨成了针。比喻做任何艰难的工作，只要有毅力，下苦功，就能够克服困难，做出成绩。","source":{"text":"李白少读书，未成，弃去。道逢老妪磨杵，白问其故。曰：‘欲作针。’白感其言，遂卒业。","book":"《潜确类书》卷六十"},"example":{"text":"没有～的毅力，学问上就不可能有很深的造诣。"},"similar":["铁杵磨成针","功到自然成"],"opposite":["三天打鱼，两天晒网"],"usage":"作谓语、定语；指功到自然成","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":34344,"word":"磨棱刓角","pinyin":"mó léng liǎng jiǎo","abbr":"mlwj","explanation":"指磨削棱角。"},{"id":34345,"word":"磨牙凿齿","pinyin":"mó yá záo chǐ","abbr":"myzc","explanation":"咬牙切齿。形容凶狠的样子。","source":{"text":"呜呼！天地间之元气终不可以灭己，而谗夫小人磨牙凿齿者，相仍而未艾。","book":"清·钱谦益《刻序》"},"example":{"text":"～地对齐占杰说：‘那你跟我捎个信，告诉王科长说，我当下这就退社。’","book":"康濯《东方红》第五章"},"similar":["咬牙切齿"],"usage":"作定语、状语；同“咬牙切齿”"},{"id":34346,"word":"磨牙吮血","pinyin":"mó yá shǔn xuè","abbr":"mysx","explanation":"磨利牙齿，吮吸鲜血。多形容像野兽一样嗜杀。","source":{"text":"朝避猛虎，夕避长蛇，磨牙吮血，杀人如麻。","book":"唐·李白《蜀道难》"},"example":{"text":"蹲着一对巨大的狮子，张了～的大口。","book":"曾朴《孽海花》第23回"},"usage":"作谓语、定语；指十分凶残"},{"id":34347,"word":"磨牙费嘴","pinyin":"mó yá fèi zuǐ","abbr":"myfz","explanation":"指反复琐碎的谈话或争论。","source":{"text":"我的性儿你是知道的，我是合你磨牙费嘴的人么？","book":"清·西周生《醒世姻缘传》第55回"},"example":{"text":"特派员，用得着和她那样～吗？","book":"《刘胡兰传》"},"usage":"作宾语、定语；指无用的争论"},{"id":34348,"word":"磨盘两圆","pinyin":"mò pán liǎng yuán","abbr":"mply","explanation":"比喻做人圆滑，双方都不得罪。","source":{"text":"比喻做人圆滑，双方都不得罪。"},"similar":["两面见光"],"usage":"作谓语、定语；指为人圆滑处世"},{"id":34349,"word":"磨盾之暇","pinyin":"mó dùn zhī xiá","abbr":"mdzx","explanation":"暇：闲暇，余暇。指在战争的余暇。","source":{"text":"先生从征九年，虽羽书旁午，然磨盾之暇，马上吟咏，穷庐诵读，无一日废也。","book":"清·江藩《国朝汉学师承记·王兰泉》"},"usage":"作宾语；用于书面语"},{"id":34350,"word":"磨砖作镜","pinyin":"mó zhuān zuò jìng","abbr":"mzzj","explanation":"把砖石磨成镜子。比喻事情不能成功。","source":{"text":"一曰：‘师作什么？’师曰：‘磨作镜。’一曰：‘磨砖岂能成镜邪？’师曰：‘坐禅岂得成佛邪？’","book":"宋·释道原《景德传灯录》卷五"},"example":{"text":"掘井及泉那用巧，～未为愚。","book":"宋·陆游《仰首座求钝庵》"},"similar":["磨砖成镜"],"usage":"作谓语、宾语、定语；比喻事情不能成功"},{"id":34351,"word":"磨砖成镜","pinyin":"mó zhuān chéng jìng","abbr":"mzcj","explanation":"把砖石磨成镜子。比喻事情不能成功。","source":{"text":"磨砖岂能成镜邪？","book":"宋·释道原《景德传灯录》"},"similar":["磨砖作镜","炊沙作饭"],"usage":"作谓语、宾语、定语；比喻事情不能成功","story":["唐玄宗开元年间，在沙门道一住传法院有一位高僧大德，每天都坚持坐禅悟道。慧能大师问他终日坐禅为的是什么，大德回答为成佛。慧能大师就在庵内取一块砖头往石头上磨，大德问作什么用？慧能大师启发他说作不可能成功的镜子"]},{"id":34352,"word":"磨砥刻厉","pinyin":"mó dǐ kè lì","abbr":"mdkl","explanation":"磨练砥砺。形容刻苦钻研。","source":{"text":"学必穷日夜磨砥刻厉，久而后有得焉。","book":"明·李东阳《成斋记》"},"usage":"作谓语、定语；指反复钻研"},{"id":34353,"word":"磨破口舌","pinyin":"mó pò kǒu shé","abbr":"mpks","explanation":"比喻说了很多的话。","example":{"text":"我～才说服她。"},"similar":["费尽口舌"],"usage":"作谓语；指费尽口舌"},{"id":34354,"word":"磨砺以须","pinyin":"mó lì yǐ xū","abbr":"mlyx","explanation":"磨快刀子等待。比喻做好准备，等待时机。","source":{"text":"摩厉以须，王出，吾刃将斩矣。","book":"春秋·鲁·左丘明《左传·昭公十二年》"},"example":{"text":"孤家久怀大志，欲建雄图，向来～，今始相机而动。","book":"清·李渔《玉搔头·逆气》"},"similar":["磨刀霍霍","磨厉以须"],"opposite":["临阵磨刀"],"usage":"作谓语、定语；比喻做好等待的准备"},{"id":34355,"word":"磨砺自强","pinyin":"mó lì zì qiáng","abbr":"mlzq","explanation":"磨砺：在磨刀石上磨擦，比喻磨炼。自己刻苦磨炼，使自身强大起来。"},{"id":34356,"word":"磨砻底厉","pinyin":"mó lóng dǐ lì","abbr":"mldl","explanation":"指四种质地和颜色不同的磨石。也指磨砺锻炼。同“磨砻砥砺”。"},{"id":34357,"word":"磨砻浸灌","pinyin":"mó lóng jìn guàn","abbr":"mljg","explanation":"切磋浸染。形容勤学苦练，始终不懈。亦作“磨礲浸灌”。","source":{"text":"君时始任戴冠，通《诗》《书》，与其群日讲说周公、孔子，以相磨砻浸灌，婆娑嬉游，未有舍所为为人意。","book":"唐·韩愈《考功员外卢君墓志铭》"},"example":{"text":"余与伯声皆罕与人接，得颛意以学问～为事。","book":"宋·曾巩《刘伯声墓志铭》"},"usage":"作谓语、定语；用于书面语"},{"id":34358,"word":"磨砻淬励","pinyin":"mó lóng cuì lì","abbr":"mlcl","explanation":"砻：磨；淬励：淬火磨砺。形容反复磨练，研讨。","source":{"text":"思得卓识博闻之士相与讲习，磨砻淬励，证其是黜其非，增益其所未至。","book":"宋·李纲《与潘子贱龙图书》"},"similar":["磨砻砥砺"],"usage":"作谓语、状语；指反复研讨"},{"id":34359,"word":"磨砻淬砺","pinyin":"mó lóng cuì lì","abbr":"mlcl","explanation":"磨砻：磨炼；淬砺：制造刀剑必须淬火和磨砺，比喻刻苦磨炼。指切磋琢磨，反复研讨。","source":{"text":"思得卓识博闻之士相与讲习，磨砻淬砺，证其是而黜其非，增益其所未至。","book":"宋·李纲《与潘子贱龙图书》"}},{"id":34360,"word":"磨砻砥砺","pinyin":"mó lóng dǐ lì","abbr":"mldl","explanation":"砻：磨；砥砺：磨刀石。指狠狠磨砺。","source":{"text":"据其未生，先其未形，磨砻砥砺，未见其损。","book":"汉·枚乘《上书谏吴王》"},"example":{"text":"平居友朋讲习，～，皆有元本，尤为他邦所不及。","book":"清·戴名世《郑允石制义序》"},"similar":["磨砻淬励"],"usage":"作谓语、状语；指反复磨练"},{"id":34361,"word":"磨砻镌切","pinyin":"mó lóng juān qiē","abbr":"mljq","explanation":"指磨砺切磋。","source":{"text":"磨砻镌切，沉浸灌养，行完而才备。","book":"宋·王安石《进说》"}},{"id":34362,"word":"磨砻隽切","pinyin":"mó lóng jùn qiē","abbr":"mljq","explanation":"砻：磨。相互切磋研讨。","source":{"text":"磨砻隽切，沉浸灌养，行完而才备。","book":"宋·王安石《进说》"},"similar":["磨砻砥砺"],"usage":"作谓语、状语；指反复研讨"},{"id":34363,"word":"磨磨蹭蹭","pinyin":"mó mó cèng cèng","abbr":"mmcc","explanation":"行动迟缓，做事拖拉。","source":{"text":"他磨磨蹭蹭地凑上来，察颜观色地看着父亲的脸。","book":"王朔《我是你爸爸》"},"example":{"text":"很晚，我们不能再～。"},"similar":["拖拖拉拉"],"opposite":["干脆利落"],"usage":"作谓语、状语、定语；用于处事"},{"id":34364,"word":"磨礲浸灌","pinyin":"mó lóng jìn guàn","abbr":"mljg","explanation":"切磋浸染。形容勤学苦练，始终不懈。同“磨砻浸灌”。"},{"id":34365,"word":"磨礲淬励","pinyin":"mó lóng cuì lì","abbr":"mlcl","explanation":"切磋琢磨，反复研讨。"},{"id":34366,"word":"磨礲砥砺","pinyin":"mó lóng dǐ lì","abbr":"mldl","explanation":"指四种质地和颜色不同的磨石。也指磨砺锻炼。同“磨砻砥砺”。"},{"id":34367,"word":"磨穿枯砚","pinyin":"mó chuān kū yàn","abbr":"mcky","explanation":"把铁铸的砚台都磨穿了。比喻读书用功，有恒心。","source":{"text":"对残编，磨穿枯砚，生涯微薄。","book":"宋·赵长卿《贺新郎》词"}},{"id":34368,"word":"磨穿铁砚","pinyin":"mó chuān tiě yàn","abbr":"mcty","explanation":"把铁铸的砚台都磨穿了。比喻读书用功，有恒心。","source":{"text":"韦编屡绝铁砚穿，口诵手抄那计年。","book":"宋·陆游《寒夜读书》诗"},"example":{"text":"坐破寒毡，～。","book":"元·范子安《竹叶舟》第一折"},"similar":["持之以恒"],"opposite":["半途而废"],"usage":"作谓语；指人的恒心","story":["五代时期，读书人桑维翰一心想考取进士，第一次因主考官迷信，桑与丧同音而没录取，第二次他写《日出扶桑赋》大赞扶桑，结果还是没录取。朋友劝他通过其他途径做官，他定制一块铁砚，说只有磨穿它后才会想别的办法去做官"]},{"id":34369,"word":"磨穿铁鞋","pinyin":"mó chuān tiě xié","abbr":"mctx","explanation":"形容长途跋涉，历尽艰辛。","source":{"text":"俺走天涯磨穿铁鞋，哭穷途西风洒泪，讨的个一事无成两鬓衰。","book":"明·康海《中山狼》第二折"},"similar":["踏破铁鞋"],"usage":"作谓语、宾语；指长途跋涉"},{"id":34370,"word":"磨而不磷","pinyin":"mó ér bù lín","abbr":"mebl","explanation":"磨了以后不变薄。比喻意志坚定的人不会受环境的影响。","source":{"text":"不曰坚乎？磨而不磷。不曰白乎？涅而不缁。","book":"《论语·阳货》"},"example":{"text":"～，未尝不心存社稷。","book":"唐·李德裕《袁盎以周勃为功臣论》"}},{"id":34371,"word":"磨而不磷，涅而不缁","pinyin":"mó ér bù lín，niè ér bù zī","abbr":"meblnebz","explanation":"磨了以后不变薄，染了以后不变黑。比喻意志坚定的人不会受环境的影响。","source":{"text":"不曰坚乎？磨而不磷。不曰白乎？涅而不缁。","book":"春秋·鲁·孔丘《论语·阳货》"},"example":{"text":"其实信得及他这朵妙法莲花出污泥而不染，真有个～的光景。","book":"清·文康《儿女英雄传》第25回"},"similar":["磨不磷，涅不缁"],"usage":"作定语、宾语；用于处世等","story":["春秋时期，孔子在鲁国政坛遭到排挤后，带领弟子们周游列国，先后在卫国、宋国等没受到重视，在赴晋的途中，子路劝他不要去投奔赵鞅这种小人，孔子相信自己是君子，会“磨而不磷，涅而不缁”，不会玷污自己的名声的"]},{"id":34372,"word":"磨踵灭顶","pinyin":"mó zhǒng miè dǐng","abbr":"mzmd","explanation":"踵：脚后跟。从头顶到脚跟都擦伤了。形容不辞劳苦，不顾身体。","source":{"text":"墨家之教，遵上俭薄，磨顶灭踵，且犹非吝。","book":"《南齐书·高逸传论》"}},{"id":34373,"word":"磨铅策蹇","pinyin":"mó qiān cè jiǎn","abbr":"mqcj","explanation":"磨钝刀，鞭蹇驴。比喻勉力而为。","source":{"text":"可与进也，乞诸一言，小子则磨铅策蹇，骋力于进取矣。","book":"唐·白居易《与陈给事书》"},"usage":"作谓语；指尽力做"},{"id":34374,"word":"磬其所有","pinyin":"qìng qí suǒ yǒu","abbr":"qqsy","explanation":"磬：尽，完。比喻把所有的东西全部拿出来。","source":{"text":"陛下不闻乎？博者输钱欲尽，乃磬所有出之，谓之孤注。","book":"《宋史·寇准传》"}},{"id":34375,"word":"磬石之固","pinyin":"qìng shí zhī gù","abbr":"qszg","explanation":"比喻不可动摇。","example":{"text":"我们两国的友谊犹如～，任何外来力量也动摇不了。"}},{"id":34376,"word":"磬竹难书","pinyin":"qìng zhú nán shū","abbr":"qzns","explanation":"罄：用尽；竹：竹简，用以写字；书：写。用尽竹子也难写完。形容罪行多得写不完。后泛指事实多，写不完。","source":{"text":"磬南山之竹，书罪未穷；决东海之波，流恶难尽。","book":"《吕氏春秋·明理》：“此皆乱国之所生也，不能胜数，尽荆越之竹，犹不能书。”《旧唐书·李密传》"},"example":{"text":"三臣罪状，～。","book":"清·陈康祺《燕下乡脞录》"}},{"id":34377,"word":"磬笔难书","pinyin":"qìng bǐ nán shū","abbr":"qbns","explanation":"极言事实多，即使用完笔也难写全。磬，通“罄”。","source":{"text":"磬南山之竹，书罪未穷；决东海之波，流恶难尽。","book":"《吕氏春秋·明理》：“此皆乱国之所生也，不能胜数，尽荆越之竹，犹不能书。”《旧唐书·李密传》"}},{"id":34378,"word":"礌礌落落","pinyin":"léi léi luò luò","abbr":"llll","explanation":"形容心地光明磊落。","source":{"text":"大丈夫行事当礌礌落落，如日月皎然。","book":"《晋书·石勒载记下》"}},{"id":34379,"word":"示贬于褒","pinyin":"shì biǎn yú bāo","abbr":"sbyb","explanation":"犹言寓批评于表扬。","source":{"text":"石以违拂不成为义，张以怀情不尽为义，皆上所亲定。盖圣意示贬于褒也。","book":"明沈德符《野获编·礼部·南礼部恤典》"},"similar":["寓贬于褒"],"usage":"作谓语；指寓批评于表扬中"},{"id":34380,"word":"礼下于人，将有所求","pinyin":"lǐ xià yú rén，jiāng yǒu suǒ qiú","abbr":"lxyrjysq","explanation":"礼：礼物；求：请求。送礼物给人，一定是对人有所求助。","source":{"text":"将求于人，则先下之。礼之善物也。","book":"《左传·昭公二十五年》"}},{"id":34381,"word":"礼不亲授","pinyin":"lǐ bù qīn shòu","abbr":"lbqs","explanation":"授：给予。古代认为男女之间不能亲手相授受。","source":{"text":"妾闻男女之别，礼不亲授。","book":"南朝·宋·范晔《后汉书·董祀妻传》"},"similar":["男女授受不亲"],"usage":"作宾语、定语；用于封建观念"},{"id":34382,"word":"礼不嫌菲","pinyin":"lǐ bù xián fěi","abbr":"lbxf","explanation":"不因为礼物菲薄而不讲求礼节。","source":{"text":"《礼坊记》：‘君子不以礼菲废礼。’注云：‘不可以其薄不及礼而不行礼。’","book":"清·翟灏《通俗编·仪节》"}},{"id":34383,"word":"礼为情貌","pinyin":"lǐ wéi qíng mào","abbr":"lwqm","explanation":"意谓一个人的礼仪容止为内心的显现。情，情意；貌，容仪。貌和情互为表里。","source":{"text":"意谓一个人的礼仪容止为内心的显现。情，情意；貌，容仪。貌和情互为表里。"},"example":{"text":"《韩非子·解老》：“礼为情貌者也，文为质饰者也。”晋·阮侃《释难宅无吉凶摄生论》：“周公有请命之事，仲尼非子路之祷。今钧圣而钧疾，何事不同也？故知臣子之情，尽斯心而已。所谓礼为情貌者耳。”"},"usage":"作宾语、定语；用于书面语"},{"id":34384,"word":"礼义廉耻","pinyin":"lǐ yì lián chǐ","abbr":"lylc","explanation":"古人认为礼定贵贱尊卑，义为行动准绳，廉为廉洁方正，耻为有知耻之心。指封建社会的道德标准和行为规范。","source":{"text":"何谓维？一曰礼，二曰义，三曰廉，四曰耻。","book":"《管子·牧民》"},"example":{"text":"古之贤君必厉士气，当务求难合自重之士，以养成～之风。","book":"宋·苏轼《乞录用郑侠王斿状》"},"similar":["三从四德"],"usage":"作宾语；指封建社会的道德标准和规范"},{"id":34385,"word":"礼义生富足","pinyin":"lǐ yì shēng fù zú","abbr":"lysfz","explanation":"旧时指人民富足后就必然讲求礼义。","source":{"text":"礼义生于富足，盗窃起于贫穷。","book":"《管子·牧民》：“衣食足而知礼节。”汉·王符《潜夫论·爱日》"}},{"id":34386,"word":"礼之用，和为贵","pinyin":"lǐ zhī yòng，hé wéi guì","abbr":"lzyhwg","explanation":"按礼行事，当以平和宁静为本。","source":{"text":"礼之用，和为贵，先王之道，斯为美。","book":"《论语·学而》"},"usage":"作宾语、定语、分句；用于交往等"},{"id":34387,"word":"礼乐刑政","pinyin":"lǐ yuè xíng zhèng","abbr":"lyxz","explanation":"指礼法、乐教、刑罚以及各项政令等。","source":{"text":"朝廷礼乐刑政之事，未尝在于学。学者亦漠然自以为礼乐刑政为有司之事，而非己所当知也。","book":"宋·王安石《上皇帝万言书》"},"example":{"text":"臣愿陛下尽君道以宰天下，～并出而用之。","book":"宋·陈亮《廷对》"}},{"id":34388,"word":"礼乐崩坏","pinyin":"lǐ yuè bēng huài","abbr":"lybh","explanation":"礼：社会道德、行为的规范；乐：教化的规范；崩：败坏。形容社会纲纪紊乱，动荡不安。","source":{"text":"庄宗虽出夷狄，又承天下大乱，礼乐崩坏之际，然顾典礼人情，亦难其事。","book":"宋·陆游《书郭崇韬传后》"},"similar":["礼坏乐崩","礼废乐崩"],"usage":"作宾语、定语；指动荡不安的时代"},{"id":34389,"word":"礼仪之邦","pinyin":"lǐ yí zhī bāng","abbr":"lyzb","explanation":"礼仪：礼节和仪式；邦：国家。指讲究礼节和仪式的国家。","source":{"text":"中国自古是礼仪之邦，现在却连同城而居的好朋友都不能见面，还美其名曰文化大革命，一点文化也没有。","book":"章诒和《往事并不如烟·最后的贵族》"},"example":{"text":"中国是一个礼仪之邦。"},"similar":["友好邻邦"],"usage":"作宾语；指讲究礼节和仪式的国家"},{"id":34390,"word":"礼先一饭","pinyin":"lǐ xiān yī fàn","abbr":"lxyf","explanation":"指在礼节上自己年岁稍长。一饭，犹言一顿饭，喻指极短的时间。也指在礼节上先有恩惠与人。同“礼先壹饭”。","source":{"text":"以仆礼先一饭，为识路之老马。","book":"清·钱谦益《答王于一秀才论文》"},"similar":["礼先壹饭"],"usage":"作谓语、宾语；用于交往等"},{"id":34391,"word":"礼先壹饭","pinyin":"lǐ xiān yī fàn","abbr":"lxyf","explanation":"指在礼节上自己年岁稍长。壹饭，犹言一顿饭，喻指极短的时间。也指在礼节上先有恩惠与人。","source":{"text":"《国语·越语上》：“句践对曰：‘昔天以越予吴，而吴不受命，今天以吴予越，越可以无听天之命而听君之令乎？吾请达王甬句东，吾与君为二君乎！’夫差对曰：‘寡人礼先壹饭矣。’”亦作“礼先一饭”。"},"example":{"text":"以仆礼先一饭，为识路之老马。","book":"清·钱谦益《答王于一秀才论文》"},"similar":["礼先一饭"],"usage":"作谓语、宾语；用于交往等"},{"id":34392,"word":"礼坏乐崩","pinyin":"lǐ huài yuè bēng","abbr":"lhyb","explanation":"古代制礼，把它当作社会道德、行为的规范；把制乐人微言轻教化的规范。形容社会纲纪紊乱，骚动不宁的时代。","source":{"text":"盖闻导民以礼，风之以乐。今礼坏乐崩，朕甚闵焉。","book":"《汉书·武帝纪》"},"example":{"text":"秦吞六雄之后，汉承百代之弊，～，上陵下替。","book":"唐·白居易《叔孙通定朝仪赋》"},"similar":["礼崩乐坏","礼乐崩坏"],"usage":"作宾语、定语；指动荡不安的时代"},{"id":34393,"word":"礼坏乐缺","pinyin":"lǐ huài yuè quē","abbr":"lhlq","explanation":"礼：社会道德、行为的规范；乐：教化的规范；缺：残破，废缺。形容社会纲纪紊乱，动荡不安。","source":{"text":"礼坏乐缺，故国异家殊，实宜以时修定，以为永准。","book":"《梁书·徐勉传》"},"similar":["礼坏乐崩"],"usage":"作宾语、定语；指动荡不安的时代"},{"id":34394,"word":"礼士亲贤","pinyin":"lǐ shì qīn xián","abbr":"lsqx","explanation":"尊敬亲近有才有德的人。","source":{"text":"礼士亲贤急访求，卑辞枉驾会儒流。","book":"明·无名氏《东篱赏菊》第三折"},"similar":["亲贤礼士","礼贤下士"],"usage":"作谓语、宾语；指爱惜人才"},{"id":34395,"word":"礼多人不怪","pinyin":"lǐ duō rén bù guài","abbr":"ldrbg","explanation":"对人多行礼仪，人不会怪罪。","source":{"text":"横竖‘礼多人不怪’，多作两个揖算得什么！","book":"清·李宝嘉《官场现形记》第31回"},"example":{"text":"～，多烧香总比少烧香的好。"},"similar":["礼多无人怪"],"usage":"作宾语、分句；用于人际关系"},{"id":34396,"word":"礼失则昏","pinyin":"lǐ shī zé hūn","abbr":"lszh","explanation":"失去礼义就必然导致昏乱。","source":{"text":"夫子之言曰：‘礼失则昏，名失则愆。矢志为昏，失所为愆。’","book":"《史记·孔子世家》"}},{"id":34397,"word":"礼奢宁俭","pinyin":"lǐ shē níng jiǎn","abbr":"lsnj","explanation":"礼义过多而烦杂，不如俭约些。","source":{"text":"丧易宁戚，自是亲亲之情；礼奢宁俭，差可得由吾意。","book":"语出《论语·八佾》：“林放问礼之本。子曰：大哉问。礼，与其奢也，宁俭。”《梁书·顾宪之传》"},"example":{"text":"《梁书·顾宪之传》：“丧易宁戚，自是亲亲之情；～。差可得由吾意。”"},"usage":"作宾语、定语；用于处事"},{"id":34398,"word":"礼奢宁简","pinyin":"lǐ shē nìng jiǎn","abbr":"lsnj","explanation":"指礼过多而苛烦，不如俭约些。","source":{"text":"林放问礼之本。子曰：‘大哉问。礼，与其奢宁俭。’","book":"《论语·八佾》"},"example":{"text":"丧易宁戚，自是亲亲之情；～，差可得由吾意。","book":"《梁书·顾宪之传》"}},{"id":34399,"word":"礼尚往来","pinyin":"lǐ shàng wǎng lái","abbr":"lswl","explanation":"尚：注重。指礼节上应该有来有往。现也指以同样的态度或做法回答对方。","source":{"text":"礼尚往来。往而不来，非礼也；来而不往，亦非礼也。","book":"《礼记·曲礼上》"},"example":{"text":"雯青顾全同僚的面子，也只好～，勉强敷衍。","book":"清·曾朴《孽海花》第六回"},"similar":["互通有无","有来有往"],"opposite":["一厢情愿","来而不往"],"usage":"作谓语、定语；用于人际关系","story":["春秋时期，孔子在家收弟子开坛讲学，引起了鲁定公的重视，经常到宫中讲学。季府的总管阳虎特地去看望孔子，孔子借故不见他。一次特地给孔子留下一只烤乳猪，知道孔子最讲究礼尚往来的，终于得到孔子的回访"]},{"id":34400,"word":"礼崩乐坏","pinyin":"lǐ bēng yuè huài","abbr":"lbyh","explanation":"指封建礼教的规章制度遭到极大的破坏。","source":{"text":"中唐以来，礼崩乐坏，狂狡有作，自己制则，而事不稽古。","book":"清·章炳麟《与简竹居书》"},"example":{"text":"章炳麟《与简竹居书》：“中唐以来，～，狂狡有作，自己制则，而事不稽古。”"},"similar":["礼坏乐崩","礼乐崩坏"],"usage":"作宾语、定语；指破坏礼教"},{"id":34401,"word":"礼废乐崩","pinyin":"lǐ fèi yuè bēng","abbr":"lflb","explanation":"古代制礼，把它当作社会道德、行为的规范；把制乐人微言轻教化的规范。形容社会纲纪紊乱，骚动不宁的时代。","source":{"text":"盖闻导民以礼，风之以乐，婚姻者，居室之大伦也。今礼废乐崩，朕甚愍焉。","book":"汉·公孙弘《请为博士置弟子员议》"},"similar":["礼乐崩坏","礼坏乐崩"],"usage":"作谓语、定语；用于社会局面"},{"id":34402,"word":"礼度委蛇","pinyin":"lǐ dù wēi yí","abbr":"ldwy","explanation":"礼度：礼数；委蛇：庄重而从容自得的样子。比喻彬彬有礼，不卑不亢。","source":{"text":"一个个精神抖擞，一个个礼度委蛇。","book":"元·无名氏《隔江斗智》第二折"}},{"id":34403,"word":"礼无不答","pinyin":"lǐ wú bù dá","abbr":"lwbd","explanation":"礼：礼数。一方以礼相待，另一方不能不以礼相报。亦指不受他人之礼，必以报答。","source":{"text":"君举旅于宾，及君所赐爵，皆降再拜稽首，升成拜，明臣礼也。君答拜之，礼无不答，明君上之礼也。","book":"《礼记·燕义》"},"example":{"text":"～，言上之不虚取于下也。","book":"《礼记·燕义》"},"usage":"作宾语、定语；用于交往等"},{"id":34404,"word":"礼烦则不庄","pinyin":"lǐ fán zé bù zhuāng","abbr":"lfzbz","explanation":"礼仪烦杂反而显得轻浮、不庄重。","source":{"text":"礼烦则不庄，业烦则无功。","book":"《吕氏春秋·适威》"}},{"id":34405,"word":"礼烦则乱","pinyin":"lǐ fán zé luàn","abbr":"lfzl","explanation":"礼仪繁琐势必导致混乱。","source":{"text":"黩于祭祀，时谓弗钦。礼烦则乱，事神则难。","book":"《尚书·说命中》"}},{"id":34406,"word":"礼禁未然","pinyin":"lǐ jìn wèi rán","abbr":"ljwr","explanation":"旧时指以礼教化人民，防范邪恶的事情发生。","source":{"text":"夫礼禁未然之前，法施已然之后，法之所为用者易见，而礼之所为禁者难知。","book":"《史记·太史公自序》"},"example":{"text":"～之前，谓难明之礼，古人不能行也。","book":"唐·欧阳洵《艺文类聚》卷五十四"}},{"id":34407,"word":"礼胜则离","pinyin":"lǐ shèng zé lí","abbr":"lszl","explanation":"指礼节过分，亲属也显得疏远了。","source":{"text":"指礼节过分，亲属也显得疏远了。"}},{"id":34408,"word":"礼让为国","pinyin":"lǐ ràng wéi guó","abbr":"lrwg","explanation":"治理。以礼所提倡的谦让精神治理国家。","source":{"text":"能以礼让为国乎？何有。不能以礼让为国，如礼何？","book":"《论语·里仁》"},"example":{"text":"中国又原是“～”的，既有礼，就必能让，而愈能让，礼也就愈繁了。","book":"鲁迅《准风月谈·礼》"},"usage":"作谓语、定语；用于书面语"},{"id":34409,"word":"礼贤下士","pinyin":"lǐ xián xià shì","abbr":"lxxs","explanation":"对有才有德的人以礼相待，对一般有才能的人不计自己的身分去结交。","source":{"text":"其在朝廷，鲠亮廉介，这宗臣表，礼贤下士有始终，尝引李巡、张参在幕府。","book":"《宋书·江夏文献王义恭传》：“礼贤下士，圣人垂训；骄多矜尚，先哲所去。”《新唐书·李勉传》"},"example":{"text":"我今天看见了一位～的大人先生，在今世只怕是要算绝少的了。","book":"清·吴趼人《二十年目睹之怪现状》第四回"},"similar":["彬彬有礼","以礼待人"],"opposite":["居高临下","盛气凌人"],"usage":"作谓语、定语；指爱惜人才","story":["唐朝时期，李勉从地方官升到宰相，他从不妄自尊大，待人非常诚恳，有礼貌。他发现县尉为人正直很能干就提拔他为南郑县令。他发现立巡、张参很有才干，就请他们出来做官，不久他们去世，李勉特别怀念他们，人们称他为礼贤下士的典范"]},{"id":34410,"word":"礼贤接士","pinyin":"lǐ xián jiē shì","abbr":"lxjs","explanation":"礼：表示敬意；接：接纳。对有才有德的人以礼相待去结交或接纳。","source":{"text":"三年为蜀帅，惠化大行，不事威仪，礼贤接士。","book":"宋·王谠《唐语林·政事》"},"similar":["礼贤下士"],"opposite":["盛气凌人"],"usage":"作谓语、定语；指爱惜人才"},{"id":34411,"word":"礼贤远佞","pinyin":"lǐ xián yuǎn nìng","abbr":"lxyn","explanation":"敬重有才德的人，疏远巧言献媚的人。","source":{"text":"赵盾等屡屡进谏，劝灵公礼贤远佞，勤政亲民。","book":"明·冯梦龙《东周列国志》第五十回"},"usage":"作谓语、定语、宾语；用于处世"},{"id":34412,"word":"礼轻义重","pinyin":"lǐ qīng yì zhòng","abbr":"lqyz","explanation":"礼物虽然很轻，但情意却很深厚。","source":{"text":"兄弟，拜义如亲，礼轻义重，笑纳为幸。","book":"元·李致远《还牢末》"}},{"id":34413,"word":"礼轻人意重","pinyin":"lǐ qīng rén yì zhòng","abbr":"lqryz","explanation":"礼物虽然很轻，但人的情意却很深厚。","source":{"text":"兄弟，拜义如亲，礼轻义重，笑纳为幸。","book":"元·李致远《还牢末》"},"example":{"text":"就是这个冤家，虽然不值得甚钱，是一个北京客人送我的，却不道～。","book":"明·冯梦龙《喻世明言》卷一"},"similar":["礼轻情意重"],"usage":"作宾语、定语；指送礼","story":["唐朝一地方官为表达对皇帝的敬意，派缅伯高给皇上进贡一只天鹅。缅伯高爬山涉水，经过沔阳湖时给天鹅洗澡，天鹅逃跑，只剩下一根鹅毛，只好写诗“上复唐天子，可饶缅伯高。礼轻人意重，千里送鹅毛。”皇帝没有怪罪并奖赏他"]},{"id":34414,"word":"礼轻情意重","pinyin":"lǐ qīng qíng yì zhòng","abbr":"lqqyz","explanation":"礼物虽然很轻，但情意却很深厚。","source":{"text":"兄弟，拜义如亲，礼轻义重，笑纳为幸。","book":"元·李致远《还牢末》"},"example":{"text":"让我替我自己说句混话罢，这叫做～。","book":"清·吴趼人《糊涂世界》第十回"},"similar":["礼轻人意重"],"usage":"作宾语、定语；指送礼","story":["唐朝一地方官为表达对皇帝的敬意，派缅伯高给皇上进贡一只天鹅。缅伯高爬山涉水，经过沔阳湖时给天鹅洗澡，天鹅逃跑，只剩下一根鹅毛，只好写诗“上复唐天子，可饶缅伯高。礼轻人意重，千里送鹅毛。”皇帝没有怪罪并奖赏他"]},{"id":34415,"word":"礼门义路","pinyin":"lǐ mén yì lù","abbr":"lmyl","explanation":"指“义”好比是大路，“礼”好比是门，只有君子才能从这条大路行走，由这扇门出入。","source":{"text":"夫义，路也；礼：门也。惟君子能由是路，出入是门也。","book":"《孟子·万章下》"},"example":{"text":"～儒家事，齐治须从身内修。","book":"清·无名氏《明珠缘》第九回"}},{"id":34416,"word":"礼顺人情","pinyin":"lǐ shùn rén qíng","abbr":"lsrq","explanation":"指礼是顺乎人之常情，人与人共处必须遵守的规范。","source":{"text":"周公有请命之事，仲尼非子路之祷。今钧圣而钧疾，何事不同也？故知臣子之情，尽斯心而已。所谓礼为情貌者耳。","book":"《韩非子·解老》：“礼为情貌者也，文为质饰者也。”晋·阮侃《释难宅无吉凶摄生论》"},"usage":"作宾语、定语；指合乎情理","story":["西汉末年，丞相孔光府里府吏卓茂为人十分宽厚，很会人情世故。他因此而做了县令，有人向他报告说亭长收受了他的米肉，他问是主动送礼还是索贿。那人说是主动送礼，法律规定是不能收财物的。卓茂说是主动送的，礼是合乎人情的"]},{"id":34417,"word":"社会贤达","pinyin":"shè huì xián dá","abbr":"shxd","explanation":"指不属任何党派而具有广泛社会声望的人士。"},{"id":34418,"word":"社威擅势","pinyin":"shè wēi shàn shì","abbr":"swss","explanation":"倚仗权势，想干什么就干什么。","source":{"text":"将相摄威擅势，私门成党，而公道不行。","book":"《淮南子·汜论训》"}},{"id":34419,"word":"社燕秋鸿","pinyin":"shè yàn qiū hóng","abbr":"syqh","explanation":"燕子和大雁都是候鸟，但在同一季节里飞的方向不同。比喻刚见面又离别。","source":{"text":"忆昔钱塘话别，十年社燕秋鸿。今朝忽遇暮云东，坐对旗亭说梦。","book":"宋·张先《西江月》词"},"example":{"text":"底事尘驱物役，空回首、～。功名已，萧骚短鬓，分付与青铜。","book":"宋·吴潜《满庭芳》词"}},{"id":34420,"word":"社稷为墟","pinyin":"shè jì wéi xū","abbr":"sjwx","explanation":"国家灭亡而成废墟。指国家被灭亡。","source":{"text":"重耳反国，起师而伐曹，遂灭之。身死人手，社稷为墟。","book":"《淮南子·人间训》"},"usage":"作宾语、定语；用于书面语"},{"id":34421,"word":"社稷之器","pinyin":"shè jì zhī qì","abbr":"sjzq","explanation":"国家的栋梁之材。","source":{"text":"蒋琬，社稷之器，非百里之才也。","book":"三国·蜀·诸葛亮《又称蒋琬》"},"similar":["社稷之臣"],"usage":"作宾语；用于书面语"},{"id":34422,"word":"社稷之役","pinyin":"shè jì zhī yì","abbr":"sjzy","explanation":"臣子对君王应尽的职责。","source":{"text":"为人臣下者，有谏而无讪，有亡而无疾，颂而无讇，谏而无骄。怠则张而相之，废则埽而更之，谓之社稷之役。","book":"《礼记·少仪》"},"usage":"作宾语；用于书面语"},{"id":34423,"word":"社稷之臣","pinyin":"shè jì zhī chén","abbr":"sjzc","explanation":"称春秋时附庸于大国的小国。也称身负国家重任的大臣。","source":{"text":"夫颛臾，昔者先王以为东蒙主，且在邦域之中矣，是社稷之臣也，何以伐为？","book":"《论语·季氏》"},"example":{"text":"若论此子，乃～，栋梁之材。","book":"元·李文蔚《蒋神灵仙》第二折"},"similar":["社稷之器"],"usage":"作宾语；用于书面语"},{"id":34424,"word":"社稷生民","pinyin":"shè jì shēng mín","abbr":"sjsm","explanation":"指国家与人民。","source":{"text":"何与于～之计，三百篇之旨哉？","book":"傅抱石《〈郑板桥集〉前言》"},"usage":"作宾语、定语；用于书面语"},{"id":34425,"word":"社鼠城狐","pinyin":"shè shǔ chéng hú","abbr":"ssch","explanation":"社：土地庙。城墙上的狐狸，社庙里的老鼠。比喻依仗权势做恶，一时难以驱除的小人。","source":{"text":"隗诚始祸，然城狐社鼠也。","book":"《晏子春秋·内篇问上》：“夫社，束木而涂之，鼠因而托焉，薰之则恐烧其木，灌之则恐败其涂。此鼠所以不可得杀者，以社故也。”《晋书·谢鲲传》"},"example":{"text":"不提防柙虎樊熊，任纵横～。","book":"清·洪昇《长生殿·疑谶》"},"similar":["城狐社鼠"],"usage":"作宾语、定语；指做恶的小人"},{"id":34426,"word":"祁奚举午","pinyin":"qí xī jǔ wǔ","abbr":"qxjw","explanation":"午：祁奚之子。祁奚推荐自己的儿子。指举贤不避亲，客观公正。亦作“祁奚举子”。","source":{"text":"祁奚请老，晋侯问嗣焉，称解狐，其仇也，将立之而卒。又问焉，对曰：‘午也可。’","book":"《左传·襄公三年》"},"example":{"text":"父教子忠，古之善训。～，义不务私。","book":"宋·钱易《南部新书》"},"usage":"作宾语、定语；用于用人","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎。大夫祁奚向晋侯请求告老还乡，晋侯问他谁可以接任，他推荐了他的仇敌解狐。晋侯问谁可以担任中军尉，祁奚推荐了自己的儿子祁午"]},{"id":34427,"word":"祁奚之举","pinyin":"qí xī zhī jǔ","abbr":"qxzj","explanation":"祁奚举荐贤人，不避亲仇，公正无私。","source":{"text":"历官三朝，年逾一纪，凡所称荐，罕避嫌疑，实有祁奚之举。","book":"唐·姚元崇《答张九龄书》"},"example":{"text":"又是臣门户子弟，堪任兖州刺史，公家之事，知无不为，是以敢希～。","book":"蔡东蕃《两晋演义》第四十六回"},"similar":["祁奚之荐"],"usage":"作宾语、定语；用于用人","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎。大夫祁奚向晋侯请求告老还乡，晋侯问他谁可以接任，他推荐了他的仇敌解狐。晋侯问谁可以担任中军尉，祁奚推荐了自己的儿子祁午"]},{"id":34428,"word":"祁奚之荐","pinyin":"qí xī zhī jiàn","abbr":"qxzj","explanation":"春秋晋国大夫祁奚告老，将辞中军尉职事。晋悼公问谁可承接，祁奚先推荐仇人解狐。复问，又荐举其子祁午。时人因而有“外举不弃仇，内举不失亲”之誉。后用为善于","source":{"text":"祁奚请老，晋侯问嗣焉，称解狐，其仇也。将立而卒。又问焉，对曰：‘午可也。’于是使祁午为中军尉。","book":"春秋·鲁·左丘明《左传·襄公三年》"},"example":{"text":"故解狐蒙～，二叔被周公之害。","book":"南朝·宋·范晔《后汉书·文苑传·刘梁》"},"similar":["祁奚之举","祁奚举午"],"usage":"作宾语、定语；用于用人","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎。大夫祁奚向晋侯请求告老还乡，晋侯问他谁可以接任，他推荐了他的仇敌解狐。晋侯问谁可以担任中军尉，祁奚推荐了自己的儿子祁午"]},{"id":34429,"word":"祁奚荐仇","pinyin":"qí xī jiàn chóu","abbr":"qxjc","explanation":"祁奚：春秋晋国人；荐：推荐；仇：仇人。祁奚举荐自己的仇人接替他。形容公正无私。","source":{"text":"祁奚请老，晋侯问嗣焉。称解狐，其仇也，将立之而卒。","book":"《左传·襄公三年》"}},{"id":34430,"word":"祁寒暑雨","pinyin":"qí hán shǔ yǔ","abbr":"qhsy","explanation":"祁：大。冬季大寒，夏天湿热。","source":{"text":"祁寒暑雨是无胥怨，天覆云油滋焉渗漉。","book":"北周·庾信《角调曲二首》其二"},"example":{"text":"二解天工四序平分岁，皇心惟念小民依。一自农功始、～遍畴咨。","book":"《清史稿·乐志五》"},"similar":["祁寒酷暑"],"usage":"作宾语、定语；用于书面语"},{"id":34431,"word":"祁寒溽暑","pinyin":"qí hán rù shǔ","abbr":"qhrs","explanation":"祁寒：大寒；溽暑：湿热。冬季大寒，夏季湿热。比喻过艰苦的生活。","source":{"text":"陛下顷在河上，汴寇未平，废寝忘食，心在战阵，祁寒溽暑，不介圣怀。","book":"《旧五代史·唐书·郭崇韬传》"},"example":{"text":"予初入道自恃甚易，逮见黄龙先师后，退思日用，与理矛盾者极多，遂力行之三年，虽～确志不移。","book":"《禅林宝训》卷一"},"similar":["祁寒酷暑","祁寒暑雨"],"usage":"作宾语、定语；用于书面语"},{"id":34432,"word":"祁寒酷暑","pinyin":"qí hán kù shǔ","abbr":"qhks","explanation":"祁：大。冬季大寒，夏天湿热。","source":{"text":"祁寒酷暑不稍间。","book":"清·陈康祺《郎潜纪闻》"},"similar":["祁寒暑雨"],"usage":"作宾语、定语；用于书面语"},{"id":34433,"word":"祁溪之举","pinyin":"qí xī zhī jǔ","abbr":"qxzj","explanation":"祁溪：春秋晋国人，推荐仇人和儿子接替自己的职务。指推荐贤才，不避亲仇，公平无私。","source":{"text":"历官三朝，年逾一纪，凡所称荐，罕避嫌疑，实有祁溪之举。","book":"唐·姚元崇《答张九龄书》"}},{"id":34434,"word":"祇树有缘","pinyin":"qí shù yǒu yuán","abbr":"qsyy","explanation":"祇树：梵语，即祇园，祇树给孤独园的略称，为释迦牟尼往舍国说法时居停之处。指与佛法有缘分。","source":{"text":"自家叫做佛印，生来有些灵性，只为了悟一心，因此削光两鬓。漫言祇树有缘，落得浮萍无定。","book":"明·陈汝元《金莲记·郊遇》"}},{"id":34435,"word":"祈晴祷雨","pinyin":"qí qíng dǎo yǔ","abbr":"qqdy","explanation":"向上天祈求天晴或下雨。","source":{"text":"正直无私有至灵，于家为国保庶民，祈晴祷雨皆显应，掌管经书文卷中。","book":"明·无名氏《贺元宵》第一折"},"usage":"作谓语、宾语；用于祈求上天"},{"id":34436,"word":"祖传秘方","pinyin":"zǔ chuán mì fāng","abbr":"zcmf","explanation":"指祖先遗传下来的秘密配方。","source":{"text":"说不定老人家还会拿出什么祖传秘方，把女儿侯玉英的那条跛腿治成好腿哩！","book":"路遥《平凡的世界》第四卷第39章"},"example":{"text":"他有～，致富是有希望的。"},"usage":"作主语、宾语；指祖先遗传下来的秘密配方"},{"id":34437,"word":"祖功宗德","pinyin":"zǔ gōng zōng dé","abbr":"zgzd","explanation":"指祖有功而宗有德。古代王朝尊始祖或开国之君为祖。有开创之功，其后有德之君则尊为宗。","source":{"text":"古者祖有功而宗有德，谓之祖宗者，其庙皆不毁。","book":"《孔子家语·庙制》"}},{"id":34438,"word":"祖宗家法","pinyin":"zǔ zōng jiā fǎ","abbr":"zzjf","explanation":"封建时代祖先制定的家族法规。","source":{"text":"不要说好是妃子，就是皇后，也严禁寻国事说一句话。这是规矩，也叫做‘祖宗家法’。","book":"姚雪垠《李自成》第一卷第一章"},"usage":"作主语、宾语、定语；用于书面语"},{"id":34439,"word":"祖宗成法","pinyin":"zǔ zōng chéng fǎ","abbr":"zzcf","explanation":"指先代帝王所制定而为后世沿袭应用的法则。","source":{"text":"此皆祖宗成法，至今为不刊之典，然而州县奉行，往往违戾。","book":"宋朱熹《论差役利害状》"},"example":{"text":"然则所谓守旧者，……死守几经劫余之～，朝堂龌龊，乡里谩骂，作蚊蚋之污渠一哄而已。","book":"《辛亥革命前十年间时论选集·中国灭亡论》"},"similar":["祖宗法度"],"usage":"作主语、宾语、定语；用于书面语"},{"id":34440,"word":"祖宗法度","pinyin":"zǔ zōng fǎ dù","abbr":"zzfd","explanation":"指先代帝王所制定而为后世沿袭应用的法则。","source":{"text":"臣等谨按：蔡京罪恶最大……变乱祖宗法度，窃弄朝迁爵赏。","book":"《宣各遗事》后集"},"example":{"text":"仁宗即位时，大学士的品位还不过是五品，这是～，不能擅改。","book":"《华东师范大学学报》1982年第3期"},"similar":["祖宗成法"],"usage":"作主语、宾语、定语；用于书面语"},{"id":34441,"word":"祖武宗文","pinyin":"zǔ wǔ zōng wén","abbr":"zwzw","explanation":"祖袭武王，尊崇文王。指尊崇祖先。","source":{"text":"惟齐继五帝洪名，纽三王绝业，祖武宗文之德，昭升严配；格天光表之功，弘启兴复。","book":"南朝梁王中《头陀寺碑文》"},"usage":"作宾语、定语；用于书面语"},{"id":34442,"word":"祖生之鞭","pinyin":"zú shēng zhī biān","abbr":"zszb","explanation":"比喻奋勉争先或先占一着之意。","source":{"text":"吾枕戈待旦，志枭逆虏，常恃祖生先吾著鞭。","book":"《晋书·刘琨传》"},"usage":"作宾语；用于比喻句"},{"id":34443,"word":"祖祖辈辈","pinyin":"zǔ zǔ bèi bèi","abbr":"zzbb","explanation":"辈辈：一代一代。世世代代。","source":{"text":"何雷，咱祖祖辈辈可没出过流氓。","book":"王朔《永失我爱》"},"example":{"text":"我～都是种地的。"},"similar":["世世代代"],"usage":"作主语、宾语、定语；指世世代代"},{"id":34444,"word":"祖舜宗尧","pinyin":"zú shùn zōng yáo","abbr":"zszy","explanation":"信仰、遵循尧舜之道。","source":{"text":"祖舜宗尧，太平之兆。","book":"明·无名氏《十样锦》第一折"},"usage":"作谓语、宾语、定语；用于处事"},{"id":34445,"word":"祖述尧舜，宪章文武","pinyin":"zǔ shù yáo shùn，xiàn zhāng wén wǔ","abbr":"zsysxzww","explanation":"遵循尧舜之道，效法周文王、周武王之制。","source":{"text":"仲尼祖述尧舜，宪章文武。","book":"《礼记·中庸》"},"example":{"text":"故虽周公制作，夫子著名，莫不～。","book":"唐陈子昂《谏灵驾入京书》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":34446,"word":"祖述有自","pinyin":"zǔ shù yǒu zì","abbr":"zsyz","explanation":"祖述：效法或遵循前人的行为和学说。指效法前人，又有自己的创新","source":{"text":"铿有‘花逐下山风’，杜有‘云逐度溪风’，祖述有自，青出于蓝也。","book":"宋·龚颐正《芥隐笔记·作诗祖述有自》"},"usage":"作宾语、定语；用于书面语"},{"id":34447,"word":"祖逖之誓","pinyin":"zǔ tì zhī shì","abbr":"ztzs","explanation":"指晋代志士祖逖毅然立誓之事","source":{"text":"元帝时藩王争权，晋室大乱，元帝以逖为奋威将军、豫州刺史，逖率部曲百余家渡江中流，击揖而誓曰：‘祖逖不能清中原而复济者，有如大江。’","book":"《晋书·祖逖传》"},"usage":"作宾语；用于书面语"},{"id":34448,"word":"祖龙一炬","pinyin":"zǔ lóng yī jù","abbr":"zlyj","explanation":"祖龙：秦始皇。指秦始皇焚书。比喻一把火烧掉。","source":{"text":"将坊间一切刻板，世上一切时文，俱付之祖龙一炬。","book":"清·夏敬渠《野叟曝言》第148回"},"similar":["付之一炬"],"usage":"作宾语、定语；指火烧","story":["秦始皇34年，秦始皇采用丞相李斯的意见，把上书分封的淳于越看成私家学诽谤朝政，下令将《秦纪》以外的史书全部上交焚毁，书生卢生等人不满，结果秦始皇下令逮捕了460多名方士和儒生，在咸阳挖坑活埋他们"]},{"id":34449,"word":"祖龙之虐","pinyin":"zǔ lóng zhī nüè","abbr":"zlzn","explanation":"指秦始皇焚书坑儒。祖龙，指秦始皇。","source":{"text":"异史氏曰：‘天下之物，积则招妒，好则生魔：女之妖，书之魔也。事近怪诞，治之未为不可；而祖龙之虐，不已惨乎！其存心之私，更宜得怨毒之报也。’","book":"清蒲松龄《聊斋志异·书痴》"},"usage":"作宾语；用于书面语"},{"id":34450,"word":"祛病延年","pinyin":"qū bìng yán nián","abbr":"qbyn","explanation":"祛：除去。除去疾病，延长寿命。","source":{"text":"陛下，从此色欲少贪，阴功多积，凡百事将长补短，自足以祛病延年。","book":"明·吴承恩《西游记》第七十九回"},"example":{"text":"清·吴璿《飞龙全传》第23回：“这是法制的五香狗肉，抹一抹，消灾降福，抹两抹，～。”"},"usage":"作谓语、定语；用于祝福"},{"id":34451,"word":"祛累","pinyin":"qu lei","abbr":"ql","explanation":"除去内心的牵累。"},{"id":34452,"word":"祛蠹除奸","pinyin":"qū dù chú jiān","abbr":"qdcj","explanation":"除去奸邪之人。","source":{"text":"且说李御史到了福建，巡历地方，祛蠹除奸，雷厉风行。","book":"明·凌濛初《二刻拍案惊奇》卷二十六"},"usage":"作谓语、宾语；用于比喻句"},{"id":34453,"word":"祛衣受业","pinyin":"qū yī shòu yè","abbr":"qysy","explanation":"祛衣：掀起衣服。形容恭恭敬敬地拜见，虚心请教。","source":{"text":"于是孟尝君曰：‘敬闻命矣。’明日祛衣请受业。","book":"汉·韩婴《韩诗外传》"}},{"id":34454,"word":"祛衣请业","pinyin":"qū yī qǐng yè","abbr":"qyqy","explanation":"祛衣：掀起衣服。形容恭恭敬敬地拜见，虚心请教。","source":{"text":"于是孟尝君曰：‘敬闻命矣。’明日祛衣请受业。","book":"汉·韩婴《韩诗外传》"}},{"id":34455,"word":"祝不胜诅","pinyin":"zhù bù shèng zǔ","abbr":"zbsz","explanation":"指祝而得益不能胜过诅而受损。","source":{"text":"一人祝之，一国诅之，一祝不胜万诅，国亡不亦宜乎？","book":"宋·洪迈《容斋四笔》"},"usage":"作宾语、定语；用于书面语"},{"id":34456,"word":"祝僇祝鲠","pinyin":"zhù lù zhù gěng","abbr":"zlzg","explanation":"古代帝王敬老、养老的表示：请年老致仕者饮酒吃饭，设置专人祷祝他们不哽不噎。同“祝哽祝噎”。"},{"id":34457,"word":"祝僯祝鲠","pinyin":"zhù lù zhù gěng","abbr":"zlzg","explanation":"古代帝王敬老、养老的表示请年老致仕者饮酒吃饭，设置专人祷祝他们不哽不噎。同祝哽祝噎”。"},{"id":34458,"word":"祝发文身","pinyin":"zhù fā wén shēn","abbr":"zfws","explanation":"削短头发，刻画其身。指中原以外地区异族的风俗服制。","source":{"text":"周之泰伯远弃骨肉，托迹异域，祝发文身，存之不反，而论称至德，书著大贤。","book":"《毂梁传·哀公十三年》：“吴，夷狄之国也，祝发文身。”晋·孙绰《喻道论》"},"example":{"text":"晋·孙绰《喻道论》：“周之泰伯远弃骨肉，托迹异域，～，存之不反，而论称至德，书著大贤。”"},"similar":["披发文身"],"usage":"作宾语、定语；用于书面语"},{"id":34459,"word":"祝发空门","pinyin":"zhù fā kōng mén","abbr":"zfkm","explanation":"指削发出家为僧尼。","source":{"text":"耿逆平，旭未授官，忽祝发空门，日修禅诵以老。","book":"清·景星杓《山斋客谭·孙旭》"},"example":{"text":"戚族劝之，遂负气～。","book":"清·王韬《凇宾琐话·倪幼蓉》"},"usage":"作谓语、定语；用于书面语"},{"id":34460,"word":"祝咽祝哽","pinyin":"zhù yān zhù gěng","abbr":"zyzg","explanation":"古代帝王接养三老、五更，以示仁惠。当进餐时，使人在前后祝祷他们不要哽噎。同“祝哽祝噎”。","source":{"text":"卜筮巫医御于前，祝咽祝哽以食。","book":"《尚书大传》卷五"},"similar":["祝哽在前，祝噎在后"],"usage":"作宾语、定语、状语；用于书面语"},{"id":34461,"word":"祝哽在前，祝噎在后","pinyin":"zhù gěng zài qián，zhù yē zài hòu","abbr":"zgzqzyzh","explanation":"祝：祝祷；哽、噎：食物塞住喉咙。古代帝王接养三老、五更，以示仁惠。当三老、五更进餐时，派人在前后祝祷他们不要哽噎","source":{"text":"然而养三老于太学，亲执酱而傀，执爵而酳，祝噎在前，祝鲠在后，公卿奉杖，大夫进履，举贤以自辅弼，求修正之士使直谏。","book":"东汉·班固《汉书·贾山传》"},"example":{"text":"南朝·宋·范晔《后汉书·明帝纪》：“尊事三老、兄事五更，……～。”"},"similar":["祝咽祝哽"],"usage":"作宾语、定语；用于书面语"},{"id":34462,"word":"祝哽祝噎","pinyin":"zhù gěng zhù yē","abbr":"zgzy","explanation":"祝：祷祝；哽、噎：食物堵住食道。古代帝王敬老、养老的表示：请年老致仕者饮酒吃饭，设置专人祷祝他们不哽不噎。","source":{"text":"然而养三老于太学，亲执酱而馈，执爵而酳，祝噎在前，祝哽在后。","book":"汉·贾山《至言》"},"similar":["祝咽祝哽"],"usage":"作宾语、定语；用于敬老"},{"id":34463,"word":"祝寿延年","pinyin":"zhù shòu yán nián","abbr":"zsyn","explanation":"祝贺人长命百岁。","source":{"text":"上帝命金母开筵，群仙会集，都要您祝寿延年，供奇进美。","book":"明·无名氏《紫微宫》第三折"},"usage":"作谓语、定语、宾语；用于祝贺等"},{"id":34464,"word":"祝染梦榜","pinyin":"zhù rǎn mèng bǎng","abbr":"zrmb","explanation":"祝染：人名；梦：梦见。祝染梦见状元榜。比喻善有善报。","source":{"text":"昔有姓祝名染者，尝遇岁饥，施粥以济四方之贫者。后生一子，初赴试，染梦一人手持状元榜竖于门外……未几，有人报其子状元及第。","book":"清·张英《渊鉴类函·粥三》"}},{"id":34465,"word":"祝禽疏网","pinyin":"zhù qín shū wǎng","abbr":"zqsw","explanation":"祝：祝福；疏：开通。为飞禽祝福，打开网。指开网放禽飞走。比喻给禽鸟自由。","source":{"text":"而祝禽疏网，徒开三面之恩；毒虺挻灾，逾肆九头之暴。","book":"唐·骆宾王《兵部奏姚州破贼设蒙俭等露布》"}},{"id":34466,"word":"祝鮀之佞","pinyin":"zhù tuó zhī nìng","abbr":"ztzn","explanation":"祝鮀，春秋卫人，能言善辩，或指其善以巧言媚人，后因以为佞人的典型。","source":{"text":"不有祝鮀之佞，而有宋朝之美，难乎免於今之世矣。","book":"《论语·雍也》"}},{"id":34467,"word":"祝鮠之佞","pinyin":"zhù tuó zhī nìng","abbr":"ztzn","explanation":"祝鮠，春秋卫人，能言善辩，或指其善以巧言媚人，后因以为佞人的典型。","source":{"text":"不有祝鮠之佞，而有宋朝之美，难乎免於今之世矣。","book":"《论语·雍也》"}},{"id":34468,"word":"祝鲠祝噎","pinyin":"zhù gěng zhù yē","abbr":"zgzy","explanation":"古代帝王敬老、养老的表示：请年老致仕者饮酒吃饭，设置专人祷祝他们不哽不噎。同“祝哽祝噎”。"},{"id":34469,"word":"祝鲠祝饐","pinyin":"zhù gěng zhù yì","abbr":"zgzy","explanation":"祝古代帝王敬老、养老的表示：请年老致仕者饮酒吃饭，设置专人祷祝他们不哽不噎。同“祝哽祝噎”。"},{"id":34470,"word":"神不主体","pinyin":"shén bù zhǔ tǐ","abbr":"sbzt","explanation":"恐惧地神志控制不住躯体。","source":{"text":"荀鹤声喏，恐惧流汗，再拜叙谢讫，命坐。荀鹤惨悴战栗，神不主体。","book":"宋·张齐贤《洛阳缙绅旧闻记·梁太祖优待文士》"},"similar":["神不守舍"],"usage":"作谓语、定语、状语；用于恐惧时"},{"id":34471,"word":"神不守舍","pinyin":"shén bù shǒu shě","abbr":"sbss","explanation":"神魂离开了身体，比喻丧魂失魄，心神不安定。","source":{"text":"疲乏之极，神不守舍。","book":"清·纪昀《阅微草堂笔记》"},"example":{"text":"你最近怎么老是～的。"},"similar":["魂不守舍","魂飞魄散","丧魂失魄"],"opposite":["泰然自若","专心致志"],"usage":"作谓语、定语、状语；指心神不安","story":["妙玉自从与宝玉听了黛玉那凄凉的琴声后，恍恍忽忽地回到庵内，念完“禅门日诵”就在禅床上打坐。可是就是神不守舍，老是想起宝玉的话，心跳耳热。迷迷糊糊地睡着了，在梦中好像有许多王孙公子要娶她，甚至有强盗持刀执棍威逼她，大病一场"]},{"id":34472,"word":"神不收舍","pinyin":"shén bù shōu shě","abbr":"sbss","explanation":"神魂离开了身体，比喻丧魂失魄，心神不安定。同“神不守舍”。","source":{"text":"清·沈复《浮生六记·坎坷记愁》；“芸曰：‘连日梦我父母放舟来接，闭目即飘然上下，如行云雾中，殆魂离而躯壳存乎？’余曰：‘此神不收舍，服以补剂，静心调养，自能安痊。’”"},"similar":["神不守舍","神不附体"],"usage":"作谓语、定语、状语；指心神不安"},{"id":34473,"word":"神不知鬼不晓","pinyin":"shén bù zhī guǐ bù xiǎo","abbr":"sbzgbx","explanation":"指形迹隐秘，不为人知。同“神不知鬼不觉”。","source":{"text":"指形迹隐秘，不为人知。同“神不知鬼不觉”。"},"example":{"text":"张翼《敌区工作记》：“何况我俩又是神不知鬼不晓走进来的。”"},"similar":["神不知鬼不觉"],"usage":"作状语、分句；形容事情做得很秘密"},{"id":34474,"word":"神不知鬼不觉","pinyin":"shén bù zhī guǐ bù jué","abbr":"sbzgbj","explanation":"指形迹隐秘，不为人知。","source":{"text":"这烦恼神不知鬼不觉，天来高地来厚。","book":"元·无名氏《冤家债主》第二折"},"example":{"text":"李自成和刘宗敏等～地率领着队伍过了洛南，埋伏在华山东麓的深山密林中。","book":"姚雪垠《李自成》第一卷第14章"},"similar":["神不知鬼不晓"],"usage":"作状语、分句；形容事情做得很秘密"},{"id":34475,"word":"神不知，鬼不觉","pinyin":"shén bù zhī，guǐ bù jué","abbr":"sbzgbj","explanation":"形容事情做得很秘密，没有被人发觉。","source":{"text":"这烦恼神不知，鬼不觉，天来高地来厚。","book":"元·无名氏《冤家债主》第二折"}},{"id":34476,"word":"神不附体","pinyin":"shén bù fù tǐ","abbr":"sbft","explanation":"形容心神不定。","source":{"text":"早是身体不快，又遇着这等人物，教我神不附体，何时是可也。","book":"元·白朴《东墙记》第一折"},"similar":["神不守舍"],"usage":"作谓语、定语、状语；用于惊慌等"},{"id":34477,"word":"神丧胆落","pinyin":"shén sàng dǎn luò","abbr":"ssdl","explanation":"形容心神极为惊恐不安。","source":{"text":"卷天下所有，曾不能供前敌之一败，而添购军械之款尚无所从出。于是赤手空拳，坐以待毙。向之主战者，乃始目瞪舌挢，神丧胆落，不敢出一语。","book":"清·谭嗣同《思纬氤氲台短书——报贝无徵》"},"usage":"作谓语、定语、状语；用于人的神态等"},{"id":34478,"word":"神乎其技","pinyin":"shén hū qí jì","abbr":"shqj","explanation":"形容技艺或手法十分高明。","source":{"text":"他仗着这个法子去拐骗金银，又乐得人人甘心被他拐骗，这才是神乎其技呢！","book":"《二十年目睹之怪现状》第三一回"},"example":{"text":"叫他们搞农艺，却要他们像一个终岁勤劳的农民；叫他们演戏，却要他们像一个～的明星，自然只有失望了。","book":"叶圣陶《倪焕之》十七"},"usage":"作宾语、定语、状语；用于技艺或手法等"},{"id":34479,"word":"神乎其神","pinyin":"shén hū qí shén","abbr":"shqs","explanation":"神：神妙；乎：语助词，表感叹。神秘奇妙到了极点。形容非常奇妙神秘。","source":{"text":"深之又深而能物焉，神之又神而能精焉。","book":"《庄子·天地》"},"example":{"text":"向日闻得古人有“袖占一课”之说，真是～。","book":"清·李汝珍《镜花缘》第七十五回"},"similar":["妙不可言"],"opposite":["不足为奇"],"usage":"作谓语、宾语、定语；指非常神秘"},{"id":34480,"word":"神交已久","pinyin":"shén jiāo yǐ jiǔ","abbr":"sjyj","explanation":"神交：精神上的交往。虽然没有见过面，但互相精神相通，仰慕已久。","source":{"text":"说里‘神交已久’，他接着便称赞仲昭的眼光是合乎他们社会心理学家的理论的。","book":"《追求》"},"example":{"text":"季高，神交已久！今天得睹丰采，让我想起一个人，林少穆。","book":"高阳《慈禧全传》二十三"},"usage":"作谓语、定语；用于交往等"},{"id":34481,"word":"神人共悦","pinyin":"shén rén gòng yuè","abbr":"srgy","explanation":"天神和凡人都感到高兴。多形容太平景象。","source":{"text":"天神和凡人都感到高兴。多形容太平景象。"},"usage":"作谓语、定语；用于局面"},{"id":34482,"word":"神人共愤","pinyin":"shén rén gòng fèn","abbr":"srgf","explanation":"神和人都愤恨。形容民愤极大。","source":{"text":"肆行暴虐，人神共愤，法令不容。","book":"唐·骆宾王《讨武曌檄》：“人神之所共忌，天地之所不容。”《旧唐书·于柚传》"},"example":{"text":"他很有自知之明，父子俩作恶多端，～。","book":"高阳《草莽英雄》第十三章"}},{"id":34483,"word":"神人鉴知","pinyin":"shén rén jiàn zhī","abbr":"srjz","explanation":"鉴：审察。天神和凡人都察知。多用为起誓时表白之辞。","source":{"text":"一点丹衷，神人鉴知。","book":"明·朱鼎《玉镜台记·新亭流涕》"},"usage":"作谓语、分句；多用于起誓"},{"id":34484,"word":"神仙中人","pinyin":"shén xiān zhōng rén","abbr":"sxzr","explanation":"对容貌端美，神态飘逸者的美称。","source":{"text":"孟昶窥见之，叹曰：此真神仙中人也。","book":"《晋书·王恭传》"},"example":{"text":"清·余怀《板桥杂记·轶事》：“夜以继日，恒酒酣歌，纶巾鹤氅，真～也。”"},"opposite":["凡夫俗子"],"usage":"作宾语；指人的外貌与气质","story":["晋朝时期，王右军长相英俊秀美，一次他见到杜弘治，见他脸象凝固的白脂，眼珠如同点染的黑漆，赞叹说他是神仙中人。当时有人称赞王右军的长相秀美，认为他很美，蔡公说：“遗憾诸位没有见到过杜弘治呀。”"]},{"id":34485,"word":"神会心契","pinyin":"shén huì xīn qì","abbr":"shxq","explanation":"互相之间，内心理解并相投合。","source":{"text":"京从兄襄深悟厥旨，其书为本朝第一。而京独神会心契，得之于心，应之于手，可与方驾。","book":"宋·赵佶《宣和书谱·行书六·王安石》"},"usage":"作谓语、定语；用于交往等"},{"id":34486,"word":"神会心融","pinyin":"shén huì xīn róng","abbr":"shxr","explanation":"犹言融会贯通。把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"余悉屏去传注，独取遗经，精思至四十春秋，一旦神会心融，灼见圣贤之大指。","book":"明·宋濂《元隐君子东阳陈公先生鹿皮子墓志铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":34487,"word":"神佛不佑","pinyin":"shén fó bù yòu","abbr":"sfby","explanation":"佑：保佑。形容人作恶多端或行为恶劣，连神仙和佛祖都不保佑。"},{"id":34488,"word":"神使鬼差","pinyin":"shén shǐ guǐ chà","abbr":"ssgc","explanation":"好像有鬼神在支使着一样，不自觉地做了原先没想到要做的事。同“神差鬼使”。","source":{"text":"当他刚从米市坝朱凉粉家里串了门子出来的时侯，忽然神使鬼差地一下停在街心。","book":"沙汀《范老老师》"},"similar":["鬼使神差","神差鬼使","神差鬼遣"],"usage":"作宾语、定语；用于处事等"},{"id":34489,"word":"神兵天将","pinyin":"shén bīng tiān jiāng","abbr":"sbtj","explanation":"比喻英勇善战、行动迅捷的军队。","source":{"text":"有一支红军部队像神兵天将一样，一天前进一百五十里。","book":"魏善成《打县城迎红军》"},"example":{"text":"你们向东走那会，我们就知道你们一定会回来的，可没想到你们回来得这样快。真是毛主席的～！","book":"萧剑飞《战斗在临江》"},"similar":["天兵天将","天兵神将"],"usage":"作宾语、定语；用于军事等"},{"id":34490,"word":"神出鬼入","pinyin":"shén chū guǐ rù","abbr":"scgr","explanation":"出：出现。象神鬼那样出没无常。形容出没无常，不可捉摸。后泛指行动变化迅速。","source":{"text":"善者之动也，神出而鬼行。","book":"《淮南子·兵略训》"},"example":{"text":"禇一官是怕得～，只有他个女儿降得住他。","book":"清·文康《儿女英雄传》第十四回"},"similar":["神出鬼没"],"usage":"作谓语、状语、定语；指变化无常"},{"id":34491,"word":"神出鬼没","pinyin":"shén chū guǐ mò","abbr":"scgm","explanation":"出：出现；没：消失。象神鬼那样出没无常。形容出没无常，不可捉摸。后泛指行动变化迅速。","source":{"text":"善者之动也，神出而鬼行。","book":"《淮南子·兵略训》"},"example":{"text":"抗日游击队～，打得日本鬼子魂飞魄散。"},"similar":["出没无常","神妙莫测"],"opposite":["按兵不动"],"usage":"作谓语、状语、定语；指变化无常"},{"id":34492,"word":"神出鬼行","pinyin":"shén chū guǐ xíng","abbr":"scgx","explanation":"出：显露；没：隐灭。形容行动出没无常，变化神奇，不可捉摸。","source":{"text":"善者之动也，神出鬼行，星曜而玄逐。","book":"西汉·刘安《淮南子·兵略论》"},"example":{"text":"黄石公兵略，～。","book":"清·翟灏《通俗编·神鬼·神出鬼没》"},"similar":["神出鬼没","神出鬼入"],"usage":"作谓语、状语、定语；指变化无常"},{"id":34493,"word":"神分志夺","pinyin":"shén fēn zhì duó","abbr":"sfzd","explanation":"精神分散，志气丧失。","source":{"text":"守京师者能聚不能散，御外侮者能进不能退，纷纷籍籍，神分志夺，国家之事，能不为阁下忧乎？","book":"《元史·张桢传》"},"usage":"作谓语、定语；用于书面语"},{"id":34494,"word":"神到之笔","pinyin":"shén dào zhī bǐ","abbr":"sdzb","explanation":"犹言神来之笔。形容作品文句精彩。","source":{"text":"沈启南先生为作《梅花主人图》，世称神到之笔，惜未及见。","book":"清·龚炜《巢林笔谈续编·梅花主人传》"},"similar":["神至之笔"],"usage":"作宾语；多用于文学作品等"},{"id":34495,"word":"神功圣化","pinyin":"shén gōng shèng huà","abbr":"sgsh","explanation":"指帝王的功绩和教化。旧时对人君的颂扬之辞。","source":{"text":"兴利除害甚于嗜欲，攘击奸恶如报私仇，首尾数年之间遂成冠古之治，虽神功圣化敏妙自然，亦此曹献替可否之力也。","book":"宋·秦观《任臣策下》"},"usage":"作宾语、定语；用于颂扬君王等"},{"id":34496,"word":"神动色飞","pinyin":"shén dòng sè fēi","abbr":"sdsf","explanation":"脸上显出极为生动的表情。","source":{"text":"妾本巫山神女，适见楚国襄王，谈妾往事，遂尔神动色飞。","book":"明·王錂《春芜记·宸游》"},"similar":["眉飞色舞","神飞色动"],"usage":"作谓语、定语；用于人的神态"},{"id":34497,"word":"神劳形瘁","pinyin":"shén láo xíng cuì","abbr":"slxc","explanation":"瘁：劳累。指精神和身体都极度劳累。","source":{"text":"治诸侯，练士卒，神劳形瘁，有所不恤。","book":"明·许仲琳《封神演义》第三十一回"},"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34498,"word":"神区鬼奥","pinyin":"shén qū guǐ ào","abbr":"sqga","explanation":"指神奇深幽的地方。","source":{"text":"夫莽苍之际，小丘卷石，古树数株，花落水流，令人神思爽然，况天閟地藏，神区鬼奥邪！","book":"明·归有光《书斋铭》"},"usage":"作宾语、定语；用于书面语"},{"id":34499,"word":"神号鬼哭","pinyin":"shén háo guǐ kū","abbr":"shgk","explanation":"号：哭。形容大声哭叫，声音凄厉。","source":{"text":"十五十六天轮地轴，日面月面神号鬼哭。","book":"《古尊宿语录·云峰悦禅师》"},"example":{"text":"此时北京城内百姓黎民，一个个鼠撺狼奔，一家家～。","book":"《水浒传》第六六回"},"similar":["鬼哭神号"],"usage":"作谓语、状语、定语；指大哭"},{"id":34500,"word":"神号鬼泣","pinyin":"shén hào guǐ qì","abbr":"shgq","explanation":"形容大声哭叫，声音凄厉。同“神号鬼哭”。","source":{"text":"尽是黄金，这海岸，摩天壁立。任掠夺，大洋风雨，神号鬼泣。","book":"陈毅《满江红·黄金海岸》词"},"similar":["神嚎鬼哭","神号鬼哭"],"usage":"作谓语、定语、状语；用于书面语"},{"id":34501,"word":"神哗鬼叫","pinyin":"shén huá guǐ jiào","abbr":"shgj","explanation":"形容大喊大叫。","source":{"text":"两三个牢头忙上前来捉时，早被他一顿抽拔拳，都打得死去活转来，便就神哗鬼叫的打将出来。","book":"《何典》第九回"},"similar":["大喊大叫"],"usage":"作定语、状语；用于口语"},{"id":34502,"word":"神嚎鬼哭","pinyin":"shén háo guǐ kū","abbr":"shgk","explanation":"形容大声哭叫，声音凄厉。同“神号鬼哭”。","source":{"text":"可怎生神嚎鬼哭，雾惨云昏，白日为幽。","book":"元·无名氏《马陵道》第二折"},"example":{"text":"真真气煞人！今天那贱人忽然嚷起肚子痛来，嚷了个～，我见他这样辛苦，便来请先生。","book":"《二十年目睹之怪现状》第二五回"},"similar":["神愁鬼哭","神号鬼哭","神号鬼泣"],"usage":"作谓语、定语、状语；用于书面语"},{"id":34503,"word":"神圣工巧","pinyin":"shén shèng gōng qiǎo","abbr":"ssgq","explanation":"中医对望、闻、问、切四种方法的别称。","source":{"text":"望而知之谓之‘神’，闻而知之谓之‘圣’，问而知之谓之‘工’，切脉而知之谓之‘巧’。","book":"《难经·神圣工巧》"},"similar":["望闻问切"],"usage":"作主语、宾语、定语；用于中医"},{"id":34504,"word":"神头鬼脸","pinyin":"shén tóu guǐ liǎn","abbr":"stgl","explanation":"①形容不愉快的脸色。②喻蓬头乱发，不加修饰。","source":{"text":"硬鼻凹寒森森扫下雪来，冷脸似冬凌块，夕斗毛齐眼睛向下排，则是个敲人脑的活妖怪，动不动神头鬼脸，投河奔井。","book":"元·武汉臣《玉壶春》第三折"},"example":{"text":"他懒得动，可是要马上恢复他的干净利落，他不肯就这么～的进城去。不过，要干净就得花钱，剃剃头，换换衣服，买鞋袜，都要钱。","book":"老舍《骆驼祥子》四"},"similar":["神头鬼面"],"usage":"作谓语、定语、状语；用于人的外表"},{"id":34505,"word":"神头鬼面","pinyin":"shén tóu guǐ miàn","abbr":"stgm","explanation":"比喻怪模怪样。","source":{"text":"夫古人之诗，本岂有意于平淡哉。但对今之狂怪雕锼、神头鬼面，则见其平。","book":"宋·朱熹《答巩仲至》"},"example":{"text":"句雕字锼，叫噪赘牙，～，以为新奇。","book":"明·叶盛《水东日记》卷二十六"},"similar":["神头鬼脸"],"usage":"作谓语、宾语、定语；指故弄玄虚"},{"id":34506,"word":"神奇腐朽","pinyin":"shén qí fǔ xiǔ","abbr":"sqfx","explanation":"指好和坏、无用和有用两种事物。","source":{"text":"鼠肝虫臂万化途，神奇腐朽相推迁。","book":"金·元好问《食榆荚》"},"example":{"text":"天壤内、～，有所穷已。","book":"元·刘敏中《满江红》词"}},{"id":34507,"word":"神奇臭腐","pinyin":"shén qí chòu fǔ","abbr":"sqcf","explanation":"指好和坏、无用和有用两种事物。","source":{"text":"老去凭谁说？看几番神奇臭腐，夏裘冬葛。","book":"宋·陈亮《贺新郎·寄辛幼安和见怀韵》"}},{"id":34508,"word":"神奇荒怪","pinyin":"shén qí huāng guài","abbr":"sqhg","explanation":"指事情奇异怪诞。","source":{"text":"顾以三十年之久，劳动心口耳目，琐琐从事于神奇荒怪，索墨费纸。","book":"宋·洪迈《夷坚丁志序》"}},{"id":34509,"word":"神奇莫测","pinyin":"shén qí mò cè","abbr":"sqmc","explanation":"莫测：不能揣测、估量。形容奇妙到极点。","source":{"text":"这个汪士荣年方四十，莫慧明断，～，策反了王辅臣与孙延龄的两次大功。 ★三月夫《吴三桂》二十四"}},{"id":34510,"word":"神女生涯","pinyin":"shén nǚ shēng yá","abbr":"snsy","explanation":"指妓女生活。","source":{"text":"神女生涯元是梦，小姑居处本无郎。","book":"战国·楚·宋玉《神女赋序》：“楚襄王与宋玉游于云梦之浦，使玉赋高唐之事，其夜王寝，梦与神女遇。”唐·李商隐《无题》诗"},"example":{"text":"唐·李商隐《无题》诗：“～元是梦，小姑居处本无郎。”"},"usage":"作主语、宾语、定语；用于书面语"},{"id":34511,"word":"神奸巨猾","pinyin":"shén jiān jù huá","abbr":"sjjh","explanation":"指有势力的奸狡恶人。同“神奸巨蠹”。","source":{"text":"过去政府虽有所惩治，然仅窃钩者诛耳，神奸巨猾未损毫末。","book":"邹韬奋、茅盾等《我们对于国事的态度和主张》"},"similar":["神奸巨蠹"],"usage":"作宾语、定语；用于为人等"},{"id":34512,"word":"神奸巨蠹","pinyin":"shén jiān jù dù","abbr":"sjjd","explanation":"指有势力的奸狡恶人。","source":{"text":"有婪官利其赃利，致之死而灭口者；有神奸巨蠹，恐其幸脱而立取病呈者。","book":"清·黄六鸿《福惠全书·刑名·监禁》"},"similar":["神奸巨猾"],"usage":"作宾语、定语；用于为人等"},{"id":34513,"word":"神妙莫测","pinyin":"shén miào mò cè","abbr":"smmc","explanation":"莫测：不能揣测、估量。形容奇妙到极点。","source":{"text":"峡中，强烈的阳光与乳白色云雾交织一处，数步之隔，这边是阳光，那边是云雾，真是神妙莫测。","book":"刘白羽《长江三日》"}},{"id":34514,"word":"神安气定","pinyin":"shén ān qì dìng","abbr":"saqd","explanation":"内心十分安定。","source":{"text":"下虔心，苦志挫锐摧强；忘宠辱，自得神安气定。","book":"金·王丹桂《洞仙歌·示门人》"},"usage":"作谓语、定语；指内心安定"},{"id":34515,"word":"神安气集","pinyin":"shén ān qì jí","abbr":"saqj","explanation":"精神安定，气息凝集。","source":{"text":"拿些姜汤灌他，他微微开口，咽了去了；又调些粥汤来灌他，弄了三四更天气，看看苏醒，神安气集。","book":"《初刻拍案惊奇》卷五"},"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34516,"word":"神完守固","pinyin":"shén wán shǒu gù","abbr":"swsg","explanation":"神：精神；完：完美；守：操守。精神饱满，坚持操守。","source":{"text":"苟可以寓其巧智，使机应于心，不挫于气，财神完而守固。","book":"唐·韩愈《送高闲上人序》"},"usage":"作谓语、定语；用于书面语"},{"id":34517,"word":"神完气足","pinyin":"shén wán qì zú","abbr":"swqz","explanation":"神气十分舒畅。常形容文章首尾贯穿，一气呵成。","source":{"text":"文字不相上下，神完气足，俱是作家。","book":"清·夏敬渠《野叟曝言》第九回"},"example":{"text":"吴小如《京剧老生流派综说》：“余民本来体弱气单，在唱工方面每感力不从心，于是他注意换气偷气，力争～。”"},"usage":"作谓语、宾语；用于书面语"},{"id":34518,"word":"神州华胄","pinyin":"shén zhōu huá zhòu","abbr":"szhz","explanation":"神州：指中国。我国古代华夏族的后裔。统指中国人。","source":{"text":"况且我们是～，敢不“绳其祖武”么？ ★鲁迅《华盖集·忽然想到》"},"usage":"作宾语、定语；指中国人"},{"id":34519,"word":"神州赤县","pinyin":"shén zhōu chì xiàn","abbr":"szcx","explanation":"后遂以“赤县神州”或“神州赤县”为中国的别称。","source":{"text":"战国时齐人邹衍称华夏之地为“赤县神州”。见《史记·孟子荀卿列传》。"},"example":{"text":"盖～，尊有所厌，非他土之比。","book":"唐·刘禹锡《为京兆尹答于襄州第一书》"},"similar":["赤县神州"],"usage":"作主语、宾语；指中原或中国"},{"id":34520,"word":"神州陆沉","pinyin":"shén zhōu lù chén","abbr":"szlc","explanation":"神州：指中国；陆沉：陆地无水而沉。中国大陆沉沦。比喻领土被敌人侵占。","source":{"text":"桓公入洛，过淮、泗，践北境，与诸僚属登平栾楼，眺瞩中原，慨然曰：‘遂使神州陆沉，百年丘虚，王夷甫诸人不得不任其责！’","book":"南朝·宋·刘义庆《世说新语·轻诋》"},"example":{"text":"现在虽然不是～的时候，我们军事防备还是不能掉以轻心。"},"usage":"作宾语、定语；指土地沦丧","story":["公元306年，司马越毒死晋惠帝，立晋怀帝，自己与清谈派首领“口中雌黄”的王衍把持朝政，结果政权被北方匈奴刘渊推翻。20多年后东晋明帝派桓温率军收复洛阳，桓温不胜感慨王衍等人使神州陆沉，繁华的洛阳变成一片废墟"]},{"id":34521,"word":"神工天巧","pinyin":"shén gōng tiān qiǎo","abbr":"sgtq","explanation":"形容建筑、布置的奇妙，非人力所能为。","source":{"text":"方寺之未大时，便房曲道各自为家，山川之胜蔽亏隔阂者十六七……矧今制度一新，神工天巧廓然披露，可以岸巾凭几而尽得之。","book":"宋·秦观《录宝林事实》"},"similar":["神工意匠"],"usage":"作宾语、定语；用于书面语"},{"id":34522,"word":"神工妙力","pinyin":"shén gōng miào lì","abbr":"sgml","explanation":"指功夫极其高超，几非人力所能为。","source":{"text":"譬如娲皇，神工妙力，炼石补天。","book":"宋·李清臣《钦圣宪肃皇后哀册文》"},"usage":"作宾语、定语；用于书面语"},{"id":34523,"word":"神工意匠","pinyin":"shén gōng yì jiàng","abbr":"sgyj","explanation":"形容建筑、绘画等构思精妙，非人力所能为。","source":{"text":"叹观止，凤凰堂，置身恍在千年上。岂只是象教庄严继盛唐？更别有神工意匠。","book":"赵朴初《平等院》诗"},"similar":["神工天巧"],"usage":"作宾语、定语；用于书面语"},{"id":34524,"word":"神工鬼力","pinyin":"shén gōng guǐ lì","abbr":"sggl","explanation":"比喻神奇超人的力量。","source":{"text":"一路之间，提起朱亮祖三字，便胆战心寒，说总有神工鬼力，那有这等奇异。","book":"《英烈传》第四二回"},"similar":["鬼斧神工"],"usage":"作宾语、定语；用于比喻句"},{"id":34525,"word":"神工鬼斧","pinyin":"shén gōng guǐ fǔ","abbr":"sggf","explanation":"象是鬼神制作出来的。形容艺术技艺高超，不是人力所能达到的。","source":{"text":"晶荧龙宫献，错落鬼斧镌。","book":"《庄子·达生》：“梓庆削木为鐻，鐻成，见者惊忧鬼神。”《南史·谢惠连传》：“此语有神工，非吾语也。”元·吴莱《大食瓶》诗"},"example":{"text":"二树画梅，题七古一篇，迭“须”字韵八十余首，～，愈出愈奇。","book":"清·袁枚《随园诗话》卷六"},"similar":["鬼斧神工"],"usage":"作谓语、宾语、定语；形容艺术技艺高超"},{"id":34526,"word":"神差鬼使","pinyin":"shén chāi guǐ shǐ","abbr":"scgs","explanation":"好像有鬼神在支使着一样，不自觉地做了原先没想到要做的事。","source":{"text":"这一场悄促促似鬼使神差。","book":"元·无名氏《碧桃花》第四折"},"example":{"text":"总是王四穷凶极恶，天理必除，故～，做出这样勾当。","book":"明·东鲁古狂生《醉醒石》第九回"},"similar":["鬼使神差","神差鬼遣","神谋魔道"],"usage":"作定语、状语；同“鬼使神差”"},{"id":34527,"word":"神差鬼遣","pinyin":"shén chà guǐ qiǎn","abbr":"scgq","explanation":"好像有鬼神在支使着一样，不自觉地做了原先没想到要做的事。同“神差鬼使”。","source":{"text":"龚丈不物‘夏官’二字不敢用，且‘周官’二字亦不也用，卒不得差。神差鬼遣，一似龚丈兵部资格专为周舍人效力也者，何其巧耶！","book":"清·何刚德《春明梦录》卷上"},"similar":["鬼使神差","神差鬼使","神使鬼差"],"usage":"作宾语、定语；用于处事等"},{"id":34528,"word":"神彩奕奕","pinyin":"shén cǎi yì yì","abbr":"scyy","explanation":"奕奕：精神焕发的样子。形容精神旺盛，容光焕发。","source":{"text":"自幼神彩奕奕，善读书，言动如成人。","book":"明·朱国桢《资德大夫正治上卿高先生墓志铭》"},"example":{"text":"旁边一个人，举起了手，五指齐舒，又张开了口，双眼看着盘内，真是～。","book":"清·吴趼人《二十年目睹之怪现状》第45回"},"similar":["神采奕奕","神采焕发"],"opposite":["没精打采"],"usage":"作谓语、定语、状语；指人的精神面貌"},{"id":34529,"word":"神彩飞扬","pinyin":"shén cǎi fēi yáng","abbr":"scfy","explanation":"飞扬：精神焕发。形容兴奋得意，精神焕发的样子。","source":{"text":"夫差年已五旬以上，面染风霜，多了皱纹，但还是神彩飞扬。","book":"曹禺《胆剑篇》第五幕"},"similar":["神采飞扬"],"usage":"作谓语、定语、状语；用于人的精神面目"},{"id":34530,"word":"神往心醉","pinyin":"shén wǎng xīn zuì","abbr":"swxz","explanation":"欣喜若狂或神不自主的状态。","source":{"text":"这酒的滋味使他～。"},"example":{"text":"这酒的滋味使他～"},"similar":["令人神往"],"usage":"作谓语、定语；指人的心理状态"},{"id":34531,"word":"神往神来","pinyin":"shén wǎng shén lái","abbr":"swsl","explanation":"指精神相通。","source":{"text":"假令以《古诗十九首》与少陵作，便是首首皆意；假令以《石壕》诸什与古人作，便是首首皆情，比皆有神往神来，不知而自至之妙。","book":"明·陆时雍《〈诗镜〉总论》"},"usage":"作谓语、定语；用于书面语"},{"id":34532,"word":"神必据我","pinyin":"shén bì jù wǒ","abbr":"sbjw","explanation":"据：保佑。旧指神道一定保佑我。","source":{"text":"吾享祀丰絜，神必据我。","book":"《左传·僖公五年》"}},{"id":34533,"word":"神志不清","pinyin":"shén zhì bù qīng","abbr":"szbq","explanation":"神志错乱或精神错乱。","source":{"text":"弟子方才被什么妖人迷住，弄得身不由己、神志不清。","book":"清·无垢道人《八仙全传》第12回"},"example":{"text":"他有些～，少理会他。"},"similar":["神智不清"],"usage":"作谓语、定语；指精神错乱"},{"id":34534,"word":"神态自若","pinyin":"shén tài zì ruò","abbr":"stzr","explanation":"神态：神情；自若：如常，象原来的样子。神情脸色毫无异样。形容态度镇静。","source":{"text":"文王曰：‘嗣宗毁顿如此，君不能共忧之，何谓？且有疾而饮酒食肉，固丧礼也。’籍饮啖不辍，神色自若。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"七怪见丘处机连喝二十八碗酒，竟是面不改色，～，尽皆骇然。","book":"金庸《射雕英雄传》第二回"},"similar":["神情自若"],"usage":"作谓语、定语、状语；用于处事等"},{"id":34535,"word":"神怒人弃","pinyin":"shén nù rén qì","abbr":"snrq","explanation":"指罪恶极大，以至天神震怒，被百姓抛弃。","source":{"text":"权侔人主，威震天下，然怙侈灭德，神怒人弃。","book":"唐·柳泽《论时政书》"},"similar":["神怒人怨"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34536,"word":"神怒人怨","pinyin":"shén nù rén yuàn","abbr":"snry","explanation":"指人人怨恨愤怒。","source":{"text":"兆庶流离，转尸蔽野，货赂公行，帑藏损耗，神怒人怨，众叛亲离。","book":"《南史·傅縡传》"},"similar":["神怒民怨","神怒民痛"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34537,"word":"神怒天诛","pinyin":"shén nù tiān zhū","abbr":"sntz","explanation":"罪大恶极，神灵震怒，天意欲加诛杀。","source":{"text":"天不长慝，神实正直，神怒天诛，未始有极。","book":"唐·欧阳詹《暗室箴》"},"similar":["神怒人弃"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34538,"word":"神怒民叛","pinyin":"shén nù mín pàn","abbr":"snmp","explanation":"天神愤怒，百姓背叛。形容作恶太甚，引进极大愤怒。","source":{"text":"神怒民叛，何以能久？赵孟不复年矣。神怒，不歆其祀；民叛，不即其事。祀事不从，又何以年？","book":"《左传·昭公元年》"}},{"id":34539,"word":"神怒民怨","pinyin":"shén nù mín yuàn","abbr":"snmy","explanation":"形容民愤极大。同“神怒民痛”。","source":{"text":"师旷退，谓羊舌肹曰：‘神怒民怨，君不久矣！’","book":"《东周列国志》第六八回"},"similar":["神怒鬼怨","神怒民痛","神怒人怨"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34540,"word":"神怒民痛","pinyin":"shén nù mín tòng","abbr":"snmt","explanation":"犹人神共愤。形容民愤极大。","source":{"text":"不思谤讟，不惮鬼神，神怒民痛，不悛于心。","book":"《晏子春秋·外篇上七》"},"example":{"text":"斩钊民力，输掠其聚，肆行非度，～。","book":"宋·王观国《学林·秘祝官》"},"similar":["神怒民怨","神怒人怨"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34541,"word":"神怒鬼怨","pinyin":"shén nù guǐ yuàn","abbr":"sngy","explanation":"作恶多端，使鬼神都为之愤怒。","source":{"text":"皇后谏陛下造此惨刑，神怒鬼怨，屈魂无申。","book":"明·许仲琳《封神演义》第二十七回"},"similar":["神怒民怨"],"usage":"作宾语、定语、状语；用于处事等"},{"id":34542,"word":"神思恍惚","pinyin":"shén sī huǎng hū","abbr":"sshh","explanation":"神思：精神，心绪；恍惚：神智不清。指心神不定，精神不集中。","source":{"text":"一者是心中不足，二者是神思恍惚，恰合眼父子相逢，正数说当年间阻，忽然的好梦惊回。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"况近日每觉～，病已渐成。","book":"清·曹雪芹《红楼梦》第三十二回"},"similar":["神魂颠倒","神情恍惚"],"opposite":["泰然处之","谈笑自若"],"usage":"作谓语；形容人神情不安定"},{"id":34543,"word":"神怡心旷","pinyin":"shén yí xīn kuàng","abbr":"syxk","explanation":"精神愉悦，心胸开阔。同“心旷神怡”。","source":{"text":"不一时，只听得箫管悠扬，笙笛并发；正值风清气爽之时，那乐声穿林度水而来，自然使人神怡心旷。","book":"《红楼梦》第四一回"},"similar":["心旷神怡"],"usage":"作谓语、状语；指人的心境"},{"id":34544,"word":"神怡心醉","pinyin":"shén yí xīn zuì","abbr":"syxz","explanation":"精神愉快，内心陶醉。","source":{"text":"听到后边，一回儿象尽是歌声，一回儿象尽是笛声，真听得神怡心醉。","book":"清·褚人获《隋唐演义》第四十七回"},"usage":"作谓语、状语；用于人的心情等"},{"id":34545,"word":"神怡心静","pinyin":"shēn yí xīn jìng","abbr":"syxj","explanation":"怡：愉快。精神愉快，心境平和。","source":{"text":"在昔暇日，味存林岭。今我斯游，神怡心静。","book":"晋·王肃之《兰亭四言》"}},{"id":34546,"word":"神怿气愉","pinyin":"shén yì qì yú","abbr":"syqy","explanation":"形容欢欣愉快。","source":{"text":"移故海宁寺钟置楼上以属沧浪亭，浮屠时其撞击，铿鍧朝夕，由是苏之士民神怿气愉，而瞻听益严以悚。","book":"清·薛福成《重建苏州南禅寺钟楼记》"},"usage":"作谓语、定语；用于书面语"},{"id":34547,"word":"神情不属","pinyin":"shén qíng bù shǔ","abbr":"sqbs","explanation":"犹言心不在焉。心思不在这里。指思想不集中。","source":{"text":"虽然谈话换了方向，静还是神情不属地随口敷衍。","book":"茅盾《幻灭》二"},"usage":"作定语、状语；用于书面语"},{"id":34548,"word":"神情恍惚","pinyin":"shén qíng huǎng hū","abbr":"sqhh","explanation":"神志不清，心神不定。","source":{"text":"悦自杀岳后，神情恍惚，不复如常。","book":"《魏书·侯莫陈悦传》"},"example":{"text":"清·曹雪芹《红楼梦》第113回：“刘姥姥看着凤姐骨瘦如柴，～，心里也就悲惨起来。”"},"similar":["精神恍惚","神思恍惚"],"opposite":["泰然自若"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":34549,"word":"神情自若","pinyin":"shén qíng zì ruò","abbr":"sqzr","explanation":"自若：自然，不变常态。神情态度仍和原来一样。","source":{"text":"举出最普通的例子来说，当你随便走进一家澡堂的时候，你就会发现有些老工人，能够在滚开的热水中拧手巾，神情自若，并不烫手。","book":"马南邨《燕山夜话·编一套“特技”丛书吧》"},"example":{"text":"周培公～地瞟了一眼王辅臣，带着轻蔑的微笑开口了。","book":"二月河《康熙大帝》第二卷第四十四章"},"similar":["神态自若"],"usage":"作谓语、定语、状语；用于处事等"},{"id":34550,"word":"神惊鬼怕","pinyin":"shén jīng guǐ pà","abbr":"sjgp","explanation":"让神仙吃惊，让鬼神害怕。形容人的武艺勇猛过人或技艺十分高超","source":{"text":"那士信足智多谋，熟于兵法，人号为‘小张飞’，使有一条铁鞭，神惊鬼怕。","book":"明·郭勋《英烈传》第21回"},"usage":"作定语、状语；用于书面语"},{"id":34551,"word":"神愁鬼哭","pinyin":"shén chóu guǐ kū","abbr":"scgk","explanation":"形容十分愁苦凄惨。","source":{"text":"吴国内甚惊恐，每发兵来交锋败北，端的神愁鬼哭。","book":"明·陆采《怀香记·飞报捷音》"},"example":{"text":"明·冯梦龙《警世通言》第40卷：“愁云蔽日，杀气漫空。地覆天翻，～。”"},"similar":["神嚎鬼哭"],"usage":"作谓语、定语、状语；用于书面语"},{"id":34552,"word":"神意自若","pinyin":"shén yì zì ruò","abbr":"syzr","explanation":"神情脸色毫无异样。形容态度镇静。同“神色自若”。","source":{"text":"宰夫励刃而欲前，坐客垂涎而思噬，而犹神意自若，低回睥睨不知祸期之行至。","book":"金·王若虚《哀雁词》"},"similar":["神色自若","神气自若","神色自如"],"usage":"作谓语、定语、状语；指人非常镇定"},{"id":34553,"word":"神憎鬼厌","pinyin":"shén zēng guǐ yàn","abbr":"szgy","explanation":"憎：憎恨；厌：讨厌。连鬼神都讨厌。形容十分让人憎恨讨厌。","source":{"text":"他这样做落得个～的下场。"},"example":{"text":"他这样做落得个～的下场"},"opposite":["人见人爱"],"usage":"作谓语、定语；指让人讨厌"},{"id":34554,"word":"神抶电击","pinyin":"shén chì diàn jī","abbr":"scdj","explanation":"指如神电之笞击。比喻进击疾速。","source":{"text":"言士卒皆如神电之击禽兽。","book":"《文选·扬雄〈羽猎赋〉》：“壁垒天旋，神抶电击。”李善注引《埤苍》：“抶，笞击也。”。刘良注"},"usage":"作谓语、定语；用于比喻句"},{"id":34555,"word":"神摇意夺","pinyin":"shén yáo yì duó","abbr":"syyd","explanation":"神：精神；意：心意；摇、夺：形容不能自持。神情为某件事物所吸引，不能自持。","source":{"text":"朱注目久，不觉神摇意夺，恍然凝思，身忽飘飘，如驾云雾。","book":"清·蒲松龄《聊斋志异·画壁》"},"similar":["神志不清"],"usage":"作谓语、宾语、定语；指人神志不清"},{"id":34556,"word":"神摇目夺","pinyin":"shén yáo mù duó","abbr":"symd","explanation":"形容心神荡漾，目光被吸引。","source":{"text":"我神摇目夺的凝望着：近如方院，远如天文台，以及周围的高高下下的树，都逼射得出了红、蓝、黄的颜色。","book":"冰心《往事二》六"},"usage":"作谓语、定语、状语；用于人或事物等"},{"id":34557,"word":"神摇目眩","pinyin":"shén yáo mù xuàn","abbr":"symx","explanation":"眼花缭乱，心神摇荡。多形容所见情景令人惊异。","source":{"text":"今来宝刹，得睹人间未见之珍，令人目眩神摇，不知身在何世。","book":"明·徐渭《英烈传》第四十回"},"example":{"text":"每升御坐，辄～，见白衣人长数丈者在前立。","book":"清·陆次云《费宫人传》"},"similar":["目眩神摇"],"usage":"作谓语、定语；用于人或事物等"},{"id":34558,"word":"神摇魂荡","pinyin":"shén yáo hún dàng","abbr":"syhd","explanation":"心神恍惚，难以把持。","source":{"text":"沈将仕看见李三情状，一发神魂摇荡。","book":"明·凌濛初《二刻拍案惊奇》卷八"},"example":{"text":"曾朴《孽海花》第31回：“菊笑被彩云这一阵迷惑，早弄得～，不能自主。”"},"similar":["神魂摇荡","神魂飘荡"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34559,"word":"神施鬼设","pinyin":"shén shī guǐ shè","abbr":"ssgs","explanation":"施、设：指设计。如神鬼所做的一般。形容诗文十分精妙。","source":{"text":"神施鬼设，间见层出。","book":"唐·韩愈《贞曜先生墓志铭》"},"example":{"text":"某细味杜诗，皆于古人语句补缀为诗，平稳妥贴，若～。","book":"宋·胡仔《苕溪渔隐丛话前集·杜少陵六》"},"similar":["鬼斧神工","鬼设神施","鬼设神使"],"usage":"作谓语、定语、宾语；指安排极为巧妙"},{"id":34560,"word":"神昏意乱","pinyin":"shén hūn yì luàn","abbr":"shyl","explanation":"神志昏沉，心意乱。","source":{"text":"问所往，俱无知者。神昏意乱，木立不复能动。","book":"清·李心衡《金川琐记·陈生》"},"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34561,"word":"神智不清","pinyin":"shén zhì bù qīng","abbr":"szbq","explanation":"神智：意识。神志错乱或精神错乱。","source":{"text":"杨承福一定以为自己有痰疾，神智不清，怎还肯在他主人面前竭力保荐援引？","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["神志不清"],"usage":"作谓语、定语；指精神错乱"},{"id":34562,"word":"神术妙法","pinyin":"shén shù miào fǎ","abbr":"ssmf","explanation":"神妙高深的计策。","source":{"text":"师父当展神术妙法，可以立国安邦，显耀英豪也。","book":"明·无名氏《广成子》第二折"},"similar":["神术妙策","神谋妙策","神机妙策"],"usage":"作宾语、定语；用于计谋等"},{"id":34563,"word":"神术妙策","pinyin":"shén shù miào cè","abbr":"ssmc","explanation":"神妙莫测的计策。","source":{"text":"待教我神机妙策苦搜求，怎做的姜子牙能伐纣，张子房会兴刘。","book":"元·无名氏《连环计》第一折"},"similar":["神谋妙策","神机妙策","神术妙法"],"usage":"作宾语、定语；用于计谋等"},{"id":34564,"word":"神术妙计","pinyin":"shén shù miào jì","abbr":"ssmj","explanation":"指神妙莫测的计谋。","source":{"text":"今索请李靖军师，至边关用神术妙计可除番虏也。","book":"明·无名氏《阴山破虏》第一折"},"similar":["神术妙策","神谋妙策","神机妙策"],"usage":"作宾语、定语；用于计谋等"},{"id":34565,"word":"神机妙术","pinyin":"shén jī miào shù","abbr":"sjms","explanation":"机：心思；术：手段，策略。灵巧的心思，奇妙的谋划。形容计谋高明。","source":{"text":"杨戬神机妙术奇，吕岳空自费心机。","book":"明·许仲琳《封神演义》第58回"},"similar":["神机妙算","神机妙用"],"opposite":["束手无策"],"usage":"作谓语、宾语、定语；指人的决策等"},{"id":34566,"word":"神机妙用","pinyin":"shén jī miào yòng","abbr":"sjmy","explanation":"机：心思；术：手段，策略。灵巧的心思，奇妙的谋划。形容计谋高明。","source":{"text":"只有狱卒心里明白，伏他的神机妙用，受过重贿，再也不敢说破。","book":"明·凌濛初《二刻拍案惊奇》第39卷"},"similar":["神机妙算","神机妙术"],"usage":"作谓语、宾语、定语；指人的决策等"},{"id":34567,"word":"神机妙策","pinyin":"shén jī miào cè","abbr":"sjmc","explanation":"神妙的计策。","source":{"text":"待教我神机妙策苦搜求，怎样做的姜子牙能伐纣，张子房会兴刘。","book":"元·无名氏《连环计》第一折"},"example":{"text":"明·施耐庵《水浒传》第116回：“须用～，智取其关，方可调兵遣将。”"},"similar":["神谋妙策","神术妙策"],"usage":"作宾语、定语；用于计谋等"},{"id":34568,"word":"神机妙算","pinyin":"shén jī miào suàn","abbr":"sjms","explanation":"神、妙：形容高明；机、算：指计谋。惊人的机智，巧妙的计谋。形容善于估计复杂的变化的情势，决定策略。","source":{"text":"智算若神也。","book":"《后汉书·王涣传》：“又能以谲数发擿奸伏，京师称叹，以为涣有神算。”李贤注"},"example":{"text":"（周）瑜大惊，慨然叹日：‘孔明～，吾不如也。’","book":"明·罗贯中《三国演义》第四十六回"},"similar":["锦囊妙计"],"opposite":["无计可施","束手无策"],"usage":"作谓语、宾语、定语；指人的决策等","story":["东汉末年，刘备派诸葛亮到东吴去联吴抗曹，东吴大都督周瑜嫉妒诸葛亮的才能，设计让诸葛亮在三天内造出十万支箭。诸葛亮在夜间用二十只快船装上稻草人向曹军进攻，骗回曹操十万支箭，周瑜自叹不如诸葛亮那样神机妙算"]},{"id":34569,"word":"神机莫测","pinyin":"shén jī mò cè","abbr":"sjmc","explanation":"神妙的计谋使人难以预料。","source":{"text":"出入锐光八表，算神机莫测，天网难笼。","book":"金·丘处机《汉宫春·苦志》词"},"example":{"text":"这里面～。"},"similar":["神机难测"],"usage":"作谓语；指神妙的计谋使人难以预料"},{"id":34570,"word":"神机鬼械","pinyin":"shén jī guǐ xiè","abbr":"sjgx","explanation":"形容计谋阴险狡诈。","source":{"text":"要从地僻人稀处，设出神机鬼械谋。","book":"《二十年目睹之怪现状》第八七回"},"usage":"作宾语、定语；用于书面语"},{"id":34571,"word":"神来之笔","pinyin":"shén lái zhī bǐ","abbr":"slzb","explanation":"由神灵帮助而写出的作品。形容作品文句精彩。","source":{"text":"这三张东西，我自己画的也觉得意，真是神来之笔。","book":"清·吴趼人《二十年目睹之怪现状》第37回"},"example":{"text":"自己也觉得仿佛是～，如用别的韵语形式去写，便决不能有此力量。","book":"周作人《知堂回想录》"},"similar":["妙笔生花"],"opposite":["词不达意"],"usage":"作主语、宾语；用于文章或绘画等"},{"id":34572,"word":"神来气旺","pinyin":"shén lái qì wàng","abbr":"slqw","explanation":"犹言运气旺盛。","source":{"text":"这骰子虽无知觉，极有灵通，最是跟着人意兴走的。起初沈将仕神来气旺，胜采便跟着他走，所以连掷连赢。","book":"《二刻拍案惊奇》卷八"},"usage":"作谓语、定语；用于书面语"},{"id":34573,"word":"神枢鬼藏","pinyin":"shén shū guǐ cáng","abbr":"ssgc","explanation":"指神奇奥妙的兵书。","source":{"text":"圣人知自然之不可为，因以制之。至静之道，律历所不能契，爰有奇器，是生万象，八卦甲子，神枢鬼藏，阴阳相胜之术，昭昭乎进于象矣。","book":"《阴符经》"}},{"id":34574,"word":"神枪手","pinyin":"shén qiāng shǒu","abbr":"sqs","explanation":"射击技术十分高强的人。","source":{"text":"我打得更好，在部队我就是神枪手。","book":"王朔《浮出海面》"},"example":{"text":"他是全连有名的～。"},"usage":"作宾语、定语；用于口语"},{"id":34575,"word":"神武挂冠","pinyin":"shén wǔ guà guàn","abbr":"swgg","explanation":"指辞官隐居。","source":{"text":"南朝梁陶弘景“家贫，求宰县不遂。永明十年，脱朝服挂神武门，上表辞禄”。见《南史·隐逸传下·陶弘景》。"},"example":{"text":"清·王夫之《石崖先生传略》：“置吾兄于～，华顶高服之间，而兄亦不受。”"},"usage":"作宾语、定语；用于书面语","story":["南朝时期，梁国的陶弘景，自幼家贫，经过苦读而入仕，他没有当上大官，在一次求一个县官失败后，对官场的尔虞我诈十分厌倦，就于永明十年，他就脱下朝服挂在神武门，上表辞官。辞官后，他就隐居山林"]},{"id":34576,"word":"神气十足","pinyin":"shén qì shí zú","abbr":"sqsz","explanation":"神气：自以为得意傲慢的神情。形容摆出一副自以为高人一等而了不起的样子。","source":{"text":"农会于是神气十足了。","book":"毛泽东《湖南农民运动考察报告》"},"example":{"text":"他总是在别人面前～。"},"similar":["神气活现"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指得意或傲慢的样子"},{"id":34577,"word":"神气扬扬","pinyin":"shén qì yáng yáng","abbr":"sqyy","explanation":"形容人精神焕发。","source":{"text":"俱见太宗不衫不履，褐衣裘而来，神气扬扬，邈与常异。","book":"宋·张君房《云笈七签》卷一百十二"}},{"id":34578,"word":"神气活现","pinyin":"shén qì huó xiàn","abbr":"sqhx","explanation":"自以为了不起而显示出来的得意和傲慢的样子。","source":{"text":"要不是他们神气活现说‘查得到’，那她干脆就去缝制新的了。","book":"《茅盾选集·委屈》"},"example":{"text":"你不要那样～！我不是你个人的英文秘书，我不写！","book":"邹韬奋《经历》"},"similar":["神气十足","自以为是"],"opposite":["奴颜婢膝","不耻下问"],"usage":"作谓语、定语、状语；指态度傲慢"},{"id":34579,"word":"神气自若","pinyin":"shén qì zì ruò","abbr":"sqzr","explanation":"神气：神情；自若：如常，象原来的样子。神情脸色毫无异样。形容态度镇静。","source":{"text":"寻为恪所攻，城陷，被执，神气自若。","book":"《晋书·沈劲传》"},"example":{"text":"一厅之中唯上首铁丐左一杯右一杯，～地吃酒。","book":"二月河《康熙大帝》四十五"},"similar":["神色自若","神意自若"],"usage":"作谓语、定语、状语；指人非常镇定"},{"id":34580,"word":"神气荒怪","pinyin":"shén qí huāng guài","abbr":"sqhg","explanation":"指事情奇异怪诞。","source":{"text":"顾以三十年之久，劳动心口耳目，琐琐从事于神气荒怪，索墨费纸。","book":"宋·洪迈《夷坚丁志序》"}},{"id":34581,"word":"神流气鬯","pinyin":"shén liú qì chàng","abbr":"slqc","explanation":"指精神气息流畅通达。","source":{"text":"夫奕叶承平，法守已定，庶事循习，玩愒易生，而君臣之相与如此，是以神流气鬯，天地太和。","book":"明·张居正《辛未会试程策·第一问》"},"usage":"作宾语、定语；用于书面语"},{"id":34582,"word":"神清气全","pinyin":"shén qīng qì quán","abbr":"sqqq","explanation":"神态清朗，元气充沛。","source":{"text":"自是神清气全，老无疾病。","book":"宋·洪迈《夷坚丙志·麻姑洞妇人》"},"usage":"作谓语、定语、状语；用于人的精神状态等"},{"id":34583,"word":"神清气朗","pinyin":"shén qīng qì lǎng","abbr":"sqql","explanation":"①形容人心神清爽。②形容人长得神态清明，气质爽朗。","source":{"text":"平旦时神清气朗，雍雍穆穆，就是尧舜世界。","book":"明·王守仁《传习录》卷下"},"example":{"text":"岳胜，济州人。生得面若凝脂，～。","book":"《杨家府演义》第十二回"},"similar":["神清气爽"],"usage":"作谓语、定语、状语；用于人心态等"},{"id":34584,"word":"神清气正","pinyin":"shén qīng qì zhèng","abbr":"sqqz","explanation":"神态清朗，气色纯正。","source":{"text":"则愿的朱颜不更，神清气正，万年欢乐永长生。","book":"明·无名氏《庆长生》第一折"},"usage":"作谓语、定语；用于书面语"},{"id":34585,"word":"神清气爽","pinyin":"shén qīng qì shuǎng","abbr":"sqqs","explanation":"①形容人神志清爽，心情舒暢。②形容人长得神态清明，气质爽朗。","source":{"text":"香风飒来，神清气爽，飘飘然有凌云之意。","book":"宋·李昉《太平广记》卷十七引唐·牛僧孺《续玄怪录·裴谌》"},"example":{"text":"长揖而坐，～，满坐风生，顾眄炜如也。","book":"宋·张君房《云笈七签》卷一一二"},"similar":["神清气朗"],"usage":"作谓语、定语、状语；用于人心态等"},{"id":34586,"word":"神清气茂","pinyin":"shén qīng qì mào","abbr":"sqqm","explanation":"指心神清朗，资质秀美。","source":{"text":"窃见秘书丞琅玡臣王暕，年二十一，字思晦，七叶重光，海内冠冕。神清气茂，允迪中和。","book":"南朝·梁·任昉《为萧扬州荐荐士表》"},"usage":"作谓语、定语；用于书面语"},{"id":34587,"word":"神清气闲","pinyin":"shén qīng qì xián","abbr":"sqqx","explanation":"形容人神态清朗，元气充沛。","source":{"text":"香风飒来，神清气爽，飘飘然有凌云之意。","book":"唐·李复言《续玄怪录·裴谌》"},"example":{"text":"话没落音，四阿哥胤祯一挑门帘，神清气闲地走了进来。","book":"二月河《康熙大帝》二十七"}},{"id":34588,"word":"神清骨秀","pinyin":"shén qīng gǔ xiù","abbr":"sqgx","explanation":"形容人长得神态清正，端庄秀美。","source":{"text":"我见你神清骨秀气飘萧，你是神仙，休得假推掉。","book":"明·陆采《明珠记·买药》"},"example":{"text":"清·魏秀仁《花月痕》第九回：“小岑、秋痕近前看那小照，画着道人，约有三十多岁，～。”"},"usage":"作谓语、定语；用于人的神态"},{"id":34589,"word":"神湛骨寒","pinyin":"shén zhàn gǔ hán","abbr":"szgh","explanation":"形容危惧。","source":{"text":"门在山坳间，不甚轩豁，而森碧上交，清流出其下，不觉神湛骨寒！","book":"明·徐弘祖《徐霞客游记·闽游日记后》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":34590,"word":"神灭形消","pinyin":"shén miè xíng xiāo","abbr":"smxx","explanation":"指死亡。","source":{"text":"夫神灭形消，遗声馀价，亦犹蝉壳蛇皮，兽迒鸟耳。","book":"北齐·颜之推《颜氏家训·名实》"},"usage":"作谓语、定语；指死亡"},{"id":34591,"word":"神焦鬼烂","pinyin":"shén jiāo guǐ làn","abbr":"sjgl","explanation":"形容火灾惨烈，众多的人被烧死。","source":{"text":"皆伐山通道，穷搜窟宅，神焦鬼烂。","book":"清·魏源《圣武记》第七卷"},"example":{"text":"～，天跳地踔，男女奔逃，破窗触户。","book":"清·康有为《大同书》甲部第二章"},"usage":"作谓语、定语；指火灾后"},{"id":34592,"word":"神牵鬼制","pinyin":"shén qiān guǐ zhì","abbr":"sqgz","explanation":"指受到多方面牵制而不能任意行事。","source":{"text":"千古上下之题品文艺者，看到传奇一种，当易心换眼，别置典刑，要知此种文字，作之可怜，出之不易……非若诗赋古文，容其得意疾书，不受神牵鬼制者。","book":"清·李渔《闲情偶寄·词曲·音律》"},"usage":"作宾语、定语；用于书面语"},{"id":34593,"word":"神目如电","pinyin":"shén mù rú diàn","abbr":"smrd","explanation":"神的眼睛相闪电一样明亮。指天理昭彰，报应不爽","source":{"text":"小人没处申诉，天理昭彰，神目如电。","book":"明·凌濛初《二刻拍案惊奇》第16卷"},"usage":"作宾语、定语；用于书面语"},{"id":34594,"word":"神眉鬼眼","pinyin":"shén méi guǐ yǎn","abbr":"smgy","explanation":"形容面部装出怪模样。","source":{"text":"不！我赶紧回学校去作成我的《观剧杂感》呢！再见，赤色的老赵！”周少濂把八卦赗戴上，神眉鬼眼的往外走。","book":"老舍《赵子曰》第九"},"usage":"作谓语、定语、状语；用于口语等"},{"id":34595,"word":"神眉鬼道","pinyin":"shén méi guǐ dào","abbr":"smgd","explanation":"形容花样多，有些神秘莫测。","source":{"text":"她是三十二三岁的寡妇，干净，爽快，作事麻利又仔细。在别处，有人嫌她太张道，主意多，时常有些神眉鬼道道儿的。","book":"老舍《骆驼祥子》七"},"usage":"作谓语、定语；用于口语等"},{"id":34596,"word":"神短气浮","pinyin":"shén duǎn qì fú","abbr":"sdqf","explanation":"指心性浅薄浮躁。","source":{"text":"盖各人病痛不同，大圣贤必有大精神，其主静只在寻常日用中。学者神短气浮，便须数十年静力，方得厚聚深培。","book":"明·高攀龙《困学记》"},"usage":"作谓语、定语、状语；用于处事等"},{"id":34597,"word":"神秘莫测","pinyin":"shén mì mò cè","abbr":"smmc","explanation":"不可理解的。","source":{"text":"所以同行都知道胡雪岩是个神秘莫测的‘大好佬’。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"面对这～的山洞，我感慨大自然造物的神奇。"},"similar":["神乎其神"],"usage":"作谓语、定语；指不可理解的"},{"id":34598,"word":"神竦心惕","pinyin":"shén sǒng xīn tì","abbr":"ssxt","explanation":"肃敬的样子。","source":{"text":"余尝读先生（陆九渊）录，至所谓分别‘义利之辨’者，乃使人斤斤焉神竦心惕，及过荆门，谒先生祠下，又低回久之不能去。","book":"明·张居正《荆六州题名记》"},"usage":"作谓语、定语；用于书面语"},{"id":34599,"word":"神算妙计","pinyin":"shén suàn miào jì","abbr":"ssmj","explanation":"神妙莫测的计谋。","source":{"text":"今索请李靖军师，至边关用神术妙计可除番虏也。","book":"明·无名氏《阴山破虏》第一折"},"example":{"text":"单是替天行道杏黄旗上的一个“天”字，还不够；总得再找出些“天意”来。这便是吴军师的～！","book":"茅盾《石碣》"},"similar":["神术妙策","神谋妙策","神机妙策"],"usage":"作宾语、定语；用于计谋等"},{"id":34600,"word":"神籁自韵","pinyin":"shén lài zì yùn","abbr":"slzy","explanation":"籁：声响。指天然之音自成韵律。","source":{"text":"瑶干千寻，无风而神籁自韵，琅琅然皆九奏八会之音也。","book":"汉·桓麟《西王母传》"},"usage":"作宾语、定语；用于书面语"},{"id":34601,"word":"神经过敏","pinyin":"shén jīng guò mǐn","abbr":"sjgm","explanation":"①症状名。神经系统的感觉机能异常锐敏，神经衰弱患者大都有这种症状。②泛指多疑，好大惊小怪。","source":{"text":"倘仅有彼此神似之处，我以为那是因为同一原书的译本，并不足异的，正不必如此神经过敏，只因‘疑心’而竟想入非非。","book":"鲁迅《集外集·关于〈关于红笑〉》"},"example":{"text":"是这样的，也许是我们～，但愿是～吧！","book":"洪深《鸡鸣早看天》第二幕"},"similar":["大惊小怪","疑神疑鬼"],"usage":"作谓语、定语；用于处事"},{"id":34602,"word":"神经错乱","pinyin":"shén jīng cuò luàn","abbr":"sjcl","explanation":"①指精神病。②指精神和思虑迷糊不清，失去常态。","source":{"text":"一刹那顷我神经错乱的俯将下去，拿着手里的书，轻轻的将他盖上。","book":"冰心《寄小读者》二"},"example":{"text":"当时我只当他说的是～的话，因为他说到要死，也不只一次了。","book":"赵景深《朱湘》"},"similar":["神志不清"],"usage":"作谓语、宾语、定语；指人的精神失常"},{"id":34603,"word":"神而明之","pinyin":"shén ér míng zhī","abbr":"semz","explanation":"指表面玄妙的事理。","source":{"text":"化而裁之，存乎变；推而行之，存乎通；神而明之，存乎其人。","book":"《周易·系辞上》"},"example":{"text":"虽曰～，匪可言喻，亦由勉强而臻自然。","book":"清·李渔《闲情偶寄·词曲·结构》"},"usage":"作谓语、宾语；指表面玄妙的事理"},{"id":34604,"word":"神而明之，存乎其人","pinyin":"shén ér míng zhī，cún hū qí rén","abbr":"semzchqr","explanation":"要真正明白某一事物的奥妙，在于各人的领会。","source":{"text":"纪而裁之，存乎变；推而行之，存乎通；神而明之，存乎其人。","book":"《易·系辞上》"},"example":{"text":"清·李宝嘉《官场现形记》第57回：“‘～’，诸公随时留心，慢慢的学罢了。”"},"usage":"作宾语、定语、分句；用于书面语"},{"id":34605,"word":"神至之笔","pinyin":"shén zhì zhī bǐ","abbr":"szzb","explanation":"形容艺术作品的技法非常奇妙。","source":{"text":"《万松叠翠》、《万横香雪》二图，寄颜设色，并极神秀，《万松》尤有势。盖去林画多得之气象萧疏，烟林清旷，此独峰峦浑厚，势状雄强。其皱擦勾斫、分披纠合，无一不备神至之笔，岂可以一律论耶！","book":"清·侯方域《倪云林十万图记》"},"similar":["神到之笔"],"usage":"作宾语；多用于文学作品等"},{"id":34606,"word":"神色不动","pinyin":"shén sè bù dòng","abbr":"ssbd","explanation":"神色：神情。神情显得没有受到惊动而十分镇定。","source":{"text":"俄而猛虎毒龙，狻猊狮子，蝮蝎万计，哮吼拿攫而争前欲搏噬，或跳过其上，子春神色不动。","book":"唐·李复言《续玄怪录》"},"example":{"text":"和尚当时被节度使抛向水中，～，如今何得恁么地？（宋·释道原《景德传灯灵》卷十）"},"similar":["神色自若"],"opposite":["惊慌失措"],"usage":"作谓语、定语；指人遇到意外或紧张"},{"id":34607,"word":"神色不惊","pinyin":"shén sè bù jīng","abbr":"ssbj","explanation":"神色：神情。神情显得没有受到惊动而十分镇定。","source":{"text":"和尚当时被节度使抛向水中，神色不动，如今何得恁么地？","book":"宋·释道原《景德传灯灵》卷十"},"similar":["镇定自若"],"usage":"作谓语、定语、状语；用于处事"},{"id":34608,"word":"神色不挠","pinyin":"shén sè bù náo","abbr":"ssbn","explanation":"神态脸色没有改变。","source":{"text":"常于殿庭论奏曲直，则天厉色诘之，左右莫不悚栗，有功神色不挠，争之弥切。","book":"《旧唐书·徐有功传》"},"example":{"text":"帝怒，立召仁朗面诘之，至殿门，命去冠带。仁朗～。","book":"清·毕沅《续资治通鉴》卷七"},"similar":["神色不惊"],"usage":"作谓语、定语、状语；用于处事"},{"id":34609,"word":"神色仓皇","pinyin":"shén sè cāng huáng","abbr":"ssch","explanation":"仓皇：惊慌，慌张。指在紧急的情况下，神气和面色紧张惊慌，失去常态。","source":{"text":"臣观其神色仓皇，必然此事在心故也。","book":"明·余邵鱼《东周列国志》第二十四回"},"example":{"text":"这日正一个人闷闷坐着，忽见几个～、手忙脚乱的人奔进来嚷道：‘祸事！祸事！日俄开仗了，东三省快要不保了！","book":"清·曾朴《孽海花》第一回"}},{"id":34610,"word":"神色张皇","pinyin":"shén sè zhāng huáng","abbr":"sszh","explanation":"张皇：惊慌，慌张。指在紧急的情况下，神气和面色紧张惊慌，失去常态。同“神色仓皇”。","source":{"text":"正在无可奈何，只听得楼梯上一阵脚步声音，当差的已经回来，和那先去的李升一同走了进来，神色张皇，满头流汗。","book":"清·张春帆《九尾龟》第七十六回"},"example":{"text":"他回到我母亲身旁，是那么～。","book":"《我的叔叔于勒》"}},{"id":34611,"word":"神色怡然","pinyin":"shén sè yí rán","abbr":"ssyr","explanation":"愉快、心安的神色。","source":{"text":"晟终不对，神色怡然，正其衣冠南望而拜。","book":"《新五代史·死事传·孙晟传》"},"example":{"text":"他～，一点也看不出心中的不悦。"},"similar":["兴高采烈"],"usage":"作谓语、定语；指人的面色"},{"id":34612,"word":"神色自如","pinyin":"shén sè zì rú","abbr":"sszr","explanation":"神色：神情，态度。形容在异常情况下态度镇定，神情不变。","source":{"text":"潘怡如心里一惊，可是表面上仍神色自如。","book":"李六如《六十年的变迁》第四章第六节"},"similar":["神色自若","神气自若","神意自若"],"usage":"作谓语、定语、状语；指人非常镇定"},{"id":34613,"word":"神色自得","pinyin":"shén sè zì dé","abbr":"sszd","explanation":"脸上露出得意的神情。","source":{"text":"长孺视之，忻然有喜色，如获千金之惠，涎流于吻，连撮噉之，神色自得，合坐惊异。","book":"唐·温庭筠《乾撰子·权长孺》"},"usage":"作谓语、定语、状语；用于人的表情等"},{"id":34614,"word":"神色自若","pinyin":"shén sè zì ruò","abbr":"sszr","explanation":"自若：如常，象原来的样子。神情脸色毫无异样。形容态度镇静。","source":{"text":"文王曰：‘嗣宗毁顿如此，君不能共忧之，何谓？且有疾而饮酒食肉，固丧礼也。’籍饮啖不辍，神色自若。","book":"南朝宋·刘义庆《世说新语·任诞》"},"example":{"text":"裘副主委一个个听汇报，手在小本子上作记录。现在他～，脸上已一点也没有不自然的神情了。","book":"徐迟《真迹》"},"similar":["从容不迫","不慌不忙","神色自如"],"opposite":["惊慌失措","手足无措"],"usage":"作谓语、定语、状语；指人非常镇定","story":["晋朝时期，竹林七贤之一的陈留阮籍母亲死后，他哀毁骨立在晋文王那里饮酒吃肉，司隶何曾对文王说阮籍有重孝还饮酒吃肉，应该流放到海外。文王说他因哀痛过度伤身而得病，饮酒吃肉不越礼。阮籍任凭他们议论，吃个不停，神色自若"]},{"id":34615,"word":"神荼郁垒","pinyin":"shēn shū yù lěi","abbr":"styl","explanation":"二神名，传说能治二鬼，后世奉为门神。指门神。","source":{"text":"于是黄帝乃作礼，以时驱之，立大桃人，门户画神荼郁垒与虎，悬苇索以御凶。","book":"《山海经新释》卷十二"},"example":{"text":"黄髯斜卷，唇边几阵风生；怪眼圆睁，眉下一双星闪。真是～象，却非立地顶天人。","book":"明·施耐庵《水浒全传》第二十九回"},"usage":"作主语、宾语、定语；用于书面语","story":["传说古代沧海之中有度朔山，上有一棵大桃木，盘曲三千里，其枝间有鬼门，是万鬼出入地。门上有神荼郁垒二位神人，专门阅领万鬼，发现恶鬼就用苇索捆着去喂老虎。后来黄帝作礼请神，在门口离一大桃人，上画神荼郁垒与老虎用来驱恶鬼"]},{"id":34616,"word":"神藏鬼伏","pinyin":"shén cáng guǐ fú","abbr":"scgf","explanation":"比喻变化莫测。","source":{"text":"世路快心无好事，恩门嘉话合书绅。神藏鬼伏能千变，亦胜忘机避要津。","book":"唐·司空图《漫书》诗之四"},"usage":"作宾语、定语；用于比喻句"},{"id":34617,"word":"神融气泰","pinyin":"shén róng qì tai","abbr":"srqt","explanation":"精神融和气息通泰。","source":{"text":"漠乎其如忘其声，茫乎其如忘其形，神融气泰，无欲而无营，渺乎其如物之莫撄也。","book":"金·王若虚《四醉图赞》"},"usage":"作谓语、定语；用于书面语"},{"id":34618,"word":"神谋妙策","pinyin":"shén móu miào cè","abbr":"smmc","explanation":"神妙莫测的计策。","source":{"text":"也不索推轮捧毂，筑坛台专仗你那妙策神谋。","book":"元·无名氏《百花亭》第二折"},"similar":["神机妙策","神术妙策"],"usage":"作谓语、宾语、定语；用于计谋等"},{"id":34619,"word":"神谋妙算","pinyin":"shén móu miào suàn","abbr":"smms","explanation":"神、妙：形容高明；谋、算：指计谋。惊人的机智，巧妙的计谋。形容善于估计复杂的变化的情势，决定策略。","source":{"text":"妙算干戈止，神谋宇宙清。","book":"《后汉书·王涣传》：“又能以谲数发擿奸伏，京师称叹，以为涣有神算。”李贤注：“智算若神也。”唐·卢纶《杂曲歌辞·皇帝感词》"},"example":{"text":"延安保卫战的胜利是党中央的～"},"similar":["神机妙算","神机妙术","神机妙用"],"usage":"作谓语、宾语、定语；指人的决策等"},{"id":34620,"word":"神谋魔道","pinyin":"shén móu mó dào","abbr":"smmd","explanation":"犹神差鬼使。好像有鬼神在支使着一样，不自觉地做了原先没想到要做的事。","source":{"text":"这位姑娘好容易才安顿了，他心里又神谋魔道的想起甚么来了？","book":"《儿女英雄传》第二九回"},"similar":["神差鬼使","鬼使神差"],"usage":"作定语、状语；用于书面语"},{"id":34621,"word":"神谟庙算","pinyin":"shén mó miào suàn","abbr":"smms","explanation":"指神奇的谋略和计划。","source":{"text":"而圣人独禀全智，功高万古，神谟庙算，有非他人所能赞其万一者。","book":"明·归有光《嘉靖庚子科乡试对策五道·第四问》"},"similar":["神谟远算"],"usage":"作宾语、定语；用于书面语"},{"id":34622,"word":"神谟远算","pinyin":"shén mó yuǎn suàn","abbr":"smys","explanation":"指神奇的谋略和计划。同“神谟庙算”。","source":{"text":"臣闻一姓之霸有天下者，刻籀其钟鼎，摩诃其灵庙，徘徊其册府，皆有神谟远算，深计长虑，以为子孙万世之业。","book":"康有为《进呈俄罗斯大彼得变政记序》"},"similar":["神谟庙算"],"usage":"作宾语、定语；用于书面语"},{"id":34623,"word":"神超形越","pinyin":"shén chāo xíng yuè","abbr":"scxy","explanation":"指身心超逸，不同凡俗。","source":{"text":"郭景纯诗云：‘林无静树，川无停流。’阮孚云：‘泓峥萧瑟，实不可言，每读此文，辄觉神超形越。’","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"明·顾起纶《国雅品·土品》：“筑墅方山间，益扩前业，为藏修真境，冠蠡服髳，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":34624,"word":"神输鬼运","pinyin":"shén shū guǐ yùn","abbr":"ssgy","explanation":"形容运输迅疾。也比喻偷漏。同“神运鬼输”。","source":{"text":"神输鬼运义奚取，径路断绝谁跻攀。","book":"清·查慎行《虹桥板歌》"},"similar":["神运鬼输"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":34625,"word":"神运鬼输","pinyin":"shén yùn guǐ shū","abbr":"sygs","explanation":"形容运输迅疾。也比喻偷漏。","source":{"text":"一旦告成，金碧之丽光照林谷，钟磬之作声摩云霄，见者疑其天降地涌而神运鬼输也！","book":"宋·陆游《洞霄宫碑》"},"example":{"text":"明·归有光《处荒呈子》：“并不取于丁田也，则此三四万两之银，盖有～而莫知所在者矣。”"},"similar":["神输鬼运"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":34626,"word":"神迷意夺","pinyin":"shén mí yì duó","abbr":"smyd","explanation":"指精神迷乱，情思恍惚。","source":{"text":"生归达一品意，返学院，神迷意夺，语减容沮，恍然凝思，日不暇食。","book":"唐·裴鉶《传奇·昆仑奴》"},"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34627,"word":"神通广大","pinyin":"shén tōng guǎng dà","abbr":"stgd","explanation":"神通：原是佛家语，指神奇的法术。法术广大无边。形容本领高超，无所不能。","source":{"text":"师日：‘你神通广大，去必无妨。’","book":"《大唐三藏法师取经诗话·入王母地之处第十一》"},"example":{"text":"这孽畜更做你这般～，也不合佛顶上大惊小怪。","book":"元·马致远《荐福碑》第三折"},"similar":["三头六臂"],"opposite":["梧鼠技穷","束手无策","雕虫小技"],"usage":"作谓语、定语；指无所不能"},{"id":34628,"word":"神逝魄夺","pinyin":"shén shì pò duó","abbr":"sspd","explanation":"犹言魂飞魄散。形容惊恐万分，极端害怕。","source":{"text":"客踸不能立，俯而哕，伏而不敢仰视，神逝魄夺如死。","book":"明·刘基《郁离子·牧豭》"},"similar":["魂飞魄散"],"usage":"作谓语、定语、状语；指害怕"},{"id":34629,"word":"神道设教","pinyin":"shén dào shè jiào","abbr":"sdsj","explanation":"神道：本指天教，即神明之理，后指关于鬼神祸福之说。利用鬼神迷信作为教育手段。","source":{"text":"观天之神道，而四时不忒，圣人以神道设教，而天下服矣。","book":"《易·观》"},"example":{"text":"尼～，假箕仙言上帝震怒，将降祸于夫人。","book":"清·陆以湉《冷庐杂识·郑峚阳》"},"usage":"作谓语；指利用鬼神迷信作为手段"},{"id":34630,"word":"神郁气悴","pinyin":"shén yù qì cuì","abbr":"syqc","explanation":"指精神郁结劳悴。","source":{"text":"厥后果迭充主考、学政，终以神郁气悴得疾遽殒。","book":"清·薛福成《选举论下》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":34631,"word":"神醉心往","pinyin":"shén zuì xīn wǎng","abbr":"szxw","explanation":"心神陶醉向往。","source":{"text":"此仆所为神醉心往，而窃怪夫人之未深识也。","book":"明·叶式《题〈诚意伯刘公集〉》"},"usage":"作谓语、定语；用于书面语"},{"id":34632,"word":"神采奕奕","pinyin":"shén cǎi yì yì","abbr":"scyy","explanation":"奕奕：精神焕发的样子。形容精神饱满，容光焕发。","source":{"text":"韩宗伯所藏曹娥碑，为右军真迹。绢素稍暗，字亦惨淡。细视良久，则笔意透出绢外，神采奕然。","book":"明·沈德符《万历野获编·玩具·晋唐小楷真迹》"},"example":{"text":"我在底下看着，果然～。（清·吴趼人《二十年目睹之怪现状》第三十七回）"},"similar":["精神焕发","神采飞扬","精神百倍"],"opposite":["无精打采","萎靡不振"],"usage":"作谓语、定语、状语；指人的精神面貌"},{"id":34633,"word":"神采奕然","pinyin":"shén cǎi yì rán","abbr":"scyr","explanation":"奕奕：精神焕发的样子。形容精神饱满，容光焕发。","source":{"text":"韩宗伯所藏曹娥碑，为右军真迹。绢素稍暗，字亦惨淡。细视良久，则笔意透出绢外，神采奕然。","book":"明·沈德符《万历野获编·玩具·晋唐小楷真迹》"},"similar":["神采奕奕","精神抖擞"],"opposite":["委靡不振","无精打采"],"usage":"作谓语、定语、状语；指人的精神面貌"},{"id":34634,"word":"神采焕发","pinyin":"shén cǎi huàn fā","abbr":"schf","explanation":"神采：人的精神、神气和光彩；焕发：光彩四射。形容精神饱满，生气勃勃的风貌。","source":{"text":"孟兆页才气英迈，神采焕发，神仙中人。","book":"《元史·赵孟兆页传》"},"example":{"text":"他显得～。"},"similar":["神采飞扬","神采焕然"],"opposite":["萎靡不振"],"usage":"作谓语、定语、状语；指人的精神面貌"},{"id":34635,"word":"神采焕然","pinyin":"shén cǎi huàn rán","abbr":"schr","explanation":"神采：显露在外的精神。脸上神态十分有光采。","source":{"text":"董北苑《潇湘图》，思翁旧物也，藏毕秋帆尚书家。卷长丈许，神采焕然，具有远山苍翠，江水潆洄景象。","book":"清·钱泳《履园丛话·收藏·五代》"},"similar":["神采焕发"],"opposite":["委靡不振"],"usage":"作谓语、定语、状语；指人的精神面貌"},{"id":34636,"word":"神采英拔","pinyin":"shén cǎi yīng bá","abbr":"scyb","explanation":"指人的容貌、仪态英俊非凡。","source":{"text":"尔操行殊异，神采英拔，后之知名，当出吾右。","book":"《陈书·江总传》"},"example":{"text":"他～，英姿焕发。"},"similar":["英姿焕发","神采奕奕"],"usage":"作谓语、定语；指人的气质","story":["南朝梁武帝时期，江总以他的述怀诗而出名，他与尚书仆射张瓒等人结为忘年交。梁武帝称他是神采英拔、才气出众的人。到了陈后主时期，江总得到重用，经常出席陈后主的酒座赋诗作曲，欢歌酣饮，通宵达旦"]},{"id":34637,"word":"神采飞扬","pinyin":"shén cǎi fēi yáng","abbr":"scfy","explanation":"形容兴奋得意，精神焕发的样子。","source":{"text":"她居然很能够安逸的，高贵的，走过去握那少年导演的手，又用那神采飞扬的眼光去照顾一下全室的人。","book":"丁玲《梦珂》"},"example":{"text":"他～地走向主席台开始做报告。"},"similar":["精神焕发","神彩飞扬"],"opposite":["无精打采"],"usage":"作谓语、定语、状语；用于人的精神面目"},{"id":34638,"word":"神閒气定","pinyin":"shén xián qì dìng","abbr":"sxqd","explanation":"指神气悠闲安静。"},{"id":34639,"word":"神闲意定","pinyin":"shén xián yì dìng","abbr":"sxyd","explanation":"精神或神态悠闲，心意专一稳定。","source":{"text":"夫内自足，然后神闲意定；神闲意定，则思不竭而笔不困也。","book":"宋·王安石《虎图》：“神闲意定始一扫，功与造化论锱铢。”宋·郭若虚《图画见闻志·论用笔得失》"},"example":{"text":"～，万籁收声天地静。玉指冰弦，未动宫商意已传。","book":"宋·苏轼《减字木兰花》词"}},{"id":34640,"word":"神闲气定","pinyin":"shén xián qì dìng","abbr":"sxqd","explanation":"指神气悠闲安静。","source":{"text":"祁尔光曰：‘当命悬呼吸间，而神闲气定，款语揖让，从眉指目语外，另构空中硕画。’","book":"明·冯梦龙《智囊补·捷智·张佳胤》"},"similar":["神闲气静"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":34641,"word":"神闲气静","pinyin":"shén xián qì jìng","abbr":"sxqj","explanation":"指神气悠闲安静。同“神闲气定”。","source":{"text":"汪御史十分着急，看见人家，也有下车来买烧饼吃的，也有在车厢里抽出书来看的，也有扯过马褥子来盖着睡觉的，无不神闲气静。","book":"《负曝闲谈》第二七回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“四面眺望，～，一年不到的工夫，自是湖山不改。”"},"similar":["神闲气定"],"usage":"作谓语、定语、状语；用于人的状态"},{"id":34642,"word":"神霄绛阙","pinyin":"shén xiāo jiàng què","abbr":"sxjq","explanation":"原指仙境。亦用以形容帝王高深华美的宫殿。","source":{"text":"神霄绛阙，丽日五云浮，开绮讌，待宸游，云和一曲倚箜篌。","book":"明·汪廷讷《广陵月》第三出"},"usage":"作宾语、定语；用于建筑物等"},{"id":34643,"word":"神领意得","pinyin":"shén lǐng yì dé","abbr":"slyd","explanation":"形容领悟透彻。","source":{"text":"和尚胡名尸黎密，西域人……性主简，不学晋语，诸公与之言，皆因传译。然神领意得，顿在言前。","book":"《世说新语·言语》“高坐道人不作汉语”南朝·梁·刘孝标注引《高坐别传》"},"similar":["神领意造"],"usage":"作谓语、定语；用于书面语"},{"id":34644,"word":"神领意造","pinyin":"shén lǐng yì zào","abbr":"slyz","explanation":"指用心神领会和创造艺术形象。","source":{"text":"心存目想，高者为山，下者为水，坎者为谷，缺者为涧，显者为近，晦者为远。神领意造，恍然见其有人禽草木飞动往来之象，了然在目。","book":"宋·沈括《梦溪笔谈·书画》"},"similar":["神领意得"],"usage":"作谓语、定语；用于书面语"},{"id":34645,"word":"神飞气扬","pinyin":"shén fēi qì yáng","abbr":"sfqy","explanation":"精神振奋，意气昂扬。","source":{"text":"大丈夫见义即为，还拣甚么日子，叫左右带马过来，我神飞气扬，这叫做当仁见义无谦让。","book":"清·李渔《蜃中楼·义举》"},"example":{"text":"今日得见安抚，拨云雾～，赖你把奇功建，勒旗常。","book":"清·蒋士铨《冬青树·得朋》"},"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34646,"word":"神飞色动","pinyin":"shén fēi sè dòng","abbr":"sfsd","explanation":"形容脸上表情生动。","source":{"text":"妾本巫山神女，适见楚国襄王，谈妾往事，遂尔神动色飞。","book":"明·王錂《春芜记·宸游》"},"example":{"text":"素臣细说在外之事，说到危险处，三人魄战心惊；说到爽快处，三人～。","book":"清·夏敬渠《野叟曝言》第一○九回"},"similar":["神动色飞"],"usage":"作谓语、定语；用于人的神态"},{"id":34647,"word":"神飞色舞","pinyin":"shén fēi sè wǔ","abbr":"sfsw","explanation":"犹眉飞色舞。形容兴高采烈。","source":{"text":"各人都神飞色舞，连连举碗，如数吃干。","book":"《野叟曝言》第二四回"},"example":{"text":"儿童团们听了，都～，眼笑眉开。","book":"郭澄清《大刀记》第十五章"},"similar":["神动色飞","神动色飞","眉飞色舞"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":34648,"word":"神驰力困","pinyin":"shén chí lì kùn","abbr":"sclk","explanation":"形容心神向往，情思昏沉。","source":{"text":"可怜素手明于雪，只恐回身化作云，洛神既去，寡人神驰力困，我想那孤馆独眠怎捱到晓。","book":"明·汪道昆《洛水悲》"},"usage":"作谓语、定语、状语；用于人的状态"},{"id":34649,"word":"神骥出枥","pinyin":"shén jì chū lì","abbr":"sjcl","explanation":"比喻气魄雄伟，志向远大。","source":{"text":"於戏！加富尔虽百折不挠之英雄，然非遇英明果断之志如英玛努埃者，亦安得成功名于后世耶！至是，而撒的尼亚之内治，一切就绪，骎骎乎有神骥出枥、鸷鹰脱韝之志矣。","book":"梁启超《意大利建国三杰传》第十一节"},"usage":"作宾语、定语；多用于比喻句"},{"id":34650,"word":"神鬼不测","pinyin":"shén guǐ bù cè","abbr":"sgbc","explanation":"神灵鬼怪都不能揣度。极言事情的隐秘奇异。亦作“神鬼难测”。","source":{"text":"若论我腹中的兵书，委的有神鬼不测之机，有捉鼠拿猫之法。","book":"元·郑光祖《伊尹耕莘》第三折：“贤士展神鬼不测之机，兴一旅之师，辅佐公子，以成大事。”元·无名氏《射柳捶丸》第一折"},"example":{"text":"清·名教中人《好逑传》第14回：“若论水小姐的才智，真是不动声色，而有～之机，谁说她不佳？”"},"similar":["神鬼难测","神鬼莫测"],"usage":"作谓语、定语；用于事物等"},{"id":34651,"word":"神鬼莫测","pinyin":"shén guǐ mò cè","abbr":"sgmc","explanation":"测：推测。事情极诡秘，神鬼也难测度。形容谁也推测不出。","source":{"text":"诸将皆拜伏曰：‘丞相机算，神鬼莫测。’","book":"明·罗贯中《三国演义》第八十七回"},"example":{"text":"想到这里，他抬头一看，威虎厅离他只有五十余步了，三十秒钟后，这场吉凶难卜，神鬼难测的斗争就要开始。","book":"曲波《林海雪原》二０"},"similar":["神鬼不测"],"usage":"作谓语、定语；指十分诡秘"},{"id":34652,"word":"神鬼难测","pinyin":"shén guǐ nán cè","abbr":"sgnc","explanation":"测：推测。事情极诡秘，神鬼也难测度。形容谁也推测不出。","source":{"text":"诸将皆拜伏曰：‘丞相机算，神鬼莫测。’","book":"明·罗贯中《三国演义》第八十七回"},"example":{"text":"这龙韬虎略，～。","book":"明·无名氏《伐晋兴齐》第四折"},"similar":["神鬼不测","神鬼莫测"],"usage":"作谓语、定语；用于事物等"},{"id":34653,"word":"神魂失据","pinyin":"shén hún shī jù","abbr":"shsj","explanation":"神魂：神志；据：依托。形容神志失去常态。","source":{"text":"是夜，多浑虫醉倒在坑，二鼓人定，贾涟便溜进来相会，一见面，早已神魂失据。","book":"清·曹雪芹《红楼梦》第二十一回"},"example":{"text":"我～的站在他们中间。","book":"冰心《往事》二"},"similar":["神魂撩乱","神魂颠倒"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34654,"word":"神魂恍惚","pinyin":"shén hún huǎng hū","abbr":"shhh","explanation":"神魂：精神，心绪；恍惚：神智不清。指心神不定，精神不集中。","source":{"text":"仲躬神魂恍惚，若不支持。","book":"南朝·宋·鲍照《梦归乡诗》：“惊起空叹息，恍惚神魂飞。”宋·李昉《太平广记·器玩三》"},"example":{"text":"就是这一场大病起于饮食不慎，却也因～所至。","book":"清·明教中人《好逑传》第九回"}},{"id":34655,"word":"神魂摇荡","pinyin":"shén hún yáo dàng","abbr":"shyd","explanation":"心神恍惚，难以把持。","source":{"text":"沈将仕看见李三情状，一发神魂摇荡。","book":"明·凌濛初《二刻拍案惊奇》卷八"},"similar":["神魂飘荡","神摇魂荡"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34656,"word":"神魂撩乱","pinyin":"shén hún liáo luàn","abbr":"shll","explanation":"心神不安的样子。","source":{"text":"致得心肠转，教令得神魂撩乱。","book":"宋·杨泽民《夜游宫》"},"example":{"text":"头月满。栏干风度，有人肠断。为多情、役得～。","book":"宋·赵长卿《探春令》词"},"similar":["神魂颠倒","神魂失据"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34657,"word":"神魂潦乱","pinyin":"shén hún liáo luàn","abbr":"shll","explanation":"心神不安的样子。","source":{"text":"致得心肠转，教令得神魂潦乱。","book":"宋·杨泽民《夜游宫》"}},{"id":34658,"word":"神魂荡扬","pinyin":"shén hún dàng yáng","abbr":"shdy","explanation":"心神恍惚，难以把持。","source":{"text":"宣教方在神魂荡扬之际，恰象身子不是自己的，虽然听得有些诧异，没工夫得疑虑别的，还只一味痴想。","book":"明·凌濛初《二刻拍案惊奇》卷十四"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第14卷：“宣教方在～之际。恰像身子不是自己的……”"},"similar":["神魂荡飏","神魂飞越"],"usage":"作谓语、定语、状语；用于书面语"},{"id":34659,"word":"神魂荡飏","pinyin":"shén hún dàng chén","abbr":"shdy","explanation":"形容精神飘忽。"},{"id":34660,"word":"神魂颠倒","pinyin":"shén hún diān dǎo","abbr":"shdd","explanation":"神魂：精神，神志。精神恍惚，颠三倒四，失去常态。形容对人或事入迷着魔。","source":{"text":"小娘们多有爱他的，奉得神魂颠倒，连家里也不思想。","book":"明·冯梦龙《醒世恒言》卷十六"},"example":{"text":"怎禁它凤求凰良夜把琴调，咏月嘲风诗句挑，引的人～。","book":"明·无名氏《女真观》第三折"},"similar":["神不守舍","魂不守舍","颠三倒四"],"opposite":["神色不动","若无其事"],"usage":"作谓语、定语、补语；指人精神恍惚"},{"id":34661,"word":"神魂飘荡","pinyin":"shén hún piāo dàng","abbr":"shpd","explanation":"形容精神飘忽。","source":{"text":"黄天祥不知所以，抬头看时，不觉神魂飘荡，一会儿不知南北，昏昏惨惨，被步下军卒生擒下马。","book":"明·许仲琳《封神演义》第七十四回"},"example":{"text":"清·曹雪芹《红楼梦》第100回：“又想前日自己～之时，曾见一人说是黛玉生不同人，死不同鬼，必是那里的仙子临凡。”"},"similar":["神摇魂荡","神魂摇荡"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34662,"word":"神魂飞越","pinyin":"shén hún fēi yuè","abbr":"shfy","explanation":"精神飞出体外。形容人精神恍惚，神志不定的样子。","source":{"text":"涕泗纵横，乱于縻绠，神魂飞越，若在烟霄。","book":"宋·王禹偁《谢加朝请大夫表》"},"example":{"text":"清·李渔《闲情偶寄·词曲·结构》：“想入云霄之际，作者～，如在梦中，不至终篇，不能返魂收魄。”"},"similar":["神魂荡扬","神魂飘荡"],"usage":"作谓语、定语、状语；用于人的状态等"},{"id":34663,"word":"神龙失势","pinyin":"shén lóng shī shì","abbr":"slss","explanation":"比喻失去权位。","source":{"text":"要之，鱼不可脱于渊，神龙失势，即还与蚯蚓同。","book":"《后汉书·隗嚣传》"},"usage":"作谓语、定语；用于比喻句"},{"id":34664,"word":"神龙失埶","pinyin":"shén lóng shī zhì","abbr":"slss","explanation":"比喻失去权位。埶，同“势”。"},{"id":34665,"word":"神龙见首","pinyin":"shén lóng jiàn shǒu","abbr":"sljs","explanation":"指诗文跌宕多姿。","source":{"text":"昉思嫉时俗之无章也，曰：‘诗如龙然，首尾爪角鳞鬣，一不具，非龙也。’司寇哂之曰：‘诗如神龙，见其首不见其尾，或云中露一爪一鳞而已，安得全体？’","book":"清·赵执信《谈龙录》"},"usage":"作宾语、定语；用于比喻句"},{"id":34666,"word":"神龙见首不见尾","pinyin":"shén lóng jiàn shǒu bù jiàn wěi","abbr":"sljsbjw","explanation":"原是谈诗的神韵，后比喻人的行踪诡秘，刚一露面又不见了。也比喻言辞闪烁，使人捉摸不透。","source":{"text":"诗如神龙，见其首不见其尾，或云中露一爪一鳞而已，安得全体？","book":"清·赵执信《谈龙录》"},"example":{"text":"刘美美也如～，从此报纸上少了吸引人的新闻。","book":"茅盾《劫后拾遗》"},"similar":["神龙见首"],"usage":"作宾语、分句；指神秘"},{"id":34667,"word":"神龙马壮","pinyin":"shén lóng mǎ zhuàng","abbr":"slmz","explanation":"比喻身体健壮、气宇轩昂。","source":{"text":"那时侯，一个个青年人都是神龙马壮，气吞牛斗，争论起世界国家大事来，都是口若悬河，当当不断，慷慨激昂，谁也不让谁。","book":"欧阳山《苦斗》四六"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":34668,"word":"祥云瑞彩","pinyin":"xiáng yún ruì cǎi","abbr":"xyrc","explanation":"旧时认为天上彩色的云气象征吉兆。","source":{"text":"你看俺佛门现万道金光，满天现祥云瑞彩也。","book":"明·无名氏《鱼篮记》第四折"},"example":{"text":"花一团，～；锦一簇，纹理纵横。","book":"清·钱彩《说岳全传》第四十回"},"similar":["祥云瑞气"],"usage":"作宾语、定语；用于书面语"},{"id":34669,"word":"祥云瑞气","pinyin":"xiáng yún ruì qì","abbr":"xyrq","explanation":"旧时认为天上彩色的云气为吉祥的征兆，故称祥云瑞气。亦作“祥云瑞彩”。","source":{"text":"您看这祥云瑞气，晓日和风，端的是太平佳兆也呵。","book":"明·无名氏《紫微宫》第四折"},"example":{"text":"郭小川《厦门风姿》诗：“那长街，那小巷，都好像掩映在～之中。”"},"similar":["祥云瑞彩"],"usage":"作宾语、定语；用于书面语"},{"id":34670,"word":"祥风时雨","pinyin":"xiáng fēng shí yǔ","abbr":"xfsy","explanation":"形容风调雨顺。多比喻恩德。","source":{"text":"夫人道得于下，则阴阳和于上，然后祥风时雨，覆被远方，则夷狄慕德重泽而至矣。","book":"晋·袁宏《后汉纪·章帝纪》"},"example":{"text":"南朝·宋·范晔《后汉书·鲁恭传》：“则阴阳和于上，然后～，覆被远方。”"},"usage":"作宾语、定语；用于比喻句"},{"id":34671,"word":"祥麟威凤","pinyin":"xiáng lín wēi fèng","abbr":"xlwf","explanation":"麒麟和凤凰，古代传说是吉祥的禽兽，只有在太平盛世才能见到。后比喻非常难得的人才。","source":{"text":"九年，岚州献祥麟。","book":"《宋书·符瑞志中》：“元康四年，南郡获威风。”《宋史·乐志一》"},"example":{"text":"见一善人，爱之如～；见一恶人，恶之如封豕长蛇。？（明·焦竑《玉堂丛语·行谊》）"},"similar":["威凤祥麟","祥麟瑞凤"],"usage":"作宾语、定语；指难得的人才"},{"id":34672,"word":"祥麟瑞凤","pinyin":"xiáng lín rèi fèng","abbr":"xlrf","explanation":"麒麟和凤凰，古代传说是吉祥的禽兽，只有在太平盛世才能见到。后比喻非常难得的人才。","source":{"text":"人间世，何处祥麟威凤，繁华一枕春梦。江湖无限闲风月，待我往来吟弄。","book":"元·许有壬《摸鱼子》词"},"example":{"text":"未须期东海南山，愿早赐～。","book":"明·沈受先《三元记》第二出"},"similar":["祥麟威凤","威凤祥麟"],"usage":"作宾语、定语；指难得的人才"},{"id":34673,"word":"祭天金人","pinyin":"jì tiān jīn rén","abbr":"jtjr","explanation":"祭：祭祀。指佛像。","source":{"text":"收休屠祭天金人。","book":"东汉·班固《汉书·霍去病传》"},"usage":"作宾语、定语；指佛像"},{"id":34674,"word":"祭神如神在","pinyin":"jì shén rú shén zài","abbr":"jsrsz","explanation":"祭：祭祀；如：好像；在：存在。祭祀神灵时就象神灵真的存在一样。形容用心虔诚。","source":{"text":"祭如在，祭神如神在。","book":"《论语·学而》"},"example":{"text":"安老爷此时已经是满面的～的神情。","book":"清·文康《儿女英雄传》第三十六回"}},{"id":34675,"word":"祲威盛容","pinyin":"lóng wēi shèng róng","abbr":"jwsr","explanation":"庄重的声威和盛大的仪容。","source":{"text":"凤盖飒洒，和鸾玲珑。天官景从，祲威盛容。","book":"南朝·宋·范晔《后汉书·班固传》"},"example":{"text":"我龙受之，～。","book":"《宋史·乐志》"},"usage":"作宾语、定语；用于书面语"},{"id":34676,"word":"祸不单行","pinyin":"huò bù dān xíng","abbr":"hbdx","explanation":"祸：灾难。指不幸的事接二连三地发生。","source":{"text":"此所谓福不重来，祸必重来者也。","book":"汉·刘向《说苑·权谋》"},"example":{"text":"～，那个私立中学因为吃了一家钱庄的倒帐，发不出薪水了。","book":"叶圣陶《得失》"},"similar":["多灾多难","福无双至","雪上加霜"],"opposite":["时来运转","双喜临门"],"usage":"作宾语、分句；常与“福无双至”连用"},{"id":34677,"word":"祸不反踵","pinyin":"huò bù fǎn zhǒng","abbr":"hbfz","explanation":"踵：脚跟。形容灾祸很快来临。","source":{"text":"今揽五郡之兵，据四战之中，苟无奇计，祸不反踵。","book":"《新唐书·许世绪传》"},"similar":["祸不旋踵"],"usage":"作谓语；形容灾祸很快来临"},{"id":34678,"word":"祸不妄至","pinyin":"huò bù wàng zhì","abbr":"hbwz","explanation":"妄至：无故降临。灾祸不会无缘无故地降临。","source":{"text":"寡人闻之，谏者福也，谀者贼也。人主听谀，是愚惑也。虽然，祸不妄至，福不徒来。","book":"《史记·龟策传》"},"usage":"作宾语、定语；用于书面语"},{"id":34679,"word":"祸不旋踵","pinyin":"huò bù xuán zhǒng","abbr":"hbxz","explanation":"旋踵：旋转脚跟，比喻时间极短。祸害不久就将到来。","source":{"text":"若违忤要势，祸不旋踵，虽以清白自守，犹不免请谒之累。","book":"《北史·袁翻传》"},"example":{"text":"座内甚欣愧，然不测其来，仍虑事连宫禁，～。","book":"五代·王定保《唐摭言》卷三"},"similar":["祸不反踵"],"usage":"作谓语；形容灾祸很快来临"},{"id":34680,"word":"祸与福临","pinyin":"huò yǔ fú lín","abbr":"hyfl","explanation":"祸与福之间相去不远。","source":{"text":"庆者在堂，吊者在闾，祸与福临，莫知其门。","book":"《荀子·大略》"}},{"id":34681,"word":"祸与福邻","pinyin":"huò yǔ fú lín","abbr":"hyfl","explanation":"邻：接近。福与祸相距不远。","source":{"text":"庆者在堂，吊者在闾，祸与福邻，莫知其门。","book":"战国·赵·荀况《荀子·大略》"},"usage":"作宾语、定语；用于劝诫人"},{"id":34682,"word":"祸中有福","pinyin":"huò zhōng yǒu fú","abbr":"hzyf","explanation":"指不幸之中也包含着产生幸运的因素。","source":{"text":"失火而遇雨，失火则不幸，遇雨则幸也，故祸中有福也。","book":"西汉·刘安《淮南子·说林训》"},"example":{"text":"别叹息，～，好日子就会来临。"},"usage":"作宾语、定语；用于安慰人"},{"id":34683,"word":"祸为福先","pinyin":"huò wéi fú xiān","abbr":"hwfx","explanation":"指受尽灾祸之后好运就会降临。多用于劝慰受难之人。","source":{"text":"祸为福先，福为祸堂。","book":"晋·贞谌《赠刘琨一首》：“祸为福始，祸作福阶。”李善注引《越记》曰"},"example":{"text":"～，大难不死，必有后福。"},"usage":"作宾语；多用于劝慰受难之人"},{"id":34684,"word":"祸乱交兴","pinyin":"huò luàn jiāo xīng","abbr":"hljx","explanation":"指灾祸、战乱交相兴起，天下动荡不安。","source":{"text":"衰弊则祸乱交兴，淳和则天下自治。治乱兴亡，无不皆由所化也。","book":"《周书·苏绰传》"},"usage":"作谓语、定语；用于时局"},{"id":34685,"word":"祸乱滔天","pinyin":"huò luàn tāo tiān","abbr":"hltt","explanation":"形容灾祸、战乱极其严重，天下动荡不安。","source":{"text":"戊申，诏曰：‘朕以不德，纂承鸿绪，于兹十有五载。祸乱滔天，奸逆仍起，至乃幽废重宫，宗庙圮绝。成都王颖温仁惠和，克平暴乱。其以颖为皇太弟、都督中外诸军事，承相如故。’","book":"《晋书·惠帝纪》"},"usage":"作谓语、定语；用于时局等"},{"id":34686,"word":"祸乱相寻","pinyin":"huò luàn xiāng xún","abbr":"hlxx","explanation":"寻：接连不断而来。指灾祸、战乱一个接一个地发生。形容天下动荡不安。","source":{"text":"此所以祸乱相寻，江河日下，武人专横，政客捣乱，而无法收拾也。","book":"孙中山《心理建设》第六章"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":34687,"word":"祸乱相踵","pinyin":"huò luàn xiāng zhǒng","abbr":"hlxz","explanation":"踵：脚后跟，指追逐，相随。形容灾祸与战乱接连发生。","source":{"text":"衰弊则祸乱交兴，淳和则天下自治。治乱兴亡，无不皆由所化也。","book":"《周书·苏绰传》"}},{"id":34688,"word":"祸从口出","pinyin":"huò cóng kǒu chū","abbr":"hckc","explanation":"灾祸从口里产生出来。指说话不谨慎容易惹祸。","source":{"text":"病从口入，祸从口出。","book":"晋·傅玄《口铭》"},"example":{"text":"在这样“～”之秋，给自己也辩护得周到一点罢。","book":"鲁迅《华盖集续编·再来一次》"},"similar":["言多必失","多言买祸"],"opposite":["谨言慎行","喜从天降"],"usage":"作谓语、宾语；常与“病从口入”连用"},{"id":34689,"word":"祸从口出，患从口入","pinyin":"huò cóng kǒu chū，huàn cóng kǒu rù","abbr":"hckchckr","explanation":"指说错了话要惹祸，吃错了东西要生病。后多以强调言语必须谨慎。","source":{"text":"先儒云：‘祸从口出，患从口入。’","book":"《易·颐》：“君子以慎言语，节饮食”唐·孔颖达疏"},"similar":["祸从口出，病从口入"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":34690,"word":"祸从口出，病从口入","pinyin":"huò cóng kǒu chū，bìng cóng kǒu rù","abbr":"hckcbckr","explanation":"指说错了话要惹祸，吃错了东西要生病。后多以强调言语必须谨慎。同“祸从口出，患从口入”。","source":{"text":"谚有：‘祸从口出，病从口入’，甚好。","book":"《朱子语类》卷七一"},"similar":["祸从口出，患从口入"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":34691,"word":"祸从口生","pinyin":"huò cóng kǒu shēng","abbr":"hcks","explanation":"指言语不慎招致灾祸。","example":{"text":"常言道：“病从口入，～”，因此不论在什么场合，都应谨慎自己的言行。"}},{"id":34692,"word":"祸从天上来","pinyin":"huò cóng tiān shàng lái","abbr":"hctsl","explanation":"祸：祸害，灾难。比喻意外的灾祸突然到来。","source":{"text":"正是：闭门家中坐，祸从天上来……陈氏见丈夫拿去，哭死在地。","book":"明·冯梦龙《醒世恒言》第20卷"},"similar":["祸从天降"],"usage":"作宾语；指意外飞来的灾祸"},{"id":34693,"word":"祸从天降","pinyin":"huò cóng tiān jiàng","abbr":"hctj","explanation":"降：落下。比喻突然遭到了意外的灾祸。","source":{"text":"咸云宗召荷恩之日，寸禄不沾，进药之时，又不同义，此乃祸从天降，罪匪己为。","book":"《旧唐书·刘瞻传》"},"example":{"text":"正是～，灾向地生。","book":"明·施耐庵《水浒全传》第四十六回"},"similar":["飞来横祸","大祸临头","祸出不测"],"opposite":["喜从天降"],"usage":"作宾语；指意外飞来的灾祸","story":["唐懿宗的爱女同昌公主因病医治无效死亡，他迁怒于医官，以“用药无效”的罪名将韩宗召、康仲殷及两家族人300多人全部投入监狱。宰相兼刑部侍郎刘瞻上书劝谏，认为他们已经尽力，朝野都认为这是祸从天降，惩罚没有犯罪的人，因此被贬为康州刺史"]},{"id":34694,"word":"祸作福阶","pinyin":"huò zuò fú jiē","abbr":"hzfj","explanation":"指祸富本无定数，相互有转化的可能，灾祸度过后即酝酿着好运的降临。","source":{"text":"福为祸始，祸作福阶。","book":"晋·卢谌《赠刘琨一首》"},"usage":"作宾语、定语；用于书面语"},{"id":34695,"word":"祸兮福所倚，福兮祸所伏","pinyin":"huò xī fú suǒ yǐ，fú xī huò suǒ fú","abbr":"hxfsyfxhsf","explanation":"倚：倚靠；伏：隐藏。祸中有福，福中有祸。比喻坏事可以引出好的结果，好事也可以引出坏的结果。","source":{"text":"祸兮福之所倚，福兮祸之所伏。","book":"春秋·楚·李耳《老子》第58章"},"example":{"text":"俗话说：～，我们的好日子即将来临。"},"similar":["祸福相生"],"usage":"作宾语、分句；指祸福相生"},{"id":34696,"word":"祸兴萧墙","pinyin":"huò xīng xiāo qiáng","abbr":"hxxq","explanation":"萧墙：古代宫室内当门的小墙，比喻内部。指祸乱发生在内部。","source":{"text":"祸兴萧墙内，万里防祸根。","book":"唐·鲍溶《长城作》"},"similar":["祸起萧墙","祸发萧墙","衅发萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":34697,"word":"祸出不测","pinyin":"huò chū bù cè","abbr":"hcbc","explanation":"灾祸的产生不可预测。指不知什么时候就会出现灾祸。","source":{"text":"仁宗大怒，玉音甚厉，众恐祸出不测。","book":"宋·胡仔《苕溪渔隐丛话前集·梅圣俞》"},"example":{"text":"若不早自引退，诚恐谣诼日加，～。","book":"清·洪昇《长生殿·紫阁》"},"similar":["祸生不测"],"usage":"作宾语、定语；用于书面语"},{"id":34698,"word":"祸及池鱼","pinyin":"huò jí chí yú","abbr":"hjcy","explanation":"犹殃及池鱼。比喻无辜波及而受害。","source":{"text":"迨苏武生还之日，正邹阳见收之期，祸及池鱼。","book":"明·张煌言《答毛参军书》"},"example":{"text":"明·张煌言《答毛参军书》：“迨苏武生还之日，正邹阳见收之期，～。”"},"similar":["祸近池鱼","殃及池鱼"],"usage":"作谓语、宾语、定语；指无端受害"},{"id":34699,"word":"祸发萧墙","pinyin":"huò fā xiāo qiáng","abbr":"hfxq","explanation":"萧墙：古代宫室内当门的小墙，比喻内部。指祸乱发生在内部。","source":{"text":"吾恐季孙之忧，不在颛臾，而在萧墙之内也。","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"内违同盟之誓，外失戎狄之心，兵兴州坏，～，将以定霸，不亦难乎？","book":"汉·袁绍《与公孙瓒书》"},"similar":["祸起萧墙","祸生萧墙","衅发萧墙"],"usage":"作谓语、宾语、定语；指内乱","story":["春秋时期，鲁国大夫季康子为巩固自己的统治权力，想攻打附近的颛臾国。季康子的谋臣冉有和子路都是孔子的学生，他们问孔子该如何处理。孔子说：“治理一国不能使百姓安居乐业，国内处于分崩离析的状态，恐怕要祸起萧墙了。”"]},{"id":34700,"word":"祸发齿牙","pinyin":"huò fā chǐ yá","abbr":"hfcy","explanation":"灾祸从口里产生出来。指说话不谨慎容易惹祸。","source":{"text":"时君听之，安可不惑。参断一谬，俗化易讹。祸发齿牙，言生枝叶，率是道也。","book":"唐·元稹《戒励风俗德音》"},"similar":["祸从口出"],"usage":"作谓语、宾语；用于说话"},{"id":34701,"word":"祸因恶积","pinyin":"huò yīn è jī","abbr":"hyej","explanation":"遭受灾祸的因素是罪恶的积累。指坏事做多了便会招致灾祸。","source":{"text":"看修行似福缘善庆，论因果是祸因恶积。","book":"明·汤显祖《还魂记·道觋》"},"example":{"text":"他怎么就没有～的常识？"},"usage":"作宾语、定语；用于劝诫人"},{"id":34702,"word":"祸国殃民","pinyin":"huò guó yāng mín","abbr":"hgym","explanation":"祸、殃：损害。使国家受害，百姓遭殃。","source":{"text":"如去岁兖州之变，西报指斥疆臣，谓其祸国殃民，肉不足以啖狗彘。","book":"章炳麟《正学报缘起·例言》"},"example":{"text":"第八条罪状是：传播出去，～。","book":"毛泽东《反对党八股》"},"similar":["蠹国害民"],"opposite":["安邦定国","富国安民","保国安民"],"usage":"作谓语、定语；指指危害国家"},{"id":34703,"word":"祸国误民","pinyin":"huò guó wù mín","abbr":"hgwm","explanation":"祸：祸害；误：误导，耽误。指危害国家，误导人民。","source":{"text":"精神污染的危害很大，足以祸国误民。","book":"邓小平《党在组织战线和思想战线上的迫切任务》"},"similar":["祸国殃民"],"usage":"作谓语、定语；指指危害国家"},{"id":34704,"word":"祸在旦夕","pinyin":"huò zài dàn xī","abbr":"hzdx","explanation":"灾难在很短时间内就要降临。形容处境非常危险。","source":{"text":"吾国有难，祸在旦夕，非驸马不能救。","book":"唐·段成式《诺皋记·长须国》"},"example":{"text":"倘是认真办起来，你老是跑不掉，拖下去家破人亡，～。","book":"清·颐琐《黄绣球》第四回"},"similar":["祸在朝夕"],"opposite":["洪福齐天"],"usage":"作宾语、定语；指灾祸马上来临"},{"id":34705,"word":"祸在朝夕","pinyin":"huò zài zhāo xī","abbr":"hzcx","explanation":"夕：晚上；朝夕：比喻短时间。指祸患来临在即。","source":{"text":"承勋虑祸在朝夕，与诸弟同谋，杀节度判官邱涛。","book":"《旧五代史·晋书·杨光远传》"},"similar":["祸在旦夕"],"usage":"作宾语、定语；指灾祸马上来临"},{"id":34706,"word":"祸在眼前","pinyin":"huò zài yǎn qián","abbr":"hzyq","explanation":"灾祸就在眼前。指灾祸马上要发生。","example":{"text":"～，得马上回避。"},"similar":["祸迫眉睫"],"usage":"作宾语、定语；指灾祸临门"},{"id":34707,"word":"祸来神昧","pinyin":"huò lái shén mèi","abbr":"hlsm","explanation":"祸事临头，神志往往昏乱不清。","source":{"text":"鄙语有之：福至心灵，祸来神昧。","book":"《资治通鉴·后汉高祖天福十二年》胡三省注"},"example":{"text":"夫～，虽亦有之，而不可藉口。","book":"清·方东树《大意尊阁·立行》"},"opposite":["福至心灵"],"usage":"作宾语、定语；用于书面语"},{"id":34708,"word":"祸枣灾梨","pinyin":"huò zǎo zāi lí","abbr":"hzzl","explanation":"旧时印书，多用枣木梨木刻板。比喻滥刻无用的书。","source":{"text":"至于交通声气，号召生徒，祸枣灾梨，递相神圣，不但有明未造标榜多诬，即月泉吟社诸人亦病未离乎客气。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录六》"},"example":{"text":"刻这些书无疑是～。"},"similar":["灾梨祸枣"],"usage":"作宾语；比喻滥刻无用的书"},{"id":34709,"word":"祸生不测","pinyin":"huò shēng bù cè","abbr":"hsbc","explanation":"测：估计，猜度。灾祸的产生不可揣测。","source":{"text":"万一祸生不测，国无老成，谁与共事。","book":"《明史·刘蕀传》"},"example":{"text":"若不早自引退，诚恐谣诼日加，～。","book":"清·洪昇《长生殿·絮阁》"},"similar":["祸出不测"],"usage":"作宾语、定语；用于书面语"},{"id":34710,"word":"祸生于忽","pinyin":"huò shēng yú hū","abbr":"hsyh","explanation":"灾祸产生于疏忽大意。","source":{"text":"福生于微，祸生于忽，日夜恐惧，唯恐不卒。","book":"汉·刘向《说苑·谈丛》"},"usage":"作宾语、定语；用于书面语"},{"id":34711,"word":"祸生于纤纤","pinyin":"huò shēng yú xiān xiān","abbr":"hsyxx","explanation":"纤纤：细微。祸患是由于不注意细微的漏洞而引起的。","source":{"text":"祸之所由生也，生自纤纤，是故君子蚤绝之","book":"《荀子·大略》"}},{"id":34712,"word":"祸生有胎","pinyin":"huò shēng yǒu tāi","abbr":"hsyt","explanation":"指灾祸的发生是因为有祸根存在。","source":{"text":"福生有基，祸生有胎，纳其基，绝其胎，祸何自来。","book":"《汉书·枚乘传》"}},{"id":34713,"word":"祸生肘腋","pinyin":"huò shēng zhǒu yè","abbr":"hszy","explanation":"肘腋：胳肢窝。比喻事变就发生在身边。","source":{"text":"主公之在公安也，北畏曹公之强，东惮孙权之逼，近则惧孙夫人生变于肘腋之下，当斯之时，进退狼跋。","book":"《三国志·蜀志·法正传》"},"example":{"text":"～，衅起萧墙。","book":"《周书·孝闵帝纪》"},"similar":["变生肘腋","事生肘腋","害起肘腋"],"usage":"作宾语、定语；比喻事变就发生在身边"},{"id":34714,"word":"祸生萧墙","pinyin":"huò shēng xiāo qiáng","abbr":"hsxq","explanation":"萧墙：古代宫室内当门的小墙，比喻内部。指祸乱发生在内部。","source":{"text":"岂知祸生萧墙，元旦灾来，反了股肱重臣，追之不及。","book":"明·许仲琳《封神演义》第35回"},"similar":["祸起萧墙","祸发萧墙","衅发萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":34715,"word":"祸盈恶稔","pinyin":"huò yíng è rěn","abbr":"hyer","explanation":"盈：满；稔：成熟。指为害作恶已经到了无以复加的地步。","source":{"text":"既祸盈恶稔，众叛亲离，不有一戎，何以大定。","book":"《周书·武帝纪下》"},"example":{"text":"乃谓汉鼎可移，郿坞方盛，殊不知～，未或不亡。","book":"唐·权德舆《后汉贼臣董卓庙议》"},"similar":["祸稔恶积","祸稔恶盈"],"usage":"作谓语、定语；用于坏人"},{"id":34716,"word":"祸福与共","pinyin":"huò fú yǔ gòng","abbr":"hfyg","explanation":"有祸同当，有福同享。","source":{"text":"死生可以相待，祸福可以相共。","book":"宋·苏轼《东坡志林》"}},{"id":34717,"word":"祸福之门","pinyin":"huò fú zhī mén","abbr":"hfzm","explanation":"指祸与福之所从出。","source":{"text":"利害之路，祸福之门，不可求而得也。","book":"《吕氏春秋·慎势》：“故小大、轻重、少多、治乱不可不察，此祸福之门也。”《淮南子·览冥训》"},"example":{"text":"西汉·刘安《淮南子·览冥训》：“利害之路，～，不可求而得也。”"},"usage":"作宾语；指祸与福之所出处"},{"id":34718,"word":"祸福倚伏","pinyin":"huò fú yǐ fú","abbr":"hfyf","explanation":"比喻坏事和好事互相依存。","source":{"text":"祸兮福之所倚，福兮祸之所伏。","book":"《老子》第五十八章"},"example":{"text":"心有亲疏，则～于无穷，虽圣智不得而防也。","book":"宋·陈亮《问答上》"},"similar":["祸福相依"],"usage":"作宾语；比喻坏事和好事互相依存"},{"id":34719,"word":"祸福同门","pinyin":"huò fú tóng mén","abbr":"hftm","explanation":"指祸福皆人自取。","source":{"text":"夫祸之来也，人自生之；福之来也，人自成之。祸与福同门，利与害为邻。","book":"《文子·微明》：“夫祸之至也，人自生之，福之来也，人自成之，祸与福同门，利与害同邻，自非至精莫之能分。《淮南子·人间训》"},"example":{"text":"夫～，倚伏万端，又未可断也。","book":"《晋书·刘牢之传》"},"usage":"作宾语、定语；用于劝诫人"},{"id":34720,"word":"祸福惟人","pinyin":"huò fú wéi rén","abbr":"hfwr","explanation":"是祸是福均取决于人自身的所作所为。亦作“祸福由人”。","source":{"text":"唐·杨炯《从弟去溢墓志铭》：“阴阳为道，大道无亭毒之心；祸福惟人，圣人有抑扬之教。”亭毒，养育。"},"similar":["祸福由人"],"usage":"作宾语、定语；用于劝诫人"},{"id":34721,"word":"祸福无偏","pinyin":"huò fú wú piān","abbr":"hfwp","explanation":"灾难和幸福的到来不是天意，无法偏袒，都是由自己的所作所为造成的。","source":{"text":"果然道祸福无偏，善恶相连，则为你昧己瞒心，因此上惹罪招愆。","book":"明·无名氏《锁白猿》第四折"},"usage":"作宾语、定语；用于劝诫人"},{"id":34722,"word":"祸福无常","pinyin":"huò fú wú cháng","abbr":"hfwc","explanation":"指祸与福没有固定不变的常规。","source":{"text":"祸福无常，忧喜难定，圣上一日心悔，娘娘便荣还，何苦悲凄。","book":"明·孙梅锡《琴心记·长门望月》"},"similar":["祸福靡常"],"usage":"作谓语、定语、宾语；指祸与福没有固定不变"},{"id":34723,"word":"祸福无门","pinyin":"huò fú wú mén","abbr":"hfwm","explanation":"无门：没有定数。指灾祸和幸福不是注定的，都是人们自己造成的。","source":{"text":"祸福无门，唯人所召。","book":"《左传·襄公二十三年》"},"example":{"text":"至于自强之道，求其在我，～，唯人自招，群策群力，庶有成功。","book":"蔡东藩、许廑父《民国通俗演义》第四十四回"},"similar":["祸福同门"],"opposite":["命中注定"],"usage":"作宾语；指灾祸和幸福没有定数"},{"id":34724,"word":"祸福无门，唯人所召","pinyin":"huò fú wú mén，wéi rén suǒ zhào","abbr":"hfwmwrsz","explanation":"无门：没有定数。指灾祸和幸福不是注定的，都是人们自己造成的。","source":{"text":"祸福无门，唯人所召。","book":"《左传·襄公二十三年》"},"example":{"text":"臣闻～。人无衅焉，妖不妄作。","book":"唐·魏征《十渐不克终疏》"},"opposite":["一路福星","一帆风顺"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":34725,"word":"祸福有命","pinyin":"huò fú yǒu mìng","abbr":"hfym","explanation":"旧时迷信认为，灾祸与幸福都有一定的气数，都是命中注定的。","source":{"text":"人之於世，祸福有命；人之操行，亦自致之。","book":"《论衡·辨祟》"},"usage":"作宾语、定语；用于迷信说法"},{"id":34726,"word":"祸福由人","pinyin":"huò fú yóu rén","abbr":"hfyr","explanation":"是祸是福均取决于人自身的所作所为。同“祸福惟人”。","source":{"text":"天网恢恢真可信，须知祸福由人。","book":"明·王錂《春芜记·反目》"},"similar":["祸福惟人"],"usage":"作宾语、定语；用于劝诫人"},{"id":34727,"word":"祸福由己","pinyin":"huò fú yóu jǐ","abbr":"hfyj","explanation":"祸福之所来都取决于人自身的所作所为。","source":{"text":"今国家闲暇，及是时，般乐怠敖，是自求祸也。祸福无不自己求之者。","book":"《孟子·公孙丑上》"}},{"id":34728,"word":"祸福相依","pinyin":"huò fú xiāng yī","abbr":"hfxy","explanation":"比喻坏事可以引出好的结果，好事也可以引出坏的结果。","source":{"text":"祸兮福之所倚，福兮祸之所伏。","book":"《老子》第五十八章"}},{"id":34729,"word":"祸福相倚","pinyin":"huò fú xiāng yī","abbr":"hfxy","explanation":"指祸与福相因而生。","source":{"text":"祸兮福所倚，福兮祸所伏。","book":"先秦·李耳《老子》"},"example":{"text":"欢娱未几，被闲愁，无端侵入双眉，要起沉疴，须分宠爱，难禁～。","book":"清·李渔《凰求凤·堕计》"},"similar":["祸福相生"],"usage":"作宾语；指祸福倚伏"},{"id":34730,"word":"祸福相生","pinyin":"huò fú xiāng shēng","abbr":"hfxs","explanation":"指祸害与幸福是相互转化、相互依存的。","source":{"text":"安危相易，祸福相生。","book":"《庄子·则阳》"},"similar":["祸福相依"],"usage":"作定语、宾语；指祸与福互相转化"},{"id":34731,"word":"祸福靡常","pinyin":"huò fú mí cháng","abbr":"hfmc","explanation":"指祸与福没有固定不变的常规。","source":{"text":"祸福靡常，喜悲交集。","book":"明·陈汝元《金莲记·归田》"},"similar":["祸福无常"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":34732,"word":"祸积忽微","pinyin":"huò jī hū wēi","abbr":"hjhw","explanation":"灾祸产生于疏忽大意。","source":{"text":"福生于微，祸生于忽，日夜恐惧，唯恐不卒。","book":"汉·刘向《说苑·谈丛》"}},{"id":34733,"word":"祸稔恶盈","pinyin":"huò rěn è yíng","abbr":"hrey","explanation":"犹言罪恶累累。稔，喻积久。同“祸盈恶稔”。","source":{"text":"今霍氏祸稔恶盈，帝岂不能治之哉？","book":"宋·王楙《野客丛书·宣帝待霍氏》"},"similar":["祸稔恶积","祸盈恶稔"],"usage":"作谓语、定语；用于坏人"},{"id":34734,"word":"祸稔恶积","pinyin":"huò rěn è jī","abbr":"hrej","explanation":"犹言祸盈恶稔。指长期作恶犯罪，罪恶深重。","source":{"text":"至于祸稔恶积，不得已而诛之，是以恩为阱也。","book":"明·刘基《郁离子·灵丘丈人》"},"similar":["祸盈恶稔","祸稔恶盈"],"usage":"作谓语、定语、宾语；用于坏人"},{"id":34735,"word":"祸稔萧墙","pinyin":"huò rěn xiāo qiáng","abbr":"hrxq","explanation":"萧墙：古代宫室内当门的小墙；稔：酝酿。指祸乱发生在家里。比喻内部发生祸乱。","source":{"text":"祸稔萧墙，奸生帷幄，臣恐曹节侯景复生于今日矣。","book":"唐·刘贲《应贤良方正能直言极谏科策》"},"similar":["祸发萧墙","祸起萧墙","祸生萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":34736,"word":"祸结兵连","pinyin":"huò jié bīng lián","abbr":"hjbl","explanation":"结：相联；兵：战争；连：接连。战争接连不断，带来了无穷的灾祸。","source":{"text":"虽有克获之功，胡辄报之，兵连祸结，三十余年。","book":"《汉书·匈奴传》"},"example":{"text":"一去故乡音耗绝，～，娇凤雏鸾没信传。","book":"元·无名氏《梧桐雨》第一折"},"similar":["兵连祸结"],"usage":"作宾语、定语；指战乱"},{"id":34737,"word":"祸结衅深","pinyin":"huò jié xìn shēn","abbr":"hjxs","explanation":"灾祸接连不断，矛盾巨大深重。","source":{"text":"州郡携贰，上下崩离，祸结衅深，遂忧惧成疾。","book":"《晋书·东海王越传》"},"usage":"作宾语、定语；用于书面语"},{"id":34738,"word":"祸绝福连","pinyin":"huò jué fú lián","abbr":"hjfl","explanation":"指灾祸消失，好运接连不断。","source":{"text":"万神即时倒，合会琼羽门。使令散祸，祸绝福连。上寝玉堂，世受名仙。","book":"宋·张君房《云笈七签》第四十二卷"},"example":{"text":"想开点，别灰心。～，会好起来的。"},"usage":"作宾语、定语；指转好运"},{"id":34739,"word":"祸至无日","pinyin":"huò zhì wú rì","abbr":"hzwr","explanation":"无日：没有几日。形容灾祸马上就要降临。","source":{"text":"楚自克庸以来，其君无日不讨国人而训之，于民生之不易，祸至之无日，戒惧之不可以怠。","book":"《左传·宣公十二年》"},"example":{"text":"晋·陈寿《三国志·蜀志·诸葛亮传》：“今将军外托服从之名，而内怀犹豫之计，事急而不断，～矣。”"},"similar":["祸在眉睫","祸在朝夕"],"usage":"作宾语、定语；用于书面语"},{"id":34740,"word":"祸莫大于轻敌","pinyin":"huò mò dà yú qīng dí","abbr":"hmdyqd","explanation":"没有什么比轻视敌人的祸害更大了。多用于警戒人们对自己的对手或敌人，切不可掉以轻心。","source":{"text":"祸莫大于轻敌，轻敌几丧吾宝。","book":"《老子》第六十九章"}},{"id":34741,"word":"祸起萧墙","pinyin":"huò qǐ xiāo qiáng","abbr":"hqxq","explanation":"萧墙：古代宫室内当门的小墙。指祸乱发生在家里。比喻内部发生祸乱。","source":{"text":"吾恐季孙之忧，不在颛臾，而在萧墙之内也。","book":"《论语·季氏》"},"example":{"text":"不照这么办法，恐～，势且波及全国，总统不如通权达变，暂歇风潮为是。","book":"蔡东藩、许廑父《民国通俗演义》第八十回"},"similar":["同室操戈","萧墙之祸","尺布斗粟"],"opposite":["敌国外患","兵临城下","大军压境"],"usage":"作谓语、宾语、定语；指内乱","story":["春秋时期，鲁国大夫季康子为巩固自己的统治权力，想攻打附近的颛臾国。季康子的谋臣冉有和子路都是孔子的学生，他们问孔子该如何处理。孔子说：“治理一国不能使百姓安居乐业，国内处于分崩离析的状态，恐怕要祸起萧墙了。”"]},{"id":34742,"word":"祸起隐微","pinyin":"huò qǐ yǐn wēi","abbr":"hqyw","explanation":"灾难祸患产生于隐蔽细微的地方。","source":{"text":"圣人贵于谋始，智者察于未形。祸起隐微，危生安逸。","book":"守·王曾《谏作玉清昭应宫》"},"usage":"作宾语、定语；用于书面语"},{"id":34743,"word":"祸起飞语","pinyin":"huò qǐ fēi yǔ","abbr":"hqfy","explanation":"飞语：无根据的话。祸患从流言蜚语中来。","source":{"text":"祸起飞语，刑极论胥。心困病怯，气以愁耗。","book":"唐·刘禹锡《上中书李相公启》"},"usage":"作宾语、定语；用于书面语"},{"id":34744,"word":"祸近池鱼","pinyin":"huò jìn chí yú","abbr":"hjcy","explanation":"犹言殃及池鱼。比喻无辜而受害。","source":{"text":"淫刑以逞，祸近池鱼，耳听恶来之谗，足践龙逢之血。","book":"隋·卢思道《劳生论》"},"similar":["祸及池鱼","殃及池鱼"],"usage":"作谓语、宾语、定语；指无端受害"},{"id":34745,"word":"祸迫眉睫","pinyin":"huò pò méi jié","abbr":"hpmj","explanation":"犹言祸在旦夕。灾难在很短时间内就要降临。形容处境非常危险。","source":{"text":"至是内外之形势益急，祸迫眉睫。","book":"梁启超《罗兰夫人传》"},"example":{"text":"现在～，我们得想出避祸办法。"},"similar":["眉睫之祸","祸在旦夕","祸在朝夕"],"usage":"作宾语、定语；指灾祸临门"},{"id":34746,"word":"祸首罪魁","pinyin":"huò shǒu zuì kuí","abbr":"hszk","explanation":"首：头目；魁：首领。犯罪作恶的首罪者。","source":{"text":"虽是虔婆杀我，娟奴是祸首罪魁，追了他去。","book":"明·郑若庸《玉玦记·索命》"},"example":{"text":"我们要把这事的～揪出来。"},"similar":["罪魁祸首"],"usage":"作主语、宾语、定语；指祸头子"},{"id":34747,"word":"祼袖揎拳","pinyin":"luǒ xiù xuān quán","abbr":"gxxq","explanation":"揎：卷起或捋起袖子。形容十分气愤的样子。也形容劲头十足。","source":{"text":"一个个酒囊饭袋成何用，掳袖揎拳号俊杰。","book":"元·无名氏《渔樵闲话》第三折"}},{"id":34748,"word":"禀性难移","pinyin":"bǐng xìng nán yí","abbr":"bxny","explanation":"本性难以改变。","source":{"text":"想他第无恩义，本性难移。着我向野田衰草残红里，离凤阁近渔矶。","book":"元·尚仲贤《洞庭湖柳毅传书》楔子"},"example":{"text":"今是昨非，谁能早见机。～，休嗔我笑伊。","book":"明·冯惟敏《海浮山堂词稿·纪笑四首》其四"},"similar":["本性难移"],"usage":"作谓语、定语；用于人的个性"},{"id":34749,"word":"禁中颇牧","pinyin":"jìn zhōng pō mù","abbr":"jzpm","explanation":"比喻宫廷侍从官中文才武略兼备者。","source":{"text":"廉颇、李牧皆战国时赵国守边御敌之良将。唐宣宗时，党项扰河西，翰林学士毕諴上破羌条陈甚悉，帝大悦，曰：“吾将择能帅者，孰谓颇牧在吾禁署，卿为朕行乎！”于是拜諴为邠宁节度使、河西供军安抚使。諴于任内多所建树。事见《新唐书·毕諴传》。"}},{"id":34750,"word":"禁乱除暴","pinyin":"jìn luàn chú bào","abbr":"jlcb","explanation":"禁：制止；乱：混乱；暴：强暴。抑制强暴势力，治理混乱局面。","source":{"text":"诸凡国法所不及加，与有司所不得而执者，不许其复仇，则无以禁乱除暴也，","book":"清·汪琬《复仇或问》"},"similar":["禁暴正乱","禁暴诛乱","禁暴止乱"],"usage":"作谓语、宾语；指打击犯罪"},{"id":34751,"word":"禁奸除猾","pinyin":"jìn jiān chú huá","abbr":"jjch","explanation":"禁：禁止；猾：狡猾。禁止清除奸险狡猾之人。","source":{"text":"无禁奸除猾之志，肆残虐幼贱之心。","book":"《隋书·酷吏传序》"},"usage":"作定语；用于社会风尚"},{"id":34752,"word":"禁情割欲","pinyin":"jìn qíng gē yù","abbr":"jqgy","explanation":"制约感情和欲望。","source":{"text":"一岁婴儿，无推让之心：见食，号欲食之；睹好，啼欲玩之。长大之后，禁情割欲，勉励为善矣。","book":"汉王充《论衡·本性》"},"usage":"作谓语、定语；指节欲"},{"id":34753,"word":"禁攻寝兵","pinyin":"jìn gōng qǐn bīng","abbr":"jgqb","explanation":"指止息战事。","source":{"text":"以禁攻寝兵为务。","book":"梁启超《中国学术思想变迁之大势》第三章第二节"},"usage":"作宾语、定语；指停战"},{"id":34754,"word":"禁暴止乱","pinyin":"jìn bào zhǐ luàn","abbr":"jbzl","explanation":"禁：制止；暴：强暴；止：制止，平息；乱：混乱。抑制强暴势力，治理混乱局面。","source":{"text":"然自五帝三王禁暴止乱，非兵，未之闻也。","book":"东汉·班固《汉书·严助传》"},"example":{"text":"诸公当～。","book":"章炳麟《电湘救赵》"},"similar":["禁暴正乱","禁暴诛乱","禁乱除暴"],"usage":"作谓语、宾语；指打击犯罪"},{"id":34755,"word":"禁暴正乱","pinyin":"jìn bào zhèng luàn","abbr":"jbzl","explanation":"禁：制止。正：纠正。抑制强暴势力，治理混乱局面；或禁除暴行，根治叛乱。亦作“禁暴止乱”、“禁暴诛乱”、“禁乱除暴”、“救乱除暴”、“拨乱诛暴”、“止暴","source":{"text":"是我一举而名实两附，而又有禁暴正乱之名。","book":"《战国策·秦策一》"},"similar":["禁暴止乱","禁乱除暴","禁暴诛乱"],"usage":"作谓语、宾语；用于治政等"},{"id":34756,"word":"禁暴诛乱","pinyin":"jìn bào zhū luàn","abbr":"jbzl","explanation":"禁除暴行，诛杀叛乱。亦作“禁暴静乱”。","source":{"text":"其强也，禁暴诛乱而天下服；其弱也，五伯征而诸侯从。","book":"汉贾谊《过秦论》"},"example":{"text":"于是乎立之君，付之以生杀之权，使之～，抑顽恶而扶弱善也。","book":"明刘基《郁离子·蛇蝎》"},"similar":["禁暴静乱","禁暴止乱"],"usage":"作谓语、宾语；指打击犯罪"},{"id":34757,"word":"禁暴静乱","pinyin":"jìn bào jìng luàn","abbr":"jbjl","explanation":"禁：禁止；静：平静。禁除暴行，平静叛乱。","source":{"text":"兵者，所以禁暴静乱者也。","book":"《隋书·经籍志》"},"similar":["禁暴诛乱"],"usage":"作谓语、宾语；指打击犯罪"},{"id":34758,"word":"禁止令行","pinyin":"jìn zhǐ lìng xíng","abbr":"jzlx","explanation":"指施禁则止，出令则行。同“令行禁止”。","source":{"text":"五官强，五兵昌，禁止令行，四夷来王，是之谓战胜于庙堂。","book":"清魏源《叙》"},"similar":["令行禁止"],"usage":"作谓语、宾语、定语；指政策等"},{"id":34759,"word":"禁网疏阔","pinyin":"jìn wǎng shū kuò","abbr":"jwsk","explanation":"指法律过于宽容。","source":{"text":"及汉兴，禁网疏阔，未之匡正。","book":"汉荀悦《汉纪·哀帝纪上》"},"example":{"text":"昔秦任狱吏，赭衣满道。汉革其风，矫枉过正，～，遂漏吞舟。","book":"《隋书·酷吏传序》"},"usage":"作谓语、宾语；用于书面语"},{"id":34760,"word":"禁舍开塞","pinyin":"jìn shě kāi sāi","abbr":"jsks","explanation":"指禁罚和赦免，开放和闭锁。","source":{"text":"今天下诸国，士所率无不及二十万之众，然不能济功名者，不明乎禁舍开塞之道也。","book":"《尉缭子·制谈》"},"example":{"text":"明乎～之道，乘时势，因民欲，而取天下。","book":"《淮南子·兵略训》"},"usage":"作宾语、定语；用于书面语"},{"id":34761,"word":"禁鼎一脔","pinyin":"jìn dǐng yī luán","abbr":"jdyl","explanation":"御用鼎器中的一块肉。比喻珍美之物。","source":{"text":"嗟乎，斯亦禁鼎一脔，尝者可以知其味已。","book":"明沈鲤《序》"},"usage":"作宾语、定语；用于比喻句"},{"id":34762,"word":"禄无常家","pinyin":"lù wú cháng jiā","abbr":"lwcj","explanation":"禄：福。指福禄没有不变的定数。","source":{"text":"禄无常家，福无定门，人谋鬼谋，道在则尊。","book":"晋·挚虞《门铭》"},"similar":["福无定门"],"usage":"作宾语、定语；用于劝诫人"},{"id":34763,"word":"禄无常家，福无定门","pinyin":"lù wú cháng jiā，fú wú dìng mén","abbr":"lwcjfwdm","explanation":"禄：福。指福禄没有不变的定数。","source":{"text":"禄无常家，福无定门，人谋鬼谋，道在则尊。","book":"晋·挚虞《门铭》"},"usage":"作宾语、定语、分句；可分开使用"},{"id":34764,"word":"禅世雕龙","pinyin":"chán shì diāo lóng","abbr":"csdl","explanation":"指文章世代相传。","source":{"text":"崔为文宗，世禅雕龙。","book":"南朝·宋·范晔《后汉书·崔骃传赞》"},"example":{"text":"你雄谭非马，～。","book":"明·梅鼎祚《玉合记·赠处》"},"usage":"作谓语；指好的文章"},{"id":34765,"word":"禅絮沾泥","pinyin":"chán xū zhān ní","abbr":"cxzn","explanation":"比喻禅寂之心受到尘世烦恼的沾染。","source":{"text":"禅心已在沾泥絮，不逐春风上下狂。","book":"宋·参寥《绝句》"},"example":{"text":"兰香来无定处，绿蕊去未移时，想你二人～，当不复悔偷灵药。","book":"清·魏秀仁《花月痕》第49回"},"opposite":["心潮澎湃"],"usage":"作谓语、定语；指心情平静"},{"id":34766,"word":"福不徒来","pinyin":"fú bù tú lái","abbr":"fbtl","explanation":"徒：白白地。幸福不会无故地到来。","source":{"text":"谏者福也，谀者贼也。人生听谀，是愚惑也。虽然，祸不妄至，福不徒来。","book":"《史记·龟策列传》"},"usage":"作宾语、定语；用于书面语"},{"id":34767,"word":"福不盈眦","pinyin":"fú bù yíng zì","abbr":"fbyz","explanation":"指福禄富贵渺小而短暂。","source":{"text":"当富贵之间，视之不满目。","book":"《文选·班固〈答宾戏〉》：“朝为荣华，夕为憔悴，福不盈眦，祸溢于世。”李善注引李奇曰"},"usage":"作宾语、定语；用于书面语"},{"id":34768,"word":"福不重至，祸必重来","pinyin":"fú bù chóng zhì，huò bì chóng lái","abbr":"fbzzhbzl","explanation":"福不会接连而来，祸灾却会接踵而至。","source":{"text":"往年秦拔宜阳，明年大旱，民饥。不以此时恤民之急也，而顾反益奢。此所谓福不重至，祸必重来也。","book":"汉·刘向《说苑·权谋》"},"similar":["福无双至，祸不单行"],"usage":"作宾语、分句；用于书面语"},{"id":34769,"word":"福与天齐","pinyin":"fú yǔ tiān qí","abbr":"fytq","explanation":"形容福气极好。","source":{"text":"因当今福与天齐，行仁孝神圣皆知。","book":"明·无名氏《群仙朝圣》第一折"},"similar":["福齐南山"],"usage":"作谓语、定语；用于祝福等"},{"id":34770,"word":"福业相牵","pinyin":"fú yè xiāng qiān","abbr":"fyxq","explanation":"业：罪孽。指福运与罪孽常常互相牵缠。","source":{"text":"有缘无缘，福业相牵，有缘福至，无缘业缠。","book":"宋·张君房《云笈七签》卷一○三"},"usage":"作宾语、定语；用于劝诫人"},{"id":34771,"word":"福为祸先","pinyin":"fú wéi huò xiān","abbr":"fwhx","explanation":"指福与祸没有定数，享福太甚就隐伏着祸端。同“福为祸始”。","source":{"text":"利为用本，福为祸先。","book":"晋·卢谌《赠刘琨》诗：“福为祸始，祸作福阶。”李善注引《韩诗》"},"similar":["福为祸始"],"usage":"作宾语、定语；用于劝诫人"},{"id":34772,"word":"福为祸始","pinyin":"fú wéi huò shǐ","abbr":"fwhs","explanation":"指福与祸没有定数，享福太甚就隐伏着祸端。亦作“福为祸先”。","source":{"text":"利为用本，福为祸先。","book":"晋·卢谌《赠刘琨》诗：“福为祸始，祸作福阶。”李善注引《韩诗》"},"similar":["福为祸先"],"usage":"作宾语、定语；用于劝诫人"},{"id":34773,"word":"福倚祸伏","pinyin":"fú yǐ huò fú","abbr":"fyhf","explanation":"指福祸互为因果，互相转化。","source":{"text":"祸兮福之所倚；福兮祸之所伏。","book":"《老子》第五十八章"},"usage":"作宾语、定语；用于书面语"},{"id":34774,"word":"福兮祸所伏，祸兮福所倚","pinyin":"fú xī huò suǒ fú，huò xī fú suǒ yī","abbr":"fxhsfhxfsy","explanation":"指福祸互为因果，互相转化。","source":{"text":"祸兮福之所倚；福兮祸之所伏。","book":"《老子》第五十八章"},"example":{"text":"～。忧喜聚门兮，吉凶同域。","book":"汉·贾谊《鹏鸟赋》"},"similar":["福祸相依"],"usage":"作宾语、分句；指福祸互为因果，互相转化"},{"id":34775,"word":"福善祸淫","pinyin":"fú shàn huò yín","abbr":"fshy","explanation":"指行善的得福，作恶的受祸。","source":{"text":"天道福善祸淫，降灾于夏，以彰厥罪。","book":"《尚书·汤诰》"},"example":{"text":"天道～。彼善而富贵，尔淫而贫贱，理也。","book":"清·郑燮《雍正十年杭州韬光庵中寄舍弟墨》"},"usage":"作谓语、宾语；指行善的得福，作恶的受祸"},{"id":34776,"word":"福国利民","pinyin":"fú guó lì mín","abbr":"fglm","explanation":"福：护佑。为国家和人民造福谋利。","source":{"text":"林则徐给其妻郑夫人家书里说：‘盖以身许国，但求福国利民，与民无害。","book":"范文澜《中国近代史》第一章"},"similar":["利国利民"],"opposite":["祸国殃民"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":34777,"word":"福地洞天","pinyin":"fú dì dòng tiān","abbr":"fddt","explanation":"原为道家语，指神道居住的名山胜地。后多比喻风景优美的地方。","source":{"text":"列出十大洞天、三十六小洞天、七十二福地的名称。","book":"唐·杜光庭《洞天福地记》"},"example":{"text":"一到南边，果然山明川丽，如登～。","book":"清·曾朴《孽海花》第七回"},"similar":["洞天福地","名山大川"],"opposite":["穷乡僻壤"],"usage":"作宾语、定语；比喻风景优美的地方"},{"id":34778,"word":"福如东海","pinyin":"fú rú dōng hǎi","abbr":"frdh","explanation":"福气象东海那样大。旧时祝颂语。","source":{"text":"寿比南山，福如东海，佳期。从今后，儿孙昌盛，个个赴丹墀。","book":"明·洪楩《清平山堂话本·花灯轿莲女成佛记》"},"example":{"text":"梁裁缝连忙依着尺寸剪了太太的衣裳，又剪老太太的寿衣，一面嘴里还说了许多“～，寿比南山”的话。","book":"清·吴趼人《糊涂世界》卷六"},"similar":["洪福齐天","福星高照"],"opposite":["生不逢时","时乖命骞"],"usage":"作谓语、定语；与“寿比南山”连用"},{"id":34779,"word":"福如东海，寿比南山","pinyin":"fú rú dōng hǎi，shòu bǐ nán shān","abbr":"frdhsbns","explanation":"南山：终南山。比喻人福气像东海的水一样浩大，寿命如终南山一样长久。","source":{"text":"齐祝赞，愿福如东海，寿比南山。","book":"明·柯丹邱《荆钗记·庆诞》"},"example":{"text":"将八盆松景从板箱抬出一看，却是用松针扎成的‘～’八个大字，却也做的新奇。","book":"清·石玉昆《三侠五义》第42回"},"similar":["福寿双全"],"usage":"作谓语、定语；用于祝福，可分开使用"},{"id":34780,"word":"福如山岳","pinyin":"fú rú shān yuè","abbr":"frsy","explanation":"福：福分；如：象。福分象山一样高。","source":{"text":"若帝求王道，寿齐三光，千变万化，坐民立亡；福如山岳，为人重爱，修道之者，白日升天。","book":"宋·张君房《云笈七签》卷二十五"},"example":{"text":"天道～。彼善而富贵，尔淫而贫贱，理也。","book":"清·郑燮《雍正十年杭州韬光庵中寄舍弟墨》"},"similar":["福如东海"],"usage":"作谓语、定语；用于祝福等"},{"id":34781,"word":"福如海渊","pinyin":"fú rú hǎi yuān","abbr":"frhy","explanation":"渊：深。福气像海那样浩瀚无边。","source":{"text":"愿冯君福如海渊，愿冯君寿比南山。","book":"明·沈受先《三元记·合欢》"},"similar":["福如东海"],"usage":"作谓语、定语；用于祝福"},{"id":34782,"word":"福孙荫子","pinyin":"fú sūn yìn zǐ","abbr":"fsyz","explanation":"指福荫及于子孙。","source":{"text":"这坟呵，只愿得中干燥，福孙荫子也者难料；便荫得个三公，也济不得亲老。","book":"元·本高明《琵琶记·五娘葬公婆》"},"usage":"作谓语、定语；用于书面语"},{"id":34783,"word":"福寿双全","pinyin":"fú shòu shuāng quán","abbr":"fssq","explanation":"既有福分，又得高寿。","source":{"text":"要说个个都是福寿双全，这句话只怕未必，大概总有几位不足去处。","book":"清·李汝珍《镜花缘》第七十一回"},"example":{"text":"老祖宗只有伶俐聪明过我十倍的，怎么如今这么～的？（清·曹雪芹《红楼梦》第五十二回）"},"similar":["多福多寿"],"usage":"作谓语、定语、补语；用于祝福等"},{"id":34784,"word":"福寿天成","pinyin":"fú shòu tiān chèng","abbr":"fstc","explanation":"人的福分和寿命都是天命注定的。","source":{"text":"可见老爷福寿天成，故寿烛中亦显此祥瑞。","book":"明·王世贞《鸣凤记·严嵩庆寿》"},"usage":"作谓语、宾语；用于口语"},{"id":34785,"word":"福寿年高","pinyin":"fú shòu nián gāo","abbr":"fsng","explanation":"年高：年龄大。有福有寿，长命百岁。","source":{"text":"他道我福寿年高，着我似松柏齐肩老。","book":"元·郑廷玉《忍字记》第一折"},"usage":"作谓语；用作祝颂之辞"},{"id":34786,"word":"福寿康宁","pinyin":"fú shòu kāng níng","abbr":"fskn","explanation":"祝颂语。谓幸福、长寿、健康、安宁诸福齐备。","source":{"text":"福寿康宁，子孙彬彬然，皆有可能者，天于夏卿亦何所负哉！","book":"宋·陈亮《喻夏卿墓志》"},"example":{"text":"是的，皇上会永远～了。","book":"郭沫若《高渐离》第二幕"},"usage":"作谓语、定语；用于祝福"},{"id":34787,"word":"福寿无疆","pinyin":"fú shòu wú jiāng","abbr":"fswj","explanation":"疆：极限，止境。福分与年寿都无止境。是祝颂之辞。","source":{"text":"至诚君子，得而宝之，即福寿无疆。","book":"宋·张君房《云笈七签》第六十九卷"},"example":{"text":"那其间新情旧意休偏向，愿太师～。","book":"《元曲选·连环计》"},"similar":["福寿绵绵"],"usage":"作谓语；用于祝颂"},{"id":34788,"word":"福寿绵绵","pinyin":"fú shòu mián mián","abbr":"fsmm","explanation":"福多寿高。是祝颂之辞。","source":{"text":"则愿的哥哥福寿绵绵，松柏齐肩者。","book":"元·郑廷玉《忍字记》第一折"},"similar":["福寿绵长"],"usage":"作谓语；用于祝颂"},{"id":34789,"word":"福寿绵长","pinyin":"fú shòu mián cháng","abbr":"fsmz","explanation":"福多寿高。是祝颂之辞。","source":{"text":"则愿的哥哥福寿绵绵，松柏齐肩者。","book":"元·郑廷玉《忍字记》第一折"},"example":{"text":"但愿时时敬诵，自然消凶聚庆，～。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["福寿绵绵"],"usage":"作谓语；用于祝颂"},{"id":34790,"word":"福寿齐天","pinyin":"fú shòu qí tiān","abbr":"fsqt","explanation":"福寿与天一样高。是祝颂之辞。","source":{"text":"俺从神圣降临下方，庆贺了元宵，祝延圣主福寿齐天也。","book":"明·无名氏《贺元宵》第三折"},"example":{"text":"会众官同来称贺，齐祝赞～。","book":"明·无名氏《广成子》第三折"},"similar":["洪福齐天"],"usage":"作谓语；用作祝颂之辞"},{"id":34791,"word":"福慧双修","pinyin":"fú huì shuāng xiū","abbr":"fhsx","explanation":"原指福德和智能都达到至善的境地。现指有福气又聪敏。","source":{"text":"菩萨为行，福慧双修，智人得果，不忘其本。","book":"唐·慧立《大慈恩寺三藏法师传》"},"example":{"text":"清·陈康祺《郎潜纪闻》：“惟生际承平，天假耆寿，文名盖代，～。”"},"usage":"作谓语、定语；指有福气，又聪明"},{"id":34792,"word":"福无十全","pinyin":"fú wú shí quán","abbr":"fwsq","explanation":"有福的人也不可能十全十美，毫无缺陷。","source":{"text":"子心罔极，福无十全。登进方隆，忍此弃捐。","book":"宋·陈亮《祭钱伯同母硕人书》"},"usage":"作宾语、定语；用于劝诫人"},{"id":34793,"word":"福无双至","pinyin":"fú wú shuāng zhì","abbr":"fwsz","explanation":"指幸运的事不会接连到来。","source":{"text":"此所谓福不重至，祸必重来者也。","book":"汉·刘向《说苑·权谋》"},"example":{"text":"宋江听罢，扯定两个公人说道：“却是苦也！正是‘～，祸不单行。’”","book":"明·施耐庵《水浒会传》第三十七回"},"similar":["福不重至"],"opposite":["祸不单行"],"usage":"作宾语、分句；常与“祸不单行”连用"},{"id":34794,"word":"福无双至，祸不单行","pinyin":"fú wú shuāng zhì，huò bù dān xíng","abbr":"fwszhbdx","explanation":"指幸运事不会连续到来，祸事却会接踵而至。","source":{"text":"却是苦也！正是‘福无双至，祸不单行。’","book":"明·施耐庵《水浒全传》第三十七回：“宋江听罢，扯定两个公人说道"},"example":{"text":"那金莲听了，心里犹如刀割一般，说道：“公子，这叫～，总是我王金莲害了公子。”","book":"清·佚名《说呼全传》第十回"},"similar":["福无双降，祸不单行"],"usage":"作宾语、分句；用于书面语，可分开使用"},{"id":34795,"word":"福无双降，祸不单行","pinyin":"fú wú shuāng jiàng，huò bù dān xíng","abbr":"fwsjhbdx","explanation":"降：降临。福不会接连而来，祸灾却会接踵而至。","source":{"text":"这才是福无双降，祸不单行。我才脱了天条死难……又撞着这般恶魔，他来害我！","book":"明·吴承恩《西游记》第15回"},"similar":["福无双至，祸不单行"],"usage":"作宾语、分句；可分开使用"},{"id":34796,"word":"福星高照","pinyin":"fú xīng gāo zhào","abbr":"fxgz","explanation":"形容人很幸运，有福气。","source":{"text":"保管你这一瞧，就抵得个福星高照。","book":"清·文康《儿女英雄传》第39回"},"example":{"text":"我想一定是～，否则没有这么顺利的。"},"similar":["洪福齐天","福如东海"],"opposite":["生不逢时","祸不单行"],"usage":"作谓语、定语；形容人很幸运，有福气"},{"id":34797,"word":"福浅命薄","pinyin":"fú qiǎn mìng bó","abbr":"fqmb","explanation":"福分浅薄，命运不好，无福消受。","source":{"text":"这是妾福浅命薄，不能保养潜龙。是妾之罪，与陛下何与？","book":"清·褚人获《隋唐演义》第36回"},"usage":"作谓语、定语；用于自谦"},{"id":34798,"word":"福生于微","pinyin":"fú shēbg yú wēi","abbr":"fsyw","explanation":"福：福分；生：产生；微：古代长度单位，为一寸的百万分之一。福分产生于极微小因素的积累。","source":{"text":"福生于微，祸生于忽，日夜恐惧，唯恐不卒。","book":"汉·刘向《说苑·谈丛》"},"usage":"作宾语、定语；指福在细小的事情中"},{"id":34799,"word":"福由心造","pinyin":"fú yóu xīn zào","abbr":"fyxz","explanation":"心地好，能行善，就能得到幸福。","source":{"text":"绍闻忽然想起，此厅当日俱是猥亵之语，与今日相较，天渊相悬，云泥迥隔，可见地因人灵，福由心造。","book":"清·李绿园《歧路灯》第九十九回"},"usage":"作宾语、定语；用于劝诫人"},{"id":34800,"word":"福禄双全","pinyin":"fú lù shuāng quán","abbr":"flsq","explanation":"福：福气；禄：俸禄。既有福气，又做官，享受俸禄。","source":{"text":"俺如今福禄双全，稳拍拍的绿窗下做针线。","book":"元·贾仲名《对玉梳》第四折"},"example":{"text":"愿他多生贵子，～。","book":"明·沈受先《三元记·秉操》"},"usage":"作谓语；指当官"},{"id":34801,"word":"福禄未艾","pinyin":"fú lù wèi ài","abbr":"flwa","explanation":"福禄：福气与禄位；艾：停止。福气和禄位还没有停止。指还可以继续高升，享有荣华富贵。","source":{"text":"古人有言，知将不为福将。臣观参知政事王钦若，福禄未艾，宜可为守。","book":"宋·魏泰《东轩笔录》卷一"}},{"id":34802,"word":"福禄长久","pinyin":"fú lù cháng jiǔ","abbr":"flcj","explanation":"福：福气；禄：俸禄。旧指世代高官富贵。用作祝贺之辞。","source":{"text":"君子万年，福禄宜之。","book":"《诗经·小雅·鸳鸯》"}},{"id":34803,"word":"福至心灵","pinyin":"fú zhì xīn líng","abbr":"fzxl","explanation":"福：幸运。意思是人运气来了，心也变得灵巧了。","source":{"text":"吴参政少以学究登科，复中贤良，为翰林学士。常常草制以示欧阳文忠，称之，因戏曰：‘君福至心灵。’","book":"宋·毕仲洵《幕府蒌闲录》"},"example":{"text":"自古道：“～”，三场完毕，没有出岔子，等到出榜，居然高高的中了。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["福至性灵"],"opposite":["祸来神昧"],"usage":"作谓语；指人幸福的时候"},{"id":34804,"word":"福至性灵","pinyin":"fú zhì xìng líng","abbr":"fzxl","explanation":"性灵：聪明。形容福运到来，人变得聪明了。","source":{"text":"亦是他福至性灵，忽又想到一个绝妙计策，仍旧上来见老师。","book":"清·李宝嘉《官场现形记》第56回"},"similar":["福至心灵"],"usage":"作谓语、定语；用于口语"},{"id":34805,"word":"福薄灾生","pinyin":"fú bó zāi shēng","abbr":"fbzs","explanation":"薄：轻薄，少。福分少，灾祸便容易发生。","source":{"text":"若是再胡弄起来，这便是福薄灾生了。","book":"清·李绿园《歧路灯》第二十八回"},"example":{"text":"门生想在这里报效老师，无奈门生～，门生的母亲又生起病来，门生不得不回去。","book":"清·李宝嘉《官场现形记》第五十六回"},"usage":"作谓语、宾语；指人的命运"},{"id":34806,"word":"福衢寿车","pinyin":"fú qú shòu chē","abbr":"fqsc","explanation":"通往福寿的道路和车子。指获取福寿的途径。"},{"id":34807,"word":"福轻命薄","pinyin":"fú qīng mìng bó","abbr":"fqmb","explanation":"指没福消受，短命。","source":{"text":"只怪她自己～，无法消受。"},"example":{"text":"只怪她自己～，无法消受"},"opposite":["福大命大"],"usage":"作谓语、定语；用于短命"},{"id":34808,"word":"福过灾生","pinyin":"fú guò zāi shēng","abbr":"fgzs","explanation":"幸福到了极点就转化为灾祸。比喻乐极生悲。","source":{"text":"无劳受遇，无与臣比。小人禄薄，福过灾生，止足之分，臣所宜守。","book":"《晋书·庾亮传》"},"example":{"text":"明公功名到此，已无可加，急流勇退，此其时矣。直待～，只恐悔之无及。","book":"明·凌濛初《二刻拍案惊奇》卷十九"},"similar":["乐极生悲","福过祸生"],"opposite":["否极泰来"],"usage":"作宾语、定语；指人乐极生悲"},{"id":34809,"word":"福过祸生","pinyin":"fú guò huò shēng","abbr":"fghs","explanation":"过：太甚。幸福到了极点就转化为灾祸。形容人乐极生悲。","source":{"text":"今此杖节，常惧福过祸生，实思避盈居损，富贵之旨，非所敢当。","book":"《宋书·刘敬宣传》"},"similar":["福过灾生"],"usage":"作宾语、定语；指人乐极生悲"},{"id":34810,"word":"福齐南山","pinyin":"fú qí nán shān","abbr":"fqns","explanation":"祝颂之辞。指福分如南山一样高。","source":{"text":"常谓福齐南山，庆钟仁寿。","book":"《南齐书·豫章献王嶷传》"},"similar":["福如东海"],"usage":"作谓语、定语、宾语；用于祝福"},{"id":34811,"word":"禹惜寸阴","pinyin":"yǔ xī cùn yīn","abbr":"yxcy","explanation":"指禹勤于治水，爱惜光阴之事。","source":{"text":"（陶侃）常语人曰：‘大禹圣者，乃惜寸阴，至于众人，当惜分阴，岂可逸游荒醉，生无益于时，死无闻于后，是自弃也。’","book":"《晋书·陶侃传》"},"example":{"text":"大～，况我无才身。","book":"唐·李群玉《送萧绾之桂林》诗"}},{"id":34812,"word":"禹行舜趋","pinyin":"yǔ xíng shùn qū","abbr":"yxsq","explanation":"原指仅模仿圣贤之外表而不注意内在的品德修养。后亦用以形容举止循规蹈距。","source":{"text":"但宗圣人之威仪而已矣。","book":"《荀子·非十二子》：“禹行而舜趋，是子张氏之贱儒也。”杨倞注"},"example":{"text":"彼见夫盛名鼎鼎之先辈，明目张胆以为乡党自好者所不为之事，而其受社会之崇拜，享学界之尸祝自若也，则更何必自苦以强为～之容也。","book":"梁启超《论私德》"},"usage":"作定语；指模仿"},{"id":34813,"word":"离世异俗","pinyin":"lí shì yì sú","abbr":"lsys","explanation":"指超脱世俗。","source":{"text":"刻意尚行，离世异俗，高论怨诽，为亢而已矣，此山谷之士，非世之人，枯槁赴渊者之所好也。","book":"《庄子·刻意》"},"example":{"text":"士固有～，独行其意，骂讥、笑侮、困辱而不悔。","book":"宋·王安石《泰州海陵县主簿许君墓志铭》"},"similar":["离世绝俗"],"usage":"作谓语、定语；用于书面语"},{"id":34814,"word":"离世绝俗","pinyin":"lí shì jué sú","abbr":"lsjs","explanation":"犹言离世异俗。指超脱世俗。","source":{"text":"伯夷不立于恶人之朝，不与恶人言，可谓离世绝俗矣。","book":"宋·罗大经《鹤林玉露》卷九"},"example":{"text":"且北方之人，不为～之举，而日周旋于君臣父子夫妇之间。","book":"王国维《屈子文学之精神》"},"similar":["离世异俗"],"usage":"作谓语、定语；用于书面语"},{"id":34815,"word":"离世遁上","pinyin":"lí shì dùn shàng","abbr":"lsds","explanation":"超脱世俗，回避君上。","source":{"text":"为故人行私，谓之‘不弃’；以公财分施，谓之‘仁人’；轻禄重身，谓之‘君子’；枉法曲亲，谓之‘有行’；弃官宠交，谓之‘有侠’；离世遁上，谓之‘高傲’；交争逆令，谓之‘刚材’。","book":"《韩非子·八说》"}},{"id":34816,"word":"离乡别井","pinyin":"lí xiāng bié jǐng","abbr":"lxbj","explanation":"离开家乡到外地。同“离乡背井”。","source":{"text":"离乡别井，劳碌奔驰，不分蚤夜。","book":"中国近代史资料丛刊《太平天国·天情道理书》"},"example":{"text":"我怎能让驴哥～，远道从军呢？","book":"许地山《女国士》"},"similar":["离乡背井","离乡别土"],"usage":"作谓语、定语；指在外瓢泊"},{"id":34817,"word":"离乡别土","pinyin":"lí xiāng bié tǔ","abbr":"lxbt","explanation":"离开家乡到外地。同“离乡背井”。","source":{"text":"买得山花一两栽，离乡别土易摧颓。","book":"唐·元稹《花栽》诗"},"similar":["离乡背土","背井离乡"],"opposite":["安居乐业"],"usage":"作谓语、宾语、定语；用于飘泊的生活"},{"id":34818,"word":"离乡背井","pinyin":"lí xiāng bèi jǐng","abbr":"lxbj","explanation":"背：离开；井：古制八家为井，引伸为乡里，家宅。离开家乡到外地。","source":{"text":"送的他离乡背井，进退无门。","book":"元·贾仲名《对玉梳》第一折"},"example":{"text":"有许多本地的干部，现在要～，到前方去。","book":"毛泽东《关于重庆谈判》"},"similar":["颠沛流离","流离失所"],"opposite":["安居乐业","安土重迁"],"usage":"作谓语、定语；指在外瓢泊"},{"id":34819,"word":"离乡背土","pinyin":"lí xiāng bèi tǔ","abbr":"lxbt","explanation":"离开家乡到外地。同“离乡别土”。","source":{"text":"恨流民尚在途，留不住都弃业抛家，当不得也离乡背土。","book":"元·张浩养《一枝花·咏喜雨》套曲"},"similar":["离乡别土"],"opposite":["安居乐业"],"usage":"作谓语、宾语、定语；用于飘泊的生活"},{"id":34820,"word":"离削自守","pinyin":"lí xuē zì shǒu","abbr":"lxzs","explanation":"离：分散；削：削弱；自守：使之能安分守己。指古代中央政权对诸侯的势力实行分散、削弱的办法，使之安分守己，不再叛乱。","source":{"text":"后乃谋臣献画，而离削自守矣。","book":"唐·柳宗元《封建论》"}},{"id":34821,"word":"离合悲欢","pinyin":"lí hé bēi huān","abbr":"lhbh","explanation":"泛指别离、团聚、悲哀、喜悦的种种遭遇和心态。","source":{"text":"佳人才子古难并，苦离分，巧完成，离合悲欢只在眼前生。","book":"明·陆采《明珠记·提纲》"},"example":{"text":"其间～，兴衰际遇，俱是按迹循踪。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["悲欢离合","喜怒哀乐"],"opposite":["平淡无奇"],"usage":"作宾语、定语；指人的聚散心情"},{"id":34822,"word":"离多会少","pinyin":"lí duō huì shǎo","abbr":"ldhs","explanation":"离别的时候多，在一起的时间少。","source":{"text":"长恨离多会少，重访问竹西，珠泪盈把。","book":"宋·江夔《探春慢》词"},"example":{"text":"恰楚泽深，秦关杳，泰华高，叹人生～。","book":"元·郑德辉《倩女离魂》第一折"}},{"id":34823,"word":"离奇古怪","pinyin":"lí qí gǔ guài","abbr":"lqgg","explanation":"十分奇特少见。","source":{"text":"曼近日所遭，离奇古怪，待长者今冬回申，当极谈耳。","book":"苏曼殊《与刘三书》"},"example":{"text":"一时间好像沉进洪荒远古的宁静里，忘记自己，脑子里幻出～的神话。","book":"杨朔《赤道雪》"},"similar":["天方夜谭"],"opposite":["司空见惯"],"usage":"作谓语、定语；指奇特的东西"},{"id":34824,"word":"离娄之明","pinyin":"lí lóu zhī míng","abbr":"llzm","explanation":"古代夜总会离娄的视力非常好，能于百步之外看到秋毫之末。比喻视力极佳。","source":{"text":"离娄之明，公输子之巧，不以规矩，不能成方圆。","book":"《孟子·离娄上》"},"example":{"text":"虽大禹之智，不能测其浅深；～，焉能辨乎咫尺！","book":"明·罗贯中《三国演义》第四十六回"},"usage":"作宾语；用于比喻句"},{"id":34825,"word":"离山调虎","pinyin":"lí shān diào hǔ","abbr":"lsdh","explanation":"比喻用计谋调动对方离开原地。","source":{"text":"岳老爷得胜不班师，秦桧东窗定巧计，私造金牌传假旨，暗使离山调虎计，风波亭上死的屈。","book":"《白雪遗音·八角鼓·精忠》"},"similar":["调虎离山"],"usage":"作谓语、定语；用于军事等"},{"id":34826,"word":"离弦走板","pinyin":"lí xián zǒu bǎn","abbr":"lxzb","explanation":"比喻言行偏离公认的准则。","example":{"text":"你这样说话未免有点～了。"},"usage":"作宾语、定语；用于比喻句"},{"id":34827,"word":"离心离德","pinyin":"lí xīn lí dé","abbr":"lxld","explanation":"心、德：心意。思想不统一，信念也不一致。指不一条心。","source":{"text":"受（纣）有亿兆夷人，离心离德。","book":"《尚书·泰誓中》"},"example":{"text":"黎民～，祸生不测。","book":"明·许仲琳《封神演义》第十七回"},"similar":["背信弃义","三心二意","离经背道"],"opposite":["忠贞不二","同心同德"],"usage":"作谓语、定语；指不团结","story":["商朝末年，纣王荒淫无道、暴虐成性。手下的官员都是离心离德，军心涣散。周武王联合西部的八个诸侯，集结4万兵力，亲自率军征讨纣王。在出发前的誓师会上，他发表演讲，表示上下要同心同德，不消灭纣王誓不罢休"]},{"id":34828,"word":"离情别恨","pinyin":"lí qíng bié hèn","abbr":"lqbh","explanation":"分离前后惜别、相思的愁苦情绪。","source":{"text":"离情别恨多少，条条结向垂杨缕。","book":"五代·毛熙震《临江仙》词：“几回偷看寄来书，离情别恨，相隔欲何如。”宋·欧阳修《梁州令》"},"example":{"text":"星桥鹊驾，经年才见，想～难穷。","book":"宋·李清照《行香子》词"}},{"id":34829,"word":"离情别绪","pinyin":"lí qíng bié xù","abbr":"lqbx","explanation":"分离前后惜别、相思的愁苦情绪。","source":{"text":"离情别恨多少，条条结向垂杨缕。","book":"宋·欧阳修《梁州令》"},"example":{"text":"昨天是第一次重逢，说不完那许多～，而今天便觉得无话可谈了。","book":"茅盾《子夜》十八"},"usage":"作宾语；指离别的情绪"},{"id":34830,"word":"离情别苦","pinyin":"lí qíng bié kǔ","abbr":"lqbk","explanation":"分离前后惜别、相思的愁苦情绪。","source":{"text":"离情别恨多少，条条结向垂杨缕。","book":"五代·毛熙震《临江仙》词：“几回偷看寄来书，离情别恨，相隔欲何如。”宋·欧阳修《梁州令》"},"example":{"text":"生怕～，多少事，欲说还休。","book":"宋·李清照《凤凰台上忆吹箫》词"}},{"id":34831,"word":"离本依末","pinyin":"lí běn yī mò","abbr":"lbym","explanation":"丢掉根本，追逐末节。同“离本趣末”。","source":{"text":"然而律文烦广，事比众多，离本依末。","book":"《晋书·刑法志》"},"similar":["离本趣末"],"usage":"作谓语、宾语；指丢掉根本，追逐末节"},{"id":34832,"word":"离本徼末","pinyin":"lí běn yāo mò","abbr":"lbym","explanation":"犹言舍本逐末。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"侈而无节，则不可赡，民离本而徼末矣。","book":"《汉书·严安传》"},"usage":"作谓语、定语；用于书面语"},{"id":34833,"word":"离本趣末","pinyin":"lí běn qū mò","abbr":"lbqm","explanation":"趣：通“趋”，趋向。丢掉根本，追逐末节。","source":{"text":"以此毒天下之民，莫不离本趣末，事以伪成。","book":"汉·徐幹《中论·考伪》"},"similar":["舍本逐末","离本依末"],"usage":"作谓语、宾语；指丢掉根本，追逐末节"},{"id":34834,"word":"离析分崩","pinyin":"lí xī fēn bēng","abbr":"lxfb","explanation":"形容国家、集团或组织分裂瓦解。","source":{"text":"使那整个的侵略阵营已经开始着离析分崩。","book":"郭沫若《新华颂·顶天立地的巨人》"},"similar":["分崩离析"],"opposite":["坚不可摧"],"usage":"作谓语、定语；形容国家或集团分裂瓦解"},{"id":34835,"word":"离析涣奔","pinyin":"lí xī huàn bēn","abbr":"lxhb","explanation":"形容国家、集团或组织分裂瓦解。同“离析分崩”。","source":{"text":"丰亨豫大之言，壹倡于天历之世；离析涣奔之祸，驯致于至正之朝。","book":"明·宋濂《进〈元史〉表》"},"similar":["离析分崩"],"usage":"作谓语、定语；用于比喻句"},{"id":34836,"word":"离疏释蹻","pinyin":"lí shū shì jué","abbr":"lssj","explanation":"疏：指疏食，粗糙的饭食；蹻：草鞋。不再吃粗糙的饭食，脱掉脚下的草鞋。比喻脱离困难艰苦的生活。","source":{"text":"离疏释蹻而享膏梁。","book":"《汉书·王褒传》"}},{"id":34837,"word":"离离矗矗","pinyin":"lí lí chù chù","abbr":"llcc","explanation":"浓密挺拔的样子。","source":{"text":"竹节促而虬叶毨毨，如猬毛、如松狗尾，离离矗矗，捎捩攒挤，若有所惊者。","book":"明·张岱《陶庵梦忆·山艇子》"}},{"id":34838,"word":"离经叛道","pinyin":"lí jīng pàn dào","abbr":"ljpd","explanation":"离：背离，不遵守。原指违反封建统治阶级所尊奉的经典和教条。现泛指背离占主导地位的理论或学说。","source":{"text":"旦本官志大言浮，离经畔道。","book":"元·费唐臣《苏子瞻风雪贬黄州》第一折"},"example":{"text":"他早就说过，与其目击儿子那样的“～”的生活，倒不如死了好！他绝对不愿意到上海。","book":"茅盾《子夜》一"},"similar":["大逆不道","背信弃义"],"opposite":["安分守己","墨守成规","循规蹈矩"],"usage":"作宾语、定语、状语；指背离正道"},{"id":34839,"word":"离经畔道","pinyin":"lí jīng pàn dào","abbr":"ljpd","explanation":"①指思想、言行背离儒家经典和规范。②指背离占统治地位的思想和行为规范。","source":{"text":"子真不待教而诛之人也！吾房中师弟授受，绍闻知之统，继精一之传，岂可以容离经畔道之人哉！","book":"元·费唐臣《贬黄州》第一折：“且本官志大言浮，离经畔道，见新法之行，往往行诸吟咏。”清·李百川《绿野仙踪》第七回"},"example":{"text":"倡导太阳系统的妖魔，～的哥白尼呀！","book":"郭沫若《匪徒颂》"},"similar":["离经叛道"],"opposite":["循规蹈矩"],"usage":"作宾语、定语、状语；指背离正道"},{"id":34840,"word":"离经辨志","pinyin":"lí jīng biàn zhì","abbr":"ljbz","explanation":"离：指断句；经：指儒家经书；辨：明察；志：志向。读断经书文句，明察圣贤志向。","source":{"text":"一年视离经辨志，三年视敬业乐群，五年视博习亲师，七年视论学取友，谓之小成。","book":"《礼记·学记》"},"usage":"作谓语、宾语；用于读书"},{"id":34841,"word":"离群索处","pinyin":"lí qún suǒ chǔ","abbr":"lqsc","explanation":"索：孤单。离开集体或群众，过孤独的生活。","source":{"text":"吾离群而索居，亦已久矣。","book":"《礼记·檀弓上》"},"example":{"text":"相看比老都能几，犹作～人。","book":"元·王恽《和彦正宪使寄周宰诗韵且酬前日见赠之什》诗"}},{"id":34842,"word":"离群索居","pinyin":"lí qún suǒ jū","abbr":"lqsj","explanation":"索：孤单。离开集体或群众，过孤独的生活。","source":{"text":"吾离群而索居，亦已久矣。","book":"《礼记·檀弓上》"},"example":{"text":"～，日对古人，研精覃思，宁无心得，未若取径乎此之捷而适也。","book":"清·况周颐《蕙风词话》卷一"},"similar":["销声匿迹","孤苦伶仃","孤家寡人"],"opposite":["和睦相处","和衷共济","精诚团结"],"usage":"作谓语、定语；用于人或动物","story":["春秋时期，孔子的学生子夏生性孤僻，平时很少与同学合群，只与曾参比较要好。子夏的儿子死了，他差一点哭瞎了眼睛。曾参前去批评他，子夏听后，如梦初醒，觉得自己离群索居很久就造成这样，于是节哀顺变，与同学打成一片"]},{"id":34843,"word":"离蔬释屩","pinyin":"lí shū shì zhe","abbr":"lssj","explanation":"比喻脱离清苦生活，入身仕官。同“离蔬释蹻”。"},{"id":34844,"word":"离蔬释蹻","pinyin":"lí shū shì zhe","abbr":"lssj","explanation":"离开蔬食，脱去木屐（一说为草鞋）。比喻脱离清苦生活，入身仕官。","source":{"text":"去卑辱奥渫而升本朝，离蔬释蹻而享膏粱。","book":"《文选·王褒〈圣主得贤臣颂〉》"}},{"id":34845,"word":"离蔬释躥","pinyin":"lí shū shì zhe","abbr":"lssz","explanation":"离开蔬食，脱去木屐（一说为草鞋）。比喻脱离清苦生活，入身仕官。","source":{"text":"去卑辱奥渫而升本朝，离蔬释躥而享膏粱。","book":"《文选·王褒〈圣主得贤臣颂〉》"}},{"id":34846,"word":"离题万里","pinyin":"lí tí wàn lǐ","abbr":"ltwl","explanation":"形容写文章或说话同要讲得主题距离很远，毫不相干。","source":{"text":"有些人说话爱跑野马，闹得‘游骑无归’。有些人作文‘下笔千言，离题万里’。","book":"朱自清《论废话》"},"example":{"text":"写文章要抓住中心，决不能下笔千言，离题万里。"},"similar":["夸夸其谈","空洞无物","废话连篇"],"opposite":["一语道破","一针见血","一字千金"],"usage":"作谓语、宾语、定语；指不着边际","story":["从前有一个自以为是的文人被人戏称为博士，他上街买了一头驴子，按当时的习惯，买家要给卖家写一份合同。博士铺开白纸，下笔千言，足足写了三大张跟驴无关的废话。卖驴人等得不耐烦就催他快点，他忙说不急还没写到“驴”字"]},{"id":34847,"word":"离题太远","pinyin":"lí tí tài yuǎn","abbr":"ltty","explanation":"离开主题很远，不着边际。","source":{"text":"咱们把大家请来，主要是想听听大家谈文学，不要离题太远。","book":"王朔《千万别把我当人》"},"example":{"text":"你的作文～，不能给分。"},"similar":["离题万里"],"opposite":["切中要害"],"usage":"作谓语；指不着边际","story":["从前有一个自以为是的文人被人戏称为博士，他上街买了一头驴子，按当时的习惯，买家要给卖家写一份合同。博士铺开白纸，下笔千言，足足写了三大张跟驴无关的废话。卖驴人等得不耐烦就催他快点，他忙说不急还没写到“驴”字"]},{"id":34848,"word":"离魂倩女","pinyin":"lí hún qiàn nǚ","abbr":"lhqn","explanation":"倩女：美丽的少女。旧时指少女为爱情而死。","source":{"text":"唐·陈玄祐《离魂记》"},"example":{"text":"因是推之，知所谓～，其事当不过如斯。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"similar":["倩女离魂"],"usage":"作宾语、定语；多用于男女爱情"},{"id":34849,"word":"离鸾别凤","pinyin":"lí luán bié fèng","abbr":"llbf","explanation":"鸾：传说中凤凰一类的鸟。比喻夫妻离散。","source":{"text":"离鸾别凤烟梧中。","book":"唐·李贺《湘妃》诗"},"example":{"text":"当日正女功，手挦着绣绒，画楼中忽闻听远院琴三弄，～恨匆匆，泪双垂，把不住乡心动。","book":"元·无名氏《梧桐叶》第四折"},"opposite":["缺月再圆"],"usage":"作宾语；比喻夫妻离散"},{"id":34850,"word":"离鸾别鹄","pinyin":"lí luán bié hú","abbr":"llbh","explanation":"比喻夫妻离散。同“离鸾别凤”。","source":{"text":"如今是痴梦、好梦、富贵梦都已醒来，觉得依旧，与未梦时反添了许多惆怅，费了许多精神，徒替他们勤作护花铃，而到底终成离鸾别鹄。","book":"清·俞达《青楼梦》第五十八回"}},{"id":34851,"word":"离鸾别鹤","pinyin":"lí luán bié hè","abbr":"llbh","explanation":"比喻夫妻离散。同“离鸾别凤”。","source":{"text":"唐刘商《胡笳曲序》曰：‘蔡文姬善琴，能为《离鸾别鹤之操》。’","book":"《乐府诗集·琴曲歌辞三·胡笳十八拍》"},"example":{"text":"忽听梨园新乐府，～清如许。","book":"元·卢挚《蝶恋花·前度归田菘下住》词"}},{"id":34852,"word":"禽兽不如","pinyin":"qín shòu bù rú","abbr":"qsbr","explanation":"连禽兽不如。形容人格低下，品行极坏。","source":{"text":"杀父，禽兽之类也。杀母，禽兽之不若。","book":"《晋书·阮籍传》"},"example":{"text":"你干这种伤天害理的事，真是～。"},"similar":["禽兽不若"],"usage":"作谓语、定语、宾语；指人丑恶","story":["三国时期，魏国东平相阮籍才华出众，思维敏捷，深受文帝司马昭的喜爱。阮籍治郡，法令清晰简单，深受百姓的爱戴。一次听说一个人杀了他的母亲，他说杀父还说得过去，杀母怎么可以？杀父是禽兽的行为，杀母是连禽兽都不如"]},{"id":34853,"word":"禽兽不若","pinyin":"qín shòu bù ruò","abbr":"qsbr","explanation":"连禽兽不如。形容人格低下，品行极坏。","source":{"text":"海青乃能尽忠如此，彼张均、张洎辈，真禽兽不若矣！","book":"清·褚人获《隋唐演义》第95回"},"similar":["禽兽不如"],"usage":"作谓语、定语、宾语；指人丑恶"},{"id":34854,"word":"禽困覆车","pinyin":"qín kùn fù chē","abbr":"qkfc","explanation":"禽兽被围捕急了，也会把人的车子撞翻。比喻人在走投无路时就会冒险。","source":{"text":"韩公仲使苏代谓向寿曰：‘禽困覆车。’","book":"西汉·司马迁《史记·樗里子甘茂列传》"},"example":{"text":"韩公仲谓向寿曰：‘～’。","book":"西汉·刘向《战国策·韩策一》"},"similar":["困兽犹斗","狗急跳墙"],"usage":"作定语、宾语；比喻人在走投无路时"},{"id":34855,"word":"禽奔兽遁","pinyin":"qín bēn shòu dùn","abbr":"qbsd","explanation":"遁：逃避。指禽兽奔逃躲避。比喻人奔波追逐。","source":{"text":"及其后世失德，而诸侯禽奔兽遁，各固其国，以相侵扰，而其上之人卒不语。","book":"宋·苏洵《审势》"},"usage":"作宾语、定语；用于生活"},{"id":34856,"word":"禽息鸟视","pinyin":"qín xī niǎo shì","abbr":"qxns","explanation":"比喻生活优裕而对社会不能做一点有益的事。","source":{"text":"虚荷上位，而忝重禄，禽息鸟视，终于白首。此徒圈牢之养物，非臣之所志也。","book":"三国·魏·曹植《求自试表》"},"example":{"text":"使上下之诚相照，恩结于其心，是岂～而不知荷恩尽力哉？","book":"宋·王安石《委任》"},"usage":"作谓语、定语；指空受爵禄而无益于世"},{"id":34857,"word":"禾头生耳","pinyin":"hé tóu shēng ěr","abbr":"htse","explanation":"禾头：农作物的顶端；耳：耳状物，指谷物经雨而长出的芽。庄稼顶部出芽，那么这种庄稼也就报废了。此为灾年的征兆。","source":{"text":"禾头生耳黍穗黑，农夫田父无消息。","book":"唐·杜甫《秋雨叹》"},"example":{"text":"春雨甲子，赤地千里；夏雨甲子，乘舟入市；秋雨甲子，～。","book":"唐·张鷟《朝野佥载》"},"similar":["禾生耳"],"usage":"作宾语、定语；用于书面语"},{"id":34858,"word":"禾生耳","pinyin":"hé shēng ěr","abbr":"hse","explanation":"耳：耳状物。禾头长出牙蘖，庄稼就报废。灾年的象征。","source":{"text":"溪田雨涨禾生耳，原野莺啼黍熟时。","book":"南唐·李建勋《闲出书怀》"},"similar":["禾头生耳"],"usage":"作宾语、定语；用于书面语"},{"id":34859,"word":"禾黍之伤","pinyin":"hé shǔ zhī shāng","abbr":"hszs","explanation":"禾：粟；黍：谷子。对故国的怀念。指国破家亡的悲伤。","source":{"text":"后巢寇入京，焚灭殆尽，悉为瓦砾狐兔穴矣。游者有禾黍之伤。","book":"宋·委心子《新编分门古今类事·丘墟之象》"},"similar":["禾黍之悲","黍离之悲"],"usage":"作宾语；用于感伤等"},{"id":34860,"word":"禾黍之悲","pinyin":"hé shǔ zhī bēi","abbr":"hszb","explanation":"黍、禾：都是可以信用的谷物，泛指庄稼。比喻亡国的悲伤。","source":{"text":"周大夫行役，至于宗周，过宗庙宫室，尽为禾黍，闵周室之颠覆。","book":"《诗经·王风·黍离》序"},"example":{"text":"时代两更，星霜四易，爱新觉罗之政权早失，自无故宫～。","book":"蔡东藩、许廑父《民国通俗演义》第五十五回"},"similar":["黍离之悲","禾黍之伤"],"usage":"作宾语；用于感伤等"},{"id":34861,"word":"禾黍故宫","pinyin":"hé shǔ gù gōng","abbr":"hsgg","explanation":"宫殿成了农田，长满禾黍。形容亡国破败的景象。","source":{"text":"一路上晓行夜宿，只觉得景物都非，不胜禾黍故宫之感。","book":"清·吴趼人《痛史》第17回"},"similar":["故宫禾黍"],"usage":"作定语；指破败的景象"},{"id":34862,"word":"秀出班行","pinyin":"xiù chū bān háng","abbr":"xcbh","explanation":"秀出：高出，引伸为才能出众，优秀；班行：班次行列，指在朝为官的位次，后也指同列、同辈。才能优秀，超出同辈。","source":{"text":"秀出班行，乃动帝目。","book":"唐·韩愈《唐故江南西道观察使洪州刺史太原王公神道碑铭》"},"example":{"text":"常州新拔贡生殷杰，少年好学，～。","book":"清·袁枚《答梁瑶峰司农》"},"similar":["出类拔萃"],"usage":"作谓语、定语；指在同辈中最为杰出"},{"id":34863,"word":"秀外惠中","pinyin":"xiù wài huì zhōng","abbr":"xwhz","explanation":"惠：通“慧”，聪慧。外表秀丽，内心聪明","source":{"text":"曲眉丰颊，清声而便体，秀外而惠中。","book":"唐·韩愈《送李愿归盘谷序》"},"example":{"text":"清·蒲松龄《聊斋志异·香玉》：“卿～，令人爱而忘死。顾一日之去，如千里之别。”"},"similar":["秀外慧中"],"usage":"作谓语、定语；用于女性"},{"id":34864,"word":"秀外慧中","pinyin":"xiù wài huì zhōng","abbr":"xwhz","explanation":"秀：秀丽；慧：联盟。外表秀丽，内心聪明。","source":{"text":"曲眉丰颊，清声而便体，秀外而慧中。","book":"唐·韩愈《送李愿归盘谷序》"},"example":{"text":"卿～，令人爱而忘死。","book":"清·蒲松龄《聊斋志异·香玉》"},"similar":["耳聪目明","绰约多姿","眉清目秀"],"opposite":["獐头鼠目","贼眉贼眼"],"usage":"作谓语、定语；用于女性"},{"id":34865,"word":"秀才不出门，全知天下事","pinyin":"xiù cái bù chū mén，quán zhī tiān xià shì","abbr":"xcbcmqztxs","explanation":"旧时认为有知识的人即使待在家里，也能知道外面发生的事情。","source":{"text":"不出户，知天下。","book":"《老子》第四十七章"},"similar":["秀才不出门，能知天下事"],"usage":"作宾语、分句；指学习的作用"},{"id":34866,"word":"秀才不出门，而知天下事","pinyin":"xiù cái bù chū mén，ér zhī tiān xià shì","abbr":"xcbcmeztxs","explanation":"秀才：指儒生。指有知识的人待在家里，也能知晓天下的事情","source":{"text":"古之秀才，自以为无所不晓，于是有‘秀才不出门，而知天下事’这自负的漫天大谎。","book":"鲁迅《谚语》"},"similar":["秀才不出门，能知天下事"],"usage":"作宾语、分句；指学习的作用"},{"id":34867,"word":"秀才不出门，能知天下事","pinyin":"xiù cái bù chū mén，néng zhī tiān xià shì","abbr":"xcbcmnztxs","explanation":"秀才：指儒生。指有知识的人待在家里，也能知晓天下的事情。","source":{"text":"不出户，知天下。","book":"春秋·楚·李耳《老子》第47章"},"example":{"text":"然则秀才们，看得两卷书，何以便要说：‘～。’","book":"清·吴趼人《俏皮话·驴辩》"},"similar":["秀才不出门，而知天下事"],"usage":"作宾语、分句；指学习的作用"},{"id":34868,"word":"秀才人情","pinyin":"xiù cái rén qíng","abbr":"xcrq","explanation":"旧时秀才多数贫穷，遇有人情往来，无力购买礼物，只得裁纸写信。俗话说：“秀才人情纸半张。”一般表示送的礼过于微薄。","source":{"text":"外具湖笔、斗方贰种，真乃秀才人情而已。","book":"清·朱之瑜《答奥村庸礼书》"},"example":{"text":"清·李汝珍《镜花缘》第31回：“～，休要见笑。”"},"usage":"作主语、宾语、定语；指轻薄的礼物"},{"id":34869,"word":"秀才人情半张纸","pinyin":"xiù cái rén qíng bàn zhāng zhǐ","abbr":"xcrqbzz","explanation":"旧时秀才多数贫穷，遇有人情往来，无力购买礼物，只得裁纸写信。形容送的礼过于微薄。","source":{"text":"小生特谒长老，奈路途奔驰，无以相馈，量着穷秀才人情只是纸半张。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["秀才人情纸半张"],"usage":"作宾语、定语；用于交往等"},{"id":34870,"word":"秀才人情纸半张","pinyin":"xiù cái rén qíng zhǐ bàn zhāng","abbr":"xcrqzbz","explanation":"旧时秀才多数贫穷，遇有人情往来，无力购买礼物，只得裁纸写信。形容送的礼过于微薄。","source":{"text":"小生特谒长老，奈路途奔驰，无以相馈，量着穷秀才人情只是纸半张。","book":"元·王实甫《西厢记》第一本第二折"},"example":{"text":"我还有个主意，又合着古语说～，现今丫头已是他拐到手了，又有这些事，料想要不回来。","book":"清·吴敬梓《儒林外史》第十四回"},"similar":["秀才人情半张纸"],"usage":"作宾语、定语；用于交往等"},{"id":34871,"word":"秀才造反","pinyin":"xiù cái zào fǎn","abbr":"xczf","explanation":"知识分子对现实不满，有所反抗、斗争。","source":{"text":"秀才造反，三年不成，无论他们有没有这回事，可以不必理他，就是实有其事，且派个人去查一查，看他们为何作此举动，再作道理。","book":"清·李宝嘉《文明小史》第六回"},"example":{"text":"这只是～罢了。"},"similar":["文人起义"],"opposite":["草寇招安"],"usage":"作主语、宾语、定语；指作用不大的行动"},{"id":34872,"word":"秀才造反，一世无成","pinyin":"xiù cái zào fǎn，yī shì wú chéng","abbr":"xczfyswc","explanation":"旧指知识分子不满现状，有所抗争，但又软弱胆小，摇摆不定，做不成大事。","source":{"text":"秀才造反，三年不成。无论他们有没这回事，可以不必理他。","book":"清·李宝嘉《文明小史》第六回"},"example":{"text":"要做皇帝，还要说什么筹安，空谈学理。俗语说得好：～。","book":"蔡东藩、许廑父《民国通俗演义》第四十七回"}},{"id":34873,"word":"秀才造反，三年不成","pinyin":"xiù cái zào fǎn，sān nián bù chéng","abbr":"xczfsnbc","explanation":"旧指知识分子不满现状，有所抗争，但又软弱胆小，摇摆不定，做不成大事。","source":{"text":"秀才造反，三年不成。无论他们有没这回事，可以不必理他。","book":"清·李宝嘉《文明小史》第六回"},"example":{"text":"常言道得好：～。料想也不成大患。","book":"金庸《鹿鼎记》第四十回"},"usage":"作主语、宾语、定语；指作用不大的行动"},{"id":34874,"word":"秀水明山","pinyin":"xiù shuǐ míng shān","abbr":"xsms","explanation":"山光明媚，水色秀丽。形容风景优美。","source":{"text":"眉黛敛秋波，尽湖南，山明水秀。","book":"宋·黄庭坚《蓦山溪·赠衡阳陈湘》"},"example":{"text":"～抱复回，风流文采胜蓬莱。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["山明水秀"],"usage":"作宾语、定语；指风景优美"},{"id":34875,"word":"秀而不实","pinyin":"xiù ér bù shí","abbr":"xebs","explanation":"秀：庄稼吐穗开花；实：结果实。开花不结果。比喻只学到一点皮毛，实际并无成就。","source":{"text":"苗而不秀者有矣夫。秀而不实者有矣夫。","book":"《论语·子罕》"},"example":{"text":"便道是秀才每～有矣夫，想皇天既与他十分才，也注还他一分绿。","book":"元·无名氏《举案齐眉》第一折"},"similar":["华而不实"],"usage":"作谓语、定语；同“华而不实”"},{"id":34876,"word":"秀色可餐","pinyin":"xiù sè kě cān","abbr":"xskc","explanation":"秀色：美女姿容或自然美景；餐：吃。原形容妇女美貌。后也形容景物秀丽。","source":{"text":"鲜肤一何润，秀色若可餐。","book":"晋·陆机《日出东南隅行》"},"example":{"text":"此中石，时有蔚蓝者，～。","book":"清·钮琇《觚剩·石言》"},"similar":["秀外慧中","国色天香"],"opposite":["其貌不扬","面目可憎"],"usage":"作谓语、定语；用于女色或风景"},{"id":34877,"word":"秀色堪餐","pinyin":"xiù sè kān cān","abbr":"xskc","explanation":"秀色：美女的姿容或自然的美景；堪：可；餐：吃。形容女子容貌秀丽动人或景色非常美","source":{"text":"黄花开，淡泞细香明艳，尽天与，助秀色堪餐。","book":"宋·柳永《爱恩深》词"},"similar":["秀色可餐"],"usage":"作谓语、定语；用于女色或风景"},{"id":34878,"word":"私仇不及公","pinyin":"sī chóu bù jí gōng","abbr":"scbjg","explanation":"及：达到。不因私人的仇怨而害及到公家之事。","source":{"text":"私仇不及公，好不废过，恶不去善，义之经也。","book":"《左传·哀公五年》"},"usage":"作宾语、定语；用于处事"},{"id":34879,"word":"私心妄念","pinyin":"sī xīn wàng niàn","abbr":"sxwn","explanation":"为个人利益打算的种种想法。同“私心杂念”。","source":{"text":"[何玉凤]心里并不曾有一毫私心妄念，不知此中怎的便如万马奔弛一般，早跳下炕来了。","book":"《儿女英雄传》第二四回"},"similar":["私心杂念"],"usage":"作主语、宾语；指个人的私心"},{"id":34880,"word":"私心杂念","pinyin":"sī xīn zá niàn","abbr":"sxzn","explanation":"为个人利益打算的种种想法。","source":{"text":"在向阳的山坡上点起斗争火焰，扫荡着私心杂念，改造着资产阶级的世界观。","book":"郭小川《忆延安》"},"similar":["私心妄念"],"opposite":["大公无私"],"usage":"作主语、宾语；指个人的私心"},{"id":34881,"word":"私心自用","pinyin":"sī xīn zì yòng","abbr":"sxzy","explanation":"单凭自己的心意办事。","source":{"text":"乃其后诸王竟私心自用，随意加减年日之多寡。","book":"清·王韬《瓮牑馀谈·西历缘起说》"},"usage":"作谓语、定语；用于处事"},{"id":34882,"word":"私恩小惠","pinyin":"sī ēn xiǎo huì","abbr":"sexh","explanation":"私人之间的小恩小惠。","source":{"text":"[曹刿]对曰：‘小惠未遍，民弗从也。’","book":"《韩非子·饰邪》：“必明于公私之分，明法制，去私恩。”《左传·庄公十年》"},"example":{"text":"我赵匡胤虽承你款留调养，只算是个～；今遇这等非礼之事，若不明究，非大丈夫之所为也！","book":"清·吴璿《飞龙全传》第十八回"},"similar":["小恩小惠"],"usage":"作主语、宾语、定语；用于处事"},{"id":34883,"word":"私情密语","pinyin":"sī qíng mì yǔ","abbr":"sqmy","explanation":"秘密的情话。","source":{"text":"你这等私情密语，他耳边只愁恹弃。","book":"清·李渔《凰求凤·避色》"},"example":{"text":"我喜欢她的～。"},"usage":"作宾语、定语；指秘密的情话"},{"id":34884,"word":"私房关目","pinyin":"sī fáng guān mù","abbr":"sfgm","explanation":"关目：事情，情节。指秘密的事情。","source":{"text":"今日这件私房关目，也去与他商议。","book":"明·冯梦龙《警世通言》卷三十五"}},{"id":34885,"word":"私房话","pinyin":"sī fáng huà","abbr":"sfh","explanation":"指夫妻之间所说的不能公开的话。也泛指私下里说的秘不可宣的话。","source":{"text":"金生与翠翠虽然夫妻相见，说不得一句私房话。","book":"明·凌濛初《二刻拍案惊奇》卷六"},"example":{"text":"西厢房的那番～，是韩太太故意给他们闪开的空儿，让他们叽咕去，能叽咕出个什么来？","book":"霍达《穆斯林的葬礼》第十三章"}},{"id":34886,"word":"私智小惠","pinyin":"sī zhì xiǎo huì","abbr":"szxh","explanation":"个人的智慧和小聪明。指带有片面性而又自以为是的聪明。","source":{"text":"好行小慧，难矣哉！","book":"《管子·禁藏》：“故国多私勇者其兵弱，吏多私智者其法乱。”《论语·卫灵公》"},"example":{"text":"历观古今，治常少而乱常多，何也？……庸人之～，小人之刻薄残忍，无智慧而行残忍，顷刻之间，内不自静，天下安得而不乱？","book":"宋·赵鼎臣《竹隐畸士集·杂著三十三条》之三二"}},{"id":34887,"word":"私智小慧","pinyin":"sī zhì xiǎo huì","abbr":"szxh","explanation":"私：个人的；慧：智慧。个人的智慧和小聪明。指带有片面性而又自以为是的聪明。","source":{"text":"好行小慧，难矣哉！","book":"春秋·齐·管仲《管子·禁藏》：“故国多私勇者其兵弱，吏多私智其法乱。”春秋·鲁·孔丘《论语·卫灵公》"},"example":{"text":"庸人之～，小人之刻薄残忍，无智慧而行残忍，顷刻之间，内不自静，天下安得不乱？","book":"宋·赵鼎臣《竹隐畸士集·杂著33条》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":34888,"word":"私淑弟子","pinyin":"sī shū dì zǐ","abbr":"ssdz","explanation":"私：私下；淑：善。对自己所敬仰而不能从学的前辈的自称。","source":{"text":"予未得为孔子徒也，予私淑诸人也。","book":"《孟子·离娄下》"},"example":{"text":"至于世界要人就不然，他们有的是秘书，或是～，替他们来做注释的工作。","book":"鲁迅《伪自由书·不求甚解》"},"usage":"作宾语、定语；用于谦词"},{"id":34889,"word":"私盐私醋","pinyin":"sī yán sī cù","abbr":"sysc","explanation":"比喻不敢公开见人的事情。","source":{"text":"我在那边睡也非为别的，因越了不过李大姐情，一两夜不在那边歇了，他守灵儿，谁和他有私盐私醋？","book":"《金瓶梅词话》第七二回"},"usage":"作主语、宾语、定语；用于口语"},{"id":34890,"word":"私相传授","pinyin":"sī xiāng chuán shòu","abbr":"sxcs","explanation":"私：私下里；相：互相。私下时传授本领。","source":{"text":"他恐邻国再把音韵学会，更难出人头地，因此禁止国人，毋许私相传授。","book":"清·李汝珍《镜花缘》第二十八回"},"similar":["私相授受"],"usage":"作谓语、宾语、定语；用于技艺等"},{"id":34891,"word":"私相授受","pinyin":"sī xiāng shòu shòu","abbr":"sxss","explanation":"授：给予；受：接受。指不是公开的给予和接受。","source":{"text":"况庄田昔系西宁，今归阳武，果钦赐也，其敢私相授受。","book":"清·钱谦益《牧斋初学集·与蒋明府论优免事宜》"},"example":{"text":"虽然是一个愿卖，一个愿买，然而内地非租界可比，华商同洋商，断不能～。（清·李宝嘉《官场现形记》第五十二回）"},"similar":["私相传授"],"usage":"作谓语；指暗地里的给予和接受"},{"id":34892,"word":"私视使目盲","pinyin":"sī shì shǐ mù máng","abbr":"sssmm","explanation":"私视：为了私欲产生的偏见。偏私的看法，会使人看不清方向。","source":{"text":"夫私视使目盲，私听使耳聋，私虑使心狂，三者皆私设，精则智无由公。","book":"《吕氏春秋·序意》"}},{"id":34893,"word":"私言切语","pinyin":"sī yán qiè yǔ","abbr":"syqy","explanation":"私下里的情话。","source":{"text":"私言切语谁人念，海燕双飞绕画梁。","book":"《乐府诗集·近代曲辞二·双带子》"},"usage":"作主语、宾语；用于书面语"},{"id":34894,"word":"私设公堂","pinyin":"sī shè gōng táng","abbr":"ssgt","explanation":"私：私下，暗地里；公堂：旧指官吏审理案件的地方。指私下非法地设置审讯室。","example":{"text":"老人家，你想过没有，抓个活口，是送官治罪，还是～呢，那不给四爷添了麻烦吗？","book":"二月河《康熙大帝》四十五"}},{"id":34895,"word":"私谐欢好","pinyin":"sī xié huān hǎo","abbr":"sxhh","explanation":"指男女间非明媒正娶而发生关系。","source":{"text":"古来才子佳人，往往私谐欢好，后来夫荣妻贵，反成美谈。","book":"《醒世恒言·吴衙内邻舟赴约》"},"usage":"作谓语、宾语、定语；多用于男女间"},{"id":34896,"word":"秉公任直","pinyin":"bǐng gōng rèn zhí","abbr":"bgrz","explanation":"持心公正，处事正直。","source":{"text":"公但自信此心，秉公任直，纷纷之言，不足为意。","book":"明·张居正《答郑范溪》"},"usage":"作谓语、定语；指人很正直"},{"id":34897,"word":"秉公办事","pinyin":"bǐng gōng bàn shì","abbr":"bgbs","explanation":"秉持公正之心做事，公事公办。","source":{"text":"昨儿巡抚吴大人来陛见，说起令尊翁前任学政时，秉公办事，凡属生童，俱心服之至。","book":"清·曹雪芹《红楼梦》第85回"},"similar":["公事公办"],"usage":"作谓语、定语；用于处理公物等"},{"id":34898,"word":"秉公办理","pinyin":"bǐng gōng bàn lǐ","abbr":"bgbl","explanation":"秉：掌握，主持。公：公法。根据公道办事。","source":{"text":"北静王甚加爱惜，又赏了茶。因说道：‘昨儿巡抚吴大人来陛见，说起令尊翁前任学政时，秉公办事，凡属生童，俱心服之至。’","book":"清·曹雪芹《红楼梦》第八十五回"},"example":{"text":"本部院凡事～，从不假手旁人。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["公正无私"],"opposite":["营私舞弊"],"usage":"作谓语、宾语；指按章办事"},{"id":34899,"word":"秉公无私","pinyin":"bǐng gōng wú sī","abbr":"bgws","explanation":"秉公：主持公道。指做事公道不掺杂私念。","source":{"text":"以明天地鬼神，秉公无私，但有报应轻重远近之别耳。","book":"清·钱彩《说岳全传》第73回"},"example":{"text":"他这人一向～。"},"similar":["不偏不倚"],"usage":"作谓语、定语；指人办事公正"},{"id":34900,"word":"秉公灭私","pinyin":"bǐng gōng miè sī","abbr":"bgms","explanation":"主持公道，灭除私念。","source":{"text":"今不务为秉公灭私，振废起坠。","book":"明·张居正《答郑范溪书》"},"example":{"text":"他～，让人尊敬。"},"similar":["大义灭亲"],"usage":"作谓语、定语、宾语；指人办事公道"},{"id":34901,"word":"秉政劳民","pinyin":"bǐng zhèng láo mín","abbr":"bzlm","explanation":"秉：掌握；劳：抚慰。掌握政治，抚慰百姓。旧时指统治者执政亲民。","source":{"text":"天子以秉政劳民贵。","book":"清·章炳麟《秦政记》"}},{"id":34902,"word":"秉政当轴","pinyin":"bǐng zhèng dāng zhóu","abbr":"bzdz","explanation":"秉：执持；当轴：要员。比喻官居要职，执掌政权。","source":{"text":"用备秉政当轴之君子采择焉。","book":"清·魏源《自序》"},"similar":["秉钧当轴","秉钧持轴"],"usage":"作谓语、定语；指当权"},{"id":34903,"word":"秉文兼武","pinyin":"bǐng wén jiān wǔ","abbr":"bwjw","explanation":"犹言能文能武。","source":{"text":"李将军秉文兼武，受命专征。","book":"唐·牛肃《纪闻·吴保安》"},"similar":["秉文经武","能文能武"],"opposite":["不文不武"],"usage":"作谓语、宾语、定语；指人的本事"},{"id":34904,"word":"秉文经武","pinyin":"bǐng wén jīng wǔ","abbr":"bwjw","explanation":"执掌文事，经营武备。","source":{"text":"秉文经武，任惟腹心。","book":"南朝·梁·沈约《王亮等封侯诏》"},"similar":["秉文兼武","能文能武"],"opposite":["不文不武"],"usage":"作谓语、宾语、定语；指人的本事"},{"id":34905,"word":"秉旄仗钺","pinyin":"bǐng máo zhàng yuè","abbr":"bmzy","explanation":"秉、仗：拿着；旄：古代军旗的一种；钺：古兵器，象斧。手执指挥全军的旗帜和受命出征的黄钺。比喻掌握着军事大权。","source":{"text":"王左仗黄钺，右秉白旄以麾。","book":"《尚书·牧誓》"},"example":{"text":"昔姜尚父年九十，～，未尝言老。","book":"明·罗贯中《三国演义》第九十八回"},"usage":"作谓语、定语；指掌军权"},{"id":34906,"word":"秉正无私","pinyin":"bǐng zhèng wú sī","abbr":"bzws","explanation":"主持正义，没有私念。","source":{"text":"闻得包公秉正无私，不畏权势。","book":"清·石玉昆《三侠五义》第十二回"},"example":{"text":"可又俨然是为了工作，～！","book":"康濯《春种秋收·三面宝镜》"},"similar":["公正无私"],"opposite":["自私自利"],"usage":"作谓语、定语、宾语；指人很正直"},{"id":34907,"word":"秉烛夜游","pinyin":"bǐng zhú yè yóu","abbr":"bzyy","explanation":"秉：执持。旧时比喻及时行乐。","source":{"text":"昼短苦夜长，何不秉烛游。","book":"《古诗十九首》"},"example":{"text":"唐·李白《春夜宴桃李园序》：“古人～，良有以也。”"},"similar":["及时行乐","炳烛夜游"],"opposite":["彻夜苦读"],"usage":"作谓语、宾语、定语；指及时行乐"},{"id":34908,"word":"秉烛待旦","pinyin":"bǐng zhú dài dàn","abbr":"bzdd","explanation":"旦：早晨。手持点燃的蜡烛待天亮。","source":{"text":"好个古撇先生，还是那壁披衣据床，秉烛待旦哩！","book":"元·马致远《陈抟高卧》第四折"},"example":{"text":"（瞿）式耜高兴极了，吩咐剩下的一个老兵进酒，～和（张）同敞销磨这个空城的一夜。","book":"朱东润《张居正大传》第十四章"},"similar":["坐以待旦"],"usage":"作谓语、定语；形容心情急迫"},{"id":34909,"word":"秉笏披袍","pinyin":"bǐng hù pī páo","abbr":"bhpp","explanation":"秉：持；笏：古代大臣上朝时拿的手板；披袍：身穿朝服。比喻作官。","source":{"text":"圣朝辅佐必良才，野有贤人久困埋，今朝察访当推举，秉笏披袍拜御街。","book":"明·无名氏《破风诗》第二折"},"usage":"作谓语、定语；指做官"},{"id":34910,"word":"秉笔直书","pinyin":"bǐng bǐ zhí shū","abbr":"bbzs","explanation":"秉：持，握住。写史书根据事实记录，不隐讳。","source":{"text":"我是秉笔直书，悬之国门，不能增损一字。","book":"清·曾朴《孽海花》第三十五回"},"usage":"作谓语；形容客观对待历史"},{"id":34911,"word":"秉节持重","pinyin":"bǐng jié chí zhòng","abbr":"bjcz","explanation":"保持节操，谨慎稳重。","source":{"text":"［伏湛］遭时反覆，不离兵凶，秉节持重，有不可夺之志。","book":"《后汉书·伏湛传》"},"usage":"作谓语、定语；指人的品行"},{"id":34912,"word":"秉要执本","pinyin":"bǐng yào zhí běn","abbr":"byzb","explanation":"秉：执，拿着；要：重要的；本：根本。指抓住要害和根本、。","source":{"text":"道家者流，盖出于史官，历记成败存亡祸福、古今之道，然后知秉要执本，清虚以自守，卑弱以自持，此君人南面之术也。","book":"《汉书·艺文志》"},"opposite":["不得要领"],"usage":"作谓语、宾语；指抓住要害和根本"},{"id":34913,"word":"秉轴持钧","pinyin":"bǐng zhóu chí jūn","abbr":"bzcj","explanation":"轴：车轴，指中心，枢纽。掌握事物运转的中心和关键。旧指居于宰相的官位。比喻身居政务重任。","source":{"text":"调和鼎鼐理阴阳，秉轴持钧政事堂。","book":"元·马致远《汉宫秋》第二折"},"similar":["秉政当轴"],"usage":"作谓语、定语；指当权"},{"id":34914,"word":"秉钧当轴","pinyin":"bǐng jūn dāng zhóu","abbr":"bjdz","explanation":"犹言秉钧持轴。执政掌权。","source":{"text":"用备秉政当轴之君子采择焉。","book":"清·魏源《默觚下·治篇八》：“皆边塞将材而不可秉钧当轴。”又《〈淮南盐法轻本私议〉自序》"},"similar":["秉钧持轴","秉政当轴"],"usage":"作谓语、定语；指当权"},{"id":34915,"word":"秉钧持轴","pinyin":"bǐng jūn chí zhóu","abbr":"bjcz","explanation":"执政掌权。","source":{"text":"明·唐顺之《答曾石塘总制》：“使继此而进以秉钧持轴，则夫不动声色而坐销天下之隐忧。"},"similar":["秉钧当轴"],"usage":"作谓语、定语；指当权"},{"id":34916,"word":"秋去冬来","pinyin":"qiū qù dōng lái","abbr":"qqdl","explanation":"秋天过去，冬天到来。形容时光流逝。","example":{"text":"～，转眼又是一年。"},"similar":["春去秋来"],"usage":"作状语、分句；指时光流逝"},{"id":34917,"word":"秋后算帐","pinyin":"qiū hòu suàn zhàng","abbr":"qhsz","explanation":"指秋收以后结清欠帐。比喻等待时机进行报复。","source":{"text":"怕就怕秋后算帐，本来挺明白的事最后也不明白了。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"我们不会抓辫子、打棍子、～，你可以放心。"},"similar":["打击报复"],"usage":"作谓语、宾语、定语；指伺机报复"},{"id":34918,"word":"秋后算账","pinyin":"qiū hòu suàn zhàng","abbr":"qhsz","explanation":"本指秋收后结算账目。比喻待到事后再对反对自己的一方行清算处理。","example":{"text":"我们处事必须谨慎，小心她会～的。"},"similar":["秋后算帐"],"usage":"作谓语、宾语、定语；指伺机报复"},{"id":34919,"word":"秋实春华","pinyin":"qiū shí chūn huā","abbr":"qsch","explanation":"比喻德行和才华。","source":{"text":"清·林则徐《杭嘉湖三郡观风告示》：“凡尔诸生，各宜踊跃，此日驰驱文囿，竞吐珠零锦粲之词；他年黼黻皇猷，伫收秋实春华之用。”参见“春华秋实”。"},"similar":["春华秋实"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":34920,"word":"秋扇见捐","pinyin":"qiū shàn jiàn juān","abbr":"qsjj","explanation":"见：被；捐：弃。秋凉以后，扇子就被抛在一边不用了。旧时比喻妇女遭丈夫遗弃。","source":{"text":"裁为合欢扇，团团似明月，出入君怀袖，动摇微风发。常恐秋节至，凉飙夺炎热，弃捐箧笥中，恩情中道绝。","book":"汉·班婕妤《怨歌行》诗"},"example":{"text":"能矢山河，勿令～，则惟命是听。","book":"清·蒲松龄《聊斋志异·黄九郎》"},"similar":["秋风团扇"],"usage":"作定语；用于女性"},{"id":34921,"word":"秋收东藏","pinyin":"qiū shōu dōng cáng","abbr":"qsdc","explanation":"秋天收获，冬天存储。泛指常规的农事活动。","source":{"text":"春耕夏耘，秋收冬藏。","book":"《荀子·王制》"},"example":{"text":"这力田呵，春耕夏耨，～，无饥无忧，何为不乐。","book":"明·无名氏《三化邯郸》第一折"}},{"id":34922,"word":"秋收冬藏","pinyin":"qiū shōu dōng cáng","abbr":"qsdc","explanation":"秋季为农作物收获季节，冬季则贮藏果实以待一年之需要。比喻一年的农事。","source":{"text":"夫春生夏长，秋收冬藏，此天道之大经也。","book":"西汉·司马迁《史记·太史公自序》"},"example":{"text":"这力田呵，春耕夏耨，～，无饥无忧，何为不乐？","book":"明·无名氏《三化邯郸》第一折"},"usage":"作宾语、定语；用于农业等"},{"id":34923,"word":"秋月华星","pinyin":"qiū yuè huá xīng","abbr":"qyhx","explanation":"如秋月那样清澈明朗，像星星那样闪闪发光。形容文章写得非常出色。","source":{"text":"两章对秋月，一字偕华星。","book":"唐·杜甫《同元使君春陵行》"}},{"id":34924,"word":"秋月如珪","pinyin":"qiū yuè rú guī","abbr":"qyrg","explanation":"珪：玉器。形容秋天的月亮像珪一样的皎洁、晶莹。","source":{"text":"至乃秋露如珠，秋月如珪。明月白露，光阴往来。","book":"南朝·梁·江淹《别赋》"}},{"id":34925,"word":"秋月寒江","pinyin":"qiū yuè hán jiāng","abbr":"qyhj","explanation":"比喻有德之人心底清纯明净。","source":{"text":"德人天游，秋月寒江。","book":"宋·黄庭坚《赠别李次翁》诗"},"usage":"作宾语、定语；指人的心地"},{"id":34926,"word":"秋月春花","pinyin":"qiū yuè chūn huā","abbr":"qych","explanation":"春天的花朵，秋天的月亮。泛指春秋美景。","source":{"text":"春花秋月何时了，往事知多少。","book":"南唐·李煜《虞美人》词"},"example":{"text":"～易老，赏心悦事难凭。","book":"明·王世贞《鸣凤记》第一出"},"similar":["良辰美景","春花秋月"],"usage":"作宾语、定语；泛指春秋美景"},{"id":34927,"word":"秋月春风","pinyin":"qiū yuè chūn fēng","abbr":"qycf","explanation":"指良辰美景。也指美好的岁月。","source":{"text":"今年欢笑复明年，秋月春风等闲度。","book":"唐·白居易《琵琶行》"},"example":{"text":"白发渔樵江渚上，惯看～。","book":"明·杨慎《临江仙》词"},"similar":["春分秋月"],"usage":"作宾语、定语；泛指美好的时光"},{"id":34928,"word":"秋毫不犯","pinyin":"qiū háo bù fàn","abbr":"qhbf","explanation":"秋毫：鸟兽秋天新换的绒毛，比喻极细微的东西；犯：侵犯。指军纪严明，丝毫不侵犯人民的利益。","source":{"text":"持军整齐，秋毫无犯。","book":"《史记·项羽本纪》：“吾入关，秋毫不敢有所近，籍吏民，封府库，而待将军。”《后汉书·岑彭传》"},"example":{"text":"～三吴悦，春日遥看五色光。","book":"唐·李白《永王东巡歌》"},"similar":["秋毫勿犯","秋毫无犯"],"usage":"作谓语、定语；指军纪严明"},{"id":34929,"word":"秋毫之末","pinyin":"qiū háo zhī mò","abbr":"qhzm","explanation":"秋毫：秋天鸟兽新生的绒毛。鸟兽在秋天新长的细毛的尖端。比喻极微小的东西或极细微的地方。","source":{"text":"明足以察秋毫之末，而不见舆薪。","book":"《孟子·梁惠王上》"},"example":{"text":"神托于～，而大宇宙之总，其德优天地而和阴阳，节四时而调五行。","book":"《淮南子·原道训》"},"similar":["无足轻重","轻于鸿毛"],"opposite":["庞然大物","重于泰山"],"usage":"作宾语；用于书面语"},{"id":34930,"word":"秋毫勿犯","pinyin":"qiū háo wù fàn","abbr":"qhwf","explanation":"指军纪严明，丝毫不侵犯人民的利益。同“秋毫无犯”。","source":{"text":"营垒所次，务在整肃，刍荛有禁，秋毫勿犯。","book":"《北史·隋纪下·炀帝》"},"similar":["秋毫不犯"],"usage":"作谓语、定语；指军纪严明"},{"id":34931,"word":"秋毫无犯","pinyin":"qiū háo wú fàn","abbr":"qhwf","explanation":"秋毫：鸟兽秋天新换的绒毛，比喻极细微的东西；犯：侵犯。指军纪严明，丝毫不侵犯人民的利益。","source":{"text":"持军整齐，秋毫无犯。","book":"《史记·项羽本纪》：“吾入关，秋毫不敢有所近，籍吏民，封府库，而待将军。”《后汉书·岑彭传》"},"example":{"text":"老夫一生公廉正直，与人～。","book":"元·岳伯川《铁拐李》第二折"},"similar":["鸡犬不惊","道不拾遗","纤毫无犯"],"opposite":["胡作非为","无恶不作"],"usage":"作谓语、定语；指军纪严明","story":["楚汉相争时期，韩信因得不到项羽的重用就投奔刘邦，在丞相萧何的推荐下，刘邦拜他为大将，刘邦问韩信有什么高见。韩信把刘邦与项羽进行一番对比，说刘邦的军队与项羽的军队不同，对百姓的利益秋毫无犯，可以得天下"]},{"id":34932,"word":"秋毫见捐","pinyin":"qiū háo jiàn juān","abbr":"qhjj","explanation":"秋凉以后，扇子就被抛在一边不用了。早时比喻妇女遭丈夫遗弃。"},{"id":34933,"word":"秋水伊人","pinyin":"qiū shuǐ yī rén","abbr":"qsyr","explanation":"指思念中的那个人。","source":{"text":"蒹葭苍苍，白露为霜；所谓伊人，在水一方。","book":"《诗经·秦风·蒹葭》"},"example":{"text":"登高望远，极目苍凉，正切～之想。","book":"清·龚萼《雪鸿轩尺牍·答许葭村》"},"usage":"作宾语、定语；指见景思念的人"},{"id":34934,"word":"秋水盈盈","pinyin":"qiū shuǐ yíng yíng","abbr":"qsyy","explanation":"形容眼神饱含感情。同“秋波盈盈”。","source":{"text":"秦牧《艺海拾贝·神速的剪影》；“通过这二十几个字，一个雪肤花貎、十指纤纤、唇红齿白、云鬓蛾眉、秋水盈盈、嫣然含笑的古代美女的形象，就呈现在人们眼前了。”"},"similar":["秋波盈盈"],"usage":"作宾语、定语；用于女性"},{"id":34935,"word":"秋水芙蓉","pinyin":"qiū shuǐ fú róng","abbr":"qsfr","explanation":"芙蓉：荷花。比喻诗文清新不俗。也形容天然艳丽的女子。","source":{"text":"秋水芙蓉聊荡桨，一樽同破愁城。","book":"宋·向子諲《相见欢》词：“亭亭秋水芙蓉，翠围中。又是一年风露、笑相逢。”宋·苏庠《临江仙》词"},"example":{"text":"斑帘十二卷轻碧，～隔画栏。","book":"元·萨都刺《三益塘芙蓉》诗"}},{"id":34936,"word":"秋波盈盈","pinyin":"qiū bō yíng yíng","abbr":"qbyy","explanation":"形容眼神饱含感情。","source":{"text":"再看秋痕，早是秋波盈盈，默然不语。","book":"清·魏秀仁《花月痕》第六回"},"similar":["秋水盈盈"],"usage":"作宾语、定语；用于女性"},{"id":34937,"word":"秋狝春苗","pinyin":"qiū xiǎn chūn miáo","abbr":"qxcm","explanation":"狝：杀戮，打猎；苗：为保护禾苗而消灭那些害虫和野兽。指古时候春秋两季猎杀野兽。也用以形容大规模扫荡敌军或盗匪。","source":{"text":"故春蒐夏苗，秋狝冬狩。","book":"《左传·隐公五年》"},"example":{"text":"借硝烟弹雨之场，寓～之意，一旦烽烟有警，鼙鼓不惊。","book":"清·曾朴《孽海花》第二十四回"},"usage":"作宾语、定语；用于书面语"},{"id":34938,"word":"秋色平分","pinyin":"qiū sè píng fēn","abbr":"qspf","explanation":"比喻双方各得一半，不分上下。","source":{"text":"平分秋色一轮满，长伴云衢千里明。","book":"《楚辞·九辩》：“皇天平分四时兮，窃独悲此廪秋。”宋·李朴《中秋》诗"},"example":{"text":"容满樽俱满，羡齐眉此日，～。","book":"清·李渔《赠张半庵暨孺人双寿》"},"similar":["平分秋色"],"usage":"作谓语、宾语、状语；指双方各得一半"},{"id":34939,"word":"秋草人情","pinyin":"qiū cǎo rén qíng","abbr":"qcrq","explanation":"秋草逐日黄枯。比喻人情日益冷落衰败。","source":{"text":"浮云世态纷纷恋，秋草人情日日疏。","book":"元·关汉卿《鲁斋郎》第三折"},"example":{"text":"也无那采薪的樵子，耕种的农夫，往来的商贾，谈笑的鸿儒，做伴的茶药琴棋笔砚书。～即惭疏。","book":"元·王实甫《丽春堂》第三折"},"usage":"作主语、宾语、定语；用于人际关系"},{"id":34940,"word":"秋荼密网","pinyin":"qiū tú mì wǎng","abbr":"qtmw","explanation":"荼：茅草上的白花。秋天繁茂的茅草白花，网眼细密的鱼网。比喻刑罚繁苛。","source":{"text":"昔秦法繁于秋荼，而网密于凝脂。","book":"汉·桓宽《盐铁论·刑德》"},"example":{"text":"秦王朝的～仍无济于事。"},"similar":["严刑峻法"],"usage":"作主语、宾语、定语；指刑法苛细"},{"id":34941,"word":"秋菊春兰","pinyin":"qiū jú chūn lán","abbr":"qjcl","explanation":"秋天的菊花，春天的兰花。比喻各有值得称道的地方。","source":{"text":"春兰兮秋菊，长无绝兮终古。","book":"战国·楚·屈原《九歌·礼魂》"},"example":{"text":"第二签，首一句且不必疑虑，大抵秋菊春兰，各极其胜。","book":"清·魏子安《花月痕》第五回"}},{"id":34942,"word":"秋行夏令","pinyin":"qiū xíng xià líng","abbr":"qxxl","explanation":"令：时令。时已秋季，还在做夏令的事。指不合时令。","source":{"text":"但现在是暮秋，所以这‘秋行夏令’的情形，在盘辫家不能不说是万分的英断，而在未庄也不能说无关于改革了。","book":"鲁迅《阿Q正传》"},"example":{"text":"～的做法滑稽可笑。"},"similar":["不合时宜"],"usage":"作宾语、定语；指不合时宜"},{"id":34943,"word":"秋豪之末","pinyin":"qiū háo zhī mò","abbr":"qhzm","explanation":"比喻极微小的东西或极细微的地方。同“秋毫之末”。","source":{"text":"天下莫大于秋豪之末，而太山为小。","book":"《庄子·齐物论》"},"similar":["秋毫之末"],"usage":"作宾语；用于书面语"},{"id":34944,"word":"秋风团扇","pinyin":"qiū fēng tuán shàn","abbr":"qfts","explanation":"秋风起后，扇子就用不到了。旧时比喻不再受男子宠爱的女子。","source":{"text":"裁为合欢扇，团团似明月，出入君怀袖，动摇微风发。常恐秋节至，凉飙夺炎热，弃绢箧笥中，恩情中道绝。","book":"《乐府诗集·班婕妤〈怨歌行〉》"},"example":{"text":"～原吾分，多谢连枝特过存。","book":"清·洪升《长生殿·献发》"},"similar":["秋风纨扇"],"usage":"作宾语、定语；用于女性"},{"id":34945,"word":"秋风扫叶","pinyin":"qiū fēng sǎo yè","abbr":"qfsy","explanation":"比喻威力大、气势猛。","source":{"text":"［程万里］每日间见元兵所过，残灭如秋风扫叶，心中暗暗悲痛，正是：宁为太平犬，莫作离乱人。","book":"明·冯梦龙《醒世恒言》第十九卷"},"similar":["秋风扫落叶"],"usage":"作宾语、定语；多用于比喻句"},{"id":34946,"word":"秋风扫落叶","pinyin":"qiū fēng sǎo luò yè","abbr":"qfsly","explanation":"秋天的大风把落叶一扫而光。比喻强大的力量迅速而轻易地把腐朽衰败的事物扫除光。","source":{"text":"以明公之威，应困穷之敌，击疲弊之寇，无异迅风之振秋叶矣。","book":"《三国志·魏志·辛毗传》"},"example":{"text":"对等敌人，要像～一样残酷无情。"},"similar":["摧枯拉朽","势如破竹"],"opposite":["日积月累"],"usage":"作谓语、定语；指势力大","story":["东汉末年，袁绍的两个儿子袁谭、袁尚互相攻伐。袁谭被打败，谋士郭图劝他求助曹操，袁谭派辛毗去请曹操攻打邺城。曹操故意按兵不动，辛毗说曹军打袁尚就像秋风扫落叶一样，一定会马到成功的。曹操于是同意出兵"]},{"id":34947,"word":"秋风纨扇","pinyin":"qiū fēng wán shàn","abbr":"qfws","explanation":"秋日凉风至，扇子遂弃置不用。常以比喻女子色衰失宠。","source":{"text":"万一结褵之后，见美而迁，使奴家有秋风纨扇之悲，如何是好！","book":"清·李渔《意中缘·先订》"},"similar":["秋风团扇","秋扇见捐"],"usage":"作宾语、定语；多用于女性"},{"id":34948,"word":"秋风落叶","pinyin":"qiū fēng luò yè","abbr":"qfly","explanation":"秋天的大风把落叶一扫而光。比喻一扫而光，不复存在。","source":{"text":"以明公之威，应困穷之敌，击疲弊之寇，无异迅风之振秋叶矣。","book":"汉·桓宽《盐铁论·论功》：“夫以智谋愚，以义伐不义，若因秋霜而振落叶。”《三国志·魏志·辛毗传》"},"example":{"text":"虽蹇驴亦无有矣，人言～，此真是也。","book":"宋·洪迈《夷坚乙志·齐先生》"},"similar":["秋风扫叶","秋风扫落叶"],"usage":"作宾语、定语；多用于比喻句"},{"id":34949,"word":"秋风过耳","pinyin":"qiū fēng guò ěr","abbr":"qfge","explanation":"象秋风从耳边吹过一样。比喻与己无关，毫不再意。","source":{"text":"富贵之于我，如秋风之过耳。","book":"汉·赵晔《吴越春秋·吴王寿梦传》"},"example":{"text":"那一个不指皇天各般说咒，恰似～早休休。","book":"元·关汉卿《救风尘》第二折"},"similar":["漠不关心"],"usage":"作宾语；指人不在意","story":["春秋时期，吴王寿梦最疼爱小儿子季札，他德才兼备最合适作君王，想传位给他。季札不愿接受，只好由长子诸樊继位。诸樊与兄弟立下誓言，以后要传位给弟弟们，待到季札继位时，他说视荣华富贵像耳边的秋风一样，然后就隐居起来"]},{"id":34950,"word":"秋高气和","pinyin":"qiū gāo qì hé","abbr":"qgqh","explanation":"形容秋空高朗、天气晴和。","source":{"text":"却说小燕便服轻车，叫车夫径到城南保安寺街而来，那时秋高气和，尘软蹄轻，不一会已到了门口，把车停在门前两棵大榆树荫下。","book":"清·曾朴《孽海花》第十九回"},"similar":["秋高气爽","秋高气肃"],"usage":"作谓语、定语；指秋天的天气"},{"id":34951,"word":"秋高气爽","pinyin":"qiū gāo qì shuǎng","abbr":"qgqs","explanation":"形容秋季晴空万里，天气清爽。","source":{"text":"爱汝玉山草堂静，高秋爽气相鲜新。","book":"唐·杜甫《崔氏东山草堂》诗"},"example":{"text":"方拟～，遣将西征。","book":"清·梁晋竹《两般秋雨盦随笔·史阁部书》"},"similar":["秋高气肃"],"opposite":["春雨绵绵"],"usage":"作谓语、定语；指秋天的天气"},{"id":34952,"word":"秋高气肃","pinyin":"qiū gāo qì sù","abbr":"qgqs","explanation":"形容秋日晴空高朗，气候凉爽宜人。","source":{"text":"爱汝玉山草堂静，高秋爽气相鲜新。","book":"唐·杜甫《崔氏东山草堂》诗"},"example":{"text":"～，西风又拂盈盈菊。挼金弄玉香芬馥。桃李虽繁，其奈太粗俗。","book":"宋·张抡《醉落魄》词"},"similar":["秋高气爽"],"usage":"作谓语、定语；指秋天的天气"},{"id":34953,"word":"秋高马肥","pinyin":"qiū gāo mǎ féi","abbr":"qgmf","explanation":"秋高气爽，马匹肥壮。古常以指西北外族活动的季节。","source":{"text":"臣恐秋高马肥，虏必再至，以责前约。","book":"宋·李纲《靖康传信录》卷三"},"example":{"text":"其外市，则西至安集延、伊犁、哈密、喀尔喀，东至黑龙江，～，被罽捆货而至。","book":"清·俞正燮《癸巳类稿·俄罗斯事辑》"},"usage":"作定语；用于书面语"},{"id":34954,"word":"种学织文","pinyin":"zhòng xué zhī wén","abbr":"zxzw","explanation":"种：栽种，引申为培养。培养学识，积累文才","source":{"text":"种学织文，名播于迩遐。","book":"明·宋濂《瑞安吴门三贞母墓版文》"},"similar":["种学绩文"],"usage":"作谓语、定语；用于书面语"},{"id":34955,"word":"种学绩文","pinyin":"zhòng xué jì wén","abbr":"zxjw","explanation":"种：栽种，引申为培养。培养学识，积累文才","source":{"text":"博陵崔斯立种学绩文，以蕃其有。","book":"唐·韩愈《蓝田县丞厅壁记》"},"example":{"text":"明·王鏊《震泽长语·官制》：“国家之意，本欲使之～，以为异日公卿之储。”"},"similar":["种学织文"],"usage":"作谓语、定语；用于书面语"},{"id":34956,"word":"种玉蓝田","pinyin":"zhòng yù lán tián","abbr":"zylt","explanation":"种：栽种，培养；蓝田：今属陕西，以产玉著名。比喻长得其所。指为缔结良缘创造条件","source":{"text":"从今后天长地远，还愿取，还愿取种玉蓝田。","book":"明·杨珽《龙膏记·错媾》"},"similar":["蓝田种玉"],"usage":"作宾语、定语；用于书面语"},{"id":34957,"word":"种瓜得瓜，种豆得豆","pinyin":"zhòng guā dé guā，zhòng dòu dé dòu","abbr":"zgdgzddd","explanation":"种什么，收什么。原为佛教语，比喻因果报应关系。后比喻做了什么事，得到什么样的结果。","source":{"text":"种豆，其苗必豆，种瓜，其苗必瓜。","book":"《涅槃经》：“种瓜得瓜，种李得李。”《吕语集粹·存养》"},"example":{"text":"～，对于已往的检讨，足为将来的借鉴。","book":"邹韬奋《抗战以来·开场白》"},"similar":["因果报应"],"usage":"作宾语、定语、分句；指因果报应"},{"id":34958,"word":"种麦得麦","pinyin":"zhòng mài dé mài","abbr":"zmdm","explanation":"指有什么样的原因就会有什么样的结果。","source":{"text":"夫种麦而得麦，种稷而得稷。","book":"战国·卫·吕不韦《吕氏春秋·用民》"},"example":{"text":"大家都明白～的结果。"},"similar":["种瓜得瓜，种豆得豆"],"usage":"作谓语、定语、宾语；指因果关系"},{"id":34959,"word":"科头箕裾","pinyin":"kē tóu jī jù","abbr":"ktjj","explanation":"科头：不戴帽子；裾：通“倨”，傲慢；箕裾：两腿分开而坐。不戴帽子，席地而坐。形容不拘礼法。","source":{"text":"这搭儿瀑布飞流，青松夹道，将蒲团打坐一回，正是科头箕裾长松下，白眼看他世上人。","book":"明·梅鼎祚《玉合记·入道》"},"similar":["科头箕踞"],"usage":"作谓语、宾语；比喻舒适的隐居生活"},{"id":34960,"word":"科头箕踞","pinyin":"kē tóu jī jù","abbr":"ktjj","explanation":"科头：不戴帽子；箕踞：两腿分开而坐。不戴帽子，席地而坐。比喻舒适的隐居生活。","source":{"text":"科头箕踞长松下，白眼看他世上人。","book":"唐·王维《与卢员外象过崔处士兴宗林亭》诗"},"example":{"text":"任～受松风，新凉霎。","book":"清·陈维菘《满江红·江村夏咏》"},"similar":["科头箕裾"],"usage":"作谓语、宾语；比喻舒适的隐居生活"},{"id":34961,"word":"科头袒体","pinyin":"kē tóu tǎn tǐ","abbr":"kttt","explanation":"科头：不戴帽子；袒：裸露。不戴帽子，袒露身体。形容傲慢不羁的神态。","source":{"text":"若夫贵门子孙及在位之士，不惜典刑，而皆科头袒体，踞见宾客。","book":"晋·葛洪《抱朴子·刺骄》"},"usage":"作谓语、定语；用于书面语"},{"id":34962,"word":"科头赤足","pinyin":"kē tóu chì zú","abbr":"ktcz","explanation":"科头：不戴帽子。露着头，光着脚。形容困苦或生活散漫。","source":{"text":"科头赤足芝荷衣，徙倚藤床对夕晖。","book":"明·唐寅《偶成》诗"},"similar":["科头跣足","跣足科头"],"usage":"作宾语、定语；形容困苦或生活散漫"},{"id":34963,"word":"科头跣足","pinyin":"kē tóu xiǎn zú","abbr":"ktxz","explanation":"科头：不戴帽子；跣足：光脚。光着头赤着脚。","source":{"text":"彦章为人骁勇有力，能跣足履棘行百步。","book":"《史记·张仪列传》：“虎贲之士跿跔科头。”《新五代史·王彦章传》"},"example":{"text":"～不得稽，要与官长修长堤。","book":"田昼《筑长堤》"},"similar":["科头赤足"],"usage":"作宾语、定语；形容困苦或生活散漫"},{"id":34964,"word":"科教兴国","pinyin":"kē jiào xīng guó","abbr":"kjxg","explanation":"通过发展科学和教育来振兴国家。"},{"id":34965,"word":"科班出身","pinyin":"kē bān chū shēn","abbr":"kbcs","explanation":"比喻具有受过正规教育或训练的资格。","example":{"text":"随着教育事业的发展，科班出身的人越来越多。"},"opposite":["半路出家"],"usage":"作定语、宾语；指受过正规教育"},{"id":34966,"word":"秕者先行","pinyin":"bǐ zhě xiān xíng","abbr":"bzxx","explanation":"秕：瘪谷，比喻无价值的东西。形容自己不如别人。","source":{"text":"簸之扬之，糠秕在前。","book":"南朝·宋·刘义庆《世说新语·排调》"},"similar":["糠秕在前"],"usage":"作宾语、定语；用于自谦"},{"id":34967,"word":"秕言谬说","pinyin":"bǐ yán miù shuò","abbr":"byms","explanation":"指错误的言论。","source":{"text":"秕言谬说，自相矛盾。","book":"《辛亥革命前十年间时论选集·论三从》"},"usage":"作主语、宾语；指错误的言论"},{"id":34968,"word":"秘而不宣","pinyin":"mì ér bù xuān","abbr":"mebx","explanation":"宣：公开说出。保守秘密，不肯宣布。","source":{"text":"秘而不露，使权得志，非计之上。","book":"《三国志·魏志·董昭传》"},"example":{"text":"泛音既有如此妙论，如何谱上都无此说？他却～，是个甚么意思。","book":"清·李汝珍《镜花缘》第七十三回"},"similar":["守口如瓶","秘而不露","缄口不言"],"opposite":["直言不讳"],"usage":"作谓语、定语；指对事情保密"},{"id":34969,"word":"秘而不泄","pinyin":"mì ér bù xiè","abbr":"mebx","explanation":"泄：泄漏。严守秘密，不肯吐露。","source":{"text":"秘而不露，使权得志，非计之上。","book":"《三国志·魏志·董昭传》"},"example":{"text":"上仙真经秘而不泄者，为此子母之法，恐凡愚之心见知也。","book":"宋·张君房《云笈七签》卷六十九"},"similar":["秘而不露"],"usage":"作谓语；指严守秘密"},{"id":34970,"word":"秘而不言","pinyin":"mì ér bù yán","abbr":"meby","explanation":"严守秘密，不肯吐露。同“秘而不露”。","source":{"text":"骋益忧惧，秘而不言。","book":"晋·干宝《搜神记》第七卷"},"similar":["秘而不宣"],"opposite":["泄漏天机"],"usage":"作谓语、定语；指对事情保密"},{"id":34971,"word":"秘而不露","pinyin":"mì ér bù lù","abbr":"mebl","explanation":"严守秘密，不肯吐露。","source":{"text":"秘而不露，使权得志，非计之上。","book":"晋·陈寿《三国志·董昭传》"},"similar":["秘而不言"],"usage":"作谓语；指严守秘密"},{"id":34972,"word":"秣马利兵","pinyin":"mò mǎ lì bīng","abbr":"mmlb","explanation":"秣：喂；利：锋利。磨好兵器，喂饱战马。形容准备战斗。","source":{"text":"搜乘补卒，秣马利兵，修陈固列。","book":"春秋·鲁·左丘明《左传·成公十六年》"},"similar":["秣马厉兵"],"usage":"作谓语；形容准备战斗"},{"id":34973,"word":"秣马厉兵","pinyin":"mò mǎ lì bīng","abbr":"mmlb","explanation":"磨好兵器，喂好马。形容准备战斗。","source":{"text":"搜乘补卒，秣马利兵，修陈固列。","book":"春秋·鲁·左丘明《左传·成公十六年》"},"example":{"text":"然后深沟高垒，～，为战守之备。","book":"《续资治通鉴·宋真宗咸平三年》"},"similar":["厉兵秣马","秣马利兵"],"usage":"作谓语、宾语、定语；形容准备战斗","story":["春秋时期，秦国、晋国联合围攻郑国，郑国派大臣烛之武单独与秦国结盟，按约秦国派杞子、逢孙和杨孙率军驻在郑国，秦国退兵。杞子派人偷偷回国要秦穆公出兵，秦军就大举进攻，郑国商人弦高冒充使臣警告秦国，秦国只好攻打滑国"]},{"id":34974,"word":"秣马脂车","pinyin":"mò mǎ zhī chē","abbr":"mmzc","explanation":"秣：喂；脂：涂油脂。喂饱马，给车涂好油脂。指准备作战或准备好交通工具。","source":{"text":"便当秣马脂车，陵蹈城邑，乘胜逐北，以定华夏。","book":"晋·习凿齿《汉晋春秋》"},"example":{"text":"肃承明诏，应会皇都，星陈夙驾，～。","book":"晋·陈寿《三国志·魏志·陈思王植传》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":34975,"word":"秤不离砣","pinyin":"chèng bù lí tuó","abbr":"cblt","explanation":"秤和砣是一整套衡器。比喻事物之间有连带关系或关系亲密。","source":{"text":"《合纵记》剧：自古道：‘公不离婆，秤不离砣。’","book":"孙锦标《通俗常言疏证·什物》"},"example":{"text":"水不离波，～。","book":"《梦笔生花弦索乐府》"},"similar":["公不离婆"],"usage":"作宾语、分句；与“公不离婆”连用"},{"id":34976,"word":"秤平斗满","pinyin":"chèng píng dǒu mǎn","abbr":"cpdm","explanation":"指做买卖规矩，不短斤少两。","example":{"text":"做买卖应该做到～，童叟无欺。"},"opposite":["短斤少两"],"usage":"作宾语、定语；用于买卖"},{"id":34977,"word":"秤斤注两","pinyin":"chēng jīn zhù liǎng","abbr":"cjzl","explanation":"形容斤斤计较，顾小不顾大。","source":{"text":"只看如今秤斤注两，作两句破头，如此是多少衰气。","book":"《朱子语类》"}},{"id":34978,"word":"秤砣虽小压千斤","pinyin":"chèng tuó suī xiǎo yā qiān jīn","abbr":"ctsxyqj","explanation":"秤砣看来一小块却能压住千斤之重。比喻外表虽不引人注目，实际很起作用。","source":{"text":"俗语云：尿泡虽大无斤两，秤砣虽小压千斤。","book":"明·吴承恩《西游记》三十一回"},"usage":"作宾语、定语；用于口语"},{"id":34979,"word":"秤薪而爨","pinyin":"chēng xīn ér cuàn","abbr":"cxec","explanation":"薪：柴；爨：烧火煮饭。比喻只注意小事，不从大处着眼。","source":{"text":"称薪而爨，数米而炊，可以治小而未可以治大也。","book":"《淮南子·泰族训》"},"example":{"text":"积财聚谷，日不暇给。真个是数米而炊，称柴而爨。","book":"明·冯梦龙《警世通言》卷五"}},{"id":34980,"word":"秤锤落井","pinyin":"chèng chuí luò jǐng","abbr":"cclj","explanation":"秤锤掉进井里。比喻不见踪影，不知消息。","source":{"text":"福州资福善禅师，自此一别，秤锤落井。","book":"宋·释晓莹《罗湖野录》卷一"}},{"id":34981,"word":"秦关百二","pinyin":"qín guān bǎi èr","abbr":"qgbe","explanation":"由于地形优越，占据关中的人可以以少胜多。比喻地势险要。","source":{"text":"洛阳宫殿化为烽，休道秦关百二重。","book":"唐·杜甫《诸将五首》"},"example":{"text":"还只道～是千年业，那里有不散的华筵、不了的棋？","book":"清·魏子安《花月痕》第五十一回"}},{"id":34982,"word":"秦失其鹿","pinyin":"qín shī qí lù","abbr":"qsql","explanation":"鹿：喻指帝位。比喻失去帝位。","source":{"text":"秦失其鹿，天下共逐之。","book":"《史记·淮阴侯列传》"},"example":{"text":"自因～，天下大乱，高才疾足者先得之。","book":"明·无名氏《暗渡陈仓》头折"},"usage":"作宾语、定语；用于比喻句","story":["楚汉相争时期，刘邦与项羽争夺王位一直不分胜负，韩信可以与他们三分鼎足，蒯通劝他说：“秦失其鹿，天下共逐之，只有高材捷足者先得之。”韩信却选择了帮助刘邦，结果被吕后骗进长乐宫杀害。韩信到临死时才后悔没听蒯通的话"]},{"id":34983,"word":"秦女楚珠","pinyin":"qín nǚ chǔ zhū","abbr":"qncz","explanation":"比喻次要的东西胜过主要的东西。","source":{"text":"若文浮于理，末胜其本，则秦女楚珠，复存于兹矣。","book":"南朝·梁·刘勰《文心雕龙·议对》"},"usage":"作宾语、定语；用于比喻句","story":["传说春秋时期，秦国国君的女儿嫁到晋国时，有一位陪嫁婢女衣着华美，晋国人便认为那婢女比新娘更高贵。有个人带了楚国产的名珠到郑国去卖，并为名珠做了一个精美的盒子，郑国人不识货，买了以后又把名珠还给卖主，只留下了盒子"]},{"id":34984,"word":"秦庭之哭","pinyin":"qín tíng zhī kū","abbr":"qtzk","explanation":"原指向别国请求救兵。后也指哀求别人救助。","source":{"text":"申包胥如秦乞师，……立依于庭墙而哭，日夜不绝声，勺饮不入口，七日。秦哀公为之赋《无衣》，九顿首而坐。秦师乃出。","book":"《左传·定公四年》"},"example":{"text":"我只能用下策，派人向绵竹 ★刘宇亮）作～。","book":"姚雪垠《李自成》第一卷第二十三章"},"similar":["包胥之哭"],"usage":"作宾语；比喻乞求别人援救","story":["春秋时期，诸侯混战，吴国进攻楚国，楚国大败。楚国大臣申包胥前往秦国求救，秦哀公举棋不定，迟迟不发兵救楚。申包胥“立依于庭墙而哭，日夜不绝声，勺饮不入口。”哭了七天七夜，秦哀公深受感动，就答应出兵救援楚国"]},{"id":34985,"word":"秦庭朗镜","pinyin":"qín tíng lǎng jìng","abbr":"qtlj","explanation":"比喻官员判案公正廉明。","source":{"text":"有方镜，广四尺，高五尺九寸，表里有明。人直来照之，影则倒见。以手扪心而来，则见肠胃五脏，历然无硋。……秦始皇常以照宫人，胆张心动者则杀之。","book":"晋·葛洪《西京杂记》卷三"},"example":{"text":"负屈寒儒，得遇～；行凶诡计，难逃萧相明条。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"usage":"作宾语、定语；用于书面语"},{"id":34986,"word":"秦晋之匹","pinyin":"qín jìn zhī pī","abbr":"qjzp","explanation":"春秋时，秦晋两国世代互相婚嫁。泛指两家联姻。","source":{"text":"妻父有冰清之姿，婿有璧润之望，所谓秦晋之匹也。","book":"《晋诸公赞》"},"similar":["秦晋之好"],"usage":"作宾语；泛指两家联姻"},{"id":34987,"word":"秦晋之好","pinyin":"qín jìn zhī hǎo","abbr":"qjzh","explanation":"春秋时，秦晋两国不止一代互相婚嫁。泛指两家联姻。","source":{"text":"末将不才，便求小娘子以成秦晋之好，亦不玷辱了他，他如何便不相容。","book":"元·乔孟符《两世姻缘》第三折"},"example":{"text":"主公仰慕将军，欲求令爱为儿妇，永结～。","book":"明·罗贯中《三国演义》第十六回"},"similar":["秦晋之缘","天作之合","秦晋之盟"],"opposite":["反目成仇"],"usage":"作宾语；泛指两家联姻","story":["春秋时期，秦国和晋国为争夺霸主地位经常兵戎相见，但又彼此通婚联姻。晋献公把自己的女儿嫁给秦穆公，秦穆公把女儿文赢嫁给晋献公的儿子重耳（晋文公）。晋文公又让太子姬娶秦国公主。秦穆公抓了晋惠公，穆公夫人亲自出来求情"]},{"id":34988,"word":"秦晋之盟","pinyin":"qín jìn zhī méng","abbr":"qjzm","explanation":"春秋时，秦晋两国世代互相婚嫁。泛指两家联姻。","source":{"text":"年伯黄先生，位尊德重，求使主秦晋之盟，则唯命是听。","book":"清·蒲松龄《聊斋志异·小梅》"},"example":{"text":"清·蒲松龄《聊斋志异·小梅》：“年伯黄先生，位尊德重，求使主～，则唯命是听。”"},"similar":["秦晋之好"],"usage":"作宾语；泛指两家联姻"},{"id":34989,"word":"秦晋之缘","pinyin":"qín jìn zhī yuán","abbr":"qjzy","explanation":"春秋时，秦晋两国不止一代互相婚嫁。泛指两家联姻。","source":{"text":"我与你成合秦晋之缘何如。","book":"元·乔吉《金钱记》第三折"},"example":{"text":"倘蒙娘子垂怜，肯结～，足称平生之愿。","book":"明·兰陵笑笑生《金瓶梅词话》第十七回"},"similar":["秦晋之好","秦晋之盟"],"usage":"作宾语；用于男女间"},{"id":34990,"word":"秦智虞愚","pinyin":"qín zhì yú yú","abbr":"qzyy","explanation":"春秋时期虞国大夫百里奚无所作为，虞亡后入秦，辅佐穆公建立霸业。指一个人的才能只有在适当的环境中才能发挥。","source":{"text":"楚材晋用，国土所以长嗟；秦智虞愚，贤哲为之永叹。","book":"清·钱谦益《光禄大夫赠少保兼太子太保吏部尚书谥文通铁山王公墓志铭》"},"similar":["楚材晋用"],"usage":"作宾语、定语；用于书面语","story":["战国时期，晋献公用碧玉骏马向虞国行贿借道灭掉虢国与虞国，俘虏无所作为的虞国大夫百里奚，并将他作为奴隶陪嫁到楚国。秦穆公释放百里奚并与他共商国事，百里奚向他推荐蹇叔，秦穆公重金迎接蹇叔，百里奚与蹇叔、由余等辅佐穆公建立了霸业"]},{"id":34991,"word":"秦树楚天","pinyin":"qín shù chǔ tiān","abbr":"qsct","explanation":"秦地的树与楚国的天。形容相距很远。","source":{"text":"年华虚度，狠撩人情沾起初，想孤鸾别鹤空调，奈秦树楚天耽误。","book":"明·高瑞南《山坡羊·怨秋声》"},"usage":"作宾语、定语；用于遥远的事物"},{"id":34992,"word":"秦楼楚馆","pinyin":"qín lóu chǔ guǎn","abbr":"qlcg","explanation":"泛指歌舞场所。多指妓院。","source":{"text":"不甫能待的孩儿成立起，把爹娘不同个天和地，也不知他在楚馆秦楼贪恋着谁，全不想养育的深恩义。","book":"元·张国宾《薛仁贵》第三折"},"example":{"text":"每夜里就请到四马路～，达旦连宵。","book":"清·黄小配《廿载繁华梦》第十四回"},"similar":["楚馆秦楼","秦楼谢馆"],"usage":"作宾语、定语；指歌榭妓院","story":["春秋时期，秦穆公的女儿弄玉特别擅长吹箫，秦穆公特地为她修建了一座凤楼，也叫秦楼，弄玉在此楼吹箫作乐。楚灵王特别好色，修建了章华宫，挑选全国最漂亮的女子住在那里，供他玩乐。后人称章华宫为楚馆"]},{"id":34993,"word":"秦楼谢馆","pinyin":"qín lóu xiè guǎn","abbr":"qlxg","explanation":"旧指都城中的吃喝玩乐之所。","source":{"text":"花衢柳陌，恨他去胡沾惹，秦楼谢馆，怪他去闲游冶。","book":"元·李邦祐《黑心调淘金令·思情》"},"similar":["秦楼楚馆"],"usage":"作宾语、定语；指歌榭妓院"},{"id":34994,"word":"秦欢晋爱","pinyin":"qín huān jìn ài","abbr":"qhja","explanation":"春秋时，秦晋两国不止一代互相婚嫁。泛指两家联姻。","source":{"text":"秦欢晋爱成吴越，料今生缘分拙。","book":"元·向贲《醉花阴》词"},"similar":["秦晋之缘","秦晋之好"],"usage":"作宾语、定语；用于男女间"},{"id":34995,"word":"秦琼卖马","pinyin":"qín qióng mài mǎ","abbr":"qqmm","explanation":"秦琼：人名。秦琼卖掉自己的坐骑。","example":{"text":"你有～的时候吗？"},"usage":"作宾语、定语；指不得已而为之","story":["济南府的秦琼因公事到潞州办差耽误了几天，身边的银子全部花尽，被逼无奈只好把自己的马牵到马市去卖，恰好遇上一个老头引见二贤庄主单雄信，单雄信十分仰慕秦琼但不认识他，秦琼也不挑明，卖完马赶紧离开"]},{"id":34996,"word":"秦皇汉武","pinyin":"qín huáng hàn wǔ","abbr":"qhhw","explanation":"秦始皇和汉武帝。","source":{"text":"此秦皇汉武之所行，非二帝三王之事业也。","book":"宋·孔平仲《续世说·直谏》"},"example":{"text":"惜～，略输文采，唐宗宋祖，稍逊风骚。","book":"毛泽东《沁园春·雪》"},"usage":"作主语、宾语、定语；指伟人"},{"id":34997,"word":"秦约晋盟","pinyin":"qín yuē jìn méng","abbr":"qyjm","explanation":"盟：盟誓。春秋时期秦晋两国君主世代联姻。指婚约。","source":{"text":"兼之秦约晋盟，遽然断绝。","book":"《剪灯余话·凤尾草记》"},"usage":"作宾语、定语；指婚约"},{"id":34998,"word":"秦越肥瘠","pinyin":"qín yuè féi jí","abbr":"qyfj","explanation":"秦：今陕西一带；越：今浙江一带；肥瘠：胖瘦。秦越两地相去遥远。比喻疏远隔膜，各不相关。","source":{"text":"视政之得失，若越人视秦人之肥瘠，忽焉不加喜戚于其心。","book":"唐·韩愈《争臣论》"},"example":{"text":"愿陛下课官吏，使之任牛羊刍牧之责；劝富民，使之无～之视。","book":"《宋史·食货志上》六"},"usage":"作定语、宾语；指各不相关"},{"id":34999,"word":"秦镜高悬","pinyin":"qín jìng gāo xuán","abbr":"qjgx","explanation":"秦镜：相传秦始皇有一面镜子，能照见人的五脏六腑，知道心的邪正；悬：挂。比喻官员判案公正廉明。","source":{"text":"有方镜，广四尺，高五尺九寸，表里有明。人直来照之，影则倒见。以手扪心而来，则见肠胃五脏，历然无硋。……秦始皇常以照宫人，胆张心动者则杀之。","book":"《西京杂记》卷三"},"example":{"text":"清·无名氏《刘公案》第25回：“望大人的～。杀人之事，休要屈赖我佛门弟子。”"},"similar":["明镜高悬"],"usage":"作谓语、宾语；指公正严明","story":["传说秦朝咸阳宫中有一面神奇的镜子，他宽四尺，高五尺，正反两面都能照人，人在镜前镜中影子是倒立的，用手按住胸口照镜可以显示五脏六腑，可以看出人体内的病灶，还能看出那些心术不正的人，秦始皇经常用该镜对付身边的人"]},{"id":35000,"word":"秦鬟妆镜","pinyin":"qín huán zhuāng jìng","abbr":"qhzj","explanation":"秦鬟：浙江的秦望山；妆镜：绍兴鉴湖。比喻山清水秀的风景区。","source":{"text":"最负他，秦鬟妆镜，好江山何事此时游。","book":"宋·周密《一萼红·登蓬莱阁有感》"},"usage":"作宾语、定语；用于风景区"}]
