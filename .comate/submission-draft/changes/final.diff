+[{"id":37501,"word":"胆大心细","pinyin":"dǎn dà xīn xì","abbr":"ddxx","explanation":"形容办事果断，考虑周密。","source":{"text":"胆欲大而心欲小，智欲圆而行欲方。","book":"《旧唐书·孙思邈传》"},"example":{"text":"以～勇猛灵活的战斗作风，炸死炸伤了几百名敌人。","book":"峻青《不尽巨涛滚滚来》"},"similar":["胆大心小"],"opposite":["胆大心粗"],"usage":"作谓语、定语；形容办事果断，考虑周密"},{"id":37502,"word":"胆大心雄","pinyin":"dǎn dà xīn xióng","abbr":"ddxx","explanation":"形容胆子大，有雄心，做事无所畏惧。","source":{"text":"船中百翁梁溪酒，胆大心雄选锋手。","book":"明·杜睿《初闻灯船鼓吹歌》"},"similar":["胆壮心雄"],"opposite":["胆小怕事"],"usage":"作谓语、定语；形容做事无所畏惧"},{"id":37503,"word":"胆大泼天","pinyin":"dǎn dà pō tiān","abbr":"ddpt","explanation":"形容胆子极大。","source":{"text":"光天化日之下，岂容奸孽余党胆大泼天，目无三尺。","book":"清·王士禛《居易续谈》"},"similar":["胆大包天"],"opposite":["胆小如鼠"],"usage":"作谓语、宾语、定语；形容胆子极大"},{"id":37504,"word":"胆如斗大","pinyin":"dǎn rú dǒu dà","abbr":"drdd","explanation":"胆：胆量；斗：旧时的一种量器，容量为十升。胆子像斗一样大。形容胆量极大。","source":{"text":"维死时见剖，胆如斗大。","book":"晋·陈寿《三国志·蜀志·姜维传》：“维妻子皆伏诛。”裴松之注引《世语》"},"similar":["胆大如斗","胆大包天"],"opposite":["胆小怕事","胆小如鼠"],"usage":"作谓语、状语；指胆大","story":["三国时期，魏军大举进攻蜀国，姜维放弃阴平而退守剑阁，钟会劝姜维投降。姜维坚决拒绝。蜀亡后，钟会暗地里谋划背叛魏国。姜维认为这是复兴汉室的机会，为他出谋划策，事败被魏军所杀，剖开其肚，见其胆大如斗"]},{"id":37505,"word":"胆寒发竖","pinyin":"dǎn hán fā shù","abbr":"dhfs","explanation":"形容恐怖之极。","source":{"text":"李少卿又曰操空弮，冒白刃，闻者靡不胆寒发竖，永为子孙之戒。","book":"五代·王定保《唐摭言·好及第恶登科》"},"similar":["心惊胆战","毛骨悚然"],"opposite":["镇定自若"],"usage":"作谓语、状语；用于害怕"},{"id":37506,"word":"胆小如豆","pinyin":"dǎn xiǎo rú dòu","abbr":"dxrd","explanation":"极言胆子小。","source":{"text":"可笑我们中国的官员，胆小如豆，莫说见着短衣窄袖蜂目高鼻的洋人惊得发慌，就是见了一个没辫子的光棍，手里提着一根赶狗棒，也要害怕起来。","book":"《黑籍冤魂》第六回"},"similar":["胆小如鼠"],"opposite":["胆大包天","胆如斗大"],"usage":"作谓语、定语；指胆小"},{"id":37507,"word":"胆小如鼠","pinyin":"dǎn xiǎo rú shǔ","abbr":"dxrs","explanation":"胆子小得象老鼠。形容非常胆小。","source":{"text":"言同百舌，胆若鼷鼠。","book":"《魏书·汝阴王天赐传》"},"example":{"text":"他们样子往往很凶，其实～。","book":"郭小川《文学工作不能跃进》"},"similar":["胆小怕事","畏首畏尾"],"opposite":["胆大包天","浑身是胆","胆大妄为"],"usage":"作谓语、定语；指胆小"},{"id":37508,"word":"胆小如鼷","pinyin":"dǎn xiǎo rú xī","abbr":"dxrx","explanation":"胆子小得象老鼠。形容非常胆小。","source":{"text":"言同百舌，胆若鼷鼠。","book":"《魏书·汝阴王天赐传》"},"example":{"text":"中央怕《竖琴》前记，真是～，其实并无害。","book":"鲁迅《书信集·致赵家璧》"},"similar":["胆小如鼠","胆小如豆"],"opposite":["胆大包天","胆如斗大"],"usage":"作谓语、定语；指胆小"},{"id":37509,"word":"胆小怕事","pinyin":"dǎn xiǎo pà shì","abbr":"dxps","explanation":"胆子非常小，怕事情落在自己头上，怕惹麻烦。","source":{"text":"他后来竟然变成了一个胆小怕事、见人低头、懦弱安分、甘受欺侮的小公务员。","book":"巴金《谈》"},"example":{"text":"他一向都是～。"},"similar":["胆小如鼠"],"opposite":["胆大心雄","胆大包天"],"usage":"作谓语、定语；指没魄力"},{"id":37510,"word":"胆小鬼","pinyin":"dǎn xiǎo guǐ","abbr":"dxg","explanation":"胆量小的人。","source":{"text":"若被这种梭镖队吓翻了，那真是胆小鬼！","book":"毛泽东《湖南农民运动考察报告》"},"similar":["怕死鬼"],"usage":"作主语、宾语、定语；用于处事"},{"id":37511,"word":"胆怯心虚","pinyin":"dǎn qiè xīn xū","abbr":"dqxx","explanation":"形容理亏气馁，胆小害怕。","source":{"text":"无奈人家的词严义正，自己胆怯心虚，只得陪着笑脸儿。","book":"清·文康《儿女英雄传》第五回"},"example":{"text":"悺与称～，自恐不能逃罪，并皆仰药毕命。","book":"蔡东藩《后汉演义》第五十二回"}},{"id":37512,"word":"胆惊心战","pinyin":"dǎn jīng xīn zhàn","abbr":"djxz","explanation":"惊：惊惧，害怕；战：发抖。形容非常害怕。","source":{"text":"可怜平地风波变，天那好苦，霎时间胆惊心战。","book":"明·陆采《怀香记·索香看墙》"},"similar":["胆惊心颤"],"opposite":["神色不惊"],"usage":"作谓语、状语；形容十分害怕"},{"id":37513,"word":"胆惊心颤","pinyin":"dǎn jīng xīn chàn","abbr":"djxc","explanation":"惊：惊惧，害怕；颤：发抖。形容非常害怕。","source":{"text":"知剑刚锋，百魔剿退，胆惊心颤。","book":"金·王吉昌《永遇乐》词"},"similar":["胆战心惊","胆颤心惊"],"opposite":["神色不惊"],"usage":"作谓语、状语；形容十分害怕"},{"id":37514,"word":"胆战心寒","pinyin":"dǎn zhàn xīn hán","abbr":"dzxh","explanation":"战：发抖。形容害怕之极。","source":{"text":"怕的是城荒国破，常子是胆战心寒。","book":"《古今杂剧·楚昭王疏者下船》"},"example":{"text":"诸将见李逵等杀了一阵，众人都～，不敢出战。","book":"明·罗贯中《三国演义》第一百一十回"},"similar":["胆战心惊"],"opposite":["神色自若"],"usage":"作谓语、定语、状语；指害怕"},{"id":37515,"word":"胆战心惊","pinyin":"dǎn zhàn xīn jīng","abbr":"dzxj","explanation":"战：通“颤”，发抖。形容十分害怕。","source":{"text":"不由我不心惊胆战，索陪着笑脸儿褪后趋前。","book":"元·无名氏《碧桃花》第三折"},"example":{"text":"三藏见说，又～，不敢举步。","book":"明·吴承恩《西游记》第十三回"},"similar":["胆颤心惊","面无人色"],"opposite":["镇定自若","满不在乎"],"usage":"作谓语、状语；形容十分害怕"},{"id":37516,"word":"胆战心慌","pinyin":"dǎn zhàn xīn huāng","abbr":"dzxh","explanation":"形容十分害怕。","source":{"text":"牛郎织女图欢会，蜂喧蝶嚷须回避，我因此上胆战心慌不自持。","book":"明·汪廷讷《种玉记·赴约》"},"similar":["胆战心惊"],"usage":"作谓语、状语；形容十分害怕"},{"id":37517,"word":"胆战心摇","pinyin":"dǎn zhàn xīn yáo","abbr":"dzxy","explanation":"形容十分害怕。","source":{"text":"呀，你道失机的哥舒翰，称兵的安禄山，赤紧的离了渔阳，陷了东京，破了潼关，唬得人胆战心摇。","book":"清·洪昇《长生殿·惊变》"},"similar":["胆战心慌","胆战心惊"],"opposite":["神色不惊"],"usage":"作谓语、状语；形容十分害怕"},{"id":37518,"word":"胆战魂惊","pinyin":"dǎn zhàn hún jīng","abbr":"dzhj","explanation":"战：发抖。形容十分恐惧害怕。","source":{"text":"闻说便胆战心惊，岂得交吾曹为使。","book":"《敦煌变文集·维摩诘经讲经文》"},"example":{"text":"你来生仍投入汉家，立为献帝，一生被曹操欺侮，～，坐卧不安，度日如年。","book":"明·冯梦龙《喻世明言》卷三十一"}},{"id":37519,"word":"胆略兼人","pinyin":"dǎn lüè jiān rén","abbr":"dljr","explanation":"胆略：勇气和智谋；兼：加倍；兼人：超过别人。形容胆量和谋略胜过常人。","source":{"text":"孙权与陆逊论周瑜、鲁肃及蒙曰：‘公瑾雄烈，胆略兼人。’","book":"晋·陈寿《三国志·吴志·吕蒙传》"},"usage":"作谓语、定语；用于人的胆识"},{"id":37520,"word":"胆破心寒","pinyin":"dǎn pò xīn hán","abbr":"dpxh","explanation":"形容由于恐惧而伏帖的样子。","source":{"text":"胆破心寒，比敌人慑伏之状。","book":"明·程登吉《幼学琼林·武职》"},"similar":["胆破心惊"],"opposite":["神色自若"],"usage":"作谓语、状语；指害怕","story":["北宋时期，范仲淹与韩琦两人都曾镇守陕西抵御西夏的骚扰边境，他们军队纪律严明，作战英勇顽强。当时边塞流传民谣说：“军中有一韩，西贼闻之心骨寒；军中有一范，西贼闻之惊破胆。”"]},{"id":37521,"word":"胆破心惊","pinyin":"dǎn pò xīn jīng","abbr":"dpxj","explanation":"形容非常害怕。","source":{"text":"猛抬头，人人自胆破心惊！钟声半彻云霄，舞动起多少回鸾翔凤。","book":"明·郭勋《英烈传》第四回"},"example":{"text":"这事让她～。"},"similar":["胆战心惊","胆破心寒"],"opposite":["镇定自若"],"usage":"作谓语、状语；指害怕"},{"id":37522,"word":"胆粗气壮","pinyin":"dǎn cū qì zhuàng","abbr":"dcqz","explanation":"形容胆大气盛，无所畏惧。","source":{"text":"我只从昨天受了那和尚的一番折磨，又经了十三妹姐姐的地番教化，不觉得胆粗气壮起来。","book":"清·文康《儿女英雄传》第十一回"},"example":{"text":"曾朴《孽海花》第35回：“立人是～的豪公子，突然见这个生人进来得奇怪，知道不妙。”"},"similar":["胆壮气粗"],"usage":"作谓语、定语、状语；指胆大"},{"id":37523,"word":"胆裂魂飞","pinyin":"dǎn liè hún fēi","abbr":"dlhf","explanation":"裂：破裂。魂：魂灵、神志。胆也破了，魂也飞了。形容极度害怕、恐慌。","source":{"text":"且说王观察见防营军作乱，吓得个胆裂魂飞。","book":"清·张春帆《宦海》第九回"},"example":{"text":"她被吓得～了。"},"similar":["魂飞魄散"],"opposite":["神色自若"],"usage":"作状语；指害怕"},{"id":37524,"word":"胆颤心寒","pinyin":"dǎn chàn xīn hán","abbr":"dcxh","explanation":"颤：颤抖；寒：忧惧，战栗。形容极度惊慌恐惧。","source":{"text":"半空中一声霹雳，只震得三妖胆颤心寒。","book":"明·许仲琳《封神演义》第96回"},"example":{"text":"她被吓得～。"},"similar":["胆战心寒","胆颤心惊"],"opposite":["神色不惊","镇定自若"],"usage":"作谓语、定语、状语；指害怕"},{"id":37525,"word":"胆颤心惊","pinyin":"dǎn chàn xīn jīng","abbr":"dcxj","explanation":"颤：发抖。形容非常害怕。","source":{"text":"生长升平，谁曾惯遭离乱，苦怎言。胆颤心惊，如何可免。","book":"元·施惠《幽闺记·士女随迁》"},"example":{"text":"所以，每有风声，无不‘谈虎色变’，～。","book":"李六如《六十年的变迁》第二卷第八章"},"similar":["胆战心惊","心惊肉跳","魂不附体"],"opposite":["神色不惊","镇定自若","满不在乎"],"usage":"作谓语、定语；形容胆怯"},{"id":37526,"word":"背义忘恩","pinyin":"bèi yù wàng ēn","abbr":"bywe","explanation":"指背弃道义，忘却恩德。同“背恩忘义”。","source":{"text":"不想他背义忘恩，更待干罢。","book":"元·无名氏《谢金吾》第三折"},"example":{"text":"那满朝文武，平日高官厚禄……那一件不是朝廷恩典，如今却一个个贪生怕死，～，争去投降不迭。","book":"清·洪昇《长生殿·骂贼》"},"similar":["背恩忘义","忘恩弃义"],"opposite":["感恩戴德"],"usage":"作谓语、定语；指不记恩德"},{"id":37527,"word":"背义负信","pinyin":"bèi yù fù xìn","abbr":"byfx","explanation":"指背弃道义，不守信用。","source":{"text":"见“背信弃义”。"},"example":{"text":"我根本就没有料到，希特勒竟发狂到这样的地步，在一年以前就～，开始去侵犯苏联。","book":"郭沫若《笑早者，祸哉》"},"similar":["背信弃义"],"opposite":["一诺千金"],"usage":"作谓语、定语；用于揭露、指责、谴责的场合"},{"id":37528,"word":"背义负恩","pinyin":"bèi yù fù ēn","abbr":"byfe","explanation":"指背弃道义，辜负别人对自己的恩德。","source":{"text":"上以其累经重任，顿亏臣节，自受逆命，颇闻讥谐悖慢之言，背义负恩，固不可舍，命斩之。","book":"《旧唐书·乔琳传》"},"similar":["背恩忘义","忘恩负义"],"opposite":["以德报怨","知恩必报"],"usage":"作谓语、定语；指不记恩德"},{"id":37529,"word":"背乡离井","pinyin":"bèi xiāng lí jǐng","abbr":"bxlj","explanation":"指远离家乡，流落他方。","source":{"text":"见“背井离乡”。"},"example":{"text":"老夫做了二十年仕宦，万一遇见贼徒，岂能幸免，所以～，寄迹他方。","book":"清·李渔《巧团圆·梦讯》"},"similar":["离乡背井"],"opposite":["安居乐业"],"usage":"作谓语、定语；指在外瓢泊"},{"id":37530,"word":"背井离乡","pinyin":"bèi jǐng lí xiāng","abbr":"bjlx","explanation":"背：离开；井：古制八家为井，引伸为乡里，家宅。离开家乡到外地。","source":{"text":"元·贾仲名《对玉梳》第一折：“送的他离乡背井，进退无门。"},"example":{"text":"～，卧雪眠霜。","book":"元·马致远《汉宫秋》第三折"},"similar":["离乡背井","浪迹天涯","颠沛流离"],"opposite":["衣锦还乡","安家立业","落叶归根"],"usage":"作谓语、定语；指不得已而离别家乡"},{"id":37531,"word":"背信弃义","pinyin":"bèi xìn qì yì","abbr":"bxqy","explanation":"背：违背；信：信用；弃：扔掉；义：道义。违背诺言，不讲道义。","source":{"text":"背惠怒邻，弃信忘义。","book":"《北史·周纪下·高祖武帝》"},"example":{"text":"～是插在我背上的一把尖刀。","book":"曹禺《王昭君》第五幕"},"similar":["见利忘义","自食其言","言而无信"],"opposite":["恪守不渝","一诺千金"],"usage":"作谓语、定语；用于揭露、指责、谴责的场合"},{"id":37532,"word":"背信负义","pinyin":"bèi xìn fù yì","abbr":"bxfy","explanation":"信：信用；义：道义。违背诺言，不讲道义。","source":{"text":"我根本就没有料到，希特勒竟发狂到这样的地步，在一年以前就背信负义，开始去侵犯苏联。","book":"郭沫若《笑早者，祸哉》"},"similar":["背信弃义","弃信违义"],"usage":"作谓语、定语；用于指责、谴责的场合"},{"id":37533,"word":"背公向私","pinyin":"bèi gōng xiàng sī","abbr":"bgxs","explanation":"指损公肥私，违法求利。","source":{"text":"二千石不奉诏书，遵承典制，背公向私，旁诏守利，侵渔百姓，聚敛为奸。","book":"《宋书·百官志下》"},"similar":["背公营私"],"opposite":["大公无私"],"usage":"作谓语、宾语、定语；指私心重"},{"id":37534,"word":"背公徇私","pinyin":"bèi gōng xùn sī","abbr":"bgxs","explanation":"公：正直无；徇：曲从。违背正道，营私舞弊。","source":{"text":"侵害百姓，背公徇私。","book":"《北史·炀帝纪》"}},{"id":37535,"word":"背公循私","pinyin":"bèi gōng xún sī","abbr":"bgxs","explanation":"公：正直无；循：曲从。违背正道，营私舞弊。","source":{"text":"公：正直无；循：曲从。违背正道，营私舞弊。"}},{"id":37536,"word":"背公营私","pinyin":"bèi gōng yíng sī","abbr":"bgys","explanation":"指损公肥私，违法求利。亦作“背公向私”。","source":{"text":"今背公营私者侵渔不已。","book":"宋·张商英《护法论》"},"example":{"text":"郭疏云：“明珠与余国柱～诸款。”","book":"清昭槤《啸亭杂录·郭刘二疏》"},"similar":["损公肥私","背公向私"],"opposite":["大公无私"],"usage":"作谓语、宾语、定语；指私心重"},{"id":37537,"word":"背前面后","pinyin":"bèi qián miàn hòu","abbr":"bqmh","explanation":"指或当面或背后。","source":{"text":"若是一顿钯打退妖精，你看他得胜而回，争嚷功果；若战他不过，被他拿去，却是我的晦气，背前面后，不知骂了多少弼马温哩！悟净，你休言语，等我去看看。","book":"明·吴承恩《西游记》第八十五回"},"example":{"text":"若是三姑娘在家还好，如今只有他几个自己的人瞎张罗，～的也抱怨，说是一个钱摸不着，脸面也不能剩一点儿。","book":"清·曹雪芹《红楼梦》第一百十回"}},{"id":37538,"word":"背地厮说","pinyin":"bèi dì sī shuō","abbr":"bdss","explanation":"背地里胡说八道。","source":{"text":"对面厮啜，背地厮说。","book":"宋·庄绰《鸡肋编》"}},{"id":37539,"word":"背城一战","pinyin":"bèi chéng yī zhàn","abbr":"bcyz","explanation":"背：背向。在自己城下和敌人决一死战。多指决定存亡的最后一战。","source":{"text":"请收合余烬，背城借一。","book":"《左传·成公二年》"},"example":{"text":"他皱着眉头问道：“可是我们怎么～呢？”","book":"茅盾《子夜》十八"},"similar":["背水一战","背城借一"],"usage":"作谓语、定语；指与敌人作最后的决战"},{"id":37540,"word":"背城借一","pinyin":"bèi chéng jiè yī","abbr":"bcjy","explanation":"背：背向；借：凭借；一：一战。在自己城下和敌人决一死战。多指决定存亡的最后一战。","source":{"text":"请收合余烬，背城借一。","book":"《左传·成公二年》"},"example":{"text":"合家细弱，依栖于此，屡被封家女子，横见摧残，今欲～，烦君属檄草耳。","book":"清·蒲松龄《聊斋志异·绛妃》"},"similar":["背水一战","破釜沉舟","垂死挣扎"],"opposite":["重整旗鼓"],"usage":"作谓语、定语；形容作最后一搏","story":["春秋时期，齐顷公被晋鲁卫三国联军打败，就派上卿宾媚人带上玉器及土地册子，去向晋军求和，并嘱咐不能屈服受辱。宾媚人来到晋国军营见到中军主将，晋国趁机提出无理要求，宾媚人说如果这样就只好收集残兵，背城借一，死战到底"]},{"id":37541,"word":"背山起楼","pinyin":"bèi shān qǐ lóu","abbr":"bsql","explanation":"靠山建造楼房。比喻使人扫兴的事。","source":{"text":"其一曰杀风景，谓清泉濯足，花上晒裤，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。","book":"宋·胡仔《茹溪渔隐丛话前集·西崑体》"},"similar":["大煞风景"],"usage":"作补语、定语；指破坏风景","story":["唐朝诗人李商隐很有才华，他的诗揭露和批判当时的黑暗现实及官场腐败。他在《杂纂》中列出大煞风景的事情，如“清泉濯足，花上晒禈，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。”这些都是当时让人扫兴的事情"]},{"id":37542,"word":"背恩弃义","pinyin":"bèi ēn qì yì","abbr":"beqy","explanation":"指辜负别人对自己的恩义。同“背恩忘义”。","source":{"text":"反以身劳民，民犹背恩弃义而远流亡。","book":"汉·桓宽《盐铁论·未通》"},"example":{"text":"反之，丢掉革命传统，对人民～，一阔脸就变，骑在人民头上作威作福，便为人民所诅咒了。","book":"管桦《关于的复信》"},"similar":["背恩负义","背恩忘义"],"opposite":["知恩必报"],"usage":"作谓语、定语；指不记恩德"},{"id":37543,"word":"背恩忘义","pinyin":"bèi ēn wàng yì","abbr":"bewy","explanation":"背：背叛。指背弃恩德，忘却道义。","source":{"text":"沈等皆刀锯之余，背恩忘义之类。","book":"《汉书·张敞传》：“背恩忘义，伤化薄俗。”《晋书·刘聪传》"},"example":{"text":"幸得主人释放，留为家丁，又以妻子配我，此恩天高地厚，未曾报得，岂可为此～之事。","book":"明·冯梦龙《醒世恒言》卷十九"},"similar":["忘恩负义","背恩弃义"],"usage":"作谓语、定语；指不记恩德"},{"id":37544,"word":"背恩负义","pinyin":"bèi ēn fù yì","abbr":"befy","explanation":"指辜负别人对自己的恩义。同“背恩忘义”。","source":{"text":"遂乃背恩负义，各立异图。","book":"《陈书·陈宝应传》"},"similar":["背恩忘义","忘恩负义"],"usage":"作谓语、定语；指不记恩德"},{"id":37545,"word":"背惠食言","pinyin":"bèi huì shí yán","abbr":"bhsy","explanation":"指忘恩失信。","source":{"text":"荐至蠕蠕，责其背惠食言，并论结婚之意。","book":"《周书·杨荐传》"},"example":{"text":"盖不退师则～而曲在晋师。","book":"宋·秦观《晁错论》"},"similar":["食言而肥"],"usage":"作谓语、定语；指人忘恩"},{"id":37546,"word":"背故向新","pinyin":"bèi gù xiàng xīn","abbr":"bgxx","explanation":"弃绝多年的朋友，而同新结识的人来往。指结交朋友不为友谊，只图势力。","source":{"text":"思远而忘近，背故而向新。","book":"汉·王充《潜夫论》"}},{"id":37547,"word":"背暗投明","pinyin":"bèi àn tóu míng","abbr":"batm","explanation":"背：背弃；投：投奔。离开黑暗，投向光明。比喻在政治上脱离反动阵营，投向进步方面。","source":{"text":"高鸟相良木而栖，贤臣择明主而佐。背暗投明，古之常理。","book":"元·尚仲贤《单鞭夺槊》楔子"},"example":{"text":"吾观项王有勇无谋，天下定然无分，我欲～，奈无明主。","book":"明·沈采《千金记·会宴》"},"similar":["弃暗投明"],"opposite":["明珠暗投"],"usage":"作谓语、定语；指追求真理"},{"id":37548,"word":"背曲腰弯","pinyin":"bèi qǔ yāo wān","abbr":"bqyw","explanation":"腰背弯曲。常指坐久或年老。同“背曲腰躬”。","source":{"text":"假如甘罗十二岁为丞相，十二岁上就死了，这十二岁之年，就是他发白齿落、背曲腰弯的时候了。","book":"明·冯梦龙《警世通言》第十八卷"}},{"id":37549,"word":"背曲腰躬","pinyin":"bèi qǔ yāo gōng","abbr":"bqyg","explanation":"腰背弯曲。常指坐久或年老。","source":{"text":"等的人心热肠鸣，坐的来背曲腰躬。","book":"明·凌濛初《二刻拍案惊奇》卷四十"}},{"id":37550,"word":"背本就末","pinyin":"bèi běn jiù mò","abbr":"bbjm","explanation":"指背离根本，追逐末节。","source":{"text":"何期臣仆吴越，背本就末乎？","book":"《三国志·蜀志·吕凯传》"},"example":{"text":"这样做就是～。"},"similar":["背本趋末","背本逐末"],"usage":"作谓语、定语；指不分主次"},{"id":37551,"word":"背本趋末","pinyin":"bèi běn qū mò","abbr":"bbqm","explanation":"古代常以农业为本，手工、商贾为末。指背离主要部分，追求细微末节。","source":{"text":"时民近战国，皆背本趋末。","book":"东汉·班固《汉书·食货志上》"},"example":{"text":"民多～，或有饥寒之色。","book":"东汉·班固《汉书·魏相传》"},"similar":["本末倒置","舍本求末"],"usage":"作谓语；同“舍本求末”"},{"id":37552,"word":"背槽抛粪","pinyin":"bèi cáo pāo fèn","abbr":"bcpf","explanation":"像牲口那样，刚吃完槽里的食物，就背过身来拉屎。比喻忘恩负义，以怨报德。","source":{"text":"一个个背槽抛粪，一个个负义忘恩。","book":"元·关汉卿《调风月》第一折"},"similar":["忘恩负义","过河拆桥"],"opposite":["以德报怨"],"usage":"作谓语、定语；用于指责人"},{"id":37553,"word":"背水一战","pinyin":"bèi shuǐ yī zhàn","abbr":"bsyz","explanation":"背水：背向水，表示没有退路。比喻与敌人决一死战。","source":{"text":"信乃使万人先行，出，背水陈。赵军望见而大笑。","book":"《史记·淮阴侯列传》"},"example":{"text":"挫折也有两重性。它可以把人置于死地，也可能使人置于死地而后生。他只有～了。","book":"理由《高山与平原》"},"similar":["破釜沉舟","背城借一","济河焚州"],"opposite":["重整旗鼓"],"usage":"作谓语、定语；比喻在艰难情况下跟敌人决战","story":["西汉三年刘邦派大将韩信和张耳率军攻打赵国，赵王刘歇和大将陈余率20万大军在井陉口迎战。陈余不听谋士李左车的建议，与韩信硬拼，韩信用计将其引至河边，然后派兵轻取赵军大营，杀死陈余，活捉刘歇，消灭赵国"]},{"id":37554,"word":"背水为阵","pinyin":"bèi shuǐ wéi zhèn","abbr":"bswz","explanation":"水：指河流。背对着淋漓摆开阵势，拼死战斗。比喻决一死战。","source":{"text":"信乃使万人先行，出，背水陈。赵军望见而大笑。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"昔韩信～，所谓‘致之死地而后生’也。","book":"明·罗贯中《三国演义》第71回"},"similar":["背水一战","背水结阵"],"usage":"作谓语、定语；指决战","story":["西汉三年刘邦派大将韩信和张耳率军攻打赵国，赵王刘歇和大将陈余率20万大军在井陉口迎战。陈余不听谋士李左车的建议，与韩信硬拼，韩信用计将其引至河边，然后派兵轻取赵军大营，杀死陈余，活捉刘歇，消灭赵国"]},{"id":37555,"word":"背生芒刺","pinyin":"bèi shēng máng cì","abbr":"bsmc","explanation":"犹言芒刺在背。同“背若芒刺”。","source":{"text":"适才听智兄之言，觉得背生芒刺。","book":"清·石玉昆《三侠五义》第112回"},"example":{"text":"这事让她一直有～的感觉。"},"similar":["背若芒刺","芒刺在背"],"usage":"作宾语、定语；指不安"},{"id":37556,"word":"背盟败约","pinyin":"bèi méng bài yuē","abbr":"bmby","explanation":"背：违背。盟、约：誓约。败：败坏。指撕毁。背叛誓言，撕毁盟约。","source":{"text":"不知出此，而乃贪疆场尺寸之利，背盟败约，以自相屠灭。","book":"宋·苏辙《六国论》"},"usage":"作谓语、定语；指撕毁合约"},{"id":37557,"word":"背碑覆局","pinyin":"bèi bēi fù jú","abbr":"bbfj","explanation":"看过的碑文能背诵，棋局乱后能复旧。指记忆力强。","source":{"text":"张蕴古，相州洹水人也。性聪敏，博涉书传，善缀文，能背碑覆局，尤晓时务，为州闾所称。","book":"《旧唐书·文苑传上·张蕴古》"},"example":{"text":"智周聪慧，举朝无比，日诵数万言，能～。","book":"《太平广记》卷一四七引唐·韩琬《御史台记·高智周》"},"usage":"作宾语、定语；指人的记忆力"},{"id":37558,"word":"背紫腰金","pinyin":"bèi zǐ yāo jīn","abbr":"bzyj","explanation":"身穿紫袍，腰佩金饰。指做大官。","source":{"text":"指望你背紫腰金，怎知你不成器！","book":"元·无名氏《宦门子弟错立身》"},"similar":["衣紫腰金"],"opposite":["一贫如洗"],"usage":"作谓语、定语；指人有权有势"},{"id":37559,"word":"背约负盟","pinyin":"bèi yuē fù méng","abbr":"byfm","explanation":"盟：盟誓。违背原来的约定和誓言。指人背信弃义。","source":{"text":"不料后来背约负盟，移花接木，治晚生心实不甘，故今日行权娶来，求太公祖与老父母做主。","book":"清·名教中人《好逑传》第五回"},"similar":["背信弃义"],"usage":"作谓语、定语、宾语；用于处事"},{"id":37560,"word":"背腹受敌","pinyin":"bèi fù shòu dí","abbr":"bfsd","explanation":"指前后都受到敌人的攻击。","source":{"text":"吾无水战之具，而使淮兵断正阳浮桥，则我背腹受敌。","book":"《新五代史·南唐世家·李昪》"},"example":{"text":"术虎高琪向南方“扩地”的图谋难以实现，反而使金朝～，兵力分散。","book":"范文澜蔡美彪等《中国能史》第四编第五章第三节"},"similar":["腹背受敌"],"opposite":["各个击破"],"usage":"作谓语、定语、分句；用于战争状态"},{"id":37561,"word":"背若芒刺","pinyin":"bèi ruò máng cì","abbr":"brmc","explanation":"犹言芒刺在背。","source":{"text":"不意［曹操］专国弄权，擅作威福。朕每见之，背若芒刺。","book":"明·罗贯中《三国演义》第二十回"},"similar":["背生芒刺","芒刺在背"],"usage":"作宾语、定语；指不安"},{"id":37562,"word":"背道而驰","pinyin":"bèi dào ér chí","abbr":"bdec","explanation":"背：背向；道：道路；驰：奔跑。朝相反的方向跑去。比喻彼此的方向和目的完全相反。","source":{"text":"其余各探一隅，相与背驰于道者，其去弥远。","book":"唐·柳宗元《〈杨评事文集〉后序》"},"example":{"text":"道学先生于是乎从而禁之，虽然很象～，其实倒是心心相印。","book":"鲁迅《坟·从胡须说到牙齿》"},"similar":["南辕北辙","适得其反","北辕适楚"],"opposite":["如出一辙","并驾齐驱"],"usage":"作谓语；形容越跑越远，永远达不到目的","story":["战国时期，魏国大臣季梁在出使途中得知魏王要出兵进攻赵都邯郸后，立即折返拜见魏王，声称在路上遇到一个老成的车夫驾驭一匹千里马向北去目的地楚国，魏王大笑他背道而驰。季梁借机劝谏魏王对赵休兵"]},{"id":37563,"word":"背黑锅","pinyin":"bēi hēi guō","abbr":"bhg","explanation":"比喻代人受过。泛指受冤屈。","source":{"text":"别光顾一时痛快，自己倒霉不算，我也得跟着背黑锅……走吧。","book":"王朔《千万别把我当人》"},"example":{"text":"你不能让他去～。"},"opposite":["嫁祸于人"],"usage":"作谓语、定语、宾语；用于口语"},{"id":37564,"word":"胎死腹中","pinyin":"tāi sǐ fù zhōng","abbr":"tsfz","explanation":"比喻一件事情还在筹备阶段就夭折。","example":{"text":"我的计划～了。"},"usage":"作谓语、定语；指中途夭折"},{"id":37565,"word":"胙土分茅","pinyin":"zuò tǔ fēn máo","abbr":"ztfm","explanation":"胙：赐；分茅：古代帝王分封诸侯的仪式。指分封爵位和土地。","source":{"text":"分茅胙土，赖周天子宠缓；右佛左萦，凭项庄王余烈。","book":"明·王錂《春芜记》"},"similar":["分茅胙土"],"usage":"作谓语、宾语；指分封爵位和土地"},{"id":37566,"word":"胜不骄，败不馁","pinyin":"shèng bù jiāo，bài bù něi","abbr":"sbjbbn","explanation":"胜了不骄傲，败了不灰心。","source":{"text":"《商君书·战法》“王者之兵，胜而不骄，败而不怨。”"},"example":{"text":"中国运动员～，终于取得了优异的成绩。"},"usage":"作谓语、宾语、分句；指人对胜负的态度"},{"id":37567,"word":"胜人一筹","pinyin":"shèng rén yī chóu","abbr":"sryc","explanation":"占有优势，比较起来，胜过别人一点。","example":{"text":"他的技法～。"},"similar":["略胜一筹"],"usage":"作谓语、定语；指胜过别人"},{"id":37568,"word":"胜任愉快","pinyin":"shèng rèn yú kuài","abbr":"sryk","explanation":"胜任：能力足以担任。指有能力担当某项任务或工作，而且能很好地完成。","source":{"text":"当是之时，吏治若救火扬沸，非武健严酷，恶能胜其任而愉快乎？","book":"《史记·酷吏列传》"},"example":{"text":"骑士坐在上面喑呜叱咤，却还很能～，虽然有些人见了，难免觉得滑稽。","book":"鲁迅《准风月谈·冲》"},"similar":["应付自如","游刃有余"],"opposite":["无能为力","一无所能"],"usage":"作谓语、宾语；指能够完成使命","story":["汉景帝时期，酷吏郅都行为强毅，直言敢谏，处理事务时心狠手辣。他在济南任太守时，当地的大宗族特别恃强凌弱，横行乡里，他将首恶斩尽杀绝，其余的人再也不敢胡作非为。司马迁评论他做事果断，这样才能胜任愉快"]},{"id":37569,"word":"胜利在望","pinyin":"shèng lì zài wàng","abbr":"slzw","explanation":"在望：盼望的事就在眼前。指胜利即将到来。也指一件事情马上就要成功。","example":{"text":"她与汪永富刚刚展开的两条道路殊死的搏斗，已经～，却要前功尽弃。","book":"陆文夫《人之窝》第十八回"}},{"id":37570,"word":"胜友如云","pinyin":"shèng yǒu rú yún","abbr":"syry","explanation":"胜友：良友。许多良友聚集一处。","source":{"text":"十旬休暇，胜友如云。千里逢迎，高朋满座。","book":"唐·王勃《秋日登洪府滕王阁饯别序》"},"example":{"text":"今日之聚，可谓极盛了，我出“高朋满座，～”，打曲牌名。","book":"清·李汝珍《镜花缘》第八十一回"},"similar":["高朋满座"],"usage":"作谓语、定语；指许多良友聚集一处"},{"id":37571,"word":"胜残去杀","pinyin":"shèng cán qù shā","abbr":"scqs","explanation":"感化残暴的人使其不再作恶，便可废除死刑。也指以德化民，太平至治。","source":{"text":"夫报忿除害，捐残去杀，朕之所图于将军也。","book":"春秋·鲁·孔丘《论语·子路》：“善人为邦百年，亦可以胜残去杀矣。”东汉·班固《汉书·李广传》"},"example":{"text":"～，上冯宗庙之威。","book":"唐·杨炯《唐右将军魏哲神道碑》"},"similar":["捐残去杀","去杀胜残"],"usage":"作宾语、定语；指以德化民"},{"id":37572,"word":"胜读十年书","pinyin":"shèng dú shí nián shū","abbr":"sdsns","explanation":"胜：超过。超过苦读十年书的收获。形容思想上收益极大。","source":{"text":"古人有言曰：‘共君一夜话，胜读十年书。’若一日有所得，何止胜读十年书也。","book":"《二程全书·遗书二十二上·伊川语录》"},"example":{"text":"清·刘鹗《老残游记》第九回：“与君一夕话，～，真是闻所未闻！”"},"usage":"作宾语、定语；多用于感慨"},{"id":37573,"word":"胜负兵家之常","pinyin":"shèng fù bīng jiā zhī cháng","abbr":"sfbjzc","explanation":"兵家：军事家。胜利或失败是军事家常遇到的事情。","source":{"text":"昔日高祖与项羽争天下，数败于羽，后九里山一战成功，而开四百年基业，胜负兵家之常，何可自隳其志！","book":"明·罗贯中《三国演义》第31回"},"similar":["胜负兵家常势","胜败乃兵家常事"],"usage":"作宾语、定语、分句；用于劝诫"},{"id":37574,"word":"胜负兵家常势","pinyin":"shèng fù bīng jiā cháng shì","abbr":"sfbjcs","explanation":"意思是不要把偶然一次的胜利或失败看得太重。同“胜败乃兵家常事”。","source":{"text":"胜负兵家常势，不可以一将失利，便沮成计。","book":"《旧唐书·宪宗纪下》"},"similar":["胜败兵家常事","胜负兵家之常"],"usage":"作宾语、定语、分句；用于劝诫"},{"id":37575,"word":"胜败乃兵家常事","pinyin":"shèng bài nǎi bīng jiā cháng shì","abbr":"sbnbjcs","explanation":"胜利或失败是带兵作战的人常遇到的事情。意思是不要把偶然一次的胜利或失败看得太重。","source":{"text":"一胜一负，兵家常势。","book":"《旧唐书·裴度传》"},"example":{"text":"这次试验失败了，但不要恢心，～，总结经验，坚持试验下去，定能成功。"},"similar":["胜败兵家常势","胜负兵家之常"],"usage":"作宾语、定语、分句；用于劝诫"},{"id":37576,"word":"胝肩茧足","pinyin":"zhī jiān jiǎn zú","abbr":"zjjz","explanation":"指艰辛劳作。","source":{"text":"凡负贩者必多给其直，家人怪问其故，府君曰：‘彼人胝肩茧足以求升合利，吾忍与之较耶？","book":"明宋濂《瞿员外墓志铭》"},"usage":"作定语、状语；用于书面语"},{"id":37577,"word":"胡为乱信","pinyin":"hú wéi luàn xìn","abbr":"hwlx","explanation":"为：干。指胡乱地干事，盲目地迷信。","source":{"text":"向后来，再不可胡为乱信，望你把三教归一：也敬僧，也敬道，也养育人才，我保你江山永固。","book":"明·吴承恩《西游记》第四十七回"},"usage":"作谓语、宾语、定语；用于处事"},{"id":37578,"word":"胡作乱为","pinyin":"hú zuò luàn wéi","abbr":"hzlw","explanation":"犹胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"世人决不可戏而不戏，胡作乱为。","book":"《初刻拍案惊奇》卷二十"},"example":{"text":"张金龙在新政权底下，不能～，也收心多了。","book":"孔厥、袁静《新儿女英雄传》第四回"},"similar":["胡行乱为","胡作胡为","胡作非为"],"opposite":["安分守己"],"usage":"作谓语、定语、宾语；指任意做坏事"},{"id":37579,"word":"胡作胡为","pinyin":"hú zuò hú wéi","abbr":"hzhw","explanation":"犹胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"我没有法子，只好依从，到后来溜了手，才胡作胡为的呀！","book":"洪深《赵阎王》第六幕"},"example":{"text":"我听说那人喝醉了酒，心里倒宽了不少，～都不由他的意思，我们又何必怪他。","book":"叶圣陶《四三集·邻居》"},"similar":["胡作非为","胡行乱为","胡作乱为"],"opposite":["安分守己"],"usage":"作谓语、定语、宾语；指任意做坏事"},{"id":37580,"word":"胡作非为","pinyin":"hú zuò fēi wéi","abbr":"hzfw","explanation":"胡：乱；非：不对。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"汝车渡村百姓刘开道下贼惯作非为，今须改行，若故态不除，死无日矣。","book":"《旧五代史·张瓘传》"},"example":{"text":"或诬好吃懒做，或诬胡作非为。","book":"清·李汝珍《镜花缘》第十二回"},"similar":["胡为乱做","为非作歹","妄作胡为"],"opposite":["安分守己","循规蹈矩"],"usage":"作谓语、定语、状语；指任意做坏事"},{"id":37581,"word":"胡吃海喝","pinyin":"hú chī hǎi hē","abbr":"hchh","explanation":"无节制地大吃大喝。","example":{"text":"他一天到晚～的，反正公家报销。"},"similar":["大吃大喝","胡吃海塞"],"usage":"作谓语、宾语、定语；指大吃大喝"},{"id":37582,"word":"胡吹乱嗙","pinyin":"hú chuī luàn pǎng","abbr":"hclp","explanation":"嗙：吹牛，夸张。形容信口开河说大话，瞎吹牛。","source":{"text":"老实告诉你说吧，别花言巧语了，也别胡吹乱嗙了，要我上你家里去老虎头上抓毛，我不干。","book":"清·曾朴《孽海花》第二十二回"},"similar":["胡说乱道"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":37583,"word":"胡吹海摔","pinyin":"hú chuī hǎi shuāi","abbr":"hchs","explanation":"胡吹胡来，不负责任。","example":{"text":"他～，天南地北都知道。"},"similar":["信口开合"],"usage":"作谓语、宾语、定语；用于方言"},{"id":37584,"word":"胡啼番语","pinyin":"hú tí fān yǔ","abbr":"htfy","explanation":"胡、番：古时指外族或异域。旧时指外族或外国的语言。","source":{"text":"拨拨絃絃意不同，胡啼番语两玲珑。","book":"唐·白居易《听曹刚琵琶兼示重莲》"}},{"id":37585,"word":"胡天胡地","pinyin":"hú tiān hú dì","abbr":"hthd","explanation":"用于贬义，形容言语荒唐、行为放肆。同“胡天胡帝②”。","source":{"text":"也有一两家兼售古书了，但他们不识货，开价往往是胡天胡地。","book":"阿英《西门买书记》"},"example":{"text":"阿英《西门买书记》：“也有一两家兼售古书，但他们不识货，开价往往是～。”"},"similar":["胡天胡帝"],"usage":"作宾语、定语；用于口语"},{"id":37586,"word":"胡天胡帝","pinyin":"hú tiān hú dì","abbr":"hthd","explanation":"胡：何；帝：指天神。什么是天，什么是帝。①原形容服饰容貌像天神一样美丽，后也表示尊敬崇仰。②用于贬义，形容言语荒唐、行为放肆。","source":{"text":"胡然而天也！胡然而帝也！","book":"《诗经·庸风·君子偕老》"},"example":{"text":"～心如醉，疑雨疑云梦正浓。","book":"周亮《次石庵冬日感怀韵》"},"similar":["胡天胡地"],"usage":"作宾语、定语；表示尊敬崇仰"},{"id":37587,"word":"胡子工程","pinyin":"hú zǐ gōng chéng","abbr":"hzgc","explanation":"喻指进度缓慢、一拖再拖而长期不能投入使用的基建工程。","example":{"text":"这个～至今不能发挥其作用。"},"usage":"作宾语、定语；用于口语"},{"id":37588,"word":"胡子拉碴","pinyin":"hú zǐ lā chā","abbr":"hzlc","explanation":"形容满脸胡子零乱不齐的样子。","example":{"text":"他不修边幅，搞得～的。"},"usage":"作谓语、定语、状语；用于口语"},{"id":37589,"word":"胡孙入袋","pinyin":"hú sūn rù dài","abbr":"hsrd","explanation":"胡孙：同“猢狲”，猴子。猴子进了口袋。比喻中计而行动失去自由。","source":{"text":"梅圣俞诗名三十年，终不得一馆职，初受敕修《唐书》，语妻曰：‘吾之修书，可谓胡孙入布袋矣！’妻曰：‘君之仕宦，何异鲇鱼上竹竿耶。’","book":"宋·欧阳修《归田录》"},"similar":["猢狲入布袋"],"usage":"作宾语；指失去自由"},{"id":37590,"word":"胡思乱想","pinyin":"hú sī luàn xiǎng","abbr":"hslx","explanation":"指没有根据，不切实际的瞎想。","source":{"text":"宜于日用之间，稍立课程，不要如此胡思乱量，过却子也。","book":"《朱子全书·学》"},"example":{"text":"杏莉母亲正在～之际，听到有人敲门，高兴极了！","book":"冯德英《苦菜花》第三章"},"similar":["痴心妄想","胡思乱量","游思网箱"],"opposite":["确信不疑"],"usage":"作谓语、宾语、定语；形容毫无收益的思想"},{"id":37591,"word":"胡思乱量","pinyin":"hú sī luàn liàng","abbr":"hsll","explanation":"犹胡思乱想。指没有根据，不切实际的瞎想。","source":{"text":"慈圣意不怿，曰：‘皇亲辈皆笑太后欲于旧涡寻兔儿。’闻者惊惧，皆退数步立。独琦不动，曰：‘太后不要胡思乱量。’","book":"宋·苏辙《龙川别志》卷下"},"example":{"text":"切宜便就脚下一切扫去，而于日用之间，稍立程课，著实下工夫，不要如此～过却日子也。","book":"宋·朱熹《答潘文叔书》之一"},"similar":["胡思乱想"],"usage":"作谓语、宾语、定语；形容毫无收益的思想"},{"id":37592,"word":"胡打海摔","pinyin":"hú dǎ hǎi shuāi","abbr":"hdhs","explanation":"比喻经得起磕碰，不娇贵。","source":{"text":"比不得咱们家的孩子，胡打海摔的惯了的。","book":"清·曹雪芹《红楼梦》第七回"},"usage":"作谓语、定语；用于口语"},{"id":37593,"word":"胡拉乱扯","pinyin":"hú lā luàn chě","abbr":"hllc","explanation":"指胡扯瞎说。","source":{"text":"我虽然不幸吃了这碗饭，然而始终只有一个客，自问和那胡拉乱扯的还不同。","book":"清·吴趼人《二十年目睹之怪现状》第58回"},"example":{"text":"请不要在这儿～了，我们得讲究办事效率。"},"similar":["胡枝扯叶","东拉西扯"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":37594,"word":"胡搅蛮缠","pinyin":"hú jiǎo mán chán","abbr":"hjmc","explanation":"蛮：粗野。不讲道理，纠缠不放。","source":{"text":"我两个是惯弄障眼法儿的，你们快去投别人做师父，莫在此胡缠乱搅。","book":"明·杨尔曾《韩湘子全集》第二十八回"},"example":{"text":"我说的正经话，你不听，～的说了这些闲篇儿，谁来听你。","book":"清·邵振华《侠义佳人》第一回"},"similar":["蛮横无理"],"opposite":["有理有据"],"usage":"作谓语、定语、状语；指不讲道理，纠缠不放"},{"id":37595,"word":"胡支扯叶","pinyin":"hú zhī chě yè","abbr":"hzcy","explanation":"东拉西扯，不着边际。同“胡枝扯叶”。"},{"id":37596,"word":"胡服骑射","pinyin":"hú fú qí shè","abbr":"hfqs","explanation":"胡：古代指北方和西文的少数民族。指学习胡人的短打服饰，同时也学习他们的骑马、射箭等武艺。","source":{"text":"今吾（赵武灵王）将胡服骑射以教百姓。","book":"《战国策·赵策二》"},"usage":"作宾语、定语；用于书面语"},{"id":37597,"word":"胡枝扯叶","pinyin":"hú zhī chě yè","abbr":"hzcy","explanation":"指东拉西扯，不着边际。","source":{"text":"瓶儿道：‘你这老货偏有这些胡枝扯叶的。你明日不来，我和你答话。’","book":"《金瓶梅词话》第三七回"},"example":{"text":"聘娘道：‘我不知怎的，心里慌慌的，合着眼就做出许多～的梦，清天白日的还有些害怕。’","book":"《儒林外史》第五四回"},"similar":["东拉西扯","胡言乱语"],"opposite":["有的放矢"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":37598,"word":"胡歌野调","pinyin":"hú gē yě diào","abbr":"hgyd","explanation":"指不正经的下流歌曲小调。","source":{"text":"坐在门首，胡歌野调，夜晚打砖，百般欺负。","book":"明·兰陵笑笑生《金瓶梅词话》第三十四回"},"usage":"作宾语、定语；用于书面语"},{"id":37599,"word":"胡猜乱想","pinyin":"hú cāi luàn xiǎng","abbr":"hclx","explanation":"胡乱地猜想。指对没有把握的事情乱加猜测。","source":{"text":"胡猜乱想，惊疑不定。","book":"明·冯梦龙《醒世恒言》卷四"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第17卷：“弄得魏撰之满肚疑心，～。”"},"similar":["胡思乱想"],"usage":"作谓语、宾语、定语；指瞎猜疑"},{"id":37600,"word":"胡猜乱道","pinyin":"hú cāi luàn dào","abbr":"hcld","explanation":"喜事从天上掉下来。比喻突然遇到意想不到的喜事。","source":{"text":"贵脚踏践地，使下官喜从天降。","book":"元·马致远《青衫泪》第三折"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"usage":"作谓语、宾语、定语；指瞎猜疑"},{"id":37601,"word":"胡编乱造","pinyin":"hú biān luàn zào","abbr":"hblz","explanation":"没有根据、不合情理地胡乱编造。","source":{"text":"在看一部通俗得只能说是胡编乱造的故事片时，杜梅索性呜呜咽咽地哭出声来。","book":"王朔《过把瘾就死》"},"example":{"text":"他～出这些事来。"},"similar":["胡编滥造"],"usage":"作谓语、宾语；指没有根据、不合情理的话"},{"id":37602,"word":"胡肥钟瘦","pinyin":"hú féi zhōng shòu","abbr":"hfzs","explanation":"胡：三国时的胡昭；钟：三国时的钟繇。胡昭的字体肥，钟繇的字体瘦。形容书法各擅其美。","source":{"text":"三国魏刘德升字君嗣，以造行书擅名，胡昭、钟繇并师其法，而胡书体肥，钟书体瘦，亦各有君嗣之美。","book":"唐·张彦远《法书要录》"}},{"id":37603,"word":"胡肥锺瘦","pinyin":"hú féi zhōng shòu","abbr":"hfzs","explanation":"胡：三国时的胡昭；锺：三国时的锺繇。胡昭的字体肥，锺繇的字体瘦。形容书法各擅其美。","source":{"text":"三国魏刘德升字君嗣，以造行书擅名，胡昭、锺繇并师其法，而胡书体肥，锺书体瘦，亦各有君嗣之美。","book":"唐·张彦远《法书要录》"},"usage":"作宾语、定语；形容书法各有其美","story":["三国时期，魏国大书法家刘德升以擅长行书而闻名。胡昭和钟鹞同时拜他为师学习书法，经过一段时间的练习，他们从不同的方面发展了刘氏行书的特长，胡昭的字体肥，锺繇的字体瘦，这是分辨他们行书的特征"]},{"id":37604,"word":"胡行乱为","pinyin":"hú xíng luàn wéi","abbr":"hxlw","explanation":"犹胡作非为。不顾法纪或舆论，毫无顾忌地做坏事。","source":{"text":"既我是这个国的国民，怎么可以不管国家的好歹，任那皇帝官府胡行乱为呢？","book":"清·陈天华《警世钟》"},"example":{"text":"那些武人官僚都是大清帝国留下来的……他们有了兵，便～。","book":"孙中山《革命最后一定成功》"},"similar":["胡作非为","胡作胡为","胡作乱为"],"opposite":["安分守己"],"usage":"作谓语、定语、状语；指任意做坏事"},{"id":37605,"word":"胡行乱闹","pinyin":"hú xíng luàn nào","abbr":"hxln","explanation":"指胡乱行动和嬉戏。","source":{"text":"从此养好了，可要安分守己，别再胡行乱闹了。","book":"清·曹雪芹《红楼梦》第七十二回"}},{"id":37606,"word":"胡言乱语","pinyin":"hú yán luàn yǔ","abbr":"hyly","explanation":"指没有根据，不符实际的瞎说，或说胡话。","source":{"text":"这二老汉，各人好与三十棒。何故？一个说长说短，一个胡言乱语。虽然如是，且放过一著。","book":"宋·释普济《五灯会元》卷十六"},"example":{"text":"你则管哩便～，将我厮花白。","book":"元·无名氏《渔樵记》第二折"},"similar":["胡说八道","无中生有"],"opposite":["有凭有据","有条不紊"],"usage":"作主语、谓语、宾语；形容说话没根据"},{"id":37607,"word":"胡言乱道","pinyin":"hú yán luàn dào","abbr":"hyld","explanation":"犹胡言乱语。指没有根据，不符实际的瞎说，或说胡话。","source":{"text":"俺孩儿听了他胡言乱道巧差排，便待离家乡做些买卖。","book":"元·张国宾《合汗衫》第三折"},"example":{"text":"这妮子～，该打嘴了。","book":"清·孔尚任《桃花扇·骂筵》"},"similar":["胡说八道","胡言乱语"],"usage":"作定语、谓语、宾语；形容说话没根据"},{"id":37608,"word":"胡言汉语","pinyin":"hú yán hàn yǔ","abbr":"hyhy","explanation":"犹言胡言乱语。指没有根据，不符实际的瞎说，或说胡话。","source":{"text":"这二老汉，各人好与三十棒。何故？一个说长说短，一个胡言汉语。","book":"《五灯会元·智海逸禅师法嗣·黄檗志因禅师》"},"example":{"text":"休听这弟子孩儿～的。","book":"元·无名氏《村乐堂》第二折"},"similar":["胡言乱语","胡言乱道"],"opposite":["有的放矢","有凭有据"],"usage":"作主语、谓语、宾语；形容说话没根据"},{"id":37609,"word":"胡诌乱傍","pinyin":"hú zhōu luàn bàng","abbr":"hzlb","explanation":"吹牛，信口开河。","source":{"text":"那寡妇在屋里也听见了，开始以为孔驰仁胡诌乱傍，而且也听不十分懂，后来越听越觉着并非单纯虚张声势，于是也慌了神。","book":"古立高《隆冬》"},"example":{"text":"你不要相信他的～。"},"similar":["信口开河"],"usage":"作谓语、宾语；指吹牛"},{"id":37610,"word":"胡诌乱扯","pinyin":"hú zhōu luàn chě","abbr":"hzlc","explanation":"指胡扯瞎说。","example":{"text":"她最爱在人前～了。"},"similar":["胡拉乱扯","胡诌乱说"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":37611,"word":"胡诌乱说","pinyin":"hú zhōu luàn shuō","abbr":"hzls","explanation":"胡诌，随意胡说。","source":{"text":"则你休听他这酒魔的汉呵，一谜里便胡诌乱说。","book":"元·杨文奎《儿女团圆》第三折"},"similar":["胡诌乱道","胡言乱语","信口开河"],"usage":"作谓语、宾语、定语；用于说话等"},{"id":37612,"word":"胡诌乱道","pinyin":"hú zhōu luàn dào","abbr":"hzld","explanation":"胡诌，随意胡说。","source":{"text":"虽懂得几句诗词也是胡诌乱道的。就是好了，也不过是风云月露，与一生的正事毫无关涉。","book":"清·曹雪芹《红楼梦》第八十一回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第九回：“这种～的，有甚么好处呢？”"},"similar":["胡诌乱傍","胡说八道"],"usage":"作谓语、宾语；指吹牛"},{"id":37613,"word":"胡诌八扯","pinyin":"hú zhōu bā chě","abbr":"hzbc","explanation":"指胡扯瞎说。"},{"id":37614,"word":"胡说乱道","pinyin":"hú shuō luàn dào","abbr":"hsld","explanation":"乱编瞎说，胡说八道。","source":{"text":"我待不言语来，忍不得你这般胡说乱道。","book":"元·郑光祖《刍梅香》第四折"},"example":{"text":"这样的～，天下难道还有真是非么？","book":"郁达夫《采石矶》"},"similar":["胡说八道"],"opposite":["言之有据"],"usage":"作谓语、宾语；同“胡说八道”"},{"id":37615,"word":"胡说八道","pinyin":"hú shuō bā dào","abbr":"hsbd","explanation":"没有根据或没有道理地瞎说。","source":{"text":"祕魔岩主擎个义儿，胡说乱道，遂将一掴成齑粉，散在十方世界。","book":"宋·释普济《五灯会元·龙门远禅师法嗣》"},"example":{"text":"为了造语惊人，对仗工稳起见，有些文豪们简直不恤～的。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["胡言乱语","信口开河","胡说乱道"],"opposite":["有凭有据","言之有据"],"usage":"作谓语、宾语、定语；形容说话没根据"},{"id":37616,"word":"胡说白道","pinyin":"hú shuō bái dào","abbr":"hsbd","explanation":"犹言胡说八道。没有根据或没有道理地瞎说。","source":{"text":"单管只胡说白道的。","book":"《金瓶梅词话》第二七回"},"example":{"text":"谁知半夜里一叠连声的嚷起心疼来，嘴里～，只说好像刀子割了去的似的。","book":"《红楼梦》第八三回"},"similar":["胡说八道","胡说乱道"],"usage":"作谓语、宾语、定语；形容说话没根据"},{"id":37617,"word":"胡走游飞","pinyin":"hú zǒu yóu fēi","abbr":"hzyf","explanation":"漫无目的，四处游荡。","example":{"text":"他们不务正业，整天～地到处游荡。"},"usage":"作谓语、定语、状语；用于方言"},{"id":37618,"word":"胡越一家","pinyin":"hú yuè yī jiā","abbr":"hyyj","explanation":"比喻居地远隔者聚集一堂。犹言四海一家。","source":{"text":"上皇命突厥颉利可汗起舞，又命南蛮酋长冯智戴咏诗，既而笑曰：‘胡越一家，自古未有也。’","book":"《资治通鉴·唐太宗贞观七年》"},"example":{"text":"清·褚人获《隋唐演义》第68回：“冯智戴咏诗，既而笑道：‘～，古未有也！’”"},"usage":"作宾语、定语；用于口语"},{"id":37619,"word":"胡越之祸","pinyin":"hú yuè zhī huò","abbr":"hyzh","explanation":"古代中原的胡国和越国之间经常发生战事，因此用“胡越之祸”来比喻战祸。","source":{"text":"是胡越起于毂下，而羌夷接轸也，岂不殆哉。","book":"《史记·司马相如列传》"},"usage":"作宾语；比喻战祸"},{"id":37620,"word":"胡越同舟","pinyin":"hú yuè tóng zhōu","abbr":"hytz","explanation":"犹言吴越同舟。指关系疏远者，同处危难则相互救助。","source":{"text":"故曰同舟而遇风，则胡越可使相救如左右手。","book":"语出宋·苏轼《大臣论下》"},"example":{"text":"双方务念兄弟急难之情，感～之谊，屏除意气，宏济艰屯。","book":"《“五四”爱国运动资料·陈光远〈请力争青岛电〉》"},"similar":["吴越同舟"],"usage":"作宾语、定语；指共患难"},{"id":37621,"word":"胡里胡涂","pinyin":"hú lǐ hú tú","abbr":"hlht","explanation":"形容不明事理或对事物的认识模糊。","source":{"text":"不过对于误服这药的病人，却能够使他不再寻求良药，拖重了病症而至于胡里胡涂的死亡。","book":"鲁迅《伪自由书·新药》"},"example":{"text":"你看你那眼直瞪瞪的，喝得～的样子！","book":"曹禺《日出》第一幕"},"similar":["糊里糊涂","迷迷糊糊"],"opposite":["一清二楚"],"usage":"作定语；指人的头脑或印象"},{"id":37622,"word":"胡颜之厚","pinyin":"hú yán zhī hòu","abbr":"hyzh","explanation":"胡颜：有何面目。指厚着脸皮做某事。古时多用作自谦之辞。","source":{"text":"今宸极反正，惟新告始，宪章既明，品物思旧，臣亦胡颜之厚，可以显居荣次。","book":"晋·殷仲文《解尚书表》"}},{"id":37623,"word":"胡马依风","pinyin":"hú mǎ yī fēng","abbr":"hmyf","explanation":"胡马：北方所产的马，即胡地之马；依：依恋。北方所产的马留恋着北方的风。比喻不忘故土或不忘本。","source":{"text":"胡马依北风，越鸟巢南枝。","book":"《古诗十九首·行行重行行》"}},{"id":37624,"word":"胫大于股","pinyin":"jìng dà yú gǔ","abbr":"jdyg","explanation":"犹言本小末大。旧时喻臣下的力量大于君上。","example":{"text":"请不要干这种～的事。"},"usage":"作宾语、定语；用于比喻句"},{"id":37625,"word":"胫大于股者难以步","pinyin":"jìng dà yú gǔ zhě nán yǐ bù","abbr":"jdygznyb","explanation":"胫：小腿；股：大腿；步：行走。小腿比大腿大则无法稳健地走路。比喻本末倒置则无法相互配合使用。","source":{"text":"胫大于股者难以步，指大于臂者难以把，本小末大，不能相使也。","book":"汉·处向《说苑·君道》"}},{"id":37626,"word":"胯下之辱","pinyin":"kuà xià zhī rǔ","abbr":"kxzr","explanation":"胯下：两条腿之间。从胯下爬过的耻辱。","source":{"text":"淮阴屠中少年有侮信者，曰：‘若虽长大，好带刀剑，中情怯耳。’众辱之曰：‘信能死，刺我，不能死，出我胯下。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"你听说过韩信的～吗？"},"similar":["胯下蒲伏"],"usage":"作宾语；指极大的侮辱","story":["秦朝末年，淮阴人韩信年轻时文质彬彬，十分斯文。屠中有一个恶少见韩信软弱可欺就纠集一帮人围攻他，让他求饶必须从恶少胯下钻过，韩信见寡不敌众就只好忍一时之气，从恶少胯下爬过。后来他成为一个大谋略家，帮助刘邦成就大业"]},{"id":37627,"word":"胯下蒲伏","pinyin":"kuà xià pú fú","abbr":"kxpf","explanation":"蒲伏：通“匍伏”，指伏地爬行。指汉朝韩信年少时有胯下之辱。","source":{"text":"将如韩信而有胯下蒲伏之辱。","book":"宋·秦观《人材》"},"similar":["胯下之辱"],"usage":"作宾语、定语；同“胯下之辱”","story":["秦朝末年，淮阴人韩信年轻时文质彬彬，十分斯文。屠中有一个恶少见韩信软弱可欺就纠集一帮人围攻他，让他求饶必须从恶少胯下钻过，韩信见寡不敌众就只好忍一时之气，从恶少胯下爬过。后来他成为一个大谋略家，帮助刘邦成就大业"]},{"id":37628,"word":"胶柱调瑟","pinyin":"jiāo zhù tiáo sè","abbr":"jzts","explanation":"瑟：古代一种弹拨乐器。用胶粘住瑟上用以调音的短木，不能再调整音的高低缓急。比喻拘泥死板，缺少变通。","source":{"text":"执一世之法籍，以非传代之俗，譬犹胶柱调瑟。","book":"《文子·道德》"},"example":{"text":"举一反三，岂其若是，～，不亦谬欤？","book":"唐·刘知畿《史通·断限》"},"similar":["胶柱鼓瑟"],"usage":"作宾语、定语；指人死板"},{"id":37629,"word":"胶柱鼓瑟","pinyin":"jiāo zhù gǔ sè","abbr":"jzgs","explanation":"用胶把柱粘住以后奏琴，柱不能移动，就无法调弦。比喻固执拘泥，不知变通。","source":{"text":"王以名使括，若胶柱而鼓瑟耳。括徒能读其父书传，不知合变也。","book":"《史记·廉颇蔺相如列传》"},"example":{"text":"若非公孙杵臼，焉得赵氏孤儿，既以遇难避仇，不必～。","book":"明·无名氏《鸣凤记·桑林奇遇》"},"similar":["胶柱调瑟","刻舟求剑"],"opposite":["随机应变","通达权变"],"usage":"作谓语、定语、宾语；比喻固执拘泥"},{"id":37630,"word":"胶漆之分","pinyin":"jiāo qī zhī fèn","abbr":"jqzf","explanation":"胶漆：胶和漆，比喻亲密。比喻亲密无间，情投意合的情谊。","source":{"text":"又膳部房与公同声尘之游，定胶漆之分。","book":"唐·白居易《祭崔常侍文》"}},{"id":37631,"word":"胶漆相投","pinyin":"jiāo qī xiāng tóu","abbr":"jqxt","explanation":"胶漆：胶和漆，比喻亲密；投：投合。形容朋友之间亲密投合。","source":{"text":"以胶投漆中，谁能别离此。","book":"《史记·鲁仲连邹阳列传》：“感于心，合于行，亲于胶漆，昆弟不能离，岂惑于众口哉。”《古诗十九首·孟冬寒气至》"},"example":{"text":"～，陈重之与雷义。","book":"清·程允升《幼学琼林·朋友宾主》"}},{"id":37632,"word":"胶胶扰扰","pinyin":"jiǎo jiǎo rǎo rǎo","abbr":"jjrr","explanation":"胶胶：动乱的样子；扰扰：纷乱的样子。纷扰、动乱，难以安宁。","source":{"text":"尧曰：‘胶胶扰扰乎？’","book":"《庄子·天道》"},"example":{"text":"机械相乘，得失倚伏，～，将伊于胡底乎？","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"}},{"id":37633,"word":"胶鬲之困","pinyin":"jiāo gé zhī kùn","abbr":"jgzk","explanation":"胶鬲，商周时人，纣时因遭世乱，曾隐遁为商。后以之指士人不在位而处于困难之境。","source":{"text":"胶鬲举于鱼盐之中。","book":"《孟子·告子下》"},"example":{"text":"元和丙申岁秋八月，余以～，寓居精舍。","book":"唐·元杰《浈阳果寺开东岭洞谷铭序》"},"usage":"作宾语；用于人处在困境时"},{"id":37634,"word":"胸中万卷","pinyin":"xiōng zhōng wàn juàn","abbr":"xzwj","explanation":"指读过大量的书。","source":{"text":"问个里，待怎么销杀，胸中万卷。","book":"宋·辛弃疾《声声慢·送上饶黄倅职满赴调》词"},"similar":["学富五车"],"usage":"作谓语、定语；用于书面语"},{"id":37635,"word":"胸中丘壑","pinyin":"xiōng zhōng qiū hè","abbr":"xzqh","explanation":"丘：山丘；壑：山沟。指绘画、作文时，心中已把握到了深远的意境。也比喻对事物的判断处置自有高下。","source":{"text":"胸中元自有丘壑，盏里何妨对圣贤。","book":"唐·厉霆《大有诗堂》"},"example":{"text":"想～，山中风月，亭台几所，花木千栽。","book":"宋·戴复古《沁园春》词"},"similar":["胸有邱壑"],"usage":"作谓语、定语；用于书面语"},{"id":37636,"word":"胸中之颖","pinyin":"xiōng zhōng zhī yǐng","abbr":"xzzy","explanation":"颖：聪明。心中的聪明才智","source":{"text":"博学览古今，计胸中之颖，出谥十万。","book":"汉·王充《论衡·程材》"},"usage":"作宾语；用于书面语"},{"id":37637,"word":"胸中块垒","pinyin":"xiōng zhōng kuài lěi","abbr":"xzkl","explanation":"块垒：积砌成堆的土块。比喻心中郁积的不平之气。","source":{"text":"阮籍胸中垒块，故须酒浇之。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"算是借他人杯酒浇自己～，朗读的调子很好听，就像是歌唱一样。","book":"姚雪垠《李自成》第一卷第二十六章"}},{"id":37638,"word":"胸中垒块","pinyin":"xiōng zhōng lěi kuài","abbr":"xzlk","explanation":"垒块：积砌成堆的土块。比喻心中郁积的不平之气。","source":{"text":"阮籍胸中垒块，故须酒浇之。","book":"南朝·宋·刘义庆《世说新语·任诞》"},"example":{"text":"自信～甚，开尊恨不泻江湖。","book":"明·袁宏道《上已日柬惟长》"},"similar":["胸中磊块"],"usage":"作谓语、定语；用于书面语"},{"id":37639,"word":"胸中怀刀","pinyin":"xiōng zhōng huái dāo","abbr":"xzhd","explanation":"形容存心险恶。"},{"id":37640,"word":"胸中无墨","pinyin":"xiōng zhōng wú mò","abbr":"xzwm","explanation":"胸中没有墨水。比喻人没有学问，文化水平低。","source":{"text":"俚俗谓不能文者为胸中无墨，盖亦有据。通典载，北齐策秀才书，有滥劣者，饮墨水一升。东坡监试呈诗试官云：麻衣职再著，墨水真可饮。","book":"宋·吴子良《林下偶谈》"},"example":{"text":"～，何妨藏拙。奈何冒名延誉，自取祸戾？","book":"蔡东藩《明史演义》第七十九回"},"similar":["胸无点墨"],"usage":"作谓语、定语；用于书面语"},{"id":37641,"word":"胸中无数","pinyin":"xiōng zhōng wú shù","abbr":"xzws","explanation":"指对情况了解不清楚，心里没有底。","source":{"text":"一切都是胸中无‘数’，结果就不能不犯错误。","book":"毛泽东《党委会的工作方法》"},"example":{"text":"～是办不好事情的。"},"similar":["心中无数"],"opposite":["心中有数","胸中有数"],"usage":"作主语、谓语、定语；指心里没有底"},{"id":37642,"word":"胸中有数","pinyin":"xiōng zhōng yǒu shù","abbr":"xzys","explanation":"指对情况有清楚的了解，心里有底。","source":{"text":"胸中有‘数’。这是说，对情况和问题一定要主意到它们的数量方面，要有基本的数量的分析。","book":"毛泽东《党委会的工作方法》"},"example":{"text":"别看他平时少言寡语的，可是～。"},"similar":["心中有数"],"opposite":["心中无数"],"usage":"作谓语、宾语、定语；指心里有底"},{"id":37643,"word":"胸中柴棘","pinyin":"xiōng zhōng chái jí","abbr":"xzcj","explanation":"比喻居心险恶。","source":{"text":"人谓庾元规名士，胸中柴棘三斗许。","book":"南朝·宋·刘义庆《世说新语·轻诋》"},"usage":"作谓语、定语；用于比喻句"},{"id":37644,"word":"胸中正，眸子瞭","pinyin":"xiōng zhōng zhèng，móu zǐ liáo","abbr":"xzzmzl","explanation":"为人正直，眼睛就明亮。","source":{"text":"存乎人者，莫良于眸子，眸子不能掩其恶。胸中正，则眸子瞭焉；胸中不正，则眸子眊焉。","book":"《孟子·离娄上》"},"example":{"text":"再龌龊的事，只能心里想，脸上不但要庄重肃穆，所谓“～”。","book":"二月河《乾隆皇帝》五"},"usage":"作谓语、定语；用于书面语"},{"id":37645,"word":"胸中甲兵","pinyin":"xiōng zhōng jiǎ bīng","abbr":"xzjb","explanation":"甲兵：披甲的士兵。比喻人具有军事才能。","source":{"text":"汝曹视此人尪纤懦弱，手不能弯弓持矛，其胸中所怀乃逾于甲兵。","book":"《魏书·崔浩传》"},"similar":["胸有甲兵"],"usage":"作谓语、定语；指人具有军事才能"},{"id":37646,"word":"胸中百万兵","pinyin":"xiōng zhōng bǎi wàn bīng","abbr":"xzbwb","explanation":"胸中装有百万军队。比喻人具有军事才能。","source":{"text":"法曹静如不能鸣，胸中自有百万兵。","book":"宋·唐庚《会饮尉厅效八仙体》"},"example":{"text":"凭着你灭寇功，举将能，两般儿功效如红定。为甚俺莺娘心下十分顺，都则为君瑞～。","book":"元·王实甫《西厢记》第二本第三折"},"usage":"作谓语、定语；用于比喻句"},{"id":37647,"word":"胸中磊块","pinyin":"xiōng zhōng lěi kuài","abbr":"xzlk","explanation":"指心中郁积的不平之气","source":{"text":"自信胸中磊块甚，开尊恨不泻江湖。","book":"明·袁宏道《上巳日柬惟长》"},"similar":["胸中垒块"],"usage":"作谓语、定语；用于书面语"},{"id":37648,"word":"胸中鳞甲","pinyin":"xiōng zhōng lín jiǎ","abbr":"xzlj","explanation":"比喻存心险恶。","source":{"text":"诸葛亮与长史蒋琬、侍中董允书曰：‘孝起前临至吴，为吾说正方腹中有鳞甲，乡党以为不可近。’","book":"《三国志·蜀志·陈震传》"},"similar":["胸有鳞甲"],"usage":"作谓语、定语；用于坏人"},{"id":37649,"word":"胸喘肤汗","pinyin":"xiōng chuǎn fū hàn","abbr":"xcfh","explanation":"形容疲乏到极点。","source":{"text":"胸喘肤汗，人极马倦。","book":"《汉书·王褒传》"},"usage":"作谓语、状语、定语；用于疲劳时"},{"id":37650,"word":"胸怀坦白","pinyin":"xiōng huái tǎn bái","abbr":"xhtb","explanation":"坦白：坦率。形容心地纯洁，光明正大。","source":{"text":"要自己抱有高度的革命热情和对党负责的精神，才会胸怀坦白，才会有‘脱裤子’的精神。","book":"邓小平《在北方局党校整风动员会上的讲话》"},"example":{"text":"王朔《枉然不供》：“～，问心无愧，夜道遇鬼胆气壮，半夜敲门心不惊。”"},"similar":["襟怀坦白"],"usage":"作谓语、宾语、定语；形容心地纯洁"},{"id":37651,"word":"胸怀大志","pinyin":"xiōng huái dà zhì","abbr":"xhdz","explanation":"怀：怀藏。胸有远大志向。","source":{"text":"夫英雄者，胸怀大志，腹有良谋，有包藏宇宙之机，吞吐天地之志者也。","book":"明·罗贯中《三国演义》第21回"},"example":{"text":"年轻人要～，报效祖国。"},"opposite":["胸无大志"],"usage":"作谓语、宾语；指胸中有远大志向"},{"id":37652,"word":"胸怀磊落","pinyin":"xiōng huái lěi luò","abbr":"xhll","explanation":"心地光明正大。","example":{"text":"他～，从不怕人恶意中伤。"},"usage":"作谓语、定语；用于书面语"},{"id":37653,"word":"胸怀祖国，放眼世界","pinyin":"xiōng huái zǔ guó，fàng yǎn shì jiè","abbr":"xhzgfysj","explanation":"怀：怀藏。胸中怀藏祖国，眼光要放远到全世界","source":{"text":"上海人过于讲实惠，讲自家的事，而北京人确实胸怀祖国，放眼世界。","book":"张双林《解读北京人》"},"usage":"作谓语、定语；用于书面语"},{"id":37654,"word":"胸无城府","pinyin":"xiōng wú chéng fǔ","abbr":"xwcf","explanation":"城府：城市和官署，比喻难于揣测的深远用心。形容待人接物坦率真诚，心口如一。","source":{"text":"尧俞厚重言寡，遇人不设城府，人自不忍欺。","book":"《宋史·傅尧俞传》"},"example":{"text":"原来陈雨堂是一个～的人，心口率直，惟有一样脾气，欢喜学人家的谈风。","book":"清·吴趼人《近十年之怪现状》第十二回"},"similar":["胸无宿物","心口不一","光明磊落"],"opposite":["心怀叵测","居心不良","笑里藏刀"],"usage":"作谓语、定语；指全无心机"},{"id":37655,"word":"胸无大志","pinyin":"xiōng wú dà zhì","abbr":"xwdz","explanation":"心里没有远大志向。","source":{"text":"至于回、革等人，实系凡庸之辈，胸无大志，三年来观望风色，动摇不前。","book":"姚雪垠《李自成》第二卷第36章"},"example":{"text":"～的人必会有近忧的。"},"opposite":["胸怀大志"],"usage":"作谓语、定语；指胸中没有远大志向"},{"id":37656,"word":"胸无宿物","pinyin":"xiōng wú sù wù","abbr":"xwsw","explanation":"宿：过夜。胸中没有过夜的东西。比喻心地坦率，没有成见。","source":{"text":"庾赤玉胸中无宿物。","book":"南朝宋·刘义庆《世说新语·赏誉》"},"example":{"text":"毕为人坦直，～，微泄之。","book":"清·蒲松龄《聊斋志异·狐梦》"},"usage":"作谓语、定语；指没有成见"},{"id":37657,"word":"胸无成竹","pinyin":"xiōng wú chéng zhú","abbr":"xwcz","explanation":"指心中没有完整的谋划打算。","source":{"text":"文与可画竹，胸有成竹。郑板桥画竹，胸无成竹。","book":"清·郑燮《板桥题画·竹·胸无成竹》"},"example":{"text":"小说写作应胸有成竹，散文随笔当～。","book":"冯骥才《胸无成竹的快乐》"},"similar":["胸无成算"],"opposite":["胸有成竹","成竹在胸"],"usage":"作谓语、定语；用于书面语"},{"id":37658,"word":"胸无成算","pinyin":"xiōng wú chéng suàn","abbr":"xwcs","explanation":"心中没有完整的谋划打算","source":{"text":"莫要胸无成算，孟浪而行，那时临时局促，倒被那厮行凶，反为不美。","book":"清·吴璿《飞龙全传》第七回"},"similar":["胸无成竹"],"opposite":["胸有成竹","成竹在胸"],"usage":"作谓语、定语；用于书面语"},{"id":37659,"word":"胸无点墨","pinyin":"xiōng wú diǎn mò","abbr":"xwdm","explanation":"肚子里没有一点墨水。指人没有文化。","source":{"text":"某家本殷实，父母以独子故，甚爱之，读书十年，胸无点墨。","book":"清·淮阴百一居士《壶天录》卷上"},"example":{"text":"你别看他每天滔滔不绝的，实际是个～的人。"},"similar":["目不识丁","不学无术","空空如也"],"opposite":["满腹经纶","博学多才","博古通今"],"usage":"作谓语、宾语、定语；指人没有文化"},{"id":37660,"word":"胸有丘壑","pinyin":"xiōng yǒu qiū hè","abbr":"xyqh","explanation":"丘：山丘；壑：山沟。指绘画、作文时，心中已把握到了深远的意境。也比喻对事物的判断处置自有高下。","source":{"text":"胸中元自有丘壑，盏里何妨对圣贤。","book":"唐·厉霆《大有诗堂》"},"example":{"text":"毕竟戴大理～，听了此言，恍然大悟。","book":"清·李宝嘉《官场现形记》第十一回"},"similar":["胸有邱壑"],"usage":"作谓语、定语；用于处事"},{"id":37661,"word":"胸有城府","pinyin":"xiōng yǒu chéng fǔ","abbr":"xycf","explanation":"形容心机深沉，毫不外露，难于窥测。","source":{"text":"林甫性沉密，城府深阻，未尝以爱憎见于容色。","book":"《旧唐书·李林甫传》"},"example":{"text":"冯超～地一扬手，制止单易之。","book":"张天民《创业》第二章"},"similar":["城府深阻","城府深密"],"opposite":["胸无城府","襟怀坦白","开诚布公"],"usage":"作谓语、定语、补语；形容心机深沉"},{"id":37662,"word":"胸有悬镜","pinyin":"xiōng yǒu xuán jìng","abbr":"xyxj","explanation":"指能洞察一切，犹如明镜在胸。","source":{"text":"运行人员互相对视了一眼，由衷信服地点着头，这位局长胸有悬镜，明察秋毫。","book":"《收获》1981年第1期"},"usage":"作谓语、定语；用于书面语"},{"id":37663,"word":"胸有成略","pinyin":"xiōng yǒu chéng lüè","abbr":"xycl","explanation":"指胸有已成的策略。","source":{"text":"江都天人之学，长沙治安之书，摩切已深，胸有成略，足以应当世之所求。","book":"清·周亮工《黄母周宜人七轶序》"},"similar":["胸有成算"],"usage":"作谓语、定语；用于书面语"},{"id":37664,"word":"胸有成竹","pinyin":"xiōng yǒu chéng zhú","abbr":"xycz","explanation":"原指画竹子要在心里有一幅竹子的形象。后比喻在做事之前已经拿定主意。","source":{"text":"故画竹，必先得成竹于胸中。","book":"宋·苏轼《文与可画筼筜谷偃竹记》"},"example":{"text":"毛委员～，决定马上向南去追赶部队。","book":"陈伯钧《毛主席率领我们上井岗山》"},"similar":["成竹在胸","心中有数"],"opposite":["心中无数","茫无头绪"],"usage":"作谓语、定语、状语；同“成竹在胸”","story":["宋朝文人画家苏轼和文同都擅长画竹，苏轼习惯画墨竹，认为画竹必先成竹于胸中。文同在自家宅前种了很多竹子，每天观察竹子的成长变化，因此画出的竹子各具形态，栩栩如生。画家晁补之称赞文同画竹是“成竹已在胸”"]},{"id":37665,"word":"胸有成算","pinyin":"xiōng yǒu chéng suàn","abbr":"xycs","explanation":"犹言胸有成竹。比喻在做事之前已经拿定主意。","source":{"text":"各口进出货物盈虚，以及市价涨跌，庶胸有成算，不为租客所欺。","book":"郑观应《盛世危言·商务》"},"similar":["胸有成略"],"usage":"作谓语、定语；用于书面语"},{"id":37666,"word":"胸有甲兵","pinyin":"xiōng yǒu jiǎ bīng","abbr":"xyjb","explanation":"甲兵：铠甲和兵器，泛指武器。比喻胸中富有韬略。","source":{"text":"汝曹视此人尪纤懦弱，手不能弯弓持矛，其胸中所怀乃逾于甲兵。","book":"《魏书·崔浩传》"},"example":{"text":"才兼文武，惭非伊吕之俦；～，颇让孙吴之术。","book":"明·沈彩《千金记·遇仙》"},"similar":["胸中甲兵"],"usage":"作谓语、定语；用于书面语"},{"id":37667,"word":"胸有邱壑","pinyin":"xiōng yǒu qiū hè","abbr":"xyqh","explanation":"①指见多识广，心中记得许多山水胜状。②指胸怀远大，颇有见地。","source":{"text":"众人都道：‘极是。非胸中大有邱壑，焉能想到这里。","book":"清·曹雪芹《红楼梦》第17回"},"example":{"text":"清·李宝嘉《官场现形记》第11回：“毕竟戴大理～，听了此言，恍然大悟道：‘是了……’”"},"similar":["胸有丘壑"],"usage":"作谓语、定语；用于书面语"},{"id":37668,"word":"胸有鳞甲","pinyin":"xiōng yǒu lín jiǎ","abbr":"xylj","explanation":"比喻存心险恶。","source":{"text":"诸葛亮与长史蒋琬、侍中董允书曰：‘孝起前临至吴，为吾说正方腹中有鳞甲，乡党以为不可近。’","book":"《三国志·蜀志·陈震传》"}},{"id":37669,"word":"胸次丘壑","pinyin":"xiōng cì qiū hè","abbr":"xcqh","explanation":"丘：山丘；壑：山沟。指绘画、作文时，心中已把握到了深远的意境。也比喻对事物的判断处置自有高下。","source":{"text":"胸中元自有丘壑，盏里何妨对圣贤。","book":"唐·厉霆《大有诗堂》"},"example":{"text":"胸次有丘壑，笑谈无俗氛。","book":"宋·释惠洪《石门文字禅·赏趣堂》"}},{"id":37670,"word":"胸次开阔","pinyin":"xiōng cì kāi kuò","abbr":"xckk","explanation":"形容人胸襟宽广。","source":{"text":"便自胸次开阔，黑白分明。","book":"宋·朱熹《答吕子约》"}},{"id":37671,"word":"胸罗锦绣","pinyin":"xiōng luó jǐn xiù","abbr":"xljx","explanation":"比喻人富有文才或谋略。","source":{"text":"眉隐江山秀气，胸罗锦绣文章。惯识天文，也知地理，熟谙行藏。","book":"明·清溪道人《禅真逸史》第二十九回"},"example":{"text":"谈春秋～，讲礼制口吐珠玑。","book":"清·李汝珍《镜花缘》第五十二回"},"usage":"作谓语、定语；用于书面语"},{"id":37672,"word":"胼手胝足","pinyin":"pián shǒ zhī zú","abbr":"pszz","explanation":"胼、胝：老茧。手脚上磨出老茧。形容经常地辛勤劳动。","source":{"text":"耕耘树艺，手足胼胝以养其亲。","book":"《荀子·子道》"},"example":{"text":"侨胞的金钱不是容易得到的，是由于他们终年～，千辛万苦，省吃俭用，积蓄起来的。","book":"邹韬奋《抗战以来·热烈爱国的千万侨胞》"},"similar":["摩顶放踵","胼胝手足"],"usage":"作定语、状语；用于书面语"},{"id":37673,"word":"胼胝之劳","pinyin":"pián zhī zhī láo","abbr":"pzzl","explanation":"胼胝：皮肤等的异常变硬和增厚。形容极为辛苦。","source":{"text":"不惮胼胝之劳，不辞癯瘦之苦。","book":"《梁书·贺琛传》"},"example":{"text":"则军行万里无～，粮运千仓有瞬息之效，零星队伍可撤可并，浮滥饷乾或裁或节。","book":"《清史稿·交通志一》"},"usage":"作宾语；指辛劳"},{"id":37674,"word":"胼胝手足","pinyin":"pián zhī shǒu zú","abbr":"pzsz","explanation":"手脚上磨出老茧。形容经常地辛勤劳动。同“胼手胝足”。","source":{"text":"农民穷苦，胼胝手足以经营之，而终岁之勤，一粒无获。","book":"康有为《大同书》甲部第二章"},"similar":["手足胼胝","胼手胝足"],"usage":"作定语、状语；用于书面语"},{"id":37675,"word":"能上能下","pinyin":"néng shàng néng xià","abbr":"nsnx","explanation":"指干部不计较职位高低，不论处于领导岗位或在基层从事实际工作，都能踏踏实实地干。实行能上能下，是对干部职务终身制的一项重要改革。","source":{"text":"我提出干部能上能下，是不是可以试验一下，先从基层做起。","book":"邓小平《执政党的干部问题》"},"example":{"text":"我们要坚持干部～的用人机制"},"similar":["收放自如"],"usage":"作谓语、宾语、定语；指可以上下活动"},{"id":37676,"word":"能不两工","pinyin":"néng bù liǎng gōng","abbr":"nblg","explanation":"工：精通。即使有才能，也不能精通两种技术。","source":{"text":"天下再与，时不久留，能不两工，事在当之。","book":"战国·卫·吕不韦《吕氏春秋·首时》"},"example":{"text":"现今～的说法已经过时。"},"usage":"作谓语、宾语、定语；指人的专长等"},{"id":37677,"word":"能不称官","pinyin":"néng bù chèn guān","abbr":"nbcg","explanation":"才能跟职位不相称。","source":{"text":"德不称位，能不称官。","book":"《汉书·刑法志》"},"usage":"作谓语、定语；指不称职"},{"id":37678,"word":"能书不择笔","pinyin":"néng shū bù zé bǐ","abbr":"nsbzb","explanation":"写字好的人不计较笔的优劣。","source":{"text":"能书不择笔，此浪语也。古来唯称率吏不择笔。","book":"明·王肯堂《郁冈·斋笔》"}},{"id":37679,"word":"能争惯战","pinyin":"néng zhēng guàn zhàn","abbr":"nzgz","explanation":"形容作战经验丰富，善于作战。","source":{"text":"自通姓名，就叫累鬼，能争惯战，有万夫不当之勇。","book":"《平鬼传》第15回"},"similar":["能征惯战"],"usage":"作谓语、定语；指善于作战"},{"id":37680,"word":"能事毕矣","pinyin":"néng shì bì yǐ","abbr":"nsby","explanation":"能事：擅长的本领；毕：尽。原指天下之能事尽在《易经》之中。后指本领用尽了。","source":{"text":"引而伸之，触类而长之。天下之能事毕矣。","book":"《周易·系辞上》"},"example":{"text":"于是五亭相望，如指之列，可谓佳境殚矣，～。","book":"唐·白居易《冷泉亭记》"}},{"id":37681,"word":"能人巧匠","pinyin":"néng rén qiǎo jiàng","abbr":"nrqj","explanation":"能：技能，才能。指工艺技术高超的人。","source":{"text":"其实既是个细琢细磨的能人巧匠，也有着敢想敢干的猛烈劲儿。","book":"康濯《太阳初升的时候》"},"similar":["能工巧匠"],"usage":"作主语、宾语；指工艺技术高超的人"},{"id":37682,"word":"能伸能屈","pinyin":"néng shēn néng qū","abbr":"nsnq","explanation":"能弯曲也能伸直。指人在失意时能忍耐，在得志时能大干一番。比喻好坏环境都能适应。","source":{"text":"与时屈伸，柔从若蒲苇，非慑怯也；刚强猛毅，靡所不信，非骄暴也。以义变应，知当曲直故也。","book":"《荀子·不苟》"},"example":{"text":"这就叫大丈夫～。","book":"冯德英《苦菜花》第三章"},"similar":["能屈能伸"],"usage":"作谓语；指人的性格"},{"id":37683,"word":"能伸能缩","pinyin":"néng shēn néng suō","abbr":"nsns","explanation":"能够伸缩自如。","example":{"text":"这个装置设计得～，进退自如。"},"similar":["能上能下"],"usage":"作谓语、定语；指弹性大"},{"id":37684,"word":"能写会算","pinyin":"néng xiě huì suàn","abbr":"nxhs","explanation":"指有一定的文化水平。","source":{"text":"过去，村中无力上学，又有志读书的农民，冬闲时凑在一起，请一位能写会算的人，来教他们，就叫习字。","book":"孙犁《乡里旧闻（二）·刁叔》"},"example":{"text":"我看这样吧！既然你～，就留在我这里吧！我这缺少一个账房先生，如不嫌弃，就由你担任好了。","book":"单田芳《童林传》第一七二回"},"usage":"作谓语、定语；指人有文化"},{"id":37685,"word":"能刚能柔","pinyin":"néng gāng néng róu","abbr":"ngnr","explanation":"刚：刚强；柔：温和。指可以温和也可以强硬。","source":{"text":"窃谓夫为将者，能去能就，能柔能刚，能进能退，能弱能强。","book":"明·罗贯中《三国演义》第一百回"},"example":{"text":"以她的模样年纪来说，实在不易再得个这样的宝贝。～才是本，她得瀎泧他一把儿。","book":"老舍《骆驼祥子》十六"},"similar":["能柔能刚"],"usage":"作谓语、定语；指人的性格"},{"id":37686,"word":"能士匿谋","pinyin":"néng shì nì móu","abbr":"nsnm","explanation":"匿：藏匿。有才能者得不到重用就藏匿其计谋。","source":{"text":"故贤愚共贯，则能士匿谋。","book":"《孔丛子·对魏王》"},"usage":"作宾语、定语；指人才不能发挥"},{"id":37687,"word":"能屈能伸","pinyin":"néng qū néng shēn","abbr":"nqns","explanation":"能弯曲也能伸直。指人在失意时能忍耐，在得志时能大干一番。","source":{"text":"尺蠖之屈，以求信也；龙蛇之蛰，以存身也。","book":"《易·系辞下》"},"example":{"text":"《易·系辞下》：“尺蠖之屈，以求信也；龙蛇之蛰，以存身也。”"},"similar":["随遇而安","能伸能屈"],"opposite":["宁折不屈"],"usage":"作谓语、定语；形容人的性格"},{"id":37688,"word":"能工巧匠","pinyin":"néng gōng qiǎo jiàng","abbr":"ngqj","explanation":"指工艺技术高明的人。","source":{"text":"今洛阳良工巧匠，批红判白，接以它木，与造化争妙。","book":"宋·李格非《洛阳名园记·李氏仁丰园》"},"example":{"text":"这些由～手工织绣的彩锦，运销世界各地。"},"similar":["能人巧匠","良工巧匠"],"usage":"作主语、宾语；指工艺技术高超的人"},{"id":37689,"word":"能征惯战","pinyin":"néng zhēng guàn zhàn","abbr":"nzgz","explanation":"征：征伐。形容作战经验丰富，很能打仗。","source":{"text":"左哨三千番兵能征惯战，右哨三千番兵猛烈雄骁。","book":"元·关汉卿《哭存孝》第二折"},"example":{"text":"足智多谋之士，～之将，何止一二千人。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["久经沙场","惯战能征"],"usage":"作谓语、定语；指善于作战"},{"id":37690,"word":"能征敢战","pinyin":"néng zhēng gǎn zhàn","abbr":"nzgz","explanation":"征：征讨。形容作战经验丰富，敢于作战。","source":{"text":"必用能征敢战之将，先以力敌，后用智擒。","book":"明·施耐庵《水浒传》第55回"},"similar":["能征惯战"],"usage":"作谓语、定语；指善于作战"},{"id":37691,"word":"能忍自安","pinyin":"néng rěn zì ān","abbr":"nrza","explanation":"能够忍耐，心情自然平静。","example":{"text":"很快地对不愉快的，不甚愉快的，或者稀里糊涂的、勉强愉快的局面，～地适应。","book":"李国文《戒之惑》十七"}},{"id":37692,"word":"能掐会算","pinyin":"néng qiā huì suàn","abbr":"nqhs","explanation":"能用手指掐算。指有未卜先知的本事。","source":{"text":"大家都说老鼠能掐会算，老鼠算到有灾难，早就逃走了。","book":"吴运铎《把一切献给党·在矿井里》"},"example":{"text":"他～，能预见未来。"},"similar":["神机妙算"],"usage":"作谓语；指有未卜先知的本事"},{"id":37693,"word":"能文善武","pinyin":"néng wén shàn wǔ","abbr":"nwsw","explanation":"能：能够，信任。指人文武双全。","source":{"text":"凭着我能文善武才人敌，俺父亲将我来许。","book":"元·纪君祥《赵氏孤儿》第四折"},"example":{"text":"争羡道，～的小郎君。","book":"明·凌濛初《二刻拍案惊奇》第17卷"},"similar":["能文能武"],"opposite":["不文不武"],"usage":"作谓语、宾语；指人文武双全"},{"id":37694,"word":"能文能武","pinyin":"néng wén néng wǔ","abbr":"nwnw","explanation":"既有文才，又通武艺。现常指既能动笔又有实际工作能力。","source":{"text":"则为那善文能武人千里。","book":"元·王实甫《西厢记》第二本楔子"},"example":{"text":"如今知道朝里那些老爷们都是～，出力报效，所到之处，早已消灭了。","book":"清·曹雪芹《红楼梦》第一○七回"},"similar":["文武双全","能文善武"],"opposite":["不文不武"],"usage":"作谓语、宾语；指人文武双全","story":["贾母去世后，宝玉的病情有了好转，他从此刻苦读书，准备考举人。贾府遭了贼人抢劫，损失了不少财物，还把妙玉尼姑给掳了去。贾府上下议论纷纷，贾芸、贾蔷等与家人在谈论贼人的问题，他们相信朝廷的那些能文能武的老爷们会把他们消灭的"]},{"id":37695,"word":"能柔能刚","pinyin":"néng róu néng gāng","abbr":"nrng","explanation":"柔：温和；刚：刚强。指可以温和也可以强硬。","source":{"text":"窃谓夫为将者，能去能就，能柔能刚；能进能退，能弱能强。","book":"明·罗贯中《三国演义》第100回"},"example":{"text":"然有道者，固～，能弱能强。","book":"梁启超《王荆公传》第11章"},"similar":["能刚能柔"],"usage":"作谓语、定语；指人的性格"},{"id":37696,"word":"能歌善舞","pinyin":"néng gē shàn wǔ","abbr":"ngsw","explanation":"擅长歌舞。","source":{"text":"不论才人、美人、嫔妃、彩女，或有色有才，能歌善舞，稍有一技可见者，许报名到显仁宫自献。","book":"清·褚人获《隋唐演义》第29回"},"opposite":["一无所能"],"usage":"作谓语、定语、宾语；多用于女性"},{"id":37697,"word":"能牙利齿","pinyin":"néng yá lì chǐ","abbr":"nylc","explanation":"指能说会道，善于辞令。"},{"id":37698,"word":"能者为师","pinyin":"néng zhě wéi shī","abbr":"nzws","explanation":"会的人就当老师。即谁会就向谁学习。","source":{"text":"能博喻，然后能为师。","book":"《礼记·学记》"},"example":{"text":"老闻，你只管讲，～嘛。","book":"池莉《霍乱之乱》七"},"usage":"作宾语；指人谦虚"},{"id":37699,"word":"能者多劳","pinyin":"néng zhě duō láo","abbr":"nzdl","explanation":"能干的人做事多、劳累也多。","source":{"text":"巧者劳而知（智）者忧，无能者无所求，饱食而敖游。","book":"《庄子·列御寇》"},"example":{"text":"官厅子上，有些同寅见了面，都恭维他“～”。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["力所能及"],"usage":"作谓语、宾语；用于赞誉人"},{"id":37700,"word":"能舌利齿","pinyin":"néng shé lì chǐ","abbr":"nslc","explanation":"形容口才好，善于辩论。"},{"id":37701,"word":"能言会道","pinyin":"néng yán huì dào","abbr":"nyhd","explanation":"道：说，讲。形容口齿伶俐，很会说话。","source":{"text":"这位侄少爷算得能言会道。","book":"清·李宝嘉《官场现形记》第六回"},"similar":["能说会道","能言善道"],"opposite":["笨口拙舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":37702,"word":"能言善辩","pinyin":"néng yán shàn biàn","abbr":"nysb","explanation":"能：善于。形容能说会道，有辩才。","source":{"text":"恰才灵壁之战，项王遣使征布会，布与龙且有隙，称病不赴，若得能言巧辩之士，说他归降，纵项王驰还……破项王必矣。","book":"元·无名氏《气英布》第一折"},"example":{"text":"而且伶牙俐齿，～。","book":"清·李汝珍《镜花缘》第十八回"},"similar":["能说会道","能言快语"],"opposite":["笨口拙舌","拙嘴笨舌"],"usage":"作谓语、定语；指人善于言辩"},{"id":37703,"word":"能言善道","pinyin":"néng yán shàn dào","abbr":"nysd","explanation":"道：说，讲。形容口齿伶俐，很会说话。","source":{"text":"由于他绝顶聪明，善于识人，而且能言善道，手面大方，所以三年满师。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"他一向都～。"},"similar":["能言会道","能说善道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":37704,"word":"能言巧辩","pinyin":"néng yán qiǎo biàn","abbr":"nyqb","explanation":"形容能说会道，善于言辩。","source":{"text":"恰才灵壁之战，项王遣使征布会，布与龙且有隙，称病不赴，若得能言巧辩之士，说他归降，纵项王驰还……破项王必矣。","book":"元·无名氏《气英布》第一折"},"example":{"text":"蹰很薄，据俗见说，这是～的标记。","book":"叶圣陶《桥上》"},"similar":["能说会道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语、宾语；指善于言辩"},{"id":37705,"word":"能言快语","pinyin":"néng yán kuài yǔ","abbr":"nyky","explanation":"能说会道，言词敏捷爽利。","source":{"text":"太尉此去，下官手下有个虞候，能言快语，问一答十，好与太尉提拨事情。","book":"元·无名氏《刘弘嫁婢》第二折：“妾身做事实偻儸，娶女招夫我说合，亲筵喜事来寻我，能言快语做媒婆。”明·施耐庵《水浒传》第七十五回"},"example":{"text":"今日我苏轼枉了～，又向那处伸冤？岂不苦哉！","book":"明·冯梦龙《喻世明言》第三十卷"},"similar":["能言快说","能言善道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":37706,"word":"能言快说","pinyin":"néng yán kuài shuō","abbr":"nyks","explanation":"能说会道，言词敏捷爽利。同“能言快语”。","source":{"text":"原来这李师师是个风尘妓女，见了燕青这表人物，能言快说，口舌利便，倒有心看上他。","book":"明·施耐庵《水浒传》第八十一回"},"similar":["能言快语"],"usage":"作谓语、定语；形容人口才很好"},{"id":37707,"word":"能言舌辩","pinyin":"néng yán shé biàn","abbr":"nysb","explanation":"言：说，讲；辩：辩论。形容很会说话，善于辩论，口才好。","source":{"text":"圣人着小官传与李道宗，便着差能言舌辩，通晓沙漠人言说语，你可去说将这匹马来。","book":"明·黄元吉《流星马》第一折"},"example":{"text":"刚才小唐打发那三个，何等不容易，他还是～的呢。","book":"叶圣陶《金耳环》"},"similar":["能言善辩","能说会道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；指人善于言辩"},{"id":37708,"word":"能诗会赋","pinyin":"néng shī huì fù","abbr":"nshf","explanation":"赋：古文体。指善于写诗作赋。","source":{"text":"况家中现有几个能诗会赋的姊妹们，何不命他们进去居住。","book":"清·曹雪芹《红楼梦》第23回"},"usage":"作谓语、定语；指人的文学功底好"},{"id":37709,"word":"能说会道","pinyin":"néng shuō huì dào","abbr":"nshd","explanation":"形容很会讲话。","source":{"text":"仗着他的模样儿比别人标致些，又长了一张巧嘴，天天打扮的象个西施样子，在人跟前能说惯道，抓尖要强。","book":"清·曹雪芹《红楼梦》第七十四回"},"example":{"text":"这个人生就的两片巧嘴，巧嘴滑舌，～。","book":"曲波《林海雪原》二八"},"similar":["伶牙俐齿","能言善辩"],"opposite":["笨口拙舌","拙嘴笨舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":37710,"word":"能说善道","pinyin":"néng shuō shàn dào","abbr":"nssd","explanation":"道：说，讲。形容口齿伶俐，很会说话。","source":{"text":"他们都是能说善道的人。","book":"黄药眠《自纪篇》"},"similar":["能说会道"],"usage":"作谓语、定语；形容人口才很好"},{"id":37711,"word":"能说惯道","pinyin":"néng shuō guàn dào","abbr":"nsgd","explanation":"形容人口才好，很会讲话。","source":{"text":"但熟甜瓜软处偏捏，蜡枪头会道能说。","book":"明·无名氏《渔樵闲话》第三折"},"example":{"text":"天天打扮的象个西施样子，在人跟前～，抓尖要强。","book":"清·曹雪芹《红楼梦》第七十四回"},"similar":["能说会道","能言会道"],"opposite":["笨嘴拙舌"],"usage":"作谓语、定语；形容人口才很好"},{"id":37712,"word":"能谋善断","pinyin":"néng móu shàn duàn","abbr":"nmsd","explanation":"善：擅长；断：决断。形容人能不断思考，并善于判断。","source":{"text":"畴咨俊茂，好谋善断。","book":"晋·陆机《辨亡论》上"},"example":{"text":"允结吕布刺卓，复杀蔡邕，可谓～者矣。","book":"宋·李新《跨鳌集·王允论》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":37713,"word":"能近取譬","pinyin":"néng jìn qǔ pì","abbr":"njqp","explanation":"能就自身打比方。比喻能推己及人，替别人着想。","source":{"text":"能近取譬，可谓仁之方也已。","book":"《论语·雍也》"},"example":{"text":"独夫为我，即曰贪贼；～，即曰仁义。","book":"章炳麟《菌说》"},"similar":["推己及人"],"usage":"作谓语、定语；指推己及人"},{"id":37714,"word":"脂膏不润","pinyin":"zhī gāo bù rùn","abbr":"zgbr","explanation":"比喻为人廉洁，不贪财物。","source":{"text":"直脂膏中，亦不能自润。","book":"汉·刘珍《东观汉记·孔奋》"},"example":{"text":"条令和平，疏食敝衣，～。","book":"清·钱谦益《四川潼川州安岳县知县翟学程授文林郎制》"},"similar":["脂膏莫润"],"opposite":["贪污受贿"],"usage":"作谓语、定语；指人廉洁"},{"id":37715,"word":"脂膏莫润","pinyin":"zhī gāo mò rùn","abbr":"zgmr","explanation":"比喻为官廉以自守，不改清操。同“脂膏不润”。","source":{"text":"清白自守，脂膏莫润。","book":"《金石萃编·隋赵芬碑》"},"similar":["脂膏不润"],"usage":"作谓语、定语；指人廉洁"},{"id":37716,"word":"脆而不坚","pinyin":"cuì ér bù jiān","abbr":"cebj","explanation":"脆弱而不坚实。形容虚有其表。","source":{"text":"无实事求是之意，有哗众取宠之心。华而不实，脆而不坚。","book":"毛泽东《改造我们的学习》"},"example":{"text":"他就是～的性格。"},"similar":["软弱无力"],"opposite":["坚不可摧"],"usage":"作谓语、定语；指脆弱"},{"id":37717,"word":"脉络分明","pinyin":"mài luò fēn míng","abbr":"mlfm","explanation":"脉络：中医对动脉和静脉的统称，引申为条理或头绪。比喻有条有理或做事有条不紊。","source":{"text":"川流者，如川之流，脉络分明而往不息也。","book":"宋·朱熹《中庸章句集注》"},"example":{"text":"花是浊浓的紫，～活像叶，一丛丛的，一片片的，真是“浓得化不开”。","book":"朱自清《蒙自杂记》"}},{"id":37718,"word":"脉络贯通","pinyin":"mài luò guàn tōng","abbr":"mlgt","explanation":"脉络：人体内的经络。比喻事物前后连贯，条理清楚。","source":{"text":"此书之旨，支分节解，脉络贯通，详略相因，巨细毕举。","book":"宋·朱熹《大学章句序》"},"example":{"text":"朕比命相臣，往开督府，两淮、西蜀，相距迢遥，要须～，易于运掉。","book":"清·毕沅《续资治通鉴》卷一百六十九"},"usage":"作谓语、宾语；用于文章等"},{"id":37719,"word":"脉脉含情","pinyin":"mò mò hán qíng","abbr":"mmhq","explanation":"脉脉：两眼凝神，要向别人诉说心曲的样子。饱含温情，默默地用眼神表达自己的感情。形容用眼神或行动默然地表达情意。","source":{"text":"空将泪滴珠玑，脉脉含情无语。","book":"明·刘基《尉迟杯·水仙花》"},"example":{"text":"给他倒了一杯水，然后坐在他身边的凳子上一声不响，～地望着他。","book":"杨沫《青春之歌》第二部第22章"},"similar":["暗送秋波"],"opposite":["横眉冷对"],"usage":"作谓语、状语；指人用眼表达情意"},{"id":37720,"word":"脉脉无言","pinyin":"mò mò wú yán","abbr":"mmwy","explanation":"脉脉：凝视，指情意深长。情意深长地凝视着，欲吐又无从说起的样子。","source":{"text":"君看脉脉无言处，中有杜陵饥客诗。","book":"宋·范成大《题汤致远运使所藏隆师四图·倚竹》"},"example":{"text":"情知闷来殢酒，奈回肠不醉只添愁。～竟日，断魂双鹜南州。","book":"宋·张孝祥《木兰花慢》词"}},{"id":37721,"word":"脉脉相通","pinyin":"mài mài xiāng tōng","abbr":"mmxt","explanation":"血管彼此相通。比喻关系密切。","source":{"text":"人间的生活，都在这大机轴中息息相关，脉脉相通。","book":"李大钊《Bolshevism的胜利》"},"example":{"text":"这与我们的利益～，切勿草率行事。"},"similar":["息息相关"],"usage":"作谓语、宾语；比喻关系密切"},{"id":37722,"word":"脍炙人口","pinyin":"kuài zhì rén kǒu","abbr":"kzrk","explanation":"脍：切细的肉；炙：烤熟的肉。脍和炙都是人们爱吃的食物。指美味人人爱吃。比喻好的诗文受到人们和称赞和传讼。","source":{"text":"如‘水声常在耳，山色不离门’，又‘扫地树留影，拂床琴有声’……皆脍炙人口。","book":"五代·王定宝《唐摭言》卷十"},"example":{"text":"一部～的《国风》与《小雅》，也是“三百篇”的最精采部分，便是诗歌合作中最美满的成绩。","book":"闻一多《歌与诗》"},"similar":["喜闻乐见","爱不释手","交口称誉"],"opposite":["平淡无味"],"usage":"作谓语、定语；指作品等","story":["孔子的弟子曾与曾参为两父子，曾死后，曾参为悼念父亲曾而不吃羊枣。孟子的弟子公孙丑听说后，就问孟子脍炙和羊哪个好吃。孟子说当然是脍炙，公孙丑问为什么曾子吃脍炙而不吃羊枣，孟子告诉他这是为了避讳而选择的结果"]},{"id":37723,"word":"脏官污吏","pinyin":"zāng guān wū lì","abbr":"zgwl","explanation":"吏：官吏。贪赃枉法的官吏。","source":{"text":"谁知被脏官污吏，淫妇奸夫，通情陷害，监在死囚牢中。","book":"明·施耐庵《水浒传》第62回"}},{"id":37724,"word":"脏心烂肺","pinyin":"zāng xīn làn fèi","abbr":"zxlf","explanation":"脏：不干净。形容人的心地肮脏，不正派。","source":{"text":"知道的说是顽，不知道的人，再遇见那脏心烂肺的爱多管闲事嚼舌头的人，吵嚷的那府里谁不知道，谁不背地里嚼舌说咱们这边混帐。","book":"清·曹雪芹《红楼梦》第六十三回"},"example":{"text":"她要名不要利，财物一概不收，自制的用品也只收工本钱，免得叫～人毁她名声。（冯骥才《三寸金莲》第十四回）"}},{"id":37725,"word":"脏污狼藉","pinyin":"zāng wū láng jí","abbr":"zwlj","explanation":"贪污、受贿，名声败坏，不可收拾。","source":{"text":"长吏多阿富贵戚，脏污狼藉。","book":"《三国志·魏书·武帝纪》"}},{"id":37726,"word":"脐脂自照","pinyin":"qí zhī zì zhào","abbr":"qzzz","explanation":"燃起肚脐的脂肪，为自己照明。比喻坏人最终没有好下场，自作自受。","example":{"text":"董卓落得个～的下场。"},"usage":"作定语；用于坏人","story":["东汉末年，国舅何进没有消灭“十常侍”反而被杀，董卓趁机进京，赶少帝刘辩下台，另立刘协为汉献帝。他作威作福，滥杀无辜，同时贪污受贿，火烧洛阳。闹得民不聊生。董卓被吕布所杀，抛尸荒野，人们把他肚脐眼中流出的油点燃"]},{"id":37727,"word":"脑子生锈","pinyin":"nǎo zǐ shēng xiù","abbr":"nzsx","explanation":"比喻思想僵化。","example":{"text":"我看他是～了，不然会这样迟钝。"},"similar":["笨头笨脑"],"opposite":["聪明伶俐"],"usage":"作谓语；指思想僵化"},{"id":37728,"word":"脑满肠肥","pinyin":"nǎo mǎn cháng féi","abbr":"nmcf","explanation":"脑满：指肥头大耳；肠肥：指身体胖，肚子大。形容饱食终日的剥削者大腹便便，肥胖丑陋的形象。","source":{"text":"琅邪王年少，肠肥脑满，轻为举措。","book":"《北齐书·琅邪王俨传》"},"example":{"text":"匹夫但知高官后禄，养得你～，哪里懂得这些大义。","book":"清·吴趼人《痛史》第二十一回"},"similar":["大腹便便"],"opposite":["骨瘦如柴"],"usage":"作谓语、定语、补语；指人肥胖丑陋的形象","story":["南北朝时期，北齐武成帝高湛的三儿子琅邪王高俨企图夺取帝位，后主高纬便调兵捉拿，将军替高俨开脱说：“琅邪王年少，肠肥脑满，轻为举措，长大自不复然，愿宽其罪。”后主当场释放了高俨，不久就派人暗杀了他"]},{"id":37729,"word":"脑瓜不灵","pinyin":"nǎo guā bù líng","abbr":"ngbl","explanation":"指人不聪明，思想转不过弯来。","example":{"text":"他是一个～的人。"},"opposite":["聪明伶俐"],"usage":"作谓语、定语；用于不聪明的人"},{"id":37730,"word":"脚不沾地","pinyin":"jiǎo bù zhān dì","abbr":"jbzd","explanation":"形容走得非常快，好像脚尖都未着地。同“脚不点地”。","source":{"text":"那李嬷嬷脚不沾地，跟着凤姐儿走了。","book":"清·曹雪芹《红楼梦》第二十回"},"example":{"text":"近几天来，他都是～，身不沾家的。他忙着对各种各样的人解释这样，说明那样。","book":"周立波《暴风骤雨》第一部十"},"similar":["脚不点地"],"usage":"作状语；形容走得非常快"},{"id":37731,"word":"脚不点地","pinyin":"jiǎo bù diǎn dì","abbr":"jbdd","explanation":"点：脚尖着地。形容走得非常快，好像脚尖都未着地。","source":{"text":"两个厮赶着一路正行，行不到三二里田地，只见后面两个人脚不点地赶上前来。","book":"《京本通俗小说·错斩崔宁》"},"example":{"text":"说完就～地走了。","book":"茹志鹃《百合花》"},"similar":["脚不沾地"],"usage":"作状语；形容走得非常快"},{"id":37732,"word":"脚心朝天","pinyin":"jiǎo xīn cháo tiān","abbr":"jxct","explanation":"死的隐语。"},{"id":37733,"word":"脚忙手乱","pinyin":"jiǎo máng shǒu luàn","abbr":"jmsl","explanation":"形容遇事慌张，不知如何是好。","source":{"text":"问：‘如何是大悲境？’师曰：‘千眼都来一只收。’曰：‘如何是境中人？’师曰：‘手忙脚乱。’","book":"宋·释普济《五灯会元》卷十一"},"example":{"text":"惊得舌吐头摇，～。","book":"明·郭勋《英烈传》第七十九回"},"similar":["手忙脚乱"],"opposite":["从容不迫"],"usage":"作谓语、状语；指慌乱"},{"id":37734,"word":"脚跟无线","pinyin":"jiǎo gēn wú xiàn","abbr":"jgwx","explanation":"比喻来去无踪，飘忽不定。","source":{"text":"游艺中原，脚跟无线，如蓬转。","book":"元·王实甫《西厢记》第一本第一折"}},{"id":37735,"word":"脚踏两只船","pinyin":"jiǎo tà liǎng zhī chuán","abbr":"jtlzc","explanation":"比喻对事物的认识不清而拿不定主意，或为了投机取巧而跟不同的两个方面都保持关系。","source":{"text":"临事不决，皆由脚踏两船，随风倒柁，何以定大难而剖大疑乎？","book":"明·李卓吾《藏书》：“世间道学，好骑两头马，喜踹两脚船。”清·陈牧《增广留表新集》卷十二"},"example":{"text":"他是～，别企他儿当八路，小萝卜，皮红肚里白。","book":"丁玲《太阳照在桑干河上》一八"},"usage":"作谓语、定语、分句；指没有立场"},{"id":37736,"word":"脚踏实地","pinyin":"jiǎo tà shí dì","abbr":"jtsd","explanation":"脚踏在坚实的土地上。比喻做事踏实，认真。","source":{"text":"公尝问康节曰：‘某何如人？’曰：‘君实脚踏实地人也。’","book":"宋·邵雍《邵氏闻见前录》卷十八"},"example":{"text":"他们渐渐丢了那空架子，～向前走去。","book":"朱自清《论书生的酸气》"},"similar":["足履实地"],"opposite":["好高骛远"],"usage":"作谓语、定语、定语、状语；指做事认真","story":["宋英宗时期，司马光负责主编《资治通鉴》，他研究很多历史书籍，广泛地收集材料，按照年代的先后顺序认真编排，终于完成294卷《资治通鉴》，后来因反对王安石变法来到洛阳定居，洛阳的邵雍评价他是一个脚踏实地的人"]},{"id":37737,"word":"脚踏硬地","pinyin":"jiǎo tà yìng dì","abbr":"jtyd","explanation":"指实打实，十分稳靠","source":{"text":"况又实实是骨血，脚踏硬地，这家私到底是稳取的了。","book":"明·凌濛初《二刻拍案惊奇》第十卷"},"similar":["脚踏实地"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":37738,"word":"脚踢拳打","pinyin":"jiǎo tī quán dǎ","abbr":"jtqd","explanation":"用拳打，用脚踢。形容打得很凶。","source":{"text":"就到我做活的地方隔着刺网看我，被辅导警看见，当时把我母亲揪着头发，脚踢拳打了一顿。","book":"爱新觉罗·溥仪《我的前半生》第八章"},"example":{"text":"爱新觉罗·溥仪《我的前半生》第八章：“就到我做活的地方隔着刺网看我，被辅导警看见，当时把我母亲揪着头发，～了一顿。”"},"similar":["拳打脚踢"],"usage":"作谓语、宾语；指打架"},{"id":37739,"word":"脚高步低","pinyin":"jiǎo gāo bù dī","abbr":"jgbd","explanation":"形容脚步不稳，歪歪倒倒。","source":{"text":"三人躲在芦苇丛中，望后面时，那火把渐近，三人心里越慌，脚高步低，在芦苇里撞。","book":"明·施耐庵《水浒传》第三十七回"},"example":{"text":"一路～，撞到家中，奔入卧房，摸出砚儿付与妻子收着，衣也不脱，一骨碌滚在床上睡了。","book":"清·徐述夔《快士传》第六卷"}},{"id":37740,"word":"脩辞立诚","pinyin":"xiū cí lì chéng","abbr":"xclc","explanation":"原指整顿文教，树立诚信，后多用以指撰文要表达作者的真实意图，不可作虚饰浮文。","source":{"text":"辞谓文教，诚谓诚实也。外则修理文教，内则立其诚实，内外相成，则有功业可居。","book":"语出《易·乾》：“脩辞立其诚，所以居业也。”孔颖达疏"}},{"id":37741,"word":"脱兔之势","pinyin":"tuō tù zhī shì","abbr":"ttzs","explanation":"变化非常迅速的形势。比喻行动非常迅速。","source":{"text":"攻如饿鸱叫，势若脱兔急。","book":"唐·陆龟蒙《杂讽》"}},{"id":37742,"word":"脱口成章","pinyin":"tuō kǒu chéng zhāng","abbr":"tkcz","explanation":"出口便成文章。比喻才思敏捷。","source":{"text":"彼都人士，狐裘黄黄，其容不改，出言有章。","book":"《诗经·小雅·都人士》"},"similar":["出口成章"],"usage":"作谓语、定语；用于写作等"},{"id":37743,"word":"脱口而出","pinyin":"tuō kǒu ér chū","abbr":"tkec","explanation":"不经考虑，随口说出。形容说话不慎重。也形容才思敏捷，可以对答如流。","source":{"text":"虽然不至于通部滚瓜烂熟，大约一部之中，至少亦有一半看熟在肚里，不然怎么能够脱口而出呢？","book":"清·李宝嘉《文明小史》第八回"},"example":{"text":"我晓得你这个人向来是有口无心的，但也不可不拘什么话便～。","book":"清·吴趼人《瞎编奇闻》第一回"},"similar":["信口开河","心直口快"],"opposite":["守口如瓶","一言不发"],"usage":"作谓语、定语、状语；指不加思索地说"},{"id":37744,"word":"脱壳金蝉","pinyin":"tuō ké jīn chán","abbr":"tkjc","explanation":"比喻用计谋脱身。","source":{"text":"元·关汉卿《谢天香》第二折：”便使尽些伎俩，千愁断我肚肠，觅不的个脱壳金蝉这一个谎。”详见“金蝉脱壳”。"},"usage":"作宾语、定语；用于比喻句"},{"id":37745,"word":"脱天漏网","pinyin":"tuō tiān lòu wǎng","abbr":"ttlw","explanation":"指不受约束地胡作非为。","source":{"text":"从前只有九姨太有些，脱天漏网的事做的顶多，银子少了不要，至少五百起码，以及几千几万不等。","book":"清·李宝嘉《官场现形记》第36回"},"usage":"作谓语、定语；用于书面语"},{"id":37746,"word":"脱帽露顶","pinyin":"tuō mào lù dǐng","abbr":"tmld","explanation":"古代指不受礼仪的约束。","source":{"text":"张旭三杯草圣传，脱帽露顶王公前。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"酒过三巡之后，未免～，舒手豁拳，呼么喝六，壶到杯干。","book":"清·石玉昆《三侠五义》第四十三回"}},{"id":37747,"word":"脱手弹丸","pinyin":"tuō shǒu dàn wán","abbr":"tsdw","explanation":"形容诗作圆转流畅。","source":{"text":"南朝梁沈约曾用谢朓“好诗圆美流转如弹丸”的话，来评王筠的诗，见《南史·王筠传》。"},"example":{"text":"王闿运《湘绮楼论唐诗》：“希夷出江谢，～，宛转生情，歌行杂言，同辟新体。”"},"similar":["弹丸脱手"],"usage":"作宾语、定语；用于比喻句"},{"id":37748,"word":"脱白挂绿","pinyin":"tuō bái guà lǜ","abbr":"tbgl","explanation":"脱去白衣，换上绿袍。指初登仕途。","source":{"text":"今幸已脱白挂绿，何不且到丈人家里，与他们欢庆一番。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"example":{"text":"明·冯梦龙《醒世恒言》第11卷：“今日挂榜，～，便是上吉之日，何必另选日子。”"},"usage":"作谓语、定语、宾语；指当官"},{"id":37749,"word":"脱皮掉肉","pinyin":"tuō pí diào ròu","abbr":"tpdr","explanation":"指卖命。","source":{"text":"老头子一辈为小梁庄群众起早搭黑，脱皮掉肉奔波，哪天黑来不熬到鸡儿叫。","book":"崔巍《爱与恨》"},"usage":"作谓语、宾语；指卖命"},{"id":37750,"word":"脱粟布被","pinyin":"tuō sù bù bèi","abbr":"tsbb","explanation":"吃粗米，盖布被。形容生活俭朴或生活艰苦。","source":{"text":"何用故人富贵为，脱粟布被，我自有之。","book":"《晏子春秋·内篇》：“衣十升之布，食脱粟之食。”晋·葛洪《西京杂记》卷二"}},{"id":37751,"word":"脱缰之马","pinyin":"tuō jiāng zhī mǎ","abbr":"tjzm","explanation":"比喻脱离羁绊的人或失去了控制的事物。","source":{"text":"但因采取了漫谈的方式，信笔所之，常如脱缰之马，离题颇远。","book":"茅盾《夜读偶记》"},"example":{"text":"他像～一样无拘无束。"},"similar":["脱缰野马"],"opposite":["笼中之鸟"],"usage":"作宾语；指失去了控制的事物"},{"id":37752,"word":"脱胎换骨","pinyin":"tuō tāi huàn gǔ","abbr":"tthg","explanation":"原为道教用语。指修道者得道以后，就转凡胎为圣胎，换凡骨为仙骨。现比喻通过教育，思想得到彻底改造。","source":{"text":"然不易其意而造其语，谓之换骨法；窥入其意而形容之，谓之夺胎法。","book":"宋·释惠洪《冷斋夜话》卷一"},"example":{"text":"那长老自服了草还丹，真是～，神爽体健。","book":"明·吴承恩《西游记》第二十七回"},"similar":["洗心革面","换骨脱胎"],"opposite":["执迷不悟","死不改悔"],"usage":"作谓语、状语；指彻底改变","story":["夺胎换骨原是道家的说法即吃了金丹换去凡骨凡胎后成仙。古代文人借用以前古文的意思用自己的语言去表达，黄庭坚认为这是换骨法，深入研究古文的原意进一步加以刻划形容，这叫夺胎法。也有人说不蹈古人一言一句，用夺胎换骨法可以点铁成金"]},{"id":37753,"word":"脱袍退位","pinyin":"tuō páo tuì wèi","abbr":"tptw","explanation":"比喻去职。","source":{"text":"拥护张主任，请郭主任脱袍退位。","book":"周立波《暴风骤雨》第二部"},"example":{"text":"我不想这么早就～。"},"opposite":["黄袍加身"],"usage":"作谓语、宾语；指辞职"},{"id":37754,"word":"脱靴磨墨","pinyin":"tuō xuē mó mò","abbr":"txmm","explanation":"指极力侍侯与讨好文人。","source":{"text":"当殿挥毫，番书草就番人吓。脱靴磨墨，宿憾今朝释。","book":"清·褚人获《隋唐演义》第82回"},"usage":"作宾语、定语；用于书面语","story":["唐朝时期，李白参加殿试求功名，杨国忠与高力士当面毁了李白的试卷，说与他们脱靴磨墨还不够资格。一次，唐玄宗接到番国的檄文，朝中无人能识，贺知章推荐李白给唐玄宗。李白翻译檄文后，借助唐玄宗之命要杨国忠与高力士为他脱靴磨墨以雪耻"]},{"id":37755,"word":"脱颖囊锥","pinyin":"tuō yǐng náng zhuī","abbr":"tynz","explanation":"比喻才能出众者。","source":{"text":"非画饼，似脱颖囊锥，头角峥嵘。","book":"明·沈鲸《双珠记·元宵灯宴》"},"usage":"作宾语、定语；用于书面语"},{"id":37756,"word":"脱颖而出","pinyin":"tuō yǐng ér chū","abbr":"tyec","explanation":"颖：尖子。锥尖透过布囊显露出来。比喻本领全部显露出来。","source":{"text":"使遂早得处囊中，乃脱颖而出，非特其末见而已。","book":"《史记·平原君虞卿列传》"},"example":{"text":"经过艰苦努力，他的学习成绩终于在全班～。"},"similar":["崭露头角","锋芒毕露"],"opposite":["深藏若虚"],"usage":"作谓语、宾语、定语；指显露"},{"id":37757,"word":"脱骨换胎","pinyin":"tuō gǔ huàn tāi","abbr":"tght","explanation":"道教语，指修道者得道以后，就脱凡胎为圣胎，换凡骨为仙骨。现比喻通过教育，思想得到彻底改造。","source":{"text":"盛蕴真：你却是脱骨换胎。","book":"郭沫若《南冠草》第二幕"},"similar":["脱胎换骨","抽胎换骨"],"opposite":["执迷不悟"],"usage":"作谓语、状语、宾语；指彻底改变"},{"id":37758,"word":"脸憨皮厚","pinyin":"liǎn hān pí hòu","abbr":"lhph","explanation":"憨：痴傻的样子。满脸痴傻气，脸皮很厚，不知廉耻。","example":{"text":"此时他却以功臣自诩，真是～，不要脸之极。","book":"三月夫《吴三贵》四十七"}},{"id":37759,"word":"脸无人色","pinyin":"liǎn wú rén sè","abbr":"lwrs","explanation":"形容极端恐惧。"},{"id":37760,"word":"脸红筋暴","pinyin":"liǎn hóng jīn bào","abbr":"lhjb","explanation":"形容发急或发怒时面部红胀，青筋暴起的样子。"},{"id":37761,"word":"脸红筋涨","pinyin":"liǎn hóng jīn zhǎng","abbr":"lhjz","explanation":"形容发急或发怒时面部红胀，青筋暴起的样子。同“脸红筋暴”。"},{"id":37762,"word":"脸红耳热","pinyin":"liǎn hóng ěr rè","abbr":"lher","explanation":"形容感情激动或害羞的样子。同“脸红耳赤”。","source":{"text":"他忽然像被人窥破秘密似地脸红耳热了。","book":"荒煤《父子书记》一"},"example":{"text":"我想起来了，这些天来，他和研究组长，为这个问题，争论得～。","book":"辛雷《一个爱说梦话的人》"},"similar":["脸红耳赤"],"usage":"作谓语、状语；形容人的状态"},{"id":37763,"word":"脸红耳赤","pinyin":"liǎn hóng ěr chì","abbr":"lhec","explanation":"形容感情激动或害羞的样子。亦作“脸红耳热”。","source":{"text":"没有等翻译同志把所有的问题都提出来，那个美国人竟脸红耳赤地吼起来。","book":"萧殷《桃子又熟了》一"},"example":{"text":"只要我们聚在一起，哪怕是吵得～，心里也是甜滋滋的。","book":"陈宜浩《冤家》"},"similar":["面红耳赤"],"opposite":["面不改色"],"usage":"作谓语、状语；形容人的状态"},{"id":37764,"word":"脸软心慈","pinyin":"liǎn ruǎn xīn cí","abbr":"lrxc","explanation":"软：和软；慈：慈善。脸面和软，心地善良。形容人不仅外表和善，心地也很仁厚。","source":{"text":"软：和软；慈：慈善。脸面和软，心地善良。形容人不仅外表和善，心地也很仁厚。"}},{"id":37765,"word":"脸青鼻肿","pinyin":"liǎn qīng bí zhǒng","abbr":"lqbz","explanation":"形容脸部伤势重。"},{"id":37766,"word":"脸黄肌瘦","pinyin":"liǎn huáng jī shòu","abbr":"lhjs","explanation":"脸色黄，肌体瘦。形容营养不良或有病的样子。","source":{"text":"在这乡下孩子的观念里，难民应该都是一些脸黄肌瘦、衣著褴褛的人。","book":"王西彦《隔膜》"},"similar":["面黄肌瘦"],"opposite":["容光焕发"],"usage":"作状语、定语；指人的脸色"},{"id":37767,"word":"脾肉之叹","pinyin":"pí ròu zhī tàn","abbr":"przt","explanation":"脾：通“髀”，大腿。指痛惜光阴虚度，思欲有所作为。","source":{"text":"备住荆州数年，尝于表坐起至厕，见髀里肉生，慨然流涕。","book":"晋·司马彪《九州春秋》"},"example":{"text":"十日不见，多少有点～的向华似乎更加焕发了。","book":"郭沫若《革命春秋·到浦东去来》"},"similar":["髀里肉生"],"usage":"作主语、宾语；指自我感叹","story":["东汉末年，刘备在与曹操作战中丢失了地盘，就去投奔刘表。刘表设酒宴安慰他。席间两人谈得甚欢，刘备入厕摸自己的髀，发现上面的肉又长了起来，回座后不禁感慨，这样下去，光复汉室何时才能成功？刘表就送他地盘与军队"]},{"id":37768,"word":"腊尽春回","pinyin":"là jìn chūn huí","abbr":"ljch","explanation":"腊：指腊月，即农历十二月。腊月过去，春天又来了。","source":{"text":"阑干六曲天围碧，松风亭下梅初白。腊尽见春回，寒梢花又开。","book":"唐·孙道绚《菩萨蛮·梅》"},"example":{"text":"光阴似箭，不久又是～了。","book":"清·吴趼人《痛史》第十八回"},"similar":["春回大地","腊尽春来"],"opposite":["春去秋来"],"usage":"作宾语、分句；指春天来了"},{"id":37769,"word":"腊尽春来","pinyin":"là jìn chūn lái","abbr":"ljcl","explanation":"腊：指腊月，即农历十二月。腊月过去，春天又回来了。","source":{"text":"阑干六曲天围碧，松风亭下梅初白。腊尽见春回，寒梢花又开。","book":"唐·孙道绚《菩萨蛮·梅》"},"example":{"text":"途中饱历风霜，到了下隽，已是～的时候。","book":"蔡东藩《后汉演义》第二十二回"},"similar":["腊尽春回"],"usage":"作宾语、分句；指春天来了"},{"id":37770,"word":"腋肘之患","pinyin":"yè zhǒu zhī huàn","abbr":"yzzh","explanation":"比喻事变就发生在身边。","source":{"text":"主公之在公安也，北畏曹公之强，东惮孙权之逼，近则惧孙夫人生变于肘腋之下，当斯之时，进退狼跋。","book":"《三国志·蜀志·法正传》"},"similar":["肘腋之患","变生肘腋"],"usage":"作主语、宾语；形容产生于身旁的祸患"},{"id":37771,"word":"腐木不可以为柱","pinyin":"fǔ mù bù kě yǐ wéi zhù","abbr":"fmbkywz","explanation":"腐朽的木料不能用做支柱。比喻愚笨、能力较差的人不能担任要职或委以重任。","source":{"text":"腐木不可以为柱，卑人不可以为主。","book":"《汉书·刘辅传》"}},{"id":37772,"word":"腐索奔马","pinyin":"fǔ suǒ bēn mǎ","abbr":"fsbm","explanation":"腐：腐烂。用腐朽的绳索驾驭奔跑的烈马。比喻形势十分艰险危急。","source":{"text":"予临兆民，懔乎若朽索之驭六马。","book":"《尚书·五子之歌》"},"usage":"作宾语、定语；用于比喻句"},{"id":37773,"word":"腐索捍马","pinyin":"fǔ suǒ hàn mǎ","abbr":"fshm","explanation":"索：粗的绳子；捍：拉、套。腐烂的粗绳子套马。比喻小心谨慎地处理政事。","source":{"text":"子曰：‘懔懔焉若腐索之捍马。’","book":"《淮南子·说林训》：“君子之居民上，若以腐索御奔马。”《孔子家语·致思》"}},{"id":37774,"word":"腐索驭马","pinyin":"fǔ suǒ yù mǎ","abbr":"fsym","explanation":"索：粗的绳子。指以腐朽的绳索驾驭奔驰着的骏马。形容存在着被颠覆的危险。","source":{"text":"君子之居民上，若以腐索御奔马。","book":"《淮南子·说林训》"}},{"id":37775,"word":"腐肠之药","pinyin":"fǔ cháng zhī yào","abbr":"fczy","explanation":"指肥肉、好酒。","source":{"text":"皓步蛾眉，命曰伐性之斧；甘脆肥浓，命曰腐肠之药。","book":"汉·枚乘《七发》"},"example":{"text":"服～，御亡国之器。","book":"晋·张协《七命》"},"usage":"作主语、宾语；指有害的东西"},{"id":37776,"word":"腥德发闻","pinyin":"xīng dé fā wén","abbr":"xdfw","explanation":"腥德：秽恶的行径。指丑恶的行径为人所知。","source":{"text":"是以辜罪昭著，腥德发闻，百姓伤心，鬼神怨痛，曾不自闻，愈休如也。","book":"汉·徐幹《中论·中道》"},"usage":"作宾语、定语；用于书面语"},{"id":37777,"word":"腥手污脚","pinyin":"xīng shǒu wū jiǎo","abbr":"xswj","explanation":"腥：弄脏；污：污染。指污染了手脚。","source":{"text":"你这伙反贼，快早早下马受缚，省得我腥手污脚！","book":"明·施耐庵《水浒传》第52回"},"usage":"作谓语、定语；用于蔑视的语气"},{"id":37778,"word":"腥闻在上","pinyin":"xíng wén zài shàng","abbr":"xwzs","explanation":"腥闻：原指酒肉的腥味，引伸为丑恶的名声。比喻丑名远扬。","source":{"text":"腥闻在上，故天降丧于殷。","book":"《尚书·酒诰》"},"similar":["臭名远扬"],"usage":"作谓语、定语；指臭名远扬"},{"id":37779,"word":"腥风血雨","pinyin":"xīng fēng xuè yǔ","abbr":"xfxy","explanation":"风里夹着腥味，雨点带着鲜血。形容疯狂杀戮的凶险气氛或环境。","source":{"text":"血浪凝犹沸，腥风远更飘。","book":"唐·韩愈《叉鱼招张功曹》"},"example":{"text":"～满松林，散乱毛发坠山奄。","book":"明·施耐庵《水浒传》第二十三回"},"similar":["血雨腥风"],"usage":"作宾语；指凶险气氛或局势"},{"id":37780,"word":"腥风醎雨","pinyin":"xīng fēng xián yǔ","abbr":"xfxy","explanation":"犹腥风血雨。形容疯狂杀戮的凶险气氛或环境。"},{"id":37781,"word":"腰缠万贯","pinyin":"yāo chán wàn guàn","abbr":"ycwg","explanation":"腰缠：指随身携带的财物；贯：旧时用绳索穿钱，每一千文为一贯。比喻钱财极多。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《商芸小说·吴蜀人》"},"example":{"text":"再要讲到夜间严谨门户，不怕你～，落了店都是店家的干系，用不着客人自己费心。","book":"清·文康《儿女英雄传》第五回"},"similar":["万贯家财","富埒王侯","家赀巨万"],"opposite":["深无长物","两手空空","囊空如洗"],"usage":"作定语、宾语；比喻钱财极多","story":["传说古代赵钱孙李四公子在扬州痩西湖畔饮酒谈志向，赵某说自己有幸结识朋友，但愿能混个扬州刺史。孙某则想骑上红顶白羽的仙鹤去琼楼玉宇渡余生。李某说要腰缠十万贯，骑鹤上扬州。众人戏他性急喝不得热粥"]},{"id":37782,"word":"腰缠十万","pinyin":"yāo chán shí wàn","abbr":"ycsw","explanation":"腰缠：指随身携带的财物。装着很多钱，骑着鹤到扬州去遨游。比喻钱财极多。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《商芸小说·吴蜀人》"},"example":{"text":"鹏抟九万，～，扬州鹤背骑来惯。","book":"元·乔吉《山坡羊·遇兴》"}},{"id":37783,"word":"腰缠十万贯，骑鹤上扬州","pinyin":"yāo chán shí wàn guàn，qí hè xià yáng zhōu","abbr":"ycswgqhsyz","explanation":"腰缠：指随身携带的财物；贯：旧时用绳索穿钱，每一千文为一贯。装着很多钱，骑着鹤到扬州去遨游。比喻钱财极多。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《商芸小说·吴蜀人》"},"example":{"text":"～，谓仙人而兼富贵；盲人骑瞎马，夜半临深池，是险语之逼人闻。","book":"清·程允升《幼学琼林·鸟兽》"}},{"id":37784,"word":"腰金拖紫","pinyin":"yāo jīn tuō zǐ","abbr":"yjtz","explanation":"比喻身居高官。金，金印；紫，紫绶。","source":{"text":"沈攸之少长庸贱，擢自阎伍，邀百战之运，乘一捷之功，镌山裂地，腰金拖紫，穷贵于国，极富于家。","book":"《宋书·沈攸之传》"},"example":{"text":"一片绿衫消不得，～是何人？","book":"唐·白居易《哭从弟》诗"},"similar":["腰金衣紫"],"usage":"作谓语、定语；用于书面语"},{"id":37785,"word":"腰金衣紫","pinyin":"yāo jīn yī zǐ","abbr":"yjyz","explanation":"腰中挂着金印，身上穿着紫袍。指做了大官。","source":{"text":"自叹绿袍难挂体，腰金衣紫是何人？","book":"元·无名氏《小孙屠》第二出"},"example":{"text":"博得个～，也是人生一世，草生一秋。","book":"明·凌濛初《初刻拍案惊》第22卷"},"usage":"作宾语、定语；指做了大官"},{"id":37786,"word":"腰金骑鹤","pinyin":"yāo jīn qí hè","abbr":"yjqh","explanation":"装着很多钱，骑着鹤四处遨游。比喻钱财极多，又想成为神仙。","source":{"text":"有客相从，各言所志，或原为扬州刺史，或原多赀财，或原骑鹤上升。其一人曰：‘腰缠十万贯，骑鹤上扬州。’欲兼三者。","book":"南朝·梁·殷芸《商芸小说·吴蜀人》"},"example":{"text":"江上一江楼，楼上远山横翠。还更～，引竹西歌吹。","book":"宋·赵长卿《好事近》词"}},{"id":37787,"word":"腰鼓兄弟","pinyin":"yāo gǔ xiōng dì","abbr":"ygxd","explanation":"腰鼓：古乐器，两头粗，中间细。比喻兄弟辈里居中的的那一个较差。","source":{"text":"冲与兄淡渊，名誉有优劣，世号为腰鼓兄弟。","book":"《齐书·沈冲传》"},"usage":"作宾语；用于书面语"},{"id":37788,"word":"腹中兵甲","pinyin":"fù zhōng bīng jiǎ","abbr":"fzbj","explanation":"兵甲：即甲兵，穿着盔甲的士兵。腹中装有士兵。比喻人有雄才谋略。","source":{"text":"……，夏人闻之，相戒曰：‘无以延州为意，今小范老子腹中自有数万兵甲，不比大范老子可欺也。","book":"《五朝名臣言行录·七之二参政范文正公仲淹》引《名臣传》"},"similar":["腹中甲兵"],"usage":"作宾语、定语；指人有雄才大略"},{"id":37789,"word":"腹中甲兵","pinyin":"fù zhōng jiǎ bīng","abbr":"fzjb","explanation":"甲兵：穿着盔甲的士兵。腹中装有士兵。比喻人有雄才大谋略。","source":{"text":"夏人闻之，相戒曰：‘无以延川为意，今小范老子腹中自有数万兵甲，不比大范老子可欺也。","book":"《五朝名臣言行录·七之二参政范文正公仲淹》引《名臣传》"},"similar":["腹中兵甲"],"usage":"作宾语、定语；指人有雄才大略"},{"id":37790,"word":"腹中鳞甲","pinyin":"fù zhōng lín jiǎ","abbr":"fzlj","explanation":"鳞甲：比喻人多巧诈之心。比喻居心险恶。","source":{"text":"孝起前临至吴，为吾说正方腹中有鳞甲，乡党以为不可近。","book":"晋·陈寿《三国志·蜀志·陈震传》"},"similar":["腹有鳞甲"],"usage":"作谓语、定语；比喻居心险恶，不可接近"},{"id":37791,"word":"腹心之患","pinyin":"fù xīn zhī huàn","abbr":"fxzh","explanation":"比喻严重的祸患。","source":{"text":"云代与燕接境，彼若扰我城戍，动摇人情，吾千里出征，缓急难应，此亦腹心之患也。","book":"宋·司马光《资治通鉴·后梁太祖乾化元年》"},"example":{"text":"东南又生一越，为其～。","book":"明·刘基《春秋明经·吴入郢于越入吴公会晋侯及吴子于黄池于越入吴》"},"similar":["腹心之疾"],"usage":"作宾语；比喻要害处的祸患"},{"id":37792,"word":"腹心之疾","pinyin":"fù xīn zhī jí","abbr":"fxzj","explanation":"腹心：比喻要害处；疾：疾患。比喻要害处的祸患。","source":{"text":"所以为腹心之疾者赵也。","book":"《战国策·魏策三》"},"example":{"text":"陛下只知行乐欢娱，歌舞宴赏，作一己之乐，致万姓之愁，臣恐陛下不能享此乐，而先有腹心之患矣。","book":"明·许仲琳《封神演义》十八回"},"similar":["心腹之患"],"usage":"作宾语；比喻要害处的祸患","story":["楚昭王27年，楚昭王看到奇怪的天象就去问成周太史，成周太史要求他去祭祀，去掉腹心的疾病。楚昭王不信，就带兵驻在城父，准备救援吴国进攻的陈国，昭王突然生病，一天比一天重，还是不肯去祭祀，直到病故"]},{"id":37793,"word":"腹心内烂","pinyin":"fù xīn nèi làn","abbr":"fxnl","explanation":"内心溃烂。比喻国家或集团等内部分崩离析。","source":{"text":"明帝惊闇，又有异谋。是以下逆上，腹心内烂也。","book":"《宋书·五行志》"}},{"id":37794,"word":"腹心相照","pinyin":"fù xīn xiāng zhào","abbr":"fxxz","explanation":"腹心：内心；照：映照，见。以真心相见。比喻彼此很知心，达到心心相印的程度。","source":{"text":"这相知只几样名色：恩德相结者，谓之知己；腹心相照者，谓之知心；声气相求者，谓之知音。","book":"明·冯梦龙《警世通言》卷一"},"example":{"text":"明·冯梦龙《警世通言》第一卷：“这相知只几样名色：恩德相结者，谓之知己；～者，谓之知心；声气相求者，谓之知音。”"},"similar":["肝胆相照"],"usage":"作谓语、定语；指知心"},{"id":37795,"word":"腹心股肱","pinyin":"fù xīn gǔ gōng","abbr":"fxgg","explanation":"腹心：心腹，比喻左右亲信；股肱：比喻帝王身边的得力臣子。形容十分亲近且办事得力的人。","source":{"text":"王敦、王导、周颐、刁协并为腹心股肱。","book":"《晋书·元帝纪》"},"similar":["得力助手"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":37796,"word":"腹有鳞甲","pinyin":"fù yǒu lín jiǎ","abbr":"fylj","explanation":"鳞甲：比喻人多巧诈的心。比喻居心险恶，不可接近。","source":{"text":"孝起前是入至吴，为吾说正方腹中有鳞甲，乡党以为不可近。","book":"《三国志·蜀书·陈震传》"},"similar":["居心叵测"],"usage":"作谓语、定语；比喻居心险恶，不可接近"},{"id":37797,"word":"腹热心煎","pinyin":"fù rè xīn jiān","abbr":"frxj","explanation":"形容心中焦急。"},{"id":37798,"word":"腹热肠慌","pinyin":"fù rè cháng huāng","abbr":"frch","explanation":"元曲俗语。形容焦急、慌乱。","source":{"text":"我手脚儿不知高下，身肢儿没处顿放，空教我腹热肠慌。","book":"元·高文秀《遇上皇》第一折：“我有酒后宽洪海量，没酒后腹热肠慌。”元·王仲文《救孝子》第四折"}},{"id":37799,"word":"腹热肠荒","pinyin":"fù rè cháng huāng","abbr":"frch","explanation":"元曲俗语。形容焦急、慌乱。同“腹热肠慌”。","source":{"text":"我一会家腹热肠荒，心忙意急。","book":"元·刘庭信《新水令·春恨》套曲"}},{"id":37800,"word":"腹背之毛","pinyin":"fù bèi zhī máo","abbr":"fbzm","explanation":"比喻无足轻重的事物。","source":{"text":"背上之毛，腹下之毳，益一把飞不为加高，损一把飞不为加下。","book":"汉·韩婴《韩诗外传》卷六"},"example":{"text":"实羽翮之美用，非徒～。","book":"《后汉书·孟尝传》"},"similar":["无足轻重"],"usage":"作宾语；比喻无足轻重的事物"},{"id":37801,"word":"腹背受敌","pinyin":"fù bèi shòu dí","abbr":"fbsd","explanation":"腹：指前面；背：指后面。前后受到敌人的夹攻。","source":{"text":"裕西入函谷，则进退路穷，腹背受敌；北上岸则姚军必不出关助我。","book":"《魏书·崔浩传》"},"example":{"text":"他只有奋力冲上这座山峰，才有可能摆脱～的困境。"},"similar":["四面楚歌","十面埋伏"],"opposite":["金蝉脱壳","各个击破"],"usage":"作谓语、定语、宾语；用于战争状态"},{"id":37802,"word":"腹背夹攻","pinyin":"fù bèi jiā gōng","abbr":"fbjg","explanation":"腹背：比喻前后两面。前后受到敌人的夹攻。","source":{"text":"进兵潍县西境，抄入青岛背后，以便腹背夹攻。","book":"蔡东藩《民国通俗演义》第41回"},"similar":["腹背受敌","腹背收敌"],"usage":"作谓语、补语、分句；用于战争状态"},{"id":37803,"word":"腹背相亲","pinyin":"fù bèi xiāng qīn","abbr":"fbxq","explanation":"腹背：指关系密切。比喻双方关系亲密。","source":{"text":"又黄门协邪，群辈相党，自冀与盛，腹背相亲，朝夕图谋，共构奸轨。","book":"《后汉书·黄琼传》"},"usage":"作谓语、定语；用于两者之间"},{"id":37804,"word":"腹诽心谤","pinyin":"fù fěi xīn bàng","abbr":"ffxb","explanation":"腹诽：口里不说，心里不满。指心怀不满，暗中发泄。","source":{"text":"魏其、灌夫日夜招聚天下豪杰壮士与论议，腹非而心谤。","book":"《史记·魏其武安侯列传》"},"usage":"作谓语；指心怀不满，暗中发泄"},{"id":37805,"word":"腹载五车","pinyin":"fù zài wǔ chē","abbr":"fzwc","explanation":"比喻读书甚多，知识渊博。","source":{"text":"惠施多方，其书五车。","book":"战国·宋·庄周《庄子·天下》"},"example":{"text":"江西李家童子郎，～干玉皇。","book":"宋·杨万里《送李童子西归》诗"},"similar":["学富五车"],"usage":"作谓语、定语；比喻读书甚多，知识渊博"},{"id":37806,"word":"腹里地面","pinyin":"fù lǐ dì miàn","abbr":"fldm","explanation":"指内部地区。","source":{"text":"凡缘边关塞及腹里地面……。","book":"《明律·兵律·关律》"}},{"id":37807,"word":"腹非心谤","pinyin":"fù fēi xīn bàng","abbr":"ffxb","explanation":"心怀不满，暗中发泄。"},{"id":37808,"word":"腹饱万言","pinyin":"fù bǎo wàn yán","abbr":"fbwy","explanation":"指学识渊博。","source":{"text":"那秦观秀才字少游，他是扬州府高邮人，腹饱万言，眼空一世。","book":"明·冯梦龙《醒世恒言·苏小妹三难新郎》"},"similar":["满腹经纶"],"opposite":["胸无点墨"],"usage":"作谓语、定语；指人学识广博"},{"id":37809,"word":"腼腼腆腆","pinyin":"miǎn miǎn tiǎn tiǎn","abbr":"mmtt","explanation":"羞愧、不自然的样子。","source":{"text":"翰林腼腼腆腆，冒冒失失进去。","book":"明·凌濛初《二刻拍案惊奇》第三卷"},"example":{"text":"他这样一笑，我反而～起来了。"},"similar":["忸忸怩怩"],"opposite":["大大方方"],"usage":"作定语、状语；指人不大方"},{"id":37810,"word":"腼颜事仇","pinyin":"miǎn yán shì chóu","abbr":"mysc","explanation":"指不知羞耻地为仇敌做事。"},{"id":37811,"word":"腼颜事敌","pinyin":"miǎn yán shì dí","abbr":"mysd","explanation":"厚着脸皮替敌人工作，不知羞耻。","example":{"text":"抗战期间，上海沦陷，他为环境所迫～，内心十分痛苦。"}},{"id":37812,"word":"腼颜人世","pinyin":"miǎn yán rén shì","abbr":"myrs","explanation":"腼颜：表现出惭愧的脸色。形容丧气失节，厚颜无耻地活在世上。","source":{"text":"岂可偷生屈节，腼颜天壤邪！","book":"《晋书·郗鉴传》"}},{"id":37813,"word":"腼颜天壤","pinyin":"miǎn yán tiān rǎng","abbr":"mytr","explanation":"腼颜：厚着脸面。天壤：天地，指人世间。形容厚着脸皮活在人世间。"},{"id":37814,"word":"腾云驾雾","pinyin":"téng yún jià wù","abbr":"tyjw","explanation":"乘着云，驾着雾。原是传说中指会法术的人乘云雾飞行，后形容奔驰迅速或头脑发昏。","source":{"text":"他放下心，日逐腾云驾雾，遨游四海，行乐千山。","book":"元·郑德辉《老君堂》第二折：“恨不的驾雾腾云，臂生两翅，飞出狱院。”明·吴承恩《西游记》第三回"},"example":{"text":"这简直不是马，是一条～的白龙！一条白龙。","book":"姚雪垠《李自成》第一卷第三章"},"similar":["驾雾腾云"],"usage":"作谓语、定语；用于人"},{"id":37815,"word":"腾声飞实","pinyin":"téng shēng fēi shí","abbr":"tsfs","explanation":"传扬名声与功业。使名实俱得传扬。","source":{"text":"岁月飘忽，性灵不居，腾声飞实，制作而已。","book":"南朝·梁·刘勰《文心雕龙·序志》"},"usage":"作谓语、宾语；用于书面语"},{"id":37816,"word":"腾焰飞芒","pinyin":"téng yàn fēi máng","abbr":"tyfm","explanation":"指光芒四射。","source":{"text":"昧爽放舟，晓色蒸霞，层岚开藻，既而火轮涌起，腾焰飞芒。","book":"明·徐弘祖《徐霞客游记·楚游日记》"},"usage":"作谓语、宾语；用于比喻句"},{"id":37817,"word":"腾空而起","pinyin":"téng kōng ér qǐ","abbr":"tkeq","explanation":"腾空：向天空飞升。向高空升起。","source":{"text":"李靖正欲挽留，只见那女子拨转马头，那马即腾空而起，倏忽不见。","book":"清·褚人获《隋唐演义》第三回"},"example":{"text":"顿时化作一股烟雾～"},"usage":"作谓语、状语；用于事物等"},{"id":37818,"word":"腾腾兀兀","pinyin":"téng téng wū wū","abbr":"ttww","explanation":"犹言昏昏沉沉；恍恍惚惚。","source":{"text":"重叠山前对酒樽，腾腾兀兀度朝昏。","book":"唐·白居易《题石山人》诗：“腾腾兀兀在人间，贵贱贤愚尽往还。”唐·方干《阳亭言事献漳州于使君》诗"},"example":{"text":"～步迟迟，兆朕消磨只自知。","book":"唐·贯休《山居诗二十四首》之十三"}},{"id":37819,"word":"腾蛟起凤","pinyin":"téng jiāo qǐ fèng","abbr":"tjqf","explanation":"蛟：蛟龙；凤：凤凰。宛如蛟龙腾跃、凤凰起舞。形容人很有文采。","source":{"text":"腾蛟起凤，孟学士之词宗。","book":"唐·王勃《滕王阁序》"},"example":{"text":"看今秋步月登云，到来春～。","book":"明·冯惟敏《桂枝香·赠妓桂香》"},"usage":"作谓语、定语；指人很有文采"},{"id":37820,"word":"腾达飞黄","pinyin":"téng dá fēi huáng","abbr":"tdfh","explanation":"形容骏马奔腾飞驰。比喻骤然得志，官职升得很快。同“飞黄腾达”。","source":{"text":"女初闻生至，私念九年之别，如彼其才，或者登金马，蹑玉堂，为文学清华之选，不则风云际会，腾达飞黄，意中事耳。","book":"清·黄钧宰《金壶泪墨·鸳鸯印传奇始末》"},"example":{"text":"就中若讲人品心地，却只有我这安学生。只可惜他清而不贵，不能～。","book":"清·文康《儿女英雄传》第十九回"},"similar":["飞黄腾达"],"usage":"作谓语、定语；指地位升得快"},{"id":37821,"word":"膀大腰圆","pinyin":"bǎng dà yāo yuán","abbr":"bdyy","explanation":"形容魁梧粗壮的人。","source":{"text":"对面来了一人，身高九尺，膀大腰圆，身穿一件白纱长衫，内衬蓝夏布汗褂裤。","book":"清·贪梦道人《彭公案》第一回"},"example":{"text":"他生得～。"},"similar":["牛高马大"],"opposite":["小巧玲珑"],"usage":"作谓语、定语、状语；指人的身材"},{"id":37822,"word":"膏唇岐舌","pinyin":"gào chún qí shé","abbr":"gcqs","explanation":"犹言膏唇拭舌。岐舌，指舌头上耍花招，说话反复无常。","source":{"text":"生平迂愚，耻以文字媚人，况敢膏唇岐舌，以诳知己。","book":"清·钱谦益《复李叔则书》"}},{"id":37823,"word":"膏唇拭舌","pinyin":"gāo chún shì shé","abbr":"gcss","explanation":"膏：用油脂涂抹；拭：擦去。用膏涂嘴唇，用布巾揩舌头。形容用尽语言之所能以打动人心。","source":{"text":"群邪项领，膏唇试舌，竞欲咀嚼，造作飞条。","book":"南朝·宋·范晔《后汉书·宦者吕强传》"},"example":{"text":"清·钱谦益《序》：“寑假而～，訾议其短长，蜉蝣撼大树，斯可为一笑已矣。”"},"similar":["膏唇贩舌"],"usage":"作谓语；形容语言能打动人心"},{"id":37824,"word":"膏唇歧舌","pinyin":"gào chún qí shé","abbr":"gcqs","explanation":"歧舌：卖弄口才，说话反复无常。极力用语言打动人。","source":{"text":"生平迂愚，耻以文字媚人，况敢膏唇歧舌，以诳知己。","book":"清·钱谦益《复李叔则书》"},"similar":["膏唇拭舌","膏唇贩舌"],"usage":"作谓语、宾语、定语；用于说话"},{"id":37825,"word":"膏唇试舌","pinyin":"gāo chún shì shé","abbr":"gcss","explanation":"用膏涂嘴唇，用巾揩舌头。比喻非常想把心里的话说出来。","source":{"text":"群邪项领，膏唇试舌，竞欲咀嚼，造作飞条。","book":"《后汉书·宦者吕强传》"},"example":{"text":"且又寂处空山，不能向五都之市，收藏之家，～而求之。","book":"清·袁枚《小仓山尺牍》第八十五首"}},{"id":37826,"word":"膏唇贩舌","pinyin":"gào chún fàn shé","abbr":"gcfs","explanation":"犹言膏唇拭舌。贩舌，指卖弄口舌。","source":{"text":"其外膏唇贩舌，分路扬镳，无罪无辜，如兄如弟。","book":"南朝·陈·徐陵《与杨仆射书》"},"example":{"text":"弟焉得～，媚死及生，周旋其刻薄之心乎？","book":"清·黄宗羲《与李杲堂陈介眉书》"},"similar":["膏唇拭舌"],"usage":"作谓语、宾语、定语；用于说话"},{"id":37827,"word":"膏场绣浍","pinyin":"gāo cháng xiù kuài","abbr":"gcxk","explanation":"指土地肥沃，水沟纵横。","source":{"text":"始吾游沱西，见其地膏场绣浍，可以稼穑。","book":"明·何景明《沱西别业记》"},"usage":"作谓语；用于书面语"},{"id":37828,"word":"膏梁之性","pinyin":"gāo liáng zhī xìng","abbr":"glzx","explanation":"膏梁：肥肉和细粮，泛指精美的食品。指骄奢淫逸的习性。","source":{"text":"夫膏梁之性难正也。","book":"《国语·晋语七》"}},{"id":37829,"word":"膏梁子弟","pinyin":"gāo liáng zǐ dì","abbr":"glzd","source":{"text":"未审上古以来，张官列位，为膏梁子弟乎？为致治乎？","book":"南朝·梁·刘勰《文心雕龙·杂文》：“盖七窍所发，发乎嗜欲，始邪末正，所以戒膏梁之子也。”《资治通鉴·齐纪·明帝建武三年》"},"example":{"text":"夏侯楙乃～，懦弱无谋。 ◎明·罗贯中《三国演义》第九十二回"},"similar":["纨绔子弟","膏粱纨绔"],"usage":"偏正式；作谓语、宾语、定语；指有钱人家的子弟"},{"id":37830,"word":"膏梁纨袴","pinyin":"gāo liáng wán kù","abbr":"glwk","explanation":"膏梁：肥肉和细粮；纨绔：细绢做的裤子。借指富贵人家子弟。","source":{"text":"宝钗笑道：‘真真膏梁纨袴之谈！我们虽是千金，原不知道这些事。’","book":"清·曹雪芹《红楼梦》第十六回"}},{"id":37831,"word":"膏梁纨裦","pinyin":"gāo liáng wán kù","abbr":"glwk","explanation":"膏梁肥肉和细粮；纨绔细绢做的裤子。借指富贵人家子弟。","source":{"text":"第十六回宝钗笑道‘真真膏梁纨裦之谈！我们虽是千金，原不知道这些事。’","book":"清·曹雪芹《红楼梦》"}},{"id":37832,"word":"膏梁锦绣","pinyin":"gāo liáng jǐn xiù","abbr":"gljx","explanation":"膏、梁：肥肉和细粮。泛指美味的食物；锦绣：精致华丽的丝织品。形容富贵人家衣食精美的奢华生活。","source":{"text":"所以这李纨虽青春丧偶，且居于膏梁锦绣之中，意如‘槁木死灰’一般。","book":"清·曹雪芹《红楼梦》第四回"}},{"id":37833,"word":"膏泽脂香","pinyin":"gāo zé zhī xiāng","abbr":"gzzx","explanation":"指油脂类的化妆品。","source":{"text":"女孩子从小就爱～之类的东西。"},"example":{"text":"女孩子从小就爱～之类的东西"},"usage":"作宾语、定语；指化妆品"},{"id":37834,"word":"膏火之费","pinyin":"gāo huǒ zhī fèi","abbr":"ghzf","explanation":"膏：点灯的油；膏火：灯火。借指求学的费用。","source":{"text":"欲登第须理旧业读书，欲读书须膏火之费，吾视君皆未易办也。","book":"清·霁园主人《夜谭随录》"},"usage":"作宾语；借指求学的费用"},{"id":37835,"word":"膏火自煎","pinyin":"gāo huǒ zì jiān","abbr":"ghzj","explanation":"比喻有才学的人的人因才得祸。","source":{"text":"山木自寇也，膏火自煎也。","book":"《庄子·人间世》"},"example":{"text":"～熬，多财为患害。","book":"晋·阮籍《咏怀诗·八》"},"usage":"作谓语、定语；比喻有才学的人因而得祸"},{"id":37836,"word":"膏烛以明自煎","pinyin":"gāo zhú yǐ míng zì jiān","abbr":"gzymzj","explanation":"油脂的烛因能用来照明而受到煎熬。比喻因有才能或特长而招至祸患。","source":{"text":"鸣铎以声自毁，膏烛以明自煎，虎豹以文来射。","book":"《老子·上德》"}},{"id":37837,"word":"膏粱子弟","pinyin":"gāo liáng zǐ dì","abbr":"glzd","explanation":"膏：肥肉；梁：细粮；膏梁：泛指美味的饭菜。旧时指官僚、地主、有钱人家的子弟。","source":{"text":"未审上古以来，张官列位，为膏梁子弟乎？为致治乎？","book":"南朝·梁·刘勰《文心雕龙·杂文》：“盖七窍所发，发乎嗜欲，始邪末正，所以戒膏梁之子也。”《资治通鉴·齐纪·明帝建武三年》"},"example":{"text":"夏侯楙乃～，懦弱无谋。","book":"明·罗贯中《三国演义》第九十二回"},"similar":["纨绔子弟","膏粱纨绔"],"usage":"作主语、宾语、定语；指有钱人家的子弟"},{"id":37838,"word":"膏粱年少","pinyin":"gāo liáng nián shào","abbr":"glns","explanation":"指富贵人家的子弟。","source":{"text":"汝膏粱年少，何患不达，不镇之以静，将恐贻讥。","book":"《南齐书·王僧虔传》"},"similar":["膏粱子弟","膏粱纨袴"],"usage":"作主语、宾语、定语；指有钱人家的子弟"},{"id":37839,"word":"膏粱文绣","pinyin":"gāo liáng wén xiù","abbr":"glwx","explanation":"指富贵人家的奢华生活。亦泛指精细贵重的东西。","source":{"text":"语本《孟子 ·告子上》：“《诗》云：‘既醉以酒，既饱以德。’言饱乎仁义也，所以不原人之膏粱之味也；令闻广誉施于身，所以不原人之文绣也。”岐注：“膏粱，细粱如膏者也；文绣，绣衣服也。"},"example":{"text":"在小侄年幼，虽不知文章为何物， 然将读过的细味起来，那～比着令闻广誉，真是不啻百倍的了。","book":"清·曹雪芹《红楼梦》第一一五回"},"similar":["膏粱锦绣"],"usage":"作宾语、定语；形容奢华生活"},{"id":37840,"word":"膏粱纨绔","pinyin":"gāo liáng wán kù","abbr":"glwk","explanation":"膏粱：肥肉和细粮。借指富贵人家子弟。","source":{"text":"晋武分诸王使典兵，晋不竞矣。彼皆膏粱纨绔之子也。","book":"清·王夫之《读通鉴论·晋怀帝》"},"similar":["膏粱纨袴","膏粱年少"],"usage":"作宾语、定语；指富贵人家"},{"id":37841,"word":"膏粱纨袴","pinyin":"gāo liáng wán kù","abbr":"glwk","explanation":"膏粱：肥肉和细粮；纨袴：细绢做的裤子。借指富贵人家子弟。","source":{"text":"真真膏粱纨袴之谈！我们虽是千金，原不知道这些事。”","book":"清·曹雪芹《红楼梦》第56回：“宝钗笑道"},"example":{"text":"我不习惯这种～般的生活。"},"similar":["膏粱子弟","纨绔子弟","膏粱纨绔"],"usage":"作宾语、定语；指富贵人家"},{"id":37842,"word":"膏粱纨裦","pinyin":"gāo liáng wán kù","abbr":"glwk","explanation":"膏粱肥肉和细粮；纨裦细绢做的裤子。借指富贵人家子弟。","source":{"text":"第56回宝钗笑道真真膏粱纨裦之谈！我们虽是千金，原不知道这些事。","book":"清·曹雪芹《红楼梦》"}},{"id":37843,"word":"膏粱锦绣","pinyin":"gāo liáng jǐn xiù","abbr":"gljx","explanation":"膏粱：肥肉和细粮，指美味佳肴；锦绣：精致华丽的丝织品。形容富贵人家的奢华生活。","source":{"text":"所以这李纨虽青春丧偶，且居于膏粱锦绣之中，意如槁木死灰一般。","book":"清·曹雪芹《红楼梦》第四回"},"similar":["锦衣玉食","膏粱文绣"],"usage":"作宾语、定语；形容奢华生活"},{"id":37844,"word":"膏肓之疾","pinyin":"gāo huāng zhī jí","abbr":"ghzj","explanation":"指不可医治的绝症。","source":{"text":"在肓之上，膏之下，攻之不可，达之不及，药不至焉，不可为也。","book":"《左传·成公十年》"},"example":{"text":"必欲闻之，则当先之以卑辞，中之以喜色，则～，不劳扁鹊而自愈矣。","book":"五代·王定保《唐摭言》卷十一"},"similar":["病入膏肓","不治之症"],"usage":"作宾语；指绝症","story":["春秋时期，晋国国君晋景公得了重病，秦国国王秦桓公派名医缓前去为其治病。缓来到晋国，见到晋景公，把好脉后摇头叹息说：“大王的病已经到了肓上面，膏下面，药力是无法到达的。”果然，没过多久，晋景公就病死了"]},{"id":37845,"word":"膏肓泉石","pinyin":"gāo huāng quán shí","abbr":"ghqs","explanation":"膏肓：胸鬲之间，比喻难治的病症。形容热爱山林泉水已成为很难改变的癖好，指隐居不愿做官。","source":{"text":"此实鸟私情，退而求息，并非膏肓泉石，借此鸣高。","book":"清·袁枚《小仓山房尺牍》第二首"},"usage":"作宾语、定语；用于比喻句"},{"id":37846,"word":"膏腴之地","pinyin":"gāo yú zhī dì","abbr":"gyzd","explanation":"指肥美的土地或肥沃富饶的地区。","source":{"text":"东割膏腴之地，以为桂林、象郡。","book":"汉·贾谊《过秦论》"},"example":{"text":"江南水乡自古就是～，如今变得更加繁荣富足。"},"similar":["膏腴之壤"],"opposite":["不牧之地","不毛之地"],"usage":"作宾语；指土地肥沃的地区"},{"id":37847,"word":"膏腴之壤","pinyin":"gāo yú zhī rǎng","abbr":"gyzr","explanation":"膏腴：土地肥沃；壤：土地。指土地肥沃富饶的地区。","source":{"text":"东据城皋之险，割膏腴之壤。","book":"西汉·司马迁《史记·李斯列传》"},"similar":["膏腴之地"],"usage":"作宾语；指土地肥沃的地区"},{"id":37848,"word":"膏腴子弟","pinyin":"gāo yú zǐ dì","abbr":"gyzd","explanation":"富贵人家的子弟。","source":{"text":"于是庸音杂体，人各为容，至使膏腴子弟，耻文不逮，终朝点缀，分夜呻吟。","book":"南朝·梁·锺嵘《〈诗品〉序》"},"example":{"text":"卖糖小孩在我面前的地位，正如我在～面前的地位一样。","book":"柯灵《香雪海·小浪花》"},"similar":["膏粱子弟"],"usage":"作主语、宾语、定语；指有钱人家的子弟"},{"id":37849,"word":"膏腴贵游","pinyin":"gāo yú guì yóu","abbr":"gygy","explanation":"犹言富家贵族。","source":{"text":"时膏腴贵游，咸以文学相尚，罕以经术为业，惟承独好之。","book":"《梁书·王承传》"},"usage":"作宾语、定语；用于书面语"},{"id":37850,"word":"膏车秣马","pinyin":"gào chē mò mǎ","abbr":"gcmm","explanation":"为车上油，给马喂料。指准备起程。","source":{"text":"羡调和鼎鼐，便膏车秣马好归来。","book":"语出唐·韩愈《送李愿归盘 谷序》：“膏吾车兮秣吾马，从子于盘兮，终吾生以徜徉。”明·屠隆《彩毫记·钦取回朝》"},"example":{"text":"［刘三白］与某～，后队兴兵呀。","book":"清·新广东武生《黄萧养回头》"},"usage":"作谓语、宾语、定语；用于旅行等"},{"id":37851,"word":"膘肥体壮","pinyin":"biāo féi tǐ zhuàng","abbr":"bftz","explanation":"形容牲畜肥壮结实。","source":{"text":"它们吃了含有乳汁的酥油草，膘肥体壮，毛色格外发亮。","book":"碧野《天山景物记》"},"example":{"text":"他牵出几匹～的马来让我们挑选。"},"similar":["肥头大耳"],"usage":"作谓语、定语、状语；用于人或动物等"},{"id":37852,"word":"膝下承欢","pinyin":"xī xià chéng huān","abbr":"xxch","explanation":"在父母跟前尽心侍奉，以博得父母的欢心。","source":{"text":"冀尘迹于丘中，绝汉机于俗网；获承欢于膝下，驭潘舆于家园。","book":"晋·刘柔妻王氏《怀思赋》：“想昔日之欢侍，奉膝下而治裕。”唐·骆宾王《上廉察使启》"},"example":{"text":"近来我在林下，倒常教他做几首诗，吟咏性情，要他知道乐天知命的道理，在我～便了。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["承欢膝下"],"usage":"作谓语、定语；用于家庭"},{"id":37853,"word":"膝下有黄金","pinyin":"xī xià yǒu huáng jīn","abbr":"xxyhj","explanation":"不肯轻易对人屈膝下跪。形容人刚正不阿，有志气。","source":{"text":"大丈夫膝下有黄金，怎肯拜无眼长老。","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"男儿～，如何拜人？","book":"明·凌濛初《初刻拍案惊奇》卷二十一"}},{"id":37854,"word":"膝下犹虚","pinyin":"xī xià yóu xū","abbr":"xxyx","explanation":"膝：膝盖；虚：空。膝盖下还空着。指没有儿女。","example":{"text":"～的日子还真空虚。"},"opposite":["儿孙满堂"],"usage":"作谓语、定语；用于家庭"},{"id":37855,"word":"膝下荒凉","pinyin":"xī xià huāng liáng","abbr":"xxhl","explanation":"膝下：子女幼时依于父母的膝下。形容没有子女或子女很少。","source":{"text":"夫妻无子，故爱如珍宝，且又见他聪明清秀，便也欲使他读书识得几个字，不过假充养子之意，聊解膝下荒凉之叹。","book":"清·曹雪芹《红楼梦》第二回"},"example":{"text":"想到自己又是～，无儿无女，不觉动了个同病相怜的念头。","book":"清·文康《儿女英雄传》第二十三回"}},{"id":37856,"word":"膝痒搔背","pinyin":"xī yǎng sāo bèi","abbr":"xysb","explanation":"膝部发痒，却去搔背。比喻力量没有使在点子上。","source":{"text":"议论无所依，如膝痒而搔背。","book":"汉·桓宽《盐铁论·利议》"},"example":{"text":"你这种～的做法真是滑稽可笑。"},"similar":["隔靴搔痒"],"opposite":["搔到痒处"],"usage":"作谓语、宾语；比喻力量没有用到要害"},{"id":37857,"word":"膝行匍伏","pinyin":"xī xíng pú fú","abbr":"xxpf","explanation":"伏地爬行。同“膝行蒲伏”。","source":{"text":"绮罗红粉轻于尘，膝行匍伏擎金樽。","book":"清·赵执信《海鸥小谱·长句》"},"similar":["膝行蒲伏"],"usage":"作谓语、宾语、定语；用于处事"},{"id":37858,"word":"膝行而前","pinyin":"xī xíng ér qián","abbr":"xxeq","explanation":"跪着用膝盖向前移动。形容敬畏恭谨之极。","source":{"text":"项羽召见诸侯将，入辕门，无不膝行而前。","book":"《史记·项羽本纪》"},"example":{"text":"“大人是今天回京的？”一位大胆的属员，～了一点，恭敬的问。","book":"鲁迅《理水》"},"similar":["膝行而进"],"usage":"作谓语、状语；用于处事"},{"id":37859,"word":"膝行而进","pinyin":"xī xíng ér jìn","abbr":"xxej","explanation":"跪着用膝盖向前移动。形容敬畏恭谨之极。","source":{"text":"广成子南首而卧，黄帝顺下风膝行而进，再拜稽首。","book":"《庄子·在宥》"},"example":{"text":"司马懿升帐，聚众将立于两边。演～，跪于帐下。","book":"明·罗贯中《三国演义》第一百六回"},"similar":["膝行而前"],"usage":"作谓语、状语；用于处事"},{"id":37860,"word":"膝行肘步","pinyin":"xī xíng zhǒu bù","abbr":"xxzb","explanation":"用膝盖和肘部匍匐前进。形容地位低下，不足以与人平起平坐。","source":{"text":"陆平原、曹子建，足可以车载斗量；谢灵运、潘安仁，足可以膝行肘步。","book":"唐·王勃《山亭思友人序》"},"example":{"text":"待到来日，～，肉袒求见。","book":"元·无名氏《谇范叔》第三折"},"usage":"作谓语、定语、状语；用于人的动作"},{"id":37861,"word":"膝行蒲伏","pinyin":"xī xíng pú fú","abbr":"xxpf","explanation":"伏地爬行。","source":{"text":"夫其膝行蒲伏，非恭也；复言重诺，非信也；糜金散玉，非惠也；刎首决腹，非勇也。","book":"宋·司马光《资治通鉴·秦始皇帝二十五年》"},"similar":["膝行匍伏"],"usage":"作谓语、宾语、定语；用于处事"},{"id":37862,"word":"膝语蛇行","pinyin":"xī yǔ shé xíng","abbr":"xysx","explanation":"跪着说话，伏地而行。极言其畏服。","source":{"text":"是时公督数边兵，威振东南，介胄之事，膝语蛇行，不敢举头。","book":"明·袁宏道《徐文长传》"},"usage":"作宾语、定语；用于书面语"},{"id":37863,"word":"膺图受箓","pinyin":"yīng tú shòu lù","abbr":"ytsl","explanation":"道教指经过修炼，受天地道箓而名列仙籍。也指帝王得受图箓，应运而兴。图，河图；箓，符命。同“膺箓受图”。"},{"id":37864,"word":"膺箓受图","pinyin":"yīng lù shòu tú","abbr":"ylst","explanation":"①指帝王得受图箓，应运而兴。图，河图；箓，符命。②道教指经过修炼，受天地道箓而名列仙籍。"},{"id":37865,"word":"臂有四肘","pinyin":"bì yǒu sì zhǒu","abbr":"bysz","explanation":"比喻不凡的相貌。","source":{"text":"耳有三漏，大禹之奇形，臂有四肘，成汤之异体。","book":"《幼学琼林·卷二·身体类》"}},{"id":37866,"word":"臣心如水","pinyin":"chén xīn rú shuǐ","abbr":"cxrs","explanation":"心地洁净如水。比喻为官清廉。","source":{"text":"上责崇曰：‘君门如市人，何以欲禁切主上？’崇对曰：‘臣门如市，臣心如水。愿得考覆。’","book":"东汉·班固《汉书·郑崇传》"},"example":{"text":"我神志很清明，却又混沌，一切感想都不起，只停在‘～’的状态之中。","book":"冰心《寄小读者》九"},"usage":"作谓语、定语；指廉洁奉公，心清如水","story":["汉哀帝听信尚书令赵昌的谗言，责问尚书仆射郑崇为什么他家来往的人像赶集一样，是否在密谋不轨。郑崇说虽然臣门如市，但是我忠君之心像水一样明澈见底，丝毫没有二心。汉哀帝为报郑崇谏他泡男妓董贤的仇恨，将郑崇抓进大牢"]},{"id":37867,"word":"臣门如市","pinyin":"chén mén rú shì","abbr":"cmrs","explanation":"旧时形容居高位、掌大权的人宾客极多。","source":{"text":"臣门如市，臣心如水。","book":"《汉书·郑崇传》"},"example":{"text":"而且有些人见不到，第二天起早再来的：真正合了古人一句话，叫做“～”。","book":"清·李宝嘉《官场现形记》第十九回"},"similar":["门庭若市"],"opposite":["门堪罗雀","门可罗雀"],"usage":"作谓语、定语；形容车马盈门","story":["汉哀帝听信尚书令赵昌的谗言，责问尚书仆射郑崇为什么他家来往的人像赶集一样，是否在密谋不轨。郑崇说虽然臣门如市，但是我忠君之心像水一样明澈见底，丝毫没有二心。汉哀帝为报郑崇谏他泡男妓董贤的仇恨，将郑崇抓进大牢"]},{"id":37868,"word":"臧仓小人","pinyin":"zāng cāng xiǎo rén","abbr":"zcxr","explanation":"臧仓：战国时鲁国人。臧仓是个奸诈的小人。指进谗害贤的小人。","example":{"text":"我们痛恨那些～。"},"opposite":["正人君子"],"usage":"作主语、宾语、定语；指小人","story":["战国时期，鲁平公很信任一个地道的卑鄙小人臧仓。臧仓靠鲁平公对他的宠信，经常挑拨别人之间的关系，说别人的坏话。他听说鲁平公要去拜访孟子，就百般阻拦，诬蔑孟子是普通的小市民，使鲁平公失去受教育的好机会"]},{"id":37869,"word":"臧否人物","pinyin":"zāng pǐ rén wù","abbr":"zprw","explanation":"臧否：褒贬。评论人物好坏。","source":{"text":"籍虽不拘礼教，然发言玄远，口不臧否人物。","book":"《晋书·阮籍传》"},"example":{"text":"语言运用的微妙之处，使～也同样出现了秉的局面。"},"similar":["月旦春秋"],"usage":"作谓语、宾语；指评论人物好坏"},{"id":37870,"word":"臧穀亡羊","pinyin":"zāng gǔ wáng yáng","abbr":"zgwy","explanation":"《庄子·骈拇》载，臧、穀二人牧羊，臧挟策读书，穀博塞以游，皆亡其羊。后因以为典，喻事不同而实则一。","source":{"text":"仲尼忧世接舆狂，藏穀虽殊竟两亡。","book":"宋·苏轼《和刘道原〈咏史〉》"},"similar":["臧谷亡羊"],"usage":"作宾语、定语；用于书面语"},{"id":37871,"word":"臧穣亡羊","pinyin":"zāng gǔ wáng yáng","abbr":"zgwy","explanation":"《庄子·骈拇》载，臧、穣二人牧羊，臧挟策读书，穣博塞以游，皆亡其羊◇因以为典，喻事不同而实则一。","source":{"text":"仲尼忧世接舆狂，藏穣虽殊竟两亡。","book":"宋·苏轼《和刘道原〈咏史〉》"}},{"id":37872,"word":"臧谷两亡","pinyin":"zāng gǔ liǎng wáng","abbr":"zglw","explanation":"臧、谷：两个人名。臧和谷一起放羊，一个去读书，一个去赌博，结果都丢了羊。形容做事马虎大意，不专心。","source":{"text":"臧与谷二人，相与牧羊而俱亡其羊，问臧奚事，则挟荚读书，问谷奚事，则博塞以游。二人者，事业不同，其于亡羊均也。","book":"《庄子·骈拇》"},"example":{"text":"仲尼忧世接舆狂，臧谷虽殊谒两亡。（宋·苏轼《咏史和刘道原》）"}},{"id":37873,"word":"臧谷之羊","pinyin":"zāng gǔ zhī yáng","abbr":"zgzy","explanation":"臧、谷：两个人名。臧和谷的羊。形容做事马虎大意，不专心。","source":{"text":"臧与谷二人，相与牧羊而俱亡其羊，问臧奚事，则挟荚读书，问谷奚事，则博塞以游。二人者，事业不同，其于亡羊均也。","book":"《庄子·骈拇》"}},{"id":37874,"word":"臧谷亡羊","pinyin":"zāng gǔ wáng yáng","abbr":"zgwy","explanation":"后因以为典，喻事不同而实则一。","source":{"text":"仲尼忧世接舆狂，藏谷虽殊竟两亡。","book":"《庄子·骈拇》：“臧、谷二人牧羊，臧挟策读书，谷博塞以游，皆亡其羊。”宋·苏轼《和刘道原〈咏史〉》"},"similar":["臧穀亡羊"],"usage":"作宾语、定语；用于书面语"},{"id":37875,"word":"自上而下","pinyin":"zì shàng ér xià","abbr":"zsex","explanation":"从上到下。","source":{"text":"有的可采取自上而下的方式，有的可采取自下而上的方式，总以能教育群众、纠正错误、保证党的领导为原则。","book":"邓小平《党与抗日民主政权》"},"example":{"text":"我们学校～都在开展学雷锋活动。"},"similar":["从上至下"],"opposite":["自下而上"],"usage":"作定语、状语；指上下顺序排列"},{"id":37876,"word":"自下而上","pinyin":"zì xià ér shàng","abbr":"zxes","explanation":"从下到上。","source":{"text":"有的可采取自上而下的方式，有的可采取自下而上的方式，总以能教育群众、纠正错误、保证党的领导为原则。","book":"邓小平《党与抗日民主政权》"},"similar":["从下到上"],"opposite":["自上而下"],"usage":"作定语、状语；指上下顺序排列"},{"id":37877,"word":"自不待言","pinyin":"zì bù dài yán","abbr":"zbdy","explanation":"大家心里明白，不必再用言语解释。","example":{"text":"散居世界各国的华侨，虽然不少已入外国籍，但其对祖国的忠诚仍是～的。"}},{"id":37878,"word":"自不量力","pinyin":"zì bù liàng lì","abbr":"zbll","explanation":"量：估量。自己不估量自己的能力。指过高地估计自己的力量。","source":{"text":"荆甚固，而薛亦不量其力。","book":"《战国策·齐策三》"},"example":{"text":"就说我们殿试都是侥幸名列上等，并非真才实学，何敢～，妄自谈文。","book":"《镜花缘》第八十七回"},"similar":["蚍蜉憾树","螳臂当车","以卵击石"],"opposite":["量力而行","力所能及","自知之明"],"usage":"作谓语、宾语；指没有自知之明","story":["春秋时期实力弱小的息国从郑国发动战争，结果被打败。分析人士认为自不量力的息国即将被消灭，原因是他不考虑自己的德行，不正确分析敌我双方的力量，分不清敌人与朋友，不团结邻国，结果没过多久息国被楚国消灭"]},{"id":37879,"word":"自业自得","pinyin":"zì yè zì dé","abbr":"zyzd","explanation":"业：造作；得：获得，取得。佛家语，指自作自受。","source":{"text":"自业自得果，众生皆如是。","book":"《正法念经》"},"similar":["自作自受"],"usage":"作谓语、定语、宾语；指自作自受"},{"id":37880,"word":"自产自销","pinyin":"zì chǎn zì xiāo","abbr":"zczx","explanation":"自己生产自己销售。","example":{"text":"这种产品我们～，一年的效益还不错。"},"usage":"作谓语、宾语、定语；用于商业"},{"id":37881,"word":"自今以往","pinyin":"zì jīn yǐ wǎng","abbr":"zjyw","explanation":"从今以后","source":{"text":"寄语某君，自今以往，更委身于祖国文学……苟能为索士双亚、弥尔顿，其报国民之思者，不已多乎？","book":"梁启超《饮冰室诗话》"},"similar":["自今而后","自今已后","自今已往"],"usage":"作状语、分句；用于书面语"},{"id":37882,"word":"自今已后","pinyin":"zì jīn yǐ hòu","abbr":"zjyh","explanation":"从今以后","example":{"text":"我～不再担任任何职务"},"similar":["自今以往","自今而后","自今已往"],"usage":"作状语、分句；用于书面语"},{"id":37883,"word":"自今已往","pinyin":"zì jīn yǐ wǎng","abbr":"zjyw","explanation":"从今以后","example":{"text":"她～不再是我的人了"},"similar":["自今以往","自今而后","自今已后"],"usage":"作状语、分句；用于书面语"},{"id":37884,"word":"自今而后","pinyin":"zì jīn ér hòu","abbr":"zjeh","explanation":"从今以后","example":{"text":"～，我再不喝啤酒了"},"similar":["自今以往","自今已后","自今已往"],"usage":"作状语、分句；用于书面语"},{"id":37885,"word":"自以为得计","pinyin":"zì yǐ wéi dé jì","abbr":"zywdj","explanation":"得计：计谋得逞。自以为计谋很对很好了（含贬义）。","source":{"text":"此宜禽兽夷狄所不忍为，而其人自视以为得计，闻子厚之风，亦可以少愧矣。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"却说魏延烧断栈道，屯兵南谷，把住隘口，～；不想杨仪、姜维星夜引兵抄到南谷之后。","book":"明·罗贯中《三国演义》第一百五回"},"similar":["自以为计"],"usage":"作谓语；指自以为是","story":["唐宪宗时期，力图革新政治的王叔文遭到贬黜，柳宗元因此也被贬官。好友韩愈为柳宗元作《柳子厚墓志铭》，谈到人在困窘时才能显出气节道义，那些表面握手言欢似乎肝胆相照，背后却落井下石还自以为计，真是可悲"]},{"id":37886,"word":"自以为是","pinyin":"zì yǐ wéi shì","abbr":"zyws","explanation":"是：对。总以为自己是对的。形容主观，不虚心。","source":{"text":"众皆悦之，自以为是。","book":"《荀子·荣辱》：“凡斗者必自以为是，而以人为非也。”《孟子·尽心下》"},"example":{"text":"世人往往～，自夸其能。","book":"清·李汝珍《镜花缘》第八十四回"},"similar":["一意孤行","执迷不悟","夜郎自大"],"opposite":["妄自菲薄","自惭形秽","自暴自弃"],"usage":"作谓语、定语；形容主观不虚心"},{"id":37887,"word":"自以为然","pinyin":"zì yǐ wéi rán","abbr":"zywr","explanation":"然：这样。自己认为自己是对的。形容主观、不虚心的态度。","source":{"text":"众皆悦之，自以为是。","book":"《孟子·尽心下》"},"example":{"text":"你不要老是这种抱着～的态度。"},"similar":["自以为是"],"opposite":["自以为非"],"usage":"作谓语、宾语、定语；指不虚心"},{"id":37888,"word":"自以为计","pinyin":"zì yǐ wéi jì","abbr":"zywj","explanation":"自己以为计谋得逞。","source":{"text":"此宜禽兽夷狄所不忍为，而其人自视以为得计，闻子厚之风，亦可以少愧矣。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"请不要～了。"},"similar":["自以为得计"],"usage":"作谓语；指自以为是，用来讽刺人","story":["唐宪宗时期，力图革新政治的王叔文遭到贬黜，柳宗元因此也被贬官。好友韩愈为柳宗元作《柳子厚墓志铭》，谈到人在困窘时才能显出气节道义，那些表面握手言欢似乎肝胆相照，背后却落井下石还自以为计，真是可悲"]},{"id":37889,"word":"自以为非","pinyin":"zì yǐ wéi fēi","abbr":"zywf","explanation":"认为自己的看法不对","example":{"text":"不要～，要有自信"},"opposite":["自以为然"],"usage":"作谓语、定语；用于书面语"},{"id":37890,"word":"自伐无功","pinyin":"zì fá wú gōng","abbr":"zfwg","explanation":"自伐：自我夸耀；功：功勋。喜欢自我夸耀的人建立不起功勋","source":{"text":"自伐者无功，自矜者不长。","book":"春秋·楚·李耳《老子·道经》第24章"},"usage":"作宾语、定语；用于书面语"},{"id":37891,"word":"自作主张","pinyin":"zì zuò zhǔ zhāng","abbr":"zzzz","explanation":"指没有经过上级或有关方面同意，就擅自处置。","source":{"text":"但那杨景是一个郡马，怎好就是这等自做主张，将他只一刀哈喇了。","book":"元·无名氏《谢金吾》第三折"},"example":{"text":"凡事总得回过他，就是多用些，也无话说，但不可～。","book":"清·李宝嘉《活地狱》第八回"},"similar":["擅自做主"],"usage":"作谓语、宾语；指擅自做主"},{"id":37892,"word":"自作之孽","pinyin":"zì zuò zhī niè","abbr":"zzzn","explanation":"孽：罪恶，灾祸。指自己招来的罪孽或灾祸是逃不脱的","source":{"text":"与卖国者言救国，与毁法者言护法……尽王揖唐等自作之草，如何与彼谈判！","book":"陶菊隐《北洋军阀统治时期史话》第44章"},"similar":["自作孽，不可活"],"usage":"作宾语；用于书面语"},{"id":37893,"word":"自作多情","pinyin":"zì zuò duō qíng","abbr":"zzdq","explanation":"自以为或自己想象自己是人家的意中人。","source":{"text":"你别老那么自作多情，以为我对你多恋恋不舍似的。","book":"王朔《浮出海面》"},"example":{"text":"她这样做是～。"},"usage":"作谓语、宾语、定语；指人自以为是"},{"id":37894,"word":"自作孽，不可活","pinyin":"zì zuò niè，bù kě huó","abbr":"zznbkh","explanation":"孽：罪恶，灾祸。指自己招来的罪孽或灾祸是逃不脱的","source":{"text":"天作孽，犹可违；自作孽，不可活。","book":"战国·邹·孟轲《孟子·公孙丑》"},"example":{"text":"陈学昭《工作着是美丽的》：“她实在是自作自受，‘～’，她早就该死了。”"},"similar":["自作之孽"],"usage":"作宾语、定语；用于书面语"},{"id":37895,"word":"自作聪明","pinyin":"zì zuò cōng míng","abbr":"zzcm","explanation":"自以为聪明而乱作主张。指过高地估计自己，主观地办事。","source":{"text":"严州分水县，故额草书‘分’字，县令自作聪明者，谓草体非宜，自真书三字刻而立之。","book":"《尚书·蔡仲之命》：“率自中，无作聪明，乱旧章。”宋·洪迈《容斋随笔》卷十四"},"example":{"text":"郑令虽笨，不至于此，难保不是经手家人～，所以弄出这样笑话来。","book":"清·李宝嘉《中国现在记》第九回"},"similar":["班门弄斧","自以为是","故作姿态"],"opposite":["自以为非","自知之明"],"usage":"作谓语、定语、状语；指耍小聪明"},{"id":37896,"word":"自作自受","pinyin":"zì zuò zì shòu","abbr":"zzzs","explanation":"自己做了蠢事坏事，自己倒霉。","source":{"text":"僧问金山颖：‘一百二十斤铁枷，教阿谁担？’颖曰：‘自作自受。’","book":"宋·释普济《五灯会元》"},"example":{"text":"他这会子不说保养着些，还要捉弄人；明儿病了，叫他～。","book":"清·曹雪芹《红楼梦》第五十一回"},"similar":["自食其果","自讨苦吃","自投罗网"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语；指自食其果"},{"id":37897,"word":"自作解人","pinyin":"zì zuò jiě rén","abbr":"zzjr","explanation":"指不明真意而乱发议论的人。","source":{"text":"非但能言人不可得，正索解人亦不得。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"南朝宋·刘义庆《世说新语·文学》：“非但能言人不可得，正索解人亦不得。”"},"similar":["强做解人"],"usage":"作谓语；指乱发议论","story":["东晋时期，谢安年轻时对战国时期赵国公孙龙著的《白马论》不能理解，就去向金紫光禄大夫阮裕请教。阮裕写了一篇解说《白马论》的文章交给谢安。谢安对他的解说文更加看不明白，又去请教他。阮裕自叹道自己是强做解人"]},{"id":37898,"word":"自作门户","pinyin":"zì zuò mén hù","abbr":"zzmh","explanation":"指自己创立派别或结成宗派。同“自立门户”。","source":{"text":"今朝廷之内，多山东人，而自作门户，更相剡荐，附下罔上，共为朋党。","book":"《旧唐书·韦云起传》"},"similar":["自立门户"],"usage":"作谓语、定语；指独立成事"},{"id":37899,"word":"自信不疑","pinyin":"zì xìn bù yí","abbr":"zxby","explanation":"相信自己，绝不怀疑。","source":{"text":"为政之日，自信而不疑。","book":"宋·苏轼《司马温公行状》"},"similar":["深信不疑"],"usage":"作谓语、定语；指十分自信"},{"id":37900,"word":"自做自当","pinyin":"zì zuò zì dāng","abbr":"zzzd","explanation":"自己做了蠢事坏事，自己受累","source":{"text":"任珪道：‘不必缚我，我自做自当，并不连累你们。’","book":"明·冯梦龙《喻世明言》第38卷"},"similar":["自作自受","自受自作"],"usage":"作谓语、宾语；指自食其果"},{"id":37901,"word":"自僝自僽","pinyin":"zì chán zì zhòu","abbr":"zczz","explanation":"僝、僽：烦恼，埋怨。自寻烦恼，自相埋怨","source":{"text":"到如今夫妻情，父子恩，都作了一笔勾，落得个自僝自僽。","book":"元·无名氏《冤家债主》第二折"},"usage":"作谓语、定语、状语；用于书面语"},{"id":37902,"word":"自出一家","pinyin":"zì chū yī jiā","abbr":"zcyj","explanation":"指在某一方面的学问或技术有独到的见解或独特的做法，能自成体系。","source":{"text":"文章须自出机杼，成一家风骨，何能共人同生活也。","book":"《魏书·祖莹传》"},"example":{"text":"尤喜作墨鬼、钟馗等画，怪怪奇奇，～。","book":"元·夏文彦《图绘宝鉴·元朝》"},"similar":["自成一家"],"usage":"作谓语、定语；指独特的见解"},{"id":37903,"word":"自出心裁","pinyin":"zì chū xīn cái","abbr":"zcxc","explanation":"心裁：心中的设计、筹划。出于自己的创造。指不抄袭、模仿别人。","source":{"text":"那些童生都读过前人这篇，不能自出心裁，每多抄袭。","book":"清·曹雪芹《红楼梦》第84回"},"example":{"text":"他们有的看人家的样，有的～。","book":"叶圣陶《四三集·一桶水》"},"similar":["自出新裁"],"usage":"作谓语；指独创"},{"id":37904,"word":"自出新意","pinyin":"zì chū xīn yì","abbr":"zcxy","explanation":"出自自己心意。指与众不同的个人见解、旨趣","source":{"text":"孟东野阴祖沈、谢，而流于蹇涩。卢仝则又自出新意，而涉于怪诡。","book":"明·宋濂《答章秀才论诗书》"},"similar":["自出胸臆"],"usage":"作谓语、定语；用于书面语"},{"id":37905,"word":"自出新裁","pinyin":"zì chū xīn cái","abbr":"zcxc","explanation":"指出于自己心中的设计或筹划。多指诗文、技艺等的构思有独创性。同“自出心裁”。","source":{"text":"他们有的看人家的样，有的自出新裁，给一切东西找个新的适当的位置。","book":"叶圣陶《四三集·一桶水》"},"example":{"text":"鲁迅《坟·看镜有感》：“但是要进步或不退步，总须时时～，至少也必取材异域。”"},"similar":["自出心裁"],"usage":"作谓语；指独创"},{"id":37906,"word":"自出机杼","pinyin":"zì chū jī zhù","abbr":"zcjz","explanation":"机杼：本指织布机上的筘，织布时每条经线都要从筘齿间穿过，比喻心思、心意。比喻写文章能创造出新的风格和体裁。","source":{"text":"文章须自出机杼，成一家风骨，何能共人同生活也。","book":"《魏书·祖莹传》"},"example":{"text":"做文章原要～，自行发挥，不是迎合他人的嗜好。","book":"《晚清文学丛钞·黄绣球》第七回"},"similar":["自出机轴"],"usage":"作谓语；用于文章"},{"id":37907,"word":"自出机轴","pinyin":"zì chū jī zhóu","abbr":"zcjz","explanation":"比喻作文章能创造出一种新的风格和体裁。同“自出机杼”。","source":{"text":"右丞辋川诸作，却是自出机轴。","book":"明·胡应麟《诗薮·近体下》"},"similar":["自成机杼","别出机杼","自出机杼"],"usage":"作谓语、定语；用于文章"},{"id":37908,"word":"自出胸臆","pinyin":"zì chū xiōng yì","abbr":"zcxy","explanation":"臆：胸。出自自己心意。指与众不同的个人见解、旨趣","source":{"text":"郭恕先、米元章之流，往往于绳墨之外，自出胸臆。","book":"清·汪琬《吴道贤诗小序》"},"similar":["自出新意"],"usage":"作谓语、定语；用于书面语"},{"id":37909,"word":"自利利他","pinyin":"zì lì lì tā","abbr":"zllt","explanation":"自利：以利己为主的修养；利他：以利他人为目的的行为。佛教自称修身的最终目的，是完成自他二利，人人成佛。借指对己对人都有好处","source":{"text":"自利利他，法皆具足。","book":"《佛遗教经·众生得度》"},"usage":"作宾语、定语；用于书面语"},{"id":37910,"word":"自刽以下","pinyin":"zì kuài yǐ xià","abbr":"zgyx","explanation":"刽：西周时的诸侯国名。从刽以下的乐曲就不加评论。比喻从某某以下就不值得一提。","source":{"text":"为之歌陈，曰：‘国无主，其能久乎？’自刽以下无讥焉。","book":"《左传·襄公二十九年》"},"example":{"text":"衰世之言，亡国之音，等之～可也。","book":"清·王棻《答王子裳书》"}},{"id":37911,"word":"自力更生","pinyin":"zì lì gēng shēng","abbr":"zlgs","explanation":"更生：再次获得生命，比喻振兴起来。指不依赖外力，靠自己的力量重新振作起来，把事情办好。","source":{"text":"中国不但会自力更生，而且也就能解除其他国家维护中国的独立与完整的麻烦。","book":"孙中山《中国问题的真解决》"},"example":{"text":"放在自己力量的基础上，叫做～。","book":"毛泽东《抗日战争胜利后的时局和我们的方针》"},"similar":["自食其力","独立自主","自给自足"],"opposite":["仰人鼻息","寄人篱下"],"usage":"作谓语、宾语、定语；指靠自己","story":["西汉人严安为劝谏汉武帝不要穷兵黩武，北犯匈奴，陈述了秦王朝兴亡的教训，他说：“秦王蚕室天下，并吞六国称皇帝，统治全国，取消诸侯，消灭他们的兵力，使国内百姓避免战乱，可以自力更生，这是百姓所渴望得到的。”"]},{"id":37912,"word":"自动自觉","pinyin":"zì dòng zì jué","abbr":"zdzj","explanation":"自己主动去做。","example":{"text":"请～地缴纳会费。"},"usage":"作宾语、定语、状语；用于处事"},{"id":37913,"word":"自卖自夸","pinyin":"zì mài zì kuā","abbr":"zmzk","explanation":"夸：夸赞。自己卖的东西自己夸好。比喻为自己吹嘘。","source":{"text":"国民党人又嚷‘罗邱视线移到东方了，先欧后亚计划改变了’……还要自卖自夸地乐一阵。","book":"毛泽东《评国民党十一中全会和三届二次国民参政会》"},"example":{"text":"你这是～。"},"similar":["自我吹嘘"],"opposite":["谦虚谨慎"],"usage":"作谓语、宾语；指自我吹嘘"},{"id":37914,"word":"自厝同异","pinyin":"zì cuò tóng yì","abbr":"zcty","explanation":"指自找矛盾，互相不和。","source":{"text":"卿忘廉、蔺、寇、贾之事邪？吾本以济国活家，岂计彼此之升降。且我能下彼，彼必不能下我，共济艰难，岂可自厝同异。","book":"《宋书·沈攸之传》"},"usage":"作谓语、定语；用于书面语"},{"id":37915,"word":"自反无愧","pinyin":"zì fǎn wú kuì","abbr":"zfwk","explanation":"摸着胸口自问，毫无惭愧之处。","source":{"text":"才做圣人自反无愧说时，便小了圣人。","book":"宋·朱熹《论语集注·述而》"},"example":{"text":"只为～，理直气壮，昂昂的步到颜家门首。","book":"明·冯梦龙《醒世恒言》卷七"}},{"id":37916,"word":"自取其咎","pinyin":"zì qǔ qí jiù","abbr":"zqqj","explanation":"咎：罪过，祸害。自己造成灾祸或自己找罪受。","source":{"text":"富贵而骄，自遗其咎。","book":"老子《道德经》"},"example":{"text":"想当时因得罪于荆公，～。（明·冯梦龙《警世通言》卷三）"},"similar":["作茧自缚","自讨苦吃","自作自受"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语；指自找的麻烦"},{"id":37917,"word":"自取其殃","pinyin":"zì qǔ qí yāng","abbr":"zqqy","explanation":"自己招来祸事","source":{"text":"也终防别生事故，休迟缓自取其殃。","book":"元·无名氏《连环计》第一折"},"similar":["自取其祸"],"usage":"作谓语、定语、宾语；用于处事"},{"id":37918,"word":"自取其祸","pinyin":"zì qǔ qí huò","abbr":"zqqh","explanation":"取：取得；祸：祸事。自己招来祸事。","source":{"text":"故门高之弑，乐器之焚，亦是自取其祸也。","book":"宋·无名氏《新编五代史平话·唐史》卷下"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第56回：“可笑世上那些谋杀亲夫的，我看他们都是～。”"},"similar":["自取其殃"],"usage":"作谓语、定语、宾语；用于处事"},{"id":37919,"word":"自取咎戾","pinyin":"zì qǔ jiù lì","abbr":"zqjl","explanation":"指自招罪过。同“自取罪戾”。","source":{"text":"目下大敌当前，万不可再事疏忽，自取咎戾！","book":"杨玉如《辛亥革命先著记》第六章"},"similar":["自取罪戾"],"usage":"作谓语、定语、宾语；用于处事"},{"id":37920,"word":"自取富贵","pinyin":"zì qǔ fù guì","abbr":"zqfg","explanation":"以自己的力量来获取荣华富贵","source":{"text":"北齐高昴曰：‘男儿当横行天下，自取富贵。’","book":"宋·祝穆《事文类聚·别集》"},"usage":"作谓语、定语；用于处事"},{"id":37921,"word":"自取灭亡","pinyin":"zì qǔ miè wáng","abbr":"zqmw","explanation":"所作所为把自己引上绝路。","source":{"text":"沉水入火，自取灭亡。","book":"《阴符经》卷下"},"example":{"text":"倭兵犯顺，～。","book":"清·陈忱《水浒后传》第三十五回"},"similar":["自投罗网","作法自毙","玩火自焚"],"opposite":["置人死地"],"usage":"作谓语、定语；指自己找死"},{"id":37922,"word":"自取罪戾","pinyin":"zì qǔ zuì lì","abbr":"zqzl","explanation":"指自招罪过。亦作“自取咎戾”。","source":{"text":"岂不知元帅虎威，马到成功？焉敢复生贰心，自取罪戾。","book":"清·陈忱《水浒后传》第十二回"},"similar":["自取咎戾"],"usage":"作谓语、定语、宾语；用于处事"},{"id":37923,"word":"自受自作","pinyin":"zì shòu zì zuò","abbr":"zszz","explanation":"受：承受。自己做了蠢事坏事，自己受累","source":{"text":"岂不闻天网恢恢，也是我自受自作。","book":"元·李致远《还牢末》第二折"},"similar":["自作自受","自做自当"],"usage":"作谓语、宾语；指自食其果"},{"id":37924,"word":"自古东丁","pinyin":"zì gǔ dōng dīng","abbr":"zgdd","explanation":"东丁：象声词，石洞中泉水下滴的声音。比喻某件事情自古以来都是一个老规矩","source":{"text":"汉嘉城西北山麓有一石洞，泉出其间，时闻洞中泉滴声，良久一滴，清如金石，黄鲁直题诗云：‘古人题作东丁水，自古东丁直到今。’","book":"宋·陆游《老学庵笔记》"},"usage":"作宾语、定语；用于书面语"},{"id":37925,"word":"自同寒蝉","pinyin":"zì tóng hán chán","abbr":"zthc","explanation":"寒蝉：冬天的蝉。自己同寒天的蝉一样不鸣。比喻缄默不语。","source":{"text":"刘胜位为大夫，见礼上宾，而知善不荐，闻恶无言，隐情惜己，自同寒蝉，此罪人也。","book":"《后汉书·杜密传》"},"usage":"作谓语、定语；用于书面语"},{"id":37926,"word":"自吹自捧","pinyin":"zì chuī zì pěng","abbr":"zczp","explanation":"自我吹嘘，自己捧场。","source":{"text":"我看外国人对于这些事，非常模胡，而所谓‘大师’、‘学者’之流，则一味自吹自捧，绝不可靠。","book":"鲁迅《书信集·致姚克》"},"example":{"text":"靠～是不能成事的。"},"similar":["自吹自擂"],"opposite":["谦虚谨慎"],"usage":"作谓语、宾语、定语；指自我吹捧"},{"id":37927,"word":"自吹自擂","pinyin":"zì chuī zì léi","abbr":"zczl","explanation":"擂：打鼓。自己吹喇叭，自己打鼓。比喻自我吹嘘。","source":{"text":"决不可把自己关在小房子里，自吹自擂，称王称霸。","book":"毛泽东《在陕甘宁边区参议会的演说》"},"example":{"text":"魏紫一听，就知道他是～，却也暗中后悔。","book":"徐迟《牡丹》"},"similar":["自我吹嘘","自卖自夸","大言不惭"],"opposite":["实事求是","谦虚谨慎","虚怀若谷"],"usage":"作谓语、定语、状语；指自我吹嘘"},{"id":37928,"word":"自告奋勇","pinyin":"zì gào fèn yǒng","abbr":"zgfy","explanation":"告：称说，表示。主动要求担任某项艰巨的任务。","source":{"text":"这饶守原本只有这一个狮子国；因为上头提倡游学，所以他自告奋勇，情愿自备资斧，叫儿子出洋。","book":"清·李宝嘉《官场现形记》第五十三回"},"example":{"text":"好心的渔户～，选拔了五十多名上等青年猎手，披弓带箭前去寻找。","book":"曲波《林海雪原》三十六"},"similar":["毛遂自荐","挺身而出"],"opposite":["畏首畏尾","畏葸不前"],"usage":"作谓语、宾语、状语；指主动要求","story":["唐僧师徒去西天取经来到西梁女国，从国王到臣民都引起一场骚动，为了换取公文，他们住进了驿堂，国王派女官来请他们师徒，说要与唐僧成亲。猪八戒抵御不了诱惑，就自告奋勇要留下成亲，被唐僧制止，他们用计骗取公文离开女儿国"]},{"id":37929,"word":"自命不凡","pinyin":"zì mìng bù fán","abbr":"zmbf","explanation":"自命：自认为；凡：平凡。自以为不平凡，比别人高明。","source":{"text":"大洪杨先生涟，微时为楚名儒，自命不凡。","book":"清·蒲松龄《聊斋志异·杨大洪》"},"example":{"text":"娄县沈童者，年甫冠，习帖括，～，有太阿出匣遽化长虹之概。","book":"清·淮阴百一居士《壶天录》"},"similar":["自高自大","惟我独尊","孤芳自赏"],"opposite":["自惭形秽","自愧不如","虚怀若谷"],"usage":"作谓语、定语；指清高"},{"id":37930,"word":"自命清高","pinyin":"zì mìng qīng gāo","abbr":"zmqg","explanation":"命：认为。自以自为清高。","source":{"text":"还自命清高，反说富贵的是俗人。","book":"清·吴趼人《二十年目睹之怪现状》第22回"},"example":{"text":"这种人～，以为公司非他不能运作。"},"similar":["自命不凡","洁身自好","孤芳自赏"],"opposite":["沽名钓誉","好大喜功","同流合污"],"usage":"作谓语、宾语、定语；指自以为是"},{"id":37931,"word":"自圆其说","pinyin":"zì yuán qí shuō","abbr":"zyqs","explanation":"圆：圆满，周全。指说话的人能使自己的论点或谎话没有漏洞。","source":{"text":"以世俗之情遇意外之事，实难自圆其说。","book":"清·方玉润《星烈日记》七十"},"example":{"text":"哈哈，单于殿下，你自己都不能～了吧。","book":"曹禺《王昭君》第五幕"},"similar":["无懈可击","滴水不漏","天衣无缝"],"opposite":["自相矛盾","漏洞百出","破绽百出"],"usage":"作谓语、宾语、定语；指不露破绽","story":["清军管带萧长贵率军船巡海时遇上海盗，外国兵船帮助捕获13名海盗交中国处理，南京制台马上与候补道史其祥处理。史其祥坚决主张中国方面行使主权，见制台大人不悦，只得自圆其说，中国方面处理几个首犯，其他人交外国方面处理"]},{"id":37932,"word":"自在逍遥","pinyin":"zì zài xiāo yáo","abbr":"zzxy","explanation":"无拘无束，安闲自得。","source":{"text":"逍遥自在蒙庄子，汉主徒言河上公。","book":"唐·赵彦昭《奉和圣制幸韦嗣立山庄应制》"},"example":{"text":"八德池边，谈讲三乘大法；七宝林下，任你～。","book":"明·许仲琳《封神演义》第六十一回"},"similar":["逍遥自在"],"usage":"作谓语、定语、状语；用于人"},{"id":37933,"word":"自坏长城","pinyin":"zì huài cháng chéng","abbr":"zhcc","explanation":"比喻自己削弱自己的力量或自己破坏自己的事业。","source":{"text":"乃坏汝万里长城。","book":"《南史·檀道济传》"},"example":{"text":"我们不能～。"},"similar":["自毁长城"],"usage":"作谓语、定语、宾语；指自己破坏"},{"id":37934,"word":"自备资斧","pinyin":"zì bèi zī fǔ","abbr":"zbzf","explanation":"资斧：旅费、盘缠。指自己准备旅费","source":{"text":"因为上头提倡游学，所以他自告奋勇，情愿自备资斧，叫儿子出洋。","book":"清·李宝嘉《官场现形记》第53回"},"usage":"作谓语、定语；用于书面语"},{"id":37935,"word":"自奉菲薄","pinyin":"zì fèng fěi bó","abbr":"zffb","explanation":"奉：信奉。指奉行节俭，对物质生活无所要求。","source":{"text":"贤君之治国，其政平，其吏不苛，其赋敛节，其自奉薄。","book":"汉·刘向《说苑·政理》"},"example":{"text":"君少力田，～，性介特，为巧黠者所嗤笑，然不为意。","book":"明·归有光《永平张封君墓志铭》"}},{"id":37936,"word":"自始自终","pinyin":"zì shǐ zì zhōng","abbr":"zszz","explanation":"从开始到末了。表示一贯到底。","source":{"text":"先皇帝与汴军校战，自始至终，马数才万。今有铁马三万五千，不能使九州混一，是吾养卒练士将帅之不至也。","book":"宋·孙光宪《北梦琐言》卷二十"}},{"id":37937,"word":"自始至终","pinyin":"zì shǐ zhì zhōng","abbr":"zszz","explanation":"从开始到末了。表示一贯到底。","source":{"text":"先皇帝与汴军校战，自始至终，马数才万。今有铁马三万五千，不能使九州混一，是吾养卒练士将帅之不至也。","book":"宋·孙光宪《北梦琐言》卷二十"},"example":{"text":"～，秀莲唱得很拘谨，好像并不想取悦听众。","book":"老舍《鼓书艺人》五"},"similar":["从头到尾","始终如一","始终不渝"],"opposite":["有始无终","有头无尾","虎头蛇尾"],"usage":"作定语、状语；表示始终如一"},{"id":37938,"word":"自媒自衒","pinyin":"zì méi zì xuàn","abbr":"zmzx","explanation":"自我介绍，自我夸耀。","source":{"text":"夫自媒自衒，诚哉可鄙；自誉自伐，实在可羞。","book":"《梁书·萧昱传》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":37939,"word":"自学成才","pinyin":"zì xué chéng cái","abbr":"zxcc","explanation":"靠自学而成为有用的人才。","source":{"text":"‘文化大革命’前大专学校毕业的和自学成才达到同等水平的知识分子，总有几百万吧。","book":"邓小平《前十年为后十年做好准备》"},"usage":"作谓语、宾语、定语；用于人"},{"id":37940,"word":"自家撞著","pinyin":"zì jiā zhuàng zháo","abbr":"zjzz","explanation":"自家：自己；著：着。自己的言行前后矛盾","source":{"text":"须弥山高不见岭，大海水深不见底。簸土扬尘无处寻，回头撞著自家底。","book":"《禅林类聚·看经门》"},"usage":"作宾语、定语；用于书面语"},{"id":37941,"word":"自寻死路","pinyin":"zì xún sǐ lù","abbr":"zxsl","explanation":"指自己走上毁灭的道路。","source":{"text":"他们的事情是并不美妙的，他们将得到一个自寻死路的前途。","book":"毛泽东《新民主主义论》"},"example":{"text":"这样做就是～。"},"similar":["自寻短见","自取灭亡"],"usage":"作谓语、宾语、定语；指自取灭亡"},{"id":37942,"word":"自寻烦恼","pinyin":"zì xún fán nǎo","abbr":"zxfn","explanation":"自找的烦闷苦恼。意思是，本来不该有烦闷苦恼。","source":{"text":"每天好好的，你必是自寻烦恼，哭一会子，才算完了这一天的事。","book":"清·曹雪芹《红楼梦》第49回"},"example":{"text":"我这是～。"},"similar":["自找麻烦"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语；指自己找麻烦","story":["大观园里来了很多客人，林黛玉与新来的宝钗之妹薛宝琴十分要好，两人十分默契。史湘云与贾宝玉经常找她们两个玩，并谈论一些典故事例，黛玉一时想起自己没有亲人，就放声大哭，宝玉笑她自寻烦恼，众人纷纷劝慰"]},{"id":37943,"word":"自寻短见","pinyin":"zì xún duǎn jiàn","abbr":"zxdj","explanation":"清·曹雪芹《红楼梦》第66回：“人家并没有威逼他，是他自寻短见。”","source":{"text":"人家并没有威逼他，是他自寻短见。","book":"清·曹雪芹《红楼梦》第66回"},"example":{"text":"社会压力日益增加，～的人越来越多了。"},"similar":["自寻死路"],"usage":"作谓语、宾语、定语；指自取灭亡","story":["贾琏听从尤三姐的意见，外出公干时遇到薛蟠与柳湘莲。贾琏极力向柳湘莲推荐尤三姐，薛蟠也主张亲上加亲，柳湘莲同意这门亲事并拿出定情礼物托贾琏带回。几个月后柳湘莲听说尤三姐与姐夫有染要退亲，尤三姐当场自寻短见死了，柳湘莲也出家为僧"]},{"id":37944,"word":"自崖而反","pinyin":"zì yá ér fǎn","abbr":"zyef","explanation":"崖：崖岸；反：通“返”，回。旧时送行辞。","source":{"text":"君其涉于江而浮于，望之而不见其崖，愈往而不知其所穷，送君者皆自崖而反，君自此远矣","book":"《庄子·山木》"},"usage":"作谓语；指送行辞"},{"id":37945,"word":"自己人","pinyin":"zì jǐ rén","abbr":"zjr","explanation":"自己一方的人。指自家人或圈内人。","source":{"text":"自己人之间，什么臭架子、坏脾气都行；笑容愈亲密，礼貌愈周到，彼此的猜忌或怨恨愈深。","book":"钱钟书《围城》"},"example":{"text":"你不能把～也牵连进来。"},"similar":["自家人"],"usage":"作宾语、定语；用于口语"},{"id":37946,"word":"自弃自暴","pinyin":"zì qì zì bào","abbr":"zqzb","explanation":"指自甘堕落，不求进取。同“自暴自弃”。","source":{"text":"凡为血气所移者，皆是自弃自暴之人耳。","book":"《朱子语类》卷一百四"},"example":{"text":"宋·朱熹《朱子语类》第104卷：“凡为血气所移者，皆是～之人耳。”"},"similar":["自暴自弃","自甘暴弃"],"usage":"作谓语、定语；指人的性格"},{"id":37947,"word":"自强不息","pinyin":"zì qiáng bù xī","abbr":"zqbx","explanation":"自强：自己努力向上；息：停止。自觉地努力向上，永不松懈。","source":{"text":"天行健，君子以自强不息。","book":"《周易·乾》"},"example":{"text":"一个国家要想强盛，必须要有～的精神。"},"similar":["发愤图强","励精图治","卧薪尝胆"],"opposite":["自暴自弃","自轻自贱","心灰意懒"],"usage":"作谓语、宾语、状语；指人的决心"},{"id":37948,"word":"自律甚严","pinyin":"zì lǜ shèn yán","abbr":"zlsy","explanation":"自律：自己约束自己。对自己要求极为严格","source":{"text":"自律甚严，其待人则宽。","book":"《金史·杨云翼传》"},"similar":["严于律己"],"opposite":["放荡不羁"],"usage":"作谓语、定语；用于处事"},{"id":37949,"word":"自得其乐","pinyin":"zì dé qí lè","abbr":"zdql","explanation":"自己能从中得到乐趣。","source":{"text":"白翎雀生于乌桓朔漠之地，雌雄和鸣，自得其乐。","book":"明·陶宗仪《辍耕录》卷二十"},"example":{"text":"老头儿有个老伴儿，带一个伙计，就这么活着，倒也～。","book":"朱自清《杂文遗集·蒙自杂记》"},"similar":["悠闲自得","逍遥自在","悠哉游哉"],"opposite":["自找苦吃","自作自受","忧天悯人"],"usage":"作谓语、定语、状语；指人能安闲"},{"id":37950,"word":"自怨自艾","pinyin":"zì yuàn zì yì","abbr":"zyzy","explanation":"怨：怨恨，悔恨；艾：割草，比喻改正错误。原意是悔恨自己的错误，自己改正。现在只指悔恨自己的错误。","source":{"text":"太甲悔过，自怨自艾。","book":"《孟子·万章上》"},"example":{"text":"但倘有不知道～的人，想将这位先生“送进疯人院”去，我可要拚命反对，尽力呼冤的。","book":"鲁迅《集外集·“音乐”》"},"similar":["悔不当初","引咎自责"],"opposite":["怨天尤人"],"usage":"作谓语、状语、定语；指悔恨自己的错误","story":["战国时期，孟子的学生万章对一些历史事件有所怀疑，问汤的贤相伊尹帮助汤统一天下是否正确。孟子说伊尹帮助汤统一天下后一直在辅佐朝政，汤的孙子太甲破坏法度被伊尹流放到相邑。三年后太甲悔过自新，伊尹迎接他回来做王"]},{"id":37951,"word":"自恃其才","pinyin":"zì shì qí cái","abbr":"zsqc","explanation":"侍：依赖；其：他的。自己仗着有才能。形容高傲，自负","source":{"text":"他也自恃其才，没有一个人看得入眼，所以缙绅之门，绝不去走，文字之交，也没有人。","book":"明·冯梦龙《喻世明言》第12卷"},"usage":"作谓语、定语；用于处事"},{"id":37952,"word":"自惊自怪","pinyin":"zì jīng zì guài","abbr":"zjzg","explanation":"自己觉得又害怕又惊异","source":{"text":"晴雯笑道：‘也不用我唬去，这小蹄子已经自惊自怪的了。’","book":"清·曹雪芹《红楼梦》第52回"},"usage":"作谓语、定语、状语；用于处事"},{"id":37953,"word":"自惜羽毛","pinyin":"zì xī yǔ máo","abbr":"zxym","explanation":"比喻为珍惜自己的名声","example":{"text":"我一向都～"},"similar":["爱惜羽毛"],"usage":"作谓语、定语；比喻珍惜自己的名声"},{"id":37954,"word":"自惟至熟","pinyin":"zì wéi zhì shú","abbr":"zwzs","explanation":"惟：思、想。自己考虑得已非常成熟","source":{"text":"朝廷有法，自惟至熟，有必不堪者七，甚不可者二。","book":"三国·魏·嵇康《与山巨源绝交书》"},"usage":"作谓语、定语；用于书面语"},{"id":37955,"word":"自惭形秽","pinyin":"zì cán xíng huì","abbr":"zcxh","explanation":"形秽：形态丑陋，引伸为缺点。因为自己不如别人而感到惭愧。","source":{"text":"珠玉在侧，觉我形秽。","book":"南朝宋·刘义庆《世说新语·容止》"},"example":{"text":"她～般只呆在一个黑暗的角落里，不敢发一言。","book":"杨沫《青春之歌》第一部第十一章"},"similar":["妄自菲薄","自暴自弃","自愧不如"],"opposite":["妄自尊大","自高自大","目空一切"],"usage":"作谓语、定语、宾语；指自愧不如","story":["晋朝时期，骠骑将军王济相貌英俊，待人接物很有风度，学问也好，成为全城中心人物。王济的外甥卫玠前来投靠他。卫玠长得眉清目秀、风度翩翩。王济见了觉得自惭形秽。大家与卫玠谈论玄理，卫玠说的头头是道，精深透彻"]},{"id":37956,"word":"自愧不如","pinyin":"zì kuì bù rú","abbr":"zkbr","explanation":"弗：不。自己惭愧不如别人。","source":{"text":"明日徐公来，熟视之，自以为不如。","book":"《战国策·齐策一》"},"example":{"text":"在那地方，圣裔们繁殖得非常多，成着使释迦牟怪和苏格拉底都～的特权阶级。","book":"鲁迅《且介亭杂文二集·在现代中国的孔夫子》"},"similar":["自惭形秽","妄自菲薄","自暴自弃"],"opposite":["自鸣得意","自高自大","自以为是"],"usage":"作谓语、宾语；表示自卑"},{"id":37957,"word":"自愧弗如","pinyin":"zì kuì fú rú","abbr":"zkfr","explanation":"自感不如别人而内心惭愧。","source":{"text":"妻亦心贤之，然自愧弗如，积惭成忌。","book":"清·蒲松龄《聊斋志异·邵九娘》"},"example":{"text":"在那地方，圣裔们繁殖得非常多，成着使释迦牟尼和苏格拉第都～的特权阶级。","book":"鲁迅《且介亭杂文二集·在现代中国的孔夫子》"},"similar":["自愧不如"],"opposite":["信心十足"],"usage":"作谓语、宾语；表示自卑","story":["战国时期，齐国大臣邹忌身高八尺，容貌漂亮，他穿上华丽的衣服问自己的妻子，自己与城北美男徐公谁美？妻子与妾都说他最美。第二天又问家里的来客，客人也是如此说。然而城北徐公来了，邹忌照了照镜子，感到自愧弗如"]},{"id":37958,"word":"自成一家","pinyin":"zì chéng yī jiā","abbr":"zcyj","explanation":"指在某一方面的学问或技术有独到的见解或独特的做法，能自成体系。","source":{"text":"作文须自出机杼，成一家风骨。","book":"《北史·祖莹传》"},"example":{"text":"乃公之文章，则～，足以千秋不朽。","book":"清·无名氏《杜诗言志》卷十二"},"similar":["自出一家","独树一帜"],"opposite":["身无长技"],"usage":"作谓语；指独特的见解"},{"id":37959,"word":"自成一格","pinyin":"zì chéng yī gé","abbr":"zcyg","explanation":"指形成自己独特的风格。","source":{"text":"香山于古诗律诗中，又多创体，自成一格。","book":"清·赵翼《瓯北诗话·白香山诗》"},"example":{"text":"自然，各人的做法不尽同……办得各有特色，～。","book":"《新华日报》1943.3.5"},"usage":"作谓语、定语；用于书面语"},{"id":37960,"word":"自成机杼","pinyin":"zì chéng jī zhù","abbr":"zcjz","explanation":"机杼：织机和梭子。比喻写文章能创造出新的风格和体裁","source":{"text":"套词连章，自成机杼。","book":"姚华《曲海一勺》"},"similar":["自出机杼","自出机轴","别出机杼"],"usage":"作谓语、定语；用于文章"},{"id":37961,"word":"自我作古","pinyin":"zì wǒ zuò gǔ","abbr":"zwzg","explanation":"作古：创始。由我创造。指不沿袭前人。","source":{"text":"唯魏收远不师古，近非因俗，自我作故，无所宪章。","book":"唐·刘知己《史通·称谓》"},"example":{"text":"康乐称太傅为宗衮，子建称孟德为家王，皆～。","book":"清·平步青《霞外捃屑》卷五"},"similar":["标新立异","独树一帜","独辟蹊径"],"opposite":["因循守旧","墨守成规","蹈常袭故"],"usage":"作谓语、宾语；指自己创造"},{"id":37962,"word":"自我作故","pinyin":"zì wǒ zuò gù","abbr":"zwzg","explanation":"作故：创始。由我创造。指不沿袭前人。","source":{"text":"唯魏收远不师古，近非因俗，自我作故，无所宪章。","book":"《国语·鲁语上》：“宗人夏父展曰：‘非故也。’公曰：‘君作故。’”唐·刘知己《史通·称谓》"},"example":{"text":"唯魏收远不师古，近非因俗，～，无所宪章。","book":"唐·刘知己《史通·称谓》"},"similar":["自我作古"],"opposite":["墨守成规"],"usage":"作谓语、宾语；指自己创新"},{"id":37963,"word":"自我作祖","pinyin":"zì wǒ zuò zǔ","abbr":"zwzz","explanation":"自：从，由。由我创新，不循旧法。指不因袭前人旧例，有所创新","source":{"text":"譬如以三家村学究口号歪诗拟《康衢》、《击壤》，谓‘自我作祖，出口成章’，岂不可笑！","book":"明·凌濛初《谭剧杂札》"},"similar":["自我作故","自我作古"],"usage":"作谓语、宾语；指自己创新"},{"id":37964,"word":"自我吹嘘","pinyin":"zì wǒ chuí xū","abbr":"zwcx","explanation":"比喻自我吹嘘、夸张。","example":{"text":"他本身是报纸编辑，因此每作新诗词必在报纸上～，俨然以当代文豪自居。"},"similar":["自卖自夸"],"usage":"作谓语、宾语；指自吹自擂"},{"id":37965,"word":"自我安慰","pinyin":"zì wǒ ān wèi","abbr":"zwaw","explanation":"指自己安慰自己。","source":{"text":"我看没有这种自我安慰的根据。","book":"邓小平《会见香港特别行政区基本法起草委员会委员时的讲话》"},"example":{"text":"我只是～罢了。"},"similar":["聊以自慰"],"usage":"作谓语、宾语、定语；指自己安慰自己"},{"id":37966,"word":"自我崇拜","pinyin":"zì wǒ chóng bài","abbr":"zwcb","explanation":"指自己崇拜自己，盲目自大。","example":{"text":"我们不要搞～。"},"similar":["个人崇拜"],"usage":"作谓语、宾语；指自高自大"},{"id":37967,"word":"自我得之，自我失之","pinyin":"zì wǒ dé zhī，zì wǒ shī zhī","abbr":"zwdzzwsz","explanation":"从我手里得到的东西，又从我手里失去。比喻兴败无常或得失相抵","source":{"text":"高祖叹曰：‘自我得之，自我失之，亦复何恨。’","book":"《梁书·邵陵王纶传》"},"similar":["自我得之，自我捐之"],"usage":"作宾语、定语；用于处事"},{"id":37968,"word":"自我得之，自我捐之","pinyin":"zì wǒ dé zhī，zì wǒ juān zhī","abbr":"zwdzzwjz","explanation":"捐：舍弃，抛弃。从我手里得到的东西，又从我手里失去。比喻兴败无常或得失相抵","source":{"text":"魏其侯曰：‘侯，自我得之，自我捐之，无所恨。’","book":"西汉·司马迁《史记·魏其武安侯列传》"},"similar":["自我得之，自我失之"],"usage":"作宾语、定语；用于处事"},{"id":37969,"word":"自我批评","pinyin":"zì wǒ pī píng","abbr":"zwpp","explanation":"自己批判自己的缺点等。","source":{"text":"我们不但要有自我批评的精神，还要有批评的精神。","book":"邓小平《在北方局党校整风动员会上的讲话》"},"example":{"text":"王朔《我是你爸爸》：“他只好也同时开展～似乎只有这样才能安抚父亲告慰自己。”"},"usage":"作谓语、宾语、定语；用于处事"},{"id":37970,"word":"自我标榜","pinyin":"zì wǒ biāo bǎng","abbr":"zwbb","explanation":"标榜：吹嘘，夸耀。自己吹嘘自己。","example":{"text":"他特别喜欢～。"},"similar":["自我吹嘘"],"usage":"作谓语、宾语、定语；指自己吹自己"},{"id":37971,"word":"自我欣赏","pinyin":"zì wǒ xīn shǎng","abbr":"zwxs","explanation":"指自己欣赏自己。","source":{"text":"韩丽婷端着两盘拌好的凉菜出来，放在餐桌上，自我欣赏着：‘色香还是挺勾人食欲的吧？","book":"王朔《无人喝彩》"},"example":{"text":"要学会～自己。"},"similar":["自我陶醉"],"usage":"作谓语、宾语；指自己欣赏自己"},{"id":37972,"word":"自我牺牲","pinyin":"zì wǒ xī shēng","abbr":"zwxs","explanation":"为别人（或事)牺牲自己。","source":{"text":"我对松树怀有敬意的更重要的原因却是它那种自我牺牲的精神。","book":"陶铸《松树的风格》"},"example":{"text":"中华民族富于～的传统精神，在无数民族，革命先烈身上都可得到印证。"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":37973,"word":"自我表现","pinyin":"zì wǒ biǎo xiàn","abbr":"zwbx","explanation":"显示或宣扬自己的优点，使自己突出。","source":{"text":"现代文艺里‘自我表现’，之特多，原是当然的道理。","book":"苏雪林《郁达夫及其作品》"},"example":{"text":"他好～。"},"similar":["自我吹嘘"],"usage":"作谓语、宾语；指表现自己"},{"id":37974,"word":"自我解嘲","pinyin":"zì wǒ jiě cháo","abbr":"zwjc","explanation":"用言语或行动为自己掩盖或辩解被人嘲笑的事。","source":{"text":"居然没有上火，反而自我解嘲地说：‘年轻人，可别火气太盛！你们就是吃了这个亏！’","book":"郁彦《闽西一老人》"},"example":{"text":"人关键时刻得～，给自己台阶下。"},"similar":["自作聪明"],"usage":"作谓语、宾语；指自我解围"},{"id":37975,"word":"自我陶醉","pinyin":"zì wǒ táo zuì","abbr":"zwtz","explanation":"陶醉：沉醉于某种事物或境界里，以求得内心的安慰。指盲目地自我欣赏。","source":{"text":"且欲近寻彭泽宰，陶然共醉菊花杯。。","book":"唐·崔曙《九日登望仙台》诗"},"example":{"text":"学习有了进步时，决不能沾沾自喜，～。"},"similar":["自鸣得意","自得其乐","沾沾自喜"],"opposite":["若有所失","自惭形秽"],"usage":"作谓语、定语；指自己欣赏"},{"id":37976,"word":"自找麻烦","pinyin":"zì zhǎo má fán","abbr":"zzmf","explanation":"自己给自己找麻烦事。","source":{"text":"我事先知道您是警察，我还会砸你房门吗？我不是自找麻烦吗？","book":"王朔《人莫予毒》"},"example":{"text":"你这不是～吗？"},"similar":["自讨苦吃"],"usage":"作谓语、宾语；指自讨苦吃"},{"id":37977,"word":"自投于地","pinyin":"zì tóu yú dì","abbr":"ztyd","explanation":"投：抛掷。自己一下子仆伏在地上","source":{"text":"盗大惊，自投于地，稽顺归罪。","book":"南朝·宋·范晔《后汉书·陈寔传》"},"example":{"text":"宋·王谠《唐语林·雅量》：“元载之败，其女资敬寺尼真一纳于掖庭。德宗即位，召至一别殿，告其父死。真一～，右右皆叱。”"},"usage":"作谓语、定语；用于书面语","story":["东汉灵帝时小官吏陈寔心地善良，做事公正无私。有天晚上一个小偷溜进他的屋里躲在屋梁上，他发现后并没有下令捉拿，而是把儿子、孙子叫到身边，给他们讲如何做人，不要学梁上的那位君子。小偷深受感动就下地求饶。陈寔给钱放他回"]},{"id":37978,"word":"自投网罗","pinyin":"zì tóu wǎng luó","abbr":"ztwl","explanation":"投：进入。比喻自己进入圈套送死","source":{"text":"丈夫与其自投网罗，为天下笑，曷若相与戮力同心，赴蹈汤火，岂徒脱祸，兼富贵可求。","book":"宋·司马光《资治通鉴·唐懿宗咸通九年》"},"similar":["自投罗网"],"usage":"作谓语、定语、宾语；指自己送死"},{"id":37979,"word":"自投罗网","pinyin":"zì tóu luó wǎng","abbr":"ztlw","explanation":"投：进入；罗网：捕捉鱼鸟的器具。自己投到罗网里去。比喻自己送死。","source":{"text":"譬如猎人终日驰驱践蹂于草茅之中，搜求伏兔而搏之，不待其自投于罗网而后取也。","book":"三国魏·曹植《野田黄雀行》诗：“不见篱间雀，见鹞自投罗。”宋·苏轼《策别十七·去奸民》"},"example":{"text":"凤姐故意报怨他失信，贾瑞急的起誓。凤姐因他～，少不的再寻别计令他知改。","book":"清·曹雪芹《红楼梦》第十二回"},"similar":["自取灭亡","自作自受","飞蛾扑火"],"opposite":["逃之夭夭"],"usage":"作谓语、定语、宾语；指自己送死","story":["三国时期，曹操的儿子曹植非常聪明，很有才华，受到曹操的宠爱，由于他纵酒，渐渐失去了继承王位的竞争力。曹丕当上皇帝后，就把他的好友丁仪抓了起来，名为王侯实为囚徒的曹植作《野田黄雀行》：“不见篱间雀，见鹞自投罗。”"]},{"id":37980,"word":"自投虎口","pinyin":"zì tóu hǔ kǒu","abbr":"zthk","explanation":"投：进入；虎口：比喻十分危险的处所。比喻自己进入危险的场所送死","source":{"text":"这薛刚真正胆大包天，不想生法报仇，反来祭扫铁丘坟，是自投虎口。","book":"清·如莲居士《薛刚反唐》第20回"},"similar":["自投罗网"],"usage":"作谓语、定语、宾语；指自己送死"},{"id":37981,"word":"自报公议","pinyin":"zì bào gōng yì","abbr":"zbgy","explanation":"自己报名或报出自认的情况，由群众讨论评议。","example":{"text":"我们对领导干部应建立～的制度。"},"usage":"作谓语、定语；用于公众"},{"id":37982,"word":"自报家门","pinyin":"zì bào jiā mén","abbr":"zbjm","explanation":"戏曲演员一出场先把角色的姓名、家世、来历介绍给观众。指作自我介绍。","example":{"text":"你还是～吧。"},"similar":["自我介绍"],"usage":"作谓语；指自我介绍"},{"id":37983,"word":"自拔来归","pinyin":"zì bá lái guī","abbr":"zblg","explanation":"拔：摆脱，离开。自觉离开恶劣环境，归向光明。指敌方人员投奔过来。","source":{"text":"自拔以归，从秦王伐东都，战有功。","book":"《新唐书·李勣传》"},"example":{"text":"～的将日益增多，红军扩充，又是一条来路。","book":"《毛泽东选集·井岗山的斗争》"},"similar":["弃暗投明"],"usage":"作宾语、定语；指敌方人员投奔过来","story":["隋朝末年，李勣投奔到李密部下被封为大将军。他率军攻下黎阳城，队伍迅速扩大到20万人，投降唐高祖李渊门下，被封为黎阳总管，莱国公。窦建德攻陷黎阳，抓走李勣父亲做人质，让他守黎阳。待窦建德走后他就自拔来归投奔李渊"]},{"id":37984,"word":"自掘坟墓","pinyin":"zì jué fén mù","abbr":"zjfm","explanation":"掘：挖。自己的所作所为就象在替自己挖掘坟墓一样。比喻自寻死路。","source":{"text":"便一一以手裂坏之，又画作一大人，掘地埋之，便径去。","book":"晋·葛洪《神仙传》"},"example":{"text":"就永无声响地随着这些‘假英雄’主义的符咒，向牛角尖中～？","book":"王统照《假英雄主义与牛角尖》"},"similar":["自取灭亡","自投罗网","作茧自缚"],"opposite":["自尊自爱"],"usage":"作谓语、宾语；指自寻死路","story":["三国时期，蜀主刘备准备讨伐东吴，行动前请人去找意其来占卜吉凶。意其来到后，刘备十分客气地接待他，并说明意图。意其不说话，只是在白纸上画很多兵马，一一撕碎。然后再画一个大人，在地上挖一个洞埋了。后来刘备东征失败告终"]},{"id":37985,"word":"自救不暇","pinyin":"zì jiù bù xiá","abbr":"zjbx","explanation":"解救自己都来不及。指无力再帮助他人。","source":{"text":"今残孽虽穷蹙日甚，自救不暇，尚虑其逆帅望秋高马肥之便，蓄突围拒辙之谋。","book":"唐·杜甫《为华州郭使君进灭残寇形势图状》"},"example":{"text":"子孙不肖，放且流落，～。","book":"明·朱国祯《涌幢小品·己丑馆选》"},"similar":["自顾不暇"],"usage":"作谓语、定语、状语；用于人的处境"},{"id":37986,"word":"自新之路","pinyin":"zì xīn zhī lù","abbr":"zxzl","explanation":"罪犯自己改正错误，重新做人的出路。","source":{"text":"豫悉见诸系囚，慰谕，开其自新之路，一时破械遣之。","book":"《三国志·魏志·田豫传》"},"usage":"作宾语；用于书面语"},{"id":37987,"word":"自新改过","pinyin":"zì xīn gǎi guò","abbr":"zxgg","explanation":"自新：自己重新做人。改正错误，重新做起","example":{"text":"希望你～，重新做人"},"similar":["改过自新"],"usage":"作谓语、宾语；指重新做好人"},{"id":37988,"word":"自是不彰","pinyin":"zì shì bù zhāng","abbr":"zsbz","explanation":"自是：自以为是；彰：明晰。自以为是的人则是非不明","source":{"text":"自见者不明，自是者不彰。","book":"春秋·楚·李耳《老子·道经》第24章"},"usage":"作宾语、定语；用于书面语"},{"id":37989,"word":"自暇自逸","pinyin":"zì xiá zì yì","abbr":"zxzy","explanation":"暇：空闲，闲暇；逸：安乐，安闲。自己找空闲安逸","source":{"text":"而乃自暇自逸，惟宫台是饰，必有危亡之祸矣。","book":"明·罗贯中《三国演义》第105回"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":37990,"word":"自暴自弃","pinyin":"zì bào zì qì","abbr":"zbzq","explanation":"暴：糟蹋、损害；弃：鄙弃。自己瞧不起自己，甘于落后或堕落。","source":{"text":"自暴者，不可与有言也；自弃者，不可与有为也。","book":"《孟子·离娄上》"},"example":{"text":"读书人悲观失望，～；可是那些工人却多么坚强呵，多么勇敢呵！","book":"欧阳山《苦斗》五三"},"similar":["妄自菲薄","自惭形秽"],"opposite":["自强不息","自高自大","自命不凡"],"usage":"作谓语、定语；指人的性格","story":["战国时期，孟子教导他的学生不要做自暴自弃的人，学生不明白。孟子解释道自暴就是说话不遵守礼义，自己残害自己。自弃就是心里想的不是仁义，自己抛弃自己。仁是最安适的住宅，义是最正确的道路，一切都得按仁义来办"]},{"id":37991,"word":"自有公论","pinyin":"zì yǒu gōng lùn","abbr":"zygl","explanation":"指事情的是非曲直公众自然会有评论。","source":{"text":"朝廷自有公论，汝岂可造次？","book":"南朝·宋·刘义庆《世说新语·品藻》：“扞庾公呴又问：‘何者居其右？’王曰：‘自有人。’又问：‘何者是？’王曰：‘噫！其自有公论。’”明·罗贯中《三国演义》第一回"},"example":{"text":"虽然是非曲直，～；但是现在的世人，总是人云亦云的居多。","book":"清·吴趼人 《二十年目睹之怪现状》第一百一回"},"usage":"作谓语、定语；用于口语","story":["晋朝时期，大将军王敦到了都城，中书令庾亮问他四个好友是谁？王说是庾凯、王夷甫、阿平、胡毋彦国，其中阿平最差。庾亮又问哪个最好，王敦说自然有人，庾亮要他说名字，王敦说自有公论。左右人暗中踩庾亮脚，这才没往下说"]},{"id":37992,"word":"自有肺肠","pinyin":"zì yǒu fèi cháng","abbr":"zyfc","explanation":"肺肠：引申为心思。指做事有自己的用心。含贬义。","source":{"text":"自有肺肠，俾民卒狂。","book":"《诗经·大雅·桑柔》"},"similar":["别有肺肠"],"usage":"作谓语、定语；用于书面语"},{"id":37993,"word":"自树一帜","pinyin":"zì shù yī zhì","abbr":"zsyz","explanation":"比喻单独建立一种风格、体制、派别或力量等。","source":{"text":"率皆攻排诋呵，自树一帜，殊可笑也。","book":"清·袁枚《随园诗话》卷一"},"example":{"text":"其于诗也，虽以余事及之，然亦欲求于古人之外，～。","book":"清·黄遵楷《〈人境庐诗草〉跋》"},"similar":["独树一帜"],"usage":"作谓语、定语；用于书面语"},{"id":37994,"word":"自欺欺人","pinyin":"zì qī qī rén","abbr":"zqqr","explanation":"欺骗自己，也欺骗别人。","source":{"text":"因说自欺欺人曰：欺人亦是自欺，此又是自欺之甚者。","book":"《朱子语类》"},"example":{"text":"有人说中国的实业就会借此促进，那是～之谈。","book":"鲁迅《两地书·二九》"},"similar":["掩耳盗铃","掩人耳目"],"opposite":["实事求是"],"usage":"作谓语、定语、分句；指相互欺骗"},{"id":37995,"word":"自毁长城","pinyin":"zì huǐ cháng chéng","abbr":"zhcc","explanation":"比喻自己削弱自己的力量或自己破坏自己的事业","example":{"text":"你～，怪不得我们了"},"similar":["自坏长城"],"usage":"作谓语、定语、宾语；指自己破坏"},{"id":37996,"word":"自比于金","pinyin":"zì bǐ yú jīn","abbr":"zbyj","explanation":"把自己比作尚未冶炼的黄金。比喻未成熟，急需锻炼","source":{"text":"朕方自比于金，以卿为良匠而加砺焉，卿虽疾未及衰，庸得便尔。","book":"《新唐书·魏徽传》"},"usage":"作谓语、定语；用于书面语"},{"id":37997,"word":"自求多福","pinyin":"zì qiú duō fú","abbr":"zqdf","explanation":"求助自己比求助他人会得到更多的幸福。","source":{"text":"无念尔祖，聿修厥德。永言配命，自求多福。","book":"《诗经·大雅·文王》"},"example":{"text":"中国人的自讨苦吃的根苗在于捧，‘～’之道却在于挖。","book":"鲁迅《华盖集·这个与那个》"},"usage":"作谓语、定语、宾语；用于劝诫人","story":["我国最早的诗歌总集《诗经》专门有一首诗夸颂周文王秉承了上帝的意志，灭掉殷商。文王不只荣宗耀祖，使子孙百世做天子诸侯。他的子孙要以文王的德行作为榜样，以商纣作为借鉴，要经常自我反省，勤修贤德，发奋图强，自求多福"]},{"id":37998,"word":"自然而然","pinyin":"zì rán ér rán","abbr":"zrer","explanation":"自由发展，必然这样。指非人力干预而自然如此。","source":{"text":"夫吉凶之与善恶，犹善恶之乘形声，自然而然，不得相免也。","book":"《牟子理惑篇》"},"example":{"text":"不知怎的～有一种说不出的感慨。","book":"清·文康《儿女英雄传》第18回"},"similar":["水到渠成","听其自然","大势所趋"],"opposite":["装腔作势","矫柔造作","事在人为"],"usage":"作状语；指自然形成"},{"id":37999,"word":"自爱不自贵","pinyin":"zì ài bù zì guì","abbr":"zabzg","explanation":"自爱：指有自爱、自尊之心；自贵：抬高自己。指有自爱之心而不抬高自己","source":{"text":"是以圣人自知而不自见也，自爱而不自贵也。","book":"春秋·楚·李耳《老子·德经》第72章"},"usage":"作谓语、定语；用于书面语"},{"id":38000,"word":"自甘堕落","pinyin":"zì gān duò luò","abbr":"zgdl","explanation":"自己甘心思想行为向坏的方向发展。","source":{"text":"我确实如你所说，是一个好吃懒做自甘堕落的人，是一个神经病的人。","book":"巴金《爱的十字架》"},"example":{"text":"我们不能～下去。"},"similar":["自甘落后"],"opposite":["不甘后人"],"usage":"作谓语、定语；指不自爱"},{"id":38001,"word":"自甘暴弃","pinyin":"zì gān bào qì","abbr":"zgbq","explanation":"指自甘堕落，不求进取。同“自暴自弃”。","source":{"text":"近来有一种欧化主义的人，总说中国人比西洋人所差甚远，所以自甘暴弃，说中国必定灭亡，黄种必定剿绝。","book":"章炳麟《演说录》"},"similar":["自暴自弃"],"usage":"作谓语、定语；指人的性格"},{"id":38002,"word":"自甘落后","pinyin":"zì gān luò hòu","abbr":"zglh","explanation":"甘：情愿，乐意。指自己不求上进","source":{"text":"帝国主义者的凶狠残恶，泯灭天良是一回事，但我们固步自封，自甘落后，不能日新又新的往前进取，求发展，也是不能否认的。","book":"冯玉祥《我的生活》第33章"},"similar":["自甘堕落"],"opposite":["力争上游"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38003,"word":"自生自死","pinyin":"zì shēng zì sǐ","abbr":"zszs","explanation":"自然地发生，生长，又自然地消灭。形容自然发展，无人过问","source":{"text":"宜宥而不获宥，宜诛而不及诛，是虽匹夫之幸不幸，犹蝼蚁之自生自死于天地之间，固无损于造化之功也。","book":"宋·吕皓《上孝宗皇帝书》"},"similar":["自生自灭"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":38004,"word":"自生自灭","pinyin":"zì shēng zì miè","abbr":"zszm","explanation":"自然地发生，生长，又自然地消灭。形容自然发展，无人过问。","source":{"text":"自生自灭成何事，能逐东风作雨无。","book":"唐·白居易《岭上云》诗"},"example":{"text":"新生事物，如不关心和培育，就只能是～。"},"similar":["听其自然","听天由命","听之任之"],"usage":"作谓语、宾语、定语；用于生物、文艺等"},{"id":38005,"word":"自用则小","pinyin":"zì yòng zé xiǎo","abbr":"zyzx","explanation":"自用：只凭自己的主观意图行事，不虚心向人求教。主观武断，就办不成大事。","source":{"text":"好问则裕，自用则小。","book":"《尚书·仲虺之诰》"},"usage":"作谓语、定语；用于劝诫人"},{"id":38006,"word":"自由主义","pinyin":"zì yóu zhǔ yì","abbr":"zyzy","explanation":"主张个人自由发展、自由表现的看法或人生观。","source":{"text":"但是自由主义取消思想斗争，主张无原则的和平，结果是腐朽庸俗的作风发生。","book":"毛泽东《反对自由主义》"},"example":{"text":"领导机关的放松领导和放任各种错误倾向的～，都达到相当惊人程度。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"usage":"作主语、宾语、定语；用于处世等"},{"id":38007,"word":"自由放任","pinyin":"zì yóu fàng rèn","abbr":"zyfr","explanation":"不加约束，任它自由发展。","source":{"text":"心目中没有集体生活的原则，只有自由放任。","book":"毛泽东《反对自由主义》"},"example":{"text":"我们不能～自己。"},"similar":["自由泛滥"],"usage":"作谓语、定语；指听其自然"},{"id":38008,"word":"自由散漫","pinyin":"zì yóu sǎn màn","abbr":"zysm","explanation":"不受限制和约束，不守纪律。","source":{"text":"要指出极端民主化的来源，在于小资产阶级的自由散漫性。","book":"毛泽东《关于纠正党内的错误思想》"},"usage":"作谓语、定语、状语、宾语；用于处事"},{"id":38009,"word":"自由泛滥","pinyin":"zì yóu fàn làn","abbr":"zyfl","explanation":"指某种错误的思想言行没有约束，到处扩散。","source":{"text":"但是如果我们不及时注意和采取坚定的措施加以制止，而任其自由泛滥，就会影响更多的人走上邪路，后果就不能非常严重。","book":"邓小平《党的组织战线和思想战线上的迫切任务》"},"example":{"text":"不能让这种思潮～下去。"},"similar":["泛滥成灾"],"usage":"作谓语、定语；指到处扩散"},{"id":38010,"word":"自由自在","pinyin":"zì yóu zì zài","abbr":"zyzz","explanation":"形容没有约束，十分安闲随意。","source":{"text":"问：‘牛头未见四祖时如何？’师曰：‘自由自在。’曰：‘见后如何？’师曰：‘自由自在。’","book":"宋·释道原《景德传灯录》卷二十三"},"example":{"text":"看那些交了卷出去的人真象～的仙人。","book":"叶圣陶《马铃瓜》"},"similar":["无拘无束"],"opposite":["身不由己"],"usage":"作谓语、定语；指没有约束"},{"id":38011,"word":"自留地","pinyin":"zì liú dì","abbr":"zld","explanation":"在实行农业集体化以后留给农民个人经营的少量土地。比喻自己的私人空间。","source":{"text":"他们把农村扩大了几尺自留地或犯了点其它‘资本主义’禁忌的老百姓以及小偷、赌徒和所谓的‘村盖子’、‘母老虎’，都统统……","book":"路遥《平凡的世界》第一卷第五章"},"usage":"作主语、宾语、定语；多用于口语"},{"id":38012,"word":"自相惊忧","pinyin":"zì xiāng jīng rǎo","abbr":"zxjy","explanation":"自己人互相惊动扰乱，造成不安。","source":{"text":"郑人相惊以伯有，曰：‘伯有至矣！’则皆走，不知所往。","book":"《左传·昭公七年》"},"example":{"text":"怀光闻官军大集，举烽召兵，无人肯至，就是部下将士，也～。","book":"蔡东藩《唐史演义》第六十八回"}},{"id":38013,"word":"自相惊扰","pinyin":"zì xiāng jīng rǎo","abbr":"zxjr","explanation":"自己人互相惊动，引起骚乱。","source":{"text":"郑人相惊以伯有，曰：‘伯有至矣。’则皆走，不知所往。","book":"《左传·昭公七年》"},"example":{"text":"希望我全体人民，一律安居乐业，切勿轻信谣言，～。切切此布。","book":"毛泽东《中国人民解放军布告》"},"similar":["惊魂未定","惊慌失措"],"opposite":["泰然处之","泰然自若","满不在乎"],"usage":"作谓语、宾语、定语；指自我害怕"},{"id":38014,"word":"自相戕贼","pinyin":"zì xiāng qiāng zéi","abbr":"zxqz","explanation":"戕贼：伤害，残害。自己人互相杀害。","source":{"text":"我与将军以勇力齐名，好汉惜好汉，何忍自相戕贼乎？","book":"明·冯梦龙《东周列国志》第62回"},"similar":["自相鱼肉","自相残杀","自相戕贼"],"usage":"作谓语、定语；指内部战争"},{"id":38015,"word":"自相抵牾","pinyin":"zì xiāng dǐ wǔ","abbr":"zxdw","explanation":"比喻自己说话做事前后抵触","source":{"text":"梦庵既以声闻缘觉与大乘菩萨有悲观乐观之分，而复言佛法无二、何自相抵牾至此！","book":"章炳麟《答梦庵》"},"similar":["自相矛盾"],"usage":"作谓语、定语；用于说话或文章"},{"id":38016,"word":"自相残害","pinyin":"zì xiāng cán hài","abbr":"zxch","explanation":"残：伤害。自己人互相杀害。","source":{"text":"季龙十三子，五人为冉闵所杀，八人自相残杀。","book":"《晋书·石季龙载记下》"},"example":{"text":"愚以衣冠～，乃避地河朔，与宗人李延光客于山东。","book":"《旧五代史·唐书·李愚传》"},"similar":["自相残杀","自相鱼肉","自相戕贼"],"opposite":["同仇敌忾","同舟共济","戮力同心"],"usage":"作谓语、定语；指内部战争"},{"id":38017,"word":"自相残杀","pinyin":"zì xiāng cán shā","abbr":"zxcs","explanation":"残：伤害。自己人互相杀害。","source":{"text":"季龙十三子，五人为冉闵所杀，八人自相残杀。","book":"《晋书·石季龙载记下》"},"example":{"text":"他成日间叫我们～，要我们自家人都互相杀尽了，好叫他那些骚鞑子来占据我们的好土地。","book":"清·吴趼人《痛史》第三回"},"similar":["同室操戈","煮豆燃萁","自相鱼肉"],"opposite":["同仇敌忾","同舟共济","戮力同心"],"usage":"作谓语、定语、宾语；指内部战争"},{"id":38018,"word":"自相水火","pinyin":"zì xiāng shuǐ huǒ","abbr":"zxsh","explanation":"自己人互相像水火那样不能相容。","source":{"text":"今大王所恃重臣二人，而使自相水火，非社稷之福也。","book":"《东周列国志》第九十六回"},"usage":"作谓语、定语；用于书面语"},{"id":38019,"word":"自相矛盾","pinyin":"zì xiāng máo dùn","abbr":"zxmd","explanation":"矛：进攻敌人的刺击武器；盾：保护自己的盾牌。比喻自己说话做事前后抵触。","source":{"text":"楚人有鬻盾与矛者，誉之曰：‘吾盾之坚，莫之能陷也。’又誉其矛曰：‘吾矛之利，于物无不陷也。’或曰：‘以子之矛陷子之盾，何如？’其人勿能应也。","book":"《韩非子·难一》"},"example":{"text":"这些理论～。"},"similar":["格格不入","杆格不入"],"opposite":["自圆其说","无懈可击","天衣无缝"],"usage":"作谓语、定语；用于说话或文章","story":["战国时期，大思想家韩非子曾讲有一个卖矛和盾的人，见人推销他的矛是世界上最尖利的矛，没有穿不透的东西；一会又向人推销他的盾是世界上最坚硬的盾，没有什么东西能戳穿它。人群中有人问他用他的矛戳他的盾，他只好落荒而逃"]},{"id":38020,"word":"自相践踏","pinyin":"zì xiāng jiàn tà","abbr":"zxjt","explanation":"自己人互相踩。形容军队溃败时各自仓皇逃命的狼狈情况","source":{"text":"军士自相践踏，死者无数。","book":"明·罗贯中《三国演义》第40回"},"example":{"text":"郭沫若《楚霸王自杀》：“撇们～地又踏死了几十个人。”"},"usage":"作谓语、状语；用于书面语"},{"id":38021,"word":"自相鱼肉","pinyin":"zì xiāng yú ròu","abbr":"zxyr","explanation":"鱼肉：当作鱼肉一般任意宰割。比喻内部自相残杀。","source":{"text":"今司马氏父子兄弟自相鱼肉，此天厌晋，授之与我。","book":"晋·殷仲堪《奏请巴西等三郡不戍汉中》：“关中余烬，自相鱼肉。”《晋书·刘元海载记》"},"example":{"text":"况叔孙氏君臣～，鲁之不幸，实齐之幸也。","book":"明·冯梦龙《东周列国志》第七十八回"},"similar":["同室操戈","自相残杀","自相戕贼"],"opposite":["同甘共苦","生死与共"],"usage":"作谓语、宾语；指内部战争","story":["晋朝时期，匈奴人刘渊见晋惠帝司马衷的八个亲王发生互相残杀，就在左贤王刘宣和将领的怂恿下，自己称帝。晋惠帝被祁弘赶到洛阳，刘宣阻止刘渊援救，认为司马父子兄弟自相鱼肉，可以乘机消灭他们，于是迁都平阳，准备进军洛阳"]},{"id":38022,"word":"自矜其勇","pinyin":"zì jīn qí yǒng","abbr":"zjqy","explanation":"矜：自以为贤能。自以为勇敢过人","source":{"text":"骄则自高其功，自神其智，自矜其勇。","book":"明·周承邦《兵家要领·戒骄篇》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":38023,"word":"自矜功伐","pinyin":"zì jīn gōng fá","abbr":"zjgf","explanation":"指居功自傲。","source":{"text":"[项羽]自矜功伐，奋其私智而不师古，谓霸王之业，欲以力征经营天下，五年卒亡其国。","book":"《汉书·陈涉项籍传赞》"},"usage":"作谓语、定语；用于处事"},{"id":38024,"word":"自知之明","pinyin":"zì zhī zhī míng","abbr":"zzzm","explanation":"自知：自己了解自己；明：看清事物的能力。指了解自己的情况，对自己有正确的估计。","source":{"text":"知人者智也，自知者明也。","book":"《老子》第三十三章"},"example":{"text":"一个严于解剖自己的人，往往是有～的。"},"similar":["知己知彼"],"opposite":["不自量力"],"usage":"作宾语；指了解自己的情况","story":["齐威王当上国王后整天只知道吃喝玩乐，喜欢听别人弹琴。邹忌携琴前去拜见齐威王，就是光说不弹，并把不弹琴的道理与治国联系起来，使齐威王明白治国的道理，齐威王任命邹忌为相国。邹忌以自身形象影响齐威王有自知之明"]},{"id":38025,"word":"自知而不自见","pinyin":"zì zhī ér bù zì jiàn","abbr":"zzebzj","explanation":"自知：有自知之明；自见：自我显示。有自知之明而不自我炫耀","source":{"text":"是以圣人自知而不自见也，自爱而不自贵也。","book":"春秋·楚·李耳《老子·德经》"},"usage":"作谓语、定语；用于书面语"},{"id":38026,"word":"自私自利","pinyin":"zì sī zì lì","abbr":"zszl","explanation":"私心很重，只为个人利益打算。","source":{"text":"大禹不以一身自利，一体偏枯。","book":"《晋书·潘尼传》：“忧患之接，必生于自私，而兴于有欲。”《列子·杨朱》"},"example":{"text":"我么？你问我么？我是～的个人主义者！","book":"柔石《二月》二"},"similar":["假公济私","损公肥私","损人利己"],"opposite":["大公无私","公而忘私","克己奉公"],"usage":"作主语、宾语、定语；指只考虑自己"},{"id":38027,"word":"自立门户","pinyin":"zì lì mén hù","abbr":"zlmh","explanation":"指单独成立家庭。也指学术上不依赖前人而另立一派。现也指离开某一集体，自己另搞一套。","source":{"text":"要称我的心，除非自立门户。","book":"清·曾朴《孽海花》第三十一回"},"example":{"text":"郡城自江鹤亭徵本地乱弹，名春台，为外江班，不能～。","book":"清·李斗《扬州画舫录·新城北录下》"},"similar":["各自为政","自食其力","独立自主"],"opposite":["打成一片","一统天下","合而为一"],"usage":"作谓语、定语；指独立成事"},{"id":38028,"word":"自繇自在","pinyin":"zì yóu zì zài","abbr":"zyzz","explanation":"形容没有约束，安闲随意的样子","source":{"text":"索性把身边所有，尽数分与三家，等三家轮供养了我，我落得自繇自在 。","book":"明·凌濛初《二刻拍案惊奇》第26卷"},"similar":["自由自在"],"usage":"作谓语、定语；指没有约束"},{"id":38029,"word":"自给自足","pinyin":"zì jǐ zì zú","abbr":"zjzz","explanation":"给：供给。依靠自己的生产，满足自己的需要。","source":{"text":"不施不惠，而物自足。","book":"《三国志·魏志·步隲传》：“种瓜自给。”《列子·黄帝》"},"example":{"text":"人民在党和政府的组织领导下，展开了～的大生产运动。","book":"冯德英《苦菜花》第九章"},"similar":["自产自销"],"usage":"作谓语、宾语、定语；指自己满足"},{"id":38030,"word":"自绝于人","pinyin":"zì jué yú rén","abbr":"zjyr","explanation":"绝：断。自己断绝了跟别人的关系。指做了对不起人的事而不愿悔改。","example":{"text":"我不会～的。"},"usage":"作谓语、宾语、定语；指死不悔改的人"},{"id":38031,"word":"自胜者强","pinyin":"zì shèng zhě qiáng","abbr":"zszq","explanation":"自胜：战胜自己；强：刚，强。能够战胜自己的人才算刚强","source":{"text":"胜人者有力，自胜者强。","book":"春秋·楚·李耳《老子·道德经》第33章"},"usage":"作宾语、定语；用于书面语"},{"id":38032,"word":"自行其是","pinyin":"zì xíng qí shì","abbr":"zxqs","explanation":"自己认为对的就做，不考虑别人的意见。","source":{"text":"他们在工作中往往自行其是，不尊重上级的统一领导，不注意遵守请示报告制度。","book":"周恩来《政府工作报告（一九五四年）》"},"example":{"text":"做事不能自行其是，最好听听别人的意见。"},"similar":["自以为是"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；指十分固执"},{"id":38033,"word":"自视不明","pinyin":"zì shì bù míng","abbr":"zsbm","explanation":"自视：单靠自己眼睛看事物；不明：看不清楚。指单靠自己眼睛看事物则看不清楚","source":{"text":"自见者不明，自是者不彰。","book":"春秋·楚·李耳《老子·道经》第24章"},"usage":"作宾语、定语；用于书面语"},{"id":38034,"word":"自视甚高","pinyin":"zì shì shèn gāo","abbr":"zssg","explanation":"把自己看得很高（多指身分，学识等）。","source":{"text":"我暗想这个人自视甚高，看来文字总也是好的，便不相强。","book":"清·吴趼人《二十年目睹之怪现状》第36回"},"example":{"text":"～的人会上当的。"},"similar":["自高自大"],"opposite":["谦虚谨慎"],"usage":"作谓语、定语；多指身分，学识等"},{"id":38035,"word":"自觉形秽","pinyin":"zì jué xíng huì","abbr":"zjxh","explanation":"本指羞愧自己的容貌举止不如别人。后也泛指与人相比，自愧不如。","source":{"text":"骠骑王武子，是卫玠之舅，俊爽有风姿。见玠辄叹曰：‘珠玉在侧，觉我形秽。’","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"小弟因多了几岁年纪，在他面前～，所以不敢痴心想着相与他。","book":"清·吴敬梓《儒林外史》第三十回"},"similar":["自惭形秽"],"usage":"作谓语、定语、宾语；指自愧不如"},{"id":38036,"word":"自觉自愿","pinyin":"zì jué zì yuàn","abbr":"zjzy","explanation":"自己觉悟而愿意。","source":{"text":"更可宝贵的是在阶级觉悟的基础上，纯粹出于自觉自愿，没有一丝一毫的强迫性质。","book":"周而复《白求恩大夫》十"},"example":{"text":"我们要自觉自愿地维护国家和民族的利益。"},"similar":["心甘情愿"],"opposite":["迫不得已"],"usage":"作宾语、状语；指自觉行事"},{"id":38037,"word":"自言自语","pinyin":"zì yán zì yǔ","abbr":"zyzy","explanation":"自己一个人低声嘀咕。","source":{"text":"你这般鬼促促的，在这自言自语，莫不要出城去砍那桃树吗？","book":"元·无名氏《桃花女》第四折"},"example":{"text":"一面点头，一面咂嘴弄舌的，～了一回。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["喃喃自语"],"opposite":["默不做声"],"usage":"作谓语、定语、状语；指自己说话"},{"id":38038,"word":"自认不讳","pinyin":"zì rèn bù huì","abbr":"zrbh","explanation":"讳：隐讳。直截了当地承认，一点也不回避隐瞒","source":{"text":"自认不讳。","book":"清·无名氏《六部成语·刑部》"},"example":{"text":"清·钱彩《说岳全传》第65回：“既是岳雷，～，不必审问。”"},"similar":["直认不讳"],"usage":"作谓语、定语；用于书面语"},{"id":38039,"word":"自讨没趣","pinyin":"zì tǎo méi qù","abbr":"ztmq","explanation":"做事不得当，反使自己难堪窘迫。","source":{"text":"他立刻觉得刚才对于孩子的要求没有意思，只不过自讨没趣罢了。","book":"叶圣陶《孤独》"},"example":{"text":"他知道这样做是～。"},"similar":["自找没趣"],"usage":"作谓语、宾语；指不会观颜察色"},{"id":38040,"word":"自讨苦吃","pinyin":"zì tǎo kǔ chī","abbr":"ztkc","explanation":"讨：招惹。自己找苦吃。","source":{"text":"殷殷防护，日夜为劳，是无知老贱自讨苦吃者也。","book":"明·张岱《陶庵梦忆·朱云崃女戏》"},"example":{"text":"可是我有一种毛病，自己也疑心是～的要苗，就是偶尔要想想。","book":"鲁迅《华盖集·“碰壁”之后》"},"similar":["自寻烦恼"],"usage":"作谓语、定语、宾语；指自找麻烦"},{"id":38041,"word":"自许州官放火，不许百姓点灯","pinyin":"zì xǔ zhōu guān fàng huǒ，bù xǔ bǎi xìng diǎn dēng","abbr":"zxzgfhbxbxdd","explanation":"州官：一州的长官。指反动统治者自己可以胡作非为，老百姓没有正当活动的自由","example":{"text":"～的做法在这里是行不通的"},"similar":["只准州官放火，不许百姓点灯"],"usage":"作宾语、分句；指肆意妄为"},{"id":38042,"word":"自诒伊戚","pinyin":"zì yí yī qī","abbr":"zyyq","explanation":"自寻烦恼；自招灾殃。","source":{"text":"乌呼，我之怀矣，自诒伊戚，其我之谓矣。","book":"《诗经·小雅·小明》：“心之忧矣，自诒伊戚。”《左传·宣公二年》"},"example":{"text":"明·无名氏《杨家将演义》第一卷：“昊天寺在幽州，与萧后接壤境界，倘辽人知之，发兵劫驾，岂非～。”"},"similar":["自贻伊戚"],"usage":"作谓语、定语；指自寻烦恼","story":["我国最早的一部诗歌总集《诗经》中有一首诗描写一个因公外出办事的官员恋家的故事：他在二月份被派往西方处理政事，在遥远的地方心里老是惦记家乡的亲人，从播种时节一直忙到收获季节还不能回家，心里堆积着无限的烦恼"]},{"id":38043,"word":"自误误人","pinyin":"zì wù wù rén","abbr":"zwwr","explanation":"第一个误：错误；第二个误：耽误。形容不但自己错了，还因这一错误，妨害了他人。","source":{"text":"太抵本领不是，只管妄作，自误误人，深为可惧耳。","book":"宋·朱熹《答许顺之》"}},{"id":38044,"word":"自说自话","pinyin":"zì shuō zì huà","abbr":"zszh","explanation":"独自决定，自己说了算。自言自语。","source":{"text":"陈世龙心满意足，‘自说自话’地放下诺言：‘我五天以后来接你。’","book":"高阳《胡雪岩全传·平步青云》中册"},"example":{"text":"他～道：没人能超过我的。"},"similar":["自言自语"],"usage":"作定语、状语；同“自言自语”"},{"id":38045,"word":"自负不凡","pinyin":"zì fù bù fán","abbr":"zfbf","explanation":"自恃高明，不同寻常。","source":{"text":"曾子固曰：‘王平甫熙宁癸丑岁直宿崇文院……梦觉时禁中已鸣钟，平甫颇自负不凡，为诗记之。’","book":"宋·赵令畤《侯鲭录》卷四"},"example":{"text":"他喜欢批驳别人的文字，便是县府下来的公文，也都逃不过他。而这一切，又是从他的～来的。","book":"沙汀《淘金记》三"},"similar":["自命不凡"],"usage":"作谓语、定语；指清高"},{"id":38046,"word":"自负其能","pinyin":"zì fù qí néng","abbr":"zfqn","explanation":"自负：自恃，自许。自恃而又自信自己的才能","source":{"text":"李广才气，天下无双，自负其能，数与虏敌战，恐亡之。","book":"西汉·司马迁《史记·李将军列传》"},"usage":"作谓语、定语；用于书面语"},{"id":38047,"word":"自负盈亏","pinyin":"zì fù yíng kuī","abbr":"zfyk","explanation":"自己负责盈利和亏损。","example":{"text":"我们自主经营，～。"},"usage":"作谓语、定语；指自己负责"},{"id":38048,"word":"自贻伊咎","pinyin":"zì yí yī jiù","abbr":"zyyj","explanation":"指自己招来过错。","source":{"text":"欲因循故事，坐膺天禄，其事不成，自贻伊咎。","book":"唐·刘知幾《史通·疑古》"},"example":{"text":"况杜亚薄知经籍，素懵文辞，李翰虽以辞藻擢第，不以书判擅名，不慎举人，～。","book":"五代·王定保《唐摭言·无名子谤议》"},"similar":["自贻伊戚","自诒伊戚","自遗伊戚"],"usage":"作谓语、定语；指自寻烦恼"},{"id":38049,"word":"自贻伊戚","pinyin":"zì yí yī qī","abbr":"zyyq","explanation":"贻：遗留；伊：此；戚：忧愁，悲哀。比喻自寻烦恼，自招忧患。","source":{"text":"心之忧矣，自诒伊戚。","book":"《诗经·小雅·小明》"},"example":{"text":"审得甄廷诏误用药而死于淫，春花婢醉汇事而死于悔，皆～，无为可抵。","book":"明·凌濛初《二刻拍案惊奇》卷十八"},"similar":["自诒伊戚","自寻烦恼","自贻伊咎"],"usage":"作谓语、定语；指自寻烦恼","story":["我国最早的一部诗歌总集《诗经》中有一首诗描写一个因公外出办事的官员恋家的故事：他在二月份被派往西方处理政事，在遥远的地方心里老是惦记家乡的亲人，从播种时节一直忙到收获季节还不能回家，心里堆积着无限的烦恼"]},{"id":38050,"word":"自身难保","pinyin":"zì shēn nán bǎo","abbr":"zsnb","explanation":"自己保不住自己。","source":{"text":"我想江西不沉却好，若沉了时节，正是‘泥菩萨落水，自身难保’，还保得别人？","book":"明·冯梦龙《警世通言》"},"example":{"text":"他现在是～了。"},"similar":["自顾不暇","草人救火"],"opposite":["助人为乐"],"usage":"作谓语、宾语；指不能自我保护"},{"id":38051,"word":"自轻自贱","pinyin":"zì qīng zì jiàn","abbr":"zqzj","explanation":"贱：藐视。自己看不起自己。多指自己降低身份。","source":{"text":"又且他家差老园公请你，有凭有据，须不是你自轻自贱。","book":"明·冯梦龙《古今小说》第二卷"},"example":{"text":"莫不是他和我玩，他就～了。","book":"清·曹雪芹《红楼梦》第22回"},"similar":["自暴自弃"],"opposite":["自强不息"],"usage":"作谓语、定语；指自卑"},{"id":38052,"word":"自遗伊戚","pinyin":"zì yí yī qī","abbr":"zyyq","explanation":"伊：是，此；戚：忧患。比喻自寻烦恼，自招灾祸","source":{"text":"若公则自遗伊戚，可无庸诉也。","book":"清·纪昀《阅微草堂笔记·如是我闻二》"},"similar":["自贻伊戚"],"usage":"作谓语、定语；指自寻烦恼"},{"id":38053,"word":"自郐以下","pinyin":"zì kuài yǐ xià","abbr":"zkyx","explanation":"吴国的季礼在鲁国看周代的乐舞，对于各诸侯国的乐曲都有评论，但从刽国以下他就没有再表示意见。比喻从某某以下就不值得评论。","source":{"text":"自郐以下无讥焉。","book":"先秦·左丘明《左传·襄公二十九年》"},"example":{"text":"后来的史官更是～了。","book":"郭沫若《雄鸡集·关于大规模搜集民歌问题》"},"similar":["自郐而下"],"usage":"作宾语、分句；指不值一提","story":["春秋时期，吴国的公子季札自幼精通音乐，他访问鲁国时，鲁国请他欣赏周代的乐舞。鲁国的乐工演奏周王朝及各诸侯国的乐曲，对于各诸侯国的乐曲都有褒贬评论，但从演奏郐国的《郐风》以后，他就没有再表示意见了"]},{"id":38054,"word":"自郐无讥","pinyin":"zì kuài wú jī","abbr":"zkwj","explanation":"表示自此以下的不值得评论。同“自郐以下”。","source":{"text":"［吴公子札］请观欲周乐，使工为之歌《周南》、《召南》，曰：‘美哉！始基之矣，犹未也，然勤而不怨矣。’……自郐以下无讥焉。","book":"《左传·襄公二十九年》"},"example":{"text":"无双谁似黄郎子，～，月满星稀，想见歌场夜打围。","book":"宋·张孝祥《丑奴儿》词"},"similar":["自郐而下","自郐以下"],"usage":"作宾语、分句；指不值一提"},{"id":38055,"word":"自郐而下","pinyin":"zì kuài ér xià","abbr":"zkex","explanation":"表示自此以下的不值得评论。同“自郐以下”。","source":{"text":"太史公的观点是反统治者的，所以《史记》所提供的史料，比《汉书》可贵，后来的史官更是自郐而下了。","book":"郭沫若《雄鸡集·关于大规模搜集民歌问题》"},"similar":["自郐无讥","自郐以下"],"usage":"作宾语、分句；指不值一提"},{"id":38056,"word":"自靖自献","pinyin":"zì jìng zì xiàn","abbr":"zjzx","explanation":"自靖：各自图谋实行其志。指自谋献身于国事","source":{"text":"各自谋行其志，人人自献达于先王以不失道。","book":"《尚书·微子》：“自靖，人自献于先王。”孔颖达疏"},"usage":"作谓语、定语；用于书面语"},{"id":38057,"word":"自顾不暇","pinyin":"zì gù bù xiá","abbr":"zgbx","explanation":"暇：空闲。光顾自己还来不及。指没有力量再照顾别人。","source":{"text":"今虽略有生机，但自顾不暇，何能另有安顿哥哥之处。","book":"清·李汝珍《镜花缘》第六十回"},"example":{"text":"其以满洲为可倚赖乎？彼～，何有于汉人。","book":"清·陈天华《狮子吼》第七回"},"similar":["自身难保","明哲保身"],"opposite":["助人为乐","慷慨解囊","救死扶伤"],"usage":"作谓语、定语；用于个人或集体","story":["春秋时期，孔子带领弟子们周游列国，在陈国闲居时，弟子冉求从鲁国回来，说鲁国宗庙失火之事，孔子说一定烧了桓公、僖公的庙。冉求说夫子料事如神，季桓子刚死，季府乱成一片，自顾不暇，根本不会去救火"]},{"id":38058,"word":"自食其力","pinyin":"zì shí qí lì","abbr":"zsql","explanation":"依靠自己的劳动所得来生活。","source":{"text":"食力，自食其力之人。","book":"《礼记·礼器》：“食力无数。”陈浩集说"},"example":{"text":"居贫，～，隐田里间，以教授为业，非义不为，人敬惮之。","book":"明·李昌祺《剪灯余话·泰山御史传》"},"similar":["自力更生","独立自主"],"opposite":["不劳而获","坐享其成"],"usage":"作谓语、定语、状语；指靠自己"},{"id":38059,"word":"自食其恶果","pinyin":"zì shí qí è guǒ","abbr":"zsqeg","explanation":"指自己做了坏事，自己受到损害或惩罚。","example":{"text":"玩火者只会自食其恶果。"}},{"id":38060,"word":"自食其果","pinyin":"zì shí qí guǒ","abbr":"zsqg","explanation":"指自己做了坏事，自己受到损害或惩罚。","source":{"text":"除了因为愚昧保守而自食其果，这些人物的的生活原也悠然自得其乐。","book":"茅盾《〈呼兰河传〉序》"},"example":{"text":"玩火者只会自食其果。"},"similar":["自作自受","玩火自焚","咎由自取"],"opposite":["嫁祸于人"],"usage":"作谓语、宾语、定语；指自作自受"},{"id":38061,"word":"自食其言","pinyin":"zì shí qí yán","abbr":"zsqy","explanation":"指说了话不算数。","source":{"text":"尔无不信，朕不食言。","book":"《尚书·汤誓》"},"example":{"text":"我若今日复出应诏，是～了。","book":"明·冯梦龙《醒世恒言》卷二"},"similar":["食言而肥","言而无信","背信弃义"],"opposite":["言而有信","一诺千金","一言为定"],"usage":"作谓语、宾语、定语；指不讲信用"},{"id":38062,"word":"自高其功","pinyin":"zì gāo qí gōng","abbr":"zgqg","explanation":"自以为劳苦功高。指居功自傲","source":{"text":"骄则自高其功，自神其智，自矜其勇。","book":"明·周承邦《兵家要领·戒骄篇》"},"similar":["居功自傲"],"usage":"作谓语、定语；用于处事"},{"id":38063,"word":"自高自大","pinyin":"zì gāo zì dà","abbr":"zgzd","explanation":"自以为了不起。","source":{"text":"见人读数十卷书，便自高大，凌忽长者，轻慢同列。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"人要是～，瞧不起别人，就不能进步。"},"similar":["夜郎自大","妄自尊大","自命不凡"],"opposite":["虚怀若谷","不耻下问"],"usage":"作主语、谓语、定语；指自以为是"},{"id":38064,"word":"自鸣得意","pinyin":"zì míng dé yì","abbr":"zmdy","explanation":"鸣：表示，以为。自以为了不起，表示很得意。","source":{"text":"挥策四顾，如辛幼安之歌于千古江山，自鸣得意。","book":"明·沈德符《万历野获编·昙花记》"},"example":{"text":"姊妹相逢无他语，惟各以阃威～。","book":"清·蒲松龄《聊斋志异·江城》"},"similar":["洋洋得意","得意忘形","沾沾自喜"],"opposite":["垂头丧气","灰心丧气","心灰意懒"],"usage":"作谓语、定语、状语；指自以为是"},{"id":38065,"word":"臭不可当","pinyin":"chòu bù kě dāng","abbr":"cbkd","explanation":"当：承受。臭得使人受不了。比喻人名声极坏。","source":{"text":"刳而振其犀以嬉，取海水杂粪壤蟯蚘而实之，臭不可当也。","book":"唐·柳宗元《东海若》"},"example":{"text":"原来公坊那年自以为～的文章，竟被霞郎估着，居然掇了巍科。","book":"《孽海花》第五回"},"similar":["臭名远扬","臭不可闻"],"opposite":["流芳百世"],"usage":"作谓语、定语、状语；比喻人名声极坏"},{"id":38066,"word":"臭不可闻","pinyin":"chòu bù kě wén","abbr":"cbkw","explanation":"臭得使人受不了。比喻人名声极坏。","source":{"text":"臭得使人受不了。比喻人名声极坏。"},"example":{"text":"呕出黑渖数斗，～。","book":"清·蒲松龄《聊斋志异·酒狂》"},"similar":["臭不可当"],"usage":"作谓语、定语；比喻人名声极坏"},{"id":38067,"word":"臭名昭彰","pinyin":"chòu míng zhāo zhāng","abbr":"cmzz","explanation":"昭：显著。坏名声人人都知道。","example":{"text":"北洋派是中国近代史上继往开来、～的一个封建军事政治集团。","book":"陶菊隐《北洋军阀统治时期史话》第一章"},"similar":["臭名昭著"],"usage":"作谓语、定语；指名声很坏的人"},{"id":38068,"word":"臭名昭著","pinyin":"chòu míng zhāo zhù","abbr":"cmzz","explanation":"坏名声人人都知道。","source":{"text":"他们是贺衷寒系统的人，在前方打狗吃，臭名昭著。","book":"郭沫若《洪波曲》第十章"},"example":{"text":"国民党以～的《危害民国紧急治罪法》控告这一群手无寸铁的青年‘颠覆政府’。","book":"《自序三》"},"similar":["声名狼藉","臭名远扬"],"opposite":["大名鼎鼎","赫赫有名"],"usage":"作谓语、定语；指名声很坏的人"},{"id":38069,"word":"臭名远扬","pinyin":"chòu míng yuǎn yáng","abbr":"cmyy","explanation":"名：名声；扬：传播。坏名声传得很远。","source":{"text":"案车骑将军义真，凶恶之性，爰自稚弱，咸阳之酷，臭声远播。","book":"《宋书·刘义真传》"},"example":{"text":"希特勒是个～的战争罪犯。"},"similar":["臭名昭著","声名狼藉","臭不可当"],"opposite":["驰名中外","名扬四海"],"usage":"作谓语、定语；同“臭名昭著”"},{"id":38070,"word":"臭味相与","pinyin":"xiù wèi xiāng yǔ","abbr":"cwxy","explanation":"臭味：气味。彼此的思想作风、兴趣等相同，很合得来（常指坏的）。","source":{"text":"凡其亲昭朋徒、臭味相与，大会而葬之。","book":"《左传·襄公八年》：“今譬于草木，寡君在君，君之臭味也。”汉·蔡邕《玄文先生李休碑》"}},{"id":38071,"word":"臭味相依","pinyin":"xiù wèi xiāng yī","abbr":"cwxy","explanation":"臭味：气味；相依：互相依赖。彼此的思想作风、兴趣等相同，很合得来（常指坏的）。","source":{"text":"今譬于草木，寡君在君，君之臭味也。","book":"《左传·襄公八年》"},"example":{"text":"至两汉已还，则全录当时纪传，而上下通达，～。","book":"唐·刘知己《史通·内篇》"}},{"id":38072,"word":"臭味相投","pinyin":"xiù wèi xiāng tóu","abbr":"xwxt","explanation":"臭味：气味；相投：互相投合。彼此的思想作风、兴趣等相同，很合得来（常指坏的）。","source":{"text":"凡其亲昭朋徒、臭味相与，大会而葬之。","book":"《左传·襄公八年》：“今譬于草木，寡君在君，君之臭味也。汉·蔡邕《玄文先生李休碑》"},"example":{"text":"两情不谋而合，况是彼此熟识，一经会面，～，当即互相借重，定名为请愿联合会。","book":"蔡东藩、许廑父《民国通俗演义》第四八回"},"similar":["沆瀣一气","同气相求","狼狈为奸"],"opposite":["格格不入","水火不容"],"usage":"作谓语、定语；比喻坏人投合在一起"},{"id":38073,"word":"臭肉来蝇","pinyin":"chòu ròu lái yíng","abbr":"crly","explanation":"腐臭的肉招来苍蝇。比喻自己的思想作风有问题，就会招致坏人的引诱。","source":{"text":"僧问慧然如何是祖师而来意？曰，臭肉来蝇。","book":"宋·释普济《五灯会元》第11卷"},"example":{"text":"大家都明白“～”的道理。"},"similar":["如蝇逐臭"],"usage":"作宾语、定语；指招致坏人"},{"id":38074,"word":"臭腐化神奇","pinyin":"xiù fǔ huà shén qí","abbr":"cfhsq","explanation":"腐败臭恶的转化为神奇美好的。比喻坏事变为好事，无用变有用","source":{"text":"是其所美者为神奇，其作恶者为臭腐，臭腐复化为神奇，神奇复化为臭腐。","book":"战国·宋·庄周《庄子·知北游》"},"usage":"作宾语、定语；用于书面语"},{"id":38075,"word":"至于此极","pinyin":"zhì yú cǐ jí","abbr":"zycj","explanation":"至于：到了。到了极点。多形容痛苦之极。","source":{"text":"吾王之好鼓乐，夫何使我至于此极也？父子不相见，兄弟妻子离散。","book":"《孟子·梁惠王下》"},"example":{"text":"中国人民智慧，蒙蔽弇陋，～，虽圣人生今，殆亦无能为力也。（清·严复《救亡决论》）"},"usage":"作谓语、状语；用于书面语"},{"id":38076,"word":"至交契友","pinyin":"zhì jiāo qì yǒu","abbr":"zjqy","explanation":"契：投合。指交谊最深而又情投意合的好友。","source":{"text":"我想此处司马白乐天，及某至交契友，不免上岸探望他一遭。","book":"元·马致远《青衫泪》第三折"},"usage":"作宾语、定语；用于交往等"},{"id":38077,"word":"至亲好友","pinyin":"zhì qīn hǎo yǒu","abbr":"zqhy","explanation":"关系至深的亲戚，感情最好的朋友。","source":{"text":"就中有引礼赞礼的人，叫做‘傧相’，都不是以下人做，都是至亲好友中间，有礼度熟闲，仪容出众，声音响亮的，众人就推举他做了。","book":"明·凌濛初《初刻拍案惊奇》"},"example":{"text":"公馆里正自酒绿灯红，笑语生风，满满的两桌，无非是～。","book":"茅盾《某一天》"},"similar":["至爱亲朋"],"opposite":["对头冤家"],"usage":"作主语、宾语、定语；指亲朋戚友"},{"id":38078,"word":"至亲骨肉","pinyin":"zhì qīn gǔ ròu","abbr":"zqgr","explanation":"关系最近的亲人。","source":{"text":"除是至亲骨肉，缓和疼痛日在面前的，用意体察，才看得出来。","book":"明·凌濛初《初刻拍案惊奇》卷二"},"example":{"text":"不过自家兄妹，～，怎么能够不关心呀。","book":"茅盾《霜叶红于二月花》"},"similar":["至亲好友"],"usage":"作宾语、定语、主语；指直系亲属"},{"id":38079,"word":"至人无为","pinyin":"zhì rén wú wéi","abbr":"zrww","explanation":"无为：不用政刑。有修养的圣明君主不靠严刑苛法统治天下。","source":{"text":"圣人者，原天地之美而达万物之理。是故至人无为，大圣不作，观于天地之谓也。","book":"《庄子·知北游》"}},{"id":38080,"word":"至人无亲","pinyin":"zhì rén wú qīn","abbr":"zrwq","explanation":"至人：指思想道德等方面达到最高境界的人。道德修养高的人对待万物一视同仁，没有亲疏的差别。","source":{"text":"曰：‘请问至人。’庄子曰：‘至人无亲。’","book":"《庄子·天运》"}},{"id":38081,"word":"至人无己","pinyin":"zhì rén wú jǐ","abbr":"zrwj","explanation":"至人：道德修养极高的人。道德修养最高的人能顺应客观，忘掉自己。","source":{"text":"至人无己，神人无功，圣人无名。","book":"《庄子·逍遥游》"},"usage":"作宾语、定语；用于书面语"},{"id":38082,"word":"至人无梦","pinyin":"zhì rén wú mèng","abbr":"zrwm","explanation":"至人：指思想道德等方面达到最高境界的人。品德高尚的人，不会做想入非非的梦。","source":{"text":"自古至人无梦，梦境忽来，未必无兆。","book":"清·钱彩《说岳全传》第五十九回"},"usage":"作主语、宾语、定语；指品德高尚的人"},{"id":38083,"word":"至人遗物","pinyin":"zhì rén yí wù","abbr":"zryw","explanation":"至人：思想道德修养很高的人。道德高尚的人能舍弃财物","source":{"text":"至人遗物，独与道俱，众人惑惑，好恶积意。","book":"汉·贾谊《鹏鸟赋》"},"usage":"作宾语、定语；用于书面语"},{"id":38084,"word":"至仁忘仁","pinyin":"zhì rén wàng rén","abbr":"zrwr","explanation":"至仁：最大的仁德。极有仁德的人反而不必常常想着仁。比喻事物达到了顶点，反而不需要它存在了。","source":{"text":"故至智弃智，至仁忘仁，至德不德。无言无思，静以待时，时至而应，心暇者胜。","book":"《吕氏春秋·任数》"},"usage":"作宾语、定语；用于书面语"},{"id":38085,"word":"至仁无亲","pinyin":"zhì rén wú qīn","abbr":"zrwq","explanation":"至仁：最大的仁德。道德修养高的人对待万物一视同仁，没有亲疏的差别。","source":{"text":"至礼有不人，至义不物，至知不谋，至仁无亲，至信辟金。","book":"《庄子·庚桑楚》"},"usage":"作宾语、定语；用于书面语"},{"id":38086,"word":"至信辟金","pinyin":"zhì xìn bì jīn","abbr":"zxpj","explanation":"至信：最有信用；辟：排除。最守信用的人无须用金玉作信物。","source":{"text":"至礼有不人，至义不物，至知不谋，至仁无亲，至信辟金。","book":"《庄子·庚桑楚》"},"usage":"作宾语、定语；用于书面语"},{"id":38087,"word":"至公无我","pinyin":"zhì gōng wú wǒ","abbr":"zgww","explanation":"至：极，最；公：无私。公正到极点，丝毫没有私心","source":{"text":"士大夫为吏者，当以至公无我处之，事自理，民自服。","book":"元·刘祁《归潜志》第七卷"},"similar":["至公无私"],"opposite":["自私自利"],"usage":"作宾语、定语、状语；用于处事"},{"id":38088,"word":"至公无私","pinyin":"zhì gōng wú sī","abbr":"zgws","explanation":"非常公正，不存私心。","source":{"text":"风漂物者也，风之所漂，不避贵贱恶美；雨濡物者也，雨之所堕，不避小大强弱。风雨至公而无私。","book":"《管子·形势解》"},"example":{"text":"昔尧治天下，～，不赏而民劝，不罚而民畏。","book":"三国·魏·嵇康《高士传》"},"similar":["大公无私","至公无我"],"opposite":["损公肥私"],"usage":"作宾语、定语、状语；用于歌颂人的品德"},{"id":38089,"word":"至关重要","pinyin":"zhì guān zhòng yào","abbr":"zgzy","explanation":"指具有特别重大影响或后果。","source":{"text":"这次命运的大决战不仅对她是至关重要的，对所有的同学都一样。","book":"路遥《平凡的世界》第四卷第43章"},"example":{"text":"对我大有用处的人，每个人都是‘～’的。","book":"王朔《许爷》"},"opposite":["无足轻重","无关紧要"],"usage":"作谓语、定语；用于加强语气"},{"id":38090,"word":"至再至三","pinyin":"zhì zài zhì sān","abbr":"zzzs","explanation":"指一而再，再而三。","source":{"text":"妾隔帘故邀其满引，至再至三，终不肯出。","book":"《尚书·多方》：“我惟时其教告之，我惟时其战要囚之，至于再，至于三，乃有不用我降尔命，我乃其大罚殛之！”宋·罗大经《鹤林玉露》卷十二"},"example":{"text":"臣拟坚持初议，～，与之磋磨。","book":"清·薛福成《通筹南洋各岛添设领事官保护华民疏》"},"similar":["一而再，再而三","几次三番"],"usage":"作定语、状语；用于书面语"},{"id":38091,"word":"至善至美","pinyin":"zhì shàn zhì měi","abbr":"zszm","explanation":"至：最。最完善，最美好。","source":{"text":"他渴望着震撼着宇宙的大风暴，而且他又把这个理解作为翻掌间便立现了至善至美世界的‘奇迹’，因而对于生活的实际的转变——在矛盾混乱中所产生的向前进展，他就不能了解，而且反感到丑恶。","book":"茅盾《三人行》七"},"similar":["十全十美"],"usage":"作谓语、定语；多用于夸奖"},{"id":38092,"word":"至圣先师","pinyin":"zhì shèng xiān shī","abbr":"zsxs","explanation":"至：最。旧时特指孔子。","source":{"text":"凡始立学者，必释奠于先圣先师。","book":"《礼记·中庸》：“唯天下至圣，为能联盟睿知，足以有临也。”《礼记·文王世子》"}},{"id":38093,"word":"至圣至明","pinyin":"zhì shèng zhì míng","abbr":"zszm","explanation":"至：极。最神圣最贤明。旧时用以称颂帝王。","source":{"text":"臣等闻玄祖之道，用慈俭为先；素王之风，以仁义是首，相沿百世，作则千年，至圣至明，不可易也。","book":"宋·孙光宪《北梦琐言》卷一"},"usage":"作谓语、定语；旧时用以称颂帝王"},{"id":38094,"word":"至大无外","pinyin":"zhì dà wú wài","abbr":"zdww","explanation":"大到极点，外无以加。","source":{"text":"至大无外，谓之大一；至小无内，谓之小一。","book":"战国·宋·庄周《庄子·天下》"},"example":{"text":"把佛法吹得～是不妥当的。"},"opposite":["至小无内"],"usage":"作谓语、定语；用于书面语"},{"id":38095,"word":"至大至刚","pinyin":"zhì dà zhì gāng","abbr":"zdzg","explanation":"至：最，极。极其正大、刚强。","source":{"text":"其为气也，至大至刚，以直养而无害，则塞于天地之间。","book":"《孟子·公孙丑上》"},"example":{"text":"他说“～”，说“养勇”，都是带有战斗性的。","book":"朱自清《论气节》"},"usage":"作谓语、宾语、定语；指人的气概"},{"id":38096,"word":"至孅至悉","pinyin":"zhì xiān zhì xī","abbr":"zqzx","explanation":"孅：通“纤”；悉：详尽。形容极其细致周密","source":{"text":"古之治天下，至孅至悉也。","book":"东汉·班固《汉书·食货志》"},"similar":["至纤至悉"],"usage":"作谓语、定语；用于书面语"},{"id":38097,"word":"至尊至贵","pinyin":"zhì zūn zhì guì","abbr":"zzzg","explanation":"至：极。极其尊贵。","source":{"text":"出门则乘骈辎，下堂则从傅母，进退则鸣佩玉，内饰则结纫绸缪。此则至尊至贵所以自敛，制不自恣纵之义也。","book":"汉·荀悦《前汉纪·宣帝纪三》"},"usage":"作谓语、定语；用于书面语"},{"id":38098,"word":"至小无内","pinyin":"zhì dà wú nèi","abbr":"zxwn","explanation":"小到极点，内无余隙。","source":{"text":"至大无外，谓之大一；至小无内，谓之小一。","book":"战国·宋·庄周《庄子·天下》"},"example":{"text":"别把小毛病看成～的东西，小心行得万年船。"},"opposite":["至大无外"],"usage":"作谓语、定语；用于书面语"},{"id":38099,"word":"至当不易","pinyin":"zhì dàng bù yì","abbr":"zdby","explanation":"至：极；当：恰当；易：改变。形容极为恰当，不能改变。","source":{"text":"故汲长孺谓其内多欲而外施仁义，而论六家要指者，又以‘博而寡要，劳而少功’八字概之，可谓至当不易之定论。","book":"明·李贽《焚书·读史·孔明为后主写申韩管子六韬》"},"usage":"作谓语、宾语；指非常恰当"},{"id":38100,"word":"至德要道","pinyin":"zhì dé yào dào","abbr":"zdyd","explanation":"至：极，最。最美好的品德和最精要的道理","source":{"text":"先王有至德要道，以顺天下，民用和睦，上下无怨。","book":"《孝经·开宗明义》"},"example":{"text":"章炳麟《检论·商鞅》：“昔者，蜀相行鞅术，～弗踣焉。”"},"usage":"作宾语、定语；用于书面语"},{"id":38101,"word":"至心朝礼","pinyin":"zhì xīn cháo lǐ","abbr":"zxcl","explanation":"至心：诚心。指诚心诚意地朝拜礼敬","source":{"text":"《晋书·王嘉传》：‘人候之者，至心则见之，不至心则隐形不见。’按，道经云‘至心朝礼’，本此。","book":"孙锦标《通俗常言疏证·释道》"},"example":{"text":"鲁迅《故事新编·起死》：“放下马鞭，朝着东方，拱两手向天，提高了喉咙大叫起来：‘～，司命大天尊！’”"},"usage":"作定语、状语；用于书面语"},{"id":38102,"word":"至情一往","pinyin":"zhì qíng yī wǎng","abbr":"zqyw","explanation":"一往：一直，始终。指对人或对事物顷注了很深的感情，向往而不能克制。","source":{"text":"桓子野每闻清歌。辄唤奈何！谢公闻之曰：‘子野可谓一往有深情。’","book":"南朝·宋·刘义庆《世说新语·任诞》"}},{"id":38103,"word":"至意诚心","pinyin":"zhì yì chéng xīn","abbr":"zycx","explanation":"至诚的心意。","source":{"text":"则为我至意诚心，忠肝义胆，我可也并无偏背。","book":"明·无名氏《万国来朝》第二折"},"similar":["诚心诚意"],"usage":"作定语、状语；用于处事"},{"id":38104,"word":"至戚世交","pinyin":"zhì qī shì jiāo","abbr":"zqsj","explanation":"至戚：关系很近的亲戚；世交：上代人就有交情的人家。最近的亲戚，最亲密的朋友。形容关系密切。","source":{"text":"愚兄老拙株守，两家至戚世交，只和老弟气味还投合的来。","book":"清·吴敬梓《儒林外史》第四十六回"},"usage":"作宾语、定语；用于交往等"},{"id":38105,"word":"至敬无文","pinyin":"zhì jìng wú é","abbr":"zjww","explanation":"敬：崇敬；文：修饰。真正的敬意无需用客套的形式来表现。","source":{"text":"至敬无文，父党无容。","book":"《礼记·礼器》"},"example":{"text":"斯皆～，贵诚重质。（《隋书·礼仪志》）"},"usage":"作谓语、定语；用于书面语"},{"id":38106,"word":"至智不谋","pinyin":"zhì zhì bù móu","abbr":"zzbm","explanation":"至：极。极聪明的人不用搞计谋。","source":{"text":"至礼有不人，至义不物，至知不谋，至仁无亲，至信辟金。","book":"《庄子·庚桑楚》"}},{"id":38107,"word":"至智弃智","pinyin":"zhì zhì qì zhì","abbr":"zzqz","explanation":"智慧达到极点，就可舍弃智慧不用","source":{"text":"至智弃智，至仁忘仁，至德不德，无言无思。","book":"战国·卫·吕不韦《吕氏春秋·任数》"},"usage":"作宾语、定语；用于书面语"},{"id":38108,"word":"至死不二","pinyin":"zhì sǐ bù èr","abbr":"zsbe","explanation":"至：到。到死不改变","source":{"text":"盖内臣性贪苟得，至死不二，遂传为笑柄。","book":"明·刘若愚《酌中志·内臣职掌纪略》"},"similar":["至死不变"],"opposite":["见异思迁","反复无常"],"usage":"作谓语、定语、状语；指立场稳定"},{"id":38109,"word":"至死不变","pinyin":"zhì sǐ bù biàn","abbr":"zsbb","explanation":"纛：到。到死不改变（现常用在坏的方面）。","source":{"text":"国无道，至死不变，强哉矫。","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"除了汉奸和那班～的反共分子外，我们是决不抛弃任何友人的。","book":"毛泽东《新民主主义论》"},"similar":["一成不变","始终不渝","死不改悔"],"opposite":["反复无常"],"usage":"作谓语、定语、状语；指立场稳定"},{"id":38110,"word":"至死不屈","pinyin":"zhì sǐ bù qū","abbr":"zsbq","explanation":"到死也不屈服。形容英勇顽强。","source":{"text":"贵身被数十创，力不支，遂为生得，至死不屈。","book":"宋·周密《齐东野语·二张援襄》"},"similar":["视死如归"],"opposite":["贪生怕死"],"usage":"作谓语、定语、状语；用于处事"},{"id":38111,"word":"至死不悟","pinyin":"zhì sǐ bù wù","abbr":"zsbw","explanation":"至：到；悟：醒悟。到死也不醒悟。","source":{"text":"求乞福愿，冀其必得，至死不悟，不亦哀哉？","book":"《抱朴子·道意》"},"example":{"text":"大率才高意远，则所寓得其妙，遂能如此，如大匠运斤，无斧凿痕。不知者疲精力，～。","book":"宋·胡仔《苕溪渔隐丛话前集·五柳先生下"},"similar":["执迷不悟","至死不渝","死心塌地"],"opposite":["见风使舵","随风转舵","随波逐流"],"usage":"作谓语、定语；指不醒悟","story":["很久以前深山里的一个猎人捉到一只小鹿，就带回家里喂养，家中的猎狗对它垂涎三尺，但猎人训练它们友好相处，小鹿把猎狗当成自己的同伴。一天小鹿看到外边有很多猎狗就出去与它们玩，结果被咬死。可惜小鹿至死也不知道是怎么死的"]},{"id":38112,"word":"至死不渝","pinyin":"zhì sǐ bù yú","abbr":"zsby","explanation":"至：到；渝：改变。到死都不改变。","source":{"text":"国无道，至死不变，强哉矫！","book":"西汉·戴圣《礼记·中庸》"},"example":{"text":"我对你的爱情～。"},"similar":["至死不悟","始终不渝","死心塌地"],"opposite":["虎头蛇尾","有头无尾","随风转舵"],"usage":"作谓语、定语、状语；指立场坚定"},{"id":38113,"word":"至死靡他","pinyin":"zhì sǐ mǐ tā","abbr":"zsmt","explanation":"至：到；靡：没有；它：别的。到死也不变心。形容爱情专一，致死不变。","source":{"text":"之死矢靡它，母也天只，不谅人只。","book":"《诗经·鄘风·柏舟》"},"example":{"text":"又不见张公鏖战及晡，～期捐躯。","book":"清·伍观澜《西炮台行为提督张公作》"},"similar":["之死靡它"],"usage":"作谓语、定语；形容立场坚定"},{"id":38114,"word":"至死靡它","pinyin":"zhì sǐ mǐ tā","abbr":"zsmt","explanation":"至：到；靡：没有；它：别的。到死也不变心。形容爱情专一，致死不变。现也形容立场坚定。","source":{"text":"之死矢靡它，母也天只，不谅人只。","book":"《诗经·鄘风·柏舟》"}},{"id":38115,"word":"至理名言","pinyin":"zhì lǐ míng yán","abbr":"zlmy","explanation":"至：最；名：有名声的。最正确的道理，最精辟的言论。","source":{"text":"涛与卢钦，论用兵之本，以为不宜去州郡武备，帝称之曰：‘天下名言也。’","book":"《晋书·山涛传》"},"example":{"text":"《晋书·山涛传》：“涛与卢钦，论用兵之本，以为不宜去州郡武备，帝称之曰：‘天下名言也。’”"},"similar":["金玉良言","良药苦口","天经地义"],"opposite":["奇谈怪论","无知妄说","无稽之谈"],"usage":"作宾语、定语；指精辟的言论"},{"id":38116,"word":"至矣尽矣","pinyin":"zhì yǐ jìn yǐ","abbr":"zyjy","explanation":"至：到。矣：语气助词。尽：极点。到了极点，无以复加。","source":{"text":"有以为未始有物者，至矣尽矣，不可以加矣。","book":"《庄子·齐物论》"},"example":{"text":"老夫妇两对这个宝贝女儿，可算是疼爱得到～。","book":"《杨乃武与小白菜》第十五回"},"usage":"作谓语；指到顶点"},{"id":38117,"word":"至知不谋","pinyin":"zhì zhī bù móu","abbr":"zzbm","explanation":"至知：极聪明的人；谋：谋略，计谋。极聪明的人可以不用谋虑","source":{"text":"故曰，至礼有不人，至义不物，至知不谋，至仁无亲，至信辟全。","book":"战国·宋·庄周《庄子·庚桑楚》"},"usage":"作宾语、定语；用于书面语"},{"id":38118,"word":"至纤至悉","pinyin":"zhì xiān zhì xī","abbr":"zxzx","explanation":"纤：细；悉：周全。形容极其细致周全。","source":{"text":"古之治天下，至纤至悉也，故其畜积足恃。","book":"汉·贾谊《论积贮疏》"},"example":{"text":"释氏之教，非吾儒所许也。然其立制之善，所以豫为同类谋者，～，宜吾儒愧叹之不暇。（清·汪琬《募建永宁接众禅院序》）"},"similar":["至孅至悉"],"usage":"作谓语、定语；用于书面语"},{"id":38119,"word":"至言不烦","pinyin":"zhì yán bù fán","abbr":"zybf","explanation":"烦：烦琐。指说话或写文章简单扼要，不烦琐。","source":{"text":"晏含笑而赞之曰：‘可谓要言不烦也。’","book":"《三国志·魏书·管辂传》裴松之注引《管辂别传》"},"example":{"text":"至美不华，至言不烦，夫华与烦，去道远甚。","book":"《指月录》卷二十五"}},{"id":38120,"word":"至言去言","pinyin":"zhì yán qù yán","abbr":"zyqy","explanation":"至言：极有道理的话。极有道理的话不必挂在嘴边。","source":{"text":"夫务免乎人之所不免者，岂不亦悲哉！至言去言，至为去为。","book":"《庄子·知北游》"},"example":{"text":"求鱼者濡，争兽者趋，非乐之也。故～，至为无为。（《吕氏春秋·审应览》）"},"usage":"作宾语、定语；用于书面语"},{"id":38121,"word":"至诚如神","pinyin":"zhì chéng rú shén","abbr":"zcrs","explanation":"至诚：极其诚恳。指精神所至，可以推知事物的发展变化，如同神仙一样。","source":{"text":"至诚之道，可以前知。国家将兴，必有祯祥；国家将亡，必有妖孽；见乎蓍龟，动乎四体。祸福将至：善，必先知之；不善，必先知之。故至诚如神。","book":"《礼记·中庸》"},"example":{"text":"是谓易以知险，简以知阻，子思所谓“～，可以前知”者也。（明·王阳明《传习录》卷中）"}},{"id":38122,"word":"至诚无昧","pinyin":"zhì chéng wú mèi","abbr":"zcwm","explanation":"极其诚实，不存有欺瞒之心。","source":{"text":"有豆孔硕，为羞既臧。至诚无昧，精意为芳。神其醉止，欣欣乐康。","book":"唐·贾曾《唐祭汾阴乐章·雍和》"},"usage":"作谓语、定语；用于处事"},{"id":38123,"word":"至诚高节","pinyin":"zhì chéng gāo jié","abbr":"zcgj","explanation":"至：最。最忠诚，最高尚的节操。形容人品高尚。","source":{"text":"至诚高节，堙没无闻，朝野人士，相与嗟悼。","book":"《魏书·儒林传·徐遵明传》"},"usage":"作谓语、定语；指人的品格"},{"id":38124,"word":"至高无上","pinyin":"zhì gāo wú shàng","abbr":"zgws","explanation":"至：最。高到顶点，再也没有更高的了。","source":{"text":"天，颠也。至高无上，从一大。","book":"《淮南子·缪称训》：“道至高无上，至深无下，平乎准，直乎绳，圆乎规，方乎矩。”汉·许慎《说文解字·一部》"},"example":{"text":"只要能把国家从水深火热里救出来，他就是～的英雄。","book":"梁斌《红旗谱》四十二"},"similar":["高高在上","无出其右","登峰造极"],"opposite":["等而下之"],"usage":"作谓语、宾语、定语；最高"},{"id":38125,"word":"至高至上","pinyin":"zhì gāo zhì shàng","abbr":"zgzs","explanation":"至：最。高到顶点，再也没有更高的了。","source":{"text":"天，颠也。至高无上，从一大。","book":"《淮南子·缪称训》：“道至高无上，至深无下，平乎准，直乎绳，圆乎规，方乎矩。”汉·许慎《说文解字·一部》"},"similar":["至高无上"],"usage":"作谓语、宾语、定语；最高"},{"id":38126,"word":"致之度外","pinyin":"zhì zhī dù wài","abbr":"zzdw","explanation":"指不放在心上。同“置之度外”。","source":{"text":"朕且含养，致之度外，勿以言辞相析。","book":"《北史·薛辩传》"},"similar":["置之度外"],"opposite":["耿耿于怀"],"usage":"作谓语、定语；用于处事"},{"id":38127,"word":"致仕悬车","pinyin":"zhì shì xuán chē","abbr":"zsxc","explanation":"致仕：辞官；悬车：将皇帝赐的“安车”挂起，指退职。指辞官回家。","source":{"text":"抑抑仲舒，再相诸侯，身修国治，致仕县车，下帷覃思，论道属书，谠言访对，为世纯儒。","book":"《汉书·叙传下》"},"similar":["悬车致仕"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":38128,"word":"致命一餐","pinyin":"zhì mìng yī cān","abbr":"zmyc","explanation":"舍弃生命，报答一餐饭的恩情。泛指舍死报恩","source":{"text":"匹夫媵母，尚能致命一餐。","book":"南朝·宋·范晔《后汉书·朱浮传》"},"usage":"作宾语、定语；用于书面语"},{"id":38129,"word":"致命遂志","pinyin":"zhì mìng suí zhì","abbr":"zmsz","explanation":"致命：舍弃生命；遂：达到，实现。舍弃生命来实现理想。","source":{"text":"君子以致命遂志。","book":"《周易·困》"},"usage":"作谓语、定语；指有追求、有个性"},{"id":38130,"word":"致知格物","pinyin":"zhì zhī gé wù","abbr":"zzgw","explanation":"致知：获得知识；格物：推究事理。获得知识，推究事物的原理","source":{"text":"欲正其心者先诚其意，欲诚其意者先致其知，致知在格物。","book":"西汉·司马迁《礼记·大学》"},"similar":["格物致知"],"usage":"作宾语、定语；用于书面语"},{"id":38131,"word":"致远任重","pinyin":"zhì yuǎn rèn zhàng","abbr":"zyrz","explanation":"《墨子·亲士》：“良马难乘，然可以任重致远。”","source":{"text":"良马难乘，然可以任重致远。","book":"《墨子·亲士》"},"example":{"text":"力足以扶颠持危，器足以～。","book":"《贺孙中丞启》"},"similar":["任重致远"],"usage":"作谓语、宾语；指有压力才会有动力"},{"id":38132,"word":"致远恐泥","pinyin":"zhì yuǎn kǒng nì","abbr":"zykn","explanation":"致：到达；泥：拘泥。担心妨碍实现远大目标。","source":{"text":"虽小道，必有可观者焉；致远恐泥，是以君子不为也。","book":"《论语·子张》"},"example":{"text":"但～，终之实难，曾未崇朝，豺声已露。（《魏书·孝庄帝纪》）"},"usage":"作宾语、定语；用于书面语"},{"id":38133,"word":"臻微入妙","pinyin":"zhēn wēi rù miào","abbr":"zwrm","explanation":"形容诗文或书法的功力达到最微妙的佳境。","source":{"text":"天下之学，要之有宗师，然后可臻微入妙。","book":"宋·黄庭坚《杨子建通神论序》"}},{"id":38134,"word":"臻臻至至","pinyin":"zhēn zhēn zhì zhì","abbr":"zzzz","explanation":"臻：达到。形容热情周到。","source":{"text":"花荣夫妻几口儿，朝暮臻臻至至，供茶献酒供食，伏侍宋江。","book":"明·施耐庵《水浒全传》第三十三回"},"example":{"text":"梁山泊好汉，个个呵活，～，人马称娖而行，观者兜截遮拦，直欲看杀玠。（明·张岱《陶庵梦忆·及时雨》）"}},{"id":38135,"word":"臼中无釜","pinyin":"jiù zhōng wú fǔ","abbr":"jzwf","explanation":"臼：石制的舂米工具；釜：锅。已经没有锅了，只能在石臼中做饭。比喻妻子已死。","source":{"text":"江淮有王生者，榜言解梦。贾客张瞻将归，梦炊于臼中。问王生。生曰：‘君归不见妻矣，臼中炊，固无釜也。’贾客至家，妻果卒已数日。","book":"唐·段成式《酉阳杂俎·梦》"}},{"id":38136,"word":"臼头深目","pinyin":"jiù tóu shēn mù","abbr":"jtsm","explanation":"形容相貌丑陋。","source":{"text":"齐有妇人，极丑无双，号曰无盐女。其为人也，臼头深目，长壮大节。","book":"汉·刘向《新序·杂事》"},"usage":"作宾语、定语；指人的相貌"},{"id":38137,"word":"臼头花钿","pinyin":"jiù tóu huā diàn","abbr":"jthd","explanation":"臼头：长得象石臼一样的头；花钿：有金翠珠宝等制成的花开首饰。形容丑女浓妆。","source":{"text":"蒋凝应宏词为赋，止四韵遂出，顷刻传播，是谓臼头花钿满面，不若徐妃半妆。","book":"宋·叶廷珪《海录碎事·文学·赋》"}},{"id":38138,"word":"臼杵之交","pinyin":"jiù chǔ zhī jiāo","abbr":"jczj","explanation":"臼：石制的舂米器具。杵：舂米的木棒。臼与杵不相离。比喻非常要好的朋友。","source":{"text":"公沙穆秋游太学，无资粮，乃变服客佣，为祐凭舂。祐与语，大惊。遂共定交于杵臼之间。","book":"《东观汉记·吴祐传》"},"example":{"text":"文登周生，与成生少共笔砚遂定为～。","book":"清·蒲松龄《聊斋志异·成仙》"},"similar":["生死之交"],"usage":"作宾语；指好朋友"},{"id":38139,"word":"臼灶生蛙","pinyin":"jiù zào shēng wā","abbr":"jzsw","explanation":"灶没与水中，产生青蛙。形容水患之甚。","source":{"text":"今城不没者三板，臼灶生蛙，人马相食。","book":"《战国策·越策一》"},"usage":"作宾语、定语；指发生了水灾"},{"id":38140,"word":"舂容大雅","pinyin":"chōng róng dà yá","abbr":"crdy","explanation":"指文章气度雍容，用辞典雅。","source":{"text":"宋末文格猥琐，元末文格纤秾，故宋景濂诸公，力追韩欧，救以舂容大雅。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"usage":"作谓语、定语；用于文章等"},{"id":38141,"word":"舄乌虎帝","pinyin":"xì wū hǔ dì","abbr":"xwhd","explanation":"因“舄”与“乌”、“虎”和“帝”字形相近，同经传抄，容易写错。指文字抄传错误。","source":{"text":"舄九写而为乌，虎三写而为帝，言书之转易如此。","book":"《埤雅》"},"usage":"作宾语、定语；指文字抄传错误"},{"id":38142,"word":"舆人之诵","pinyin":"yú rén zhī sòng","abbr":"yrzs","explanation":"舆人：众人；诵：陈述。指众人的议论。","source":{"text":"晋侯听舆人之诵。","book":"春秋·鲁·左丘明《左传·僖公二十八年》"},"usage":"作主语、宾语；指舆论"},{"id":38143,"word":"舆榇自缚","pinyin":"yú chèn zì fù","abbr":"yczf","explanation":"舆榇：用车载着棺材，表示甘受极刑；缚：捆绑。用车拉着棺材，自愿捆绑双手，表示愿受极刑，听凭处置。指古代的一种投降仪式。","source":{"text":"艾至城北，后主舆榇自缚，诣军垒门。","book":"《三国志·蜀志·后主传》"},"example":{"text":"皓从之，亦～，率诸文武，诣王濬军前归降。","book":"明·罗贯中《三国演义》第一百二十回"}},{"id":38144,"word":"舆死扶伤","pinyin":"yú sǐ fú shāng","abbr":"ysfs","explanation":"指抬运死者，扶持伤者。形容死伤之众。","source":{"text":"若此，则士争前战为颜，行不偷而为用，舆死扶伤，死者过半，此何故也？士非好战而轻死，轻重之分使然也。","book":"《管子·轻重甲》"},"example":{"text":"其交兵之际，虽未免～之泣，然而天下和平，不闻有战争之事。","book":"清·唐甄《潜书·全学》"},"usage":"作定语；用于书面语"},{"id":38145,"word":"舆论哗然","pinyin":"yú lùn huá rán","abbr":"ylhr","explanation":"公众大表惊讶和不满。","example":{"text":"这名高级官员在演说中公然侮辱新闻记者，顿时～。"}},{"id":38146,"word":"舌剑唇枪","pinyin":"shé jiàn chún qiāng","abbr":"sjcq","explanation":"舌如剑，唇象枪。形容争辩激烈，言词锋利，针锋相对，各不相让。","source":{"text":"凭着我唇枪舌剑定江山，见如今河清海晏，黎庶宽安。","book":"元·高文秀《渑池会》一折"},"example":{"text":"显吹弹歌舞，论角徵宫商，使心猿意马，逞～。","book":"元·武汉臣《玉壶春》第二折"},"similar":["唇枪舌剑"],"usage":"作谓语、定语；形容争辩激烈"},{"id":38147,"word":"舌尖口快","pinyin":"shé jiān kǒu kuài","abbr":"sjkk","explanation":"尖：尖锐，锋利。快：锐利，爽快。形容口舌伶俐，说话爽快。也指说话尖刻，不肯让人。","source":{"text":"若是独角牛今番撇台，着那厮浅水鱼儿摸来。山海也似冤仇我和他劈甚么排，不是我舌尖口快。","book":"元·无名氏《独角牛》第二折"},"similar":["伶牙俐齿","尖嘴快舌"],"usage":"作谓语、定语、状语；用于说话等"},{"id":38148,"word":"舌干唇焦","pinyin":"shé gān chún jiāo","abbr":"sgcj","explanation":"说话过多，舌头干燥，嘴唇焦裂。形容费尽口舌，苦心劝说。","source":{"text":"日夜焦唇干舌，欲与吴王接踵而死。","book":"《史记·仲尼弟子列传》"},"example":{"text":"为了她的事情，我找有关部门说得～了"},"similar":["舌敝唇焦"],"usage":"作谓语、宾语、状语；指费尽了唇舌"},{"id":38149,"word":"舌底澜翻","pinyin":"shé dǐ lán fān","abbr":"sdlf","explanation":"舌头底下好像波涛奔涌。形容善于说话，说起来滔滔不绝。","source":{"text":"夜梦神官与我言，罗缕道妙角与根。挈携陬维口澜翻，百二十刻须臾间。","book":"唐·韩愈《记梦》"},"example":{"text":"生因谈诗词兼及家乡风景，女～，妙绪泉涌。","book":"清·王韬《淞隐漫录·七·姚云纤》"}},{"id":38150,"word":"舌战群儒","pinyin":"shé zhàn qún rú","abbr":"szqr","explanation":"舌战：激烈争辩；儒：指读书人。指同很多人辩论，并驳倒对方。","source":{"text":"诸葛亮舌战群儒。","book":"明·罗贯中《三国演义》第43回"},"example":{"text":"诸葛亮～，薛综谓刘玄德乃织席败履之徒。","book":"冯玉祥《我的生活》第32章"},"usage":"作谓语、定语；指口才好","story":["东汉末年，刘表去世，刘琮投降曹操，形势对刘备与孙权极为不利。刘备派诸葛亮随鲁肃一起前往东吴去说服孙权联合抗曹。诸葛亮在孙权的殿前先后把张昭，虞翻、步陟、陆绩的投降主义驳得体无完肤，孙权终于同意联刘抗曹"]},{"id":38151,"word":"舌挢不下","pinyin":"shé jiǎo bù xià","abbr":"sjbx","explanation":"挢：翘起。翘起舌头，久久不能放下。形容惊讶或害怕时的神态。","source":{"text":"中庶子闻扁鹊言，目眩然而不瞚，舌挢然而不下。","book":"《史记·扁鹊苍公列传》"},"example":{"text":"次日长闻报，仰面视天，舌挢不能下。","book":"清·纪昀《阅微草堂笔记》卷十"},"usage":"作谓语、定语、状语；用于惊讶或恐惧时"},{"id":38152,"word":"舌敝唇枯","pinyin":"shé bì chún kū","abbr":"sbck","explanation":"形容费尽了唇舌。同“舌敝唇焦”。","source":{"text":"近时志士，舌敝唇枯，惟企强中国以比欧美。","book":"孙中山《〈民报〉发刊词》"},"similar":["舌敝唇焦"],"usage":"作谓语、宾语、状语；指费尽了唇舌"},{"id":38153,"word":"舌敝唇焦","pinyin":"shé bì chún jiāo","abbr":"sbcj","explanation":"敝：破碎；焦：干枯。说话说得舌头都破了，嘴唇都干了。形容费尽了唇舌。","source":{"text":"焦唇干舌，苦身劳力，上事群臣，下养百姓。","book":"汉·赵晔《吴越春秋·夫差内传》"},"example":{"text":"亲戚本家都说到～，也终于阻挡不住。","book":"鲁迅《彷徨·孤独者》"},"similar":["口干舌燥","唇焦口燥","舌干唇焦"],"opposite":["一言不发"],"usage":"作谓语、宾语、状语；指费尽了唇舌"},{"id":38154,"word":"舌敝耳聋","pinyin":"shé bì ěr lóng","abbr":"sbel","explanation":"讲的人舌头破了，听的人耳朵聋了。形容议论多而杂，别人不予理睬。","source":{"text":"舌敝耳聋，不见成功。","book":"《战国策·秦策一》"},"similar":["舌敝唇焦"],"usage":"作谓语、宾语、补语；指不予理睬"},{"id":38155,"word":"舌枪唇剑","pinyin":"shé qiāng chún jiàn","abbr":"sqcj","explanation":"舌如枪，唇象剑。形容争辩激烈，言词锋利，针锋相对，各不相让。","source":{"text":"凭着我唇枪舌剑定江山，见如今河清海晏，黎庶宽安。","book":"元·高文秀《渑池会》一折"},"example":{"text":"双方～，互不相让。","book":"刘凤舞《民国春秋》第二十一章"}},{"id":38156,"word":"舌柔顺终以不弊","pinyin":"shé róu shùn zhōng yǐ bù bì","abbr":"srszybb　","explanation":"弊：破坏。道家认为舌软易存，齿硬易折。比喻为人、说话柔顺，才能避免祸患。","source":{"text":"老莱子曰：‘子不见夫齿乎？虽坚刚，卒尽相摩；舌柔顺，终以不弊。","book":"《孔丛子·抗志》"}},{"id":38157,"word":"舌桥不下","pinyin":"shé qiáo bù xià","abbr":"sqbx","explanation":"形容惊讶的神态。"},{"id":38158,"word":"舌端月旦","pinyin":"shé duān yuè dàn","abbr":"sdyd","explanation":"指常在谈话中议论别人。","source":{"text":"舌端月旦，皮里阳秋。","book":"宋·叶廷圭《海录碎事·人事》"},"usage":"作宾语、定语；用于书面语"},{"id":38159,"word":"舌者兵也","pinyin":"shé zhě bīng yě","abbr":"szby","explanation":"舌头好比兵器，说话不当，既伤别人，又伤自己。","source":{"text":"口者关也，舌者兵也，出言不当，反自伤也。","book":"汉·刘向《说苑·谈丛》"}},{"id":38160,"word":"舌芒于剑","pinyin":"shé máng yú jiàn","abbr":"smyj","explanation":"言辞比剑还锋利。形容口才好，言辞锋利。","source":{"text":"一激之怒炎于火，三寸之舌芒于剑。","book":"汉·黄宪《天禄阁外史》卷二"}},{"id":38161,"word":"舌锋如火","pinyin":"shé fēng rú huǒ","abbr":"sfrh","explanation":"比喻话说得十分尖锐。","example":{"text":"他一向～，很少有人能说得过他。"},"usage":"作谓语、定语；用于说话"},{"id":38162,"word":"舌长事多","pinyin":"shé cháng shì duō","abbr":"szsd","explanation":"爱说长道短的人，容易惹事生非。告诫人说话要慎重。","source":{"text":"谚语：舌长事多，夜长梦多。"}},{"id":38163,"word":"舍军保帅","pinyin":"shě jū bǎo shuài","abbr":"sjbs","explanation":"舍：舍弃；车、帅：中国象棋的两种棋子。“车”表示战车，“帅”表示军中主将。比喻为了保护主要的而舍弃次要的。"},{"id":38164,"word":"舍命不渝","pinyin":"shě mìng bù yú","abbr":"smby","explanation":"指见危受命，死守善道。","source":{"text":"彼真之子，舍命不渝。","book":"《诗经·郑风·羔裘》"},"example":{"text":"《诗经·郑风·羔裘》：“彼真之子，舍命不渝。”"}},{"id":38165,"word":"舍命不舍财","pinyin":"shě mìng bù shě cái","abbr":"smbsc","explanation":"情愿丢掉生命也要保住钱财。比喻过分贪财，非常吝啬。","example":{"text":"她是一个～的守财奴。"},"similar":["爱财如命"],"usage":"作谓语、定语；形容十分贪婪、吝啬"},{"id":38166,"word":"舍命救人","pinyin":"shě mìng jiù rén","abbr":"smjr","explanation":"指舍弃自己的生命以拯救他人。","source":{"text":"人家有急事，咱拉着他跑，这不是舍命救人！","book":"老舍《老张的哲学》"},"similar":["舍己救人"],"usage":"作谓语、定语；指牺牲自己去救人"},{"id":38167,"word":"舍命陪君子","pinyin":"shě mìng péi jūn zǐ","abbr":"smpjz","explanation":"舍：舍弃；命；生命；陪：陪伴。指不惜一切陪伴与跟随对方。","example":{"text":"我～，奉陪到底。"},"usage":"作谓语、宾语；用于口语"},{"id":38168,"word":"舍安就危","pinyin":"shě ān jiù wēi","abbr":"sajw","explanation":"就：靠。舍弃安逸而去接近危险。指为某种目的，甘愿面临危险。","source":{"text":"延州逼近贼锋，而能舍安逸以就危隘，虽古人不逮也。","book":"宋·苏舜钦《上范希文书》"},"usage":"作宾语、定语；用于处世等"},{"id":38169,"word":"舍实听声","pinyin":"shě shí tīng shēng","abbr":"ssts","explanation":"不察实际，只听虚名。","source":{"text":"周显拘时，故苏秦；燕哙利虚誉，故让子之：皆舍实听声，呕哇之过也。","book":"汉·王符《潜夫论·实贡》"},"usage":"作宾语、定语；用于处事"},{"id":38170,"word":"舍实求虚","pinyin":"shě shí qiú xū","abbr":"ssqx","explanation":"放弃实在的，追求虚幻的。","source":{"text":"王兄本有养命金丹，今不反本求源，倒去求那服食养生之术，即使有益，何能抵得万分之一，岂非舍实求虚么？","book":"清·李汝珍《镜花缘》第三十九回"},"usage":"作谓语、宾语；用于书面语"},{"id":38171,"word":"舍己为人","pinyin":"shě jǐ wèi rén","abbr":"sjwr","explanation":"舍弃自己的利益去帮助别人。","source":{"text":"初无舍己为人之意，而其胸次悠然，直与天地万物上下同流，各得其所之妙。","book":"《论语·先进》：“夫子喟然叹曰：‘吾与点也。’”朱熹注"},"example":{"text":"爱朋友，讲义气，～，这些地方他和朱老忠有共同的地方。","book":"梁斌《漫谈〈红旗谱〉的创作（代序）》"},"similar":["舍己救人","助人为乐"],"opposite":["损人利己","假公济私"],"usage":"作谓语、定语；指尽力帮助别人"},{"id":38172,"word":"舍己为公","pinyin":"shě jǐ wèi gōng","abbr":"sjwg","explanation":"为公共的利益而舍弃个人的利益。","source":{"text":"而矜持不苟，舍己为公，却是每个共产党员具备的美德。","book":"方志敏《清贫》"},"example":{"text":"我们应当培养下一代具有～的好品德。"},"similar":["大公无私"],"usage":"作谓语、定语；指大公无私"},{"id":38173,"word":"舍己从人","pinyin":"shě jǐ cóng rén","abbr":"sjcr","explanation":"舍：弃；从：顺。放弃自己的意见，服从众人的主张。","source":{"text":"大舜有大焉，善与人同，舍己从人，乐取于人以为善。","book":"《书·大禹谟》：“稽于众，舍己从人。”《孟子·公孙丑上》"},"example":{"text":"贤契不替令郎纳采，今反～，教老夫心中如何能安。","book":"清·李汝珍《镜花缘》第十五回"},"similar":["舍己就人"],"usage":"作谓语、定语、宾语；指顾全大局","story":["我国古代圣王之一的舜，他十分虚心听取别人的意见，孟子认为舜比禹更伟大，他能善与人同，舍己从人，与人为善。他曾在历山耕过田，在河滨烧过窑，又在雷泽捕过鱼。他做过农民、陶工、渔夫，十分虚心地吸收别人的长处来提高自己"]},{"id":38174,"word":"舍己就人","pinyin":"shě jǐ jiù rén","abbr":"sjjr","explanation":"舍：弃；就：顺。放弃自己的意见，服从众人的主张。","source":{"text":"大舜有大焉，善与人同，舍己从人，乐取于人以为善。","book":"《尚书·大禹谟》：“稽于众，舍己从人。”《孟子·公孙丑上》"},"similar":["舍己从人"],"usage":"作谓语、定语、宾语；指顾全大局"},{"id":38175,"word":"舍己成人","pinyin":"shě jǐ chéng rén","abbr":"sjcr","explanation":"牺牲自己利益，成全别人。","source":{"text":"婚男嫁女，虽父母之心；舍己成人，乃高明之事。","book":"《醒世恒言·两县令竞义婚孤女》"},"example":{"text":"清·石玉昆《三侠五义》第38回：“仁兄知恩报恩，～，原是大丈夫所为。”"},"similar":["舍己为人"],"usage":"作谓语、定语；指尽力帮助别人"},{"id":38176,"word":"舍己救人","pinyin":"shě jǐ jiù rén","abbr":"sjjr","explanation":"舍己：牺牲自己。不惜牺牲自己去救别人。","source":{"text":"舍己救人也要凑好了机会，不然，你把肉割下来给别人吃，人们还许说你的肉中含有传染病的细菌。","book":"老舍《老张的哲学》"},"example":{"text":"我们要学习雷锋～的精神。"},"similar":["舍己为人","舍命救人"],"usage":"作谓语、定语；指牺牲自己去救人"},{"id":38177,"word":"舍己芸人","pinyin":"shě jǐ yún rén","abbr":"sjyr","explanation":"指看重别人，轻视自己。","source":{"text":"人病舍其田而芸人之田，所求于人者重，而所以自任者轻。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"慎毋数典忘祖，徒欢迎皙种之唾余；～，尽弃神州之特质。","book":"陶曾佑《中国文学之概观》"},"opposite":["自高自大"],"usage":"作谓语、定语；指看重别人，轻视自己"},{"id":38178,"word":"舍得一身剐，敢把皇帝拉下马","pinyin":"shě dé yī shēn guǎ，gǎn bǎ huáng dì lā xià mǎ","abbr":"sdysggbhdlxm","explanation":"比喻再难的事，拼着一死也敢干下去。","source":{"text":"拚着一身剐，敢把皇帝拉下马。","book":"《红楼梦》第六十八回"},"example":{"text":"毛泽东《在中共第八届中央委员会第二次全体会议上的讲话》：“‘～’。这是古人有言，其人叫王熙凤，又名凤姐儿，就是她说的。”"},"similar":["拼得一身剐，敢把皇帝拉下马"],"usage":"作定语、分句；指大无畏精神"},{"id":38179,"word":"舍我其谁","pinyin":"shě wǒ qí shuí","abbr":"swqs","explanation":"舍：除了。除了我还有哪一个？形容人敢于担当，遇有该做的事，决不退让。","source":{"text":"如欲平治天下，当今之世，舍我其谁也？","book":"《孟子·公孙丑下》"},"example":{"text":"我嫡孙也，欲立太子，～！","book":"明·冯梦龙《东周列国志》第七十九回"},"similar":["非我莫属","舍我复谁"],"usage":"作谓语、分句；形容人敢于担当","story":["战国时期，孟子经常与学生们谈论一些治理国家的问题，他把儒家学说加以发挥，认为君主要仁爱，以仁治天下就像运转一个小泥丸一样容易。学生问他为什么有些不愉快，孟子回答：“如欲平治天下，当今之世，舍我其谁也？”"]},{"id":38180,"word":"舍我复谁","pinyin":"shě wǒ fù shuí","abbr":"swfs","explanation":"形容人敢于担当，遇有该做的事，决不退让。同“舍我其谁”。","source":{"text":"皇天如欲治，舍我复谁耶？","book":"金·段克己《临江仙·幽怀》词"},"similar":["舍我其谁"],"usage":"作谓语、分句；形容人敢于担当"},{"id":38181,"word":"舍文求质","pinyin":"shě wén qiú zhì","abbr":"swqz","explanation":"舍：舍弃；文：文采；质：朴实。形容不重文采，而求朴实。"},{"id":38182,"word":"舍旧谋新","pinyin":"shě jiù móu xīn","abbr":"sjmx","explanation":"指弃旧求新。","source":{"text":"原田每每，舍其旧而新是谋。","book":"春秋·鲁·左丘明《左传·僖公二十八年》"},"example":{"text":"～，捉月拿云，撇了家乡，剩了孤身。","book":"清·湘灵子《轩亭冤·哭墓》"},"similar":["破旧立新"],"usage":"作谓语、定语；指弃旧求新","story":["春秋时期，晋文公在国外流亡19年后回国执政，当时楚国围攻宋国，宋国是晋国的盟友，晋文公立即派兵灭曹、卫两国，楚国得知后立即派大将子玉进攻晋国，晋文公因为旧情而对楚军退避三舍，手下人劝他舍弃旧恩而建立新功，结果打败楚军"]},{"id":38183,"word":"舍本事末","pinyin":"shě běn shì mò","abbr":"sbsm","explanation":"舍：舍弃；事：从事。抛弃根本的、主要的，而去追求枝节的、次要的。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"民舍本而事末则不令，不令则不可以守，不可以战；民舍本而事末则其产约，其产约则轻迁徙，轻迁徙则国家有患，皆有远志，无有居心。","book":"《吕氏春秋·上农》"},"similar":["舍本求末","舍本逐末","舍本问末"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38184,"word":"舍本从末","pinyin":"shě běn cóng mò","abbr":"sbcm","explanation":"比喻不抓根本环节，而只在枝节问题上下功夫。同“舍本逐末”。","source":{"text":"又有一等人，自己亲族贫乏，尚不肯周济分文，到得此辈募缘，偏肯整几两价布施，岂不是舍本从末的痴汉！","book":"《醒世恒言·汪大尹火焚宝莲寺》"},"similar":["舍本逐末"],"usage":"作谓语、宾语、定语、状语；指本末倒置"},{"id":38185,"word":"舍本求末","pinyin":"shě běn qiú mò","abbr":"sbqm","explanation":"舍：舍弃；求：追求。抛弃根本的、主要的，而去追求枝节的、次要的。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"民舍本而事末则不令，不令则不可以守，不可以战；民舍本而事末则其产约，其产约则轻迁徙，轻迁徙则国家有患，皆有远志，无有居心。","book":"《吕氏春秋·上农》"},"example":{"text":"写文章只追求形式而不注重内容，那是～。"},"similar":["舍本逐末","本末倒置"],"usage":"作谓语、宾语、定语、状语；指本末倒置"},{"id":38186,"word":"舍本逐末","pinyin":"shě běn zhú mò","abbr":"sbzm","explanation":"舍：舍弃；逐：追求。抛弃根本的、主要的，而去追求枝节的、次要的。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"弃本逐末，耕者不能半，奸邪不可禁，原起于钱。","book":"《汉书·食货志》"},"example":{"text":"写文章只追求形式而不注重内容，那是～。"},"similar":["舍近求远","贪小失大","舍本从末"],"opposite":["追本求源"],"usage":"作谓语、宾语、定语、状语；指本末倒置","story":["战国时期，孟子的弟子问他现在要办的事情很多该如何处理，孟子说应该知道要做的事情中哪些是最急需办的就先办，不能面面俱到。如果父母死子女在服丧期间吃饭狼吞虎咽，喝汤时响声很大，这就是舍本逐末，不知自己当前该干什么"]},{"id":38187,"word":"舍本问末","pinyin":"shě běn wèn mò","abbr":"sbwm","explanation":"舍：舍弃；事：从事。指舍弃农耕去从经商。泛指做事不从根本上着手，而在枝节上用功夫。","source":{"text":"岂舍本而问末者耶？","book":"西汉·刘向《战国策·齐策》"},"similar":["舍本事末"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38188,"word":"舍正从邪","pinyin":"shě zhèng cóng xié","abbr":"szcx","explanation":"丢弃正当的事不做，而去做邪恶的勾当。","source":{"text":"乃舍正从邪，背道而驰奸，彼独能介然不为，故见贵也。","book":"汉·仲长统《昌言下》"},"opposite":["舍邪归正"],"usage":"作谓语、定语；用于处世"},{"id":38189,"word":"舍死忘生","pinyin":"shě sǐ wàng shēng","abbr":"ssws","explanation":"舍死：舍得牺牲；忘生：忘掉性命。不把个人的生死放在心上。","source":{"text":"你须索舍死忘生，建立功勋。","book":"元·无名氏《锁魔镜》第二折"},"example":{"text":"近来被一妖魔在此欺虐，强要占我们水帘洞府，是我等～，与他争斗。","book":"明·吴承恩《西游记》第二回"},"similar":["舍生忘死","忘生舍死"],"opposite":["贪生怕死"],"usage":"作谓语、定语；指不把个人的生死放在心上","story":["绎州龙门大黄庄农民薛仁贵自幼喜欢武术，20岁时学成十八般武艺。他一心想投军报国，父母鼓励他为国要舍死忘生。他对父母说：“今当国家用人之际，要扫除夷虎，肃靖边疆，凭你孩儿学成武艺，智勇双全，若在两阵之间，怕不马到成功。”"]},{"id":38190,"word":"舍然大喜","pinyin":"shě rán dà xǐ","abbr":"srdx","explanation":"舍：释然、宽舒的样子。舒心地喜悦。","source":{"text":"其人舍然大喜，晓诸亦舍然大喜。","book":"《列子·天瑞》"}},{"id":38191,"word":"舍生取义","pinyin":"shě shēn qǔ yì","abbr":"ssqy","explanation":"舍：舍弃；身：生命；取：求取；义；正义。指为正义而牺牲生命。","source":{"text":"生，亦我所欲也，义，亦我所欲也。二者不可得兼，舍生而取义者也。","book":"战国·邹·孟轲《孟子·告子上》"},"example":{"text":"我们为了革命事业要～。"},"similar":["以身报国","舍身求法"],"opposite":["苟且偷生","贪生怕死"],"usage":"作谓语、定语；指为正义而牺牲生命","story":["春秋末期，大夫赵襄子杀了大夫智伯。智伯的心腹豫让发誓舍身取义要杀赵襄子，他潜入赵襄子的宅内行刺未遂。赵襄子佩服他的义气放了他。后来他把全身漆成癞子，吞下烧红的炭使声音变哑，再次去行刺未遂而自杀"]},{"id":38192,"word":"舍生取谊","pinyin":"shě shēng qǔ yì","abbr":"ssqy","explanation":"指为正义而牺牲生命。同“舍生取义”。","source":{"text":"保身遗名，民之表兮。舍生取谊，亦道用兮。","book":"《汉书·叙传上》"},"similar":["舍生取义","舍生存义"],"usage":"作谓语、定语；指为正义而牺牲生命"},{"id":38193,"word":"舍生存义","pinyin":"shě shēng cún yì","abbr":"sscy","explanation":"指为正义而牺牲生命。同“舍生取义”。","source":{"text":"元康忠勇，舍生存义。","book":"《北齐书·杜弼传赞》"},"similar":["舍生取义","舍生取谊"],"usage":"作谓语、定语；用于处事"},{"id":38194,"word":"舍生忘死","pinyin":"shě shēng wàng sǐ","abbr":"ssws","explanation":"不把个人的生死放在心上。","source":{"text":"你须索舍死忘生，建立功勋。","book":"元·关汉卿《哭存孝》第二折：“说与俺能争好斗的番官，舍生忘死家将。”元·无名氏《锁魔镜》第二折"},"example":{"text":"众将奉元帅之命，～，攻击三关。","book":"清·俞万春《荡寇志》第一百三十五回"},"similar":["奋不顾身","舍死忘生"],"opposite":["贪生怕死"],"usage":"作谓语；指不计个人安危","story":["绎州龙门大黄庄农民薛仁贵自幼喜欢武术，20岁时学成十八般武艺。他一心想投军报国，父母鼓励他为国要舍死忘生。他对父母说：“今当国家用人之际，要扫除夷虎，肃靖边疆，凭你孩儿学成武艺，智勇双全，若在两阵之间，怕不马到成功。”"]},{"id":38195,"word":"舍短从长","pinyin":"shě duǎn cóng cháng","abbr":"sdcz","explanation":"短：短处，缺点；长：长处，优点。不计较别人缺点，取其长处，予以录用。","source":{"text":"若能修六艺之术，而观此九家之言，舍短取长，则可以通万方之略矣。","book":"《汉书·艺文志》"},"example":{"text":"尘事番番宜损损，～。","book":"元·王丹桂《炼丹砂》"},"similar":["舍短取长","舍短录长"],"usage":"作谓语、定语；指抛弃缺点吸收优点"},{"id":38196,"word":"舍短取长","pinyin":"shě duǎn qǔ cháng","abbr":"sdqc","explanation":"短：短处，缺点；长：长处，优点。不计较别人缺点，取其长处，予以录用。","source":{"text":"若能修六艺之术，而观此九家之言，舍短取长，则可以通万方之略矣。","book":"《汉书·艺文志》"},"example":{"text":"及其在位，廉方自守，所交皆～，好成人之美。","book":"《后汉书·李杜列传》"},"similar":["舍短从长","舍短录长"],"usage":"作谓语、定语；指抛弃缺点吸收优点"},{"id":38197,"word":"舍短录长","pinyin":"shě duǎn lù cháng","abbr":"sdlz","explanation":"不计较别人缺点，取其长处，予以录用。同“舍短取长”。","source":{"text":"若舍短录长，则人有微技，亦获见用。","book":"《清史稿·世祖纪二》"},"example":{"text":"《清史稿·世祖纪》：“若～，则人有微技，亦获见用。”"},"similar":["舍短从长","舍短取长"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38198,"word":"舍短用长","pinyin":"shě duǎn yòng cháng","abbr":"sdyz","explanation":"短：短处，缺点；长：长处，优点。不计较别人缺点，取其长处，予以录用。","source":{"text":"若能修六艺之术，而观此九家之言，舍短取长，则可以通万方之略矣。","book":"《汉书·艺文志》"},"example":{"text":"照他的理想，最善莫过于恭王与肃顺能和衷共济，彼此～。","book":"高阳《慈禧全传》三"},"similar":["舍短从长","舍短取长","舍短录长"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38199,"word":"舍策追羊","pinyin":"shě cè zhuī yáng","abbr":"sczy","explanation":"放下手中书本去寻找丢失的羊。比喻发生错误以后，设法补救。","source":{"text":"筴，字又作策，初革反。李云：竹简也。古以写书，长二尺四寸。","book":"语出《庄子·骈拇》：“臧与榖二人相与牧羊，而俱亡其羊。问臧奚事？则挟筴读书；问榖奚事？则博塞以游。”陆德明释文"},"example":{"text":"宋·叶适《陈待制挽诗》：“昔年行往偶相同，～径未通。只么空归在何处，一竿红日海门东。”"},"usage":"作宾语、定语；用于比喻句"},{"id":38200,"word":"舍经从权","pinyin":"shě jīng cóng quán","abbr":"sjcq","explanation":"指变通常道以适应现实的需要。同“舍道用权”。","source":{"text":"无论立心端正者，我当设身处地，代生端正之想；即遇立身邪辟者，我亦当舍经从权，暂为邪辟之思。","book":"清·李渔《闲情偶寄·词典·宾白》"},"example":{"text":"清·李百川《绿野仙踪》第17回：“我的主意，要～，救你性命。”"},"similar":["舍道用权"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38201,"word":"舍身为国","pinyin":"shě shēn wéi guó","abbr":"sswg","explanation":"为国家牺牲自己的生命。","example":{"text":"黄花岗七十二烈士～的英雄事迹，永远为中国人民所敬颂。"}},{"id":38202,"word":"舍身取义","pinyin":"shě shēn qǔ yì","abbr":"ssqy","explanation":"舍：舍弃；身：生命；取：求取；义；正义。指为正义而牺牲生命","source":{"text":"生，亦我所欲也，义，亦我所欲也。二者不可得兼，舍生而取义者也。","book":"战国·邹·孟轲《孟子·告子上》"},"example":{"text":"我们为了革命事业要～"},"similar":["舍生取义","杀身成仁"],"opposite":["贪生怕死"],"usage":"作主语、谓语、定语；指为正义而牺牲生命","story":["春秋末期，大夫赵襄子杀了大夫智伯。智伯的心腹豫让发誓舍身取义要杀赵襄子，他潜入赵襄子的宅内行刺未遂。赵襄子佩服他的义气放了他。后来他把全身漆成癞子，吞下烧红的炭使声音变哑，再次去行刺未遂而自杀"]},{"id":38203,"word":"舍身图报","pinyin":"shě shēn tú bào","abbr":"sstb","explanation":"指受了别人大恩惠，舍弃生命也要给以报答。","source":{"text":"剩此微躯，皆赖天恩庇；舍身图报，如何敢逡巡回避。","book":"明·无名氏《鸣凤记·杨公劾奸》"},"usage":"作谓语、定语；用于处事"},{"id":38204,"word":"舍身成仁","pinyin":"shě shēn chéng rén","abbr":"sscr","explanation":"成：成全；仁：仁爱，儒家道德的最高标准。指为正义而舍弃生命。后泛指为了维护正义事业而舍弃自己的生命。","source":{"text":"志士仁人，无求生以害仁，有杀身以成仁。","book":"《论语·卫灵公》"},"example":{"text":"与其残酷斗争，不如让我们这些有觉悟没牵挂的人～。","book":"王朔《你不是一个俗人》"}},{"id":38205,"word":"舍身求法","pinyin":"shě shēn qiú fǎ","abbr":"ssqf","explanation":"舍身：舍弃身体；求法：寻求佛法。原指佛教徒不惜牺牲自己，远道求经。后比喻为了追求真理而不惜牺牲自己。","source":{"text":"我们从古以来，就有埋头苦干的人，有拼命硬干的人，有为民请命的人，有舍身求法的人。","book":"鲁迅《且介亭杂文·中国人失掉自信了吗》"},"usage":"作定语；指追求真理"},{"id":38206,"word":"舍车保帅","pinyin":"shě jū bǎo shuài","abbr":"sjbs","explanation":"象棋用语，比喻在某些斗争中，为保全主要的人物，就把责任推到次要人物身上。","example":{"text":"他这样做纯粹是为了～。"},"similar":["丢车保帅"],"usage":"作宾语、定语；用于激烈斗争"},{"id":38207,"word":"舍近务远","pinyin":"shě jìn wù yuǎn","abbr":"sjwy","explanation":"放弃近的，谋求远的。","source":{"text":"陛下舍近务远，弃易求难，四方疑怪，百姓怨惧，诚臣之所惑也。","book":"《后汉书·伏湛传》"},"similar":["舍近谋远","舍近求远","舍近即远"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38208,"word":"舍近即远","pinyin":"shě jìn jí yuǎn","abbr":"sjjy","explanation":"放弃近的，谋求远的。同“舍近务远”。","source":{"text":"易其居，去安从危；于其途，舍近即远。士卒有必死之心。","book":"《孙子·九地》“易其居，迂其途，使人不得虑”唐·杜牧注"},"similar":["舍近谋远","舍近务远","舍近求远"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38209,"word":"舍近取远","pinyin":"shě jìn qǔ yuǎn","abbr":"sjqy","explanation":"舍去近处的，选取远处的。形容做事走弯路。","source":{"text":"舍近谋远者，劳而无功；舍远谋近者，逸而有终。","book":"《孟子·离娄上》：“道在迩而求诸远。”《后汉书·臧宫传》"}},{"id":38210,"word":"舍近图远","pinyin":"shě jìn tú yuǎn","abbr":"sjty","explanation":"舍去近处的，追求远处的。形容做事走弯路。","source":{"text":"若犹未已，则舍近图远，抑慈示严，惟陛下之命。","book":"《孟子·离娄上》：“道在迩而求诸远。”《新唐书·武平一传》"},"example":{"text":"将军如何～？好好一个宗亲，不去结交，却要去孝敬曹操，真令人不解了！","book":"蔡东藩《后汉演义》第八十六回"}},{"id":38211,"word":"舍近求远","pinyin":"shě jìn qiú yuǎn","abbr":"sjqy","explanation":"舍去近处的，追求远处的。形容做事走弯路。","source":{"text":"舍近谋远者，劳而无功；舍远谋近者，逸而有终。","book":"《孟子·离娄上》：“道在迩而求诸远。”《后汉书·臧宫传》"},"example":{"text":"可见咱们天天是～。现有这样诗人在此，却天天去纸上谈兵。","book":"清·曹雪芹《红楼梦》第七十六回"},"similar":["小题大作","好高骛远"],"opposite":["近在咫尺"],"usage":"作谓语、宾语；指做事的方法"},{"id":38212,"word":"舍近谋远","pinyin":"shě jìn móu yuǎn","abbr":"sjmy","explanation":"舍去近处的，谋求远处的。形容做事走弯路或追求不切实际的东西。","source":{"text":"舍近谋远者，劳而无功；舍远谋近者，逸而有终。","book":"《后汉书·臧宫传》"},"similar":["舍近求远","舍近务远","舍近即远"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38213,"word":"舍道用权","pinyin":"shě dào yòng quán","abbr":"sdyq","explanation":"指变通常道以适应现实的需要。","source":{"text":"周公之摄王位，伊尹之黜太甲，霍光之废昌邑，孙綝之退少帝，谓之舍道用权，以安社稷。","book":"晋·葛洪《抱朴子·良规》"},"similar":["舍经从权"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38214,"word":"舍邪归正","pinyin":"shě xié guī zhèng","abbr":"sxgz","explanation":"舍弃邪路，回到正道上来。","source":{"text":"支离累劫，诚哉不虚。今可舍邪归正，以入佛乘。","book":"宋·释普济《五灯会元》卷一"},"similar":["改邪归正"],"opposite":["舍正从邪"],"usage":"作谓语、定语；用于处世"},{"id":38215,"word":"舐毫吮墨","pinyin":"shì háo shǔn mò","abbr":"shsm","explanation":"舐毫：以舌舔毛笔的笔尖；吮墨：以口吮吸毛笔上的墨。指写诗作文或绘画等。","source":{"text":"善图山水，酒酣，或击鼓吹笛，舐笔辄成。","book":"唐·李商隐《太尉公会昌一品制集序》：“吮墨摛词，咏日月之光华。”《旧唐书·张志和传》"}},{"id":38216,"word":"舐犊之念","pinyin":"shì dú zhī niàn","abbr":"sdzn","explanation":"舐：舔；舐犊：老牛舔小牛的毛以示爱抚。比喻对子女的慈爱之情。","source":{"text":"愧无日磾先见之明，犹怀老牛舐犊之爱。","book":"《后汉书·杨彪传》"},"similar":["舐犊之爱","舐犊之私","舐犊情深"],"usage":"作主语、宾语；用于父母对子女"},{"id":38217,"word":"舐犊之爱","pinyin":"shì dú zhī ài","abbr":"sdza","explanation":"舐：舔；舐犊：老牛舔小牛的毛以示爱抚。比喻对子女的慈爱之情。","source":{"text":"犹怀老牛舐犊之爱。","book":"南朝·宋·范晔《后汉书·杨彪传》"},"example":{"text":"每个父母都有～。"},"similar":["舐犊情深","舐犊之私","舐犊之念"],"usage":"作主语、宾语；用于父母对子女","story":["东汉末年，曹操进攻刘备，在斜谷界口驻扎，陷于进退两难境地，部将夏侯淳询问夜间口令，曹操随口说鸡肋。杨修认为是曹操退兵的意思，叫士兵打点行装，曹操借口杀了杨修。后见到骨瘦如柴的杨修父亲杨彪，问为何？杨彪说有舐犊之爱"]},{"id":38218,"word":"舐犊之私","pinyin":"shì dú zhī sī","abbr":"sdzs","explanation":"舐：舔；舐犊：老牛舔小牛的毛以示爱抚。比喻对子女的慈爱之情。","source":{"text":"愧无日磾先见之明，犹怀老牛舐犊之爱。","book":"《后汉书·杨彪传》"},"example":{"text":"诸君请从轻典，得无疑我有～乎？","book":"明·冯梦龙《东周列国志》第六回"},"similar":["舐犊之爱","舐犊之念","舐犊情深"],"usage":"作主语、宾语；用于父母对子女"},{"id":38219,"word":"舐犊情深","pinyin":"shì dú qíng shēn","abbr":"sdqs","explanation":"舐：舔；舐犊：老牛舔小牛的毛以示爱抚。比喻对子女的慈爱之情。","source":{"text":"犹怀老牛舐犊之爱。","book":"《后汉书·杨彪传》"},"example":{"text":"安老夫妻暮年守着个独子，未免～，加了几分怜爱。","book":"清·文康《儿女英雄传》第三十回"},"similar":["舐犊之爱"],"usage":"作谓语、定语；用于父母对子女","story":["东汉末年，曹操进攻刘备，在斜谷界口驻扎，陷于进退两难境地，部将夏侯淳询问夜间口令，曹操随口说鸡肋。杨修认为是曹操退兵的意思，叫士兵打点行装，曹操借口杀了杨修。后见到骨瘦如柴的杨修父亲杨彪，问为何？杨彪说有舐犊之爱"]},{"id":38220,"word":"舐痈吮痔","pinyin":"shì yōng shǔn zhì","abbr":"sysz","explanation":"舐：舔；痈：毒疮；吮：聚拢嘴唇来吸。只为人舔吸疮痔上的脓血。比喻卑劣地奉承人。","source":{"text":"秦王有病召医，破痈溃座者得车一乘；舐痔者得车五五乘。所治愈下，得车愈多。","book":"《庄子·列御寇》"},"example":{"text":"清·蒲松龄《聊斋志异·崂山道士》：“遂有～者，进宣威逞暴之术，以迎其旨。”"},"usage":"作谓语、宾语、定语；多用于比喻句"},{"id":38221,"word":"舐皮论骨","pinyin":"shì pí lùn gǔ","abbr":"splg","explanation":"舐：舔。比喻只看到一点表面现象就妄加评论。","source":{"text":"至于《野草》，此后做不做很难说，大约是不见得再做了，省得人来谬托知己，舐皮论骨。","book":"鲁迅《华盖集续编的续编·海上通信》"},"example":{"text":"爱吹牛的人都有～的毛病。"},"usage":"作谓语、宾语、定语；指妄加评论"},{"id":38222,"word":"舐糠及米","pinyin":"shì kāng jí mǐ","abbr":"skjm","explanation":"舐：用舌头舔东西。舔米外的糠，一直舔到里面的米。比喻占据的地方再夺取政权。也比喻由表及里，逐步进逼。","source":{"text":"里语有之，‘舐糠及米。’","book":"《史记·吴王濞列传》"},"example":{"text":"无人才，则之数事者，虽举亦废故也。～，终至危亡而已。","book":"清·严复《救亡决论》"},"similar":["狧糠及米","得寸进尺"],"usage":"作谓语、宾语；多用于比喻句","story":["西汉时期，各诸侯国不听中央的号令，各自为政，御史大夫晁错建议汉景帝削减各诸侯国的领地，把权力收归中央。实力最大的吴王刘濞野心勃勃地对其他诸侯国王说削减领地就像舐糠及米一样，号召其他六国起来反抗，历史上称七国之乱"]},{"id":38223,"word":"舒吭一鸣","pinyin":"shū háng yī míng","abbr":"skym","explanation":"吭：喉咙。禽鸟放开嗓子一声鸣叫。比喻放声发表意见或充分发泄愤慨情绪。","source":{"text":"观子瞻乌台诗案，其远谪穷荒，诚自取之矣。而抑不能昂首舒吭以一鸣，三木加身，则曰‘圣主如天万物春’，可耻孰甚焉。","book":"清·王夫之《夕堂永日绪论内编》卷三十七"}},{"id":38224,"word":"舒头探脑","pinyin":"shū tóu tàn nǎo","abbr":"sttn","explanation":"伸头去探看。形容行为鬼鬼祟祟。","source":{"text":"只是舒头探脑，望里边一望，又退立了两步。","book":"明·凌濛初《二刻拍案惊奇》第六回"},"example":{"text":"她～的样子十分滑稽。"},"similar":["巴头探脑","伸头探脑"],"usage":"作谓语、定语、状语；指人的行为"},{"id":38225,"word":"舒眉展眼","pinyin":"shū méi zhǎn yǎn","abbr":"smzy","explanation":"神态舒适，无忧无虑的样子。","source":{"text":"数千名农村干部，早早赶到披红结彩的会场上，一个个舒眉展眼，喜气洋洋。","book":"贾大山《取经》"},"example":{"text":"贾大山《取经》：“数千名农村干部，早早赶到披红结彩的会场上，一个个～，喜气洋洋。”"},"similar":["扬眉吐气"],"usage":"作谓语、定语；指喜悦"},{"id":38226,"word":"舒筋活络","pinyin":"shū jīn huó luò","abbr":"sjhl","explanation":"舒展筋骨，活血脉，使经络畅通。","example":{"text":"这药有～的功效。"},"similar":["舒筋活血"],"usage":"作谓语、宾语、定语；用于医学"},{"id":38227,"word":"舒舒坦坦","pinyin":"shū shū tǎn tǎn","abbr":"sstt","explanation":"舒适愉快。","source":{"text":"你宝姐姐生来是个大方的人，头里他家这样好，他也一点儿不骄傲，后来他家坏了事，他也是舒舒坦坦的。","book":"清·曹雪芹《红楼梦》第108回"},"example":{"text":"王朔《许爷》：“发现他已经脱了衣服，躺在被窝里～地睡着了。”"},"similar":["舒舒服服"],"usage":"作定语、状语；用于心情等"},{"id":38228,"word":"舒舒服服","pinyin":"shū shū fú fú","abbr":"ssff","explanation":"身心感到轻松愉快舒适。","source":{"text":"家里唱动戏，我又不得舒舒服服的看。","book":"清·曹雪芹《红楼梦》第29回"},"example":{"text":"和风吹拂，我～地躺在草地上，十分惬意。"},"similar":["舒舒坦坦"],"usage":"作宾语、定语、状语；用于人的感觉","story":["大观园内很久没有唱戏了，元春从宫里传命在清虚观打醮。王熙凤就约宝钗、宝玉、黛玉等去清虚观看戏。宝钗嫌天气太热不想去，王熙凤则说家里唱戏自己忙上忙下，没有舒舒服服的看过一回戏。贾母听后，表示愿意陪王熙凤前去"]},{"id":38229,"word":"舔唇咂嘴","pinyin":"tiǎn chún zā zuǐ","abbr":"tczz","explanation":"舔唇：舔嘴唇；咂嘴：舌尖抵住上颚吸气时发出的声音。形容贪馋的样子。也形容自觉得意的样子。","source":{"text":"说话间，刘老老已吃完了饭，拉了板儿过来，舔唇咂嘴的道谢。","book":"清·曹雪芹《红楼梦》第六回"}},{"id":38230,"word":"舛讹百出","pinyin":"chuǎn é bǎi chū","abbr":"cebc","explanation":"舛：错乱。讹：错误。错乱的地方很多。一般指书籍的写作或印制不精。","example":{"text":"这本手抄本真是～。"},"similar":["舛错百出"],"usage":"作谓语、定语；用于书籍的写作或印制等"},{"id":38231,"word":"舛错不齐","pinyin":"chuǎn cuò bù qí","abbr":"ccbq","explanation":"参差错杂。","example":{"text":"请把这些～的物品整理好。"},"similar":["参差不齐"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；用于凌乱的物体"},{"id":38232,"word":"舜日尧天","pinyin":"shùn rì yáo tiān","abbr":"sryt","explanation":"尧、舜：古代传说中的两位贤君。尧、舜在位的时期。原用以称颂帝王的盛德。后也比喻天下太平的时候。","source":{"text":"佩服瑶草驻容色，舜日尧年欢无极。","book":"南朝·梁·沈约《四时白纻歌》"},"example":{"text":"生逢舜日当尧天，经营内外皆英贤。","book":"元·丁鹤年《送岳侍郎定江浙赋税还大都》"},"similar":["舜日尧年"],"usage":"作宾语、定语；指太平盛世"},{"id":38233,"word":"舜日尧年","pinyin":"shùn rì yáo nián","abbr":"sryn","explanation":"尧、舜：古代传说中的两位贤君。尧、舜在位的时期。原用以称颂帝王的盛德。后也比喻天下太平的时候。","source":{"text":"佩服瑶草驻容色，舜日尧年欢无极。","book":"南朝·梁·沈约《四时白狞歌·春白狞》"},"example":{"text":"理当千邦应贺，正旦之节，万国来朝，端的是～也。","book":"明·无名氏《闹钟馗》楔子"},"similar":["尧年舜日"],"usage":"作宾语、定语；指太平盛世"},{"id":38234,"word":"舞凤飞龙","pinyin":"wǔ fèng fēi lóng","abbr":"wffl","explanation":"犹龙飞凤舞。气势奔放雄壮的样子。","source":{"text":"舞凤飞龙五百年，尽将锦绣裹山川。","book":"宋·张孝祥《鹧鸪天》词"},"example":{"text":"文疏贵重，上印着～；经典庄严，外护的绣衣锦套。","book":"明·清溪道人《禅真逸史》第四回"},"similar":["龙飞凤舞"],"usage":"作宾语、定语；用于书面语"},{"id":38235,"word":"舞刀跃马","pinyin":"wǔ dāo yuè mǎ","abbr":"wdym","explanation":"挥舞刀枪，纵跃战马。比喻奋勇作战。","source":{"text":"岳胜怒曰：‘好贼奴，敢如此大言。’舞刀跃马，直取天佑。","book":"《杨家将演义》第十五回"},"usage":"作谓语、宾语；用于作战"},{"id":38236,"word":"舞弄文墨","pinyin":"wǔ nòng wén mò","abbr":"wnwm","explanation":"舞、弄：故意玩弄；文、墨：文笔。故意玩弄文笔。原指曲引法律条文作弊。后常指玩弄文字技巧。","source":{"text":"明习法令，而舞弄文墨，高下其心。","book":"《隋书·王充传》"},"similar":["舞文弄墨"],"usage":"作谓语、宾语、定语；指玩弄文字技巧"},{"id":38237,"word":"舞弊营私","pinyin":"wǔ bì yíng sī","abbr":"wbys","explanation":"舞：玩弄；弊：指坏事；营：谋求。因图谋私利而玩弄欺骗手段做犯法的事。","source":{"text":"施奏咸与逄信邪枉贪污，营私多利。","book":"《汉书·翟方进传》"},"example":{"text":"周乃兹畏罪自尽，生前～，侵吞库款，无可疑的了。","book":"清·黄小配《廿载繁华梦》第三十六回"},"similar":["营私舞弊"],"opposite":["公正无私"],"usage":"作谓语、宾语、定语；指做坏事"},{"id":38238,"word":"舞态生风","pinyin":"wǔ tài shēng fēng","abbr":"wtsf","explanation":"跳舞的姿态像风吹那样飘逸。比喻舞姿轻盈。","source":{"text":"歌声遏云，舞态生风，一进一退，光华夺目，如游天上，睹仙姬，非复人间思想所及。","book":"明·冯梦龙《东周列国志》第七十九回"}},{"id":38239,"word":"舞文巧法","pinyin":"wǔ wén qiǎo fǎ","abbr":"wwqf","explanation":"故意玩弄文字，巧于利用法令，以达到邪恶的目的。","source":{"text":"长大成吏，舞文巧法，徇私为己，勉赴权利。","book":"汉·王充《论衡·程材》"},"similar":["舞文枉法"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38240,"word":"舞文巧诋","pinyin":"wǔ wén qiǎo dǐ","abbr":"wwqd","explanation":"玩弄文字，诋毁构陷。","source":{"text":"所治即豪，必舞文巧诋。","book":"《汉书·张汤传》"},"example":{"text":"宋·苏轼《论积欠六事并乞捡会应诏所论四事一处行下状》：“官吏刻薄，与圣意异，～，使不该放。”"},"usage":"作谓语、宾语；用于处事"},{"id":38241,"word":"舞文弄墨","pinyin":"wǔ wén nòng mò","abbr":"wwnm","explanation":"舞、弄：故意玩弄；文、墨：文笔。故意玩弄文笔。原指曲引法律条文作弊。后常指玩弄文字技巧。","source":{"text":"明习法令，而舞弄文墨，高下其心。","book":"《隋书·王充传》"},"example":{"text":"而写碑的人偏要～，所以反面越舞越糊涂。","book":"鲁迅《华盖集续编的续编·厦门通信》"},"similar":["舞词弄札"],"opposite":["目不识丁"],"usage":"作谓语、宾语、定语；指玩弄文字技巧"},{"id":38242,"word":"舞文弄法","pinyin":"wǔ wén nòng fǎ","abbr":"wwnf","explanation":"舞、弄：耍弄，玩弄；文：法令条文；法：法律。歪曲法律条文，舞弊徇私。","source":{"text":"吏士舞文弄法，刻章伪书，不避刀锯之诛者，没于赂遗也。","book":"《史记·货殖列传》"},"example":{"text":"我想这为吏的扭曲作直，～，只这一管笔上，送了多少人也呵。","book":"元·孟汉卿《魔合罗》第三折"},"similar":["舞文玩法","弄法舞文"],"usage":"作谓语、宾语、定语；指歪曲法律条文"},{"id":38243,"word":"舞文枉法","pinyin":"wǔ wén wǎng fǎ","abbr":"wwwf","explanation":"故意玩弄文字，巧于利用法令，以达到邪恶的目的。","source":{"text":"长大成吏，舞文巧法，徇私为己，勉赴权利。","book":"汉·王充《论衡·程材》"},"example":{"text":"稽查书办，没有一个不～。","book":"清·李绿园《歧路灯》第一百六回"},"similar":["舞文巧法"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38244,"word":"舞文玩法","pinyin":"wǔ wén wán fǎ","abbr":"wwwf","explanation":"歪曲法律条文，舞弊徇私。同“舞文弄法”。","source":{"text":"吏士舞文弄法，刻章伪书，不避刀锯之诛者，没于赂遗也。","book":"《史记·货殖列传》"},"example":{"text":"假使真只胡涂，倒还不失为胡涂人，但他是知道～的。","book":"鲁迅《坟·从胡须说到牙齿》"},"similar":["舞文弄法","弄法舞文"],"usage":"作谓语、宾语、定语；指歪曲法律条文"},{"id":38245,"word":"舞文饰智","pinyin":"wǔ wén shì zhì","abbr":"wwsz","explanation":"指舞文弄墨、利用才智以作奸伪。","source":{"text":"贞观中，万年尉司马玄景舞文饰智，以邀干没，太宗弃之都市。","book":"《旧唐书·魏元忠传》"},"usage":"作谓语、定语；用于处事"},{"id":38246,"word":"舞枪弄棒","pinyin":"wǔ qiāng nòng bàng","abbr":"wqnb","explanation":"指使弄刀枪棍棒等兵器，借指习武。","source":{"text":"试看全伙里舞枪弄棒的书生，犹胜满朝中欺君害民的官吏。","book":"明·施耐庵《水浒传》第82回"},"similar":["使枪弄棒"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":38247,"word":"舞棍弄棒","pinyin":"wǔ gùn nòng bàng","abbr":"wgnb","explanation":"挥舞着棍棒，高压统治。","source":{"text":"人民都成了反革命，而真正的反革命都戴着马克思主义的面具，在人民头上舞棍弄棒……","book":"路遥《平凡的世界》第二卷第36章"},"usage":"作谓语、定语；用于书面语"},{"id":38248,"word":"舞榭歌台","pinyin":"wǔ xiè gē tái","abbr":"wxgt","explanation":"榭：建筑在高土台上的敞屋。指歌舞场所。","source":{"text":"舞榭歌台，风流总被雨打风吹去。","book":"南宋·辛弃疾《永遇乐》词"},"example":{"text":"暗昏柳眼，勒绽梅腮，填蔽了锦重重禁阙宫阶，遮掩了绿沉沉～。","book":"清·褚人获《隋唐演义》第十一回"},"similar":["舞榭歌楼"],"usage":"作主语、宾语、定语；指舞台"},{"id":38249,"word":"舞榭歌楼","pinyin":"wǔ xiè gē lóu","abbr":"wxgl","explanation":"榭：建筑在高台上的房屋。为歌舞娱乐而设立的堂或楼台。泛指歌舞场所。同“舞榭歌台”。","source":{"text":"他每待强巴劫深宅大院，怎知道摧折了舞榭歌楼？","book":"宋·沈唐《望海潮》词：“松偃旧亭，城高故国，空余舞榭歌楼。”元·关汉卿《救风尘》第二折"},"example":{"text":"小苗儿忒煞风流，镇日介～，花朝月夕。","book":"明·方汝浩《禅真逸史》第四回"},"similar":["舞榭歌台"],"usage":"作主语、宾语、定语；指舞台"},{"id":38250,"word":"舞燕歌莺","pinyin":"wǔ yàn gē yíng","abbr":"wygy","explanation":"歌声宛转如黄莺，舞姿轻盈如飞燕。亦形容景色宜人，形势大好。","source":{"text":"罨画溪山红锦障，舞燕歌莺台阁。","book":"宋·梁栋《念奴娇》词"},"example":{"text":"韶华向人如旧，莫青春行乐负平生。说与东君知道，先迎～。","book":"元·刘敏中《木兰花慢》词"},"similar":["歌莺舞燕"],"usage":"作宾语、定语；形容一派太平景象"},{"id":38251,"word":"舞爪张牙","pinyin":"wǔ zhǎo zhāng yá","abbr":"wzzy","explanation":"原形容猛兽的凶相，后常用来比喻猖狂凶恶的样子。","source":{"text":"鱼生三日游于江湖，龙生三日张牙舞爪。","book":"《敦煌变文集·孔子项托相问书》附录二《新编小儿难孔子》"},"example":{"text":"百般怪兽，尽皆～；千种奇禽，类各舒毛鼓翼。","book":"明·凌濛初《初刻拍案惊奇》卷三十七"},"similar":["张牙舞爪"],"usage":"作谓语、定语、状语；指人的外表神态"},{"id":38252,"word":"舞笔弄文","pinyin":"wǔ bǐ nòng wén","abbr":"wbnw","explanation":"指舞文弄墨。","source":{"text":"若不达政体，而舞笔弄文，支离构辞，穿凿会巧。","book":"南朝·梁·刘勰《文心雕龙·议对》"},"similar":["舞文弄墨"],"usage":"作谓语、宾语；指舞文弄墨"},{"id":38253,"word":"舞衫歌扇","pinyin":"wǔ shān gē shàn","abbr":"wsgs","explanation":"舞衫：跳舞的人所穿的衣服；歌扇：唱歌的人所拿的扇子。歌舞的装束、用具，即指歌舞。也指能歌善舞的人。","source":{"text":"舞衫回袖胜春风，歌扇当窗似秋月。","book":"南朝陈·徐陵《杂曲》"},"example":{"text":"方俊官乃作此状，谁信曾～，倾倒一时耶？","book":"清·纪昀《阅微草堂笔记》卷九"},"similar":["舞裙歌扇"],"usage":"作主语、宾语、定语；指歌舞或歌舞妓"},{"id":38254,"word":"舞裙歌扇","pinyin":"wǔ qún gē shàn","abbr":"wqgs","explanation":"歌舞的装束、用具，即指歌舞。也指能歌善舞的人。同“舞衫歌扇”。","source":{"text":"东园捶鼓赏新醅，唤取舞裙歌扇，探春回。","book":"宋·晁补之《南歌子》词"},"similar":["舞衫歌扇"],"usage":"作主语、宾语、定语；指歌舞或歌舞妓"},{"id":38255,"word":"舞词弄札","pinyin":"wǔ cí nòng zhá","abbr":"wcnz","explanation":"犹言舞文弄墨。故意玩弄文笔。原指曲引法律条文作弊。后常指玩弄文字技巧。","source":{"text":"其有舞词弄札，饰非文过，若王隐虞预毁辱相凌，子野体文释纷相谢，用舍由乎臆说，威福行于笔端，斯乃作者之丑行，人伦所同疾也。","book":"唐·刘知几《史通·曲笔》"},"example":{"text":"夫以一时之富贵，冒万亿不韪而不辞，～，眩惑天下，使贱儒元恶为之则已矣。","book":"清·章炳麟《驳康有为论革命书》"},"similar":["舞文弄墨"],"usage":"作谓语、宾语、定语；用于文人"},{"id":38256,"word":"舞鸾歌凤","pinyin":"wǔ luán gē fèng","abbr":"wlgf","explanation":"鸾凤在歌舞。比喻男女间情深意切。","source":{"text":"宴桃源深洞，一曲舞鸾歌凤，长记欲别时，残月落花烟重，如梦，如梦，和泪出门相关。","book":"宋·胡仔《苕溪渔隐丛话后集·长短句》"},"example":{"text":"明·孙梅锡《琴心记·金闺荣返》：“曾共锦帏闲哄，一曲～。”"},"usage":"作宾语、定语；用于书面语","story":["后唐庄宗时期，宫殿内部整修，从地下挖出一块断碑，上面有32个字：“宴桃源深洞，一曲舞鸾歌凤，长记欲别时，残月落花烟重，如梦，和泪出门相送。”唐庄宗觉得有趣，就命乐工谱曲，带头唱此新歌"]},{"id":38257,"word":"舟中之指可掬","pinyin":"zhōu zhōng zhī zhǐ kě jū","abbr":"zzzzkj","explanation":"指：手指。船里被砍断的手指可以捧起来。形容战败后的惨烈场面。","source":{"text":"中军下军争舟，舟中之指可掬也。","book":"《左传·宣公十二年》"},"example":{"text":"及败，奔走欲渡而北，卒争舟，而以刃击引，～也。（汉·刘向《新序·杂事》）"}},{"id":38258,"word":"舟中敌国","pinyin":"zhōu zhōng dí guó","abbr":"zzdg","explanation":"同船的人都成的敌人。比喻大家反对，十分孤立。","source":{"text":"若君不修德，舟中之人尽为敌国也。","book":"西汉·司马迁《史记·孙子吴起列传》"},"example":{"text":"势苟安则异类同心也，势苟危则～也。","book":"唐·陆贽《论关中事宜状》"},"similar":["众叛亲离"],"usage":"作宾语、定语；指人与人之间","story":["战国时期著名的军事家吴起听说魏文侯很聪明贤能，就去投靠魏国，被任命魏军的统领，对付秦国和韩国。魏文侯死后，魏武侯乘船时说江山多美好。吴起说如不施行仁政，那么共乘的小船上也会有敌国的存在，魏武侯赞同他的观点"]},{"id":38259,"word":"舟水之喻","pinyin":"zhōu shuǐ zhī yù","abbr":"zszy","explanation":"舟：船。对船和水的比喻，即水可以载舟，也可覆舟。老百姓可以帮助君王建立朝廷，也可以起来反抗推翻朝廷。","source":{"text":"愿陛下深察东野之弊，留意舟水之喻，息奔驷于未尽，节力役于未困。","book":"《三国志·魏志·王基传》"},"usage":"作宾语；用于比喻句"},{"id":38260,"word":"舟车之利","pinyin":"zhōu chē zhī lì","abbr":"zczl","explanation":"舟：船，水运；车：车辆，陆运；利：便利。车船便利。形容水陆运输方便。","source":{"text":"舟车机械之利，用力少，至功大，则入多。","book":"战国·韩·韩非《韩非子·难二》"},"usage":"作宾语；指交通发达"},{"id":38261,"word":"舟车之苦","pinyin":"zhōu chē zhī kǔ","abbr":"zczk","explanation":"坐船、坐车的辛苦。指旅途的劳累。"},{"id":38262,"word":"舟车劳顿","pinyin":"zhōu chē láo dùn","abbr":"zcld","explanation":"舟车：船与车，泛指一切水陆交通工具。劳顿：劳累疲倦。形容旅途疲劳困顿。","source":{"text":"那两位记者都说：‘今天方博士舟车劳顿，明天早晨到府聆教。’","book":"钱钟书《围城》第二章"},"example":{"text":"等回到保定，因为～，公事又多，曾国藩的眼疾，越发重了，而岁尾年头，不如意的事，纷至沓来。","book":"高阳《慈禧全传》第二部二七"}},{"id":38263,"word":"舟车楫马","pinyin":"zhōu chē jí mǎ","abbr":"zcjm","explanation":"舟：船；楫：船桨。古时以战船当车，以船桨当马。指古代的水战","source":{"text":"《太白阴经》云：水战之具，始自伍员制之以与楚战，以船为车，以楫为马。","book":"明·张鼎思《琅琊代醉编·舟车楫马》"},"usage":"作宾语、定语；用于书面语"},{"id":38264,"word":"航海梯山","pinyin":"háng hǎi tī shān","abbr":"hhts","explanation":"渡过大海，攀越高山。指经历艰远的路程。","source":{"text":"航海梯山，奉白环之使。","book":"南朝·梁·简文帝《大法颂》序"},"example":{"text":"～，贡奉循环。","book":"唐·于兢《王审知德政碑》"},"similar":["跋山涉水"],"usage":"作主语、分句；指长途跋涉"},{"id":38265,"word":"舳舻千里","pinyin":"zhú lú qiān lǐ","abbr":"zlql","explanation":"舳：船后持舵处；舻：船前刺棹处。形容船多，首尾相接，千里不绝。","source":{"text":"舳舻千里，薄枞阳而出，作《盛唐枞阳之歌》。","book":"《汉书·武帝纪》"},"example":{"text":"宋·苏轼《前赤壁斌》：“方其破荆州，下江陵，顺流而东也，～，旌旗蔽空。”"},"similar":["轴轳千里"],"usage":"作定语；用于书面语"},{"id":38266,"word":"舳舻相接","pinyin":"zhú lú xiāng jiē","abbr":"zlxj","explanation":"舳：船尾；舻：船头。形容船与船相接，数量多。","source":{"text":"帝御龙舟，文武官五品以上给楼船，九品以上给黄篾舫，舳舻相接，二百余里。","book":"《隋书·食货志》"},"similar":["舳舻相继"],"usage":"作宾语、定语；指船多"},{"id":38267,"word":"舳舻相继","pinyin":"zhú lú xiāng jì","abbr":"zlxj","explanation":"舳：船尾。舻：船头。指船首尾相接，数量很多。亦作“舳舻相接”。","source":{"text":"时舳舻相继，连接千里，自大梁至淮江，联绵不绝，锦帆过处，香闻百里。","book":"唐·韩偓《开河记》"},"similar":["舳舻相接"],"usage":"作宾语、定语；指船多"},{"id":38268,"word":"船到桥头自会直","pinyin":"chuán dào qiáo tóu zì huì zhí","abbr":"cdqtzhz","explanation":"意谓事先不用着急，到时候问题总可以解决。这是在无可奈何中强作宽慰的说法。同“船到桥门自然直”。","source":{"text":"俗语说，船到桥头自会直，那就到哪会说哪会话吧！","book":"程树榛《钢铁巨人》十三"},"example":{"text":"二爷的话不错，事缓则圆，～，你放心好了！","book":"高阳《草莽英雄》第二十六章"},"similar":["船到桥门自会直"],"usage":"作定语、宾语、分句；指顺其自然"},{"id":38269,"word":"船到桥门自会直","pinyin":"chuán dào qiáo mén zì huì zhí","abbr":"cdqmzhz","explanation":"桥：桥梁。比喻事先不必多虑，问题自会得到解决。","source":{"text":"算了罢！船到桥门自会直！忘八才去赶他妈妈的夜市！","book":"茅盾《赛会》"},"example":{"text":"我不相信～。"},"similar":["顺其自然","车到山前必有路"],"usage":"作定语、宾语、分句；指顺其自然"},{"id":38270,"word":"船到桥门自然直","pinyin":"chuán dào qiáo mén zì rán zhí","abbr":"cdqmzrz","explanation":"意谓事先不用着急，到时候问题总可以解决。这是在无可奈何中强作宽慰的说法。","source":{"text":"黄二官：不要这样想，‘船到桥门自然直’，我们慢慢的总有法子好想。","book":"洪深《香稻米》第二幕"},"similar":["船到桥门自会直"],"usage":"作定语、宾语、分句；指顺其自然"},{"id":38271,"word":"船到江心补漏迟","pinyin":"chuán dào jiāng xīn bǔ lòu chí","abbr":"cdjxblc","explanation":"船到江心才补漏洞。比喻补救不及时，对事情毫无帮助。","source":{"text":"恁时节，船到江心补漏迟，烦恼怨他谁。事要前思，免劳后悔。","book":"元·关汉卿《救风尘》一折"},"example":{"text":"这是蓝田种玉结亲娱，今日里～。","book":"元·高明《琵琶记·散发归林》"},"similar":["于事无补"],"usage":"作宾语、定语；用于劝诫人"},{"id":38272,"word":"船坚炮利","pinyin":"chuán jiān pào lì","abbr":"cjpl","explanation":"利：锋利。指战舰坚固，大炮猛烈。形容海军强盛。","source":{"text":"此次士密等前来寻衅……无非恃其般坚炮利，以悍济贪。","book":"清·林则徐等《会奏穿鼻尖沙嘴叠次轰击夷船情形折》"},"example":{"text":"欧洲富强之本，不尽在于～而在于人能尽其才，地能尽其利。","book":"孙中山《上李鸿章书》"},"usage":"作谓语、定语；形容海军强盛"},{"id":38273,"word":"船多不碍路","pinyin":"chuán duō bù ài lù","abbr":"cdbal","explanation":"比喻各走各的路，彼此不妨碍。","example":{"text":"～，咱们谁也不碍谁。"},"similar":["船多不碍港"],"usage":"作宾语、定语、分句；用于口语"},{"id":38274,"word":"船骥之托","pinyin":"chuán jì zhī tuō","abbr":"cjzt","explanation":"船骥：船只和千里马；托：信托。比喻可信托，可重用的人才。","source":{"text":"绝江者托于船，致远者托于骥，霸王者托于贤。伊尹、吕尚、管夷吾、百里奚，此霸王者之船骥也。","book":"《吕氏春秋·知度》"}},{"id":38275,"word":"良史之才","pinyin":"liáng shǐ zhī cái","abbr":"lszc","explanation":"良史：旧指有学识，记事无所隐讳的史官。形容优秀史官的才能。","source":{"text":"然自刘向、扬雄博极群书，皆称迁有良史之才。","book":"《汉书·司马迁传赞》"}},{"id":38276,"word":"良宵好景","pinyin":"liáng xiāo hǎo jǐng","abbr":"lxhj","explanation":"美好的夜晚和景色。同“良宵美景”。","source":{"text":"我与你捧瑶殇酒满倾，今日个堪赏玩在公厅，休辜负良宵好景。","book":"明·无名氏《认金梳》第三折"},"similar":["良宵美景"],"usage":"作宾语；指夜晚"},{"id":38277,"word":"良宵美景","pinyin":"liáng xiāo měi jǐng","abbr":"lxmj","explanation":"宜人的夜，美丽的景色。","source":{"text":"从今永保无灾障，莫思量，良宵美景，不乐计非长。","book":"明·胡文焕《群音类选·胡全庵》"},"example":{"text":"我们不要辜负这～。"},"similar":["良辰美景","良宵好景"],"usage":"作宾语；指夜晚"},{"id":38278,"word":"良家子","pinyin":"liáng jiā zǐ","abbr":"ljz","explanation":"旧指良家的子女。汉代把技艺、商贾、工匠等都划在良家之外。","source":{"text":"汉兴，六郡良家子，选给羽林期门。","book":"《汉书·地理志下》"},"example":{"text":"归元贤大夫，断脰～。","book":"明·顾炎武《秋山》"}},{"id":38279,"word":"良工不示人以朴","pinyin":"liáng gōng bù shì rén yǐ pǔ","abbr":"lgbsryp","explanation":"朴：没有细加工的木材。高明的木匠不把非成品拿给人看。比喻有贤德的人一定要把人培养成材或所做的事一定要完美。","source":{"text":"汝大才，当晚成。良工不示人以朴，且从所好。","book":"《后汉书·马援传》"}},{"id":38280,"word":"良工巧匠","pinyin":"liáng gōng qiǎo jiàng","abbr":"lgqj","explanation":"良工：手艺精良的工人；巧匠：技艺精巧的匠人。指技艺高超的工匠。","source":{"text":"齐之东鄙人有常致苦者……不知致苦，卒为齐国良工，泽及子孙。","book":"《吕氏春秋·慎大览·不广》"},"example":{"text":"今洛阳国～，批红判白，接以他木，与造化争妙。","book":"宋·邵博《河南邵氏闻见后录·李氏仁丰园》"},"similar":["能工巧匠"],"usage":"作主语、宾语；指工艺技术高超的人"},{"id":38281,"word":"良工心苦","pinyin":"liáng gōng xīn kǔ","abbr":"lgxk","explanation":"良工：手艺高明的工匠。形容优秀艺术家的作品，在创作过程中都费尽心思。","source":{"text":"已知仙客意相亲，更觉良工心独苦。","book":"唐·杜甫《题李尊师松树障子歌》诗"},"example":{"text":"谛听其声，如出一口，无高低断续之痕者，虽曰～，然作者深心，于兹埋没。","book":"清·李渔《闲情偶记·演习》"},"similar":["良工苦心"],"usage":"作宾语；指精心构思"},{"id":38282,"word":"良工苦心","pinyin":"liáng gōng kǔ xīn","abbr":"lgkx","explanation":"形容优秀艺术家的作品，在创作过程中都费尽心思。又泛指用心良苦。","source":{"text":"良工苦心为远别，天机要眇潜得之。","book":"宋·刘攽《次韵苏子瞻〈韩斡马〉赠李伯时》"},"example":{"text":"[伯父]特特的给我父母立了这座家庙；不但我身有所归，便是我的双亲也神有所托，这是一片～。","book":"《儿女英雄传》第二五回"},"similar":["良工心苦"],"usage":"作宾语；指精心构思"},{"id":38283,"word":"良师益友","pinyin":"liáng shī yì yǒu","abbr":"lsyy","explanation":"良：好；益：有帮助。使人得到教益和帮助的好老师和好朋友。","source":{"text":"益者三友，损者三友。友直、友谅、友多闻，益矣；友便辟、友善柔、友便佞，损矣。","book":"《论语·述而》：“三人行必有我师焉，择其善者而从之，其不善者而改之。”《论语·季氏》"},"example":{"text":"和一位缔交半个多世纪的～诀别，悲痛之情是难以尽述的。","book":"夏衍《知公此去无遗恨——痛悼郭沫若同志》"},"similar":["情同手足","莫逆之交"],"opposite":["一丘之貉","狐群狗党"],"usage":"作主语、宾语、定语；指有帮助的人"},{"id":38284,"word":"良师诤友","pinyin":"liáng shī zhèng yǒu","abbr":"lszy","explanation":"良：好；诤：敢于直言。很好的老师，能够直言相劝的朋友。","example":{"text":"他是我的良师诤友。"},"similar":["良师益友","莫逆之交","情同手足"],"opposite":["狐群狗党","一丘之貉"],"usage":"作宾语、定语；同“良师益友”"},{"id":38285,"word":"良弓无改","pinyin":"liáng gōng wú gǎi","abbr":"lgwg","explanation":"指继承父祖的优良传统和事业。","source":{"text":"良弓无改，必学为箕。","book":"语出《礼记·学记》"},"example":{"text":"其有开国承家，世禄不坠，积仁累德，～……略书于传可也。","book":"唐·刘知幾《史通·书事》"},"usage":"作宾语、定语；用于好事物"},{"id":38286,"word":"良心发现","pinyin":"liáng xīn fā xiàn","abbr":"lxfx","explanation":"指触发了善良之心而对自己的言行有所悔悟。","source":{"text":"言人之良心，虽已放矢，然其日夜之间，亦必有所生长，故平旦未与接物，其气清明之际，良心必有所发见也。","book":"宋·朱熹《孟子集注·告子上》"},"example":{"text":"如此一想，自然闷恨，要哭了。姐姐，你说这宗忖度岂非～么？","book":"清·李汝珍《镜花缘》第六十六回"}},{"id":38287,"word":"良时吉日","pinyin":"liáng shí jí rì","abbr":"lsjr","explanation":"美好的时辰，吉利的日子。后常用以称宜于成亲的日子。同“良辰吉日”。","source":{"text":"新道台择了接印日期，颁了红谕出去，到了良时吉日，便具了朝衣朝冠，到衙门接印。","book":"《二十年目睹之怪现状》第七八回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第78回：“新道台择了接印日期，颁了红谕出去，到了～，便具了朝衣朝冠，到衙门接印。”"},"similar":["吉日良辰","黄道吉日","良辰吉日"],"usage":"作宾语；指宜于成亲的日子"},{"id":38288,"word":"良时美景","pinyin":"liáng shí měi jǐng","abbr":"lsmj","explanation":"美好的时光和景物。同“良辰美景”。","source":{"text":"良时美景，始云蒸而电激；临水登山，忽风流而雨散。","book":"唐·杨炯《送并州旻上人诗序》"},"similar":["良辰美景"],"usage":"作主语、宾语；用于环境与心情都好时"},{"id":38289,"word":"良有以也","pinyin":"liáng yǒu yǐ yě","abbr":"lyyy","explanation":"良：很，甚；以：所以，原因。指某种事情的产生是很有些原因的。","source":{"text":"古人一馈十起，辄沐挥洗，良有以也。","book":"晋·常璩《华阳国志·公孙述刘二牧志》"},"example":{"text":"浮生若梦，为欢几何，古人秉烛夜游，～。","book":"唐·李白《春夜宴桃李园序》"}},{"id":38290,"word":"良玉不琢","pinyin":"liáng yù bù zhuó","abbr":"lybz","explanation":"美玉不用雕琢，保持其天然的美。比喻本质好不凭借修饰外表。","source":{"text":"良玉不雕，美言不闻，何谓也？”《汉书·董仲舒传》“臣闻良玉不瑑，资质润美；不待刻瑑，此亡异于达巷党人不学而自知也。","book":"汉·扬雄《法言·寡见》"},"example":{"text":"语曰：“～”，谓其不借美于外也。","book":"宋·陈师道《后山谈丛》卷一"}},{"id":38291,"word":"良玉不瑑","pinyin":"liáng yù bù zhuàn","abbr":"lybz","explanation":"美玉不用雕琢，保持其天然的美。比喻本质好不凭借修饰外表。","source":{"text":"良玉不雕，美言不闻，何谓也？”《汉书·董仲舒传》“臣闻良玉不瑑，资质润美；不待刻瑑，此亡异于达巷党人不学而自知也。","book":"汉·扬雄《法言·寡见》"}},{"id":38292,"word":"良玉不雕","pinyin":"liáng yù bù diāo","abbr":"lybd","explanation":"美玉不用雕琢，保持其天然的美。比喻本质好不凭借修饰外表。","source":{"text":"良玉不雕，美言不闻，何谓也？”《汉书·董仲舒传》“臣闻良玉不瑑，资质润美；不待刻瑑，此亡异于达巷党人不学而自知也。","book":"汉·扬雄《法言·寡见》"}},{"id":38293,"word":"良田不如心田好","pinyin":"liáng tián bù rú xīn tián hǎo","abbr":"ltbrxth","explanation":"比喻财产多不如心地善良好。"},{"id":38294,"word":"良知良能","pinyin":"liáng zhī liáng néng","abbr":"lzln","explanation":"旧指人的天赋的首选观念和本能。","source":{"text":"人之所不学而能者，其良能也；所不虑而知者，其良知也。","book":"《孟子·尽心上》"},"example":{"text":"孟子皆以仁义言之，言～亦然。","book":"清·恽敬《读孟子二》"},"usage":"作宾语；指人的观念和本能"},{"id":38295,"word":"良禽择木","pinyin":"liáng qín zé mù","abbr":"lqzm","explanation":"比喻贤者择主而事。","source":{"text":"鸟则择木，木岂能择鸟。","book":"《左传·哀公十一年》"},"example":{"text":"岂不闻“～而栖，贤臣择主而事”。遇可事之主，而交臂失之，非丈夫也。","book":"明·罗贯中《三国演义》第十四回"},"usage":"作宾语；比喻贤者择主而事"},{"id":38296,"word":"良苗怀新","pinyin":"liáng miáo huái xīn","abbr":"lmhx","explanation":"苗壮的禾苗正孕育着谷穗。形容生机盎然。","source":{"text":"秉力时务，解颜劝农人。平畴交运风，良苗亦怀新。","book":"晋·陶潜《癸卯岁始春怀谷田舍》"},"example":{"text":"吾读渊明诗，喜其有生趣。时鸟变声喜，～穗。","book":"陈毅《冬夜杂咏·吾读》"}},{"id":38297,"word":"良药苦口","pinyin":"liáng yào kǔ kǒu","abbr":"lykk","explanation":"好药往往味苦难吃。比喻衷心的劝告，尖锐的批评，听起来觉得不舒服，但对改正缺点错误很有好处。","source":{"text":"良药苦于口而利于病，忠言逆于耳而利于行。","book":"《韩非子·外储说左上》：“夫良药苦于口，而智者劝而饮之，知其入而已己疾也。”《孔子家语·六本》"},"example":{"text":"夫～，惟冼者能甘之。忠言逆耳，惟达者能受之。","book":"《三国志·吴志·孙奋传》"},"similar":["忠言逆耳"],"opposite":["口蜜腹剑","笑里藏刀","甜言蜜语"],"usage":"作主语、宾语、分句；用于规劝"},{"id":38298,"word":"良莠不一","pinyin":"liáng yǒu bù yī","abbr":"lyby","explanation":"莠：狗尾草，很象谷子，常混在禾苗中。比喻好人坏人都有，混杂在一起。难以区分。同“良莠不齐”。","source":{"text":"闽、浙两省棚民，以种麻靛、造纸、烧灰为业，良莠不一。","book":"《清史稿·觉罗满保传》"},"example":{"text":"你对那巡长说，难民们～，要是发生了什么事，他这巡长担当得起吗？","book":"茅盾《清明前后》第四幕"},"similar":["良莠不齐","良莠混杂"],"usage":"作谓语、定语；用于书面语"},{"id":38299,"word":"良莠不分","pinyin":"liáng yǒu bù fēn","abbr":"lybf","explanation":"莠：狗尾草，很象谷子，常混在禾苗中。好人坏人都有，混杂在一起，难以分辨。","source":{"text":"且说彼时捐例大开，各省侯补人员十分拥挤，其中鱼龙混杂，良莠不齐。","book":"清·李宝嘉《官场现形记》第五十六回"},"example":{"text":"驭夷长策，当先剿后抚，未剿遽抚，～。兵至，相率归诚；兵退，复出焚掠。","book":"《清史稿·吴杰传》"},"similar":["是非不分","良莠不齐"],"opposite":["泾渭分明"],"usage":"作谓语、定语；指好坏不分"},{"id":38300,"word":"良莠不齐","pinyin":"liáng yǒu bù qí","abbr":"lybq","explanation":"莠：狗尾草，很象谷子，常混在禾苗中。好人坏人都有，混杂在一起。","source":{"text":"且说彼时捐例大开，各省侯补人员十分拥挤，其中鱼龙混杂，良莠不齐。","book":"清·李宝嘉《官场现形记》第五十六回"},"example":{"text":"兼之人品～，诚恐因逸生事。","book":"太平天国·洪秀全《整顿属员诏》"},"similar":["混淆视听","混淆是非"],"opposite":["泾渭分明"],"usage":"作谓语；用于书面语","story":["明朝时期，田艺蘅《留青札记》中记载：元朝时称人以郎、官、秀为等第，“秀”是最高级别，“郎”是最下的，至明朝时称鄙人为“不郎不秀”，是指不高不下。良莠不齐就是不郎不秀，称那些高不成、低不就的人"]},{"id":38301,"word":"良莠淆杂","pinyin":"liáng yǒu xiáo zá","abbr":"lyxz","explanation":"淆：混淆。杂：混杂。好坏混在一起。比喻好人和坏人难以区分。亦作“良莠混杂”","source":{"text":"开山发矿，多人群聚，良莠淆杂，臣通饬严禁。","book":"《清史稿·萧永藻传》"},"similar":["良莠混杂"],"usage":"作谓语、定语；用于书面语"},{"id":38302,"word":"良莠混杂","pinyin":"liáng yǒu hùn zá","abbr":"lyhz","explanation":"莠：狗尾草。好苗和野草混杂在一起。比喻好人坏人混杂在一起，难以区分。","source":{"text":"开山发矿，多人群聚，良莠混杂，臣通饬严禁。","book":"《清史稿·萧永藻传》"},"example":{"text":"这个班的学生～，得因材施教"},"similar":["良莠不齐","良莠淆杂"],"usage":"作谓语、定语；用于书面语"},{"id":38303,"word":"良质美手","pinyin":"liáng zhì měi shǒu","abbr":"lzms","explanation":"心灵美好，手艺精巧。","source":{"text":"卿巧越嵇心，妙臻羊体，良质美手，信在今辰。岂止当世称奇，足可追踪古烈。","book":"《梁书·柳恽传》"},"usage":"作宾语、定语；用于书面语"},{"id":38304,"word":"良贾深藏","pinyin":"liáng gǔ shēn cáng","abbr":"ljsc","explanation":"好的生意人常把贵重之物深藏而不显露。也多比喻有真本事的人往往不轻易显露。","source":{"text":"良贾深藏若虚，君子有盛教如无。","book":"《大戴礼记·曾子制言》"},"example":{"text":"璇姑谦说百无一能，大奶奶认是～。","book":"清·夏敬渠《野叟曝言》第三十二回"}},{"id":38305,"word":"良辰吉日","pinyin":"liáng chén jí rì","abbr":"lcjr","explanation":"良：好；辰：时日；吉：吉利。美好的时辰，吉利的日子。后常用以称宜于成亲的日子。","source":{"text":"战国·楚·屈原《九歌·东皇太一》： “吉日兮辰良，穆将愉兮上皇。”"},"example":{"text":"今日乃是～，方可毕姻。","book":"明·谢谠《四喜记·大宋毕姻》"},"similar":["吉日良辰","黄道吉日","良时吉日"],"usage":"作宾语；也指宜于成亲的日子"},{"id":38306,"word":"良辰媚景","pinyin":"liáng chén mèi jǐng","abbr":"lcmj","explanation":"美好的时光和景物。同“良辰美景”。","source":{"text":"你纵宝马，跳金鞍，玩玉京，迷恋着良辰媚景。","book":"元·侯克中《醉花阴》套曲"},"example":{"text":"～换今古，赏心乐事暗乘除。","book":"《全元散曲·快活三过朝天子四换头·叹四美》"},"similar":["良辰美景","良时美景"],"usage":"作主语、宾语；用于环境与心情都好时"},{"id":38307,"word":"良辰美景","pinyin":"liáng chén měi jǐng","abbr":"lcmj","explanation":"良：美好；辰：时辰。美好的时光和景物。","source":{"text":"天下良辰、美景、赏心、乐事，四者难并。","book":"南朝·宋·谢灵运《拟魏太子邺中集诗序》"},"example":{"text":"虚度了丽日风和，枉误了～。","book":"元·关汉卿《金线池》第三折"},"similar":["光风霁月","大好时光"],"opposite":["月黑风高"],"usage":"作主语、宾语；用于环境与心情都好时"},{"id":38308,"word":"良金美玉","pinyin":"liáng jīn měi yù","abbr":"ljmy","explanation":"成色好的赤金，无瑕的美玉。比喻文章十分完美。也比喻人道德品质极好。","source":{"text":"李峤、崔融、薛稷、宋之问之文，如良金美玉，无施不可。","book":"唐·徐夤《避世金马门赋》：“岂异严霜降处，难伤夫翠竹青松；烈火焚时，不损其良金璞玉。”《旧唐书·杨炯传》"},"example":{"text":"卿如～，浑厚无瑕。","book":"《宋史·黄洽传》"},"similar":["精金美玉"],"usage":"作宾语；比喻人道德品质极好"},{"id":38309,"word":"良马见鞭影而行","pinyin":"liáng mǎ jiàn biān yǐng ér xíng","abbr":"lmjbyex","explanation":"比喻有才智的人能闻风而动，自觉行事。","source":{"text":"外道已去，阿难问佛云：‘外道以何所证，而言得入？’佛云：‘如世间良马见鞭影而行。’","book":"宋·释道原《景德传灯录》卷二十七"}},{"id":38310,"word":"艰深晦涩","pinyin":"jiān shēn huì sè","abbr":"jshs","explanation":"艰深：文辞深奥难懂；晦涩：意义隐晦，不顺口。形容笔调深僻、寓意难以理解的文章。","source":{"text":"为文而晦涩若此，其湮弗没传也。","book":"宋·黄伯思《东观余论·校定楚辞序》：“故分章办事，以其所对，别附于问，庶几览者莹然，知子厚之文不苟为艰深也。”宋·陈振孙《直斋书录解题·别集上》"},"usage":"作谓语、定语；用于文章等"},{"id":38311,"word":"艰苦创业","pinyin":"jiān kǔ chuàng yè","abbr":"jkcy","explanation":"艰难困苦地创办事业。","example":{"text":"他经过艰苦创业终于使公司壮大起来。"},"similar":["艰苦奋斗","自强不息"],"opposite":["好逸恶劳"],"usage":"作谓语、定语、宾语；指干事的艰辛"},{"id":38312,"word":"艰苦卓绝","pinyin":"jiān kǔ zhuó jué","abbr":"jkzj","explanation":"卓绝：极不平凡。坚忍刻苦的精神超过寻常。","source":{"text":"始为学，即坚苦刻厉，寒不炉，暑不扇，夜不席者数年。","book":"《宋史·邵雍传》"},"example":{"text":"用儒家之道德，故艰苦卓厉者绝无，而冒没奔竞者皆是。","book":"章炳麟《诸子学略说》"},"similar":["艰难竭蹶"],"opposite":["花天酒地","好逸恶劳"],"usage":"作谓语、定语、状语；指异常的艰苦"},{"id":38313,"word":"艰苦奋斗","pinyin":"jiān kǔ fèn dòu","abbr":"jkfd","explanation":"不怕艰难困苦，坚持英勇斗争。","source":{"text":"我们要过渡到共产主义社会，还要经过长时期的艰苦奋斗。","book":"陶铸《崇高的理想》"},"example":{"text":"我们要提倡艰苦奋斗，反对铺张浪费。"},"similar":["艰苦创业","奋发图强","自力更生"],"opposite":["花天酒地"],"usage":"作谓语、宾语、定语；形容吃苦耐劳"},{"id":38314,"word":"艰苦朴素","pinyin":"jiān kǔ pǔ sù","abbr":"jkps","explanation":"指吃苦耐劳、勤俭节约的作风。","source":{"text":"要勤俭建国，反对铺张浪费，提倡艰苦朴素、同甘共苦。","book":"毛泽东《在中国共产党第八届中央委员会第二次全体会议上的讲话》"},"example":{"text":"我们首先上的一课是～的作风。","book":"周而复《白求恩大夫》"},"similar":["坚苦卓绝","艰苦创业"],"opposite":["铺张浪费","穷奢极侈"],"usage":"作谓语、定语；指吃苦耐劳"},{"id":38315,"word":"艰苦涩滞","pinyin":"jiān kǔ sè zhì","abbr":"jksz","explanation":"涩：干涩；滞：不通畅。形容语言不畅，文法不通。","source":{"text":"出言命意未免有艰苦涩滞者，求于言而不求于言之所从出，无惑乎其难也。","book":"明·方孝儒《答张廷璧》"}},{"id":38316,"word":"艰难困苦","pinyin":"jiān nán kùn kǔ","abbr":"jnkk","explanation":"形容处境艰苦，困难重重。","source":{"text":"这日子穷了，受过了艰难困苦，也就渐渐的明白过来。","book":"清·李绿园《歧路灯》第六十八回"},"example":{"text":"中国共产党，它的领导机关，它的干部，它的党员，是不怕任何～的。","book":"毛泽东《论反对日本帝国主义的策略》"},"similar":["荆棘载途"],"opposite":["万事亨通"],"usage":"作宾语、定语；形容处境艰苦，困难重重"},{"id":38317,"word":"艰难时世","pinyin":"jiān nán shí shì","abbr":"jnss","explanation":"指难以生存，危难四起的年代。","source":{"text":"艰难时世，世事休夸会。官宦误人多，道是也，终须不是。","book":"宋·冯时行《蓦山溪·村中闲作》"}},{"id":38318,"word":"艰难曲折","pinyin":"jiān nán qū zhé","abbr":"jnqz","explanation":"困难和曲折。","source":{"text":"任何新生事物的成长都是要经过艰难曲折的。在社会主义事业中，要想不经过艰难曲折。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"example":{"text":"道路是～的。"},"opposite":["一帆风顺"],"usage":"作宾语；指困难和曲折"},{"id":38319,"word":"艰难玉成","pinyin":"jiān nán yù chéng","abbr":"jnyc","explanation":"玉成：敬辞，意为成全，成功。形容经过艰辛的磨炼，终于获得成功。","source":{"text":"贫贱忧戚，庸玉女于成也。","book":"《诗经·大雅·民劳》：“王欲玉女，是用大谏。”宋·张载《西铭》"},"example":{"text":"和刘邦、朱元璋辈起于草泽的英雄们比较起来，很有过之而无不及的气概。自然，也是～了他。","book":"郭沫若《甲申三百年祭》"}},{"id":38320,"word":"艰难竭蹶","pinyin":"jiān nán jié jué","abbr":"jnjj","explanation":"竭蹶：赶路跌跌撞撞的样子，引伸为资财匮乏。形容收入少，生活艰难。","source":{"text":"故近者歌讴而乐之，远者竭蹶而趋之。","book":"《荀子·儒效》"},"example":{"text":"于～之中，存聊以卒岁之想。","book":"毛泽东《中国社会各阶级的分析》"},"similar":["艰苦卓绝","聊以卒月","饥寒交迫"],"opposite":["家给人足","丰衣足食"],"usage":"作宾语、定语；形容经济困难，生活艰难"},{"id":38321,"word":"艰难险阻","pinyin":"jiān nán xiǎn zǔ","abbr":"jnxz","explanation":"险阻：危险和障碍。前进道路上的困难、危险和障碍。","source":{"text":"险阻艰难备尝之矣。","book":"《左传·僖公二十八年》"},"example":{"text":"南极考察队的队员们，战胜了各种～，终于完成了考察任务。"},"similar":["荆棘载途","艰难曲折","险阻艰难"],"opposite":["一帆风顺","无往不利","万事亨通"],"usage":"作宾语、定语；形容经历极为困难的境地","story":["春秋时期，晋文公重耳励精图治，使晋国日益强大，准备挑战当时的霸主楚成王。公元前632年，晋文公亲率大军进攻曹、卫小国，楚成王派大将子玉前去救援曹，告诫子玉说重耳在外流亡19年，什么艰难险阻都经历过，得小心对"]},{"id":38322,"word":"艰食鲜食","pinyin":"jiān shí xiān shí","abbr":"jsxs","explanation":"艰食：指人力耕种的五谷粮食；鲜食：指鸟兽鱼鳖等鲜货。指五谷粮食和鱼鲜。","example":{"text":"我们要靠劳动而获得～。"},"usage":"作主语、宾语、定语；用于书面语"},{"id":38323,"word":"色中饿鬼","pinyin":"sè zhōng è guǐ","abbr":"szeg","explanation":"比喻极其贪色的人。","source":{"text":"一个字便是僧，两个字是和尚，三个字鬼乐官，四字色中饿鬼。","book":"明·施耐庵《水浒传》第45回"},"example":{"text":"随着手中的权力增大，他日益成为～了。"},"usage":"作宾语、定语；用于比喻句"},{"id":38324,"word":"色仁行违","pinyin":"sè rén xíng wéi","abbr":"srxw","explanation":"表面上主张仁德，实际行动却背道而驰。","source":{"text":"夫闻也者，色取仁而行违，居之不疑。","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"见～，先德后贼，如王莽辈者。","book":"唐·白居易《有木诗》序"},"similar":["表里不一"],"usage":"作谓语；指言行不一"},{"id":38325,"word":"色即是空","pinyin":"sè jí shì kōng","abbr":"sjsk","explanation":"佛家语。指世家一切色法(物质)的本性(内在真实性)都是空无所有。","source":{"text":"本庵法名，向以‘色即是空’四字为则，如前岁收的几个小徒。","book":"明·伏雌教主《醋葫芦》第12回"},"example":{"text":"一入佛门，～。"},"similar":["空即是色"],"usage":"作宾语、定语；用于佛教等"},{"id":38326,"word":"色厉内荏","pinyin":"sè lì nèi rěn","abbr":"slnr","explanation":"色：神色，样子；厉：凶猛；荏：软弱。外表强更，内心虚弱。","source":{"text":"色厉而内荏，譬诸小人，其穿窬之盗也与。","book":"《论语·阳货》"},"example":{"text":"他跑遍租界的各处，观察了帝国主义爪牙的～的窘态。","book":"叶圣陶《英文教授》"},"similar":["外强中干","虚有其表"],"opposite":["表里如一","名副其实"],"usage":"作谓语、状语；指外强中干"},{"id":38327,"word":"色厉胆薄","pinyin":"sè lì dǎn bó","abbr":"sldb","explanation":"色：神色。厉：严厉、凶猛。薄：脆弱。外表强硬而内心怯懦。","source":{"text":"袁绍色厉胆薄，好谋无断；干大事而惜身，见小利而忘命：非英雄也。","book":"明·罗贯中《三国演义》第二十一回"},"usage":"作谓语、定语；用于为人"},{"id":38328,"word":"色如死灰","pinyin":"sè rú sǐ huī","abbr":"srsh","explanation":"比喻脸色惨白难看。","source":{"text":"保母忽惊叫仆地，色如死灰，既起，不顾而走入宅。","book":"唐·皇甫枚《三水小牍·王知古》"},"similar":["色若死灰"],"usage":"作谓语、定语、状语；指脸色惨白难看"},{"id":38329,"word":"色授魂与","pinyin":"sè shòu hún yǔ","abbr":"sshy","explanation":"色：神色；授、与：给予。形容彼此用眉目传情，心意投合。","source":{"text":"长眉连娟，微睇绵藐，色授魂与，心愉一侧。","book":"汉·司马相如《上林赋》"},"example":{"text":"时一谈宴，则～，尤胜于颠倒衣裳矣。","book":"清·蒲松龄《聊斋志异·娇娜》"},"similar":["神魂颠倒"],"usage":"作谓语、定语；形容见到美色而神魂颠倒"},{"id":38330,"word":"色胆包天","pinyin":"sè dǎn bāo tiān","abbr":"sdbt","explanation":"形容贪恋淫欲胆量很大。","source":{"text":"常言道：色胆包天，这回钮逢之竟要把天来包一包。","book":"清·李宝嘉《文明小史》第三十九回"},"example":{"text":"你真是～，敢吃老娘豆腐？"},"similar":["色胆如天"],"usage":"作谓语、定语；用于口语"},{"id":38331,"word":"色胆如天","pinyin":"sè dǎn rú tiān","abbr":"sdrt","explanation":"形容贪恋淫欲胆量很大。","source":{"text":"那和尚一头接茶，两只眼涎瞪瞪的只顾看那妇人身上，这妇人也嘻嘻的笑着看这和尚。人道色胆如天，却不防石秀在布廉里张见。","book":"明·施耐庵《水浒传》第四十五回"},"example":{"text":"看那瑞仙郡主，犹如酒醉杨妃，露出一身白肉，按不住心头欲火，一时～。","book":"清·钱彩《说岳全传》第七十九回"},"similar":["色胆包天"],"opposite":["坐怀不乱"],"usage":"作谓语、定语；指荒淫无度"},{"id":38332,"word":"色胆迷天","pinyin":"sè dǎn mí tiān","abbr":"sdmt","explanation":"形容贪恋淫欲胆量很大。","source":{"text":"吴氏经过儿子几番道儿，也该晓得谨慎些，只是色胆迷天，又欺他年小，全不照顾。","book":"明·凌濛初《初刻拍案惊奇》第17卷"},"similar":["色胆包天"],"opposite":["坐怀不乱"],"usage":"作谓语、宾语；指胆大包天"},{"id":38333,"word":"色色俱全","pinyin":"sè sè jù quán","abbr":"ssjq","explanation":"各种各样的东西都很齐全。","source":{"text":"过了半个月，已是色色俱全，便检了初三迎娶。请了一位候补同知盛涛，并一位试用知县张春午做大宾，择了午时发了轿，大吹大擂，竟到黎大人那边去。","book":"清·吴趼人《糊涂世界》第二回"},"example":{"text":"鲁迅《伪自由书·战略关系》：“现在一切准备停当，行都陪都都～。”"},"similar":["样样俱全"],"usage":"作谓语、定语；指很齐全"},{"id":38334,"word":"色艺两绝","pinyin":"sè yì liǎng jué","abbr":"sylj","explanation":"色艺：容貌和技艺。姿色和技艺都绝无仅有，非常美妙。","source":{"text":"王晋卿都尉既丧蜀国，贬均州，姬侍尽逐。有一歌者，号‘啭春莺’，色艺两绝。","book":"宋·胡仔《啭春莺》"},"similar":["色艺双绝"],"usage":"作谓语、定语；用于艺妓"},{"id":38335,"word":"色艺双绝","pinyin":"sè yì shuāng jué","abbr":"sysj","explanation":"女子姿色和技艺都绝无仅有，非常美妙。","source":{"text":"为帝言陇西氏色艺双绝，帝艳心焉。","book":"宋·无名氏《李师师外传》"},"example":{"text":"清·褚人获《隋唐演义》第26回：“小女线娘，年方十三，～，好读韬略，闺中时舞一剑，竟若游龙。”"},"similar":["色艺两绝"],"usage":"作谓语、定语；用于艺妓"},{"id":38336,"word":"色艺无双","pinyin":"sè yì wú shuāng","abbr":"syws","explanation":"女子姿色和技艺没有第二个人可比。","source":{"text":"小旦马大保，为美臣子，色艺无双。","book":"清·李斗《扬州画鲂录》卷五"},"similar":["色艺绝伦"],"usage":"作谓语、定语；多用于女性等"},{"id":38337,"word":"色艺绝伦","pinyin":"sè yì jué lún","abbr":"syjl","explanation":"伦：同类。女子姿色和技艺超群拔俗。","source":{"text":"师师无所归，有倡籍李姥者，收养之口比长，色艺绝伦，遂名冠诸坊曲。","book":"宋·无名氏《李师师外传》"},"similar":["色艺两绝","色艺无双"],"usage":"作谓语、定语；多用于女性等"},{"id":38338,"word":"色若死灰","pinyin":"sè ruò sǐ huī","abbr":"srsh","explanation":"面目惨白。原比喻面部没有什么表情。现形容十分害怕的神情。","source":{"text":"目茫然无见，色若死灰。","book":"《庄子·盗跖》"},"similar":["色如死灰"],"usage":"作谓语、定语、状语；指脸色惨白难看"},{"id":38339,"word":"色衰爱寝","pinyin":"sè shuāi ài qǐn","abbr":"ssaq","explanation":"色：指姿色；寝：平息，停止。女子因姿色衰退而受到的宠爱减退。","source":{"text":"色衰爱寝从来话，忆西陵松阴露华。","book":"明·胡文焕《群音类选·清腔类·山坡羊》"},"similar":["色衰爱弛"],"usage":"作谓语、定语；用于女性"},{"id":38340,"word":"色衰爱弛","pinyin":"sè shuāi ài chí","abbr":"ssac","explanation":"色：姿色、容颜；弛：松懈，衰退。指靠美貌得宠的人，一旦姿色衰老，就会遭到遗弃。指男子喜新厌旧。","source":{"text":"弥子色衰爱弛，得罪于君。","book":"战国·韩·韩非《韩非子·说难》"},"example":{"text":"及即位数年，～，武惠妃有宠，阴怀倾夺之志。","book":"宋·司马光《资治通鉴·唐玄宗开元十年》"},"similar":["色衰爱寝"],"usage":"作谓语、定语；用于女性"},{"id":38341,"word":"色飞眉舞","pinyin":"sè fēi méi wǔ","abbr":"sfmw","explanation":"色：脸色，表情。形容人非常得意兴奋的样子。","source":{"text":"蔡曰：‘步月山坞，忽闻清音，令人色飞眉舞。’","book":"清·杨复吉《梦阑琐笔·蔡涛》"},"example":{"text":"中考成绩公布后，有些人垂头丧气，有些人～。"},"similar":["眉飞色舞"],"opposite":["愁眉苦脸","垂头丧气"],"usage":"作谓语、状语、定语；形容人得意的神态"},{"id":38342,"word":"艳丽夺目","pinyin":"yàn lì duó mù","abbr":"yldm","explanation":"夺目：耀眼。形容花朵或女子姿色鲜艳美丽耀眼。","source":{"text":"红白色的花朵掩映在一簇簇的绿叶丛中，愈显得艳丽夺目。","book":"巴金《春》"},"example":{"text":"夜晚海口的灯光～。"},"similar":["绚丽多彩"],"usage":"作谓语、定语、状语；指花朵或女性"},{"id":38343,"word":"艳如桃李","pinyin":"yàn rú táo lǐ","abbr":"yrtl","explanation":"容颜像成熟的桃李那样娇艳。","source":{"text":"女子得非嫌吾贫乎？为人不言亦不笑，艳如桃李，而冷如霜雪，奇人也。","book":"清·蒲松龄《聊斋志异·侠女》"},"example":{"text":"钱钟书《围城》：“苏小姐理想的自己是：‘～，冷若冰霜。’”"},"usage":"作谓语、定语；用于女性"},{"id":38344,"word":"艳如桃李，冷如霜雪","pinyin":"yàn rú táo lǐ，lěng rú shuāng xuě","abbr":"yrtllrsx","explanation":"形容女子容貌艳丽而态度严肃","source":{"text":"女子得非嫌吾贫乎？为人不言亦不笑，艳如桃李，而冷如霜雪，奇人也！","book":"清·蒲松龄《聊斋志异·侠女》"},"similar":["艳如桃李，冷若冰霜"],"usage":"作谓语、定语；形容女子容貌艳丽"},{"id":38345,"word":"艳如桃李，冷若冰霜","pinyin":"yàn rú táo lǐ，lěng ruò bīng shuāng","abbr":"yrtllrbs","explanation":"形容女子容貌艳丽而态度严肃。","source":{"text":"敢道艳如桃李，冷若冰霜，芝兰其馨，金石其操，故是青楼贱质，红粉庸姿。","book":"清·伤时子《苍鹰击·割爱》"},"similar":["艳如桃李，冷如冰霜"],"usage":"作谓语、定语；形容女子容貌艳丽"},{"id":38346,"word":"艳如桃李，凛若冰霜","pinyin":"yàn rú táo lǐ，lǐn ruò bīng shuāng","abbr":"yrtllrbs","explanation":"凛：严冷可畏。形容女子容貌艳丽而态度严肃","source":{"text":"又是两个绝代女子，一个艳如桃李，凛若冰霜；一个裙布钗荆，端庄俏丽。","book":"清·文康《儿女英雄传》缘起"},"similar":["艳如桃李，冷若冰霜"],"usage":"作谓语、定语；形容女子容貌艳丽"},{"id":38347,"word":"艳曲淫词","pinyin":"yàn yǔ yín cí","abbr":"yqyc","explanation":"香艳的乐曲和淫秽的文辞。","source":{"text":"至乐，则尽放郑声，以复雅乐，琵琶弦索，艳曲淫词，付之祖龙一炬。","book":"清·夏敬渠《野叟曝言》第十二回"},"usage":"作主语、宾语；用于书面语"},{"id":38348,"word":"艳紫妖红","pinyin":"yàn zǐ yāo hóng","abbr":"yzyh","explanation":"犹言姹紫嫣红。形容各种花朵娇艳美丽。","source":{"text":"肯羡狂蜂殢蝶，艳紫妖红。","book":"《渚山堂词话》卷二引元·白朴《玉耳坠金环》曲"},"example":{"text":"～尘俗病，论风流让与琼琼。","book":"元·张可久《普天乐·赠白玉梅》曲"},"usage":"作宾语、定语；用于书面语"},{"id":38349,"word":"艳绝一时","pinyin":"yàn jué yī shí","abbr":"yjys","explanation":"姿色娇美，冠绝一代。","source":{"text":"其幸姬曰柳氏，艳绝一时，喜谈谑，善讴咏。","book":"唐·许尧佐《章台柳传》"},"similar":["艳色绝世"],"usage":"作谓语、定语；用于书面语"},{"id":38350,"word":"艳美无敌","pinyin":"yàn měi wú dí","abbr":"ymwd","explanation":"敌：匹敌。明艳美丽，没有人与之媲美的。","source":{"text":"庾屣履听之，数青衣年十八九，艳美无敌。","book":"唐·张泌《尸媚传·张庾》"},"usage":"作谓语、定语；指十分明艳"},{"id":38351,"word":"艳美绝俗","pinyin":"yàn měi jué sú","abbr":"ymjs","explanation":"形容娇艳美丽超过寻常人。","source":{"text":"一日，生于隘巷中，见一女郎，艳美绝俗，从以小鬟，仅六七岁。","book":"清·蒲松龄《聊斋志异·江城》"},"usage":"作谓语、定语；多用于女性"},{"id":38352,"word":"艳色绝世","pinyin":"yàn sè jué shì","abbr":"ysjs","explanation":"姿色美丽，冠绝当代。","source":{"text":"良久，妓女十余，排大门而入，轻绡翠翘，艳色绝世。","book":"唐·段成式《酉阳杂俎·雀汾》"},"usage":"作谓语、定语；用于女性"},{"id":38353,"word":"艳色耀目","pinyin":"yàn sè yào mù","abbr":"ysym","explanation":"颜色娇艳，光彩夺目。","source":{"text":"莫非玉羁、金勒、宝镫，花韀，艳色耀目，香风袭人。","book":"宋·孟元老《东京梦华录》卷七"},"usage":"作谓语、定语；用于书面语"},{"id":38354,"word":"艴然不悦","pinyin":"fú rán bù yuè","abbr":"frby","explanation":"非常生气。艴fú然，也作怫然，生气时表现一付脸色难看的样子。","source":{"text":"尔何曾比予于管仲！……","book":"典自《孟子·公孙丑上》[孟子]曰：“然则吾子与管仲孰贤？”曾西艴然不悦，曰"},"similar":["怫然不悦"],"opposite":["兴高采烈"],"usage":"作谓语、定语、状语；用于生气时"},{"id":38355,"word":"艴然大怒","pinyin":"fú rán dà nù","abbr":"frdn","explanation":"艴然：恼怒地。形容人十分恼怒","source":{"text":"荆公看罢，艴然大怒。","book":"明·冯梦龙《警世通言》第四卷"},"similar":["勃然大怒"],"usage":"作谓语、定语、状语；指生气"},{"id":38356,"word":"艺不压身","pinyin":"yì bù yā shēn","abbr":"ybys","explanation":"艺：技艺。技艺不会压垮身体。比喻人学会的技艺越多越好。","source":{"text":"这孙海仙说了这些江湖本领，不耕而食，不织而衣，遨游海内，艺不压身。","book":"清·李绿园《歧路灯》第四十四回"},"similar":["艺多不压身"],"usage":"作宾语、定语；比喻人学会的技艺越多越好"},{"id":38357,"word":"艺多不压身","pinyin":"yì duō bù yā shēn","abbr":"ydbys","explanation":"艺：技艺。技艺多不会压垮身体。比喻人学会的技艺越多越好。","source":{"text":"这孙海仙说了这些江湖本领，不耕而食，不织而衣，遨游海内，艺不压身。","book":"清·李绿园《歧路灯》第四十四回"},"similar":["艺不压身"],"usage":"作宾语、定语；用于书面语"},{"id":38358,"word":"艺高人胆大","pinyin":"yì gāo rén dǎn dà","abbr":"ygrdd","explanation":"技艺高超的人胆量也大。","source":{"text":"这正是艺高人胆大。蒋爷竟不慌不忙的答道：‘实是半路出家，何必施主追问呢？’","book":"清·石玉昆《三侠五义》第66回"},"similar":["艺高胆大"],"usage":"作宾语、定语；指技艺高超"},{"id":38359,"word":"艺高胆壮","pinyin":"yì gāo dǎn zhuàng","abbr":"ygdz","explanation":"本领高超的人，做事胆量就大。","source":{"text":"练胆是第一义，兵若无胆，如何站住？然必技艺精熟，继光云，艺高则胆壮也。","book":"明·张岱《石匮书后集·蒋德璟传》"}},{"id":38360,"word":"艺高胆大","pinyin":"yì gāo dǎn dà","abbr":"ygdd","explanation":"技艺高超的人胆量也大。","source":{"text":"这正是艺高人胆大。蒋爷竟不慌不忙的答道：‘实是半路出家，何必施主追问呢？’","book":"清·石玉昆《三侠五义》第66回"},"example":{"text":"见过龙门石窟的宏伟雕像者，无不赞叹只有～的人才能创造出这样的杰作。"},"similar":["艺高人胆大"],"usage":"作谓语、定语、宾语；指技艺高超"},{"id":38361,"word":"艾发衰容","pinyin":"ài fà shuāi róng","abbr":"afsr","explanation":"艾：灰白色。灰白色的头发，衰老的面容。","source":{"text":"艾发衰容惜寸辉。","book":"唐·元稹《郡斋感怀见寄》"},"similar":["白发苍颜"],"usage":"作主语、宾语；用于老年人"},{"id":38362,"word":"节上生枝","pinyin":"jié shàng shēng zhī","abbr":"jssz","explanation":"本不应该生枝的地方生枝。比喻在原有问题之外又岔出了新问题。多指故意设置障碍，使问题不能顺利解决。","source":{"text":"随语生解，节上生枝，则更读万卷书，亦无用处也。","book":"宋·朱熹《答吕方子约（九月十三日）》"},"similar":["节外生枝","节上生枝"],"usage":"作谓语、宾语、定语；指意料之外的事"},{"id":38363,"word":"节中长节","pinyin":"jié zhōng zhǎng jié","abbr":"jzcj","explanation":"节：竹节。枝节中又长出枝杈。比喻在已有的情节中又生出新的情节。","source":{"text":"十出以后，皆是枝外生枝，节中长节，如遇行路之人，非止不问姓字，并形体面目皆可不必认矣。","book":"清·李渔《闲情偶寄·词曲·格局》"},"similar":["节上生枝","节外生枝"],"usage":"作谓语、宾语、定语；指意料之外的事"},{"id":38364,"word":"节俭力行","pinyin":"jié jiǎn lì xíng","abbr":"jjlx","explanation":"指生活俭朴，又肯努力躬行。","source":{"text":"以节俭力行重于齐，既相齐，食不重肉，妾不衣帛。","book":"《史记·管晏列传》"},"similar":["节俭躬行"],"usage":"作谓语、定语；指节约","story":["春秋时期，齐国相国晏婴身居高位，生活非常俭朴，从不讲排场，办事亲力亲为。在家吃饭只吃一份肉菜，家人也不穿绫罗绸缎，只穿布衣。他从不炫耀权势，居功自傲，说话非常谦虚，勤勤恳恳地辅佐国君"]},{"id":38365,"word":"节俭躬行","pinyin":"jié jiǎn gōng xíng","abbr":"jjgx","explanation":"指生活俭朴，从自身做起。","source":{"text":"以节俭力行重于齐，既相齐，食不重肉，妾不衣帛。","book":"《史记·管晏列传》"},"example":{"text":"贤妃助内咏《鸡鸣》，～迈往古。","book":"明·顾炎武《骊山行》"},"similar":["节俭力行"],"usage":"作谓语、定语；指节约"},{"id":38366,"word":"节制之师","pinyin":"jié zhì zhī shī","abbr":"jzzs","explanation":"节制：有节度，讲法制；师：军队。指军纪严整的军队。","source":{"text":"秦之锐士，不可以当桓文之节制；桓文之节制，不可以敌汤武之仁义。","book":"《荀子·议兵》"},"example":{"text":"执事今以～，居形胜之地，一举足为天下轻重。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十五回"}},{"id":38367,"word":"节变岁移","pinyin":"jié biàn suì yí","abbr":"jbsy","explanation":"节：节令；岁：年。节令变易，年岁转换。","source":{"text":"今节变岁移，腊冬春首，照晴光于效甸，动暄气于梅柳，水解冻而绕轩，风扇和而入牖。","book":"唐·牛肃《纪闻·牛应贞》"},"usage":"作宾语、定语；用于岁月变迁"},{"id":38368,"word":"节同时异","pinyin":"jié tóng shí yì","abbr":"jtsy","explanation":"季节相同，但时间已不是那个时间了。多用于表达时过境迁，因而怀念故人。","source":{"text":"节同时异，物是人非，我劳如何？","book":"三国·魏·曹丕《与吴质书》"}},{"id":38369,"word":"节哀顺变","pinyin":"jié āi shùn biàn","abbr":"jasb","explanation":"节：节制；变：事变。抑制哀伤，顺应变故。用来慰唁死者家属的话。","source":{"text":"丧礼，哀戚之至也；节哀，顺变也。君子念始之者也。","book":"《礼记·檀弓下》"},"example":{"text":"吾兄～，保全金玉之躯。","book":"清·无名氏《西湖二集·洒雪堂巧结良缘》"},"usage":"作谓语、宾语；用来慰唁死者家属的话"},{"id":38370,"word":"节外生枝","pinyin":"jié wài shēng zhī","abbr":"jwsz","explanation":"本不应该生枝的地方生枝。比喻在原有问题之外又岔出了新问题。多指故意设置障碍，使问题不能顺利解决。","source":{"text":"随语生解，节上生枝，则更读万卷书，亦无用处也。","book":"宋·朱熹《答吕方子约（九月十三日）》"},"example":{"text":"兀的是闲言语甚意思，他怎肯道～。","book":"元·杨显之《潇湘雨》第二折"},"similar":["横生枝节","节上生枝"],"opposite":["一帆风顺"],"usage":"作谓语、宾语、定语；指意料之外的事","story":["宋代理学家朱熹，他一生大部分时间从事讲学和著书，他认为读书要从文章的思想内容、逻辑推理上去读，不要管别的问题，吕祖谦的弟弟吕子约不同意这种观点，朱熹认为读书不要左遮右拦，没必要去多惹一些麻烦，以免节外生枝"]},{"id":38371,"word":"节威反文","pinyin":"jié wēi fǎn wén","abbr":"jwfw","explanation":"节：节制；威：威力，威风；反：同“返”，归还。节抑威强，复用文理。","source":{"text":"节威反文。案用夫端诚信全之君子治天下焉。","book":"战国·赵·荀况《荀子·强国》"},"usage":"作宾语、分句；用于书面语"},{"id":38372,"word":"节用厚生","pinyin":"jié yòng hòu shēng","abbr":"jyhs","explanation":"节约用度，厚待生民。","source":{"text":"谦谦曼伯，不逾规矩，节用厚生，保家之主。","book":"唐·杨炯《梓州官僚赞·参军中山张曼伯赞》"},"similar":["节用爱人"],"usage":"作宾语、定语；用于书面语"},{"id":38373,"word":"节用爱人","pinyin":"jié yòng ài rén","abbr":"jyar","explanation":"节约用度，爱护百姓。","source":{"text":"陛下若节用爱人，当与夏后齐驾，何必劳人动众，而踵梁武之遗风乎？","book":"唐·高郢《谏造章敬寺书》"},"similar":["节用厚生"],"usage":"作宾语、定语；用于书面语"},{"id":38374,"word":"节用爱民","pinyin":"jié yòng ài mín","abbr":"jyam","explanation":"节省开支，爱护百姓。","source":{"text":"道千乘之国，敬事而信，节用而爱人，使民以时。","book":"《论语·学而》"},"example":{"text":"汉之文帝，史称其～，方内安宁，家给人足。","book":"清·汪琬《太子太保礼部尚书王公行状》"},"similar":["节用裕民"],"usage":"作谓语、定语；指节省开支，爱护百姓"},{"id":38375,"word":"节用裕民","pinyin":"jié yòng yù mín","abbr":"jyym","explanation":"裕：富足。节约用度，使人民过富裕的生活。","source":{"text":"足国之道，节用裕民，而善藏其余。","book":"《荀子·富国》"},"similar":["节用爱民"],"usage":"作谓语；指节约用度，使人民富裕"},{"id":38376,"word":"节节胜利","pinyin":"jié jié shèng lì","abbr":"jjsl","explanation":"节节：逐段。指胜利一个接着一个。","example":{"text":"卢金山因北路袁祖铭军～，毫不在意，每日只在司令部中，征花侑酒，打牌消遣。","book":"蔡东藩、许廑父《民国通俗演义》第一百四十六回"}},{"id":38377,"word":"节节败退","pinyin":"jié jié bài tuì","abbr":"jjbt","explanation":"形容接连失败退缩。","source":{"text":"南北两战场节节败退，长江要塞节节失守。","book":"郭沫若《洪波曲》第九章"},"example":{"text":"敌人～，我军节节胜利。"},"opposite":["节节胜利"],"usage":"作谓语；指连败"},{"id":38378,"word":"节衣素食","pinyin":"jié yī sù shí","abbr":"jyss","explanation":"节：节减；素：蔬菜类食物。省吃俭用，生活节俭。","source":{"text":"节衣素食已经成了他的生活习惯。","book":"《新华日报》1994.1.8"},"similar":["节衣缩食"],"usage":"作主语、宾语、定语；形容节俭"},{"id":38379,"word":"节衣缩食","pinyin":"jié yī suō shí","abbr":"jyss","explanation":"节、缩：节省。省吃省穿。形容节约。","source":{"text":"能薄饮食，忍嗜欲，节衣服。","book":"《史记·贷殖列传》"},"example":{"text":"本来，有关本业的东西，是无论怎样～也应该购买的。","book":"《鲁迅书信集·致赵家璧》"},"similar":["布衣疏食","艰苦朴素","缩衣节食"],"opposite":["穷奢极欲","铺张浪费","花天酒地"],"usage":"作主语、谓语、宾语、定语、状语；形容节俭"},{"id":38380,"word":"节食省衣","pinyin":"jié shí shèng yī","abbr":"jssy","explanation":"节、省：节省。省吃省穿。形容节约。","source":{"text":"能薄饮食，忍嗜欲，节衣服。","book":"《史记·贷殖列传》"},"example":{"text":"米丘林多年过着～的生活。","book":"周建人《米丘林的故事》"}},{"id":38381,"word":"节食缩衣","pinyin":"jié shí suō yī","abbr":"jssy","explanation":"节、缩：节省。省吃省穿。形容节约。","source":{"text":"能薄饮食，忍嗜欲，节衣服。","book":"《史记·贷殖列传》"},"example":{"text":"～，悉力营聚，至绍兴壬申岁而所谓数千卷者，始复其旧。","book":"宋·朱熹《刘氏墨庄记》"},"similar":["节衣缩食"],"usage":"作谓语、宾语、定语、状语；形容节俭"},{"id":38382,"word":"节骨眼","pinyin":"jiē gǔ yǎn","abbr":"jgy","explanation":"比喻关键的环节或时机。","source":{"text":"别起什么邪念，起也没用，都到这节骨眼了，满意不满意符不符合你那什么梦想也由不得你了。","book":"王朔《永失我爱》"},"usage":"作宾语；用于比喻句"},{"id":38383,"word":"节齿咬牙","pinyin":"qiè chǐ yǎo yá","abbr":"jcyy","explanation":"切齿：咬紧牙齿，表示痛恨。形容极端仇视或痛恨。也形容把某种情绪或感觉竭力抑制住。","source":{"text":"为甚事咬牙切齿，諕的犯罪人面色如金纸。","book":"元·孙仲章《勘头巾》第二折"},"example":{"text":"各人将短器械执在手中，～，怒冲牛斗，随后而行。","book":"明·许仲琳《封神演义》第三十四回"}},{"id":38384,"word":"芒刺在背","pinyin":"máng cì zài bèi","abbr":"mczb","explanation":"芒刺：细刺。象有芒和刺扎在背上一样。形容内心惶恐，坐立不安。","source":{"text":"现在被献忠这样一看，感到跼蹐不安，犹如～。 ★姚雪垠《李自成》第二卷第二十七章"},"example":{"text":"姚雪垠《李自成》第二卷第27章：“现在被献忠这样一看，感到跼蹐不安，犹如～。”"},"similar":["如坐针毡","六神无主","坐立不安"],"opposite":["泰然自若","若无其事","悠悠自得"],"usage":"作定语、宾语；用于感知动词后","story":["西汉时期，汉武帝病死，霍光辅佐汉昭帝刘弗陵执政，汉昭帝死后立刘贺为皇帝，由于刘贺不争气，就另立汉宣帝刘询。宣帝去太庙祭祖，见身材高大的霍光在旁陪伴，非常惶恐不安，就像有芒刺在背上那样难受，直到霍光死后才感到轻松"]},{"id":38385,"word":"芒刺在身","pinyin":"máng cì zài shēn","abbr":"mczs","explanation":"芒刺：谷类壳上的细刺。好像有芒刺扎在身上。形容心中内心惶恐，坐立不安。","source":{"text":"他觉得那个姓周的在背后盯住他，使他有如芒刺在身，脊梁骨痒痒，可又不敢回头。","book":"柳青《创业史》第13章"},"similar":["芒刺在背","芒刺在躬"],"usage":"作定语、宾语；用于感知动词后"},{"id":38386,"word":"芒刺在躬","pinyin":"máng cì zài gōng","abbr":"mczg","explanation":"芒刺：谷类壳上的细刺。好像有芒刺扎在身上。形容心中内心惶恐，坐立不安。","source":{"text":"常怀再造之恩，未答自天之泽，兢忧度日，芒刺在躬。","book":"前蜀·杜光庭《杨鼎校书本命本樵词》"},"similar":["芒刺在身"],"usage":"作定语、宾语；用于感知动词后"},{"id":38387,"word":"芒寒色正","pinyin":"máng hán sè zhèng","abbr":"mhsz","explanation":"指星光清冷色纯正。也借以称颂人的品行高洁正直。","source":{"text":"粲焉如繁星丽天，而芒寒色正。","book":"唐·刘禹锡《尚书礼部员外郎柳君集纪》"},"example":{"text":"此数公者，声称德望，炳然较著，真与～者比。","book":"宋·张孝祥《代季父上陈枢密书》"},"usage":"作谓语、定语；指人的品行"},{"id":38388,"word":"芒屩布衣","pinyin":"máng juē bù yī","abbr":"mjby","explanation":"屩：麻草鞋。穿着草鞋和粗布衣服。形容衣着朴素。","source":{"text":"在瓛门下积年，去来归家，恒芒屩布衣，徒行于路。","book":"《梁书·儒林传·范缜》"},"usage":"作宾语、定语；用于生活"},{"id":38389,"word":"芒然自失","pinyin":"máng rán zì shī","abbr":"mrzs","explanation":"芒然：模糊不清。若有所失而又不知所以的样子。","source":{"text":"此天子之剑也。文王芒然自失。","book":"战国·宋·庄周《庄子·说剑》"},"example":{"text":"全欧人士，为之栗然震惊者有之，～者有之。","book":"鲁迅《坟·文化偏至论》"},"similar":["茫然自失"],"usage":"作谓语、定语；指不知所以的样子"},{"id":38390,"word":"芒芒苦海","pinyin":"máng máng kǔ hǎi","abbr":"mmkh","explanation":"佛教语，辽阔深远的样子。比喻苦难无穷无尽。","source":{"text":"嗟见南山尘，积年为丘山。芒芒苦海中，生死成波澜。","book":"宋·张君房《云笈七签》第66卷"},"example":{"text":"～，回头是岸。"},"similar":["茫茫苦海"],"usage":"作宾语；指苦难无穷无尽"},{"id":38391,"word":"芒鞋竹杖","pinyin":"máng xié zhú zhàng","abbr":"mxzz","explanation":"芒鞋：草鞋；竹杖：用竹子做的手杖。这些都是古人外出漫游地常备用具。也指到处漫游。","source":{"text":"芒鞋竹杖寒冻时，玉霄忽去非有期。","book":"唐·贯休《寒月送玄道士入天台》"},"example":{"text":"子怕他腐烂了～，尘昧了蒲团纸帐。","book":"元·马致远《陈抟高卧》第四折"},"similar":["竹杖芒鞵"],"usage":"作宾语、定语；用于书面语"},{"id":38392,"word":"芒鞋竹笠","pinyin":"máng xié zhú lì","abbr":"mxzl","explanation":"芒鞋：草鞋。竹笠：用竹子编成的斗笠。穿草鞋，戴斗笠是古人外出漫游的工具。指到处漫游。","source":{"text":"倘然寻不着他，那管芒鞋竹笠，海角天涯，我一定要寻着这个女孩儿家才罢。","book":"清·文康《儿女英雄传》第十三回"}},{"id":38393,"word":"芙蓉出水","pinyin":"fú róng chū shuǐ","abbr":"frcs","explanation":"芙蓉：荷花。刚开放的荷花。比喻诗文清新不俗。也形容天然艳丽的女子。","source":{"text":"谢诗如芙蓉出水，颜如错彩镂金。","book":"南朝·梁·钟嵘《诗品》卷中"},"example":{"text":"学画宫眉细细长，～斗新妆。","book":"宋·欧阳修《鹧鸪天》词"},"similar":["出水芙蓉"],"usage":"作宾语；用于女性"},{"id":38394,"word":"芙蓉并蒂","pinyin":"fú róng bìng dì","abbr":"frbd","explanation":"蒂：花或瓜果跟枝茎相连的部分；芙蓉：荷花别名。两朵荷花并生一蒂。比喻夫妻相亲相爱。也比喻两者可以相媲美。","source":{"text":"芙蓉并蒂一心连，花侵隔子眼应穿。","book":"唐·皇甫松《竹枝词》"},"example":{"text":"他们如～，相亲相爱。"},"similar":["并蒂芙蓉"],"usage":"作宾语；指夫妻相亲相爱"},{"id":38395,"word":"芜词俚曲","pinyin":"wú cí lǐ qǔ","abbr":"wclq","explanation":"芜词：比喻文辞杂乱；俚：俚俗。形容杂乱粗俗的词曲。","source":{"text":"芜词俚曲，见笑大方。","book":"清·孔尚任《桃花扇·侦戏》"}},{"id":38396,"word":"芜音累句","pinyin":"wú yīn lèi jù","abbr":"wylj","explanation":"芜：比喻文辞杂乱。形容芜杂累赘的辞句。","source":{"text":"自兹以降，史道陵夷，作者芜音累句，云蒸泉涌。","book":"唐·刘知几《史通·叙事》"}},{"id":38397,"word":"芜音累气","pinyin":"wú yīn lèi qì","abbr":"wylq","explanation":"芜：比喻文辞杂乱。形容芜杂累赘的辞句。","source":{"text":"虽清辞丽曲，时发乎篇，而芜音累气，固亦多矣。","book":"《宋书·谢灵运传论》"}},{"id":38398,"word":"芝兰之交","pinyin":"zhī lán zhī jiāo","abbr":"zlzj","explanation":"芝草和兰草之间的交往。比喻品德高尚的人之间的友谊。"},{"id":38399,"word":"芝兰之室","pinyin":"zhī lán zhī shì","abbr":"zlzs","explanation":"比喻良好的环境。","source":{"text":"与善人居，如入芝兰之室，久而不闻其香，即与之化矣。","book":"《孔子家语·六本》"},"example":{"text":"君子有邻，还得～。","book":"唐·陈子昂《薛大夫山亭宴序》"},"opposite":["鲍鱼之肆"],"usage":"作主语、宾语；指良好的环境"},{"id":38400,"word":"芝兰玉树","pinyin":"zhī lán yù shù","abbr":"zlys","explanation":"芝兰：香草；玉树：用玉做的树。比喻有出息的子弟。","source":{"text":"譬如芝兰玉树，欲使其生于庭阶耳。","book":"《晋书·谢安传》"},"example":{"text":"人间富贵荣华尽，膝下～齐。","book":"清·陈端生《再生缘》卷一"},"similar":["玉树芝兰"],"usage":"作宾语、定语；用于人","story":["晋朝时期，太傅谢安问众子侄：“你们又何尝需要过问政事，为什么总想培养他们成为优秀子弟？”大家都不说话，只有车骑将军谢玄回答说：“这就好比芝兰玉树，总想使它们生长在自家的庭院中啊！”"]},{"id":38401,"word":"芝兰生于深林","pinyin":"zhī lán shēng yú shēn lín","abbr":"zlsysl","explanation":"芝兰：芝草、兰草，都是香草。芝兰生长于树木深处。比喻德高的人不因没有人看见而变节。","source":{"text":"且芝兰生于深林，不以无人而不芳，君子修道立德，不谓穷困而改节。","book":"《孔子家语·在厄》"},"usage":"作宾语、定语；用于书面语"},{"id":38402,"word":"芝残蕙焚","pinyin":"zhī cán huì fén","abbr":"zchf","explanation":"比喻贤德者之亡逝或遭贬谪。","source":{"text":"敬通虽芝残蕙焚，终填沟壑，而为名贤所慕。","book":"《南史·刘峻传》"},"usage":"作谓语、定语；用于比喻句"},{"id":38403,"word":"芝焚蕙叹","pinyin":"zhī fén huì tàn","abbr":"zfht","explanation":"芝、蕙：同为香草名；焚：烧。芝草被焚，蕙草伤叹。比喻因同类遭到不幸而悲伤。","source":{"text":"信松茂而柏悦，嗟芝焚而蕙叹。","book":"晋·陆机《叹逝赋》"},"example":{"text":"今日油烹蒯彻，正所谓兔死狐悲，～，请丞相自思之。","book":"元·无名氏《赚蒯通》第四折"},"similar":["兔死狐悲"],"usage":"作宾语、定语；比喻因同类遭到不幸而悲伤叹"},{"id":38404,"word":"芝艾俱尽","pinyin":"zhī ài jù jìn","abbr":"zajj","explanation":"芝艾：比喻美和恶。芝艾同被烧毁。比喻好的坏的同归于尽。","source":{"text":"若苗秽害田，随风烈火，芝艾俱焚，安能自别乎？","book":"《三国志·魏志·公孙度传》裴松之注引《魏略》"},"example":{"text":"孟诸焚燎，～；宣房河决，玉石同沉。（《梁书·元帝纪》）"},"similar":["芝艾俱焚","芝艾并焚","芝艾同焚"],"usage":"作宾语、定语；指同归于尽"},{"id":38405,"word":"芝艾俱焚","pinyin":"zhī ài jù fén","abbr":"zajf","explanation":"芝艾：比喻美和恶。芝艾同被烧毁。比喻好的坏的同归于尽。","source":{"text":"若苗秽害田，随风烈火，芝艾俱焚，安能自别乎？","book":"《三国志·魏志·公孙度传》裴松之注引《魏略》"},"similar":["玉石俱焚","芝艾共焚","芝艾同焚"],"usage":"作宾语、定语；指同归于尽"},{"id":38406,"word":"芝艾共焚","pinyin":"zhī ài gòng fén","abbr":"zagf","explanation":"犹玉石俱焚。比喻贵贱、贤愚、良莠同归于尽。同“芝艾并焚”。","source":{"text":"复恐迎风纵火，芝艾共焚。","book":"《北齐书·文苑传·樊逊》"},"similar":["芝艾并焚","芝艾俱焚","芝艾同焚"],"usage":"作宾语、定语；用于比喻句"},{"id":38407,"word":"芝艾同焚","pinyin":"zhī ài tóng fén","abbr":"zatf","explanation":"犹玉石俱焚。比喻好的坏的同归于尽。同“芝艾俱焚”。","source":{"text":"以此攻城，何城不克；以此赴敌，何陈能坚？……芝艾同焚，悔将何及！","book":"《宋书·沈攸之传》"},"similar":["芝艾俱焚","芝艾共焚","芝艾并焚"],"usage":"作宾语、定语；用于比喻句"},{"id":38408,"word":"芝艾并焚","pinyin":"zhī ài bìng fén","abbr":"zabf","explanation":"犹玉石俱焚。比喻贵贱、贤愚、良莠同归于尽。","source":{"text":"虑巫山之失火，恐芝艾之并焚耳。","book":"晋·葛洪《抱朴子·嘉遁》"},"similar":["玉石俱焚","芝艾共焚","芝艾同焚"],"usage":"作宾语、定语；用于比喻句"},{"id":38409,"word":"芝草无根","pinyin":"zhī cǎo wú gēn","abbr":"zcwg","explanation":"比喻人的成就，没有任何帮助，出于自己的努力。","source":{"text":"自古道：‘芝草无根，醴水无源。’只要孩子肯学好，那些闲话听他怎的！","book":"清·李漁《巧团圆》第三出"},"similar":["白手起家"],"usage":"作宾语、定语；指白手起家"},{"id":38410,"word":"芟夷大难","pinyin":"shān yí dà nàn","abbr":"sydn","explanation":"芟：删除杂草；芟夷：削平；难：灾难。削平大乱。","source":{"text":"今操芟夷大难，略已平矣。","book":"晋·陈寿《三国志·蜀志·诸葛亮传》"},"usage":"作谓语；指平乱"},{"id":38411,"word":"芟繁就简","pinyin":"shān fán jiù jiǎn","abbr":"sfjj","explanation":"芟：除去；就：趋向。去掉繁杂部分，使它趋于简明。","source":{"text":"绝句之法，要婉曲回环，删芜就简。","book":"《尚书·纬》：“删夷繁乱。”宋·严羽《历代诗话·诗法家数》"},"example":{"text":"今所定律令，～，使之归一，直言其事，庶几人人易知而难犯。","book":"明·焦竑《玉堂丛语·纂修》"},"similar":["删繁就简","删芜就简"],"usage":"作谓语、宾语；指简单化"},{"id":38412,"word":"芥子须弥","pinyin":"jiè zǐ xū mí","abbr":"jzxm","explanation":"芥子：芥菜子；须弥：古代印度传说中的大山。佛家语，指微小的芥子中能容纳巨大的须弥山。比喻小中也有大。","source":{"text":"师教中有言：须弥纳芥子，芥子纳须弥。须弥纳芥子时人不疑，芥子纳须弥莫成妄语不？","book":"《祖堂集·归宗和尚》"},"example":{"text":"达人胸次元无翳，～我独知。","book":"宋·刘过《投诚斋七首》其六"}},{"id":38413,"word":"芥拾青紫","pinyin":"jiè shí qīng zǐ","abbr":"jsqz","explanation":"芥：小草；青紫：官印上青色或紫色的绶带，借指高官显位。把任高官看作象捡起一棵小草那样轻松。比喻有才能，可以轻松取得高位。","source":{"text":"其取青紫，如俛拾地芥耳。","book":"《汉书·夏侯胜传》"},"example":{"text":"念己才调，自合～，富贵后何求弗得。","book":"清·蒲松龄《聊斋志异·仙人岛》"}},{"id":38414,"word":"芥纳须弥","pinyin":"jiè nà xū mí","abbr":"jnxm","explanation":"须弥：传说中的古印度山名。佛教说法，小小的芥子可包容须弥大山或整个世界。","example":{"text":"佛家所说的～包含一个伟大的哲理。"},"usage":"作宾语、定语；用于书面语"},{"id":38415,"word":"芬芳馥郁","pinyin":"fēn fāng fù yù","abbr":"fffy","explanation":"芬芳：指香气；馥：香气；馥郁：香气浓厚。形容香气非常浓。","source":{"text":"家树先不必看她那人就闻到一阵芬芳馥郁的脂粉味。","book":"张恨水《啼笑姻缘》第二回"},"example":{"text":"这儿的花香叶香，统体～，沁人心脾。"},"similar":["沁人心脾"],"usage":"作谓语、定语；形容香气非常浓烈"},{"id":38416,"word":"花下晒裈","pinyin":"huā xià shài kūn","abbr":"hxsk","explanation":"裈：有裆裤子。在鲜花下晒裤子。比喻不文雅，煞风景。","source":{"text":"花下晒裈。","book":"唐·李商隐《杂纂·杀风景》"},"usage":"作宾语、定语；用于比喻句","story":["唐朝诗人李商隐很有才华，他的诗揭露和批判当时的黑暗现实及官场腐败。他在《杂纂》中列出大煞风景的事情，如“清泉濯足，花上晒裈，背山起楼，烧琴煮鹤，对花啜茶，松下喝道。”这些都是当时让人扫兴的事情"]},{"id":38417,"word":"花下晒裻","pinyin":"huā xià shài kūn","abbr":"hxsk","explanation":"裻有裆裤子。在鲜花下晒裤子。比喻不文雅，煞风景。","source":{"text":"花下晒裻。","book":"唐·李商隐《杂纂·杀风景》"}},{"id":38418,"word":"花不棱登","pinyin":"huā bù lēng dēng","abbr":"hbld","explanation":"形容颜色杂而乱。","example":{"text":"他们都爱穿那种～的衬衫。"},"usage":"作定语、状语；用于口语"},{"id":38419,"word":"花不迷人人自迷","pinyin":"huā bù mí rén rén zì mí","abbr":"hbmrrzm","explanation":"花不会去迷人，因人喜欢而美丽。指人对某事倾注了感情色彩。","source":{"text":"酒不醉人人自醉，花不迷人人自迷。直饶今日能知悔，何不当初莫去为？","book":"明·施耐庵《水浒传》第21回"},"similar":["酒不醉人人自醉"],"usage":"作宾语、定语；多用于自我解嘲"},{"id":38420,"word":"花丽狐哨","pinyin":"huā lì hú shào","abbr":"hlhs","explanation":"形容颜色过分鲜艳繁杂或比喻人浮华而不实在。","source":{"text":"他自己吃人在他跟前那等花丽狐哨，乔龙画虎的，两面三刀哄他，就是千好万好了。","book":"明·兰陵笑笑生《金瓶梅词话》第20回"},"similar":["花狸狐哨","花里胡哨","花藜胡哨"],"usage":"作定语、状语；比喻浮华而不实在"},{"id":38421,"word":"花信年华","pinyin":"huā xìn nián huá","abbr":"hxnh","explanation":"花信：开花时期。指女子的年龄到了二十四岁。也泛指女子的年龄正处在年轻貌美之时。","source":{"text":"谁能腰鼓催花信，快打扬州百面雷。","book":"宋·范成大《元夕后连阴》"},"example":{"text":"在她～时，她早就小有名气了"},"usage":"作宾语、定语；用于女性"},{"id":38422,"word":"花光柳影","pinyin":"huā guāng liǔ yǐng","abbr":"hgly","explanation":"百花流彩生光，垂柳投影摇曳。形容春到人间，多彩清新。","source":{"text":"花光柳影，鸟语溪声。","book":"清·曹雪芹《红楼梦》第二十五回"},"usage":"作宾语、定语；指春天的景象"},{"id":38423,"word":"花前月下","pinyin":"huā qián yuè xià","abbr":"hqyx","explanation":"本指游乐休息的环境。后多指谈情说爱的处所。","source":{"text":"尽听笙歌夜醉眠，若非月下即花前。","book":"唐·白居易《老病》诗"},"example":{"text":"～，几度销魂，未识多情面，空遗泪痕。","book":"明·胡文焕《群音类选·红叶记·红叶重逢》"},"similar":["耳鬓厮磨"],"opposite":["行同陌路"],"usage":"作宾语、定语；指谈情说爱的处所"},{"id":38424,"word":"花团锦簇","pinyin":"huā tuán jǐn cù","abbr":"htjc","explanation":"锦：有文彩的丝织品；簇：丛聚。形容五彩缤纷，十分鲜艳多彩的景象。也形容文章辞藻华丽。","source":{"text":"自余是什么亲拟，将有限身心向无限中用，……。若无恁么事，饶你攒花簇锦，亦无用处。","book":"宋·释道原《景德传灯录》卷十七"},"example":{"text":"上下人等打扮的～。","book":"清·曹雪芹《红楼梦》第五十三回"},"similar":["姹紫嫣红","万紫千红","花簇锦攒"],"usage":"作宾语、定语、状语；形容五彩缤纷"},{"id":38425,"word":"花堆锦簇","pinyin":"huā duī jǐn cù","abbr":"hdjc","explanation":"形容五色缤纷，艳丽多彩。","source":{"text":"库吏奉了多贴，将六十万钱资妆，都搬来旧衙门内，摆设得齐齐整整，花堆锦簇。","book":"《古今小说·葛令公生遣弄珠儿》"},"similar":["花团锦簇","花簇锦攒"],"usage":"作谓语、定语、宾语；形容五彩缤纷"},{"id":38426,"word":"花多子少","pinyin":"huā duō zǐ shǎo","abbr":"hdzs","explanation":"花虽开得很多，但果实却很少。多比喻妇人孕多而不育。","source":{"text":"妇人疏孕者子活，数孕者子死，譬若瓠华多实少也。","book":"清·翟灏《通俗编·草木》"}},{"id":38427,"word":"花天酒地","pinyin":"huā tiān jiǔ dì","abbr":"htjd","explanation":"形容沉湎在酒色之中。花，指妓女。","source":{"text":"一篷儿，花天酒地，消磨风月如许。","book":"清·郭麐《摸鱼儿》词"},"example":{"text":"南京秦淮河一带仍是～，听歌狎妓。","book":"姚雪垠《李自成》第二卷第十七章"},"similar":["金迷纸醉","醉生梦死","灯红酒绿"],"opposite":["克勤克俭","艰苦朴素","节衣缩食"],"usage":"作谓语、定语、状语；指酒色生活"},{"id":38428,"word":"花天锦地","pinyin":"huā tiān jǐn dì","abbr":"htjd","explanation":"形容繁华热闹。","source":{"text":"行至长安，果然是花天锦地，比新丰市又不相同。","book":"明·冯梦龙《古今小说》第五卷"},"example":{"text":"清·黄小配《廿载繁华梦》第一回：“今有舅父这一条路，好歹借一帆风，再见个～的世界，也未可定。”"},"usage":"作宾语、定语；用于口语"},{"id":38429,"word":"花好月圆","pinyin":"huā hǎo yuè yuán","abbr":"hhyy","explanation":"花儿正盛开，月亮正圆满。比喻美好圆满。多用于祝贺人新婚。","source":{"text":"莫思身外，且逗尊前，愿花长好，人长健，月长圆。","book":"宋·晁端礼《行香子·别恨》词"},"example":{"text":"祝你们新婚～，白头偕老。"},"similar":["鹊笑鸠舞"],"opposite":["花残月缺"],"usage":"作谓语、定语；比喻美好生活"},{"id":38430,"word":"花嫣柳媚","pinyin":"huā yān liǔ mèi","abbr":"hylm","explanation":"比喻女子姿容美丽。","source":{"text":"平如衡听见说不是小姐，忙抬头起来一看，只见那女子生得花嫣柳媚，犹如仙子一般。","book":"清·荻岸山人《平山冷燕》第16回"},"example":{"text":"在这～的氛围里，谁能坐怀不乱呢？"},"usage":"作定语；用于比喻句"},{"id":38431,"word":"花容月貌","pinyin":"huā róng yuè mào","abbr":"hrym","explanation":"如花似月的容貌。形容女子美貌。","source":{"text":"那公主花容月貌，有二十分人才。","book":"明·吴承恩《西游记》第六十二回"},"example":{"text":"那娟娟小姐，～，自不必说；刺绣描花，也是等闲之事。","book":"明·冯梦龙《醒世恒言》卷二十五"},"similar":["国色天香","羞花闭月","倾城倾国"],"opposite":["面目可憎","其貌不扬"],"usage":"作谓语、定语；形容女子貌美"},{"id":38432,"word":"花影缤纷","pinyin":"huā yǐng yīng fēn","abbr":"hybf","explanation":"花光月影，五彩缤纷。形容景色绚丽多彩。","source":{"text":"元春入室，更衣复出，上舆进园，只见园中香烟缭绕，花影缤纷，处处灯光相映，时时细乐声喧，说不尽这太平景象，富贵风流。","book":"清·曹雪芹《红楼梦》第十八回"}},{"id":38433,"word":"花成蜜就","pinyin":"huā chéng mì jiù","abbr":"hcmj","explanation":"比喻好事圆满地完成或实现。多指爱情婚姻生活。","source":{"text":"再休题愁除病减，花成蜜就，叶落归根。","book":"明·无名氏《逞风流王焕百花亭》第二折"}},{"id":38434,"word":"花拳绣腿","pinyin":"huā quán xiù tuǐ","abbr":"hqxt","explanation":"比喻只做些表面上好看实际上并无用处的工作。","source":{"text":"只见张国乾缚得花拳绣腿，戚光祖、戚继祖两个教师在后面跟着，走上台来，两边坐定。","book":"清·钱彩《说岳全传》第69回"},"example":{"text":"你的这套～中看不中用。"},"similar":["表面功夫"],"usage":"作主语、宾语、定语；指不实用的东西"},{"id":38435,"word":"花攒绮簇","pinyin":"huā cuán qǐ cù","abbr":"hzqc","explanation":"锦：有彩色花纹的丝织品；簇：聚成一团。形容五彩缤纷的景象。","source":{"text":"骚人逸士之流，狭斜平康之伎，社南社北之儿，花攒绮簇，杂踏山间，不减上方、虎丘。","book":"明·袁宏道《游记·楞伽》"},"similar":["花攒锦簇","花攒锦聚","花团锦簇"],"usage":"作谓语、定语、宾语；形容五彩缤纷"},{"id":38436,"word":"花攒锦簇","pinyin":"huā cuán jǐn cù","abbr":"hcjc","explanation":"形容五色缤纷、繁盛艳丽的景象。","source":{"text":"不说当日酒筳笑声，，觥筹交错，耍顽至二更时分，方才席散。","book":"《金瓶梅词话》第七六回"},"similar":["花攒锦聚","花团锦簇","花攒绮簇"],"usage":"作谓语、定语、宾语；形容五彩缤纷"},{"id":38437,"word":"花攒锦聚","pinyin":"huā cuán jǐn jù","abbr":"hcjj","explanation":"形容五色缤纷、繁盛艳丽的景象。同“花攒锦簇”。","source":{"text":"隐隐春雷慢吐，十三段花攒锦聚。","book":"清·陈维崧《贺新郎·春夜听鼓师挝鼓》词"},"similar":["花攒锦簇","花团锦簇","花攒绮簇"],"usage":"作谓语、定语、宾语；形容五彩缤纷"},{"id":38438,"word":"花无百日红","pinyin":"huā wú bǎi rì hóng","abbr":"hwbrh","explanation":"花不能长开不败。比喻好景不长。","source":{"text":"几曾见柳有千年绿，花都说有百日红，枉费春工。","book":"元·谷子敬《城南柳》第二折"},"example":{"text":"正是人无百日好，～。","book":"明·罗贯中《平妖传》第十二回"},"similar":["人无千日好"],"usage":"作宾语、定语、分句；比喻青春易逝","story":["宋江杀了阎婆惜后投靠有钱有势的柴进，柴进特别款待他，他喝酒到深夜起身去上厕所碰到武松。武松破口大骂，旁人告诉武松他是大官人最红的客官，武松大发感慨：人无千日好，花无百日红。他们同去见柴进，相识后成为要好的朋友"]},{"id":38439,"word":"花明柳媚","pinyin":"huā míng liǔ mèi","abbr":"hmlm","explanation":"形容春天绿柳成荫、繁花似锦的景象。","source":{"text":"遇着花明柳媚的时节，把一乘年车载了母亲，他便戴了高帽……在乡村镇上以及湖边，到处玩耍。","book":"《儒林外史》第一回"},"example":{"text":"待得～，看雕鞍骏马，又去踏春风。","book":"清·徐大椿《洄溪道情·题唐悔生寒林行啸图》"},"usage":"作定语；用于春天"},{"id":38440,"word":"花明柳暗","pinyin":"huā míng liǔ àn","abbr":"hmla","explanation":"垂柳浓密，鲜花夺目。形容柳树成荫，繁花似锦的春天景象。也比喻在困难中遇到转机。","source":{"text":"花明柳暗绕天愁，上尽重城更上楼。","book":"唐·李商隐《夕阳楼》诗"},"example":{"text":"～绕天愁，赵女乘春上画楼。","book":"明·刘基《忆王孙》诗"},"similar":["柳暗花明"],"usage":"作谓语、定语；比喻在困难中遇到转机"},{"id":38441,"word":"花晨月夕","pinyin":"huā chén yuè xī","abbr":"hcyx","explanation":"有鲜花的早晨，有明月的夜晚。指美好的时光和景物。同“花朝月夕”。","source":{"text":"花晨月夕，如乘彩云而登碧落。","book":"清·汪汝谦《画舫约》"},"example":{"text":"清·韩邦庆《海上花列传》第37回：“尚未得一可意人儿承欢侍宴，未免辜负～耳。”"},"similar":["花辰月夕","花朝月夕"],"usage":"作宾语；指美好的时光和景物"},{"id":38442,"word":"花月之身","pinyin":"huā yuè zhī shēn","abbr":"hyzs","explanation":"花容月貌之身。形容女子美丽的身姿。旧时也指妓女。","source":{"text":"他为你生小绿珠花月身，寻一个金谷绮罗里石季伦。","book":"清·孔尚任《桃花扇·拒媒》"}},{"id":38443,"word":"花朝月夕","pinyin":"huā zhāo yuè xī","abbr":"hzyx","explanation":"有鲜花的早晨，有明月的夜晚。指美好的时光和景物。旧时也特指农历二月十五和八月十五。","source":{"text":"每花朝月夕，与宾佐赋咏，甚有情致。","book":"《旧唐书·罗威传》"},"example":{"text":"到了～，依旧相约玩耍。","book":"清·曹雪芹《红楼梦》第一○二回"},"similar":["良辰美景","花朝月夜","花晨月夕"],"usage":"作宾语；指美好的时光和景物","story":["唐朝时期，北方的魏州等地土地辽阔，兵强马壮，那儿的节度使虽受封于皇帝，罗威自己继承父位，皇帝也只好承认。他喜欢儒家文化，藏书很多，经常与一帮文人墨客迎风作赋、对月作诗，他把自己花朝月夕作品命名为《偷江东山集》"]},{"id":38444,"word":"花朝月夜","pinyin":"huā zhāo yuè yè","abbr":"hzyy","explanation":"有鲜花的早晨，有明月的夜晚。指美好的时光和景物。旧时也特指农历二月十五和八月十五。","source":{"text":"动春心花朝月夜，谁忍相思今不见。","book":"南朝·梁元帝《春别应令诗》"},"example":{"text":"～，置酒题篇。","book":"唐·陈子良《隋新城郡东曹掾萧平仲诔》"},"similar":["花朝月夕"],"usage":"作宾语；指美好的时光和景物"},{"id":38445,"word":"花林粉阵","pinyin":"huā lín fěn zhèn","abbr":"hlfz","explanation":"旧时比喻成群的艳装美女。","source":{"text":"排列着花林粉阵。","book":"清·孔尚任《桃花扇·拒蝶》"},"usage":"作宾语、定语；指美女"},{"id":38446,"word":"花枝招展","pinyin":"huā zhī zhāo zhǎn","abbr":"hzzz","explanation":"招展：迎风摆动的样子。形容打扮得十分艳丽。","source":{"text":"袭人等捧过茶来，才吃了一口，平儿也打扮的花枝招展的来了。","book":"清·曹雪芹《红楼梦》第六十二回"},"example":{"text":"墙边一排一排的板凳上，坐着粉白黛绿，～的妇女们，笑语盈盈的不休。","book":"冰心《六一姊》"},"similar":["如花似锦","姹紫嫣红","花团锦簇"],"opposite":["朴实大方"],"usage":"作谓语、定语、状语、宾语；用于女子"},{"id":38447,"word":"花枝招颤","pinyin":"huā zhī zhāo chàn","abbr":"hzzc","explanation":"形容打扮得十分艳丽。同“花枝招展”。","source":{"text":"冯舍人见了，慌忙起身，偷眼一觑，花枝招颤，态度轻盈，魂不附体，倒身便拜。","book":"《水浒后传》第四回"},"similar":["花枝招颭","花枝招展"],"usage":"作定语、状语、宾语；用于女子"},{"id":38448,"word":"花枝招颭","pinyin":"huā zhī zhāo zhǎn","abbr":"hzzz","explanation":"形容打扮得十分艳丽。同“花枝招展”。","source":{"text":"那女子的尖尖趫趫，凤头一对，露在汀裙之下，莲步轻移，如花枝招颭一般。","book":"《醒世恒言·乔太守乱点鸳鸯谱》"}},{"id":38449,"word":"花枝招飍","pinyin":"huā zhī zhāo zhǎn","abbr":"hzzz","explanation":"形容打扮得十分艳丽。同花枝招展”。","source":{"text":"那女子的尖尖趫趫，凤头一对，露在汀裙之下，莲步轻移，如花枝招飍一般。","book":"《醒世恒言·乔太守乱点鸳鸯谱》"}},{"id":38450,"word":"花枝招飐","pinyin":"huā zhī zhāo zhǎn","abbr":"hzzz","explanation":"飐：风吹物使之颤动；招飐：迎风摆动。形容女子打扮得十分艳丽或景色优美。","source":{"text":"那女子的尖尖跷跷风头一对，露在湘裙之下，莲步轻移，如花枝招飐一般。","book":"明·冯梦龙《醒世恒言》第八卷"},"similar":["花枝招展"],"usage":"作定语、状语、宾语；用于女子"},{"id":38451,"word":"花样不同","pinyin":"huā yàng bù tóng","abbr":"hybt","explanation":"原指丝织品的式样花色各不相同。后指同类产品的花色式样不一样。也指技艺的表现手法各不相同，五花八门。","source":{"text":"因问之，云旧隶宫锦坊，近以薄技投本行云，如今花样不同，且东归也。","book":"唐·卢言《卢氏杂说》"}},{"id":38452,"word":"花样年华","pinyin":"huā yàng nián huá","abbr":"hynh","explanation":"花样：像花一样。指美丽的青春年华。"},{"id":38453,"word":"花样新翻","pinyin":"huā yàng xīn fān","abbr":"hyxf","explanation":"指独出心裁，创造新花样。同“花样翻新”。","source":{"text":"十年来拼置章句，专改鼓词，花样新翻。只恐词难达意，机丝巧织，未免手不从心。","book":"清·侯芝《再生缘》序"},"similar":["花样翻新"],"usage":"作谓语、定语、宾语；指独出心裁"},{"id":38454,"word":"花样翻新","pinyin":"huā yàng fān xīn","abbr":"hyfx","explanation":"指独出心裁，创造新花样。","source":{"text":"天吴柴凤绣垂缪，花样翻新新色嵌。","book":"清·孙道干《小螺庵病榻忆语》附录·姜葆初《用十五咸全韵》"},"example":{"text":"～，无奇不有。","book":"孙犁《秀露集·第一个洞》"},"similar":["除旧布新","推陈出新"],"opposite":["老调重弹","故技重演"],"usage":"作谓语、定语、宾语；指独出心裁"},{"id":38455,"word":"花根本艳","pinyin":"huā gēn běn yàn","abbr":"hgby","explanation":"花的艳丽由其根本所致，是本身所固有的，无需借助外部力量，旧时比喻达官显贵的子孙后代不需谋求而享受荣华富贵。"},{"id":38456,"word":"花残月缺","pinyin":"huā cán yuè quē","abbr":"hcyq","explanation":"形容衰败零落的景象。也比喻感情破裂，两相离异。","source":{"text":"月缺花残莫怆然，花须终发月须圆。","book":"唐·温庭筠《和王秀才伤歌妓》诗"},"example":{"text":"咱两个恩断义绝，～，再谁恋锦帐罗帏。","book":"元·马致远《任风子》第三折"},"opposite":["花好月圆"],"usage":"作定语、宾语、补语；比喻夫妻感情破裂"},{"id":38457,"word":"花烛洞房","pinyin":"huā zhú dòng fáng","abbr":"hzdf","explanation":"花烛：彩色蜡烛；洞房：深邃的房，指新婚夫妇的卧室。深室里点燃有龙凤图案装饰的蜡烛。形容结婚的欢乐景象。","source":{"text":"到晚来月射的破窑明，风刮的蒲帘响，便是俺花烛洞房。","book":"元·王实甫《破窑记》第一折"},"example":{"text":"路遥《平凡的世界》第二卷第35章：“一个臂挽黑纱的人怎么可能去进～呢？”"},"similar":["洞房花烛"],"usage":"作宾语、定语；指新婚"},{"id":38458,"word":"花烛红妆","pinyin":"huā zhú hóng zhāng","abbr":"hzhz","explanation":"花烛：彩色的蜡烛。点上彩色的蜡烛，穿着红艳的礼服。指婚礼。","source":{"text":"何如花烛夜，轻扇掩红妆。","book":"南朝·梁·何逊《看伏郎新婚》"}},{"id":38459,"word":"花狸狐哨","pinyin":"huā lǐ hú shào","abbr":"hlhs","explanation":"形容颜色过分鲜艳繁杂或比喻人浮华而不实在。","source":{"text":"我家是清凉瓦屋，不像这个害黄病的房子，花狸狐哨的门扇！","book":"明·吴承恩《西游记》第12回"},"similar":["花里胡哨","花藜胡哨","花丽狐哨"],"usage":"作定语、状语；比喻浮华而不实在"},{"id":38460,"word":"花甜蜜嘴","pinyin":"huā tián mì zuǐ","abbr":"htmz","explanation":"蜜嘴：嘴上抹着蜜。能说会道，甜言蜜语。比喻说话动听。","source":{"text":"取钱的时候，花甜蜜嘴，讲过按月按时，十来分重的利钱，不费一些努力，定了时刻，自己送上门来。","book":"清·西周生《醒世姻缘传》第35回"},"similar":["花甜蜜语"],"usage":"作定语、状语；用于说话等"},{"id":38461,"word":"花生满路","pinyin":"huā shēng mǎn lù","abbr":"hsml","explanation":"比喻荣耀、美满。","source":{"text":"子得和丈夫一处对舞，便是燕燕花生满路。","book":"元·关汉卿《调风月》第四折"}},{"id":38462,"word":"花甲之年","pinyin":"huā jiǎ zhī nián","abbr":"hjzn","explanation":"花甲：旧时用天干和地支相互配合作为纪年，六十年为一花甲，亦称一个甲子。花：形容干支名号错综参差。指六十岁。","source":{"text":"对酒曰：‘手挼六十花甲子，循环落落如弄珠。’","book":"宋·计有功《唐诗纪事》"},"example":{"text":"宋·计有他的爷爷已经到～，两鬓斑白。"},"usage":"作主语、宾语；用于男性"},{"id":38463,"word":"花移木接","pinyin":"huā yí mù jiē","abbr":"hymj","explanation":"把一种花木的枝条或嫩芽嫁接在另一种花木上。比喻暗中用手段更换人或事物来欺骗别人。","source":{"text":"同窗友认假作真，女秀才移花接木。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"example":{"text":"遂使玉碎香消，谁能解语？～，莫识称名。","book":"清·但明伦《聊斋志异·葛巾·评》"}},{"id":38464,"word":"花簇锦攒","pinyin":"huā cù jǐn cuán","abbr":"hcjc","explanation":"形容五色缤纷、繁盛艳丽的景象。同“花攒锦簇”。","source":{"text":"端的花簇锦攒，吹弹歌舞。","book":"《金瓶梅词话》第七六回"},"similar":["花团锦簇","花攒锦簇","花攒锦聚"],"usage":"作谓语、定语、宾语；形容五彩缤纷"},{"id":38465,"word":"花红柳绿","pinyin":"huā hóng liǔ lǜ","abbr":"hhll","explanation":"形容明媚的春天景象。也形容颜色鲜艳纷繁。","source":{"text":"花红柳绿间晴空。","book":"五代·蜀·魏承班《生查子》词"},"example":{"text":"史见那郊园野旷，景物芳菲，～，仕女游人不断头的走的。","book":"明·兰陵笑笑生《金瓶梅词话》第八十九回"},"similar":["姹紫嫣红","柳绿花红"],"usage":"作定语；形容颜色鲜艳纷繁"},{"id":38466,"word":"花脚猫","pinyin":"huā jiǎo māo","abbr":"hjm","explanation":"比喻闲游浪荡、爱串门子的女人。","example":{"text":"她是一个～、长舌妇，邻居很讨厌她。"},"usage":"作宾语、定语；用于比喻句"},{"id":38467,"word":"花腿闲汉","pinyin":"huā tuǐ xián hàn","abbr":"htxh","explanation":"旧时在腿上刺花的男人。指市井无赖。","example":{"text":"你不能与那些～一起混日子。"},"usage":"作宾语、定语；用于口语"},{"id":38468,"word":"花花世界","pinyin":"huā huā shì jiè","abbr":"hhsj","explanation":"指繁华的、吃喝玩乐的地方。也泛指人世间。","source":{"text":"回首洛阳花世界，烟渺黍离之地。","book":"宋·文及翁《贺新郎·西湖》词"},"example":{"text":"史见满园青翠萦目，红紫迎人，真是锦绣乾坤，～。","book":"清·李汝珍《镜花缘》第四回"},"similar":["灯红酒绿"],"opposite":["天昏地暗"],"usage":"作宾语、定语；指花天酒地的场所"},{"id":38469,"word":"花花公子","pinyin":"huā huā gōng zǐ","abbr":"hhgz","explanation":"指衣着华丽，只会吃喝玩乐，不务正业的、有钱有势人家的女弟。","source":{"text":"活死人便知他是个仗官托势的花花公子了。","book":"清·张南庄《何典》第六回"},"example":{"text":"他和小丑的不同，是不扮横行无忌的～，也不扮一味仗势的宰相家丁。","book":"鲁迅《二丑艺术》"},"similar":["纨绔子弟"],"opposite":["白面书生"],"usage":"作主语、宾语；指不务正业的人"},{"id":38470,"word":"花花哨哨","pinyin":"huā huā shāo shāo","abbr":"hhss","explanation":"指颜色繁多，鲜艳夺目。","source":{"text":"宾客们送的礼物，都早已摆到餐厅前面的几张大桌子上，红红绿绿，花花哨哨，在几张桌子上摆得边边沿沿都是。","book":"路遥《平凡的世界》第二卷第40章"},"similar":["花里胡哨"],"usage":"作定语、状语；用于口语"},{"id":38471,"word":"花花太岁","pinyin":"huā huā tài suì","abbr":"hhts","explanation":"太岁：原指传说中的神名，借指作威作福的土豪和官宦。指穿着华丽，不务正业，只专心于吃喝玩乐的官宦和土豪。","source":{"text":"花花太岁为第一，浪子丧门再没双。","book":"元·关汉卿《鲁斋郎》楔子"},"example":{"text":"京师人惧怕他权势，谁敢与他争口，叫他做～。","book":"明·施耐庵《水浒传》第七回"},"similar":["花花公子"],"usage":"作宾语、定语；同“花花公子”"},{"id":38472,"word":"花花搭搭","pinyin":"huā huā dā dā","abbr":"hhdd","explanation":"掺和着。形容疏密、高矮不均。","example":{"text":"这片小麦～，产量肯定高不了。"},"usage":"作谓语、定语、状语；用于口语"},{"id":38473,"word":"花花柳柳","pinyin":"huā huā liǔ liǔ","abbr":"hhll","explanation":"形容艳丽轻盈的样子。","example":{"text":"她打扮得～，十分迷人。"},"usage":"作定语、状语；用于书面语"},{"id":38474,"word":"花花点点","pinyin":"huā huā diǎn diǎn","abbr":"hhdd","explanation":"形容杂乱无序的图案、斑点。","example":{"text":"这件新衣服刚穿就被弄得～。"},"similar":["斑斑点点"],"usage":"作定语、状语；指杂乱无序"},{"id":38475,"word":"花花绿绿","pinyin":"huā huā lǜ lǜ","abbr":"hhll","explanation":"形容颜色艳丽纷繁。","source":{"text":"凭君细数东州客，谁在花花绿绿间？","book":"金·元好问《又解嘲》诗"},"example":{"text":"陈列在橱窗里的～的洋布，听说只要八分半一尺。","book":"叶圣陶《多收了三五斗》"},"similar":["绚烂多彩"],"opposite":["暗淡无光"],"usage":"作定语；形容颜色鲜明多彩"},{"id":38476,"word":"花花肠子","pinyin":"huā huā cháng zǐ","abbr":"hhcz","explanation":"比喻奸诈的计谋或有奸诈心计之人。","source":{"text":"我这人见水就晕，坐那两小时船没风没浪的都吐出了花花肠子。","book":"王朔《千万别把我当人》"},"example":{"text":"你最好别听那～瞎吹牛。"},"usage":"作宾语、定语；指诡计多端"},{"id":38477,"word":"花萼相辉","pinyin":"huā è xiāng huī","abbr":"hexh","explanation":"萼：花蒂。花朵与花萼相互辉映。比喻兄弟友爱，手足情深。","source":{"text":"玄宗于兴庆宫西南置楼，四面题曰花萼相辉之楼，南面题曰勤政务本之楼。","book":"《旧唐书·让皇帝宪传》"}},{"id":38478,"word":"花落谁家","pinyin":"huā luò shuí jiā","abbr":"hlsj","explanation":"喻指在众多竞选者、待聘者、参赛者中，谁是最后胜出者。","usage":"常用于疑问或猜测语气。"},{"id":38479,"word":"花藜胡哨","pinyin":"huā lí hú shào","abbr":"hlhs","explanation":"形容颜色过分鲜艳繁杂或比喻人浮华而不实在。","source":{"text":"一同进到房里，见满桌堆着都是选的刻本文章，红笔对的样，花藜胡哨的。","book":"清·吴敬梓《儒林外史》第29回"},"similar":["花里胡哨","花狸狐哨","花丽狐哨"],"usage":"作定语、状语；比喻浮华而不实在"},{"id":38480,"word":"花街柳巷","pinyin":"huā jiē liǔ xiàng","abbr":"hjlx","explanation":"花、柳：旧指娼妓。旧指游乐的地方。也指妓院。","source":{"text":"花街柳陌，众多娇艳名姬；楚馆秦楼，无限风流歌妓。","book":"明·施耐庵《水浒全传》第六回"},"example":{"text":"那～，也时常要逛逛，这仲勋就慢慢的放荡出来。","book":"清·彭养鸥《黑籍冤魂》第十五回"},"similar":["花街柳市"],"usage":"作宾语；指妓院"},{"id":38481,"word":"花街柳市","pinyin":"huā jiē liǔ shì","abbr":"hjls","explanation":"指妓院聚集的街市。","source":{"text":"花街柳市，你恋着蜂蝶采。","book":"《金瓶梅词话》第七四回"},"similar":["花街柳巷","花阶柳市"],"usage":"作宾语、定语；指妓院聚集的地方"},{"id":38482,"word":"花街柳陌","pinyin":"huā jiē liǔ mò","abbr":"hjlm","explanation":"指妓院聚集的街市。","source":{"text":"那李秀才不离了花街柳陌，占场儿贪杯好色，看上那柳眉星眼杏花腮。","book":"元·无名氏《货郎旦》第四折"},"example":{"text":"～，众多娇艳名姬；楚馆秦楼，无限风流歌妓。","book":"《水浒传》第六回"},"similar":["花街柳市","花街柳巷","花衢柳陌"],"usage":"作宾语、定语；指妓院聚集的地方"},{"id":38483,"word":"花衢柳陌","pinyin":"huā qú liǔ mò","abbr":"hqlm","explanation":"指妓院聚集的街市。","source":{"text":"花街柳陌，恨他去胡沾惹；秦楼谢馆，怪他去闲游冶。","book":"元·李邦祐《转调淘金令·思情》曲"},"similar":["花街柳陌","花街柳巷","花街柳市"],"usage":"作宾语、定语；指妓院聚集的地方"},{"id":38484,"word":"花言巧语","pinyin":"huā yán qiǎo yǔ","abbr":"hyqy","explanation":"原指铺张修饰、内容空泛的言语或文辞。后多指用来骗人的虚伪动听的话。","source":{"text":"‘巧言’即今所谓花言巧语，如今世举子弄笔端做文字者是也。","book":"宋·朱熹《朱子语类·论语三》"},"example":{"text":"我以为法律上的许多罪名，都是～，只有一语以包括之，曰：可恶罪。","book":"鲁迅《而已集·可恶罪》"},"similar":["心口不一","甜言蜜语","巧舌如簧"],"opposite":["肺腑之言","心口如一","由衷之言"],"usage":"作主语、定语、宾语；指虚伪动听的话","story":["张生喜欢莺莺，他写一封情书托莺莺的丫鬟红娘偷偷带给莺莺。莺莺假装生气给张生回信，实际是暗中约他月下偷偷私会。红娘看出其中的破绽，故意装作不愿送信。崔莺莺只好花言巧语骗红娘给她送信"]},{"id":38485,"word":"花说柳说","pinyin":"huā shuō liǔ shuō","abbr":"hsls","explanation":"形容说虚假而动听的话哄人。","source":{"text":"你看不得这些年轻小老爷们，花说柳说的不中，一按就没了，早呢。","book":"清·文康《儿女英雄传》第十五回"},"example":{"text":"我也不会～的，一句话，我就保他不撒谎，出苦力，这两条儿。","book":"清·文康《儿女英雄传》第四十回"},"similar":["花言巧语"],"usage":"作宾语、定语、状语；指骗人的话"},{"id":38486,"word":"花貌蓬心","pinyin":"huā mào péng xīn","abbr":"hmpx","explanation":"蓬心：蓬草的心狭窄而弯曲，比喻见识浅薄。指虚有其表。","source":{"text":"而叩其女学，则花貌蓬心，瞢无所识。","book":"康有为《大同书》戊部第一章"},"similar":["虚有其表"],"usage":"作谓语、定语；用于比喻句"},{"id":38487,"word":"花貎蓬心","pinyin":"huā ní péng xīn","abbr":"hnpx","explanation":"指虚有其表。","source":{"text":"故举国女子，殆皆不学……而叩其女学，则花貎蓬心，瞢无所识。","book":"康有为《大同书》戊部第一章"}},{"id":38488,"word":"花辰月夕","pinyin":"huā chén yuè xī","abbr":"hcyx","explanation":"有鲜花的早晨，有明月的夜晚。指美好的时光和景物。同“花朝月夕”。","source":{"text":"每值花辰月夕，辄置酒宴赏。","book":"清·王韬《淞滨琐话·药娘》"},"example":{"text":"清·王韬《淞滨琐话·药娘》：“每值～，辄置酒宴赏。”"},"similar":["花晨月夕","花朝月夕"],"usage":"作宾语；指美好的时光和景物"},{"id":38489,"word":"花边人物","pinyin":"huā biān rén wù","abbr":"hbrw","explanation":"指八面玲珑、快嘴利舌、幽默机智、活动于有新闻价值场合的人。","example":{"text":"她喜欢制造绯闻，以至于成为～。"},"usage":"作主语、宾语、定语；用于口语"},{"id":38490,"word":"花遮柳掩","pinyin":"huā zhē liǔ yǎn","abbr":"hzly","explanation":"形容不让人看见，悄悄地走。也比喻运行或说话躲躲闪闪，不实在。","source":{"text":"花遮柳掩防人至，觅常山宝符。","book":"明·胡文焕《群音类选·窃符记·如姬窃符》"},"similar":["花遮柳隐"],"usage":"作状语；指行动掩掩遮遮"},{"id":38491,"word":"花遮柳隐","pinyin":"huā zhē liǔ yǐn","abbr":"hzly","explanation":"形容不让人看见，悄悄地走。也比喻运行或说话躲躲闪闪，不实在。","source":{"text":"花遮柳掩防人至，觅常山宝符。","book":"明·胡文焕《群音类选·窃符记·如姬窃符》"},"example":{"text":"五儿听罢，便心下要分些赠芳官，遂用纸另包了一半，趁黄昏人稀之时，自己～的来找芳官。","book":"清·曹雪芹《红楼梦》第六十一回"},"similar":["花遮柳掩"],"usage":"作定语、状语；形容悄悄地走"},{"id":38492,"word":"花里胡哨","pinyin":"huā lǐ hú shào","abbr":"hlhs","explanation":"形容颜色过分鲜艳繁杂。也比喻浮华而不实在。","source":{"text":"这里那里是我家，我家是清凉瓦屋，不象这个害黄病的房子，花狸狐哨的门扇。","book":"明·吴承恩《西游记》第十二回"},"example":{"text":"一同进到房里，见满桌堆着都是选的刻本文章，红笔对的样，～的。","book":"清·吴敬梓《儒林外史》第二十九回"},"similar":["花里胡梢","花藜胡哨","花丽狐哨"],"usage":"作定语、状语；比喻浮华而不实在"},{"id":38493,"word":"花锦世界","pinyin":"huā jǐn shì jiè","abbr":"hjsj","explanation":"指繁华之地。同“花花世界”。","source":{"text":"到永乐爷从北平起兵靖难，迁于燕都，是为北京。只因这一迁，把个苦寒地面，变作花锦世界。","book":"《警世通言·杜十娘怒沉百宝箱》"},"similar":["花花世界"],"usage":"作宾语、定语；指花天酒地的场所"},{"id":38494,"word":"花门柳户","pinyin":"huā mén liǔ hù","abbr":"hmlh","explanation":"花、柳：指妓女。旧指妓院。","source":{"text":"奴家当脱得花门柳户，与孙官人结为夫妻。","book":"元·无名氏《小孙屠·谋杀孙必达》"},"example":{"text":"好男人不能去～。"},"similar":["花街柳巷"],"usage":"作主语、宾语、定语；指妓院"},{"id":38495,"word":"花闭月羞","pinyin":"huā bì yuè xiū","abbr":"hbyx","explanation":"闭：躲避；羞：害臊。闭月形容貂禅，羞花形容杨玉环。使月亮见了也躲避起来，花儿见了也自觉羞愧。形容女子貌美。","source":{"text":"只闻檀板当歌讴，不见如花闭月羞。","book":"元·无名氏《醉写赤壁赋》第一折"},"similar":["闭月羞花","月闭花羞"],"usage":"作谓语、定语；用于美女"},{"id":38496,"word":"花阶柳市","pinyin":"huā jiē liǔ shì","abbr":"hjls","explanation":"指妓院聚集的街市。","source":{"text":"你每小舍人年纪少，莫要花阶柳市去。","book":"明·刘基《诚意伯次子阁门使刘仲璟遇恩录》"},"similar":["花街柳市","花街柳巷","花街柳陌"],"usage":"作宾语、定语；指妓院聚集的地方"},{"id":38497,"word":"花须蝶芒","pinyin":"huā xū dié máng","abbr":"hxdm","explanation":"形容草书笔法优美熟练。","source":{"text":"昔右军之叙兰亭，字既尽美，尤善布置，所谓增一分太长，亏一分太短，鱼鬣鸟翅，花须蝶芒，油然桀然，各止其所，纵横曲折，无不如意，毫发之间，直无遗憾。","book":"明·解缙《春雨杂述》"}},{"id":38498,"word":"花颜月貌","pinyin":"huā yán yuè mào","abbr":"hyym","explanation":"形容女子的美丽。","source":{"text":"那公主花容月貌，有二十分人才。","book":"明·吴承恩《西游记》第六十二回"},"example":{"text":"刘姥姥见平儿遍身凌罗，插金戴银，～，便当是凤姐了。","book":"清·曹雪芹《红楼梦》第六回"},"similar":["花容月貌","月貌花容"],"usage":"作定语、宾语；形容女子的美丽"},{"id":38499,"word":"花飞蝶舞","pinyin":"huā fēi dié wǔ","abbr":"hfdw","explanation":"鲜花和蝴蝶随风起舞、飘飞。比喻年轻女子的走路姿势柔美轻盈。","source":{"text":"她答应了一声，早花飞蝶舞一般过去。","book":"清·文康《儿女英雄传》第四十回"}},{"id":38500,"word":"花香鸟语","pinyin":"huā xiāng niǎo yǔ","abbr":"hxny","explanation":"鸟语：鸟鸣如同讲话一般。形容春天动人的景象。","source":{"text":"鸟语花香变夕阴，稍闲复恐病相寻。","book":"宋·吕本中《紫薇·庵居》"},"example":{"text":"云雾渐淡，日色微明，四面也有人烟来往，各处～，颇可盘桓。","book":"清·李汝珍《镜花缘》第九十八回"},"similar":["鸟语花香"],"usage":"作定语、宾语；形容春天媚人的景象"},{"id":38501,"word":"花马吊嘴","pinyin":"huā mǎ diào zuǐ","abbr":"hmdz","explanation":"花言巧语地耍嘴皮子。","source":{"text":"你倒还想来，别给我花马吊嘴的，妹妹记着前事，正在这里恨你呢！","book":"曾朴《孽海花》第16回"},"similar":["花马掉嘴"],"usage":"作谓语、定语；用于口语"},{"id":38502,"word":"花马掉嘴","pinyin":"huā mǎ diào zuǐ","abbr":"hmdz","explanation":"旧时俗语，指花言巧语、油嘴滑舌地耍嘴皮子。","source":{"text":"你不用和我花马掉嘴的。咱们清水下杂面——你吃我看……你别糊涂油蒙了心，打量我们不知你府上的事呢。","book":"清·曹雪芹《红楼梦》第六十五回"},"similar":["花马吊嘴"],"usage":"作谓语、定语；用于口语"},{"id":38503,"word":"花魔酒病","pinyin":"huā mó jiǔ bìng","abbr":"hmjb","explanation":"花：指女色。指迷恋酒色。","source":{"text":"花解语，娇相并，旦暮花魔酒病。","book":"元·曾瑞《哨遍·思乡》"},"example":{"text":"早除却～，惯闻他鹤唳猿声，守清夜药垆丹鼎。","book":"明·梅鼎祚《玉合记·醳负》"},"usage":"作宾语、定语；用于生活"},{"id":38504,"word":"芳兰竟体","pinyin":"fāng lán jìng tǐ","abbr":"fljt","explanation":"芳兰：兰草的香气；竟体：满身。香气满身。比喻举止闲雅，风采极佳。","source":{"text":"意气闲雅，视瞻聪明，武帝目送良久，谓徐勉曰：‘觉此生芳兰竟体。’","book":"《南史·谢览传》"},"example":{"text":"这两人，面如傅粉，唇若涂朱；举止风流，～。","book":"清·吴敬梓《儒林外史》第三十四回"},"usage":"作谓语、定语；比喻举止闲雅"},{"id":38505,"word":"芳年华月","pinyin":"fāng nián huá yuè","abbr":"fnhy","explanation":"芳年：妙龄。指美好的年华。","source":{"text":"芳年有华月，佳人无还期。","book":"南朝·宋·刘铄《拟行行重行行》"},"usage":"作宾语、定语；用于书面语"},{"id":38506,"word":"芳草鲜美","pinyin":"fāng cǎo xiān měi","abbr":"fcxm","explanation":"晋·陶潜《桃花源记》：“缘溪行，忘路之远近，忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷。”","source":{"text":"缘溪行，忘路之远近，忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷。","book":"晋·陶潜《桃花源记》"},"usage":"作宾语、定语；指春天的美景"},{"id":38507,"word":"芸芸众生","pinyin":"yún yún zhòng shēng","abbr":"yyzs","explanation":"芸芸：形容众多；众生：原指一切生物，后指许多人。原指世间的一切生灵。后多指大群无知无识的人。","source":{"text":"众生必死，死必归土。","book":"《老子》第十六章：“夫物芸芸，各复归其根。”《礼记·祭义》"},"example":{"text":"这些话，是告诉～，到底是有一大部分感觉不敏的。","book":"鲁迅《三闲集·文艺与革命》"},"similar":["绸人广众","凡夫俗子"],"usage":"作主语、宾语、定语；指一切生灵"},{"id":38508,"word":"苌弘化碧","pinyin":"cháng hóng huà bì","abbr":"chhb","explanation":"苌弘：周敬王的夫人，后蒙冤为人所杀，传说血化为碧玉。","source":{"text":"人主莫不欲其臣之忠，而忠未必信，故伍员流于江，苌弘死于蜀，藏其血三年而化为碧。","book":"《庄子·外物》"},"example":{"text":"我不要半星热血红尘洒，都只在八尺旗枪素练悬。等他四下里皆瞧见，这就是咱～，望帝啼鹃。","book":"元·关汉卿《窦娥冤》第三折"},"similar":["三年化碧"],"usage":"作宾语、定语；指人忠诚","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他被杀的当时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":38509,"word":"苌弘碧血","pinyin":"cháng hóng bì xuě","abbr":"chbx","explanation":"形容为正义事业而流的血。苌弘：春秋时周大夫，又称苌叔。碧：青绿色的玉石。","source":{"text":"苌弘死于蜀，藏其血，三年而化为碧。","book":"《庄子·外物》"},"similar":["苌弘化碧"],"usage":"作宾语、定语；用于为正义事业","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他在蜀地被杀时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":38510,"word":"苍松翠柏","pinyin":"cāng sōng cuì bǎi","abbr":"cscb","explanation":"苍：青色。翠：青绿色。指四季常青的松柏。比喻具有高贵品质、坚定节操的人。","source":{"text":"只见对面千佛山上，梵宇僧楼，与那苍松翠柏，高下相间，红的火红，白的雪白，青的靛青，绿的碧绿。","book":"清·刘鹗《老残游记》第二回"},"example":{"text":"望着长城内外挺立的～，我常常想起在顽敌面前坚贞不屈的伟大战士王若飞。","book":"杨植霖《王若飞在狱中·再版后记》"},"usage":"作宾语、定语；用于书面语"},{"id":38511,"word":"苍狗白云","pinyin":"cāng gǒu bái yún","abbr":"cgby","explanation":"比喻事物变幻无常。同“苍狗白衣”。","source":{"text":"春花秋月销磨尽，苍狗白云变态中，游丝万丈飘无定。","book":"清·文康《儿女英雄传》第三十八回"},"similar":["苍狗白衣"],"usage":"作宾语、定语；比喻世事变化无常"},{"id":38512,"word":"苍狗白衣","pinyin":"cāng gǒu bái yī","abbr":"cgby","explanation":"同白衣苍狗，比喻世事变化无常。","source":{"text":"苍狗白衣俱昨梦，长庚孤月自青天。","book":"宋·杨万里《送乡人余文明劝之以归》诗"},"similar":["白云苍狗"],"usage":"作宾语、定语；比喻世事变化无常"},{"id":38513,"word":"苍生涂炭","pinyin":"cāng shēng tú tàn","abbr":"cstt","explanation":"涂：泥淖。形容老百姓像陷入泥坑、掉进火坑那样痛苦。","source":{"text":"先帝晏驾贼庭，京师鞠为戎穴，神州萧条，生灵涂炭。","book":"《尚书·仲虺之诰》：“有夏昏德，民坠涂炭。”《晋书·苻丕载记》"},"example":{"text":"狼心狗行之辈，滚滚当道，奴颜婢膝之徒，纷纷秉政。以致社稷丘墟，～。","book":"明·罗贯中《三国演义》第九十三回"},"similar":["生灵涂炭"],"opposite":["安居乐业"],"usage":"作宾语、定语；指社会时局"},{"id":38514,"word":"苍白无力","pinyin":"āng bái búi lì","abbr":"cbwl","explanation":"苍白：灰白。形容贫弱无力。","source":{"text":"那拥抱过去的人虽不一定‘苍白无力’，那也不免外强中干。","book":"朱自清《历史的战斗中》"},"example":{"text":"他的这种辩驳显得～。"},"opposite":["掷地有声"],"usage":"作谓语、定语、状语；指人的面貌及论点等"},{"id":38515,"word":"苍翠欲滴","pinyin":"cāng cuì yù dī","abbr":"ccyd","explanation":"苍翠：深绿。形容草木等绿色植物仿佛饱含水份一样。","source":{"text":"春山澹冶而如笑，夏山苍翠而欲滴，秋山明净而如妆，冬山惨淡而如睡。","book":"宋·郭熙《山川训》"},"example":{"text":"在这块地面上，～的树木……一株株一丛丛地生长着。","book":"秦牧《沙面晨眺》"},"similar":["葱翠欲滴"],"usage":"作谓语、定语、补语；形容草木茂盛的样子"},{"id":38516,"word":"苍蝇不抱没缝的蛋","pinyin":"cāng yíng bù bào méi féng de dàn","abbr":"cybbmfdd","explanation":"形容自身不正，坏事才会找到头上。","source":{"text":"‘苍蝇不抱没缝的鸡蛋’，虽然这柳家的没偷，到底有些影儿，人才说他。","book":"清·曹雪芹《红楼梦》第61回"},"opposite":["空穴来风"],"usage":"作宾语、分句；用于口语"},{"id":38517,"word":"苍蝇碰壁","pinyin":"cāng yíng pèng bì","abbr":"cypb","explanation":"比喻坏人走投无路，四处受挫。","source":{"text":"小小寰球，有几个苍蝇碰壁。","book":"毛泽东《满江红·和郭沫若同志》词"},"similar":["四面碰壁"],"usage":"作宾语、定语；用于口语"},{"id":38518,"word":"苍蝇见血","pinyin":"cāng yíng jiàn xuě","abbr":"cyjx","explanation":"苍蝇一见到血，就拼命吮吸。形容极其贪婪","source":{"text":"他两个正是旷夫怨女，相见如饥虎逢羊，苍蝇见血。","book":"明·冯梦龙《喻世明言》第23卷"},"example":{"text":"明·伏雌教主《醋葫芦》第二回：“众和尚得了铜钱，好似～。”"},"similar":["见钱眼开"],"usage":"作宾语、定语；比喻十分贪婪"},{"id":38519,"word":"苍蝇附骥","pinyin":"cāng yíng fù jì","abbr":"cyfj","explanation":"骥：千里马。苍蝇附在千里马的尾巴上，可以很快地到达千里之外。比喻依靠别人的声望而成名。","source":{"text":"苍蝇附骥尾而致千里。","book":"《史记·伯夷列传》：“颜渊虽笃学，附骥尾而行益显。”司马贞索隐"}},{"id":38520,"word":"苍蝇附骥尾","pinyin":"cāng yíng fù jì wěi","abbr":"cyfjw","explanation":"骥：千里马。苍蝇附在千里马的尾巴上，可以很快地到达千里之外。比喻依靠别人的声望而成名。","source":{"text":"苍蝇附骥尾而致千里。","book":"《史记·伯夷列传》：“颜渊虽笃学，附骥尾而行益显。”司马贞索隐"},"usage":"作宾语、定语；用于依附别人出名"},{"id":38521,"word":"苍颜白发","pinyin":"cāng yán bái fà","abbr":"cybf","explanation":"颜：容颜。面容苍老，满头白发。","source":{"text":"苍颜白发，颓然乎其间者，太守醉也。","book":"宋·欧阳修《醉翁亭记》"},"similar":["白发苍苍"],"opposite":["绿鬓少年"],"usage":"作谓语、宾语、定语；用于老年人"},{"id":38522,"word":"苍髯如戟","pinyin":"cāng rán rú jǐ","abbr":"crrj","explanation":"苍：青色；髯：两颊上的胡须。又长又硬的青须好像长戟。形容相貌威猛。","source":{"text":"紫髯如戟冠崔嵬。","book":"唐·李白《司马将军歌》"},"example":{"text":"湖海平生，算不负～。","book":"宋·辛弃疾《满江红·送信守郑舜举被召》"},"similar":["须髯如戟","紫髯如戟"],"opposite":["白面书生"],"usage":"作谓语、定语；形容男子相貌威猛"},{"id":38523,"word":"苍黄反复","pinyin":"cāng huáng fǎn fù","abbr":"chff","explanation":"苍：青色。反复：颠过来倒过去。青的一会儿变成黄的，黄的一会变成青的。比喻变化不定，反复无常。亦作“苍黄翻复”。"},{"id":38524,"word":"苍黄翻复","pinyin":"cāng huáng fān fù","abbr":"chff","explanation":"苍：青色。比喻变化不定，反复无常。","source":{"text":"岂期终始参差，苍黄翻复。泪翟子之悲，恸朱公之哭。","book":"《墨子·所染》：“见染丝者而叹曰：‘染于苍则苍，染于黄则黄。’”南朝·齐·孔稚珪《北山移文》"}},{"id":38525,"word":"苍黄翻覆","pinyin":"cāng huáng fān fù","abbr":"chff","explanation":"苍：青色；苍黄：青色和黄色；反覆：反复无常。比喻变化不定，反复无常。","source":{"text":"见染丝者而叹曰：‘染于苍则苍，染于黄则黄。’","book":"春秋·鲁·墨翟《墨子·所染》"},"example":{"text":"岂期终始参差，～。泪翟子之悲，恸朱公之哭。","book":"南朝·齐·孔稚珪《北山移文》"},"similar":["反复无常"],"usage":"作谓语、定语；指反复无常"},{"id":38526,"word":"苏武牧羊","pinyin":"sū wǔ mù yáng","abbr":"swmy","explanation":"苏武：汉朝时人。苏武宁死不屈情愿牧羊也不投降匈奴。","source":{"text":"他取笔就画了一幅苏武牧羊，画了又要我题。","book":"清·吴趼人《二十年目睹之怪现状》第38回"},"example":{"text":"我们要学～的精神。"},"usage":"作宾语、定语；指人有气节","story":["西汉时期，汉武帝派大臣苏武等为使者出使西域同匈奴单于修好，由于汉朝降将鍭侯王的反叛，单于大怒，扣押了苏武等人，劝其投降。苏武宁死不屈，坚决不降，被迫沦为匈奴的奴隶在茫茫草原上放羊，19年后才回到汉朝"]},{"id":38527,"word":"苏海韩潮","pinyin":"sū hǎi hán cháo","abbr":"shhc","explanation":"指唐朝韩愈和宋朝苏轼的文章气势磅礴，如海如潮。","source":{"text":"蚤岁清词，吐出班香宋艳；中年浩气，流出苏海韩潮。","book":"清·孔尚任《桃花扇·听稗》"},"usage":"作宾语、定语；用于文章的风格"},{"id":38528,"word":"苗而不秀","pinyin":"miáo ér bù xiù","abbr":"mebx","explanation":"苗：指庄稼出苗；秀：庄稼吐穗开花。指庄稼出了苗而没有抽穗。比喻人有好的资质，却没有成就。","source":{"text":"苗而不秀者有矣夫！秀而不实者有矣夫！","book":"《论语·子罕》"},"example":{"text":"如果把我们栽种在阴暗偏陬，那就染上官气暮气，～。","book":"郭沫若《玉簪花》"},"opposite":["开花结果"],"usage":"作谓语、定语；指没有成就就不幸夭折"},{"id":38529,"word":"苛捐杂税","pinyin":"kē juān zá shuì","abbr":"kjzs","explanation":"苛：苛刻、繁重；杂：繁杂。指反动统治下苛刻繁重的捐税。","source":{"text":"在整个经济危机之下，在严重的苛捐杂税之下，在卑劣的利诱腐化之下，成本提高了，购买力减低了。","book":"郭沫若《天地玄黄·拙劣的犯罪》"},"example":{"text":"没完没了的～不算，还他妈的乱抢乱夺。","book":"郭澄清《大刀记》第二章"},"similar":["敲骨吸髓","敲诈勒索","横征暴敛"],"usage":"作主语、宾语、定语；指苛刻繁重的捐税"},{"id":38530,"word":"苛政猛于虎","pinyin":"kē zhè měng yú hǔ","abbr":"kzmyh","explanation":"政：政治。指残酷压迫剥削人民的政治比老虎还要可怕。","source":{"text":"夫子曰：‘何为不去也？’曰：‘无苛政。’夫子曰：‘小子识之，苛政猛于虎也。’","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"不觉暗暗点头，深服古人‘～’真是不错。","book":"清·刘鹗《老残游记》第六回"},"similar":["苛政猛虎"],"usage":"作谓语、宾语；形容政治的残暴","story":["春秋时期，孔子和他的学生经过泰山边时看到一位妇女在墓旁痛哭，相问之下，得知他的丈夫与儿子都被老虎吃了，这儿没有苛捐杂税才从外地逃到这儿，这个妇女表示情愿被老虎吃了也不愿意去别的地方。孔子感慨地对学生说：“你们看，苛政猛于虎也。"]},{"id":38531,"word":"苛政猛虎","pinyin":"kē zhèng měng hǔ","abbr":"kzmh","explanation":"苛政：残暴地统治。指残酷压迫剥削人民的政策比老虎还要凶恶暴虐。","source":{"text":"军阀盗贼真可恶！苛政猛虎向谁诉？","book":"续范亭《老妇行》"},"similar":["苛政猛于虎"],"usage":"作定语、宾语；形容政治的残暴"},{"id":38532,"word":"苜蓿盘空","pinyin":"mù xū pán kōng","abbr":"mxpk","explanation":"比喻小官吏或私塾教师生活清贫。","source":{"text":"时开元东宫官僚清贫淡，令之以诗自悼，复纪于公署曰：‘朝旭上团团，照见先生盘。盘中何所有？苜蓿长阑干。’","book":"五代·王定保《唐摭言·闽中进士》"},"example":{"text":"女父居官清正，～，初无所蓄。","book":"清·王韬《淞隐漫录·二·徐双芙》"}},{"id":38533,"word":"苞笼万象","pinyin":"bāo lóng wàn xiàng","abbr":"blwx","explanation":"苞：通“包”，包含；笼：收罗；象：形状，样子。包含容纳一切。形容内容丰富，无所不包。","source":{"text":"夫四声者，无响不到，不言不摄，总括三才，苞笼万象。","book":"隋·刘善经《四声论》"},"similar":["包罗万象","无所不包"],"opposite":["空空如也"],"usage":"作谓语、定语；形容无所不有"},{"id":38534,"word":"苞苴公行","pinyin":"bāo jū gōng xíng","abbr":"bjgx","explanation":"苞苴：蒲包，指赠送的礼物，引申为贿赂。指公开行贿。","source":{"text":"苞苴行与？谗夫兴与？","book":"战国·赵·荀况《荀子·大略》"},"similar":["货赂公行"],"usage":"作谓语、宾语；指公开以货财进行行贿"},{"id":38535,"word":"苞苴竿牍","pinyin":"bāo jū gān dú","abbr":"bjgd","explanation":"苞苴：蒲包，指赠送的礼物，引申为贿赂；竿牍：竹简为书，指书信，这里特指请托信。指携着礼物带着书信，去探访人。指行贿请托。","source":{"text":"小夫之知，不离苞苴竿牍。","book":"《庄子·列御寇》"},"usage":"作宾语；指走后门"},{"id":38536,"word":"苞藏祸心","pinyin":"bāo cáng huò xīn","abbr":"bchx","explanation":"苞：通“包”，包藏；祸心：害人之心。心里暗藏着不可告人的坏主意。","source":{"text":"阴怀妒害，苞藏祸心，弗可以承天命。","book":"南朝·宋·范晔《后汉书·皇后纪下·献帝伏皇后》"},"example":{"text":"而遣人纳和，此固～，别营凶计。","book":"宋·范仲淹《除枢密副使召赴阙陈让第三状》"},"similar":["包藏祸心"],"opposite":["菩萨心肠"],"usage":"作谓语、宾语；形容外表不露声色暗中害人"},{"id":38537,"word":"苟且之心","pinyin":"gǒu qiě zhī xīn","abbr":"gqzx","explanation":"苟且：得过且过。指得过且过、只顾眼前思想。亦指想做不正当事情的念头。一般多指男女关系。","source":{"text":"若论狄希陈的心里，见了小珍珠这个风流俊俏的模样……却实在安着苟且之心。","book":"清·西周生《醒世姻缘传》第七十九回"},"example":{"text":"饰～，弃本崇教，其违于形势远矣。","book":"清·章炳麟《〈客帝〉匡谬》"},"usage":"作宾语；一般多指男女关系"},{"id":38538,"word":"苟且偷安","pinyin":"gǒu qiě tōu ān","abbr":"gqta","explanation":"苟且：得过且过；偷安：只图眼前的安逸。只顾眼前的安逸，不顾将来。","source":{"text":"承晏安太平之后，苟且偷安，昧于远图，政令日弛，法度日隳。","book":"宋·汪应辰《文定集·廷试策》"},"example":{"text":"做大员的这样～，做属吏的又是那般逢迎得意。","book":"清·张春帆《宦海》第二十回"},"similar":["苟且偷生","得过且过","因循苟且"],"opposite":["发愤图强","高瞻远瞩"],"usage":"作谓语、宾语、定语；指只顾眼前的安逸"},{"id":38539,"word":"苟且偷生","pinyin":"gǒu qiě tōu shēng","abbr":"gqts","explanation":"苟且：得过且过；偷生：苟且地活着。得过且过，勉强活着。","source":{"text":"今夫偷生浅知之属，曾比而不知也。","book":"《荀子·荣辱》"},"example":{"text":"但他知道，那种高官厚禄、那种的～，是比死还要可怕。","book":"郭沫若《屈原》第一幕"},"similar":["苟全性命","苟延残喘","因循苟且"],"opposite":["宁死不屈","视死如归","铮铮铁骨"],"usage":"作谓语、宾语、定语；指只顾眼前的利益"},{"id":38540,"word":"苟且因循","pinyin":"gǒu qiě yīn xún","abbr":"gqyx","explanation":"苟且：得过且过；因循：沿袭。得过且过地混日子。","source":{"text":"愿监苟且因循之弊，明诏大臣，为之以渐，斯合于当世之变。","book":"《宋史·王安石传》"},"example":{"text":"郭沫若《羽书集·把精神武装起来》：“更加以清朝三百年的无理的统制，养成了一种～的习惯，毫无积极进取的精神。”"},"similar":["因循苟且"],"usage":"作谓语、宾语、定语；指不会变通"},{"id":38541,"word":"苟且行止","pinyin":"gǒu qiě xíng zhǐ","abbr":"gqxz","explanation":"苟且：不正当的。指不正当的行为。","example":{"text":"对于你们的～，我们要加以批判。"},"usage":"作宾语、定语；多指男女关系"},{"id":38542,"word":"苟全性命","pinyin":"gǒu quán xìng mìng","abbr":"gqxm","explanation":"苟：苟且，姑且。苟且保全性命。","source":{"text":"苟全性命于乱世，不求闻达于诸侯。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"并建豪英，获际不冤之世；～，颇思当痛之时。","book":"宋·陈亮《谢胡参政启》"},"similar":["苟且偷生"],"usage":"作谓语、宾语；指保全性命"},{"id":38543,"word":"苟合取容","pinyin":"gǒu hé qǔ ān","abbr":"ghqr","explanation":"苟合：苟且附合；取容：取悦，讨好。苟且迎合，取悦于人。","source":{"text":"四者无一遂，苟合取容，无所短长之效，可见于此矣。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"趣尚高远，不为～于世。","book":"宋·无名氏《宣和书谱·行书六》"},"opposite":["刚正不阿"],"usage":"作谓语、定语；指讨好人"},{"id":38544,"word":"苟安一隅","pinyin":"gǒu ān yī yú","abbr":"gayy","explanation":"苟安：暂且偷生；一隅：一个角落。指一个小地方。暂且在一个小地方偷安。指统治者对外来侵略不进行抵抗。占据一个小地方以偷安。","source":{"text":"方今奸臣弄权，专主和议；朝廷听信奸言，希图苟安一隅，无用兵之志。","book":"清·钱彩《说岳全传》第59回"},"example":{"text":"我只好～，等待时机。"},"similar":["苟且偷安"],"usage":"作谓语；指偷生"},{"id":38545,"word":"苟容曲从","pinyin":"gǒu róng qū cóng","abbr":"grqc","explanation":"苟：苟且，姑且；容：容身；曲：委曲；从：顺从。苟且容身，委曲顺从。比喻不分是非曲直，完全听命于权势者。","source":{"text":"以苟容曲从为贤，以拱默尸禄为智。","book":"《汉书·鲍宣传》"}},{"id":38546,"word":"苟延一息","pinyin":"gǒu yán yī xī","abbr":"gyyx","explanation":"还剩下一口气。指仅存的生命。","source":{"text":"一则忍耻偷生，苟延一息，冀乐昌破镜，再得重圆。","book":"清·纪昀《阅微草堂笔记·槐西杂志二》"},"similar":["苟延残息","苟延残喘","苟留残喘"],"usage":"作谓语、定语；指勉强维持"},{"id":38547,"word":"苟延残喘","pinyin":"gǒu yán cán chuǎn","abbr":"gycc","explanation":"苟：暂且，勉强；延：延续；残喘：临死前的喘息。勉强延续临死前的喘息。比喻暂时勉强维持生存。","source":{"text":"今日之事，何不使我得早处囊中，以苟延残喘乎？","book":"宋·欧阳修《与韩忠献王》：“遽来居颖，苟存残喘，承赐恤问，敢此勉述。”明·马中锡《中山狼传》"},"example":{"text":"穷得当卖全无，虽只区区四金，到也不无小补，又可以～得好几日了。","book":"清·李宝嘉《官场现形记》第二十八回"},"similar":["苟且偷生","苟全性命"],"opposite":["宁死不屈","视死如归"],"usage":"作谓语、定语；指勉强维持","story":["春秋时期，晋国大夫赵简子在中山举行狩猎，遇到一只狼就拼命追赶。狼遇到东郭先生说：“先生能借你的口袋让我苟延残喘躲一会，躲过这场灾难，我会报答你的大恩的。”东郭先生帮助了狼。后来狼安全跳出布袋扑向东郭先生咬去"]},{"id":38548,"word":"苟延残息","pinyin":"gǒu yán cán xī","abbr":"gycx","explanation":"苟延：苟且延续；残息：临死前残存的喘息。指勉强维持生命。","source":{"text":"方敢冒昧，今虽苟延残息，终是不堪异日使令。","book":"宋·朱熹《乞追还待制职名……》"},"similar":["苟延残喘","苟延一息"],"usage":"作谓语、定语；指勉强维持生存"},{"id":38549,"word":"苟留残喘","pinyin":"gǒu liú cán chuǎn","abbr":"glcc","explanation":"苟：苟且，勉强；残喘：临死前的喘息。勉强拖延一口没断的气。比喻勉强维持生存。","source":{"text":"奴家自把细米皮糠逼逻吃，苟留残喘。","book":"元·高明《琵琶记·蔡婆埋冤五娘》"},"similar":["苟延残喘","苟延残息","苟延一息"],"usage":"作谓语、定语；指勉强维持"},{"id":38550,"word":"若不胜衣","pinyin":"ruò bù shèng yī","abbr":"rbsy","explanation":"形容身体羸弱，好像连衣服的重量都不能承担。","source":{"text":"周公事文王也，行无专制，事无由己，身若不胜衣，言若不出口，有奉持于文王，洞洞属属，而将不能，恐失之，可谓能子矣。","book":"《淮南子·氾论》"},"example":{"text":"[丽者]瘦怯凝寒，～。","book":"清·蒲松龄《聊斋志异·连琐》"},"similar":["如不胜衣"],"usage":"作谓语、定语；指人衰弱"},{"id":38551,"word":"若丧考妣","pinyin":"ruò sàng kǎo bǐ","abbr":"rskb","explanation":"丧：死去；考：父亲；妣：母亲。好像死了父母一样地伤心。","source":{"text":"享国六十，殂落而崩。四海伤怀，擗踊拊心，若丧考妣，遏密八音。","book":"汉·扬雄《元后诔》"},"example":{"text":"单是提倡新式标点，就会有一大群人“～”。","book":"鲁迅《且介亭杂文·忆刘半农君》"},"similar":["如丧考妣"],"usage":"作谓语、定语、状语；指极度悲伤"},{"id":38552,"word":"若出一轨","pinyin":"ruò chū yī guǐ","abbr":"rcyg","explanation":"像出自同一个车辙。比喻两种事物非常相似。","source":{"text":"嘉靖之季，以诗名者有后七子，李王为之冠，与前七子隔绝数十年，而此唱彼和，声应气求，若出一轨。","book":"清·陈田《序》"},"similar":["若出一辙","如出一辙"],"usage":"作谓语、宾语、定语；用于言论和行动"},{"id":38553,"word":"若出一辙","pinyin":"ruò chū yī zhé","abbr":"rcyz","explanation":"辙：车轮碾轧的痕迹。好像出自同一个车辙。比喻两件事情非常相似。","source":{"text":"盖其相两朝，再罢相，乃累洪氏二兄弟，先后若出一辙，可笑如此。","book":"宋·岳珂《桯史·汤岐公罢相》"},"example":{"text":"窃钩者死，卖国者荣，古今～，字号原无二家：新者旧，旧者新，良有以也。","book":"老舍《痰迷新格》"},"similar":["如出一辙","若出一轨"],"usage":"作谓语、宾语、定语；用于言论和行动"},{"id":38554,"word":"若即若离","pinyin":"ruò jì ruò lí","abbr":"rjrl","explanation":"若：好像；即：接近。好像接近，又好象不接近。①形容对人保持一定距离。②形容事物含混不清。","source":{"text":"后生在后边跟随，若即若离，并不言语。","book":"姚雪垠《李自成》第二卷第十六章"},"example":{"text":"他的书虽然和《了凡纲鉴》也有些相合，但大段又很不相同，～，令人不知道讲起来应该怎样拉在一处。","book":"鲁迅《彷徨·高老夫子》"},"similar":["敬而远之","貌合神离","若离若即"],"opposite":["亲密无间","亲如骨肉"],"usage":"作谓语、定语、状语；形容态度不明朗"},{"id":38555,"word":"若卵投石","pinyin":"ruò luǎn tóu shí","abbr":"rlts","explanation":"比喻不自量力，必遭失败。同“以卵击石”。","source":{"text":"以桀诈尧，若卵投石，夫何幸之有！","book":"《汉书·刑法志》"},"similar":["以卵击石"],"usage":"作谓语、定语；用于处事"},{"id":38556,"word":"若合符节","pinyin":"ruò hé fú jié","abbr":"rhfj","explanation":"比喻两者完全吻合。","source":{"text":"[舜和文王]得志行乎中国，若合符节。先圣后圣，其揆一也。","book":"《孟子·离娄下》"},"example":{"text":"古圣贤之言，大抵～。盖心，一心也，理，一理也，至当归一，情义无二。","book":"宋·陆九渊《与曾宅之书》"},"usage":"作谓语、定语；用于书面语"},{"id":38557,"word":"若存若亡","pinyin":"ruò cún ruò wáng","abbr":"rcrw","explanation":"有时记在心里，有时则忘记掉。用以形容若有若无，难以捉摸。","source":{"text":"上士闻道，勤而行之；中士闻道，若存若亡；下士闻道，大笑之。","book":"春秋·楚·李耳《老子》"},"example":{"text":"后世人天路隔，心量浅隘，上世之事，～矣。","book":"明·李贽《史纲评要·三皇五帝纪·人皇氏》"},"similar":["若有若无"],"usage":"作谓语、定语、状语；指难以捉摸"},{"id":38558,"word":"若崩厥角","pinyin":"ruò bēng jué jiǎo","abbr":"rbjj","explanation":"①像野兽折了头角一样。比喻危惧不安的样子。②叩头的声响像山崩一样。形容十分恭敬的样子。","source":{"text":"言民畏纣之虐，危惧不安，若崩摧其角，无所容头。","book":"《书·泰誓中》：“百姓懔懔，若崩厥角。”孔传"},"example":{"text":"王曰‘无畏！宁尔也，非敌百姓也。’～稽首。","book":"《孟子·尽心下》"},"usage":"作谓语、定语；用于书面语"},{"id":38559,"word":"若张火伞","pinyin":"ruò zhāng huǒ sǎn","abbr":"rzhs","explanation":"张：展开；火伞：比喻夏天太阳酷烈。形容夏天烈日当空，十分炎热。","source":{"text":"光华闪壁见神鬼，赫赫炎官张火伞。","book":"唐·韩愈《游青龙寺赠崔太补阙》诗"},"example":{"text":"今夏天气，酷热异常，赤日当空，～，几于铄石流金。（清·王韬《淞隐漫录·冯佩伯》）"}},{"id":38560,"word":"若敖之鬼","pinyin":"ruò áo zhī guǐ","abbr":"razg","explanation":"若敖：指春秋时楚国的若敖氏。若敖氏的鬼将因灭宗而无人祭祀。比喻没有后代，无人祭祀。","source":{"text":"鬼犹求食，若敖氏之鬼，不其馁尔？","book":"《左传·宣公四年》"},"example":{"text":"后其子冶游骄纵，竟破其家，流离寄食，～遂馁。","book":"清·纪昀《阅微草堂笔记·滦阳续录二》"},"usage":"作宾语；用于书面语","story":["春秋时期，楚国若敖家族子文、子良兄弟均做官。司马子良生了个很凶猛的儿子斗越椒，令尹子文不喜欢这孩子，说他有狼子野心会灭了全族。后来斗越椒做了司马，他杀死堂兄子扬继任令尹，暗中扩军反叛，被楚王打败，灭了若敖全族"]},{"id":38561,"word":"若敖鬼馁","pinyin":"ruò áo guǐ něi","abbr":"ragn","explanation":"若敖：指春秋时楚国的若敖氏；馁：饿。若敖氏的鬼受饿了。比喻没有后代，无人祭祀。","source":{"text":"若敖氏之鬼，不其馁尔？","book":"《左传·宣公四年》"},"usage":"作宾语、定语；指没有后代","story":["春秋时期，楚国若敖家族子文、子良兄弟均做官。司马子良生了个很凶猛的儿子斗越椒，令尹子文不喜欢这孩子，说他有狼子野心会灭了全族。后来斗越椒做了司马，他杀死堂兄子扬继任令尹，暗中扩军反叛，被楚王打败，灭了若敖全族"]},{"id":38562,"word":"若无其事","pinyin":"ruò wú qí shì","abbr":"rwqs","explanation":"象没有那回事一样。形容遇事沉着镇定或不把事情放在心上。","source":{"text":"统领听不见，庄大老爷也听不见，就作为如无其事，不去提他了。","book":"清·李宝嘉《官场现形记》第十八回"},"example":{"text":"王柬芝～地闩上门，又叫她点着灯，他那双眼睛四处巡视着。","book":"冯德英《苦菜花》第三章"},"similar":["不动声色","泰然自若"],"opposite":["六神无主","张皇失措"],"usage":"作谓语、定语、状语；指人的态度"},{"id":38563,"word":"若明若昧","pinyin":"ruò míng ruò mèi","abbr":"rmrm","explanation":"比喻对情况的了解或对问题的认识不清楚。同“若明若暗”。","source":{"text":"此等若明若昧之论，作记者无由知之。","book":"清·俞正燮《癸巳类稿·以畜寡人义》"},"similar":["若明若暗"],"opposite":["一目了然"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":38564,"word":"若明若暗","pinyin":"ruò míng ruò àn","abbr":"rmra","explanation":"好像明亮，又好像昏暗。比喻对情况的了解或对问题的认识不清楚。","source":{"text":"单凭主观热情去工作，对于中国今天的面目若明若暗。","book":"毛泽东《改造我们的学习》"},"example":{"text":"这洞穴幽深莫测，云雾缭绕，由杨汝章领头，潜行数百步，越走越亮，一缕～的光从洞顶直射下来。","book":"《国宝》"},"similar":["若有若无","或隐或现"],"opposite":["一目了然","水落石出"],"usage":"作谓语、定语、状语；用于人或事物"},{"id":38565,"word":"若昧平生","pinyin":"ruò mèi píng shēng","abbr":"rmps","explanation":"平生：平素，往常。指过去好像不熟悉，现在突然恍悟。","source":{"text":"予自少时读班史，今六七十年，何啻百遍，用朱点句，亦须十本，初不记忆高帝之祖称丰公，比再阅之，恍然若昧平生，聊表见于此。","book":"宋·洪迈《容斋四笔·汉高帝祖称丰公》"}},{"id":38566,"word":"若有所丧","pinyin":"ruò yǒu suǒ sàng","abbr":"ryss","explanation":"若：好像。好像丢了什么似的。形容心神不定的样子。也形容心里感到空虚。","source":{"text":"解车休马，罢酒彻乐，而心忽然若有所丧，怅然若有所亡也。","book":"《淮南子·原道训》"},"similar":["若有所亡","若有所失"],"usage":"作谓语、宾语、补语；用于人的神态"},{"id":38567,"word":"若有所亡","pinyin":"ruò yǒu suǒ wáng","abbr":"rysw","explanation":"若：好像。好象丢了什么似的。形容心神不定的样子。也形容心里感到空虚。同“若有所丧”。","source":{"text":"解车休马，罢酒彻乐，而心忽然若有所丧，怅然若有所亡也。","book":"《淮南子·原道训》"},"similar":["若有所失","若有所丧"],"usage":"作定语；指心神不定"},{"id":38568,"word":"若有所失","pinyin":"ruò yǒu suǒ shī","abbr":"ryss","explanation":"好像丢了什么似的。形容心神不定的样子。也形容心里感到空虚。","source":{"text":"生邑邑若有所失，忘啜废枕，日渐委悴。","book":"清·蒲松龄《聊斋志异·黄九郎》"},"example":{"text":"他整天必事重重，～。"},"similar":["惘然若失","忐忑不安"],"opposite":["若无其事","不动声色"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":38569,"word":"若有所思","pinyin":"ruò yǒu suǒ sī","abbr":"ryss","explanation":"若：好像。好像在思考着什么。","source":{"text":"玉妃茫然退立，若有所思。","book":"唐·陈鸿《长恨传》"},"example":{"text":"月光下，他默默地站在太湖石旁，～。"},"similar":["神思恍惚","心潮起伏"],"opposite":["不假思索"],"usage":"作谓语、定语、状语；形容表情"},{"id":38570,"word":"若有若无","pinyin":"ruò yǒu ruò wú","abbr":"ryrw","explanation":"形容事物不清晰或关系不亲密。","source":{"text":"若有若无，半真半幻，最足以悦人心目而豁人性灵。真天地间一妙境也。","book":"明·洪应明《菜根谭·闲适》"},"example":{"text":"她很清楚，他对她早已～，不放在心上了。","book":"沙汀《淘金记》八"},"usage":"作谓语、定语；用于书面语"},{"id":38571,"word":"若涉渊冰","pinyin":"ruò shè yuān bīng","abbr":"rsyb","explanation":"比喻处境艰险。同“若涉渊水”。","source":{"text":"朕承太上皇亮付托之重，念国家之深耻，志在复雠，八年于兹，若涉渊冰，未知攸济。","book":"宋·陈亮《论励臣之道》"},"similar":["若涉渊水"],"usage":"作谓语、定语；用于比喻句"},{"id":38572,"word":"若涉渊水","pinyin":"ruò shè yuān shuǐ","abbr":"rsys","explanation":"比喻处境艰险。","source":{"text":"予惟小子，若涉渊水，予惟往求腾攸济。","book":"《书·大诰》"},"example":{"text":"永思厥艰，～，非君攸济，朕无任焉。","book":"汉·潘勖《册魏公九锡文》"},"similar":["若涉渊冰"],"usage":"作谓语、定语；用于比喻句"},{"id":38573,"word":"若烹小鲜","pinyin":"ruò pēng xiǎo xiān","abbr":"rpxx","explanation":"意为治理大国要像煮小鱼一样。煮小鱼，不能多加搅动，多搅则易烂，比喻治大国应当无为。后常用来比喻轻而易举。","source":{"text":"治大国而数变法，则民苦之。是以有道之君贵静，不重变法。故曰：‘治大国者若烹小鲜。’","book":"《老子》：“治大国，若烹小鲜。”《韩非子·解老》"},"example":{"text":"夫百姓，鱼兽之类也，上德治之，～，与天地同操也。","book":"汉·王充《论衡·自然》"},"similar":["如烹小鲜"],"usage":"作谓语、定语；用于比喻句"},{"id":38574,"word":"若离若即","pinyin":"ruò lí ruò jí","abbr":"rlrj","explanation":"形容对人保持一定距离。同“若即若离”。","source":{"text":"大抵总宪戆直凌人，岳岳觥觥，朝士必多未满，而与和相若离若即，又未尝不稍敛其锋棱，一时众口诋諆，遂有师相门生之谤。","book":"清·陈康祺《郎潜纪闻》卷十"},"similar":["若即若离"],"usage":"作谓语、定语、状语；形容态度不明朗"},{"id":38575,"word":"若要不知，除非莫为","pinyin":"ruò yào bù zhī，chú fēi mò wéi","abbr":"rybzcfmw","explanation":"要想人家不知道，除非自己不去做。指干了坏事终究要暴露。","source":{"text":"自古道：‘若要不知，除非莫为。’","book":"明·冯梦龙《喻世明言》第21卷"},"similar":["若要人不知，除非己莫为"],"usage":"作宾语、分句；指干了坏事终究要暴露"},{"id":38576,"word":"若要人不知，除非己莫为","pinyin":"ruò yào rén bù zhī，chú fēi jǐ mò wéi","abbr":"ryrbzcfjmw","explanation":"要想人家不知道，除非自己不去做。指干了坏事终究要暴露。","source":{"text":"欲人勿闻，莫若勿言；欲人勿知，莫若勿为。","book":"汉·枚乘《上书谏吴王》"},"example":{"text":"却不道是～。","book":"明·冯梦龙《醒世恒言·勘皮靴单证二郎神》"},"similar":["若要不知，除非莫为"],"usage":"作宾语、分句；指干了坏事终究要暴露"},{"id":38577,"word":"若要好，问三老","pinyin":"ruò yào hǎo，wèn sān lǎo","abbr":"ryhwsl","explanation":"如果想办好事情，就要先请教几位有经验的老人。","source":{"text":"常言道：若要好，问三老。俺与您去寻着三个老的问他，道是该吃也不该吃。","book":"明·康海《中山狼》第三折"}},{"id":38578,"word":"若释重负","pinyin":"ruò shì zhòng fù","abbr":"rszf","explanation":"形容紧张心情过去以后的的轻松愉快。同“如释重负”。","source":{"text":"宜依前典，趋上尊号，若释重负，感泰兼怀。","book":"《旧唐书·高祖纪》"},"example":{"text":"除了‘惋惜’以外，还带点‘何苦来’的意味。不，甚至也还带着‘麻烦的日子终于也过完了’的～的意思。","book":"茅盾《第一阶段的故事》十一"},"similar":["如释重负"],"usage":"作谓语、宾语、状语；指消除紧张的心情"},{"id":38579,"word":"若隐若显","pinyin":"ruò yǐn ruò xiǎn","abbr":"ryrx","explanation":"若：好像；隐：隐藏；显：显现。好像隐藏不露，又好像显现出来。形容隐隐约约，看不清楚的样子。","source":{"text":"作《风烟欲雨图》，非阴非霁，如梅天雾晓，霏微暗霭之状，殊有深思，使他人想象于微茫之间，若隐若显，不能穷也。","book":"宋·赵佶《宣和画谱·山水三》"}},{"id":38580,"word":"若隐若现","pinyin":"ruò yǐn ruò xiàn","abbr":"ryrx","explanation":"若：好像；隐：隐藏；现：显现。好像隐藏不露，又好像显现出来。形容隐隐约约，看不清楚的样子。","source":{"text":"伸着头往外张望，见两盏红灯，若隐若现。","book":"明·冯梦龙《醒世恒言》卷五"},"example":{"text":"李惊，方将诘问，则见其～，恍惚如烟雾，宛转间已登榻。","book":"清·蒲松龄《聊斋志异·珠儿》"},"similar":["若有若无","隐约可见"],"opposite":["一目了然","黑白分明"],"usage":"作谓语、定语、状语；形容记忆模糊"},{"id":38581,"word":"苦不可言","pinyin":"kǔ bù kě yán","abbr":"kbky","explanation":"痛苦或困苦到了极点，已经不能用言语来表达。","source":{"text":"晚年得恶疾，须眉堕落，鼻梁断坏，苦不可言。","book":"宋·李昌龄《乐善录·刘贡父》"},"example":{"text":"不料一时大旱起来，饥荒疫病，一齐发作，百姓苦不可言。","book":"清·古吴墨浪子《西湖佳话·六桥才迹》"},"similar":["苦不堪言"],"opposite":["无比欢欣"],"usage":"作谓语、定语；指十分痛苦"},{"id":38582,"word":"苦不堪言","pinyin":"kǔ bù kān yán","abbr":"kbky","explanation":"堪：能。痛苦或困苦到了极点，已经不能用言语来表达。","source":{"text":"晚年得恶疾，须眉堕落，鼻梁断坏，苦不可言。","book":"宋·李昌龄《刘贡父》"},"example":{"text":"他受的磨难真是～。"},"similar":["苦不可言","痛苦不堪"],"opposite":["喜之不尽","无比欢欣"],"usage":"作谓语、宾语；形容十分痛哭"},{"id":38583,"word":"苦不聊生","pinyin":"kǔ bù liáo shēng","abbr":"kbls","explanation":"聊生：赖以维持生活。形容备受痛苦，无法生存。","source":{"text":"丁男被甲，丁女转输，苦不聊生，自经于道树，死者相望。","book":"东汉·班固《汉书·严安传》"},"usage":"作谓语、定语；用于十分艰难生存"},{"id":38584,"word":"苦中作乐","pinyin":"kǔ zhōng zuò lè","abbr":"kzzl","explanation":"在困苦中勉强自寻欢乐。","source":{"text":"宰运：‘吾辈可谓忙里偷闲，苦中作乐。’","book":"宋·陈造《同陈宰黄簿游灵山八首》自注"},"example":{"text":"此第三首，则俗所谓～也。言山行之可畏若此，而于其中强寻乐处，则亦有可喜者。","book":"清·无名氏《杜诗言志》卷十"},"similar":["强颜欢笑","自得其乐"],"usage":"作谓语、宾语、定语；指在困苦中自寻欢乐"},{"id":38585,"word":"苦乐不均","pinyin":"kǔ lè bù jūn","abbr":"klbj","explanation":"均：平均。同样的人享受的待遇却不相同。形容待遇不相等。","source":{"text":"苦乐不均，羊少狼多，复有蚕食，此之为弊久矣。","book":"《魏书·太武五王列传》"},"example":{"text":"初年摊之一甲一里，次年摊之二甲二里，各年差徭多寡不等，即里甲认派～。","book":"《清史稿·食货志二》"},"usage":"作谓语；形容待遇不相同"},{"id":38586,"word":"苦乐之境","pinyin":"kǔ lè zhī jìng","abbr":"klzj","explanation":"境：境地。痛苦与欢乐的境界。","source":{"text":"并驰于苦乐之境，皆入于生死之门。","book":"北魏·温子升《定国寺碑》"},"usage":"作主语、宾语；用于人的生存环境"},{"id":38587,"word":"苦争恶战","pinyin":"kǔ zhēng è zhàn","abbr":"kzez","explanation":"形容艰苦的征伐。","source":{"text":"某姓秦名琼字叔宝，立唐以来，苦征恶战，累建功勋。","book":"明·无名氏《庆赏端阳》第一折"},"similar":["苦征恶战"],"usage":"作主语、宾语、定语；用于战争"},{"id":38588,"word":"苦口之药","pinyin":"kǔ kǒu zhī yào","abbr":"kkzy","explanation":"苦口：口味苦。有疗效的药往往味苦难吃。比喻尖锐的批评，听起来觉得不舒服，但对改正错误很有好处。","source":{"text":"夫良药苦口，惟疾者能甘之；忠言逆耳，惟达者能受之。","book":"晋·陈寿《三国志·吴志·孙奋传》"},"example":{"text":"初年摊之一甲一里，次年摊之二甲二里，各年差徭多寡不等，即里甲认派～。","book":"《清史稿·食货志二》"},"similar":["良药苦口"],"usage":"作主语、宾语、分句；用于规劝"},{"id":38589,"word":"苦口婆心","pinyin":"kǔ kǒu pó xīn","abbr":"kkpx","explanation":"苦口：反复规劝；婆心：仁慈的心肠。比喻善意而又耐心地劝导。","source":{"text":"问：‘学人根思迟回，乞师曲运慈悲，开一线道。’师曰：‘这个是老婆心。’","book":"《宋史·赵普传》：“忠言苦口，三复来奏。”宋·释道原《景德传灯录·泉州道匡禅师》"},"example":{"text":"我和龙济光～的谈了十几点钟。","book":"清·梁启超《护国之役回顾谈》"},"similar":["苦口相劝","语重心长"],"opposite":["口蜜腹剑"],"usage":"作定语、状语；指真诚的劝诫","story":["春秋时期，孔子带领弟子周游列国碰壁后，在冉求的帮助下，终于回到了鲁国，他与季康子是不相为谋。于是专心著述，编辑整理《诗》《书》《礼》《乐》《春秋》，回顾一生，周游列国，游说君王，苦口婆心，结果是四处碰壁，穷困潦倒"]},{"id":38590,"word":"苦口恶石","pinyin":"kǔ kǒu è shí","abbr":"kkes","explanation":"石：古代石针。比喻逆耳而有益的规劝。","source":{"text":"美疢不如恶石：夫石犹生我，疢之美，其毒滋多。","book":"春秋·鲁·左丘明《左传·襄公二十三年》"},"example":{"text":"～，想勿余隐。","book":"《周书·萧疍传》"},"usage":"作宾语、定语；用于比喻句"},{"id":38591,"word":"苦口良药","pinyin":"kǔ kǒu liáng yào","abbr":"kkly","explanation":"好药往往味苦难吃。比喻衷心的劝告，尖锐的批评，听起来觉得不舒服，但对改正缺点错误很有好处。","source":{"text":"良药苦于口而利于病，忠言逆于耳而利于行。","book":"《孔子家语·六本》"}},{"id":38592,"word":"苦口逆耳","pinyin":"kǔ kǒu nì ěr","abbr":"kkne","explanation":"苦口：药吃起来特别苦；逆耳：听起来使人感到不舒服。形容真诚的规劝。","source":{"text":"忠言逆耳利于行，毒药苦口利于病。","book":"西汉·司马迁《史记·留侯世家》"},"example":{"text":"妄有讥刺，虽～，不得事实，且优游宽容。","book":"南朝·宋·范晔《后汉书·陈宠传》"},"similar":["忠言逆耳"],"usage":"作谓语、定语；指真诚的劝诫"},{"id":38593,"word":"苦大仇深","pinyin":"kǔ dà chóu shēn","abbr":"kdcs","explanation":"形容受尽剥削压迫的苦，有很大的仇恨。","source":{"text":"在山路上，二柱很少讲话，冯均却摸到他一点～的家底。","book":"陈残云《山谷风烟》第四章"},"example":{"text":"他对地主阶级是～。"},"similar":["深仇大恨","饱经风霜"],"opposite":["养尊处优"],"usage":"作谓语、定语；指有很大的仇恨"},{"id":38594,"word":"苦学力文","pinyin":"kǔ xué lì wén","abbr":"kxlw","explanation":"力：努力；文：著文。用功学习，努力写作。","source":{"text":"即壮而肤革不丰盈，未老而齿发早衰白，蓦然为飞蝇垂珠在眸子中者，动以万数。盖苦学力文所致。","book":"《旧唐书·白居易传》"},"usage":"作宾语、定语；用于学习"},{"id":38595,"word":"苦尽甘来","pinyin":"kǔ jìn gān lái","abbr":"kjgl","explanation":"甘：甜，比喻幸福。艰难的日子过完，美好的日子来到了。","source":{"text":"忘餐废寝舒心害，若不是真心耐，志诚捱，怎能勾这相思苦尽甘来。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"更不想你生下这猴子，又得岳丈为我报仇。真是～，莫大之喜。","book":"明·吴承恩《西游记》第九回"},"similar":["否极泰来","时来运转","雨过天晴"],"opposite":["乐极生悲"],"usage":"作谓语、定语；指好日子来临"},{"id":38596,"word":"苦尽甜来","pinyin":"kǔ jìn tián lái","abbr":"kjtl","explanation":"艰难的日子过完，美好的日子来到了。","source":{"text":"忘餐废寝舒心害，若不是真心耐，志诚捱，怎能勾这相思苦尽甘来。","book":"元·王实甫《西厢记》第四本第一折"},"example":{"text":"贫遭富欺，不道富有贫日，贫有富时。～，泰生否极，只道常如是。","book":"明·胡文焕《群音类选·金印记·婆婆夺绢》"},"similar":["苦尽甘来"],"usage":"作谓语、定语；同“苦尽甘来”"},{"id":38597,"word":"苦征恶战","pinyin":"kǔ zhēng è zhàn","abbr":"kzez","explanation":"艰苦的征战。","source":{"text":"某姓秦名琼自叔宝，立唐以来，苦征恶战，累建功勋。","book":"明·无名氏《庆赏端阳》第一折"},"similar":["苦争恶战"],"usage":"作主语、宾语、定语；用于战争"},{"id":38598,"word":"苦心孤诣","pinyin":"kǔ xīn gū yì","abbr":"kxgy","explanation":"指苦心钻研，到了别人所达不到的地步。也指为寻求解决问题的办法而煞费苦心。","source":{"text":"今且勿以意匠之独运者言之，且勿以苦心孤诣戛戛独造者言之，公且以效古之作若规仿格调者言之。","book":"清·翁方纲《复初斋文集·格调论下》"},"example":{"text":"～地运动着做了一次大总统，后来被人赶跑了，跑向天津。","book":"郭沫若《革命春秋·创造十年》"},"similar":["费尽心机","苦心经营","惨淡经营"],"usage":"作宾语、定语、状语；指尽心刻苦钻研"},{"id":38599,"word":"苦心极力","pinyin":"kǔ xīn jí lì","abbr":"kxjl","explanation":"费尽心机，使出了全部力量。","source":{"text":"夫秦日夜深惟，苦心竭力，以除六国之忧。","book":"汉·贾谊《新书·权重》"},"example":{"text":"为文操笔立成，藻思赡蔚，统计不紊，有～所不到者。","book":"宋·陆九渊《黄公墓志铭》"},"similar":["苦心竭力"],"usage":"作谓语、状语；用于处事"},{"id":38600,"word":"苦心焦思","pinyin":"kǔ xīn jiāo sī","abbr":"kxjs","explanation":"焦：焦急。形容人为某事忧心苦思。","source":{"text":"吴既赦越，越王勾践反国，乃苦身焦思，置胆于坐，坐卧即仰胆，饮食亦尝胆也。","book":"《史记·越王勾践世家》"},"example":{"text":"圣君难逢，重德宜报，～，以日继夜。","book":"唐·韩愈《为裴相公让官表》"},"similar":["苦思焦虑","苦心焦虑"],"usage":"作谓语、定语；用于处事"},{"id":38601,"word":"苦心焦虑","pinyin":"kǔ xīn jiāo lǜ","abbr":"kxjl","explanation":"形容用尽心思，想方设法。","source":{"text":"经过三番五次的苦心焦虑，仍然找不到完全满意的解决途径。","book":"欧阳山《三家巷》"},"similar":["苦心焦思"],"usage":"作谓语、定语；用于处事"},{"id":38602,"word":"苦心积虑","pinyin":"kǔ xīn jī lǜ","abbr":"kxjl","explanation":"积虑：长期地或一再地思考。指费尽心思长期的思考问题。","source":{"text":"孙奇逢谓其苦心积虑，阅历深而动忍孰。","book":"《清史稿·文苑传·申涵光》"},"similar":["苦心焦思"],"usage":"作谓语；指冥思苦想"},{"id":38603,"word":"苦心竭力","pinyin":"kǔ xīn jié lì","abbr":"kxjl","explanation":"费尽心机，使出了全部力量。","source":{"text":"夫秦日夜深惟，苦心竭力，以除六国之忧。","book":"汉·贾谊《新书·权重》"},"similar":["苦心极力"],"usage":"作谓语、状语；用于处事"},{"id":38604,"word":"苦心经营","pinyin":"kǔ xīn jīng yíng","abbr":"kxjy","explanation":"经营：筹划，管理。用尽心思去筹划安排。","source":{"text":"但专制政体不除，任凭你君相恁地苦心经营，民力是断不能发达的。","book":"梁启超《新中国未来记》第四回"},"example":{"text":"我们～这个公司十年了。"},"similar":["费尽心机","苦心孤诣","惨淡经营"],"opposite":["撒手不管"],"usage":"作谓语、定语；用于军事、商业等"},{"id":38605,"word":"苦思冥想","pinyin":"kǔ sī míng xiǎng","abbr":"ksmx","explanation":"尽心地思索和想象。","source":{"text":"我拿起笔从来不苦思冥想，我照例写得快，说我‘粗制滥造’也可以，反正有作品在。","book":"巴金《创作回忆录·关于二》"},"example":{"text":"设计人员在搞设计之前，不只是埋头翻资料，或者捧着脑袋～，而是跟着余师傅上沸腾的建筑工地?","book":"《人民文学》1976年第5期"},"similar":["冥思苦想","绞尽脑汁"],"usage":"作谓语、定语；指尽心地思索和想象"},{"id":38606,"word":"苦思恶想","pinyin":"kǔ sī è xiǎng","abbr":"ksex","explanation":"绞尽脑汁，深沉地思索。","source":{"text":"彼此争强赌胜，用尽心机，苦思恶想，愈出愈奇，必要出人头地。","book":"清·李汝珍《镜花缘》第三十二回"},"similar":["苦思冥想"],"usage":"作谓语、宾语；用于人仔细思考"},{"id":38607,"word":"苦打成招","pinyin":"kǔ dǎ chéng zhāo","abbr":"kdcz","explanation":"严刑拷打，迫使无罪的人冤枉招认。","source":{"text":"凶犯逃走了，他没了法子，还常拿不相干的人来苦打成招，硬派他是凶手。","book":"清·吴沃尧《九命奇冤》第30回"},"similar":["屈打成招"],"usage":"作谓语、宾语、状语；用于断案"},{"id":38608,"word":"苦海无涯","pinyin":"kǔ hǎi wú yá","abbr":"khwy","explanation":"苦海：比喻极困苦的环境。佛家语，形容深重无比的苦难。","source":{"text":"苦海无涯，生灭甚时彻。","book":"金·长筌子《百宝妆》词"},"similar":["苦海无边","无边苦海"],"usage":"作主语、宾语、定语；用于安慰人"},{"id":38609,"word":"苦海无边","pinyin":"kǔ hǎi wú biān","abbr":"khwb","explanation":"原为佛家语，形容深重无比的苦难。常和“回头是岸”连用。","source":{"text":"苦海无边，爱河无底，流浪看成百漏船。","book":"宋·陆游《大圣乐》词"},"example":{"text":"世俗人没来由，争长竞短，你死我活。有呵吃些个，有呵穿些个。～，回头是岸。","book":"元·无名氏《度翠柳》第一折"},"similar":["苦不堪言","回头是岸"],"opposite":["欢乐无涯","欢天喜地"],"usage":"作主语、宾语；常与“回头是岸”连用"},{"id":38610,"word":"苦海无边，回头是岸","pinyin":"kǔ hǎi wú biān，huí tóu shì àn","abbr":"khwbhtsa","explanation":"佛教语。意指尘世如同苦海，无边无际，只有悟道，才能获得超脱。亦以比喻罪恶虽重，只要悔改，便有出路。","source":{"text":"知得心放，此心便在这里，更何用求？适见道人题壁云：‘苦海无边，回头是岸。’说得极好。","book":"宋·朱熹《朱子语类》卷五十九"},"example":{"text":"传情寄恨万千番，藕丝断，情难断，～。","book":"明·李开先《朝天子·为王渼陂口占》曲"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":38611,"word":"苦海茫茫","pinyin":"kǔ hǎi máng máng","abbr":"khmm","explanation":"苦海：苦难深重如海；茫茫：辽阔深远的样子。无穷无尽的苦难。","source":{"text":"嗟见南山尘，积年为丘山。芒芒苦海中，生死成波澜。","book":"宋·张君房《云笈七签》卷六十六"},"example":{"text":"～，深可悲伤。","book":"金·王处《行香子·劝徐老奉善》"},"similar":["苦海无边"],"usage":"作主语、宾语；指无穷无尽的苦难"},{"id":38612,"word":"苦绷苦拽","pinyin":"kǔ bēng kǔ yè","abbr":"kbkz","explanation":"绷：拉紧；拽：用力拉。苦苦地东拉西扯，凑集钱财。","source":{"text":"向日那些旧朋友，还道是昔日的晃大舍，苦绷苦拽，或当借了银钱，或损折了器服，买了礼，都来与晃大舍接风。","book":"清·西周生《醒世姻缘传》第一回"},"similar":["东拉西扯"],"usage":"作谓语；用于筹资等"},{"id":38613,"word":"苦肉计","pinyin":"kǔ ròu jì","abbr":"krj","explanation":"故意伤害自己的肉体以骗取敌方信任的计策。","source":{"text":"亏杀那苦肉计黄盖添粮草。","book":"元·关汉卿《单刀会》第一折"},"example":{"text":"今日痛打黄盖，乃计也。吾欲令他诈降，先须用～瞒过曹操，就中用火攻之，可以取胜。","book":"明·罗贯中《三国演义》第四十六回"},"usage":"作宾语、定语；用于欺骗对方","story":["隋朝时期，杨坚谋位成功，封杨广为晋王。杨广心中不服，一心想当太子，就找安州总管宇文述商议。宇文述知道独孤皇后妒心重，就给杨广出主意，让他回宫用苦肉计博得皇后的同情。这一计很灵，皇后鼓动皇上，废太子而另立杨广"]},{"id":38614,"word":"苦药利病","pinyin":"kǔ yào lì bìng","abbr":"kylb","explanation":"良药苦口对病有好处。比喻严厉的劝诫或批评有利于人的进步。","source":{"text":"古人云，苦药利病。","book":"汉·袁康《越绝书·越绝计倪内经》"},"similar":["良药苦口利于病"],"usage":"作宾语、定语；用于劝诫人"},{"id":38615,"word":"苦行僧","pinyin":"kǔ xíng sēng","abbr":"kxs","explanation":"苦行：某些宗教徒的修炼手段，用常人难以忍受的痛苦来磨炼自己。指出家修行的人。现用来形容放弃正当物质享受，一味苦行的人。"},{"id":38616,"word":"苦行赎罪","pinyin":"kǔ xíng shú zuì","abbr":"kxsz","explanation":"执行忏悔神父所要求的苦行以补偿罪行。","example":{"text":"她对上帝忏悔，希望能够～。"},"usage":"作宾语、定语；指忏悔"},{"id":38617,"word":"苦言药，甘言疾","pinyin":"kǔ yán yào，gān yán jí","abbr":"kyygyj","explanation":"古时谚语。逆耳的话如同苦口的良药，动听的话如同害人的病毒。","source":{"text":"语有之矣，貌言华也，至言实也，苦言药也，甘言疾也。","book":"《史记·商君列传》"}},{"id":38618,"word":"苦语软言","pinyin":"kǔ yǔ ruǎn yán","abbr":"kyry","explanation":"苦语：逆耳的忠言；软言：委婉的话。指善意规劝人的各种话语。","source":{"text":"苦语软言，随方弘训。","book":"南朝·梁·刘孝绰《栖隐寺碑》"},"usage":"作主语、宾语、定语；用于劝人的言语"},{"id":38619,"word":"苦身焦思","pinyin":"kǔ shēn jiāo sī","abbr":"ksjs","explanation":"焦：焦急。形容人为某事忧心苦思。","source":{"text":"吴既赦越，越王勾践反国，乃苦身焦思，置胆于坐，坐卧即仰胆，饮食亦尝胆也。","book":"《史记·越王勾践世家》"},"example":{"text":"况今天子神圣威武，～，缩衣节食，以养战士，此志岂须臾忘天下哉！","book":"《资治通鉴·唐纪·元和十三年》"},"similar":["焦思苦想"],"usage":"作谓语；用于人"},{"id":38620,"word":"苦难深重","pinyin":"kǔ nàn shēn zhòng","abbr":"knsz","explanation":"遭受的痛苦和灾难既深又重。","source":{"text":"苦难深重的农民，怎能再忍受反动派的蹂躏。","book":"罗广斌、杨益言《红岩》第四章"},"example":{"text":"他过惯了～的生活。"},"similar":["苦海茫茫"],"usage":"作定语；指受苦难很大"},{"id":38621,"word":"苦雨凄风","pinyin":"kǔ yǔ qī fēng","abbr":"kyqf","explanation":"苦雨：久下成灾的雨；凄风：寒冷的风。形容天气恶劣。后用来比喻境遇悲惨凄凉。","source":{"text":"春无凄风，秋无苦雨。","book":"《左传·昭公四年》"},"example":{"text":"黄昏长夜，捱了多少～；春昼秋霄，受了多少魂惊目断。","book":"清·禇人获《隋唐演义》第二十八回"},"similar":["凄风苦雨"],"opposite":["和风细雨"],"usage":"作宾语、定语；指凄苦悲凉"},{"id":38622,"word":"苫眼铺眉","pinyin":"shān yǎn pū méi","abbr":"sypm","explanation":"瞪眼晴，竖眉毛。形容装模作样地摆架子。","source":{"text":"常记着礼之用和为贵，到那里则要你折腰叉手，休学那苫眼铺眉。","book":"元·秦简夫《剪发待宾》第三折"},"example":{"text":"怎受的小儿曹出乖弄丑，～，迎奸卖俏，点醋尝醯。","book":"明·康海《王兰卿》第三折"},"usage":"作谓语、宾语、定语；指摆架子"},{"id":38623,"word":"英俊豪杰","pinyin":"yīng jùn háo jié","abbr":"yjhj","explanation":"英武俊秀且有才能、有作为的人。","source":{"text":"英俊豪杰，各以小大之材处其位，得其宜。","book":"《淮南子·泰族训》"}},{"id":38624,"word":"英勇不屈","pinyin":"yīng yǒng bù qū","abbr":"yybq","explanation":"屈：屈服。勇敢出众，不屈不挠。","source":{"text":"各地都有大批先进分子不怕他们的白色恐怖，同他们进行了英勇不屈的斗争。","book":"邓小平《工人阶级要为实现四个现代化作出优异贡献》"},"usage":"作谓语、定语、状语；用于人很勇敢坚强"},{"id":38625,"word":"英勇善战","pinyin":"yīng yǒng shàn zhàn","abbr":"yysz","explanation":"十分勇敢而且善于作战。","source":{"text":"这说明我们军队的传统是好的，是英勇善战的。","book":"邓小平《军队整顿的任务》"},"similar":["骁勇善战"],"usage":"作谓语、宾语；用于夸奖人"},{"id":38626,"word":"英勇顽强","pinyin":"yīng yǒng wán qiáng","abbr":"yywq","explanation":"勇敢出众，强硬不屈。","source":{"text":"则是在他们面前表示中国军队和中国人民不可屈服的精神和英勇顽强的战斗力，这就是给以歼灭战的打击。","book":"毛泽东《论持久战》"},"example":{"text":"王朔《给我顶住》：“你还得机智灵活，～，屡战屡败，屡败屡战。”"},"usage":"作谓语、定语、状语；用于做事"},{"id":38627,"word":"英华外发","pinyin":"yīng huá wài fā","abbr":"yhwf","explanation":"英华：美好的才华。美好才能表现出来。","source":{"text":"是故情深而文明，气盛而化神。和顺积中而英华外发。","book":"《礼记·乐记》"},"example":{"text":"灼灼明两，作离承圣。～，温文成性。","book":"南朝·梁·萧子云《胤雅》"}},{"id":38628,"word":"英声欺人","pinyin":"yīng shēng qī rén","abbr":"ysqr","explanation":"指非凡人物逞才欺世。","source":{"text":"太白纵横，往往强弩之末，间杂长语，英声欺人耳。","book":"明·李攀龙《〈唐诗选〉序》"},"example":{"text":"总观他的历史题材的剧本，都是针对当时政治形势，有的放矢，不拘泥于历史事实，而随意发挥，虽云自我作古，却非～。","book":"茅盾《化悲痛为力量》"}},{"id":38629,"word":"英声茂实","pinyin":"yīng shēng mào shí","abbr":"ysms","explanation":"指美名和盛业。","source":{"text":"盛业洪基，同天地之长久；英声茂实，齐日月之照临。","book":"《隋书·于宣敏传》"},"example":{"text":"惟公～，腾于朝著，敬服敬服。","book":"明·张居正《答承天守备枢使王涵斋书》"},"usage":"作宾语、定语；用于书面语"},{"id":38630,"word":"英姿勃勃","pinyin":"yīng zī bó bó","abbr":"yzbb","explanation":"英俊而富有朝气的样子。","source":{"text":"这时，我看见躺在病床上的青年人，他的面颊烧黑了，头发烧焦了，可是从他向上扬着的短短眉毛上，还显露出一种英姿勃勃的神气。","book":"刘白羽《火》"},"example":{"text":"十个～的姑娘，像十只带火比翼的彩燕。","book":"林玉《带火的彩燕》诗"},"similar":["英姿勃发"],"usage":"作谓语、定语；指人的精神面貌"},{"id":38631,"word":"英姿勃发","pinyin":"yīng zī bó fā","abbr":"yzbf","explanation":"英勇威武，神采四溢","source":{"text":"现在的画面上舍弃了两棵大黄桷树，把柏树从小改大，使其英姿勃发，昂首挺立。","book":"赖少其《序》"},"similar":["英姿勃勃","英姿焕发"],"usage":"作谓语、定语；用于书面语"},{"id":38632,"word":"英姿焕发","pinyin":"yīng zī huàn fā","abbr":"yzhf","explanation":"英姿：英勇威武姿态；焕发：光彩四射。形容英俊威武的样子。","source":{"text":"遥想公瑾当年，小乔出嫁了，雄姿英发。","book":"宋·苏轼《念妈娇·赤壁怀古》词"},"similar":["英姿勃发"],"usage":"作谓语、定语；形容人威武"},{"id":38633,"word":"英姿迈往","pinyin":"yīng zī mài wǎng","abbr":"yzmw","explanation":"英俊威武，超逸非凡。","source":{"text":"某人英姿迈往，隽辩绝伦，早集布金之园，久造笑云之室。","book":"宋·陆游《乡士请妙相讲主疏》"},"similar":["英特迈往"],"usage":"作谓语、定语；用于书面语"},{"id":38634,"word":"英姿飒爽","pinyin":"yīng zī sà shuǎng","abbr":"yzss","explanation":"英姿：英勇威武的姿态；飒爽：豪迈矫健。形容英俊威武、精神焕发的样子。","source":{"text":"褒公鄂公毛发动，英姿飒爽来酣战。","book":"唐·杜甫《丹青引赠曹将军霸》"},"example":{"text":"～战酣来，梦里神交一噱开。","book":"元·王恽《秋涧全集·张九元帅哀辞》"},"similar":["英姿焕发","英姿勃勃","意气风发"],"opposite":["獐头鼠目"],"usage":"作定语、宾语、补语、状语；形容人"},{"id":38635,"word":"英才大略","pinyin":"yīng cái dà lüè","abbr":"ycdl","explanation":"非常杰出的才智和谋略。","source":{"text":"如武帝之雄材大略，不改文、景之恭俭以济斯民，虽《诗》、《书》所称，何有加焉？","book":"《汉书·武帝纪赞》"},"example":{"text":"塔思，一名查剌温，幼与常儿异，～，绰有祖风。","book":"《元史·木华黎传》"}},{"id":38636,"word":"英才盖世","pinyin":"yīng cái gài shì","abbr":"ycgs","explanation":"才：才能；盖世：压倒当世，超出世上所有的。形容超出当代、无与伦比的才能。","source":{"text":"田横，齐之壮士耳，犹守义不辱，况刘豫州王室之胄，英才盖世，众士仰慕，若水之归海，若事之不济，此乃天也，安能复为之下乎！","book":"《三国志·蜀志·诸葛亮传》"}},{"id":38637,"word":"英明果断","pinyin":"yīng míng guǒ duàn","abbr":"ymgd","explanation":"思想出色明智，做事果敢。","example":{"text":"他是一个～的领导。"},"opposite":["狐疑不决"],"usage":"作谓语、定语；指决策等"},{"id":38638,"word":"英特迈往","pinyin":"yīng tè mài wǎng","abbr":"ytmw","explanation":"英俊威武，超逸非凡。","source":{"text":"英特迈往，不屑于流俗；声色利达之习，介然无毫毛得以入于其心；洁白之操，寒于冰霜，公之质也。","book":"宋·陆九渊《荆国王文公祠堂记》"},"similar":["英姿迈往"],"usage":"作谓语、定语；用于书面语"},{"id":38639,"word":"英英玉立","pinyin":"yīng yīng yù lì","abbr":"yyyl","explanation":"仪态俊美的样子。","source":{"text":"适才会见令表叔，才知尊大人已谢宾客，使我不胜伤感。今见世兄如此英英玉立，可称嗣续有人，又要破涕为笑。","book":"《儒林外史》第十回"},"usage":"作谓语、定语、状语；用于书面语"},{"id":38640,"word":"英雄入彀","pinyin":"yīng xióng rù gòu","abbr":"yxrg","explanation":"入彀：指进入弓箭的射程以内，比喻就范。天下英雄均已就范。","source":{"text":"尝私幸端门，见新进士缀行而出，喜曰：‘天下英雄入我彀中矣。’","book":"五代·王定保《唐摭言》卷一"},"example":{"text":"英雄尽入彀，帝王心始快。","book":"清·黄遵宪《杂感》诗"},"usage":"作宾语、定语；指网络人才"},{"id":38641,"word":"英雄出少年","pinyin":"yīng xióng chū shào nián","abbr":"yxcsn","explanation":"杰出的人物大都从年轻人中产生。","source":{"text":"黄大军机道：‘英雄出少年，将来老兄一定要发达的。’","book":"清·吴敬梓《儒林外史》第七回：“果然英雄出少年，到省试高高中了。”清·李宝嘉《官场现形记》第二十五回"},"example":{"text":"当真～，老头儿不中用啦。","book":"金庸《神雕侠侣》第二十三回"}},{"id":38642,"word":"英雄好汉","pinyin":"yīng xióng hǎo hàn","abbr":"yxhh","explanation":"非凡出众的人物。指见解、才能超群出众或领袖群众的人。","source":{"text":"它向全世界宣告，红军是英雄好汉，帝国主义者和他们的走狗蒋介石等辈则是完全无用的。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"你算什么～？"},"similar":["英雄豪杰","好汉英雄"],"usage":"作主语、宾语、定语；用于口语"},{"id":38643,"word":"英雄所见略同","pinyin":"yīng xióng suǒ jiàn lüè tóng","abbr":"yxsjlt","explanation":"所见：所见到的，指见解；略：大略，大致。英雄人物的见解基本相同同。这是对意见相同的双方表示赞美的话。","source":{"text":"天下智谋之士所见略同耳。","book":"《三国志·蜀志·庞统传》裴松之注引《江表传》"},"example":{"text":"你们听这番议论，倒不谋而合的。～，可见这里头是有这么一个道理。","book":"清·曾朴《孽海花》第十一回"},"similar":["所见略同"],"opposite":["针锋相对"],"usage":"作宾语；对意见相同的双方表示赞美的话"},{"id":38644,"word":"英雄无用武之地","pinyin":"yīng xióng wú yòng wǔ zhī dì","abbr":"yxwywzd","explanation":"比喻有才能却没地方或机会施展。","source":{"text":"英雄无用武之地，故豫州遁逃至此。","book":"《资治通鉴·汉纪·献帝建安十三年》"},"example":{"text":"齐先生之所以～，岂不是当时腐败的社会所造成的吗？","book":"沙叶新《陈毅市长》"},"similar":["怀才不遇"],"opposite":["大展宏图"],"usage":"作宾语；指怀才不遇","story":["公元208年，曹操率大军南征荆州，刘琮投降曹操，刘备不忍心拿下荆州就只好去东吴联合孙权。诸葛亮在柴桑劝说孙权，说刘备考虑同刘表的关系才落得英雄无用武之地。他希望孙权能够与联合起来共同对付曹操"]},{"id":38645,"word":"英雄无觅孙仲谋处","pinyin":"yīng xióng wú mì sūn zhòng móu chù","abbr":"yxwmszmc","explanation":"觅：寻找；孙仲谋：孙权。无处寻找出英雄孙仲谋那样的人了","source":{"text":"千古江山，英雄无觅孙仲谋处。","book":"宋·辛弃疾《永遇乐·京口北固亭怀古》"},"usage":"作宾语、定语、分句；用于感慨等"},{"id":38646,"word":"英雄本色","pinyin":"yīng xióng běn sè","abbr":"yxbs","explanation":"英雄：杰出的人才。杰出人物的本来面貌。多指杰出的人物必然有非凡的行为、举动。","source":{"text":"四公子道：‘这才是英雄本色。’","book":"明·方汝浩《禅真逸史》第三十四回：“段韶道：‘元帅所言，正是英雄本色，但要用心莫作等闲，挫动锐气。’”清·吴敬梓《儒林外史》第十二回"},"example":{"text":"母舅虽系绿林聚义，山寨生涯，然须保善锄强，不愧～。","book":"清·吴璿《飞龙全传》第二十五回"},"usage":"作宾语、定语；用于书面语"},{"id":38647,"word":"英雄欺人","pinyin":"yīng xióng qī rén","abbr":"yxqr","explanation":"拿杰出人物的名声和气势吓人。","source":{"text":"唐无五言古诗，陈子昂以其古诗为古诗，弗取也。七言古诗，唯杜子美不失初唐气格，而纵横有之。太白纵横，往往强弩之末，间杂长语，英雄欺人耳。","book":"明·李攀龙《选唐诗序》"},"example":{"text":"左季高常有～的举动，不便明言而已。","book":"高阳《慈禧全传》六十三"},"usage":"作宾语、定语；用于书面语"},{"id":38648,"word":"英雄气短","pinyin":"yīng xióng qì duǎn","abbr":"yxqd","explanation":"气短：志气沮丧。指有才能的人因遭受困厄或沉迷于爱情而丧失进取心。","source":{"text":"伤秋赋寂寥，多病成迤逗。吹笛谁家，惹得双眉斗，英雄气短偏憔瘦。","book":"明·陈汝元《金莲记·量移》"},"example":{"text":"倘若有冒功等事，岂不使～，谁肯替国家出力！（清·钱彩《说岳全传》第二十三回）"},"similar":["儿女情长"],"usage":"作宾语；指沉迷于爱情"},{"id":38649,"word":"英雄短气","pinyin":"yīng xióng duǎn qì","abbr":"yxdq","explanation":"短气：志气沮丧。指有才能的人因遭受困厄或沉迷于爱情而丧失进取心。","source":{"text":"仁兄青年男子，天下何事不可为，莫只管做些儿女态，令英雄短气！","book":"明·明教中人《好逑传》第一回"},"example":{"text":"他自己想到不违性情上头，就未免觉得儿女伤心，～。","book":"清·文康《儿女英雄传》第四十回"},"similar":["英雄气短"],"usage":"作宾语、定语；用于书面语"},{"id":38650,"word":"英雄豪杰","pinyin":"yīng xióng háo jié","abbr":"yxhj","explanation":"指才能超众或勇武超群的人。","source":{"text":"如今秦王功盖天下，四海扬名，英雄豪杰，莫不归附。","book":"明·方汝浩《禅真逸史》第四十回"},"example":{"text":"自古～，不经心志之拂乱，未必能奋发有为，故敌国外患之来，实磨砺英豪之一块试金石也。","book":"蔡东藩《清史演义》第二回"},"similar":["豪杰英雄"],"usage":"作主语、宾语、定语；指杰出人物"},{"id":38651,"word":"英雄辈出","pinyin":"yīng xóng bèi chū","abbr":"yxbc","explanation":"英雄层出不穷。","example":{"text":"《青梅煮酒》三国时期 ，是一个～的年代。"}},{"id":38652,"word":"英雄闲日月","pinyin":"yīng xióng xián rì yuè","abbr":"yxxry","explanation":"闲：大。英雄人物心胸如日月般宽广。形容杰出人物胸怀广大。"},{"id":38653,"word":"英雄难过美人关","pinyin":"yīng xióng nán guò měi rén guān","abbr":"yxngmrg","explanation":"指英雄人物往往因迷恋女色而失去斗志，身败名裂。","source":{"text":"第一是要考一考自己，都说‘英雄难过美人关’，倒要看看自己闯不闯得过这一关？","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"自古道：～，你能抗拒吗？"},"usage":"作宾语、定语、分句；指难拒美色"},{"id":38654,"word":"英风亮节","pinyin":"yīng fēng liàng jié","abbr":"yflj","explanation":"高尚的风格和节操。","source":{"text":"可钦可敬的周总理，英风亮节堪师表。","book":"毛錡《悼念周恩来总理》诗"},"similar":["高风亮节"],"usage":"作宾语、定语；用于书面语"},{"id":38655,"word":"苶然沮丧","pinyin":"niè rán jǔ sàng","abbr":"nrjs","explanation":"苶然：疲惫的样子。形容意志消沉颓废。","source":{"text":"素暴悍者，欲其观古人之小心黜己，齿弊舌存，含垢藏疾，尊贤容众，苶然沮丧，若不胜衣也。","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":38656,"word":"茁壮成长","pinyin":"zhuó zhuàng chéng zhǎng","abbr":"zzcz","explanation":"健康地成长。","example":{"text":"看到下一代健康活泼地～，为人父母者无不感到十分欣慰。"},"usage":"作谓语、定语；用于书面语"},{"id":38657,"word":"茁茁壮壮","pinyin":"zhuó zhuó zhuàng zhuàng","abbr":"zzzz","explanation":"肥大壮实，成长壮大。","source":{"text":"孩子们一个个都懂事明理，长得茁茁壮壮的。","book":"路遥《平凡的世界》第一卷第六章"},"usage":"作定语、状语；用于人或事物"},{"id":38658,"word":"茂实英声","pinyin":"mào shí yīng shēng","abbr":"msys","explanation":"茂：茂盛之实，指实际；英：英华之声，指名声。称颂人的声名事业日盛。","source":{"text":"俾万世得激清流，扬微波，蜚英声，腾茂实。","book":"《史记·司马相如列传》"},"example":{"text":"洪规盛范，冠绝百王；～，方垂千载。","book":"《梁书·徐勉传》"}},{"id":38659,"word":"茂林修竹","pinyin":"mào lín xiū zhú","abbr":"mlxz","explanation":"修：长。茂密高大的树林竹林。","source":{"text":"此地有崇山峻岭，茂林修竹。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"刚过了小桥曲水，又见些～。","book":"清·李汝珍《镜花缘》第七十二回"},"similar":["茂林深篁"],"usage":"作宾语、定语；指茂密高大的树林竹丛"},{"id":38660,"word":"茂林深篁","pinyin":"mào lín shēn huáng","abbr":"mlsh","explanation":"深篁：丛生的竹林。茂密高大的树林竹丛。","source":{"text":"此地有崇山峻岭，茂林修竹。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"虎丘山绝岩耸壑，～，为江左丘壑之表。","book":"清·顾虔《吴地江》"},"similar":["茂林修竹"],"usage":"作宾语、定语；指茂密高大的树林竹丛"},{"id":38661,"word":"范张鸡黍","pinyin":"fàn zhāng jī shǔ","abbr":"fzjs","explanation":"范：范式；张：张劭；鸡：禽类；黍：草本植物，指黍子。范式、张劭一起喝酒食鸡。比喻朋友之间含义与深情。","source":{"text":"范式字巨卿……与汝南张劭为友。劭字元伯。二人并告归乡里。……乃共克期日。后期方至，元伯具以白母，请设馔以候之。","book":"《后汉书·范式传》载"},"example":{"text":"季鹰千里莼鲈兴，更喜～。","book":"元·白朴《摸鱼儿》"},"usage":"作宾语、定语；用于朋友","story":["东汉时期，山阳金乡的范式与汝南张劭是京城洛阳太学里的同学，关系特别要好，毕业后范式约定两年后的9月15日去张劭家拜访，转眼约期已到，张劭杀鸡煮黍准备待客，果然十分守信的范式走了几百里地登门拜访，让张家感动不已"]},{"id":38662,"word":"范水模山","pinyin":"fàn shuǐ mó shān","abbr":"fsms","explanation":"比喻效法模仿他人。","source":{"text":"抗心迈古，肆力式靡；吹花嚼蕊，相炫虚华，范水模山，自诧淡远。","book":"清·江顺诒《词学集成》第六卷"},"usage":"作谓语、宾语；指模仿"},{"id":38663,"word":"茅塞顿开","pinyin":"máo sè dùn kāi","abbr":"msdk","explanation":"茅塞：喻人思路闭塞或不懂事；顿：立刻。原来心里好像有茅草堵塞着，现在忽然被打开了。形容思想忽然开窍，立刻明白了某个道理。","source":{"text":"山径之蹊间，介然用之而成路；为间不用，则茅塞之矣。","book":"《孟子·尽心下》"},"example":{"text":"我身无力，我腹无才，得三公之教，～。","book":"明·吴承恩《西游记》第六十四回"},"similar":["恍然大悟"],"opposite":["冥顽不灵"],"usage":"作谓语、定语、状语；指忽然开窍"},{"id":38664,"word":"茅室土阶","pinyin":"máo shì tǔ jiē","abbr":"mstj","explanation":"茅草盖的屋顶，泥土砌的台阶。形容房屋简陋，或生活俭朴。","source":{"text":"扶风掾李育经明行著，教授百人，客居杜陵，茅室土阶。","book":"《后汉书·班固传》"},"similar":["茅茨土阶","土阶茅屋","土阶茅茨"],"opposite":["高楼大厦","楼台亭阁"],"usage":"作宾语、定语；指生活俭朴"},{"id":38665,"word":"茅室蓬户","pinyin":"máo shì péng hù","abbr":"msph","explanation":"茅：茅草；蓬：飞蓬，草名。茅草房子。形容住房极其简陋。","source":{"text":"茅室蓬户，庭草芜径，唯床上有数卷书。","book":"《宋书·孔淳传》"},"similar":["蓬门筚户","茅茨土阶"],"opposite":["雕梁画栋"],"usage":"作宾语、定语；比喻住房简陋"},{"id":38666,"word":"茅封草长","pinyin":"máo fēng cǎo zhǎng","abbr":"mfcz","explanation":"茅：茅草；封：封闭；长：生长。长满茅草。形容野草丛生的荒凉景象。"},{"id":38667,"word":"茅屋土阶","pinyin":"máo wū tǔ jiē","abbr":"mwtj","explanation":"茅草的房屋，泥土的台阶。比喻住房简陋。","source":{"text":"昔尧、舜在上，茅屋土阶，汤、禹为君，藜杖韦带。","book":"《陈书·宣帝纪》"}},{"id":38668,"word":"茅屋草舍","pinyin":"máo wū cǎo shě","abbr":"mwcs","explanation":"用茅草修建的房子。形容住宿条件简陋。","source":{"text":"茅屋草舍，掌柜的不要见笑。","book":"清·石玉昆《三侠五义》第24回"},"usage":"作主语、宾语、定语；用于自谦"},{"id":38669,"word":"茅屋采椽","pinyin":"máo wū cǎi chuán","abbr":"mwcc","explanation":"指住宿简陋。","source":{"text":"尧之王天下也，茅茨不翦，采椽不斫。","book":"《韩非子·五蠹》"},"example":{"text":"墨家者流，盖出清庙之守，～，是以贵俭。","book":"《汉书·艺文志》"},"similar":["茅茨不翦，采椽不斫"],"usage":"作主语、宾语；指住宿简陋"},{"id":38670,"word":"茅庐三顾","pinyin":"máo lú sān gù","abbr":"mlsg","explanation":"刘备为请诸葛亮，三次到草庐中去拜访他。后用此典故表示帝王对臣下的知遇之恩。也比喻诚心诚意地邀请或过访。同“草庐三顾”","source":{"text":"不肯去兰省一朝登北阙，便想这茅庐三顾到南阳。","book":"元·无名氏《醉写赤壁赋》第一折"},"example":{"text":"岂不闻渭水同车，～之事，奈何山川悬阔，有失躬迎之礼。","book":"明·陶宗仪《辍耕录·丘真人》"},"similar":["草庐三顾"],"usage":"作宾语、定语；指求贤","story":["东汉末年，天下大乱，诸葛亮在隆中茅草房，自耕自食，但很有学问，人称“卧龙先生”。徐庶给刘备推荐诸葛亮，刘备和关羽、张飞亲自到卧龙冈拜见诸葛亮，前两次都没见到，第三次终于见到诸葛亮，诚心请诸葛亮出山"]},{"id":38671,"word":"茅茨不翦","pinyin":"máo cí bù jiǎn","abbr":"mcbj","explanation":"茅茨：茅屋；翦：修饰。用茅草覆盖屋顶，而且没有修剪整齐。形容生活简陋俭朴。","source":{"text":"尧之王天下也，茅茨不翦，采椽不斫。","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"～，易层巢于故事。","book":"唐·王勃《益州夫子庙碑》"},"usage":"作谓语、定语；形容生活简陋"},{"id":38672,"word":"茅茨不翦，采椽不斫","pinyin":"máo cì bù jiǎn，cǎi chuán bù zhuó","abbr":"mcbjccbz","explanation":"茅茨：用茅草覆盖的屋；翦：修饰；采椽：用栎木或柞木做椽子；斫：砍削。形容住房质朴简陋。","source":{"text":"尧之王天下也，茅茨不翦，采椽不斫。","book":"《韩非子·五蠹》"},"similar":["茅屋采椽"],"usage":"作宾语、定语；形容生活简陋"},{"id":38673,"word":"茅茨土阶","pinyin":"máo cì tǔ jiē","abbr":"mctj","explanation":"茨：用茅草、芦苇盖的屋顶；阶：台阶。茅草盖的屋顶，泥土砌的台阶。形容房屋简陋，或生活俭朴。","source":{"text":"扶风掾李育经明行著，教授百人，客居杜陵，茅室土阶。","book":"汉·张衡《东京赋》：“慕唐虞之茅茨。思夏后之卑室。”《后汉书·班固传》"},"example":{"text":"昔尧舜在位，～，禹居卑宫，不以为陃。","book":"明·冯梦龙《东周列国志》第三回"},"similar":["茅室土阶","土阶茅屋","土阶茅茨"],"usage":"作宾语、定语；指生活俭朴"},{"id":38674,"word":"茕茕孑立","pinyin":"qióng qióng jié lì","abbr":"qqjl","explanation":"孤身一人。形容一个人无依无靠，孤苦伶仃。","source":{"text":"外无期功强近之亲，内无应门五尺之童。茕茕孑立，形影相吊。","book":"晋·李密《陈情表》"},"example":{"text":"我凑着～的小油灯，尽情享受秋灯夜读的乐趣。","book":"何为《小灯》"},"similar":["孤苦伶仃","举目无亲"],"opposite":["四世同堂","儿孙绕膝"],"usage":"作谓语、定语；指无依无靠","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母及老人。他想启用西蜀尚书郎李密，就下诏书任命他为郎中。李密不愿做官，就写《陈情表》上书晋武帝，说自己的祖母茕茕孑立、形影相吊、相依为命，待终养祖母后再出来做官"]},{"id":38675,"word":"茕茕孑立，形影相吊","pinyin":"qióng qióng jié lì，xíng yǐng xiāng diào","abbr":"qqjlxyxd","explanation":"茕茕：孤独的样子；孑：孤单；形：指身体；吊：慰问。孤身一人，只有和自己的身影相互慰问。形容无依无靠，非常孤单。","source":{"text":"茕茕孑立，形影相吊。","book":"晋·李密《陈情表》"},"example":{"text":"他～，非常可怜。"},"usage":"作谓语、分句；指非常孤单","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母及老人。他想启用西蜀尚书郎李密，就下诏书任命他为郎中。李密不愿做官，就写《陈情表》上书晋武帝，说自己的祖母茕茕孑立、形影相吊、相依为命，待终养祖母后再出来做官"]},{"id":38676,"word":"茕茕孤立","pinyin":"qióng qióng gū lì","abbr":"qqgl","explanation":"茕茕：孤零零的样子。孤身一人。形容一个人无依无靠，孤苦伶仃。","source":{"text":"茕茕孑立，形影相吊。","book":"汉·张衡《思玄赋》：“何孤行之茕茕兮，孑不群而介立。”晋·李密《陈情表》"},"example":{"text":"～，未有子息，荒陬中少士人女子，无与为婚。","book":"唐·柳完元《寄许京兆孟容书》"},"similar":["茕茕孑立"],"usage":"作谓语、定语；指无依无靠"},{"id":38677,"word":"茕茕无依","pinyin":"qióng qióng wú yī","abbr":"qqwy","explanation":"茕茕：孤独的样子。孤身一人，没有依靠。形容无依无靠，非常孤单。","source":{"text":"茕茕孑立，形影相吊。","book":"汉·张衡《思玄赋》：“何孤行之茕茕兮，孑不群而介立。”晋·李密《陈情表》"},"example":{"text":"父病危，隔二千里～，有子不得待，何以立于天地间，儿今日行矣。","book":"清·钱泳《履园丛话·景贤·乡贤二》"}},{"id":38678,"word":"茧丝牛毛","pinyin":"jiǎn sī niú máo","abbr":"jsnm","explanation":"形容功夫细密。","source":{"text":"茧丝牛毛，充栋汗牛，字书之繁也；道听涂说，井蛙瓮鸡，学识之拘也。","book":"明·郎瑛《七修续稿·诗文》"},"example":{"text":"吾兄经术，～，用心如此，不仅当今无与绝尘，即在先儒，亦岂易得！","book":"清·黄宗羲《答万充宗质疑书》"},"similar":["多如牛毛"],"usage":"作宾语、定语；形容细密繁多"},{"id":38679,"word":"茨棘之间","pinyin":"cí jí zhī jiān","abbr":"cjzj","explanation":"茨：茅苇的屋盖；棘：荆棘。形容穷苦人家简陋的住房。","source":{"text":"而清洁之士，徒自苦于茨棘之间，无所益损于风俗也。","book":"汉·仲长统《昌言·理乱》"}},{"id":38680,"word":"茫无头绪","pinyin":"máng wú tóu xù","abbr":"mwtx","explanation":"茫：不清楚，纷乱。一点儿头绪也没有。形容事情摸不着边，不知从哪里入手。","source":{"text":"沈伯英构造极多，最喜以奇事旧闻，不论数种，扭合一家……茫无头绪，尤为可怪。","book":"明·凌濛初《谭曲杂礼》"},"example":{"text":"本驻使与贵总长磋商，已经数次，迁延至一月有余，仍然是～，莫非轻视敝国不成？（蔡东藩、许廑父《民国通俗演义》第四十二回）"},"similar":["茫无端绪"],"opposite":["思绪万千"],"usage":"作谓语；指事情没有线索"},{"id":38681,"word":"茫无定见","pinyin":"máng wú dìng jiàn","abbr":"mwdj","explanation":"形容对事情捉摸不透，因而没有见解和主张。","source":{"text":"阅人一首一句，即侈然评论，并欲概其生平，于是随声附和，茫无定见矣。","book":"清·吴雷发《说诗菅蒯》卷七"},"example":{"text":"乃忽战忽和，忽和忽战，小胜即喜，小败即怯，我之伎俩，早为所窥，犹且首鼠两端，～。","book":"蔡东藩《清史演义》第六十九回"}},{"id":38682,"word":"茫无所知","pinyin":"máng wú suǒ zhī","abbr":"mwsz","explanation":"一点也不知道。","source":{"text":"关于秦代的典章文物，我也茫无所知。","book":"鲁迅《书信集·致姚克》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“也到过上海，跟洋人打过交道，不是～。”"},"similar":["一窍不通"],"usage":"作谓语；指一点也不知道"},{"id":38683,"word":"茫无涯际","pinyin":"máng wú yá jì","abbr":"mwyj","explanation":"辽阔浩渺而无边际。亦作“茫无边际”。","source":{"text":"如今幸而见着心海中的灯塔，虽然只赤光一线，依微隐约，总算能勉强辨得出茫无涯际的前程。","book":"瞿秋白《〈饿乡纪程〉跋》"},"example":{"text":"这是一座孤零零立在大海当中的小岛，四面是～的海水和天空。","book":"郑文光《夜渔记》"},"similar":["茫无边际"],"usage":"作谓语、定语；用于巨大"},{"id":38684,"word":"茫无端绪","pinyin":"máng wú duān xù","abbr":"mwdx","explanation":"毫无头绪，纷乱缺乏条理。","source":{"text":"男子不知何自来，亦无识者，研问邻里，茫无端绪。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"},"example":{"text":"事情还～，不要过早下结论。"},"similar":["茫无头绪"],"opposite":["思绪万千"],"usage":"作谓语；指事情没有线索"},{"id":38685,"word":"茫无边际","pinyin":"máng wú biān jì","abbr":"mwbj","explanation":"辽阔浩渺而无边际。","source":{"text":"钱花光了，没钱买火车票，父亲急得在湖岸上来回转圈，望着茫无边际的湖水发愁。","book":"吴运铎《把一切献给党·在矿井里》"},"similar":["漫无边际"],"usage":"作定语、状语；用于谈话方面"},{"id":38686,"word":"茫然不知所措","pinyin":"máng rán bù zhī suǒ cuò","abbr":"mrbzsc","explanation":"茫然：完全不知道的样子；措：筹划，安排。形容没有主意，不知怎么办才好。","source":{"text":"今以尽心知性知天为格物致知，使初学之士，尚未能不贰其心者。而遽责之以圣人生知安行之事。如捕风捉影，茫然莫知所措。","book":"明·王阳明《传习录·答顾东挢书》"},"example":{"text":"在烟台上了岸，洪钧～。","book":"高阳《状元娘子》十"}},{"id":38687,"word":"茫然不解","pinyin":"máng rán bù jiě","abbr":"mrbj","explanation":"茫然：无所知的样子。一无所知，不理解。","source":{"text":"邵肩齐说及前事，娄朴茫然不解。","book":"清·李绿园《歧路灯》第一○二回"},"example":{"text":"十句不过懂得三句，其余都～。","book":"冯玉祥《我的生活》第六章"},"similar":["茫然费解"],"usage":"作谓语、定语、状语；指不可理解"},{"id":38688,"word":"茫然失措","pinyin":"máng rán shī cuò","abbr":"mrsc","explanation":"心中迷惑，不知怎么办才好。","source":{"text":"种谔在绥德节制诸军，闻夏人至，茫然失措，欲作书召燕达，战怖不能下笔。","book":"《宋史·夏国传》"},"example":{"text":"面对突如其来的变化，我有些～。"},"similar":["茫然若失"],"usage":"作谓语、定语；用于人迷惑时"},{"id":38689,"word":"茫然无知","pinyin":"máng rán wú zhī","abbr":"mrwz","explanation":"茫然：什么也不知道的样子。指对某事物一无所知。","source":{"text":"那刺史官已是知得，帅着合郡父老香烛迎接。直到州堂开读诏书，却是征聘仙人李清。刺史官茫然无知，遂问众父老。","book":"明·冯梦龙《醒世恒言》卷三十八"},"example":{"text":"他们都很明白，皇上对目前中原大局很不清楚，对作战形势更是～。","book":"姚雪垠《李自成》第三卷第十八章"}},{"id":38690,"word":"茫然自失","pinyin":"máng rán zì shī","abbr":"mrzs","explanation":"茫然：失意的样子。形容心中迷惘，自感若有所失。","source":{"text":"颜回北面拜手曰：‘回亦得之矣。’出告子贡，子贡茫然自失。","book":"《庄子·说剑》：“文王芒然自失，曰：‘诸侯之剑如何？’”《列子·仲尼》"},"example":{"text":"值夫人睡觉，呼娉索人参汤。娉惶恐走去，生～，魂魄俱丧。","book":"明·李昌祺《剪灯余话·贾云华还魂记》"},"similar":["芒然自失","爽然自失"],"usage":"作谓语、定语；指不知所以的样子"},{"id":38691,"word":"茫然若失","pinyin":"máng rán ruò shī","abbr":"mrrs","explanation":"茫然：失意的样子；若失：好像失去了东西。形容精神不集中，恍惚，若有所失的样子。","source":{"text":"徐子以告夷子，夷子抚然为间曰：‘命之矣。’集注：‘抚然茫然自失之貌。’","book":"先秦·孟轲《孟子·滕文公上》"},"example":{"text":"他被这个消息弄得～，焦虑不安。","book":"沈西蒙《南征北战》第二章"},"similar":["若有所失"],"usage":"作定语、宾语；形容人的心情"},{"id":38692,"word":"茫然若迷","pinyin":"máng rán ruò mí","abbr":"mrrm","explanation":"迷惑不明白的样子。","source":{"text":"弟前日闻先生正论，因久溺其说，锢蔽已深，竟茫然若迷，莫措一语。","book":"清·夏敬渠《野叟曝言》第六十二回"},"usage":"作谓语、定语；用于迷惑时"},{"id":38693,"word":"茫然莫知所措","pinyin":"máng rán mò zhī suǒ cuò","abbr":"mrmzsc","explanation":"茫然：完全不知道的样子；措：筹划，安排。形容没有主意，不知怎么办才好。","source":{"text":"今以尽心知性知天为格物致知，使初学之士，尚未能不贰其心者。而遽责之以圣人生知安行之事。如捕风捉影，茫然莫知所措。","book":"明·王阳明《传习录·答顾东挢书》"}},{"id":38694,"word":"茫然费解","pinyin":"máng rán fèi jiě","abbr":"mrfj","explanation":"茫然：渺茫，模糊不清。认识不清，不能理解。","source":{"text":"只图讲究古音，总是转弯磨禄，令人茫然费解。","book":"清·李汝珍《镜花缘》第82回"},"similar":["茫然不解"],"usage":"作谓语、定语、状语；指不可理解"},{"id":38695,"word":"茫茫苦海","pinyin":"máng máng kǔ hǎi","abbr":"mmkh","explanation":"茫茫：辽阔深远的样子；苦海：苦难深重如海。无穷无尽的苦难。","source":{"text":"嗟见南山尘，积年为丘山。芒芒苦海中，生死成波澜。","book":"宋·张君房《云笈七签》卷六十六"},"example":{"text":"儿女情深，英雄气短，～，同此病源。","book":"清·蒲松龄《聊斋志异·马介甫》"},"similar":["芒芒苦海","苦海无边"],"usage":"作宾语；指苦难无穷无尽"},{"id":38696,"word":"茫茫荡荡","pinyin":"máng máng dàng dàng","abbr":"mmdd","explanation":"辽阔深远而又模糊不清。","source":{"text":"若说这个石碣村湖荡，紧靠着梁山泊，都是茫茫荡荡，芦苇水港。","book":"明·施耐庵《水浒传》第19回"},"usage":"作定语、状语；用于书面语"},{"id":38697,"word":"茵席之臣","pinyin":"yīn xí zhī chén","abbr":"yxzc","explanation":"茵席：铺垫的东西，褥垫、草席。指侍奉于皇帝左右的近臣。","source":{"text":"公曰：‘请进服裘。’对曰：‘婴非君茵席之臣也，敢辞。’","book":"语出《晏子春秋·内篇·杂上》"}},{"id":38698,"word":"茶余酒后","pinyin":"chá yú jiǔ hòu","abbr":"cyjh","explanation":"泛指休息或空闲的时候。","source":{"text":"茶余饭饱邀故友，谢馆秦楼，散闷消愁。","book":"元·关汉卿《斗鹌鹑·女校尉》曲"},"example":{"text":"他看出他的失慎已经成了～的重要话柄。","book":"沙汀《炮手》"},"similar":["茶余饭后"],"usage":"作定语、宾语；指休闲时间"},{"id":38699,"word":"茶余饭后","pinyin":"chá yú fàn hòu","abbr":"cyfh","explanation":"泛指休息或空闲的时候。","source":{"text":"茶余饭饱邀故友，谢馆秦楼，散闷消愁。","book":"元·关汉卿《斗鹌鹑·女校尉》曲"},"example":{"text":"难道还只当作亭子间“～”谈天的资料吗？","book":"瞿秋白《普洛大众文艺的现实问题》"},"similar":["茶余酒后","茶余饭饱"],"usage":"作主语、宾语、定语；指休闲时间"},{"id":38700,"word":"茶余饭饱","pinyin":"chá yú fàn bǎo","abbr":"cyfb","explanation":"泛指闲暇之时。","source":{"text":"茶余饭饱邀故友，谢馆秦楼，散闷消愁。","book":"元·关汉卿《斗鹤鹊·女校尉》曲"},"example":{"text":"从今后～破工夫，玉镜台前插架书。","book":"明·汤显祖《牡丹亭·训女》"},"similar":["茶余饭后"],"usage":"作主语、宾语、定语；指休闲时间"},{"id":38701,"word":"茶饭无心","pinyin":"chá fàn wú xīn","abbr":"cfwx","explanation":"没有心怀喝茶吃饭。形容心情苦闷。","source":{"text":"忙得凤姐茶饭无心，坐卧不宁。","book":"清·曹雪芹《红楼梦》第十四回"},"example":{"text":"眼看着一分节礼要被人夺去，更是～，坐立不安。","book":"清·李宝嘉《官场现形记》第四十四回"},"similar":["茶饭不思"],"usage":"作状语、补语；指人焦急"},{"id":38702,"word":"茹古涵今","pinyin":"rú gǔ hán jīn","abbr":"rghj","explanation":"犹言博古通今。对古代的事知道得很多，并且通晓现代的事情。形容知识丰富。","source":{"text":"茹古涵今，无有端涯。","book":"唐·皇甫湜《韩文公墓志铭》"},"example":{"text":"其道足以济天下之用，其词足以媲《坟》《典》之宏，～，牢笼百氏。","book":"清·方东树《〈切问斋文钞〉书后》"},"similar":["博古通今"],"usage":"作谓语、宾语；用于书面语"},{"id":38703,"word":"茹柔刚吐","pinyin":"rú róu gāng tǔ","abbr":"rrgt","explanation":"柔：软；刚：硬。吃下软的，吐出硬的。比喻怕强欺软。","source":{"text":"人亦有言，柔则茹之，刚则吐之。","book":"《诗经·大雅·烝民》"}},{"id":38704,"word":"茹柔吐刚","pinyin":"rú róu tǔ gāng","abbr":"rrtg","explanation":"柔：软；刚：硬。吃下软的，吐出硬的。比喻怕强欺软。","source":{"text":"人亦有言，柔则茹之，刚则吐之。","book":"《诗经·大雅·烝民》"},"example":{"text":"梁启超《中俄交涉与时局之危机》：“利用我～之劣根性。”"},"similar":["柔茹刚吐"],"usage":"作谓语、定语；指欺软怕硬"},{"id":38705,"word":"茹毛饮血","pinyin":"rú máo yǐn xuè","abbr":"rmyx","explanation":"茹：吃。用来描绘原始人不会用火，连毛带血地生吃禽兽的生活。","source":{"text":"未有火化，食草木之食，鸟兽之肉，饮其血，茹其毛，未有麻丝，衣其羽皮。","book":"《礼记·礼运》"},"example":{"text":"～的时代已经一去不复返了。"},"similar":["生吞活剥","刀耕火种"],"usage":"作谓语、宾语、定语；形容野蛮的生活"},{"id":38706,"word":"茹泣吞悲","pinyin":"rú qì tūn bēi","abbr":"rqtb","explanation":"茹泣：哭泣。形容极其悲痛。","source":{"text":"北地残氓，东部遗老，莫不茹泣吞悲，倾耳戴目，翘心仁政，延首王风。","book":"南朝·齐·王融《画汉武北伐图上疏》"},"usage":"作谓语、定语；用于书面语"},{"id":38707,"word":"茹痛含辛","pinyin":"rú tòng hán xīn","abbr":"rthx","explanation":"形容忍受痛苦和艰辛。","source":{"text":"秃巾髽髻老扶车，茹痛含辛说乱华。","book":"宋·范成大《相州》诗"},"similar":["茹苦含辛"],"usage":"作谓语、定语、状语；形容忍受艰难困苦"},{"id":38708,"word":"茹苦含辛","pinyin":"rú kǔ hán xīn","abbr":"rkhx","explanation":"辛：辣；茹：吃。形容忍受辛苦或吃尽辛苦。","source":{"text":"无所不至，茹苦含辛，更百千亿生而后成。","book":"宋·苏轼《中和胜相院记》"},"example":{"text":"上有霜姑，下无遗息，茕茕孑立，～。","book":"清·淮阴百一居士《壶天录》卷上"},"similar":["千辛万苦","如牛负重","茹苦含酸"],"opposite":["如解倒悬"],"usage":"作谓语、定语、状语；形容忍受艰难困苦","story":["传说宋朝时期，人们修养佛性往往一开始就进驻山林，踏着荆棘与蛇虫，在霜雪中裸体行走，甚至更有人割下自己的肉烹烧去喂老虎以及其他的小动物，这些人茹苦含辛以为就能成佛，人们感慨“佛之道难成”"]},{"id":38709,"word":"茹鱼去蝇","pinyin":"rú yú qù yíng","abbr":"ryqy","explanation":"茹鱼：腐臭的鱼。用腐臭的鱼驱赶苍蝇。比喻做事方法不对头，结果适得其反。","source":{"text":"以茹鱼去蝇，蝇愈至，不可禁。","book":"《吕氏春秋·功名》"}},{"id":38710,"word":"荀令衣香","pinyin":"xún lìng yī xiāng","abbr":"xlyx","explanation":"形容官吏美名远扬，为人所敬仰。也形容独具风采，风度优雅的官吏。","source":{"text":"晋·习凿齿《襄阳记》载：东汉荀彧性喜香，常将衣服薰香，若去他人家坐一下，坐处三日有香气。"},"example":{"text":"细思二十年前事，叹人琴，已矣俱亡。改尽潘郎鬓发，消残～。","book":"宋·刘克庄《风入松·福清道中作》"}},{"id":38711,"word":"荆人涉澭","pinyin":"jīng rén shè yōng","abbr":"jrsy","explanation":"荆人：楚国人。澭：澭水。楚国人过澭水。后用以讽刺拘泥于成法，不知道根据情况的变化而变通的行为。","source":{"text":"《吕氏春秋·察今》：“荆人欲袭宋，使人先表澭水。澭水暴益，荆人弗知，循表而夜涉，溺死者千余人，军惊而坏都舍。"},"usage":"作宾语、定语；用于处事"},{"id":38712,"word":"荆南杞梓","pinyin":"jīng nán qǐ zǐ","abbr":"jnqz","explanation":"荆：荆山，在今湖北省；杞梓：杞树和梓树，都是优质木材。荆南地方的杞树和梓树。比喻南方的优秀人才。","source":{"text":"庾域字司大，新野人也。少沈静，有名乡曲。梁文帝为郢州，辟为主簿，叹美其才，曰：‘荆南札梓，其在斯乎？’","book":"《南史·庾域传》"}},{"id":38713,"word":"荆天棘地","pinyin":"jīng tiān jí dì","abbr":"jtjd","explanation":"到处都是荆棘。形容困难重重，障碍极多。","source":{"text":"一事不能做，寸步不能行，荆天棘地，生气索然。","book":"清·壮者《扫迷帚》第一回"},"example":{"text":"一年多以前，他们夫妇俩怎样幸而走出了对于他们是～的大连。","book":"鲁迅《三月的租界》"},"similar":["天昏地暗","寸步难行","天荒地老"],"opposite":["光辉灿烂","光天化日"],"usage":"作宾语、定语；形容困难重重"},{"id":38714,"word":"荆山之玉","pinyin":"jīng shān zhī yù","abbr":"jszy","explanation":"荆山：山名，此山产宝玉，据传和氏璧就出自此山。比喻极珍贵的东西。","source":{"text":"人人自谓握灵蛇之珠，家家自谓抱荆山之玉。","book":"三国·魏·曹植《与杨德祖书》"},"example":{"text":"如夜之珠既碎而不复全，～既玷而不可磨。","book":"清·烟霞散人《凤凰池》第十五回"},"similar":["灵蛇之珠"],"usage":"作宾语；指极珍贵的东西"},{"id":38715,"word":"荆棘丛生","pinyin":"jīng jí cóng shēng","abbr":"jjcs","explanation":"荆棘：荆条蒺藜；丛：聚集成堆。荆蔓蒺藜成群地生长出来。比喻前进道路阻碍很大，困难极多。","source":{"text":"况荆棘丛生，狐兔为侣，宁不可叹。日后唐家天子，亦如此而已。","book":"清·褚人获《隋唐演义》第五十一回"},"example":{"text":"若说她并非藏在此地，却又何故将他们引来这样一个～的荒凉所在？","book":"染羽生《狂侠天娇魔女》第一百十一回"},"usage":"作宾语、定语；用于比喻句"},{"id":38716,"word":"荆棘丛里","pinyin":"jīng jí cóng lǐ","abbr":"jjcl","explanation":"荆棘：荆条蒺藜；丛：聚集成堆。比喻境遇恶劣，坏人很多的地方。","source":{"text":"荆棘丛里难容凤，沧海波心好变龙。","book":"清·孔尚任《桃花扇·听稗》"},"example":{"text":"望远镜的视界内，只见元豹象片羽毛似地从悬崖上跳下来，缓缓地落在崖下的～。","book":"王朔《千万别把我当人》"}},{"id":38717,"word":"荆棘塞途","pinyin":"jīng jí sè tú","abbr":"jjst","explanation":"满路都是荆棘。比喻环境困难，障碍很多。","source":{"text":"言无道路可从，冒榛薮也，说其穷困之极也。","book":"《左传·襄公十四年》：“乃祖吾离被苫盖，蒙荆棘，以来归我先君。”孔颖达疏"},"example":{"text":"问什么～的老路，寻什么乌烟瘴气的鸟导师！","book":"鲁迅《华盖集·导师》"},"similar":["荆天刺地"],"usage":"作宾语、补语、定语；比喻前进路上困难重重"},{"id":38718,"word":"荆棘满腹","pinyin":"jīng jí mǎn fù","abbr":"jjmf","explanation":"比喻内心尽是不良的念头。","source":{"text":"面结口头交，肚里生荆棘。","book":"唐·孟郊《择友》诗"}},{"id":38719,"word":"荆棘满途","pinyin":"jīng jí mǎn tú","abbr":"jjmt","explanation":"荆棘遍地。比喻世道艰难。","source":{"text":"荆棘满途，蓬莱闲住，诸葛茅庐。","book":"元·任昱《上小楼·隐居》曲"},"example":{"text":"红箫妹妹哟，你与我同向生的路上走去吧，不怕那儿就是～！","book":"郭沫若《卓文君》第三景"},"similar":["荆棘塞途"],"usage":"作宾语、补语、定语；比喻前进路上困难重重"},{"id":38720,"word":"荆棘载途","pinyin":"jīng jí zài tú","abbr":"jjzt","explanation":"满路都是荆棘。比喻环境困难，障碍很多。","source":{"text":"言无道路可从，冒榛薮也，说其穷困之极也。","book":"《左传·襄公十四年》：“乃祖吾离被苫盖，蒙荆棘，以来归我先君。”孔颖达疏"},"example":{"text":"山有芝也，亦可采也。荆棘载途，何可扫也？","book":"清·周茂兰《追和采芝歌》"},"similar":["荆棘丛生","荆棘塞途","荆棘满途"],"opposite":["一帆风顺","一马平川"],"usage":"作宾语、补语、定语；比喻前进路上困难重重"},{"id":38721,"word":"荆棘铜驼","pinyin":"jīng jí tóng tuó","abbr":"jjtt","explanation":"铜驼：铜制的骆驼，古代置于宫门外。形容国土沦陷后残破的景象。","source":{"text":"靖有先识远量，知天下将乱，指洛阳宫门铜驼，叹曰：‘会见汝在荆棘中耳？’","book":"《晋书·索靖传》"},"example":{"text":"～心上泪，觚棱金爵劫余灰。","book":"清·黄遵宪《术闻》诗"},"usage":"作主语、宾语；形容世乱荒凉"},{"id":38722,"word":"荆榛满目","pinyin":"jīng zhēn mǎn mù","abbr":"jzmm","explanation":"荆榛：带刺的丛生灌木。放眼望去，都是荆榛。形容遭遇变故后到处都是荒凉的景象。也比喻处境困难，障碍重重。","source":{"text":"文进在平州，率奚族劲骑，鸟击兽搏，倏来忽往，燕赵诸州，荆榛满目。","book":"《旧五代史·卢文进传》"},"example":{"text":"除杨安殿外，尚是瓦砾成堆，～。","book":"蔡东藩《后汉演义》第七十四回"},"usage":"作谓语、宾语；指荒凉的景象"},{"id":38723,"word":"荆笔杨板","pinyin":"jīng bǐ yáng bǎn","abbr":"jbyb","explanation":"荆：晋惠帝时权臣楚王司马玮；杨：晋惠帝时权臣杨骏；板：诏书。形容权臣专权用事。","source":{"text":"二月末，三月初，荆笔杨板行诏书。","book":"《晋书·五行志中》"},"usage":"作宾语、定语；指奸臣专权"},{"id":38724,"word":"荆衡杞梓","pinyin":"jīng héng qǐ zǐ","abbr":"jhqz","explanation":"荆：荆山；衡：衡山；杞梓：两种好木材，比喻优秀的人才。比喻南方的优秀人才。","source":{"text":"观夫陆机、陆云，实荆衡之杞梓，挺珪璋之秀实，驰英华于早年。","book":"《晋书·陆机陆云传论》"},"usage":"作宾语、定语；用于书面语"},{"id":38725,"word":"荆钗布袄","pinyin":"jīng chāi bù ǎo","abbr":"jcba","explanation":"荆：灌木名；钗：妇女的发饰。荆枝为钗，粗布为衣。形容妇女装束简陋寒素。","source":{"text":"妻从俭荆钗布袄，子甘贫陋巷箪瓢。","book":"元·汪元享《朝天子·归田》曲"},"similar":["荆钗布裙","裙布荆钗","布裙荆钗"],"usage":"作主语、宾语、定语；用于女性的装束"},{"id":38726,"word":"荆钗布裙","pinyin":"jīng chāi bù qún","abbr":"jcbq","explanation":"荆枝作钗，粗布为裙。形容妇女装束朴素。","source":{"text":"年近将冠，皆已有室，荆钗布裙，足得成礼。","book":"南朝·宋·虞通之《为江敩让尚公主表》"},"example":{"text":"况～者未必能安于荆钗布裙也，与其后悔，莫若无成。","book":"清·沈复《浮生六记·坎坷记愁》"},"similar":["粗衣布服","荆钗布袄"],"opposite":["金玉其外","穿金带玉"],"usage":"作主语、宾语、定语；用于女性","story":["东汉书生梁鸿读完太学回家务农，与县上孟财主的30岁女儿孟光结婚，婚后他们抛弃孟家的富裕生活，到霸陵山区隐居，后来帮皋伯通打短工。孟光用荆条作钗，穿着粗布衣服，举案齐眉，夫妻十分恩爱"]},{"id":38727,"word":"荆钗裙布","pinyin":"jīng chāi qún bù","abbr":"jcqb","explanation":"荆：灌木名；钗：妇女的发饰。荆枝为钗，粗布为裙。形容妇女装束简陋寒素。","source":{"text":"荆钗裙布，还有甚娇娆？","book":"明·范受益《寻亲记·剖面》"},"similar":["荆钗布裙","裙布荆钗","布裙荆钗"],"usage":"作主语、宾语、定语；用于女性的装束"},{"id":38728,"word":"草偃风从","pinyin":"cǎo yǎn fēng cóng","abbr":"cyfc","explanation":"像草随风倒伏一样，旧比喻政治清明，百姓服从统治。","source":{"text":"君子之德风，小人之德草，草上之风必偃。","book":"《论语·颜渊》"}},{"id":38729,"word":"草偃风行","pinyin":"cǎo yǎn fēng xíng","abbr":"cyfx","explanation":"比喻道德文教的感化人。同“风行草偃”。"},{"id":38730,"word":"草入牛口，其命不久","pinyin":"cǎo rù niú kǒu，qí mìng bù jiǔ","abbr":"crnkqmbj","explanation":"草进到牛嘴里，牛一定会把它吃掉。比喻难以逃脱厄运。","source":{"text":"我们只是草寇，常言：草入牛口，其命不久。","book":"明·冯梦龙《古今小说》卷三十六"}},{"id":38731,"word":"草创未就","pinyin":"cǎo chuàng wèi jiù","abbr":"ccwj","explanation":"草创：开始创办或创立；就：完成。刚开始做，尚未完成。","source":{"text":"亦欲以究天人之际，通古今之变，成一家之言。草创未就，会遭此祸，惜其不成，以就极刑而无愠色。","book":"汉·司马迁《报任少卿书》"},"opposite":["大功告成"],"usage":"作谓语、定语；指刚开始"},{"id":38732,"word":"草头天子","pinyin":"cǎo tóu tiān zǐ","abbr":"cttz","explanation":"强盗的头领，旧时亦指入山聚众起义的首领。","source":{"text":"蛇无头而不行，就有个草头天子出来。此人姓范名汝为，仗义执言，救民水火。","book":"《京本通俗小说·冯玉梅团圆》"},"example":{"text":"况且～，他的命数修短，大则关系天下，小则关系一方。","book":"明·罗贯中《平妖传》第37回"},"similar":["草莽英雄"],"usage":"作主语、宾语；指强盗头子"},{"id":38733,"word":"草庐三顾","pinyin":"cǎo lú sān gù","abbr":"clsg","explanation":"顾：拜访。刘备为请诸葛亮，三次到草庐中去拜访他。后用此典故表示帝王对臣下的知遇之恩。也比喻诚心诚意地邀请或过访。","source":{"text":"先帝不以臣卑鄙，猥自枉屈，三顾臣于草庐之中。","book":"三国·蜀·诸葛亮《出师表》"},"example":{"text":"对于孔明这类贤人，我也会～的。"},"similar":["三顾茅庐"],"usage":"作宾语、定语；指求贤","story":["东汉末年，天下大乱，诸葛亮在隆中茅草房，自耕自食，但很有学问，人称“卧龙先生”。徐庶给刘备推荐诸葛亮，刘备和关羽、张飞亲自到卧龙冈拜见诸葛亮，前两次都没见到，第三次终于见到诸葛亮，诚心请诸葛亮出山"]},{"id":38734,"word":"草木俱朽","pinyin":"cǎo mù jù xiǔ","abbr":"cmjx","explanation":"象草木一样死去，世人并不知道。借喻人一生毫无建树。","source":{"text":"彼与草木俱朽，此与金石相倾。","book":"《后汉书·朱穆传》"},"usage":"作宾语、定语；多用于比喻句"},{"id":38735,"word":"草木同腐","pinyin":"cǎo mù tóng fǔ","abbr":"cmtf","explanation":"象草木一样腐烂。比喻人一生毫无建树。","source":{"text":"彼与草木俱朽，此与金石相倾。","book":"《后汉书·朱穆传》"},"example":{"text":"高宝赞理光铲木，与～。","book":"《唐书》"}},{"id":38736,"word":"草木愚夫","pinyin":"cǎo mù yú fū","abbr":"cmyf","explanation":"旧时农民的谦称。象山野之中草木那样愚昧无知的人。也指人对农民的蔑称。","source":{"text":"料你不过草木愚夫，识得什么天时人事。","book":"明·许仲琳《封神演义》第70回"},"example":{"text":"我本是～，谈不上什么高雅。"},"similar":["凡夫俗子"],"usage":"作宾语、定语；指村民"},{"id":38737,"word":"草木皆兵","pinyin":"cǎo mù jiē bīng","abbr":"cmjb","explanation":"把山上的草木都当做敌兵。形容人在惊慌时疑神疑鬼。","source":{"text":"坚与苻融登城而望王师，见部阵齐整，将士精锐；又北望八公山上草森皆类人形，顾谓融曰：‘此亦劲敌也，何谓少乎？’怃然有惧色。","book":"《晋书·苻坚载记》"},"example":{"text":"这一天大家都是惊疑不定，～，迨及到了晚上，仍然毫无动静。","book":"清·吴趼人《二十年目睹之怪现状》第五十九回"},"similar":["风声鹤唳","杯弓蛇影"],"opposite":["若无其事","稳如泰山","措置裕如"],"usage":"作谓语、定语、状语；形容神经过敏","story":["东晋时期，前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃的过程中看到后边山上草木的阴影，都以为是追兵"]},{"id":38738,"word":"草木知威","pinyin":"cǎo mù zhī wēi","abbr":"cmzw","explanation":"连草木都知道他的威名。形容威势极大。","source":{"text":"朕谓江淮草木亦知尔威名。","book":"《新唐书·张万福传》"},"similar":["赫赫有名"],"usage":"作宾语；形容威势极大"},{"id":38739,"word":"草木荣枯","pinyin":"cǎo mù róng kū","abbr":"cmrk","explanation":"荣枯：繁茂和枯萎。草木的茂盛和干枯。","source":{"text":"几千年来，劳动人民注意了草木荣枯，侯鸟去来等自然现象同气候的关系，据以安排农事。","book":"《大自然的语言》"},"usage":"作宾语、定语；用于自然现象"},{"id":38740,"word":"草木萧疏","pinyin":"cǎo mù xiāo shū","abbr":"cmxs","explanation":"萧疏：冷落，稀稀落落。花草树木都已枯萎凋谢。形容深秋景象。","source":{"text":"春日黄花满山，径幽香远；秋来草木萧疏，天高水清。","book":"《晋祠》"}},{"id":38741,"word":"草木黄落","pinyin":"cǎo mù huáng luò","abbr":"cmhl","explanation":"秋天以到，因草木的叶子呈枯黄而掉落。","source":{"text":"秋风起兮白云飞，草木黄落兮雁南归。","book":"《汉武·秋风辞》"}},{"id":38742,"word":"草泽英雄","pinyin":"cǎo zé yīng xióng","abbr":"czyx","explanation":"草泽：荒野地。指在山林出没的农民起义军首领。","source":{"text":"遗民未忘旧君，遂渐念草泽英雄之为明宣力者。","book":"鲁迅《中国小说史略》第27篇"},"example":{"text":"鲁迅《中国小说史略》第27篇：“遗民未忘旧君，遂渐念～之为明宣力者。”"},"similar":["草莽英雄"],"usage":"作主语、宾语；指民间英雄"},{"id":38743,"word":"草满囹圄","pinyin":"cǎo mǎn líng yǔ","abbr":"cmly","explanation":"监狱里长满了草。比喻政治清明，犯罪的人极少。","source":{"text":"在职七年，风教大洽，狱中无系囚，争讼绝息，囹圄尽皆生草，庭可张罗。","book":"《隋书·刘旷传》"},"similar":["政简刑清"],"usage":"作宾语、定语；用于政事"},{"id":38744,"word":"草率了事","pinyin":"cǎo shuài liǎo shì","abbr":"csls","explanation":"了：了结，结束。草率地把事情结束了。","example":{"text":"这事不能～。"},"similar":["草草了事"],"opposite":["郑重其事"],"usage":"作谓语、状语、定语；指做事马马虎虎"},{"id":38745,"word":"草率从事","pinyin":"cǎo shuài cóng shì","abbr":"cscs","explanation":"草率：粗枝大叶，敷衍了事。马马虎虎就处理了。形容办事不认真。","source":{"text":"明初修史时，即据其成文编入，不复彼此互订，以归画一，亦可见其草率从事也。","book":"清·赵翼《廿二史札记·新唐书本纪书法》"},"example":{"text":"务必纠正一切～的偏向。","book":"毛泽东《镇压反革命必须打得稳，打得准，打得狠》"},"similar":["草率了事","草率行事"],"opposite":["郑重其事"],"usage":"作谓语、定语、补语；指不认真"},{"id":38746,"word":"草率将事","pinyin":"cǎo lǜ jiāng shì","abbr":"cljs","explanation":"指办事马虎不认真。","source":{"text":"虽说不愿意十分撤烂污，然而‘半生不熟’‘草率将事’产毛病总不能免。","book":"叶圣陶《〈叶圣陶文集〉自序》"},"similar":["草率从事","草率行事"],"usage":"作谓语、定语、宾语；指不认真"},{"id":38747,"word":"草率收兵","pinyin":"cǎo shuài shōu bīng","abbr":"cssb","explanation":"比喻马马虎虎、急急忙忙地把事情结束了。","source":{"text":"应当在处理闹事的过程中，进行细致的工作，不要用简单的方法去处理，不要‘草率收兵’。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"example":{"text":"他这样～是极不负责的。"},"similar":["草草了事","马马虎虎"],"opposite":["认认真真","郑重其事"],"usage":"作谓语；形容工作不负责任"},{"id":38748,"word":"草率行事","pinyin":"cǎo shuài xíng shì","abbr":"csxs","explanation":"草率：粗枝大叶，敷衍了事。形容办事不认真。","source":{"text":"务必纠正一切草率行事的偏向。","book":"毛泽东《镇压反革命必须打得稳，打得准，打得狠》"},"example":{"text":"这件大事绝不可以～。"},"similar":["草率从事"],"usage":"作谓语、定语、宾语；指不认真"},{"id":38749,"word":"草腹菜肠","pinyin":"cǎo fù cài cháng","abbr":"cfcc","explanation":"比喻毫无才学。亦用为谦词。","source":{"text":"老夫疏于学问，草腹菜肠，对着众位长者，也吟诗一首，万望勿哂者。","book":"元·刘唐卿《降桑椹》第一折"},"opposite":["满腹经纶"],"usage":"作宾语、定语；用于自谦"},{"id":38750,"word":"草船借箭","pinyin":"cǎo chuǎn jiè jiàn","abbr":"ccjj","explanation":"运用智谋，凭借他人的人力或财力来达到自己的目的。","source":{"text":"用奇谋孔明借箭，献密计黄盖受刑。","book":"明·罗贯中《三国演义》第46回回目"},"example":{"text":"他很佩服诸葛亮的～的计谋。"},"usage":"作宾语、定语；指借他人的力量","story":["三国时期，曹操率大军攻打东吴，孙权刘备联合抗曹，周瑜心胸狭隘，很忌妒诸葛亮，设计让诸葛亮三天之间完成造箭十万支。诸葛亮向鲁肃借了20只船及草人，趁夜色大雾之机，开船向曹营，曹操率军拼命向草人上射箭，圆满完成任务"]},{"id":38751,"word":"草芥人命","pinyin":"cǎo jiè rén mìng","abbr":"cjrm","explanation":"视人命如草芥而任意摧残。同“草菅人命”。","source":{"text":"橐金如山，草芥人命者，拥冠盖扬扬闾里间矣。","book":"明·王世贞《觚不觚录》"},"similar":["草菅人命"],"usage":"作谓语、宾语、定语；用于反动统治者"},{"id":38752,"word":"草茅之产","pinyin":"cǎo máo zhī chǎn","abbr":"cmzc","explanation":"指乡下平凡的女子。多用于谦称。","source":{"text":"草茅之产，得奉箕帚之事。","book":"汉·刘向《说苑·修文》"}},{"id":38753,"word":"草茅之臣","pinyin":"cǎo máo zhī chén","abbr":"cmzc","explanation":"草茅：杂草。比喻在野无权的人。","source":{"text":"在野则曰草茅之臣。","book":"《仪礼·士相见礼》"},"similar":["平民百姓"],"opposite":["达官贵人","王公大臣"],"usage":"作主语、宾语；用于口语"},{"id":38754,"word":"草草不恭","pinyin":"cǎo cǎo bù gōng","abbr":"ccbg","explanation":"草草：杂乱不整齐的样子；恭：恭敬。草率而不恭敬。常用作书信中的自谦之辞。"},{"id":38755,"word":"草草了事","pinyin":"cǎo cǎo liǎo shì","abbr":"ccls","explanation":"草草：形容草率、马虎；了：办完，结束。草率地把事情结束了。","source":{"text":"陈文端请修正史，分各志二十八，务于详备，一志多至四五十万余言。未几，文端薨，各志草草了事。","book":"明·朱国桢《涌幢小品·实录》"},"example":{"text":"虽说僧经道忏，吊祭供饭，络绎不绝，终是钱银吝啬，谁肯踊跃，不过～。","book":"清·曹雪芹《红楼梦》第一百一十回"},"similar":["草草收兵","敷衍了事"],"opposite":["一丝不苟","兢兢业业"],"usage":"作谓语、状语、定语；指做事马马虎虎"},{"id":38756,"word":"草草收兵","pinyin":"cǎo cǎo shōu bīng","abbr":"ccsb","explanation":"马马虎虎地就收了兵。比喻工作不负责任，不细致，不慎重。","source":{"text":"张发奎刚占领了那个地方，要管也管不了许多，正是咱们的人活动的好机会，——你怎么好意思草草收兵？象一个赤卫队员么？","book":"欧阳山《苦斗》十七"},"example":{"text":"你不能就这样～。"},"similar":["草率收兵","草草收场"],"opposite":["慎重其事"],"usage":"作谓语、宾语；指不负责任"},{"id":38757,"word":"草草率率","pinyin":"cǎo cǎo shuài shuài","abbr":"ccsl","explanation":"指人做事马虎，不细致。","source":{"text":"她于是就草草率率收拾起一个出门的提包，准备第二天动身。","book":"路遥《平凡的世界》第二卷第36章"},"similar":["轻轻率率","草率从事"],"opposite":["郑重其事"],"usage":"作定语、状语；用于处事"},{"id":38758,"word":"草莽之臣","pinyin":"cǎo mǎng zhī chén","abbr":"cmzc","explanation":"草莽：草野，草丛。指草野间未作官的人。","source":{"text":"在野曰草莽之臣。","book":"《左传·昭公元年》：“若野赐之，是委君兄于草莽也。”《孟子·万章下》"}},{"id":38759,"word":"草莽英雄","pinyin":"cǎo mǎng yīng xióng","abbr":"cmyx","explanation":"草莽：草丛，草野。旧时指在山林出没的农民起义或强盗们中的著名人物。","source":{"text":"昔刘邦以亭长而定汉基，朱元璋以布衣而奠明祚……天命所属，多在草泽英雄。","book":"清·黄小配《洪秀全演义》第五回"},"example":{"text":"胸前和肩膀上缠着眩着人眼的红色标帜，真是个“～”的气慨。","book":"冯铿《红的日记》"},"similar":["草泽英雄","绿林好汉"],"usage":"作主语、宾语；指民间英雄"},{"id":38760,"word":"草菅人命","pinyin":"cǎo jiān rén mìng","abbr":"cjrm","explanation":"草菅：野草。把人命看作野草。比喻反动统治者随意谑杀人民。","source":{"text":"其视杀人，若艾草菅然。","book":"《汉书·贾谊传》"},"example":{"text":"象某人这样的官，真正是～了。","book":"清·李宝嘉《官场现形记》第四十七回"},"similar":["滥杀无辜","生杀予夺","杀人如麻"],"opposite":["为民请命","为民除害"],"usage":"作谓语、宾语、定语；用于反动统治者","story":["汉文帝初年，丞相周勃因受诬陷入狱，曾经受周勃排挤的贾谊不记前嫌，写一篇《治安策》进献汉文帝。汉文帝从《治安策》中领悟到秦二世胡亥的草菅人命的残暴统治而导致秦朝的灭亡，决定实行仁政，赦免周勃，给他官复原职"]},{"id":38761,"word":"草薙禽狝","pinyin":"cǎo tì qín xiǎn","abbr":"ctqx","explanation":"薙：除草；狝：杀。如同割除野草，捕杀禽兽一般。比喻肆意屠戮，无所顾惜。","source":{"text":"至纷不可治，乃草薙而禽狝之，尽根株痛断乃止。","book":"唐·韩愈《送郑尚书序》"},"example":{"text":"岂可不察臧否，不择是非，欲草薙而禽狝之，能无乱乎？","book":"《资治通鉴·唐纪昭宗天复三年》"},"similar":["草菅人命"],"usage":"作谓语、宾语；指残忍"},{"id":38762,"word":"草藄禽猘","pinyin":"cǎo tì qín xiǎn","abbr":"ctqx","explanation":"藄除草；猘杀。如同割除野草，捕杀禽兽一般。比喻肆意屠戮，无所顾惜。","source":{"text":"至纷不可治，乃草藄而禽猘之，尽根株痛断乃止。","book":"唐·韩愈《送郑尚书序》"},"quote":{"text":"岂可不察臧否，不择是非，欲草藄而禽猘之，能无乱乎？","book":"《资治通鉴·唐纪昭宗天复三年》"}},{"id":38763,"word":"草蛇灰线","pinyin":"cǎo shé huī xiàn","abbr":"cshx","explanation":"比喻事物留下隐约可寻的线索和迹象。","source":{"text":"写秋痕，采秋，则更用暗中之明，明中之暗……草蛇灰线，马迹蛛丝，隐于不言，细入无间。","book":"《花月痕》第五回回评"},"example":{"text":"该处市面，极为恐慌，乱机日深，皆由此等～而来。","book":"黄远庸《内外之形势》"},"usage":"作宾语、定语；用于作文等"},{"id":38764,"word":"草行露宿","pinyin":"cǎo xíng lù sù","abbr":"cxls","explanation":"走在野草里，睡在露天下。形容走远路的人艰苦和匆忙的情形。","source":{"text":"闻内生鹤唳，皆以为王师已至，草行露宿，重以饥冻，死者十七八。","book":"《晋书·谢玄传》"},"example":{"text":"不得已，变姓名，诡踪迹，～，日与北骑相出没于长淮间。","book":"宋·文天祥《指南录后序》"},"similar":["餐风露宿"],"usage":"作谓语、定语；形容旅途的艰辛"},{"id":38765,"word":"草衣木食","pinyin":"cǎo yī mù shí","abbr":"cyms","explanation":"编草为衣，以树木果实为食。形容生活清苦。","source":{"text":"你这出家人，无过草衣木食，干受辛苦，有什么受用快活处。","book":"元·马致远《黄梁梦》第一折"},"example":{"text":"这出家无过～，熬枯受淡。","book":"元·关汉卿《望江亭》第一折"},"opposite":["锦衣玉食"],"usage":"作宾语、定语；指生活清苦"},{"id":38766,"word":"草长莺飞","pinyin":"cǎo zhǎng yīng fēi","abbr":"czyf","explanation":"莺：黄鹂。形容江南暮春的景色。","source":{"text":"暮春三月，江南草长，杂花生树，群莺乱飞。","book":"南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"这样看来，花香鸟语，～，都是大自然的语言。","book":"竺可桢《大自然的语言》"},"usage":"作定语、分句；形容春天的景象"},{"id":38767,"word":"草间求活","pinyin":"cǎo jiān qiú huó","abbr":"cjqh","explanation":"草间：草野之中。形容只求眼前能马马虎虎活下去。","source":{"text":"苟厄运必至，我当以死卫社稷，横尸庙门，不能运窜于草间求活也。","book":"《宋书·武帝纪》"},"example":{"text":"吾备位大臣，朝廷丧败，宁可复～，外投胡越邪！（《晋书·周顗传》）"},"similar":["苟且偷安"],"usage":"作谓语；形容苟且偷安地活下去"},{"id":38768,"word":"草靡风行","pinyin":"cǎo mí fēng xíng","abbr":"cmfx","explanation":"比喻道德文教的感化人。同“风行草偃”。","example":{"text":"比喻道德文教的感化人。同“风行草偃”。"},"similar":["风行草偃","风行草从"],"usage":"作谓语、定语；用于书面语"},{"id":38769,"word":"荏弱无能","pinyin":"rěn ruò wú néng","abbr":"rrwn","explanation":"荏弱：软弱。软弱且没有能力。","source":{"text":"外承欢之汋约兮，谌荏弱而难持。","book":"战国·楚·屈原《九章·哀郢》"}},{"id":38770,"word":"荏弱难持","pinyin":"rěn ruò nán chí","abbr":"rrnc","explanation":"荏弱：软弱，怯弱。旧指臣子才能平庸，难以扶持君国。","source":{"text":"外承欢之汋约兮，谌荏弱而难持。","book":"战国·楚·屈原《九章·哀郢》"},"example":{"text":"六姊频犯，连引十余爵，酡然径醉，芳体娇懒，～。","book":"清·蒲松龄《聊斋志异·萧七》"}},{"id":38771,"word":"荏苒代谢","pinyin":"rěn rǎn dài xiè","abbr":"rrdx","explanation":"荏苒：时光渐渐过去；代谢：交替。指日月交替运行，时光渐渐消逝。","source":{"text":"日与月与，荏苒代谢。","book":"西晋·张华《励志》"},"similar":["荏苒日月"],"usage":"作谓语；指时光流逝"},{"id":38772,"word":"荏苒日月","pinyin":"rěn rǎn rì yuè","abbr":"rrry","explanation":"荏苒：时光渐渐过去。指日月交替运行，时光渐渐消逝。","source":{"text":"欲草一中国通史，以助爱国思想之发达，然荏苒日月，至今犹未能成十之二。","book":"梁启超《三十自述》"},"similar":["荏苒代谢"],"usage":"作谓语；指时光流逝"},{"id":38773,"word":"荐贤不荐愚","pinyin":"jiàn xián bù jiàn yú","abbr":"jxbjy","explanation":"应该推荐德才兼备的贤能之人，而不能推荐糊涂无知的愚笨之人。"},{"id":38774,"word":"荐贤举能","pinyin":"jiàn xián jǔ néng","abbr":"jxjn","explanation":"举：推荐。选拔推荐有都能有德行的人。","source":{"text":"大道之行也，天下为公，选贤与能，讲信修睦。","book":"《礼记·礼运》"}},{"id":38775,"word":"荒唐不经","pinyin":"huāng táng bù jīng","abbr":"htbj","explanation":"不经：不合常理。形容虚妄离奇，不合情理。","source":{"text":"神仙之说，多荒唐不经，莫可考信。","book":"清·阮葵生《茶余客话·龙泉连学博》"},"similar":["荒怪不经","荒渺不经","荒诞不经"],"usage":"作谓语、宾语、定语；指不合情理"},{"id":38776,"word":"荒唐之言","pinyin":"huāng táng zhī yán","abbr":"htzy","explanation":"指荒诞无稽的言论。","source":{"text":"庄周闻其风而悦之，以谬悠之说，荒唐之言，无端崖之辞时恣纵而不戃。","book":"战国·宋·庄周《庄子·天下篇》"},"example":{"text":"语颇错杂无伦次，又多～。","book":"鲁迅《狂人日记》"},"usage":"作主语、宾语；用于说话或文章等"},{"id":38777,"word":"荒唐无稽","pinyin":"huāng táng wú jī","abbr":"htwj","explanation":"清·岭南羽衣女士《东欧女豪杰》第三回：“那个神字，原是野蛮世界拿出来哄著愚人的话，如今科学大明，这些荒诞无稽的谬说，那里还能立足呢？”","source":{"text":"他的大九州之说，在当年虽是～，而在现代则毫不足惊异了。 ★郭沫若《文艺论集·惠施的性格与思想》"},"example":{"text":"王朔《痴人》：“我想你慢慢会知道你所谓的气功传导是～的。”"},"similar":["荒诞无稽"],"opposite":["有根有据"],"usage":"作谓语、宾语、定语；形容极其荒唐"},{"id":38778,"word":"荒唐谬悠","pinyin":"huāng táng miù yōu","abbr":"htmy","explanation":"谬悠：荒唐无稽。指说话没有根据或行为不合常理。","source":{"text":"以不喜之心，强其所不长。其荒唐谬悠可知也。","book":"宋·苏轼《答守寺丞书》"}},{"id":38779,"word":"荒子孱孙","pinyin":"huāng zǐ chán sūn","abbr":"hzcs","explanation":"不成材的子孙；放荡无行的后嗣。","source":{"text":"其政易行，其民易使，风俗淳厚而王道成矣。虽有荒子孱孙，犹七八百岁而后已。","book":"宋·欧阳修《本论》"},"usage":"作宾语、定语；用于书面语"},{"id":38780,"word":"荒山野岭","pinyin":"huāng shān yě lǐng","abbr":"hsyl","explanation":"指荒凉无人烟的山野","source":{"text":"往前一看，都是荒山野岭，不见有人行路，连一株树木也没有。","book":"清·贪梦道人《彭公案》第80回"},"similar":["荒郊野外"],"usage":"作宾语、定语；用于口语"},{"id":38781,"word":"荒怪不经","pinyin":"huāng guài bù jīng","abbr":"hgbj","explanation":"荒怪：荒唐怪异；不经：不合常理。形容言论荒谬，不合情理。","source":{"text":"其夸苑囿之大，固无荒怪不经之说，后世学者，往往读之不通。","book":"宋·王楙《野客丛书·相如上林赋》"},"example":{"text":"我们没必要去研究这～的故事。"},"similar":["荒诞不经","荒唐不经","荒渺不经"],"usage":"作谓语、定语；指不合情理"},{"id":38782,"word":"荒无人烟","pinyin":"huāng wú rén yān","abbr":"hwry","explanation":"人烟：指住户、居民，因有炊烟的地方就有人居住。形容地方偏僻荒凉，见不到人家。","source":{"text":"部队指战员忍饥受寒，翻越高达四千二百米荒无人烟的大山。","book":"穆欣《南线巡回·解放西昌之战》"},"example":{"text":"他们来到这～的地方只好自力更生了。"},"similar":["不牧之地"],"opposite":["人烟稠密"],"usage":"作宾语、定语；形容偏僻荒凉，没有人家"},{"id":38783,"word":"荒时暴月","pinyin":"huāng shí bào yuè","abbr":"hsby","explanation":"荒：五谷不收；暴：凶。指荒年或青黄不接的时候。","source":{"text":"荒时暴月，向亲友乞哀告怜，借得几斗几升，敷衍三日五日，债务丛集，如牛负重。","book":"毛泽东《中国社会各阶级的分析》"},"example":{"text":"我们得想办法渡过这～。"},"usage":"作宾语、定语；指荒年或青黄不接的时候"},{"id":38784,"word":"荒淫无度","pinyin":"huāng yín wú dù","abbr":"hywd","explanation":"荒：荒唐；淫：淫乱；度：限度。形容征逐酒色，生活糜烂。","source":{"text":"人生行乐耳，须富贵何时。是日也，拂衣而喜，奋袖低昂，顿足起舞，诚淫荒无度，不知其不可也。","book":"汉·杨恽《报孙会宗书》"},"example":{"text":"由于～，乡长的身体越来越加坏了，随常都在闹病，于是他的太太硬把她的愤怒转注在所有的流娼身上。","book":"沙汀《一个秋天的晚上》"},"similar":["醉生梦死","穷奢极欲","荒淫无耻"],"usage":"作谓语、定语、宾语；指生活糜烂"},{"id":38785,"word":"荒淫无耻","pinyin":"huāng yín wú chǐ","abbr":"hywc","explanation":"荒唐淫乱，不知羞耻。形容生活糜烂。","source":{"text":"公荒淫无道，废贤失败，理宜诛戮。","book":"明·罗贯中《三国演义》第一百一十九回"},"example":{"text":"这些官老爷挥霍民脂民膏，～。"},"similar":["荒淫无度"],"usage":"作补语、定语；形容生活糜烂"},{"id":38786,"word":"荒淫无道","pinyin":"huāng yín wú dào","abbr":"hywd","explanation":"荒淫：淫乱无度；无道：不讲道义。多指君主生活靡烂，重用奸佞，残害忠良，奴役百姓。","source":{"text":"不能属任贤相，用妇人之言，荒淫无道。","book":"《晋书·段灼传》"},"example":{"text":"公～，废贤失政，理宜诛戮。","book":"明·罗贯中《三国演义》第一百十九回"},"similar":["昏庸无道"],"usage":"作谓语、定语、宾语；用于为人"},{"id":38787,"word":"荒渺不经","pinyin":"huāng miǎo bù jīng","abbr":"hmbj","explanation":"不经：不合常理。形容虚妄离奇，不合情理。","source":{"text":"上古世远人湮，所传之事，如共工触山、女娲补天，俱荒渺不经。","book":"清·夏敬渠《野叟曝言》第62回"},"similar":["荒唐不经","荒怪不经","荒诞不经"],"usage":"作谓语、宾语、定语；指不合情理"},{"id":38788,"word":"荒烟蔓草","pinyin":"huāng yān màn cǎo","abbr":"hymc","explanation":"荒烟：空旷荒凉的原野上的雾气；蔓草：蔓生的野草。比喻空旷偏僻，冷落荒凉。","source":{"text":"奈何荒烟野蔓，荆棘纵横。","book":"宋·欧阳修《祭石曼卿文》"},"example":{"text":"徘徊于～之间，得浣花残碣。","book":"清·黄宗羲《朱岷左先生近诗题辞》"}},{"id":38789,"word":"荒烟野蔓","pinyin":"huāng yān yě màn","abbr":"hyym","explanation":"荒烟：荒凉原野上的雾气；野蔓：野草。形容冷落荒凉的景象。","source":{"text":"奈何荒烟野蔓，荆棘纵横。","book":"宋·欧阳修《祭石蔓卿文》"},"usage":"作宾语、定语；用于书面语"},{"id":38790,"word":"荒诞不经","pinyin":"huāng dàn bù jīng","abbr":"hdbj","explanation":"荒诞：荒唐离奇；不经：不合常理。形容言论荒谬，不合情理。","source":{"text":"其语闳大不经，必先验小物，推而大之，至于无垠。","book":"《史记·孟子荀卿列传》"},"example":{"text":"如果用世俗的眼光看来，这些内容几乎都是～的。","book":"秦牧《幻想的彩翼》"},"similar":["荒谬绝伦","荒诞无稽"],"opposite":["确凿不移","信而有征","千真万确"],"usage":"作谓语、宾语、定语；指不合情理"},{"id":38791,"word":"荒诞无稽","pinyin":"huāng dàn wú jī","abbr":"hdwj","explanation":"稽：考查。十分荒唐，不可凭信。","source":{"text":"那个神字，原是野蛮世界拿出来哄著愚人的话，如今科学大明，这些荒诞无稽的谬说，那里还能立足呢？","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"example":{"text":"对于这种～的传闻，大家都不可相信。"},"similar":["荒谬绝伦","荒谬不经","大谬不然"],"opposite":["信而有征","有案可稽","千真万确"],"usage":"作谓语、宾语、定语；形容极其荒唐"},{"id":38792,"word":"荒谬不经","pinyin":"huāng miù bù jīng","abbr":"hmbj","explanation":"不经：不合常理。形容虚妄离奇，不合情理。","source":{"text":"照例便有三三五五女学生，由一个荒谬不经的热闹地方来，到另一个远地方去，取道从本地过身。","book":"沈从文《萧萧》"},"similar":["荒诞不经","荒唐不经","荒渺不经"],"opposite":["千真万确"],"usage":"作谓语、宾语、定语；指不合情理"},{"id":38793,"word":"荒谬绝伦","pinyin":"huāng miù jué lún","abbr":"hmjl","explanation":"绝伦：超过同类。没有比这更荒唐更不合情理的了。","source":{"text":"其说荒谬绝伦，更可付诸一笑。","book":"清·壮者《扫迷帚》第二回"},"example":{"text":"这促～的论调，根本不值得一驳。"},"similar":["荒诞无稽","大谬不然"],"opposite":["理所当然","天经地义"],"usage":"作谓语、宾语、定语；用于斥责他人言行荒唐"},{"id":38794,"word":"荒郊旷野","pinyin":"huāng jiāo kuàng yě","abbr":"hjky","explanation":"指人迹罕至，空旷荒凉的郊外。","source":{"text":"走荒郊旷野，把不住心娇怯，喘吁吁难将两气接。","book":"明·崔时佩《西厢记·草桥惊梦》"},"example":{"text":"我们经常去～去露营。"},"similar":["荒郊野外"],"usage":"作主语、宾语、定语；指荒凉的野外"},{"id":38795,"word":"荒郊野外","pinyin":"huāng jiāo yě wài","abbr":"hjyw","explanation":"指人迹罕至，空旷荒凉的郊外。","source":{"text":"走荒郊旷野，把不住心娇怯，喘吁吁难将两气接。","book":"明·崔时佩《西厢记·草桥惊梦》"},"example":{"text":"如今何不趁早儿告诉老当家的，将他抛弃在～，岂不省了担着心。","book":"清·石玉昆《三侠五义》第二回"},"similar":["荒郊旷野"],"usage":"作主语、宾语、定语；指荒凉的野外"},{"id":38796,"word":"荜路蓝缕","pinyin":"bì lù lán lǚ","abbr":"blll","explanation":"蓝缕：破衣服。坐着柴车，穿着破衣服，去开辟山林。形容创业的艰苦。","source":{"text":"嗟嗟若敖、蚡冒，荜路蓝缕空辛勤。","book":"宋·司马光《和王介甫巫山高》"},"example":{"text":"已由～之期，入于重熙累洽之时期。","book":"黄远庸《喜日日记》"},"similar":["筚路蓝缕"],"opposite":["坐享其成"],"usage":"作谓语、定语、状语；用于书面语"},{"id":38797,"word":"荜路蓝蒌","pinyin":"bì lù lán lóu","abbr":"blll","explanation":"筚路：柴车。坐着柴车，穿着破衣服，去开辟山林。形容创业的艰苦。","source":{"text":"荜路蓝蒌，以处草莽。","book":"西汉·司马迁《史记·楚世家》"},"similar":["筚路蓝缕"],"usage":"作谓语、定语、状语；用于书面语"},{"id":38798,"word":"荜门圭窦","pinyin":"bì mén guī dòu","abbr":"bmgd","explanation":"筚门：荆竹编成的门，又称柴门。常用以喻指贫户居室。","source":{"text":"绳枢瓮牖之室，荜门圭窦之堂，尚不然矣。","book":"《魏书·逸士传·李谧》"},"example":{"text":"我不禁暗暗称奇，不料这～中，有这等明理女子。","book":"清·吴趼人《二十年目睹之怪现状》第34回"},"similar":["筚门圭窦"],"usage":"作宾语、定语；形容穷人的住宿"},{"id":38799,"word":"荜门委巷","pinyin":"bì mén wěi xiàng","abbr":"bmwx","explanation":"荜：同“筚”；荜门：柴门；委巷：小巷。指贫苦人家居住的地方。","source":{"text":"荜门委巷之士，其势与力不足以自存矣，可谓微也。","book":"宋·叶适《廷对》"},"usage":"作宾语、定语；指贫寒的地方"},{"id":38800,"word":"荜门蓬户","pinyin":"bì mén péng hù","abbr":"bmph","explanation":"用柴草、树枝等做成的门户。形容居处简陋，生活困苦。","source":{"text":"既相招共处同居，暂离这荜门蓬户。","book":"元·柯丹邱《荆钗记·迎亲》"},"example":{"text":"野水萦纡石径斜，～两三家。","book":"明·于谦《村舍桃花》诗"}},{"id":38801,"word":"荟萃一堂","pinyin":"huì cuì yī táng","abbr":"hcyt","explanation":"荟萃：草木繁茂，引申为杰出人物或精美东西的聚集；一堂：指在一个厅堂里。形容难逢的盛会。","example":{"text":"各路豪杰～，可谓是群英会。"},"usage":"作谓语、定语；用于口语"},{"id":38802,"word":"荡为寒烟","pinyin":"dàng wéi hán yān","abbr":"dwhy","explanation":"荡：破坏，毁坏；寒：冷。指房屋等建筑物被烧毁，只剩下已经变冷的轻烟。形容彻底被毁坏，不复存在。","source":{"text":"今皆亡有，既已荡为寒烟矣。","book":"清·邵长蘅《夜游孤山记》"}},{"id":38803,"word":"荡产倾家","pinyin":"dàng chǎn qīng jiā","abbr":"dcqj","explanation":"指丧失全部家产。","source":{"text":"尽他万千挜靶，乱国家使些奸诈，少不了荡产倾家，能几日状孤做大。","book":"明·杨珽《龙膏记·脱难》"},"example":{"text":"凡狱讼征科诸巨事……其有悉索贿赂致小民～。","book":"刘师培《论新政为病民之根》"},"similar":["倾家荡产"],"usage":"作谓语、定语、补语；指破产"},{"id":38804,"word":"荡析离居","pinyin":"dàng xī lí jū","abbr":"dxlj","explanation":"荡析：离散。家人离散，没有定居。","source":{"text":"今我民用荡析离居，罔有定极。","book":"《尚书·盘庚下》"},"example":{"text":"韵书如陆法言虽以声为经，而同部者～矣。","book":"清·段玉裁《六书音韵表》一"},"similar":["流离失所","妻离子散","背井离乡"],"usage":"作谓语、定语；指家人离散，没有定居"},{"id":38805,"word":"荡检逾闲","pinyin":"dàng jiǎn yú xián","abbr":"djyx","explanation":"逾、荡：超越；闲、检：指规矩、法度。形容行为放荡，不守礼法。","source":{"text":"道家去名者，欲以笃实也，苟失其本，又有越检之行。","book":"《论语·子张》：“大德不逾头，小德出入可也。”《晋书·戴逵传》"},"example":{"text":"把他逼得房帏以内，生趣毫无，荆棘满眼，就不免在外眠花宿柳，～。（清·文康《儿女英雄传》第二十七回）"},"similar":["放荡不羁"],"usage":"作谓语、定语；形容行为放荡不检点"},{"id":38806,"word":"荡气回肠","pinyin":"dàng qì huí cháng","abbr":"dqhc","explanation":"荡：动摇；回：回转。形容文章、乐曲十分婉转动人。","source":{"text":"女娥长歌，声协宫商，感心动耳，荡气回肠。","book":"战国·楚·宋玉《高唐赋》：“感心动耳，回肠伤气。”三国·魏·曹丕《大墙上蒿行》"},"example":{"text":"这首乐曲旋律优美动人，令人～。"},"similar":["回肠荡气","感人肺腑"],"usage":"作主语、宾语、定语；指文辞等"},{"id":38807,"word":"荡海拔山","pinyin":"dàng hǎi bá shān","abbr":"dhbs","explanation":"摇动大海，拔起高山。形容力气非常大。","source":{"text":"力荡海而拔山。","book":"晋·陆机《吊魏武帝文》"}},{"id":38808,"word":"荡然一空","pinyin":"dàng rán yī kōng","abbr":"dryk","explanation":"荡：洗涤；荡然：干净的样子。全都毁坏，消失尽净。形容原有的东西完全失去或毁坏。","source":{"text":"且州之四面，属羌遭贼驱胁，荡然一空，止存孤垒，犹四肢尽废，首面心腹独存也。","book":"《宋史·杨偕传》"},"similar":["荡然无余","荡然无存"],"usage":"作谓语、状语；指消失"},{"id":38809,"word":"荡然无余","pinyin":"dàng rán wú yú","abbr":"drwy","explanation":"荡：洗涤；荡然：干净的样子。全都毁坏，消失尽净。形容原有的东西完全失去或毁坏。","source":{"text":"近灾起柏梁，遂逐渠阁，青编素简，一同煨烬，湘囊綖柣，荡然无余。","book":"南朝·梁·任昉《为梁武帝集坟籍令》"},"similar":["荡然无存","荡然一空"],"usage":"作谓语、状语；指消失"},{"id":38810,"word":"荡然无存","pinyin":"dàng rán wú cún","abbr":"drwc","explanation":"荡然：完全空无。形容东西完全失去，一点没有留下。","source":{"text":"近灾起柏梁，遂延渠阁，青编素简，一同煨尽，湘囊綖帙，荡然无存。","book":"南朝·梁·任昉《为梁武帝集坟籍令》"},"example":{"text":"使民国政制，～，澔澔新邦，悬为虚器。","book":"蔡东藩、许廑父《民国通俗演义》第五十九回"},"similar":["化为乌有","付之东流","无影无踪"],"opposite":["依然故我","完好无损","原封不动"],"usage":"作谓语、状语；指消失"},{"id":38811,"word":"荡然无遗","pinyin":"dàng rán wú yí","abbr":"drwy","explanation":"荡：洗涤；荡然：干净的样子。全都毁坏，消失尽净。形容原有的东西完全失去或毁坏。","source":{"text":"窃有所虑，因又焚之。于是图画奇迹，荡然无遗矣。","book":"《太平广记·杂编》"},"example":{"text":"《太平广记·杂编》：“窃有所虑，因又焚之。于是图画奇迹，～矣。”"},"similar":["荡然无余","荡然无存"],"usage":"作谓语、状语；指消失"},{"id":38812,"word":"荡然肆志","pinyin":"dàng rán sì zhì","abbr":"drsz","explanation":"荡：放荡；肆：放纵。放荡不羁，无拘无束。","source":{"text":"然余多其在布衣之位，荡然肆志，不屈于诸侯。","book":"《史记·鲁仲连邹阳列传》"},"example":{"text":"～，谈者不得而名焉。","book":"《汉书·叙传上》"}},{"id":38813,"word":"荡荡之勋","pinyin":"dàng dàng zhī xūn","abbr":"ddzx","explanation":"荡荡：广大的样子。指极大的功劳。","source":{"text":"荡荡之勋，可诵而不可名。","book":"《后汉书·邓皇后传》"}},{"id":38814,"word":"荡荡悠悠","pinyin":"dàng dàng yōu yōu","abbr":"ddyy","explanation":"形容飘忽不定的样子。","source":{"text":"枉费了意悬半世心，好一似荡荡悠悠三更梦。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"随风去，信路行，～。","book":"清·洪昇《长生殿·情海》"}},{"id":38815,"word":"荡荡默默","pinyin":"dàng dàng mò mò","abbr":"ddmm","explanation":"形容心神不宁的样子。","source":{"text":"北门成问于黄帝曰：‘帝张威池之乐于洞庭之野，吾始闻之惧，复闻之怠，卒闻之而惑，荡荡默默，乃不自得。’","book":"《庄子·天运》"}},{"id":38816,"word":"荡魂摄魄","pinyin":"dàng hún shè pò","abbr":"dhsp","explanation":"震撼心神。","source":{"text":"灯会自然搞得异常热烈，煊赫，每夜有新的名色，每夜有麻醉观众的荡魂摄魄的景象。","book":"叶圣陶《倪焕之》十"},"usage":"作谓语、定语；指有震撼力"},{"id":38817,"word":"荣华富贵","pinyin":"róng huá fù guì","abbr":"rhfg","explanation":"荣华：草木开花，比喻兴盛或显达。形容有钱有势。","source":{"text":"所谓贤人君子者，非必高位厚禄富贵荣华之谓也。","book":"《管子·重令》：“而群臣必通外请谒，取权道，行事便辟，以贵富为荣华以相稚也，谓之逆。”汉·王符《潜夫论·论荣》"},"example":{"text":"话说人生～，眼前的多是空花，不可认为实相。","book":"明·凌濛初《初刻拍案惊奇》二十二"},"similar":["养尊处优","金玉满堂"],"opposite":["倾家荡产","一贫如洗"],"usage":"作谓语、宾语、定语；含讽刺意味"},{"id":38818,"word":"荣古虐今","pinyin":"róng gǔ nüè jīn","abbr":"rgnj","explanation":"推崇古代，苛责现今。","source":{"text":"唐·柳宗元《与友人论为文书》：“而又荣古虐今者，比肩叠迹，大抵生则不遇，死而垂声者众焉。”一本作“荣古陋今”。"},"example":{"text":"不知诗有真本领，未可以～之见，轻为訾议也。","book":"清·赵翼《瓯北诗话·查初白诗》"},"similar":["荣古陋今"],"usage":"作宾语、定语；用于对古今的态度"},{"id":38819,"word":"荣古陋今","pinyin":"róng gǔ lòu jīn","abbr":"rglj","explanation":"推崇古代，苛责现今。同“荣古虐今”。","source":{"text":"唐·柳宗元《与友人论为文书》：“而又荣古虐今者，比肩叠迹，大抵生则不遇，死而垂声者众焉。”一本作“荣古陋今”。"},"similar":["荣古虐今"],"usage":"作宾语、定语；用于对古今的态度"},{"id":38820,"word":"荣宗耀祖","pinyin":"róng zōng yào zǔ","abbr":"rzyz","explanation":"为祖先增添光荣。旧指光耀门庭。","source":{"text":"做官怕不是荣宗耀祖的事，我看见这些做官的都不见有甚好收场。","book":"清·吴敬梓《儒林外史》第一回"},"example":{"text":"这孩子前程不可限量！这孩子将来一定要～的！","book":"蒋光慈《鸭绿江上·弟兄夜话》"},"similar":["光宗耀祖","光前裕后"],"usage":"作谓语、定语；指为祖先增添光荣"},{"id":38821,"word":"荣谐伉俪","pinyin":"róng xié kàng lì","abbr":"rxkl","explanation":"祝人夫妇和谐美好。","source":{"text":"贺人娶妻曰荣谐伉俪。","book":"明·丘浚《成语考·夫妇》"},"usage":"作宾语；用于祝贺结婚"},{"id":38822,"word":"荣辱与共","pinyin":"róng rǔ yǔ gòng","abbr":"rryg","explanation":"两者共同分享荣耀和耻辱。指关系十分密切。","example":{"text":"这是你我～的事，得慎重对待。"},"usage":"作谓语、定语；用于处事"},{"id":38823,"word":"荣辱升沉","pinyin":"róng rǔ shēng chén","abbr":"rrsc","explanation":"指仕途中提升、贬谪、荣耀、屈辱等种种境遇。","source":{"text":"荣辱升沉影与身，世情谁是旧雷陈。","book":"唐·元稹《寄乐天二首》其一"},"example":{"text":"她的感情和思虑，都被后宫的大事，自己的～吸引了。","book":"凌力《少年天子》第一章"}},{"id":38824,"word":"荣辱得失","pinyin":"róng rǔ dé shī","abbr":"rrds","explanation":"荣耀和耻辱，得到和失去。","source":{"text":"把自己融合于党的事业之中，毫无个人荣辱得失的考虑，真正达到了忘我的境界。","book":"邓小平《悼伯承》"},"example":{"text":"邓小平《悼伯承》：“把自己融合于党的事业之中，毫无个人～的考虑，真正达到了忘我的境界。”"},"usage":"作宾语、定语；用于口语"},{"id":38825,"word":"荦荦大端","pinyin":"luò luò dà duān","abbr":"lldd","explanation":"荦荦：清楚、分明的样子。指主要的项目，明显的要点。","source":{"text":"此其荦荦大者，若至委曲小变，不可胜道。","book":"《史记·天官书》"},"example":{"text":"今之言变法者，其～，必曰练兵也，开矿也，通商也。","book":"清·梁启超《变法通议·论变法不知本原之害》"},"similar":["荦荦大者"],"opposite":["鸡毛蒜皮"],"usage":"作主语、宾语；指要点"},{"id":38826,"word":"荦荦大者","pinyin":"luò luò dà zhě","abbr":"lldz","explanation":"荦荦：明显。指明显的重大的方面。","source":{"text":"此其荦荦大者。若至委曲小变，不可胜道。","book":"西汉·司马迁《史记·天官书》"},"example":{"text":"今天讲的内容很多，我们抓住～就行。"},"similar":["举足轻重"],"opposite":["可有可无","无足轻重","鸡毛蒜皮"],"usage":"作主语、宾语；指重大方面"},{"id":38827,"word":"荦荦确确","pinyin":"luò luò què què","abbr":"llqq","explanation":"形容骨节突露瘦硬。","source":{"text":"翻翻联联衔尾鸦，荦荦确确蜕骨蛇。","book":"宋·苏轼《无锡道中赋水车》诗"}},{"id":38828,"word":"荫子封妻","pinyin":"yìn zǐ fēng qī","abbr":"yzfq","explanation":"妻子得到封号，子孙获得世袭官爵。指建立功业，光耀门庭。","source":{"text":"我暂把洛阳绕一遭，专等你捷音来报。那时节呵重叠的荫子封妻恩不小。","book":"明·汤显祖《邯郸记·东巡》"},"example":{"text":"清·褚人获《隋唐演义》第四回：“我累代将家，若得志，为国家提一枝兵马，斩将搴旗，开疆展土，博一个荣封父母，～。”"},"similar":["封妻荫子"],"usage":"作谓语、定语、分句；指世袭特权"},{"id":38829,"word":"药到病除","pinyin":"yào dào bìng chú","abbr":"ydbc","explanation":"药一服下病就好了。形容用药效果非常好。","source":{"text":"药到病除，效如桴鼓。","book":"张锡纯《医学衷中参西录》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“闲话少说，这件事办得要快，‘～’，不宜耽误！”"},"similar":["手到病除"],"usage":"作谓语、宾语；指人的医术"},{"id":38830,"word":"药店飞龙","pinyin":"yào diàn fēi lóng","abbr":"ydfl","explanation":"飞龙：指中药龙骨。药店里的龙骨。比喻人瘦骨嶙峋。","source":{"text":"旧作琴台凤，今为药店龙。","book":"南朝宋乐府《读曲歌》：“自从别郎后，卧宿头不举，飞龙落药店，骨出只为汝。”唐·李商隐《垂柳》诗"},"similar":["药店龙"],"usage":"作宾语；指人消瘦"},{"id":38831,"word":"药店龙","pinyin":"yào diàn lóng","abbr":"ydl","explanation":"药店里的龙骨。比喻人瘦骨嶙峋","source":{"text":"旧作琴台凤，今为药店龙。","book":"唐·李商隐《垂柳》诗"},"similar":["药店飞龙"],"usage":"作宾语；指人消瘦"},{"id":38832,"word":"药石之言","pinyin":"yào shí zhī yán","abbr":"yszy","explanation":"药石：治病的药物和砭石，泛指药物。比喻劝人改过的话。药石：治病的药物和砭石，泛指药物。比喻劝人改过的话。","source":{"text":"臧孙曰：‘季孙之爱我，疾疢也。孟孙之恶我，药石也。美疢不如恶石。’","book":"《左传·襄公二十三年》"},"example":{"text":"高季辅尝谏时政得失，太宗特赐钟一剂日：“进～，故以药石相报。”","book":"宋·孔平仲《续世说·直谏》"},"usage":"作宾语；比喻诚意劝人改过的良言"},{"id":38833,"word":"药石无功","pinyin":"yào shí wú gōng","abbr":"yswg","explanation":"药石：治病的药物和石针，泛指药物；功：功用，效验。药物已经起不到作用。形容人病情严重，无法医治。","source":{"text":"朕以菲薄，获奉宗祧，十有四年，未臻至理，惟天示遣，降疚于躬，药石无功，弥留斯迫。","book":"唐·宣宗《命皇太子即位文》"}},{"id":38834,"word":"药石无效","pinyin":"yào shí wú xiào","abbr":"yswx","explanation":"药石：治病的药物和石针，泛指药物。药物已经起不到作用。形容人病情严重，无法医治。","source":{"text":"朕以菲薄，获奉宗祧，十有四年，未臻至理，惟天示遣，降疚于躬，药石无功，弥留斯迫。","book":"唐·宣宗《命皇太子即位文》"},"example":{"text":"蔡的喉疾和肺病，因拖延过久，抵达日本后已是病入膏肓，群医束手，～。","book":"丁中江《北洋军阀史话》一百"},"similar":["病入膏肓"],"usage":"作谓语、定语；用于书面语"},{"id":38835,"word":"药笼中物","pinyin":"yào lóng zhōng wù","abbr":"ylzw","explanation":"药笼中备用的药材。比喻备用的人才。","source":{"text":"君正吾药笼中物，不可一日无也。","book":"《新唐书·儒学传下·元行冲》"},"example":{"text":"章、闻二公既有异才，终究是老师～，何必介介呢？","book":"曾朴《孽海花》第13回"},"usage":"作宾语；比喻备用的人才"},{"id":38836,"word":"药笼中需","pinyin":"yào lóng zhōng xū","abbr":"ylzx","explanation":"药笼：放药材的用具。药笼中需要储备的东西。比喻储备人才的需要。","source":{"text":"给馈饷，镇关中，自是斯世金城之重；求文武，致幕府，将为异时药笼之需。","book":"宋·李曾伯《可斋杂稿·谢京西漕请举书》"}},{"id":38837,"word":"荷枪实弹","pinyin":"hé qiāng shí dàn","abbr":"hqsd","explanation":"荷：扛。扛着枪，上了子弹。形容全副武装，准备投入战斗。","source":{"text":"冲要的马路和街道忽然密布了荷枪实弹的武装岗位。","book":"杨沫《青春之歌》第一部第七章"},"example":{"text":"一到村头，就看见围子墙上岗哨严密，青年民兵们～的来往巡逻着。","book":"峻青《李家埠·在战斗》"},"similar":["持枪实弹","枕戈待旦","披坚执锐"],"opposite":["赤手空拳","手无寸铁"],"usage":"作谓语、定语、状语；形容高度警戒"},{"id":38838,"word":"荷花虽好，也要绿叶扶持","pinyin":"hé huā suī hǎo，yě yào lǜ yè fú chí","abbr":"hhshyylyfc","explanation":"比喻人才能出众也须大家的支持。","source":{"text":"人是要帮助的。‘荷花虽好，也要绿叶扶持’。","book":"毛泽东《在中国共产党全国代表会议上的讲话》"},"example":{"text":"个人的力量是有限的，～。"},"usage":"作宾语、定语；用于劝诫人"},{"id":38839,"word":"荻塘女子","pinyin":"dí táng nǚ zǐ","abbr":"dtnz","explanation":"鹭的一种别称。","source":{"text":"东坡诗称鹭为雪衣儿，杜牧赋称风标公子，《广记》云，获塘女子。","book":"清·厉荃《事物异名录·禽鸟·鹭鸶》"}},{"id":38840,"word":"荼毒生民","pinyin":"tú dú shēng mín","abbr":"tdsm","explanation":"荼毒：毒害，残害。指残害人民。","source":{"text":"秦起长城，竟海为关，荼毒生民，万里朱殷。","book":"唐·李华《吊古战场文》"},"similar":["荼毒生灵"],"usage":"作谓语、定语；指残害人民"},{"id":38841,"word":"荼毒生灵","pinyin":"tú dú shēng líng","abbr":"tdsl","explanation":"荼毒：毒害、残害；生灵：指百姓。指残害人民。","source":{"text":"荼毒生灵，万里朱殷。","book":"《尚书·汤诰》：“罹其凶害，弗忍荼毒。”唐·李华《吊古战场文》"},"example":{"text":"听说，后来玉皇大帝也就怪法海多事，以至～，想要拿办他了。","book":"鲁迅《坟·论雷峰塔的倒掉》"},"similar":["生灵涂炭","荼毒生民"],"opposite":["爱民如子"],"usage":"作谓语、定语；指残害人民"},{"id":38842,"word":"莘莘学子","pinyin":"shēn shēn xué zǐ","abbr":"ssxz","explanation":"莘莘：众多的样子。众多的学生。","source":{"text":"这群莘莘学子，长期苦无出路及至科举废止，游学成风，他们便大批地来到日本。","book":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》"},"usage":"作主语、宾语、定语；指学生"},{"id":38843,"word":"莞尔而笑","pinyin":"wǎn ěr ér xiào","abbr":"weex","explanation":"形容微笑的样子。","source":{"text":"渔父莞尔而笑，鼓枻而去。","book":"战国·楚·屈原《楚辞·渔父》"},"example":{"text":"她对我～，我不明白她的意思。"},"similar":["莞然一笑"],"usage":"作谓语；指微笑的样子"},{"id":38844,"word":"莞然一笑","pinyin":"wǎn rán yī xiào","abbr":"gryx","explanation":"形容微笑的样子","source":{"text":"形容微笑的样子。"},"example":{"text":"她～，就走进了登机门。"},"similar":["莞尔而笑"],"usage":"作谓语；多用于女性"},{"id":38845,"word":"莞然而笑","pinyin":"wǎn rán ér xiào","abbr":"grex","explanation":"形容微笑的样子。","source":{"text":"渔父莞尔而笑，鼓泄而去。","book":"《楚辞·渔父》"},"example":{"text":"邕～曰：“此足以当之矣。”","book":"《后汉书·蔡邕传》"}},{"id":38846,"word":"莫不逾侈","pinyin":"mò bù yú chǐ","abbr":"mbyc","explanation":"莫：没有谁；逾：超越，引申为过度；侈：奢侈。没有谁不会过度奢侈。","source":{"text":"时天下承平日久，自王侯以下，莫不逾侈。","book":"南朝·宋·范晔《后汉书·张衡传》"},"usage":"作谓语、分句；用于书面语"},{"id":38847,"word":"莫为已甚","pinyin":"mò wéi yǐ shèn","abbr":"mwys","explanation":"不做得太过分。多指对人的责备或责罚适可而止。","example":{"text":"在好的方面讲，这就是中国人之平等主义，无论何人总须替对方留一点脸面，～。","book":"林语堂《脸与法治》"}},{"id":38848,"word":"莫之与京","pinyin":"mò zhī yǔ jīng","abbr":"mzyj","explanation":"莫：没有什么，没有谁；京：大。大得没有能跟它相比的。形容极大。","source":{"text":"有妫之后，将育于姜。五世其昌，并于正卿。八世之后，莫之与京。","book":"《左传·庄公二十二年》"},"example":{"text":"弟兄姻媾皆甲门，内外隆盛，～。","book":"唐·白行简《李娃传》"},"usage":"作谓语；用于书面语"},{"id":38849,"word":"莫之谁何","pinyin":"mò zhī shuí hé","abbr":"mzsh","explanation":"莫：没有。指没有谁敢对他怎么样。","source":{"text":"今倭贼冯陵，所在莫之谁何。","book":"明·归有光《备倭事略》"},"similar":["莫敢谁何"],"usage":"作分句；指没有谁敢对他怎么样"},{"id":38850,"word":"莫予毒也","pinyin":"mò yù dú yě","abbr":"mydy","explanation":"再也没有人威胁、危害我了。表示目空一切，认为谁也不能伤害我。","source":{"text":"晋侯闻之而后喜可知也，曰：‘莫余毒也已。’","book":"《左传·僖公二十八年》"},"example":{"text":"无论他们如何得势，如何兴高采烈，以为天下“～”，然而他们的命运是最后一定要受到全国人民的制裁的。","book":"毛泽东《反对投降活动》"},"similar":["目空一切"],"usage":"作谓语、宾语；指为所欲为","story":["公元前633年，楚成王率陈、蔡两国的军队进攻宋国。宋国向晋国求救，晋文公出兵进攻楚国的盟国曹、卫两国，楚军北上并且大败，楚王对统帅子玉十分不满，就命他自杀。晋文公听到子玉自杀的消息高兴地说没有人能加害于他了"]},{"id":38851,"word":"莫余毒也","pinyin":"mò yú dú yě","abbr":"mydy","explanation":"再也没有人威胁、危害我了。表示目空一切，认为谁也不能伤害我。","source":{"text":"晋侯闻之而后喜可知也，曰：‘莫余毒也已。’","book":"《左传·僖公二十八年》"}},{"id":38852,"word":"莫信直中直，须防人不仁","pinyin":"mò xìn zhí zhōng zhí,xū fáng rén bù rén","abbr":"mxzzzxfrbr","explanation":"直：公正，正直。不能简单地相信别人很正直，而应当提防他存心不良。","source":{"text":"素姐道：‘莫信直中直，须防人不仁。拿天平来，我把这银子兑兑。’","book":"清·西周生《醒世姻缘传》第16回"},"example":{"text":"清·西周生《醒世姻缘传》第16回：“素姐道：‘～。拿天平来，我把这银子兑兑。’”"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":38853,"word":"莫信直中直，须防仁不仁","pinyin":"mò fáng zhí zhōng zhí，xū fáng rén bù rén","abbr":"mxzzzxfrbr","explanation":"直：正直；不仁：不讲道义。不要相信表面上的正直，要防备别人心存不良。","source":{"text":"莫信直中直，须防仁不仁。","book":"《增广贤文》"},"example":{"text":"～。拿天平来，我把这银子兑兑。","book":"清·西周生《醒世姻缘传》第九十六回"}},{"id":38854,"word":"莫兹为甚","pinyin":"mò zī wéi shèn","abbr":"mzws","explanation":"莫：无；甚：严重，超过。没有什么能超过这个的了。","source":{"text":"亏体伤风，莫兹为甚。","book":"《宋史·谢绛传》"},"similar":["莫此为甚","莫此之甚","莫斯为甚"],"usage":"作分句；多指不良倾向或形势严重"},{"id":38855,"word":"莫可名状","pinyin":"mò kě míng zhuàng","abbr":"mkmz","explanation":"名：用言语说出；状：描绘，形容。不能用言语来形容。指事物极复杂微妙，无法描述。","source":{"text":"少选复出，则一国色丽人，云鬟靓妆，袅袅婷婷而至，衣皆鲛绡雾縠，亦无缝缀之迹，香气飘扬，莫可名状，自称为林四娘。","book":"清·张潮《虞初新志·林四娘记》"},"example":{"text":"这信该收束了，我心中～，我觉得非常的荣幸！","book":"冰心《寄小读者·通讯一》"},"similar":["不可名状"],"usage":"作谓语、定语、补语；指无法用言语来形容"},{"id":38856,"word":"莫可奈何","pinyin":"mò kě nài hé","abbr":"mknh","explanation":"犹无可奈何。指感到没有办法，只有这样了。","source":{"text":"他们见了凤凰要说是鸡，见了麒麟要说是驴马，我也把他们莫可奈何。","book":"郭沫若《女神·湘累》"},"example":{"text":"‘你可不能不这样想啦！’吴楣说，～的叹了口气。","book":"沙丁《困兽记》六"},"similar":["无可奈何","无可如何"],"usage":"作谓语、宾语、定语、状语；形容毫无办法"},{"id":38857,"word":"莫可究诘","pinyin":"mò kě jiū jié","abbr":"mkjj","explanation":"究：追查；诘：追问。无法追问到底。","source":{"text":"千里行人，死不见尸，数客同游，全无音信，积案累累，莫可究诘。","book":"清·蒲松龄《聊斋志异·老龙船户》"},"example":{"text":"宗支荒忽，～。","book":"清·章炳麟《驳康有为论革命书》"},"usage":"作分句；用于书面语"},{"id":38858,"word":"莫名其妙","pinyin":"mò míng qí miào","abbr":"mmqm","explanation":"说不出其中的奥妙。指事情很奇怪，说不出道理来。","source":{"text":"我实在是莫名其妙，我从那时得着这么一个门生，连我也不知道。","book":"清·吴趼人《二十年目睹之怪现状》第十五回"},"example":{"text":"这个人与众不同，常有些令人～的惊人之举。"},"similar":["莫明其妙"],"opposite":["洞若观火"],"usage":"作谓语、定语、状语；常与“让人”等连用"},{"id":38859,"word":"莫展一筹","pinyin":"mò zhǎn yī chóu","abbr":"mzyc","explanation":"一点计策也施展不出，一点办法也想不出来。同“一筹莫展”。","source":{"text":"本兵错愕惶惑，莫展一筹。","book":"明·张居正《与王鉴川计四事四要书》"},"example":{"text":"勒保经略半载，～。","book":"清·魏源《圣武记》卷九"},"similar":["一筹莫展"],"opposite":["神通广大","大显身手"],"usage":"作谓语、定语、补语；指无计可施"},{"id":38860,"word":"莫措手足","pinyin":"mò cuò shǒu zú","abbr":"mcsz","explanation":"措：安放。手脚不知放到哪儿好。形容举动慌张，或无法应付。","source":{"text":"天下嗷嗷，莫措手足。","book":"《明史·杨守随传》"},"similar":["手足无措","手脚无措"],"usage":"作谓语、状语、定语；指慌乱"},{"id":38861,"word":"莫敢仰视","pinyin":"mò gǎn yǎng shì","abbr":"mgys","explanation":"仰：抬头。不敢抬头看。形容被对方的声势所压倒。","source":{"text":"于是已破破秦军，项羽召诸侯将，入辕门，无不膝行而前，莫敢仰视。","book":"《史记·项羽本纪》"},"example":{"text":"乃命娃出，明眸皓腕，举步冶艳。生遽惊起，～。","book":"唐·白行简《李娃传》"},"usage":"作谓语、定语；指对方的声势等"},{"id":38862,"word":"莫敢谁何","pinyin":"mò gǎn shuí hé","abbr":"mgsh","explanation":"没有谁敢怎么样。","source":{"text":"信臣精卒，陈利兵而谁何。","book":"汉·贾谊《过秦论》"},"example":{"text":"争奈董卓弄权，将危汉室，群臣畏惧，～。","book":"元·无名氏《连环计》第一折"},"similar":["莫之谁何"],"usage":"作分句；指没有谁敢对他怎么样"},{"id":38863,"word":"莫斯为甚","pinyin":"mò sī wéi shèn","abbr":"msws","explanation":"莫：无；甚：严重，超过。没有什么能超过这个的了。","source":{"text":"玷辱流辈，莫斯为甚。自古巨舋，莫斯为甚。","book":"南朝·宋·沈约《奏弹王源》"},"similar":["莫此为甚","莫此之甚","莫兹为甚"],"usage":"作分句；多指不良倾向或形势严重"},{"id":38864,"word":"莫明其妙","pinyin":"mò míng qí miào","abbr":"mmqm","explanation":"说不出其中的奥妙。指事情很奇怪，说不出道理来。","source":{"text":"魏翩仞莫明其妙，陶子尧却不免心上一呆。","book":"清·李宝嘉《官场现形记》第十回"},"example":{"text":"这个人与众不同，常有些令人～的惊人之举。"},"similar":["莫名其妙"],"opposite":["洞若观火"],"usage":"作谓语、定语、状语；形容事情非常奇怪"},{"id":38865,"word":"莫此为甚","pinyin":"mò cǐ wéi shèn","abbr":"mcws","explanation":"莫：没有什么；甚：超过。没有什么能超过这个的了。多指不良倾向或形势严重。","source":{"text":"只如扬州税额已增不亏，而数小吏为虐不已，原其情，盖为有条许酒税监管分请增剩赏钱，此元丰中一小人建议，羞污士风，莫此为甚。","book":"宋·苏轼《扬州上吕相书》"},"example":{"text":"颠倒彝伦，～。","book":"明·朱国桢《涌幢小品·启圣祠》"},"similar":["莫此之甚","莫斯为甚","莫兹为甚"],"usage":"作分句；多指不良倾向或形势严重"},{"id":38866,"word":"莫此之甚","pinyin":"mò cǐ zhī shèn","abbr":"mczs","explanation":"莫：无；甚：严重，超过。没有什么能超过这个的了。","source":{"text":"损败风化，渎乱情礼，莫此之甚。","book":"《魏书》"},"similar":["莫此为甚","莫斯为甚","莫兹为甚"],"usage":"作分句；多指不良倾向或形势严重"},{"id":38867,"word":"莫测高深","pinyin":"mò cè gāo shēn","abbr":"mcgs","explanation":"高深的程度无法揣测。指处世的态度、或说话、文章的内容（多不用在正面，带贬义）。","source":{"text":"吏民莫能测其意深浅。","book":"《汉书·严延年传》"},"example":{"text":"知县当然别有我们所～的妙法在。","book":"鲁迅《华盖集·这个与那个》"},"similar":["故弄玄虚","高深莫测"],"opposite":["胸无城府"],"usage":"作谓语、定语；指人或事物","story":["西汉时期，刚正不阿的涿郡太守严延年到任不久，听说地方高氏家族无恶不作，就派属官赵绣前去查办。赵绣想暗中包庇被严延年斩首。严延年断案与其他官员不同，专门治那些地方豪强。不论官吏还是老百姓都不能揣测出他的真实心思"]},{"id":38868,"word":"莫知所为","pinyin":"mò zhī suǒ wéi","abbr":"mzsw","explanation":"不知道怎幺办好，形容激动得不知怎幺办。亦作“莫知所谓”。","source":{"text":"是时温将废海西公，百僚震栗，温亦色动，莫知所为。","book":"《晋书·王廙传》"},"example":{"text":"三月朔，列牍请署，后决以三月三日御殿听政，乃立署之，众大喜，～。","book":"《元史·哈刺哈孙传》"},"similar":["莫知所谓"],"usage":"作谓语、状语、补语；指处境很为难"},{"id":38869,"word":"莫知所措","pinyin":"mò zhī suǒ cuò","abbr":"mzsc","explanation":"措：安置，处理。不知道怎么办才好。形容处境为难或心神慌乱。","source":{"text":"忽因昼寝，梦坐烟霞之境，四顾而望，熊罴虎豹，围绕周匝，莫知所措。","book":"宋·张君房《云笈七签》第119卷"},"similar":["不知所措"],"opposite":["应付自如"],"usage":"作谓语、状语、补语；指处境很为难"},{"id":38870,"word":"莫知所谓","pinyin":"mò zhī suǒ wèi","abbr":"mzsw","explanation":"莫：不。不知道怎么办才好。","source":{"text":"义熙三年中，小儿相逢于道，辄举其两手曰‘卢健健’，次曰‘斗叹斗叹’，末复曰‘翁年老，翁年老’。当时莫知所谓。","book":"《宋书·五行志二》"},"example":{"text":"至若前所示《兵鉴》，则读之终篇，～。","book":"宋·苏轼《与李方叔书》"},"similar":["莫知所为"],"usage":"作谓语、状语、补语；指处境很为难"},{"id":38871,"word":"莫神与天，莫富于地","pinyin":"mò shén yǔ tiān，mò fù yú dì","abbr":"msytmfyd","explanation":"没有什么比天更神奇，没有什么比地更富有。指天地养育万物。","source":{"text":"天不产而万物化，地不长而万物有，帝王无为而天下功。故曰：莫神于天，莫富于地，莫大于帝王。","book":"《庄子·天道》"}},{"id":38872,"word":"莫衷一是","pinyin":"mò zhōng yī shì","abbr":"mzys","explanation":"不能决定哪个是对的。形容意见分歧，没有一致的看法。","source":{"text":"诸将或言固守待援，或言决一死战，或言到临安求救。议论纷纷，莫衷一是。","book":"清·吴趼人《痛史》第三回"},"example":{"text":"人们议论纷纷，～。"},"similar":["无所适从"],"opposite":["一针见血"],"usage":"作谓语、定语；用于书面语"},{"id":38873,"word":"莫衷壹是","pinyin":"mò zhōng yī shì","abbr":"mzys","explanation":"莫：不，还是；衷：折衷，断定；是：对。不知哪个是正确。形容意见分歧，没有一致的看法。","source":{"text":"主张个人主义者，莫不反对社会主义，主张社会主义者，又莫不反对个人主义，聚讼纷纭，莫衷壹是。","book":"孙中山《社会主义之演讲》"},"similar":["莫衷一是","没衷一是"],"usage":"作谓语、定语；用于书面语"},{"id":38874,"word":"莫见乎隐，莫显乎微","pinyin":"mò xiàn hū yǐn，mò xiǎn hū wēi","abbr":"mjhymxhw","explanation":"见：同“现”；显：显现。极隐秘、极细微之处没有不显现出来的。","source":{"text":"莫见乎隐，莫显乎微，故君子慎其独也。","book":"《礼记·中庸》"},"example":{"text":"惠老是画匠，如医书上会画那～的心肝叶儿。","book":"清·李绿园《歧路灯》第三十九回"},"usage":"作定语、分句；用于书面语"},{"id":38875,"word":"莫踬于山，而踬于垤","pinyin":"mò zhì yú shān，ér zhì yū dié","abbr":"mzysezyd","explanation":"踬：绊倒；垤：小土堆。没有因登山而绊倒，反而被小土堆绊倒了。比喻小问题常易被忽略，因而赞成错误。也指在小事上出了大差错。","source":{"text":"人莫踬于山而踬于垤，是故人皆轻小害，易微事，以多悔。","book":"《淮南子·人间训》"},"example":{"text":"我笑对她说，你这所谓“～”了，她也为之掩口葫芦。","book":"功雪林《劳山二日游》七"}},{"id":38876,"word":"莫辨楮叶","pinyin":"mò biàn chǔ yè","abbr":"mbcy","explanation":"莫：不；辨：分辨。不能分辨楮叶的真假。比喻模仿逼真或以假乱真。","source":{"text":"宋人有为其君以象为楮叶者，三年而成。丰杀茎柯，毫芒繁泽，乱之楮叶之中而不可别也。","book":"《韩非子·喻老》"},"usage":"作定语、状语；用于书面语"},{"id":38877,"word":"莫逆之交","pinyin":"mò nì zhī jiāo","abbr":"mnzj","explanation":"莫逆：没有抵触，感情融洽；交：交往，友谊。指非常要好的朋友。","source":{"text":"四人相视而笑，莫逆于心，遂相与为友。","book":"《庄子·大宗师》"},"example":{"text":"少与崔浩为～。","book":"《北史·眭夸传》"},"similar":["生死之交","莫逆于心","莫逆之友"],"opposite":["一面之交"],"usage":"作宾语；指好朋友","story":["战国时期，哲学家庄子讲到子祀、子兴、子犁、子来四人交谈说：“谁能以无为头脑，以有为脊背，以死为屁股，知道死生存亡为一体就可以成为朋友。”四人相视而笑，觉得莫逆于心，就相互结为好朋友"]},{"id":38878,"word":"莫逆之友","pinyin":"mò nì zhī yǒu","abbr":"mnzy","explanation":"莫：没有；逆：抵触。指非常要好或情投意合的朋友。","source":{"text":"与乐安孙树仁为莫逆之友，每易衣而出。","book":"《周书·张轨传》"},"similar":["莫逆之交"],"usage":"作宾语；指好朋友"},{"id":38879,"word":"莫逆之契","pinyin":"mò nì zhī qì","abbr":"mnzq","explanation":"莫逆：没有抵触；契：相合。指朋友之间情投意切，心心相印的深厚友情。","source":{"text":"与先帝隆布衣之好，著莫逆之契。","book":"晋·范弘之《与王珣书》"},"example":{"text":"～，义等于天伦；不腆之辞，意勤于地主。","book":"宋·苏轼《寒食宴提刑致语口号》"}},{"id":38880,"word":"莫逆于心","pinyin":"mò nì yú xīn","abbr":"mnyx","explanation":"心中没有抵触。指情感一致，心意相投。","source":{"text":"三人相视而笑，莫逆于心，遂相与为友。","book":"战国·宋·庄周《庄子·大宗师》"},"example":{"text":"此王与导之得意忘言而～者也。","book":"清·王夫之《读通鉴论·晋惠帝》"},"similar":["情投意合","莫逆之交"],"opposite":["貌合神离"],"usage":"作谓语、定语；指情感一致，心意相投"},{"id":38881,"word":"莫逆交","pinyin":"mò nì jiāo","abbr":"mnj","explanation":"莫：没有；逆：抵触；交：交往，友谊。指非常要好或情投意合的朋友。","source":{"text":"原来胡元炜，本与钱江是个同学中人，少年各抱大志，为莫逆交。","book":"《洪秀全评传》第11回"},"similar":["莫逆之交"],"usage":"作宾语；指好朋友"},{"id":38882,"word":"莫道君行早，更有早行人","pinyin":"mò dào jūn xíng zǎo，gèng yǒu zǎo xíng rén","abbr":"mdjxzgyzxr","explanation":"多指办事情已被别人抢先下手了。","source":{"text":"谓言侵早起，更有夜行人。","book":"宋·释道原《景德传灯录》卷二十二"}},{"id":38883,"word":"莫道桑榆晚，为霞尚满天","pinyin":"mò dào sāng yú wǎn，wéi xiá shàng mǎn tiān","abbr":"mdsywwxsmt","explanation":"桑榆：指太阳到了桑榆星附近，比喻晚年。不要说岁数已大，将落的太阳还能放出满天霞光。比喻老当益壮，老有所为，积极进取。","source":{"text":"细想皆幸矣，下此便翛然。莫道桑榆晚，为霞尚满天。","book":"唐·刘禹锡《酬乐天咏老见示》"}},{"id":38884,"word":"莫邪钝，铅刀铦","pinyin":"mò yé dùn，qiān dāo xiān","abbr":"mxdqdx","explanation":"莫邪：古代名剑；铅刀：铅制的刀；铦：锋利。认为莫邪不锋利，反而认为铅刀锋利。比喻把有才德的人弃置不用，而用品质不好的人。","source":{"text":"世谓随夷为溷兮，谓跖蹻为廉。莫邪为钝兮，铷刀为铦。","book":"汉·贾谊《吊屈原文》"}},{"id":38885,"word":"莫须有","pinyin":"mò xū yǒu","abbr":"mxy","explanation":"原意是也许有吧。后指凭空捏造。","source":{"text":"飞子云与张宪书虽不明，其事体莫须有。","book":"《宋史·岳飞传》"},"example":{"text":"看来许之罪其实是‘～’的，大约有人欲得而甘心，故有此辣手。","book":"鲁迅《书信集·致许寿裳》"},"similar":["凭空捏造"],"opposite":["确凿无疑"],"usage":"作谓语、补语、定语；指凭空捏造诬陷","story":["南宋时期，岳飞率领岳家军英勇抗击金军的侵略，所向披靡。金军闻风丧胆，指使投诚的秦桧回南宋朝廷，离间岳飞君臣的关系。岳飞父子等被秦桧诬陷治罪，韩世忠心中不平，责问秦桧。秦桧说：“飞子云与张宪书虽不明，其事体莫须有。"]},{"id":38886,"word":"莲耦同根","pinyin":"lián ǒu tóng gēn","abbr":"lotg","explanation":"比喻有血肉亲缘关系。"},{"id":38887,"word":"莲花步步生","pinyin":"lián huā bù bù shēng","abbr":"lhbbs","explanation":"莲花：荷花。形容女子步态轻盈。","source":{"text":"人道公门不可入，我道公门多修行。若将曲直无颠倒，脚底莲花步步生。","book":"元·岳伯川《铁拐李》第二折"},"similar":["步步生莲花"],"usage":"作谓语；用于女子步态"},{"id":38888,"word":"获保首领","pinyin":"huò bǎo shǒu lǐng","abbr":"hbsl","explanation":"首领：头颈，脑袋。保住脑袋。指善终。","source":{"text":"得保首领以没。","book":"《左传·隐公三年》"}},{"id":38889,"word":"获兔烹狗","pinyin":"huò tù pēng gǒu","abbr":"htpg","explanation":"比喻事成之后排斥以至杀害有功之臣。亦作“狡兔死，良狗烹”。","source":{"text":"南洋一带，苟微华人，必不有今日。今虽获兔烹狗，得鱼忘筌。","book":"梁启超《论中国之将强》"},"example":{"text":"你要小心他干～的事。"},"similar":["过河拆桥","狡兔死，走狗烹"],"usage":"作谓语、定语；同“过河拆桥”","story":["春秋末期，楚国的范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，终于使越国强大，最后灭了吴国。范蠡深知勾践的为人就到齐国隐姓埋名经商，他写信劝文种离开说：“狡兔死，走狗烹”。文种不信后被勾践所杀"]},{"id":38890,"word":"获陇望蜀","pinyin":"huò lǒng wāng shǔ","abbr":"hlws","explanation":"比喻得寸进尺，贪得无厌。","source":{"text":"两城若下，便可带兵南击蜀虏。人苦不知足，既平陇，复望蜀。","book":"《后汉书·岑彭传》载：东汉初年，隗器和公孙述分别割据于陇、蜀两地，光武帝刘秀使岑彭等率军攻打隗器所占的西城、上邽两地，并在给岑彭的信中说"},"example":{"text":"其奈得入尺、～者，既眈眈相逼乎前，而政府之慑狐威者，今日许以寸，明日予以尺；民间之贪蝇利者……。","book":"梁启超《论民族竞争之大势》"},"similar":["得陇望蜀"],"usage":"作谓语、宾语；指人贪心不足","story":["东汉时期，刘秀当了皇帝后，西部巴蜀蜀王公孙述及陇西的隗嚣对东汉的威胁很大，光武帝建武八年，刘秀亲率大军讨伐隗嚣，隗嚣大败逃西域。刘秀命令大将实施他的“得陇望蜀”的计划，继而进攻巴蜀，势如破竹，消灭了蜀王，使巴蜀归汉"]},{"id":38891,"word":"获隽公车","pinyin":"huò jūn gōng chē","abbr":"hjgc","explanation":"汉代曾以公家车马送应举的人，后以公车指入京应试的人。“获隽公车”为会试得中的意思。","source":{"text":"学生自蒙慨赠到都，托庇获隽公车。受任贵乡，始知老先生超悟尘凡，飘举仙境。","book":"《红楼梦》第一○三回"},"similar":["金榜题名"],"usage":"作谓语、宾语；指考试得中"},{"id":38892,"word":"莺俦燕侣","pinyin":"yīng chóu yàn lǚ","abbr":"ycyl","explanation":"莺、燕：比喻女子；俦：伴侣。指男子的妻室或情侣。","source":{"text":"你自有莺俦燕侣，我从今万事不关心。","book":"元·关汉卿《鲁斋郎》第三折"},"example":{"text":"岂可为～三春约，忘却你鹏路鹍程万里遥。","book":"明·徐复祚《红梨记·诗要》"},"usage":"作宾语、定语；指情侣"},{"id":38893,"word":"莺吟燕儛","pinyin":"yīng yín yàn sāi","abbr":"yyyw","explanation":"形容春天鸟儿喧闹活跃的景象。现常比喻革命和建设蓬勃兴旺的景象。同“莺歌燕舞”。"},{"id":38894,"word":"莺吟燕舞","pinyin":"yīng yín yàn wǔ","abbr":"yyyw","explanation":"黄莺在歌唱，小燕子在飞舞。形容春天鸟儿喧闹活跃的景象。现常比喻蓬勃兴旺的景象。","source":{"text":"日丽风和熏协气，莺吟燕舞皆欢意。","book":"宋·卢炳《满江红·贺赵县丞》"},"similar":["莺歌燕舞"],"usage":"作谓语、定语；形容形势"},{"id":38895,"word":"莺啼燕语","pinyin":"yīng tí yàn yǔ","abbr":"ytyy","explanation":"莺：黄鹂。燕子的话语，黄鹂的歌声。形容大好春光。","source":{"text":"莺啼燕语报新年，马邑龙堆路几千？","book":"唐·皇甫冉《春思》诗"},"example":{"text":"那妇人并不起身，运扇如故，口中～。","book":"明·冯梦龙《警世通言》第二卷"},"similar":["莺声燕语","莺歌燕语"],"usage":"作宾语、定语；用于女性"},{"id":38896,"word":"莺声燕语","pinyin":"yīng shēng yàn yǔ","abbr":"ysyy","explanation":"莺：黄鹂。燕子的话语，黄鹂的歌声。原形容大好春光。后多形容年轻女子说笑的声音。","source":{"text":"袅娜复轻盈，都是宜描上翠屏，语若流莺声似燕，丹青，燕语莺声怎画成？","book":"元·关汉卿《金线池》楔子"},"example":{"text":"宋江听的～，不是男子之音，便从神柜底下钻将出来，看时，却是两个青衣女童侍立在床边。","book":"明·施耐庵《水浒全传》第四十二回"},"similar":["莺歌燕语"],"usage":"作宾语、定语；用于女性"},{"id":38897,"word":"莺巢燕垒","pinyin":"yīng cháo yàn lěi","abbr":"ycyl","explanation":"比喻妓院。","source":{"text":"多置狎邪门巷，遂作莺巢燕垒，顿成柳市花街。","book":"清·黄六鸿《福惠全书·邮政·逐娼妓》"},"usage":"作宾语、定语；用于比喻句"},{"id":38898,"word":"莺期燕约","pinyin":"yīng qī yàn yuē","abbr":"yqyy","explanation":"比喻男女私情的约会。","source":{"text":"思前事、莺期燕约，寂寞向谁说。","book":"宋·应法孙《霓裳中序第一》词"}},{"id":38899,"word":"莺歌燕舞","pinyin":"yīng gē yàn wǔ","abbr":"ygyw","explanation":"黄莺在歌唱，小燕子在飞舞。形容春天鸟儿喧闹活跃的景象。现常比喻革命和建设蓬勃兴旺的景象。","source":{"text":"烟红露绿晓风香，燕舞莺啼春日长。","book":"宋·苏轼《锦被亭》词"},"example":{"text":"千里来寻故地，旧貌变新颜。到处～，更有潺潺流水，高路入云端。","book":"毛泽东《水调歌头·重上井冈山》词"},"similar":["鸟语花香","莺吟燕舞"],"opposite":["鸡犬不宁"],"usage":"作谓语、定语；形容形势"},{"id":38900,"word":"莺歌燕语","pinyin":"yīng gē yàn yǔ","abbr":"ygyy","explanation":"黄鹂歌唱，燕子呢喃。形容春天的美好景象。","source":{"text":"见了些，红红绿绿桃共杏，最喜春日晴。莺歌燕语，云淡风轻，水秀山明。","book":"《白雪遗音·马头调·春景》"},"similar":["莺啼燕语"],"usage":"作宾语、定语；用于景物描写"},{"id":38901,"word":"莺歌蝶舞","pinyin":"yīng gē dié wǔ","abbr":"ygdw","explanation":"莺啼如歌，蝶飞若舞。形容春光明媚，万物欢悦。亦比喻形势大好。同“莺歌燕舞”。","source":{"text":"莺歌蝶舞韶光长，红炉煮茗松花香。","book":"唐·鲍君徽《惜花吟》诗"},"example":{"text":"～两矜春，见我长嗟亦飞去。","book":"宋·宋痒《感花》诗"},"similar":["莺歌燕舞"],"usage":"作谓语、定语；用于景物描写"},{"id":38902,"word":"莺猜燕妒","pinyin":"yīng cāi yàn dù","abbr":"ycyd","explanation":"比喻遭人猜忌。","source":{"text":"算年年、莺猜燕妒，仙缘知在何处？","book":"清·王鹏运《摸鱼子·太常仙蝶来过赋此以志》词"},"usage":"作谓语、宾语；用于女性居多"},{"id":38903,"word":"莺迁之喜","pinyin":"yīng qiān zhī xǐ","abbr":"yqzx","explanation":"莺：黄鹂。黄鹂从不好的地方迁到好的地方。比喻地位由低而高。旧时常用作祝人升职或迁居之语。","source":{"text":"莺迁高树音容改。","book":"《诗经·小雅·伐木》：“伐木丁丁，鸟鸣嘤嘤，出自幽古，迁于乔木。”金·元好问《与宗秀才》"}},{"id":38904,"word":"莺闺燕阁","pinyin":"yīng guī yàn gé","abbr":"ygyg","explanation":"指妇女的闺阁。","source":{"text":"莺闺燕阁年三五，马邑龙堆路十千。","book":"明·杨慎《塞垣鹧鸪词》"},"usage":"作主语、宾语、定语；指闺房"},{"id":38905,"word":"莺颠燕狂","pinyin":"yīng diān yàn kuáng","abbr":"ydyk","explanation":"比喻男女寻欢作乐。","source":{"text":"暗思想，那些莺颠燕狂，关甚兴亡！","book":"清·孔尚任《桃花扇·听稗》"}},{"id":38906,"word":"莺飞燕舞","pinyin":"yīng fēi yàn wǔ","abbr":"yfyw","explanation":"莺燕飞舞。象征春光明媚。","source":{"text":"清明节前，汤河两岸换上了春天的盛装，桃红柳绿，莺飞燕舞的时光。","book":"柳青《创业史》第一部第十五章"},"usage":"作宾语、定语；用于景物描写"},{"id":38907,"word":"莺飞草长","pinyin":"yīng fēi cǎo zhǎng","abbr":"yfcz","explanation":"形容明媚的春景。","source":{"text":"暮春三月，江南草长，杂花生树，群莺乱飞。","book":"南朝·梁·丘迟《与陈伯之书》"},"example":{"text":"～谁为主？渺渺春江作歌苦。","book":"清·黄景仁《春风怨》诗"},"usage":"作宾语、定语；用于书面语"},{"id":38908,"word":"莼羹鲈脍","pinyin":"chún gēng lú kuài","abbr":"cglk","explanation":"莼：莼菜；脍：切得很细的肉。比喻怀念故乡的心情。","source":{"text":"翰因见秋风起，乃思吴中菰菜、莼羹、鲈鱼脍。","book":"《晋书·张翰传》"},"example":{"text":"意倦须还，身闲贵早，岂为～哉！","book":"宋·辛弃疾《沁园春·带湖新居将成》词"},"similar":["莼鲈之思"],"usage":"作宾语、定语；指思乡辞官","story":["西晋时期，吴县人张翰才思敏捷，他把功名利禄看得很淡，经常与朋友外出喝酒聊天，吃莼菜羹与红脍鲈鱼。他曾到洛阳大司马府做官，见官场黑暗，不由得想起家乡的莼羹鲈脍，就毅然辞官，悄悄地回到故乡"]},{"id":38909,"word":"莼鲈之思","pinyin":"chún lú zhī sī","abbr":"clzs","explanation":"比喻怀念故乡的心情。","source":{"text":"翰因见秋风起，乃思吴中菰菜、莼羹、鲈鱼脍。","book":"《晋书·张翰传》"},"usage":"作宾语；指思念故乡"},{"id":38910,"word":"莽大夫","pinyin":"mǎng dà fū","abbr":"mdf","explanation":"本指汉代扬雄，曾为王莽的大夫。后比喻变节的人。","source":{"text":"戊寅五年，莽大夫扬雄死。","book":"宋·朱熹《通鉴纲目·汉纪》"},"example":{"text":"这都是洁身自好的志士，可法可传，比诸～扬雄，原是清浊不同呢！","book":"蔡东藩《后汉演义》第二回"}},{"id":38911,"word":"莽眇之鸟","pinyin":"mǎng miǎo zhī niǎo","abbr":"mmzn","explanation":"比喻能轻身飞上天空又不见痕迹的物体。","source":{"text":"子方将与造物者为人，厌则又乘夫莽眇之鸟，以出六极之外。","book":"《庄子·应帝王》"}},{"id":38912,"word":"莽莽广广","pinyin":"mǎng mǎng guǎng guǎng","abbr":"mmgg","explanation":"莽：粗率、莽撞。做事鲁莽。","source":{"text":"况我老人家，从来药材行里，不曾着脚，怎便莽莽广广的要去行医。","book":"明·冯梦龙《醒世恒言》第38卷"},"usage":"作定语、状语；指人鲁莽"},{"id":38913,"word":"菊老荷枯","pinyin":"jú lǎo hé kū","abbr":"jlhk","explanation":"比喻女子容颜衰老。","source":{"text":"辜负却桃娇柳嫩三春景，捱尽了菊老荷枯几度秋。","book":"明·沈采《千金记·通报》"},"example":{"text":"当初共约芙蓉帐里，到如今～犹未归。","book":"明·胡文焕《群音类选·八声甘州·寄情》"},"usage":"作定语、状语；用于女性"},{"id":38914,"word":"菜果之物","pinyin":"cài guǒ zhī wù","abbr":"cgzw","explanation":"比喻没有才能的人。","source":{"text":"大器晚成，宝货难售，不崇一朝，辄成贾者，菜果之物也。","book":"汉·王充《论衡·状留》"}},{"id":38915,"word":"菜蔬之色","pinyin":"cài shū zhī sè","abbr":"cszs","explanation":"比喻人们在饥荒年景度日所显现的营养不良的脸色。","source":{"text":"野有菜蔬之色，朝靡代耕之秩。","book":"晋·潘岳《籍田鼠》"},"similar":["面有菜色"],"usage":"作宾语；指人的脸色"},{"id":38916,"word":"菟裘归计","pinyin":"tù qiú guī jì","abbr":"tqgj","explanation":"菟裘：地名，山东泰安东南。比喻准备告老还乡或退隐。","source":{"text":"公曰：‘为其少故也，吾将授之矣。使营菟裘，吾将老焉。","book":"春秋·鲁·左丘明《左传·隐公十一年》"},"similar":["告老还乡"],"usage":"作主语、宾语、定语；指告老还乡","story":["春秋时期，鲁惠公死，由继室所生的鲁隐公继位，他执政11年准备让位给鲁桓公，大夫羽父要求他杀了桓公。隐公说自己准备在菟裘造房养老。羽父反过来在桓公面前诬陷隐公，并派人刺杀了隐公。隐公的菟裘归计还没实施就被杀害了"]},{"id":38917,"word":"菩萨低眉","pinyin":"pú sà dī méi","abbr":"psdm","explanation":"象菩萨那样低眉看人。形容人的面貌慈祥善良。","source":{"text":"金刚努目，所以降服四魔；菩萨低眉，所以慈悲六道。","book":"《太平广记·俊辩类二》引《谈薮》"},"example":{"text":"若是再高等的呢，结识得几位有体面的洋大人，那就任凭老佛爷见著你，也只好～了。","book":"清·梁启超《新中国未来记》第五回"},"similar":["慈眉顺眼","和蔼可亲"],"opposite":["金刚怒目"],"usage":"作谓语、宾语；形容人的面貌慈祥善良","story":["隋朝时期，吏部侍郎薛道衡喜欢游历名胜古迹，他在游览钟山古寺开善寺时，见寺内各种金刚与菩萨形象各异，就好奇地问小和尚为什么金刚怒目而菩萨低眉，小和尚告诉他金刚怒目是为了降妖，菩萨低眉则为了对众生世界显其慈悲"]},{"id":38918,"word":"菩萨心肠","pinyin":"pú sà xīn cháng","abbr":"psxc","explanation":"比喻仁慈之心。","source":{"text":"吾弟以恩报仇，实是菩萨心肠。","book":"《西湖佳话·放生善迹》"},"example":{"text":"他有一副～。"},"opposite":["恶毒心肠"],"usage":"作主语、宾语；指好心肠"},{"id":38919,"word":"菱角磨作鸡头","pinyin":"líng jiǎo mó zuò jī tóu","abbr":"ljmzjt","explanation":"比喻困难大，波折多。","source":{"text":"俗谓困折多者谓菱角磨作鸡头。","book":"宋·陆游《书斋壁》诗：“平生忧患苦萦缠，菱刺磨成芡实圆。”自注"},"example":{"text":"这真是～，还是省点心吧"},"usage":"作宾语、定语；用于口语"},{"id":38920,"word":"菲才寡学","pinyin":"fěi cái guǎ xué","abbr":"fcgx","explanation":"菲：微薄；寡：少。才能小，学识浅。","source":{"text":"小侄菲才寡学，大人误采虚名。","book":"清·吴敬梓《儒林外史》第三十三回"},"similar":["才疏学浅"],"usage":"作谓语、定语；用于自谦"},{"id":38921,"word":"菲衣恶食","pinyin":"fěi yī è shí","abbr":"fyes","explanation":"菲：微，薄。简单粗劣的衣食。形容生活俭朴。","source":{"text":"九重菲衣恶食，卧薪尝胆，使上下改虑易听，然后可图。","book":"《宋史·李韶传》"},"similar":["粗衣粝食","菲食薄衣"],"usage":"作宾语、定语；指生活俭朴"},{"id":38922,"word":"菲言厚行","pinyin":"fěi yán hòu xíng","abbr":"fyhx","explanation":"菲：微薄，引申为少；厚：指多。少说多做。","source":{"text":"显仁翌明，藏用玄默，菲言厚行，陶化染学，仇校篆籀，篇章毕觌。","book":"晋·左思《魏都赋》"}},{"id":38923,"word":"菲食卑宫","pinyin":"fěi shí bēi gōng","abbr":"fsbg","explanation":"菲：微薄；卑：低。饮食菲薄，宫室简陋。指不讲究享受，励精图治。","source":{"text":"高祖菲食卑宫，春秋九十，屈志凝威，愤终贼手。","book":"《梁书·王僧辩传》"},"similar":["卑宫菲食"],"usage":"作谓语、宾语、定语；指不讲究享受"},{"id":38924,"word":"菲食薄衣","pinyin":"fěi shí bó yī","abbr":"fsby","explanation":"菲：微薄。微薄的衣服，粗劣的食物。形容生活十分俭朴。","source":{"text":"其中有可以率先卿士，准的甿庶，菲食薄衣，请自孤始。","book":"《梁书·武帝纪上》"},"example":{"text":"《梁书·武帝纪上》：“其中有可以率先卿士，准的甿庶，菲食薄衣，请自孤始。”"},"similar":["粗衣恶食","菲衣恶食"],"opposite":["锦衣玉食"],"usage":"作宾语、定语；指生活俭朴"},{"id":38925,"word":"菽水之欢","pinyin":"shū shuǐ zhī huān","abbr":"sszh","explanation":"菽水：豆和水，指普通饮食；欢：侍奉父母使其欢喜。指奉养父母，使父母欢乐。","source":{"text":"啜菽饮水尽其欢，斯之谓孝。","book":"《礼记·檀弓下》"},"example":{"text":"母子相与为命以致～者，又数年于此矣。","book":"宋·陈亮《祭蔡行之母太恭人文》"},"similar":["菽水承欢"],"usage":"作谓语、宾语；指奉养父母"},{"id":38926,"word":"菽水承欢","pinyin":"shū shuǐ chéng huān","abbr":"ssch","explanation":"菽水：豆和水，指普通饮食；承欢：侍奉父母使其欢喜。指奉养父母，使父母欢乐。","source":{"text":"啜菽饮水尽其欢，斯之谓孝。","book":"《礼记·檀弓下》"},"example":{"text":"慈帏恩爱成抛闪，怎能彀～。","book":"明·胡文焕《群音类选·祝发记·分食寄姑》"},"similar":["菽水之欢"],"usage":"作谓语、宾语；指奉养父母"},{"id":38927,"word":"萋斐成锦","pinyin":"qī fěi chéng jǐn","abbr":"qfcj","explanation":"萋斐：花纹错杂；锦：指贝锦，带有贝壳花纹的锦缎。比喻花言巧语，罗织罪名，诬陷别人。","source":{"text":"萋兮斐兮，成是贝锦。","book":"《诗经·小雅·巷伯》"},"example":{"text":"～，谓谮人之酿祸；含沙射影，言鬼域之害人。","book":"清·程允升《幼学故事琼林·人事》"}},{"id":38928,"word":"萋斐贝锦","pinyin":"qī fěi bèi jǐn","abbr":"qfbj","explanation":"比喻谗言。","source":{"text":"萋兮斐兮，成此贝锦。","book":"《诗经·小雅·巷伯》"},"example":{"text":"向异城藏身避仇，只愁那风沙难受，叹～无休。","book":"明·许三阶《节侠记·遁荒》"},"similar":["萋菲贝锦"],"usage":"作宾语、定语；用于为人"},{"id":38929,"word":"萋菲贝锦","pinyin":"qī fēi bèi jǐn","abbr":"qfbj","explanation":"贝锦：有花纹的织锦。女子织布织成美丽的图案。比喻花言巧语，罗织罪名，诬陷别人。","source":{"text":"恨何物，萋菲贝锦，敢污清烈。","book":"柳亚子《满江红·吊蒋清烈女士》"},"similar":["萋斐贝锦"],"usage":"作宾语、定语；用于为人"},{"id":38930,"word":"萍水偶逢","pinyin":"píng shuǐ ǒu féng","abbr":"psof","explanation":"浮萍随水漂泊，聚散无定。比喻人的偶然相遇。","source":{"text":"然数百年来，相遇如君者，不知凡几入，大都萍水偶逢，烟云倏散。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录四》"},"similar":["萍水相逢"],"usage":"作谓语、定语；指无深交"},{"id":38931,"word":"萍水相逢","pinyin":"píng shuǐ xiāng féng","abbr":"psxf","explanation":"浮萍随水漂泊，聚散不定。比喻向来不认识的人偶然相遇。","source":{"text":"萍水相逢，尽是他乡之客。","book":"唐·王勃《滕王阁序》"},"example":{"text":"此生平第二知心交也。惜～，聚首无多日耳。","book":"清·沈复《浮生六记·浪游记快》"},"similar":["不期而遇","一面之交"],"opposite":["莫逆之交"],"usage":"作谓语、定语；指无深交","story":["公元676年，唐朝著名的文学家王勃因罪被免官，前去交趾探望做县令的父亲，途经洪都，都督阎伯屿因重修的滕王阁落成，宴请文人志士及他的女婿吴子章，邀请他们为它作序，王勃作《滕王阁序》感慨：“萍水相逢，尽是他乡之客。”"]},{"id":38932,"word":"萍水相遇","pinyin":"píng shuǐ xiāng yù","abbr":"psxy","explanation":"比喻素不相识之人偶然相遇。","source":{"text":"我与足下未遇之先，已受先施之惠，及至萍水相遇，怎好为我破格！","book":"清·吴趼人《二十年目睹之怪现状》第39回"},"similar":["萍水相逢"],"usage":"作谓语、定语；指无深交"},{"id":38933,"word":"萍水相遭","pinyin":"píng shuǐ xiāng zāo","abbr":"psxz","explanation":"浮萍随水漂泊，聚散无定。比喻人的偶然相遇。","source":{"text":"天呵，果然是萍水相遭。","book":"明·陆采《明珠记·煎茶》"},"similar":["萍水相逢"],"usage":"作谓语、定语、宾语；指无深交"},{"id":38934,"word":"萍踪梗迹","pinyin":"píng zōng gěng jì","abbr":"pzgj","explanation":"萍：浮萍；梗：草木的直茎。像浮萍在水中，飘泊不定。比喻行踪无定。","source":{"text":"空挥泪，萍踪梗迹将安寄，此生何济？","book":"明·郑若庸《玉玦记·报信》"},"similar":["萍踪浪迹"],"usage":"作宾语、定语；指行踪无定"},{"id":38935,"word":"萍踪浪影","pinyin":"píng zōng làng yǐng","abbr":"pzly","explanation":"像浮萍、波浪一样无定所。比喻到处漂泊，踪迹无定。","source":{"text":"恨怱怱，萍踪浪影，风剪了玉芙蓉。","book":"明·汤显祖《牡丹亭》第二十出"},"example":{"text":"恨匆匆～，风剪了玉芙蓉。","book":"清·魏子安《花月痕》第二十七回"},"similar":["萍踪浪迹"],"usage":"作谓语、定语、宾语；指行踪无定"},{"id":38936,"word":"萍踪浪迹","pinyin":"píng zōng làng jì","abbr":"pzlj","explanation":"象浮萍、波浪一般的无定。比喻到处漂泊，没有固定的住所。","source":{"text":"恨怱怱，萍踪浪影，风剪了玉芙蓉。","book":"明·汤显祖《牡丹亭》第二十出"},"example":{"text":"只是此人不是本国之人，～。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"similar":["漂泊不定","飘蓬断梗"],"opposite":["安营扎寨","安居乐业"],"usage":"作谓语、定语、宾语；指行踪无定"},{"id":38937,"word":"萍踪靡定","pinyin":"píng zōng mǐ dìng","abbr":"pzmd","explanation":"象浮萍、波浪一般的无定。比喻到处漂泊，没有固定的住所。","source":{"text":"或就来，或一二日，或叁五，萍踪靡定，逢山遇水，或师或友，便谈玄论道，故无定期。","book":"明·许仲琳《封神演义》第二十四回"},"example":{"text":"睽违教命，乃云鄙吝复萌；来往无凭，则曰～。","book":"明·程允升《幼学学源》卷三"}},{"id":38938,"word":"萍飘蓬转","pinyin":"píng piāo péng zhuàn","abbr":"pppz","explanation":"像浮萍随水飘荡，像蓬草随风飞转。比喻漂泊不定的生活。","source":{"text":"甚或金尽裘敝，耻还乡里，萍飘蓬转，不通音问者，亦往往有之。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"},"example":{"text":"我就弄得这般模样，～，重入火坑，将来还不知作何归结。","book":"清·张春帆《九尾龟》第一百七十三回"},"similar":["飘蓬断梗","漂泊不定"],"opposite":["安居乐业"],"usage":"作谓语、定语；比喻漂泊不定的生活"},{"id":38939,"word":"萎糜不振","pinyin":"wěi mí bù zhèn","abbr":"wmbz","explanation":"形容情绪低沉，精神颓废。","example":{"text":"自从经商失败后，他就一直～。"}},{"id":38940,"word":"萎靡不振","pinyin":"wěi mǐ bù zhèn","abbr":"wmbz","explanation":"委靡：也作“萎靡”，颓丧。形容精神不振，意志消沉。","source":{"text":"颓堕委靡，溃败不可收失。","book":"唐·韩愈《送高闲上人序》"},"example":{"text":"无精打采地喘了一口粗气，然后象个病人一样～地站在那里。","book":"曲波《林海雪原》一七"},"similar":["垂头丧气","没精打采"],"opposite":["朝气蓬勃","神采飞扬"],"usage":"作谓语、定语、状语；指人意志消沉","story":["公元1125年，金军大举南下进攻北宋，燕京守将郭药师投敌，黄河守将梁方平脱逃，直逼北宋都城东京，宋徽宗将帝位传给儿子宋钦宗赵桓，自己逃到镇江。大臣杨时上书说：“大敌当前必须振奋精神抗击金人入侵，如果萎靡不振就只有灭亡。”"]},{"id":38941,"word":"萑苻遍野","pinyin":"huán fú biàn yě","abbr":"hfby","explanation":"萑苻：春秋时郑国的泽名，曾是盗贼出没之处。遍地都是像萑苻那样的盗贼窝。形容盗匪横行，出没各处，天下不宁。","source":{"text":"郑国多盗，敢人于萑苻之泽。","book":"《左传·昭公二十年》"}},{"id":38942,"word":"萤灯雪屋","pinyin":"yíng dēng xuě wū","abbr":"ydxw","explanation":"指勤学苦读。同“萤窗雪案”。","source":{"text":"游之兴废，家之盛衰占焉；学之兴废，人之盛衰占焉。学不待地也，萤灯雪屋，苟取尺寸，而圣贤之业可成矣。","book":"宋·叶適《石洞书院记》"},"similar":["萤窗雪案","映雪囊萤"],"usage":"作宾语、定语；用于书面语"},{"id":38943,"word":"萤窗雪案","pinyin":"yíng chuāng xuě àn","abbr":"ycxa","explanation":"为勤学苦读的典实。","source":{"text":"孙康家贫，常映雪读书。","book":"《晋书·车胤传》：“胤恭勤不倦，博学多通。家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。”《初学记》卷二引《宋齐语》"},"example":{"text":"暗想小生～，刮垢磨光，学成满腹文章，尚在湖海飘零。","book":"元·王实甫《西厢记》第一本第一折"},"similar":["映雪囊萤","萤灯雪屋"],"usage":"作宾语、定语；用于书面语"},{"id":38944,"word":"营私作弊","pinyin":"yíng sī zuò bì","abbr":"yszb","explanation":"为谋私利而耍弄手段干违法乱纪的事。","source":{"text":"总期民隐尽能上达，督抚无从营私作弊为要。","book":"清·谭嗣同《代拟上谕》"},"similar":["营私舞弊"],"usage":"作谓语、宾语、定语；用于处事"},{"id":38945,"word":"营私植党","pinyin":"yíng sī zhí dǎng","abbr":"yszd","explanation":"结合党羽，谋取私利。","source":{"text":"籍贯不可分，素行不可考，智愚贤否不能一律，则营私植党，沽名罔利之弊生焉。","book":"郑观应《盛世危言·议院上》"},"example":{"text":"我觉得随便换一个别的不是以教务为前提而只以～为得计的校长，我老早就要滚蛋的。","book":"邹韬奋《经历》十八"},"similar":["结党营私"],"usage":"作谓语、定语、宾语；用于处事"},{"id":38946,"word":"营私罔利","pinyin":"yíng sī wǎng lì","abbr":"yswl","explanation":"指谋求私利。","source":{"text":"大臣既以身许国，则但当计国民之利害，不当计一身之利害，营私罔利，固不可也。","book":"梁启超《中国积弱溯源论》第四节"},"usage":"作谓语、定语、宾语；用于处事"},{"id":38947,"word":"营私舞弊","pinyin":"yíng sī wǔ bì","abbr":"yswb","explanation":"营：谋求；舞：玩弄；弊：指坏事。因图谋私利而玩弄欺骗手段做犯法的事。","source":{"text":"施奏咸与逄信邪枉贪污，营私多利。","book":"《汉书·翟方进传》"},"example":{"text":"南洋兵船虽然不少，叵耐管带一味知道～，那里还有公事在他心上。","book":"清·吴趼人《二十年目睹之怪现状》第十四回"},"similar":["贪赃枉法","营私作弊"],"opposite":["公正无私"],"usage":"作谓语、宾语、定语；指做坏事"},{"id":38948,"word":"营营苟苟","pinyin":"yíng yíng gǒu gǒu","abbr":"yygg","explanation":"营营：往来不绝的样子。形容人不顾廉耻，到处钻营","source":{"text":"就是那最时髦的政客，成日价营营苟苟，忙个不了……又那个不是为他将来的物质生活作预备呢？","book":"李大钊《现在与未来》"},"example":{"text":"王朔《玩儿的就是心跳》：“侃侃而谈，吹着他那套生意经和人生观，听得我那些一辈子～的同学目瞪口呆。”"},"usage":"作谓语、定语；用于处事"},{"id":38949,"word":"营营逐逐","pinyin":"yíng yíng zhú zhú","abbr":"yyzz","explanation":"①忙忙碌碌。②竞相追逐。","source":{"text":"单道世上人，营营逐逐，急急巴巴，跳不出七情六欲关头，打不破酒色财气圈子。","book":"明·宋濂《抱瓮子传》：“夫子恒营营逐逐于一瓮间，无乃自苦乎？”明·兰陵笑笑生《金瓶梅词话》第一回"},"example":{"text":"群蚁～，以企仰此无量之光荣，莫肯让也。","book":"梁启超《中国积弱溯源论》第三节"},"similar":["忙忙碌碌"],"usage":"作谓语、状语；用于处事"},{"id":38950,"word":"营蝇斐锦","pinyin":"yíng yíng fēi jǐn","abbr":"yyfj","explanation":"比喻谗人颠倒黑白，诽谤诬陷，入人于罪。","source":{"text":"萋兮斐兮，成是贝锦。彼谮人者，亦已大甚。","book":"《诗·小雅·青蝇》：“营营青蝇，止于樊。岂弟君子，无信谗言。”又《诗·小雅·巷伯》"},"example":{"text":"～难为忠，空中愤死田神功。","book":"明·李东阳《河阳战》诗"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":38951,"word":"萧墙之危","pinyin":"xiāo qiáng zhī wēi","abbr":"xqzw","explanation":"因内部问题而引起的危机。","source":{"text":"今社稷之难，急于陇、蜀，操外吞天子，内残群寮，朝廷有萧墙之危而御侮未建，可为寒心。","book":"《三国志·蜀志·先主传》"},"example":{"text":"晋·陈寿《三国志·蜀志·先主传》：“朝廷有～而御侮未建，可为寒心。”"},"similar":["萧墙之患","萧墙之变"],"usage":"作宾语；指内部发生祸乱"},{"id":38952,"word":"萧墙之变","pinyin":"xiāo qiáng zhī biàn","abbr":"xqzb","explanation":"萧墙：古代宫室内当门的小墙。产生于家中的祸乱，比喻由内部原因所致的灾祸、变乱。","source":{"text":"海陵本怀觊觎，因之疑畏愈甚，萧墙之变，从此萌生矣。","book":"《金史·后妃传·熙宗悼平皇后》"},"similar":["萧墙之祸","萧墙之危"],"usage":"作宾语；指内部发生祸乱"},{"id":38953,"word":"萧墙之患","pinyin":"xiāo qiáng zhī huàn","abbr":"xqzh","explanation":"因内部问题而引起的祸患。","source":{"text":"不谨萧墙之患，而固金城于远境。","book":"《韩非子·用人》"}},{"id":38954,"word":"萧墙之祸","pinyin":"xiāo qiáng zhī huò","abbr":"xqzh","explanation":"萧墙：古代宫室内当门的小墙。产生于家中的祸乱，比喻灾祸、变乱皆由内部原因所致。","source":{"text":"速提雄虎之师，克定萧墙之祸。","book":"晋·陈寿《三国志·董卓议立陈留王》"},"example":{"text":"我们要尽量避免～。"},"similar":["祸起萧墙","萧墙之变"],"usage":"作宾语；指内部发生祸乱"},{"id":38955,"word":"萧墙之衅","pinyin":"xiāo qiáng zhī xìn","abbr":"xqzx","explanation":"因内部问题而引起的危机。","source":{"text":"庐陵之事，不由傍人，内积萧墙之衅，外行叔段之罚，既制之有主，臣何预焉。","book":"《宋书·谢晦传》"},"example":{"text":"乘厥～，藉其分崩之隙，东据历阳，兼指瓜步，缘江镇戍，达于荆郢。","book":"《魏书·源贺传》"}},{"id":38956,"word":"萧墙祸起","pinyin":"xiāo qiáng huò qǐ","abbr":"xqhq","explanation":"萧墙：古代宫室内当门的小墙。指祸乱发生在家里。比喻内部发生祸乱。","source":{"text":"吾恐季孙之忧不在颛臾，而在萧墙之内也。","book":"《论语·季氏》"},"example":{"text":"～片时间，到如今反为难上难。","book":"明·冯梦龙《警世通言》卷三十八"},"similar":["祸起萧墙"],"usage":"作宾语、定语；指内部发生祸乱"},{"id":38957,"word":"萧敷艾荣","pinyin":"xiāo fū ài róng","abbr":"xfar","explanation":"萧、艾：艾蒿，蒿草；敷、荣：开花。指蒿草长得很茂盛。比喻才能低下，品行卑劣的人一时得势。比喻小人得志。","source":{"text":"毛伯成既负其才气，常称：‘宁为兰摧玉折，不作萧敷艾荣。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"usage":"作宾语、定语；用于比喻句"},{"id":38958,"word":"萧斧之诛","pinyin":"xiāo fǔ zhī zhū","abbr":"xfzz","explanation":"萧斧：行刑的斧钺；诛：杀戮。受到斧钺的诛杀。形容人罪大恶极。","source":{"text":"一字之嘉，有同华衮之赠；一言所黜，无异萧斧之诛。","book":"唐·孔颍达《春秋正义序》"},"usage":"作宾语；用于处罚"},{"id":38959,"word":"萧曹避席","pinyin":"xiāo cáo bì xí","abbr":"xcbx","explanation":"萧曹：指汉高祖的丞相萧何、曹参；避席：起立离座，表示敬意。连萧何、曹参都要对他肃然起敬。比喻政治才能极大，超过前人。","source":{"text":"语文章，则严、马扶轮；论政事，则萧、曹避席。","book":"《旧唐书·李德裕传论》"},"usage":"作宾语、定语；指政绩显赫"},{"id":38960,"word":"萧然四壁","pinyin":"xiāo rán sì bì","abbr":"xrsb","explanation":"萧然：寂寞冷落；四壁：四面墙壁。屋里空荡荡的，没什么东西。形容生活非常贫困。","source":{"text":"萧然四壁野人家，幽事还堪对客夸。","book":"宋·陆游《幽事》"},"example":{"text":"～坡翁，要求黄木无从。受用一般苦味，奉扬千载清风。","book":"元·程文海《清平乐》词"}},{"id":38961,"word":"萧然尘外","pinyin":"xiāo rán chén wài","abbr":"xrcw","explanation":"尘外：自身以外的一切。形容极为超脱，不为俗情杂务所烦扰。","source":{"text":"修洁孤高，凌霜傲雪，萧然尘外丰姿。","book":"宋·李曾伯《声声慢·和韵赋江梅》"},"example":{"text":"～意，一曲在沧浪。","book":"清·徐宝字《通润桥散步》"},"similar":["萧然物外"],"usage":"作谓语、定语；用于处事"},{"id":38962,"word":"萧然物外","pinyin":"xiāo rán wù wài","abbr":"xrww","explanation":"物外：自身以外的一切。形容极为超脱，不为俗情杂务所烦扰。","source":{"text":"萧然物外，自得天机，吾不如傅青主。","book":"《清朝野史大观》卷九"},"similar":["萧然尘外"],"usage":"作谓语、定语；用于处事"},{"id":38963,"word":"萧行范篆","pinyin":"xiāo xíng fàn zhuàn","abbr":"xxfz","explanation":"南朝宋羊欣的隶书见重一时，萧思话、范晔同师羊欣而小叛，萧善行草，范精小篆，后世并称为“萧行范篆”。","source":{"text":"羊真孔草、萧行范篆，各一时绝妙。","book":"南朝·梁·袁昂《古今书评》"},"example":{"text":"若要古人的，有羊真孔草，～。","book":"清·李渔《意中缘·画遇》"},"usage":"作宾语、定语；用于书法等"},{"id":38964,"word":"萧规曹随","pinyin":"xiāo guī cáo suí","abbr":"xgcs","explanation":"萧何创立了规章制度，死后，曹参做了宰相，仍照着实行。比喻按照前任的成规办事。","source":{"text":"夫萧规曹随，留侯画策，陈平出奇，功若泰山，响若坻隤。","book":"《史记·曹相国世家》：“参代何为汉相国，举事无所变更，一遵萧何约束。”汉·扬雄《解嘲》"},"example":{"text":"以神宗之明主持于上，而继伴者能～，则九仞之功，可不亏于一篑。","book":"清·梁启超《王荆公传》第十四章"},"similar":["因循守旧","故步自封","一如既往"],"opposite":["兴利除弊","破旧立新"],"usage":"作谓语、定语、分句；指继承前人的政策","story":["萧何跟随刘邦打天下，忠心耿耿为刘邦制定治理江山的政策与法规，为巩固西汉政权做出了很大的贡献。萧何死后，曹参担任相国，完全执行萧何的法规制度。汉惠帝不满，问曹参为什么自己没有建树。曹参认为以前的法规很好照办就是"]},{"id":38965,"word":"萧郎陌路","pinyin":"xiāo láng mò lù","abbr":"xlml","explanation":"萧郎：旧时泛指女子所爱恋的男子；陌路：过路人。比喻女子对原来爱恋的男子视若路人，不愿或不能接近。","source":{"text":"侯门一入深如海，从此萧郎是路人。","book":"唐·崔郊《赠婢诗》"},"similar":["视同陌路"],"usage":"作宾语、定语；指不再相爱"},{"id":38966,"word":"萱花椿树","pinyin":"xuān huā chūn shù","abbr":"xhcs","explanation":"指父母。萱花指母，椿树指父。","source":{"text":"祝萱花椿树，虽则是子生迟暮，守得见这蟠桃熟。","book":"明汤显祖《牡丹亭·训女》"},"usage":"作主语、谓语、定语；指父母"},{"id":38967,"word":"萱草忘忧","pinyin":"xuān cǎo wàng yōu","abbr":"xcwy","explanation":"传说食萱草能令人忘忧，指想法解忧。","source":{"text":"谖草令人忘忧。背，北堂也。","book":"《诗经·卫风·伯兮》：“焉得谖（同‘萱’）草，言树之背？”毛传"},"usage":"作宾语、定语；用于人处事"},{"id":38968,"word":"落井下石","pinyin":"luò jǐng xià shí","abbr":"ljxs","explanation":"看见人要掉进陷井里，不伸手救他，反而推他下去，又扔下石头。比喻乘人有危难时加以陷害。","source":{"text":"落陷阱，不一引手救，反挤之，又下石焉者，皆是也。","book":"语出唐·韩愈《柳子厚墓志铭》"},"example":{"text":"为什么要在别人危急的时刻，～……太不讲做人的道德了。","book":"周而复《上海的早晨》第三部十九"},"similar":["乘人之危","趁火打劫"],"opposite":["助人为乐","雪中送炭","相濡以沫"],"usage":"作谓语、定语、宾语；指陷害人","story":["唐朝时期，御史大夫柳宗元因为过失而被贬至柳州刺史，他在柳州忧郁不得志而死。文学家韩愈见好友被小人进谗言而替他打抱不平，为他写墓志铭深刻揭露那帮落井下石的人，同时也提醒世人要警惕那些平时指天发誓掏心窝的人"]},{"id":38969,"word":"落井投石","pinyin":"luò jǐng tóu shí","abbr":"ljts","explanation":"看见别人掉进陷井里，不伸手救他，还往井下丢石头。比喻乘人之危加以打击、陷害。","source":{"text":"从未做过落井投石的事。","book":"沙汀《炮手》"},"example":{"text":"他平时呼朋唤友，可一旦友人有了急难，不但不救，反而～。"},"similar":["落井下石"],"opposite":["雪中送炭"],"usage":"作谓语、定语；指陷害人"},{"id":38970,"word":"落发为僧","pinyin":"luò fà wéi sēng","abbr":"lfws","explanation":"落发：剃光头发；为僧：做僧人。剃光头发做僧人。","source":{"text":"策少好浮图之说，乃落发为僧，居长安慈恩寺。","book":"《新五代史·张策传》"},"example":{"text":"为因打死了人，情愿～。","book":"明·施耐庵《水浒全传》第六回"}},{"id":38971,"word":"落叶归根","pinyin":"luò yè guī gēn","abbr":"lygg","explanation":"飘落的枯叶，掉在树木根部。比喻事物有一定的归宿。多指客居他乡的人，终要回到本乡。","source":{"text":"叶落归根，来时无口。","book":"宋·释道原《景德传灯录》卷五"},"example":{"text":"～，丰城剑回。","book":"明·王世桢《鸣凤记》第三十八出"},"similar":["故土难离","解甲归田"],"opposite":["流离失所","离乡背井","四海为家"],"usage":"作谓语、宾语、定语、分句；指事物的归宿"},{"id":38972,"word":"落叶知秋","pinyin":"luò yè zhī qiū","abbr":"lyzq","explanation":"指见到落地的黄叶，知道已经是秋天快到了。","source":{"text":"见一叶落而知岁之将暮。","book":"《淮南子·说山训》"},"example":{"text":"恨天涯摇落三杯酒，似飘零～。","book":"明·汤显祖《南柯记·侠概》"},"similar":["一叶落而知天下秋"],"usage":"作谓语、宾语；指通过迹象便可预测未来"},{"id":38973,"word":"落地生根","pinyin":"luò dì shēng gēn","abbr":"ldsg","explanation":"比喻长期安家落户或切切实实、一心一意地做好所从事的工作。","source":{"text":"他们纷纷表示，要在农村落地生根，干一辈子革命。","book":"《人民日报》1969.12.18"},"example":{"text":"他准备在边疆～。"},"similar":["生根发芽"],"opposite":["飘浮不定"],"usage":"作谓语、宾语；用于确定的意思"},{"id":38974,"word":"落拓不羁","pinyin":"luò tuò bù jī","abbr":"ltbj","explanation":"形容人性情豪放，行为散漫。","source":{"text":"少落拓有大志，不拘小节。","book":"《北史·杨素传》"},"example":{"text":"《北史·杨素传》：“少落拓有大志，不拘小节。”"},"similar":["无拘无束","放荡不羁","放浪形骸"],"opposite":["循规蹈矩","安分守己","谨小慎微"],"usage":"作谓语、定语；形容人无拘无束"},{"id":38975,"word":"落月屋梁","pinyin":"luò yuè wū liáng","abbr":"lywl","explanation":"比喻对朋友的怀念。","source":{"text":"落月满屋梁，犹疑照颜色。","book":"唐·杜甫《梦李白》诗"},"example":{"text":"每动～之思。","book":"宋·胡继宗《书言故事·瞻仰类》"},"usage":"作宾语、定语；比喻对故人的怀念"},{"id":38976,"word":"落水狗","pinyin":"luò shuǐ gǒu","abbr":"lsg","explanation":"比喻失势的恶人。","source":{"text":"中国最多的却是枉道；不打落水狗，反被狗咬了。","book":"鲁迅《坟·论“费厄泼赖”应该缓行》"},"example":{"text":"我们要痛打～。"},"usage":"作主语、宾语；指失势的坏人"},{"id":38977,"word":"落汤螃蟹","pinyin":"luò tāng páng xiè","abbr":"ltpx","explanation":"汤：热水。如同落在热水里的螃蟹一般。形容手忙脚乱的狼狈样子。","source":{"text":"宋·释道原《景德传灯录》卷十九：“一似落汤螃蟹，手脚忙乱。”忽一日眼光落地，莫似落汤螃蟹，手忙脚乱。 ★清·翟灏《通俗编·禽鱼》"},"example":{"text":"忽一日眼光落地，莫似落汤螃蟹，手忙脚乱。","book":"清·翟灏《通俗编·禽鱼》"},"usage":"作宾语、定语；指手忙脚乱"},{"id":38978,"word":"落汤鸡","pinyin":"luò tāng jī","abbr":"ltj","explanation":"比喻落水或浑身湿透的人。","source":{"text":"止子小船身一旺，立勿定，落汤鸡子浴风波。","book":"明·天然智叟《石头点》第六回"},"example":{"text":"那老妪闻言，好像～一般，口不能言。","book":"明·冯梦龙《醒世恒言》卷二十二"},"usage":"作宾语、定语；多用于比喻句"},{"id":38979,"word":"落笔妙天下","pinyin":"luò bǐ miào tiān xià","abbr":"lbmtx","explanation":"形容文章的文辞精妙无比。","source":{"text":"君房下笔，言语妙天下。","book":"《汉书·贾捐之传》"},"example":{"text":"舟次～，于人少所许可。","book":"清·汪琬《敕赠乔母潘孺人墓志铭》"}},{"id":38980,"word":"落笔成蝇","pinyin":"luò bǐ chéng yíng","abbr":"lbcy","explanation":"把屏风上的因误笔而成的污点画成苍蝇。形容绘画技术十分高超。","source":{"text":"曹不兴，吴兴人也。孙权使画屏风，误落笔点素，因就成蝇状。权疑其真，以手弹之。","book":"唐·张彦远《历代名画记》卷四"}},{"id":38981,"word":"落纸云烟","pinyin":"luò zhǐ yún yān","abbr":"lzyy","explanation":"笔墨落到纸上如同云烟一样变幻多姿。形容书法或诗文高超玄妙，变化多姿。","source":{"text":"草隶兼善，尺牍必珍。足不缀行，手不释文。翰动若飞，纸落如云。","book":"晋·潘岳《杨荆州诔》"}},{"id":38982,"word":"落纸如飞","pinyin":"luò zhǐ rú fēi","abbr":"lzrf","explanation":"形容写字迅捷。","source":{"text":"词理纵横，文笔灿烂，手不停缀，落纸如飞。","book":"唐·刘肃《大唐新语》"},"usage":"作谓语、定语；用于人写字、作画等"},{"id":38983,"word":"落纸烟云","pinyin":"luò zhǐ yān yún","abbr":"lzyy","explanation":"笔墨落到纸上如同云烟一样变幻多姿。形容书法或诗文高超玄妙，变化多姿。","source":{"text":"草隶兼善，尺牍必珍。足不缀行，手不释文。翰动若飞，纸落如云。","book":"晋·潘岳《杨荆州诔》"},"example":{"text":"～纷态度，照人冰玉峙高寒。","book":"宋·陆游《致语口号》"}},{"id":38984,"word":"落花媒人","pinyin":"luò huā méi rén","abbr":"lhmr","explanation":"不正当男女关系的撮合人。","example":{"text":"我们要坚决打击～。"},"usage":"作主语、宾语、定语；用于口语"},{"id":38985,"word":"落花无言","pinyin":"luò huā wú yán","abbr":"lhwy","explanation":"原来比喻诗的风格典雅。后比喻经受失败而无怨忿。","source":{"text":"眠琴绿阴，上有飞瀑。落花无言，人淡如菊。","book":"唐·司空图《诗品·典雅》"},"example":{"text":"绿惨粉销，真像个～，人淡如菊。","book":"清·魏子安《花月痕》第二十四回"},"usage":"作宾语、定语；用于书面语"},{"id":38986,"word":"落花时节","pinyin":"luò huā shí jié","abbr":"lhsj","explanation":"春末。","source":{"text":"落花时节又逢君。","book":"唐·杜甫《江南逢李龟年》"},"example":{"text":"在这～里，我们又相逢了。"},"usage":"作宾语、定语；指春末"},{"id":38987,"word":"落花有意，流水无情","pinyin":"luò huā yǒu yì，liú shuǐ wú qíng","abbr":"lhyylswq","explanation":"比喻这一方面有情，那一方面无意（多指男女恋爱）。","source":{"text":"落花有意随流水，流水无情恋落花。","book":"宋·释惟白《续传灯录·温州龙翔竹庵士珪禅师》"},"example":{"text":"谁知朱重是个老实人，又且兰花龌龊丑陋，朱重也看不上眼。以此～。","book":"明·冯梦龙《醒世恒言》卷三"},"opposite":["两相情愿"],"usage":"作主语、宾语；指男女情爱"},{"id":38988,"word":"落花流水","pinyin":"luò huā liú shuǐ","abbr":"lhls","explanation":"原形容暮春景色衰败。后常用来比喻被打得大败。","source":{"text":"流水落花春去也，天上人间","book":"唐·李群玉《奉和张舍人送秦炼师归岑公山》诗：“兰浦苍苍春欲暮，落花流水怨离襟。”南唐·李煜《浪淘沙》词"},"example":{"text":"幸有杨戬在侧，看见闻太师好鞭，只打得～，才把银合马飞走出阵，使枪便刺。","book":"明·许仲琳《封神演义》第四十二回"},"similar":["狼狈不堪","一败涂地"],"opposite":["得胜回朝","凯旋而归"],"usage":"作定语、状语；指残败零落的样子"},{"id":38989,"word":"落花芳草无寻处","pinyin":"luò huā fāng cǎo wú xún chù","abbr":"lhfcwxc","explanation":"比喻春天美好宜人的景色已经过去。","source":{"text":"寂寂孤莺啼杏园，寥寥一犬吠桃源。落花芳草无寻处，万壑千峰独闭门。","book":"唐·刘长卿《过郑山人所居》"}},{"id":38990,"word":"落花难上枝","pinyin":"luò huā nán shàng zhī","abbr":"lhnsz","explanation":"比喻夫妻关系破裂，难以挽回。","source":{"text":"破镜不重照，落花难上枝。","book":"宋·释道原《景德传灯录》卷十七"}},{"id":38991,"word":"落英缤纷","pinyin":"luò yīng bīn fēn","abbr":"lybf","explanation":"形容落花纷纷飘落的美丽情景。","source":{"text":"忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷，渔人甚异之。","book":"晋·陶潜《桃花源记》"},"example":{"text":"四次来游，满天满谷的～；树上剩得青叶与绿叶，更何处寻那淡红娇嫩的樱。","book":"周恩来《四次游中山公园》"},"similar":["花团锦簇"],"usage":"作谓语、宾语；花瓣凋落，纷纷飞扬的样子"},{"id":38992,"word":"落草为寇","pinyin":"luò cǎo wéi kòu","abbr":"lcwk","explanation":"寇：盗贼。旧指逃入山林做强盗。","source":{"text":"难道我们自幼习武艺时节，就要落草为寇？","book":"清·褚人获《隋唐演义》第十五回"},"example":{"text":"鲁军大多由收编土匪而来，编余兵士又大多回到山上～。","book":"陶菊隐《北洋军阀统治时期史话》第七十九章"},"similar":["占山为王"],"usage":"作谓语、定语；指当强盗"},{"id":38993,"word":"落荒而走","pinyin":"luò huāng ér zǒu","abbr":"lhez","explanation":"指离开战场，向荒野逃命。形容战败逃命。","source":{"text":"玄德见势危，落荒而走。","book":"元·无名氏《马陵道》第三折：“你自慢慢的从大路上行，我便落慌而走。”明·罗贯中《三国演义》三十一回"},"example":{"text":"兽马争持，剑戟并举。未及数合，子牙便走，不进城，落荒而逃。殷洪见子牙～，急忙赶来。","book":"明·许仲琳《封神演义》六十一回"},"similar":["落荒而逃"],"usage":"作谓语；指败逃"},{"id":38994,"word":"落荒而逃","pinyin":"luò huāng ér táo","abbr":"lhet","explanation":"形容吃了败仗慌张逃跑。","source":{"text":"玄德望见‘地公将军’旗号，飞马赶来，张宝落荒而走。","book":"明·罗贯中《三国演义》"},"example":{"text":"他们根本不是对手，只好～。"},"similar":["一败涂地","狼狈不堪"],"opposite":["大获全胜","得胜回朝"],"usage":"作谓语；指败逃"},{"id":38995,"word":"落落之誉","pinyin":"luò luò zhī yù","abbr":"llzy","explanation":"落落：坦荡。度量大，能容人的好名声。","source":{"text":"若明府能招致此人，必有忠谠落落之誉。","book":"《三国志·蜀志·彭羕传》"}},{"id":38996,"word":"落落大方","pinyin":"luò luò dà fāng","abbr":"lldf","explanation":"落落：坦率，开朗的样子。形容言谈举止自然大方。","source":{"text":"更兼她生得落落大方，不似那羞手羞脚的小家气象。","book":"清·文康《儿女英雄传》第二十九回"},"example":{"text":"对于我们也是非常宽大的。还有他的夫人也～。","book":"郭沫若《蔡文姬》第四幕"},"similar":["雍容大雅"],"opposite":["缩手缩脚","局促不安","扭扭捏捏"],"usage":"作谓语、定语、补语；指人的言谈举止"},{"id":38997,"word":"落落寡合","pinyin":"luò luò guǎ hé","abbr":"llgh","explanation":"形容跟别人合不来。","source":{"text":"常以为落落难合。","book":"《汉书·耿传》"},"example":{"text":"他的文章观点深奥，一定～。"},"similar":["孤芳自赏","与世无争","孤家寡人"],"opposite":["和衷共济","八面玲珑","同舟共济"],"usage":"作谓语、定语；指人不合群"},{"id":38998,"word":"落落晨星","pinyin":"luò luò chén xīng","abbr":"llcx","explanation":"落落：稀疏的样子；晨星：早晨天空中的星星。比喻非常稀少。","source":{"text":"吾不幸，向所谓同年友，当其盛时，连辔举鏣，互绝九衢，若屏风然，今来，落落如晨星之相望。","book":"唐·刘禹锡《送张盥赴举序》"},"example":{"text":"～，言同年者，或存或亡也。","book":"宋·胡继宗《书言故事·同官》"}},{"id":38999,"word":"落落穆穆","pinyin":"luò luò mù mù","abbr":"llmm","explanation":"落落：冷落的样子；穆穆：淡薄的样子。形容待人冷淡。","source":{"text":"澄嘗谓衍曰：‘兄形似道，而神锋太儁。’衍曰：‘诚不如卿落落穆穆然也。’","book":"《晋书·王澄传》"},"usage":"作谓语、定语；用于处事"},{"id":39000,"word":"落落难合","pinyin":"luò luò nán hé","abbr":"llnh","explanation":"原形容事情很邈远，很难实现。后也形容为人孤僻，不易合群。","source":{"text":"将军前在南阳，建此大策，常以为落落难合，有志者事竟成也。","book":"《后汉书·耿弇传》"},"example":{"text":"起初与六君子十三太保等，统是～，后来逐渐亲昵，反似彼此引为同调。","book":"蔡东藩、许廑父《民国通俗演义》第五十一回"},"similar":["落落寡合"],"usage":"作谓语、定语；指人不合群"},{"id":39001,"word":"落阱下石","pinyin":"luò jǐng xià shí","abbr":"ljxs","explanation":"比喻乘人有危难时加以陷害。同“落井下石”。","source":{"text":"一旦临小利害，仅如毛发比，反眼若不相识；落陷阱，不一引手救，反挤之，又下石焉者，皆是也。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"毫无疑义，他是误解了牛祚，以为对方在～。","book":"沙汀《困兽记》三"},"similar":["落井下石"],"opposite":["雪中送炭"],"usage":"作谓语、定语、宾语；指陷害人","story":["唐朝时期，御史大夫柳宗元因为过失而被贬至柳州刺史，他在柳州忧郁不得志而死。文学家韩愈见好友被小人进谗言而替他打抱不平，为他写墓志铭深刻揭露那帮落井下石的人，同时也提醒世人要警惕那些平时指天发誓掏心窝的人"]},{"id":39002,"word":"落雁沉鱼","pinyin":"luò yàn chén yú","abbr":"lycy","explanation":"雁见了飞落地面，鱼见了潜入水底。形容女子容貌美丽动人。","source":{"text":"毛嫱、丽姬，人之所美也。鱼见之深入，鸟见之高飞。","book":"先秦·庄周《庄子·齐物论》"},"example":{"text":"～真绝世，羞花闭月果非凡。","book":"明·蘅芜室主人《再生缘》第一回"},"similar":["沉鱼落雁","闭月羞花"],"usage":"作谓语、宾语、定语；形容女子貌美"},{"id":39003,"word":"落魄不偶","pinyin":"luò pò bù ǒu","abbr":"lpbo","explanation":"古代一种迷信观念，认为偶数好，奇数不好。落魄：倒霉、潦倒；不偶：运气不好。","source":{"text":"吾久闻明公大名，何故至今犹落魄不偶耶？","book":"明·罗贯中《三国演义》第三十五回"}},{"id":39004,"word":"落魄不羁","pinyin":"luò pò bù jī","abbr":"lpbj","explanation":"落魄：穷困，不得意；羁：束缚。潦倒失意，行为放纵。也指豪迈不受拘束。","source":{"text":"实之莆人，登甲科，甚有文名，落魄不羁。","book":"《北史·杨素传》：“少落拓有大志，不拘小节。”  宋·周密《齐东野语》卷四"},"example":{"text":"杜君泽，号小痴，姑苏人。善楷书，工山水，嗜酒。流寓高邮，～。","book":"明·韩昂《图绘宝鉴续编·皇明》"},"similar":["落拓不羁","无拘无束","放浪形骸"],"opposite":["循规蹈矩","安分守己"],"usage":"作谓语、定语；形容人无拘无束的性格"},{"id":39005,"word":"落魄江湖","pinyin":"luò pò jīng hú","abbr":"lpjh","explanation":"落魄：穷困失意。为生活所迫而到处流浪。","source":{"text":"落魄：穷困失意。为生活所迫而到处流浪。"},"example":{"text":"落魄：穷困失意。为生活所迫而到处流浪。"}},{"id":39006,"word":"葄枕图史","pinyin":"zuò zhěn tú shǐ","abbr":"zzts","explanation":"葄：垫衬。形容陷溺于图书资料之中。","source":{"text":"揆病取士不考实，迂学陋生，葄枕图史，且不能自措于词。","book":"《新唐书·李揆传》"},"example":{"text":"我不想老是过～的生活。"},"similar":["钻故纸堆"],"usage":"作谓语、定语；指人喜欢图书"},{"id":39007,"word":"葑菲之采","pinyin":"fēng fēi zhī cǎi","abbr":"ffzc","explanation":"不可因葑菲根茎味苦而连叶也不采。原比喻夫妻相处，应发德为重，不可因女子容颜衰退而遗弃。后常用作请人有所采取的谦词。","source":{"text":"采葑采菲，无以下体。","book":"《诗经·邶风·谷风》"},"usage":"作宾语；常用作请人有所采取的谦词"},{"id":39008,"word":"著之竹帛","pinyin":"zhù zhī zhú bó","abbr":"zzzb","explanation":"著：写作；竹帛：古代写字用的竹简和白绢。指著书","source":{"text":"所欲著之竹帛者，盖尚有三四种。","book":"章炳麟《与龚未生书》"},"similar":["著乎竹帛","著于竹帛"],"usage":"作谓语、宾语；用于书面语"},{"id":39009,"word":"著乎竹帛","pinyin":"zhù hū zhú bó","abbr":"zhzb","explanation":"著：写作；竹帛：竹简和绢。在竹简和绢上写作。指把事物或人的功绩等写入书中。","source":{"text":"孙叔敖日夜不息，不得以便生为故，故使庄王功迹著乎竹帛，传乎后世。","book":"《吕氏春秋·仲春纪》"},"similar":["著于竹帛","著之竹帛"],"usage":"作谓语、宾语；用于书面语"},{"id":39010,"word":"著书立言","pinyin":"zhù shū lì yán","abbr":"zsly","explanation":"立：创立、提出；言：主张，学说。从事写作，提出自己的主张和学说。","source":{"text":"扬雄亦慕仲尼之教者，以著书立言为事，得自易哉。","book":"唐·陈黯《言风》"},"example":{"text":"盖是晦庵早年登朝，茫茫仕宦之中，～，流布天下，自己还有些不慊意处。（明·凌濛初《二刻拍案惊奇》卷十二）"},"similar":["著书立说"],"usage":"作谓语、定语、宾语；指写作"},{"id":39011,"word":"著书立说","pinyin":"zhù shū lì shuō","abbr":"zsls","explanation":"立：创立、提出；说：主张，学说。从事写作，提出自己的主张和学说。","source":{"text":"扬雄亦慕仲尼之教者，以著书立言为事，得自易哉。","book":"唐·陈黯《言风》"},"example":{"text":"将南京元武湖赐与庄尚志～，鼓吹休明。","book":"清·吴敬梓《儒林外史》第三十五回"},"similar":["著书立言"],"usage":"作谓语、定语、宾语；指写作"},{"id":39012,"word":"著书等身","pinyin":"zhù shū děng shēn","abbr":"zsds","explanation":"形容著述极多，迭起来能跟作者的身高相等。","source":{"text":"黄中幼聪悟，方五岁，玭每旦令正立，展书卷比之，谓之等身书，课其诵读。","book":"《宋史·贾黄中传》"},"example":{"text":"黟汪先生南士，绩学敦行，～，以稽古余力，重为蒐补。（鲁迅《古集序跋集·关于汪辑本〈谢承后汉书〉》）"}},{"id":39013,"word":"著于竹帛","pinyin":"zhù yú zhú bó","abbr":"zyzb","explanation":"着：写作。竹帛：竹简和绢。在竹简和绢上写作。指把事物或人的功绩等写入书中。","source":{"text":"今子大夫修先生之术，慕圣人之义，讽诵诗书百家之言，不可胜记，著于竹帛，唇腐齿落，服膺而不可释。","book":"汉·东方朔《答客难》"},"example":{"text":"不过孔子是匹夫制宪，贬天子，刺诸侯，所以不能～，只好借口说传授。","book":"清·曾朴《孽海花》第三十四回"},"similar":["著乎竹帛","著之竹帛"],"usage":"作谓语、宾语；用于书面语"},{"id":39014,"word":"著作等身","pinyin":"zhù zuò děng shēn","abbr":"zzds","explanation":"形容著述极多，迭起来能跟作者的身高相等。","source":{"text":"黄中幼聪悟，方五岁，玭每旦令正立，展书卷比之，谓之等身书，课其诵读。","book":"《宋史·贾黄中传》"},"example":{"text":"会上陈列了他多年来的全部著作，那时他已是～了。","book":"曹禺《我们尊敬的老舍先生》"},"similar":["学富五车"],"opposite":["目不识丁","胸无点墨"],"usage":"作谓语、定语；指作品多","story":["宋朝时期，从小有神童之称的贾黄中15岁高中进士，他父亲对他要求很严，规定每天要读一定数量的书籍，办法是将要读的文章篇幅展开，用它来量黄中的身高。身高多少就得读完多长的文章。黄中的记忆力相当惊人，居然读完就可背诵"]},{"id":39015,"word":"著手成春","pinyin":"zhuó shǒu chéng chūn","abbr":"zscc","explanation":"著手：动手接触。指诗歌格调自然清新。后比喻医术高明。","source":{"text":"俯拾即是，不取诸邻，俱道适往，著手成春。如逢花开，如瞻岁新。","book":"唐·司空图《二十四诗品·自然》"},"example":{"text":"画梅，宗王元章一派，千枝万蕊，～。","book":"清·钱泳《履园丛话·画学·画中人》"},"similar":["妙手回春"],"usage":"作谓语、定语、宾语；指医术"},{"id":39016,"word":"著有成效","pinyin":"zhù yǒu chéng xiào","abbr":"zycx","explanation":"著：显著。有突出的成绩和效果。","source":{"text":"若巡访劝谕著有成效者，县官备礼亲造其庐，重加奖励。","book":"明·王守仁《申行十家牌法》"},"example":{"text":"嘉庆间，四川举办乡团，行坚壁清野之法，～，自应仿办。（《清史稿·兵志四》）"}},{"id":39017,"word":"著粪佛头","pinyin":"zhuó fèn fó tóu","abbr":"zfft","explanation":"著：同“着”。往佛像的头上拉粪。比喻美好的事物被亵渎、玷污","source":{"text":"达夫的《沉沦》，资平的《冲积期化石》，都曾叫我作序，但我都没有著粪佛头。","book":"郭沫若《创造十年续编》"},"similar":["佛头著粪","佛头着粪"],"usage":"作谓语、宾语、定语；指亵渎美好的事物"},{"id":39018,"word":"著述等身","pinyin":"zhù shù děng shēn","abbr":"zsds","explanation":"著述：编写的著作。写的书摞起来和自己的身高相等。形容著作极多。亦作“著作等身”。","source":{"text":"自是以外，虽著述等身，声华盖代，总听其自贮名山，不得入此门一步焉，先圣之志也。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录一》"},"example":{"text":"伟烈君通天算之学，生平～，而精勤惕厉，未尝一日废书不观也。","book":"清·王韬《瀛壖杂志》卷六"},"similar":["著作等身"],"usage":"作谓语、定语；指作品多"},{"id":39019,"word":"葛屦履霜","pinyin":"gě jù lǚ shuāng","abbr":"gjls","explanation":"冬天穿著夏天的鞋子。比喻过分节俭吝啬。","source":{"text":"葛屦履霜，诮俭啬之过甚。","book":"《诗经·魏风·葛屦》：“纠纠葛屦，可以履霜？”《幼学琼林·卷二·衣服类》"},"example":{"text":"你不会学那～般吝啬吧"},"usage":"作宾语、定语；用于比喻句"},{"id":39020,"word":"葛巾布袍","pinyin":"gé jīn bù páo","abbr":"gjbp","explanation":"葛巾：用葛布做的头巾。戴葛布头巾穿粗布衣服。指隐士或道士的服饰。","source":{"text":"干葛巾布袍，驾一只小舟，径到周瑜寨中。","book":"明·罗贯中《三国演义》第45回"},"usage":"作宾语、定语；指隐士装束"},{"id":39021,"word":"葛巾野服","pinyin":"gé jīn yě fú","abbr":"gjyf","explanation":"葛巾：用葛布缝制的头巾。戴葛布头巾，穿乡野粗布衣服。指隐士或道士的服饰。","source":{"text":"这国能葛巾野服，扮作了道童模样。","book":"明·凌濛初《二刻拍案惊奇》第二卷"},"example":{"text":"蘧太守也换了～，拄着天台藤杖，出来陪坐。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["葛巾布袍"],"usage":"作宾语、定语；用于人的服饰"},{"id":39022,"word":"董狐之笔","pinyin":"dǒng hú zhī bǐ","abbr":"dhzb","explanation":"后人对那些公正不偏，不因为各人的好恶或利害关系，而捏造不实言论的人的称呼。","source":{"text":"董狐，古之良史也，书法不隐。","book":"《左传·宣公二年》载：赵穿杀晋灵公，身为正卿的赵盾没有管，董狐认为赵盾应负责任，便在史策上记载说赵盾弑其君。为赵盾所杀。后孔子称赞说"},"example":{"text":"《曾国藩》曾国荃对大哥的说法不服气。去年湘中士人公推王闿运撰湘军志。王闿运也扬言，为湘军修志一事非他莫属，他要秉～，不溢美，不饰恶，为湘军存一信史。"}},{"id":39023,"word":"董狐直笔","pinyin":"dǒng hú zhí bǐ","abbr":"dhzb","explanation":"董狐：春秋时晋国的史官。直笔：根据事实，如实记载。指敢于秉笔直书，尊重史实，不阿权贵的正直史家。","source":{"text":"董狐，古之良史也，书法不隐。","book":"《左传·宣公二年》载：赵穿杀晋灵公，身为正卿的赵盾没有管，董狐认为赵盾应负责任，便在史策上记载说“赵盾弑其君”。为赵盾所杀。后孔子称赞说"},"usage":"作宾语、定语；指尊重历史事实","story":["春秋时期，晋灵公十分残暴，相国赵盾劝他改变作风。晋灵公竟想杀他，他只好准备出逃。赵穿刺杀了晋灵公。太史董狐在史书上写赵盾杀其君。赵盾不服要求改写。董狐说：“你身为相国，国君被杀，你不讨贼，你就是主谋，这事我就是死也不会改。”"]},{"id":39024,"word":"葫芦依样","pinyin":"hú lu yī yàng","abbr":"hlyy","explanation":"依样画葫芦。比喻只是模仿，缺乏创造。","source":{"text":"工者不免优孟抵掌之诮，拙者至有葫芦依样之讥。","book":"清·周亮工《书影》第三卷"},"example":{"text":"才既不天，而仅～的我们，那就不能不有多少学理上的准备。","book":"郭沫若《文艺论集·批评与梦》"},"similar":["依样葫芦"],"usage":"作定语；指模仿","story":["宋朝初年，翰林学士陶谷自以为文笔高超、才能出众，想好好表现一下升职，他劝宋太祖重视文字工作。赵匡胤以为他的工作只是抄写而已，说是依样画葫芦。陶谷的目的没有达到，就在住处墙上题诗：“堪笑翰林陶学士，年年依样画葫芦”"]},{"id":39025,"word":"葬玉埋香","pinyin":"zàng yù mái xiāng","abbr":"zymx","explanation":"指美丽的女子死亡。含有惋惜之意。","source":{"text":"车道之北，邽山之阳。深深葬玉，郁郁埋香。","book":"唐·无名氏《王承检掘得墓铭》"},"example":{"text":"～偏不免，上天入地总无因。箧中侥幸存遗稿，十万珠玑认化身。","book":"田汉《黑马·跋》"},"usage":"作谓语、定语；用于书面语"},{"id":39026,"word":"葬用柔日","pinyin":"zàng yòng róu rì","abbr":"zyrr","explanation":"柔日：天干中的乙、丁、己、辛、癸五天，其余五天为刚日。春秋时代习俗，死者埋葬必须选择柔日","source":{"text":"春秋葬用柔日，汉人不知此义，皆用刚日。","book":"清·顾炎武《日知录·经义·葬用柔日》"},"usage":"作宾语、定语；用于书面语"},{"id":39027,"word":"葬身鱼腹","pinyin":"zàng shēn yū fù","abbr":"zsyf","explanation":"尸体为鱼所食。指淹死于水中。","source":{"text":"宁赴湘流，葬于江鱼之腹中。安能以皓皓之白，而蒙世俗之尘埃乎？","book":"战国·楚·屈原《渔父》"},"example":{"text":"只要你舍得这辆汽车，我就奉陪三百回合，直到大雨把汽车冲进大河，咱俩一同～。","book":"刘绍棠《十步芳草》"},"similar":["命赴黄泉","一命呜呼","玉陨香消"],"opposite":["长命百岁","寿比南山","万寿无疆"],"usage":"作谓语、宾语；指淹死水中"},{"id":39028,"word":"葭莩之亲","pinyin":"jiā fú zhī qīn","abbr":"jfzq","explanation":"葭莩：芦苇杆内壁的薄膜。比喻关系疏远的亲戚。","source":{"text":"今群臣非有葭莩之亲。","book":"《汉书·中山靖王传》"},"example":{"text":"唐炯是张之洞的大舅子，跟他亦算有～，所以于公于私，他都不能不派人来送信。","book":"高阳《母子君臣》"},"usage":"作宾语；比喻远亲"},{"id":39029,"word":"葭莩之情","pinyin":"jiā fú zhī qíng","abbr":"jfzq","explanation":"葭莩：苇杆里的薄膜。指亲戚间的感情。","source":{"text":"葭莩之情，爱何待言。","book":"清·蒲松龄《聊斋志异·婴宁》"},"example":{"text":"谁都会有～的。"},"usage":"作宾语；指亲情"},{"id":39030,"word":"葱翠欲滴","pinyin":"cōng cuì yù dī","abbr":"ccyd","explanation":"葱翠：深绿。形容草木等绿色植物仿佛饱含水份一样。","source":{"text":"春山澹冶而如笑，夏山苍翠而欲滴，秋山明净而如妆，冬山惨淡而如睡。","book":"宋·郭熙《山川训》"}},{"id":39031,"word":"葱葱郁郁","pinyin":"cōng cōng yù yù","abbr":"ccyy","explanation":"郁郁：草木茂盛的样子。形容草木苍翠茂盛。也形容气势美好蓬勃。","source":{"text":"你看前面海岸，葱葱郁郁，绿杨成郭，烟雨楼台。","book":"梁启超《新罗马·吊古》"},"similar":["郁郁葱葱"],"opposite":["赤地千里"],"usage":"作谓语、定语、状语；形容气势"},{"id":39032,"word":"葱蔚洇润","pinyin":"cōng wèi yīn rùn","abbr":"cwyr","explanation":"葱蔚：草木生长茂盛；洇润：润泽，滋润。形容草木苍翠润泽，生机勃勃。","source":{"text":"就是后面一带花园里，树林山石，也都还有葱蔚洇润之气，哪里象个衰败之家。","book":"清·曹雪芹《红楼梦》第二回"},"usage":"作定语；用于气势等"},{"id":39033,"word":"葵倾向日","pinyin":"kuí qīng xiàng rì","abbr":"kqxr","explanation":"形容下级对上级表示忠诚与仰慕。","source":{"text":"谁知俺一片葵倾向日花。","book":"清·孔尚任《桃花扇·抚兵》"},"similar":["葵花向日"],"usage":"作宾语、定语；用于下级对上级"},{"id":39034,"word":"葵花向日","pinyin":"kuí huā xiàng rì","abbr":"khxr","explanation":"向：朝着。形容下级对上级表示忠诚与仰慕。","source":{"text":"若葵藿之倾叶，太阳虽不为之回光，然终向之者，诚也。","book":"三国·魏·曹植《求通亲亲表》"},"example":{"text":"更无柳絮随风起，惟有～倾。","book":"宋·司马光《初夏》"},"similar":["葵花倾日"],"usage":"作宾语、定语；用于下级对上级"},{"id":39035,"word":"葵藿之心","pinyin":"kuí huò zhī xīn","abbr":"khzx","explanation":"比喻臣下对君主表示忠诚或对所仰慕的人的尊敬之情。","source":{"text":"葵藿之心，庶知向日。犬马之意，何足动天。","book":"唐·王维《责躬荐弟表》"},"example":{"text":"桑榆之景方暮，～迭倾。","book":"宋·田锡《泰山父老望登封赋》"},"usage":"作宾语；用于比喻句"},{"id":39036,"word":"葵藿倾阳","pinyin":"kuí huò qīng yáng","abbr":"khqy","explanation":"葵：葵花；藿：豆类植物的叶子。葵花和豆类植物的叶子倾向太阳。比喻一心向往所仰慕的人或下级对上级的忠心。","source":{"text":"臣草莽微臣，窃不自揆，敢抱葵藿倾阳之心，仰慕《周易》匪躬之志，故不远六千里，愿言命侣，谨贡丹愚，希垂察纳。","book":"《宋书·彭城王义康传》"},"example":{"text":"幸同～早，愿比盘根应候荣。","book":"唐·郑愔《奉和春日幸望春宫》诗"},"usage":"作宾语、定语；指忠诚"},{"id":39037,"word":"蒋干盗书","pinyin":"jiǎng gàn dào shū","abbr":"jgds","explanation":"蒋干：《三国演义》中的人物。蒋干盗去书信回到曹营杀自己大将。比喻中别人的反间计。","example":{"text":"～的故事不能忘。"},"usage":"作宾语、定语；指中计","story":["三国时期，蒋干受曹操的命令前去周瑜营中劝降。周瑜知道同窗好友是受命而来，暗作布置，宴席上不允许谈论政治，只叙旧喝酒，安排夜间同睡。周瑜故意让蒋干盗得蔡瑁、张允假降书信交给曹操。周瑜设计成功地让曹操杀害了这两个劲敌"]},{"id":39038,"word":"蒙以养正","pinyin":"méng yǐ yǎng zhèng","abbr":"myyz","explanation":"指从童年开始，就要施以正确的教育。","source":{"text":"蒙以养正，圣功也。","book":"《易·蒙》"},"usage":"作宾语；指教育要从童年开始"},{"id":39039,"word":"蒙冤受屈","pinyin":"méng yuān shòu qū","abbr":"mysq","explanation":"蒙：受；冤：冤枉；屈：屈辱。遭受了冤枉和屈辱。","source":{"text":"他只待强拆开我长搀搀的连理枝，生摆断我颤巍巍的并头莲。其实负屈衔冤。","book":"元·关汉卿《望江亭》第四折"}},{"id":39040,"word":"蒙在鼓里","pinyin":"méng zài gǔ lǐ","abbr":"mzgl","explanation":"好像被包在鼓里一样。比喻受人蒙蔽，对有关的事情一点儿也不知道。","source":{"text":"我是要听听，否则我真蒙在鼓里，不知道人家在背后怎样糟蹋我呢？","book":"钱钟书《围城》"},"example":{"text":"我还～，对此时一无所知。"},"similar":["闷在鼓里"],"usage":"作谓语；指受人蒙蔽"},{"id":39041,"word":"蒙头转向","pinyin":"mēng tóu zhuàn xiàng","abbr":"mtzx","explanation":"蒙：迷糊，昏迷；转向：迷失方向。形容头脑昏迷，不清晰。","source":{"text":"刚一动手的时候，我有点蒙头转向的。","book":"老舍《神拳》第一幕第二场"},"example":{"text":"同时还想多搞些问题出来，使何子学他们忙得～。","book":"艾芜《百炼成钢》第12章"},"similar":["晕头转向"],"opposite":["头脑清醒"],"usage":"作谓语、状语；指不清晰"},{"id":39042,"word":"蒙尘","pinyin":"meng chen","abbr":"mc","explanation":"指皇帝被驱逐出宫廷，在外流亡而言。"},{"id":39043,"word":"蒙恩被德","pinyin":"méng ēn bèi dé","abbr":"mebd","explanation":"蒙、被：受到。受到别人的恩惠。","source":{"text":"崔相姻亲交朋，蒙恩被德。","book":"元·董解元《西厢记》卷二"}},{"id":39044,"word":"蒙昧无知","pinyin":"méng mèi wú zhī","abbr":"mmwz","explanation":"蒙昧：知识未开。没有知识，不明事理。指糊涂不懂事理。","source":{"text":"臣诚蒙昧，所以为罪。","book":"《晋书·阮种传》"},"example":{"text":"那些将马克思列宁主义当宗教教条看待的人，就是这种～的人。","book":"毛泽东《整顿党的作风》"},"similar":["冥顽不灵"],"opposite":["学富五车"],"usage":"作谓语、定语；指不明事理"},{"id":39045,"word":"蒙混过关","pinyin":"méng hùn guò guān","abbr":"mhgg","explanation":"用欺骗的手段逃过关口。","source":{"text":"她四处做手脚，造假象，为调查设置障碍，企图蒙混过关。","book":"《中国纪检监察报》"},"example":{"text":"你不要希望～。"},"similar":["混水摸鱼"],"opposite":["真才实学"],"usage":"作谓语、宾语；用欺骗的手段逃过关口","story":["春秋时期伍子胥在郑国劝阻楚国的太子建不要做晋国的内应没有成功，事发后他只好带着太子建的儿子逃往吴国，在路上官兵搜捕他们，他遇到神医扁鹊的弟子东皋公，一夜间须发全白了。东皋公让皇甫讷扮伍子胥，这样才蒙混过关到吴国"]},{"id":39046,"word":"蒙然坐雾","pinyin":"mēng rán zuò wù","abbr":"mrzw","explanation":"蒙：昏迷。糊里糊涂，什么也不知道。","source":{"text":"及有吉凶大事，议论得失，蒙然张口，如坐云雾。","book":"北齐·颜之推《颜氏家训·勉学》"}},{"id":39047,"word":"蒙袂辑屦","pinyin":"méng mèi jí jù","abbr":"mmjj","explanation":"袂：袖子；辑：拖着不使脱落；屦：鞋。用袖子蒙着脸，脚上拖着鞋。形容十分困乏的样子。","source":{"text":"有饿者蒙袂辑屦，贸贸然来。","book":"《礼记·檀弓下》"},"example":{"text":"方之～，有愤于黔敖，擿植索涂，见称于杨子，差不同耳。","book":"唐·段成式《酉阳杂俎·支诺皋上》"},"usage":"作谓语、定语；指十分狼狈"},{"id":39048,"word":"蒙面丧心","pinyin":"méng miàn sàng xīn","abbr":"mmsx","explanation":"蒙：包，遮蔽。遮起脸面，不讲良心。比喻厚颜无耻，伤天害理。","source":{"text":"而既归西京，讨贼之功，方将就绪，苶然委顺，制于悍妻，迫于家奴，使拥兵劫父，囚处别宫，唯其所为，莫之能禁，乃至蒙面丧心。","book":"明·王夫之《读通鉴论》卷二十三"},"example":{"text":"你的罪过，朝野俱知，～，还敢入庙。","book":"清·孔尚任《桃花扇·哄丁》"},"usage":"作谓语、定语；用于坏人"},{"id":39049,"word":"蒲元识水","pinyin":"pú yuán shí shuǐ","abbr":"pyss","explanation":"蒲元：人名。指实践经验十分丰富。","source":{"text":"君以淬刀，言杂涪水，不可用。取水者捍言不杂。君以刀画水，言杂八升。","book":"《太平御览》"},"usage":"作宾语、定语；指经验丰富","story":["三国时期，才智超人的蒲元在斜谷替诸葛亮制造三千把军刀，刀铸成后，他说用蜀江水淬火就能使清亮刚烈。就派人到成都取蜀江水。水取回后，蒲元用它为刀淬火，马上发现水中掺假，细问取水人，才得知在涪江渡口用涪江水增补"]},{"id":39050,"word":"蒲扇价增","pinyin":"pú shàn jià zēng","abbr":"psjz","explanation":"蒲扇：用香蒲编的扇子。形容某种东西因受到名人的使用而价格增长。","source":{"text":"安乃取其中者捉之，京师士庶竞市，价增数倍。","book":"《晋书·谢安传》"},"usage":"作宾语、定语；指名人效应","story":["晋朝时期，谢安才华出众，曾经隐居东山20多年，他久负盛名，很多人都仰慕他。有一个同乡人在中宿县被免了官，去拜访谢安。谢安问他带回什么特产。他拿出一把蒲扇送给谢安使用。京都士族和庶族见谢安使用蒲扇就争相抢购，扇子价格涨了好几倍"]},{"id":39051,"word":"蒲柳之姿","pinyin":"pú liǔ zhī zī","abbr":"plzz","explanation":"蒲柳：蒲和柳皆望秋先凋，引申为早衰。旧时称自己体质弱的客套话。","source":{"text":"蒲柳之姿，望秋而落；松柏之质，经霜弥茂。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"学生自愧～，敢烦桃李之教。","book":"明·汤显祖《牡丹亭》第五出"},"similar":["蒲柳之质"],"usage":"作宾语；比喻衰弱的体质","story":["东晋时期，扬州刺史殷浩请顾悦做官，顾悦重义守信，倾注全力处理政务，长期的劳累使得30多岁的顾悦满头白发。殷浩劝他注意身体。顾悦在殷浩的引见下见到年纪相仿的简文帝，简文帝感到诧异。顾悦说皇上是松柏之质，他是蒲柳之姿经不起风霜"]},{"id":39052,"word":"蒲柳之质","pinyin":"pú liǔ zhī zhì","abbr":"plzz","explanation":"蒲柳：水杨，秋天凋谢早。多用来比喻身体衰弱或未老先衰。","source":{"text":"蒲柳之姿，望秋而落；松柏之质，经霜弥茂。","book":"南朝·宋·刘义庆《世说新语·言语》"},"example":{"text":"公主所论,实切愿怀。但恐～，难与国英雁行。","book":"清·褚人获《隋唐演义》第六十一回"},"similar":["蒲柳之姿"],"usage":"作宾语；比喻衰弱的体质","story":["晋代尚书右丞顾悦与简文帝同岁，文帝头发全黑，而顾悦头发全白了。文帝问他为什么头发先白？顾悦回答道：“皇帝您是松柏之姿，经霜犹茂；臣是蒲柳之质，望秋先零。”文帝听后十分高兴"]},{"id":39053,"word":"蒲牒写书","pinyin":"pú dié xiě shū","abbr":"pdxs","explanation":"蒲：蒲草；牒：片、竹片等。编蒲为牒，用以写书。","source":{"text":"路温舒牧羊。温舒取泽中蒲，截以牒，编用写书。","book":"《汉书·路温舒传》"}},{"id":39054,"word":"蒲邑三善","pinyin":"pú yì sān shàn","abbr":"pyss","explanation":"蒲邑：蒲县，在山西隰县。孔子的弟子子路治理蒲邑，孔子称赞他有三善：恭敬、忠信、明察。","source":{"text":"子路治蒲三年，孔子过之。入其境曰：‘善哉由也，恭敬以信矣。’至廷曰：‘善哉由也，明察以断矣。’","book":"《孔子家语·辨政》"}},{"id":39055,"word":"蒲鞭之政","pinyin":"pú biān zhī zhèng","abbr":"pbzz","explanation":"蒲：香蒲，一种草本植物。以蒲为鞭，柔软不能伤人。旧时称官吏宽厚仁慈。","source":{"text":"臣职右南阳，谢蒲鞭之政。","book":"南朝·梁·江淹《为始安王拜南兗州刺史章》"},"usage":"作宾语；指仁治"},{"id":39056,"word":"蒲鞭之罚","pinyin":"pú biān zhī fá","abbr":"pbzf","explanation":"比喻对下属的过错持宽容的态度。","source":{"text":"吏人有过，但以蒲鞭罚之，示辱而已，终不加苦。","book":"《后汉书·刘宽传》"},"usage":"作宾语、定语；用于书面语"},{"id":39057,"word":"蒲鞭示辱","pinyin":"pú biān shì rǔ","abbr":"pbsr","explanation":"对有过错的人用蒲做的鞭子抽打，只是为了使他感到羞耻，并不使他皮肉受苦。旧时用于宣扬官吏的所谓宽仁。","source":{"text":"吏人有过，但以蒲鞭罚之，示辱而已，终不加苦。","book":"《后汉书·刘宽传》"},"example":{"text":"各怀旧恩，又心服他前知，加意用情，手腕偷力，～而已。","book":"明·凌濛初《二刻拍案惊奇》卷三十三"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，官员刘宽为官清正，善于从心理上去治理他的辖区，他不用很残酷的刑罚，对于部下或百姓犯错时，只是用蒲鞭抽几下而已，让他自己感到羞辱，下次好知错必改"]},{"id":39058,"word":"蒸沙为饭","pinyin":"zhēng shā wéi fàn","abbr":"zswf","explanation":"要把沙子蒸成饭。比喻事情不可能成功。同“蒸沙成饭”。","source":{"text":"清净是菩提，爱染难离，蒸沙为饭饭终非，暮鼓晨钟勤忏悔，怎免阿鼻。","book":"明·周履靖《锦笺记》第十九出"},"similar":["蒸沙成饭","蒸沙作饭"],"usage":"作宾语、定语；用于比喻句"},{"id":39059,"word":"蒸沙作饭","pinyin":"zhēng shā zuò fàn","abbr":"zszf","explanation":"要把沙子蒸成饭。原为佛家语，比喻事情不可能成功。","source":{"text":"若不断淫，修禅定者，如蒸沙石欲其成饭，经千百劫，只名热沙。","book":"《楞严经》卷六"},"example":{"text":"你～可能吗？"},"similar":["蒸沙为饭","蒸沙成饭"],"usage":"作宾语、定语；指不可能的事情"},{"id":39060,"word":"蒸沙成饭","pinyin":"zhēng shā chéng fàn","abbr":"zscf","explanation":"要把沙子蒸成饭。比喻事情不可能成功。","source":{"text":"若不断淫，修禅定者，如蒸沙石欲其成饭，经千百劫，只名热沙。","book":"《楞严经》"},"similar":["炊沙成饭"],"usage":"作谓语、定语；指不可能的事情"},{"id":39061,"word":"蒸蒸日上","pinyin":"zhēng zhēng rì shàng","abbr":"zzrs","explanation":"蒸蒸：上升、兴盛的样子。一天比一天上升发展。形容事业一天天向上发展。","source":{"text":"余蒸蒸焉日有长进，而公病归矣。","book":"《诗经·鲁颂·泮水》：“烝烝皇皇，不吴不扬。”明·李开先《闲居集·资善大夫太常寺卿兼翰林院五经博士西桥刘公墓志铭》"},"example":{"text":"你世兄又是槃槃大才，调度有方，还怕不～吗？（清·李宝嘉《官场现形记》第五十二回）"},"similar":["欣欣向荣","如日方升","隆隆日上"],"opposite":["每况愈下","江河日下"],"usage":"作谓语、定语；指兴旺"},{"id":39062,"word":"蒸蒸日盛","pinyin":"zhēng zhēng rì shèng","abbr":"zzrs","explanation":"蒸蒸：上升、兴盛的样子。一天比一天上升发展。形容事业一天天向上发展。同“蒸蒸日上”。","source":{"text":"自兹以后，行见东瀛留学界，蒸蒸日盛矣。","book":"清·秋瑾《〈中国女报〉发刊辞》"},"similar":["蒸蒸日进","蒸蒸日上"],"opposite":["每况愈下","江河日下"],"usage":"作谓语、定语；指兴旺"},{"id":39063,"word":"蒸蒸日进","pinyin":"zhēng zhēng rì jìn","abbr":"zzrj","explanation":"蒸蒸：上升、兴盛的样子。一天比一天上升发展。形容事业一天天向上发展。同“蒸蒸日上”。","source":{"text":"余蒸蒸焉日有长进，而公病归矣。","book":"明·李开先《闲居集·资善大夫太常寺卿兼翰林院五经博士西桥刘公墓志铭》"},"example":{"text":"大凡一国的政治濒于破产的时候，那一国的文化却转有～的可能。","book":"郭沫若《文艺论集·天才与教育》"},"similar":["蒸蒸日上","蒸蒸日盛"],"opposite":["每况愈下","江河日下"],"usage":"作谓语、定语；指兴旺"},{"id":39064,"word":"蒹葭之思","pinyin":"jiān jiā zhī sī","abbr":"jjzs","explanation":"蒹葭：初生的芦苇；思：思念，怀念。指恋人的思念之情。","source":{"text":"蒹葭苍苍，白露为霜，所谓伊人，在水一方。","book":"《诗经·秦风·蒹葭》"},"usage":"作宾语；用于书面语"},{"id":39065,"word":"蒹葭伊人","pinyin":"jiān jiā yī rén","abbr":"jjyr","explanation":"蒹葭：初生的芦苇；伊人：那个人。指一心寻求思恋而不曾会面的人。","source":{"text":"蒹葭苍苍，白露为霜，所谓伊人，在水一方。","book":"《诗经·秦风·蒹葭》"},"example":{"text":"奉教忽焉经岁，～，自是朋辈相怀，终以一水为恨；若不肖于先生，直高山仰止耳。","book":"徐世溥《寄侍御李匡山先生书》"},"usage":"作宾语、定语；指思念亲人"},{"id":39066,"word":"蒹葭倚玉","pinyin":"jiān jiā yǐ yù","abbr":"jjyy","explanation":"蒹、葭：价值低微的水草，比喻微贱。表示地位低的人依附地位高的人。","source":{"text":"小女娇痴慕学，得承高贤不弃，今幸结此良缘，蒹葭倚玉，惶恐惶恐。","book":"明·凌濛初《二刻拍案惊奇》第17卷"},"example":{"text":"太太如此见爱，妾非木石，那有不感激的理，只是同太太并肩拍照，～，恐折薄福。","book":"清·曾朴《孽海花》第12回"},"similar":["蒹葭玉树"],"usage":"作宾语、定语；用于谦辞"},{"id":39067,"word":"蒹葭倚玉树","pinyin":"jiān jiā yǐ yù shù","abbr":"jjyys","explanation":"蒹葭：没有长穗的芦苇。芦苇靠在玉树旁。比喻一丑一美不能相比。也用作借别人的光的客套话。","source":{"text":"魏蝗帝使后弟毛曾与夏侯元并坐，时人谓蒹葭倚玉树。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"太太如此见爱，，妾非木石，那有不感激的哩？只是同太太并肩拍照，～，恐折薄福。","book":"清·曾朴《孽海花》第十二回"},"similar":["蒹葭倚玉"],"usage":"作宾语、定语；用于自谦","story":["三国时期，黄门侍郎夏侯玄一表人才，有玉人之称。他自视甚高，很有傲气。驸马都尉毛曾相貌丑陋，令人生厌，他凭着自己的姐姐是皇后经常找机会接近夏侯玄，他们坐在一起人称为蒹葭倚玉树，夏侯玄十分不满，魏明帝因此而降他的职"]},{"id":39068,"word":"蒹葭玉树","pinyin":"jiān jiā yù shù","abbr":"jjys","explanation":"蒹葭：价值低微的水草，比喻微贱。表示地位低的人依附地位高的人。","source":{"text":"魏明帝使后弟毛曾与夏侯玄并坐，时人谓‘蒹葭倚玉树’。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"云屏初列，彩丝新恋，袖映屏山艳，～，低回笑揽芳年。","book":"明·陈汝元《金莲记·小星》"},"similar":["蒹葭倚玉树"],"usage":"作宾语、定语；用于谦辞","story":["三国时期，黄门侍郎夏侯玄一表人才，有玉人之称。他自视甚高，很有傲气。驸马都尉毛曾相貌丑陋，令人生厌，他凭着自己的姐姐是皇后经常找机会接近夏侯玄，他们坐在一起人称为蒹葭倚玉树，夏侯玄十分不满，魏明帝因此而降他的职"]},{"id":39069,"word":"蒿目时艰","pinyin":"hàng mù shí jiān","abbr":"hmsj","explanation":"蒿目：极目远望；时艰：艰难的局势。指对时事忧虑不安。","source":{"text":"今世之仁人，蒿目而忧世之患。","book":"《庄子·骈拇》"},"example":{"text":"先本是台湾的臬台，因～，急流勇退，威毅伯笃念故旧，派了这个清闲的差使。","book":"清·曾朴《孽海花》第三十回"},"usage":"作谓语；形容对时局忧虑不安"},{"id":39070,"word":"蓄盈待竭","pinyin":"xù yíng dài jié","abbr":"xydj","explanation":"蓄：积蓄；竭：干涸，指士气衰落。积聚部队的锐气，等待敌方士气低落时，再行出击。","source":{"text":"若此，则当卷迹藏声，蓄盈待竭，避其锋势，与之持久，安可犯之哉！","book":"唐·杜佑《通典》卷一百五十四"},"usage":"作宾语、定语；用于军事等"},{"id":39071,"word":"蓄精养锐","pinyin":"xù jīng yǎng ruì","abbr":"xjyr","explanation":"犹养精蓄锐。","source":{"text":"正值烟瘴炽发，钦奉谕旨，轸念士卒，仡令停兵，蓄精养锐。","book":"清昭槤《啸亭杂录·缅甸归诚本末》"},"similar":["养精蓄锐"],"usage":"作谓语、定语、宾语；用于军力、比赛等"},{"id":39072,"word":"蓄谋已久","pinyin":"xù móu yǐ jiǔ","abbr":"xmyj","explanation":"蓄：等待；谋：谋划。对某件事情等待、谋划了很长时间。含贬义。","example":{"text":"由于清廷在甲午战争中的失败，进一步促成了列强瓜分中国之势，英国趁机将～的“香港拓界”付诸实施。","book":"霍达《补天裂·后记》"}},{"id":39073,"word":"蓄锐养威","pinyin":"xù ruì yǎng wēi","abbr":"xryw","explanation":"积蓄锐气，保养威力。","source":{"text":"今若更存尊养，且复相时，臣谓宜还崇邻好，申其盟约，安人和众，通商惠工，蓄锐养威，观衅而动。","book":"《周书·韦孝宽传》"},"similar":["养威蓄锐","养锐蓄威"],"usage":"作谓语、宾语、定语；用于处事等"},{"id":39074,"word":"蓄锐养精","pinyin":"xù ruì yǎng jīng","abbr":"xryj","explanation":"《周书·韦孝宽传》：“今若更存尊养，且复相时，臣谓宜还崇邻好，申其盟约，安人和众，通商惠工，蓄锐养威，观衅而动。”","source":{"text":"今若更存尊养，且复相时，臣谓宜还崇邻好，申其盟约，安人和众，通商惠工，蓄锐养威，观衅而动。","book":"《周书·韦孝宽传》"},"example":{"text":"再讲陈炯明在漳数年，～，志不在小。","book":"蔡东藩、许廑父《民国通俗演义》第一百二十三回"}},{"id":39075,"word":"蓑笠纶竿","pinyin":"suō lì lún gān","abbr":"sllg","explanation":"蓑：蓑衣；笠：斗笠；纶：钓鱼的线。身披蓑衣，头戴斗笠，手持钓竿。形容鱼翁钓鱼的样子。也比喻不问世事的隐逸生活。","source":{"text":"待我蓑衣纶竿自然，我比姜太公多来近远。","book":"元·王伯成《贬夜郎》第四折"}},{"id":39076,"word":"蓝田出玉","pinyin":"lán tián chū yù","abbr":"ltcy","explanation":"蓝田：地名，在陕西省。比喻名门出贤子弟。","source":{"text":"太祖见而异之，谓尚书仆射殷景仁、领军将军刘湛曰：‘蓝田出玉，岂虚也哉！’","book":"《宋书·谢庄传》"},"similar":["蓝田生玉"],"usage":"作宾语；比喻贤父生贤子"},{"id":39077,"word":"蓝田生玉","pinyin":"lán tián shēng yù","abbr":"ltsy","explanation":"蓝田：地名，在陕西省，古时蓝田出产美玉。旧时比喻贤父生贤子。","source":{"text":"蓝田生玉，真不虚也。","book":"晋·陈寿《三国志·吴志·诸葛恪传》：“诸葛恪字元逊，瑾长子也。”裴松之注引晋·虞溥《江表传》"},"example":{"text":"～，岂虚也哉？","book":"《南史·谢庄传》"},"similar":["蓝田出玉"],"usage":"作宾语；比喻贤父生贤子","story":["三国时期，诸葛亮的哥哥诸葛瑾在孙权手下为官。孙权让诸葛瑾带六岁的儿子诸葛恪赴宴，在毛驴的长脸上写“诸葛子瑜”讥笑他脸长。诸葛恪在四字后加上“之驴”，让人赞叹不已，孙权又考他，他一一对答如流，孙权夸他是蓝田生玉"]},{"id":39078,"word":"蓝田种玉","pinyin":"lán tián zhòng yù","abbr":"ltzy","explanation":"原指杨伯雍在蓝田的无终山种出玉来，得到美好的婚配。后用来比喻男女获得了称心如意的美好姻缘。","source":{"text":"公至所种玉田中，得璧五双，以聘。徐氏大惊，遂以女妻公。","book":"晋·干宝《搜神记》卷十一"},"example":{"text":"～，雍伯之良缘。","book":"清·程允升《幼学琼林·婚姻类》"}},{"id":39079,"word":"蓬头历齿","pinyin":"péng tóu lì chǐ","abbr":"ptlc","explanation":"头发蓬乱，牙齿稀疏。形容人衰老的容貌。","source":{"text":"其妻蓬头挛耳，齞脣历齿。","book":"战国楚·宋玉《登徒子好色赋》"},"example":{"text":"鹤发鸡皮，～。","book":"北周·庾信《竹杖赋》"},"similar":["老态龙钟"],"usage":"作谓语、定语；形容人的老态","story":["东汉时期，光武帝刘秀下诏让在王莽时期弃官不做的王霸重新做官，王霸坚决不同意，与他同郡令狐子伯是好朋友。令狐子伯的儿子当上了功曹，前去拜访王霸。王霸见自己的儿子跟着他一样从事农活蓬头历齿的样子，心中有愧，觉得对不起儿子"]},{"id":39080,"word":"蓬头厉齿","pinyin":"péng tóu lì chǐ","abbr":"ptlc","explanation":"形容头发蓬松，牙齿缺落，年高衰老的容态。","example":{"text":"二十年前风度翩翩的老张，经过多年生活的磨难，已变成～了。"}},{"id":39081,"word":"蓬头垢面","pinyin":"péng tóu gòu miàn","abbr":"ptgm","explanation":"头发蓬乱，脸上很脏。旧时形容贫苦人生活生活条件很坏的样子。也泛指没有修饰。","source":{"text":"君子正其衣冠，尊其瞻视，何必蓬头垢面，然后为贤？","book":"《魏书·封轨传》"},"example":{"text":"穷人的孩子～的在街上转，富人的孩子妖形妖势娇声娇气的在家里转。","book":"鲁迅《热风·随感录二十五》"},"similar":["囚首垢面","不修边幅"],"opposite":["眉清目秀","风仪秀整"],"usage":"作谓语、定语、补语；指外表不整","story":["北魏时期，回族人封轨为人正直，喜欢学习，对儒家经典特有研究，他十分注意修饰打扮，有个不修边幅的文人说有学问的人都不注重打扮。封轨回答道：“品行好的人更应注重整洁，并不是蓬头垢面的人才能做贤人的。”那人悻悻而归"]},{"id":39082,"word":"蓬头散发","pinyin":"péng tóu sàn fà","abbr":"ptsf","explanation":"头发长而散乱。形容仪容不整。","source":{"text":"那张三又挑唆阎婆去厅上披头散发来告道：‘宋江实是宋清隐藏在家，不令出官。相公如何不与老身做主去拿宋江。’","book":"明·施耐庵《水浒全传》第二十二回"},"example":{"text":"一个～的瘦女人，满脸烟气，眼圈乌黑，挤眉弄眼的。","book":"杨沫《青春之歌》第二十六章"},"similar":["披头散发"],"usage":"作谓语、定语；形容非常狼狈"},{"id":39083,"word":"蓬头赤脚","pinyin":"péng tóu chì jiǎo","abbr":"ptcj","explanation":"头发蓬乱，光着脚丫。形容未经修饰很不整齐的样子。","source":{"text":"被人打得蓬头赤脚，衣裳粉碎。","book":"明·名教中人《好逑传》第一回"},"example":{"text":"清·李宝嘉《官场现形记》第八回：“新嫂嫂～，一定还要亲自替陶子尧打一条辫子，方容他走。”"},"similar":["蓬头赤足"],"usage":"作谓语、定语、状语；用于口语"},{"id":39084,"word":"蓬头跣足","pinyin":"péng tóu xiǎn zú","abbr":"ptxz","explanation":"头发散乱，双脚赤裸。形容人衣冠不整的样子。","source":{"text":"买臣妻的后夫亦在役中，其妻蓬头跣足，随伴送饭。","book":"明·冯梦龙《喻世明言》第27卷"},"example":{"text":"她那～的模样十分难看。"},"similar":["科头跣足"],"usage":"作谓语、定语；指人的外表"},{"id":39085,"word":"蓬室柴门","pinyin":"péng shì chái mén","abbr":"pscm","explanation":"用柴草、树枝等做成的门户。形容居处简陋，生活困苦。","source":{"text":"性嗜口腹，多事田渔，虽蓬室柴门，食必兼肉。","book":"《隋书·地理志上》"}},{"id":39086,"word":"蓬屋生辉","pinyin":"péng wū shēng huī","abbr":"pwsh","explanation":"蓬屋：简陋的房屋。使陋室增添光辉。","source":{"text":"家父斋僧二十余年，更不曾遇着好人，今幸圆满，四位下降，诚然是蓬屋生辉。","book":"明·吴承恩《西游记》第96回"},"similar":["蓬荜生辉","蓬闾生辉"],"usage":"作谓语、定语、宾语；多用作谦词"},{"id":39087,"word":"蓬心蒿目","pinyin":"péng xīn hāo mù","abbr":"pxhm","explanation":"心似飞蓬随风乱舞，眼若蒿烟迷矇恍惚。形容内心没有主见，现眼迷惑不清。"},{"id":39088,"word":"蓬户柴门","pinyin":"péng hù chái mén","abbr":"phcm","explanation":"用柴草、树枝等做成的门户。形容居处简陋，生活困苦。","source":{"text":"性嗜口腹，多事田渔，虽蓬室柴门，食必兼肉。","book":"《隋书·地理志上》"},"example":{"text":"住的是草舍茅菴，～，陋巷箪瓢，我可也委实难熬。","book":"元·无名氏《举案齐眉》第四折"},"similar":["蓬门筚户"],"usage":"作宾语、定语；用于生活等"},{"id":39089,"word":"蓬户桑枢","pinyin":"péng hù sāng shū","abbr":"phss","explanation":"蓬户：蓬草做的门。用蓬草编门，用桑树作门。指贫苦人家的住房。","source":{"text":"下官本蓬户桑枢之人，布衣韦带之士。","book":"南朝·梁·江淹《诣建平王上书》"},"similar":["蓬户瓮牖","蓬牖茅椽"],"usage":"作宾语、定语；指贫苦人家的住房"},{"id":39090,"word":"蓬户瓮牖","pinyin":"péng hù wèng yǒu","abbr":"phwy","explanation":"用蓬草编门，用破瓮做窗。指贫苦的人家。","source":{"text":"筚门圭窬，蓬户瓮牖。","book":"《礼记·儒行》"},"example":{"text":"原宪居鲁，环堵之室，茨以蒿莱，～，桷桑而无枢。","book":"汉·韩婴《韩诗外传》卷一"},"similar":["蓬门荜户"],"usage":"作宾语；指贫苦人家的住房"},{"id":39091,"word":"蓬牖茅椽","pinyin":"péng yǒu máo chuán","abbr":"pymc","explanation":"牖：窗；椽：放在檩上架着屋顶的木料。用蓬草、茅柴搭的房屋。形容住房简陋，生活贫困。","source":{"text":"所以蓬牖茅椽，绳床瓦灶，并不是妨我襟怀。","book":"清·曹雪芹《红楼梦》第十四回"},"similar":["蓬户瓮牖","蓬户桑枢"],"usage":"作宾语；指贫苦人家的住房"},{"id":39092,"word":"蓬生麻中","pinyin":"péng shēng má zhōng","abbr":"psmz","explanation":"比喻生活在好的环境里，也能成为好人。","source":{"text":"蓬生麻中，不扶而直；白沙在涅，与之俱黑。","book":"先秦·荀况《荀子·劝学》"},"example":{"text":"目能视而见之，耳能听而闻之，～，不劳翰墨。","book":"北齐·颜之推《颜氏家训·风操》"},"similar":["近墨者黑"],"usage":"作谓语；比喻环境对人的影响","story":["汉武帝的第五儿子刘胥被封为广陵王，由于没能继承王位，对自己的小弟刘弗陵怀恨在心，就请女巫诅咒昭帝早死，后来又用同样手段诅咒刘贺与刘询，见不起作用就与刘延寿合谋篡位。刘胥的儿子刘宝也同父亲一样干了许多坏事"]},{"id":39093,"word":"蓬生麻中，不扶而直","pinyin":"péng shēng má zhōng，bù fú ér zhí","abbr":"psmzbfez","explanation":"蓬：蓬草。蓬草长在大麻田里，不用扶持，自然挺直。比喻生活在好的环境里，得到健康成长。","source":{"text":"蓬生麻中，不扶而直，白沙在涅，与之俱黑。","book":"战国·赵·荀况《荀子·劝学》"},"similar":["蓬生麻中，不扶自直"],"usage":"作定语、分句；指环境对人的影响"},{"id":39094,"word":"蓬生麻中，不扶自直","pinyin":"péng shēng má zhōng，bù fú zì zhí","abbr":"psmzbfzz","explanation":"蓬草长在大麻田里，不用扶持，自然挺直。比喻生活在好的环境里，得到健康成长。","source":{"text":"蓬生麻中，不扶而直，白沙在涅，与之俱黑。","book":"《荀子·劝学》"},"example":{"text":"昔在江南，目能视而见之，耳能听而闻之，～，不劳翰墨。","book":"北齐·颜之推《颜氏家训·风操》"},"similar":["蓬生麻中，不扶而直"],"usage":"作定语、分句；指环境对人的影响"},{"id":39095,"word":"蓬筚生光","pinyin":"péng bì shēng guāng","abbr":"pbsg","explanation":"蓬荜：编蓬草、荆竹为门，形容穷苦人家。使寒门增添光辉（多用作宾客来到家里，或赠送可以张挂的字画等物的客套话）。","source":{"text":"圣旨召臣入院充学士，承旨使，星下独生蓬荜之光华。","book":"宋·苏轼《谢宣召入学士院状》"},"example":{"text":"贵脚踏入贱地，～。","book":"元·秦简夫《剪发待宾》第三折"}},{"id":39096,"word":"蓬筚生辉","pinyin":"péng bì shēng huī","abbr":"pbsh","explanation":"使寒门增添光辉（多用作宾客来到家里，或赠送可以张挂的字画等物的客套话）。","source":{"text":"圣旨召臣入院充学士，承旨使，星下独生蓬荜之光华。","book":"宋·苏轼《谢宣召入学士院状》"},"example":{"text":"谢人过访日～。","book":"清·程允升《幼学故事琼林·宫室》"},"similar":["蓬筚增辉","蓬闾生辉","蓬荜生光"],"usage":"作谓语；用于自谦"},{"id":39097,"word":"蓬荜增辉","pinyin":"péng bì zēng huī","abbr":"pbzh","explanation":"蓬荜：蓬门荜户，简陋的房屋。使陋室增添光辉。","source":{"text":"杯茗相邀，得蒙光降，顿使蓬荜增辉。","book":"明·兰陵笑笑生《金瓶梅词话》第31回"},"example":{"text":"你的到来让～。"},"similar":["蓬荜生辉"],"usage":"作谓语、定语；多用作谦词"},{"id":39098,"word":"蓬荜有辉","pinyin":"péng bì yǒu huī","abbr":"pbyh","explanation":"蓬荜：蓬门荜户，简陋的房屋。使陋室增添光辉。","source":{"text":"有劳仙驾珍顾，蓬荜有辉。","book":"明·吴承恩《西游记》第17回"},"similar":["蓬荜生辉","蓬荜增辉"],"usage":"作谓语、定语；多用作谦词"},{"id":39099,"word":"蓬荜生光","pinyin":"péng bì shēng guāng","abbr":"pbsg","explanation":"蓬荜：蓬门荜户，形容穷人的陋屋。使贫贱之家增加光彩。","source":{"text":"贵脚踏于贱地，蓬荜生光。","book":"《元曲选外编·剪发待宾》"},"example":{"text":"元·无名氏《剪发待宾》：“贵脚踏于贱地，～。”"},"similar":["蓬荜生辉","蓬屋生辉"],"usage":"作谓语；用于自谦"},{"id":39100,"word":"蓬荜生辉","pinyin":"péng bì shēng huī","abbr":"pbsh","explanation":"蓬荜：编蓬草、荆竹为门，形容穷苦人家。使寒门增添光辉（多用作宾客来到家里，或赠送可以张挂的字画等物的客套话）。","source":{"text":"贵脚踏于贱地，蓬荜生光。","book":"元·秦简夫《剪发待宾》第三折"},"example":{"text":"谢人过访日～。","book":"清·程允升《幼学故事琼林·宫室》"},"similar":["柴门有庆","蓬屋生辉","蓬荜生光"],"usage":"作谓语、宾语；多用作谦词"},{"id":39101,"word":"蓬蒿满径","pinyin":"péng hāo mǎn jìng","abbr":"phmj","explanation":"蓬：飞蓬，蓬草；蒿：青蒿。飞蓬、青蒿布满小路。形容多日无人出入之处。","source":{"text":"蓬蒿满径尘一榻，独此闵闵何其烦。","book":"唐·吴融《风雨吟》"},"example":{"text":"秦老献了茶，领那官员走到王冕家，推开了门，见蟏螨满室，～，知是果然去得久了。","book":"清·吴敬梓《儒林外史》第一回"}},{"id":39102,"word":"蓬蓬勃勃","pinyin":"péng péng bó bó","abbr":"ppbb","explanation":"繁荣旺盛的样子。","source":{"text":"各学校各机关各部队的宪政促进会呀，蓬蓬勃勃，办得很好。","book":"毛泽东《新民主主义的宪政》"},"example":{"text":"坚持民主集中制，我们的事业就会～地发展起来。","book":"邓小平《解决台湾问题，完成祖国统一大业提上具体日程》"},"similar":["朝气蓬勃"],"usage":"作谓语、状语、定语；用于新事物等"},{"id":39103,"word":"蓬赖麻直","pinyin":"péng lài má zhí","abbr":"plmz","explanation":"比喻生活在好的环境里，也能学习成为好人。","source":{"text":"蓬生麻中，不扶而直，白沙在涅，与之俱黑。","book":"《荀子·劝学》"}},{"id":39104,"word":"蓬门生辉","pinyin":"péng mén shēng huī","abbr":"pmsh","explanation":"使陋室增添光辉。","source":{"text":"徐先生，今天真是蓬门生辉。","book":"《花城》1980年第7期"},"similar":["蓬屋生辉","蓬闾生辉","蓬荜生辉"],"usage":"作定语、宾语；多用作谦词"},{"id":39105,"word":"蓬门筚户","pinyin":"péng mén bì hù","abbr":"pmbh","explanation":"蓬门：用蓬草编成的门；筚户：用荆条竹子树枝编成的门。形容穷苦人家所住的简陋的房屋。","source":{"text":"筚门圭窬，蓬户瓮牖。","book":"《礼记·儒行》"},"example":{"text":"野水萦纡石径斜，筚门蓬户两三家。","book":"明·于谦《村舍桃花》"},"similar":["蓬门荜户"],"usage":"作宾语；形容穷苦人家所住的简陋的房屋"},{"id":39106,"word":"蓬门荜户","pinyin":"péng mén bì hù","abbr":"pmbh","explanation":"用树枝、草等做成的房子。形容穷苦人家所住的简陋的房屋。","example":{"text":"蓬门荜户，鸟语花香，真是世外桃源。"},"similar":["蓬门瓮牖"],"usage":"作宾语；形容穷苦人家所住的简陋的房屋"},{"id":39107,"word":"蓬间雀","pinyin":"péng jiān què","abbr":"pjq","explanation":"蓬：飞蓬；野草；雀：小鸟。生活在蓬草间的小鸟。比喻目光短浅，没有志向的人。","source":{"text":"抟扶摇羊角而上者九万里，绝云气，负青天，然后图南，且适南冥也，斥鴳笑之曰：‘彼且奚适也？我腾跃而上，不过数仞而下，翱翔蓬蒿之间，此亦飞之至也。而彼且奚适也。","book":"《庄子·逍遥游》"},"example":{"text":"鲲鹏展翅，九万里，翻动扶摇羊角。背负青天朝下看，都是人间城郭。炮火连天，弹痕遍地。吓倒～。","book":"毛泽东《念奴娇·鸟儿问答》"}},{"id":39108,"word":"蓬闾生辉","pinyin":"péng lǘ shēng huī","abbr":"plsh","explanation":"蓬闾：简陋的房屋。使陋室增添光辉。","source":{"text":"孝移道：‘多蒙两位先生台爱，蓬闾生辉。’","book":"清·李汝珍《歧路灯》第四回"},"similar":["蓬屋生辉","蓬门生辉"],"usage":"作谓语、定语、宾语；多用作谦词"},{"id":39109,"word":"蓬首垢面","pinyin":"péng shǒu gòu miàn","abbr":"psgm","explanation":"头发很乱，脸上很脏。旧时形容贫苦人生活生活条件很坏的样子。也泛指没有修饰。","source":{"text":"君子正其衣冠，尊其瞻视，何必蓬头垢面，然后为贤？","book":"《魏书·封轨传》"},"example":{"text":"他虽然～，但相貌却依稀未改。"},"similar":["蓬头垢面"],"usage":"作谓语、定语、补语；指人的外表"},{"id":39110,"word":"蓼菜成行","pinyin":"liǎo cài chéng háng","abbr":"lcch","explanation":"把蓼菜一棵一棵地排列成行。比喻只能管理小事，不能治理大事。","source":{"text":"夫彻于一事，察于一辞，审于一技，可以曲说而未可广应也。蓼菜成行，甂瓯有提，称薪而爨，数米而炊，可以治小，而未可以治大也。","book":"《淮南子·泰族训》"}},{"id":39111,"word":"蓼虫不知苦","pinyin":"liǎo chóng bù zhī kǔ","abbr":"lcbzk","explanation":"蓼：一种有辣味的草。蓼的味苦，寄生于蓼的虫不觉得它苦。比喻人安于习惯，不知辛苦。","source":{"text":"何异食蓼虫，不知苦是苦。","book":"汉·东方朔《七谏》：“蓼虫不知徙乎葵菜。”唐·白居易《自咏五首》其二"}},{"id":39112,"word":"蓼虫忘辛","pinyin":"liǎo chóng wàng xīn","abbr":"lcwx","explanation":"吃惯了蓼（一种有辣味的草）的虫子已经不感到蓼是辣的了。比喻人为了所好就会不辞辛苦。","source":{"text":"蓼虫不知辛，去来勿与咨。”晋·左思《魏都赋》“习蓼虫之辛，玩进退之维谷。","book":"《文选·王粲（七哀）》"},"usage":"作宾语、定语；用于比喻句"},{"id":39113,"word":"蔑伦悖理","pinyin":"miè lún bèi lǐ","abbr":"mlbl","explanation":"指违背道德和伦理。","source":{"text":"备闻襄公淫妹之事，默然自叹：‘似此蔑伦悖理，禽兽不如。","book":"明·冯梦龙《东周列国志》第14回"},"example":{"text":"而～之事，因之层出不穷，此皆学校不讲之故也。","book":"清·郑观应《盛世危言·学校》"},"usage":"作谓语、定语；指违背道德和伦理"},{"id":39114,"word":"蔓引株求","pinyin":"màn yǐn zhū qiú","abbr":"myzq","explanation":"顺着蔓寻根。比喻一网打尽。","source":{"text":"奉命今将逆党搜，须得你蔓引株求。","book":"清·孔尚任《桃花扇·逮社》"},"similar":["寻根究底","蔓引株连"],"usage":"作谓语；比喻一网打尽"},{"id":39115,"word":"蔓引株连","pinyin":"màn yǐn zhū lián","abbr":"myzl","explanation":"蔓：蔓生植物的根茎。顺着蔓寻根。比喻一网打尽。","source":{"text":"御史等体上天好生之德，也不须蔓引株连了。","book":"清·陶贞怀《天雨花》第八回"},"similar":["蔓引株求"],"usage":"作谓语；比喻一网打尽"},{"id":39116,"word":"蔓草荒烟","pinyin":"màn cǎo huāng yān","abbr":"mchy","explanation":"蔓草：蔓生的野草；荒烟：空旷荒凉的原野上的雾气。比喻空旷偏僻，冷落荒凉。","source":{"text":"奈何荒烟野蔓，荆棘纵横。","book":"宋·欧阳修《祭石曼卿文》"},"example":{"text":"宋·欧阳修《祭石曼卿文》：“奈何荒烟野蔓，荆棘纵横。”"}},{"id":39117,"word":"蔓草难除","pinyin":"màn cǎo nán chú","abbr":"mcnc","explanation":"蔓草：蔓延生长的草。蔓生的草难于彻底铲除。比喻恶势力一经滋长，就难于消灭。","source":{"text":"不如早为之所，无使滋蔓，蔓，难图也。蔓草犹不可除，况君之宠弟乎？","book":"《左传·隐公元年》"},"usage":"作宾语、定语；用于比喻句"},{"id":39118,"word":"蔓蔓日茂","pinyin":"màn màn rì mào","abbr":"mmrm","explanation":"蔓蔓：形容长久。天长日久，一天天茂盛起来。","source":{"text":"蔓蔓日茂，芝成灵华。","book":"《汉书·礼乐志》"},"usage":"作谓语；指一天天茂盛起来"},{"id":39119,"word":"蔚为大观","pinyin":"wèi wéi dà guān","abbr":"wwdg","explanation":"蔚：茂盛；大观：盛大的景象。发展成为盛大壮观的景象。形容事物美好繁多，给人一种盛大的印象。","source":{"text":"余藩吴时，复加修治，增设台榭，蔚成大观。","book":"清·梁章钜《楹联丛话》"},"example":{"text":"乡村风景，甚觉宜人，野外花园，殊有清趣，树木～。","book":"鲁迅《两地书·致许广平五一》"},"similar":["洋洋大观"],"usage":"作谓语；用于文物展品等"},{"id":39120,"word":"蔚成风气","pinyin":"wèi chéng fēng qì","abbr":"wcfq","explanation":"指一件事情逐渐发展盛行，形成一种良好风气。","source":{"text":"可惜这种个人捐献在我们国家里还只是麟角凤毛，还没蔚成风气。","book":"萧乾《一本褪色的相册·在康奈尔校园里》"},"example":{"text":"只是毕竟兹事体大，她觉得如果不细想一想，遽作裁决，未免放不下心，所以一切～，纷纷建言。","book":"高阳《慈禧全传》九十七"},"usage":"作谓语、定语；用于事物等"},{"id":39121,"word":"蔚然成风","pinyin":"wèi rán chéng fēng","abbr":"wrcf","explanation":"蔚然：草木茂盛的样子。指一件事情逐渐发展盛行，形成一种良好风气。","source":{"text":"日本国内，自望族以至一般文士，摹仿唐诗蔚然成风。","book":"范文澜《中国通史》第三编第七章第八节"},"example":{"text":"”五讲四美在我们周围～。"},"similar":["蔚成风气"],"usage":"作谓语；指形成一种良好风气"},{"id":39122,"word":"蔫头耷脑","pinyin":"niān tóu dā nǎo","abbr":"ntdn","explanation":"蔫：枯萎；耷：垂。没精打采的样子。","source":{"text":"满银蔫头耷脑走出门坎后，惊讶地看见是他的小舅子，便把罗着的腰直了一下，脸上倒显出了几分羞愧的颜色。","book":"路遥《平凡的世界》第一卷第七章"},"example":{"text":"马林生摇头，～地对老同学说，‘实事求是地说，中等。’","book":"王朔《我是你爸爸》"},"similar":["蔫头蔫脑"],"usage":"作谓语、定语、状语；用于口语"},{"id":39123,"word":"蔬食布衣","pinyin":"shū shí bù yī","abbr":"ssby","explanation":"穿布衣，吃粗粮。形容生活俭朴。","source":{"text":"嵊父临青州，为土民所害。嵊感家祸，终身蔬食布衣，手不执刀刃。","book":"《梁书·张嵊传》"},"similar":["布衣蔬食"],"usage":"作主语、定语、宾语；形容生活清苦"},{"id":39124,"word":"蔼然仁者","pinyin":"ǎi rán rén zhě","abbr":"arrz","explanation":"对人和善的有仁德的人。","source":{"text":"仁义之人，其言蔼如也。","book":"唐·韩愈《答李翊书》"},"example":{"text":"子恺为他家华瞻写的文章，真是‘～’之言。","book":"朱自清《儿女》"},"usage":"作主语、宾语、定语；形容好人"},{"id":39125,"word":"蔼然可亲","pinyin":"ǎi rán kě qīn","abbr":"arkq","explanation":"蔼然：对人和善的样子。形容态度和气，使人愿意接近。","source":{"text":"迄今才八阅月，绝从生之文法，除苛细之科条，虽若凛不可犯，而实蔼然可亲。","book":"明·李开先《贺邑令贺洪滨奖异序》"},"example":{"text":"早有那般世谊同年，见他翩翩风度，～，都愿和他亲近进来了。","book":"清·文康《儿女英雄传》第三十八回"},"similar":["和蔼可亲"],"opposite":["凶神恶煞"],"usage":"作谓语、定语；指人的态度"},{"id":39126,"word":"蔽伤之忧","pinyin":"bì shāng zhī yōu","abbr":"bszy","explanation":"蔽伤：优点被隐蔽，受到中伤。指优点被抹煞及受到陷害的忧虑。","source":{"text":"则抱功修职之吏，无蔽伤之忧。","book":"《汉书·谷永传》"}},{"id":39127,"word":"蔽日干云","pinyin":"bì rì gān yún","abbr":"brgy","explanation":"挡住太阳，直冲云霄。形容十分高大。","source":{"text":"干云蔽日之木，起于葱青。","book":"《后汉书·丁鸿传》"},"example":{"text":"于时金台银阙，～。(唐·张文成《游仙窟》)"},"usage":"作谓语、定语；形容十分高大"},{"id":39128,"word":"蔽日遮天","pinyin":"bì rì zhē tiān","abbr":"brzt","explanation":"遮住了天空和太阳。形容遮盖的范围非常宽广。","source":{"text":"自三峡七百里中，两崖连山，略无阙处，重岩叠嶂，隐天蔽日，自非停午夜分，不见曦月。","book":"北魏·郦道元《水经注·江水》"},"example":{"text":"诡难穷，奸莫测，～，一霎分南北。","book":"清·天花藏主人《玉支矶》"},"similar":["遮天蔽日"],"usage":"作谓语、定语、状语；用于恶势力或气势等"},{"id":39129,"word":"蔽明塞聪","pinyin":"bì míng sè cōng","abbr":"bmsc","explanation":"蔽：遮；聪：听觉灵敏；明：看得清楚。蒙住眼睛不看，堵塞耳朵不听。指对外界事物不闻不问。","source":{"text":"夫然，故蔽明塞聪，而天下之情可坐而尽也。","book":"宋·曾巩《洪范传》"},"similar":["蔽聪塞明"],"usage":"作谓语、宾语、定语；指人的处世态度"},{"id":39130,"word":"蔽美扬恶","pinyin":"bì měi yáng è","abbr":"bmye","explanation":"蔽：遮蔽。指掩盖压抑好的，宣扬传播坏的。","source":{"text":"人君唯贯，听群徒比周，则群臣朋党，蔽美扬恶，然则国之情伪，不见于上。","book":"春秋·齐·管仲《管子·立政九败解》"},"opposite":["抑恶扬善"],"usage":"作谓语、定语；指坏人"},{"id":39131,"word":"蔽聪塞明","pinyin":"bì cōnɡ sè mínɡ","abbr":"bcsm","explanation":"蔽：遮；聪：听觉灵敏；明：香得清楚。掩住耳朵，挡住眼睛。比喻对客观事物不闻不问。","source":{"text":"闭目塞聪，爱精自保。","book":"汉·王充《论衡·自纪》"},"example":{"text":"二、是对于现实要“～”，麻木冷静，不受感触，先由努力，后成自然。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["不闻不问","蔽明塞聪"],"opposite":["耳聪目明"],"usage":"作谓语、定语、宾语；指人的处世态度"},{"id":39132,"word":"蕃篱之鷃","pinyin":"fān lí zhī yàn","abbr":"flzy","explanation":"蕃篱：篱笆；鷃：鹌鹑。篱笆中间的鹌鹑。比喻目光短浅，阅历狭窄的人。","source":{"text":"凤皇上击九千里，绝云霓，负苍天，翱翔乎杳冥之上，夫蕃篱之鷃，岂能与之料天地之高哉？","book":"战国·楚·宋玉《对楚王问》"},"usage":"作宾语、定语；多用于比喻句"},{"id":39133,"word":"蕉鹿之梦","pinyin":"jiāo lù zhī mèng","abbr":"jlzm","explanation":"蕉：同“樵”，柴。比喻把真事看作梦幻。","source":{"text":"郑人有薪于野者，……，覆之以蕉，不胜其喜。","book":"战国·郑·列御寇《列子·周穆王》"},"example":{"text":"～只不过是自我解嘲罢了。"},"usage":"作主语、宾语；指人把真事看作梦幻","story":["从前郑国人在野外砍柴，看到一只受伤的鹿跑过来，就把鹿打死，担心猎人追来，就把死鹿藏在一条小沟里，顺便砍了一些蕉叶覆盖。天黑了，他想找到死鹿扛回家，可惜怎么也找不到。于是他只好放弃，就当作自己做了同样的梦罢了"]},{"id":39134,"word":"蕙心兰质","pinyin":"huì xīn lán zhì","abbr":"hxlz","explanation":"蕙、兰：都是香草名。蕙草样的心地，兰花似的本质。比喻女子心地纯洁，性格高雅。","source":{"text":"金声玉韵，蕙心兰质。","book":"唐·王勃《王子安集·七夕赋》"},"similar":["蕙质兰心"],"usage":"作谓语、宾语；用于女性"},{"id":39135,"word":"蕙心纨质","pinyin":"huì xīn wán zhì","abbr":"hxwz","explanation":"心灵如蕙草芬芳，品质似纨素洁白。比喻品行高洁。","source":{"text":"东都妙姬，南国丽人，蕙心纨质，玉貌绛唇。","book":"南朝·宋·鲍照《芜城赋》"},"example":{"text":"漫将佳丽推评，尽是～。","book":"清·袁于令《西楼记·集艳》"},"similar":["蕙心兰质"],"usage":"作谓语、定语；比喻品行高洁"},{"id":39136,"word":"蕙折兰摧","pinyin":"huì zhé lán cuī","abbr":"hzlc","explanation":"蕙：蕙草；兰：兰花。比喻女子夭亡。","source":{"text":"怨侣方成，鸾俦遽拆，珠沉玉陨，蕙折兰摧。","book":"清·袁枚《续新齐谐》"},"similar":["蕙损兰摧"],"usage":"作谓语；用于女性"},{"id":39137,"word":"蕙损兰摧","pinyin":"huì sǔn lán cuī","abbr":"hslc","explanation":"蕙：蕙草；兰：兰花。比喻女子夭亡。","source":{"text":"把酒对斜晖，问芳卿为甚的便蕙损兰摧。","book":"明·梁辰鱼《破齐阵·咏时序悼亡》"},"similar":["香销玉殒","蕙折兰摧"],"usage":"作谓语；用于女性"},{"id":39138,"word":"蕙质兰心","pinyin":"huì zhì lán xīn","abbr":"hzlx","explanation":"蕙：一种香草；兰：兰花。蕙草样的心地，兰花似的本质。比喻女子心地纯洁，性格高雅。","source":{"text":"有天然蕙质兰心，美韶容，何啻值千金。","book":"宋·柳永《离别难》"},"similar":["蕙心兰质"],"usage":"作谓语、宾语、定语；用于女性"},{"id":39139,"word":"蕞尔弹丸","pinyin":"zuì ěr dàn wán","abbr":"zedw","explanation":"蕞尔：小的样子；弹丸：比喻地方很小。形容极小。","source":{"text":"虽蕞尔弹丸，弱小不能自强，而既托日本之宇下，又入贡中朝。","book":"清·王韬《琉事不足辨》"},"example":{"text":"位在藩镇，～，未参内政。","book":"章炳麟《驳康有为论革命书》"},"usage":"作宾语、定语；指小东西"},{"id":39140,"word":"蕤宾铁响","pinyin":"ruí bīn tiě xiǎng","abbr":"rbtx","explanation":"以之赞扬弹奏技艺的精妙超绝。","source":{"text":"武宗初，朱崖李太慰有乐吏廉郊者……郊尝宿平泉别墅，值风清月朗，携琵琶于池上，弹《蕤宾调》……忽有一物锵然跃出池岸之上，视之，乃一片方响，盖蕤宾铁也。以指拨精妙，律吕相应也。","book":"唐·段安节《乐府杂录·琵琶》"},"example":{"text":"～应黄鹂，纨扇轻摇唱《竹枝》。","book":"清·阎尔梅《刘君因携琴见访醉后赠之》诗"},"usage":"作宾语、定语；用于书面语","story":["唐武宗时期，朱崖、李太尉带领乐工到郊外游玩，住在平泉别墅，晚上风清月朗，携琵琶到池上弹奏《蕤宾调》。突然有一东西掉到池岸上，发出铿锵之声，赶忙去看，原来是一片蕤宾铁，用手指弹奏，其音律与乐器相应"]},{"id":39141,"word":"蕴奇待价","pinyin":"yùn qí dài jià","abbr":"yqdj","explanation":"蕴：积聚，藏蓄。积聚珍奇的宝物，等待适当的价钱。比喻怀藏奇才，等待施展的机会。","source":{"text":"若怀宝迷邦，蕴奇待价，蓄响藏真，不求闻达。","book":"《梁书·武帝纪》"},"opposite":["怀才不遇"],"usage":"作谓语、定语；指人有才待施展"},{"id":39142,"word":"蕴藉风流","pinyin":"yùn jiè fēng liú","abbr":"yjfl","explanation":"蕴藉：含而不露。形容风度潇洒，含蓄有致。","source":{"text":"昕母清河崔氏，学识有风训，生九子，并风流蕴藉，世号王氏九龙。","book":"《北齐书·王昕传》"},"example":{"text":"少年天子，～，只因长毛蔓延，烽烟未靖，不免宵旰勤劳，连那六宫妃嫔，都无心召幸。（蔡东藩《清史演义》第六十三回）"}},{"id":39143,"word":"薄今厚古","pinyin":"bó jīn hòu gǔ","abbr":"bjhg","explanation":"薄：轻视，鄙薄；厚：优待，重视。重视古代，轻视现代。","source":{"text":"浅于知而深于思，薄今而厚古，岂特颇牧而已哉！","book":"宋·杨万里《文帝曷不用颇牧论》"},"similar":["厚古薄今"],"usage":"作主语、谓语、定语；指推崇古代的轻视现代"},{"id":39144,"word":"薄养厚葬","pinyin":"bó yǎng hòu zàng","abbr":"byhz","explanation":"指子女在父母生前不尽心供养，父母死后却大办丧事，借以炫耀自己的经济实力与孝心。","example":{"text":"～的做法要遭人谴责的。"},"usage":"作宾语、定语；用于子女对待父母的态度"},{"id":39145,"word":"薄利多销","pinyin":"bó lì duō xiāo","abbr":"bldx","explanation":"单个产品或商品赢利少，靠售出数量很大赚钱。","example":{"text":"我们采取～的营销方式。"},"opposite":["囤积居奇"],"usage":"作宾语、定语；用于生意方面"},{"id":39146,"word":"薄命佳人","pinyin":"bó mìng jiā rén","abbr":"bmjr","explanation":"薄命：福薄命苦。福薄命苦的美女。","source":{"text":"可怜前代汗青史，薄命佳人类如此。","book":"元·洪希文《书美人图》"},"similar":["红颜薄命"],"usage":"作主语、宾语、定语；用于女性"},{"id":39147,"word":"薄唇轻言","pinyin":"báo chún qīng yán","abbr":"bcqy","explanation":"形容多嘴，说话随便。","source":{"text":"瘦人者，皮薄色少，肉廉廉然，薄唇轻言。","book":"春秋·无名氏《灵枢·逆顺肥瘦篇》"},"similar":["多嘴多舌"],"opposite":["沉默寡言"],"usage":"作谓语、宾语；指人多嘴"},{"id":39148,"word":"薄寒中人","pinyin":"bó hán zhòng rén","abbr":"bhzr","explanation":"薄寒：轻微的寒气。中人：伤人。指轻微的寒气也能伤害人的身体。也比喻人在衰老或患难之中时经不住轻微的打击。","source":{"text":"憯凄增欷兮，薄寒之中人。","book":"《楚辞·九辩》"},"example":{"text":"～老可畏，热酒浇肠气先压。","book":"宋·苏轼《九月黄楼作》"},"usage":"作谓语、宾语；指寒气伤人"},{"id":39149,"word":"薄志弱行","pinyin":"bó zhì ruò xíng","abbr":"bzrx","explanation":"薄：脆弱，不坚定；弱：懦弱。意志不坚定，行为很懦弱。"},{"id":39150,"word":"薄情无义","pinyin":"báo qíng wú yì","abbr":"bqwy","explanation":"薄：淡薄。感情淡薄，没有情义。常指对于生离死别的事无动于衷。","source":{"text":"宝玉听了自思通：‘谁知这样一个人，这样薄情无义呢？’","book":"清·曹雪芹《红楼梦》第19回"},"example":{"text":"请不要做～的人。"},"opposite":["深情厚意"],"usage":"作谓语、定语；指人缺乏感情"},{"id":39151,"word":"薄批细抹","pinyin":"bó pī xì mǒ","abbr":"bpxm","explanation":"薄：略微地；批：批改；细：仔细抹：删除。略微地推敲批改，缌地斟酌删除。形容为调谐韵，选词改字而吟咏诗词。","source":{"text":"薄批明月，细抹清风。","book":"宋·释道原《景德传灯录》"}},{"id":39152,"word":"薄技在身","pinyin":"bó jì zài shēn","abbr":"bjzs","explanation":"薄：微小。指自己掌握了微小的技能。","source":{"text":"积财千万，不如薄技在身。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"我们要有～，才不会被淘汰。"},"similar":["一技之长"],"opposite":["一无所长"],"usage":"作宾语；用于谦词"},{"id":39153,"word":"薄暮冥冥","pinyin":"bó mù míng míng","abbr":"bmmm","explanation":"傍晚时天气昏暗。","source":{"text":"薄暮冥冥，虎啸猿啼。","book":"宋·范仲淹《岳阳楼记》"},"example":{"text":"～，江上渔火点点，很有诗情画意。"},"similar":["薄暮蒙蒙"],"opposite":["晨光熹微"],"usage":"作谓语、补语；形容黑夜将临的时刻"},{"id":39154,"word":"薄海腾欢","pinyin":"bó hǎi téng hān","abbr":"bhth","explanation":"薄：逼迫；海：四海；薄海：指海内外。海内外翻腾着欢乐的浪潮。"},{"id":39155,"word":"薄物细故","pinyin":"bó wù xì gù","abbr":"bwxg","explanation":"薄：微小；物：事物；故：事故。指微小的事情。","source":{"text":"薄物细故，谋臣计失，皆不足以离昆弟之欢。","book":"《汉书·匈奴传上》"},"example":{"text":"凡我各省将帅，平时～，悉当弃置，集其精力，从事破贼。","book":"蔡东藩、许廑父《民国通俗演义》第一百五十九回"},"similar":["鸡毛蒜皮"],"usage":"作主语、宾语；形容极细微的事情"},{"id":39156,"word":"薄祚寒门","pinyin":"bó zuò hán mén","abbr":"bzhm","explanation":"祚：福。贫贱低微的门第。","source":{"text":"纵然生于薄祚寒门，甚至为奇优，为名娼，亦断不至为走卒健仆，甘遭庸夫驱制。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["蓬门荜户"],"usage":"作宾语、定语；指贫民家"},{"id":39157,"word":"薄赋轻徭","pinyin":"bó fù qīng yáo","abbr":"bfqy","explanation":"减轻徭役，降低赋税。比喻统治者让劳动人民担负的义务比较轻。","source":{"text":"海内虚耗，户口减半，光知时务之要，轻徭薄赋，与民休息。","book":"《汉书·昭帝纪》"},"example":{"text":"劝农树艺，～，无事横耒，有事荷戈，诸县户口，逐渐归复，野无旷土，桑麻蔚然。","book":"蔡东藩《唐史演义》第九十五回"}},{"id":39158,"word":"薏苡之嫌","pinyin":"yì yǐ zhī xián","abbr":"yyzx","explanation":"薏苡：多年生草本植物，果实可供食用酿酒，并入药。薏米被进谗的人说成了明珠。比喻被人诬谄，蒙受冤屈。","source":{"text":"家书缺者，诚宜补葺。然此去京师，水际万里，不可露赍，当须箧笥。人观兼乘，谓是货财，古人薏苡之嫌，得为深诫。","book":"《旧唐书·牛廪传》"}},{"id":39159,"word":"薏苡之疑","pinyin":"yì yǐ zhī yí","abbr":"yyzy","explanation":"薏苡：多年生草本植物，果实可供食用酿酒，并入药。薏米被进谗的人说成了明珠。比喻被人诬谄，蒙受冤屈。","source":{"text":"南方薏苡实大，援欲以为种，军还，载之一车。时人以为南土珍怪，权贵皆望之。援时方有宠，故莫以闻。及卒后，有上书谮之者，以为前所载还，皆明珠文犀。","book":"《后汉书·马援传》"}},{"id":39160,"word":"薏苡之谗","pinyin":"yì yǐ zhī chán","abbr":"yyzc","explanation":"比喻被人诬蔑，蒙受冤屈。同“薏苡之谤”。","source":{"text":"忠能格主，不蒙薏苡之谗；功每先人，曾在麒麟之强。","book":"清·李渔《玉搔头·拾愁》"},"similar":["薏苡之谤","薏苡明珠","薏苡蒙谤"],"usage":"作谓语、定语；指蒙受冤屈"},{"id":39161,"word":"薏苡之谤","pinyin":"yì yǐ zhī bàng","abbr":"yyzb","explanation":"比喻被人诬蔑，蒙受冤屈。","source":{"text":"正伦以能文被举，以直道见委，参典机密，出入两宫，斯谓得时。然被承乾金带之讥，孰与夫薏苡之谤，士大夫慎之。","book":"《旧唐书·王珪杜正伦等传论》"},"example":{"text":"是知瓜李之嫌，～，斯不可忘。","book":"五代·王定保《唐摭言·好及第恶登科》"},"similar":["薏苡明珠","薏苡蒙谤","薏苡之谗"],"usage":"作谓语、定语；指蒙受冤屈"},{"id":39162,"word":"薏苡兴谤","pinyin":"yì yǐ xīng bàng","abbr":"yyxb","explanation":"薏苡：多年生草本植物，果实可供食用酿酒，并入药。薏米被进谗的人说成了明珠。比喻被人诬谄，蒙受冤屈。","source":{"text":"今大人逾越五岭，远在海滨，其俗旧多珍怪。此书若成，则载之兼两。昔马援以薏苡兴谤，王阳以衣囊邀名。嫌疑之间，诚先贤所慎也。","book":"《后汉书·吴佑传》"}},{"id":39163,"word":"薏苡明珠","pinyin":"yì yǐ míng zhū","abbr":"yymz","explanation":"薏苡：多年生草本植物，果实可供食用酿酒，并入药。薏米被进谗的人说成了明珠。比喻被人诬蔑，蒙受冤屈。","source":{"text":"南方薏苡实大。援欲以为种，军还，载之一车。……及卒后，有上书谮之者，以为前所载还，皆明珠文犀。","book":"《后汉书·马援传》"},"example":{"text":"梧桐夜雨词凄绝，～谤偶然。","book":"清·陈彝尊《酬洪昇》诗"},"similar":["薏苡之谤"],"usage":"作谓语、定语；指蒙受冤屈","story":["东汉初年大将马援率军远征越南，在交趾采了很多薏苡果子，该果子可以强身健体，抵抗瘴气的侵袭，形状像夜明珠一样。马援采了很多准备回家种。回朝途中马援病故。梁松趁机诬陷他贪污大量珍珠，马援夫人将薏苡献上才保住马援的封号"]},{"id":39164,"word":"薏苡蒙谤","pinyin":"yì yǐ méng bàng","abbr":"yymb","explanation":"比喻被人诬蔑，蒙受冤屈。同“薏苡之谤”。","source":{"text":"昔马援薏苡蒙谤，邓艾槛车被征。","book":"《明史·项忠传》"},"similar":["薏苡之谤","薏苡之谗","薏苡明珠"],"usage":"作谓语、定语；指蒙受冤屈"},{"id":39165,"word":"薛卞之门","pinyin":"xuē biàn zhī mén","abbr":"xbzm","explanation":"薛：古代善于鉴定刀剑的薛烛；卞：指发现宝玉的楚人卞和。比喻善于鉴赏人才的人。","source":{"text":"庶青萍结绿，长价于薛卞之门。","book":"唐·李白《与韩荆州书》"},"usage":"作宾语；指善于鉴赏人才的人"},{"id":39166,"word":"薪传有自","pinyin":"xīn chuán yǒu zì","abbr":"xcyz","explanation":"薪：柴；自：从……出来的地方。比喻师父传业于弟子，一代代地传下去。","source":{"text":"指穷于为薪，火传也，不知其尽也。","book":"《庄子·养生主》"},"example":{"text":"西圃为司农山姜先生长孙，家学渊源，～，而又好学深思，以力充其所至，故其为是说也。","book":"清·张元《西圃诗说序》"}},{"id":39167,"word":"薪储之费","pinyin":"xīn chǔ zhī fèi","abbr":"xczf","explanation":"指柴米等日常生活费用。","source":{"text":"应乡赋秀才举，将行，乃盛其服玩车马之饰，计其京师薪储之费。","book":"唐·白行简《李娃传》"}},{"id":39168,"word":"薪尽火传","pinyin":"xīn jìn huǒ chuán","abbr":"xjhc","explanation":"薪：柴。柴虽烧尽，火种仍留传。比喻师父传业于弟子，一代代地传下去。","source":{"text":"指穷于为薪，火传也，不知其尽也。","book":"《庄子·养生主》"},"example":{"text":"风流云散，贤豪才色总成空；～，工匠市廛都有韵。","book":"清·吴敬梓《儒林外史》第五十四回"},"similar":["薪烬火传"],"usage":"作谓语、定语；比喻师父传业于弟子"},{"id":39169,"word":"薪尽火灭","pinyin":"xīn jìn huǒ miè","abbr":"xjhm","explanation":"薪：柴火。柴草完了，火也就灭了。比喻死亡。","source":{"text":"佛此夜灭度，如薪尽火灭，分布诸舍利，而起无量塔。","book":"《法华经·序品》"},"example":{"text":"弹指不留，水流灯焰，金身永谢，～。","book":"唐·王维《能禅师碑》"},"usage":"作宾语、定语；多用于比喻句"},{"id":39170,"word":"薪桂米珠","pinyin":"xīn guì mǐ zhū","abbr":"xgmz","explanation":"薪：柴草。米贵得像珍珠，柴贵得像桂木。指物价昂贵，人民生活很困难。","source":{"text":"都中薪桂米珠，勿忧资斧。舍后有窖镪，可以发用。","book":"清·蒲松龄《聊斋志异·司文郎》"},"example":{"text":"清·蒲松龄《聊斋志异·司文郎》：“都中～，勿忧资斧。舍后有窖镪，可以发用。”"},"similar":["米珠薪桂"],"usage":"作谓语、定语；指物价昂贵","story":["战国时期，纵横家苏秦擅长辩论，凭一张嘴到处游说。他去楚国要求见楚王，把守宫门的谒者索贿不成，故意陷害他，让他先住三天，卖给他的东西特别贵。楚王见苏秦后，谈得非常投机。苏秦说楚国的米像珍珠、柴火像桂木一样贵"]},{"id":39171,"word":"薪桂米金","pinyin":"xīn guì mǐ jīn","abbr":"xgmj","explanation":"薪：柴草；桂：木名。把柴草看得像桂木，把粮食看得像金子。比喻生活极度贫苦。","source":{"text":"一落泥途迹愈深，尺薪如桂米如金。","book":"宋·苏轼《次韵郑介夫》诗"},"similar":["薪桂米珠"],"usage":"作谓语、定语；指物价昂贵"},{"id":39172,"word":"薪烬火传","pinyin":"xīn jìn huǒ chuán","abbr":"xjhc","explanation":"薪：木材。柴虽烧尽，火种仍留传。比喻师生传授，学问一代代地流传下去。","source":{"text":"虽不能至，而或具体而微焉，或有其一体焉，则薪烬火传，犹旦莫也，国于是乎有与立。","book":"梁启超《管子传·自序》"},"similar":["薪尽火传"],"usage":"作宾语、定语；用于书面语"},{"id":39173,"word":"薪贵于桂","pinyin":"xīn guì yú guì","abbr":"xgyg","explanation":"薪：柴草；桂：桂木。形容物价飞涨。","source":{"text":"楚国之食贵于玉，薪贵于桂，谒者难得无如鬼，王难见如天帝，令臣食玉炊桂，因鬼见帝。","book":"西汉·刘向《战国策·楚策三》"},"similar":["米珠薪桂"],"usage":"作宾语、定语；指物价高昂","story":["战国时期，纵横家苏秦擅长辩论，凭一张嘴到处游说。他去楚国要求见楚王，把守宫门的谒者索贿不成，故意陷害他，让他先住三天，卖给他的东西特别贵。楚王见苏秦后，谈得非常投机。苏秦说楚国的米像珍珠、柴火像桂木一样贵"]},{"id":39174,"word":"薮中荆曲","pinyin":"sǒu zhōng jí qǔ","abbr":"szjq","explanation":"比喻品质不好的人，处在恶劣的环境中会变得更坏。","example":{"text":"～的道理简单明了"},"usage":"作宾语、定语；用于书面语"},{"id":39175,"word":"薰以香自焚","pinyin":"xūn yǐ xiāng zì fén","abbr":"xyxzf","explanation":"薰：香草。香草因为有香味才遭焚烧。比喻人因有才能而招来祸患。","source":{"text":"嗟，薰以香自焚，膏以明自销，龚生竟夭天年，非吾徒也。","book":"《汉书·龚胜传》"}},{"id":39176,"word":"薰天赫地","pinyin":"xūn tiān hè dì","abbr":"xthd","explanation":"薰天：气势极盛的样子；赫：显明，盛大。形容气焰炽盛。","source":{"text":"兹邦称贵近，与世尝薰赫。","book":"唐·张九龄《南阳道中》诗"},"example":{"text":"然那等～富贵人，除非是遇了朝廷诛戮，或是生下子孙不肖，方是败落散场。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"}},{"id":39177,"word":"薰莸不同器","pinyin":"xūn yóu bù tóng qì","abbr":"xybtq","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草不可以放在一个器物里。比喻好和坏不能共处。","source":{"text":"回闻薰莸不同器而藏，尧桀不共国而治，以其异类也。","book":"三国·魏·王肃《孔子家语·致思》"},"example":{"text":"～，清淆本殊源。","book":"明·何景明《咏怀》"},"similar":["薰莸异器"],"opposite":["薰莸同器","鱼龙混杂"],"usage":"作宾语、定语；比喻好和坏不能共处","story":["晋朝时期，丞相王导到江南之初，想结交吴地人士，就向太尉阮玩提出结成儿女亲家。阮玩回复说：“小土丘不能长松柏那样大树，香草与臭草不能放在同一器物内。我虽然没有才能，但不能带头来破坏人伦。”"]},{"id":39178,"word":"薰莸不杂","pinyin":"xūn yóu bù zá","abbr":"xybz","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草不可以放在一起。比喻好和坏不能共处。","source":{"text":"且非我族类，往哲格言；薰莸不杂，闻之前典。","book":"南朝·梁·沈约《奏弹王源》"}},{"id":39179,"word":"薰莸同器","pinyin":"xūn yóu tóng qì","abbr":"xytq","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草放在一起。比喻善恶同处，恶者掩善。","source":{"text":"回闻薰莸不同器而藏，尧桀不共国而治，以其类异也。","book":"《孔子家语·观思》"},"example":{"text":"现自国民党议员奉令取消以来，去者得避害马败群之谤，留者仍蒙～之嫌。","book":"蔡东藩、许廑父《民国通俗演义》第三十八回"},"similar":["黑白不分","是非不分"],"opposite":["是非分明","泾渭分明"],"usage":"作谓语、分句；指鱼龙混杂"},{"id":39180,"word":"薰莸异器","pinyin":"xūn yóu yì qì","abbr":"xyyq","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草不可以放在一个器物里。比喻好和坏不能共处。","source":{"text":"回闻薰莸不同器而藏，尧桀不共国而治，以其类异也。","book":"《孔子家语·观思》"},"example":{"text":"那时～，臭味差池，渐渐的君子道消，小人道长。","book":"蔡东藩《明史演义》第八十七回"},"similar":["薰莸不同器"],"opposite":["薰莸同器"],"usage":"作宾语、定语；用于比喻句"},{"id":39181,"word":"薰莸无辨","pinyin":"xūn yóu wú biàn","abbr":"xywb","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草不加区分。比喻善恶同处，恶者掩善。","source":{"text":"薰莸无辨，泾渭不分，二乱于兹，莫之能整。","book":"唐·陆贽《又论进瓜果人拟官状》"},"similar":["泾渭不分"],"opposite":["泾渭分明"],"usage":"作宾语、定语；用于比喻句"},{"id":39182,"word":"薰莸有别","pinyin":"xūn yóu yǒu bié","abbr":"xyyb","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草要区别对待。比喻好和坏不能共处。","source":{"text":"回闻薰莸不同器而藏，尧桀不共国而治，以其类异也。","book":"《孔子家语·观思》"},"example":{"text":"与其泾渭不分，转致无所忌惮；曷若～，俾皆就我范围。","book":"清·林则徐《复奏曾望颜务陈封关禁海事宜折》"}},{"id":39183,"word":"薰莸错杂","pinyin":"xūn yóu cuò zá","abbr":"xycz","explanation":"薰：香草，比喻善类；莸：臭草，比喻恶物。香草和臭草放在一起。比喻善恶同处，恶者掩善。","source":{"text":"洎乎近代，厥道浸微；玉石不分，薰莸错杂。","book":"五代·王定保《唐摭言·进归礼部》"},"similar":["玉石不分","薰莸同器"],"usage":"作宾语、定语；用于比喻句"},{"id":39184,"word":"薰风解愠","pinyin":"xūn fēng jiě yùn","abbr":"xfjy","explanation":"薰风：和煦的风；愠：怨恨。温和的风可消除心头的烦恼","source":{"text":"昔日舜弹五弦之琴，造《南风》之诗，其诗曰：‘南风之薰兮，可以解吾民之愠兮。’","book":"《孔子家语·辩乐》"},"example":{"text":"宋·柳永《永遇乐》词：“～，昼景清和，新霁时候。”"},"usage":"作宾语、定语；用于书面语"},{"id":39185,"word":"薰香自烧","pinyin":"xūn xiāng zì shāo","abbr":"xxzs","explanation":"薰：香草。薰草因为有香气而招致焚烧。比喻人因有才能而招致灾祸","source":{"text":"薰以香自烧，膏以明自销，龚生竟夭天年，非吾徒也。","book":"东汉·班固《汉书·龚胜传》"},"usage":"作宾语、定语；用于比喻句"},{"id":39186,"word":"藉草枕块","pinyin":"jiè cǎo zhěn kuài","abbr":"jczk","explanation":"藉：垫衬。古时居父母之丧，坐卧在草垫上，枕着土块。形容悲痛欲绝。","source":{"text":"贾珍贾蓉此时为礼法所拘，不免在灵旁藉草枕块，恨苦居丧。","book":"清·曹雪芹《红楼梦》第六十四回"},"usage":"作谓语、宾语；形容十分悲痛"},{"id":39187,"word":"藏之名山","pinyin":"cáng zhī míng shān","abbr":"czms","explanation":"把著作藏在名山传给志趣相投的人。形容著作极有价值。","source":{"text":"虽未能藏之名山，将以传之同好。","book":"三国·魏·鱼豢《魏略》"},"example":{"text":"三国·魏·鱼豢《魏略》：“虽未能藏之名山，将以传之同好。”"},"similar":["藏诸名山"],"usage":"作谓语、定语；指能传后世之作"},{"id":39188,"word":"藏之名山，传之其人","pinyin":"cáng zhī míng shān，chuán zhī qí rén","abbr":"czmsczqr","explanation":"把著作藏在名山，传给志趣相投的人。","source":{"text":"仆诚以著此书，藏诸名山，传之其人，通邑大都，则仆偿前辱之现，虽万被戮，岂有悔哉。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"一个人做一部书，“～”，是封建时代的事，早已过去了。","book":"鲁迅《准风月谈·序的解放》"}},{"id":39189,"word":"藏修游息","pinyin":"cáng xiū tóu xī","abbr":"cxyx","explanation":"心里常常想着学习，不能废弃，甚至休息或闲暇的时候也要学习。","source":{"text":"君子之于学也，藏焉，修焉，息焉，游焉。","book":"《礼记·学记》"}},{"id":39190,"word":"藏器待时","pinyin":"cáng qì dài shí","abbr":"cqds","explanation":"器：用具，引伸为才能。比喻学好本领，等待施展的机会。","source":{"text":"君子藏器于身，待时而动。","book":"《周易·系辞下》"},"example":{"text":"李如真四月二十六日书到黄安，知兄已到家，～，最喜最喜。","book":"明·李贽《续焚书·与焦弱侯》"},"similar":["怀才不遇"],"usage":"作谓语、定语；比喻怀才等待时机"},{"id":39191,"word":"藏垢纳污","pinyin":"cáng gòu nà wū","abbr":"cgnw","explanation":"垢、污：肮脏的东西。包藏容纳肮脏之物。比喻隐藏或包容坏人坏事。","source":{"text":"谚曰：‘高下在心，川泽纳污，山薮藏疾，瑾瑜匿瑕。’国君含垢，天之道也。","book":"《左传·宣公十五年》"},"example":{"text":"大概是明末的王思任说的罢：“会稽乃报仇雪耻之乡，非～之地。”","book":"鲁迅《且介亭杂文附集·女吊》"},"similar":["含污纳垢"],"opposite":["涤瑕荡垢","藏龙卧虎"],"usage":"作定语；形容坏人聚积的场所","story":["春秋时期，楚庄王因为使臣申舟在宋国被杀，就发兵攻打宋国。宋国派乐婴齐到晋国求救，晋景公听从大臣伯宗的藏垢纳污的建议，坐视不救，纵容楚国攻打宋国。宋国只好靠自己的力量与楚国协商求和"]},{"id":39192,"word":"藏头亢脑","pinyin":"cáng tóu kàng nǎo","abbr":"ctkn","explanation":"遮遮掩掩，不明不白。","source":{"text":"乡里诸贤文字，以为皆不免有藏头亢脑底意思，有学者来问，便当直说与之。","book":"《朱子语类辑略》卷七"},"similar":["遮遮掩掩"],"usage":"作宾语、定语；用于说话或做事等"},{"id":39193,"word":"藏头护尾","pinyin":"cáng tóu hù wěi","abbr":"cthw","explanation":"原指书法的用笔笔力强劲。现指说话、做事躲躲闪闪，怕把真相全暴露出来。","source":{"text":"藏头护尾，力在字中，下笔用力，肌肤之丽，势来不可止，势去不可遏。","book":"汉·蔡邕《九势》"},"similar":["藏头露尾"],"opposite":["光明正大"],"usage":"作谓语、状语；形容做事和说话躲躲闪闪"},{"id":39194,"word":"藏头漏影","pinyin":"cáng tóu lòu yǐng","abbr":"ctly","explanation":"藏：隐藏。把头藏起来，却露出影子。形容遮遮掩掩，不明不白。","source":{"text":"当初也无定无媒证，做的来藏头漏影。","book":"元·佚名《鸳鸯被》"},"similar":["藏头露尾"],"usage":"作谓语、状语；用于做事和说话等"},{"id":39195,"word":"藏头露尾","pinyin":"cáng tóu lù wěi","abbr":"ctlw","explanation":"藏起了头，露出了尾。形容说话躲躲闪闪，不把真实情况全部讲出来。","source":{"text":"早休官弃职，远红尘是非，省藏头露尾。","book":"元·张可久《点绛唇·翻归去来辞》套曲"},"example":{"text":"况一挂上人家的假招牌，便有许多面子来拘束你，使你不得不～；寻欢作乐，如何能称心适意！","book":"清·曾朴《孽海花》第三十回"},"similar":["转弯抹角","旁敲侧击","藏形匿影"],"opposite":["直截了当","开门见山","直言不讳"],"usage":"作谓语、状语；形容做事和说话躲躲闪闪"},{"id":39196,"word":"藏奸卖俏","pinyin":"cáng jiān mài qiào","abbr":"cjmq","explanation":"藏奸：心怀奸诈。心怀奸诈，故意装出媚态以诱人上当。","source":{"text":"逞狐形狗态，忿激诚可羞……恨藏奸卖俏，真个是人中兽。","book":"明·沈鲸《双珠记·剑击淫邪》"}},{"id":39197,"word":"藏巧于拙","pinyin":"cáng qiǎo yú zhuō","abbr":"cqyz","explanation":"有才能而不显示出来。","source":{"text":"藏巧于拙，用晦而明，寓清于浊，以屈为伸，真涉世之一壶藏身之三窟也。","book":"明·洪应明《菜根谭》上"},"example":{"text":"为人不能锋芒毕露，要～。"},"similar":["大智若愚"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；用于处世"},{"id":39198,"word":"藏巧守拙","pinyin":"cáng qiǎo shǒu zhuō","abbr":"cqsz","explanation":"拙：笨。有才能而不显露出来。"},{"id":39199,"word":"藏弓烹狗","pinyin":"cáng gōng pēng gǒu","abbr":"cgpg","explanation":"飞鸟射尽了就把良弓收起，狡兔被捉就把捕兔的猎狗煮了吃肉。旧时比喻统治者得势后，废弃、杀害有功之臣。","source":{"text":"飞鸟尽，良弓藏，狡兔死，走狗烹。","book":"《史记·越王勾践世家》"},"similar":["鸟尽弓藏","过河拆桥"],"usage":"作宾语、定语；用于为人处世"},{"id":39200,"word":"藏形匿影","pinyin":"cáng xíng nì yǐng","abbr":"cxny","explanation":"藏、匿：隐藏。隐藏形迹，不露真相。","source":{"text":"为君者，藏形匿影，群下无私，掩目塞耳，万民恐震。","book":"《邓析子·无厚篇》"},"example":{"text":"伏念某奥从罢郡还里，自知罪名稍重，姑以～为幸，都无复玷起废之想。","book":"宋·刘克庄《与游丞相书》"},"similar":["躲躲闪闪"],"usage":"作谓语、宾语；指隐藏形迹"},{"id":39201,"word":"藏怒宿怨","pinyin":"cáng nù sù yuàn","abbr":"cnsy","explanation":"藏、宿：存留。把愤怒和怨恨藏留在心里。指心怀怨恨，久久难消。","source":{"text":"仁人之于弟也，不藏怒焉，不宿怨焉。","book":"《孟子·万章上》"},"example":{"text":"为人要心胸开阔，～对自己没有什么好处。"},"opposite":["怒气冲天"],"usage":"作主语、谓语；指心怀愤怒和怨恨"},{"id":39202,"word":"藏污纳垢","pinyin":"cáng wū nà gòu","abbr":"cwng","explanation":"污、垢：肮脏的东西。比喻隐藏或包容坏人坏事。","source":{"text":"川泽纳污，山薮藏疾。","book":"《左传·宣公十五年》"},"example":{"text":"这个地方曾经是一个～的黑窝。"},"similar":["藏垢纳污"],"opposite":["藏龙卧虎"],"usage":"作定语；用于坏人聚积的场所","story":["公元前594年，楚庄王率军攻打宋国。宋国派乐婴齐去晋国求救。晋景公看不惯楚国的恃强欺弱，准备出兵救宋。大夫伯宗认为晋国是鞭长莫及，他说：“谚曰‘高下在心’。川泽纳污，山薮藏疾，瑾瑜匿瑕，国君含垢，天之道也。”"]},{"id":39203,"word":"藏诸名山","pinyin":"cáng zhū míng shān","abbr":"czms","explanation":"把著作藏在名山，传给志趣相投的人。","source":{"text":"汉·司马迁《报任少卿书》：\"仆诚以着此书，藏诸名山，传之其人，通邑大都，则仆偿前辱之责，虽万被戮，岂有悔哉。”"},"example":{"text":"一个人做一部书，～，是封建时代的事，早已过去了。","book":"鲁迅《准风月谈·序的解放》"},"similar":["藏之名山","藏诸名山，传之其人"],"usage":"作谓语、宾语；指作品等"},{"id":39204,"word":"藏诸名山，传之其人","pinyin":"cáng zhū míng shān，chuán zhī qí rén","abbr":"czmsczqr","explanation":"诸：之于的合音；传：传布流传；其人：同道。把著作藏在名山，传给后来志趣相投的人。","source":{"text":"仆诚以著此书，藏诸名山，传之其人，通邑大都，则仆偿前辱之责，虽万被戮，岂有悔哉！","book":"汉·司马迁《报任少卿书》"},"example":{"text":"一个人做一部书，‘～’，是封建时代的事，早已过去了。","book":"鲁迅《准风月谈》"},"similar":["藏之名山"],"usage":"作谓语、宾语、分句；指作品等"},{"id":39205,"word":"藏贼引盗","pinyin":"cáng zéi yǐn dào","abbr":"czyd","explanation":"藏：隐藏；引：勾引。包庇小偷，勾引强盗。形容与坏人狼狈为奸。","source":{"text":"其中夜静人稀，趁便藏贼引盗，什么事情做不出来。","book":"清·曹雪芹《红楼梦》第73回"},"usage":"作谓语、定语；指包庇"},{"id":39206,"word":"藏踪蹑迹","pinyin":"cáng zōng niè jī","abbr":"cznj","explanation":"蹑：轻步行走的样子。隐秘行踪，悄悄行动。","source":{"text":"且说张横将引三二百人，从芦苇中间，藏踪蹑迹，直到寨边，拨开鹿角，径奔中军。","book":"明·施耐庵《水浒传》第64回"},"example":{"text":"我们可以光明正大地干，不需要～。"},"similar":["藏踪秘迹"],"usage":"作谓语、宾语；用于书面语"},{"id":39207,"word":"藏锋敛锐","pinyin":"cáng fēng liǎn ruì","abbr":"cflr","explanation":"比喻不露锋芒。同“藏锋敛锷”。","source":{"text":"俺山大王前次出兵……被他伏下火攻，烧坏我许多猛兽，只得逃入深山，藏锋敛锐，休息了半年，才觉得精还力复。","book":"清·李渔《比目鱼·窃发》"},"similar":["藏锋敛锷","藏锋敛颖"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；指含蓄"},{"id":39208,"word":"藏锋敛锷","pinyin":"cáng fēng liǎn è","abbr":"cfle","explanation":"锷：剑刃。比喻人不露锋芒。","source":{"text":"予独谓高牙大纛，堂堂正正，攻坚而折锐，则刘有一日之长。若藏锋敛锷，出奇制胜，……则於虞有取焉。","book":"明·李东阳《麓堂诗话》"},"example":{"text":"大智若愚，大勇若怯，不是要埋冤他，正深爱着他，要他～，以成大器。","book":"清·夏敬渠《野叟曝言》一三回"},"similar":["藏锋敛颖","藏锋敛颖"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；指含蓄"},{"id":39209,"word":"藏锋敛颖","pinyin":"cáng fēng liǎn yǐng","abbr":"cfly","explanation":"比喻不露锋芒。同“藏锋敛锷”。","source":{"text":"及乎藏锋敛颖，韬潜谨饬……洁身寡过，而求自免也。","book":"元·戴表元《送吴州判还番阳诗序》"},"similar":["藏锋敛锐","藏锋敛锷"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；指含蓄"},{"id":39210,"word":"藏龙卧虎","pinyin":"cáng lóng wò hǔ","abbr":"clwh","explanation":"指隐藏着未被发现的人才，也指隐藏不露的人才。","source":{"text":"暗石疑藏虎，盘根似卧龙。","book":"北周·庾信《同会河阳公新造山地聊得寓目》诗"},"example":{"text":"在中州地面，四通八达，乃是～之地，英雄荟萃之区，非同小地方可比。","book":"姚雪垠《李自成》第二卷第十六章"},"similar":["潜龙伏虎"],"opposite":["野无遗才","藏污纳垢"],"usage":"作谓语、定语；指有不平常的人"},{"id":39211,"word":"藐兹一身","pinyin":"miǎo zī yī shēn","abbr":"mzys","explanation":"藐：微小。指一个人的身躯和力量是微不足道的。","source":{"text":"遗诏曰：朕获保宗庙，以眇眇之身托于天下君王之上，二十有余年矣。","book":"《汉书·文帝纪》"},"example":{"text":"～，其堕落于穷谷中不克自拔矣。","book":"孙中山《伦敦蒙难记》四"}},{"id":39212,"word":"藕丝难杀","pinyin":"ǒu sī nán shā","abbr":"osns","explanation":"比喻感情缠绵，难以割断。","source":{"text":"而艳思绮语，触者纷来，正恐莲性虽胎，藕丝难杀。","book":"清·张潮《虞初新志·小青传》"}},{"id":39213,"word":"藕断丝不断","pinyin":"ǒu duàn sī bù duàn","abbr":"odsbd","explanation":"比喻表面上关系已断，实际上仍有牵连。","example":{"text":"虽然他们已经离了婚，但实际上他们是～。"},"similar":["藕断丝连"],"usage":"作谓语、定语；同“藕断丝连”"},{"id":39214,"word":"藕断丝联","pinyin":"ǒu duàn sī lián","abbr":"odsl","explanation":"藕已折断，但还有许多丝连接着未断开。比喻没有彻底断绝关系。多指男女之间情思难断。同“藕断丝连”。","source":{"text":"人道郴阳无雁，奈情钟藕断丝联。","book":"宋·黄机《满庭芳·次仁和韵时欲之官永兴》词"},"similar":["藕断丝连"],"usage":"作谓语、定语、状语；指男女间的感情"},{"id":39215,"word":"藕断丝连","pinyin":"ǒu duàn sī lián","abbr":"odsl","explanation":"藕已折断，但还有许多丝连接着未断开。比喻没有彻底断绝关系。多指男女之间情思难断。","source":{"text":"妾心藕中丝，虽断犹相连。","book":"唐·孟郊《去妇》诗"},"example":{"text":"算了吧，你也不必看得过于眼紧，反正他们是～的。","book":"欧阳山《三家巷》二二"},"similar":["难舍难分"],"opposite":["一刀两断"],"usage":"作谓语、定语、状语；指男女间的感情"},{"id":39216,"word":"藕断丝长","pinyin":"ǒu duàn sī cháng","abbr":"odsz","explanation":"藕已折断，但还有许多丝连接着未断开。比喻没有彻底断绝关系。多指男女之间情思难断。同“藕断丝连”。","source":{"text":"蒙愁绪以回肠，蔓牵瓜落；拭泪珠而洗面，藕断丝长。","book":"清·魏秀仁《花月痕》第五回"},"similar":["藕断丝连","藕断丝联"],"opposite":["一刀两断"],"usage":"作谓语、定语、状语；指男女间的感情"},{"id":39217,"word":"虎不食儿","pinyin":"hǔ bù shí ér","abbr":"hbse","explanation":"老虎凶猛残忍，但并不吃自己的孩子。比喻人皆有爱子之心，都有骨肉之情。","source":{"text":"饿虎不食儿，人无骨肉恩。","book":"清·崔灏《通俗编·兽畜·虎不食儿》"},"example":{"text":"大家都知道～，你却忍心伤害自己的亲生儿子。"},"similar":["虎毒不食儿"],"usage":"作宾语、定语；比喻人皆有爱子之心"},{"id":39218,"word":"虎体元斑","pinyin":"hǔ tǐ yuán bān","abbr":"htyb","explanation":"虎体：像老虎勇猛的身体；斑：杂色花纹或斑点。比喻朝廷大官。","source":{"text":"花根本艳公卿子，虎体元斑将相孙。","book":"元·王实甫《西厢记》第二折楔子"},"similar":["虎体鹓斑","虎体原斑"],"usage":"作宾语、定语；用于比喻句"},{"id":39219,"word":"虎体原斑","pinyin":"hǔ tǐ yuán bān","abbr":"htyb","explanation":"虎体：像老虎勇猛的身体；斑：杂色花纹或斑点。比喻朝廷大官。","source":{"text":"花根本艳，虎体原斑。","book":"元·无名氏《雁门关》第二折"},"similar":["虎体鹓斑","虎体元斑"],"usage":"作宾语、定语；用于比喻句"},{"id":39220,"word":"虎体熊腰","pinyin":"hǔ tǐ xióng yāo","abbr":"htxy","explanation":"形容身材魁梧，体格健壮。","source":{"text":"为首一将，生得广额阔面，虎体熊腰；吴郡富春人也，姓孙，名坚，字文台，乃孙武子之后。","book":"明·罗贯中《三国演义》第二回"},"similar":["虎背熊腰"],"usage":"作谓语、状语、定语；用于男性"},{"id":39221,"word":"虎体鹓斑","pinyin":"hǔ tǐ yuān bān","abbr":"htyb","explanation":"虎体：像老虎勇猛的身体；鹓：古时像凤凰一样的鸟；斑：杂色花纹或斑点。比喻朝廷大官。","source":{"text":"花根本艳公卿子，虎体鹓斑将相孙。","book":"元·王实甫《丽春堂》第一折"},"similar":["虎体元斑","虎体原斑"],"usage":"作宾语、定语；用于比喻句"},{"id":39222,"word":"虎体鹓班","pinyin":"hǔ tǐ yuān bān","abbr":"htyb","explanation":"虎体：老虎勇猛强健，比喻有才能的将相；鹓班：鹓鸟飞行有序，比喻朝官行列。比喻朝廷文武大臣。","source":{"text":"你枉做个虎体鹓班卿相种，你本是花根本艳铁衣郎。","book":"元·无名氏《怒斩关平》第二折"}},{"id":39223,"word":"虎兕出柙","pinyin":"hǔ sì chū xiá","abbr":"hscx","explanation":"兕：犀牛一类的野兽；柙：关兽的木笼。虎、兕从木笼中逃出。比喻恶人逃脱或作事不尽责，主管者应付责任。","source":{"text":"孔子曰：‘……虎兕出于柙，龟玉毁于椟中，是谁之过与？’","book":"《论语·季氏》"},"usage":"作宾语、定语；用于处事"},{"id":39224,"word":"虎党狐侪","pinyin":"hǔ dǎng hú chái","abbr":"hdhc","explanation":"比喻凶恶狡黠之辈。","source":{"text":"谁曾见这锦囊诗袋，却遮藏的虎党狐侪，只您这眉前眼后谁瞒过。道不的露尾藏头，怎撒乖，没处安排。","book":"明·康海《中山狼》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":39225,"word":"虎入羊群","pinyin":"hǔ rù yáng qún","abbr":"hryq","explanation":"老虎跑进羊群。比喻强大者冲入柔弱者中间任意砍杀。","source":{"text":"孔融望见太史慈与关、张赶杀贼众，如虎入羊群，纵横莫当，便驱兵出城。","book":"明·罗贯中《三国演义》第11回"},"example":{"text":"敌人就像～残酷迫害老百姓。"},"similar":["狐入鸡舍","虎荡羊群"],"usage":"作宾语；比喻强者在肆意欺凌弱者"},{"id":39226,"word":"虎冠之吏","pinyin":"hǔ guān zhī lì","abbr":"hgzl","explanation":"指凶狠残暴的官吏，虽穿衣戴帽却凶残如虎。","source":{"text":"致温舒有虎冠之吏，延年有屠伯之名，岂虚也哉。","book":"《后汉书·酷吏传序》"}},{"id":39227,"word":"虎卧龙跳","pinyin":"hǔ wò lóng tiào","abbr":"hwlt","explanation":"形容字势雄浑超逸。","source":{"text":"王右军书，字势雄强，如龙跳天门，虎卧凤阁，故历代宝之，永以为训。","book":"南朝·梁·袁昂《评书》"},"example":{"text":"写得来～，钦派阅卷大臣把他优定在前十本以内。","book":"清·文康《儿女英雄传》第36回"},"usage":"作谓语、定语；形容字势雄强超逸"},{"id":39228,"word":"虎变不测","pinyin":"hǔ biàn bù cè","abbr":"hbbc","explanation":"无法预测老虎身上的花纹发生什么变化或何时变化。形容非常之人的行踪或性情变化莫测，不可捉摸。","source":{"text":"大观虎变愚不测，当年颇似寻常人。","book":"唐·李白《梁甫吟》"}},{"id":39229,"word":"虎变龙蒸","pinyin":"hǔ biàn lóng zhēng","abbr":"hblz","explanation":"指乘时变化而飞黄腾达。","source":{"text":"君侯膺归衮之期，贱子附迁莺着役。风期未远，存问非遥。虎变龙蒸，风云自爱。","book":"明·汤显祖《紫钗记·节镇还朝》"},"usage":"作宾语、定语；用于比喻句"},{"id":39230,"word":"虎口之厄","pinyin":"hǔ kǒu zhī è","abbr":"hkze","explanation":"厄：迫害，苦难。比喻极其危险的境地。","source":{"text":"久之，西安之救致，竟免虎口之厄。","book":"晋·潘岳《马汧督诔》"}},{"id":39231,"word":"虎口余生","pinyin":"hǔ kǒu yú shēng","abbr":"hkys","explanation":"老虎嘴里幸存下来的生命。比喻逃脱极危险的境地侥幸活下来。","source":{"text":"孔子曰：‘然，丘所谓无病而自灸也，疾走料虎头，编虎须，几不免虎口哉。","book":"《庄子·盗跖》"},"example":{"text":"况我本是～，诸事久已看破。","book":"清·李汝珍《镜花缘》第四十七回"},"similar":["绝处逢生","死里逃生"],"usage":"作谓语、定语、宾语；比喻逃脱危险的境地","story":["宋朝湖州农民朱泰家贫，靠打柴为生养活家中老母。一次打柴途中碰到一只老虎，他被老虎扑在地上，他大喊：“我死了，老母怎么办？”老虎被吓跑。乡亲们赶来看他，庆贺他从老虎嘴里逃出，把他的名字改为朱虎残"]},{"id":39232,"word":"虎口夺食","pinyin":"hǔ kǒu duó shí","abbr":"hkds","explanation":"从老虎嘴里抢夺食物。比喻十分危险的事情或十分勇敢的行为","source":{"text":"只要国内出产，全国人民不吃，虎口夺食也要给你弄来。","book":"王朔《千万别把我当人》"},"similar":["龙口夺食"],"usage":"作宾语、定语；多用于比喻句"},{"id":39233,"word":"虎口扳须","pinyin":"hǔ kǒu bá xū","abbr":"hkbx","explanation":"扳：拉。从老虎嘴边拔胡须。比喻冒极大的风险。","source":{"text":"郦老师纵是丽君，我也不敢往虎口扳须，龙头锯角。","book":"清·陈瑞生《再生缘》第55回"},"similar":["虎口拔须","虎口拔牙"],"usage":"作宾语、定语；指危险的行动"},{"id":39234,"word":"虎口拔牙","pinyin":"hǔ kǒu bá yá","abbr":"hkby","explanation":"从老虎嘴里拔牙。比喻做十分危险的事情。","source":{"text":"猛虎口中敲玉齿，骊龙颔下夺神珠。","book":"金·马钰《玩丹砂·赠阎先生》"},"example":{"text":"苍龙头上拶折角，猛虎口中拔得牙。","book":"元·弘济《一山国师语录》卷一"},"similar":["火中取栗","虎口夺食","如临深渊"],"usage":"作宾语、定语；指危险的行动"},{"id":39235,"word":"虎口拔须","pinyin":"hǔ kǒu bá xū","abbr":"hkbx","explanation":"从老虎嘴边拔胡须。比喻冒极大的风险。","example":{"text":"我不想冒～的风险。"},"similar":["虎口扳须","虎口拔牙"],"usage":"作宾语、定语；指危险的行动"},{"id":39236,"word":"虎口残生","pinyin":"hǔ kǒu cán shēng","abbr":"hkcs","explanation":"老虎嘴里幸存下来的生命。比喻经历极大的危险，侥幸得生。","source":{"text":"烦你们拜上小姐，说我铁中玉虎口残生，多蒙垂救，高谊已足千古。","book":"清·名教中人《好逑传》第六回"},"similar":["虎口余生","虎口逃生"],"usage":"作谓语、定语、宾语；比喻逃脱危险的境地"},{"id":39237,"word":"虎口逃生","pinyin":"hǔ kǒu táo shēng","abbr":"hkts","explanation":"老虎嘴里幸存下来的生命。比喻逃脱极危险的境地侥幸活下来。","source":{"text":"孔子曰：‘然，丘所谓无病而自灸也，疾走料虎头，编虎须，几不免虎口哉。","book":"《庄子·盗跖》"},"example":{"text":"我如今在～，急腾腾再不消停。","book":"元·无名氏《硃砂担》第一折"},"similar":["虎口余生"],"usage":"作谓语、定语、宾语；比喻从险境中逃出来","story":["宋朝湖州农民朱泰家贫，靠打柴为生养活家中老母。一次打柴途中碰到一只老虎，他被老虎扑在地上，他大喊：“我死了，老母怎么办？”老虎被吓跑。乡亲们赶来看他，庆贺他从老虎嘴里逃出，把他的名字改为朱虎残"]},{"id":39238,"word":"虎咽狼吞","pinyin":"hǔ yàn láng tūn","abbr":"hylt","explanation":"形容吃东西又猛又急的样子。","source":{"text":"十人自来吃酒……须臾之间，狼飧虎咽，算来吃够有六七十斤肉。","book":"明·凌濛初《初刻拍案惊奇·刘东山夸技顺城门》"},"similar":["虎咽狼餐","狼吞虎咽"],"usage":"作谓语、状语、定语；形容吃东西的样子"},{"id":39239,"word":"虎咽狼餐","pinyin":"hǔ yàn láng cān","abbr":"hylc","explanation":"咽：吞。形容吃东西又猛又急的样子。","source":{"text":"虎咽狼餐胜似趁熟，酄得十分透。","book":"元·无名氏《耍孩儿·拘刷行院》"},"example":{"text":"入座之后，黄子文也不管他们。只顾自己～。","book":"《负曝闲谈》第19回"},"similar":["虎咽狼吞","狼吞虎咽"],"usage":"作谓语、状语、定语；形容吃东西的样子"},{"id":39240,"word":"虎啸狼号","pinyin":"hǔ xiào láng háo","abbr":"hxlh","explanation":"啸：兽类的长吼声；号：大叫。比喻强暴者在掠夺时的叫嚣。","source":{"text":"你看那境内啊！弄潢池鼠偷狗盗；你看那境外啊！猎中原虎啸狼号。","book":"清·南荃外史《叹老》"},"usage":"作谓语、定语；用于比喻句"},{"id":39241,"word":"虎啸风生","pinyin":"hǔ xiào fēng shēng","abbr":"hxfs","explanation":"啸：长鸣。猛虎长鸣，则大风四起。比喻英雄人物顺应时代潮流而出现，并且对社会产生极大的影响；亦指豪杰奋起，大展宏图。","source":{"text":"虎啸生风，龙腾云起，英贤奋发，亦各因时。","book":"《北史·张定和传论》"},"example":{"text":"起陆之贵，际会如期，～，龙吟云萃，固非偶然也。","book":"唐·杜光庭《虬髯客传》"},"similar":["龙腾云起"],"usage":"作宾语；指大展宏图"},{"id":39242,"word":"虎啸风生，龙腾云起","pinyin":"hǔ xiào fēng shēng，lóng téng yún qǐ","abbr":"hxfsltyq","explanation":"猛虎长鸣，则大风四起；蛟龙腾跃，则云彩出现。比喻英雄人物顺时而现，并对社会产生极大的影响。也指豪杰奋起，大展宏图。","source":{"text":"虎啸生风，龙腾云起，英贤奋发，亦各因时。","book":"《北史·张定和传论》"}},{"id":39243,"word":"虎啸风驰","pinyin":"hǔ xiào fēng chí","abbr":"hxfc","explanation":"啸：兽类的长声吼叫。指事物之间的相互感应。","source":{"text":"夫虎啸风驰，龙兴云属，故重华立而元凯升，辛受生而飞廉进。","book":"南朝·梁·刘孝标《辩命论》"},"usage":"作宾语、定语；用于书面语"},{"id":39244,"word":"虎啸龙吟","pinyin":"hǔ xiào lóng yín","abbr":"hxly","explanation":"象虎在啸，龙在鸣。比喻相关的事物互相感应。也形容人发迹。","source":{"text":"尔乃龙吟方泽，虎啸山丘。","book":"汉·张衡《归田赋》"},"example":{"text":"太平天国·洪秀全《吟剑诗》：“～光世界，太平一统乐如何！”"},"similar":["龙吟虎啸"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":39245,"word":"虎头上捉虱子","pinyin":"hǔ tóu shàng zhuō shī zi","abbr":"htszsz","explanation":"在老虎头上捉虱子。比喻干危险的事情。也指不懂厉害，冲撞了惹不起的大人物或势力。","source":{"text":"你偏进去，又不就走，还要虎头上捉虱子。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["虎口拔须"],"usage":"作宾语、定语；指危险的行动"},{"id":39246,"word":"虎头燕颔","pinyin":"hǔ tóu yàn hàn","abbr":"htyh","explanation":"旧时形容王侯的贵相或武将相貌的威武。","source":{"text":"燕颔虎颈，飞而食肉。","book":"《后汉书·班超传》"},"example":{"text":"从古人才难得，我看你～，封侯万里，况又生得这等的望族。","book":"清·文康《儿女英雄传》第十八回"},"similar":["虎头燕额","燕颔虎头"],"usage":"作谓语、宾语、定语；形容相貌威武"},{"id":39247,"word":"虎头燕额","pinyin":"hǔ tóu yàn é","abbr":"htye","explanation":"形容王侯的贵相或相貌的威武。","source":{"text":"我虎头燕额，羞杀他脸似桃花。","book":"明·无心子《金雀记·掷果》"},"similar":["虎头燕颔"],"usage":"作谓语、宾语、定语；形容相貌威武"},{"id":39248,"word":"虎头虎脑","pinyin":"hǔ tóu hǔ nǎo","abbr":"hthn","explanation":"形容壮健憨厚的样子（多指儿童）。","source":{"text":"是个年壮力足虎头虎脑的英雄。","book":"老舍《赵子曰》"},"example":{"text":"小男孩长得～，非常结实。"},"opposite":["猴头猴脑"],"usage":"作状语、定语；多指儿童"},{"id":39249,"word":"虎头蛇尾","pinyin":"hǔ tóu shé wěi","abbr":"htsw","explanation":"头大如虎，尾细如蛇。比喻开始时声势很大，到后来劲头很小，有始无终。","source":{"text":"则为你两头白面搬兴废，转背言词说是非，这厮敢狗行狼心，虎头蛇尾。","book":"元·康进之《李逵负棘》第二折"},"example":{"text":"小奇也许会写得好，就是她有一个毛病，“～”。","book":"冰心《陶奇的星期日记》"},"similar":["为德不卒","有始无终"],"opposite":["全始全终","善始善终","持之以恒"],"usage":"作定语、宾语、状语；比喻做事有始无终","story":["清朝时期，官场十分腐败，只要有钱就可以捐官。京城的都老爷给皇上上奏折要求整顿吏治。湖南巡抚接到皇上的指令，立即组织手下的文武百官进行考试，并声言对请人代考的人斩立决，当场抓了他二少爷的枪手，此事就只好虎头蛇尾了"]},{"id":39250,"word":"虎头鼠尾","pinyin":"hǔ tóu shǔ wěi","abbr":"htsw","explanation":"头大如虎，尾细如老鼠。比喻做事起始时声势很大，后来劲头很小，有始无终。","source":{"text":"律诗无好结句，谓之虎头鼠尾。","book":"明·谢榛《四溟诗话》"},"similar":["虎头蛇尾"],"opposite":["有始有终"],"usage":"作定语、宾语、状语；比喻做事有始无终"},{"id":39251,"word":"虎威狐假","pinyin":"hǔ wēi hú jiǎ","abbr":"hwhj","explanation":"假：假借，凭借。狐狸假借老虎的威风去吓唬其他野兽。比喻依仗别人的势力去欺压别人。","source":{"text":"或以集翼鷃披，虎威狐假。","book":"北周·庾信《哀江南诗》"},"similar":["狐假虎威"],"usage":"作谓语、定语、宾语；指借机欺压别人"},{"id":39252,"word":"虎子狼孙","pinyin":"hǔ zǐ láng sūn","abbr":"hzls","explanation":"虎和狼的子孙后代。比喻凶狠残暴之人。","source":{"text":"虎子狼孙，茫茫黔首，于何叫阍。","book":"《旧唐书·王延凑传赞》"}},{"id":39253,"word":"虎尾春冰","pinyin":"hǔ wěi chūn bīng","abbr":"hwcb","explanation":"踩着老虎尾巴，走在春天将解冻的冰上。比喻处境非常危险。","source":{"text":"心之忧危，若蹈虎尾，涉于春冰。","book":"《尚书·君牙》"},"example":{"text":"烦君属和增危惕，～寄此生。","book":"宋·朱熹《择之所和生字韵，极警切，次韵谢之，兼呈伯崇》"},"similar":["春冰虎尾"],"usage":"作宾语；比喻处境非常危险"},{"id":39254,"word":"虎据龙蟠","pinyin":"hǔ jù lóng pán","abbr":"hjlp","explanation":"形容地势雄伟险要。同“虎踞龙盘”。","source":{"text":"昔之虎据龙蟠，加以黄旗紫气；莫不随狐兔而窟穴，与风尘而殄悴。","book":"北周·庚信《哀江南赋》"},"similar":["虎踞龙盘","虎踞龙蟠"],"usage":"作主语、宾语；形容地势雄伟险要"},{"id":39255,"word":"虎掷龙拿","pinyin":"hǔ zhì lóng ná","abbr":"hzln","explanation":"掷：挣扎跳跃。指龙虎互相争斗。比喻激烈的搏斗。","source":{"text":"虎掷龙拿不两存，当年曾此赌乾坤。","book":"金·元好问《楚汉战处》诗"},"similar":["虎跳龙拿"],"usage":"作宾语、定语；用于比喻句"},{"id":39256,"word":"虎斑霞绮，林籁泉韵","pinyin":"hǔ bān xiá qǐ，lín lài quán yùn","abbr":"hbxqllqy","explanation":"绮：美丽；籁：孔穴中发出的声响；韵：悦耳和谐的声音。形容自然界景色秀丽，各种声音悦耳动听。","source":{"text":"故凡虎斑霞绮，林籁泉韵，俱为文章。其说汗漫，不可审理。","book":"鲁迅《汉文学史纲要》第一篇"},"usage":"作宾语、定语；用于书面语"},{"id":39257,"word":"虎斗龙争","pinyin":"hǔ dòu lóng zhēng","abbr":"hdlz","explanation":"形容斗争或竞赛很激烈。","source":{"text":"分裂诸夏，龙战虎争。","book":"汉·班固《答宾戏》"},"example":{"text":"桂林杏苑，空成魂梦之游；～，又见战征之事。","book":"清·吴敬梓《儒林外史》第四十二回"},"similar":["龙争虎斗"],"usage":"作谓语、宾语；比喻群雄互相争斗"},{"id":39258,"word":"虎步龙行","pinyin":"hǔ bù lóng xíng","abbr":"hblx","explanation":"原形容帝王的仪态不同一般。后也形容将军的英武姿态。","source":{"text":"刘裕龙行虎步，视瞻不凡，恐不为人下，宜早为其所。","book":"《宋书·武帝纪上》"},"example":{"text":"只见那人生得面如冠玉，唇若涂朱，眉清目秀，～。","book":"清·吴趼人《痛史》第十回"},"similar":["龙行虎步"],"usage":"作谓语；形容帝王的仪态不同一般"},{"id":39259,"word":"虎毒不食儿","pinyin":"hǔ dú bù shí ér","abbr":"hdbse","explanation":"老虎再歹毒也不会吃掉自己的孩子。","source":{"text":"自古虎毒不食儿，如今朝廷失政，大变伦常，各处荒乱，刀兵四起，天将不祥，祸乱已现。","book":"明·许仲琳《封神演义》第33回"},"similar":["虎毒不食子"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":39260,"word":"虎父无犬子","pinyin":"hǔ fù wú quǎn zǐ","abbr":"hfwqz","explanation":"勇猛的父亲不会生出一般的孩子。用于夸奖别人的子辈。","source":{"text":"以十九岁之妙龄弱质，凌数千里之莽涛瘴雾，亦可谓虎父无犬子也。","book":"章诒和《往事并不如烟·最后的贵族》"},"example":{"text":"真是～，周骧是一个不错的孩子。"},"usage":"作宾语、定语；用于夸奖人"},{"id":39261,"word":"虎牙桀立","pinyin":"hǔ yá jié lì","abbr":"hyjl","explanation":"桀：小木桩。如虎牙之状，像群桩而立。比喻山势险峻。","source":{"text":"尧山一名豆山，今山于城北如东，崭绝孤峙，虎牙桀立。","book":"北魏·郦道元《水经注·滱水》"}},{"id":39262,"word":"虎狼之势","pinyin":"hǔ láng zhī shì","abbr":"hlzs","explanation":"形容极凶猛的声势。","source":{"text":"孝公欲以虎狼之势而吞诸侯。","book":"《淮南子·要略》"},"usage":"作宾语；用于局势"},{"id":39263,"word":"虎狼之国","pinyin":"hǔ láng zhī guó","abbr":"hlzg","explanation":"像饿虎贪狼一样的国家。形容侵略成性的国家。","source":{"text":"秦，虎狼之国，不可信。","book":"《史记·屈原贾生列传》"},"example":{"text":"我们要时刻提防那些～的侵略。"},"opposite":["礼仪之邦"],"usage":"作宾语、定语；指侵略成性的国家","story":["战国时期，秦国意图吞并六国，派张仪去游说楚国不要与齐国联盟，贪心的楚怀王信以为真，得不到秦国许诺的土地就攻打秦国，结果被秦国打败并赔偿秦国的土地。楚怀王不听屈原的“秦国是虎狼之国”的劝告，只身去秦，客死秦国"]},{"id":39264,"word":"虎狼之威","pinyin":"hǔ láng zhī wēi","abbr":"hlzw","explanation":"像虎和狼那样的威风。形容威严凶猛的气派和声势。","source":{"text":"告大人暂息雷霆之怒，略罢虎狼之威。","book":"元·无名氏《举案齐眉》第四折"},"usage":"作宾语；形容极凶猛的威势"},{"id":39265,"word":"虎狼之心","pinyin":"hǔ láng zhī xīn","abbr":"hlzx","explanation":"比喻凶残的野心。","source":{"text":"今秦，四塞之国也，有虎狼之心，恐其有木梗之患。","book":"汉·刘向《说苑·正谏》"},"usage":"作宾语；用于比喻句","story":["战国时期，孟尝君准备去西边的秦国，门客用寓言谏之说：在淄水听到土耦人与木梗人的对话，木梗人说土耦人前身是土，遇水必化。土耦人说木梗人是东园之桃，遇水漂泊异乡。秦国有虎狼之心，不能去。孟尝君才能门客的意见，不敢去秦国"]},{"id":39266,"word":"虎狼之穴","pinyin":"hǔ láng zhī xué","abbr":"hlzx","explanation":"虎和狼居住的洞穴。比喻极其危险的地方。","source":{"text":"父亲奈何以万金之躯，亲蹈虎狼之穴。","book":"明·罗贯中《三国演义》第六十六回"}},{"id":39267,"word":"虎珀拾芥","pinyin":"hǔ pò shí jiè","abbr":"hpsj","explanation":"琥珀摩擦后生电，能吸引细小的东西。比喻互相感应。","source":{"text":"顿牟拾芥，磁石引针。","book":"汉·王充《论衡·乱龙》"}},{"id":39268,"word":"虎生三子，必有一彪","pinyin":"hǔ shēng sān zì，bì yǒu yī biāo","abbr":"hsszbyyb","explanation":"比喻众多子女之中，一定有一个超群出众的人。","source":{"text":"谚云：‘虎生三子，必有一彪。’","book":"《癸辛杂识》"},"usage":"作宾语、定语；用于口语"},{"id":39269,"word":"虎生而文炳","pinyin":"hǔ shēng ér wén bǐng","abbr":"hsewb","explanation":"文：纹理；炳：显著。老虎生来身上的皮毛就是花纹鲜艳多彩。比喻人本来就具有的素质和品德。","source":{"text":"虎生而文炳，凤生而五色，岂以五采自饰画哉？天性自然也。","book":"《三国志·蜀志·秦宓传》"}},{"id":39270,"word":"虎略龙韬","pinyin":"hǔ lüè lóng tāo","abbr":"hllt","explanation":"略：指传说中黄石公所撰的《三略》。韬：指《六韬》。《三略》、《六韬》是古代兵书。泛指兵书、兵法，也指兵家权谋。","source":{"text":"一朝奔迸各西东，玉斝金杯散蓬荜。清都太微天听高，虎略龙韬缄石室。","book":"明·刘基《悲杭城》诗"},"example":{"text":"雄图壮志千秋罕，～万众从。","book":"郭化若《奉和陈司令赐诗步原韵》"},"usage":"作宾语、定语；用于书面语"},{"id":39271,"word":"虎瘦雄心在","pinyin":"hǔ shòu xióng xīn zài","abbr":"hsxxz","explanation":"比喻人穷志不穷。","source":{"text":"虎瘦雄心在，人贫场所存。","book":"元·万松老人《从容录》"},"similar":["人穷志不穷"],"usage":"作宾语、定语；用于为人"},{"id":39272,"word":"虎皮羊质","pinyin":"hǔ pí yáng zhì","abbr":"hpyz","explanation":"质：本性。比喻外强内弱，虚有其表。","source":{"text":"羊质虎皮，见草而悦，见豺而战，忘其皮之虎矣。","book":"西汉·扬雄《法言·吾子》"},"example":{"text":"～，霸者假之以为护符。","book":"梁启超《新民说》"},"similar":["羊质虎皮"],"usage":"作宾语、定语；指外强中干"},{"id":39273,"word":"虎穴得子","pinyin":"hǔ xué dé zǐ","abbr":"hxdz","explanation":"比喻诗文贴切中肯。","source":{"text":"先生之作，诚可谓虎穴得子矣！","book":"明·郎瑛《七修类稿·佛顶菊》"},"usage":"作宾语、定语；用于说话等"},{"id":39274,"word":"虎穴狼巢","pinyin":"hǔ xué láng cháo","abbr":"hxlc","explanation":"虎和狼的巢穴。比喻极其危险的地方。","source":{"text":"半年来某未尝在署，晨昏缺然，掷此身于红尘赤日，付八口于虎穴狼巢，无不为某称危者。","book":"明·卢象昇《与蒋泽垒先生五首》其三"}},{"id":39275,"word":"虎穴龙潭","pinyin":"hǔ xué lóng tán","abbr":"hxlt","explanation":"龙潜居的深水坑，老虎藏身的巢穴。比喻极险恶的地方。","source":{"text":"不甫能撞开了天关地户，跳出这龙潭虎窟。","book":"元·无名氏《昊天塔》第三折"},"example":{"text":"感谢坐位豪杰不避凶险，来～，力救残生。","book":"明·施耐庵《水浒全传》第四十一回"},"similar":["虎窟龙潭","虎窟狼窝"],"usage":"作宾语、定语；比喻极险恶的地方"},{"id":39276,"word":"虎窟狼窝","pinyin":"hǔ kū láng wō","abbr":"hklw","explanation":"窟：洞穴。比喻极其危险的地方。","source":{"text":"不是宋江来和这人厮见，有分教，江州城里，翻为虎窟狼窝。","book":"明·施耐庵《水浒传》第37回"},"similar":["虎穴狼窝","虎穴龙潭"],"usage":"作宾语、定语；用于书面语"},{"id":39277,"word":"虎窟龙潭","pinyin":"hǔ kū lóng tán","abbr":"hklt","explanation":"窟：洞穴；潭：深水池。龙居住的深水潭，虎栖身的巢穴。比喻极其凶险的地方。","source":{"text":"怕筑成传说墙，愁扳折朱云槛，急跳出虎窟龙潭。","book":"元·汪元亨《沉醉东风·归田》"},"example":{"text":"岳侯冒险浑身胆，翻身入～，愿把命儿拚。","book":"清·钱彩《说岳全传》第五十回"},"similar":["龙潭虎穴","虎穴龙潭"],"usage":"作宾语；指凶险的地方"},{"id":39278,"word":"虎符龙节","pinyin":"hǔ fú lóng jié","abbr":"hflj","explanation":"虎符：古代铜制虎形兵符；龙节：古代邦国使臣用的金制龙形凭证。比喻重要的凭证。","source":{"text":"虎符龙节昭歧路，何苦愁为江海人。","book":"唐·卢纶《送从叔牧永州》诗"},"example":{"text":"金卷王册，～。","book":"宋·苏轼《表忠观碑铭》"},"usage":"作宾语、定语；用于书面语"},{"id":39279,"word":"虎而冠","pinyin":"hǔ ér guàn","abbr":"heg","explanation":"冠：把帽子戴在头上。比喻生性残虐的人。","source":{"text":"其爪牙吏，虎而冠。","book":"《史记·酷吏列传》"}},{"id":39280,"word":"虎而冠者","pinyin":"hǔ ér guān zhě","abbr":"hegz","explanation":"冠：帽子。穿衣戴帽的老虎。比喻凶残如虎之人。","source":{"text":"齐王母家驷钧，恶戾，虎而冠者也。","book":"《史记·齐悼惠王世家》"}},{"id":39281,"word":"虎背熊腰","pinyin":"hǔ bèi xióng yāo","abbr":"hbxy","explanation":"背宽厚如虎，腰粗壮如熊。形容人身体魁梧健壮。","source":{"text":"这厮倒是一条好汉，狗背驴腰的，哦，是虎背熊腰。","book":"元·无名氏《飞刀对箭》"},"example":{"text":"一个面如重枣，一个脸似黄金，都是～，相貌非凡。","book":"清·李汝珍《镜花缘》第九十五回"},"similar":["熊腰虎背"],"opposite":["弱不禁风","肌瘦如柴"],"usage":"作宾语、定语；形容体格健壮"},{"id":39282,"word":"虎荡羊群","pinyin":"hǔ dàng yáng qún","abbr":"hdyq","explanation":"老虎跑进羊群。比喻强大者冲入柔弱者中间任意横行，以强凌弱。","source":{"text":"孔融望见太史慈与关、张赶杀贼众，如虎入羊群，纵横莫当。","book":"明·罗贯中《三国演义》第十一回"},"example":{"text":"那知小侠指东打西，窜南跃北，犹台～。","book":"清·石玉昆《三侠五义》第九十二回"},"similar":["虎入羊群"],"usage":"作宾语；比喻强者在肆意欺凌弱者"},{"id":39283,"word":"虎落平川","pinyin":"hǔ luò píng chuān","abbr":"hlpc","explanation":"平川：地势平坦的地方。老虎离开自己称王称霸的深山老林，落到了平地上。比喻有权有势或有实力者失去了自己的权势或优势。","source":{"text":"虎落平川被犬欺。","book":"清·钱彩《说岳全传》第40回"},"example":{"text":"他此刻有～之感。"},"similar":["虎落平阳"],"usage":"作主语、宾语、定语；指人失势"},{"id":39284,"word":"虎落平阳","pinyin":"hǔ luò píng yáng","abbr":"hlpy","explanation":"平阳：地势平坦明亮的地方。老虎离开深山，落到平地里受困。比喻失势。","source":{"text":"虎落平川被犬欺。","book":"清·钱彩《说岳全传》第40回"},"example":{"text":"他顿时就产生～的感觉。"},"similar":["孤雁失群","蛟龙失水"],"opposite":["放虎归山","蛟龙得水"],"usage":"作宾语、定语；常与“被犬欺”连用"},{"id":39285,"word":"虎虎有生气","pinyin":"hǔ hǔ yǒu shēng qì","abbr":"hhysq","explanation":"虎虎：威武勇猛的样子。形容勇猛威武，气势蓬勃，生命力旺盛。","source":{"text":"他那篇有名的万言的《陈政事疏》，在两千年后的今日虽然都还虎虎有生气，但在当时的权贵者却字字都是眼中钉。","book":"郭沫若《贾长沙痛哭》"},"example":{"text":"王朔《刘慧芳》：“他放下菜篮子，转过身面对慧芳，～。”"},"usage":"作谓语、定语；用于气势等"},{"id":39286,"word":"虎视眈眈","pinyin":"hǔ shì dān dān","abbr":"hsdd","explanation":"眈眈：注视的样子。象老虎那样凶狠地盯着。形容心怀不善，伺机攫取。","source":{"text":"虎视耽耽，其欲逐逐。","book":"《周易·颐》"},"example":{"text":"你看这里这些人，因见老太太多疼了宝玉和凤姐姐两个，他们尚～，背地里言三语四的，何况于我？","book":"清·曹雪芹《红楼梦》第四十回"},"similar":["凶相毕露"],"usage":"作定语、状语；形容心怀不善，伺机攫取"},{"id":39287,"word":"虎视耽耽","pinyin":"hǔ shì dān dān","abbr":"hsdd","explanation":"像老虎那样凶狠地盯着。形容心怀不善，伺机攫取某种东西","source":{"text":"这些人都有虎视耽耽之意。若欲加害，索性全害了，方为稳便。","book":"清·石玉昆《三侠五义》第100回"},"similar":["虎视眈眈"],"usage":"作定语、状语；形容心怀不善，伺机攫取"},{"id":39288,"word":"虎视鹰扬","pinyin":"hǔ shì yīng yáng","abbr":"hsyy","explanation":"扬：高举，飞起。像老虎那样雄视，像老鹰那样飞翔天空。形容人很有威仪。","source":{"text":"明正德间，李空同虎视鹰扬，望之森森武库，学者风靡，固其雄也。","book":"清·施润章《重刻序》"},"usage":"作谓语、定语；用于比喻句"},{"id":39289,"word":"虎视鹰瞵","pinyin":"hǔ shì yīng lín","abbr":"hsyl","explanation":"瞵：眼光闪闪地看着。像虎和鹰那样恶狠狠地注视着。比喻强敌窥伺。","source":{"text":"虎视鹰瞵萃列强，竞称兵要犯封疆。","book":"清·洪楝园《后南柯·代檀》"},"example":{"text":"清·洪楝园《后南柯·代檀》：“虎视鹰瞵萃列强，竞称兵要犯封疆。”"},"usage":"作谓语、状语；指贪婪"},{"id":39290,"word":"虎豹不外其爪","pinyin":"hǔ bào bù wài qí zhǎo","abbr":"hbbwqz","explanation":"老虎和豹子不轻易将自己的爪子露出来。比喻军队不轻易把自己的威势和实力显露在外面。","source":{"text":"虎豹不外其爪，而噬不见齿。故用兵之道，未之以柔而迎之以刚。","book":"《淮南子·兵略训》"}},{"id":39291,"word":"虎豹之驹","pinyin":"hǔ bào zhī jū","abbr":"hbzj","explanation":"驹：两岁以下的幼马或少壮的骏马。指虎和豹的幼子。比喻志向远大的英俊少年。","source":{"text":"虎豹驹未成文，而有食牛之气。","book":"《尸子》"}},{"id":39292,"word":"虎豹九关","pinyin":"hǔ bào jiǔ guān","abbr":"hbjg","explanation":"九关：九重天门。到天庭去的九重门都有虎豹把守。比喻凶暴残虐的弄权之臣。","source":{"text":"魂兮归来，君无上天兮；虎豹九关，啄害天下人兮。一夫九首，拔木九千兮。","book":"战国·楚·屈原《招魂》"},"example":{"text":"白日射金阙，～开。见君谏疏频上，高论挽天回。","book":"宋·辛弃疾《水调歌头·汤坡见和、用韵为谢》"}},{"id":39293,"word":"虎豹狼虫","pinyin":"hǔ bào láng chóng","abbr":"hblc","explanation":"泛指危害人畜的各种野兽。比喻凶残害人的坏人。","source":{"text":"手中那棒，上抵三十三天，下至十八层地狱，把些虎豹狼虫，满山群怪，七十二洞妖王，都吓得磕头礼拜。","book":"明·吴承恩《西游记》第三回"},"similar":["虎豹豺狼","狼虫虎豹"],"usage":"作主语、宾语、定语；用于书面语"},{"id":39294,"word":"虎豹豺狼","pinyin":"hǔ bào chái láng","abbr":"hbcl","explanation":"泛指危害人畜的各种野兽。比喻凶残害人的坏人。","source":{"text":"那里有什么虎豹豺狼，那里有什么奇花，那里有什么绝代佳人，只见太阳光线一会儿暗似一会，渐渐沉下去了。","book":"曾朴《孽海花》第一回"},"similar":["虎豹狼虫","狼虫虎豹"],"usage":"作主语、宾语、定语；用于书面语"},{"id":39295,"word":"虎质羊皮","pinyin":"hǔ zhì yáng pí","abbr":"hzyp","explanation":"质：本性。羊虽然披上虎皮，还是见到草就喜欢，碰到豺狼就怕得发抖，它的本性没有变。比喻外表装作强大而实际上很胆小。","source":{"text":"羊质而虎皮，见草而悦，见豺而战，忘其皮之虎矣。","book":"汉·扬雄《法言·吾子》"}},{"id":39296,"word":"虎贲中郎","pinyin":"hǔ bēn zhōng láng","abbr":"hbzl","explanation":"虎贲：勇士；中郎：指东汉蔡邕，曾做左中郎将。有一个勇士与蔡中郎长相特别相似。形容两人面貌相似，如同一个人一样。","source":{"text":"与蔡邕素善，邕卒后，有虎贲士貌类于邕，融每酒酣，引与同坐，曰：‘虽无老成人，且有典型。’","book":"《后汉书·孔融传》"}},{"id":39297,"word":"虎超龙骧","pinyin":"hǔ chāo lóng xiāng","abbr":"hclx","explanation":"比喻群雄奋起，互相角逐。","source":{"text":"当此时也，九州鼎沸，四海渊涌。言帝者二三，称王者四五。鸱视狼顾，虎超龙骧。","book":"三国·魏·曹植《汉二祖优劣论》"},"usage":"作宾语、定语；用于比喻句"},{"id":39298,"word":"虎跃龙骧","pinyin":"hǔ yuè lóng xiāng","abbr":"hylx","explanation":"骧：马首昂举，上举；龙骧：比喻气概威武。形容威武雄壮的样子。","source":{"text":"综核万变，以义而动。虎跃龙骧，天下震恐。","book":"明·方孝孺《尚友五赞·诸葛武侯》"},"usage":"作宾语、定语；用于比喻句"},{"id":39299,"word":"虎跳龙拿","pinyin":"hǔ tiào lóng ná","abbr":"htln","explanation":"跳：跳跃。像老虎那样跳跃，像龙那样伸爪抓取。比喻身手矫健，武艺高强。也比喻英雄相互征战。","source":{"text":"虎掷龙拿不两存，当年曾此睹乾坤。","book":"金·元好问《楚汉战处》"},"example":{"text":"就是他帐下那班奔走的健儿，也是一个个有……～之技。","book":"清·文康《儿女英雄传》第十八回"},"similar":["虎掷龙拿"],"usage":"作宾语、定语；用于比喻句"},{"id":39300,"word":"虎踞鲸吞","pinyin":"hǔ jù jīng tūn","abbr":"hjjt","explanation":"比喻豪强割据和相互兼并。","source":{"text":"诸将皆来动问，尽皆愕然相顾曰：‘江北百万之众，虎踞鲸吞。不争都督如此，倘曹兵一至，如之奈何？’","book":"明·罗贯中《三国演义》第四十九回"},"usage":"作宾语、定语；用于局势"},{"id":39301,"word":"虎踞龙盘","pinyin":"hǔ jù lóng pán","abbr":"hjlp","explanation":"形容地势雄伟险要。","source":{"text":"高城新筑压长川，虎踞龙盘气色全。","book":"晋·吴勃《吴录》：“刘备曾使诸葛亮至京，因睹秣陵山阜，叹曰：‘钟山龙盘，石头虎踞，此帝王之宅。’” 唐·雍陶《河阴新城》诗"},"example":{"text":"～今胜昔，天翻地覆慨而慷。","book":"毛泽东《人民解放军占领南京》诗"},"similar":["龙盘虎踞"],"usage":"作主语、宾语；形容地势雄伟险要","story":["三国时期，刘备为了联吴抗曹，派诸葛亮去吴都建业去游说孙权。诸葛亮到了建业，看到秣陵的山势地形，感慨地说：“紫金山山势险峻，像一条龙环绕建业，石头城很威武，像老虎蹲踞着，这是帝王建都的好地方。”"]},{"id":39302,"word":"虎踞龙蟠","pinyin":"hǔ jù lóng pán","abbr":"hjlp","explanation":"形容地势雄伟险要。同“虎踞龙盘”。","source":{"text":"虎踞龙蟠何处是？只有兴亡满目。","book":"宋·辛弃疾《念奴娇·登建康赏心亭呈史留守致道》词"},"example":{"text":"茅盾《八百壮士》：“那时正当淞沪沦陷，苏嘉失守，而‘～’的首都也危在旦夕。”"},"similar":["虎据龙蟠","虎踞龙盘"],"usage":"作主语、宾语；形容地势雄伟险要"},{"id":39303,"word":"虎踪猫迹","pinyin":"hǔ zōng māo jì","abbr":"hzmj","explanation":"痕迹，蛛丝马迹。","example":{"text":"请注意一切～，不要错过。"},"similar":["蛛丝马迹"],"usage":"作主语、宾语、状语；指线索"},{"id":39304,"word":"虎饱鸱咽","pinyin":"hǔ bǎo chī yàn","abbr":"hbcy","explanation":"像老虎一样凶残饱食，像鹞鹰一样贪婪地吞咽猎物。形容贪官污吏凶狠贪婪。","source":{"text":"当世嚣嚣，非患儒之鸡廉，患在位者之虎饱鸱咽，于求览无所孑遗耳。","book":"汉·桓谭《盐铁论·褒贤》"}},{"id":39305,"word":"虐人害物","pinyin":"nuè rén hài wù","abbr":"nrhw","explanation":"虐：残暴，侵害。指残害百姓。","source":{"text":"虐人害物即豺狼，何必钩爪锯牙食人肉？","book":"唐·白居易《杜陵叟》"},"example":{"text":"唐·白居易《杜陵叟》：“虐人害物即豺狼，何必钩爪锯牙食人肉？”"},"usage":"作主语、宾语、定语；指残害百姓"},{"id":39306,"word":"虐老兽心","pinyin":"nüè lǎo shòu xīn","abbr":"nlsx","explanation":"虐老：虐待老人。喻残暴凶狠而无仁义，有如野兽。","source":{"text":"于戏！荤粥氏虐老兽心，侵犯寇盗，加以奸巧边萌。","book":"汉·班固《汉书·武五子传》：“呜呼！薰鬻氏虐老兽心，以奸巧边氓。朕命将率，徂征厥罪。”汉·司马迁《史记·王世家》"}},{"id":39307,"word":"虑不及远","pinyin":"lǜ bù jí yuǎn","abbr":"lbjy","explanation":"远：长远。老虎不到长远。形容目光短浅。","source":{"text":"所以僶俛从事，志在宣力，虑不及远。","book":"《宋书·王弘传》"},"example":{"text":"虽能快中心之所欲，而后世之被其患有不可胜道者，此所谓～也。","book":"宋·陈亮《酌古论·桑维翰》"}},{"id":39308,"word":"虑事多暗","pinyin":"lǜ shì duō zǎo","abbr":"lsda","explanation":"考虑事情不明。","example":{"text":"～的人往往不能成功。"},"usage":"作定语；用于口语"},{"id":39309,"word":"虑周藻密","pinyin":"lǜ zhōu zǎo mì","abbr":"lzzm","explanation":"藻：辞藻，措辞。密：缜密。思路严谨，措词缜密。考虑周到，辞采细密。","source":{"text":"白寿彝总主编《中国通史》(第十三册)第二节：“元诗矫宋流弊，而失于多学晚唐，……然其佳者则婉转惆怅，附物切情，工整而流逸，清新而秀丽，虑周藻密而不涉于粗疏，意深韵远而不失之径直”。"}},{"id":39310,"word":"虑无不周","pinyin":"lǜ wú bù zhōu","abbr":"lwbz","explanation":"虑：思虑，考虑；周：周全。思考没有不周全之处。形容考虑问题十分全面。","source":{"text":"至于大事，与四海接，恩之所加，皆过其望，虽所不见，虑无不周，此仁胜也。","book":"《资治通鉴·汉纪·孝献皇帝丁建安元年》"},"example":{"text":"绍恤近忽远，公～，此仁胜也。","book":"明·罗贯中《三国演义》第十八回"}},{"id":39311,"word":"虚一而静","pinyin":"xū yī ér jìng","abbr":"xyej","explanation":"指虚心、专一而冷静地观察事物，就能得到正确的认识。","source":{"text":"心何以知？曰：‘虚一而静。’","book":"《荀子·解蔽》"},"example":{"text":"外之得以窒吾听、杂吾目、扰吾天君者，以吾未得～之理也。","book":"《宋史·赵汝谈传》"},"usage":"作宾语；用于书面语"},{"id":39312,"word":"虚与委蛇","pinyin":"xū yǔ wēi yí","abbr":"xywy","explanation":"虚：假；委蛇：随便应顺。指对人虚情假意，敷衍应酬。","source":{"text":"乡吾示之以未始出吾宗，吾与之虚而委蛇。","book":"《庄子·应帝王》"},"example":{"text":"他也要同你～了。","book":"闻一多《诗与批评·戏剧的歧途》"},"similar":["敷衍了事","虚情假意"],"opposite":["心口如一","真心实意"],"usage":"作谓语、宾语、定语；指敷衍了事","story":["战国时期，列子是壶子的学生，学习老庄之道，后来他遇到郑国的神巫季咸，就把他介绍给壶子。他们在一起开始斗法比高低，壶子跟季咸虚与委蛇，让他感到难以捉摸，就落荒而逃。列子刻苦学习，修炼老庄之道，终于达到忘我的境界"]},{"id":39313,"word":"虚中乐善","pinyin":"xū zhōng lè shàn","abbr":"xzls","explanation":"中：同“衷”，内心；虚中：虚心；善：善言善事。指虚心采纳善言，乐意做善事。","source":{"text":"古之人虚中乐善，不择事而问焉，不择人而问焉。","book":"清·刘开《问说》"},"usage":"作谓语；用于书面语"},{"id":39314,"word":"虚为委蛇","pinyin":"xū wéi wēi yí","abbr":"xwwy","explanation":"虚：假；委蛇：随便应顺。指对人虚情假意，敷衍应酬。","source":{"text":"乡吾示之以未始出吾宗，吾与之虚而委蛇。","book":"《庄子·应帝王》"},"example":{"text":"而冀诸公相与为实践，以矫～之失。","book":"孙中山《和平统一之通电》"},"similar":["虚与委蛇"],"usage":"作谓语、宾语、定语；指敷衍了事"},{"id":39315,"word":"虚位以待","pinyin":"xū wèi yǐ dài","abbr":"xwyd","explanation":"留着位置等待。","source":{"text":"公子从车骑，虚左，自迎夷门侯生。","book":"《史记·魏公子列传》"},"example":{"text":"宁可～人,不可以人而滥位。","book":"明·冯梦龙《东周列国志》"},"similar":["虚左以待"],"usage":"作谓语；指留着位置恭候"},{"id":39316,"word":"虚作声势","pinyin":"xū zuò shēng shì","abbr":"xzss","explanation":"假装出强大的气势。指假造声势，借以吓人。","source":{"text":"淄青、恒冀两道，与蔡州气类略同，今闻讨伐元济，人情必有救助之意，然皆暗弱，自保无暇，虚张声势，则必有之。","book":"唐·韩愈《论淮西事宜状》"},"example":{"text":"火把中看见众军士面带怯色，想想外边都是乌合之众～，城外突袭一战即收。","book":"二月河《乾隆皇帝》二十四"}},{"id":39317,"word":"虚受益，满招损","pinyin":"xū shòu yì，mǎn zhāo sǔn","abbr":"xsymzs","explanation":"虚：虚心；受：得到；益：好处；满：自满，骄傲；招：招惹；损：损害。自满会招致损失，谦虚可以得到好处。","source":{"text":"盖虚受益，满招损。心虚而后学进，学愈进，心愈虚，虚心者为学之门，亦为学之验也。","book":"清·李沂《秋星阁诗话·劝虚心》"},"similar":["谦受益，满招损"],"usage":"作定语、宾语、分句；用于劝诫人"},{"id":39318,"word":"虚名在外","pinyin":"xū míng zài wài","abbr":"xmzw","explanation":"虚名：与实际情况不符的名声。在外界有一个虚而不实的名声。","example":{"text":"他只不过是～罢了。"},"similar":["徒有虚名"],"usage":"作谓语、定语；指徒有空名"},{"id":39319,"word":"虚名薄利","pinyin":"xū míng bó lì","abbr":"xmbl","explanation":"虚浮的名声，微薄的利益。指不看重世俗名利。","source":{"text":"人间何最苦，说著替君愁。眼前生灭景、象悠悠。虚名薄利，随分少贪求。","book":"元·王丹桂《满路花》"},"example":{"text":"空热闹～，分外惹闲愁。","book":"元·无名氏《锦堂春》"},"usage":"作谓语、定语；用于处事"},{"id":39320,"word":"虚嘴掠舌","pinyin":"xū zuǐ lüè shé","abbr":"xzls","explanation":"比喻花言巧语。","source":{"text":"谁听你那虚嘴掠舌的？我到明日死了，你也舍不得我吧？","book":"明·兰陵笑笑生《金瓶梅词话》第61回"},"similar":["花言巧语"],"usage":"作谓语、宾语；指花言巧语"},{"id":39321,"word":"虚堂悬镜","pinyin":"xū táng xuán jìng","abbr":"xtxj","explanation":"旧时比喻地方官廉明公正。","source":{"text":"无术，第公此心，如虚堂悬镜耳。","book":"《宋史·陈良翰传》"},"similar":["明镜高悬"],"usage":"作谓语、定语；指人心术纯正"},{"id":39322,"word":"虚声恐吓","pinyin":"xū shēng kǒng hè","abbr":"xskh","explanation":"虚张声势来吓唬人。","source":{"text":"贱不过张其数以虚声恐吓我耳。","book":"明·吴世济《太和县御寇始末·复毫州叶发明书》"},"example":{"text":"这不过是一句～，说过就完。","book":"白羽《偷拳》七"}},{"id":39323,"word":"虚声恫吓","pinyin":"xū shēng dòng hè","abbr":"xsdh","explanation":"恫吓：恐吓。虚张声势来吓唬人。","source":{"text":"贱不过张其数以虚声恐吓我耳。","book":"明·吴世济《太和县御寇始末·复毫州叶发明书》"},"example":{"text":"但此时彼众我寡，双方军力悬殊，这眼前亏是吃定了的；心下好生后悔，实不该～。","book":"金庸《鹿鼎记》第四十八回"},"usage":"作谓语、宾语；用于处事"},{"id":39324,"word":"虚实失度","pinyin":"xū shí shī dù","abbr":"xssd","explanation":"失度：失调。虚与实失去平衡","source":{"text":"一曰矫氏，二曰愈氏，三曰卢氏，诊其所疾，矫氏谓季梁曰：‘汝寒温不节，虚实失度。’","book":"战国·郑·列御寇《列子·力命》"},"usage":"作谓语、定语；用于书面语"},{"id":39325,"word":"虚室上白","pinyin":"xū shì shàng bái","abbr":"xssb","explanation":"虚：使空虚；室：指心；白：指道。心无任何杂念，就会悟出“道”来，生出智慧。也常用以形容清澈明朗的境界。","source":{"text":"瞻彼阕者，虚室生白，吉祥止止。","book":"《庄子·人世间》"},"example":{"text":"～，玄门不关。","book":"唐·韦渠牟《商山四皓画图赞并序》"},"similar":["虚室生白"],"usage":"作宾语、定语；用于书面语"},{"id":39326,"word":"虚室生白","pinyin":"xū shì shēng bái","abbr":"xssb","explanation":"虚：使空虚；室：指心；白：指道。心无任何杂念，就会悟出“道”来，生出智慧。也常用以形容清澈明朗的境界。","source":{"text":"瞻彼阕者，虚室生白，吉祥止止。","book":"《庄子·人世间》"},"example":{"text":"西汉·刘安《淮南子·俶真训》：“是故～，吉祥止也。”"},"similar":["虚室上白"],"usage":"作宾语、定语；用于书面语"},{"id":39327,"word":"虚左以待","pinyin":"xū zuǒ yǐ dài","abbr":"xzyd","explanation":"虚：空着；左：古时以左为尊；待：等待。空着尊位恭候别人。","source":{"text":"公子从车骑，虚左，自迎夷门侯生。","book":"《史记·魏公子列传》"},"example":{"text":"诸贵客见公子亲往迎客，～，正不知甚处有名的处士，何方大国的使臣，俱办下一片敬心侍候。","book":"明·冯梦龙《东周列国志》第九十四回"},"similar":["虚位以待"],"usage":"作谓语；同“虚位以待”","story":["战国时期，魏国信陵君魏无忌十分爱才好客，对天下能人贤士十分敬仰。他听说夷门监侯嬴见多识广，是个气节很高的隐士，就亲自赶马车去请他。侯嬴毫不客气上车，路上碰到熟人朱亥，故意冷落信陵君，而信陵君谦虚地把左面尊位留给他"]},{"id":39328,"word":"虚左相待","pinyin":"xū zuǒ xiāng dài","abbr":"xzxd","explanation":"虚：空着；左：古代以左为尊；待：等待。空着尊位恭候别人","source":{"text":"素闻老先生品位崇高，学问醇正，敬以参谋之位，虚左相待。","book":"清·李绿园《歧路灯》第九回"},"similar":["虚左以待"],"usage":"作谓语、定语；用于处事"},{"id":39329,"word":"虚己以听","pinyin":"xū jǐ yǐ tīng","abbr":"xjyt","explanation":"形容接受意见的态度诚恳。","source":{"text":"君子盛德而卑，虚己以受人。","book":"汉·韩婴《韩诗外传》第二卷"},"example":{"text":"这位主管工作踏实，对于属下所反映的意见，都能～。"},"similar":["虚己受人"],"usage":"作谓语、定语；用于处事"},{"id":39330,"word":"虚己受人","pinyin":"xū jǐ shòu rén","abbr":"xjsr","explanation":"虚心接受他人的意见。","source":{"text":"君子盛德而卑，虚己以受人。","book":"汉·韩婴《韩诗外传》卷二"},"similar":["虚己以听"],"usage":"作谓语、定语；用于处事"},{"id":39331,"word":"虚席以待","pinyin":"xū xí yǐ dài","abbr":"xxyd","explanation":"空着位置等待。","source":{"text":"桌上摆着精致的餐具虚席以待，使人穿堂而过时有一种昼夜不分的懒洋洋的感觉。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"不可滥竽充数，宁可～。"},"similar":["虚位以待"],"usage":"作谓语；指留着位置恭候"},{"id":39332,"word":"虚幻无实","pinyin":"xū huàn wú shí","abbr":"xhws","explanation":"虚幻：虚假。虚假不真实","source":{"text":"观诸世间，虽其可爱，而虚幻无实，终非我有。","book":"宋·苏轼《书金光明经后》"},"usage":"作谓语、定语；用于书面语"},{"id":39333,"word":"虚应故事","pinyin":"xū yìng gù shì","abbr":"xygs","explanation":"故事：旧日的事例。照例应付，敷衍了事。指用敷衍的态度对待工作。","source":{"text":"比年朋邪扇焰，缄默成风，奏事者不过袭陈言应故事而已。","book":"《宋史·刘黻传》"},"example":{"text":"他既自己情愿，你们代我著实重打，若再～，定要狗命。","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["敷衍了事"],"usage":"作谓语、定语；指敷衍了事"},{"id":39334,"word":"虚废词说","pinyin":"xū fèi cí shuō","abbr":"xfcs","explanation":"空费精神白说话。指说话不起作用。","source":{"text":"刘使君与孙将军自来无旧，恐虚废词说。","book":"明·罗贯中《三国演义》第四十二回"}},{"id":39335,"word":"虚度光阴","pinyin":"xū dù guāng yīn","abbr":"xdgy","explanation":"时光白白地度过。指没有好好地利用时间。","source":{"text":"也应自有寻春日，虚度而今正少年。","book":"唐·元稹《羡醉》"},"example":{"text":"我虽然帮不上您什么忙，但是每次谈一谈翻译，就觉得在这里的生活也是充实的，没有～……（霍达《穆斯林的葬礼》第十章）"}},{"id":39336,"word":"虚度年华","pinyin":"xū dù nián huá","abbr":"xdnh","explanation":"虚：没有收获、成就。白白地度过年岁。","source":{"text":"他认为：古今一切有成就的人，都很严肃地对待自己的生命，不虚度年华。","book":"《忆邓拓·邓拓与人民日报》"},"example":{"text":"年轻人不能～。"},"similar":["年华虚度","虚度光阴"],"opposite":["分秒必争","自强不息","孜孜不倦"],"usage":"作谓语、宾语、定语；指浪费光阴"},{"id":39337,"word":"虚庭一步","pinyin":"xū tíng yī bù","abbr":"xtyb","explanation":"庭：庭院；一步：来回走动。在空旷的庭院中徘徊","source":{"text":"你看月色过墙，照的槐影迷离，不免虚庭一步。","book":"清·孔尚任《桃花扇·会狱》"},"usage":"作宾语、定语；用于书面语"},{"id":39338,"word":"虚延岁月","pinyin":"xū yán suì yuè","abbr":"xysy","explanation":"虚：空，白白地；延：拖延。白白地拖延时间","source":{"text":"我有秘书，便守事之，庶有异闻，而虚延岁月，妨资弃力，卒无所成。","book":"晋·葛洪《抱朴子·勤求》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":39339,"word":"虚张声势","pinyin":"xū zhāng shēng shì","abbr":"xzss","explanation":"张：铺张，夸大。假装出强大的气势。指假造声势，借以吓人。","source":{"text":"淄青、恒冀两道，与蔡州气类略同，今闻讨伐元济，人情必有救助之意，然皆暗弱，自保无暇，虚张声势，则必有之。","book":"唐·韩愈《论淮西事宜状》"},"example":{"text":"都只是～，止不过故意穷忙。","book":"明·冯惟敏《不伏老》第一折"},"similar":["虚晃一枪"],"opposite":["不动声色"],"usage":"作谓语、宾语、定语；指造势"},{"id":39340,"word":"虚张形势","pinyin":"xū zhāng xíng shì","abbr":"xzxs","explanation":"张：铺张，夸大。假装出强大的气势。指假造声势，借以吓人。","source":{"text":"淄青、恒冀两道，与蔡州气类略同，今闻讨伐元济，人情必有救助之意，然皆暗弱，自保无暇，虚张声势，则必有之。","book":"唐·韩愈《论淮西事宜状》"},"example":{"text":"请以大军当其冲，～以疑贼。","book":"宋·晁补之《上皇帝安南罪言》"}},{"id":39341,"word":"虚往实归","pinyin":"xū wǎng shí guī","abbr":"xwsg","explanation":"无所知而往，有所得而归。","source":{"text":"鲁有兀者王骀，从之游者，与仲尼相若。常季问于仲尼曰：‘王骀，兀者也，从之游者，与夫子中分鲁。立不教，坐不议。虚而往，实而归。","book":"战国·宋·庄周《庄子·德充符》"},"example":{"text":"昉乐人之乐，忧人之忧，～，忘贫去吝。","book":"《南史·任昉传》"},"usage":"作谓语、定语；用于书面语"},{"id":39342,"word":"虚心冷气","pinyin":"xū xīn lěng qì","abbr":"xxlq","explanation":"虚：虚假；冷：不热情。心虚胆怯、低三下四的样子。也指虚伪做作，假装殷勤","source":{"text":"娘使尽虚心冷气，女着些带耍连真，总饶你便通天彻地的郎君，也不够三朝五日遭瘟。","book":"元·石德玉《曲江池》第二折"},"example":{"text":"明·施耐庵《水浒传》第45回：“那和尚～，动问道：‘大郎贵乡何处，高姓大名？’”"},"usage":"作宾语、定语、状语；用于处事"},{"id":39343,"word":"虚心平意","pinyin":"xū xīn píng yì","abbr":"xxpy","explanation":"平：宁静。心意空舒宁静，如同说心平气和","source":{"text":"安徐而静，柔节先定，虚心平意以待须。","book":"春秋·齐·管仲《管子·九守》"},"example":{"text":"《鬼谷子·符言》：“善与而不静，～，以待倾损。”"},"similar":["心平气和","虚气平心"],"usage":"作谓语、状语；用于书面语"},{"id":39344,"word":"虚怀若谷","pinyin":"xū huái ruò gǔ","abbr":"xhrg","explanation":"虚：谦虚；谷：山谷。胸怀象山谷一样深广。形容十分谦虚，能容纳别人的意见。","source":{"text":"敦兮其若朴，旷兮其若谷。","book":"《老子》"},"example":{"text":"每个人都应有～的态度，遇事不固执己见。"},"similar":["谦虚谨慎","大智若愚"],"opposite":["自高自大","目空一切"],"usage":"作谓语、宾语、状语；指人很谦虚"},{"id":39345,"word":"虚情假套","pinyin":"xū qíng jiǎ tào","abbr":"xqjt","explanation":"虚：假。装着对人热情，不是真心实意。","source":{"text":"叹世情，其实可笑，交朋友，尽都是虚情假套。","book":"明·朱载堉《山坡羊·交情可叹》"}},{"id":39346,"word":"虚情假意","pinyin":"xū qíng jiǎ yì","abbr":"xqjy","explanation":"虚：假。装着对人热情，不是真心实意。","source":{"text":"那妖精巧语花言，虚情假意的答道：‘主公，微臣自幼儿好习弓马，采猎为生。’","book":"明·吴承恩《西游记》第三十回"},"example":{"text":"在我是～，你听了一样的难过。","book":"清·曾朴《孽海花》第三十一回"},"similar":["假仁假义","装腔作势"],"opposite":["深情厚意","真心实意"],"usage":"作宾语、定语、状语；指虚假的情意"},{"id":39347,"word":"虚惊一场","pinyin":"xū jīng yī cháng","abbr":"xjyc","explanation":"指事后才知道是不必要的惊慌。","source":{"text":"我坚信我会被稠密的气流托住，托不住也会在坠落过程中倏地醒来，在床上虚惊一场。","book":"王朔《痴人》"},"example":{"text":"我们发现原来是～。"},"similar":["一场虚惊"],"usage":"作宾语；指事后才知道是不必要的惊慌"},{"id":39348,"word":"虚推古人","pinyin":"xū tuī gǔ rén","abbr":"xtgr","explanation":"虚：凭空。凭空推崇古人","source":{"text":"此臣以俯信偏识，不虚推古人者也。","book":"南朝·齐·祖冲之《辩戴法兴难新历》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":39349,"word":"虚掷光阴","pinyin":"xū zhì guāng yīn","abbr":"xzgy","explanation":"虚掷：白白地扔掉。把时光白白地扔掉。形容虚度岁月","source":{"text":"您有这般智力，当此乱离之世，不从事弓刀间立着功名，取那富贵，怎不枉了一生？虚掷光阴，真是可惜！","book":"宋·无名氏《新编五代史平话·周史》"},"similar":["蹉跎岁月"],"usage":"作谓语、宾语、定语；用于处事"},{"id":39350,"word":"虚掷年华","pinyin":"xū zhì nián huá","abbr":"xznh","explanation":"虚掷：白白地抛掉；年华：岁月，时光。形容无所作为，白白地浪费时光。","source":{"text":"老去淡生涯，虚掷年华。腊茶盂子太清些，待得痴儿公事毕，谢了梅花。","book":"宋·刘克庄《浪淘沙》词"}},{"id":39351,"word":"虚文浮礼","pinyin":"xū wén fú lǐ","abbr":"xwfl","explanation":"没有意义的，表面应酬的礼数。","example":{"text":"我们不要那些～。"},"similar":["虚文缛礼"],"usage":"作主语、宾语、定语；指表面应酬的礼数"},{"id":39352,"word":"虚文缛礼","pinyin":"xū wén rù lǐ","abbr":"xwrl","explanation":"文：旧指礼节、仪式；缛：繁重。繁琐、不切实际的的礼节或仪式。也比喻繁琐且不必要的手续。","source":{"text":"议者必又曰：省去繁文末节，则一岁可以再郊。","book":"宋·苏轼《上圆丘合祭六议》"},"example":{"text":"盖英伦尔时，虚伪满于社会，以～为真道德，有秉自由思想而探究者，世辄谓之恶人。","book":"鲁迅《坟·摩罗诗力说》"},"similar":["虚文缛节"],"usage":"作宾语、定语；用于处事等"},{"id":39353,"word":"虚文缛节","pinyin":"xū wén rù jié","abbr":"xwrj","explanation":"文、节：旧指礼节、仪式；缛：繁重。繁琐、不切实际的的礼节或仪式。也比喻繁琐且不必要的手续。","source":{"text":"议者必又曰：省去繁文末节，则一岁可以再郊。","book":"宋·苏轼《上圆丘合祭六议》"},"example":{"text":"社会既厌三纲压抑～之俗，而未能研究新道德以代之，是理想风俗上过渡时代也。","book":"清·梁启超《过渡时代论》"},"similar":["虚文缛礼"],"usage":"作宾语、定语；用于处事等"},{"id":39354,"word":"虚无恬淡","pinyin":"xū wú tián dàn","abbr":"xwtd","explanation":"指虚静而无所企慕。","source":{"text":"虚无恬淡，乃合天德。","book":"《庄子·刻意》"},"example":{"text":"郭沫若《屈原研究·屈原身世及其作品》：“他虽是南人，而于道家的～，寂寞无为的学说却毫没有沾染。”"},"usage":"作宾语、定语；用于书面语"},{"id":39355,"word":"虚无缥渺","pinyin":"xū wú piāo miǎo","abbr":"xwpm","explanation":"虚无：虚幻不实。若有若无的样子。形容空虚渺茫，不可捉摸","source":{"text":"明知总在前途的，却常觉得有些虚无缥渺似的。","book":"朱自清《桨声灯影里的秦淮河》"},"similar":["虚无缥缈"],"usage":"作谓语、定语；指虚幻的东西"},{"id":39356,"word":"虚无缥缈","pinyin":"xū wú piāo miǎo","abbr":"xwpm","explanation":"虚无：空虚；缥缈：隐隐约约，若有若无的样子。形容空虚渺茫。","source":{"text":"忽闻海上有仙山，山在虚无缥缈间。","book":"唐·白居易《长恨歌》"},"example":{"text":"这都是～的事，那里有甚么神仙鬼怪！我却向来不信这个。","book":"清·吴趼人《二十年目睹之怪现状》第二十五回"},"similar":["扑朔迷离","虚无缥渺"],"opposite":["坚定不移"],"usage":"作谓语、定语；指虚幻的东西"},{"id":39357,"word":"虚无飘渺","pinyin":"xū wú piāo miǎo","abbr":"xwpm","explanation":"形容若有若无，空虚渺茫。","example":{"text":"人要到月亮上去，以前认为是～的想法，而现在则是确实可行的事实。"}},{"id":39358,"word":"虚晃一枪","pinyin":"xiù huàng yī qiāng","abbr":"xhyq","explanation":"形容佯作进攻，以便退却。","source":{"text":"栾廷玉抵当不住，虚晃一枪，败阵而走。","book":"清·陈忱《水浒后传》第三回"},"example":{"text":"我军却～。即向西北方向金沙江边挺进。","book":"刘伯承《回顾长征》"},"usage":"作谓语、宾语、定语；指用计"},{"id":39359,"word":"虚有其表","pinyin":"xū yǒu qí biǎo","abbr":"xyqb","explanation":"虚：空；表：表面，外貌。空有好看的外表，实际上不行。指有名无实。","source":{"text":"嵩既成，上掷其草于地，曰：‘虚有其表耳。’","book":"唐·郑处诲《明皇杂录》"},"example":{"text":"表面看上去他挺精明的，可实际上却是～，什么事也办不好。"},"similar":["徒有虚名","秀而不实","有名无实"],"opposite":["货真价实","名副其实","名不虚传"],"usage":"作谓语、定语；指没有真才实学","story":["唐玄宗很器重工部侍郎苏廷硕，因为他为人正直而又很有学问，便命英俊潇洒的萧嵩起草任命苏廷硕为宰相的诏书。唐玄宗让萧嵩将“国之宝”改动一下避苏廷硕父亲苏之的名讳，萧嵩不敢乱改，气得唐玄宗骂萧嵩真是虚有其表"]},{"id":39360,"word":"虚构无端","pinyin":"xu gou wu duan","abbr":"xgwd","explanation":"假造没有根据的事。"},{"id":39361,"word":"虚枯吹生","pinyin":"xū kū chuī shēng","abbr":"xkcs","explanation":"虚：同“嘘”，呼气。把枯的吹活，活的吹枯。形容口才极好。","source":{"text":"孔公绪清谈高论，嘘枯吹生，并无军旅之才，执锐之干。","book":"《后汉书·郑太传》"}},{"id":39362,"word":"虚比浮词","pinyin":"xū bǐ fú cí","abbr":"xbfc","explanation":"虚比：虚拟的比方。泛泛地讲空话。","source":{"text":"虽看过，那不过是勉人自励，虚比浮词，那里都真有的？","book":"清·曹雪芹《红楼梦》第五十六回"},"usage":"作宾语、定语；用于书面语"},{"id":39363,"word":"虚气平心","pinyin":"xū qì píng xīn","abbr":"xqpx","explanation":"虚：通“舒”。心平气和","source":{"text":"虚气平心，乃至怒喜。","book":"春秋·齐·管仲《管子·版法解》"},"similar":["心平气和"],"usage":"作定语、状语；用于书面语"},{"id":39364,"word":"虚生浪死","pinyin":"xū shēng làng sǐ","abbr":"xsls","explanation":"虚：徒然；浪：随便。活得没有意义，死得没有价值。","source":{"text":"不可虚生浪死，取笑于后代。","book":"《旧唐书·越王贞传》"},"example":{"text":"明·李贽《寄焦弱侯书》：“性又狷介，不能会于无方之道，真～之徒耳。”"},"usage":"作谓语、定语；用于处世等"},{"id":39365,"word":"虚美熏心","pinyin":"xū měi xūn xīn","abbr":"xmxx","explanation":"虚：虚假；熏心：迷了心窍。被美好的假象所迷惑","source":{"text":"虚美薰心，实祸蔽塞。","book":"汉·路温舒《尚德缓刑书》"},"usage":"作宾语、定语；用于书面语"},{"id":39366,"word":"虚美薰心","pinyin":"xū měi xūn xīn","abbr":"xmxx","explanation":"虚：虚假；薰心：迷了心窍。指被表面上的美好假象所迷惑。","source":{"text":"虚美薰心，实祸蔽塞。","book":"汉·路温舒《尚德缓刑书》"}},{"id":39367,"word":"虚美隐恶","pinyin":"xū měi yǐn è","abbr":"xmye","explanation":"虚：空；隐：隐蔽。用凭空的赞美来掩盖其过错","source":{"text":"敬宗又纳其宝货，称孝泰频破贼，斩获数万，汉将骁健者，唯苏定方与庞孝素耳，曹继权、刘伯英皆出其下。虚美隐恶如此。","book":"《旧唐书·许敬宗传》"},"example":{"text":"宋·王应麟《困学纪闻·考史》：“愚谓子显以齐宗室，仕于梁而作齐史，～，其能直笔乎？”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":39368,"word":"虚而不淈","pinyin":"xū ér bù gǔ","abbr":"xebg","explanation":"淈：穷竭。原比喻天地为风箱，愈空虚愈不穷竭，愈推拉愈多排风。多比喻愈虚心求知，知识就越丰富。","source":{"text":"天地之间，其犹橐籥与？虚而不淈，动而愈出。多闻数穷，不若守于中。","book":"《老子》第五章"},"usage":"作谓语、定语；用于书面语"},{"id":39369,"word":"虚而虚之","pinyin":"xū ér xū zhī","abbr":"xexz","explanation":"虚：空虚。力量虚弱而故意表现虚弱，使敌人反误以为强大","source":{"text":"虚而虚之，使敌人转疑以我为实。","book":"《草庐经略·虚实》"},"usage":"作宾语、定语；用于处事策略等"},{"id":39370,"word":"虚脾假意","pinyin":"xū pí jiǎ yì","abbr":"xpjy","explanation":"虚：假。装着对人热情，不是真心实意。","source":{"text":"员外，你休将此话来认真，那做子弟的虚脾假意，你听我说。","book":"明·周藩宪王《三工小桃红》第一折"}},{"id":39371,"word":"虚舟飘瓦","pinyin":"xū zhōu piāo wǎ","abbr":"xzpw","explanation":"比喻没有实用价值的东西。","source":{"text":"方船济乎江，有虚船从一方来，触而覆之，虽有忮心者，必无怨色。","book":"西汉·刘安《淮南子·诠言训》"},"example":{"text":"饥不可食，寒不可衣，看他似～。","book":"明·汤显祖《牡丹亭·谒遇》"},"usage":"作主语、宾语、定语；指不实用的东西"},{"id":39372,"word":"虚船触舟","pinyin":"xū chuán chù zhōu","abbr":"xccz","explanation":"没有载人的空船碰撞了别人的船，虽是气量小的人也不会生气。比喻虚心可以远祸。","source":{"text":"方舟而济于河，有虚船来触舟，虽有偏心之人不怒。……向也不怒而今也怒，向也虚而今也实；人能虚己以游世，其孰能害之？","book":"《庄子·山木》"},"usage":"作宾语、定语；用于比喻句"},{"id":39373,"word":"虚虚实实","pinyin":"xū xū shí shí","abbr":"xxss","explanation":"假假真真，以假乱真。指军事上讲究策略，善于迷惑对方。也指文艺作品中虚写、实写并用，表现方法耐人思索回味。","source":{"text":"岂不闻兵法‘虚虚实实’之论？操虽能用兵，只此可以瞒过他也。","book":"明·罗贯中《三国演义》第四十九回"},"example":{"text":"此诗～，何能逆料就是才女。","book":"清·李汝珍《镜花缘》第九十回"},"similar":["真真假假"],"opposite":["诚实可靠"],"usage":"作宾语、定语；指真真假假"},{"id":39374,"word":"虚誉欺人","pinyin":"xū yù qī rén","abbr":"xyqr","explanation":"誉：声誉，名誉。用虚假的声誉欺骗人。","source":{"text":"非比夸辩之徒，虚誉欺人。","book":"明·罗贯中《三国演义》第43回"},"usage":"作谓语；指欺骗人"},{"id":39375,"word":"虚论浮谈","pinyin":"xū lùn fú tán","abbr":"xlft","explanation":"虚饰的言论，浮夸的语言。指大话、空话。","source":{"text":"又有虚论浮谈，谗言轻议，虽辅弼之士，亦不取焉。","book":"宋·刘颜《辅弼名对序》"}},{"id":39376,"word":"虚论高议","pinyin":"xū lùn gāo yì","abbr":"xlgy","explanation":"不切实际，高妙空洞的议论。亦作“高谈虚论”。","source":{"text":"博闻辩辞，虚论高议以为容美，穷居静处而诽时俗，此奸人也。","book":"《六韬·上贤》"},"similar":["高谈虚辞","高谈虚论","虚谈高论"],"usage":"作谓语、宾语、定语；用于谈话等"},{"id":39377,"word":"虚词诡说","pinyin":"xū cí guǐ shuō","abbr":"xcgs","explanation":"虚：虚假；诡：欺诈。虚假不实的话。","source":{"text":"相如虽多虚词滥说，然其要归引之节俭，此与《诗》之风谏何异。","book":"《史记·司马相如列传》"},"example":{"text":"玉自生逾期，数访音信。～，日日不同。","book":"唐·蒋防《霍小玉传》"},"usage":"作主语、宾语、定语；指虚假不实的话"},{"id":39378,"word":"虚语高论","pinyin":"xū yǔ gāo lùn","abbr":"xygl","explanation":"虚：空虚。高妙空洞，不切实际的议论。","source":{"text":"不图大事得利，而动以高谈虚论说于人主，王者慎勿使。","book":"《六韬·文韬·上贤》"}},{"id":39379,"word":"虚谈高论","pinyin":"xū tán gāo lùn","abbr":"xtgl","explanation":"高：高超；虚：空。空洞、不切实际的言论。","source":{"text":"齐土之民，风俗浅薄，虚谈高论，专在荣利。","book":"北魏·杨衒之《洛阳伽蓝记·秦太上君寺》"},"similar":["高谈虚论","高谈虚辞","虚论高议"],"usage":"作谓语、宾语、定语；用于谈话等"},{"id":39380,"word":"虚费词说","pinyin":"xū fèi cí shuō","abbr":"xfcs","explanation":"空费精神白说话。指说话不起作用。","source":{"text":"刘使君与孙将军自来无旧，恐虚费词说。","book":"明·罗贯中《三国演义》第四十二回"},"similar":["白费口舌"],"usage":"作谓语、定语、宾语；指白费口舌"},{"id":39381,"word":"虚骄恃气","pinyin":"xiù jiāo shì qì","abbr":"xjsq","explanation":"虚骄：虚浮而骄矜；恃气：凭着意气。虚浮骄矜，意气用事。","source":{"text":"纪渻子为王养斗鸡，十日而问鸡已乎。曰：‘未也，方虚骄而恃气。’","book":"《庄子·达生》"},"example":{"text":"夫所恶于～者，以其果敢而窒，如醉人之勇，俟其既醒，必怯懦而不可复作也。","book":"严复《原强续篇》"},"usage":"作谓语、定语；指意气用事","story":["西周时纪渻子专门为宣王养斗鸡，宣王一再催问纪渻子养的斗鸡如何样了？10天后，纪渻子说：“还没有养成，才虚骄而恃气。”40天过后，纪渻子养的斗鸡像一只木头做的，不惊不动，别的鸡见它都吓跑了，这只鸡天下无敌"]},{"id":39382,"word":"虞褚欧颜","pinyin":"yú chǔ ōu yán","abbr":"ycoy","explanation":"虞世南、褚遂良、欧阳询、颜真卿，古代四位书法家。泛指楷书的各种流派。","source":{"text":"北海的字，与虞褚欧颜同出羲、献之门，惟各各变化，独立一格。","book":"陆士谔《续孽海花》第39回"},"usage":"作主语、宾语、定语；指楷书的流派"},{"id":39383,"word":"虫书鸟篆","pinyin":"chóng shū niǎo zhuàn","abbr":"csnz","explanation":"书：字体。字体像鸟虫。借指外国文字。","source":{"text":"巡捕传进一个洋式片子来，上面写着虫书鸟篆，说有位洋老爷拜会大人。","book":"清·李宝嘉《文明小史》第50回"},"usage":"作宾语、定语；用于文字等"},{"id":39384,"word":"虫沙猿鹤","pinyin":"chóng shā yuán hè","abbr":"csyh","explanation":"旧时比喻战死的将士。也指死于战乱的人。","source":{"text":"周穆王南征，一军尽化，君子为猿为鹤，小从为虫为沙。","book":"《太平御览》卷九一六引《抱朴子》"},"example":{"text":"穆昔南征军不归，～伏似飞。","book":"唐·韩愈《送区弘南归诗》"},"similar":["猿鹤虫沙"],"usage":"作宾语、定语；比喻战场上战死的将士"},{"id":39385,"word":"虫臂拒辙","pinyin":"chóng bì jù zhé","abbr":"cbjz","explanation":"拒：抵抗；辙：车轮痕迹，指车。比喻以小敌大，力量悬殊。","source":{"text":"虫臂拒辙，鸡肋承拳，万万相殊，破之必矣。","book":"唐·元稹《授牛元翼深冀州节度使制》"},"similar":["螳臂当车"],"usage":"作宾语、定语；指力量悬殊"},{"id":39386,"word":"虫臂鼠肝","pinyin":"chóng bì shǔ gān","abbr":"cbsg","explanation":"比喻极微小而无价值的东西。","source":{"text":"以汝为汝肝乎？以汝为虫臂乎？","book":"《庄子·大宗师》"},"example":{"text":"鼠肝虫臂万化途，神奇腐朽相推迁。","book":"金·元好问《食榆荚》诗"},"opposite":["和璧隋珠"],"usage":"作宾语、定语；比喻微不足道的东西"},{"id":39387,"word":"虫鱼之学","pinyin":"chóng yù zhī xué","abbr":"cyzx","explanation":"指繁琐的考据订正。","source":{"text":"《尔雅》注虫鱼，定非磊落人。","book":"唐·韩愈《读皇甫湜公安园池诗书其后》诗"},"usage":"作宾语；指繁琐的考据订正之学"},{"id":39388,"word":"虫鸣螽跃","pinyin":"chóng míng zhōng yuè","abbr":"cmzy","explanation":"螽：螽斯，昆虫名。草虫鸣叫螽斯跳。","source":{"text":"喓喓草虫，趯趯阜螽。","book":"《诗经·召南·草虫》"},"example":{"text":"楚润云兴，～。","book":"《旧唐书·太宗纪论》"},"usage":"作宾语、定语；指自然规律"},{"id":39389,"word":"虮虱相吊","pinyin":"jǐ shī xiēng diào","abbr":"jsxd","explanation":"虮：虱的幼卵；吊：慰问。虮和虱相互怜悯。比喻自怜即将灭亡。","source":{"text":"汤沐具而虮虱相吊，大厦成而燕雀相贺。","book":"汉·刘安《淮南子·说林训》"},"usage":"作宾语、定语；用于比喻句"},{"id":39390,"word":"虱处头而黑","pinyin":"shī chǔ tóu ér hēi","abbr":"scteh","explanation":"处：停留。虱子本来是白色，躲在人头发里就变成黑色。比喻随着环境而变化。","source":{"text":"虱处头而黑，麝食柏而香。","book":"三国·魏·嵇康《养生论》"}},{"id":39391,"word":"虱处裈中","pinyin":"shī chǔ kūn zhōng","abbr":"sckz","explanation":"裈：裤子。虱子躲在裤缝里。比喻世俗生活的拘窘局促。","source":{"text":"汝独不见夫虱之处于裈之中乎！逃于深缝，匿乎坏絮，自以为吉宅。","book":"晋·阮籍《大人先生传》"},"usage":"作宾语；指生活窘态"},{"id":39392,"word":"虱处裻中","pinyin":"shī chǔ kūn zhōng","abbr":"sckz","explanation":"裻裤子。虱子躲在裤缝里。比喻世俗生活的拘窘局促。","source":{"text":"汝独不见夫虱之处于裻之中乎！逃于深缝，匿乎坏絮，自以为吉宅。","book":"晋·阮籍《大人先生传》"}},{"id":39393,"word":"虱多不痒","pinyin":"shī duō bù yǎng","abbr":"sdby","explanation":"债欠多了反而不忧愁。比喻困难成堆，认为反正一时解除不了，也就不去愁它了。","example":{"text":"我现在是～，无所谓了。"},"similar":["债多不愁","死猪不怕开水烫"],"usage":"作谓语、定语；指困难成堆"},{"id":39394,"word":"虱胫虮肝","pinyin":"shī jìng jī gān","abbr":"sjjg","explanation":"虱子的小腿，虮子的肝脏。比喻非常微小的东西。","source":{"text":"烹虱胫，切虮肝，会九族而同噬，犹委余而不殚。","book":"战国楚·宋玉《小言赋》"},"usage":"作宾语、定语；指细小的东西"},{"id":39395,"word":"虹销雨霁","pinyin":"hóng xiāo yǔ jì","abbr":"hxyj","explanation":"虹：彩虹；销：同“消”，消失；霁：本指雨止，也引申为天气放睛。彩虹消失，雨后天睛。","source":{"text":"虹销雨霁，彩彻云衢，落霞与孤鹜齐飞，秋水共长天一色。","book":"唐·王勃《滕王阁序》"},"usage":"作谓语、定语；用于天气"},{"id":39396,"word":"虹霓吐颖","pinyin":"hóng ní tǔ yǐng","abbr":"hnty","explanation":"吐气成虹霓。形容有丰富的诗文才华。","example":{"text":"李白是一个～的大诗人。"},"usage":"作定语；用于书面语"},{"id":39397,"word":"虽休勿休","pinyin":"suī xiū wù xiū","abbr":"sxwx","explanation":"休：赞美。意思是虽受称许而不要沾沾自喜。","source":{"text":"尔尚敬逆天命，以奉我一人，虽畏勿畏，虽休勿休。","book":"《尚书·吕刑》"},"usage":"作谓语、定语；用于书面语"},{"id":39398,"word":"虽多亦奚为","pinyin":"suī duō yì xī wéi","abbr":"sdyxw","explanation":"奚：何，什么；以：用；为：表疑问。虽然很多又有何用呢？常用于对于多而无当的反诘。","source":{"text":"诵诗三百，使于四方，不能专对，虽多亦奚以为？","book":"《论语·子路》"},"example":{"text":"群桔少生意，～？","book":"唐·杜甫《病桔》"}},{"id":39399,"word":"虽多亦奚以为","pinyin":"suī duō yì xī yǐ wéi","abbr":"sdyxyw","explanation":"奚：何，什么；以：用；为：表疑问。虽然很多又有何用呢？常用于对于多而无当的反诘。","source":{"text":"诵诗三百，使于四方，不能专对，虽多亦奚以为？","book":"《论语·子路》"},"example":{"text":"否则才夸八斗，胸号五车，为文仅称点鬼之谈，著书惟供覆瓿之用，～？","book":"清·李渔《闲情偶寄·词曲部》"}},{"id":39400,"word":"虽有搞暴","pinyin":"shui you gao pu","abbr":"sygb","explanation":"即使因干枯而变形。"},{"id":39401,"word":"虽死之日，犹生之年","pinyin":"suī sǐ zhī rì，yóu shēng zhī nián","abbr":"sszryszn","explanation":"犹：如同。指人虽死，精神不灭，楷模犹存。也指心无牵挂、憾事，虽死犹同活着。","source":{"text":"先公为汉忠臣，虽死之日，犹生之年。","book":"晋·常璩《汉中士女志·文姬》"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“惟求皇上简发重兵，迅图扫荡，则臣等～。”"},"similar":["虽死犹生"],"usage":"作宾语、定语；用于书面语"},{"id":39402,"word":"虽死无悔","pinyin":"suī sǐ wú huǐ","abbr":"sswh","explanation":"虽然为之而死，也决不后悔。","source":{"text":"但臣为国之心，虽死无悔。","book":"战国·楚·屈原《离骚》：“亦余心之所善兮，虽九死其犹未悔。”宋·李昉《太平广记》卷一百七十六"},"example":{"text":"浚岂不知废置生杀，二公得专之，盖其心自处已定，之～。","book":"清·毕沅《续资治通鉴》卷一百十四"}},{"id":39403,"word":"虽死犹生","pinyin":"suī sǐ yóu shēng","abbr":"ssys","explanation":"犹：如同。指人虽死，精神不灭，楷模犹存。也指心无牵挂、憾事，虽死犹同活着。","source":{"text":"先公为汉忠臣，虽死之日，犹生之年。","book":"晋·常璩《汉中士女志·文姬》"},"example":{"text":"至曾晢、晏子，身为贤士，名传不朽，其人～。","book":"清·李汝珍《镜花缘》第四十六回"},"similar":["死得其所"],"usage":"作谓语；指死得有价值","story":["北魏孝文帝元宏的弟弟，咸阳王元禧积极配合孝文帝的改革，加强与汉人的联系，受元宏的遗诏辅佐少主元恪。元禧渐渐居功自傲，图谋反叛，阴谋败露，只好带着尹龙虎出逃。尹龙虎愿意与他共患难，认为为他去死是虽死犹生"]},{"id":39404,"word":"虽死犹荣","pinyin":"suī sǐ yóu róng","abbr":"ssyr","explanation":"人虽然死了，但死得光荣。","example":{"text":"她～，死得其所。"},"similar":["死得其所"],"usage":"作谓语；指死得其所"},{"id":39405,"word":"虽畏勿畏，虽休勿休","pinyin":"suī wèi wù wèi，suī xiū wù xiū","abbr":"swwwsxwx","explanation":"畏：佩服，敬畏；勿：不要；休：赞美。虽然受到尊敬，但不要自认为可尊敬，虽受到称许，但不要认为可赞美。","source":{"text":"尔尚敬逆天命，以奉我一人，虽畏勿畏，虽休勿休。","book":"《尚书·吕刑》"}},{"id":39406,"word":"虽覆能复","pinyin":"suī fù néng fù","abbr":"sfnf","explanation":"覆：翻倒；复：复原。虽然已经翻倒，但还能复原。后也指反复无常的手段。","source":{"text":"可引而反，可引而覆。虽覆能覆，不失其度。","book":"《鬼谷子·飞箝》"},"example":{"text":"“～”很有些可怕。但这一种手段，我们在社会上是时常遇见的。","book":"鲁迅《补白·二》"},"usage":"作宾语、定语；用于处事"},{"id":39407,"word":"虾兵蟹将","pinyin":"xiā bīng xiè jiàng","abbr":"xbxj","explanation":"古代神怪小说里海龙王手下的兵将。比喻敌人的爪牙或不中用的大小娄罗。","source":{"text":"乃率领鼋帅虾兵蟹将，统帅党类，一齐奔出潮头。","book":"明·冯梦龙《警世通言》卷四十"},"example":{"text":"汪精卫和他的～已在公开讨论“和平”。","book":"邹韬奋《抗战以来·“来宾”放炮》"},"similar":["残兵败将"],"opposite":["爪牙之将"],"usage":"作主语、宾语、定语；指不中用的大小娄罗"},{"id":39408,"word":"虾忙蟹乱","pinyin":"xiā máng xiè luàn","abbr":"xmxl","explanation":"指虾蟹成灾，将稻谷荡尽。旧因以为兵乱的征兆。现多形容乱作一团。","source":{"text":"吴俗有虾荒蟹乱之语，盖取其被甲执锐，岁或暴至，则乡人用以为兵证也。","book":"宋·傅肱《蟹谱·兵证》"}},{"id":39409,"word":"虾荒蟹乱","pinyin":"xiā huāng xiè luàn","abbr":"xhxl","explanation":"指虾蟹成灾，将稻谷荡尽。旧因以为兵乱的征兆。","source":{"text":"吴俗有虾荒蟹乱之语，盖取其被甲执锐，岁或暴至，则乡人用以为兵证也。","book":"宋·傅肱《蟹谱·兵证》"},"similar":["蟹荒蟹乱"],"usage":"作定语、状语；用于比喻句"},{"id":39410,"word":"蚀本生意","pinyin":"shí běn shēng yì","abbr":"sbsy","explanation":"赔本的买卖。","source":{"text":"如果有什么蠢人，不知此理，拒绝睡觉，他明天就没有精神了，这是蚀本生意。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["亏本生意","亏本买卖"],"usage":"作宾语、定语；用于商业等"},{"id":39411,"word":"蚁封盘马","pinyin":"yǐ fēng pán mǎ","abbr":"yfpm","explanation":"蚁封：蚂蚁洞外隆起的小土堆；盘马：驰马盘旋。比喻在很小的天地里施展才能。","source":{"text":"湛曰：‘今直行车路，何以别马胜不？唯当就蚁封耳！’于是就蚁封盘马，果倒踣，其俊识天才乃尔。","book":"晋·邓粲《晋纪》"},"example":{"text":"垆下三年世路穷，～竟难工。千山虽隔日连梦，犹到平阳池馆中。","book":"宋·范成大《次韵徐子礼提举莺花亭》诗"}},{"id":39412,"word":"蚁封穴雨","pinyin":"yǐ fēng xué yǔ","abbr":"yfxy","explanation":"蚂蚁聚土洞口，是要下大雨的征兆。","source":{"text":"蚁封户穴，大雨将集。","book":"汉·焦延寿《易林》卷十三"},"usage":"作宾语、定语；指下雨的征兆"},{"id":39413,"word":"蚁拥蜂攒","pinyin":"yǐ yōng fēng cuán","abbr":"yyfc","explanation":"比喻集结者众多。同“蚁萃螽集”。","source":{"text":"乡民蚁拥蜂攒，布满山麓，约有十余万众。","book":"《三元里人民抗英斗争史料·广东军务记》"},"similar":["蚁聚蜂攒","蚁集蜂攒","蚁附蜂屯"],"usage":"作谓语、定语；用于人多的场合"},{"id":39414,"word":"蚁斗蜗争","pinyin":"yǐ dòu wō zhēng","abbr":"ydwz","explanation":"比喻微末的争斗。","source":{"text":"蚁斗蜗争求予没，老夫身世自难裁。","book":"宋·刘克庄《和仲弟》之四"},"usage":"作宾语、定语；用于比喻句"},{"id":39415,"word":"蚁旋磨","pinyin":"yǐ xuán mò","abbr":"yxm","explanation":"像蚂蚁跟着磨盘运转一样。比喻人一生一世奔波劳碌，仍摆脱不了自然规律的支配。","source":{"text":"一丝不挂鱼脱渊，万古同归蚁旋磨。","book":"汉·扬雄《法言义疏》卷十三：“譬之于蚁行磨石之上，磨左旋而蚁右去，磨疾而蚁迟，故不得不随磨以左回焉。”宋·黄庭坚《僧景宣相访寄法王航禅师》诗"},"example":{"text":"羁孤猿失群，往复～。","book":"宋·胡仔《苕溪渔隐丛话前集》卷十三"}},{"id":39416,"word":"蚁溃鼠骇","pinyin":"yǐ kuì shǔ hài","abbr":"yksh","explanation":"形容敌军惊骇溃逃。","source":{"text":"左师出于剑门，大攘顽嚚，谕引劫胁，蚁溃鼠骇，险无以固，收夺利地，以须王师。","book":"唐·柳宗元《剑门铭序》"},"usage":"作宾语、定语；用于书面语"},{"id":39417,"word":"蚁穴坏堤","pinyin":"yǐ xué huài dī","abbr":"yxhd","explanation":"比喻小事不注意，就会出大乱子。同“蚁穴溃堤”。","source":{"text":"蛇螫断腕，蚁穴坏堤，史臣之所以俯仰三汉者也。","book":"清·钱谦益《向言下》之五"},"similar":["蚁穴溃堤"],"usage":"作宾语、定语；用于劝诫人"},{"id":39418,"word":"蚁穴溃堤","pinyin":"yǐ xué kuì dī","abbr":"yxkd","explanation":"小小的蚂蚁窝，能够使堤岸溃决。比喻小事不注意，就会出大乱子。","source":{"text":"千丈之堤，以蝼蚁之穴溃；百尺之室，以突隙之烟焚。","book":"战国·韩·韩非《韩非子·喻老》"},"example":{"text":"～，衅不在大。","book":"清·康有为《上清帝第五书》"},"similar":["蚁穴坏堤"],"usage":"作宾语、定语；用于劝诫人","story":["战国时期，魏国相国白圭在防洪方面很有成绩，他善于筑堤防洪，并勤查勤补，经常巡视，一发现小洞即使是极小的蚂蚁洞也立即派人填补，不让它漏水，以免小洞逐渐扩大、决口，造成大灾害。白圭任魏相期间，魏国没有闹过水灾"]},{"id":39419,"word":"蚁穴自封","pinyin":"yǐ xué zì fēng","abbr":"yxzf","explanation":"比喻以区区之地方自主独立。","source":{"text":"且明置缅甸宣慰司，表内未称宣旧衔；又有蚁穴自封，夜郎天外之言。","book":"清·照槤《啸亭杂录·缅甸归诚本末》"},"usage":"作宾语、定语；用于比喻句"},{"id":39420,"word":"蚁聚蜂屯","pinyin":"yǐ jù fēng tún","abbr":"yjft","explanation":"屯：聚集。像蚂蚁、螽斯一般集聚。比喻集结者之众多。","source":{"text":"蚁聚蜂屯已入城，持矛瞋目呼狂贼。","book":"清·吴伟业《雁门尚书行》"},"example":{"text":"夫自东汉以迄于明，其间学士词人，～，不可计数。","book":"清·戴均衡《重刻〈方望溪先生全集〉序》"},"similar":["蜂屯蚁聚"],"usage":"作谓语、定语；用于人多的场合"},{"id":39421,"word":"蚁聚蜂攒","pinyin":"yǐ jù fēng cuán","abbr":"yjfc","explanation":"像蚂蚁、螽斯一般集聚。比喻集结者之众多。","source":{"text":"蚁聚蜂攒，穷诛不尽。马足毛群，难与竞逐。","book":"南朝·齐·孔稚珪《上和虏表》"},"similar":["蚁聚蜂屯","蚁集蜂攒","蚁附蜂屯"],"usage":"作宾语、状语；用于书面语"},{"id":39422,"word":"蚁膻鼠腐","pinyin":"yǐ shān shǔ fǔ","abbr":"yssf","explanation":"蚂蚁喜欢吃腥膻的食物，老鼠喜欢吃腐败的食物。比喻趣味低下","source":{"text":"其高者则激昂于文章气节之域，而其下者则遂沉酣濡首于蚁膻鼠腐之间。","book":"明·唐顺之《寄高上尚书》"},"usage":"作宾语、定语；用于书面语"},{"id":39423,"word":"蚁萃螽集","pinyin":"yǐ cuì zhōng jí","abbr":"yczj","explanation":"像蚂蚁、螽斯一般集聚。比喻集结者之众多。","source":{"text":"羯寇遗丑，趋致畿甸，蚁萃螽集，闻以崩殪。","book":"《宋书·袁淑传》"},"similar":["蜂屯蚁聚","蚁附蜂屯"],"usage":"作宾语、定语；用于比喻句"},{"id":39424,"word":"蚁阵蜂衙","pinyin":"yǐ zhèn fēng yá","abbr":"yzfy","explanation":"衙：排列成行的事物；蜂衙：蜂成群结队。比喻人们追逐名利，像蚂蚁群集，蜂拥而至，不知疲倦。","source":{"text":"看蚁阵蜂衙，虎争龙斗，燕去鸿来，兔走鸟飞。","book":"元·马致远《陈抟高卧》第三折"},"example":{"text":"山间林下，伴药炉经卷老生涯，眼不见车尘马足，梦不到～。","book":"元·王子一《误入桃源》第一折"}},{"id":39425,"word":"蚁附蜂屯","pinyin":"yǐ fù fēng tún","abbr":"yfft","explanation":"像蚂蚁、螽斯一般集聚。比喻集结者之众多。","source":{"text":"一旦有急，则蚁附蜂屯，授之以扞格不操之利器，曳兵而走，转以奉敌。","book":"严复《原强》"},"similar":["蚁聚蜂攒","蚁集蜂攒","蚁拥蜂攒"],"usage":"作宾语、状语；用于书面语"},{"id":39426,"word":"蚁附蝇趋","pinyin":"yǐ fù yíng qū","abbr":"yfyq","explanation":"如蚁附膻，如蝇逐臭。指攀附奉承别人。","example":{"text":"为人不能学～一样实际。"},"similar":["蝇趋蚁附"],"usage":"作宾语、定语；用于为人"},{"id":39427,"word":"蚁附蝇集","pinyin":"yǐ fù yíng jí","abbr":"yfyj","explanation":"形容趋附者之多。","source":{"text":"山人辈作队趋之，随军转徙，无不称季馨词宗先生，蚁附蝇集，去而复来。","book":"明·沈德符《野获编·兵部·武臣好文》"},"usage":"作宾语、状语；用于比喻句"},{"id":39428,"word":"蚁集蜂攒","pinyin":"yǐ jí fēng cuán","abbr":"yjfc","explanation":"像蚂蚁、螽斯一般集聚。比喻集结者之众多。","source":{"text":"栝寇复兴，蚁集蜂攒，众号数万，遂陷婺之永康。","book":"明·宋濓《赠行军镇抚迈里古思平寇诗序》"},"similar":["蚁附蜂屯","蚁聚蜂攒","蚁拥蜂攒"],"usage":"作谓语、定语；用于人多的场合"},{"id":39429,"word":"蚁鼻之缺","pinyin":"yǐ bí zhī quē","abbr":"ybzq","explanation":"像蚂蚁鼻子那样小的缺陷。比喻微不足道的缺点。","source":{"text":"此所谓以分寸之瑕，弃盈尺之夜光，以蚁鼻之缺，捐无价之淳钧，非荆和之远识，风胡之赏真也。","book":"《抱朴子·论仙》"}},{"id":39430,"word":"蚂蚁啃骨头","pinyin":"mǎ yǐ kěn gǔ tóu","abbr":"mykgt","explanation":"比喻一点一点地苦干以完成一项很大的任务。","source":{"text":"当你看见他们像蚂蚁啃骨头似的，把一座座大山啃掉。","book":"路遥《平凡的世界》第二卷第32章"},"example":{"text":"我们不要怕困难，要学～去克服它。"},"usage":"作宾语、定语；指实干才能出成绩"},{"id":39431,"word":"蚂蚁搬泰山","pinyin":"mǎ yǐ bān tài shān","abbr":"mybts","explanation":"比喻人多力量大，可以创造奇迹。用作贬义指人自不量力。","example":{"text":"我们学习上要有～的精神。"},"usage":"作宾语、定语；指人自不量力"},{"id":39432,"word":"蚂蚁缘槐","pinyin":"mǎ yǐ yuán huái","abbr":"myyh","explanation":"缘：沿，顺着。蚂蚁沿着槐树上下爬。比喻自以为了不起。","source":{"text":"唐·李公佐《南柯太守传》载：一个名叫淳于棼的人梦见自己当了大槐安国的南柯太守，一时好不威风。醒来方知是一场大梦，所谓大槐安国不过是老槐树下的蚂蚁窝。"},"example":{"text":"～夸大国，蚍蜉撼树谈何易。","book":"毛泽东《满江红·和郭沫若同志》"},"usage":"作宾语、定语；指自大","story":["传说唐朝东平郡“游侠之士”淳于棼在他家南面的古老大槐树下睡了一觉，梦中他成了槐安国的南柯太守，国王把小公主嫁给他，为官20年，生活十分幸福。后来因檀罗国进攻南柯郡，他防守不力被国王逐出槐安国，梦醒见槐安国原来是槐树下的一个蚂蚁洞"]},{"id":39433,"word":"蚊力负山","pinyin":"wén lì fù shān","abbr":"wlfs","explanation":"以蚊虫的力量能背山。比喻力虽小却身负重任。","source":{"text":"其与治天下也，犹涉海凿河，而使蚊负山也。","book":"战国·宋·庄周《庄子·应帝王》"},"example":{"text":"今何幸大慰所怀，不揣～，遂以一人独肩斯任。","book":"清·陈梦雷《上诚亲王汇编启》"},"similar":["使蚊负山","蚊虻负山"],"usage":"作宾语、定语；指力小负重"},{"id":39434,"word":"蚊思负山","pinyin":"wén sī fù shān","abbr":"wsfs","explanation":"负：担负。比喻力量虽微却愿担负重任。","source":{"text":"予不自揣，蚊思负山，欲取郦注从而疏之。","book":"清·刘献廷《广阳杂记》第四卷"},"similar":["蚊虻负山"],"usage":"作宾语、定语；指力小负重"},{"id":39435,"word":"蚊虻负山","pinyin":"wén méng fù shān","abbr":"wmfs","explanation":"蚊虻：吸血的昆虫。以蚊虫的力量能背山。比喻力弱者担重任，难以信任。","source":{"text":"蚊虻：吸血的昆虫。以蚊虫的力量能背山。比喻力弱者担重任，难以信任。"},"example":{"text":"望使必信，是令～，是井蟆论海也。","book":"晋·葛洪《抱朴子·论仙》"},"similar":["蚊力负山"],"usage":"作宾语、定语；指力小负重"},{"id":39436,"word":"蚊虻过耳","pinyin":"wén méng guò ěr","abbr":"wmge","explanation":"蚊虻：吸血的昆虫。比喻倏然已过，不足挂怀。","source":{"text":"世故纷纭，但蚊虻过耳。","book":"宋·张孝祥《醉蓬莱·为老人寿》词"},"usage":"作宾语、定语；用于比喻句"},{"id":39437,"word":"蚌病成珠","pinyin":"bàng bìng chéng zhū","abbr":"bbcz","explanation":"比喻因不得志而写出好文章来。","source":{"text":"明月之珠，蚌之病而我之利。","book":"《淮南子·说林训》"},"example":{"text":"敬通雅好辞说，而坎壈盛世，显志自序，亦～。” （南朝·梁·刘勰《文心雕龙·才略》）"},"similar":["蚌病生珠"],"usage":"作定语、宾语；指读书人不得志"},{"id":39438,"word":"蚌病生珠","pinyin":"bàng bìng shēng zhū","abbr":"bbsz","explanation":"比喻因不得志而写出好文章来。同“蚌病成珠”。","source":{"text":"嗟哉蚌病乃生珠，诗渐可读消雄图。","book":"高燮《题蔡哲夫所绘沈孝则即步哲夫韵》"},"example":{"text":"～，才能写出好文章来。"},"similar":["蚌病成珠"],"usage":"作谓语、宾语；指读书人不得志"},{"id":39439,"word":"蚌鹬争衡","pinyin":"bàng yù zhēng héng","abbr":"byzh","explanation":"蚌张开壳晒太阳，鹬去啄它，嘴被蚌壳夹住，两方都不相让。渔翁来后把两个都捉住。比喻双方争执两败俱伤，便宜第三者。","source":{"text":"蚌鹬争衡，鱼龙曼衍，离奇变幻之局，孰有甚于近三十年者。","book":"蔡寅《变鸦楼三十年诗征序》"},"example":{"text":"我们都明白～谁都是受害者。"},"similar":["蚌鹬相持"],"usage":"作宾语、定语；指两者相争"},{"id":39440,"word":"蚌鹬相持","pinyin":"bàng yù xiāng chí","abbr":"byxc","explanation":"比喻双方相争，两败俱伤，徒使第三者得利。","source":{"text":"今者臣来，过易水，蚌方出曝，而鹬啄其肉，蚌合而钳其喙。鹬曰：‘今日不雨，明日不雨，即有死蚌。’蚌亦谓鹬曰：‘今日不出，明日不出，即有死鹬。’两者不肯相舍，渔翁得而并禽之。","book":"《战国策·燕策二》"},"example":{"text":"天方厌羌，内难屡起，权臣擅事，～。","book":"宋·秦观《边防中》"},"similar":["鹬蚌相持"],"opposite":["相辅相成"],"usage":"作宾语、定语；指两者相争","story":["战国时期赵国准备攻打燕国，燕王派苏代去赵国游说赵王不要战争，讲述一只河蚌在岸上夹住一只鹬鸟的长嘴，双方争执不让，最后被一个渔翁轻易擒住。如果燕赵发生战争，秦国就像渔翁那样轻易吞并燕赵。赵王只好放弃战争的打算"]},{"id":39441,"word":"蚍蜉戴盆","pinyin":"pí fú dài pén","abbr":"pfdp","explanation":"比喻能力低而承担的任务极重。也比喻不自量力。","source":{"text":"蚍蜉戴盆，不能上山。","book":"汉·焦延寿《易林》卷十三"},"similar":["蚍蜉撼树","力不能及","力所不能"],"opposite":["力所能及"],"usage":"作宾语、定语；比喻力不胜任"},{"id":39442,"word":"蚍蜉撼大木","pinyin":"pí fú hàn dà mù","abbr":"pfhdm","explanation":"撼：摇动。蚂蚁想摇动大树。比喻不自量力。","source":{"text":"蚍蜉撼大木，多见不知量也。","book":"宋·赵与时《宾退录》第二卷"},"similar":["蚍蜉撼大树"],"usage":"作宾语、定语；指不自量力"},{"id":39443,"word":"蚍蜉撼大树","pinyin":"pí fú hàn dà shù","abbr":"pfhds","explanation":"撼：摇动。蚂蚁想摇动大树。比喻不自量力。","source":{"text":"蚍蜉撼大树，可笑不自量。","book":"唐·韩愈《昌黎先生集·调张籍》"},"example":{"text":"真可谓‘小人不欲成人之美’而且‘～，可笑不自量’了！","book":"鲁迅《且介亭杂文末编·关于太炎先生二三事》"},"similar":["蚍蜉撼树"],"usage":"作宾语、定语；指不自量力","story":["唐朝时期，李白、杜甫刚去世不久，就有人对这两位诗人的作品妄加诋毁，韩愈对此很不满意，就写给好友《调张籍》一诗：“李杜文章在，光焰万丈长，不知群儿愚，那用故谤伤，蚍蜉撼大树，可笑不自量。”得到张籍的赞同"]},{"id":39444,"word":"蚍蜉撼树","pinyin":"pí fú hàn shù","abbr":"pfhs","explanation":"蚂蚁想摇动大树。比喻自不量力。","source":{"text":"蚍蜉撼大树，可笑不自量。","book":"唐·韩愈《调张籍》诗"},"example":{"text":"蚂蚁缘槐夸大国，～谈何易。","book":"毛泽东《满江红·和郭沫若同志》"},"similar":["自不量力","螳臂当车"],"opposite":["量力而行"],"usage":"作主语、谓语、宾语；指不自量力","story":["唐朝时期，李白、杜甫刚去世不久，就有人对这两位诗人的作品妄加诋毁，韩愈对此很不满意，就写给好友《调张籍》一诗：“李杜文章在，光焰万丈长，不知群儿愚，那用故谤伤，蚍蜉撼大树，可笑不自量。”得到张籍的赞同"]},{"id":39445,"word":"蚓窍蝇鸣","pinyin":"yǐn qiào yíng míng","abbr":"yqym","explanation":"从蚯蚓孔发出像苍蝇一样的嗡嗡叫声。比喻声响微不足道。也比喻没有多大的才能。","source":{"text":"时于蚯蚓窍，微作苍蝇鸣。","book":"唐·轩辕弥明《石鼎联句》"},"example":{"text":"文章之事，岂可假人！～，庶不自珍？","book":"清·黄宗羲《作文三戒·戒应酬之文》"}},{"id":39446,"word":"蚕丛鸟道","pinyin":"cán cóng niǎo dào","abbr":"ccnd","explanation":"指险绝的山路。","source":{"text":"开其蚕丛鸟道，通其百工技巧。","book":"清·戴名世《纪红苗事》"},"example":{"text":"这～十分难行。"},"similar":["羊肠小道"],"opposite":["康庄大道"],"usage":"作主语、宾语、定语；指险绝的山路"},{"id":39447,"word":"蚕丝牛毛","pinyin":"cán sī niú máo","abbr":"csnm","explanation":"比喻多而细密。","source":{"text":"苟于孝道有阙，则虽分析经义如蚕丝牛毛，徒召辱耳。","book":"明·宋濂《答郡守聘五经师书》"},"usage":"作宾语、定语；用于细密的事物"},{"id":39448,"word":"蚕头燕尾","pinyin":"cán tóu yàn wěi","abbr":"ctyw","explanation":"形容书法起笔凝重，结笔轻疾。","source":{"text":"宋·赵佶《宣和画谱·颜真卿》“惟其忠贯白日，识高天下，故精神见于翰墨之表者，特立而兼括。……后之俗学，乃求其形似之末，以谓蚕头燕尾，仅乃得之。”"},"usage":"作宾语、定语；用于书法"},{"id":39449,"word":"蚕绩蟹匡","pinyin":"cán jì xiè kuāng","abbr":"cjxk","explanation":"匡：背壳。比喻名是实非，两不相干。","source":{"text":"成人有其兄死而不为衰者，闻子皋将为成宰，遂为衰。成人曰：‘蚕则绩而蟹有匡，范则冠而蝉有緌；兄则死而子皋为之衰。’","book":"西汉·戴圣《礼记·檀弓下》"},"example":{"text":"其时为邑宰者，～，著有成效。","book":"清·郑观应《盛世危言》"},"similar":["名不副实","牵强附会"],"usage":"作宾语、定语；指名不副实"},{"id":39450,"word":"蚕食鲸吞","pinyin":"cán shí jīng tūn","abbr":"csjt","explanation":"象蚕吃桑叶那样一步步侵占，象鲸吞食那样一下子吞并。比喻用各种方式侵占吞并别国的领土。","source":{"text":"诸侯可蚕食而尽，赵氏可得与敌矣。","book":"《韩非子·存韩》"},"example":{"text":"在乾隆时代，英吉利灭东印度，据孟加刺，渐肆其～手段，兼并那东、中、南三印度之地。","book":"清·彭养鸥《黑籍冤魂》第二回"},"similar":["鲸吞虎据"],"usage":"作谓语、定语；比喻一点一点被吞食"},{"id":39451,"word":"蚤朝晏退","pinyin":"sāo cháo yàn tuì","abbr":"zcyt","explanation":"朝：上朝；晏：晚。清早去上朝，很晚才结束。形容古代一些帝王勤于政事。","source":{"text":"王公大人蚤朝晏退，听狱治政，此其分事也。","book":"《墨子·非乐上》"},"example":{"text":"～的官员很少了"},"similar":["早朝晏罢"],"usage":"作谓语、定语；用于书面语"},{"id":39452,"word":"蚩蚩者民","pinyin":"chī chī zhě mín","abbr":"cczm","explanation":"蚩蚩：无知。无知无识的人民。旧时统治阶级蔑视人民的说法。","source":{"text":"氓之蚩蚩，抱布贸丝。","book":"《诗经·卫风·氓》"},"example":{"text":"～，就有绝对服从的义务。","book":"邹韬奋《抗战以来·老爷与老百姓的不平等论》"},"usage":"作宾语、定语；用于蔑视的口吻"},{"id":39453,"word":"蚩蚩蠢蠢","pinyin":"chī chī chǔn chǔn","abbr":"cccc","explanation":"蚩：痴呆，愚蠢。指愚笨蠢动的样子。","example":{"text":"经过这次严重的打击，他变得～了。"},"similar":["痴呆笨拙"],"usage":"作定语、状语；用于人笨拙"},{"id":39454,"word":"蛇入筒中曲性在","pinyin":"shé rù tǒng zhōng qū xìng zài","abbr":"srtzqxz","explanation":"比喻本性难改。","source":{"text":"譬如蛇行，本性好曲，若入竹筒则直，出筒还曲。","book":"《大智度论》卷九十二"}},{"id":39455,"word":"蛇入鼠出","pinyin":"shé rù shǔ chū","abbr":"srsc","explanation":"比喻行动隐秘。","source":{"text":"于是深怒积怨，退而治兵，蛇入鼠出，不可端倪。","book":"严复《原强续篇》"},"usage":"作宾语、定语；用于比喻句"},{"id":39456,"word":"蛇化为龙，不变其文","pinyin":"shé huà wéi lóng，bù biàn qí wén","abbr":"shwlbbqw","explanation":"比喻无论形式上怎样变化，实质还是一样。","source":{"text":"蛇化为龙，不变其文；家化为国，不变其姓。","book":"《史记·外戚世家》"},"similar":["万变不离其宗"],"usage":"作分句、宾语；指万变不离其宗"},{"id":39457,"word":"蛇口蜂针","pinyin":"shé kǒu fēng zhēn","abbr":"skfz","explanation":"比喻恶毒的言词和手段。","example":{"text":"他是一个～的人。"},"usage":"作宾语、定语；指人的心肠狠毒"},{"id":39458,"word":"蛇头蝎尾","pinyin":"shé tóu xiē wěi","abbr":"stxw","explanation":"指蛇蝎之毒。蛇之毒在牙咬，蝎螫毒在尾刺，故称。亦泛指毒害人的东西。","source":{"text":"暂时上天少问天，蛇头蝎尾谁安著。","book":"唐·卢仝《忆金鹅山沈山人》诗之一"},"example":{"text":"～不相同，毒杀人多始是功。","book":"宋·邵雍《感事吟》"},"usage":"作宾语、定语；用于比喻句"},{"id":39459,"word":"蛇头鼠眼","pinyin":"shé tóu shǔ yǎn","abbr":"stsy","explanation":"形容人的面相丑恶，心术不正。亦作“蛇眉鼠眼”。","source":{"text":"忽听见门声一响，早有一个蛇头鼠眼，满脸胡须，又矮又胖的丑汉子走进来。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"example":{"text":"周炳再转回平记门口，探头往里仔细一看，果然见李民魁和一个～的人在喝酒。","book":"欧阳山《三家巷》十六"},"usage":"作定语、状语；用于比喻句"},{"id":39460,"word":"蛇影杯弓","pinyin":"shé yǐng bēi gōng","abbr":"sybg","explanation":"把酒杯中的弓影当成了蛇。比喻因疑神疑鬼而自惊自怕。","source":{"text":"时北壁上有悬赤弩照于杯，形如蛇。宣畏恶之，然不敢不饮。","book":"汉·应劭《风俗通义·世间多有见怪》"},"example":{"text":"人亡物在公子填词，～颦卿绝粒。","book":"清·曹雪芹《红楼梦》第八十九回"},"similar":["杯弓蛇影","蛇杯弓影"],"usage":"作宾语、定语；指自相惊扰","story":["传说古代有个人叫杜宣，一次在人家中饮酒，见杯中好像有一条蛇，酒后胸腹作痛，多方医治始终不见好。朋友询问他为什么会这样？他把那天的情形说了一遍。朋友笑着告诉他那是墙上的箭影而已，他也大笑一声，病不治而愈"]},{"id":39461,"word":"蛇心佛口","pinyin":"shé xīn fó kǒu","abbr":"sxfk","explanation":"佛的嘴巴，蛇的心肠。比喻话虽说得好听，心肠却极狠毒。","source":{"text":"诸佛出世，打劫杀人，祖师西来，吹风放火，古今善知识佛口蛇心，天下衲僧自投笼槛。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"王魁你恶狠狠～，我便到黄泉，也须把你这歹魂儿勾，定与我倒断了前番呪。","book":"明·王玉峰《焚香记·构祸》"},"similar":["佛口蛇心"],"usage":"作宾语、补语、定语；比喻嘴甜心毒"},{"id":39462,"word":"蛇无头不行","pinyin":"shé wú tóu bù xíng","abbr":"swtbx","explanation":"比喻做事没有领头的就办不成。","source":{"text":"若得杀了杨景一个，虽有二十四个指挥使，所谓蛇无头而不行，也就不怕他了。","book":"《敦煌变文集·李陵变文》：“虵（蛇）无头不行，鸟无翼不飏。”元·无名氏《谢金吾》楔子"},"example":{"text":"二二两两，逃入山间，相聚为盗。‘蛇无头而下行’，就有个草头天子出来，此人姓范名汝为，仗义执言，救民水人。","book":"明·冯梦龙《警世通言》第十二卷"},"usage":"作宾语、定语；用于口语"},{"id":39463,"word":"蛇无头而不行，鸟无翅而不飞","pinyin":"shé wú tóu ér bù xíng，niǎo wú chì ér bù fēi","abbr":"swtebxnwcebf","explanation":"比喻失去主导或羽翼，就办不成事情了。","source":{"text":"当晚二更时分，天色微明，十五个头领，都在寨中纳闷，正是蛇无头而不行，鸟无翅而不飞，嗟咨叹惜，进退无措。","book":"明·施耐庵《水浒全传》第六十回"},"example":{"text":"那城里一个小妖儿也没有了，正是～。他见佛祖收了妖王，各自逃生而去。","book":"明·吴承恩《西游记》第七十七回"}},{"id":39464,"word":"蛇杯弓影","pinyin":"shé bēi gōng yǐng","abbr":"sbgy","explanation":"比喻因疑神疑鬼而自惊自怕。同“蛇影杯弓”。","source":{"text":"况蛇杯弓影，恍惚无凭。","book":"清·纪昀《阅微草堂笔记·如是我闻四》"},"similar":["蛇影杯弓","杯弓蛇影"],"usage":"作宾语、定语；比喻把虚幻误作真实"},{"id":39465,"word":"蛇欲吞象","pinyin":"shé yù tūn xiàng","abbr":"sytx","explanation":"蛇想吞下大象。比喻贪欲极大。","source":{"text":"一蛇吞象，厥大何如？","book":"《山海经·海内南经》：“巴蛇食象，三岁而出其骨。”战国楚·屈原《天问》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“美恶不称，谓之狗尾续貂；贪图不足，谓之～。”"},"usage":"作宾语、定语；用于比喻句"},{"id":39466,"word":"蛇毛马角","pinyin":"shé máo mǎ jiǎo","abbr":"smmj","explanation":"蛇生毛，马出角，世界上不可能存在的的事物。因以指有名无实。","source":{"text":"国家者如机关木人，有作用而无自性，如蛇毛马角，有名言而非实存。","book":"章炳麟《五无论》"},"similar":["马角乌白"],"usage":"作宾语、定语；比喻不能实现之事"},{"id":39467,"word":"蛇灰蚓线","pinyin":"shé huī yǐn xiàn","abbr":"shyx","explanation":"比喻有相应的线索可循。","source":{"text":"词亦文之一体。昔人名作，亦有理脉可寻。所谓蛇灰蚓线之妙。","book":"况周颐《蕙风词话》卷二"},"usage":"作宾语、定语；用于书面语"},{"id":39468,"word":"蛇珠雀环","pinyin":"shé zhū què huán","abbr":"szqh","explanation":"指大蛇衔明珠、黄雀衔白环报恩的故事。同“蛇雀之报”。","source":{"text":"小人之说不止蛇珠雀环之可笑也。","book":"明·田艺蘅《留青日札·方正学蛇报之妄》"},"similar":["蛇雀之报"],"usage":"作宾语、定语；用于比喻句","story":["传说隋侯外出时，看见一条大蛇受伤从中间断开，他给蛇上药救了蛇一命。第二年大蛇衔一颗明珠来报答他。杨宝幼年时，看见一只黄雀被猫头鹰击伤，杨宝将黄雀带回家疗伤，伤好后就飞走了。第二天有一个黄衣童子拿四枚白玉环来报答他"]},{"id":39469,"word":"蛇盘鬼附","pinyin":"shé pán guǐ fù","abbr":"spgf","explanation":"比喻相互色结。","source":{"text":"呜呼！自昔权奸将有的不利于忠勋之臣，则必内置腹心，外张羽翼，蛇盘鬼附，相与无间，而后得以逞焉。","book":"明·郎瑛《七修类稿·诗文五·诗文论于肃愍是非》"},"similar":["蛇蟠蚓结"],"usage":"作定语、状语；用于比喻句"},{"id":39470,"word":"蛇眉鼠眼","pinyin":"shé méi shǔ yǎn","abbr":"smsy","explanation":"形容人的长相丑恶，心术不正。","source":{"text":"包公见他兔耳莺腮，蛇眉鼠眼，已知是不良之辈。","book":"清·石玉昆《三侠五义》第三十九回"}},{"id":39471,"word":"蛇神牛鬼","pinyin":"shé shén niú guǐ","abbr":"ssng","explanation":"牛头的鬼，蛇身的神。形容作品虚幻怪诞。比喻形形色色的坏人。","source":{"text":"楚俗纷纷竟淫祀，蛇神牛鬼争媕婀。","book":"清·李必恒《谒浮山禹次昌黎石鼓韵作歌》"},"similar":["牛鬼蛇神"],"usage":"作主语、宾语、定语；指坏人"},{"id":39472,"word":"蛇蚓蟠结","pinyin":"shé yǐn pán jié","abbr":"sypj","explanation":"蛇蚓：蛇和蚯蚓；蟠结：盘曲纠结的样子。比喻草书笔划曲屈。","source":{"text":"晴窗洗矶丛，蛇蚓稍蟠结。","book":"宋·苏轼《孙莘老寄墨四首》"}},{"id":39473,"word":"蛇蝎为心","pinyin":"shé xiē wéi xīn","abbr":"sxwx","explanation":"蝎：一种蜘蛛类的毒虫。形容心肠狠毒。","source":{"text":"便是蛇蝎心肠，不似恁般毒害。","book":"元·无名氏《抱妆盒》第二折"}},{"id":39474,"word":"蛇蝎心肠","pinyin":"shé xiē xīn cháng","abbr":"sxxc","explanation":"蝎：一种蜘蛛类的毒虫。形容心肠狠毒。","source":{"text":"便是蛇蝎心肠，不似恁般毒害。","book":"元·无名氏《抱妆盒》第二折"},"similar":["狼心狗肺"],"opposite":["菩萨心肠"],"usage":"作宾语、定语；指心肠狠毒"},{"id":39475,"word":"蛇螫断腕","pinyin":"shé shì duàn wàn","abbr":"ssdw","explanation":"比喻小害能坏大事。","source":{"text":"蛇螫断腕，蚁穴坏堤，史臣之所以俯仰三叹者也。","book":"清·钱谦益《向言下》之五"},"usage":"作宾语、定语；用于比喻句"},{"id":39476,"word":"蛇蟠蚓结","pinyin":"shé pán yǐn jié","abbr":"spyj","explanation":"比喻相互勾结。","source":{"text":"当是时，章惇、蔡确、黄履、邢恕等蛇蟠蚓结，牢不可解。","book":"明·宋濂《题司马公手帖后》"},"similar":["蛇盘鬼附"],"usage":"作定语、状语；用于比喻句"},{"id":39477,"word":"蛇行斗折","pinyin":"shé xíng dǒu zhé","abbr":"sxdz","explanation":"斗：北斗星。像蛇那样蜿蜒爬行，像北斗星那样曲折。形容道路曲折蜿蜒。","source":{"text":"漂西南而望，斗折蛇行，明灭可见。","book":"唐·柳宗元《永州八记·小石潭记》"}},{"id":39478,"word":"蛇行鳞潜","pinyin":"shé xíng lín qián","abbr":"sxlq","explanation":"比喻行动极为谨慎隐蔽。","source":{"text":"刺客者，怀弹丸，淬匕首，蛇行鳞潜，如螳螂之捕蝉，恐其有警而飞翔。","book":"汪东《刺客者校军人论》"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":39479,"word":"蛇行鼠步","pinyin":"shé xíng shǔ bù","abbr":"sxsb","explanation":"形容胆小谨慎。","source":{"text":"虽小道亦有可观，但我见贤弟蛇行鼠步，鬼鬼马马，无文无气。","book":"清·新广东武生《黄萧养回头》"},"usage":"作宾语、定语；用于书面语"},{"id":39480,"word":"蛇雀之报","pinyin":"shé què zhī bào","abbr":"sqzb","explanation":"指大蛇衔明珠、黄雀衔白环报恩的故事。后以之为报恩的典故。","source":{"text":"据载：隋侯出行见大蛇被伤中断，以药封之，蛇乃能行，岁余，蛇衔明珠以报之，谓之隋侯珠、明月珠。另载：杨宝幼时见一黄雀为鸱枭所博，坠于树下，为蝼蚁所困，宝救之养百余日飞去，其夜有黄衣童子以白环四枚相报，并云当使其子孙洁白，位登三事，有如此环。"},"example":{"text":"曾不闻吐珠衔环，效～。","book":"宋·欧阳修《〈归田录〉序》"},"similar":["蛇珠雀环"],"usage":"作宾语；用于比喻句","story":["传说隋侯外出时，看见一条大蛇受伤从中间断开，他给蛇上药救了蛇一命。第二年大蛇衔一颗明珠来报答他。杨宝幼年时，看见一只黄雀被猫头鹰击伤，杨宝将黄雀带回家疗伤，伤好后就飞走了。第二天有一个黄衣童子拿四枚白玉环来报答他"]},{"id":39481,"word":"蛇食鲸吞","pinyin":"shé shí jīng tūn","abbr":"ssjt","explanation":"蛇食：像蛇一样吞食。鲸吞：像鲸一样吞咽。比喻强者逐步并吞弱者。","source":{"text":"天齐地轴之所，蛇食鲸吞；铜陵、玉垒之区，狼顾鸱跱。","book":"隋·薛道衡《老氏碑》"},"usage":"作宾语、定语；用于比喻句"},{"id":39482,"word":"蛇鼠横行","pinyin":"shé shǔ héng xíng","abbr":"sshx","explanation":"比喻恶人得势、胡作非为。","example":{"text":"在～的时候，是非颠倒。"},"similar":["豺狼当道"],"usage":"作宾语、定语；用于社会局势等"},{"id":39483,"word":"蛊惑人心","pinyin":"gǔ huò rén xīn","abbr":"ghrx","explanation":"蛊惑：迷惑。指用欺骗引诱等手段迷惑人，搞乱人的思想。","source":{"text":"诸阴阳家者流，辄为人燃灯祭星，蛊惑人心者，禁之。","book":"《元史·刑法志》"},"example":{"text":"却胆敢把这个反天逆地、阻碍进化、～的邪说谬论说将出来。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["造谣惑众","造谣中伤","蜚短流长"],"usage":"作谓语、定语、宾语；指迷惑人心"},{"id":39484,"word":"蛙蟆胜负","pinyin":"wā má shèng fù","abbr":"wmsf","explanation":"青蛙与蛤蟆斗争的胜负。比喻不足介意的荣哀得失。","source":{"text":"任蛙蟆胜负，鱼龙变化，侬方在，华胥国。","book":"宋·刘克庄《水龙吟·丙辰生日》词之二"},"example":{"text":"我从来不计较这些～。"},"similar":["鸡虫得失"],"usage":"作宾语；指微不足道的荣耀"},{"id":39485,"word":"蛙鸣狗吠","pinyin":"wā míng gǒu fèi","abbr":"wmgf","explanation":"吠：狗叫。青蛙鸣，狗汪汪叫。比喻浅陋拙劣的诗词及文章。","source":{"text":"此真铿金霏玉之音也。我向所厌薄者，大率皆蛙鸣狗吠耳。","book":"清·钮琇《觚剩·樵隐》"},"similar":["蛙鸣鸱叫"],"usage":"作宾语、定语；用于书面语"},{"id":39486,"word":"蛙鸣蚓叫","pinyin":"wā míng yǐn jiào","abbr":"wmyj","explanation":"蚓：蚯蚓。青蛙鸣，蚯蚓叫。比喻浅陋的识见或议论。","source":{"text":"小慧私智，不知大体，自安于蛙鸣蚓叫，君子亦无校也。","book":"清·章学诚《文史通义·书坊刻诗话后》"},"similar":["蛙鸣鸱叫"],"usage":"作宾语、定语；用于书面语"},{"id":39487,"word":"蛙鸣蝉噪","pinyin":"wā míng chán zào","abbr":"wmcz","explanation":"蛙声和蝉声，使人听了厌烦。比喻拙劣的议论或文章。","source":{"text":"蛙鸣蝉噪，魂绕神劳。","book":"明·顾大典《青衫记·裴兴私叹》"},"example":{"text":"我受不了这般～。"},"usage":"作谓语、宾语、定语；比喻众口喧闹"},{"id":39488,"word":"蛙鸣鸱叫","pinyin":"wā míng chī jiào","abbr":"wmcj","explanation":"鸱：鸱鸟。青蛙鸣，鸱鸟叫。比喻浅陋拙劣的文词。","source":{"text":"段文昌以骈四俪六蛙鸣鸱叫之音，易钧天之奏，真不识人间有廉耻事。","book":"韩愈《平淮西碑》清·储欣评"},"similar":["蛙鸣狗吠"],"usage":"作宾语、定语；用于书面语"},{"id":39489,"word":"蛙鸣鼓吹","pinyin":"wā míng gǔ chuī","abbr":"wmgc","explanation":"鼓吹：古时仪仗乐队的器乐合奏。两部器乐合奏。一般指蛙鸣。也用来形容悠闲舒适的天然形成的生活环境。","source":{"text":"门庭之内，草莱不剪，中有蛙鸣，或问之曰：‘欲为陈蕃乎？’稚珪笑曰：‘我以此当两部鼓吹，何必期效仲举。’","book":"《南齐书·孔稚珪传》"},"example":{"text":"万竿苦竹旌旗卷，一部～秋。","book":"宋·黄庭坚《次韵黄斌老晚游池亭》卷三十二"}},{"id":39490,"word":"蛛丝尘网","pinyin":"zhū sī chén wǎng","abbr":"zscw","explanation":"被蛛网所缠绕，被尘土所封盖。形容居室、器物等长期封存而无人动用。","source":{"text":"则为气昂昂误的我这鬓斑斑，久居在单瓢陋巷，风雪材关，穷不穷甑有蛛丝尘网乱。","book":"元·郑光祖《王粲登楼》第一折"},"similar":["蛛网尘埃"],"usage":"作宾语、定语；用于书面语"},{"id":39491,"word":"蛛丝虫迹","pinyin":"zhū sī chén jì","abbr":"zscj","explanation":"蜘蛛的丝和虫子爬过的痕迹。比喻事情所留下的隐约可寻的痕迹和线索。","source":{"text":"蛛丝虫迹，屋漏蝙涎，不即不离，有意无意，其妙如何。","book":"清·夏敬渠《野叟曝言》七十九回"},"similar":["蛛丝马迹","蛛丝鼠迹"],"usage":"作主语、宾语、状语；指线索"},{"id":39492,"word":"蛛丝马迹","pinyin":"zhū sī mǎ jì","abbr":"zsmj","explanation":"从挂下来的蜘蛛丝可以找到蜘蛛的所在，从马蹄的印子可以查出马的去向。比喻事情所留下的隐约可寻的痕迹和线索。","source":{"text":"大开通同转假之门，泛滥浩博，几凝天下无字不可通用，而实则蛛丝马迹，原原本本，具在古书。","book":"清·王家贲《别雅序》"},"example":{"text":"机敏的公安人员根据现场的～，很快找到了作案人的线索。"},"similar":["一望可知"],"opposite":["千丝万缕","千头万绪"],"usage":"作主语、宾语、状语；指线索"},{"id":39493,"word":"蛛丝鼠迹","pinyin":"zhū sī shǔ jì","abbr":"zssj","explanation":"蜘蛛的丝和老鼠留下的痕迹。比喻事情所留下的隐约可寻的痕迹和线索。","source":{"text":"七绝一诗，拖起婚姻，有蛛丝鼠迹之妙。","book":"清·夏敬渠《野叟曝言》第90回"},"example":{"text":"几案间，～，一竹笥贮朝服，一釜备炊爨，文卷书册数百束，此外都无一物。（陈廷敬《清端于公传》）"},"similar":["蛛丝马迹","蛛丝虫迹"],"usage":"作主语、宾语、状语；指线索"},{"id":39494,"word":"蛛游蜩化","pinyin":"zhū yóu tiáo huà","abbr":"zyth","explanation":"蜩：蝉。蛛的游网，蝉的蜕变。比喻技艺纯熟","source":{"text":"故或役心命志，如蛛游蜩化而不自知。","book":"明·李东阳《奕说》"},"usage":"作宾语、定语；用于比喻句"},{"id":39495,"word":"蛛网尘埃","pinyin":"zhū wǎng chén āi","abbr":"zwca","explanation":"被蛛网所缠绕，被尘土所封盖。形容居室、器物等长期封存而无人动用。","source":{"text":"余录其《浪淘沙》云：‘春到凤城中，游运方通，闲来指点过桥东。记得当时心醉处，蛛网尘封。’","book":"清·袁枚《随园诗话补遗》卷三"},"example":{"text":"在他那～的家里，什么值钱的东西也找不到"},"similar":["蛛丝尘网"],"usage":"作宾语、定语；用于书面语"},{"id":39496,"word":"蛛网尘封","pinyin":"zhū wǎng chén fēng","abbr":"zwcf","explanation":"形容居室、器物等长期封存而无人过问。","source":{"text":"余录其《浪淘沙》云：‘春到凤城中，游运方通，闲来指点过桥东。记得当时心醉处，蛛网尘封。’","book":"清·袁枚《随园诗话补遗》卷三"},"example":{"text":"其书本贮内府，康熙间因编官书，移置翰林院供参考，此后～无人过问者数十年。","book":"梁启超《论清代学者之辑佚书》"},"usage":"作宾语、定语；用于书面语"},{"id":39497,"word":"蛟龙失水","pinyin":"jiāo lóng shī shuǐ","abbr":"jlss","explanation":"蛟：传说的无角龙。蛟龙失掉了赖以生存的水。比喻英雄失去凭借。","source":{"text":"不可，蛟龙失水，蝼蚁足以制之。","book":"宋·司马光《资治通鉴·后唐庄宗同光二年》"},"opposite":["蛟龙得水"],"usage":"作宾语；指失势"},{"id":39498,"word":"蛟龙得云雨，终非池中物","pinyin":"jiāo lóng dé yún yǔ，zhōng fēi chí zhōng wù","abbr":"jldyyzfczw","explanation":"蛟龙：传说中的一种神龙。蛟龙得到云和雨，就会飞腾上天，终究不会呆在池中。比喻有才能的人一旦遇到机会，就会充分施展才华。","source":{"text":"刘备以枭在雄之姿，而有关羽、张飞熊虎之将，恐蛟龙得云雨，终非池中物也。","book":"《三国志·吴志·周瑜传》"}},{"id":39499,"word":"蛟龙得水","pinyin":"jiāo lóng dé shuǐ","abbr":"jlds","explanation":"传说蛟龙得水后就能兴云作雨飞腾升天。比喻有才能的人获得施展的机会。也比喻摆脱困境。","source":{"text":"人主待得民，而后成其威，故曰：蛟龙得水，而神可立也，虎豹得幽，而威可载也。","book":"《管子·形势》"},"example":{"text":"西伯夸官先饮宴，～离泥沙。","book":"明·许仲琳《封神演义》第二十回"},"similar":["如鱼得水","飞黄腾达","一鸣惊人"],"opposite":["怀才不遇","蛟龙失水"],"usage":"作主语、谓语、宾语、分句；指得势","story":["北魏时期，朝廷决定南征，急需将才，尚书李冲受命挑选将领，小官吏杨大眼要求率军出征。李冲认为他的资历不够，杨大眼当众表演自己捷走如飞，他的武艺高强征服了李冲，当即任命他为主帅，取得了很大的胜利，让他蛟龙得水"]},{"id":39500,"word":"蛟龙得雨","pinyin":"jiāo lóng dé yǔ","abbr":"jldy","explanation":"传说蛟龙得水后就能兴云作雨飞腾升天。比喻有才能的人获得施展的机会。也比喻摆脱困境。","source":{"text":"人主待得民，而后成其威，故曰：蛟龙得水，而神可立也，虎豹得幽，而威可载也。","book":"《管子·形势》"},"example":{"text":"～终须变，揽镜正华年。","book":"清·浴日生《海国英雄记·航海》"}},{"id":39501,"word":"蛟龙戏水","pinyin":"jiāo lóng xì shuǐ","abbr":"jlxs","explanation":"比喻刀枪棍棒等武器使得轻松自如，灵活多变。形容武艺精湛纯熟。","source":{"text":"饿虎扑食最伤人，蛟龙戏水能凶恶。","book":"明·吴承恩《西游记》第五十一回"},"usage":"作宾语、定语；用于比喻句"},{"id":39502,"word":"蛤蟆夜哭","pinyin":"há má yè kū","abbr":"hmyk","explanation":"蛤蟆于夜晚哭泣。形容毫无根据诬陷好人。","source":{"text":"复闻有言曰：‘吾今幸无尾，但恐更理会蝌蚪时事也。","book":"《艾子杂说》"},"example":{"text":"～的做法让人讨厌。"},"usage":"作宾语、定语；指毫无根据诬陷人","story":["艾子在海上航行，晚上停泊在孤岛上，半夜听到水底有声音传来，鼋说龙王下命令明天要把有尾巴的动物斩杀，它很害怕。蛤蟆听后也哭了起来，鼋觉得很奇怪。蛤蟆解释它害怕追溯到蝌蚪时代，那也在诛杀之列"]},{"id":39503,"word":"蛮不讲理","pinyin":"mán bù jiǎng lǐ","abbr":"mbjl","explanation":"态度粗暴，不讲道理。","source":{"text":"在我们社会里，也有少数不顾公共利益，蛮不讲理，行凶犯法的人。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"example":{"text":"我们要少跟这种～的人打交道。"},"similar":["蛮横无理","强词夺理"],"opposite":["彬彬有礼","以理服人","通情达理"],"usage":"作谓语、定语、状语；指不讲道理"},{"id":39504,"word":"蛮争触斗","pinyin":"mán zhēng chù dòu","abbr":"mzcd","explanation":"蛮、触：蛮氏、触氏，《庄子》寓言中的在蜗牛两角的两个小国。因细小的缘故而引起的争端。","source":{"text":"有国于蜗之左角者，曰触氏，有国于蜗之右角者，曰蛮氏。时相与争地而战，伏尸数万，逐北旬有五日而后反。","book":"《庄子·则阳》"},"example":{"text":"石火电光俱是梦，～总无常。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["蛮触之争","蛮触相争"],"usage":"作宾语、定语；指非正义战争","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":39505,"word":"蛮来生作","pinyin":"mán lái shēng zuò","abbr":"mlsz","explanation":"形容强迫。","source":{"text":"岂有此理！这事可是蛮来生作得的吗？","book":"清·文康《儿女英雄传》第26回"},"example":{"text":"请不要～，没有解决不了的问题。"},"usage":"作谓语、宾语；指动武"},{"id":39506,"word":"蛮横无理","pinyin":"mán hèng wú lǐ","abbr":"mhwl","explanation":"态度粗暴，不讲道理。","source":{"text":"武松在旁边说话不得，恼恨县主得了贿银，这样蛮横无理。","book":"刘操南《武松演义》第六回"},"example":{"text":"将政府负责人士尽皆列入，更要求政府先行逮捕，其～，显而易见。","book":"毛泽东《国民党反动派由“呼吁和平”变为呼吁战争》"},"similar":["蛮不讲理","飞扬跋扈"],"opposite":["一团和气","温柔敦厚"],"usage":"作谓语、定语、状语；指不讲理"},{"id":39507,"word":"蛮烟瘴雨","pinyin":"mán yān zhàng yǔ","abbr":"myzy","explanation":"指南方有瘴气的烟雨。也泛指十分荒凉的地方。","source":{"text":"瘴雨蛮烟，十年梦，樽前休说。","book":"宋·辛弃疾《满江红》词"},"example":{"text":"走～之乡，受骇浪惊涛之险。","book":"清·李汝珍《镜花缘》第六回"},"similar":["蛮烟瘴雾"],"usage":"作宾语、定语；指十分荒凉的地方"},{"id":39508,"word":"蛮烟瘴雾","pinyin":"mán yān zhàng wù","abbr":"myzw","explanation":"指南方的烟雨瘴气。借指荒凉地区。","source":{"text":"蛮烟瘴雾虽生处，何必区区忆陋邦。","book":"宋·欧阳修《再和公仪赠白鹇》"},"similar":["蛮烟瘴雨"],"usage":"作宾语、定语；指荒凉地区"},{"id":39509,"word":"蛮笺象管","pinyin":"mán jiān xiàng guǎn","abbr":"mjxg","explanation":"蜀地生产的纸，以象牙为杆的毛笔。泛指精美的纸笔。","source":{"text":"蛮笺象管休凝思，且放春心入醉乡。","book":"唐·刘兼《春宴河亭》"},"example":{"text":"～夜深时，曾赋陈宫第一诗。","book":"唐·罗隐《清溪江令公宅》"}},{"id":39510,"word":"蛮触之争","pinyin":"mán chù zhī zhēng","abbr":"mczz","explanation":"蛮：蛮氏；触：触氏。《庄子》中的在蜗牛两角的两个小国，因细小的缘故而引起的争端。","source":{"text":"有国于蜗之左角者，曰触氏，有国于蜗之右角者，曰蛮氏。时相与争地而战，伏尸数万，逐北旬有五日而后反。","book":"战国·宋·庄周《庄子·则阳》"},"example":{"text":"～，要于兴、观、群、怨，丝毫未有当也。","book":"清·王夫之《姜斋诗话》下卷"},"similar":["蛮触相争","蛮争触斗"],"usage":"作宾语、定语；指非正义战争","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":39511,"word":"蛮触相争","pinyin":"mán chù xiāng zhēng","abbr":"mcxz","explanation":"蛮触：蛮氏、触氏，《庄子》寓言中的在蜗牛两角的两个小国。因细小的缘故而引起的争端。","source":{"text":"有国于蜗之左角者，曰触氏，有国于蜗之右角者，曰蛮氏。时相与争地而战，伏尸数万，逐北旬有五日而后反。","book":"《庄子·则阳》"},"example":{"text":"略观大体，同盟会固多不直，共和党亦务诈欺，～，不离蜗角。","book":"章炳麟《致江西统一党支部函》一"},"similar":["蛮争触斗","蛮触之争"],"usage":"作宾语、定语；指非正义战争","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":39512,"word":"蛮风瘴雨","pinyin":"mán fēng zhàng yǔ","abbr":"mfzy","explanation":"蛮：荒凉的南方；瘴：瘴气。指南方有烟雨瘴气的地方。泛指十分荒凉的地方。","source":{"text":"为使君洗尽蛮风瘴雨，作《霜天晓》。","book":"明·周楫《西湖二集·吹风箫女诱东墙》"},"similar":["蛮烟瘴雨"],"usage":"作宾语、定语；指十分荒凉的地方"},{"id":39513,"word":"蛲蛔之死","pinyin":"náo huí zhī sǐ","abbr":"nhzs","explanation":"蛲：人体寄生虫；蛔：蛔虫。形容不劳而获者终归会失败。","source":{"text":"蛲蛔所藉以生者，在人肠胃之中也。","book":"《燕书》"},"usage":"作主语、宾语；指寄生虫的生活","story":["蛲虫和蛔虫都是人体的寄生虫，他们潜藏在人的身体里，大都寄生在人的肠胃里，日夜不停地吸吮血浆和脂肪，让人得病，逐渐让人致死。人一旦死去，蛲虫和蛔虫也就干枯而死，因此寄生虫的生命不会长久"]},{"id":39514,"word":"蛾扑灯蕊","pinyin":"é pū dēng ruǐ","abbr":"epdr","explanation":"飞蛾投火，自取灭亡。","source":{"text":"笑他命薄烟花鬼，好一似蛾扑灯蕊。","book":"清·孔尚任《桃花扇·媚座》"}},{"id":39515,"word":"蛾眉倒蹙，凤眼圆睁","pinyin":"é méi dào cù，fèng yǎn yuán zhēng","abbr":"emdcfyyz","explanation":"蛾眉：细长的眉毛；蹙：皱；凤眼：长而大的双眼皮眼睛。形容美女发怒的面容。","source":{"text":"晴雯听了，果然气的蛾眉倒蹙，凤眼圆睁，即时就叫坠儿。","book":"清·曹雪芹《红楼梦》第52回"},"usage":"作谓语、定语；用于女性"},{"id":39516,"word":"蛾眉曼睩","pinyin":"é méi màn lù","abbr":"emml","explanation":"蛾眉：像蚕触须似的弯而细长的眉毛；曼睩：亮晶晶的转动有神的眼睛。细长而弯的眉毛，炯炯有神的眼睛。形容女子美丽。也指美女。","source":{"text":"蛾眉曼睩，目腾光些。","book":"《楚辞·招魂》"},"example":{"text":"～分明在，孤负琴心已十年。","book":"清·李慈铭《越缦堂诗话》卷中"},"usage":"作宾语、定语；用于女性"},{"id":39517,"word":"蛾眉皓齿","pinyin":"é méi hào chǐ","abbr":"emhc","explanation":"蛾眉：像蚕蛾触须似的弯而长的眉毛。修长的眉毛，洁白的牙齿。形容女子容貌美丽。","source":{"text":"臣之东邻，有一女子，云发丰艳，蛾眉皓齿。","book":"汉·司马相如《美人赋》"},"example":{"text":"至于论美女，则～如东邻之女，瑰姿艳逸如洛浦之神。","book":"宋·赵佶《宣和画谱》卷五"},"similar":["明眸皓齿"],"usage":"作宾语、定语；用于女子"},{"id":39518,"word":"蛾眉螓首","pinyin":"é méi qín shǒu","abbr":"emqs","explanation":"弯弯的眉毛，方广的前额。形容女子容貌的美艳。","source":{"text":"螓首蛾眉。","book":"《诗经·卫风·硕人》"},"example":{"text":"此时宫嫔在前，～，巧笑倩兮。","book":"明·孙仁孺《东郭记·为人也》"},"usage":"作宾语、定语；形容女子貌美"},{"id":39519,"word":"蛾附蜂屯","pinyin":"yǐ fù fēng tún","abbr":"efft","explanation":"蛾：蚂蚁。像飞蛾和蜜蜂一样聚集。","example":{"text":"灾民与难民～一般拥向救济站。"},"similar":["蜂屯蚁聚"],"usage":"作宾语、定语；形容成群的人聚集在一处"},{"id":39520,"word":"蜀中无大将，廖化作先锋","pinyin":"shǔ zhōng wú dà jiàng，liào huà zuò xiān fēng","abbr":"szwdjlhzxf","explanation":"比喻办事缺乏好手，让能力一般的人出来负责。","source":{"text":"时蜀汉景耀元年冬，大将军姜维以廖化、张翼为先锋，王含、蒋斌为左军，蒋舒、傅佥为右军，胡济为合后，维与夏侯霸总中军，共起蜀兵二十万，拜辞后主，径到汉中。","book":"明·罗贯中《三国演义》第一百十三回"},"example":{"text":"‘～’，你这少年，公然充起著述名家来，怪极！怪极！","book":"清·壮者《扫迷帚》第二十四回"},"usage":"作宾语、定语、分句；用于感慨"},{"id":39521,"word":"蜀得其龙","pinyin":"shǔ dé qí lóng","abbr":"sdql","explanation":"龙：杰出人物。蜀国得到诸葛亮。","source":{"text":"于时以为‘蜀得其龙，吴得其虎，魏得其狗’。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"usage":"作宾语、定语；指杰出人才","story":["三国时期，诸葛家族三个杰出人物即诸葛瑾、诸葛亮、诸葛诞。诸葛瑾任吴国大将军，诸葛亮辅佐刘备建蜀汉政权，与曹操、孙权抗衡，诸葛诞任魏国扬州刺史。史书上评价为蜀国得到一条龙，吴国得到一只虎，魏国只得到一条狗"]},{"id":39522,"word":"蜀犬吠日","pinyin":"shǔ quǎn fèi rì","abbr":"sqfr","explanation":"蜀：四川省的简称；吠：狗叫。原意是四川多雨，那里的狗不常见太阳，出太阳就要叫。比喻少见多怪。","source":{"text":"屈子赋曰：‘邑犬群吠，吠所怪也。’仆往闻庸、蜀之南，恒雨少日，日出则犬吠。","book":"唐·柳宗元《答韦中立论师道书》"},"example":{"text":"～，比人所见甚稀。","book":"程允升《幼学琼林》卷一"},"similar":["少见多怪","孤陋寡闻"],"usage":"作宾语、定语；指少见多怪","story":["唐朝散文家柳宗元因王叔文失势而被贬到湖南永州当司马，他在永州期间收到韦中立的拜师信，非常感动。他立即回信《答韦中立论师道书》表达一个观点：少见多怪是常有的事情，就像蜀犬吠日就是一个典型的例子"]},{"id":39523,"word":"蜀贾卖药","pinyin":"shǔ gǔ mài yào","abbr":"sjmy","explanation":"贾：商人。四川商人卖药，各得其所。指商人投机取巧谋取暴利。","source":{"text":"蜀贾三人，皆卖药于市。","book":"《郁离子》"},"usage":"作宾语、定语；指商人投机取巧","story":["三个四川药商卖药，一个专门微利卖好药，一个诚信卖好药与劣药，坚持价格分开，一个专门以低价卖劣药，而且经常多送一些。一年下来，专门卖劣药的商人大发，门槛都被人挤破，而专卖好药的商人则门前冷清，过着吃了上顿没下顿的生活"]},{"id":39524,"word":"蜀鄙二僧","pinyin":"shǔ bǐ èr sēng","abbr":"sbes","explanation":"蜀：四川；鄙：边境；僧：和尚。比喻穷与富不是事业成功的关键条件。","source":{"text":"蜀之鄙有二僧，其一贫，其一富。","book":"《白鹤堂时文集》"},"usage":"作宾语、定语；指不同条件的人","story":["四川边境有两个和尚，穷和尚对富和尚说要到几千里远的南海去，富和尚问他靠什么去。穷和尚表示只靠一个水瓶和一个饭碗。富和尚不屑一顾地说自己想买一条船去南海都没去成。一年后，穷和尚从南海回来，富和尚只好满脸愧色"]},{"id":39525,"word":"蜀锦吴绫","pinyin":"shǔ jǐn wú líng","abbr":"sjwl","explanation":"蜀锦：四川生产的彩锦；吴绫：绫的一种，最初出于吴郡。泛指各种精美的丝织品。","source":{"text":"价重如齐纨鲁缟，名高似蜀锦吴绫。","book":"元·汤式《一枝花·赠美人》套曲"},"example":{"text":"微风初动，轻飘飘展开～；细雨才收，娇滴滴露出冰肌玉质。","book":"明·吴承恩《西游记》第82回"},"similar":["齐纨鲁缟"],"usage":"作主语、宾语、定语；指丝织品"},{"id":39526,"word":"蜂出并作","pinyin":"fēng chū bìng zuò","abbr":"fcbz","explanation":"蜂出：象蜂群出巢一样，多且杂乱；作：兴起。象蜂群出巢一样兴起。形容纷纷兴起，层出不穷。","source":{"text":"是以九家之术，蜂出并作。","book":"《汉书·艺文志》"},"usage":"作谓语、定语；用于局势"},{"id":39527,"word":"蜂出泉流","pinyin":"fēng chū quán liú","abbr":"fcql","explanation":"像群蜂倾巢，如泉水涌流。形容一时并作。","source":{"text":"孔子殁，七十子不见用，衰世著书之徒，蜂出泉流。","book":"清·龚自珍《古史勾沉论二》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39528,"word":"蜂合蚁聚","pinyin":"fēng hé yǐ jù","abbr":"fhyj","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"蠢彼不庭，敢违天道……欲恃其蜂合蚁聚之势，仗锄耰白挺之徒，垂二十年不宾睿化。","book":"前蜀·杜光庭《中和周天醮词》"},"similar":["蜂屯蚁聚","蜂屯蚁附"],"usage":"作谓语、定语；形容成群的人聚集在一处"},{"id":39529,"word":"蜂合豕突","pinyin":"fēng hé shǐ tū","abbr":"fhst","explanation":"如群蜂聚集，似野猪奔突。比喻众人杂沓会合，横冲直撞。","source":{"text":"今不然矣，中国之虚实在楚人目中矣！于是荆户乘广之旅，蜂合豕突以败徐于娄林。","book":"明·刘基《春秋明经·公会齐侯楚人败徐于娄林》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39530,"word":"蜂媒蝶使","pinyin":"fēng méi dié shǐ","abbr":"fmds","explanation":"花间飞舞的蜂蝶。比喻为男女双方居间撮合或传递书信的人。","source":{"text":"偏是你瘦影疏枝，不受那蜂媒蝶使。","book":"宋·周邦彦《六丑·蔷薇谢后作》词：“多情为谁追惜？但蜂媒蝶使，时叩窗槅。”元·吴昌龄《张天师》第三折"},"example":{"text":"也不用～，更何须燕侣莺俦，硬撞八凤窟鸾穴，只消我移宫换羽，便是我捎关打节。","book":"明·朱权《卓文君》第二折"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":39531,"word":"蜂屯乌合","pinyin":"fēng tún wū hé","abbr":"ftwh","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"蕞尔林胡，无名内侮，蜂屯乌合，鼠窃狗偷；必想边民夺挺以殴攘，亭长持绳而絷缚。","book":"宋·王禹偁《贺圣驾还京表》"},"similar":["蜂攒蚁集","蜂拥蚁屯"],"usage":"作谓语、定语；形容成群的人聚集在一处"},{"id":39532,"word":"蜂屯蚁杂","pinyin":"fēng tún yǐ zá","abbr":"ftyz","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"撞搪呼号以相和应；蜂屯蚁杂，不可爬梳。","book":"唐·韩愈《送郑尚书序》"},"similar":["蜂屯蚁聚","蜂屯蚁附"],"usage":"作谓语、定语；用于比喻句"},{"id":39533,"word":"蜂屯蚁聚","pinyin":"fēng tún yǐ jù","abbr":"ftyj","explanation":"形容成群的人聚集在一处。","source":{"text":"蜂屯蚁杂，不可爬梳。","book":"唐·韩愈《送郑尚书序》"},"example":{"text":"这里雯青直到日落西山，才把那些～的亲朋支使出了门，坐了一肩小轿，向三茅阁巷褚爱林家而来。","book":"清·曾朴《孽海花》第三回"},"similar":["蜂攒蚁聚","蜂拥蚁聚"],"usage":"作谓语、定语、状语；形容成群的人聚集在一"},{"id":39534,"word":"蜂屯蚁附","pinyin":"fēng tún yǐ fù","abbr":"ftyf","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"犬戎之众，蜂屯蚁附，渡壕临城，梯长如云，箭落如雨。","book":"宋·李纲《上道君太上皇帝札子》"},"similar":["蜂屯蚁聚","蜂屯乌合"],"usage":"作谓语、定语；形容成群的人聚集在一处"},{"id":39535,"word":"蜂房不容鹄卵","pinyin":"fēng fáng bù róng hú luǎn","abbr":"ffbrgl","explanation":"鹄：天鹅。蜂房装不下天鹅蛋。比喻小容器装不下体积大的东西。","source":{"text":"牛蹄之涔，不能生鳣鲔，而蜂房不容鹄卵，小形不足以包大体也。","book":"《淮南子·汜论训》"}},{"id":39536,"word":"蜂房水涡","pinyin":"fēng fáng shuǐ wō","abbr":"ffsw","explanation":"蜜蜂的巢和水的漩涡。比喻宫殿楼台的布局曲折回旋，多且密。","source":{"text":"盘盘焉，囷囷焉，蜂房水涡，矗不知其几千万落。","book":"唐·杜牧《阿房宫赋》"}},{"id":39537,"word":"蜂房蚁穴","pinyin":"fēng fáng yǐ xué","abbr":"ffyx","explanation":"比喻各自占据一方。","source":{"text":"自共和以来，诸侯如蜂房蚁穴，不用天子之元年矣。","book":"明·杨慎《丹铅续录·春秋·隐公元年》"},"similar":["蜂窠蚁穴"],"usage":"作宾语、定语；用于比喻句"},{"id":39538,"word":"蜂扇蚁聚","pinyin":"fēng shān yǐ jù","abbr":"fsyj","explanation":"蜂翅扇动，蚂蚁聚合。比喻人虽众多但起不了大作用。","source":{"text":"况乎蕞尔一隅，蜂扇蚁聚，杨谅之愚鄙，群小之凶慝，而欲凭陵畿甸，觊幸非望者哉！","book":"《隋书·房彦谦传》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39539,"word":"蜂拥而上","pinyin":"fēng yōng ér shàng","abbr":"fyes","explanation":"形容许多人一起涌上来。","source":{"text":"墨雨遂掇起一根门闩，扫红、锄药手中都是马鞭子，蜂拥而上。","book":"清·曹雪芹《红楼梦》第九回"},"example":{"text":"他们～，迅速逮住了坏蛋。"},"similar":["蜂拥而至","蜂拥而来"],"opposite":["鱼贯而来"],"usage":"作谓语、定语；指杂乱"},{"id":39540,"word":"蜂拥而来","pinyin":"fēng yōng ér lái","abbr":"fyel","explanation":"象蜂群似的拥挤着过来。形容许多人一起过来。","source":{"text":"陈涉首难，豪杰蜂起。","book":"《史记·项羽本纪》"},"example":{"text":"又等了一会子，方见胡统领打着灯笼火把，一路～。","book":"清·李宝嘉《官场现形记》第十二回"},"similar":["蜂拥而上"],"usage":"作谓语、定语；指杂乱"},{"id":39541,"word":"蜂拥而至","pinyin":"fēng yōng ér zhì","abbr":"fyez","explanation":"像一窝蜂似地一拥而来。形容很多人乱哄哄地朝一个地方聚拢。","source":{"text":"徐承志等他去远，刚要回船，前面尘头滚滚，喊声渐近，又来许多草寇。个个头戴浩然巾，手机器械，蜂拥而至。","book":"清·李汝珍《镜花缘》第二十六回"},"example":{"text":"该处七哨匪徒，不下数十万人，每聚众时，用牛角一吹，无不～。","book":"清·林则徐《筹办永昌哨匪起程日期折》"},"similar":["蜂拥而来"],"usage":"作谓语、定语；指杂乱"},{"id":39542,"word":"蜂拥而起","pinyin":"fēng yōng ér qǐ","abbr":"fyeq","explanation":"像蜂飞一样成群而起。形容许多人一拥而起。","source":{"text":"陈涉首难，豪杰蜂起。","book":"西汉·司马迁《史记·项羽本纪赞》"},"example":{"text":"各地群众～，纷纷涌入城内。"},"similar":["蜂拥而至","纷至沓来"],"usage":"作谓语、定语；指一哄而上","story":["秦朝的残暴统治，造成民不聊生。陈涉吴广首先发难，其他豪杰蜂拥而起，推翻了秦朝的统治。为了争夺胜利果实，项羽与刘邦进行几年的争斗。项羽刚愎自用，仅靠武力统一天下，最后被刘邦围困在乌江边自刎而死"]},{"id":39543,"word":"蜂拥蚁屯","pinyin":"fēng yōng yǐ tún","abbr":"fyyt","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"帆樯衔接，倏然蜂拥蚁屯者数千人。","book":"清·昭梿《啸亭杂录·缅甸归诚本末》"},"similar":["蜂拥蚁聚","蜂攒蚁集","蜂屯乌合"],"usage":"作谓语、定语、宾语；用于人多的地方"},{"id":39544,"word":"蜂拥蚁聚","pinyin":"fēng yōng yǐ jù","abbr":"fyyj","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"城下死者山积，攻者反藉叠尸以登，蜂拥蚁聚，城遂陷。","book":"罗振常《史可法别传》"},"similar":["蜂攒蚁聚","蜂屯蚁聚","蜂拥蚁屯"],"usage":"作谓语、定语、宾语；用于人多的地方"},{"id":39545,"word":"蜂攒蚁聚","pinyin":"fēng cuán yǐ jù","abbr":"fcyj","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"那跟随楚王人众，何止千人，一个个俱脱衣露甲，手执暗器，如蜂攒蚁聚，飞奔上坛。","book":"明·冯梦龙《东周列国志》第三十三回"},"example":{"text":"一到大街，～，身不由己。琬儿母女，各各惊慌。","book":"清·佚名《说唐》第十三回"},"similar":["蜂屯蚁聚","蜂拥蚁聚","蜂拥蚁屯"],"usage":"作谓语、定语、宾语；用于人多的地方"},{"id":39546,"word":"蜂攒蚁集","pinyin":"fēng cuán yǐ jí","abbr":"fcyj","explanation":"形容人群蜂蚁般杂乱地聚集在一起。同“蜂屯蚁聚”。","source":{"text":"四方商贾来收买的，蜂攒蚁集，挨挤不开。","book":"明·冯梦龙《醒世恒言》第十八卷"},"similar":["蜂攒蚁聚","蜂屯蚁聚","蜂拥蚁聚"],"usage":"作谓语、定语；形容成群的人聚集在一处"},{"id":39547,"word":"蜂狂蝶乱","pinyin":"fēng kuáng dié luàn","abbr":"fkdl","explanation":"旧指男女间行为放荡。","source":{"text":"那淫奔坞，多少蜂狂蝶乱，毕竟傍谁虚度。","book":"明·王玉峰《焚香记·允谐》"},"similar":["蜂迷蝶恋"],"usage":"作谓语、定语、宾语、状语；用于比喻句"},{"id":39548,"word":"蜂目豺声","pinyin":"fēng mù chái shēng","abbr":"fmcs","explanation":"眼睛象蜂，声音象豺。形容人相貌凶恶，声音可怕。","source":{"text":"蜂目而豺声，忍人也。","book":"《左传·文公元年》"},"example":{"text":"见了这野心杂种牧羊的奴，料～定是狡徒。","book":"清·洪昇《长生殿·疑谶》"},"usage":"作定语、宾语；形容坏人","story":["晋朝时期，潘阳仲见到幼年王敦的长相，便说：“你像蜂一样的眼睛已露出来，只是豺狼一样的声音还没有发出罢了，你今后一定会吃人，也一定会被别人吃掉。”"]},{"id":39549,"word":"蜂窠蚁穴","pinyin":"fēng kē yǐ xué","abbr":"fkyx","explanation":"比喻占据的地方极为窄小，借以对偏安一隅的地方势力的蔑称。","source":{"text":"开宝八年，王师围金陵。朝廷殿试《桥梁渡长江赋》、《习水战诗》；江南亦试《王德惟亲赋》、《谈笑却秦诗》。太祖笑曰：‘江南畜文臣武将，迨同飞走，岂不知中原有真主耶？’赵普曰：‘蜂窠蚁穴不足挂圣虑。’","book":"宋·曾慥《类说·见闻录·胡讷》"},"similar":["蜂房蚁穴"],"usage":"作宾语、定语；用于比喻句","story":["北宋开宝八年，赵匡胤率军围攻江南的金陵。当时北宋朝廷殿试的题目是《桥梁渡长江赋》、《习水战诗》，江南也在科举殿试，其题目为《王德惟亲赋》、《谈笑却秦诗》。赵匡胤讥笑江南出文臣武将就不知中原有真主，赵普说江南只不过是蜂窠蚁穴而已"]},{"id":39550,"word":"蜂缠蝶恋","pinyin":"fēng chán dié liàn","abbr":"fcdl","explanation":"缠：纠缠；恋：依恋。蜜蜂纠缠不休，蝴蝶依恋不舍。比喻情和爱的干扰。","source":{"text":"后来降几历劫，还报了灌溉之恩，今返归真境。所以警幻仙子命我看管，不令蜂缠蝶恋。","book":"清·曹雪芹《红楼梦》第一百十六回"}},{"id":39551,"word":"蜂腰削背","pinyin":"fēng yāo xuē bèi","abbr":"fyxb","explanation":"细腰窄背。形容轻盈俊俏。同“蜂腰猿背”。","source":{"text":"蜂腰削背，鸭蛋脸，乌油头发，高高的鼻子，两边腮上微微的几点雀瘢。","book":"清·曹雪芹《红楼梦》第四十六回"},"similar":["蜂腰猿背"],"usage":"作宾语、定语；多用于女性"},{"id":39552,"word":"蜂腰猿背","pinyin":"fēng yāo yuán bèi","abbr":"fyyb","explanation":"细腰窄背。形容轻盈俊俏。","source":{"text":"腰里紧紧束着一条蝴蝶结子长穗五色宫绦，脚下也穿着鹿皮小靴：越显得蜂腰猿背，鹤势螂形。","book":"清·曹雪芹《红楼梦》第四十九回"},"similar":["蜂腰削背"],"usage":"作宾语、定语、状语；多用于女性"},{"id":39553,"word":"蜂腰鹤膝","pinyin":"fēng yāo hè xī","abbr":"fyhx","explanation":"指诗歌声律八病中的两种。泛指诗歌声律上的毛病。","source":{"text":"蜂腰鹤膝嘲希逸，春蚓秋蛇病子云。","book":"宋·苏轼《和孔密州五绝》"},"similar":["鹤膝蜂腰"],"usage":"作宾语、定语；多用于比喻句"},{"id":39554,"word":"蜂舞并起","pinyin":"fēng wǔ bìng qǐ","abbr":"fwbq","explanation":"蜂舞：杂乱纷繁。象蜂起舞一样兴起。形容纷纷地一起都来了。","source":{"text":"水、旱、饥、蝝、螽、螟、逄舞并起。","book":"《汉书·刘向传》"},"usage":"作谓语、定语、状语；用于事物等"},{"id":39555,"word":"蜂营蚁队","pinyin":"fēng yíng yǐ duì","abbr":"fyyd","explanation":"比喻乌合之众。","source":{"text":"一朝闽寇掠乡部，蜂营蚁队来无涯。","book":"明·宋濂《次刘经历韵诗》"},"similar":["乌合之众"],"usage":"作宾语、定语；用于比喻句"},{"id":39556,"word":"蜂虿作于怀袖","pinyin":"fēng chài zuò yú huái xiù","abbr":"fczyhx","explanation":"比喻出乎意外的惊吓。","source":{"text":"比喻出乎意外的惊吓。"},"example":{"text":"比喻出乎意外的惊吓。"},"usage":"作定语、分句；比喻出乎意外的惊吓"},{"id":39557,"word":"蜂虿有毒","pinyin":"fēng chài yǒu dú","abbr":"fcyd","explanation":"虿：蝎子一类的毒虫。比喻有些人物，地位虽低，但能害人，不可轻视。","source":{"text":"君其无谓邾小，蜂虿有毒，而况国乎？","book":"《左传·僖公二十二年》"},"example":{"text":"雯青到此真有些耐不得了，待要发作，又怕～，惹出祸来，只好纳着头，生生的咽了下来。","book":"清·曾朴《孽海花》第二十四回"},"usage":"作分句、宾语；指小人"},{"id":39558,"word":"蜂蝶随香","pinyin":"fēng dié suí xiāng","abbr":"fdsx","explanation":"蜜蜂和蝴蝶跟随花香而追逐。旧时比喻那些纨绔子弟追逐女色。","source":{"text":"都中名妓楚莲香，国色无双。时贵门子弟，争相诣之。莲香每出处之间，则蜂蝶相随，盖慕其香也。","book":"五代·王仁裕《开元天宝遗事》"}},{"id":39559,"word":"蜂识莺猜","pinyin":"fēng shí yīng cāi","abbr":"fsyc","explanation":"比喻男子对女子的思慕。同“蜂迷蝶猜”。","source":{"text":"绛罗深护奇葩小，不许蜂识莺猜。","book":"元本·高明《琵琶记·牛相教女》"},"similar":["蜂迷蝶猜"],"usage":"作谓语、宾语；用于比喻句"},{"id":39560,"word":"蜂起云涌","pinyin":"fēng qǐ yún yǒng","abbr":"fqyy","explanation":"比喻许多事物相继兴起，声势很大。","source":{"text":"然而，大部分是因为市场的需要，社会科学的译著又蜂起云涌了。","book":"鲁迅《二心集·我们要批评家》"},"similar":["风起云涌"],"usage":"作谓语、状语；用于事物等"},{"id":39561,"word":"蜂趋蚁附","pinyin":"fēng qū yǐ fù","abbr":"fqyf","explanation":"比喻很多人迎合投靠。","source":{"text":"果然蜂趋蚁附，攘攘熙熙，诚不出神灵所料者矣。","book":"《三元里人民抗英斗争史料·联升社学和钟镛社学》"},"usage":"作谓语、宾语；用于比喻句"},{"id":39562,"word":"蜂迷蝶恋","pinyin":"fēng mí dié liàn","abbr":"fmdl","explanation":"旧指男女间行为放荡。同“蜂狂蝶乱”。","source":{"text":"说不尽梦儿里半推半就，蜂迷蝶恋花心动。","book":"《白雪遗音·岭儿调·草桥惊梦》"},"similar":["蜂狂蝶乱"],"usage":"作谓语、定语、宾语、状语；用于比喻句"},{"id":39563,"word":"蜂迷蝶猜","pinyin":"fēng mí dié cāi","abbr":"fmdc","explanation":"比喻男子对女子的思慕。","source":{"text":"绛罗深护奇葩小，不许蜂迷蝶猜。","book":"明·高明《琵琶记·丞相教女》"},"similar":["蜂识莺猜"],"usage":"作谓语、宾语；用于比喻句"},{"id":39564,"word":"蜂附云集","pinyin":"fēng fù yún jí","abbr":"ffyj","explanation":"比喻人众从各处聚集。","source":{"text":"夜则桅灯如列星，旦则吹螺举号，蜂附云集。","book":"明·归有光《昆山县倭寇始末书》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39565,"word":"蜃楼山市","pinyin":"shèn lóu shān shì","abbr":"slss","explanation":"即海市蜃楼。旧时比喻人世繁华的虚幻。","source":{"text":"何何氏有扩信之密诀曰：‘……虚中见实，实中见虚，蜃楼山市，龙女施珠。’","book":"清·方以智《东西均·扩信》"},"similar":["蜃楼海市","海市蜃楼"],"usage":"作宾语、定语；指虚幻的事物"},{"id":39566,"word":"蜃楼海市","pinyin":"shèn lóu hǎi shì","abbr":"slhs","explanation":"旧时比喻人世繁华的虚幻。","source":{"text":"此海市蜃楼比耳，岂长久耶？","book":"《隋唐遗事》"},"similar":["海市蜃楼","蜃楼山市"],"usage":"作宾语、定语；指虚幻的事物"},{"id":39567,"word":"蜉蝣撼大树","pinyin":"fú yóu hàn dà shù","abbr":"fyhds","explanation":"比喻自不量力。","source":{"text":"汤家公子喜夸诩，好似蜉蝣撼大树。","book":"明刘昌《悬笥琐探恃才傲物》"},"example":{"text":"假使你内省不疚，那小孩子的醉态就像～，何损于你的泰山北斗呢？","book":"郭沫若《我的童年》第三篇七"},"similar":["蚍蜉撼大树"],"usage":"作宾语、定语；指不自量力"},{"id":39568,"word":"蜎飞蠕动","pinyin":"xuān fēi rú dòng","abbr":"yfrd","explanation":"蜎：通“翾”，飞翔。昆虫等小动物飞行或蠕动。","source":{"text":"故观蜎飞蠕动，无不有利害。","book":"《鬼谷子·揣》"},"usage":"作宾语；用于小动物"},{"id":39569,"word":"蜕化变质","pinyin":"tuì huà biàn zhì","abbr":"thbz","explanation":"蜕化：虫类脱皮变化。比喻人堕落变坏。","source":{"text":"最后还说我是什么蜕化变质分子，被糖衣炮弹击中的分子，把我一脚踢出门外。","book":"魏巍《东方》第六部第13章"},"example":{"text":"他已经～，晚节不保。"},"similar":["腐化堕落"],"usage":"作谓语、定语；指人腐化堕落变坏"},{"id":39570,"word":"蜕故孳新","pinyin":"tuì gù zī xīn","abbr":"tgzx","explanation":"蜕：脱去；孳：新芽。指去旧生新。","source":{"text":"有一代之政教风尚，则有一代之学术思想，蜕故孳新，瞬息不可复省，而有为之摄影者曰史，而有为之留声者曰文。","book":"黄人《序》"},"similar":["革故鼎新"],"usage":"作谓语、定语；用于书面语"},{"id":39571,"word":"蜗利蝇名","pinyin":"wō lì yíng míng","abbr":"wlym","explanation":"蜗利：蜗牛角大的利益；蝇名：苍蝇一样大的名声。比喻虚名小利。","source":{"text":"既悟尘缘，摆爱海恩山，蜗利蝇名。","book":"元·王丹桂《春从天上来》"},"similar":["蜗名蝇利","蝇利蜗名","蝇名蜗利"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":39572,"word":"蜗名微利","pinyin":"wō míng wēi lì","abbr":"wmwl","explanation":"蜗名：像蜗牛角那样极微小的名声。虚名小利。亦作“蜗利蝇名”、“蜗名蝇利”。","source":{"text":"蜗名微利，误人之本，从此亦不复思进取也！","book":"明·冯梦龙《喻世明言》卷九"},"similar":["蜗名蝇利","蜗利蝇名","蝇名蜗利"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":39573,"word":"蜗名蝇利","pinyin":"wō míng yíng lì","abbr":"wmyl","explanation":"蜗名：象蜗牛角那样微小的名声；蝇利：苍蝇般大的利益。比喻虚名小利。","source":{"text":"最癖登山临水。又何心、蜗名蝇利。","book":"宋·李昴英《水龙吟》词"},"example":{"text":"妙道勤求，乐以忘忧，要～心休。","book":"元·刘志渊《行香子》词"},"similar":["蜗利蝇名","蝇利蜗名","蝇名蜗利"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":39574,"word":"蜗舍荆扉","pinyin":"wō shè jīng fēi","abbr":"wsjf","explanation":"象蜗牛壳似的房子，用荆条编的门户。形容极简陋狭小的房屋。扉：门户。","source":{"text":"栖息同蜗舍，出入共荆扉。","book":"南朝·梁·何逊《仰赠从兄兴宁置南》"}},{"id":39575,"word":"蜗行牛步","pinyin":"wō xíng niú bù","abbr":"wxnb","explanation":"蜗牛爬行，老牛慢走。比喻行动或进展极慢。","example":{"text":"他前进的速度就像～。"},"opposite":["快步流星"],"usage":"作宾语、定语；指进展极慢"},{"id":39576,"word":"蜗角之争","pinyin":"wō jiǎo zhī zhēng","abbr":"wjzz","explanation":"比喻为了极小的事物而引起大的争执。","source":{"text":"有国于蜗之左角者，曰触氏，有国于蜗之右角者，曰蛮氏，时相与争地而战，伏尸数万，逐北，旬有五日而后反。","book":"《庄子·则阳》"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第十卷：“宋礼立裹之约，希～。”"},"similar":["蜗角斗争"],"usage":"作宾语；指为极小的事而引起大的争执","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":39577,"word":"蜗角斗争","pinyin":"wō jiǎo dòu zhēng","abbr":"wjdz","explanation":"蜗：蜗牛；蜗角：比喻极微小的境地。比喻为极小的事而引起大的争执。","source":{"text":"有国于蜗之左角者曰触氏，有国于蜗之右角者曰蛮氏，时相与争地而战，伏尸数万。","book":"战国·宋·庄周《庄子·则阳》"},"example":{"text":"～，左触右蛮，一战连千里。","book":"宋·辛弃疾《哨遍·秋水观》词"},"similar":["蜗角之争"],"usage":"作宾语；指为极小的事而引起大的争执","story":["传说古代有一只蜗牛的两个触角上有两个小国，左边的叫触氏国，右边的叫蛮氏国。两个国家因为争夺地盘而经常发生战争，有时竟伏尸百万，血流成河，造成民不聊生，怨声载道，蜗牛因此而丧失触觉功能"]},{"id":39578,"word":"蜗角虚名","pinyin":"wō jiǎo xū míng","abbr":"wjxm","explanation":"蜗角：蜗牛的角，比喻细微。微小而没有作用的名声。","source":{"text":"蜗角虚名蝇头微利，算来着甚干忙。","book":"宋·苏轼《满庭芳》词"},"example":{"text":"都为那～，蝇头微利，蚁阵蜂衙，将一片打劫的心，则与人争高论下，直等待那揭局儿死时才罢。","book":"元·石子章《竹坞听琴》第二折"},"usage":"作谓语、定语、宾语；指空名"},{"id":39579,"word":"蜗角蚊睫","pinyin":"wō jiǎo wén jié","abbr":"wjwj","explanation":"蜗：蜗牛；睫：眼睫毛。蜗牛的角，蚊子的眼睫毛。形容极为狭小的境地。","source":{"text":"陆机则兄弟同居，韩康则舅甥不别。蜗角蚊睫，又足相容者也。","book":"北周·庾信《小园赋》"},"usage":"作宾语、定语；用于比喻句"},{"id":39580,"word":"蜗角蝇头","pinyin":"wō jiǎo yíng tóu","abbr":"wjyt","explanation":"蜗角：蜗牛的触角；蝇头：苍蝇头。比喻获利甚微，不足挂齿。","source":{"text":"有国于蜗之左角者，曰触氏，有国于蜗之右角者，曰蛮氏，时相与争地而战，伏尸数万，逐北，旬有五日而后反。","book":"《庄子·则阳》"},"example":{"text":"～，名亲共利切。","book":"元·白朴《乔木查·对景》"},"similar":["蝇头蜗角"],"usage":"作宾语、定语；多用于比喻句"},{"id":39581,"word":"蜚瓦拔木","pinyin":"fēi wǎ bá mù","abbr":"fwbm","explanation":"形容风力迅猛。","source":{"text":"余乡常有飓风，但初来声势颇恶，与三州不异，人家即曰：‘报起矣！’有顷则亦蜚瓦拔木，无所不至。","book":"宋·袁文《瓮牖闲评》第三卷"},"usage":"作定语；形容风力迅猛"},{"id":39582,"word":"蜚短流长","pinyin":"fēi duǎn liú cháng","abbr":"fdlc","explanation":"指散播谣言，中伤他人。","source":{"text":"造言生事者，蜚短流长，所不堪受。","book":"清·蒲松龄《聊斋志异·封三娘》"}},{"id":39583,"word":"蜚英腾茂","pinyin":"fēi yīng téng mǎo","abbr":"fytm","explanation":"英：英华之声，指名声；茂：茂盛之实，指实际。称颂人的声名事业日盛。","source":{"text":"俾万世得激清流，扬微波，蜚英声，腾茂实。","book":"《史记·司马相如列传》"},"example":{"text":"吾弟～，下笔如神，不须谦让，请就挥毫。","book":"明·孙梅锡《琴心记·赉金买赋》"},"usage":"作谓语、定语；用于书面语"},{"id":39584,"word":"蜚蓬之问","pinyin":"fēi péng zhī wèn","abbr":"fpzw","explanation":"蜚：通“飞”；蓬：蓬草。比喻无根据的传闻。","source":{"text":"蜚蓬之问，明主不听也。无度之言，明主不许也。","book":"春秋·齐·管仲《管子·形势解》"},"example":{"text":"若其勿便，虽不愆于旧章，～，三王所不宾。","book":"章炳麟《訄书·官统》"},"similar":["无稽之谈","道听途说"],"usage":"作主语、宾语；用于无根据的传闻"},{"id":39585,"word":"蜚语恶言","pinyin":"fēi yǔ è yán","abbr":"fyey","explanation":"蜚语：没有根据的流言。形容诽谤的言辞。","source":{"text":"乃有蜚语为恶言闻上。","book":"《史记·魏其武安侯列传》"}},{"id":39586,"word":"蜚鸟尽，良弓藏","pinyin":"fēi niǎo jìn，liáng gōng cáng","abbr":"fnjlgc","explanation":"藏：收藏。飞鸟射尽，弹弓也就藏起来不用了。比喻事成之后，把曾经出过力的人一脚踢开或加以消灭。","source":{"text":"范蠡遂去，自齐遗大夫种书曰：‘蜚鸟尽，良弓藏；狡兔死，走狗烹。越王为人……’","book":"西汉·司马迁《史记·越王勾践世家》"},"similar":["飞鸟尽，良弓藏","过河拆桥"],"usage":"作宾语、定语、分句；用于书面语","story":["春秋末期，楚国范蠡和文种到越国去做官，辅佐被吴王夫差打败的勾践，他们发奋图强，使越国强大，灭了吴国。范蠡深知勾践的为人就到齐国隐姓埋名经商，他写信劝文种离开说：“飞鸟尽，良弓藏，狡兔死，走狗烹”。文种不信被杀"]},{"id":39587,"word":"蜚黄腾达","pinyin":"fēi huáng téng dá","abbr":"fhtd","explanation":"腾达：上升。形容骏马的飞驰。比喻官职地位升得很快。","source":{"text":"恭喜世兄一举成名，蜚黄腾达。","book":"曾朴《孽海花》第二回"},"similar":["飞黄腾达"],"opposite":["江河日下"],"usage":"作谓语、定语；指地位升得快"},{"id":39588,"word":"蜜口剑腹","pinyin":"mì kǒu jiàn fù","abbr":"mkjf","explanation":"蜜：比喻甘美。嘴上甜，心里狠。形容两面派的狡猾阴险。","source":{"text":"李林甫之蜜口剑腹，贾似道之牢笼言路，合而为一，其患可胜道哉。","book":"明·何良俊《四友斋丛说·史二》"},"example":{"text":"得小心那些～的上司"},"similar":["口蜜腹剑"],"opposite":["心口如一"],"usage":"作谓语、定语；指人阴险","story":["唐玄宗李隆基在位时，宰相李林甫非常阴险狡猾，对皇帝阿谀奉承、溜须拍马以取得信任；对朝中官员就以甜言蜜语取得信任，骗取对方的好感和欢心，然后背后出卖别人或加以陷害，用尽两面三刀的手段。人们说他是“口有蜜，腹有剑”"]},{"id":39589,"word":"蜜语甜言","pinyin":"mì yǔ tián yán","abbr":"myty","explanation":"蜜：比喻甘美。说的话像蜜一样甜。形容说的话好听。","source":{"text":"他生就能为将人哄，蜜语甜言会装腔。","book":"《白雪遗音·劝嫖》"},"similar":["甜言蜜语"],"usage":"作宾语、定语；指好听的话"},{"id":39590,"word":"蜜里藏刀","pinyin":"mì lǐ cáng dāo","abbr":"mlcd","explanation":"蜜：蜂蜜。表面很友好，暗里却藏着害人之心。","source":{"text":"尔乃蜜里藏刀，必欲花间逐蝶，狡亦甚矣，罚岂容轻！","book":"清·梁绍壬《两般秋雨庵随笔·妒律》"},"similar":["笑里藏刀"],"usage":"作谓语、定语；指人很阴险"},{"id":39591,"word":"蜜里调油","pinyin":"mì lǐ tiáo yóu","abbr":"mlty","explanation":"比喻非常亲密和好。","source":{"text":"宝玉一日家和我们姑娘好的蜜里调油，这时候总不见面了，也不知是真病假病。","book":"清·曹雪芹《红楼梦》第九十七回"},"example":{"text":"他就合人家好了个～，临走合那个怪哭的只问人家多早晚还瞧他来。（清·文康《儿女英雄传》第三十九回）"},"usage":"作宾语；比喻非常亲密无间"},{"id":39592,"word":"蜣螂抱粪","pinyin":"qiāng láng bào fèn","abbr":"qlbf","explanation":"蜣螂：屎壳郎。形容臭味相投。","source":{"text":"见一处，尽以粪土涂墙，四面附蜣螂百万，屹如长城。","book":"《谐铎》"},"usage":"作宾语、定语；指环境改变人","story":["古代书生荀小令通体芳香，有“香留三日”的美称，他搭乘商船漂浮到一个小岛上，岛上恶臭无比，遇到奇臭无比的孔铜臭老翁。孔铜臭负责掌管蜣螂城北大门的钥匙，他把女儿阿魏嫁给他，并送他赤金条，从此荀小令也变得奇臭无比"]},{"id":39593,"word":"蜩螗沸羹","pinyin":"tiáo táng fèi gēng","abbr":"ttfg","explanation":"蜩：蝉；螗：蝉的一种，体小，背青绿色，鸣声清圆；沸：开水翻腾。象蝉的叫，象沸汤的翻滚。形容社会动乱。","source":{"text":"咨妇女殷商，如蜩如螗，如沸如羹。","book":"《诗经·大雅·荡》"},"example":{"text":"上年资政院开议，竟至戟手漫骂，藐视朝廷。以辩给为通才，以横议为舆论，～，莫可究诘。","book":"《清史稿·陆润庠传》"},"similar":["蜩螗羹沸"],"usage":"作宾语、定语；指嘈杂喧闹"},{"id":39594,"word":"蜩螗羹沸","pinyin":"tiáo táng gēng fèi","abbr":"ttgf","explanation":"蜩螗：蝉；沸：沸腾。形容声音嘈杂喧闹，好像蝉噪、水滚、羹沸一样。比喻纷扰不宁。","source":{"text":"虽中原逐鹿，刘兴项仆，蜩螗羹沸，而彼一无所闻焉。","book":"梁启超《论美菲英杜之战事关系于中国》"},"similar":["蜩螗沸羹"],"usage":"作宾语、定语；指嘈杂喧闹"},{"id":39595,"word":"蜻蜓撼石柱","pinyin":"qīng tíng hàn shí zhù","abbr":"qthsz","explanation":"比喻不自量力。也比喻纹丝不动。","source":{"text":"这行者即去拿瓶，——唉，莫想拿得他动。好像似蜻蜓撼石柱，怎生摇得半分毫？","book":"明·吴承恩《西游记》第42回"},"example":{"text":"你不要干～般的傻事。"},"similar":["蚍蜉撼大树"],"usage":"作宾语、定语；指不自量力"},{"id":39596,"word":"蜻蜓点水","pinyin":"qīng tíng diǎn shuǐ","abbr":"qtds","explanation":"指蜻蜓在水面飞行时用尾部轻触水面的动作。比喻做事肤浅不深入。","source":{"text":"穿花蛱蝶深深见，点水蜻蜓款款飞。","book":"唐·杜甫《曲江》诗"},"example":{"text":"下乡只是～式的，还要带白馒头。","book":"郭小川《沉重的教训》"},"similar":["走马观花","浮光掠影"],"opposite":["脚踏实地","下马观花"],"usage":"作谓语、宾语、定语；指做事肤浅","story":["唐肃宗李亨时，杜甫当上八品言官“左拾遗”，因帮一个不该问罪的大臣说话而被李亨疏远，他很苦闷，到曲江边写诗散心。其中《曲江二首》中写道：“穿花蛱蝶深深见，点水蜻蜓款款飞。传语春光共流转，暂时相赏莫相违。”"]},{"id":39597,"word":"蝇利蜗名","pinyin":"yíng lì wō míng","abbr":"ylwm","explanation":"苍蝇头般的小利，蜗牛角样的细名。比喻微不足道的名利。","source":{"text":"回首蝇利蜗名，微官多误，自笑尘生袜。","book":"宋·卢炳《念奴娇》词"},"example":{"text":"明·汪廷讷《狮吼记·住锡》：“～镇日奔，生恶趣，苦客尘，胶胶扰扰只贪嗔。”"},"similar":["蜗名蝇利","蜗利蝇名","蝇名蜗利"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":39598,"word":"蝇名蜗利","pinyin":"yíng míng wō lì","abbr":"ymwl","explanation":"苍蝇头般微名，蜗牛角样的小利。比喻微不足道的名利。","source":{"text":"看这些蝇名蜗利，心肠热凭谁淘洗。","book":"明·陈汝元《金莲记·郊遇》"},"similar":["蜗利蝇名","蝇利蜗名","蜗名蝇利"],"usage":"作主语、宾语、定语；用于比喻句"},{"id":39599,"word":"蝇声蚓窍","pinyin":"yíng shēng yǐn qiào","abbr":"ysyq","explanation":"从蚯蚓孔发出像苍蝇一样的嗡嗡叫声。比喻声响微不足道。也比喻没有多大的才能。","source":{"text":"时于蚯蚓窍，微作苍蝇鸣。","book":"唐·轩辕弥明《石鼎联句》"},"example":{"text":"岂肯寄今人篱落下，效～之音，苟然相慕说也哉。","book":"清·钱谦益《牧斋初学集·南游草叙》"}},{"id":39600,"word":"蝇声蛙噪","pinyin":"yíng shēng wā zào","abbr":"yswz","explanation":"苍蝇、青蛙无休止地鸣叫。比喻低劣的、无病呻吟的诗文。","source":{"text":"所以生民伦常之道立，而其教遂亘古而弗衰，弘文宣化，如黄钟，如律吕，然他年则蝇声蛙噪耳。","book":"清·何汗敬《正教真诠·叙》"},"usage":"作宾语、定语；用于比喻句"},{"id":39601,"word":"蝇声蛙躁","pinyin":"yíng shēng wā zào","abbr":"yswz","explanation":"苍蝇、青蛙无休止地叫。比喻低劣的、无病呻吟的诗文。","source":{"text":"今也生乎百世之下，欲以其蝇声蛙躁，追配古人，俪然以李杜相命，浸假而膏唇拭舌，訾议其短长，蜉蝣撼大树，斯可为一笑已矣。","book":"清·钱谦益《〈范玺卿诗集〉序》"}},{"id":39602,"word":"蝇头小利","pinyin":"yíng tóu xiǎo lì","abbr":"ytxl","explanation":"比喻非常微小的利润。","source":{"text":"蜗角虚名，蝇头微利。","book":"宋·苏轼《满庭芳》"},"example":{"text":"但是它们算盘虽精，却忘了灵活应用，不知道得来一点～，而付出了难以估计的代价。","book":"白韵琴《贪》"},"similar":["蝇头微利"],"usage":"作主语、宾语；指小利"},{"id":39603,"word":"蝇头小楷","pinyin":"yíng tóu xiǎo kǎi","abbr":"ytxk","explanation":"像苍蝇头一般大小的楷体汉字。","source":{"text":"年八十余，尚能作蝇头小楷。","book":"清·钱泳《履园丛话·画学·画中人》"},"example":{"text":"冯玉祥《我的生活》第36章：“那时他已八、九十岁，……犹能作～。”"},"usage":"作宾语、定语；用于书写等"},{"id":39604,"word":"蝇头微利","pinyin":"yíng tóu wēi lì","abbr":"ytwl","explanation":"如同苍蝇头那样的小利。比喻非常微小的利润。","source":{"text":"蜗角虚名，蝇头微利。","book":"宋·苏轼《满庭芳》词"},"example":{"text":"只为～，抛却鸳被良缘。","book":"明·冯梦龙《古今小说》卷一"},"similar":["蝇头小利"],"usage":"作主语、宾语；指小利"},{"id":39605,"word":"蝇头蜗角","pinyin":"yíng tóu wō jiǎo","abbr":"ytwj","explanation":"苍蝇头，蜗牛角。比喻微小的名利。","source":{"text":"蝇头蜗角都休竞。万古豪华同一尽。","book":"宋·赵师侠《水调歌头》：“蝇头蜗角微利，争较一毫芒。”宋 ·刘清夫《玉楼春》词"},"example":{"text":"叹～空忙，受尽了许多风浪，转教人心旌遥飏。","book":"明·顾大典《青衫记·蛮素至江》"},"similar":["蜗角蝇头"],"usage":"作宾语、定语；多用于比喻句"},{"id":39606,"word":"蝇奔蚋集","pinyin":"yíng bèn ruì jí","abbr":"ybrj","explanation":"蚋：一种吸食人畜血液的昆虫。像苍蝇、蚋一样向有臭味、酸味的地方聚集。比喻许多人向一个有吸引力的地方集中。含贬义。","source":{"text":"当秦桧专国时，士大夫嗜进者蝇奔蚋集。","book":"元·戴表元《题方公删定家藏诸贤墨迹》"}},{"id":39607,"word":"蝇攒蚁聚","pinyin":"yíng cuán yǐ jù","abbr":"ycyj","explanation":"比喻人众多杂沓，聚集一处。同“蝇飞蚁聚”。","source":{"text":"今据尔等言明白，不过为此些些小事情，本来都是良百姓，只为着心坚奉佛神，要杀教主一个人，是以蝇攒蚁聚这般行。","book":"《天雨花》第十五回"},"similar":["蝇飞蚁聚"],"usage":"作宾语、状语；用于比喻句"},{"id":39608,"word":"蝇攒蚁附","pinyin":"yíng cuán yǐ fù","abbr":"ycyf","explanation":"犹蝇营蚁聚。比喻不顾谦耻，趋炎附势，到处钻营。","source":{"text":"那子春平时的一起宾客，闻得他自长安还后，带得好几万银子来，依旧做了财主，无不趋奉，似蝇攒蚁附一般，因而撺掇他重妆气象，再整风流。","book":"《醒世恒言·杜子春三入长安》"},"similar":["蝇营蚁聚","蝇集蚁附"],"usage":"作宾语、状语；用于比喻句"},{"id":39609,"word":"蝇粪点玉","pinyin":"yíng fèn diǎn yù","abbr":"yfdy","explanation":"点：斑点，引伸为污辱、玷污。苍蝇粪玷污了美玉。比喻坏人诬陷好人。","source":{"text":"青蝇一相点，白璧遂成冤。","book":"唐·陈子昂《宴胡楚真禁所》"},"example":{"text":"青蝇粪尤能败物，虽玉犹不免，所谓～是也。","book":"宋·陆佃《埤雅·释虫》"},"usage":"作宾语、定语；指坏事"},{"id":39610,"word":"蝇营狗苟","pinyin":"yíng yíng gǒu gǒu","abbr":"yygg","explanation":"营：谋求；苟：苟且偷生。比喻为了追逐名利，不择手段，象苍蝇一样飞来飞去，象狗一样的不识羞耻。","source":{"text":"蝇营狗苟，驱去复返。","book":"唐·韩愈《送穷文》"},"example":{"text":"假使是在军阀统治时代，一个作家要以～的态度，运动做官，运动当议员，那当然是值得反对的事。","book":"郭沫若《新文艺的使命》"},"similar":["禽兽不如"],"opposite":["光明磊落"],"usage":"作谓语、宾语、定语；指坏人","story":["唐朝时期，官场十分黑暗，贪污成风，一级盘剥一级，老百姓对之深恶痛绝，敢怒不敢言。人们把那些贪贿舞弊、争逐微利的卑劣人物称之为“蝇营”，令人讨厌。韩愈也看不惯这种现象，《送穷文》记载“朝悔其行，暮已复然，蝇营狗苟，驱去复返。”"]},{"id":39611,"word":"蝇营蚁聚","pinyin":"yíng yíng yǐ jù","abbr":"yyyj","explanation":"像苍蝇样往来飞逐，像蚂蚁般纷纷聚集。比喻不顾谦耻，趋炎附势，到处钻营。","source":{"text":"朝列，蝇营蚁聚还竞扰，这余膻怎污颊，算自有峰头玉版，鼎中金屑。","book":"明·梅鼎祚《玉合记·卜居》"},"similar":["蝇攒蚁附","蝇营蚁附"],"usage":"作宾语、状语；用于比喻句"},{"id":39612,"word":"蝇营蚁附","pinyin":"yíng yíng yǐ fù","abbr":"yyyf","explanation":"比喻不顾谦耻，趋炎附势，到处钻营。同“蝇营蚁聚”。","source":{"text":"吾以六十四之舅氏，主于其家，见彼蝇营蚁附之流，骇人耳闻。","book":"清·顾炎武《与潘次耕札》之二"},"similar":["蝇营蚁聚"],"usage":"作宾语、定语；用于比喻句"},{"id":39613,"word":"蝇营鼠窥","pinyin":"yíng yíng shǔ kuī","abbr":"yysk","explanation":"像蝇一样营营往来，像鼠一样四下窥伺。比喻到处钻营，贪婪无耻。","source":{"text":"手谈眼语，譸张万端，蝇营鼠窥，射利如蜮，吾见驵侩之于市井也，而今布之学校矣。","book":"明·吴承恩《贺学博未齐陶师膺奖序》"},"usage":"作宾语、定语；用于比喻句"},{"id":39614,"word":"蝇趋蚁附","pinyin":"yíng qū yǐ fù","abbr":"yqyf","explanation":"像苍蝇样往来飞逐，像蚂蚁般纷纷聚集。比喻许多人向一个有吸引力的地方集中。含贬义。","source":{"text":"申部残贼，充斥一隅，蝇飞蚁聚，攻州略地。","book":"《隋书·高祖纪》"},"example":{"text":"较之今日～，恋恋于势利之场者，大相远矣。","book":"清·西湖渔隐主人《欢喜冤家一回"}},{"id":39615,"word":"蝇附骥尾","pinyin":"yíng fù jì wěi","abbr":"yfjw","explanation":"骥：千里马。苍蝇因附在千里马的尾巴上。指普通人因沾了贤人的光而名声大振。","source":{"text":"伯夷叔齐虽贤，得夫子而名益彰。颜渊虽笃学，附骥尾而行益显。","book":"西汉·司马迁《史记·伯夷列传》"},"example":{"text":"～，岂须愁路贫。","book":"明·邵璨《香囊记·设祭》"},"usage":"作宾语、定语；指依附别人"},{"id":39616,"word":"蝇附骥尾而致千里","pinyin":"yíng fù jì wěi ér zhì qiān lǐ","abbr":"yfjwezql","explanation":"苍蝇因附在千里马的尾巴上而跑了千里的路程。普通人因沾了贤人的光而名声大振。","source":{"text":"伯夷叔齐虽贤，得夫子而名益彰。颜渊虽笃学，附骥尾而行益显。","book":"《史记·伯夷列传》"}},{"id":39617,"word":"蝇随骥尾","pinyin":"yíng suí jì wěi","abbr":"ysjw","explanation":"苍蝇附随在骐骥的尾巴上，便可腾飞千里。比喻依附于贤能或有名望者，必能得益。","source":{"text":"数蒙伯乐一顾之价，而苍蝇之飞，不过数步，即托骥尾，得以绝群。","book":"语出《后汉书·隗嚣传》"},"example":{"text":"你们得遇使君，今带汝同归乡郡。～，岂须愁路贫。","book":"明·邵璨《香囊记·设祭》"},"usage":"作宾语、定语；用于比喻句"},{"id":39618,"word":"蝇集蚁附","pinyin":"yíng jí yǐ fù","abbr":"yjyf","explanation":"犹蝇营蚁聚。比喻不顾谦耻，趋炎附势，到处钻营。","source":{"text":"暮夜乞怜者，莫不缘呈秀以进，蝇集蚁附，其门如市。","book":"《明史·阉党传·崔呈秀》"},"similar":["蝇营蚁聚","蝇攒蚁附"],"usage":"作宾语、状语；用于比喻句"},{"id":39619,"word":"蝇飞蚁聚","pinyin":"yíng fēi yǐ jù","abbr":"yfyj","explanation":"比喻人众多杂沓，聚集一处。","source":{"text":"申部残贼，充斥一隅，蝇飞蚁聚，攻州略地。","book":"《隋书·高祖纪上》"},"similar":["蝇攒蚁聚"],"usage":"作宾语、状语；用于比喻句"},{"id":39620,"word":"蝉不知雪","pinyin":"chán bù zhī xuě","abbr":"cbzx","explanation":"知了夏天生，秋天死，看不到雪。比喻人见闻不广。","source":{"text":"以所不睹不信人，若夏蝉不知雪坚。","book":"汉·桓宽《盐铁论·相刺》"},"example":{"text":"你真是～没有见识。"},"similar":["孤陋寡闻","蜀犬吠日"],"opposite":["见多识广"],"usage":"作宾语、定语；指人见闻不广"},{"id":39621,"word":"蝉喘雷干","pinyin":"chán chuǎn léi gān","abbr":"cclg","explanation":"蝉：昆虫名，知了；干：空。蝉喘息，雷声净。形容酷热干旱。","source":{"text":"蝉喘雷干冰井融，些子清风有何益。","book":"前蜀·贯休《苦热寄赤松道者》"},"usage":"作定语；指天热干旱"},{"id":39622,"word":"蝉翼为重，千钧为轻","pinyin":"chán yì wéi zhòng，qiān jūn wéi qīng","abbr":"cywzqjwq","explanation":"把蝉的翅膀看成是重的，三万斤的重量看成是亲轻的。喻指是非颠倒，真伪混淆。","source":{"text":"蝉翼为重，千钧为轻；黄钟毁弃，瓦釜雷鸣；谗人高张，贤士无名。","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"在那段是非混淆、腥风血雨、‘～’的日子里，某些老一辈革命家、劳动模范、科学家、艺术家受到的……","book":"秦牧《漫记端木蕻良》"},"similar":["本末倒置","颠倒是非"],"usage":"作主语、宾语、定语、分句；比喻是非混淆"},{"id":39623,"word":"蝉联往复","pinyin":"chán lián wǎng fù","abbr":"clwf","explanation":"蝉联：连续相承。接连不断地反复重演。","source":{"text":"故扰乱之种子不除，则蝉联往复之破坏，终不可得免。","book":"梁启超《新民说》"},"similar":["循环往复"],"usage":"作定语、状语；用于事物等"},{"id":39624,"word":"蝉联蚕绪","pinyin":"chán lián cán xù","abbr":"clcx","explanation":"蝉联：连续相承；绪：丝头。比喻连接相承。","source":{"text":"昔如来以正法眼藏授大迦叶，蝉联蚕绪，以传于今。","book":"宋·沈辽《序》"},"usage":"作宾语、定语；用于事物等"},{"id":39625,"word":"蝉脱浊秽","pinyin":"chán tuō zhuó huì","abbr":"ctzh","explanation":"蝉脱：蝉蜕皮。比喻摆脱了污浊的环境。","source":{"text":"蝉脱于浊秽，以浮游尘埃之外。","book":"《史记·屈原贾生列传》"}},{"id":39626,"word":"蝉腹龟肠","pinyin":"chán fù guī cháng","abbr":"cfgc","explanation":"古人认为蝉只须饮露，乌龟只要喝水。比喻饥饿之极。","source":{"text":"珪诉虔求禄不得，与僧虔书曰：‘蝉腹龟蛇，为日已久’","book":"《南史·檀珪传》"},"example":{"text":"早已弃微官，～亦自宽。","book":"清·叶鸣鸾《南乡子·湫水暮春》"},"usage":"作谓语、定语；比喻挨饿或穷困"},{"id":39627,"word":"蝉蜕蛇解","pinyin":"chán tuì shé jiě","abbr":"ctsj","explanation":"蝉蜕：幼蝉化为成蝉时所脱下的皮；解：脱。蝉脱壳，蛇换皮。比喻解脱而进入更高境界。","source":{"text":"若此人者，抱素守精，蝉蜕蛇解，游于太清，轻举独往。","book":"西汉·刘安《淮南子·精神训》"},"similar":["蝉蜕龙变"],"usage":"作宾语、定语；用于变化"},{"id":39628,"word":"蝉蜕龙变","pinyin":"chán tuì lóng biàn","abbr":"ctlb","explanation":"蝉蜕：幼蝉化为成蝉时所脱下的皮。比喻解脱而进入更高境界。","source":{"text":"蝉蜕龙变，弃俗登仙。","book":"晋·夏侯湛《序》"},"similar":["蝉蜕蛇解"],"usage":"作宾语、定语；用于变化"},{"id":39629,"word":"蝉衫麟带","pinyin":"chán shān lín dài","abbr":"csld","explanation":"薄纱制的衣服，有文采的衣带。旧时形容服饰华丽。","source":{"text":"蝉衫麟带压愁香，偷得莺簧锁金缕。","book":"唐·温庭筠《舞衣曲》"},"usage":"作宾语、定语；用于人的衣着"},{"id":39630,"word":"蝎蝎螫螫","pinyin":"xiē xiē zhē zhē","abbr":"xxzz","explanation":"形容人婆婆妈妈，在小事情上过分地表示关心、怜惜。","source":{"text":"晴雯忙回身进来，笑道：‘那里就吓死他了？偏惯会这么蝎蝎螫螫老婆子的样儿。’","book":"清·曹雪芹《红楼梦》第五十一回"},"example":{"text":"曾朴《孽海花》第16回：“别给我～的，那些个狼心猪肺狗肚肠，打量咱们照不透吗？”"},"similar":["婆婆妈妈"],"opposite":["干脆利落"],"usage":"作定语；指人婆婆妈妈"},{"id":39631,"word":"蝟缩蠖屈","pinyin":"wèi suō huò qū","abbr":"wshq","explanation":"蝟：同“猬”，刺猬；蠖：尺蠖。像刺猬一样把身子缩起来，像尺蠖一样把身体弯起来。比喻畏惧到极点。","source":{"text":"乃跼蹐四足，引绳而束缚之，下首至尾，曲脊掩胡，蝟缩蠖屈，蛇盘龟息，以听命先生。","book":"明·纪中锡《中山狼传》"}},{"id":39632,"word":"蝮蛇螫手，壮士解腕","pinyin":"fù shé shì shǒu，zhuàng shì jiě wàn","abbr":"fssszsjw","explanation":"手腕被腹蛇咬伤，便立即截断，以免毒液延及全身，危及生命。比喻事到紧要关头，必须下决心当机立断。也比喻牺牲局部，照顾全局。","source":{"text":"古人有言，蝮蛇螯手，壮士解其腕。","book":"《三国志·魏书·陈泰传》"},"example":{"text":"～，英雄作事不顾小名小义，今贪能容之虚名，受诛夷之实祸，还恐噬脐无及。","book":"《隋唐演义》第四十六回"},"similar":["蝮螫解腕"],"usage":"作分句；比喻牺牲局部，照顾全局"},{"id":39633,"word":"蝮螫解腕","pinyin":"fù shì jiě wàn","abbr":"fsjw","explanation":"螫：蜂螫；解：放弃。手腕被蝮蛇咬伤，应立即截断，以免危及生命。比喻面临危险，必须弃小求大。","source":{"text":"二公明此机，死守誓不变。虽危所保大，如腹螫解腕。","book":"元·王恽《双庙怀古》诗"},"similar":["蝮蛇螫手，壮士解腕"],"usage":"作比喻、定语；用于处事"},{"id":39634,"word":"蝶乱蜂狂","pinyin":"dié luàn fēng kuáng","abbr":"dlfk","explanation":"飞舞游戏的蝴蝶和蜜蜂。后用以比喻浪荡子弟。","source":{"text":"乱蝶狂蜂俱有意，兔葵燕麦自无知。","book":"宋·吕本中《春日即事》"}},{"id":39635,"word":"蝶使蜂媒","pinyin":"dié shǐ fēng méi","abbr":"dsfm","explanation":"比喻传递信息者或男女双方情爱的媒介。","source":{"text":"蝶使蜂媒传客恨，莺梭柳线织春愁。","book":"宋·朱淑真《恨春》诗之四"},"example":{"text":"莺喉燕态，尽属奇观；～，都归大雅。","book":"清·张潮《〈板桥杂记〉小引》"},"usage":"作宾语、定语；指媒介"},{"id":39636,"word":"蝶化庄周","pinyin":"dié huà zhuāng zhōu","abbr":"dhzz","explanation":"比喻事物的虚幻无常。同“蝶化庄生”。","source":{"text":"昔者庄周梦为胡蝶，栩栩然胡蝶也，自喻适志与！不知周也。俄然觉，则蘧蘧然周也。不知周之梦为胡蝶与，胡蝶之梦为周与？","book":"典出《庄子·齐物论》"},"example":{"text":"鹿随郑相应难辨，～未可知。","book":"明·兰陵笑笑生《金瓶梅词话》第九十四回"},"similar":["蝶化庄周"],"usage":"作宾语、定语；用于感叹人生","story":["战国时期，著名的哲学家庄周常在《庄子》中讲寓言故事，借以说明自己的哲学观点。其中《庄生梦蝶》寓言就描绘他自己梦见变成一只蝴蝶，欣然自得，轻松舒畅地自由飞翔，完全忘记人世间的烦恼。梦醒后一直栩栩如生浮现在眼前"]},{"id":39637,"word":"蝶化庄生","pinyin":"dié huà zhuāng shēng","abbr":"dhzs","explanation":"比喻事物的虚幻无常。","source":{"text":"昔者庄周梦为胡蝶，栩栩然胡蝶也，自喻适志与！不知周也。俄然觉，则蘧蘧然周也。不知周之梦为胡蝶与，胡蝶之梦为周与？","book":"《庄子·齐物论》"},"example":{"text":"鹿疑郑相终难辨，～讵可知。","book":"唐·白居易《疑梦》诗之二"},"similar":["庄生化蝶"],"usage":"作宾语、定语；用于感叹人生","story":["战国时期，哲学家庄周常在《庄子》中讲寓言故事，借以说明自己的哲学观点。其中《庄生梦蝶》寓言就描绘他自己梦见变成一只蝴蝶，欣然自得，轻松舒畅地自由飞翔，完全忘记人世间的烦恼。梦醒后一直栩栩如生浮现在眼前"]},{"id":39638,"word":"蝶怨蛩凄","pinyin":"dié yuàn qióng qī","abbr":"dyqq","explanation":"比喻哀怨凄清的思家之情。","source":{"text":"蝶怨蛩凄书不尽，只封将泪点教君寄。","book":"清·孙麟趾《金缕曲·定庵将归托寄家书赋此送别》词"},"usage":"作比喻、定语；用于比喻句"},{"id":39639,"word":"蝶恋蜂狂","pinyin":"dié liàn fēng kuáng","abbr":"dlfk","explanation":"指留恋繁花似锦的春光。","source":{"text":"知否，算蝶恋蜂狂，少不得为韶光一逗溜。","book":"明·张凤翼《灌园记·太史赏花》"},"usage":"作状语、定语；形容春天"},{"id":39640,"word":"蝶意莺情","pinyin":"dié yì yīng qíng","abbr":"dyyq","explanation":"比喻爱恋春色的情意。","source":{"text":"［张靖之］《念奴娇》云：‘清明天气，叹三分春色，二分僝骤，蝶意莺情留恋处，还在余花剩柳。’","book":"明·陈霆《渚山堂词话》卷三"},"usage":"作宾语、定语；多用于比喻句"},{"id":39641,"word":"蝶粉蜂黄","pinyin":"dié fěn fēng huáng","abbr":"dffh","explanation":"指古代妇女粉面额黄，妆扮美容。","source":{"text":"何处拂胸资蝶粉，几时涂额藉蜂黄。","book":"唐·李商隐《酬崔八早梅有赠兼示之作》"},"example":{"text":"～拌付与，浅颦深笑总难知，教人何处忏情痴。","book":"清·徐钇《词苑丛谈·叶元礼〈浣溪沙〉》"},"usage":"作谓语、状语；用于形容女人"},{"id":39642,"word":"蝼蚁之诚","pinyin":"lóu yǐ zhī chéng","abbr":"lyzc","explanation":"蝼蚁：蝼蛄和蚂蚁，比喻力量微小或地位低微的人。自谦微诚之辞。","example":{"text":"我以～作保，他不会再干那样的事情了。"},"usage":"作宾语；用于自谦"},{"id":39643,"word":"蝼蚁得志","pinyin":"lóu yǐ dé zhì","abbr":"lydz","explanation":"蝼蚁：蝼蛄和蚂蚁。比喻小人得势。","source":{"text":"海大鱼，网弗能止也，钓弗能牵也，荡而失水，则蝼蚁皆得志焉。","book":"《战国策·齐策一》：“君不闻大鱼乎？网不能止，钩不能牵，荡而失水，则蝼蚁得意焉。”《淮南子·人间训》"},"example":{"text":"小心他～，骑到人民头上作威作福"},"similar":["小人得志"],"usage":"作宾语、定语；用于比喻句"},{"id":39644,"word":"蝼蚁贪生","pinyin":"lóu yǐ tān shēng","abbr":"lyts","explanation":"蝼蚁：蝼蛄和蚂蚁。蝼蛄和蚂蚁那样的小虫也贪恋生命。旧指乞求活命的话，有时也用以劝人不可轻生自杀。","source":{"text":"万望大圣慈悲，可怜蝼蚁贪生之意，饶了我命，愿送你师父过山。","book":"明·吴承恩《西游记》第七十六回"},"usage":"作宾语、定语；用于劝诫人"},{"id":39645,"word":"融为一体","pinyin":"róng wéi yī tǐ","abbr":"rwyt","explanation":"融合为整体。比喻几种事物关系密切，配合自然，如同一个整体。","source":{"text":"有一体之治，故能出号令，明宪法矣。","book":"先秦·管仲《管子·七法》"},"example":{"text":"路遥《平凡的世界》第三卷第23章：“尽管她仍然保持着自己的个性，但基本上和新的环境～。”"},"similar":["难解难分","如胶似漆"],"opposite":["方柄圆凿"],"usage":"作谓语、定语；用于事物之间的关系密"},{"id":39646,"word":"融会贯通","pinyin":"róng huì guàn tōng","abbr":"rhgt","explanation":"把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"郑板桥学习任何东西，都在继承优秀传统的基础上融汇贯通，发扬创造性。","book":"秦牧《艺海拾贝·独创一格》"},"example":{"text":"孙犁《后记》：“这种激情，虽然基于作者当时迫切的抗日要求，但还没有多方面和广大群众的伟大的复杂的抗日生活～。”"},"similar":["举一反三","豁然贯通"],"opposite":["望文生义","生吞活剥","囫囵吞枣"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":39647,"word":"融会通浃","pinyin":"róng huì tōng jiā","abbr":"rhtj","explanation":"把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"已而遍观诸书，博求百家，融会通浃，天文、地理、象数、异书，无不该极。","book":"宋·叶適《司农卿湖广总领詹公墓志铭》"},"similar":["融会贯通","融释贯通"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":39648,"word":"融合为一","pinyin":"róng hé wéi yī","abbr":"rhwy","explanation":"渗透整个物体，合为一个整体。","example":{"text":"少数民族文化与中原文化逐渐～。"},"similar":["融为一体"],"usage":"作谓语；指融为一体"},{"id":39649,"word":"融汇贯通","pinyin":"róng huì guàn tōng","abbr":"rhgt","explanation":"融汇：融合；贯通：透彻理解。把各方面的知识和道理融化汇合，得到全面透彻的理解","source":{"text":"郑板桥学习任何东西，都在继承优秀传统的基础上融汇贯通，发扬创造性。","book":"秦牧《艺海拾贝·独创一格》"},"similar":["融会贯通","融释贯通"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":39650,"word":"融洽无间","pinyin":"róng qià wú jiàn","abbr":"rqwj","explanation":"融合而没有隔阂抵触。","source":{"text":"他的哲学的所谓‘森林哲学’，应当与自然融洽无间的。","book":"瞿秋白《文艺杂著·弟弟的信》"},"example":{"text":"少祥没想到，一年到头～的伙伴，就在新年和旧年交替的时候闹了个不痛快。","book":"草明《乘风破浪》十九"},"similar":["亲密无间"],"usage":"作谓语、定语、状语；指关系密切"},{"id":39651,"word":"融液贯通","pinyin":"róng yè guàn tōng","abbr":"rygt","explanation":"犹融会贯通。把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"殆于圣贤之义理，心领神会，融液贯通，然后参之经史子集，以发其光华，范之规矩准绳，以密其法律，而后乃称为文。","book":"清·秦笃辉《平书·文艺下》"},"similar":["融释贯通"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":39652,"word":"融融泄泄","pinyin":"róng róng xiè xiè","abbr":"rrxx","explanation":"形容大家在一起融洽愉快。","source":{"text":"公入而赋：‘大隧之中，其乐也融融。’姜出而赋：‘大隧之外，其乐也泄泄。’","book":"春秋·鲁·左丘明《左传·隐公元年》"},"similar":["融融洩洩"],"usage":"作谓语、定语；指融洽","story":["春秋时期，郑武公死后由大儿子寤生继位成郑庄公，他听信母后的要求将京城封给弟弟共叔段。段仗着母后的宠信想起兵造反。郑庄公派兵镇压，他恨母后武姜说到黄泉才能相见，后悔话说得太绝，命人挖地道去见母后，两人心头都融融泄泄"]},{"id":39653,"word":"融释贯通","pinyin":"róng shì guàn tōng","abbr":"rsgt","explanation":"把各方面的知识和道理融化汇合，得到全面透彻的理解。","source":{"text":"世苟有通学古之士，潜心冥会，融释贯通，其于程朱继志述事，能补其所未及，是亦程朱之功臣也。","book":"清·戴名世《〈读易质疑〉序》"},"similar":["融会贯通","融液贯通"],"usage":"作谓语、定语、宾语；用于学习或思想"},{"id":39654,"word":"螓首蛾眉","pinyin":"qín shǒu ér méi","abbr":"qsem","explanation":"螓：蝉的一种。螓首：额广而方；蛾眉：眉细而长。宽宽的额头，弯弯的眉毛。形容女子容貌美丽。","source":{"text":"螓首蛾眉，巧笑倩兮，美目盼兮。","book":"《诗经·卫风·硕人》"},"example":{"text":"想杀我龙肝凤髓；害杀我～。","book":"元·王子一《误入桃源》第三折"},"usage":"作宾语、定语；用于女性"},{"id":39655,"word":"螟蛉之子","pinyin":"míng líng zhī zǐ","abbr":"mlzz","explanation":"螟蛉：绿色小虫，寄生蜂蜾赢常捕捉螟蛉，产卵在它们身体里，卵孵化后就拿螟蛉作食物。比喻义子。","source":{"text":"螟蛉有子，蜾赢负之。","book":"《诗经·小雅·小宛》"},"example":{"text":"周侗年迈，巴不得将平生一十八般武艺，尽心传授与螟蛉之子。","book":"清·钱彩《说岳全传》"},"usage":"作宾语；指义子"},{"id":39656,"word":"螫手解腕","pinyin":"shì shǒu jǐe wǎn","abbr":"ssjw","explanation":"比喻为了顾全大局而忍痛牺牲局部。","source":{"text":"蝮螫手则斩手，螫足则斩足。何干？为害于身也。","book":"《史记·田儋列传》"},"example":{"text":"王旅未接，死亡交急，遂求援关中，自救目前。臣既不安于高氏，岂见客于宇文！但～，事不得已，本图为国，愿不赐咎！","book":"《资治通鉴·梁武帝太清元年》"},"usage":"作宾语、定语；用于比喻句"},{"id":39657,"word":"螭魅罔两","pinyin":"chī mèi wǎng liǎng","abbr":"cmwl","explanation":"螭：通“魑”，古代传说中山泽的鬼怪妖精。比喻各种各样的坏人。","source":{"text":"螭魅罔两，莫能逢之。","book":"春秋·鲁·左丘明《左传·宣公三年》"},"example":{"text":"王孙满之～，莫能逢之，言川泽山林也。","book":"清·黄宗羲《七怪》"},"similar":["魑魅魍魉","螭魅魍魉"],"usage":"作主语、宾语、定语；用于书面语"},{"id":39658,"word":"螭魅魍魉","pinyin":"chī mèi wǎng liǎng","abbr":"cmwl","explanation":"螭：通“魑”，古代传说中山泽的鬼怪妖精。比喻各种各样的坏人。","source":{"text":"螭魅魍魉，莫能逢旃。","book":"汉·张衡《西京赋》"},"similar":["魑魅魍魉"],"usage":"作主语、宾语、定语；用于书面语"},{"id":39659,"word":"螳臂当车","pinyin":"táng bì dāng chē","abbr":"tbdc","explanation":"当：阻挡。螳螂举起前肢企图阻挡车子前进。比喻做力量做不到的事情，必然失败。","source":{"text":"汝不知夫螳螂乎，怒其臂以当车辙，不知其不胜任也。","book":"《庄子·人间世》"},"example":{"text":"谁知腹中虽离渊博尚远，那目空一切，旁若无人光景，却处处摆在脸上。可谓“～，自不量力。”","book":"清·李汝珍《镜花缘》第十八回"},"similar":["自不量力","泰山压卵"],"opposite":["量力而行"],"usage":"作谓语、宾语、定语；指自不量力","story":["春秋时期，卫灵公请鲁国贤士颜阖做大公子蒯目贵的老师。蒯目贵是一个生性残暴、胡作非为的人，根本不听颜阖的教导。颜阖去向蘧伯玉大夫讨教。蘧伯玉告诉他不能过分迁就他，但也不能得罪他，否则会像螳臂当车一样粉身碎骨"]},{"id":39660,"word":"螳臂当辕","pinyin":"táng bì dāng yuán","abbr":"tbdy","explanation":"螳臂：螳螂的前腿；当：阻挡；辕：借指车。比喻自不量力做力量做不到的事情，必然失败","source":{"text":"势弱难敌，谓之螳臂当辕；人生易死，乃曰蜉蝣在世。","book":"明·程登吉《幼学琼林》第四卷"},"similar":["螳臂当车"],"usage":"作谓语、宾语、定语；指自不量力"},{"id":39661,"word":"螳臂当辙","pinyin":"táng bì dāng zhé","abbr":"tbdz","explanation":"比喻自不量力，招致失败。同“螳臂当车”。","source":{"text":"螳臂当辙横，怒蛙致凭轼。","book":"明·蒋一葵《长安客话·斗促织》"},"similar":["螳臂扼辙","螳螂拒辙"],"usage":"作宾语、定语；指自不量力"},{"id":39662,"word":"螳臂扼辙","pinyin":"táng bì è zhé","abbr":"tbez","explanation":"比喻做力量做不到的事情，必然失败。同“螳臂当车”。","source":{"text":"是知真人之兴，非英雄所凯，况非英雄乎！人臣之谬思乱者，乃螳臂扼辙耳。","book":"宋·王谠《唐语林·补遗一》"},"similar":["螳臂当辙","螳臂当车"],"usage":"作宾语、定语；指自不量力"},{"id":39663,"word":"螳臂挡车","pinyin":"táng bì dǎng chē","abbr":"tbdc","explanation":"比喻自不量力，招致失败。同“螳臂当车”。","source":{"text":"武汉义师之崛起也，以一隅而待北方数省之兵，盖有螳臂挡车之势，危莫甚焉。","book":"李一《荆宜施鹤光复记》"},"example":{"text":"飞蛾扑火，～，最终逃脱不了灭亡的命运。","book":"白桦《梅园青松·周总理您在亿万人民心中永生》诗"},"similar":["螳臂当车","螳臂当辙"],"usage":"作宾语、定语；指自不量力"},{"id":39664,"word":"螳臂自雄","pinyin":"táng bì zì xióng","abbr":"tbzx","explanation":"螳螂奋举腿臂想去阻挡车轮。比喻自不量力，狂妄自大。","source":{"text":"若螳臂自雄，鹅痴不逊，天兵一下，玉石俱焚。","book":"清·褚人获《隋唐演义》第82回"},"usage":"作宾语、定语；用于处事"},{"id":39665,"word":"螳螂奋臂","pinyin":"táng láng fèn bì","abbr":"tlfb","explanation":"犹螳臂当车。比喻做力量做不到的事情，必然失败。","source":{"text":"将怜其蚌蛤剖胎，只自回旋于皎月；螳螂奋臂无辞殒碎于高车。","book":"唐·黄滔《谢试官启》"},"example":{"text":"却乃提一旅之师，抗百万之众，何异～，羊豚鼓鬣。","book":"明·徐复祚《投梭记·却说》"},"similar":["螳臂挡车"],"usage":"作宾语、定语；指自不量力"},{"id":39666,"word":"螳螂拒辙","pinyin":"táng láng jù zhé","abbr":"tljz","explanation":"犹螳臂当车。比喻做力量做不到的事情，必然失败。","source":{"text":"乃其申诰誓，降移檄，便称其智昏菽麦，识昧玄黄，列宅建都若鹪鹩之巢苇，临戎贾勇犹螳臂之拒辙。此所谓厚颜也。","book":"唐·刘知幾《史通·载文》"}},{"id":39667,"word":"螳螂捕蛇","pinyin":"táng láng bǔ shé","abbr":"tlbs","explanation":"形容只要方法得当，敢于斗争，以弱制强。","source":{"text":"则一螳螂据顶上，以刺刀攫其首，攧不可去。久之，蛇竟死。","book":"清·蒲松龄《聊斋志异·螳螂捕蛇》"},"example":{"text":"～并不是不可能的事情。"},"usage":"作宾语、定语；指以弱制强","story":["古时张某在山崖边路过，见一条碗口粗的大蛇在树丛中摆来摆去，尾巴把树枝都打断了，他仔细观察，一只小螳螂爬在巨蛇的头顶上，用一对刺刀般锋利的前腿抓着蛇的脑袋不放，任凭大蛇折腾也不松开，后来大蛇居然死去"]},{"id":39668,"word":"螳螂捕蝉","pinyin":"táng láng bǔ chán","abbr":"tlbc","explanation":"蝉：知了。螳螂捉蝉，不知潜在危险。比喻目光短浅。","source":{"text":"螳螂捕蝉，志在有利，不知黄雀在后啄之。","book":"汉·赵晔《吴越春秋》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“小狗子哪知道‘～，黄雀在后’，听得声音，转脸来看。”"},"similar":["鼠目寸光","急功近利"],"opposite":["瞻前顾后"],"usage":"作宾语、定语；指人目光短浅","story":["春秋时期，吴王寿梦要攻打楚国，并禁止大臣提反对意见，有一个大臣的儿子听说后，带上弹弓到王宫花园去打鸟。吴王问他干什么，他说在看螳螂捕树上的蝉，而黄雀在后面等着吃螳螂。吴王觉得自己的处境同螳螂差不多，就只好取消计划"]},{"id":39669,"word":"螳螂捕蝉，黄雀在后","pinyin":"táng láng bǔ chán，huáng què zài hòu","abbr":"tlbchqzh","explanation":"螳螂正要捉蝉，不知黄雀在它后面正要吃它。比喻目光短浅，只想到算计别人，没想到别人在算计他。","source":{"text":"螳螂方欲食蝉，而不知黄雀在后，举其颈欲啄而食之也。","book":"《庄子·山木》：“睹一蝉，方得美荫而忘其身，螳螂执翳而搏之，见得而忘其形；异鹊从而利之，见利而忘其真。”汉·韩婴《韩诗外传》"},"example":{"text":"你们不可以打边区。“鹬蚌相持，渔人得利”，“～”，这两个故事，是有道理的。","book":"毛泽东《质问国民党》"},"similar":["一物降一物"],"usage":"作宾语、分句；指人目光短浅","story":["春秋时期，吴王寿梦要攻打楚国，并禁止大臣提反对意见，有一个大臣的儿子听说后，带上弹弓到王宫花园去打鸟。吴王问他干什么，他说在看螳螂捕树上的蝉，而黄雀在后面等着吃螳螂。吴王觉得自己的处境同螳螂差不多，就只好取消计划"]},{"id":39670,"word":"螳螂黄雀","pinyin":"táng láng huáng què","abbr":"tlhq","explanation":"比喻目光短浅，只见眼前利益而不顾后患。“螳螂捕蝉，黄雀在后”的略语。","source":{"text":"打虎功思悬赏，杀人身被官拿，试看螳螂黄雀，劝君得意休夸。","book":"明·施耐庵《水浒传》第四十三回"},"similar":["螳螂捕蝉，黄雀在后"],"usage":"作宾语、定语；用于比喻句"},{"id":39671,"word":"螽斯之庆","pinyin":"zhōng sī zhī qìng","abbr":"zszq","explanation":"螽斯：昆虫名，产卵极多；衍：延续；庆：喜庆。旧时用于祝颂子孙众多。","source":{"text":"螽斯羽，诜诜兮。","book":"《诗经·周南·螽斯》"},"example":{"text":"陛下春秋鼎盛，～未艾，椒聊之实必蕃。（宋·刘克庄《转对札子》）"}},{"id":39672,"word":"螽斯之征","pinyin":"zhōng sī zhī zhēng","abbr":"zszz","explanation":"螽斯：昆虫名，产卵极多；征：征兆。指子孙众多的征兆。","source":{"text":"臣愚以为可妙简淑媛，以备内宫之数，其余尽遣还家。且以育精养神，专静为宝。如此，则螽斯之征，可庶而致矣。","book":"《三国志·魏志·高柔传》"}},{"id":39673,"word":"螽斯衍庆","pinyin":"zhōng sī yǎn qìng","abbr":"zsyq","explanation":"螽斯：昆虫名，产卵极多；衍：延续；庆：喜庆。旧时用于祝颂子孙众多。","source":{"text":"螽斯羽，诜诜兮。","book":"《诗经·周南·螽斯》"},"similar":["儿孙满堂"],"usage":"作谓语；用于祝颂子孙众多"},{"id":39674,"word":"螽斯诜诜","pinyin":"zhōng sī shēn shēn","abbr":"zsss","explanation":"螽斯：昆虫；诜诜：形容众多。用以祝贺子孙众多。","source":{"text":"螽斯羽，诜诜兮。","book":"《诗经·周南·螽斯》"}},{"id":39675,"word":"蟒袍玉带","pinyin":"mǎng páo yù dài","abbr":"mpyd","explanation":"绣有蟒蛇的长袍，饰有玉石的腰带。指官服，也指传统戏曲中帝王将相的服装。亦作“蟒衣玉带”。","source":{"text":"又故意把蟒袍玉带、锦绣幞头之类放在面前，金银、彩币、锦绣堆积如山。","book":"明·周楫《西湖二集·觉闍黎一念错投胎》"},"example":{"text":"但见高卷帘栊，正面一张太师椅上，坐着一位束发金冠、～的王爷，两边有多少内辅伺候。","book":"清·石玉昆《三侠五义》第十七回"},"usage":"作宾语、定语；用于书面语"},{"id":39676,"word":"蟠天际地","pinyin":"pán tiān jì dì","abbr":"ptjd","explanation":"蟠：遍及；际：到。指从天到地无所不在。形容气势博大。","source":{"text":"精神四达并流，无所不极，上际于天，下蟠于地。","book":"战国·宋·庄周《庄子·刻意》"},"example":{"text":"～能几时，万恨沉埋向谁咎？","book":"清·龚自珍《京师春尽夕吴舍人》诗"},"similar":["极天际地"],"usage":"作宾语、定语；用于书面语"},{"id":39677,"word":"蟠木朽株","pinyin":"pán mù xiǔ zhū","abbr":"pmxz","explanation":"株：树根。盘曲之木，朽烂的根。比喻无用之材。","source":{"text":"宾王蟠木朽株，散欐贱质，墙面难用，灰心易寒。","book":"唐·骆宾王《上李少·常伯启》"},"similar":["槃木朽株"],"usage":"作主语、宾语、定语；指劣材"},{"id":39678,"word":"蟠根错节","pinyin":"pán gēn cuò jié","abbr":"pgcj","explanation":"错：交错；节：枝节。树木的根盘屈，枝节交错。比喻事情的艰难复杂。","source":{"text":"然君以为章句细微，无关重轻，所贵乎学者，必当为世所倚仗，蟠根错节，取定俄顷。","book":"清·黄宗羲《赠编修弁玉吴君墓志铭》"},"similar":["盘根错节","槃根错节"],"usage":"作谓语、宾语、定语；比喻事情复杂"},{"id":39679,"word":"蟠龙卧虎","pinyin":"pán lóng wò hǔ","abbr":"plwh","explanation":"踞：蹲或坐。像盘曲的蛟龙，像蹲卧的猛虎。形容地势雄伟险要。","source":{"text":"蟠龙卧虎高山顶，万丈高楼从地起。","book":"贾芝《颂歌·万丈高楼从地起》"},"similar":["蟠龙踞虎"],"usage":"作谓语、定语；指地势险要"},{"id":39680,"word":"蟠龙踞虎","pinyin":"pán lóng jù hǔ","abbr":"pljh","explanation":"踞：蹲或坐。像盘曲的蛟龙，像蹲卧的猛虎。形容地势雄伟险要。","source":{"text":"是日风曀望建业江山蟠龙踞虎之状，皆依约而得之。","book":"宋·秦观《游汤泉记》"},"similar":["龙蟠虎踞","蟠龙卧虎"],"usage":"作谓语、定语；指地势险要"},{"id":39681,"word":"蟪蛄不知春秋","pinyin":"huì gū bù zhī chūn qiū","abbr":"hgbzcq","explanation":"蟪蛄：蝉的一种，也叫寒蝉、伏天儿，春生夏死，夏生秋死，因此知春而不知秋，知秋则不知春。比喻见识短浅。","source":{"text":"朝菌不知晦朔，蟪蛄不知春秋。","book":"《庄子·逍遥游》"}},{"id":39682,"word":"蟹匡蝉緌","pinyin":"xiè kuāng chán ruí","abbr":"xkcr","explanation":"匡：背壳；緌：蝉的针吻。比喻名是实非，两不相干。","source":{"text":"成人有其兄弟而不为衰者，闻子皋将为成宰，遂为衰。成人曰：‘蚕则绩而蟹有匡，范则冠而蝉有緌；兄则死而子皋为之衰。’","book":"西汉·戴圣《礼记·檀公下》"},"example":{"text":"乃知～，不独成人之弟也。","book":"《东坡志林》第二卷"},"usage":"作宾语、定语；指名不副实"},{"id":39683,"word":"蟹将虾兵","pinyin":"xiè jiàng xiā bīng","abbr":"xjxb","explanation":"古代神怪小说里海龙王手下的兵将。比喻敌人的爪牙或不中用的大小娄罗。","source":{"text":"东海龙王敖广即忙起身,与龙子龙孙、虾兵蟹将出宫。","book":"明·吴承恩《西游记》第三回"},"similar":["虾兵蟹将"],"usage":"作主语、宾语、定语；指不中用的大小娄罗"},{"id":39684,"word":"蟹慌蟹乱","pinyin":"xiè huāng xiè luàn","abbr":"xhxl","explanation":"指虾蟹成灾，将稻谷荡尽。旧因以为兵乱的征兆。现多形容乱作一团。","source":{"text":"吴俗有虾荒蟹乱之语，盖取其被甲执锐，岁或暴至，则乡人用以为兵证也。","book":"宋·傅肱《蟹谱·兵证》"},"example":{"text":"大德丁未，吴中蟹卮如蝗，平田皆满，稻谷荡尽，吴谚有～之说，正谓此也。","book":"元·高德基《平江记事》"}},{"id":39685,"word":"蟹荒蟹乱","pinyin":"xiè huāng xiè luàn","abbr":"xhxl","explanation":"荒：灾荒。虾蟹太多，稻谷遭殃。指兵荒马乱的征兆。","source":{"text":"大德丁未，吴中蟹厄如蝗，平田皆满，稻谷荡尽。吴谚有蟹荒蟹乱之说，正谓此也。","book":"元·高德基《平江纪事》"},"similar":["虾荒蟹乱"],"usage":"作定语、状语；用于比喻句"},{"id":39686,"word":"蟾宫扳桂","pinyin":"chán gōng pān guì","abbr":"cgbg","explanation":"蟾宫：指月宫。科举时代比喻应试及第。","source":{"text":"蟾宫扳桂折高枝，书香还有继，天道岂无知。","book":"明·谢谠《四喜记·乡荐荣欢》"},"similar":["蟾宫折桂"],"usage":"作谓语、定语；比喻考试得中"},{"id":39687,"word":"蟾宫折桂","pinyin":"chán gōng zhé guì","abbr":"cgzg","explanation":"蟾宫：月宫。攀折月宫桂花。科举时代比喻应考得中。","source":{"text":"武帝于东堂会送，问诜曰：‘卿自以为如何？’诜对曰：‘臣鉴贤良对策，为天下第一，犹桂林之一枝，昆山之片玉。’","book":"《晋书·郤诜传》"},"example":{"text":"只要吴刚老爹修桂树的玉斧砍下一枝半枝，肯赐给我们老爷，我们老爷就可以中举，名叫～。","book":"清·曾朴《孽海花》第五回"},"similar":["金榜题名"],"opposite":["名落孙山"],"usage":"作谓语、定语；比喻考试得中","story":["晋武帝泰始年间，吏部尚书崔洪举荐郤诜当左丞相。后来郤诜当雍州刺史，晋武帝问他的自我评价，他说：“我就像月宫里的一段桂枝，昆仑山上的一块宝玉。”晋武帝大笑并嘉许他"]},{"id":39688,"word":"蠕蠕而动","pinyin":"rú rú ér dòng","abbr":"rred","explanation":"像虫子似的前后蠕动身体，形容准备慢慢移动的样子。","source":{"text":"某些亡国论者又将蠕蠕而动，而且难免勾结某些国际成分（英、美、法内部都有这种人，特别是英国的上层分子），狼狈为奸。","book":"毛泽东《论持久战》"},"similar":["蠢蠢欲动"],"usage":"作谓语、定语；用于人或事物等"},{"id":39689,"word":"蠖屈不伸","pinyin":"huò qū bù shēn","abbr":"hqbs","explanation":"像尺蠖一样弯曲而不能伸展。比喻人不得志。","source":{"text":"即诸同学之士亦多食贫作苦，蠖屈不伸。","book":"清·戴名世《序》"},"example":{"text":"人在～的时候不能气馁。"},"similar":["怀才不遇"],"usage":"作谓语、定语；指人不得志"},{"id":39690,"word":"蠖屈求伸","pinyin":"huò qū qiú shēn","abbr":"hqqs","explanation":"蠖：昆虫名，行时屈伸其体。比喻人不遇时，则屈身求隐，待来日再展宏图。","source":{"text":"尺蠖之屈，以求信（伸）也。","book":"《周易·系辞下》"},"example":{"text":"盖闻～，非终于屈，龙潜或跃，匪固于潜。","book":"明·刘基《诚意伯文集》第八卷"},"similar":["蠖屈不伸"],"usage":"作谓语、宾语；指等待东山再起"},{"id":39691,"word":"蠖屈蜗潜","pinyin":"huò qū wō qián","abbr":"hqwq","explanation":"蠖：尺蠖；蜗：蜗牛。形容房屋极为低矮和窄小。","source":{"text":"不如且入低低屋，团蒲枕瓦方床竹，蠖屈蜗潜聊自足。","book":"清·陆硎《低低屋》"},"usage":"作宾语、定语；用于书面语"},{"id":39692,"word":"蠖屈螭盘","pinyin":"huò qū chī pán","abbr":"hqcp","explanation":"蠖：尺蠖；螭：传说中无角龙；盘：通“蟠”，回绕。像蠖弯曲，像螭回绕。形容屈曲回绕的样子。","source":{"text":"琐文结绶灵蛇降，蠖屈螭盘顾视闲。","book":"唐·李绅《灵蛇见少林寺》"},"usage":"作宾语、定语；用于书面语"},{"id":39693,"word":"蠖屈鼠伏","pinyin":"huò qū shǔ fú","abbr":"hqsf","explanation":"蠖：尺蠖；伏：俯伏。形容卑躬屈膝向人讨好的样子。","source":{"text":"注至，蠖屈鼠伏，佞词泉涌。","book":"宋·孔平仲《续世说·奸佞》"},"similar":["卑躬屈膝"],"usage":"作宾语、定语；用于书面语"},{"id":39694,"word":"蠡测管窥","pinyin":"lǐ cè guǎn kuī","abbr":"lcgk","explanation":"蠡：瓢；管：竹管；窥：人小孔缝隙里观看。用瓢来量大海，从竹管的小孔看天空。比喻见识片面狭窄，看不到事物的整体。","source":{"text":"以管窥天，以蠡测海，以筳撞钟，岂能通其条贯，考其文理，发其音声哉。","book":"《汉书·东方朔传》"},"example":{"text":"李于鳞所选唐诗数百首，未尽各家精髓。至所定五言古，尤～。","book":"清·李重华《贞一斋诗说》"},"similar":["蠡酌管窥"],"usage":"作宾语、定语；指见识狭隘"},{"id":39695,"word":"蠡酌管窥","pinyin":"lǐ zhuó guǎn kuī","abbr":"lzgk","explanation":"用瓢量海水，从竹管里看天。比喻见识浅薄，对事物的观察和了解很片面。","source":{"text":"蠡酌管窥，一至于此。","book":"宋·张君房《云笈七签》第三卷"},"similar":["蠡测管窥","孤陋寡闻"],"opposite":["见多识广"],"usage":"作宾语、定语；指见识狭隘"},{"id":39696,"word":"蠢头蠢脑","pinyin":"chǔn tóu chǔn nǎo","abbr":"ctcn","explanation":"神情、相貌蠢笨痴呆的样子。","example":{"text":"瞧你这～的样子。"},"similar":["笨头笨脑"],"opposite":["滑头滑脑"],"usage":"作谓语、定语；指愚钝"},{"id":39697,"word":"蠢如鹿豕","pinyin":"chǔn rú lù shǐ","abbr":"crls","explanation":"豕：猪；蠢：愚笨。笨得像鹿和猪一样。","source":{"text":"舜之居深山之中，与木石居，与鹿豕游。","book":"《孟子·尽心上》"}},{"id":39698,"word":"蠢若木鸡","pinyin":"chǔn ruò mù jī","abbr":"crmj","explanation":"形容神貌呆笨。","source":{"text":"小虫伏不动，蠢若木鸡。","book":"清·蒲松龄《聊斋志异·促织》"},"example":{"text":"他真是～。"},"similar":["呆若木鸡"],"opposite":["聪明伶俐"],"usage":"作谓语、状语、定语；指愚笨"},{"id":39699,"word":"蠢蠢思动","pinyin":"chǔn chǔn sī dòng","abbr":"ccsd","explanation":"蠢蠢：爬虫蠕动的样子。比喻敌人策划进攻或坏人准备捣乱破坏。","source":{"text":"而这个念头，近来正又蠢蠢思动的激荡着他，叫他得不到安静。","book":"沙汀《困兽记》"},"example":{"text":"敌人～，伺机反扑。"},"similar":["蠢蠢欲动"],"opposite":["按兵不动"],"usage":"作谓语、宾语、状语；形容准备随时干某事"},{"id":39700,"word":"蠢蠢欲动","pinyin":"chǔn chǔn yù dòng","abbr":"ccyd","explanation":"蠢蠢：爬虫蠕动的样子。比喻敌人准备进攻或坏人阴谋捣乱。","source":{"text":"掘得一黑物，无有首尾，形如数百斛舡，长数十丈，蠢蠢而动。","book":"南朝·宋·刘敬叔《异苑·句容水脉》"},"example":{"text":"据点里的敌人又～。","book":"峻青《爆炸远征队》五"},"similar":["跃跃欲试"],"opposite":["按兵不动"],"usage":"作谓语、宾语；形容准备随时干某事"},{"id":39701,"word":"蠲敝崇善","pinyin":"juān bì chóng shàn","abbr":"jbcs","explanation":"蠲：免除；敝：破旧；善：美好。指革除敝政，崇尚雅道。","source":{"text":"且好仁恶杀，蠲敝崇善，所以贤达君子多爱其法焉。","book":"南朝·宋·范晔《后汉书·西域传论》"},"usage":"作谓语、宾语；用于管理人员"},{"id":39702,"word":"蠹书虫","pinyin":"dù shū chóng","abbr":"dsc","explanation":"蛀书的虫子。比喻读死书的人。","source":{"text":"岂殊蠹书虫，生死文字间。","book":"唐·韩愈《杂诗》"},"example":{"text":"他是个～，不知变通。"},"usage":"作宾语、定语；指读死书的人"},{"id":39703,"word":"蠹众木折","pinyin":"dù zhòng mù zhé","abbr":"dzmz","explanation":"蛀虫多了，木头就要折断。比喻不利的因素多了，就能造成灾祸。","source":{"text":"蠹众而木折，隙大而墙坏。","book":"战国·卫·商鞅《商君书·修权》"},"example":{"text":"请记住～的教训。"},"similar":["隙大墙坏","蠹众木折，隙大墙坏"],"usage":"作宾语、定语；指不利因素多了造成灾祸"},{"id":39704,"word":"蠹众木折，隙大墙坏","pinyin":"dù zhòng mù zhé，xì dà qiáng huài","abbr":"dzmzxdqh","explanation":"蛀虫多了，木头就要折断，缝隙大了，墙就要倒塌。比喻不利的因素多了，就能造成灾祸。","source":{"text":"蠹众而木折，隙大而墙坏。","book":"《商君书·修权》"},"similar":["蠹众木折","隙大墙坏"],"usage":"作宾语、分句；可分开使用"},{"id":39705,"word":"蠹啄剖梁柱","pinyin":"dù zhuó pōu liáng zhù","abbr":"dzplz","explanation":"虫蛀鸟啄能使梁柱毁坏。比喻微小的有害因素，可以酿成大祸。","source":{"text":"故蠹啄剖梁柱，蚊虻走牛羊，此之谓也。","book":"《淮南子·人间训》"},"similar":["蚊虻走牛羊"],"usage":"作宾语、定语；用于劝诫人"},{"id":39706,"word":"蠹啄剖梁柱，蚊虻走牛羊","pinyin":"dù zhuó pōu liáng zhù，wén méng zǒu niú yáng","abbr":"dzplzwmzny","explanation":"虫蛀鸟啄能使梁柱毁坏，蚊虻的叮咬可使牛羊奔跑。比喻微小的有害因素，可以酿成大祸。","source":{"text":"故蠹啄剖梁柱，蚊虻走牛羊，此之谓也。","book":"《淮南子·人间训》"},"similar":["蠹啄剖梁柱","蚊虻走牛羊"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":39707,"word":"蠹国害民","pinyin":"dù guó hài mín","abbr":"dghm","explanation":"蠹：损害。危害国家，残害人民。","source":{"text":"乃者奸言诐行，蠹国残民之状，论者纷然，方议其罪，而悖德隐恶，达于朕听，考实其状，至不忍言。","book":"宋·苏轼《张诚一责授左武卫将军制》"},"example":{"text":"阴司以儿父久居高位，不思行善，专一任性执拗，行青苗等新法，～，怨气腾天。","book":"明·冯梦龙《警世通言》卷四"},"similar":["祸国殃民","蠹国殃民","蠹国病民"],"opposite":["安邦定国"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39708,"word":"蠹国殃民","pinyin":"dù guó yāng mín","abbr":"dgym","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"代营榷税，蠹国殃民。","book":"《明史·方从哲传》"},"example":{"text":"世间何物最堪憎？～莫若僧。","book":"清·陈忱《水浒后传》第二十一回"},"similar":["蠹国病民","蠹国害民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39709,"word":"蠹国残民","pinyin":"dù guó cán mín","abbr":"dgcm","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"乃者奸言诐行，蠹国残民之状，论者纷然，方议其罪，而悖德隐恶，达于朕听，考实其状，至不忍言。","book":"宋·苏轼《张诚一责授左武卫将军制》"},"similar":["蠹国病民","祸国殃民","蠹国耗民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39710,"word":"蠹国病民","pinyin":"dù guó bìng mín","abbr":"dgbm","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"因思一时富贵权势之人，生长纨绮中……非惟不知稼穑之艰难，流于奢淫以蠹国病民，抑又不知世间温饱安逸之正味为不少。","book":"元·刘祁《归潜志》卷十三"},"example":{"text":"依然是敷衍颟顸，～，自家拼命的自杀自亡，他人是救不来的。","book":"张孝若《张季直先生传记》"},"similar":["蠹国害民","蠹国殃民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39711,"word":"蠹国耗民","pinyin":"dù guó hào mín","abbr":"dghm","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"彼募化亦谋食之一道，必以其不耕不织为蠹国耗民，彼不耕不织而蠹国耗民者，独僧尼耶？","book":"清·纪昀《阅微草堂笔记·如是我闻一》"},"similar":["蠹国残民","祸国殃民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39712,"word":"蠹居棊处","pinyin":"dù jū què chǔ","abbr":"djqc","explanation":"蠹居：像蛀虫一样，深居在蛀坏的器物里。棊：同“棋”。像蛀虫一样深居，像棋子一样密布。形容坏人隐蔽很深，散布在各个要害地方。"},{"id":39713,"word":"蠹居棋处","pinyin":"dù jū qí chǔ","abbr":"djqc","explanation":"比喻坏人深入社会，散布各处。","source":{"text":"孽臣奸隶，蠹居棋处，摇毒自防，外顺内悖。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"各种牛鬼蛇神～，让人防不胜防。"},"usage":"作谓语；比喻坏人散布很广"},{"id":39714,"word":"蠹政害民","pinyin":"dù zhèng hài mín","abbr":"dzhm","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"凡所委任，皆非其人，兼诸子贪残，僚属纵逸，恃护威势，莫不蠹政害民。","book":"《周书·晋荡公护传》"},"example":{"text":"书牍交于道路，请托遍于官曹，其小者足以～，而其大者，至于立党倾轧，取人主太阿之柄而颠倒之，皆此之繇也。","book":"清·顾炎武《生员论中》"},"similar":["蠹政病民","蠹国病民","祸国殃民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39715,"word":"蠹政病民","pinyin":"dù zhèng bìng mín","abbr":"dzbm","explanation":"危害国家和人民。同“蠹国害民”。","source":{"text":"时皓［孙皓］居武昌，扬州百姓溯流供给，甚苦之；又奢侈无度，公私匮乏。陆凯上疏谏曰：‘……又左右皆非其人，群党相挟，害忠隐贤，此皆蠹政病民者也。’","book":"明·罗贯中《三国演义》第一百二十回"},"similar":["蠹国病民","祸国殃民","蠹政害民"],"usage":"作谓语、定语；同“祸国殃民”"},{"id":39716,"word":"蠹民梗政","pinyin":"dù mín gěng zhèng","abbr":"dmgz","explanation":"梗：阻挠。分割人民，阻挠政令。","source":{"text":"某人浮湛里中，无以为生，侦民有小不平，嗾之讼，佐之请谒，己旁缘自资，且既饵临政者，因持其短长，以蠹民梗政。","book":"明·陶宗仪《辍耕录·雕传》"}},{"id":39717,"word":"蠹简遗编","pinyin":"dù jiǎn yí biān","abbr":"djyb","explanation":"泛指残存的书籍。","source":{"text":"蠹简遗编试一寻，寂寥前事似如今。","book":"唐·罗隐《咏史》"},"usage":"作宾语、定语；指古书"},{"id":39718,"word":"血债累累","pinyin":"xuè zhài lěi lěi","abbr":"xzll","explanation":"血债：未报的杀人深仇；累累：形容很多。指杀人很多，罪恶极大。","source":{"text":"这狗仗官势、血债累累的地头蛇，被暴怒的人们活活地埋进沙坑。","book":"冯德英《迎春花》第二章"},"example":{"text":"这两个～的杀人犯被枪决了。"},"similar":["杀人如麻","血海深仇"],"opposite":["恩重如山","恩深义厚"],"usage":"作谓语、定语；指杀害的人很多"},{"id":39719,"word":"血债血还","pinyin":"xuè zhài xuè huán","abbr":"xzxh","explanation":"指犯下杀人害命的罪行，必须以死来抵偿。","example":{"text":"～！没有什么好说的！","book":"刘德桂《宣统皇帝》第四章"}},{"id":39720,"word":"血债要用血来还","pinyin":"xuè zhài yào yòng xuè lái huán","abbr":"xzyyxlh","explanation":"指犯下杀人害命的罪行，必须以死来抵偿。","source":{"text":"同志们，走！血债要用血来还，欠一分也不成！","book":"曲波《桥隆飙》"},"example":{"text":"生擒许家恶魔，送交人民——有仇报仇，有冤报冤，～。","book":"曲波《林海雪原》第八回"},"usage":"作宾语、定语；用于处事"},{"id":39721,"word":"血光之灾","pinyin":"xuè guāng zhī zāi","abbr":"xgzz","explanation":"迷信指有被杀的灾祸。","source":{"text":"吴用道：‘员外这命，目下不出百日之内，必有血光之灾。","book":"明·施耐庵《水浒传》第61回"},"example":{"text":"我们要尽量避免～。"},"usage":"作宾语；指杀身的灾祸"},{"id":39722,"word":"血化为碧","pinyin":"xuè huà wéi bì","abbr":"xhwb","explanation":"碧：碧玉。人死后血液凝固为碧玉。形容为正义而流的鲜血。比喻人的精诚所至","source":{"text":"伍员流于江，苌弘藏其血，三年化为碧。","book":"战国·宋·庄周《庄子·外物》"},"similar":["苌弘化碧"],"usage":"作宾语、定语；用于书面语","story":["周朝时期，刘文公的大夫苌弘一生忠于朝廷，不卑不亢，有浩然正气。他因为正直而得罪了朝中权贵，蒙冤被周人杀害，传说他被杀的当时，有人慕名收集他的血液藏在家里，三年后这些干血块全都化为碧玉"]},{"id":39723,"word":"血口喷人","pinyin":"xuè kǒu pēn rén","abbr":"xkpr","explanation":"比喻用恶毒的话污蔑或辱骂别人。","source":{"text":"含血喷人，先污其口；百丈野狐，失头狂走。","book":"宋·晓莹《罗湖野录》卷二"},"example":{"text":"她镇静起来，从炕上摸起一件上衣往身上披，用生硬的口吻说：“你别～！你，你不安好心……”","book":"冯德英《苦菜花》第三章"},"similar":["含血喷人","含沙射影"],"opposite":["逢人说项"],"usage":"作谓语、宾语、状语；指污蔑或辱骂别人"},{"id":39724,"word":"血性男儿","pinyin":"xuè xìng nán ér","abbr":"xxne","explanation":"指刚强正直，勇敢热情的男子汉。","source":{"text":"你小姐乃是闺阁中的须眉男子，我铁挺生也是个血性男儿。","book":"明·名教中人《好逑传》第六回"},"usage":"作宾语、定语；用于男性"},{"id":39725,"word":"血战到底","pinyin":"xuè zhàn dào dǐ","abbr":"xzdd","explanation":"血战：非常激烈地拼死地战斗。指激烈战斗到最后时刻。","source":{"text":"我们中华民族有同自己的敌人血战到底的气概。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"我们要～，决不放过敌人。"},"usage":"作谓语、定语；指拼死战斗"},{"id":39726,"word":"血染沙场","pinyin":"xuè rǎn shā chǎng","abbr":"xrsc","explanation":"沙场：战场。鲜血染红了战场。指在战场上牺牲。","source":{"text":"设将军等今日不来，吾辈血染沙场早矣。","book":"明·无名氏《杨家将演义》卷二"},"example":{"text":"董必武《邯郸烈士塔》：“～气化虹，捐躯为国是英雄。”"},"usage":"作谓语、定语；用于书面语"},{"id":39727,"word":"血气之勇","pinyin":"xuè qì zhī yǒng","abbr":"xqzy","explanation":"指凭一时感情冲动产生的勇气。","source":{"text":"孟贲血气之勇。","book":"《孟子·公孙丑上》：“夫子过孟贲远矣。”宋·朱熹集注"},"example":{"text":"明·罗贯中《三国演义》第99回：“汝等不知兵法，只凭～，强欲出战，致有此败。”"},"similar":["意气用事"],"usage":"作宾语；用于处事"},{"id":39728,"word":"血气方刚","pinyin":"xuè qì fāng gāng","abbr":"xqfg","explanation":"血气：精力；方：正；刚：强劲。形容年青人精力正旺盛。","source":{"text":"及其壮也，血气方刚，戒之在斗。","book":"《论语·季氏》"},"example":{"text":"公子杨干，乃悼公之同母弟，年方一十九岁，新拜中军戎御之职，～，未经战阵。","book":"明·冯梦龙《东周列国志》第六十回"},"similar":["年轻气盛","年富力强"],"opposite":["老态龙钟","暮气沉沉","未老先衰"],"usage":"作谓语、定语；用于年轻人"},{"id":39729,"word":"血气方勇","pinyin":"xuè qì fāng yǒng","abbr":"xqfy","explanation":"血气：精力；方：正；勇：勇猛。凭一时感情冲动而迸发出的勇气。","source":{"text":"孟贲血气之勇。","book":"《孟子·公孙丑上》：“夫子过孟贲远矣。”宋·朱熹集注"}},{"id":39730,"word":"血气方壮","pinyin":"xuè qì fāng zhuàng","abbr":"xqfz","explanation":"血气：精力；方：正。形容年青人精力正旺盛。","source":{"text":"昔马周起徒步，谒人主，血气方壮，太宗用之，能尽其才，甫五十而没。","book":"《新唐书·张嘉贞传》"},"similar":["血气方刚","气血方刚","血气方盛"],"opposite":["老态龙钟","暮气沉沉"],"usage":"作谓语、定语；用于年轻人"},{"id":39731,"word":"血气方盛","pinyin":"xuè qì fāng shèng","abbr":"xqfs","explanation":"血气：精力；方：正。形容年青人精力正旺盛。","source":{"text":"黄门郎年幼，血气方盛，既无长君退让之风，而要结轻狡无行之客。","book":"南朝·宋·范晔《后汉书·杨终传》"},"similar":["血气方刚","气血方刚","血气方壮"],"opposite":["老态龙钟","暮气沉沉"],"usage":"作谓语、定语；用于年轻人"},{"id":39732,"word":"血气未动","pinyin":"xuè qì wèi dòng","abbr":"xqwd","explanation":"血气：血性，指生命；动：变动。形容没有重病","source":{"text":"瘠则甚矣，而血气未动。","book":"春秋·鲁·左丘明《左传·襄公二十一年》"},"usage":"作谓语、宾语；用于书面语"},{"id":39733,"word":"血泪斑斑","pinyin":"xuè lèi bān bān","abbr":"xlbb","explanation":"血与泪俱在实证物。","source":{"text":"艰难犹有君亲念，血泪斑斑满客衣。","book":"元·韦居安《梅磵诗话》卷上"},"example":{"text":"这一幅幅～的照片，正控诉着侵略者的杀人暴行。"},"usage":"作谓语、定语；用于悲痛事情"},{"id":39734,"word":"血泪盈襟","pinyin":"xuè lèi yíng jīn","abbr":"xlyj","explanation":"血泪：悲痛的眼泪；盈：满。眼泪流湿了衣襟。形容非常悲痛。","source":{"text":"遂置笏伏陛，极言是非，血泪盈襟，词竟不屈。","book":"唐·白居易《虢州刺史崔公墓志铭》"},"usage":"作谓语、定语；指非常悲痛"},{"id":39735,"word":"血流如注","pinyin":"xuè liú rú zhù","abbr":"xlrz","explanation":"注：灌注。血流得象射出来的那样。形容血流得又多又急。","source":{"text":"其物匣刃而走，血流如注。","book":"唐·段成式《酉阳杂俎续集》"},"example":{"text":"朝奉头上被差官打了一个大窟窿，～。（清·李宝嘉《文明小史》第十二回）"},"similar":["血流成河"],"usage":"作谓语、宾语、定语；指流血很多"},{"id":39736,"word":"血流成川","pinyin":"xuè liú chéng chuān","abbr":"xlcc","explanation":"鲜血流成了河。形容被杀的人极多。","source":{"text":"因遂害之，无问少长，血流成川，坏诸塔寺八百余所。","book":"隋·祖君彦《檄洛州文》：“尸骸蔽野，血流成河，积怨满于山川，号哭动于天地。”唐·释道士《法苑珠林》卷九十八"},"example":{"text":"清军勇气，陡增十倍，杀得尸横遍野，～。","book":"蔡东藩《清史演义》第八十一回"},"similar":["血流成河","血流成渠"],"usage":"作谓语、定语；指战争残酷"},{"id":39737,"word":"血流成河","pinyin":"xuè liú chéng hé","abbr":"xlch","explanation":"形容被杀的人极多。","source":{"text":"尸骸蔽野，血流成河，积怨满于山川，号哭动于天地。","book":"《旧唐书·李密传》"},"example":{"text":"须臾～，顷刻尸如山积。","book":"明·施耐庵《水浒全传》第一百九回"},"similar":["血流成渠","尸横遍野"],"opposite":["兵不血刃"],"usage":"作谓语、定语；指战争残酷"},{"id":39738,"word":"血流成渠","pinyin":"xuè liú chéng qú","abbr":"xlcq","explanation":"鲜血流成了河。形容死伤的人极多。","source":{"text":"刘猊丢甲丢盔而走，杀得尸横遍野，血流成渠，又折了二千多兵，退到万庆寺喘急方定。","book":"清·陈忱《水浒后传》"},"example":{"text":"清·陈忱《水浒后传》：“刘猊丢甲丢盔而走，杀得尸横遍野，～，又折了二千多兵，退到万庆寺喘急方定。”"},"similar":["血流成川","血流成河"],"opposite":["兵不血刃"],"usage":"作谓语、定语；指战争残酷"},{"id":39739,"word":"血流没足","pinyin":"xuè liú mò zú","abbr":"xlmz","explanation":"足：脚。形容死伤很多，流血淹没了脚面","source":{"text":"武帝发兵攻卫太子，连闻五日，白虎门前沟中，血流没足。","book":"《三辅旧事》"},"similar":["血流漂卤"],"usage":"作谓语、定语；用于书面语"},{"id":39740,"word":"血流漂卤","pinyin":"xuè liú piāo lǔ","abbr":"xlpl","explanation":"卤：通“橹”，大盾。血流成河能把大盾漂浮起来。形容杀人很多","source":{"text":"伏尸百万，流血漂卤。","book":"西汉·贾谊《过秦论》"},"example":{"text":"晋·皇甫谧《帝王世纪》：“长平之战，～。”"},"similar":["血流漂杵"],"usage":"作谓语、宾语、定语；指战争残酷"},{"id":39741,"word":"血流漂杵","pinyin":"xuè liú piāo chǔ","abbr":"xlpc","explanation":"杵：捣物的棒槌。血流成河，舂米的木棰都漂了起来。形容战死的人很多。也泛指流血很多。","source":{"text":"炎帝无道，黄帝伐之，涿鹿之野，血流漂杵。","book":"《尚书·武成》：“会于牧野，罔有敌于我师，前徒倒戈，攻于后以北，血流漂杵。”汉·贾谊《益攘》"},"example":{"text":"若崩厥角齐稽首，～脂如泉。","book":"明·许仲琳《封神演义》第一回"},"similar":["血流成河","血雨腥风"],"opposite":["兵不血刃"],"usage":"作谓语、宾语、定语；指战争残酷","story":["《尚书·武成》中记载周武王讨伐商纣王，在朝歌附近的牧野进行一场恶战，杀得天昏地暗，血流漂杵。孟子认为这样描写夸张过度，武王的军队是仁义之师，不会滥杀无辜，纣王残暴，士兵会纷纷起义，不会有这样激烈的战斗"]},{"id":39742,"word":"血流飘卤","pinyin":"xuè liú piāo lǔ","abbr":"xlpl","explanation":"卤：通“橹”，大盾牌。血流得能将橹飘起来。形容死伤极多。","source":{"text":"秦有余力而制其敌，追亡逐北，伏尸百万，流血漂卤。","book":"《史记·秦始皇本纪》"}},{"id":39743,"word":"血海冤仇","pinyin":"xuè hǎi yuān chóu","abbr":"xhyc","explanation":"血海：形容杀人流血很多。形容仇恨极大、极深。多指人被杀而引起的仇恨。","source":{"text":"放着他血海深仇三百载，鬼混了汉家疆宇十余传。","book":"清·陈天华《狮子吼》楔子"},"example":{"text":"这些～的根源，他还不十分清楚。他只恨那帮杀人凶手。","book":"杜鹏程《保卫延安》第二章"},"similar":["血海深仇","深仇大恨"],"usage":"作主语、宾语；指仇恨深"},{"id":39744,"word":"血海尸山","pinyin":"xuè hǎi shī shān","abbr":"xhss","explanation":"血流成海，尸戴盆望天如山。形容伤亡惨重。","source":{"text":"杀的他血海尸山人马亡，似败叶，狂风荡。","book":"明·无名氏《王马破曹》第二折"},"example":{"text":"清·钱彩《说岳全传》第70回：“绿草黄沙地，忽变做～；青风白日天，霎时间云愁雾惨。”"},"usage":"作宾语、定语；用于比喻句"},{"id":39745,"word":"血海深仇","pinyin":"xuè hǎi shēn chóu","abbr":"xhsc","explanation":"血海：形容杀人流血很多。形容仇恨极大、极深。多指人被杀而引起的仇恨。","source":{"text":"放着他血海深仇三百载，鬼混了汉家疆宇十余传。","book":"清·陈天华《狮子吼》楔子"},"example":{"text":"他转回身来，面向着哀悼的人群，“我们要把悲痛变成力量，我们要誓死报这场～。”（曲波《林海雪原》十八）"},"similar":["深仇大恨","新仇旧恨"],"opposite":["大恩大德","恩重如山"],"usage":"作主语、宾语；指仇恨深"},{"id":39746,"word":"血盆大口","pinyin":"xuè pén dà kǒu","abbr":"xpdk","explanation":"指野兽凶残吞噬的大嘴。也比喻剥削者、侵略者蚕食鲸吞的巨大胃口。","source":{"text":"眼如悬镜，口若血盆，毒气成云。","book":"唐·变文《叶净能诗》"},"example":{"text":"原来身后有个山羊在那里吃草，却被大虫看见，扑了过去，抱住山羊，张开～，羊头吃在腹内。","book":"清·李汝珍《镜花缘》第四十九回"},"usage":"作宾语；指嘴"},{"id":39747,"word":"血竭髯枯","pinyin":"xuè jié rán kū","abbr":"xjrk","explanation":"髯：两颊上的长须。血流尽了，胡须枯索了。形容费尽心血","source":{"text":"此六朝以下，温李诸公血竭髯枯，矜诧累日者，子于受戒一刻，随口而答。","book":"清·周亮工《书影》第六卷"},"usage":"作谓语、定语；用于书面语"},{"id":39748,"word":"血肉模糊","pinyin":"xuè ròu mó hu","abbr":"xrmh","explanation":"血流肉烂，无法辨认器官肢体。形容死亡或受伤的惨状。","source":{"text":"弟兄们让不开路，被火车碾的断腰折骨，血肉模糊。","book":"冯玉祥《我的生活》第24章"},"example":{"text":"仔细看去，这条路上～成了一片，没有一个干净的尸体。","book":"巴金《家》二十五"},"usage":"作谓语、定语；用于流血场面"},{"id":39749,"word":"血肉横飞","pinyin":"xuè ròu héng fēi","abbr":"xrhf","explanation":"形容发生爆炸等灾祸时，死伤者血肉四溅的惨状。","source":{"text":"养息了两天，真是贱皮贱肉，打得那般血肉横飞的，不到几天，已经全愈了。","book":"清·吴趼人《发财秘诀》第六回"},"example":{"text":"即有几个如狼似虎的狱吏，各执竹条，纵横乱打，打得～，足足打了四个小时，方才丧命。","book":"清·陈天华《狮子吼》第八回"},"similar":["尸横遍野"],"usage":"作谓语、宾语；形容战争的惨状"},{"id":39750,"word":"血肉淋漓","pinyin":"xuè ròu lín lí","abbr":"xrll","explanation":"淋漓：小湿。形容血肉流淌的惨状。","source":{"text":"狱卒割剔其股文，血肉淋漓，形容枯瘠不类人。","book":"宋·洪迈《夷坚甲志·高俊入冥》"},"example":{"text":"清·颐琐《黄绣球》第二回：“天天那双脚是要替她裹的，裹起来使着手劲，不顾死活，弄得～，哭声震地。”"},"similar":["血肉横飞"],"usage":"作定语、状语；用于书面语"},{"id":39751,"word":"血肉狼藉","pinyin":"xuè ròu láng jí","abbr":"xrlj","explanation":"血流肉烂，无法辨认器官肢体。形容死亡或受伤的惨状。","source":{"text":"就叫哨兵取出瓮来，打开看时，只见血肉狼藉，头颅劈破，是一个人碎割了的。","book":"《宋史·五行志》：“又断其足筋，俄施刀脔，血肉狼籍。”明·凌濛初《初刻拍案惊奇》卷十二四"},"example":{"text":"九月兵起，出走，兵抽刃击之，未殊，骂不绝，被数刃，乃绝。～，白发为之赤。","book":"《清史稿·列女传·连惠妻》"}},{"id":39752,"word":"血肉相联","pinyin":"xuè ròu xiāng lián","abbr":"xrxl","explanation":"象血和肉一样相互联系着。比喻关系十分密切，不可分离。","source":{"text":"趋视之，二百钱乃在其胁下皮内，与血肉相连。","book":"宋·洪迈《夷坚丁志·雷击王四》"},"example":{"text":"与群众特别是陕北农民群众的～，使人民革命化，民歌民舞也革命化，使革命文艺也亲密无间地民间化了。","book":"王蒙《今天的延安》"},"similar":["血肉相连"],"usage":"作谓语、宾语、定语；指关系密切"},{"id":39753,"word":"血肉相连","pinyin":"xuè ròu xiāng lián","abbr":"xrxl","explanation":"象血和肉一样相互联系着。比喻关系十分密切，不可分离。","source":{"text":"趋视之，二百钱乃在其胁下皮内，与血肉相连。","book":"宋·洪迈《雷击王四》"},"example":{"text":"你和党的关系，不能不是这样息息相关，～呵。","book":"闻捷《布沙热，我要为你唱一支歌》"},"similar":["息息相关","休戚与共","血肉相联"],"opposite":["不关痛痒","漠不关心"],"usage":"作谓语、宾语、定语；指关系密切"},{"id":39754,"word":"血脉相通","pinyin":"xuè mài xiāng tōng","abbr":"xmxt","explanation":"血脉：血统。原指有血缘亲属关系。也比喻极亲近的关系。","source":{"text":"人血脉相通如江河，针炙在思其要津。","book":"唐·卢氏《逸史·治针道人》"},"example":{"text":"张顺见了宋江，～。","book":"明·施耐庵《水浒全传》第四十回"},"similar":["血脉相连"],"usage":"作谓语、定语；用于人或事务等"},{"id":39755,"word":"血迹斑斑","pinyin":"xuè jì bān bān","abbr":"xjbb","explanation":"形容留下的血迹很多。","source":{"text":"……就是把一个封建的中国变为一个半封建、半殖民地和殖民地的中国的血迹斑斑的图画。","book":"毛泽东《中国革命和中国共产党》"},"example":{"text":"这～的模样真是十分恐怖。"},"usage":"作谓语、定语；指非常恐怖"},{"id":39756,"word":"血雨腥风","pinyin":"xuè yǔ xīng fēng","abbr":"xyxf","explanation":"风里夹着腥味，雨点带着鲜血。形容疯狂杀戮的凶险气氛或环境。","source":{"text":"腥风血雨满松林，散乱毛发坠山奄。","book":"明·施耐庵《水浒传》第二十三回"},"example":{"text":"投身革命即为家，～应有涯。取义成仁今日事，人间遍种自由花。","book":"陈毅《梅岭三章》诗"},"similar":["腥风血雨"],"opposite":["天下太平"],"usage":"作谓语、宾语；指恐怖气氛"},{"id":39757,"word":"血风肉雨","pinyin":"xuè fēng ròu yǔ","abbr":"xfry","explanation":"形容剧烈残酷的屠杀或性格刚强。","source":{"text":"试一读欧美诸国法律发达史，如立宪政，废奴隶……等诸大法律，何一不自血风肉雨中熏沐而来。","book":"清·梁启超《论权利思想》"},"example":{"text":"虽说～的精神，断无惜香怜玉的心绪。","book":"清·曾朴《孽海花》"},"similar":["血雨腥风"],"usage":"作宾语、定语；指恐怖气氛"},{"id":39758,"word":"衅发萧墙","pinyin":"xìn fā xiāo qiáng","abbr":"xfxq","explanation":"衅：缝隙，引申为争端，事端。萧墙：古代宫室内当门的小墙，引申为内部。比喻事端或灾祸发生在内部。","source":{"text":"今张角起于赵、魏，黄巾乱于六州。此皆衅发萧墙，而祸延四海者也。","book":"《后汉书·傅燮传》"},"example":{"text":"止恐祸生匕首，衅发萧墙，空以七尺之躯，悬赏千金之购，可为酸鼻者也。","book":"《北史·王弘传》"},"similar":["祸起萧墙","祸发萧墙","祸兴萧墙"],"usage":"作谓语、宾语、定语；指内乱"},{"id":39759,"word":"衅稔恶盈","pinyin":"xìn rěn è yíng","abbr":"xrey","explanation":"犹言罪大恶极。罪恶大到了极点。","example":{"text":"汪精卫是一个～的卖国贼。"},"similar":["罪大恶极"],"usage":"作谓语、定语；用于书面语"},{"id":39760,"word":"衅起萧墙","pinyin":"xìn qǐ xiāo qiáng","abbr":"xqxq","explanation":"萧墙：古代宫室内当门的小墙。指祸乱发生在家里。比喻内部发生祸乱。","source":{"text":"时值乱离，衅起萧墙。","book":"北周·庾信《周大将军司马裔神道碑》"},"similar":["衅发萧墙","祸起萧墙"],"usage":"作宾语、定语；指内部祸乱"},{"id":39761,"word":"行下春风望夏雨","pinyin":"xíng xià chū fēng wàng xià yǔ","abbr":"xxcfwxy","explanation":"行：施。比喻要先给别人好处，然后别人才会给自己好处。","source":{"text":"我本是好人家孩儿，不是娼人家妇女，也是行下春风望夏雨。待要做眷属，枉坏了少俊前程，辱没了你裴家上祖！","book":"元·白朴《墙头马上》第四折"},"usage":"作宾语、定语；用于处事"},{"id":39762,"word":"行不从径","pinyin":"xíng bù cóng jìng","abbr":"xbcj","explanation":"走路不遵循正道。比喻做事为学走捷径。","source":{"text":"稽度皆明而不道也，譬之出不由门，行不从径也。以是求利，不亦难乎？","book":"《列子·说符》"},"similar":["行不由径"],"usage":"作谓语、宾语；用于处事等"},{"id":39763,"word":"行不副言","pinyin":"xíng bù fù yán","abbr":"xbfy","explanation":"指言行不一。","source":{"text":"天下之人行不副言者多矣，使夫子随听而遽信之，所失者岂特宰予邪！","book":"金·王若虚《论语辨惑》"},"similar":["言行不一"],"opposite":["言行一致"],"usage":"作谓语、定语；用于处事"},{"id":39764,"word":"行不及言","pinyin":"xíng bù jí yán","abbr":"xbjy","explanation":"及言：顾虑到已经说了的。指做事不守信用。","source":{"text":"相国齐晏子，赠行不及言。","book":"《孟子·尽心下》：“言不顾行，行不顾言。”唐·李白《送鲁郡刘长史迁弘农长史》"},"example":{"text":"诸兄与弟，当以～为耻，生逢明圣，而一无展布，何以答君父，复友生乎？","book":"清·夏敬渠《野叟曝言》第一百二十四回"},"similar":["行不顾言"],"usage":"作谓语、定语；用于处事"},{"id":39765,"word":"行不履危","pinyin":"xíng bù lǚ wēi","abbr":"xblw","explanation":"不走有危险的地方。","source":{"text":"臣闻千金之子坐不垂堂，万乘之主行不履危。","book":"《晋书·石季龙载记上》"},"usage":"作谓语、定语；用于处事"},{"id":39766,"word":"行不得也哥哥","pinyin":"xíng bù dé yě gē gē","abbr":"xbdygg","explanation":"鹧鸪叫声的拟意，表示行路艰难。","source":{"text":"行不得也哥哥，十八滩头乱石多。东去入闽南入广，溪流湍驶岭嵯峨，行不得也哥哥。","book":"明·丘濬《禽言》诗"},"example":{"text":"又对燕子说道：‘～！～！’","book":"清·吴趼人《俏皮话·鹧鸪杜鹃》"},"usage":"作宾语；表示行路艰难"},{"id":39767,"word":"行不愧影，寝不愧衾","pinyin":"xíng bù kuì yǐng，qǐn bù kuì qīn","abbr":"xbkyqbkq","explanation":"衾：被子。走路没有对不起影子，睡觉没有对不起被子。比喻为人行为光明，问心无愧。","source":{"text":"独行不愧影，独寝不愧衾。","book":"《宋史·蔡元定传》"},"example":{"text":"罗江东自此之后，一味学做好人，再不敢存一毫不肖之心，真个～。","book":"明·周楫《西湖二集·文昌司怜才慢注禄籍》"},"usage":"作宾语、定语；用于处事"},{"id":39768,"word":"行不更名，坐不改姓","pinyin":"xíng bù gēng míng，zuò bù gǎi xìng","abbr":"xbgmzbgx","explanation":"任何情况下都不隐瞒自己的真实姓名。形容为人处世光明磊落。","source":{"text":"行不更名，坐不改姓，自家盆罐赵的便是。","book":"元·无名氏《盆儿鬼》第一折"},"example":{"text":"我～，都头武松的便是。","book":"明·施耐庵《水浒全传》第二十七回"},"usage":"作谓语、定语；用于处事"},{"id":39769,"word":"行不由径","pinyin":"xíng bù yóu jìng","abbr":"xbyj","explanation":"径：小路，引伸为邪路。从来不走邪路。比喻行动正大光明。","source":{"text":"有澹台灭明者，行不由径，非公事，未尝至于偃之室也。","book":"春秋·鲁·孔丘《论语·雍也》"},"example":{"text":"就不慌不忙，斯斯文文，～的走到上房来。","book":"清·文康《儿女英雄传》第33回"},"similar":["光明正大","行不从径"],"usage":"作谓语、定语；指人的行动"},{"id":39770,"word":"行不由西州路","pinyin":"xíng bù yóu xī zhōu lù","abbr":"xbyxzl","explanation":"西州：古南京。晋朝宰相谢安病重时，曾经从西州城门入城回京，死后，其友羊昙很悲痛，不愿从西州路走。比喻怀念故人，悲悼亡友。","source":{"text":"羊昙者，太山人，知名士也。为安所爱重，安薨后，辍乐弥年，行不由西州路。","book":"《晋书·谢安传》"},"usage":"作谓语、定语；用于书面语","story":["晋朝时期，太山知名人士羊昙被宰相谢安所看重，两人关系十分要好。谢安病重时曾多次由西州门入城回京，羊昙也经常陪同。谢安死后，羊昙十分悲痛，停止所有的娱乐有几年时间，甚至不愿再走西州们这条引起伤心的路"]},{"id":39771,"word":"行不由路","pinyin":"xíng bù yóu lù","abbr":"xbyl","explanation":"路：小路，引申为邪路。从来不走邪路。比喻行动正大光明。","source":{"text":"垒壁已具，行不由路，谓之奸人，奸人者杀。","book":"汉·刘向《说苑·指武》"}},{"id":39772,"word":"行不知往","pinyin":"xíng bù zhī wǎng","abbr":"xbzw","explanation":"行：走。行路不知道走向何方。指行动不能自主，只能听任自然摆布","source":{"text":"故行不知往，处不知所持，食不知所味，天地之强阳气也，又胡可得而有邪！","book":"战国·宋·庄周《庄子·知北游》"},"usage":"作宾语、定语；用于处事"},{"id":39773,"word":"行不胜衣","pinyin":"xíng bù shèng yī","abbr":"xbsy","explanation":"衣服都禁受不起，比喻体力衰弱。","source":{"text":"叶公子高，微小短瘠，行若将不胜其衣。","book":"《荀子·非相》"},"similar":["弱不胜衣"],"usage":"作谓语、定语；指非常虚弱"},{"id":39774,"word":"行不苟合","pinyin":"xíng bù gǒu hé","abbr":"xbgh","explanation":"指做事有主见，不随便附和别人。","source":{"text":"建为人口辩，初名廉直，行不苟合。","book":"汉·荀悦《汉纪·高后纪》"},"example":{"text":"唐·张说《齐黄门侍郎庐公神道碑》：“清明虚受，磊落标奇，言不诡行，～，游心英俊，门无尘杂。”"},"similar":["行不苟容"],"usage":"作谓语、定语；用于处事"},{"id":39775,"word":"行不苟容","pinyin":"xíng bù gǒu róng","abbr":"xbgr","explanation":"做事有主见，不附和别人","source":{"text":"毅方正亮直，介然不群，言不苟合，行不苟容。","book":"《晋书·刘毅传》"},"similar":["行不苟合"],"usage":"作谓语、定语；用于处事"},{"id":39776,"word":"行不贰过","pinyin":"xíng bù èr guò","abbr":"xbeg","explanation":"指犯过的错误不再犯。","source":{"text":"有颜回者好学，不迁怒，不贰过。","book":"语出《论语·雍也》"},"usage":"作谓语、宾语、定语；用于处事等"},{"id":39777,"word":"行不逾方","pinyin":"xíng bù yú fāng","abbr":"xbyf","explanation":"指行动不逾越法度。","source":{"text":"班彪以通儒上才，倾侧危乱之间，行不逾方，言不失正。","book":"《后汉书·班彪传》"},"usage":"作谓语、定语；用于处事"},{"id":39778,"word":"行不顾言","pinyin":"xíng bù gù yán","abbr":"xbgy","explanation":"顾言：顾虑到已经说了的。指做事不守信用。","source":{"text":"言不顾行，行不顾言。","book":"《孟子·尽心下》"},"similar":["行不及言"],"usage":"作谓语、定语；用于处事"},{"id":39779,"word":"行之惟艰","pinyin":"xíng zhī wéi jiān","abbr":"xzwj","explanation":"惟：为。知道并不难，去做就难了。","source":{"text":"非知之艰，行之惟艰。","book":"《尚书·说命中》"},"example":{"text":"王暨曰：“以古为鉴，此言发于太宗，而身自违之。”帝曰：“非知之艰，～。”","book":"清·毕沅《续资治通鉴》卷一百六十四"},"similar":["知之非艰，行之惟艰"],"usage":"作宾语、定语；用于劝诫人"},{"id":39780,"word":"行之有效","pinyin":"xíng zhī yǒu xiào","abbr":"xzyx","explanation":"之：代词，它，指办法、措施等；效：成效，效果。实行起来有成效。指某种方法或措施已经实行过，证明很有效用。","source":{"text":"皇甫隆遇青牛道士，姓封名君达，其论养性法则可施用，大略云……武帝行之有效。","book":"晋·张华《博物志·方士》"},"example":{"text":"整风是在我们历史上～的办法。","book":"毛泽东《中中国共产党第八届中央委员会第二次全体会议上的讲话》"},"similar":["立竿见影","卓有成效"],"opposite":["劳而无功","徒劳无益"],"usage":"作谓语、宾语、定语；指证明有效"},{"id":39781,"word":"行之非艰，知之惟艰","pinyin":"xíng zhī fēi jiān，zhī zhī wéi jiān","abbr":"xzfjzzwj","explanation":"惟：为。施行并不难，知道其整理就难了。","source":{"text":"非知之艰，行之惟艰。","book":"《尚书·说命中》"}},{"id":39782,"word":"行乎富贵","pinyin":"xíng hū fù guì","abbr":"xhfg","explanation":"行：所作所为。指所作所为符合富贵的身份","source":{"text":"素富贵，行乎富贵；素贫贱，行乎贫贱；素夷狄，行乎夷狄；素患难，行乎患难。","book":"西汉·戴圣《礼记·中庸》"},"usage":"作谓语、定语；用于书面语"},{"id":39783,"word":"行乐及时","pinyin":"xíng lè jí shí","abbr":"xljs","explanation":"及时：抓紧时机。不失时机，寻欢作乐。","source":{"text":"汉乐府《西门行》诗：“夫为乐，为乐当及时。”《古诗十九首·生年不满百》：“为乐当及时，何能待来兹”。"},"example":{"text":"～时已晚，对酒当歌歌不成。","book":"唐·杜牧《湖南正初招李郢秀才》"},"similar":["及时行乐"],"usage":"作谓语、宾语、定语；指消极性享乐"},{"id":39784,"word":"行亏名缺","pinyin":"xíng kuī míng quē","abbr":"xkmq","explanation":"德行、名声都缺损低下。","source":{"text":"自小攻读，从来知礼，忍使行亏名缺。","book":"明·高明《琵琶记·丞相发怒》"},"usage":"作谓语、定语；用于书面语"},{"id":39785,"word":"行云流水","pinyin":"xíng yún liú shuǐ","abbr":"xyls","explanation":"形容文章自然不受约束，就象漂浮着的云和流动着的水一样。","source":{"text":"所示书教及诗赋杂文，观之熟矣；大略如行云流水，初无定质，但常行于所当行，止于不可不止。","book":"宋·苏轼《答谢民师书》"},"example":{"text":"结构如～，层次分明，先后呼应。","book":"茅盾《〈力原〉读后感》"},"similar":["无拘无束","挥洒自如"],"opposite":["矫柔造作"],"usage":"作宾语、定语；指文章等"},{"id":39786,"word":"行令猜拳","pinyin":"xíng lìng cāi quán","abbr":"xlcq","explanation":"行令：行酒令；猜拳：酒令的一种。泛指喝酒划拳。","source":{"text":"行令猜拳频递盏，拆牌道字漫传钟。","book":"明·吴承恩《西游记》第九回"},"example":{"text":"这一番酒兴，都有些闹阑了，各人好恶不同，爱饮的，楼上灯下，残肴剩酒～。","book":"清·褚人获《隋唐演义》第二十二回"},"similar":["猜拳行令"],"usage":"作谓语、宾语；指行酒令"},{"id":39787,"word":"行伍出身","pinyin":"háng wǔ chū shēn","abbr":"hwcs","explanation":"行伍：旧时军队编制，五人为一伍，五伍为一行。当兵出身的人。","source":{"text":"幸亏炮船上统带赵大人是行伍出身，天生海量。","book":"清·李宝嘉《官场现形记》第十三回"},"example":{"text":"我是一个～的人，常常感觉自己读书太少，学识不足。","book":"冯玉祥《我的生活》第十八章"},"usage":"作谓语、宾语；指当兵出身"},{"id":39788,"word":"行住坐卧","pinyin":"xíng zhù zuò wò","abbr":"xzzw","explanation":"指一举一动。","source":{"text":"行住坐卧，受诸苦恼。","book":"《大承本生心地观经·报恩品》"},"example":{"text":"清·文康《儿女英雄传》第37回：“你只看那猴儿，无论～，他总把脑袋扎在胸坎子上，倒把勃儿扛起来。”"},"usage":"作宾语、定语；指人的举止"},{"id":39789,"word":"行侠好义","pinyin":"xíng xiá hào yì","abbr":"xxhy","explanation":"指讲义气，肯舍己助人。"},{"id":39790,"word":"行兵列阵","pinyin":"xíng bīng liè zhèn","abbr":"xblz","explanation":"指挥军队，布置阵势。","source":{"text":"有一将，名继业，人号为令公，此人天文地理，六韬三略，无不精通，行兵列阵，玄妙莫测，乃智勇兼全之士。","book":"明·无名氏《杨家将演义》第四回"},"similar":["行兵布阵"],"usage":"作谓语、宾语；用于军事"},{"id":39791,"word":"行兵布阵","pinyin":"xíng bīng bù zhèn","abbr":"xbbz","explanation":"指挥军队，布置阵势。","source":{"text":"有一将，名继业，人号为令公，此人天文地理，六韬三略，无不精通，行兵列阵，玄妙莫测，乃智勇兼全之士。","book":"明·无名氏《杨家将演义》第四回"},"example":{"text":"老僧有兵书一册，内有传枪之法，并～妙用。今赠与令郎，用心温习。","book":"清·钱彩《说岳全传》第四回"},"similar":["行兵列阵"],"usage":"作谓语、宾语；用于军事"},{"id":39792,"word":"行军动众","pinyin":"xíng jūn dòng zhòng","abbr":"xjdz","explanation":"行：发动；众：大队人马。旧指大规模出兵。现多指动用很多人力做某件事。","source":{"text":"且雨水方盛，非行军动众之时。","book":"《吴子·励士》：“夫发号布令，而人乐闻；兴师动众，而人乐战；交兵接刃，而人乐死。”《三国志·魏志·王朗传》"},"similar":["兴师动众","起兵动众","行师动众"],"opposite":["单枪匹马","小打小闹"],"usage":"作谓语、宾语、定语；指大规模行动"},{"id":39793,"word":"行凶撒泼","pinyin":"xíng xiōng sā pō","abbr":"xxsp","explanation":"撒泼：耍无赖，用蛮横无礼的行动待人。指待人凶恶，蛮横无理。","source":{"text":"我平日之间，行凶撒泼，倚强凌弱，欺负平人。","book":"明·无名氏《打董达》第二折"},"example":{"text":"明·无名氏《打董达》第二折：“我平日之间，～，倚强凌弱，欺负平人。”"},"similar":["撒泼放刁"],"usage":"作谓语、宾语、定语；用于处事"},{"id":39794,"word":"行则思义","pinyin":"xíng zé sī yì","abbr":"xzsy","explanation":"行：行动；义：公正。行动时要考虑是否合乎正义","source":{"text":"君子动则思礼，行则思义，不为利回。","book":"春秋·鲁·左丘明《左传·昭公三十一年》"},"usage":"作谓语、定语；用于处事"},{"id":39795,"word":"行则连舆，止则接席","pinyin":"xíng zé lián yú，zhǐ zé jiē xí","abbr":"xzlyzzjx","explanation":"行：行路；舆：蓬车或轿子；止：停止席：席位。外出时车或轿相连，休息时座位相接。形容关系密切，形影不离。","source":{"text":"昔日游行，行则连舆，止则接席，何曾须臾相失。","book":"三国·魏·曹丕《与吴质书》"},"similar":["形影不离"],"usage":"作谓语、定语；用于两人的关系"},{"id":39796,"word":"行动坐卧","pinyin":"xíng dòng zuò wò","abbr":"xdzw","explanation":"泛指人的举止和风度。","example":{"text":"一个人的～可以看出他的修养如何。"},"usage":"作主语、宾语、定语；指人的举止"},{"id":39797,"word":"行化如神","pinyin":"xíng huà rú shén","abbr":"xhrs","explanation":"形容行动变化快得出奇。","source":{"text":"当今陛下临制海内，一齐天下，口虽未言，声疾雷电，令虽未发，行化如神。","book":"汉·荀悦《汉纪·武帝纪》"},"usage":"作谓语、定语；用于书面语"},{"id":39798,"word":"行古志今","pinyin":"xíng gǔ zhì jīn","abbr":"xgzj","explanation":"按古道行事，为当今服务。指时异势迁，不可食而不化。","source":{"text":"始之以古，终之以古，行古志今，政之至也。","book":"《逸周书·常训》"},"usage":"作宾语、定语；用于书面语"},{"id":39799,"word":"行号卧泣","pinyin":"xíng háo wò qì","abbr":"xhwq","explanation":"行走或躺卧时都在号呼哭泣。形容悲痛之极。","source":{"text":"自皇家祸乱，亟积寒暄，九州万国之人，蟠本流沙之地，莫不行号卧泣，想望休平。","book":"南朝·陈·徐陵《为贞阳侯答王太尉书》"},"usage":"作谓语、定语；用于悲伤的事"},{"id":39800,"word":"行号巷哭","pinyin":"xíng háo xiàng kū","abbr":"xhxk","explanation":"行：路；号：大声哭叫。道路上和大街小巷里的人都在哭泣。形容人们极度悲哀。","source":{"text":"苟在食土之毛，含气之类，莫不叩心绝气，行号巷哭。","book":"晋·刘琨《劝进表》"},"example":{"text":"俄而暴卒，百姓～，市里为之喧沸，设祭奠于郡庭者四百余人。","book":"《南史·萧昂传》"},"usage":"作宾语、定语；指人很悲伤"},{"id":39801,"word":"行合趋同","pinyin":"xíng hé qū tóng","abbr":"xhqt","explanation":"行为志趣相同。","source":{"text":"行合趋同，千里相从；行不合，趋不同，对门不通。","book":"《淮南子·说山训》"},"similar":["志同道合"],"usage":"作谓语、定语；用于书面语"},{"id":39802,"word":"行同犬彘","pinyin":"xíng tóng quǎn zhì","abbr":"xtqz","explanation":"旧时指人无耻，行为和猪狗一样。","source":{"text":"故此一豫让也，反君事仇，行若狗彘，已而抗节致忠，行出乎列士，人主使然也。","book":"汉·贾谊《治安策》"},"example":{"text":"甚至当垆沽酒，亦所甘心，以视近人之忽合忽离，～者，其得毋相去尚远耶！","book":"蔡东藩《前汉演义》第六十一回"}},{"id":39803,"word":"行同狗彘","pinyin":"xíng tóng gǒu zhì","abbr":"xtgz","explanation":"旧时指人无耻，行为和猪狗一样。","source":{"text":"故此一豫让也，反君事仇，行若狗彘，已而抗节致忠，行出乎列士，人主使然也。","book":"汉·贾谊《治安策》"},"similar":["行若狗彘"],"usage":"作谓语、定语；用于书面语"},{"id":39804,"word":"行同狗豨","pinyin":"xíng tóng gǒu xī","abbr":"xtgx","explanation":"豨：猪。人的行为丑恶，如同猪狗一样。形容人的行为卑鄙恶劣到了极点。亦作“行如禽兽”、“行若狗彘”、“行同犬彘”。","source":{"text":"言则称于汤文，行则譬于狗豨。","book":"语本《墨子·耕柱》"},"similar":["行若狗彘"],"usage":"作谓语、定语；指人无耻","story":["战国时期，子夏的徒弟去问子墨子说：“君子有标准没有？”子墨子说君子没有固定的标准。子夏的徒弟说：“猪狗都有标准，作恶的人怎么会没有标准呢？”子墨子说：“那些口头上说得好听而行动却比猪狗还不如，这不能称君子。”"]},{"id":39805,"word":"行同能偶","pinyin":"xíng tóng néng ǒu","abbr":"xtno","explanation":"品行相同，才能相等。","source":{"text":"诸侯岁贡少学之异者于天子，学于大学，命曰造士。行同能偶，则别之以射，然后爵命焉。","book":"《汉书·食货志上》"},"usage":"作谓语、定语；用于书面语"},{"id":39806,"word":"行吟坐咏","pinyin":"xíng yín zuò yǒng","abbr":"xyzy","explanation":"吟、咏：声调抑扬地念、唱。走着也念，坐着也读。形容读书用功。","source":{"text":"陛下昔岁尚学，置立五馆，行吟坐唱，诵声溢境。","book":"《南史·郭祖深传》"},"usage":"作谓语、定语；用于读书"},{"id":39807,"word":"行善如登，行恶如崩","pinyin":"xíng shàn rú dēng，xíng è rú bēng","abbr":"xsrdxerb","explanation":"比喻做好事就像登山一样困难，做干事就像山崩溃那样容易。"},{"id":39808,"word":"行坐不安","pinyin":"xíng zuò bù ān","abbr":"xzba","explanation":"走也不是，坐也不是。形容心绪焦躁不安的样子。","source":{"text":"近见大人两眉愁锁，必有国家大事，又不敢问。今晚又见行坐不安，因此长叹，不想为大人窥见。","book":"明·罗贯中《三国演义》第八回"},"example":{"text":"从这天起，他便如油锅上蚂蚁一般，～。","book":"清·吴趼人《二十年目睹之怪现状》第八十八回"},"similar":["坐立不安"],"usage":"作谓语、定语、状语；用于处事"},{"id":39809,"word":"行奸卖俏","pinyin":"xíng jiān mài qiào","abbr":"xjmq","explanation":"指恣淫行邪，弄姿作态。","source":{"text":"是一个行奸卖俏的小伙子，使钱撒漫的大老官。","book":"明·许自昌《水浒记》第三出：“你若肯行奸卖俏，何必献笑倚门？你不惜目挑心招，无俟招摇过市。”《石点头·瞿凤奴情愆死盖》"},"example":{"text":"那张荩乃风流子弟，只晓得三瓦两舍，～，是他的本等。","book":"明·冯梦龙《醒世恒言》第十六卷"},"usage":"作谓语、定语；用于处事"},{"id":39810,"word":"行好积德","pinyin":"xíng hǎo jī dé","abbr":"xhjd","explanation":"行好：做好事；积德：积功德。旧时劝人行善做好事的套话。","source":{"text":"那婆子又央众人道：‘我虽错了，姑娘们吩咐了，我以后改过。姑娘们那不是行好积德。’","book":"清·曹雪芹《红楼梦》第五十九回"},"example":{"text":"要有个人能给我管教管教，真是～啦！","book":"马烽《吕梁英雄传》第十二回"},"usage":"作谓语、宾语、定语；用于劝诫人"},{"id":39811,"word":"行如禽兽","pinyin":"xíng rú qín shòu","abbr":"xrqs","explanation":"旧时指人无耻，行为象禽兽一样。形容人的行为卑鄙恶劣到了极点。同“行同狗豨”。","source":{"text":"心如虎狼，行如禽兽。","book":"《荀子·修身》"}},{"id":39812,"word":"行家里手","pinyin":"háng jiā lǐ shǒu","abbr":"hjls","explanation":"里手：内行人。指精通这种业务的人。","source":{"text":"批评东西的毛病，说那东西的出处，着实是个行家。","book":"清·吴趼人《二十年目睹之怪现状》"}},{"id":39813,"word":"行将就木","pinyin":"xíng jiāng jiù mù","abbr":"xjjm","explanation":"行将：将要；木：指棺材。指人寿命已经不长，快要进棺材了。","source":{"text":"我二十五年矣，又如是而嫁，则就木焉。","book":"《左传·僖公二十三年》"},"example":{"text":"但老夫～，只求晚年残喘。","book":"清·吴趼人《痛史》第二十五回"},"similar":["枯木朽株","气息奄奄"],"opposite":["欣欣向荣","蒸蒸日上"],"usage":"作谓语、定语；指快要死亡","story":["春秋时期，晋国内乱，公子重耳与夷吾外逃他国。重耳在狄国娶季隗为妻。公子夷吾借助秦国力量回国继位为晋惠公，想派人暗杀重耳。重耳要季隗等她25年后再嫁。季隗说到时快要进棺材了还谈什么改嫁。后来重耳在秦国帮助成为晋文公"]},{"id":39814,"word":"行尸坐肉","pinyin":"xíng shī zuò ròu","abbr":"xszr","explanation":"行尸：可以走动的尸体；坐肉：没有灵魂的躯壳。比喻不动脑筋，不起作用，糊里糊涂过日子的人。","source":{"text":"夫人好学，虽死若存；不学者，虽存，谓之行尸走肉耳。","book":"晋·王嘉《拾遗记》卷六"},"example":{"text":"但一味爱惜，与他吃，与他穿，养得肥头胖脸，著锦穿绫，且是好看，却是一个～。","book":"明·东鲁古狂生《醉醒石》第七回"}},{"id":39815,"word":"行尸走肉","pinyin":"xíng shī zǒu ròu","abbr":"xszr","explanation":"行尸：可以走动的尸体；走肉：会走动而没有灵魂的躯壳。比喻不动脑筋，不起作用，糊里糊涂过日子的人。","source":{"text":"夫人好学，虽死若存；不学者，虽存，谓之行尸走肉耳。","book":"晋·王嘉《拾遗记》卷六"},"example":{"text":"在他们的心目中，任何貌似强大的侵略者，都只不过是一群徒有虚表的～而已。","book":"峻青《不尽巨涛滚滚来》"},"similar":["酒囊饭袋","行尸走骨"],"opposite":["虽死犹生"],"usage":"作宾语、定语；指没有思想的人","story":["东汉人任末从小家境贫寒，他勤奋好学，始终坚持自学。他对自己要求活到老、学到老，曾经用荆条作笔，用树液加上烟灰作墨，映着月光读书。他成为一个十分博学的人，收了很多学生，他说人如果不学习就像行尸走肉一样"]},{"id":39816,"word":"行尸走骨","pinyin":"xíng shī zǒu gǔ","abbr":"xszg","explanation":"比喻不动脑筋，不起作用，糊里糊涂过日子的人。同“行尸走肉”。","source":{"text":"虽位极人臣，皆行尸走骨矣。","book":"宋·张君房《云笈七签》卷六十"},"similar":["行尸走肉","走肉行尸"],"usage":"作宾语、定语；指没有思想的人"},{"id":39817,"word":"行峻言厉","pinyin":"xíng jùn yán lì","abbr":"xjyl","explanation":"行：行为；峻：严厉。指一个人的行为和言语都非常严厉。","source":{"text":"形大而声宏，行峻而言厉，心醇而气和。","book":"唐·韩愈《答尉迟生书》"},"usage":"作宾语、定语；用于书面语"},{"id":39818,"word":"行崄侥幸","pinyin":"xíng xiǎn jiǎo xìng","abbr":"xxjx","explanation":"指冒险行事以求利。同“行险徼幸”。"},{"id":39819,"word":"行己有耻","pinyin":"xíng jǐ yǒu chǐ","abbr":"xjyc","explanation":"一个人行事，凡自己认为可耻的就不去做。","source":{"text":"清闲贞静，守节整齐，行己有耻，动静有法，是谓妇德。","book":"《论语·子路》：“子贡问曰：‘何如斯可谓之士矣。’子曰：‘行己有耻，使于四方，不辱君命，可谓士矣。’”《后汉书·列女传˙曹世叔妻传》"},"example":{"text":"兄质性笃厚，～，不至有是。","book":"宋·陆九渊《与徐子宜书》"},"usage":"作谓语、定语；用于处事"},{"id":39820,"word":"行师动众","pinyin":"xíng shī dòng zhòng","abbr":"xsdz","explanation":"谓指挥大军作战。","source":{"text":"即位之后，褒礼大臣，料简功能，真伪不得相贸，务绝浮华谮毁之端，行师动众，论决大事，谋臣将相，咸服帝之大略。","book":"《三国志·魏书·明帝纪》“癸丑，葬高平陵”裴松之注引晋·王沈《魏书》"},"similar":["兴师动众","劳师动众","行军动众"],"opposite":["单枪匹马","小打小闹"],"usage":"作谓语、宾语、状语；指大规模行动"},{"id":39821,"word":"行常带经","pinyin":"xíng cháng dài jīng","abbr":"xcdj","explanation":"行：走；经：经书。走路经常携带经书。形容人好学","source":{"text":"行常带经，止息则诵习之。","book":"西汉·司马迁《史记·儒林传》"},"usage":"作谓语、定语；用于书面语"},{"id":39822,"word":"行得春风望夏雨","pinyin":"xíng dé chū fēng wàng xià yǔ","abbr":"xdcfwxy","explanation":"行：施。比喻要先给别人好处，然后别人才会给自己好处。","source":{"text":"我本是好人家孩儿，不是娼人家妇女，也是行下春风望夏雨。待要做眷属，枉坏了少俊前程，辱没了你裴家上祖！","book":"元·白朴《墙头马上》第四折"}},{"id":39823,"word":"行思坐忆","pinyin":"xíng sī zuò yì","abbr":"xszy","explanation":"走着坐着都在想。形容时刻在思考着或怀念着。","source":{"text":"行思坐忆，知他是，怎生过日。","book":"宋·袁去华《金蕉叶》"},"similar":["行思坐想","行思坐筹"],"usage":"作谓语、定语、状语；用于处事"},{"id":39824,"word":"行思坐想","pinyin":"xíng sī zuò xiǎng","abbr":"xszx","explanation":"走着坐着都在想。形容时刻在思考着或怀念着。","source":{"text":"行思坐忆，知他是，怎生过日。","book":"宋·袁去华《金蕉叶》"},"example":{"text":"殿上，帝王，～正南下望，知祸起自天降。","book":"元·关汉卿《双赴梦》第二折"},"similar":["行思坐筹","行思坐忆"],"usage":"作谓语、定语、状语；用于处事"},{"id":39825,"word":"行思坐筹","pinyin":"xíng sī zuò chóu","abbr":"xszc","explanation":"形容时刻在思考着或怀念着。同“行思坐想”。","source":{"text":"生行思坐筹，无以为计。","book":"清·蒲松龄《聊斋志异·青娥》"},"similar":["行思坐想","行思坐忆"],"usage":"作谓语、定语、状语；用于处事"},{"id":39826,"word":"行成于思","pinyin":"xíng chéng yú sī","abbr":"xcys","explanation":"行：做事；思：思考。做事情成功是因为多思考，失败是由于不经心。指做事情要多思考，多分析。","source":{"text":"行成于思，毁于随。","book":"唐·韩愈《进学解》"},"example":{"text":"～，这是学业、事业有成的格言。"},"usage":"作谓语、宾语；指做事情要多思考"},{"id":39827,"word":"行成功满","pinyin":"xíng chéng gōng mǎn","abbr":"xcgm","explanation":"满：圆满。旧指出家修炼成仙。","source":{"text":"三千日、行成功满。稳驾祥云，独通霄汉。","book":"元·王哲《夜行船》词"},"similar":["行满功成","功成行满"],"usage":"作谓语、宾语；指成功"},{"id":39828,"word":"行或使之","pinyin":"xíng huò shǐ zhī","abbr":"xhsz","explanation":"行：所作所为；使：命令，指使。所作所为好像有人指使似的。比喻做事自觉主动","source":{"text":"行，或使之，止，或尼之，行止非人所能也。","book":"战国·邹·孟轲《孟子·梁惠王》"},"usage":"作谓语；用于书面语"},{"id":39829,"word":"行所无事","pinyin":"xíng suǒ wú shì","abbr":"xsws","explanation":"行：行动，办事。指人在紧急关头，态度镇定，毫不慌乱。有时也指对坏人坏事听之任之，满不在乎。","source":{"text":"禹之行水也，行其所无事也。","book":"《孟子·离娄下》"},"example":{"text":"见面之后，朱侍郎尚是～，不料这黄仲文面上顿时露出一副羞惭之色。","book":"清·李宝嘉《中国现在记》第二回"},"usage":"作谓语、定语、状语；用于处事"},{"id":39830,"word":"行数墨寻","pinyin":"háng shǔ mò xún","abbr":"xsmx","explanation":"行数：一行行地读；墨寻：一字字地读。指只会诵读文句，而不能理解义理。也指专在文字上下功夫。","source":{"text":"口内诵经千卷，体上问经不识。不解佛法圆通，徒劳寻行数墨。","book":"宋·释道原《景德传灯录》卷二十九"},"example":{"text":"今也句摭字捃，～，兴会索然。","book":"清·钱谦益《列朝诗集小传·丁·李按察攀龙》"}},{"id":39831,"word":"行无越思","pinyin":"xíng wú yuè sī","abbr":"xwys","explanation":"所行之事不要超过所想的内容。","source":{"text":"政如农功，日夜思之，思其始而成其终；朝夕而行之，行无越思，如农之有畔，其过鲜矣。","book":"《左传·襄公二十五年》"},"usage":"作宾语、定语；用于处事"},{"id":39832,"word":"行易知难","pinyin":"xíng yì zhī nán","abbr":"xyzn","explanation":"行：实施；知：知晓。实行容易，但通晓其道理却很困难。","source":{"text":"天下的事情，的确是行易知难。","book":"孙中山《民权主义》第二讲"},"example":{"text":"说～，真是确切不移。","book":"叶圣陶《某城纪事》"},"usage":"作宾语、定语；用于书面语"},{"id":39833,"word":"行有余力","pinyin":"xíng yǒu yú lì","abbr":"xyyl","explanation":"做了事情以后，还有剩余的精力和时间。","source":{"text":"行有余力，则以学文。","book":"《论语·学而》"},"example":{"text":"鲁迅《书信集·致许寿裳》：“至整顿一层，不如待天气清明以后，或官已做稳，～时耳。”"},"usage":"作谓语、定语；用于处事"},{"id":39834,"word":"行步如风","pinyin":"xíng bù rú fēng","abbr":"xbrf","explanation":"形容走路的步子轻快得像风一样。","source":{"text":"至寺门下，觉身轻神逸，行步如飞，洎归舍，不复饮食。","book":"宋·洪迈《夷坚丁志·李茇遇仙》"},"similar":["行走如飞","行步如飞"],"usage":"作谓语、定语；用于书面语"},{"id":39835,"word":"行步如飞","pinyin":"xíng bù rú fēi","abbr":"xbrf","explanation":"走路的步子轻快如飞。亦作“行步如风”、“行疾如飞”、“行走如飞”。","source":{"text":"至寺门下，觉身轻神逸，行步如飞，洎归舍，不复饮食。","book":"宋·洪迈《夷坚丁志·李茇遇仙》"},"similar":["行走如飞","行步如风"],"usage":"作谓语、宾语；用于书面语"},{"id":39836,"word":"行比伯夷","pinyin":"xíng bǐ bó yí","abbr":"xbby","explanation":"行：品德；伯夷：商末孤竹君长子。品行可与伯夷相比拟。形容品德高洁","source":{"text":"年岁虽小，可师长兮，行比伯夷，置以为像兮。","book":"战国·楚·屈原《九章·桔颂》"},"usage":"作谓语、定语；用于书面语"},{"id":39837,"word":"行流散徙","pinyin":"xíng liú sǎn xǐ","abbr":"xlsx","explanation":"徙：迁徙。像云行水流似的分散迁徙。指万物随自然规律而变化","source":{"text":"行流散徙，不主常声。","book":"战国·宋·庄周《庄子·天运》"},"usage":"作宾语、定语；用于书面语"},{"id":39838,"word":"行浊言清","pinyin":"xíng zhuó yán qīng","abbr":"xzyq","explanation":"清：清高；浊：浑浊，指低下。说的是清白好话，十的是污浊坏事。形容人言行不一。","source":{"text":"言轻行浊，执不通变。","book":"唐·李虚中《命书》卷中"},"example":{"text":"杜牧之难折证，掉僧孺不志诚，都一般～。","book":"元·乔孟符《扬州梦》第四折"},"usage":"作谓语、宾语、定语；用于处事"},{"id":39839,"word":"行满功圆","pinyin":"xíng mǎn gōng yuán","abbr":"xmgy","explanation":"行满：修行期满。旧指出家修炼成仙。","source":{"text":"要行满功圆，跨鹤儿飞上天。","book":"元·无名氏《新水令·殿前欢》"},"similar":["行满功成"],"usage":"作谓语、宾语、定语；指成功"},{"id":39840,"word":"行满功成","pinyin":"xíng mǎn gōng chéng","abbr":"xmgc","explanation":"行满：修行期满。旧指出家修炼成仙。","source":{"text":"五更里，天晓架上金鸡叫。有个忙儿，拍手呵呵笑。放饱牛儿，快活睡一觉。行满功成，自有丹书诏。","book":"元·马钰《挂金索五首》其四"},"example":{"text":"先生修养三世，～，当得元沴于月中，而为孝道明王。","book":"明·冯梦龙《警世通言》卷四十"},"similar":["行成功满","功成行满","行满功圆"],"usage":"作谓语、宾语、定语；指成功"},{"id":39841,"word":"行疾如飞","pinyin":"xíng jí rú fēi","abbr":"xjrf","explanation":"形容走路的步子轻得像飞一样。","source":{"text":"至寺门下，觉身轻神逸，行步如飞，洎归舍，不复饮食。","book":"宋·洪迈《夷坚丁志·李茇遇仙》"},"usage":"作谓语、定语；用于书面语"},{"id":39842,"word":"行百里者半九十","pinyin":"xíng bǎi lǐ zhě bàn jiǔ shí","abbr":"xblzbjs","explanation":"走一百里路，走了九十里才算是一半。比喻做事愈接近成功愈要认真对待。","source":{"text":"诗云：‘行百里者半九十。’此言末路之难也。","book":"《战国策·秦策五》"},"example":{"text":"～，掘井九仞，犹为弃井。","book":"清·梁启超《过渡时代论》"},"similar":["行百里者半于九十"],"usage":"作分句；用于劝诫人"},{"id":39843,"word":"行百里者半于九十","pinyin":"xíng bǎi lǐ zhě bàn yú jiǔ shí","abbr":"xblzbyjs","explanation":"走一百里路，走了九十里才算是一半。比喻做事越是接近成功越要认真对待。","source":{"text":"诗云：‘行百里者半于九十’，此言末路之难也。","book":"西汉·刘向《战国策·秦策五》"},"example":{"text":"持坚无术，末路蹉跎，～，彪之谓也。","book":"《北史·韩麒麟等传论》"},"similar":["行百里者半九十"],"usage":"作分句；用于劝诫人"},{"id":39844,"word":"行监坐守","pinyin":"xíng jiān zuò shǒu","abbr":"xjzs","explanation":"监：监视。指对人的一举一动都在旁边严密监视、看守。","source":{"text":"我着你但去处行监坐守，谁着你迤逗的胡行乱走？","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"得你意，平生够，喜温柔。怎禁你～。闲寻斗，不肯休，折证倒看谁羞。","book":"元·曾瑞《小令·商调》"},"usage":"作谓语、定语；用于书面语"},{"id":39845,"word":"行眠立盹","pinyin":"xíng mián lì dǔn","abbr":"xmld","explanation":"形容极度疲倦无精神。","source":{"text":"若做官后每日价行眠立盹。","book":"元·马致远《陈抟高卧》第二折"},"example":{"text":"我每日千思万想，～，不是存活。","book":"元·石君宝《紫云亭》第三折"},"usage":"作谓语、定语；用于人的状态"},{"id":39846,"word":"行短才乔","pinyin":"xíng duǎn cái qiáo","abbr":"xdcq","explanation":"行短：行为卑鄙；乔：高。才能虽高但行为卑劣。","source":{"text":"这是负心人行短才乔，转眼处把人嘲诮，更烂翻寸舌，易起波涛。","book":"明·张凤翼《红拂记·同调相怜》"},"similar":["行短才高"],"usage":"作谓语、定语；用于人"},{"id":39847,"word":"行短才高","pinyin":"xíng duǎn cái gāo","abbr":"xdcg","explanation":"行短：行为卑鄙。才能虽高但行为卑劣。","source":{"text":"这是负心人行短才乔，转眼处把人嘲诮，更烂翻寸舌，易起波涛。","book":"明·张凤翼《红拂记·同调相怜》"},"similar":["行短才乔"],"usage":"作谓语、定语；用于人"},{"id":39848,"word":"行者让路","pinyin":"xíng zhě ràng lù","abbr":"xzrl","explanation":"行走的人相互让路。指大家都谦逊有礼。","source":{"text":"又言山出车，泽出舟，男女异路，市无二价，耕者让畔，行者让路。","book":"汉·王充《论衡·是应篇》"},"example":{"text":"刚才我们一路看来，那些“耕者让畔，～”光景，已是不争之意。","book":"清·李汝珍《镜花缘》第十一回"},"usage":"作宾语、定语；用于书面语"},{"id":39849,"word":"行而世为天下法","pinyin":"xíng ér shì wèi tiān xià fǎ","abbr":"xeswtxf","explanation":"行：所作所为；法：效法。言行要谨慎，自己的一言一行要为世人作学习榜样","source":{"text":"是故君子，动而世为天下道，行而世为天下法，言而世为天下则。","book":"西汉·戴圣《礼记·中庸》"},"usage":"作宾语、定语；用于书面语"},{"id":39850,"word":"行而未成","pinyin":"xíng ér wèi chéng","abbr":"xewc","explanation":"行：从事；成：成功。虽然行动了但没有成功。比喻时机还没有成熟","source":{"text":"文言曰：隐而未见，行而未成，是以君子费用也。","book":"《周易·乾》"},"usage":"作谓语、宾语；用于处事"},{"id":39851,"word":"行色匆匆","pinyin":"xíng sè cōng cōng","abbr":"xscc","explanation":"行色：出发前后的神态。行走或出发前后的神态举止急急忙忙的样子。","source":{"text":"西风吹冷透貂裘，行色匆匆不暂留。","book":"唐·牟融《送客之杭》"},"example":{"text":"又是在～里，一两天要到新汉寿。","book":"冰心《寄小读者》"},"similar":["风尘仆仆","行色仓皇"],"opposite":["无所事事","悠哉游哉"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":39852,"word":"行色怱怱","pinyin":"xíng sè cōng cōng","abbr":"xscc","explanation":"行走或出发前后的神态举止急急忙忙的样子。同“行色匆匆”。"},{"id":39853,"word":"行色恠恠","pinyin":"xíng sè cōng cōng","abbr":"xscc","explanation":"行走或出发前后的神态举止急急忙忙的样子。同行色匆匆”。"},{"id":39854,"word":"行若无事","pinyin":"xíng ruò wú shì","abbr":"xrws","explanation":"行：行动，办事；若：好像。指人在紧急关头，态度镇定，毫不慌乱。有时也指对坏人坏事听之任之，满不在乎。","source":{"text":"万太尊说罢，行若无事。","book":"清·李宝嘉《官场现形记》"},"example":{"text":"甚至听了反革命分子的话也不报告，泰然处之，～。","book":"毛泽东《反对自由主义》"},"similar":["泰然自若","神色不惊"],"opposite":["手忙脚乱","大惊小怪"],"usage":"作谓语、状语；指人的态度镇定"},{"id":39855,"word":"行若狗彘","pinyin":"xíng ruò gǒu zhì","abbr":"xrgz","explanation":"指人无耻，行为像猪狗一样。","source":{"text":"故此一豫让也，反君事仇，行若狗彘。","book":"西汉·贾谊《论治安策》"},"example":{"text":"阳为道学，阴为富贵，被服儒雅，～然也。","book":"明·李贽《三教归儒说》"},"similar":["行同狗彘"],"usage":"作谓语、定语；指人无耻","story":["战国时期，子夏的徒弟去问子墨子说：“君子有标准没有？”子墨子说君子没有固定的标准。子夏的徒弟说：“猪狗都有标准，作恶的人怎么会没有标准呢？”子墨子说：“那些口头上说得好听而行动却比猪狗还不如，这不能称君子。”"]},{"id":39856,"word":"行若由夷","pinyin":"xíng ruò yóu yí","abbr":"xryy","explanation":"行：行为；由、夷：指春秋时的许由和伯夷，古代的廉洁之士。比喻品德高尚，做人清正廉洁。","source":{"text":"若仆大质已方缺矣，虽才怀隋和，行若由夷，终不可以为荣，适足以见笑而自点耳。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"方今谗人高张，贤士无名，虽材怀隋和，～的，终不能达九重。","book":"明·施耐庵《水浒全传》第一百八回"}},{"id":39857,"word":"行藏用舍","pinyin":"xíng cáng yòng shě","abbr":"xcys","explanation":"行：做，实行。藏；退隐。用：任用。舍：不用。","source":{"text":"用之则行，舍之则藏，唯我与尔有是夫。","book":"《论语·述而》"},"example":{"text":"乐天知命，古来谁会，～。","book":"宋·辛弃疾《水龙吟·题瓢泉》"},"similar":["用舍行藏"],"usage":"作谓语、定语；用于书面语"},{"id":39858,"word":"行行出状元","pinyin":"háng háng chū zhuàng yuán","abbr":"hhczy","explanation":"〖释义〗比喻不论干哪一行，只要热爱本职工作，都能做出优异的成绩。","example":{"text":"明  冯惟敏 《玉抱肚·赠赵今燕》曲：“琵琶輕掃動人憐，須信行行出狀元。”《儿女英雄传》第十一回：“ 張老 道：‘姑爺，俗話兒説的，“行行出狀元”。又説，“好漢不怕出身低”，那一行没有好人哪！’” 陶行知 《社会大学颂》诗：“行行出状元，工人可以中状元，失学的青年可以中状元。”"}},{"id":39859,"word":"行行蛇蚓","pinyin":"háng háng shé yǐn","abbr":"hhsy","explanation":"形容字体如蛇蚓盘绕，难以辨认。","source":{"text":"行行蛇蚓字相续，野农不识何由读？","book":"《晋书·王羲之传》：“行行若萦春蚓，字字如绾秋蛇。”宋·利登《野农谣》诗"}},{"id":39860,"word":"行行重行行","pinyin":"xíng xíng chóng xíng xíng","abbr":"xxcxx","explanation":"行行：走啊，走啊；重：又。指道路遥远，走了一程又一程。","source":{"text":"行行重行行，与君生别离。","book":"《古诗十九首》其一"},"example":{"text":"～，忽地眼睛一亮。只见前面一个冰湖，湖面的冰层已经开始解冻。","book":"梁羽生《弹指惊雷》第三回"},"usage":"作谓语、宾语；用于书面语"},{"id":39861,"word":"行言自为","pinyin":"xíng yán zì wéi","abbr":"xyzw","explanation":"行：行为；言：言论。行为和言论都是自己发出的。比喻要自己约束自己","source":{"text":"行言自为而天下化，手挠顾指，四方之民莫不俱至，此之谓圣治。","book":"战国·宋·庄周《庄子·天地》"},"usage":"作宾语、定语；用于书面语"},{"id":39862,"word":"行词告状","pinyin":"xíng cí gào zhuàng","abbr":"xcgz","explanation":"写状词打官司。","source":{"text":"前日有我小舅子暗暗的寄一封书来与我，着我拆开看，谁想俺小舅子打死两个人的命，那苦主要行词告状。","book":"元·无名氏《延安府》第一折"}},{"id":39863,"word":"行财买免","pinyin":"xíng cái mǎi miǎn","abbr":"xcmm","explanation":"行：从事。花费钱财，买得免罪。指用金钱贿赂以逃避惩罚","source":{"text":"落得骗了些果子吃进肚里，且又得了行财买免的供招。","book":"清·西周生《醒世姻缘传》第66回"},"usage":"作宾语、定语；用于处事"},{"id":39864,"word":"行赍居送","pinyin":"xíng jī jū sòng","abbr":"xjjs","explanation":"行：指服徭役的人；赍：自己携带生必须品。服徭役的人，自己携带衣食之具；不服徭役的人，也要承担繁重的财物。","source":{"text":"干戈日滋，行者赍，居者送，中外骚扰相奉，百姓抚敝以巧法，财赂衰耗而不澹。","book":"《汉书·食货志下》"},"example":{"text":"比年师行出入，皆经山西地方，有～之劳。其免山西明年额赋。","book":"《清史稿·世祖纪二》"}},{"id":39865,"word":"行走如风","pinyin":"xíng zǒu rú fēng","abbr":"xzrf","explanation":"形容走路的步子轻快得像风一样。","source":{"text":"其女或朝出暮至，或夜出晓来，行步如风。","book":"宋·李昉《太平广记》卷三百二十八"},"example":{"text":"郭靖怕他有失，催马赶上，小红马～，一瞬眼间已追在前头。","book":"金庸《射雕英雄传》第四十回"}},{"id":39866,"word":"行走如飞","pinyin":"xíng bù rú fēi","abbr":"xzrf","explanation":"形容走路快得像飞一样。","source":{"text":"至寺门下，觉身轻神逸，行步如飞，洎归舍，不复饮食。","book":"宋·洪迈《夷坚丁志·李茇遇仙》"},"similar":["行步如飞","行步如风"],"usage":"作谓语、宾语；用于走路"},{"id":39867,"word":"行踪无定","pinyin":"xíng zōng wú dìng","abbr":"xzwd","explanation":"行踪：行动的踪迹。指在各处来往出没，没有固定处所。","source":{"text":"出家人行踪无定，待贫道自去寻来。","book":"清·钱彩《说岳全传》第一回"},"example":{"text":"清·李百川《绿野仙踪》第62回：“那冷于冰～，知道他如今在那里？”"},"usage":"作谓语、定语；用于人或事物等"},{"id":39868,"word":"行过乎恭","pinyin":"xíng guò hū gōng","abbr":"xghg","explanation":"行：所作所为；乎：相当“于”。所作所为过于恭敬。指恭敬过度","source":{"text":"君子以行过乎恭，丧过乎哀，用过乎俭。","book":"《周易·小过》"},"usage":"作谓语、定语；用于书面语"},{"id":39869,"word":"行迈靡靡，中心摇摇","pinyin":"xíng mài mǐ mǐ，zhōng xīn yáo yáo","abbr":"xmmmzxyy","explanation":"行迈：走路；靡靡：行走迟缓的样子。走路缓慢，心里晃荡。形容心情沉重惶惑。","source":{"text":"彼黍离离，彼稷之苗，行迈靡靡，中心摇摇。","book":"《诗经·王风·黍离》"},"example":{"text":"正值雨雪，俱乘款段，莫不艰辛；朝则齐鏣，夜还连榻，～。","book":"五代·王定保《唐摭言·怨怒》"},"usage":"作分句；用于书面语"},{"id":39870,"word":"行远升高","pinyin":"xíng yuǎn shēng gāo","abbr":"xysg","explanation":"比喻为学由浅入深，逐步提高。","source":{"text":"君子之道，辟（譬）如行远必自迩，辟如登高必自卑。","book":"《书·太甲》：“若升高，必自下；若陟遐，必自迩。”《礼记·中庸》"},"example":{"text":"明·张居正《进进章疏》：“虽章句浅近之言，不足以仰窥圣学精微之奥，然～，或亦一助云耳。”"},"usage":"作宾语、定语；用于比喻句"},{"id":39871,"word":"行远必自迩，登高必自卑","pinyin":"xíng yuǎn bì zì ěr，dēng gāo bì zì bēi","abbr":"xybzedgbzb","explanation":"自；从；迩：近；卑：低下。走远路必须要从近处开始，登高必须从低处开始。比喻做事情都得由浅入深，循序渐进","source":{"text":"君子之道，辟如行远必自迩，辟如登高必自卑。","book":"西汉·戴圣《礼记·中庸》"},"similar":["行远升高"],"usage":"作宾语、定语；用于劝诫人"},{"id":39872,"word":"行远自迩","pinyin":"xíng yuǎn zì ěr","abbr":"xyze","explanation":"自：从；迩：近。走远路必须要从最近的一步走起。比喻做事情都得由浅入深，一步步前进。","source":{"text":"君子之道，辟（譬）如行远必自迩，辟（譬）如登高必自卑。","book":"《礼记·中庸》"},"example":{"text":"～，学习要先打好基础，然后再逐步加深。"},"similar":["由浅入深","登高自卑"],"opposite":["一步登天","好高骛远"],"usage":"作宾语、定语、分句；比喻由浅入深"},{"id":39873,"word":"行远自迩，登高自卑","pinyin":"xíng yuǎn zì ěr，dēng gā zì bēi","abbr":"xyzedgzb","explanation":"《礼记·中庸》：“君子之道，辟如行远必自迩，辟如登高必自卑。”","source":{"text":"君子之道，辟如行远必自迩，辟如登高必自卑。","book":"《礼记·中庸》"},"example":{"text":"所谓～，州县博收，乃所以备正史之约以也。","book":"清·章学诚《文史通义·永清县志士旅表序例》"}},{"id":39874,"word":"行迹可疑","pinyin":"xíng jì kě yí","abbr":"xjky","explanation":"行迹：行动的踪迹；可疑：值得怀疑。举动和神色值得怀疑","example":{"text":"得注意那些～的人"},"similar":["形迹可疑"],"usage":"作谓语、定语；用于人的举动"},{"id":39875,"word":"行针步线","pinyin":"xíng zhēn bù xiàn","abbr":"xzbx","explanation":"比喻设计划策。","source":{"text":"试看我行针步线，俺在这梁园城一交却又早二十年。","book":"元·无名氏《蓝采和》第一折"},"usage":"作宾语、定语；用于比喻句"},{"id":39876,"word":"行间字里","pinyin":"háng jiān zì lǐ","abbr":"hjzl","explanation":"指文章的字句中间。","source":{"text":"书有圈点勾勒，始自前明中叶选刻时文陋习。然行间字里，触眼特为爽豁，故仿而用之。","book":"南朝·梁·简文帝《答新渝侯和诗书》：“垂示三首，风云吐于行间，珠玉生于字里。”清·平步青《霞外■（扌麕）屑·论文下·文章圈点》"},"example":{"text":"今阅是书所说中西利病情形，了如指掌。其忠义之气，溢于～，实获我心，故缀数语。 ◎清·彭玉麟《〈盛世危言〉序》"}},{"id":39877,"word":"行险侥幸","pinyin":"xíng xiǎn jiǎo xìng","abbr":"xxjx","explanation":"行险：冒险；侥幸：偶然地获得成功或意外地免遭不幸。冒险行事以求得意外的成功。","source":{"text":"故君子居易以俟命，小人行险以侥幸。","book":"《礼记·中庸》"},"example":{"text":"又有边鄙之臣，～，轻动干戈，深入敌境，使兵夫数十万暴骸于旷野。","book":"清·毕沅《续资治通鉴》卷七十八"},"usage":"作宾语、定语；用于处事"},{"id":39878,"word":"行险徼幸","pinyin":"xíng xiǎn jiǎo xìng","abbr":"xxjx","explanation":"指冒险行事以求利。","source":{"text":"小人行险以徼幸。","book":"语出《礼记·中庸》"}},{"id":39879,"word":"行随事迁","pinyin":"xíng suí shì qiān","abbr":"xssq","explanation":"指行动要随着事情的发展而变化。","source":{"text":"故行随事迁，则言焉人殊，安得据住行以为典要，守前言以效尾生耶？","book":"明·李贽《焚书·先行录序》"},"usage":"作宾语、定语；用于书面语"},{"id":39880,"word":"行香挂牌","pinyin":"xíng xiāng guà pái","abbr":"xxgp","explanation":"学政到省后例行的仪式。行香：到孔丘庙烧香。挂牌：出牌公告考试地点、日期等。","source":{"text":"次日，行香挂牌。先考了两场生员。","book":"清·吴敬梓《儒林外史》第三回"}},{"id":39881,"word":"衒才扬己","pinyin":"xuàn cái yáng jǐ","abbr":"xcyj","explanation":"衒：炫耀；扬：赞扬，传播。显露自己的才能，表现自己。","source":{"text":"高谈王霸，衒才扬己，历抵公卿，不汲汲于荣名，不戚戚于卑位，盖养亲之故也。","book":"唐·骆宾王《上吏部裴侍郎书》"},"similar":["露才扬己","露己扬才","扬己露才"],"usage":"作谓语、定语、宾语；指显露自己的才能"},{"id":39882,"word":"衒材扬己","pinyin":"xuàn cái yáng jǐ","abbr":"xcyj","explanation":"炫耀才能，故意表现自己。","source":{"text":"亦何尝献策干时，高谈王霸，衒材扬己，力抵公卿。","book":"唐·骆宾王《上吏部裴侍郎书》"}},{"id":39883,"word":"衒玉求售","pinyin":"zuì yù qiú shòu","abbr":"xyqs","explanation":"比喻自夸其才以求任用或信任。同“衒玉自售”。","source":{"text":"子贡曰：‘有美玉于斯，韫椟而藏诸，求善贾而沽诸？’子曰：‘沽之哉，我待贾者也。’","book":"《论语·子罕》"},"example":{"text":"今日慕小妹之才，虽然～，又怕损了自己的名誉，不肯随行逐队，寻消问息。","book":"明·冯梦龙《醒世恒言》卷十一"},"similar":["衒玉自售"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39884,"word":"衒玉自售","pinyin":"zuì yù zì shòu","abbr":"xyzs","explanation":"比喻自夸其才以求任用或信任。","source":{"text":"沽之哉，不衒卖之辞。","book":"《论语·子罕》：“子贡曰：‘有美玉于斯，韫奁而藏诸，求善贾而沽诸？’子曰：‘沽之哉，沽之哉，我待贾者也。’”何晏集解引包咸曰"},"similar":["衒玉求售"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":39885,"word":"衒玉贾石","pinyin":"zuì yù jiǎ shí","abbr":"xyjs","explanation":"叫卖璧玉，实际上卖的却是石头。比喻言不副实。","source":{"text":"衒玉而贾石者，其狙诈乎！","book":"汉·扬雄《法言·问道》"},"similar":["鱼目混珠"],"usage":"作谓语、定语；指名不副实"},{"id":39886,"word":"衔冤负屈","pinyin":"xián yuān fù qū","abbr":"xyfq","explanation":"衔：含在嘴里，负：遭受；比喻心怀冤枉，身受委屈。","source":{"text":"我做了个衔冤负屈没头鬼，怎肯便放了你好色荒淫漏面贼！","book":"元·关汉卿《窦娥冤》第二折"},"example":{"text":"明·范受益《寻亲记·省夫》：“你吃人妆配，～无甚罪。”"},"similar":["负屈衔冤","负屈含冤"],"usage":"作谓语、宾语、定语；指蒙受委曲"},{"id":39887,"word":"衔勇韬力","pinyin":"xián yǒng tāo lì","abbr":"xytl","explanation":"衔：含；韬：掩藏。把勇气和力量掩藏起来。比喻收敛锋芒，等待时机成熟。","source":{"text":"衔勇韬力，日思予殛。","book":"唐·柳宗元《奉平淮夷伯雅表》"},"similar":["韬光养晦"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；用于处事等"},{"id":39888,"word":"衔华佩实","pinyin":"xián huá pèi shí","abbr":"xhps","explanation":"衔：包含；华：比喻文采；佩：佩带；实：果实，比喻文章的思想内容。形容文章的形式和内容都完美。也形容草木开花结果。","source":{"text":"然则圣文之雅丽，固衔华而佩实者也。","book":"南朝·梁·刘勰《文心雕龙·徵圣》"},"example":{"text":"窃观古人文章，～。","book":"清·钱谦益《复徐巨源书》"},"usage":"作谓语、定语；用于文章"},{"id":39889,"word":"衔口垫背","pinyin":"xián kǒu diàn bèi","abbr":"xkdb","explanation":"衔口：给死者嘴里含上珍珠、玉石或米作压舌物；垫背：在死者垫褥下面放钱。指古时殓葬时的一种习俗。比喻死亡。","source":{"text":"我又不等着衔口垫背，忙了什么。","book":"清·曹雪芹《红楼梦》第七十二回"},"usage":"作宾语、定语；用于书面语"},{"id":39890,"word":"衔哀致诚","pinyin":"xián āi zhì chéng","abbr":"xazc","explanation":"衔：含着。胸怀哀痛之情，致真诚之意。","source":{"text":"乃能衔哀致诚，使建中远具时羞之奠，告汝十二郎之灵。","book":"唐·韩愈《祭十二郎文》"},"usage":"作谓语、定语；用于书面语"},{"id":39891,"word":"衔尾相属","pinyin":"xián wěi xiāng zhǔ","abbr":"xwxs","explanation":"衔：马嚼子；尾：马尾巴。马嚼子接着马尾巴。形容一个紧跟着一个，成单行前进。","source":{"text":"如遇险阻，衔尾相随。","book":"《汉书·匈奴传》"},"example":{"text":"前马已去，后马续来，相次不绝者。古人谓之～，即其义也。","book":"唐·封演《封氏闻见记》卷五"},"similar":["衔尾相随"],"usage":"作谓语、定语；指一个紧跟着一个"},{"id":39892,"word":"衔尾相随","pinyin":"xián wěi xiāng suí","abbr":"xwxs","explanation":"衔：马嚼子；尾：马尾巴。马嚼子接着马尾巴。形容一个紧跟着一个，成单行前进。","source":{"text":"如遇险阻，衔尾相随。","book":"《汉书·匈奴传》"},"similar":["衔尾相属"],"usage":"作谓语、定语；指一个紧跟着一个"},{"id":39893,"word":"衔恨蒙枉","pinyin":"xián hèn méng wǎng","abbr":"xhmw","explanation":"衔：含着；蒙：受着。含着怨恨，受着冤枉。","source":{"text":"恐有司卒然见构，衔恨蒙冤，不得自叙，使后世论者，擅以陛下有此方比，宁可复使子孙追掩之乎？","book":"汉·孔僖《上书自讼》"},"usage":"作谓语、定语；用于处事等"},{"id":39894,"word":"衔悲茹恨","pinyin":"xián bēi rú hèn","abbr":"xbrh","explanation":"衔：含。茹：吃。胸中藏有悲痛与仇恨。亦作“衔悲蓄恨”。","source":{"text":"元崇母陈氏梦元崇还，具叙父亡及身被杀委曲，尸骸流漂，怨酷无双，奉违累载，亘　长辞，衔悲茹恨，如何可说，歔欷不能自胜。","book":"《太平广记》卷一二○引《还冤记》"},"similar":["衔悲蓄恨"],"usage":"作谓语、定语；用于书面语"},{"id":39895,"word":"衔悲蓄恨","pinyin":"xián bēi xù hèn","abbr":"xbxh","explanation":"衔：含；蓄：积蓄。胸中藏着悲痛和仇恨。","source":{"text":"伤今感昔兮三拍成，衔悲蓄恨兮何时平。","book":"汉·蔡琰《胡笳十八拍》"},"similar":["衔悲茹恨"],"usage":"作谓语、定语；用于书面语"},{"id":39896,"word":"衔枚疾走","pinyin":"xián méi jí zǒu","abbr":"xmjz","explanation":"衔：用嘴含；枚：像筷子的东西，两头有带，可系于颈上；疾走：快走。形容夜晚秘密急行军。","source":{"text":"又如赴敌之兵，衔枚疾走，不闻号令，但闻人马之行声。","book":"宋·欧阳修《秋声赋》"},"usage":"作谓语、定语；用于行军等"},{"id":39897,"word":"衔橛之变","pinyin":"xián jué zhī biàn","abbr":"xjzb","explanation":"指车马倾覆的危险。亦喻意外发生的事故。","source":{"text":"且夫道清而后行，中路而驰，犹时有衔橛之变。","book":"东汉·班固《汉书·司马相如传》"},"example":{"text":"《明史·赵佑传》：“万一有～，岂不为两宫忧。”"},"similar":["衔橛之虞"],"usage":"作宾语；用于书面语"},{"id":39898,"word":"衔橛之虞","pinyin":"xián jué zhī yú","abbr":"xjzy","explanation":"指车马倾覆的危险。亦喻意外发生的事故。同“衔橛之变”。","source":{"text":"夫利猛兽之乐者忘衔橛之虞。","book":"明·何景明《功实篇》"},"example":{"text":"清·夏燮《中西纪事·天津新议续议》：“一旦有触藩之变、～……京师岂复有可存之地哉！”"},"similar":["衔橛之变"],"usage":"作宾语；用于书面语"},{"id":39899,"word":"衔沙填海","pinyin":"xián shā tián hǎi","abbr":"xsth","explanation":"犹言衔石填海。比喻为实现既定目标，坚韧不拔地奋斗到底。","source":{"text":"衔沙填海志，炼石补天情。","book":"明·何景明《送吕子迁右给事中》诗"},"similar":["衔石填海","精卫填海"],"usage":"作宾语、定语；用于比喻句","story":["神话传说，上古时期炎帝最疼爱的小女儿女娃在东海游泳被水淹死，她的灵魂于是化成一只作精卫鸟，经常飞到西山去叼小石头和小树枝扔进东海，发誓要填平东海为自己报仇，她就这样一直飞来飞去，但最终也没有将东海填平"]},{"id":39900,"word":"衔玉贾石","pinyin":"xián yù jiǎ shí","abbr":"xyjs","explanation":"给人看的是玉，卖给人的却是石头，义同“挂羊头，卖狗肉”。","example":{"text":"这家小店老板经常做些～的买卖，以此发财。"}},{"id":39901,"word":"衔环结草","pinyin":"xián huán jié cǎo","abbr":"xhjc","explanation":"结草：把草结成绳子，搭救恩人；衔环：嘴里衔着玉环。旧时比喻感恩报德，至死不忘。","source":{"text":"莫学衔环雀，崎岖谩报恩。","book":"《左传·宣公十五年》：“及辅氏之役，颗见老人结草以亢杜回，杜回踬而颠，故获之。”唐·白居易《赎鸡》诗"},"example":{"text":"大恩未报，刻刻于怀。～，生死不负。","book":"明·冯梦龙《醒世恒言》卷十九"},"similar":["结草衔环"],"opposite":["忘恩负义"],"usage":"作宾语、定语；指感恩报德","story":["春秋时期，晋国大夫魏颗没有按照父亲的遗愿让小老婆陪葬而让她改嫁他人，小老婆的父亲的灵魂在战场上把草打结绊倒秦国大将杜回帮助魏颗取胜来报答。东汉人杨宝救了一只受伤的小黄雀，小黄雀伤好后叼来四个玉环来报答杨宝救命之恩"]},{"id":39902,"word":"衔石填海","pinyin":"xián shí tián hǎi","abbr":"xsth","explanation":"比喻为实现既定目标，坚韧不拔地奋斗到底。","source":{"text":"炎帝之少女名曰女娃。女娃游于东海，溺而不返，故为精卫，常衔西山之木石，以堙于东海。","book":"《山海经·北山经》"},"example":{"text":"清·谭嗣同《报贝元微书》：“此日之～，他日未必不收入人材蔚起之效。”"},"similar":["衔沙填海"],"usage":"作宾语、定语；用于比喻句","story":["神话传说，上古时期炎帝最疼爱的小女儿女娃在东海游泳被水淹死，她的灵魂于是化成一只作精卫鸟，经常飞到西山去叼小石头和小树枝扔进东海，发誓要填平东海为自己报仇，她就这样一直飞来飞去，但最终也没有将东海填平"]},{"id":39903,"word":"衔胆栖冰","pinyin":"xián dǎn qī bīng","abbr":"xdqb","explanation":"衔：嘴含；胆：苦胆；栖：栖息。嘴里含着苦胆，居住在冰上。形容刻苦自励。","source":{"text":"但以大耻未雪，社稷无主，衔胆栖冰，勉从群议。","book":"《晋书·刘元海载记》"},"usage":"作宾语、定语；用于处事等"},{"id":39904,"word":"街号巷哭","pinyin":"jiē hào xiàng kū","abbr":"jhxk","explanation":"号哭于大街小巷。形容悲痛至极。","source":{"text":"凡尔同围，心焉摧剥，扶老携幼，街号巷哭。","book":"晋·潘岳《马汧督诔》"},"usage":"作宾语、定语；指十分悲痛"},{"id":39905,"word":"街坊四邻","pinyin":"jiē fāng sì lín","abbr":"jfsl","explanation":"街坊：邻居。指住处邻近的人。同“街坊邻里”。","source":{"text":"街坊四邻，你们都听听。如今这年月，颠倒儿颠拉，媳妇是祖宗，婆婆是家奴，你们给评评，是我昏瞆了，是她欺辱我。","book":"《春阿氏谋夫案》第六回"},"example":{"text":"听到这个不幸的消息，～都来安慰他"},"similar":["街坊邻里"],"usage":"作主语、宾语、定语；用于口语"},{"id":39906,"word":"街坊邻居","pinyin":"jiē fāng lín jū","abbr":"jflj","explanation":"街坊：邻居。指邻居人家。","source":{"text":"自古道：好事不出门，恶事传千里。不到半月之间，街坊邻居，都知得了，只瞒着武大一个不知。","book":"明·施耐庵《水浒传》第24回"},"example":{"text":"谁都想与一个好的～作伴。"},"similar":["街坊邻舍"],"usage":"作主语、宾语、定语；指邻居"},{"id":39907,"word":"街坊邻舍","pinyin":"jiē fāng lín shě","abbr":"jfls","explanation":"街坊：邻居。指邻居人家。","source":{"text":"我们太太又多病，家务也忙，我原是个闲人，就是街坊邻舍，也要帮个忙儿，何况是姨娘托我。","book":"清·曹雪芹《红楼梦》第56回"},"example":{"text":"千万买邻是指好～的可贵。"},"similar":["街坊邻居"],"usage":"作主语、宾语、定语；指邻居"},{"id":39908,"word":"街坊邻里","pinyin":"jiē fāng lín lǐ","abbr":"jfll","explanation":"街坊：邻居。指住处邻近的人。亦作“街坊四邻”。","source":{"text":"他无过是指着收生老娘和街坊邻里做证见，我已都用银子买转了，这衙门以外的事，不要你费心。","book":"元·李行道《灰阑记》第一折"},"example":{"text":"奴丈夫脾性是不好惹的，他说得来，干得去，这时怕嘈闹起来，惊动了～，面子不知怎好见人了。","book":"清·黄小配《廿载繁华梦》第七回"},"similar":["街坊四邻"],"usage":"作主语、宾语、定语；用于口语"},{"id":39909,"word":"街头巷口","pinyin":"jiē tóu xiàng kǒu","abbr":"jtxk","explanation":"巷：胡同。指大街小巷。","source":{"text":"以贩卖书报盛极一时的各街头巷口的小书摊也完全改变模样。","book":"郭沫若《洪波曲》第一章"},"similar":["街头巷尾","街头巷底","巷尾街头"],"usage":"作宾语、定语；指大街小巷"},{"id":39910,"word":"街头巷尾","pinyin":"jiē tóu xiàng wěi","abbr":"jtxw","explanation":"指大街小巷。","source":{"text":"问：‘如何是学人转身处？’师日：‘街头巷尾。’","book":"宋·释普济《五灯会元》卷三十一"},"example":{"text":"上海的～的老虔婆，一知道近邻的阿二嫂家有野男人出入，津津乐道。","book":"鲁迅《且介亭杂文二集·论人言可畏》"},"similar":["大街小巷","街头市尾"],"usage":"作宾语、定语；指大街小巷"},{"id":39911,"word":"街头巷底","pinyin":"jiē tóu xiàng dǐ","abbr":"jtxd","explanation":"指大街小巷。同“街头巷尾”。","source":{"text":"杏花红了，梨花白了，街头巷底声声叫。","book":"刘大白《卖花女》诗"},"similar":["街头巷尾","街头巷口","巷尾街头"],"usage":"作宾语、定语；指大街小巷"},{"id":39912,"word":"街头市尾","pinyin":"jiē tóu shì wěi","abbr":"jtsw","explanation":"泛指大街小巷。","source":{"text":"今日未吃茶上堂堵人会心，但向街头市尾屠儿魁刽地狱钁汤处会取若恁么。","book":"宋·释普济《五灯会元·云门偃禅师法嗣》"},"similar":["街头巷尾","街头巷底","巷尾街头"],"usage":"作宾语、定语；指大街小巷"},{"id":39913,"word":"街巷阡陌","pinyin":"jiē xiàng qiān mò","abbr":"jxqm","explanation":"阡陌：小道。指大街小巷各个地方。","source":{"text":"至京师又聚会祀西王母，设祭于街巷阡陌。","book":"汉·荀悦《汉纪·哀帝纪》"},"similar":["大街小巷"],"usage":"作宾语、定语；指大街小巷各个地方"},{"id":39914,"word":"街溜子","pinyin":"jiē liū zǐ","abbr":"jlz","explanation":"指游荡街衢、不务正业的奸滑之徒。","example":{"text":"请收起你的～形象，踏踏实实地工作。"},"similar":["街滑子"],"usage":"作主语、宾语、定语；用于方言"},{"id":39915,"word":"街谈巷议","pinyin":"jiē tán xiàng yì","abbr":"jtxy","explanation":"大街小巷里人们的议论。指民间的舆论。","source":{"text":"街谈巷议，弹射威否。","book":"汉·张衡《西京赋》"},"example":{"text":"一路行来，～，大半都是这话。","book":"清·刘鹗《老残游记》第二回"},"similar":["众说纷纭","交头接耳","街谈巷说"],"usage":"作主语、宾语、定语；指民间的舆论","story":["东汉时期，统治阶级过着穷奢极侈的生活，他们霸占良田与民宅，搜刮民脂民膏。张衡写《西京赋》来讽谏东汉的统治阶级，其中讲到西汉丞相公孙贺的儿子贪污军饷，公孙贺则抓捕逃犯朱安世来为儿子顶罪，对此，人们街谈巷议纷纷批评与指责"]},{"id":39916,"word":"街谈巷语","pinyin":"jiē tán xiàng yǔ","abbr":"jtxy","explanation":"大街小巷里人们的议论。指民间的舆论。同“街谈巷议”。","source":{"text":"小说家者流，盖出于稗官，街谈巷语，道听途说者之所造也。","book":"《汉书·艺文志》"},"example":{"text":"宋·杨万里《乞不杀窦参及免薄录庄宅三床》：“献纳论思，安用此物哉！意其所陈，非～之鄙事，则说诌面谀之巧言也。”"},"similar":["街谈巷谚","街谭巷议","街谈巷议"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":39917,"word":"街谈巷说","pinyin":"jiē tán xiàng shuō","abbr":"jtxs","explanation":"大街小巷里人们的议论。指民间的舆论。同“街谈巷议”。","source":{"text":"今往仆少小所著辞赋一通相与。夫街谈巷说，必有可采；击辕之歌，有应风雅，匹夫之思，未易轻弃也。","book":"《文选·曹植·与杨德祖书》"},"similar":["街谈市语","街谈巷谚","街谈巷议"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":39918,"word":"街谈巷谚","pinyin":"jiē tán xiàng yàn","abbr":"jtxy","explanation":"大街小巷里人们的议论。指民间的舆论。同“街谈巷议”。","source":{"text":"公于召见时，凡民间隐情，街谈巷谚，无不率口而出，毫无隐忌，故人多尼之。","book":"清·昭梿《啸亭杂录·松相公好理学》"},"similar":["街谈巷说","街谈巷语","街谈巷议"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":39919,"word":"街谈市语","pinyin":"jiē tán shì yǔ","abbr":"jtsy","explanation":"大街小巷里人们的议论。指群众舆论。","source":{"text":"东坡云：‘街谈市语皆可入诗，但要人熔化耳。’","book":"宋·周紫芝《竹坡诗话》"},"example":{"text":"近日觉与市井屠沽，山鹿野獐，～，皆同得去，然尚不能合污，亦未免为病。","book":"明·袁宏道《解脱集·尺牍·朱司理》"},"similar":["街谈巷语","街谈巷议","巷议街谈"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":39920,"word":"街谭巷议","pinyin":"jiē tán xiàng yì","abbr":"jtxy","explanation":"大街小巷里人们的议论。指民间的舆论。同“街谈巷议”。","source":{"text":"仲尼祖述尧舜，宪章文武， 其道大德尊，岂与小儿街谭巷议乎又六合之外，非关教化者，仲尼弃而不论，故子路问事鬼神与死，皆不答也。","book":"唐·丘光庭《兼明书·杂说·日远近》"},"similar":["街谈巷语","街谈巷议","街谈巷说"],"usage":"作主语、宾语、定语；指民间的舆论"},{"id":39921,"word":"街道巷陌","pinyin":"jiē dào xiàng mò","abbr":"jdxm","explanation":"陌：小道。指大街小巷各个地方。","source":{"text":"遇新春，街道巷陌，官府差顾淘渠人沿门通渠。","book":"宋·吴自牧《东京梦梁录》卷十三"}},{"id":39922,"word":"衙官屈宋","pinyin":"yá guān qū sòng","abbr":"ygqs","explanation":"衙官：军府的属官；屈：屈原；宋：宋玉。要以屈原、宋玉为属官。原为自夸文章好。后也用以称赞别人的文采。","source":{"text":"吾文章当得屈、宋作衙官，吾笔当得王羲之北面。","book":"《新唐书·杜审言传》"},"example":{"text":"先生文学士，必能～，欲烦椽笔赋海市，幸无吝珠玉。","book":"清·蒲松龄《聊斋志异·罗刹海市》"},"usage":"作宾语、定语；用于书面语"},{"id":39923,"word":"衡情酌理","pinyin":"héng qíng zhuó lǐ","abbr":"hqzl","explanation":"估量情况，斟酌道理。","source":{"text":"这两位师老爷援古证今，衡情酌理的把‘古巴’截去了一个巴字。","book":"《宦海》第四回"},"usage":"作宾语、状语；指考虑"},{"id":39924,"word":"衡短论长","pinyin":"héng duǎn lùn cháng","abbr":"hdlc","explanation":"比较、评定事物的优劣。","source":{"text":"末学肤受，本无定事物的优劣。而抑扬其间，妄相拟议，遂与比类纂辑之业同年而语，而衡短论长，岑楼寸木且有不敌之势也，岂不诬哉？","book":"清·章学诚《文史通义·申郑》"},"similar":["说长道短"],"usage":"作谓语、宾语；指评论事物"},{"id":39925,"word":"衡石程书","pinyin":"héng shí chéng shū","abbr":"hscs","explanation":"用以形容君主勤于国政。同“衡石量书”。","source":{"text":"近君子而远小人，虽不亲细务，大功可成；不然，虽衡石程书，卫士传餐，亦无益也。","book":"宋·李纲《建炎进退志·总叙下之上》"},"example":{"text":"卫士传餐，～，如此其敬且勤也，奈何一再世而遂亡也耶？","book":"明·李贽《答周柳塘》"},"similar":["衡石量书","悬石程书"],"usage":"作谓语、定语；指勤于政事"},{"id":39926,"word":"衡石量书","pinyin":"héng shí liàng shū","abbr":"hsls","explanation":"古时文书用竹简木札，以衡石来计算文书的重量，因用以形容君主勤于国政。","source":{"text":"天下之事，无大小皆决於上，上至以衡石量书，日夜有呈，不中呈不得休息。","book":"《史记·秦始皇本纪》"},"similar":["衡石程书","悬石程书"],"usage":"作谓语、定语；指勤于政事","story":["公元前221年，秦始皇灭掉六国之后，日益骄横，对儒生横加指责，认为任何人都不如他，丞相和大臣都唯唯诺诺，一切听命于他。卢生、侯生对此不满，经常批评他贪权：“上至以衡石量书，日夜有呈，不中呈不得休息。”"]},{"id":39927,"word":"衡虑困心","pinyin":"héng lǜ kùn xīn","abbr":"hlkx","explanation":"形容费尽心思。","source":{"text":"困於心，衡於虑，而后作。","book":"语出《孟子·告子下》"},"example":{"text":"中间解衣缩食，～，体肤筋骨，靡所不惫，收集仅兹。","book":"明·胡应麟《少室山房笔丛·经籍会通四》"},"similar":["困心衡虑"],"usage":"作谓语、状语；表示费尽心力"},{"id":39928,"word":"衡门圭窦","pinyin":"héng mén guī dòu","abbr":"hmgd","explanation":"衡门：横木为门；圭窦：在墙上挖圭玉形的洞作窗。形容住所极其简陋。","source":{"text":"衡门圭窦之屋亦可以居。","book":"清·汪琬《答安轩记》"},"similar":["蓬门筚户"],"usage":"作宾语、定语；用于生活"},{"id":39929,"word":"衡门深巷","pinyin":"héng mén shēn xiàng","abbr":"hmsx","explanation":"衡门：横木为门，指简陋的地方；深巷：指冷落的巷子。简陋、偏僻的地方。","source":{"text":"闲岁月衡门深巷，淡衣冠博带宽裘。","book":"明·无名氏《三化邯郸》第三折"},"example":{"text":"我已经习惯这～的隐居生活。"},"usage":"作主语、宾语、定语；指偏僻的地方"},{"id":39930,"word":"衡阳雁断","pinyin":"héng yáng yàn duàn","abbr":"hyyd","explanation":"衡山南峰有回雁峰，相传雁来去以此为界。比喻音信不通。","source":{"text":"巫峡啼猿数行泪，衡阳归雁几封书。","book":"唐·高适《送李少府贬峡中王少府贬长沙》诗"},"example":{"text":"～三千路，巫峡猿啼十二峰。","book":"元·陈益稷《安南集·鄂馆书怀》"},"similar":["音信隔绝"],"usage":"作谓语、宾语；比喻音信不通"},{"id":39931,"word":"衣不兼彩","pinyin":"yī bù jiān cǎi","abbr":"ybjc","explanation":"衣服不全是彩色的。比喻衣着朴素","source":{"text":"素无铅华甘脆之好，衣不兼彩，食不重味。","book":"清·汪琬《敕封徐母刘孺人墓志》"},"similar":["衣不重彩","衣不重采","衣不兼采"],"usage":"作谓语、定语；比喻衣着朴素"},{"id":39932,"word":"衣不兼采","pinyin":"yī bù jiān cǎi","abbr":"ybjc","explanation":"衣服不全是彩色的。比喻衣着朴素","source":{"text":"家亡余财，衣不兼采，食不重味。","book":"东汉·班固《汉书·游侠传·朱家》"},"similar":["衣不重采","衣不兼彩","衣不重彩"],"usage":"作谓语、定语；比喻衣着朴素"},{"id":39933,"word":"衣不及带","pinyin":"yì bù jí dài","abbr":"ybjd","explanation":"衣：穿衣服；带：腰带。穿衣服来不及把腰带系上。形容时间仓促，装束不整。","source":{"text":"规素闻符名，乃惊遽而起，衣不及带，屣履出迎，援符手而还，与同坐，极欢。","book":"《后汉书·王充传》"},"example":{"text":"效节指挥使赵在礼闻乱，～，逾垣出走。","book":"蔡东藩《五代史演义》第十八回"}},{"id":39934,"word":"衣不如新，人不如故","pinyin":"yī bù rú xīn，rén bù rú gù","abbr":"ybrxrbrg","explanation":"衣服新的好，朋友旧的好。形容故旧不可轻弃。","source":{"text":"衣莫若新，人莫若故。","book":"《晏子春秋·内篇杂上》"},"example":{"text":"茕茕白兔，东走西顾。～。","book":"金庸《神雕侠侣》第二十回"},"usage":"作宾语、定语；用于书面语"},{"id":39935,"word":"衣不完采","pinyin":"yī bù wán cǎi","abbr":"ybwc","explanation":"衣服不全是彩色的。比喻衣着朴素。","source":{"text":"衣不守采，食不重味。","book":"《史记·游侠列传》"},"similar":["衣不重采"],"usage":"作谓语、定语；比喻衣着朴素"},{"id":39936,"word":"衣不布体","pinyin":"yī bù bù tǐ","abbr":"ybbt","explanation":"布：铺开。衣服破烂，连身子都遮盖不住。形容生活贫苦。","source":{"text":"臣八岁丧父，家贫无业，母兄乞丐以供资养。衣不布体，食无充肠，幼学三年不蒙师训。","book":"唐·元稹《同州刺史谢上表》"},"similar":["衣不蔽体","衣不盖体","衣不遮体"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":39937,"word":"衣不择采","pinyin":"yī bù zé cǎi","abbr":"ybzc","explanation":"衣服不选择彩色的。比喻衣着朴素。","source":{"text":"家无余财，衣不完采，食不重味，乘不过軥牛。","book":"《史记·游侠列传》"}},{"id":39938,"word":"衣不曳地","pinyin":"yī bù yè dì","abbr":"ybyd","explanation":"曳：拖。衣衫短小，不拖在地上。比喻衣着朴素。","source":{"text":"母病，公卿列侯遣夫人问疾，莽妻迎之，衣不曳地，著布蔽膝，见者以为僮仆，使人问乃知其夫人。","book":"汉·荀悦《汉纪·成帝纪》"},"example":{"text":"《晋书·苻坚载记》：“是秋，大旱，坚减膳彻悬，金玉绮绣皆散之戎上，后宫悉去罗纨，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":39939,"word":"衣不盖体","pinyin":"yī bù gài tǐ","abbr":"ybgt","explanation":"盖：遮盖。衣服破烂，连身子都遮盖不住。形容生活贫苦。","source":{"text":"唯臣衣不盖体，学号寄食于人。","book":"唐·杜甫《进雕赋表》"},"example":{"text":"陛下赋敛烦重，百姓日以贫困，～，则是陛下未得以财结民也。","book":"宋·苏辙《御试制策》"},"similar":["衣不蔽体","衣不遮体","衣不遮身"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":39940,"word":"衣不蔽体","pinyin":"yī bù bì tǐ","abbr":"ybbt","explanation":"蔽：遮。衣服破烂，连身子都遮盖不住。形容生活贫苦。","source":{"text":"妻子衣不蔽体，每日求丐得百钱，仅能菜粥度日。","book":"唐·杜甫《进雕赋表》：“唯臣衣不盖体，学号寄食于人。”宋·洪迈《夷坚丁志·奢侈报》"},"example":{"text":"～、家里正在愁吃愁穿的农民望了这群不知稼穑艰难的人们一眼，一句话也没说。","book":"秦牧《土地》"},"similar":["食不果腹","衣不布体","衣不遮体"],"opposite":["锦衣玉食"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":39941,"word":"衣不解带","pinyin":"yī bù jiě dài","abbr":"ybjd","explanation":"解带：解开衣带，指脱衣。因事过度操劳，以致不能脱衣安睡。也形容看护病人十分辛劳（多指对长辈）。","source":{"text":"仲堪父尝疾患经时，仲堪衣不解带数年。","book":"南朝宋·刘义庆《世说新语·排调》刘孝标注引《中兴书》"},"example":{"text":"看见父亲病重，他～，伏伺十余日，眼见得是不济事。","book":"清·吴敬梓《儒林外史》第四十回"},"similar":["衣不解结"],"usage":"作谓语、定语、状语；用于书面语"},{"id":39942,"word":"衣不解结","pinyin":"yī bù jiě jié","abbr":"ybjj","explanation":"解结：解开衣结，指脱衣。因事过度操劳，以致不能脱衣安睡。也形容看护病人十分辛劳。","source":{"text":"仲堪父尝疾患经时，仲堪衣不解带数年。","book":"南朝·宋·刘义庆《世说新语·排调》刘孝标注引《中兴书》"},"example":{"text":"中州有李生者，娶妇旬馀而母病，夫妇更番守侍，～者七八月。","book":"清·纪昀《阅微草堂笔记·姑妄听之一》"},"similar":["衣不解带"],"usage":"作谓语、定语、状语；用于书面语"},{"id":39943,"word":"衣不遮体","pinyin":"yī bù zhē tǐ","abbr":"ybzt","explanation":"衣服破烂，连身子都遮盖不住。形容生活贫苦","source":{"text":"后来自己落魄，病在店中，衣不遮体，食不充饥。","book":"清·石玉昆《小五义》第96回"},"example":{"text":"乌丙安《民俗学丛话·从“貂禅”谈服饰》：“当人们贫困、～的时候，观赏的意义也就完全丧失了。”"},"similar":["衣不遮身","衣不蔽体","衣不盖体"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":39944,"word":"衣不遮身","pinyin":"yī bù zhē shēn","abbr":"ybzs","explanation":"衣服破烂，连身子都遮盖不住。形容生活贫苦","source":{"text":"曹州有一个穷汉，叫做贾仁。真是衣不遮身，食不充口。","book":"明·凌濛初《初刻拍案惊奇》第35卷"},"example":{"text":"清·石玉昆《小五义》第107回：“一个个蓬头垢面，～，满脸的污泥。”"},"similar":["衣不遮体","衣不蔽体","衣不盖体"],"usage":"作谓语、定语、状语；指生活贫困"},{"id":39945,"word":"衣不重帛","pinyin":"yī bù chóng bó","abbr":"ybzb","explanation":"指不穿多件丝织的衣服。","source":{"text":"加以处身清苦，衣不重帛，家无儋石之储。","book":"《晋书·刘超传》"},"example":{"text":"《晋书·刘超传》：“处身清苦，～，家无儋石之储。”"},"similar":["衣不重采"],"usage":"作谓语、定语；用于书面语"},{"id":39946,"word":"衣不重彩","pinyin":"yī bù chóng cǎi","abbr":"ybzc","explanation":"衣服不全是彩色的。比喻衣着朴素","source":{"text":"吴王闻越王尽心自守，食不重味，衣不重彩，虽有五台之游，未尝一日登玩。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"example":{"text":"清·石玉昆《小五义》第98回：“却安于节俭，茅茨不剪，采椽不斫，后宫妃妾，～，食不重味。”"},"similar":["衣不兼彩","衣不重采","衣不兼采"],"usage":"作谓语、定语；比喻衣着朴素"},{"id":39947,"word":"衣不重采","pinyin":"yī bù chóng cǎi","abbr":"ybzc","explanation":"重：重叠；彩：通“彩”。不穿多件色彩鲜艳的衣服。形容衣着朴素。","source":{"text":"越王勾践食不重味，衣不重采，吊死问疾，且欲有所用其众。","book":"《史记·吴太伯世家》"},"similar":["衣不重彩","衣不兼彩"],"usage":"作谓语、定语；比喻衣着朴素"},{"id":39948,"word":"衣丰食足","pinyin":"yī fēng shí zú","abbr":"yfsz","explanation":"丰：丰富；足：足够。指衣食充足，生活富裕。","source":{"text":"谁似你衣丰食足口头肥。","book":"明·杨柔胜《玉环记·玉箫叹怀》"},"example":{"text":"且说那些长安的妇人，生在富贵之家，～，外面景致，也不大动她心里。","book":"清·褚人获《隋唐演义》第18回"},"similar":["丰衣足食","足衣足食","衣丰食饱"],"opposite":["缺衣少食","食不果腹"],"usage":"作谓语、定语；指生活富足"},{"id":39949,"word":"衣丰食饱","pinyin":"yī fēng shí bǎo","abbr":"yfsb","explanation":"丰：丰富；足：足够。指衣食充足，生活富裕。","source":{"text":"你看他衣丰食饱无闲事，齐念禾词大叫呼，端的是壮观皇都。","book":"明·无名氏《群仙朝圣》第二折"},"similar":["衣丰食足","丰衣足食","足衣足食"],"opposite":["缺衣少食","食不果腹"],"usage":"作谓语、定语；指生活富足"},{"id":39950,"word":"衣冠云集","pinyin":"yī guān yún jí","abbr":"ygyj","explanation":"衣冠：古时士以上戴冠，衣冠连称，引申为世族士绅；云集：如云聚集，形容人多。达官显贵们集聚在一起。","source":{"text":"丹墀下玉帛星联，绮席上衣冠云集。","book":"明·梅鼎祚《玉合记·还玉》"},"similar":["冠盖云集"],"usage":"作谓语、状语；用于书面语"},{"id":39951,"word":"衣冠优孟","pinyin":"yī guān yōu mèng","abbr":"ygym","explanation":"优孟：春秋时楚国著名的的演杂戏的人，擅长滑稽讽谏。比喻假扮古人或模仿他人。也指登场演戏。","source":{"text":"《史记·滑稽列传》记载：楚相孙叔敖死后，儿子很穷。优孟穿戴了孙叔敖的衣冠去见楚庄王。楚庄五受到感动，封了孙叔敖的儿子。"},"example":{"text":"中国戏法，由来已久，～，音曲绕梁。","book":"清·淮阴百一居士《壶天录》"},"similar":["优孟衣冠"],"usage":"作宾语、定语；用于书面语","story":["春秋时期，楚国王宫艺人优孟听说前相国孙叔敖死后儿子过着十分清贫的生活，觉得过意不去，就穿戴孙叔敖的衣冠，模仿他的音容笑貌去见楚王，楚王即景生情，优孟趁机讲述孙叔敖儿子的现状，楚王深受感动，就重封孙叔敖的儿子"]},{"id":39952,"word":"衣冠土枭","pinyin":"yī guān tǔ xiāo","abbr":"ygtx","explanation":"犹衣冠禽兽。指品德极坏，行为卑劣的人。","source":{"text":"苏楷、高贻休、萧闻礼，皆人才寝陋……河朔人士，目苏楷为衣冠土枭。","book":"宋·孙光宪《北梦琐言》卷十七"},"similar":["衣冠禽兽"],"usage":"作宾语、定语；用于比喻句"},{"id":39953,"word":"衣冠扫地","pinyin":"yī guān sǎo dì","abbr":"ygsd","explanation":"指旧时士大夫寡廉鲜耻，丧尽名节。","source":{"text":"自唐祚横流，衣冠扫地，苟无端事，孰恢素风。","book":"《旧唐书·薛廷珪等传论》"},"example":{"text":"清·侯方域《拟思宗改元廷臣谢表》：“家国无人，～。”"},"usage":"作谓语、定语、状语；用于书面语"},{"id":39954,"word":"衣冠文物","pinyin":"yī guān wén wù","abbr":"ygww","explanation":"衣冠：古代士以上戴冠，这里借喻文人众多。比喻太平盛世，文人众多，文化兴盛。","source":{"text":"于时三川定鼎，万国朝宗，衣冠文物，足为壮观。","book":"《隋书·百官志》"},"example":{"text":"到得辽人，一般称帝称宗，以至官员职名大半与中国相参，～，百工技艺，竟与中华无二。","book":"明·凌濛初《二刻拍案惊奇》卷二"}},{"id":39955,"word":"衣冠枭獍","pinyin":"yī guān xiāo jìng","abbr":"ygxj","explanation":"相传枭是吃母的恶鸟，獍是吃父的恶兽。旧时比喻不孝的人。","source":{"text":"河朔士人目苏楷为衣冠枭獍。","book":"宋·孙光宪《北梦琐言》卷十七"},"similar":["衣冠禽兽","不肖子孙"],"usage":"作宾语、定语；指不孝的人"},{"id":39956,"word":"衣冠楚楚","pinyin":"yī guān chǔ chǔ","abbr":"ygcc","explanation":"楚楚：鲜明、整洁的样子。衣帽穿戴得很整齐，很漂亮。","source":{"text":"蜉蝣之羽，衣裳楚楚。","book":"《诗经·曹风·蜉蝣》"},"example":{"text":"他整天～，但对工作却漠然置之。"},"similar":["衣冠齐楚"],"opposite":["衣衫褴褛","衣不蔽体","不修边幅"],"usage":"作定语、状语；形容人"},{"id":39957,"word":"衣冠沐猴","pinyin":"yī guān mù hóu","abbr":"ygmh","explanation":"冠：戴帽子；沐猴：猕猴。猴子穿衣戴帽，究竟不是真人。比喻虚有其表，形同傀儡。常用来讽刺投靠恶势力窃据权位的人。","source":{"text":"人言楚人沐猴而冠耳，果然。","book":"《史记·项羽本纪》"},"example":{"text":"厌襟裾马牛，笑～。","book":"元·汪元亨《朝天子·归隐》曲"},"similar":["沐猴而冠"],"usage":"作宾语、定语；用于书面语"},{"id":39958,"word":"衣冠济楚","pinyin":"yī guān jì chǔ","abbr":"ygjc","explanation":"济楚：鲜明、整洁的样子。衣帽穿戴得很整齐，很漂亮。","source":{"text":"蜉蝣之羽，衣裳楚楚。","book":"《诗经·曹风·蜉蝣》"},"example":{"text":"衣冠济楚庞儿俊，可知道引动俺莺莺。","book":"元·王实甫《西厢记》第二本第三折"},"similar":["衣冠楚楚","衣冠齐楚","衣妆楚楚"],"usage":"作定语、状语；形容人"},{"id":39959,"word":"衣冠济济","pinyin":"yī guān jǐ jǐ","abbr":"ygjj","explanation":"济济：庄重恭敬的样子。衣帽穿戴得很整齐，很庄重。","source":{"text":"衣冠济济，钟磬洋洋。令仪克盛，嘉会有章。","book":"《诗经·曹风·蜉蝣》：“蜉蝣之羽，衣裳楚楚。”唐·张昭《郊庙歌辞·周朝飨乐章·忠顺》"},"example":{"text":"各人分着帮，摆设了猪羊祭筵，衣冠济济的在那里伺候。","book":"清·吴趼人《二十年目睹之怪现状》第七十八回"},"opposite":["衣冠蓝缕"],"usage":"作谓语、定语、状语；用于书面语"},{"id":39960,"word":"衣冠甚伟","pinyin":"yī guān shèn wěi","abbr":"ygsw","explanation":"伟：壮美。人的仪表神态端庄美好。","source":{"text":"四人者从太子，年皆八十有余，须眉皓白，衣冠甚伟。","book":"《汉书·张良传》"},"example":{"text":"宋·陆游《曾文清公墓志铭》：“及入朝，鬓须皓然，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":39961,"word":"衣冠礼乐","pinyin":"yī guàn lǐ lè","abbr":"ygll","explanation":"指各种等级的穿戴服饰及各种礼仪规范。指封建社会中各种典章礼仪。","source":{"text":"何者？百王之敝，齐季斯甚。衣冠礼乐，扫地无余。","book":"南朝·梁·任昉《策秀才文》"},"example":{"text":"宋·范仲淹《上张右丞书》：“生四民中，识书学文为～之士，研精覃思，粗闻圣人之道。”"},"usage":"作宾语、定语；用于书面语"},{"id":39962,"word":"衣冠禽兽","pinyin":"yī guān qín shòu","abbr":"ygqs","explanation":"穿戴着衣帽的禽兽。指品德极坏，行为象禽兽一样卑劣的人。","source":{"text":"人人骂我做衣冠禽兽，个个识我是文物穿窬。","book":"明·陈汝元《金莲记·构衅》"},"example":{"text":"既是不孝，所谓～，要那才女又有何用。","book":"清·李汝珍《镜花缘》第四十三回"},"similar":["人面兽心","社鼠城狐","牛鬼蛇神"],"opposite":["正人君子"],"usage":"作主语、宾语；用于骂人"},{"id":39963,"word":"衣冠绪余","pinyin":"yī guān xù yú","abbr":"ygxy","explanation":"绪余：残余。比喻名门之家的后裔。","source":{"text":"与兄忝是衣冠绪余，荷国荣宠。今大军已临，而兄尚欲为高氏尽力。","book":"《周书·薛善传》"},"usage":"作宾语、定语；用于书面语"},{"id":39964,"word":"衣冠蓝缕","pinyin":"yī guān lán lǚ","abbr":"ygll","explanation":"形容衣帽破烂。","source":{"text":"隆兴甲申冬，黄再入都，因访亲戚陈晟，见信在焉，为晟教幼子，衣冠蓝缕，身寒欲颤，月得千钱。","book":"宋·洪迈《夷坚丁志·奢侈报》"},"opposite":["衣冠济济"],"usage":"作谓语、定语、状语；用于书面语"},{"id":39965,"word":"衣冠赫奕","pinyin":"yī guān hè yì","abbr":"yghy","explanation":"赫奕：显耀盛大的样子。服饰显耀华丽。引申指达官贵人的显赫气势。","source":{"text":"李宏门胄，衣冠赫奕。气蕴风霜，心如铁石。","book":"唐·杨炯《司兵参军陇西李宏赞》"},"usage":"作谓语、定语；用于书面语"},{"id":39966,"word":"衣冠辐凑","pinyin":"yī guān fú còu","abbr":"ygfc","explanation":"衣冠：古时士以上戴冠，衣冠连称，引申为世族士绅；辐凑：车辐凑集于毂上。达官显贵集聚一处。","source":{"text":"金城北峙，玉关西候，山泽骈罗，衣冠辐凑。","book":"唐·杨炯《唐昭武校尉曹君神道碑》"}},{"id":39967,"word":"衣冠辐辏","pinyin":"yī guān fú còu","abbr":"ygfc","explanation":"衣冠：古代士人阶层以上戴冠；辐辏：车辐聚集。指聚集一处。比喻达官显宦汇聚一处","source":{"text":"金城北峙，玉关西候，山泽骈罗，衣冠辐辏。","book":"唐·杨炯《唐昭武校尉曹君神道碑》"},"usage":"作谓语、定语；用于书面语"},{"id":39968,"word":"衣冠齐楚","pinyin":"yī guān qí chǔ","abbr":"ygqc","explanation":"齐楚：整齐、鲜明的样子。衣帽穿戴得很整齐，很漂亮。","source":{"text":"蜉蝣之羽，衣裳楚楚。","book":"《诗经·曹风·蜉蝣》"},"example":{"text":"见那些童生纷纷进来，也有小的，也有老的，仪表端正的，獐头鼠目的，～的，褴褛破烂的。","book":"清·吴敬梓《儒林外史》第三回"},"similar":["衣冠济楚","衣冠楚楚","衣妆楚楚"],"usage":"作定语、状语；形容人"},{"id":39969,"word":"衣单食缺","pinyin":"yī dān shí quē","abbr":"ydsq","explanation":"衣裳单薄，食物缺少。形容生活困苦","source":{"text":"行粮不敷，衣单食缺，若一人独往，可到楚国。","book":"明·冯梦龙《喻世明言》第七卷"},"similar":["衣单食薄"],"opposite":["丰衣足食"],"usage":"作谓语、定语；指生活贫困"},{"id":39970,"word":"衣单食薄","pinyin":"yī dān shí bó","abbr":"ydsb","explanation":"衣裳单薄，食物很少。形容生活困苦。","source":{"text":"例如八路军、新四军及其他军队，待遇最为菲薄，衣单食薄，弹药不继，医疗不备。","book":"毛泽东《向国民党的十点要求》"},"example":{"text":"～的日子实在难熬。"},"similar":["缺衣少食","衣单食缺"],"opposite":["丰衣足食"],"usage":"作谓语、定语；指生活贫困"},{"id":39971,"word":"衣取蔽寒","pinyin":"yī qǔ bì hán","abbr":"yqbh","explanation":"取：选取，采用；蔽：遮往。衣服只求抵御寒冷。","source":{"text":"平生衣取蔽寒，食取充腹。","book":"宋·司马光《训俭示康》"},"usage":"作谓语、定语；指人不讲究穿着"},{"id":39972,"word":"衣妆楚楚","pinyin":"yī zhuāng chǔ chǔ","abbr":"yzcc","explanation":"楚楚：整洁，鲜明。衣帽穿戴得很整齐，很漂亮","source":{"text":"二人夜同步河之西，见一妇人在前，衣妆楚楚，因纵步觇之，常不及焉。","book":"宋·王明清《玉照新志》第四卷"},"similar":["衣冠楚楚","衣冠齐楚","衣冠济楚"],"usage":"作定语、状语；用于书面语"},{"id":39973,"word":"衣宵食旰","pinyin":"yī xiāo shí gàn","abbr":"yxsg","explanation":"指天未明就穿衣起身，天黑了才进食。常用以称谀帝王勤于政事。","source":{"text":"衣宵寝二难，食旰餐三惧。","book":"语出唐太宗《执契静三边》诗"},"example":{"text":"嗟彼河淮，怒溢弥漫，万室成渊，千里无岸，我皇忧之，～。","book":"明·张居正《神母授图万年永赖颂》"},"similar":["废寝忘食"],"usage":"作谓语、定语；用于书面语"},{"id":39974,"word":"衣宽带松","pinyin":"yī kuān dài sōng","abbr":"ykds","explanation":"形容人消瘦。","source":{"text":"一字字更长漏永，一声声衣宽带松。别恨离愁，变成一弄。","book":"元·王实甫《西厢记》第二本第四折"},"usage":"作宾语、状语；用于书面语"},{"id":39975,"word":"衣屩蓝缕","pinyin":"yī juē lán lǚ","abbr":"yjll","explanation":"屩：用麻与草做的鞋；蓝缕：破烂。衣服鞋子破烂","source":{"text":"先是东平有术士皇甫喈者，落魄不仕，衣屩蓝缕，众甚鄙之。","book":"唐·薛用弱《集异记·刘惟清》"},"usage":"作谓语、定语；用于书面语"},{"id":39976,"word":"衣帛食肉","pinyin":"yì bó shí ròu","abbr":"ybsr","explanation":"穿着精美的丝绸服装，吃的是肉食。形容生活富裕。","source":{"text":"七十者衣帛食肉，黎民不饥不寒，然而不王者，未之有也。","book":"《孟子·梁惠王章句上》"},"example":{"text":"老者～，黎民不饥不寒，然而不王者，未之有也。","book":"明·无名氏《孟母三移》第四折"},"similar":["衣锦食肉"],"usage":"作谓语、定语；用于书面语"},{"id":39977,"word":"衣带一江","pinyin":"yī dài yī jiāng","abbr":"ydyj","explanation":"一条衣带那样狭窄的水。指虽有江河湖海相隔，但距离不远，不足以成为交往的阻碍。","source":{"text":"国事如今谁倚仗，衣带一江而已。","book":"宋·文及翁《贺新郎·游西湖有感》词"}},{"id":39978,"word":"衣带之水","pinyin":"yī dài zhī shuǐ","abbr":"ydzs","explanation":"一条衣带那样狭窄的水。指虽有江河湖海相隔，但距离不远，不足以成为交往的阻碍。","source":{"text":"我为百姓父母，岂可一衣带水不拯之乎？","book":"《南史·陈后主纪》"},"example":{"text":"海天万里，不过～尔。","book":"《台湾通史·疆域志》"}},{"id":39979,"word":"衣带宽松","pinyin":"yī dài kuān sōng","abbr":"ydks","explanation":"衣服肥了，腰带松了。形容人消瘦了。","source":{"text":"一字字更长漏永，一声声衣宽带松。别恨离愁，变成一弄。","book":"元·王实甫《西厢记》第二本第四折"}},{"id":39980,"word":"衣带渐宽","pinyin":"yī dài jiàn kuān","abbr":"ydjk","explanation":"指因相思而消瘦，衣服都显得肥大了。","source":{"text":"衣带渐宽终不悔，为伊消得人憔悴。","book":"宋·柳永《蝶恋花》词"},"example":{"text":"～无别意，新书报我添憔悴。","book":"宋·苏轼《蝶恋花》词"}},{"id":39981,"word":"衣弊履穿","pinyin":"yī bì lǚ chuān","abbr":"yblc","explanation":"弊：坏；履：鞋。衣服穿破了，鞋子磨漏了。形容人很贫穷。","source":{"text":"衣弊履穿，贫也。","book":"《庄子·山木》"},"example":{"text":"～，坐榻无席，自以跣露，恒兀坐读书，不迎送宾客，人皆以为倨。","book":"《金史·雷渊传》"},"similar":["衣敝履空"],"usage":"作谓语、定语；指生活贫困"},{"id":39982,"word":"衣披群生","pinyin":"yì pī qún shēng","abbr":"ypqs","explanation":"衣被：给人衣穿，比喻加惠于人；群生：众生。把衣服给百姓穿上或披上。比喻广施恩惠于百姓。","source":{"text":"衣被群生，赡足万类。","book":"宋·欧阳修《夫子罕言利命仁论》"}},{"id":39983,"word":"衣敝履空","pinyin":"yī bì lǚ kōng","abbr":"yblk","explanation":"衣服破烂，鞋子穿孔。形容贫穷","source":{"text":"唐尊衣敝履空，以瓦器饮食，又以历遗公卿，被虚伪名。","book":"东汉·班固《汉书·鲍宣传》"},"similar":["衣弊履穿"],"usage":"作谓语、定语；指生活贫困"},{"id":39984,"word":"衣无二彩","pinyin":"yī wú èr cǎi","abbr":"ywec","explanation":"身上没有第二件彩衣。形容衣着朴素","source":{"text":"朝廷躬自菲薄，去绝奢饰，食不兼味，衣无二彩。","book":"南朝·宋·范晔《后汉书·安帝纪》"},"similar":["衣不重采"],"usage":"作谓语、定语；用于生活"},{"id":39985,"word":"衣来伸手，饭来张口","pinyin":"yī lái shēn shǒu，fàn lái zhāng kǒu","abbr":"ylssflzk","explanation":"形容懒惰成性，坐享别人劳动成果的人。","source":{"text":"安公子是自幼娇养，衣来伸手，饭来张口的人。","book":"清·文康《儿女英雄传》第31回"},"example":{"text":"人们看不起那些～的人。"},"similar":["坐享其成","不劳而获"],"opposite":["勤劳致富"],"usage":"作宾语、定语、分句；可分开使用","story":["从前有个财主有万贯家财，他的儿子不学无术，过着衣来伸手、饭来张口的生活，财主不教育他。艾子提醒他让他受教育，财主不满艾子说他的儿子不通世务。艾子把他的儿子叫来问大米从何处而来，财主儿子答米是从米袋中来的"]},{"id":39986,"word":"衣架饭囊","pinyin":"yī jià fàn náng","abbr":"yjfn","explanation":"装饭的口袋，挂衣的架子。比喻没有能力，干不了什么事的人。","source":{"text":"其余皆是衣架饭囊、酒桶肉袋耳！","book":"明·罗贯中《三国演义》第23回"},"example":{"text":"我讨厌那些～般的人。"},"similar":["酒囊饭袋","衣架饭袋"],"usage":"作宾语、定语；指无能之辈"},{"id":39987,"word":"衣架饭袋","pinyin":"yī jià fàn dài","abbr":"yjfd","explanation":"比喻没有能力，干不了事的人","source":{"text":"对于‘日求三餐，夜求一宿’的衣架饭袋、凡夫俗子来说，佛门也许是个逃离苦海的福地。","book":"李栋《彩云归》"},"similar":["衣架饭囊"],"usage":"作宾语、定语；指无能之辈"},{"id":39988,"word":"衣狐坐熊","pinyin":"yì hú zuò xióng","abbr":"yhzx","explanation":"衣：穿。穿着狐皮衣服，坐在熊皮上。形容生活奢侈","source":{"text":"如使臣享厚禄，居重荣，衣狐坐熊，而无事于世者，固所不能安也。","book":"《宋书·王僧达传》"},"usage":"作谓语、定语；用于书面语"},{"id":39989,"word":"衣租食税","pinyin":"yī zū shí shuì","abbr":"yzss","explanation":"租、税：田赋和各种税款的总称。依靠百姓缴纳的租税生活。","source":{"text":"县官食租衣税而已。","book":"《汉书·食货志下》"},"example":{"text":"正是，多少男人，～，及至事到临头，尚且如此。","book":"清·曹雪芹《红楼梦》第七十三回"},"similar":["衣食税租"],"usage":"作谓语、定语；用于生活"},{"id":39990,"word":"衣紫腰金","pinyin":"yī zǐ yāo jīn","abbr":"yzyj","explanation":"身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。","source":{"text":"见一人衣紫腰金，神清貌古。","book":"宋·无名氏《灯下闲谈·掠剩大夫》"},"example":{"text":"陈母教子，～。","book":"元·关汉卿《蝴蝶梦》第二折"},"similar":["背紫腰金","衣紫腰黄"],"opposite":["一贫如洗"],"usage":"作谓语、定语；指人有权有势"},{"id":39991,"word":"衣紫腰银","pinyin":"yī zǐ yāo yín","abbr":"yzyy","explanation":"身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。","source":{"text":"想当日，孟母教子，居必择邻；陶母教子，剪发待宾；陈母教子，衣紫腰银。","book":"元·关汉卿《蝴蝶梦》第二折"},"similar":["衣紫腰金"],"opposite":["无权无势"],"usage":"作谓语、定语；指人有权有势"},{"id":39992,"word":"衣紫腰黄","pinyin":"yī zǐ yāo huáng","abbr":"yzyh","explanation":"身穿紫袍，腰佩金银鱼袋。大官装束，亦指做大官。","source":{"text":"谁不愿衣紫腰黄，还须虑同袍中伤。","book":"明·谢谠《四喜记·帝阙辞荣》"},"similar":["衣紫腰金","衣紫腰银"],"opposite":["无权无势"],"usage":"作谓语、定语；指人有权有势"},{"id":39993,"word":"衣绣夜游","pinyin":"yī xiù yè yóu","abbr":"yxyy","explanation":"比喻虽居官位，却不能使人看到自己的荣耀显贵。同“衣绣夜行”。","source":{"text":"衣绣夜游，与君相逢，除患解惑，使君不忧。","book":"汉·焦赣《易林·小过之否》"},"example":{"text":"且～，有识不许。","book":"《北史·鹿悆传》"},"similar":["衣绣夜行","衣锦夜行","衣锦夜游"],"usage":"作谓语、定语；指爱炫耀的人"},{"id":39994,"word":"衣绣夜行","pinyin":"yī xiù yè xíng","abbr":"yxyx","explanation":"衣：穿。绣：锦绣。穿着精美鲜艳的锦绣衣服夜间上街行走。比喻人富贵以后不为人知。亦作“衣锦夜游”、“衣锦夜行”。","source":{"text":"项王见秦宫室皆以烧残破，又心怀思欲东归，曰：‘富贵不归故乡，如衣绣夜行，谁知之者！’","book":"《史记·项羽本纪》"},"example":{"text":"‘富贵不归故乡，如～’，汉武为朱买臣言也。","book":"宋·孙奕《履斋示儿编·文说·史同文》"},"similar":["衣绣夜游","衣锦夜游","衣锦夜行"],"usage":"作谓语、定语；指爱炫耀的人"},{"id":39995,"word":"衣绣昼行","pinyin":"yī xiù zhòu xíng","abbr":"yxzx","explanation":"昼：白天。穿了锦绣衣服在白昼行走。比喻在本乡作官，或富贵后回到故乡。","source":{"text":"还君本州，可谓衣绣昼行矣。","book":"《三国志·魏书·张既传》"},"similar":["衣锦还乡","衣锦昼行"],"usage":"作谓语；同“衣锦还乡”"},{"id":39996,"word":"衣衫蓝缕","pinyin":"yī shān lán lǚ","abbr":"ysll","explanation":"衣服破烂。","source":{"text":"蓝缕：敝衣。","book":"语出《左传·宣公十二年》：“训之以若敖、蚡冒，筚路蓝缕以启山林。”杜预注"},"example":{"text":"虽是天色和暖，那些人却也～。","book":"明·吴承恩《西游记》第四十四回"},"similar":["衣衫褴褛"],"opposite":["衣冠楚楚"],"usage":"作谓语、定语；指贫困"},{"id":39997,"word":"衣衫褴褛","pinyin":"yī shān lán lǚ","abbr":"ysll","explanation":"褴褛：破烂。衣服破破烂烂。","source":{"text":"蓝缕：敝衣。","book":"语出先秦·左丘明《左传·宣公十二年》：“训之以若敖，蚡冒，筚路蓝缕以启山林。”杜预注"},"example":{"text":"你看吧，～的饥民们冻得缩着肩膀，守候在庄稼院的街门口。","book":"柳青《创业史》第一部"},"similar":["捉襟见肘","衣不蔽体","破衣烂衫"],"opposite":["丰衣足食","腰缠万贯","衣冠楚楚"],"usage":"作主语、定语、状语；指生活贫困"},{"id":39998,"word":"衣被群生","pinyin":"yī bèi qún shēng","abbr":"ybqs","explanation":"衣被：给人衣穿，比喻加惠于人；群生：众生。比喻恩惠广施。","source":{"text":"衣被群生，赡足万类。","book":"宋·欧阳修《夫子罕言利命仁论》"},"usage":"作谓语、定语；指给别人施恩"},{"id":39999,"word":"衣被苍生","pinyin":"yì pī cāng shēng","abbr":"ybcs","explanation":"被：同“披”；苍生：百姓。把衣服给百姓穿上或披上。比喻广施恩惠于百姓。","source":{"text":"言垂示文章，作世间之轨则也，有本云，衣被苍生，亦可然也。","book":"唐·释元康《肇论疏》卷上"},"example":{"text":"狐曰：“我之皮，能～，如何言无功？若汝则无功耳。”","book":"清·吴趼人《俏皮话·狼施威》"}},{"id":40000,"word":"衣裳之会","pinyin":"yī shāng zhī huì","abbr":"yszh","explanation":"与“兵车之会”相对而言，指春秋时代诸国之间和好的会议。","source":{"text":"衣裳之会十有一，未尝有歃血之盟也，信厚也。","book":"《谷梁传·庄公二十七年》"},"example":{"text":"明·冯梦龙《东周列国志》第18回：“君奉王命，以临诸侯，安用兵车？请为～。”"},"similar":["衣裳盟会"],"opposite":["兵车之会"],"usage":"作宾语；用于交往等"}]
