+[{"id":45001,"word":"钉是钉，铆是铆","pinyin":"dīng shì dīng，mǎo shì mǎo","abbr":"dsdmsm","explanation":"某个钉子一定要安在相应的铆处，不能有差错。形容对事认真，毫不含糊。","example":{"text":"他说话做事钉是钉，铆是铆，深得大家信任。"},"similar":["丁是丁，卯是卯"],"opposite":["藕断丝连"],"usage":"作宾语、分句；指办事认真"},{"id":45002,"word":"钓名拾紫","pinyin":"diào míng shí zǐ","abbr":"dmsz","explanation":"钓：捞取；紫：指贵官的印绶或服饰的颜色。比喻运用不正当的手段捞取名誉和官职。","source":{"text":"钓名劳拾紫，隐迹自谈玄。","book":"唐·骆宾王《叙寄员半千》"}},{"id":45003,"word":"钓名欺世","pinyin":"diào míng qī shì","abbr":"dmqs","explanation":"钓：捞取。运用不正当手段捞取名著，欺骗世人。","source":{"text":"不过挪移借贷，改窜添补，便尔钓名欺世。","book":"清·郑燮《潍县寄舍弟墨第四书》"},"example":{"text":"他喜欢干～的事情。"},"similar":["沽名钓誉","盗世欺名"],"usage":"作谓语、定语；同“欺世盗名”"},{"id":45004,"word":"钓名沽誉","pinyin":"diào yù gū míng","abbr":"dmgy","explanation":"钓：用饵引鱼上钩，比喻骗取；沽：买。用某种不正当的手段捞取名誉。","source":{"text":"彼虽硁硁有类沽名者。","book":"《管子·法法》：“钓名之人，无贤士焉。”《后汉书·逸民传序》"},"example":{"text":"有一种人，不干实事，专会～。"},"similar":["钓誉沽名"],"usage":"作谓语、宾语、定语；指追求名利"},{"id":45005,"word":"钓名要誉","pinyin":"diào míng yào yù","abbr":"dmyy","explanation":"指用某种不正当的手段捞取名誉。同“钓名沽誉”。","source":{"text":"虽不可取于民奢纵害公，亦不必钓名要誉，太险陋也。","book":"元·刘祁《归潜志》第七卷"},"example":{"text":"现今社会里～的人太多了。"},"similar":["钓名沽誉"],"usage":"作谓语、宾语、定语；指追求名利"},{"id":45006,"word":"钓游之地","pinyin":"diào yóu zhī dì","abbr":"dyzd","explanation":"童年生活的地方，一般指故乡。","source":{"text":"今之归，指其树曰：‘某树，吾先人之所种也；某水某丘，吾童子时所钓游也。’","book":"唐·韩愈《送杨少尹序》"},"example":{"text":"儿时的～，当然很使人怀念的。","book":"鲁迅《华盖集·忽然想到》"},"usage":"作宾语；借指故乡"},{"id":45007,"word":"钓誉沽名","pinyin":"diào yù gū míng","abbr":"dygm","explanation":"指用某种不正当的手段捞取名誉。同“钓名沽誉”。","source":{"text":"为国家谋长久……毋钓誉沽名，毋模棱两可。","book":"郑观应《盛世危言·吏治下》"},"similar":["钓名要誉","沽名钓誉"],"usage":"作谓语、宾语、定语；指追求名利"},{"id":45008,"word":"钓鳌客","pinyin":"diào áo kè","abbr":"dak","explanation":"钓：钓钩；鳌：传说海中的大龟。比喻有豪放的胸襟和远大的抱负。","source":{"text":"一钓而连六鳌。","book":"战国·郑·列御寇《列子·汤问》"},"example":{"text":"李白开元中谒宰相，封一版，上题曰：‘海上～李白。’","book":"宋·赵德麟《侯靖录》第六卷"},"usage":"作主语、宾语、定语；指人的胸怀","story":["传说古代渤海东面有五座山，常随波涛浮动。上帝命15只巨鳌用头顶着，山才固定不动。龙伯国有一个人由于出门要经过这五座山，觉得十分不方便，得知其是用鳌头顶着，就用鱼饵将这鳌钓起，一连钓了六只鳌，于是这两座山就沉入大海"]},{"id":45009,"word":"钗横鬓乱","pinyin":"chāi héng bìn luàn","abbr":"chbl","explanation":"鬓：耳边的头发；钗：妇女的首饰，由两股合成。耳边的头发散乱，首饰横在一边。形容妇女睡眠初醒时未梳妆的样子。","source":{"text":"青冥风霜非人世，鬓乱钗横特地寒。","book":"宋·王安石《扇子词》"},"example":{"text":"宋·王安石《扇子词》：“青冥风霜非人世，鬓乱钗横特地寒。”"},"similar":["鬓乱钗横","披头散发"],"usage":"作定语；用于女性"},{"id":45010,"word":"钗荆裙布","pinyin":"chāi jīng qún bù","abbr":"cjqb","explanation":"荆枝作钗，粗布为裙。形容妇女装束朴素。","source":{"text":"梁鸿妻孟光，荆钗布裙。","book":"西汉·刘向《列女传》"},"example":{"text":"因薛姨妈看见邢岫烟生得端雅稳重，且家道贫寒，是个～的女儿，便欲说给薛蟠为妻。","book":"清·曹雪芹《红楼梦》第57回"},"similar":["荆钗布裙"],"usage":"作谓语、定语；比喻贫困"},{"id":45011,"word":"钜人长德","pinyin":"jù rén cháng dé","abbr":"jrcd","explanation":"指德高望重的人。","source":{"text":"迁太常卿，天下愈推为钜人长德。","book":"唐·韩愈《唐故相权公墓碑》"},"similar":["巨人长德"],"usage":"作宾语、定语；用于书面语"},{"id":45012,"word":"钜儒宿学","pinyin":"jù rú sù xué","abbr":"jrsx","explanation":"钜：通“巨”，很大；宿：老成。指学识渊博，学术上有权威的人士。","source":{"text":"桑大夫据当时，合时变，上权利之路，虽非正法，钜儒宿学不能自解，博物通达之士也。","book":"《汉书·公孙刘车王杨蔡陈郑传赞》"}},{"id":45013,"word":"钜学鸿生","pinyin":"jù xué hóng shēng","abbr":"jxhs","explanation":"学识渊博的人。","source":{"text":"于兹乎鸿生钜儒，俄轩冕，杂衣裳，修唐典，匡《雅》《颂》，揖让于前。","book":"汉·扬雄《羽猎赋》"},"example":{"text":"愿与～共力雠刊，准汉旧事，镂石太学。","book":"《新唐书·郑覃传》"},"similar":["巨学鸿生"],"usage":"作主语、宾语；指学识渊博的人"},{"id":45014,"word":"钝兵挫锐","pinyin":"dùn bīng cè ruì","abbr":"dbcr","explanation":"钝：锋刃不利，引申为疲惫；兵：军队；挫：挫伤；锐：锋利，指锐气。军队疲惫，锐气挫伤。","source":{"text":"久则钝兵挫锐。","book":"《孙子兵法·作战篇》"}},{"id":45015,"word":"钝刀子割肉","pinyin":"dùn dāo zi gē ròu","abbr":"ddzgr","explanation":"钝：不锋利。用不锋利的刀割肉。比喻做事行动慢，不能快速解决问题。","source":{"text":"不快意，印刀切物，破帆使我，树阴遮景致。","book":"唐·李商隐《杂纂》"}},{"id":45016,"word":"钝刀慢剐","pinyin":"dùn dāo màn guǎ","abbr":"ddmg","explanation":"钝：不锋利；剐：割。用不锋利的刀慢慢地割。比喻做事行动慢。","source":{"text":"不快意，印刀切物，破帆使我，树阴遮景致。","book":"唐·李商隐《杂纂》"}},{"id":45017,"word":"钝口拙腮","pinyin":"dùn kǒu zhuō sāi","abbr":"dkzs","explanation":"指口才笨拙，说话不流利。","source":{"text":"好妹妹，我是钝口拙腮，可不能一句一句同你套！","book":"清·李汝珍《镜花缘》第80回"},"example":{"text":"他一紧张就变得～起来。"},"similar":["笨嘴拙舌"],"opposite":["伶牙俐齿"],"usage":"作谓语、定语、状语；比喻嘴笨，不善于说话"},{"id":45018,"word":"钝学累功","pinyin":"dùn xué lěi gōng","abbr":"dxlg","explanation":"钝：迟钝，笨拙；累：积聚。愚笨的人只要刻苦学习，也能取得成就。","source":{"text":"钝学累功，不妨精熟。","book":"北齐·颜之推《颜氏家训·文章》"},"example":{"text":"我们要有～的精神才能有所进步。"},"usage":"作谓语、宾语；用于劝诫人"},{"id":45019,"word":"钟仪楚奏","pinyin":"zhōng yí chǔ zòu","abbr":"zycz","explanation":"仲仪：春秋时楚国乐官。钟仪奏楚国的音乐。比喻思念故国，怀念乡土。","source":{"text":"钟仪幽而楚奏兮，庄舄显而越吟。人情同于怀土兮，岂穷达而异心！","book":"三国·魏·王粲《登楼赋》"},"usage":"作宾语、定语；用于书面语"},{"id":45020,"word":"钟响磬鸣","pinyin":"zhōng xiǎng qìng míng","abbr":"zxqm","explanation":"磬：古代打击乐器。钟被敲响后，磬就自鸣了。比喻事物之间有内在联系。","source":{"text":"唐·韦绚《刘宾客嘉话录》记载：洛阳一寺院里的磬常常自鸣，僧侣为此忧患成疾。其友知此事后，用锉将磬锉了几处，磬从此不再自鸣。用现代的理论解释，当为共振现象。"},"example":{"text":"～的现象并不奇怪"},"usage":"作宾语、定语；用于书面语","story":["古代洛阳一个寺庙僧房中有一个磬，经常自鸣，僧人因此忧患成疾。他的朋友得知后，用锉刀将磬锉了数处，磬就不再自鸣了。原来是磬与寺钟的频率暗合，所以寺里击钟，磬便自鸣"]},{"id":45021,"word":"钟漏并歇","pinyin":"zhōng lòu bìng xiē","abbr":"zlbx","explanation":"比喻年老衰残。","source":{"text":"今年逾八十，位极三事，钟漏并歇，筋骸俱耄。","book":"唐·沈既济《枕中记》"},"example":{"text":"老身～，残年向尽，骨肉之间，殊多乖阔。","book":"清·蒲松龄《聊斋志异·辛十四娘》"},"usage":"作谓语、定语；用于书面语"},{"id":45022,"word":"钟灵毓秀","pinyin":"zhōng líng yù xiù","abbr":"zlyx","explanation":"钟：凝聚，集中；毓：养育。凝聚了天地间的灵气，孕育着优秀的人物。指山川秀美，人才辈出。","source":{"text":"盖天钟秀于是，不限于遐裔也。","book":"唐·柳宗元《马退山茅亭记》"},"example":{"text":"不想我生不幸，亦且琼闺绣阁中亦染此风，真真有负天地～之德了。","book":"清·曹雪芹《红楼梦》第三十六回"},"similar":["鸾翔凤集"],"usage":"作谓语、定语；指人杰地灵"},{"id":45023,"word":"钟盘烛龠","pinyin":"zhōng pán zhú yuè","abbr":"zpzy","explanation":"比喻认识片面，未得要领。","source":{"text":"生而眇者不识日，问之有目者。或告之曰：‘日之状如铜槃。’扣槃而得其声。他日闻钟，以为日也。或告之曰：‘日之光如烛。’扪烛而得其形。他日揣籥，以为日也。","book":"宋·苏轼《日喻》"},"usage":"作宾语、定语；用于书面语"},{"id":45024,"word":"钟离委珠","pinyin":"zhōng lí wěi zhū","abbr":"zlwz","explanation":"委：抛弃；钟离：东汉人钟离意。钟离抛弃定珠。比喻不接受来路不正的赃物。","source":{"text":"《后汉书·钟离意传》记载：交阯太守张恢因犯贪污罪被惩治，皇帝将他的赃物赏赐给群臣，钟离意却将得到的定珠抛在地上，以表明自己不受赃。"},"example":{"text":"端木辞金，～。（唐·李翰《蒙求》）"},"usage":"作宾语、定语；用于书面语"},{"id":45025,"word":"钟馗捉鬼","pinyin":"zhōng kuí zhuō guǐ","abbr":"zkzg","explanation":"钟馗：传说中打鬼的神。钟馗抓住小鬼。比喻清除坏人。","source":{"text":"钟馗捉鬼。","book":"宋·王莹《群书类编故事·梦钟馗》"},"example":{"text":"～让坏人害怕。"},"usage":"作宾语、定语；指清除坏人","story":["传说唐明皇从骊山狩猎回宫得了疟疾，神志昏迷时见一个小鬼呲牙咧嘴地进来戏弄，并称自己名叫虚耗。唐明皇吓得满头大汗。这时钟馗进来抓住虚耗就吃了，唐明皇对钟馗感激不尽，彻底醒悟，病就痊愈了"]},{"id":45026,"word":"钟鸣漏尽","pinyin":"zhōng míng lòu jìn","abbr":"zmlj","explanation":"漏：滴漏，古代计时器。晨钟已经敲呼，漏壶的水也将滴完。比喻年老力衰，已到晚年。也指深夜。","source":{"text":"年过七十而以居位，譬犹钟鸣漏尽而夜行不休，是罪人也。","book":"汉·崔寔《政论》：“钟鸣漏尽，洛阳城中，不得有行者。”《三国志·魏书·田豫传》"},"example":{"text":"直到～，方始酒阑人散。","book":"清·曾朴《孽海花》第四回"},"similar":["夜深人静","夜静更阑"],"usage":"作宾语；指深夜"},{"id":45027,"word":"钟鸣鼎列","pinyin":"zhōng míng dǐng liè","abbr":"zmdl","explanation":"指官高位重。同“钟鸣鼎重”。","source":{"text":"都尉起家勋戚，钟鸣鼎列，极福终其身。","book":"清·曹寅《题铜官秋色图》"},"similar":["钟鸣鼎重"],"usage":"作定语；用于书面语"},{"id":45028,"word":"钟鸣鼎重","pinyin":"zhōng míng dǐng zhòng","abbr":"zmdz","explanation":"谓官高位重。","source":{"text":"徒苟且富贵，即钟鸣鼎重，亦何足道。","book":"明·唐顺之《章孺人传》"},"similar":["钟鸣鼎列"],"usage":"作定语；用于书面语"},{"id":45029,"word":"钟鸣鼎食","pinyin":"zhōng míng dǐng shí","abbr":"zmds","explanation":"钟：古代乐器；鼎：古代炊器。击钟列鼎而食。形容贵族的豪华排场。","source":{"text":"闾阎扑地，钟鸣鼎食之家。","book":"《史记·货殖列传》：“洒削，薄技也，而郅氏鼎食。马医浅方，张里击钟。”唐·王勃《滕王阁序》"},"example":{"text":"谁知这样～的人家儿，如今养的子孙竟一代不如一代了。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["锦衣玉食","灯红酒绿","花天酒地"],"opposite":["粗茶淡饭","荆钗布裙","食淡衣粗"],"usage":"作定语；常与“之家”连用"},{"id":45030,"word":"钟鼎之家","pinyin":"zhōng dǐng zhī jiā","abbr":"zdzj","explanation":"富贵宦达之家。","source":{"text":"虽系钟鼎之家，却亦是书香之族。","book":"清·曹雪芹《红楼梦》第二回"},"similar":["钟鼎人家"],"usage":"作宾语、定语；用于书面语"},{"id":45031,"word":"钟鼎人家","pinyin":"zhōng dǐng rén jia","abbr":"zdrj","explanation":"富贵宦达之家。同“钟鼎之家”。","source":{"text":"虽然算不得簪缨门第、钟鼎人家，却倒过得亲亲热热，安安静静。","book":"清·文康《儿女英雄传》第一回"},"similar":["钟鼎之家"],"usage":"作宾语、定语；用于书面语"},{"id":45032,"word":"钟鼎山林","pinyin":"zhōng dǐng shān lín","abbr":"zdsl","explanation":"比喻富贵和隐逸。","source":{"text":"疏雨梧桐，微云河汉，钟鼎山林无限悲。","book":"宋·辛弃疾《临江仙·再用韵送祐之弟归浮梁》词：“钟鼎山林都是梦，人间宠辱休惊。”宋·张世南《游宦纪闻》卷一"},"example":{"text":"宋·陆游《自咏》诗：“～俱不遂，声名官职两无多。”"},"usage":"作宾语、定语；用于书面语"},{"id":45033,"word":"钟鼓之乐","pinyin":"zhōng gǔ zhī yuè","abbr":"zgzl","explanation":"钟鼓；钟与鼓，乐器。指钟鼓一类的音乐","source":{"text":"劳智虑，苦身体，乏钟鼓之乐。","book":"汉·贾谊《论时政疏》"},"usage":"作宾语；用于书面语"},{"id":45034,"word":"钟鼓之色","pinyin":"zhōng gǔ zhī sè","abbr":"zgzs","explanation":"指欢欣喜乐的面色，像欣赏音乐时表现出的那样。","source":{"text":"夫欣然喜乐者，钟鼓之色也。","book":"《管子·小问》"},"example":{"text":"欢欣众悦，～。","book":"宋·李冗《独异志》卷中"},"usage":"作宾语；用于书面语"},{"id":45035,"word":"钟鼓馔玉","pinyin":"zhōng gǔ zhuàn yù","abbr":"zgzy","explanation":"指鸣钟鼓，食珍馐。形容富贵豪华的生活。","source":{"text":"钟鼓馔玉不足贵，但愿长醉不愿醒。","book":"唐·李白《将进酒》诗"},"example":{"text":"绮衣灿烂，～，剥下自润，而不睹其艰。","book":"明·张居正《学农园记》"},"usage":"作宾语、定语；用于书面语"},{"id":45036,"word":"钢打铁铸","pinyin":"gāng dǎ tiě zhù","abbr":"gdtz","explanation":"铸：铸造。像钢铁铸造的一样。形容十分坚固或坚强。","source":{"text":"任是纯钢打就生铁铸成，也须额头汗出。","book":"宋·释惟白《续传灯录·法秀圆通禅师》"},"example":{"text":"就是～的身子也经不起这样折腾。"},"similar":["钢浇铁铸"],"usage":"作谓语、定语；指人的性格"},{"id":45037,"word":"钢浇铁铸","pinyin":"gāng jiāo tiě zhù","abbr":"gjtz","explanation":"比喻坚毅顽强。","source":{"text":"钢浇铁铸的活雷锋啊！抖一抖满身的泥土，又投入火热的斗争。","book":"光未然《英雄钻井队》诗"},"similar":["钢打铁铸"],"usage":"作谓语、定语；指人的性格"},{"id":45038,"word":"钢筋铁骨","pinyin":"gāng jīng tiě gǔ","abbr":"gjtg","explanation":"筋骨象钢铁打铸的一般。形容身体健壮有力或意志坚强不屈。","source":{"text":"在一间放着垫子和各种各样举重器械的房间里，我遇见了一群钢筋铁骨的青年。","book":"曹禺《半日的“旅行”》"},"example":{"text":"风餐露宿，转战南北，锤炼出一副～，赤胆忠心。","book":"《人民文学》1977年第8期"},"usage":"作宾语、定语；指健壮的体魄"},{"id":45039,"word":"钦佩莫名","pinyin":"qīn pèi mò míng","abbr":"qpmm","explanation":"心中无限钦佩。","source":{"text":"黄道台这番说话，说得袁伯珍五体投地，钦佩莫名，从此就把回家的心思，抛在脑背后去了。","book":"清·无名氏《官场维新记》第五回"},"example":{"text":"老佛爷明见千里，～！但据抚臣毓贤密报，的确是真。","book":"蔡东藩《清史演义》第八十八回"},"usage":"作谓语、定语；用于对人或事物等"},{"id":45040,"word":"钦差大臣","pinyin":"qīn chāi dà chén","abbr":"qcdc","explanation":"过去指由皇帝派遣并代表皇帝外出办理重大事件的官员。现在用来讽刺从上级机关派到下面去，不了解情况就指手画脚发号施令的人。","source":{"text":"三品以上用钦差大臣关防，四品以下用钦差官员关防。","book":"清·阮葵生《茶余客话·钦差官使》"},"example":{"text":"雯青因是～，上海道特地派了一只官轮来接，走了一夜，次早就抵埠头。","book":"清·曾朴《孽海花》第九回"},"similar":["重任在身"],"opposite":["奸贼死党"],"usage":"作主语、宾语；指特派员"},{"id":45041,"word":"钦敬之忱","pinyin":"qīn jìng zhī chén","abbr":"qjzc","explanation":"钦佩敬重的真诚的情意。","source":{"text":"我们对于所有这样的军队，特别是在前线抗战的军队，都是具有钦敬之忱的。","book":"毛泽东《国共合作成立后的迫切任务》"},"usage":"作宾语；用于处世"},{"id":45042,"word":"钦贤好士","pinyin":"qīn xián hào shì","abbr":"qxhs","explanation":"尊敬贤才，爱惜文士。","source":{"text":"闻王钦贤好士，吐握不倦，苟有一介，莫不毕至。","book":"宋·张君房《云笈七签》卷一○九"},"usage":"作谓语、定语；用于为人"},{"id":45043,"word":"钧天之乐","pinyin":"jūn tiān zhī yuè","abbr":"jtzl","explanation":"钧天：古代神话传说指天的中央。指天上的音乐，仙乐。后形容优美雄壮的乐曲。","source":{"text":"行百许步，复有大殿，上陈广筵重乐，罗列樽俎，九奏万舞，若钧天之乐。","book":"《异闻录·韦安道》"},"example":{"text":"虽有～，霓裳羽衣之舞，皆付之不见不闻。","book":"清·李渔《闲情偶寄·科诨第五》"},"similar":["钧天广乐","广乐钧天"],"usage":"作主语、宾语；指天上的音乐"},{"id":45044,"word":"钧天广乐","pinyin":"jūn tiān guǎng yuè","abbr":"jtgy","explanation":"钧天：古代神话传说指天之中央；广乐：优美而雄壮的音乐。指天上的音乐，仙乐。后形容优美雄壮的乐曲。","source":{"text":"王实以为清都紫微，钧天广乐，帝之所居。","book":"《列子·周穆王》"},"example":{"text":"昔者大帝说秦缪公而觐之，飨以～。","book":"汉·张衡《西京赋》"},"similar":["广乐钧天","钧天之乐"],"usage":"作主语、宾语；指天上的音乐"},{"id":45045,"word":"钩元提要","pinyin":"gōu yuán tí yào","abbr":"gyty","explanation":"钩：探索；提：举出；要：纲要。探取精微，摘出纲要。","source":{"text":"记事者必提其要，纂言者必钩其玄。","book":"唐·韩愈《进学解》"},"example":{"text":"故撰录事迹，诠次法程，～庶有取尔。","book":"章炳麟《正学报缘起·例言》"},"similar":["钩玄提要"],"usage":"作谓语；指探取精微，摘出纲要"},{"id":45046,"word":"钩元摘秘","pinyin":"gōu yuán zhāi mì","abbr":"gyzm","explanation":"探取精微，采摘奥秘。","source":{"text":"或钩元摘秘，著古今未有之奇书。","book":"郑观应《盛世危言·藏书》"},"usage":"作谓语、宾语；用于书面语"},{"id":45047,"word":"钩心斗角","pinyin":"gōu xīn dòu jiǎo","abbr":"gxdj","explanation":"心：宫室中心；角：檐角。原指宫室建筑结构的交错和精巧。后比喻用尽心机，明争暗斗。","source":{"text":"各报地势，钩心斗角。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"但他人谁会想到他为了争一点无聊的名声，竟肯如此～，无所不至呢。","book":"鲁迅《两地书》十五"},"similar":["明争暗斗"],"opposite":["开诚相见","肝胆相照"],"usage":"作谓语、定语；指明争暗斗","story":["唐朝诗人杜牧有感于晚唐帝王的大兴土木、骄奢淫逸，十分感慨，就写一篇《阿房宫赋》来讽喻当时的统治者，文章描写阿房宫的雄伟壮丽，原文如下：“五步一楼，十步一阁。廊腰缦回，檐牙高啄。各抱地势，钩心斗角。”"]},{"id":45048,"word":"钩深图远","pinyin":"gōu shēn tú yuǎn","abbr":"gsty","explanation":"指对僻远的异族图谋予以讨伐。","source":{"text":"是时孝武因其余财府帑这蓄，始有钩深图远之意，探冒顿之罪，校平城之雠。","book":"《后汉书·文苑传上·杜笃》"},"usage":"作谓语、定语；用于处事"},{"id":45049,"word":"钩深极奥","pinyin":"gōu shēn jí ào","abbr":"gsja","explanation":"指探索并极尽深奥的意义、道理。","source":{"text":"休少以好学，游心典谟，既综七经，又精群纬，钩深极奥，穷览圣旨。","book":"汉·蔡邕《玄文先生李子材铭》"},"usage":"作谓语、定语；用于学术等"},{"id":45050,"word":"钩深索隐","pinyin":"gōu shēn suǒ yǐn","abbr":"gssy","explanation":"钩：钩取；索：探索。色取深处的，探索隐秘的。指钻研深奥的学问，探索隐秘的事情。","source":{"text":"探赜索隐，钩深致远。","book":"《周易·系辞上》"},"example":{"text":"明眼人取而阅之，～，煞费苦心，尚未能洞烛靡遗。","book":"蔡东藩、许厪父《民国通俗演义》自序"},"similar":["钩深致远"],"usage":"作谓语、宾语；用于学问等"},{"id":45051,"word":"钩深致远","pinyin":"gōu shēn zhì yuǎn","abbr":"gszy","explanation":"致：招致。探取深处的，使远处的到来。比喻探讨深奥的道理。","source":{"text":"探赜索隐，钩深致远。","book":"《周易·系辞上》"},"example":{"text":"～，盖非浅识所测。","book":"南朝·宋·刘义庆《世说新语·方正》"},"similar":["钩深索隐"],"usage":"作谓语；比喻探索深奥的道理"},{"id":45052,"word":"钩爪锯牙","pinyin":"gōu zhǎo jù yá","abbr":"gzjy","explanation":"指鸟兽尖曲、锋利的爪、牙。比喻人的凶恶残暴。也比喻武装军队。","source":{"text":"凤皇不下，句爪、居牙、戴角、出距之兽于是鸷矣。","book":"汉·东方朔《神异经·西北荒经》：“穷奇似牛而狸尾，钩爪锯牙，逢忠信之人，齧而食之。”《淮南子·本经训》"},"example":{"text":"虐人害物即豺狼，何必～食人肉。","book":"唐·白居易《杜陵叟》诗"},"usage":"作谓语、定语、宾语；比喻人的凶恶残暴"},{"id":45053,"word":"钩玄提要","pinyin":"gōu xuán tí yào","abbr":"gxty","explanation":"钩：探索；玄：精微之处；提：举出；要：纲要。探取精微，摘出纲要。","source":{"text":"记事者必提其要，纂言者必钩其玄。","book":"唐·韩愈《进学解》"},"example":{"text":"～，匪按图索骥之空言；考古验今，得闭户斫轮之大意。","book":"明·邵亨贞《〈南村辍耕录〉疏》"},"similar":["钩元提要","提要钩玄"],"usage":"作谓语；指探取精微，摘出纲要"},{"id":45054,"word":"钩玄猎秘","pinyin":"gōu xuán liè mì","abbr":"gxlm","explanation":"探取精微，搜寻奥秘。","source":{"text":"景孚为文，钩玄猎秘，杂以古文奇字。","book":"清·陈田《明诗纪事戊签·江晖》"},"usage":"作谓语、定语；用于学术等"},{"id":45055,"word":"钩章棘句","pinyin":"gōu zhāng jí jù","abbr":"gzjj","explanation":"钩：弯曲；章：章节；棘：刺；句：文句。形容文辞艰涩拗口。","source":{"text":"钩章棘句，掐擢胃肾。","book":"唐·韩愈《贞曜先生墓志铭》"},"example":{"text":"时进士相习为奇僻，～，浸失浑淳。","book":"《宋史·选举志一》"},"usage":"作谓语、宾语；指文辞艰涩拗口"},{"id":45056,"word":"钩辀格磔","pinyin":"gōu zhōu gé zhé","abbr":"gzgz","explanation":"鹧鸪的叫声。","source":{"text":"正穿诘曲崎岖路，更听钩辀硌磔声。","book":"唐·李群玉《九子坡闻鹧鸪》诗"},"example":{"text":"曲诘崎岖，乃双声也；～，乃叠韵也。","book":"宋·胡仔《苕溪渔隐从话前集》卷二"},"usage":"作宾语、定语；指鹧鸪的叫声"},{"id":45057,"word":"钩金舆羽","pinyin":"gōu jīn yú yǔ","abbr":"gjyy","explanation":"钩金：三钱多的金子；舆：车；羽：羽毛。金子比羽毛重，但不能说三钱多重的金子比一车羽毛还重。比喻二者悬殊太大，不可作比。","source":{"text":"金重于羽者，岂谓一钩金与一舆羽之谓哉。","book":"《孟子·告子下》"},"example":{"text":"《孟子·告子下》：“金重于羽者，岂谓一钩金与一舆羽之谓哉。”"},"usage":"作宾语；指类比失当"},{"id":45058,"word":"钩隐抉微","pinyin":"gōu yǐn jué wēi","abbr":"gyjw","explanation":"钩：探求；隐：深奥；抉：择取；微：精微。治学上能发掘幽深深奥之处，发挥精微。","source":{"text":"《从书》门分类聚，钩隐抉微，考证经史百氏，下至骚人墨客佚事，细大不捐。","book":"宋·郭绍彭《宋王先生圹铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":45059,"word":"钱可使鬼","pinyin":"qián kě shǐ guǐ","abbr":"qksg","explanation":"使：支使。有钱可以支使鬼。形容金钱魔力极大，可以买通一切。","source":{"text":"谚曰：‘钱无耳，可闇使。’岂虚也哉！又曰：‘有钱可使鬼。’而况于人乎！","book":"晋·鲁褒《钱神论》"},"example":{"text":"然而富家儿总不免常常误解，以为～，就也可以通文。","book":"鲁迅《准风月谈·后记》"}},{"id":45060,"word":"钱可通神","pinyin":"qián kě tōng shén","abbr":"qkts","explanation":"比喻金钱的魔力极大。","source":{"text":"钱十万可通神矣，无不可回之事，吾惧祸及，不得不止。","book":"唐·张固《幽闲鼓吹》卷五十二"},"example":{"text":"大小荆条，先决四十，再发有司，从公拟罪，～，法难纵你。","book":"元·无名氏《鸳鸯被》第四折"},"similar":["有钱能使鬼推磨"],"usage":"作宾语；指金钱的魔力","story":["唐代宗李豫时，左仆射张延赏了解一件重大冤案，叫狱吏十天内了结。没想到第二天公案上有个帖子要求三万贯不过问此案。他气愤地要求尽快了结，结果帖子数目增加到十万贯。他感到对方势力就作罢，感慨地说：“钱至十万，可通神矣”"]},{"id":45061,"word":"钱过北斗","pinyin":"qián guò běi dǒu","abbr":"qgbd","explanation":"北斗；北斗星。形容钱财很多。","source":{"text":"家里钱过北斗，米烂陈仓，赤的是金，白的是银；圆得是珠，光的是宝。","book":"明·施耐庵《水浒全传》第二十三回"},"example":{"text":"真像古人说的：～，米烂成仓，僮仆成群，朱马成行。","book":"周而复《上海的早晨》第六章"},"usage":"作谓语、定语；指人富有"},{"id":45062,"word":"钳口不言","pinyin":"qián kǒu bù yán","abbr":"qkby","explanation":"钳口：闭口。闭着嘴不说话。","source":{"text":"吾形解而不欲动，口钳而不欲言，吾所学者，直土梗耳！","book":"《庄子·田子方》"},"example":{"text":"遇廷争则～，罗谴责则引身潜避。","book":"清·阮葵生《茶余客话》卷六"},"similar":["缄口不言"],"opposite":["口若悬河"],"usage":"作谓语、定语；指不说话"},{"id":45063,"word":"钳口侧目","pinyin":"qián kǒu cè mù","abbr":"qkcm","explanation":"口不敢言，斜目而视，指敢怒不敢言。","example":{"text":"面对他的高压统治，百姓只能～。"},"similar":["敢怒不敢言"],"usage":"作谓语、定语、状语；用于书面语"},{"id":45064,"word":"钳口吞舌","pinyin":"qián kǒu tūn shé","abbr":"qkts","explanation":"钳口：闭口。指闭嘴不言。","source":{"text":"若使下官事非其虚，罪得其实，亦当钳口吞舌，伏匕首殒身。","book":"南朝·梁·江淹《诣建平王上书》"},"similar":["钳口结舌"],"opposite":["直言不讳"],"usage":"作谓语、宾语；指闭口不说"},{"id":45065,"word":"钳口挢舌","pinyin":"qián kǒu jiǎo shé","abbr":"qkjs","explanation":"钳口：闭口；挢舌：翘起舌头。形容因惊讶或害怕而闭嘴翘舌说不出话来的样子。","source":{"text":"此智士所以钳口结舌，挌囊共默而已者也。","book":"汉·王充《潜夫论》"},"example":{"text":"一旦遇大利害，抢攘无措，～而莫敢言。","book":"《清史稿·朱琦传》"},"usage":"作定语；指闭口"},{"id":45066,"word":"钳口结舌","pinyin":"qián kǒu jié shé","abbr":"qkjs","explanation":"钳口：闭口。闭口不说话。形容理屈词穷说不出话来。也指慑于淫威不敢讲话。","source":{"text":"此智士所以钳口结舌、括囊共默而已者也。","book":"汉·王符《潜夫论·贤难》"},"example":{"text":"然则破空而存物，破时而存事者，终不能使边、尽诸见，一时～明矣。","book":"章炳麟《建立宗教论》"},"similar":["缄口不言","张口结舌","闭口不言"],"opposite":["直言不讳","脱口而出"],"usage":"作谓语、宾语；指闭口不说"},{"id":45067,"word":"钳马衔枚","pinyin":"qián mǎ xián méi","abbr":"qmxm","explanation":"钳马：用器具夹住马口，不使鸣叫；衔枚：形如箸，两端有带，可系于颈上。形容古代急行军时听不到马的嘶叫和人的说话声。","source":{"text":"宜选敢悍数千，骛行潜掩，偃旗裹甲，钳马衔枚。","book":"南朝·宋·袁淑《防御索虏议》"},"usage":"作宾语、定语；用于行军等"},{"id":45068,"word":"钻冰取火","pinyin":"zuàn bīng qǔ huǒ","abbr":"zbqh","explanation":"比喻徒劳无功。","source":{"text":"姐姐每钻冰取火，婆婆每指山卖磨。","book":"《全元散曲·普天乐·嘲风情》"},"example":{"text":"清·贪梦道人《彭公案》第46回：“这里找你老人家，如同～，轧沙取油。”"},"similar":["钻冰求火"],"usage":"作宾语、定语；用于比喻句"},{"id":45069,"word":"钻冰求火","pinyin":"zuān bīng qiú huǒ","abbr":"zbqh","explanation":"比喻徒劳无功。","source":{"text":"影离响绝，云销雾除，钻冰求火，探巢捕鱼，不足言其无也。","book":"宋·张君房《云笈七签》第102卷"},"similar":["缘木求鱼","徒劳无益","钻冰取火"],"usage":"作谓语、定语；指徒劳无功"},{"id":45070,"word":"钻冰求酥","pinyin":"zuān bīng qiú sū","abbr":"zbqs","explanation":"酥：酥油，牛羊奶制成的食品。比喻想要的东西一定得不到。","source":{"text":"譬如钻冰求酥，是实难得。","book":"《菩萨本缘经》卷下"},"similar":["钻冰求火"],"usage":"作宾语、定语；指处世方法不对"},{"id":45071,"word":"钻刀立誓","pinyin":"zuān dāo lì shì","abbr":"zdls","explanation":"钻刀：古代立誓仪式，立誓人要从刀门下钻过，表示如果负盟，甘愿死于刀刃之下。形容立誓定盟之真诚","source":{"text":"即当钻刀立誓，永受元帅鞭策便了。","book":"清·李玉《牛头山》"},"usage":"作宾语、定语；用于书面语"},{"id":45072,"word":"钻坚仰高","pinyin":"zuàn jiān yǎng gāo","abbr":"zjyg","explanation":"原形容颜渊对于孔子之道的赞叹，后指努力攻读，深入研究，力求达到极高水平。","source":{"text":"博学余暇，游手于斯，后世慕焉，专用为务，钻坚仰高，忘其罢劳。","book":"《论语·子罕》：“颜渊喟然叹曰：‘仰之弥高，钻之弥坚。’”汉·赵壹《非草书》"},"example":{"text":"故夫子尝以先难后获为仁，又以先事后得为崇德，盖于此小差则心失其正，虽有～之志，而反为谋利计功之私矣。","book":"宋·朱熹《答林退思》"},"usage":"作宾语、定语；用于书面语"},{"id":45073,"word":"钻坚研微","pinyin":"zuàn jiān yán wēi","abbr":"zjyw","explanation":"钻研艰深精妙的学问。","source":{"text":"博闻强识，钻坚研微，有弗及之勤。","book":"《晋书·虞喜传》"},"usage":"作宾语、定语；用于书面语"},{"id":45074,"word":"钻天入地","pinyin":"zuān tiān rù dì","abbr":"ztrd","explanation":"形容神通广大，很有办法。","source":{"text":"他是个钻天入地，斧砍火烧，下油锅都不怕的好汉。","book":"明·吴承恩《西游记》第三十二回"},"example":{"text":"明·吴承恩《西游记》第32回：“他是个～，斧砍火烧，下油锅都不怕的好汉。”"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":45075,"word":"钻天打洞","pinyin":"zuān tiān dǎ dòng","abbr":"ztdd","explanation":"比喻利用一切机会钻营。","source":{"text":"那边渔阳伯与郭掌柜摩拳擦掌的时候，正这边庄燕替章风孙钻天打洞的当儿。","book":"清·曾朴《孽海花》第二十二回"},"usage":"作谓语、宾语、定语；指人会钻营"},{"id":45076,"word":"钻天觅缝","pinyin":"zuàn tiān mì féng","abbr":"ztmf","explanation":"比喻千方百计地寻找时机。","source":{"text":"只要你不给他点烟倒茶，侍侯周到了，他就钻天觅缝地收拾你！","book":"老舍《女店员》第一幕"},"similar":["钻洞觅缝"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":45077,"word":"钻头就锁","pinyin":"zuàn tóu jiù suǒ","abbr":"ztjs","explanation":"形容自投罗网。","source":{"text":"你正是剔蝎撩蜂，暴虎凭河，谁着你钻头就锁，也怪不的咱故旧情薄。","book":"元·尚仲贤《气英布》第一折"},"similar":["自投罗网"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":45078,"word":"钻头觅缝","pinyin":"zuān tóu mì fèng","abbr":"ztmf","explanation":"比喻到处寻找门路。","source":{"text":"秦福到了武城，钻头觅缝的打听。","book":"清·西周生《醒世姻缘传》第十八回"},"example":{"text":"一到南京，便～的寻觅事情。","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["钻天打洞"],"usage":"作谓语、定语；指寻找门路"},{"id":45079,"word":"钻尖仰高","pinyin":"zuān jiān yǎng gāo","abbr":"zjyg","explanation":"钻：钻研；仰：仰望。越抬头看，越觉得高；越用力钻研，越觉得深。原形容颜渊对于孔子之道的赞叹。后指深入研究。","source":{"text":"颜渊喟然叹曰：‘仰之尔高，钻之弥坚。","book":"《论语·子罕》"},"example":{"text":"盖于此小差则心失其正，虽有～之志，而反为谋利计功之私矣。","book":"宋·朱熹《答林退思》"}},{"id":45080,"word":"钻山塞海","pinyin":"zuàn shān sāi hǎi","abbr":"zssh","explanation":"比喻做极为困难的事。","source":{"text":"只要你干，我钻山塞海总来一个。","book":"沙汀《淘金记》二"},"usage":"作定语、状语；用于书面语"},{"id":45081,"word":"钻心刺骨","pinyin":"zuàn xīn cì gǔ","abbr":"zxcg","explanation":"钻入心里，侵入骨中。形容刺激极深。","source":{"text":"一到登场的时节，他把我认做真妻子，我把他认做真丈夫。没有一句话儿，不说得钻心刺骨。","book":"清·李渔《比目鱼》第六回"},"example":{"text":"熏得你浑身起红斑点，～的痒痒。","book":"大群《小矿工·续编》"},"usage":"作谓语、定语；用于比喻句"},{"id":45082,"word":"钻懒帮闲","pinyin":"zuān lǎn bāng xián","abbr":"zlbx","explanation":"指逢迎凑趣，耍弄乖巧。亦指逢迎凑趣，耍弄乖巧的人。","source":{"text":"我想着香闺少女……怎守得三贞九烈，敢早着了钻懒帮闲。","book":"元·无名氏《杀狗劝夫》第四折：“他他他似这般钻懒帮闲，便是他封妻荫子。”元·关汉卿《望江亭》第一折"},"example":{"text":"～人无赛，高占莺花风月寨。","book":"明·孟称舜《娇红记·归图》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":45083,"word":"钻故纸堆","pinyin":"zuàn gù zhǐ duī","abbr":"zgzd","explanation":"故纸：指古籍。指一味钻研古籍而脱离现实。亦作“钻故纸”、“钻研故纸”。","source":{"text":"关于这些，我们既没有时间钻故纸堆，也没有能力钻故纸堆，我们只是提醒读者老爷，这种把一半中国人硬生生折丧成残废的文化，至少在中国已存在了一千年之久。","book":"《柏杨杂文集·浊世人间》"},"example":{"text":"他成天地～，对于外面的事一点也不知道。"},"similar":["钻故纸","葄枕图史","钻研故纸"],"usage":"作谓语、宾语；指书呆子"},{"id":45084,"word":"钻木取火","pinyin":"zuān mù qǔ huǒ","abbr":"zmqh","explanation":"硬木棒对着木头摩擦或钻进去，靠摩擦取火。","source":{"text":"形之所自生者，如钻木得火。","book":"《关尹子·二柱》"},"example":{"text":"他在孤岛上过着～的生活。"},"similar":["钻木得火"],"usage":"作谓语、宾语、定语；指原始生活"},{"id":45085,"word":"钻洞觅缝","pinyin":"zuàn dòng mì féng","abbr":"zdmf","explanation":"比喻千方百计地寻找时机。","source":{"text":"一下里他那好像冻僵了的心重复生气蓬勃，能够出主意，能够钻洞觅缝找门路了。","book":"茅盾《子夜》十一：“做公债的人那一个不在那里钻洞觅缝探听老赵的手法呢！” 又十六"},"similar":["钻天觅缝"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":45086,"word":"钻火得冰","pinyin":"zuān huǒ dé bīng","abbr":"zhdb","explanation":"比喻不可能实现的事情。","source":{"text":"未见钻火得冰，种豆得麦。","book":"唐·释道世《法苑珠林》"},"similar":["缘木求鱼"],"usage":"作宾语、定语；指办事方法不对头"},{"id":45087,"word":"钻燧取火","pinyin":"zuàn suì qǔ huǒ","abbr":"zsqh","explanation":"燧：火石。钻打火石取火。原始人类取火的方式","source":{"text":"有圣人作，钻燧取火，以化腥躁，而民说之，使王天下，号之曰燧人氏。","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"李四光《人类的出现》：“象我国关于远古的传说那样，‘～，以化腥躁’，就会扩大食物的范围……”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":45088,"word":"钻牛犄角","pinyin":"zuān niú jī jiǎo","abbr":"znjj","explanation":"指思想方法狭窄。比喻费力研究不值得研究或无法解决的问题","source":{"text":"有人要是非钻牛犄角死想不可，他一定是傻蛋。","book":"老舍《赵子曰》"},"similar":["钻牛角尖"],"usage":"作谓语、定语、宾语；用于处事"},{"id":45089,"word":"钻牛角尖","pinyin":"zuān niú jiǎo jiān","abbr":"znjj","explanation":"比喻费力研究不值得研究或无法解决的问题。也指思想方法狭窄。","source":{"text":"凡事都要留有余地，别死钻牛角尖。","book":"老舍《神拳》第三幕"},"example":{"text":"他遇事爱～。"},"similar":["钻牛犄角"],"usage":"作谓语、定语、宾语、状语；用于处事"},{"id":45090,"word":"钻皮出羽","pinyin":"zuān pí chū yǔ","abbr":"zpcy","explanation":"比喻极意夸饰自己偏爱的人。","source":{"text":"所好则钻皮出其毛羽，所恶则洗垢求其瘢痕。","book":"汉·赵壹《刺世疾邪赋》"},"example":{"text":"好则～，恶则洗垢索瘢。","book":"《新唐书·魏征传》"},"usage":"作定语；指虚夸"},{"id":45091,"word":"钻研故纸","pinyin":"zuān yán gù zhǐ","abbr":"zygz","explanation":"故纸：指文籍，古书。讽刺脱离实际，一味读古书的人","source":{"text":"钻研故纸，信煮字真可疗饥。","book":"清·张岱《讨蠹鱼檄》"},"similar":["钻故纸"],"usage":"作谓语、定语；用于书面语"},{"id":45092,"word":"钻穴逾垣","pinyin":"zuàn xué yú yuán","abbr":"zxyy","explanation":"指偷情、私奔、偷窃等行为。","source":{"text":"也有钻穴逾垣在那里偷窃的，也有杀人放火在那里抢劫的。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["钻穴逾隙","钻穴逾墙","钻隙逾墙"],"usage":"作谓语、定语；指男女偷情或小偷行窃"},{"id":45093,"word":"钻穴逾墙","pinyin":"zuān xué yú qiáng","abbr":"zxyq","explanation":"穴：洞。逾：越过。钻洞爬墙。旧时常比喻违背父母之命、媒妁之言的青年男女自由相恋的行为。后也指男女偷情或小偷行窃。","source":{"text":"不待父母之命，媒妁之言，钻穴隙相窥，逾墙相从，则父母国人皆贱之。","book":"《孟子·滕文公下》"},"example":{"text":"那里有～闵子骞。","book":"元·乔孟符《金钱儿》第二折"},"similar":["钻穴逾隙","钻穴逾垣"],"usage":"作谓语、定语；指男女偷情或小偷行窃"},{"id":45094,"word":"钻穴逾隙","pinyin":"zuān xué yú xì","abbr":"zxyx","explanation":"指偷情、私奔、偷窃等行为。","source":{"text":"安丘某生通卜筮之术，其为人邪荡不检，每有钻穴逾隙之行，则卜之。","book":"清·蒲松龄《聊斋志异·果报》"},"similar":["钻穴逾垣","钻穴逾墙","钻隙逾墙"],"usage":"作谓语、定语；指男女偷情或小偷行窃"},{"id":45095,"word":"钻空子","pinyin":"zuān kòng zǐ","abbr":"zkz","explanation":"指乘隙钻营投机","source":{"text":"这么两句半话跟大人都说不清楚，让小人钻空子。","book":"王朔《一点正经没有》"},"example":{"text":"章诒和《往事并不如烟·一片青山了此身》：“万一他们～，态度表现不好，我们应及时展开批评。”"},"usage":"作谓语、定语、宾语；用于口语"},{"id":45096,"word":"钻营奔竞","pinyin":"zuān yíng bēn jìng","abbr":"zybj","explanation":"钻营：找门路，托人情，以谋取名利；奔竞：争逐。争名逐利，到处找门路","source":{"text":"他的功名大都从钻营奔竞而来。","book":"清·李宝嘉《官场现形记》第12回"},"usage":"作谓语、宾语；用于书面语"},{"id":45097,"word":"钻隙逾墙","pinyin":"zuān xì yú qiáng","abbr":"zxyq","explanation":"指偷情、私奔、偷窃等行为。","source":{"text":"此钻隙逾墙之贱，而惧行已之无耻也。","book":"宋·陈亮《祭潘叔度文》"},"similar":["钻穴逾墙","钻穴逾隙","钻穴逾垣"],"usage":"作谓语、定语；指男女偷情或小偷行窃"},{"id":45098,"word":"钿合金钗","pinyin":"diàn hé jīn chāi","abbr":"dhjc","explanation":"钿盒和金钗，相传为唐玄宗与杨贵妃定情之信物。泛指情人之间的信物。","source":{"text":"唯将旧物表深情，钿合金钗寄将去。","book":"唐·白居易《长恨歌》"},"example":{"text":"～细语处，算谁在，回廊影下。","book":"宋·柳永《二郎神》词"},"usage":"作宾语；指情人之间的信物"},{"id":45099,"word":"钿车宝马","pinyin":"diàn chē bǎo mǎ","abbr":"dcbm","explanation":"华丽的车子，珍贵的宝马。指考究的车骑。","source":{"text":"听欢声、犹自未归，钿车宝马。","book":"宋·李昴英《瑞鹤仙》词"},"example":{"text":"回首，看～，六街烟绣。","book":"清·张昌衢《月华清·上元观灯》"}},{"id":45100,"word":"铁中铮铮","pinyin":"tiě zhōng zhēng zhēng","abbr":"tzzz","explanation":"铮铮：金属器皿相碰的声音。比喻才能出众的人。","source":{"text":"卿所谓铁中铮铮，庸中佼佼者也。","book":"《后汉书·刘盆子传》"},"example":{"text":"黑闼何足道！如汉田横，唐之李密，亦可谓～者也。","book":"明·瞿祐《剪灯新话·华亭逢故人记》"},"similar":["铮铮铁骨"],"usage":"作谓语、定语；指才能较为出众的人"},{"id":45101,"word":"铁佛伤心，石人落泪","pinyin":"tiě fó shāng xīn，shí rén luò lèi","abbr":"tfsxsrll","explanation":"铁铸的的神佛也会伤心，雕刻的石人也会落泪。形容极其悲伤。","source":{"text":"这场哭，直哭得那铁佛伤心，石人落泪；风凄云惨，鹤唳猿啼。","book":"清·文康《儿女英雄传》第十九回"},"usage":"作宾语、定语；用于比喻句"},{"id":45102,"word":"铁券丹书","pinyin":"tiě quàn dān shū","abbr":"tqds","explanation":"铁券：用铁制的凭证；丹书：用朱砂写字。古代帝王赐给功臣世代享受优遇或免罪的凭证。文凭用丹书写铁板上，故名。","source":{"text":"丹书铁券，传于无穷。","book":"《后汉书·祭遵传》"},"example":{"text":"～家世，朱阁青毡步武，名字在尧聪。","book":"宋·李曾伯《水调歌头》词"}},{"id":45103,"word":"铁嘴钢牙","pinyin":"tiě zuǐ gāng yá","abbr":"tzgy","explanation":"比喻能言善辩。","source":{"text":"你看他真是铁嘴钢牙。","book":"《花城》1981年第5期"},"example":{"text":"一开始这林德厚不服气儿，～，就是不承认。","book":"单田芳《童林传》第二一九回"},"similar":["嘴尖牙利"],"usage":"作宾语、定语；多用于人"},{"id":45104,"word":"铁壁铜墙","pinyin":"tiě bì tóng qiáng","abbr":"tbtq","explanation":"像铜铁筑成的墙壁一样。比喻十分坚固，不可摧毁的事物。","source":{"text":"随他铜墙铁壁，也不怕不拆倒了他的。","book":"元·无名氏《谢金梧》楔子"},"example":{"text":"张弓硬弩护辕门，～齐队伍。","book":"明·许仲琳《封神演义》第五十一回"},"similar":["铜墙铁壁"],"usage":"作宾语、定语；比喻牢不可破的工事"},{"id":45105,"word":"铁壁铜山","pinyin":"tiě bì tóng shān","abbr":"tbts","explanation":"比喻坚强可靠的势力。","source":{"text":"有这两位豁刺刺的大头脑做我的铁壁铜山，难道这小小官儿，不让我自由做做么？","book":"清·感惺《游侠传·侠圆》"},"usage":"作宾语、定语；多用于比喻句"},{"id":45106,"word":"铁心木肠","pinyin":"tiě xīn mù cháng","abbr":"txmc","explanation":"犹言铁打心肠。","source":{"text":"王介甫少时作《石榴花》……此老风味不薄，岂铁心木肠者哉。","book":"宋·赵令畤《侯鲭录》卷三"},"similar":["铁心石肠","铁石心肠","铁石心肝"],"usage":"作宾语、定语；用于处事"},{"id":45107,"word":"铁心石肠","pinyin":"tiě xīn shí cháng","abbr":"txsc","explanation":"犹言铁石心肠。","source":{"text":"然鹿门子常怪宋广平之为人，意其铁心石肠，而为《梅花赋》，则清便艳发，得南朝徐庾体。","book":"宋·苏轼《牡丹记叙》"},"example":{"text":"紫鹃姐姐，你从来不是这样～，怎么近来连一句好好儿的话都不和我说了？","book":"清·曹雪芹《红楼梦》第一一三回"},"similar":["铁石心肠","铁打心肠","铁石心肝"],"usage":"作宾语、定语；用于处事"},{"id":45108,"word":"铁心铁意","pinyin":"tiě xīn tiě yì","abbr":"txty","explanation":"下了决心，非常坚定。","example":{"text":"她偏偏～要跟他结婚。"},"similar":["死心塌地"],"usage":"作定语、状语；指铁定心"},{"id":45109,"word":"铁打心肠","pinyin":"tiě dǎ xīn cháng","abbr":"tdxc","explanation":"谓心肠像铁铸成的。形容人刚强的秉性。","source":{"text":"望断天涯无故人，便做铁打心肠珠泪倾。","book":"宋·无名氏《错立身》戏文第八出"},"example":{"text":"老爹，你一时之怒，打死了他，你若见这样呵，随你～也痛悲。","book":"明·徐霖《绣襦记·责善则离》"},"similar":["铁石心肠","铁石心肝","铁心石肠"],"usage":"作宾语、定语；用于处事"},{"id":45110,"word":"铁打江山","pinyin":"tiě dǎ jiāng shān","abbr":"tdjs","explanation":"用铁锻打成的江山。比喻国家巩固。","example":{"text":"这样下去，你的江山如何能够坐稳？如何能建立一统的～？","book":"姚雪垠《李自成》第四卷第十七章"}},{"id":45111,"word":"铁打铜铸","pinyin":"tiě dǎ tóng zhù","abbr":"tdtz","explanation":"铁打成的，用铜浇铸的。形容非常坚固。","source":{"text":"请老兄放心，并非愚弟酒后乱吹，敝寨确是像铁打铜铸的一般。","book":"姚雪垠《李自成》第一卷第二十四章"},"usage":"作宾语、定语；多用于书面语"},{"id":45112,"word":"铁杵成针","pinyin":"tiě chǔ chéng zhēn","abbr":"tccz","explanation":"比喻只要有毅力，肯下苦功，事情就能成功。","source":{"text":"好似铁杵磨针，心坚杵有成针日。","book":"明·郑之珍《目连救母·四·刘氏斋尼》"},"similar":["持之以恒"],"opposite":["半途而废"],"usage":"作谓语、宾语；用于劝诫人","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":45113,"word":"铁杵磨成针","pinyin":"tiě chǔ mó chéng zhēn","abbr":"tcmcz","explanation":"杵：舂米或捶衣用的棒。将铁棒磨成细针。比喻只要有恒心，肯努力，做任何事情都能成功。","source":{"text":"在象耳山下，世传李太白读书山中，未成弃去，过是溪，逢老媪方磨铁杵，问之，曰：‘欲作针’太白感其意还，卒业。","book":"宋·祝穆《方舆胜览·眉州·磨针溪》"},"example":{"text":"没听过～？","book":"阮章竞《漳河水》第二部"},"similar":["铁杵成针","铁棒磨成针"],"usage":"作宾语、定语、分句；用于劝诫人","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":45114,"word":"铁杵磨针","pinyin":"tiě chǔ mó zhēn","abbr":"tcmz","explanation":"铁杵：铁棍。铁棍子磨成绣花针。比喻只要有恒心，肯努力，做任何事情都能成功。","source":{"text":"好似铁杵磨针，心坚杵有成针日。","book":"明·郑之珍《目连救母·刘氏斋尼》"},"example":{"text":"那南方中的举人进士，不知费了先生多少掏成，多少指点，～，才成正果。","book":"《醒世姻缘》第25回"},"similar":["铁杵磨成针","铁杵成针"],"usage":"作宾语、定语；用于劝诫人","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":45115,"word":"铁板一块","pinyin":"tiě bǎn yī kuài","abbr":"tbyk","explanation":"比喻结合紧密，不可分裂的整体。","source":{"text":"朱元璋和这个集团的首脑人物，尽管在过去同生死，共患难，但并不是铁板一块。","book":"吴晗《朱元璋传》第七章"},"example":{"text":"他们不是～，我们各个击破。"},"similar":["牢不可破"],"usage":"作宾语、定语；比喻牢固不变"},{"id":45116,"word":"铁板不易","pinyin":"tiě bǎn bù yì","abbr":"tbby","explanation":"易：变易，更改。像铁板那样不能改变。形容不变的，不可更改的。","source":{"text":"所谓‘臧谷亡羊’，其亡必多。这是铁板不易的话。","book":"清·李绿园《歧路灯》第九十五回"},"example":{"text":"所以古人说得好来：悭吝揝财，必生败家之子。这两句话，便是从古至今～之理。","book":"清·刘璋《斩鬼传》第五回"},"usage":"作定语；用于处事"},{"id":45117,"word":"铁板歌喉","pinyin":"tiě bǎn gē hóu","abbr":"tbgh","explanation":"形容豪迈的演唱。","source":{"text":"撮几句盲辞瞎话，交还他铁板歌喉。","book":"清·郑燮《道情》曲之七"},"usage":"作宾语、定语；用于比喻句"},{"id":45118,"word":"铁板注脚","pinyin":"tiě bǎn zhù jiǎo","abbr":"tbzj","explanation":"注脚：解释字句的文字。指最具权威，不可动摇的注解。","source":{"text":"‘劝善规 过’四字，此是友字铁板注脚。","book":"清·孙锦标《通俗常言疏证·文事·铁板注脚》引陈裕门评吕语集粹"},"example":{"text":"吾夫子说“吾不如老农”、“吾不如老圃”这两句话，正是“吾非斯人之徒与而谁与”的～。","book":"清·文康《儿女英雄传》第三十三回"}},{"id":45119,"word":"铁板钉钉","pinyin":"tiě bǎn dìng dīng","abbr":"tbdd","explanation":"①犹言硬碰硬。比喻说话办事坚决、干脆。②比喻已成定论。","source":{"text":"［老汉］右手的烟袋朝着支书手中的计划点了几点，铁板钉钉似的崩出来三个字：‘我反对！’","book":"范乃成《小技术员战胜神仙手》"},"example":{"text":"大红门里的叶处长就是二妞儿，已经～，不容怀疑了。","book":"《花城》1981年第6期"},"similar":["板上钉钉"],"usage":"作定语；指铁定的事情"},{"id":45120,"word":"铁板铜弦","pinyin":"tiě bǎn tóng xián","abbr":"tbtx","explanation":"形容豪迈激越的文章风格。","source":{"text":"铁板铜弦随手弄，娄江有个人知重。","book":"清·蒋士铨《临川梦·提纲》"},"similar":["铁板铜琶","铜琶铁板"],"usage":"作宾语、定语；多用于比喻句","story":["北宋时期，苏轼带他随从外出郊游，他观赏山崖的金鸡菊，随从在一旁高唱苏轼的歌词。苏轼问他们自己与柳永的词有什么不同。随从说：柳郎中的词只可借17岁的女孩子执红牙拍板唱“杨柳外晓风残月”，您的歌词得请关西大汉持铁板唱“大江东去”"]},{"id":45121,"word":"铁板铜琶","pinyin":"tiě bǎn tóng pá","abbr":"tbtp","explanation":"形容豪迈激越的文章风格。同“铁板铜弦”。","source":{"text":"铁板铜琶唱《大江》，西来潮气未全降。","book":"清·二石生《十洲春语·评花小诗·杭州绣凤》"}},{"id":45122,"word":"铁树开华","pinyin":"tiě shù kāi huā","abbr":"tskh","explanation":"比喻事情非常罕见或极难实现。铁树原产热带，不常开花。热带，不常开花。华，通“花”。","source":{"text":"淳熙己亥八月朔示微疾，梁翰别郡守曾公。逮夜半书偈辞众曰：‘铁树开华，雄鸡生卵，七十二年，摇篮绳断。’掷笔云寂。","book":"《续传灯录·或庵师体禅师》"},"similar":["铁树开花","铁树花开"],"usage":"作宾语、定语；多用于比喻句"},{"id":45123,"word":"铁树开花","pinyin":"tiě shù kāi huā","abbr":"tskh","explanation":"铁树：也叫苏铁，常绿乔木，不常开花。比喻事情非常罕见或极难实现。","source":{"text":"吴浙间尝有俗谚云，见事难成，则云须铁树开花。","book":"明·王济《君子堂日询手镜》"},"example":{"text":"大军抗日渡金沙，铁树要开花。","book":"陈毅《赣南游击词》"},"similar":["百年不遇","大海捞针"],"opposite":["触目皆是","轻而易举","易如反掌"],"usage":"作主语、宾语；形容事情很难做成"},{"id":45124,"word":"铁树花开","pinyin":"tiě shù huā kāi","abbr":"tshk","explanation":"比喻事情非常罕见或极难实现。铁树原产热带，不常开花。热带，不常开花。同“铁树开花”。","source":{"text":"铁树花开千载易，坠落阿鼻耍出难。","book":"明·王济《君子堂日询手镜》：“吴浙间尝有俗谚云见事难成，则云须铁树花开。”明·洪楩《清平山堂话本·五戒禅师私红莲记》"},"example":{"text":"看夏王鼎上支祁号，～还早。 ◎清·杨潮观《灌口二郎初显圣》"}},{"id":45125,"word":"铁案如山","pinyin":"tiě àn rú shān","abbr":"tars","explanation":"铁案：证据确凿的案件或结论。形容证据确凿，定的案象山那样不能推翻。","source":{"text":"铁案如山，宿遂延颈以待秋决矣。","book":"清·蒲松龄《聊斋志异·胭脂》"},"example":{"text":"这个坏分子，罪行累累，～，不容抵赖。"},"similar":["铁证如山","确凿不移"],"opposite":["不实之词","屈打成招"],"usage":"作谓语、宾语；指已经定案"},{"id":45126,"word":"铁桶江山","pinyin":"tiě tǒng jiāng shān","abbr":"ttjs","explanation":"比喻牢固的政权或地位。","source":{"text":"村里的干部虽然调换了几个，而他两个却好像铁桶江山。","book":"赵树理《小二黑结婚》"},"usage":"作宾语、定语；多用于比喻句"},{"id":45127,"word":"铁棒磨成针","pinyin":"tiě bàng mó chéng zhēn","abbr":"tbmcz","explanation":"比喻只要有恒心，有毅力，做任何事情都能成功。同“铁杵磨成针”。","source":{"text":"拼着些坚忍工夫，做到铁棒磨成针的地位，看似发达的迟，实在收效最速。","book":"清·颐琐《黄绣球》第十章"},"example":{"text":"清·颐琐《黄绣球》第十回：“拚着些坚忍工夫，做到～的地位，看似发达得迟，实在收效最速。”"},"similar":["铁杵磨成针"],"usage":"作宾语、定语、分句；用于劝诫人","story":["唐朝著名诗人李白小时候从不认真读书，经常是把书本一抛就出去玩耍。一天李白碰到一个白发苍苍的老婆婆正拿着一根大铁棒在石头上磨，觉得好奇问她做什么，老婆婆告诉他要磨成绣花针，李白深受感动，从此就用功读书，终于成为文豪"]},{"id":45128,"word":"铁狱铜笼","pinyin":"tiě yù tóng lóng","abbr":"tytl","explanation":"形容密闭森严的监牢。","source":{"text":"那儿是奴役因袭的铁狱铜笼，那儿有险狠、阴贼、贪婪，涌聚如蜂。","book":"郭沫若《星空·孤竹君子之二》"},"usage":"作宾语、定语；多用于比喻句"},{"id":45129,"word":"铁画银钩","pinyin":"tiě huà yín gōu","abbr":"thyg","explanation":"画：笔画；钩：钩勒。形容书法刚键柔美。","source":{"text":"徘徊俯仰，容与风流，刚则铁画，媚若银钩。","book":"唐·欧阳洵《用笔论》"},"example":{"text":"银钩铁画石经余，想见先唐字学书。","book":"清·沈曾植《题北宋本广韵四绝》诗"},"similar":["银钩铁画"],"usage":"作谓语、定语、宾语；形容书法刚键柔美"},{"id":45130,"word":"铁石心肝","pinyin":"tiě shí xīn gān","abbr":"tsxg","explanation":"犹言铁石心肠。形容人刚强的秉性。同“铁石心肠”。","source":{"text":"俺虔婆生下一副铁石心肝，皱著柄冻凌觜脸，把俺这做女的，不做人也似看承。","book":"明·刘兑《金童玉女娇红记》"},"example":{"text":"孤坟一径楚山尖，～老孝廉。","book":"清·顾炎武《楚僧元瑛谈湖南三十年来事作绝句》之二"},"similar":["铁石心肠","铁打心肠","铁心石肠"],"usage":"作主语、宾语；指心肠硬"},{"id":45131,"word":"铁石心肠","pinyin":"tiě shí xīn cháng","abbr":"tsxc","explanation":"心肠硬得象铁和石头一样。形容心肠很硬，不为感情所动。","source":{"text":"虽兄之受我厚，然仆本以铁石心肠待公。","book":"唐·皮日休《宋璟集序》：“宋广平刚态毅状，疑其铁石心肠。”宋·苏轼《与李公择书》"},"example":{"text":"如果再不给你回信，那简直是～了。","book":"闻一多《给臧克家先生》"},"similar":["泥塑木雕","我行我素","铁石心肝"],"opposite":["心慈面软"],"usage":"作主语、宾语；指心肠硬","story":["公元604年，隋炀帝杨广杀父继位，命负责检察的司隶大夫薛道衡对天下官员进行一次考察。薛道衡对卫州司马敬肃的评语是：“心如铁石，老而弥笃”。大臣宇文述希望敬肃庇护他那些仗着他势力为非作歹的亲朋。敬肃则将他们一一正法"]},{"id":45132,"word":"铁砚磨穿","pinyin":"tiě yàn mó chuān","abbr":"tymc","explanation":"把铁铸的砚台都磨穿了。比喻读书用功，有恒心。","source":{"text":"韦编屡绝铁砚穿，口诵手抄那计年。","book":"宋·陆游《寒夜读书》诗"},"example":{"text":"乌纱白发人争羡，须知～。","book":"明·王玉峰《焚香记·看榜》"},"similar":["磨穿铁砚"],"usage":"作宾语、定语；指人的恒心","story":["五代时期，桑维翰一心想考取进士，第一次因主考官迷信，桑与丧同音而没录取，第二次他写《日出扶桑赋》大赞扶桑，结果还没录取。朋友劝他想别的法子做官，他定制一块铁砚，说只有磨穿它后才会想别的办法去做官。最终还是考取了进士"]},{"id":45133,"word":"铁窗风味","pinyin":"tiě chuāng fēng wèi","abbr":"tcfw","explanation":"指监牢里囚犯的生活。","source":{"text":"随后十年来，除和几位救国会的同志在苏州略尝铁窗风味不能算流亡外，有第二次流亡……","book":"邹韬奋《患难余生记》第一章"},"example":{"text":"数十载的监牢生涯，使他遍尝～。"},"usage":"作主语、宾语；指坐牢"},{"id":45134,"word":"铁笔无私","pinyin":"tiě bǐ wú sī","abbr":"tbws","explanation":"谓执笔判案不徇私情。","source":{"text":"五个鬼齐齐的走上前去，照手一抢，把管笔夺将下来，说道，‘铁笔无私。’","book":"《中国小说史略》第十八篇"}},{"id":45135,"word":"铁算盘","pinyin":"tiě suàn pán","abbr":"tsp","explanation":"比喻精于算计的人。","source":{"text":"呀！你莫非在这里打铁算盘？","book":"清·吴趼人《二十年目睹之怪现状》第31回"},"example":{"text":"谁能算过你这个～？"},"usage":"作主语、宾语、定语；指精于算计的人"},{"id":45136,"word":"铁绰铜琶","pinyin":"tiě chuō tóng pá","abbr":"tctp","explanation":"形容豪迈激越的文章风格。同“铁板铜琶”。"},{"id":45137,"word":"铁网珊瑚","pinyin":"tiě wǎng shān hú","abbr":"twsh","explanation":"比喻搜罗珍奇。","source":{"text":"玉轮顾兔初生魄，铁网珊瑚未有枝。","book":"唐·李商隐《碧城》诗"},"usage":"作定语、宾语；比喻搜罗珍奇","story":["唐朝时期，在拂菻国就开始挖掘海底珊瑚了。由于珊瑚是寄生在石头上，像蘑菇一样白，一年后就发黄，三年后就发红，纵横交错，千姿百态，是当时的奇珍异宝。渔民乘船到珊瑚洲，把铁网中沉入水底，用船的力量拖拽而出"]},{"id":45138,"word":"铁肠石心","pinyin":"tiě cháng shí xīn","abbr":"tcsx","explanation":"比喻刚强而不为感情所动的秉性。","source":{"text":"贞姿劲质，刚态毅状，疑其铁肠石心，不解吐婉媚辞。","book":"唐·皮日休《桃花赋》序"},"similar":["铁石心肠","铁石心肝","铁心石肠"],"usage":"作宾语、定语；用于处事"},{"id":45139,"word":"铁腕人物","pinyin":"tiě wàn rén wù","abbr":"twrw","explanation":"用意志或性格的力量或军事手段进行领导或控制的人。","example":{"text":"我们佩服你这个～。"},"similar":["铁杆人物"],"usage":"作主语、宾语、定语；指实力派"},{"id":45140,"word":"铁证如山","pinyin":"tiě zhèng rú shān","abbr":"tzrs","explanation":"柳子戏《孙安动本》第四场：“十八张冤状在此，铁证如山，老贼还有何辩！”","source":{"text":"十八张冤状在此，铁证如山，老贼还有何辩！","book":"柳子戏《孙安动本》第四场"},"example":{"text":"他们罪行累累，～，不容抵赖。"},"similar":["铁案如山"],"usage":"作谓语、定语；指证据确凿"},{"id":45141,"word":"铁郭金城","pinyin":"tiě guō jīn chéng","abbr":"tgjc","explanation":"比喻设防坚固的城池。","source":{"text":"大军一至，朽珠枯木亦助声威；大军不至，则铁郭金城将沦灰烬。","book":"清·冯桂芬《公启曾协揆》"},"usage":"作主语、宾语；用于比喻句"},{"id":45142,"word":"铁钉铁铆","pinyin":"tiě dīng tiě mǎo","abbr":"tdtm","explanation":"确凿可信。","example":{"text":"～的事情不能只是说说而已。"},"similar":["铁板钉钉"],"usage":"作宾语、定语；指铁定的事情"},{"id":45143,"word":"铁面御史","pinyin":"tiě miàn yù shǐ","abbr":"tmys","explanation":"宋赵抃为殿中侍御史，弹劾权贵，刚直无私，人称“铁面御史”。后泛称不畏权贵，不徇私情，公正严明的官员。","source":{"text":"翰林学士曾公亮未之识，荐为殿中侍御史，弹劾不避权幸，声称凛然，京师目为‘铁面御史’。","book":"《宋史·赵抃传》"},"example":{"text":"明·程登吉《幼学琼林》第一卷：“王德用，人称黑王相公；赵清献，世号～。”"},"usage":"作宾语、定语；指公正严明的官员","story":["宋朝时期，翰林学士曾公亮听说赵抃是一个敢怒敢言的忠义之士，虽然没有见过面，但还是向皇帝推荐他为殿中侍御史。赵抃上任后，目睹朝廷的种种弊端，他浩然正气堤上书弹劾权贵。由于他刚直无私，人称“铁面御史”"]},{"id":45144,"word":"铁面无情","pinyin":"tiě miàn wú qíng","abbr":"tmwq","explanation":"形容公正严明，不怕权势，不讲情面。","source":{"text":"若要我与陈州百姓除了这害呵，则除是包龙图，那个铁面没人情。","book":"元·无名氏《陈州粜米》第一折"},"example":{"text":"奔逃无路，众和尚葫芦爆碎似椰瓢，叫杀连天，众好汉～如黑煞。","book":"有·清溪道人《禅真逸史》第十五回"}},{"id":45145,"word":"铁面无私","pinyin":"tiě miàn wú sī","abbr":"tmws","explanation":"形容公正严明，不怕权势，不讲情面。","source":{"text":"我想必得你去作个‘监社御史’，铁面无私才好。","book":"清·曹雪芹《红楼梦》第45回"},"example":{"text":"现在是共产党的天下，人家办事～，送钞票送金条不派用场。","book":"周而复《上海的早晨》第四部"},"similar":["明镜高悬","大公无私"],"opposite":["结党营私"],"usage":"作谓语、定语、状语；指不讲情面","story":["王熙凤酒后无德大骂平儿，事后觉得自己的行为过火，就向平儿道歉。李纨、探春等来拜访她们，她们与王熙凤说已经成立一个海棠诗社，要求增拨开销，并拉王熙凤入社，做一个铁面无私的“监社御史”。王熙凤看出了她们的目的，也只好做顺水人情了"]},{"id":45146,"word":"铁面枪牙","pinyin":"tiě miàn qiāng yá","abbr":"tmqy","explanation":"比喻坚忍不拔，刻苦自励。","source":{"text":"卧薪尝胆为吞吴，铁面枪牙是丈夫。","book":"明·李贽《咏古》之一"},"usage":"作宾语、定语；多用于比喻句"},{"id":45147,"word":"铁鞋踏破","pinyin":"tiě xié tà pò","abbr":"txtp","explanation":"比喻长途跋涉，到处寻求。","source":{"text":"便天涯海崖，天涯海崖，十洲方外，铁鞋踏破三千界。","book":"清·孔尚任《桃花扇·逃难》"}},{"id":45148,"word":"铁饭碗","pinyin":"tiě fàn wǎn","abbr":"tfw","explanation":"比喻稳固的永远不会失业的工作。","source":{"text":"反正工作好坏都是铁饭碗，能进不能出，能上不能下。","book":"邓小平《党和国家领导制度的改革》"},"example":{"text":"我们要打破～，引入竞争机制。"},"opposite":["泥饭碗"],"usage":"作主语、宾语、定语；指固定工作"},{"id":45149,"word":"铁马金戈","pinyin":"tiě mǎ jīn gē","abbr":"tmjg","explanation":"①形容威武雄壮的士兵和战马。②谓战事，兵事。","source":{"text":"忆当年铁马金戈，自桃园初结义，把尊兄辅佐。","book":"宋·李纲《以旧赐战袍等赠韩少帅》诗之二：“铁马金戈睢水上，碧油红旆海山滨。”元·关汉卿《双赴梦》第三折"},"example":{"text":"生长承平听画筝，几闻～声。","book":"清·魏源《秦淮镫船引》"},"similar":["金戈铁马","金戈铁骑"],"usage":"作谓语、宾语、定语；用于描写战争"},{"id":45150,"word":"铁骨铮铮","pinyin":"tiě gǔ zhēng zhēng","abbr":"tgzz","explanation":"指人有骨气，刚正坚贞。","example":{"text":"方志敏烈士～的英雄气概值得我们学习。"},"similar":["铮铮铁骨"],"usage":"作谓语、定语；指有正义感"},{"id":45151,"word":"铄古切今","pinyin":"shuò gǔ qiē jīn","abbr":"sgqj","explanation":"犹言融贯古今。形容学识渊博。","source":{"text":"孙幼如起都，少而称诗，长而经义，雅丽宏肆，铄古切今，极才人之致。","book":"明·顾起元《客座赘语·文士》"},"usage":"作谓语、定语；用于书面语"},{"id":45152,"word":"铄懿渊积","pinyin":"shuò yì yuān jī","abbr":"syyj","explanation":"指德行美好，学问渊博精深。","source":{"text":"然其铄懿渊积，庇于后来者远矣。","book":"明·张居正《素庵戴公墓志铭》"},"usage":"作宾语、定语；用于书面语"},{"id":45153,"word":"铄石流金","pinyin":"shuò shí liú jīn","abbr":"sslj","explanation":"铄、流：熔化。石头被熔化，金属变成了水。形容天气很热。","source":{"text":"大热铄石流金，火弗为益其烈。","book":"战国·楚·宋玉《招魂》：“十日代出，流金铄石些。”《淮南子·铨言训》"},"example":{"text":"正是六月前后，炎炎火日当天，～之际，只得赶早凉而行。","book":"明·施耐庵《水浒全传》第二十七回"},"similar":["烁石流金"],"usage":"作谓语、定语；形容天气酷热"},{"id":45154,"word":"铄金毁骨","pinyin":"shuò jīn huǐ gǔ","abbr":"sjhg","explanation":"比喻毁谤太多，使人无以自存。","source":{"text":"众口铄金，积毁销骨。","book":"西汉·司马迁《史记·张仪列传》"},"example":{"text":"今仕涂颠陨于～之日。","book":"明·归有光《上王都御史书》"},"similar":["积毁销骨"],"usage":"作谓语；指谣言"},{"id":45155,"word":"铄金点玉","pinyin":"shuò jīn diǎn yù","abbr":"sjdy","explanation":"熔化金属，玷污美玉。比喻毁谤为害之烈。","source":{"text":"皆自伤清直芬馥，而遭铄金点玉之谤。","book":"唐·吴兢《乐府古题要解》上卷"},"usage":"作谓语、定语；用于比喻句"},{"id":45156,"word":"铅刀一割","pinyin":"qiān dāo yī gē","abbr":"qdyg","explanation":"铅刀虽不锋利，偶尔用得得当，也能割断东西。比喻才能平常的人有时也能有点用处。多作请求任用的谦词。","source":{"text":"况臣奉大汉之威，而无铅刀一割之用呼？","book":"南朝·宋·范晔《后汉书·班超传》"},"example":{"text":"幸而时济，庶几比于～。","book":"章炳麟《革命道德说》"},"usage":"作宾语、定语；作请求任用的谦词"},{"id":45157,"word":"铅刀为铦","pinyin":"qiān dāo wéi xiān","abbr":"qdwx","explanation":"铦：锋利。把铅制的刀看作十分锋利。比喻没有眼光，把庸人当人才。","source":{"text":"莫邪为钝兮，铅刀为铦。","book":"《汉书·贾谊传》"}},{"id":45158,"word":"铅刀驽马","pinyin":"qiān dāo nú mǎ","abbr":"qdnm","explanation":"铅刀：铅质的刀。蹩脚的马，不快的刀。比喻才力卑微。","source":{"text":"昔文王三分，犹服事殷。但驽马铅刀，不可强扶。","book":"《后汉书·隗嚣传》"}},{"id":45159,"word":"铎以声自悔","pinyin":"duó yǐ shēng zì huǐ","abbr":"dyszh","explanation":"铎：大铃。比喻因自己的才能或特长而招来祸患。","source":{"text":"铎以声自毁，膏烛以明自铄。","book":"《淮南子·缪称训》"}},{"id":45160,"word":"铜唇铁舌","pinyin":"tóng chún tiě shé","abbr":"tcts","explanation":"比喻雄辩的口才。","source":{"text":"不得贤弟自来力救，便有铜唇铁舌，也和他分辩不得。","book":"明·施耐庵《水浒传》第33回"},"similar":["伶牙俐齿"],"opposite":["笨嘴拙舌"],"usage":"作宾语、定语；用于比喻句"},{"id":45161,"word":"铜围铁马","pinyin":"tóng wéi tiě mǎ","abbr":"twtm","explanation":"比喻坚固的阵势。","source":{"text":"奔突飘忽于铜围铁马之中，为意大利国民一天然之陆军学校。","book":"梁启超《意大利建国三杰传》"},"usage":"作宾语、定语；用于比喻句"},{"id":45162,"word":"铜城铁壁","pinyin":"tóng chéng tiě bì","abbr":"tctb","explanation":"原比喻防御十分坚固，不可摧毁。也比喻团结一致。同“铜墙铁壁”。","source":{"text":"民间之作寨堡者，亦饬令仿效为之，处之铜城铁壁矣。","book":"清·严如熤《三省边防备览·策略》"},"similar":["铜墙铁壁","铜壁铁墙"],"usage":"作主语、宾语；指十分坚固"},{"id":45163,"word":"铜墙铁壁","pinyin":"tóng qiáng tiě bì","abbr":"tqtb","explanation":"原比喻防御十分坚固，不可摧毁。也比喻团结一致。","source":{"text":"随他铜墙铁壁，也不怕不拆倒了他的。","book":"元·无名氏《谢金梧》楔子"},"example":{"text":"宋江自引了前部人马，转过独龙岗后面来看祝家庄时，后面都是～，把得严整。","book":"明·施耐庵《水浒全传》第四十八回"},"similar":["森严壁垒","牢不可破","固若金汤"],"opposite":["不堪一击","无坚不摧","一触即溃"],"usage":"作主语、宾语；指十分坚固"},{"id":45164,"word":"铜壁铁墙","pinyin":"tóng bì tiě qiáng","abbr":"tbtq","explanation":"像铜铁筑成的墙壁一样。原比喻防御十分坚固，不可摧毁。也比喻团结一致。","source":{"text":"至于入室投机，则如铜崖铁壁，不可攀登。","book":"宋·宋惠洪《石门文字禅·云庵真净和尚行状》"},"similar":["铜墙铁壁"],"usage":"作主语、宾语；指十分坚固"},{"id":45165,"word":"铜壶刻漏","pinyin":"tóng hú kè lòu","abbr":"thkl","explanation":"铜壶：古代计时的漏器；刻漏：一种古代计时器。用铜壶盛水滴漏来计时刻。指时光正在流逝。","source":{"text":"铜壶漏断梦初觉，宝马尘高人未知。","book":"唐·温庭筠《鸡鸣埭歌》"},"similar":["铜壶滴漏","铜壶漏断"],"usage":"作宾语、定语；指时光流逝"},{"id":45166,"word":"铜壶滴漏","pinyin":"tóng hú dī lòu","abbr":"thdl","explanation":"铜壶：古代计时的漏器。用铜壶盛水滴漏来计时刻。","source":{"text":"铜壶漏断梦初觉，宝马尘高人未知。","book":"唐·温庭筠《鸡鸣埭歌》"},"example":{"text":"静听得～，夜月微残。","book":"《白雪遗音·马头调·好梦儿》"},"similar":["铜壶刻漏"],"usage":"作宾语、定语；指时光流逝"},{"id":45167,"word":"铜壶漏断","pinyin":"tóng hú lòu duàn","abbr":"thld","explanation":"漏壶里的水滴完了。表示一天的时间已经过完，夜已深了。","source":{"text":"铜壶漏断梦初觉，宝马尘高人未知。","book":"唐·温庭筠《鸡鸣埭歌》"},"similar":["铜壶刻漏","铜壶滴漏"],"usage":"作宾语、定语；指时光流逝"},{"id":45168,"word":"铜头铁臂","pinyin":"tóng tóu tiě bì","abbr":"tttb","explanation":"形容人勇猛强悍。同“铜头铁额”。","source":{"text":"住在这里每个人都有被炸死的机会，没有谁能做一个铜头铁臂的人。","book":"巴金《旅途通讯·广州在轰炸中》"},"similar":["铜头铁额"],"usage":"作宾语、定语；指人勇猛强悍"},{"id":45169,"word":"铜头铁额","pinyin":"tóng tóu tiě é","abbr":"ttte","explanation":"铜铸的头，铁打的额。形容人勇猛强悍。","source":{"text":"兄弟八十人，铜头铁额。","book":"《太平御览》卷七十九引《龙鱼河图》：“蚩尤兄弟八十一人，并兽身人语，铜头铁额。”《云笈七签》卷一百"},"example":{"text":"问：“如何是出家人？”师曰：“～，乌觜鹿身。”","book":"宋·释普济《五灯会元》卷四"},"similar":["铜头铁臂"],"usage":"作谓语、定语；指人勇猛强悍","story":["远古时期，中华大地上生活黄帝部落、炎帝部落及蚩尤部落。黄帝部落打败西北的炎帝部落，实现了两大部落的统一，炎帝要求黄帝攻打九黎部族。九黎部族首领蚩尤兄弟81人，个个都是人头兽身，铜头铁额。天神派玄女授给黄帝兵书神符，制服了蚩尤"]},{"id":45170,"word":"铜山西崩，洛钟东应","pinyin":"tóng shān xī bēnɡ，luò zhōng dōng yìng","abbr":"tsxblzdy","explanation":"比喻重大事件彼此相互影响。","source":{"text":"铜山西崩，灵钟应应。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"此义易明，～，不以远而阴也。","book":"清·纪昀《阅微草堂笔记》卷十三"},"similar":["山崩钟应"],"usage":"作宾语、分句；比喻同类事物互相感应","story":["西汉时期，皇宫未央宫前殿钟无故自鸣，三天三夜不停止。汉武帝召问王朔，王朔说可能有兵争。武帝不信就问东方朔。东方朔说铜是山的儿子，山是铜之母，钟响就是山崩的感应。三天后，南郡太守上书说山崩了二十多里"]},{"id":45171,"word":"铜山金穴","pinyin":"tóng shān jīn xué","abbr":"tsjx","explanation":"比喻极其富有。","source":{"text":"少甚獐头鼠目，拥着铜山金穴，驷马高车？","book":"清·蒋士铨《临川梦·访梦》"},"usage":"作宾语、定语；用于比喻句"},{"id":45172,"word":"铜山铁壁","pinyin":"tóng shān tiě bì","abbr":"tstb","explanation":"形容坚固的防御物。比喻可信赖的坚强人物。","source":{"text":"赵汝腾尝荐八士，各有品目，于伯玉曰：‘铜山铁壁。’立朝风节，大较似之。","book":"《宋史·李伯玉传》"},"example":{"text":"则教你心如铁石也怕恐，便有那～都没用。","book":"元·尚仲贤《柳毅传书》第二折"},"similar":["铜墙铁壁"],"usage":"作主语、宾语；指坚强后盾"},{"id":45173,"word":"铜心铁胆","pinyin":"tóng xīn tiě dǎn","abbr":"txtd","explanation":"形容人的意志坚定。","source":{"text":"秀才每自古眼睛馋，不似这里忒铜心铁胆。","book":"明·贾仲名《萧淑兰》第二折"},"usage":"作宾语、定语；用于比喻句"},{"id":45174,"word":"铜打铁铸","pinyin":"tóng dǎ tiě zhù","abbr":"tdtz","explanation":"形容非常牢靠、稳固。","source":{"text":"不止于此，做官里头还有多少不乎处，进土官就是个铜打铁铸的，撤漫做去，投人敢说他下字。","book":"明·冯梦龙《警世通言》卷十八"},"example":{"text":"现在只要你把书念的好好儿的，让大爷乐了，你的终身大事那就是～的了。","book":"张恨水《啼笑姻缘》第七回"},"usage":"作定语；用于比喻句"},{"id":45175,"word":"铜浇铁铸","pinyin":"tóng jiāo tiě zhù","abbr":"tjtz","explanation":"形容体格非常强壮。","source":{"text":"二郎神忙使个定水诀向下一指，水合海冰，宛如铜浇铁铸一般。","book":"清·无垢道人《八仙全传》第七回"},"example":{"text":"王朔《人莫予毒》：“你岂不知我现在已如～，任何方向射来的矢石都不能裂穿我心灵的甲胄。”"},"similar":["铜铸铁浇"],"usage":"作定语；多用于比喻句"},{"id":45176,"word":"铜琶铁板","pinyin":"tóng pā tiě bǎn","abbr":"tptb","explanation":"铜琶、铁板：两种伴奏乐器。用铜琵琶、铁绰板伴唱。形容气慨豪迈，音调高亢的文辞。","source":{"text":"柳郎中词，只好十七八女孩儿执红牙拍板，唱‘杨柳岸晓风残月’；学士词，须关西大汉持铁板，唱‘大江东去’。","book":"宋·俞文豹《吹剑续录》"},"example":{"text":"～声声恨，剩馥残膏字字哀。","book":"清·吴趼人《二十年目睹之怪现状》第四十九回"},"similar":["铁板铜琶"],"usage":"作宾语、定语；形容气慨豪放激越的文辞","story":["北宋时期，苏轼带他随从外出郊游，他观赏山崖的金鸡菊，随从在一旁高唱苏轼的歌词。苏轼问他们自己与柳永的词有什么不同。随从说：柳郎中的词只可借17岁的女孩子执红牙拍板唱“杨柳外晓风残月”，您的歌词得请关西大汉持铁板唱“大江东去”"]},{"id":45177,"word":"铜盘重肉","pinyin":"tóng pán zhòng ròu","abbr":"tpzr","explanation":"贵重的食器，丰盛的饭菜。引申指特殊恩宠。","source":{"text":"汝辈但如遵彦谨慎，自得竹林别室，铜盘重肉之食。","book":"《北齐书·杨愔传》"},"example":{"text":"清·俞蛟《潮嘉风月记·佚事》：“此余家贤宅相，有北齐杨遵彦之风，真消受竹林别室，～者也。”"},"usage":"作宾语、定语；用于书面语","story":["北齐时期，杨愔，字遵彦，小时候特别懂得礼节，他家旁边有一个水果树，别的小孩争相去偷采水果，只有他不去。他的父亲向人夸奖他，同时在家庭院落中特修一间房子让他住，同时用铜盘装丰盛的食物给他，并告诫其他孩子要向他学习"]},{"id":45178,"word":"铜筋铁肋","pinyin":"tóng jīn tiě lèi","abbr":"tjtl","explanation":"比喻十分健壮的身体。也指能负重任的人。同“铜筋铁骨”。","source":{"text":"天生一具铜筋铁肋，不使立勋万里外，乃槁死三尺蒿下，命也，亦时也。","book":"明·宋濂《秦士录》"},"similar":["铜筋铁骨"],"usage":"作宾语、定语；指人的身体健壮"},{"id":45179,"word":"铜筋铁骨","pinyin":"tóng jīn tiě gǔ","abbr":"tjtg","explanation":"如铜一样的筋，如铁一样的骨。比喻十分健壮的身体。也指能负重任的人。","source":{"text":"我盗了太上老君炼就金丹，九转炼得铜筋铁骨，火眼金睛。","book":"元·杨暹《西游记》第二本第九出"},"example":{"text":"他本来是一副～，黑皮肤衬着那一套大布之衣，看去象个乡下人。","book":"朱自清《哀互生》"},"similar":["铜筋铁肋"],"opposite":["弱不禁风"],"usage":"作宾语、定语；指人的身体健壮"},{"id":45180,"word":"铜臭满身","pinyin":"tóng chòu mǎn shēn","abbr":"txms","explanation":"浑身散发着铜钱的臭气。常用以讥讽有钱的或是唯利是图的人。","source":{"text":"论者嫌其铜臭。","book":"《后汉书·崔寔传》"}},{"id":45181,"word":"铜臭熏天","pinyin":"tóng chòu xūn tiān","abbr":"tcxt","explanation":"铜臭：铜钱的气味。充满难闻的铜钱气味。常用以讥刺有钱人品行丑恶。也指贿赂公行，败坏风气。"},{"id":45182,"word":"铜臭薰天","pinyin":"tóng chòu xūn tiān","abbr":"txxt","explanation":"铜臭：铜钱的气味。充满铜钱的臭味。常用以讥讽有钱人品行不端。也指贿赂公行，败坏风气。","source":{"text":"论者嫌其铜臭。","book":"《后汉书·崔寔传》"},"example":{"text":"几把一座北京城闹得～，令人不可向迩。","book":"丁中江《北洋军阀史话》二○七"},"usage":"作定语、状语；用于比喻句"},{"id":45183,"word":"铜铸铁浇","pinyin":"tóng zhù tiě jiāo","abbr":"tztj","explanation":"形容体格非常强壮。同“铜浇铁铸”。","source":{"text":"大炮师傅，我们年轻人是铜铸铁浇的，这点辛苦算得什么！","book":"张英《老年突击队》"},"similar":["铜浇铁铸"],"usage":"作定语；多用于比喻句"},{"id":45184,"word":"铜驼荆棘","pinyin":"tóng tuó jīng jí","abbr":"ttjj","explanation":"铜驼：铜制的骆驼，古代置于宫门外。形容国土沦陷后残破的景象。","source":{"text":"靖有先识远量，知天下将乱，指洛阳宫门铜驼，叹曰：‘会见汝在荆棘中耳？’","book":"《晋书·索靖传》"},"example":{"text":"陛下试念两都黍离麦袖之悲，则居处必不安，试念孝陵、长陵～之惨，则对越必不安。","book":"《清史稿·庄元辰传》"},"similar":["铜驼草莽"],"usage":"作定语、分句；指国破","story":["西晋时期，索靖长期钻研经史，学识丰富，被封为驸马都尉。晋武帝时被提拔为尚书郎、酒泉太守。晋惠帝被封为关内侯。他有远见卓识，预料时局不稳，天下将发生动乱，看到洛阳宫门旁的铜驼感慨地说：“铜驼，以后你将倒卧在荆棘丛中。”"]},{"id":45185,"word":"铜驼草莽","pinyin":"tóng tuó cǎo mǎng","abbr":"ttcm","explanation":"形容国土沦陷后残破的景象。同“铜驼荆棘”。","source":{"text":"顾不得宗社丘墟，铜驼草莽。","book":"明·汪廷讷《种玉记·促晤》"},"similar":["铜驼荆棘"],"usage":"作定语、分句；指国破"},{"id":45186,"word":"铢两之奸","pinyin":"zhū liǎng zhī jiān","abbr":"zlzj","explanation":"铢两：积轻微；奸：邪恶。极其轻微的邪恶罪行。","source":{"text":"郡中盗贼，闾里轻侠，其根株窟穴所在，及吏受取请求铢两之奸，皆知之。","book":"《汉书·赵广汉传》"},"example":{"text":"尤善为鉤距以得事情，闾里～皆知之。（《资治通鉴·汉纪·孝昭本始三年》）"},"usage":"作宾语；用于书面语"},{"id":45187,"word":"铢两分寸","pinyin":"zhū liǎng fēn cùn","abbr":"zlfc","explanation":"指极少的数量。","source":{"text":"不使有铢两分寸之加焉。","book":"宋·王安石《上仁宗皇帝言事书》"},"usage":"作主语、宾语、定语；指少数"},{"id":45188,"word":"铢两悉称","pinyin":"zhū liǎng xī chèn","abbr":"zlxc","explanation":"悉：都；称：相当。形容两者轻重相当，丝毫不差。","source":{"text":"梁同考坐吏书之左，去官三百余员，铢两悉称，士林服之，此皆破格之异命也。","book":"明·周晖《金陵琐事·尚书异命》"},"example":{"text":"倘要保存上文，则将末两句改为“警察队空枪亦一齐发声，乡民始后退”，这才～，和军警都毫无关系。","book":"鲁迅《伪自由书·不通两种"},"similar":["半斤八两","不相上下","平起平坐"],"opposite":["判若云泥","天差地别","天渊之别"],"usage":"作谓语、定语；指半斤八两"},{"id":45189,"word":"铢两相称","pinyin":"zhū liǎng xiāng chèn","abbr":"zlxc","explanation":"形容两者轻重相当或优劣相等。","source":{"text":"茅盾《大题小解》：“于是指出何者为适如其分，铢两相称，何者被强调了非特殊点而忽略了特殊点，何者甚至被拉扯为‘四不像’。“"},"example":{"text":"段、王虽同捧杨翠喜，却并不争风吃醋，这是因为杨翠喜受了养母的教，手腕颇为高明，对两人都是不即不离，若拒若迎，而又～。","book":"高阳《慈禧全传》第六部九七"},"similar":["铢两悉称"],"usage":"作谓语、定语；用于书面语"},{"id":45190,"word":"铢分毫析","pinyin":"zhū fēn háo xī","abbr":"zfhx","explanation":"指细微地分析。","source":{"text":"学问须严密理会，铢分毫析。","book":"宋·朱熹《朱子语类》卷八"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":45191,"word":"铢寸累积","pinyin":"zhū cùn lèi jī","abbr":"zclj","explanation":"犹言一点一滴地积累。常形容事物完成之不易。同“铢积寸累”。","source":{"text":"翁削衣缩食，铢寸累积，以谋复故第。","book":"清·汪琬《乡饮大宾周翁墓志铭》"},"similar":["铢积寸累","铢积丝累","铢积锱累"],"usage":"作谓语、宾语；指积少成多"},{"id":45192,"word":"铢施两较","pinyin":"zhū shī liǎng jiào","abbr":"zslj","explanation":"指一铢一两都斤斤计较。形容非常吝啬。","source":{"text":"其赋于人也，铢施两较，不肯多与。","book":"明·方孝孺《答许廷植书》"},"usage":"作宾语、定语；用于书面语"},{"id":45193,"word":"铢积丝累","pinyin":"zhū jī sī lèi","abbr":"zjsl","explanation":"犹言一点一滴地积累。常形容事物完成之不易。同“铢积寸累”。","source":{"text":"当时漕司不量州军之力，一例均科，既有偏重之弊，于是郡县横敛，铢积丝累，江东、西之害尤甚。","book":"元·脱脱《宋史》卷一百七十九"},"example":{"text":"是下邑穷乡～以豪于闾井者之情，而奚足为俭哉？","book":"清·王夫之《读通鉴论·隋文帝十五》"},"similar":["铢积寸累","铢积锱累","铢累寸积"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":45194,"word":"铢积寸累","pinyin":"zhū jī cùn lěi","abbr":"zjcl","explanation":"铢：我国古代极小的重量单位，汉代以一百黍的重量为一铢。形容一点一滴地积累。也形容事物完成的不容易。","source":{"text":"此织生自蚕茧，成于机杼，一丝而累，以至于寸，累寸不已，遂成丈匹。","book":"《后汉书·列女传》"},"example":{"text":"寒女之丝，～。步武所临，云生雷起。","book":"宋·赵德麟《侯鲭录》卷四"},"similar":["积少成多","集腋成裘","日积月累"],"opposite":["一蹴而就"],"usage":"作谓语、宾语；指积少成多"},{"id":45195,"word":"铢积锱累","pinyin":"zhū jī zī lèi","abbr":"zjzl","explanation":"犹言一点一滴地积累。常形容事物完成之不易。同“铢积寸累”。","source":{"text":"老儒故善治生……铢积锱累，得四十金。","book":"清·纪昀《阅微草堂笔记·如是我闻四》"},"similar":["铢积丝累","铢累寸积","铢积寸累"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":45196,"word":"铢称寸量","pinyin":"zhū chēng cùn liáng","abbr":"zccl","explanation":"形容极精细地衡量、推究。","source":{"text":"以尹之所乐者，尧舜之道也，而袛铢称寸量于一介取予之间。若硁硁小人然者，何也？","book":"明·唐顺之《与王龙溪郎中书》"},"similar":["铢量寸度"],"usage":"作宾语、定语；用于书面语"},{"id":45197,"word":"铢累寸积","pinyin":"zhū lèi cùn jī","abbr":"zlcj","explanation":"犹言一点一滴地积累。常形容事物完成之不易。","source":{"text":"扬某自十四五岁时，便觉得这物事是好底物事，心便爱了。某不敢自昧，实以铢累寸积而得之。","book":"宋·朱 熹《朱子语类·朱子一 》"},"example":{"text":"货财非经天降，皆世祖～而致之。 ◎清·毕沅《续资治通鉴·元武宗至大三年》"}},{"id":45198,"word":"铢量寸度","pinyin":"zhū liáng cùn duó","abbr":"zlcd","explanation":"形容极精细地衡量、推究。","source":{"text":"铢量寸度，石丈必差，操券责偿，曷以见天地之大哉。","book":"清·魏源《默觚上·学篇八》"},"similar":["铢称寸量"],"usage":"作宾语、定语；用于书面语"},{"id":45199,"word":"铢铢校量","pinyin":"zhū zhū xiào liàng","abbr":"zzxl","explanation":"铢铢：分量极轻。指斤斤计较。","source":{"text":"然荣辱得失之际，铢铢校量，而自矜其达，每诗不着此意，是岂能真忘之者哉！","book":"宋·胡仔《苕溪渔隐丛话前集·柳柳州》"},"similar":["铢铢较量","锱铢必较","锱铢较量"],"usage":"作宾语、定语；用于书面语"},{"id":45200,"word":"铢铢较量","pinyin":"zhū zhū jiào liàng","abbr":"zzjl","explanation":"指极精细地计较衡量。","source":{"text":"荀告韩杨，各是所见，铢铢较量，可谓愚甚。","book":"清·陈确《原教》"},"example":{"text":"内有一生员，姓张名直古，平日极不信因果，只说鬼神是有的，原无～善恶，一毫不爽的理。","book":"清·丁耀亢《续金瓶梅》第六十二回"},"similar":["铢铢校量","锱铢必较","锱铢较量"],"usage":"作宾语、定语；用于书面语"},{"id":45201,"word":"铤而走险","pinyin":"tǐng ér zǒu xiǎn","abbr":"tezx","explanation":"铤：急走的样子；走险：奔赴险处。指在无路可走的时候采取冒险行动。","source":{"text":"小国之事大国也，德则其人也，不德则其鹿也，铤而走险，急何能择？","book":"《左传·文公十七年》"},"example":{"text":"碰了荒年，也少不了这班人，不然，闹出那～的，更是不得了了。","book":"清·吴趼人《二十年目睹之怪现状》第十五回"},"similar":["见义勇为","孤注一掷"],"opposite":["畏缩不前"],"usage":"作谓语、定语、补语；指冒险","story":["春秋时期，晋灵公为扩大实力争当霸主，在扈地会合诸侯，他不愿与小国郑穆公见面，怀疑他对付自己。为缓和矛盾，郑国执政大夫子家给晋国执政大夫赵盾写信，信中表示愿意友好，国与国之间得以礼相待，而没必要造成双方铤而走险去打仗"]},{"id":45202,"word":"铤鹿走险","pinyin":"dìng lù zǒu xiǎn","abbr":"dlzx","explanation":"①指在无路可走的时候采取冒险行动。同“铤而走险”。②指因无路可走而采取冒险行动。","source":{"text":"诚恐川人骤见兵威，妄思自卫，铤鹿走险，风鹤皆惊。","book":"《辛亥革命·保路运动·四川铁路档案》"},"similar":["铤而走险"],"usage":"作谓语、定语；指冒险"},{"id":45203,"word":"铩羽暴鳞","pinyin":"shā yǔ bào lín","abbr":"sybl","explanation":"飞鸟羽毛脱落，养鱼之水已干涸。用以比喻不得志，处境极为困难。","source":{"text":"铩羽暴鳞，复见翻跃。","book":"南朝·宋·鲍照《侍郎上疏》"},"similar":["铩羽涸鳞"],"usage":"作宾语、定语；用于处事"},{"id":45204,"word":"铩羽涸鳞","pinyin":"shā yǔ hé lín","abbr":"syhl","explanation":"用以比喻不得志，处境极为困难。同“铩羽暴鳞”。","source":{"text":"铩羽涸鳞去安所，翾飞川咏几时同。","book":"明·杨慎《高泉临行再赋此以别》"},"similar":["铩羽暴鳞"],"usage":"作宾语、定语；用于处事"},{"id":45205,"word":"铩羽而归","pinyin":"shā yǔ ér guī","abbr":"syeg","explanation":"铩羽：羽毛摧落，比喻失败或不得志。指失败或不得志而归。","source":{"text":"铩羽暴鳞，复见翻跃。","book":"南朝宋·鲍照《拜侍郎上疏》"},"example":{"text":"这一批被斩了魔爪，“～”，另一批又破门出来。","book":"秦牧《手莫伸》"},"opposite":["兴高采烈"],"usage":"作谓语、状语；指不得志而回来"},{"id":45206,"word":"铩羽而逃","pinyin":"shā yǔ ér táo","abbr":"syet","explanation":"铩羽：羽毛摧落，比喻失败或不得志。指失败或不得志而逃跑。","source":{"text":"铩羽暴鳞，复见翻跃。","book":"南朝·宋·鲍照《拜侍郎上疏》"},"example":{"text":"各单位工作组哭爹喊娘，接受批斗，赔礼道歉，～。","book":"王蒙《狂欢的季节》二"}},{"id":45207,"word":"铭刻心骨","pinyin":"míng kè xīn gǔ","abbr":"mkxg","explanation":"比喻感念极深，永远不忘。","source":{"text":"深荷王公之德，铭刻心骨。","book":"唐·李白《上安州李长史书》"},"similar":["刻骨铭心","铭心镂骨","铭心刻骨"],"usage":"作谓语、定语、状语；多用于对别人的感激"},{"id":45208,"word":"铭心刻骨","pinyin":"míng xīn kè gǔ","abbr":"mxkg","explanation":"刻写在心上骨上，形容记忆深刻，难以忘记。","source":{"text":"深荷王公之德，铭刻心骨。","book":"唐·李白《上安州李长史书》"},"example":{"text":"恩同海岳，～难忘。","book":"明·李开先《林冲宝剑记》"},"similar":["没齿不忘","铭心镂骨"],"opposite":["无动于衷"],"usage":"作谓语、定语、状语；指印象深刻"},{"id":45209,"word":"铭心镂骨","pinyin":"míng xīn lòu gǔ","abbr":"mxlg","explanation":"形容感受极深，永记不忘。","source":{"text":"追思平昔之指，铭肌镂骨。","book":"北齐·颜之推《颜氏家训·序致》"},"example":{"text":"～，无报上天。","book":"唐·柳宗元《谢除柳州刺史表》"},"similar":["刻骨铭心","铭心刻骨"],"opposite":["无动于衷"],"usage":"作谓语、定语、状语；形容印象深刻"},{"id":45210,"word":"铭感不忘","pinyin":"míng gǎn bù wàng","abbr":"mgbw","explanation":"铭：在器物上刻字，比喻永记心上。深刻地记在心上，感激不忘。","source":{"text":"明·罗贯中《三国演义》第七十五回向蒙相救，铭感不忘。今某已遇祸而死，愿求清诲，指点迷途。"},"example":{"text":"得蒙仗义释放，已是～，厚贶断不敢受。","book":"清·吴趼人《痛史》第七回"},"similar":["铭记在心"],"usage":"作谓语、定语；指永远记在心上"},{"id":45211,"word":"铭感五内","pinyin":"míng gǎn wǔ nèi","abbr":"mgwn","explanation":"比喻内心非常感激。","source":{"text":"这是万岁的龙恩，臣等铭感五内。","book":"明·罗贯中《粉妆楼》第八十回"},"example":{"text":"这位工人虽然也绷着脸，一言不发，但是对我们一句训斥的话都没有说过，我心里实在是～。","book":"季羡林《牛棚杂忆》第十四节"}},{"id":45212,"word":"铭肌镂骨","pinyin":"míng jī lòu gǔ","abbr":"mjlg","explanation":"形容感受极深，永记不忘。","source":{"text":"追思平昔之指，铭肌镂骨。","book":"北齐·颜之推《颜氏家训·序致》"},"similar":["铭心镂骨"],"usage":"作谓语、定语；形容感受极深"},{"id":45213,"word":"铭肤镂骨","pinyin":"míng fū lòu gǔ","abbr":"mflg","explanation":"形容感受极深，永记不忘。同“铭心镂骨”。","source":{"text":"铭肤镂骨，不敢殒坠。","book":"唐·令狐楚《代李仆射谢男赐绯鱼袋表》"},"similar":["铭心镂骨","铭肌镂骨"],"usage":"作谓语、定语、状语；形容印象深刻"},{"id":45214,"word":"铭记不忘","pinyin":"míng jì bù wàng","abbr":"mjbw","explanation":"比喻牢记在心，永远不忘。","example":{"text":"我相信，他将庆幸自己的生活里出现过那么一个女孩儿，他将对我终生～！”","book":"梁晓声《表弟》八"},"similar":["牢记不忘"],"usage":"作谓语、定语；用于处事"},{"id":45215,"word":"铭诸五内","pinyin":"míng zhū wǔ nèi","abbr":"mzwn","explanation":"五内：五脏，指内心。深深刻在内心深处，永远不会忘记。","source":{"text":"置之座隅，用比韦弦之益；铭诸心腑，何啻药石之功。","book":"《旧唐书·李德裕传》"},"example":{"text":"吴先生，你的情谊，我是～了。","book":"李劼人《暴风雨前》"}},{"id":45216,"word":"铭诸心腑","pinyin":"míng zhū xīn fǔ","abbr":"mzxf","explanation":"心腑：指内心。牢牢铭记在心里。比喻永记不忘。","source":{"text":"置之座隅，用比韦弦之益；铭诸心腑，何啻药石之功。","book":"《旧唐书·李德裕传》"}},{"id":45217,"word":"铭诸肺腑","pinyin":"míng zhū fèi fǔ","abbr":"mzff","explanation":"比喻永记不忘。","source":{"text":"敢不置之枕席，铭诸肺腑，终老是戒。","book":"《旧唐书·李德裕传》：“置之座隅，用比韦弦之益；铭诸心腑，何啻药石之功。”宋·王偁《东都事略·富弼传》"},"example":{"text":"更～的是，我还在团防区内的竹岔岛上，目送过两千头海豚闹大海的磅礴和壮美。","book":"李存葆《鲸殇》二"},"similar":["铭记不忘","刻骨铭心"],"usage":"作谓语、定语；用于比喻句"},{"id":45218,"word":"铮铮不屈","pinyin":"zhēng zhēng bù qū","abbr":"zzbq","explanation":"铮铮：金属器皿相碰的声音。比喻性格刚强的人。","source":{"text":"卿所谓铁中铮铮，佣中佼佼者也。","book":"《后汉书·刘盆子传》"},"example":{"text":"那四个俱是铁汉，～，俱死了。（清·钱彩《说岳全传》第五十四回）"},"usage":"作谓语、定语、状语；用于处事"},{"id":45219,"word":"铮铮佼佼","pinyin":"zhēng zhēng jiǎo jiǎo","abbr":"zzjj","explanation":"形容出类拔萃，不同一般。","source":{"text":"卿所谓铁中铮铮，佣中佼佼者也。","book":"南朝·宋·范晔《后汉书·刘盆子传》"},"example":{"text":"他在留学界中当然是～的一流。","book":"郭沫若《我的童年》第三篇"},"similar":["出类拔萃"],"usage":"作谓语、定语；指人才"},{"id":45220,"word":"铮铮有声","pinyin":"zhēng zhēng yǒu shēng","abbr":"zzys","explanation":"铮铮：金属相击声。比喻为人正直，名声很好。","source":{"text":"他也是敝世兄，在复社中铮铮有声，岂肯为此？","book":"清·孔尚任《桃花扇》第十二出"},"example":{"text":"清·孔尚任《桃花扇·辞院》：“他也是敝世兄，在复社中～，岂肯为此？”"},"similar":["铁骨铮铮"],"usage":"作谓语、定语；指人的性格"},{"id":45221,"word":"铮铮铁汉","pinyin":"zhēng zhēng tiě hàn","abbr":"zzth","explanation":"指刚正不阿、坚强不屈的人。","source":{"text":"别看吴锋当初烧人家谷仓的时候是一条死都不怕的铮铮铁汉，可有的时候他简直像个小孩子——哪有热闹往哪钻。","book":"孙开泰 孙东《吴起传》第九回"}},{"id":45222,"word":"铮铮铁骨","pinyin":"zhēng zhēng tiě gǔ","abbr":"zztg","explanation":"比喻人的刚正不阿，坚强不屈的骨气。","source":{"text":"狂风暴雨刮走的只是枯枝败叶，留下的却是铮铮铁骨。","book":"柯岩《奇异的书简·美的追求者》"},"example":{"text":"铁窗生活并没有销磨他的～。","book":"袁鹰《悲欢·不灭的诗魂》"},"similar":["铮铮铁汉"],"usage":"作宾语、定语；用于比喻句"},{"id":45223,"word":"铲恶锄奸","pinyin":"chǎn è chú jiān","abbr":"cecj","explanation":"铲：消灭。铲除凶恶奸邪的人。","source":{"text":"他杀人污佛地，我救苦下云端，铲恶锄奸。","book":"清·文康《儿女英雄传》第十回"},"similar":["剗恶锄奸"],"opposite":["姑息养奸"],"usage":"作谓语、宾语；用于为民除害"},{"id":45224,"word":"铲旧谋新","pinyin":"chǎn jiù móu xīn","abbr":"cjmx","explanation":"铲：铲除；谋：营求。革除旧的追求新的。","source":{"text":"志欲铲旧谋新，振兴时治，其气锐不可折。","book":"宋·田况《儒林公议》上卷"},"similar":["除旧布新"],"usage":"作谓语、宾语；同“除旧布新”"},{"id":45225,"word":"铲草除根","pinyin":"chǎn cǎo chú gēn","abbr":"cccg","explanation":"铲：消灭；除：去掉。除草时要连根除掉。比喻除去祸根，不留后患。","source":{"text":"为国家者，见恶，如农夫之务去草焉……绝其本根，勿使能殖。","book":"春秋·鲁·左丘明《左传·隐公六年》"},"example":{"text":"自古道杀人见血，～。","book":"明·沈鲸《双珠记·协谋诬讼》"},"similar":["斩草除根"],"opposite":["留有余地"],"usage":"作谓语、宾语；指彻底成事"},{"id":45226,"word":"铲迹销声","pinyin":"chǎn jì xiāo shēng","abbr":"cjxs","explanation":"铲：消除；销：消失。指隐藏起来，不公开露面。","source":{"text":"若仲宁之清贞守道，抗志柴门；行齐之居室屡空，栖心陋巷；文博之漱流枕石，铲迹销声；宣子之乐道安贫，弘风阐教；斯并通儒之高尚者也。","book":"《晋书·儒林传论》"},"similar":["销声匿迹"],"opposite":["抛头露面"],"usage":"作谓语、宾语；用于人或事物"},{"id":45227,"word":"银屏金屋","pinyin":"yín píng jīn wū","abbr":"ypjw","explanation":"形容极其华丽的住宅和陈设。借指富家大族。","source":{"text":"须信银屏金屋里，一例，琪花不称槛前栽。","book":"清·龚自珍《定风波》词"},"example":{"text":"清·陶贞怀《天雨花》第21回：“若照这样来看起，怎做～人。”"},"usage":"作宾语、定语；用于书面语"},{"id":45228,"word":"银山铁壁","pinyin":"yín shān tiě bì","abbr":"ystb","explanation":"比喻十分坚固，不可摧毁的事物。","source":{"text":"元城在南都，似个银山铁壁。","book":"宋·朱熹《朱子语类》第130卷"},"example":{"text":"元·无名氏《小尉迟》第一折：“俺这里七重围子，手摆布的～相似。”"},"similar":["铜墙铁壁"],"usage":"作宾语、定语；用于比喻句"},{"id":45229,"word":"银杯羽化","pinyin":"yín bēi yǔ huà","abbr":"ybyh","explanation":"指银质的酒杯像羽毛一样飘上天空。比喻贵重器物被窃，不翼而飞。","source":{"text":"别贮酒器杯盂一笥，缄滕如故，其器皆亡。讯海鸥，乃曰：‘不测其亡。’公权哂曰：‘银杯羽化耳？’","book":"《旧唐书·柳公权传》"}},{"id":45230,"word":"银样蜡枪头","pinyin":"yín yàng là qiāng tóu","abbr":"yylqt","explanation":"样子像银子实际是焊锡做的枪头。比喻外表很好看，实际上不中用。","source":{"text":"反对那种强不知以为知，专业知识贫乏而自封专家、权威的银样蜡枪头。","book":"吴晗《神仙会和百家争鸣》"},"example":{"text":"吴晗《神仙会和百家争鸣》：“反对那种强不知以为知，专业知识贫乏而自封专家、权威的～。”"},"similar":["银样镴枪头"],"usage":"作宾语；指好看不中用"},{"id":45231,"word":"银样镴枪头","pinyin":"yín yàng là qiāng tóu","abbr":"yylqt","explanation":"镴：焊锡，样子很像银子。样子象银子实际是焊锡做的枪头。比喻外表很好看，实际上不中用。","source":{"text":"你原来‘苗而不秀’，呸，一个银样镴枪头。","book":"元·王实甫《西厢记》第四本第二折"},"example":{"text":"一般唬的这么个样儿，还只管胡说。——呸，原来也是个～。","book":"清·曹雪芹《红楼梦》第二十三回"},"similar":["银样蜡枪头"],"usage":"作宾语；指好看不中用"},{"id":45232,"word":"银样閖枪头","pinyin":"yín yàng là qiāng tóu","abbr":"yylqt","explanation":"样子象银子实际是焊锡做的枪头。比喻外表很好看，实际上不中用。","source":{"text":"第四本第二折你原来‘苗而不秀’，呸，一个银样閖枪头。","book":"元·王实甫《西厢记》"}},{"id":45233,"word":"银河倒泻","pinyin":"yín hé dào xiè","abbr":"yhdx","explanation":"泻：水从高处往下直流。象银河里的水倒泻下来。形容雨下得极大，象泻下来的一样。","source":{"text":"金阙前开二峰长，银河倒挂三石梁。","book":"唐·李白《庐山谣寄卢侍御虚舟》"},"example":{"text":"果然是～，沧海盆倾，好阵大雨！","book":"明·冯梦龙《警世通言》卷十四"},"usage":"作宾语、定语；指瀑布"},{"id":45234,"word":"银海生花","pinyin":"yín hǎi shēng huā","abbr":"yhsh","explanation":"银海：道家指眼睛。眼睛因接触到反射的光线而昏花。比喻眼睛看得迷乱。","source":{"text":"冻合玉楼寒起粟，光摇银海眩生花。","book":"宋·苏轼《雪后书北台壁》诗"},"example":{"text":"方幼恽坐在车中，那头就如泼浪鼓一般，不住的东西摇晃，真是目迷五色，～。","book":"清·张春帆《九尾龟》第五回"}},{"id":45235,"word":"银瓶素绠","pinyin":"yín píng sù gěng","abbr":"ypsg","explanation":"银瓶：汲水器；素绠：汲水用的桶绳。指从井下汲水的器具。","source":{"text":"寒泉未必能如此，奈有银瓶素绠何？","book":"唐·陆龟蒙《野井》"},"example":{"text":"碎霞浮动晓朦胧，春意与花浓。～，玉泉金甃，真色浸朝气红。","book":"宋·张先《少年游·井桃》词"},"similar":["素绠银瓶"],"usage":"作主语、宾语；用于书面语"},{"id":45236,"word":"银花火树","pinyin":"yín huā huǒ shù","abbr":"yhhs","explanation":"比喻灿烂的焰火或灯火。","source":{"text":"到了黄昏时候，城中银花火树，一色通明。","book":"清·魏秀仁《花月痕》第四回"},"example":{"text":"清·魏秀仁《花月痕》第四回：“到了黄昏时候，城中～，一色通明。”"},"similar":["火树银花"],"usage":"作主语、宾语、定语；形容节日晚上的灯火"},{"id":45237,"word":"银装素裹","pinyin":"yín zhuānɡ sù ɡuǒ","abbr":"yzsg","explanation":"雪天户外的东西被白雪包起来像穿上了银白色的衣服。形容雪景的美丽。"},{"id":45238,"word":"银钩玉唾","pinyin":"yín gōu yù tuò","abbr":"ygyt","explanation":"比喻他人的书法笔画有如银钩，遒劲有力；言谈有如吐玉，弥足珍贵。","source":{"text":"银钩玉唾明茧纸，松箑轻凉并送似。","book":"宋·黄庭坚《次韵钱穆父赠松扇》诗"},"example":{"text":"谢人惠书云辱～。","book":"宋·胡继宗《书言故事·书翰类》"},"similar":["唾玉钩银"],"usage":"作宾语、定语；多用于比喻句"},{"id":45239,"word":"银钩虿尾","pinyin":"yín gōu chài wěi","abbr":"ygcw","explanation":"比喻书法的钩、挑等笔画遒劲有力，有如银钩和蝎尾。一说虿尾指指蝎子的尾巴，能揵然上卷，写“乙”、“丁”、“亭”等字之末趯，须驻锋而后趯出，故遒劲有力。","source":{"text":"（索靖）散骑常侍张芝姊之孙也，传芝草而形异，甚矜其书，名其字势曰‘银钩虿尾’。","book":"南朝·齐·王僧虔《论书》"},"example":{"text":"明·顾起元《客座赘语·文士》：“惟礼又善书法，颇有～之意。”"},"usage":"作宾语、定语；用于书面语"},{"id":45240,"word":"银钩铁画","pinyin":"yín gōu tiě huà","abbr":"ygth","explanation":"钩：钩勒；画：笔画。形容书法刚键柔美。","source":{"text":"徘徊俯仰，容与风流，刚则铁画，媚若银钩。","book":"唐·欧阳洵《用笔论》"},"example":{"text":"～石经余，想见先唐字学书。","book":"清·沈曾植《题北宋本广韵四绝》诗"},"similar":["铁画银钩"],"usage":"作谓语、定语、宾语；用于书法"},{"id":45241,"word":"铸剑为犁","pinyin":"zhù jiàn wéi lí","abbr":"zjwl","explanation":"销熔武器以制造务农器具。","source":{"text":"铸剑习以为农器，放牛马于原薮，室家无离旷之思，千岁无战斗之患。","book":"《孔子家语·致思》"},"usage":"作谓语、定语；指战争结束"},{"id":45242,"word":"铸山煮海","pinyin":"zhù shān zhǔ hǎi","abbr":"zszh","explanation":"开采山中铜矿以铸造钱币，烧煮海水而获得食盐。比喻善于开发自然资源。","source":{"text":"吴有豫章郡铜山，濞则招致天下亡命者盗铸钱，煮海水为盐。","book":"《史记·吴王濞列传》"},"example":{"text":"～、象犀珠玉之富，甲于天下。","book":"宋·苏轼《表忠观碑》"},"usage":"作谓语、宾语、定语；指资源开发"},{"id":45243,"word":"铸成大错","pinyin":"zhù chéng dà cuò","abbr":"zcdc","explanation":"铸：铸造，把金属熔化后倒入模具内制成器物；错：错误。指造成严重的错误。","source":{"text":"合六州四十三县铁，不能为此错也。","book":"《资治通鉴·唐纪·昭宗天佑三年》"},"example":{"text":"倘若我晚回一步，岂不～！","book":"姚雪垠《李自成》第一卷第十五章"},"similar":["阴差阳错"],"opposite":["痛改前非"],"usage":"作谓语；指造成严重的错误","story":["唐朝末年，魏博节度使罗绍威担心自己的卫队会反他，于是派亲信臧廷范去找亲家梁王朱温帮忙。朱温趁女儿办丧事之机，出兵把罗绍威的卫队消灭，进而占据魏州。罗绍威只好供应军饷。他引狼入室，铸成大错，后悔莫及"]},{"id":45244,"word":"铸新淘旧","pinyin":"zhù xīn táo jiù","abbr":"zxtj","explanation":"创造新的，汰除旧的。","source":{"text":"这都是先生在中国民族革命史上继往开来，铸新淘旧，把革命的基础，深植于本国工农民众，广结于世界革命民众的伟大功绩。","book":"李大钊《孙中山先生在中国民族革命史上之位置》"},"similar":["推陈出新"],"usage":"作宾语、定语；用于书面语"},{"id":45245,"word":"铸木镂冰","pinyin":"zhù mù lòu bīng","abbr":"zmlb","explanation":"指约束树木（使其按人为的形态生长），刻镂冰塊（使其成某种精致的工艺品）。比喻经办毫无成效的事情。","source":{"text":"卖浆贩麦，利辄失时，铸木镂冰，初无成日。","book":"宋·叶廷珪《海录碎事·人事中》"},"usage":"作宾语、定语；用于比喻句"},{"id":45246,"word":"铸此大错","pinyin":"zhù cǐ dà cuò","abbr":"zcdc","explanation":"铸：铸造，把金属熔化后倒入模具内制成器物；错：锉刀，这里是双关语，特指错误。指造成严重的错误。","source":{"text":"当时一快意，事过有余怍。不知几州铁，铸此一大错。","book":"宋·苏轼《赠钱道人》诗"},"example":{"text":"难道他当真将我错认为那姓任的前辈？此人甚是精细，怎会～？","book":"金庸《笑傲江湖》第二十一回"},"similar":["铸成大错"],"usage":"作谓语；指造成严重的错误"},{"id":45247,"word":"铸甲销戈","pinyin":"zhù jiǎ xiāo gē","abbr":"zjxg","explanation":"销熔铁甲兵器。借指结束战争，实现和平。","source":{"text":"修文偃武君王意，铸甲销戈会有期。","book":"明·刘基《丙申岁十月还乡作》诗之七"},"usage":"作宾语、定语；用于书面语"},{"id":45248,"word":"铸鼎象物","pinyin":"zhù dǐng xiàng wù","abbr":"zdxw","explanation":"鼎：古代炊具，三足两耳。原指禹收九州之金铸九鼎并铸上各种牲口的图像。旧时用此称颂君王有德。","source":{"text":"昔夏之方有德也，远方图物，贡金九牧，铸鼎象物，百物为之备，使民知神奸。","book":"《左传·宣公三年》"},"usage":"作宾语、定语；用于书面语"},{"id":45249,"word":"铺天盖地","pinyin":"pū tiān gài dì","abbr":"ptgd","explanation":"一下子到处都是。形容来势很猛。","source":{"text":"问：‘如何是和尚家风？’师曰：‘遮天盖地。’","book":"宋·释惟白《续传灯录·卷二·志仁禅师》"},"example":{"text":"它把大沙丘一下子卷上天空，然后又～地撒下来。","book":"杜鹏程《年青的朋友·瀚海新歌》"},"similar":["漫山遍野","遮天蔽日","排山倒海"],"opposite":["微不足道","蜻蜓点水"],"usage":"作谓语、定语、状语；形容来势很猛"},{"id":45250,"word":"铺张扬厉","pinyin":"pū zhāng yáng lì","abbr":"pzyl","explanation":"原指竭力铺陈渲染，力求发扬光大。后多形容过分讲究排场。","source":{"text":"作为歌诗，荐之郊庙，纪泰山之封，镂白玉之牒，铺张对天之闳休，扬厉无前之伟绩。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"你看他一到任时，便～的，要办这个，办那个，几时见有一件事成了功呢！","book":"清·吴趼人《二十年目睹之怪现状》第二十一回"},"similar":["铺张浪费"],"usage":"作谓语、定语；指过分夸张"},{"id":45251,"word":"铺张浪费","pinyin":"pū zhāng làng fèi","abbr":"pzlf","explanation":"铺张：讲究排场。为了场面好看而浪费人力物力。","source":{"text":"要勤俭建国，反对铺张浪费，提倡艰苦朴素，同甘共苦。","book":"毛泽东《在中国共产党第八届中央委员会第二次全体会议上讲话》"},"example":{"text":"我们要以朴素为荣，反对～的作风。"},"similar":["挥霍无度"],"opposite":["勤俭节约"],"usage":"作主语、谓语、宾语；指讲究排场"},{"id":45252,"word":"铺眉苫眼","pinyin":"pū méi shàn yǎn","abbr":"pmsy","explanation":"装模作样。","source":{"text":"一个个铺眉苫眼，妆些像态。","book":"元·关汉卿《裴度还带》第一折"},"example":{"text":"一个～滔滔口若悬河，一个俐齿伶牙喋喋舌如干将。","book":"清·西周生《醒世姻缘传》第18回"},"similar":["装模作样"],"usage":"作谓语、定语；指装模作样"},{"id":45253,"word":"铺眉蒙眼","pinyin":"pū méi méng yǎn","abbr":"pmmy","explanation":"装模作样。","source":{"text":"身穿茧绸衣，手里拿着数珠，铺眉蒙眼的走了出来。","book":"清·吴敬梓《儒林外史》第28回"},"similar":["铺眉苫眼"],"usage":"作谓语、定语；指装模作样"},{"id":45254,"word":"铺胸纳地","pinyin":"pū xiōng nà dì","abbr":"pxnd","explanation":"一种上半身贴近地面的跪拜礼，表示虔敬与隆重。","source":{"text":"三藏展背舒身，铺胸纳地，望金像叩头。","book":"明·吴承恩《西游记》第十六回"}},{"id":45255,"word":"铺谋定计","pinyin":"pū móu dìng jì","abbr":"pmdj","explanation":"铺设和制定计谋。","source":{"text":"我猜老虔婆和淫妇铺谋定计，叫了去不知怎的撮弄，陪着不是，还要回炉复帐，不知涎缠到多咱时候。","book":"明·兰陵笑笑生《金瓶梅词话》第二十回"},"example":{"text":"我还有甚么碍你眼处，你还要～，必定叫我远避他乡！","book":"清·西周生《醒世姻缘传》第十三回"},"similar":["铺谋设计"],"usage":"作谓语、定语、宾语；用于谋划"},{"id":45256,"word":"铺谋设计","pinyin":"pù móu shè jì","abbr":"pmsj","explanation":"铺：铺设，安排；谋：筹划。巧作安排设下计谋。","source":{"text":"一经生有儿女，希冀独吞家财，莫不铺谋设计……种种陷害。","book":"清·李汝珍《镜花缘》第12回"},"similar":["铺谋定计"],"usage":"作谓语、定语、宾语；用于谋划"},{"id":45257,"word":"铺采摛文","pinyin":"pù cǎi chī wén","abbr":"pccw","explanation":"指铺陈文采。","source":{"text":"《诗》有六义，其二曰赋。赋者，铺也。铺采摛文，体物写志也。","book":"南朝·宋·刘义庆《文心雕龙·诠赋》"},"example":{"text":"于是那种～，体物叙事的汉赋，才正式成立。","book":"刘大杰《中国文学发展史》第六章"},"usage":"作宾语、定语；用于文章等"},{"id":45258,"word":"铺锦列绣","pinyin":"pū jǐn liè xiù","abbr":"pjlx","explanation":"铺：铺陈；列：陈列；锦、绣：原指精致华丽的丝绣品，比喻华丽的词藻。形容文章充满华丽的词藻。","source":{"text":"君诗若铺锦列绣，亦雕缋眼。","book":"《南史·颜延之传》"},"usage":"作谓语、定语；用于文章的词藻"},{"id":45259,"word":"铿金戛玉","pinyin":"kēng jīn jiá yù","abbr":"kjjy","explanation":"形容文词音节铿锵有力。","source":{"text":"吾豫当初变时，一人起而左右北地，铿金戛玉，至今踔厉词坛。","book":"清·周亮工《书影》第一卷"},"similar":["铿金霏玉"],"usage":"作谓语、定语；指文辞等"},{"id":45260,"word":"铿金霏玉","pinyin":"kēng jīn fēi yù","abbr":"kjfy","explanation":"形容文词音节铿锵，不同凡响。","source":{"text":"崔出《樵隐近咏》相示……黄不觉惊赏曰：‘此真铿金霏玉之音也。’","book":"清·钮琇《觚剩·樵隐》"},"similar":["铿金戛玉"],"usage":"作谓语、定语；用于文辞等"},{"id":45261,"word":"铿铿锵锵","pinyin":"kēng kēng qiāng qiāng","abbr":"kkqq","explanation":"形容乐器声音响亮节奏分明或诗词文曲声调响亮，节奏明快。","source":{"text":"车行时摇动的铿铿锵锵，就如奏细乐一般。","book":"清·褚人获《隋唐演义》第28回"},"usage":"作定语、状语；用于声音等"},{"id":45262,"word":"铿锵有力","pinyin":"kēng qiāng yǒu lì","abbr":"kqyl","explanation":"形容声音响亮而有劲。铿镪：有节奏而响亮的声音。","source":{"text":"我们的总理，回答得最为铿锵有力；不用语言，而用电闪雷鸣般的一生的经历。","book":"郭小川《痛悼敬爱的周总理》诗"},"example":{"text":"托卡力夫的声音～，完全不是平时那种沙哑的低音。","book":"《筑路》"},"usage":"作谓语、定语、状语；指文章或说话等"},{"id":45263,"word":"铿锵顿挫","pinyin":"kēng qiāng dùn cuò","abbr":"kqdc","explanation":"铿锵：有节奏而响亮的声音。形容音律和谐有力、动听。","source":{"text":"这一出戏是一套‘北点绛唇’，铿锵顿挫，韵律不用说是好了。","book":"清·曹雪芹《红楼梦》第22回"},"usage":"作谓语、定语；用于书面语"},{"id":45264,"word":"铿镪顿挫","pinyin":"kēng qiāng dùn cuò","abbr":"kqdc","explanation":"铿镪：有节奏而响亮的声音。形容音律和谐有力、动听。","source":{"text":"这一出戏是一套‘北点绛唇’，铿镪顿挫，韵律不用说是好了。","book":"清·曹雪芹《红楼梦》第二十二回"}},{"id":45265,"word":"销声割迹","pinyin":"xiāo shēng gē jì","abbr":"xsgj","explanation":"销：通“消”，消失；迹：踪迹。指隐藏起来，不公开露面。","source":{"text":"披裘当夏，俗外为心，虽逢季子，不拾遗金，禽巢欲远，鱼穴惟深，消声灭迹，何必山林。","book":"北周·庾信《五月披裘负薪画赞》"},"example":{"text":"刘君石龄，以高才不试于有司，～，恒以吟咏自娱。","book":"清·朱彝尊《刘介于诗集序》"}},{"id":45266,"word":"销声匿影","pinyin":"xiāo shēng nì yǐng","abbr":"xsny","explanation":"指隐藏起来，不公开露面。同“销声避影”。","source":{"text":"妾又以夫族得罪于天，未蒙上帝昭雪，所以销声避影，而自困如是。","book":"唐·无名氏《灵应传》"},"example":{"text":"有向来相熟的客人，也可过去坐坐，他自己却竟是～的不大出来。","book":"清·张春帆《九尾龟》第七十二回"},"similar":["销声避影"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":45267,"word":"销声匿迹","pinyin":"xiāo shēng nì jì","abbr":"xsnj","explanation":"不公开讲话，不出头露面。形容隐藏起来，不再出现。","source":{"text":"禽巢欲远，鱼穴惟深，消声灭迹，何必山林！","book":"语出《艺文类聚》卷三六引北周庚信《五月披裘负薪画赞》"},"example":{"text":"虽然在初期也有少数人唱导‘与抗战无关’论，但为大势所迫，不久也就～了。","book":"郭沫若《沸羹集·抗战以来的文艺思潮》"},"similar":["隐姓埋名","无影无踪","销声敛迹"],"opposite":["死灰复燃","东山再起","抛头露面"],"usage":"作谓语、宾语、定语；用于人或事物","story":["唐朝时期，长安提炼金银的宗某与卖烧饼的陈敬瑄十分要好，为争夺一个美女而反目成仇。两人绝交后，陈敬瑄当上了四川节度使。长安发生叛乱，宗某随逃难人群到蜀地锦江。他四处游荡，隐姓埋名，准备销声匿迹，结果在内江还是被陈敬瑄所杀"]},{"id":45268,"word":"销声敛迹","pinyin":"xiāo shēng liǎn jì","abbr":"xslj","explanation":"犹言销声匿迹。指隐藏起来，不公开露面。","source":{"text":"宗国乱离，僖宗幸蜀。宗生避地，亦到锦江，然畏颖川知之，遂旅游资中郡，销声敛迹，惟恐人知。","book":"宋·孙光宪《北梦琐言》卷十一"},"example":{"text":"但进城后，因为革命声势，此辈已～，不能见其在大庭广众之中，行施其伎俩。","book":"孙犁《乡里旧闻·光棍》"},"similar":["销声匿迹"],"usage":"作谓语、宾语、定语；用于人或事物","story":["唐僖宗时期，长安人宗生与四川节度使陈敬瑄关系密切，后来两人因色失欢。因发生战乱，唐僖宗逃到四川，宗生也逃到锦江，因害怕陈敬瑄知道，他就到资中郡去旅游，一路销声敛迹，唯恐走漏消息"]},{"id":45269,"word":"销声避影","pinyin":"xiāo shēng bì yǐng","abbr":"xsby","explanation":"犹言销声匿迹。指隐藏起来，不公开露面。","source":{"text":"妾又以夫族得罪于天，未蒙上帝昭雪，所以销声避影，而自困如是。","book":"唐·无名氏《灵应传》"},"similar":["销声匿影","销声匿迹"],"usage":"作谓语、定语、宾语；用于处事等"},{"id":45270,"word":"销毁骨立","pinyin":"xiāo huǐ gǔ lì","abbr":"xhgl","explanation":"销：久病枯瘦。形容身体枯瘦如柴。","source":{"text":"高祖形容本壮，及还至京都，销毁骨立，亲表士友，不复识焉。","book":"《梁书·武帝纪》"},"similar":["柴毁骨立","哀毁骨立"],"usage":"作谓语、定语；用于人的外表"},{"id":45271,"word":"销神流志","pinyin":"xiāo shén liú zhì","abbr":"xslz","explanation":"消耗精神，丧失意志。","source":{"text":"女之艳媚，亦令人销神流志。","book":"明·杨慎《冶容诲淫》"},"usage":"作谓语、定语；用于书面语"},{"id":45272,"word":"销魂夺魄","pinyin":"xiāo hún duó pò","abbr":"xhdp","explanation":"神魂颠倒，失去常态。形容因羡慕或爱好某种事物而着迷。","source":{"text":"盐商富贵奢华，多少士大夫见了就销魂夺魄；你一个弱女子，视如土芥，这就可敬的极了！","book":"清·吴敬梓《儒林外史》第四十一回"},"similar":["失魂落魄","销魂荡魄"],"usage":"作谓语、定语；形容人神态失常"},{"id":45273,"word":"销魂荡魄","pinyin":"xiāo hún dàng pò","abbr":"xhdp","explanation":"形容因羡慕或爱好某种事物而着迷。同“销魂夺魄”。","source":{"text":"这都是风俗奢靡，处处使人销魂荡魄。","book":"清·彭养鸥《黑籍冤魂》第15回"},"similar":["销魂夺魄","失魂落魄"],"usage":"作谓语、定语；形容人神态失常"},{"id":45274,"word":"锄强扶弱","pinyin":"chú qiáng fú ruò","abbr":"cqfr","explanation":"铲除强暴，扶助弱者。","source":{"text":"此等锄强扶弱的事，不是我，谁人肯做？","book":"明·凌濛初《二刻拍案惊奇》卷十二"},"example":{"text":"如墨学主于～，势力愈盛者，则其仇之愈深。","book":"清·梁启超《论中国学术思想变迁之大势》"},"similar":["除暴安良","杀富济贫"],"usage":"作谓语、定语；指消灭强暴势力以帮助弱小"},{"id":45275,"word":"锋不可当","pinyin":"fēng bù kě dāng","abbr":"fbkd","explanation":"锋：锋芒，指刀剑的刃和尖；当：阻挡、承受。锋芒纯利，没有东西可以承受。形容气势极盛，不可阻挡。","source":{"text":"汉兵远斗，穷寇战，锋不可当。","book":"东汉·班固《汉书·韩信传》"},"example":{"text":"不意杜国越来越猛，～。","book":"清·陈天华《猛回头》"},"similar":["势不可当","锐不可当"],"usage":"作谓语、定语；指气势极盛"},{"id":45276,"word":"锋发韵流","pinyin":"fēng fā yùn liú","abbr":"ffyl","explanation":"指文章笔锋犀利，情韵欲流。","source":{"text":"安仁轻敏，故锋发而韵流。","book":"南朝·梁·刘勰《文心雕龙·体性》"},"usage":"作谓语、定语；指文章等"},{"id":45277,"word":"锋芒不露","pinyin":"fēng máng bù lù","abbr":"fmbl","explanation":"锋芒：刀剑的尖端，比喻显露出来的才干或心机；露：显露。有才干或心机却不外露。形容满腹才干或心机，表面上看不出来。","source":{"text":"宋寇准拜相时，朝廷所下诏书有：‘能断大事，不拘小节；有干将之器，不露锋芒，怀照物之明，而能包纳。","book":"宋·沈括《梦溪笔谈补》"},"similar":["胸有城府"],"opposite":["锋芒毕露"],"usage":"作谓语、定语；指有城府"},{"id":45278,"word":"锋芒所向","pinyin":"fēng máng suǒ xiàng","abbr":"fmsx","explanation":"向：指向。指斗争中矛头所指的地方。","source":{"text":"二十年来，这个文化新军的锋芒所向，从思想到形式（文字等），无不起了极大的革命。","book":"毛泽东《新民主主义论》"},"example":{"text":"我们要注意敌人的～，要避实就虚。"},"usage":"作主语、宾语；指斗争的矛头"},{"id":45279,"word":"锋芒挫缩","pinyin":"fēng máng cuò suō","abbr":"fmcs","explanation":"锋芒：刀或剑的尖端，比喻事物的尖锐部分；挫：挫折；缩：后退。指人的锐气才干受挫折而后退。","source":{"text":"赞亦枭夷，故使锋芒挫缩，厥图不果。","book":"《后汉书·袁绍传》"}},{"id":45280,"word":"锋芒毕露","pinyin":"fēng máng bì lù","abbr":"fmbl","explanation":"毕露：完全显露。锐气和才华全都显露出来。多指人好表现自己。","source":{"text":"瓒示枭夷，故使锋芒挫缩，厥图不果。","book":"南朝·宋·范晔《后汉书·袁绍传》"},"example":{"text":"写得不错，比她那些～的诗好得多了。","book":"夏衍《秋瑾传》第二幕"},"similar":["锋芒逼人","盛气凌人"],"opposite":["不露锋芒","不露圭角"],"usage":"作谓语、定语；指人好表现自己"},{"id":45281,"word":"锋芒毛发","pinyin":"fēng máng máo fà","abbr":"fmmf","explanation":"锋芒：刀或剑的尖端。刀剑的刃如毛发一样细。形容细微的事情。","source":{"text":"锋芒毛发之事，莫不记载。","book":"汉·王充《论衡·超奇》"}},{"id":45282,"word":"锋芒逼人","pinyin":"fēng máng bī rén","abbr":"fmbr","explanation":"锋：刀锋；芒：枪头。比喻言词锋利，给人以威胁。","source":{"text":"想借着师友渊源、故旧情谊来笼络这位锋芒毕露的身居要位的武将。","book":"华而实《汉衣冠》第二回"},"example":{"text":"鲁迅的杂文～。"},"similar":["锋芒毕露"],"opposite":["不露圭角","闪烁其辞"],"usage":"作谓语、宾语、状语；比喻言词锋利"},{"id":45283,"word":"锋铓毕露","pinyin":"fēng máng bì lù","abbr":"fmbl","explanation":"锐气和才华全都显露出来。多指人好表现自己。同“锋芒毕露”。"},{"id":45284,"word":"锋镝之苦","pinyin":"fēng dí zhī kǔ","abbr":"fdzk","explanation":"锋：刀或剑的尖端；镝：箭头。指刀砍箭射的痛苦。形容遭受战争的苦难。","source":{"text":"目的在于造成一种超然于南北以外的特殊地位，使浙江人民不受锋镝之苦。","book":"陶菊隐《北洋军阀统治时期史话》第七十四回"},"usage":"作宾语；用于战争等"},{"id":45285,"word":"锋镝余生","pinyin":"fēng dí yú shēng","abbr":"fdys","explanation":"锋：锋芒。镝：箭镞。指从刀箭下逃生或经过战乱后而活下来。","source":{"text":"他经过～，更加珍惜生命。"},"example":{"text":"他经过～，更加珍惜生命"},"usage":"作宾语、定语；用于战争等"},{"id":45286,"word":"锐不可当","pinyin":"ruì bù kě dāng","abbr":"rbkd","explanation":"锐：锐气；当：抵挡。形容勇往直前的气势，不可抵挡。","source":{"text":"其锋不可当。","book":"《后汉书·吴汉传》"},"example":{"text":"那是～，无坚不摧的。","book":"欧阳山《三家巷》八"},"similar":["攻无不克","所向无敌"],"opposite":["铩羽而归","损兵折将"],"usage":"作谓语、宾语、定语、状语；指声势浩大","story":["五代时期，周太祖郭威即位不久，后汉的河东节度使刘旻率军攻打晋州。周太祖派常胜将军王峻前去救援，王峻到达陕州后驻军休息。太祖派翟守素前去催征。王峻解释为了避免与来势汹汹、锐不可当的刘旻军队正面冲突而损兵折将，刘旻见势不妙就撤军"]},{"id":45287,"word":"锐卒勿攻","pinyin":"ruì zú wù gōng","abbr":"rzwg","explanation":"对精锐的军队不要攻击。","source":{"text":"锐卒勿攻，饵兵勿食。","book":"《孙子·军争》"}},{"id":45288,"word":"锐挫望绝","pinyin":"ruì cuò wàng jué","abbr":"rcwj","explanation":"指受挫而希望破灭。","source":{"text":"前戈矛，后邪许，得险即守，寸步前，而后苗锐挫望绝，薪烬焰熄，堤塞水止。","book":"清·魏源《圣武记》卷七"},"usage":"作谓语、定语；用于处境"},{"id":45289,"word":"锐挫气索","pinyin":"ruì cuò qì suǒ","abbr":"rcqs","explanation":"指因受挫而气势丧尽。","source":{"text":"任举败没，锐挫气索，晏起偷安，将士不得一见。","book":"清·魏源《圣武记》卷七"},"usage":"作谓语、定语；用于书面语"},{"id":45290,"word":"锐未可当","pinyin":"ruì wèi kě dāng","abbr":"rwkd","explanation":"锐：锐气；当：抵挡。形容勇往直前的气势，不可抵挡。","source":{"text":"晋州城坚不可近，而刘旻兵锐亦未可当。","book":"《后汉书·吴汉传》：“其锋不可当。”《新五代史·王峻传》"}},{"id":45291,"word":"锐气益壮","pinyin":"ruì qì yì zhuàng","abbr":"rqyz","explanation":"锐气：锐力的士气；益壮：更加强盛。士气更加旺盛。","source":{"text":"于是诸部齐心同力，锐气益壮，遂俱进，破杀甄阜、梁丘赐。","book":"《后汉书·王常传》"},"example":{"text":"我以～，以方胜之气，当已疲之敌，所谓势如破竹，数节之后，迎刃而解也。","book":"明·无名氏《草庐经略·乘胜》"}},{"id":45292,"word":"锒铛入狱","pinyin":"láng kāng rù yù","abbr":"ldry","explanation":"锒铛：铁索链相撞击的声音。用铁链锁起来，投入监狱。","source":{"text":"打破饭碗算是轻描淡写，其较重者由特务老爷赐予一绑，锒铛入狱，或一命呜呼。","book":"邹韬奋《患难余生记》第二章"},"example":{"text":"他因为是右派被～。"},"usage":"作谓语、定语；指坐牢"},{"id":45293,"word":"错上加错","pinyin":"cuò shàng jiā cuò","abbr":"csjc","explanation":"本来已经错了，又犯了新的错误。"},{"id":45294,"word":"错彩镂金","pinyin":"cuò cǎi lòu jīn","abbr":"cclj","explanation":"错：涂饰；镂：雕刻。形容诗文的词藻十分华丽。","source":{"text":"谢诗如芙蓉出水，颜如错彩镂金。","book":"南朝·梁·钟嵘《诗品》卷中"},"similar":["精雕细刻","镂金错彩"],"usage":"作定语、宾语；形容诗文的词藻十分华丽"},{"id":45295,"word":"错综变化","pinyin":"cuò zōng biàn huà","abbr":"czbh","explanation":"形容头绪纷繁，变化多端。","source":{"text":"惟能线索在手，则错综变化，惟吾所施。","book":"清·刘熙载《艺概·文概》"},"similar":["变幻莫测"],"opposite":["一成不变"],"usage":"作谓语、宾语；指变化多端"},{"id":45296,"word":"错综复杂","pinyin":"cuò zōng fù zá","abbr":"czfz","explanation":"错：交错，交叉；综：合在一起。形容头绪多，情况复杂。","source":{"text":"参伍以变，错综其数。","book":"《周易·系辞上》"},"example":{"text":"不管形式上怎样～，变化诡奇，实际上总有一个基本的道理贯串其间。","book":"秦牧《河汊错综》"},"similar":["扑朔迷离","盘根错节","纵横交错"],"opposite":["井然有序","一目了然"],"usage":"作谓语、定语；形容斗争、矛盾等"},{"id":45297,"word":"错节盘根","pinyin":"cuò jié pán gēn","abbr":"cjpg","explanation":"错：交错；节：枝节；盘：盘曲。树木的根枝盘旋交错。①比喻事情纷难复杂。②形容人坚韧不拔。","source":{"text":"志不求易，事不避难，臣之职也；不遇盘根错节，何以别利器乎？","book":"《后汉书·虞诩传》"},"example":{"text":"光风霁月，自是无尘，～，试规游刃。","book":"宋·张孝祥《赵通判》"},"similar":["盘根错节"],"usage":"作谓语、宾语、定语；比喻事情复杂"},{"id":45298,"word":"错落不齐","pinyin":"cuò luò bù qí","abbr":"clbq","explanation":"形容极不整齐。","source":{"text":"纤波浓点，错落期间。","book":"汉·班固《西都赋》：“随侯明月，错落其间。”《晋书·卫恒传》"},"example":{"text":"十多封来信……开口处～，是随手撕的。","book":"叶圣陶《皮包》"},"similar":["参差不齐"],"opposite":["错落有致"],"usage":"作谓语、定语；形容不整齐"},{"id":45299,"word":"错落参差","pinyin":"cuò luò cēn cī","abbr":"clcc","explanation":"交错不齐。同“参差错落”。","source":{"text":"一骑在前，数骑在后……乃未及半圈，而前者忽后，后者忽前，错落参差，捉摸不定，使人目眩神骇。","book":"清·百一居士《壶天录》卷下"},"similar":["参差错落","参差不齐"],"opposite":["整齐划一","整整齐齐"],"usage":"作谓语、定语；指交错不齐"},{"id":45300,"word":"错落有致","pinyin":"cuò luò yǒu zhì","abbr":"clyz","explanation":"错落：参差不齐。致：情趣。形容事物的布局虽然参差不齐，但却极有情趣，使人看了有好感。","source":{"text":"纤波浓点，错落其间。","book":"《晋书·卫恒》"},"example":{"text":"外湖跟里湖从～的枝叶间望去，似乎时刻在变换模样儿。","book":"叶圣陶《游了三个湖》"},"similar":["有条不紊","有条有理"],"opposite":["杂乱无章","错落不齐"],"usage":"作谓语、定语、补语；指事物布局合理可爱"},{"id":45301,"word":"错落高下","pinyin":"cuò luò gāo xià","abbr":"clgx","explanation":"犹言长短高低。","source":{"text":"已而耳改目化，气竦神涌，古今事物，错落高下，不以涯量。","book":"宋·叶適《文林郎前秘书省正字周君南仲墓志铭》"},"similar":["错落参差"],"usage":"作谓语、定语；用于秩序等"},{"id":45302,"word":"错认颜标","pinyin":"cuò rèn yán biāo","abbr":"cryb","explanation":"形容懵懂浅陋。","source":{"text":"主司头脑太冬烘，错认颜标作鲁公。","book":"五代·王定保《唐摭言》卷八"},"usage":"作谓语、定语；指头脑不清醒","story":["唐朝时期，主考官郑薰先生在评卷时，见到颜标的卷子，他看了一遍觉得没有什么特别的地方，他想颜标是颜真卿的后代，应该让这个忠烈的后代作状元。谢恩的那天，郑薰才发现错认了颜标。后来人们评论：“主司头脑太冬烘，错认颜标作鲁公。”"]},{"id":45303,"word":"错过时机","pinyin":"cuò guò shí jī","abbr":"cgsj","explanation":"丧失机会。","example":{"text":"我们不能～，把胜利果实让给对方。"},"similar":["错过良机"],"opposite":["不失时机"],"usage":"作谓语、宾语；指丧失机会"},{"id":45304,"word":"锡衮封圭","pinyin":"xī gǔn fēng guī","abbr":"xgfg","explanation":"锡：赐；衮：衮服；圭：玉器。古代帝王诸侯所执的礼器。","source":{"text":"这恩荣锡衮封圭，不比那登龙御李。","book":"清·孔尚任《桃花扇·媚座》"},"usage":"作宾语；指高官"},{"id":45305,"word":"锢聪塞明","pinyin":"gù cōng sāi míng","abbr":"gcsm","explanation":"锢：禁锢，堵塞；聪：听觉灵敏；明：视觉灵敏。堵住人的耳目，使之寡见少闻，浅陋迟钝。","source":{"text":"因其繁而繁之，是洽丝而棼，瞀天下者也。强其繁而简之，是锢聪塞明，陋天下者也。","book":"汉·王充《论衡·自纪》：“闭目塞聪，爱精自保。” 清·谭嗣同《黄颖初〈传音快字简法〉序》"},"similar":["蔽聪塞明"],"usage":"作宾语、定语；指不注意交流"},{"id":45306,"word":"锣鼓喧天","pinyin":"luó gǔ xuān tiān","abbr":"lgxt","explanation":"喧：声音大。锣鼓震天响。原指作战时敲锣击鼓指挥进退。后多形容喜庆、欢乐的景象。","source":{"text":"早来到北邙前面，猛听的锣鼓喧天，那军不到三千，拥出个将一员，雄纠纠威风武艺显。","book":"元·尚仲贤《单鞭夺槊》第四折"},"example":{"text":"周庸祐一一回发，赏封五块银子，各人称谢。少时，～，笙箫彻耳。","book":"清·黄小配《廿载繁华梦》第二十二回"},"similar":["敲锣打鼓","吹吹打打"],"opposite":["哑然失声","万籁俱寂"],"usage":"作谓语、定语、状语；指喜庆气氛"},{"id":45307,"word":"锣齐鼓不齐","pinyin":"luó qí gǔ bù qí","abbr":"lqgbq","explanation":"比喻人到不齐或条件不具备。","example":{"text":"～，我们何时才能开一个团圆会。"},"usage":"作定语、状语；指条件不具备"},{"id":45308,"word":"锥出囊中","pinyin":"zhuī chū náng zhōng","abbr":"zcnz","explanation":"囊：口袋。锥子放在口袋里，锥尖就会露出来。比喻有才能的人初露头角。","source":{"text":"夫贤士之处世也，譬若锥之处囊中，其末立见。","book":"《史记·平原君虞卿列传》"},"example":{"text":"思王《野田黄雀行》，譬如～，大索露矣。","book":"明·徐祯卿《谈艺录》"},"similar":["锥处囊中"],"usage":"作宾语、定语；指初显才能"},{"id":45309,"word":"锥刀之利","pinyin":"zhuī dāo zhī lì","abbr":"zdzl","explanation":"比喻微小的利益。也比喻极小的事情。同“锥刀之末”。","source":{"text":"争锥刀之利，杀人若刈草然，其宗祀亦旋夷灭。","book":"《后汉书·舆服志上》"},"example":{"text":"陛下贵为天子，富有四海，乃至竞～，如倡优馆舍乎？","book":"《明史·齐之鸾传》"},"similar":["锥刀之末"],"usage":"作宾语；用于书面语"},{"id":45310,"word":"锥刀之末","pinyin":"zhuī dāo zhī mò","abbr":"zdzm","explanation":"末：梢，尖端。比喻微小的利益。也比喻极小的事情。","source":{"text":"锥刀之末，将尽争之。","book":"《左传·昭公六年》"},"example":{"text":"竞毛羽之轻，趋～。","book":"《南史·任昉传》"},"similar":["锥刀之利"],"usage":"作宾语；指小事"},{"id":45311,"word":"锥刀之用","pinyin":"zhuī dāo zhī yòng","abbr":"zdzy","explanation":"指微小的功用。","source":{"text":"若使陛下出不世之诏，效臣锥刀之用。","book":"三国·魏·曹植《求自试表》"},"usage":"作宾语；用于书面语"},{"id":45312,"word":"锥处囊中","pinyin":"zhuī chǔ náng zhōng","abbr":"zcnz","explanation":"囊：口袋。锥子放在口袋里，锥尖就会露出来。比喻有才能的人不会长久被埋没，终能显露头角。","source":{"text":"夫贤士之处世也，譬若锥之处囊中，其末立见。","book":"西汉·司马迁《史记·平原君虞卿列传》"},"example":{"text":"书传圯上此人去，～相士谁？","book":"陈三立《次韵再答王义门》"},"similar":["锥出囊中","囊里盛锥"],"opposite":["不露锋芒"],"usage":"作宾语、定语；指初显才能","story":["战国时期，赵国平原君的门客毛遂主动自荐随同平原君前去与楚王谈判，平原君见他平时没有名气，说：“夫贤士之处世也，譬若锥之处囊中，其末立见。”毛遂说他愿意得处囊中才能脱颖而出。平原君允许他去，结果终于说动楚国出兵抗秦救赵"]},{"id":45313,"word":"锥心刺骨","pinyin":"zhuī xīn cì gǔ","abbr":"zxcg","explanation":"锥：用尖锥刺。形容十分悲痛","source":{"text":"只是见不得这一个‘穷’字听到耳朵里，真是锥心刺骨、势不两立的勾当。","book":"清·李百川《绿野仙踪》第54回"},"usage":"作宾语、定语；用于比喻句"},{"id":45314,"word":"锦上添花","pinyin":"jǐn shàng tiān huā","abbr":"jsth","explanation":"锦：有彩色花纹的丝织品。在锦上再绣花。比喻好上加好，美上添美。","source":{"text":"又要涪翁作颂，且图锦上添花。","book":"宋·王安石《即事》诗：“嘉招欲覆杯中渌，丙方唱仍添锦上花。”宋·黄庭坚《了了庵颂》"},"example":{"text":"命穷时镇日价河头卖水，运来时一朝的～。","book":"明·康海《中山狼》第一的"},"similar":["精益求精","如虎添翼"],"opposite":["雪上加霜"],"usage":"作谓语、宾语、补语；指更好"},{"id":45315,"word":"锦囊佳制","pinyin":"jǐn náng jiā zhì","abbr":"jnjz","explanation":"犹言锦囊佳句。指优美的诗句。","source":{"text":"恒从小奚奴，骑巨驴，背一古破锦囊，遇有所得，即书投囊中。","book":"唐·李商隐《李长吉小传》"},"example":{"text":"昨宵个～明勾引，今日个玉堂人物难亲近。","book":"元·王实甫《西厢记》第二本第一折"},"similar":["锦囊佳句"],"usage":"作宾语；指优美的文句"},{"id":45316,"word":"锦囊佳句","pinyin":"jǐn náng jiā jù","abbr":"jnjj","explanation":"锦囊：用锦做成的袋子，古人多用以藏诗稿。指优美的诗句。","source":{"text":"恒从小奚奴，骑巨驴，背一古破锦囊，遇有所得，即书投囊中。","book":"唐·李商隐《李长吉小传》"},"example":{"text":"余戏题其签曰：“～。”不知夭寿这机此已伏矣。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["妙语连珠","锦囊佳制"],"usage":"作宾语；指优美的文句","story":["唐朝时期，诗人李贺身体很瘦小，经常带着一名书童，骑着一匹弱马，在郊外闲游，看到漂亮的风景，即景生情写下几句，放到书童背上的锦囊中。傍晚回家就立即拿出这些锦囊佳句出来整理成篇。每天都有新作品问世"]},{"id":45317,"word":"锦囊妙句","pinyin":"jǐn náng miào jù","abbr":"jnmj","explanation":"锦囊：用锦做成的袋子，古人多用以藏诗稿。指优美的诗句。","source":{"text":"恒从小奚奴，骑巨驴，背一古破锦囊，遇有所得，即书投囊中。","book":"唐·李商隐《李长吉小传》"},"example":{"text":"长鲸渴兴沈江海，～生风雷。","book":"宋·邓肃《醉吟轩》"}},{"id":45318,"word":"锦囊妙计","pinyin":"jǐn náng miào jì","abbr":"jnmj","explanation":"旧小说里描写足智多谋的人把对付敌方的计策写在纸条上，放在锦囊里，以便当事人在紧急时拆阅。比喻有准备的巧妙办法。","source":{"text":"汝保主公入吴，当领此三个锦囊。囊中有三条妙计，依次而行。","book":"明·罗贯中《三国演义》第五十四回"},"example":{"text":"为什么叫麻烦？你的～在哪里呢？","book":"叶圣陶《倪焕之》"},"similar":["神机妙算"],"opposite":["无计可施","一筹莫展"],"usage":"作主语、宾语、定语；用于俏皮、讥讽语句中","story":["三国时期，刘备在诸葛亮的辅佐下，以吴国荆州为基地，实力逐渐强大起来。长坂坡之战后，周瑜设计诱使刘备去东吴娶孙权的妹妹然后除掉他。诸葛亮给赵云三个锦囊妙计，让赵云陪刘备前往东吴，使得孙权赔了夫人又折兵"]},{"id":45319,"word":"锦囊玉轴","pinyin":"jǐn náng yù zhóu","abbr":"jnyz","explanation":"①玉轴装裱，盛以锦囊。指对书画作品的珍爱宝藏。②借指名贵的书画作品。","source":{"text":"余作字其上，后世当有锦囊玉轴什袭之宠。","book":"宋·袁文《瓮牖闲评》第六卷"},"example":{"text":"～来无趾，粲然夺真疑圣智。"},"usage":"作宾语、定语；用于书画作品"},{"id":45320,"word":"锦囊还矢","pinyin":"jǐn náng huán shǐ","abbr":"jnhs","explanation":"指凯旋告捷。","source":{"text":"世言晋王之将终也，以三矢赐庄宗而告之曰：‘梁，吾仇也；燕王吾所立，契丹与吾约为兄弟，而皆背晋以归梁，吾遗恨也。与尔三矢，尔其无忘乃父之志！’庄宗受而藏之于庙。其后用兵……盛以锦囊，……及凯旋而纳之。","book":"《新五代史·伶官传序》"},"example":{"text":"柳亚子有《十一月二十九日为邓择生先烈殉国南都十六周忌辰赋诗遥奠～雠头告庙之日知不逾明岁今朝矣》诗。"}},{"id":45321,"word":"锦团花簇","pinyin":"jǐn tuán huā cù","abbr":"jthc","explanation":"形容五色缤纷，十分华丽。","source":{"text":"那巧姐儿身上穿得锦团花簇，手里拿着好些顽意儿，笑嘻嘻走到凤姐身边学舌。","book":"清·曹雪芹《红楼梦》第八十八回"},"similar":["花团锦簇"],"usage":"作宾语、定语、状语；形容五彩缤纷"},{"id":45322,"word":"锦天绣地","pinyin":"jǐn tiān xiù dì","abbr":"jtxd","explanation":"形容房屋或其他环境布置得十分美观华丽。","source":{"text":"那得青烟穿御柳，且将银烛照京花……锦天绣地春不散，任教檐雨卷泥沙。","book":"宋·范成大《清明日试新火作牡丹会》"},"example":{"text":"灯如昼，人如蚁，总为赏元宵，妆点出～。","book":"明·李翠微《正宫山樵灯犯·元宵艳曲》"},"usage":"作宾语、定语；用于环境等"},{"id":45323,"word":"锦字回文","pinyin":"jǐn zì huí wén","abbr":"jzhw","explanation":"绣在锦缎上的回文。指情诗。","example":{"text":"～的故事真是感人肺腑。"},"similar":["织锦回文"],"usage":"作宾语、定语；指情诗","story":["前秦时期，秦州刺史窦滔因得罪了苻坚的手下大官被流放到流沙县。夫妻天各一方，他的妻子苏蕙特地在一块锦缎上绣上840个字，纵横20几个字的方图，可以任意地读，共能读出3752首诗，表达了她对丈夫的思念与关心之情"]},{"id":45324,"word":"锦屏射雀","pinyin":"jǐn píng shè què","abbr":"jpsq","explanation":"锦屏：画有孔雀的丝织门屏。指得选为女婿。","source":{"text":"乃于门屏画二孔雀，诸公子有求婚者，辄与两箭射之，潜约中目者许之。前后数十辈莫能中。高祖后至，两发各中一目。毅大悦，遂归于我帝。","book":"《旧唐书·高祖太穆皇后窦氏传》"},"similar":["雀屏中选"],"usage":"作宾语、定语；指比武招婿","story":["唐朝时期，窦融觉得女儿才貌双全，不能轻易许给平庸之辈，得嫁一个真正的贤人。于是他在门屏上画两个孔雀，表示谁能同时两箭射中两孔雀的眼睛就将女儿嫁给他。很多公子都去射箭比武，可惜都不能如愿。唐高祖一箭射两目而娶得她"]},{"id":45325,"word":"锦心绣口","pinyin":"jǐn xīn xiù kǒu","abbr":"jxxk","explanation":"锦、绣：精美鲜艳的丝织品。形容文思优美，词藻华丽。","source":{"text":"骈四骊六，锦心绣口，宫沉羽振，笙簧触手。","book":"唐·柳宗元《乞巧文》"},"example":{"text":"虽只数字，结束之妙，无过于此，若非～，何能道出。","book":"清·李汝珍《镜花缘》第九十三回"},"similar":["满腹经纶","生花妙笔"],"usage":"作谓语、宾语、定语；用于文章等"},{"id":45326,"word":"锦心绣肠","pinyin":"jǐn xīn xiù cháng","abbr":"jxxc","explanation":"形容文思优美，聪明有才。","source":{"text":"刚将妄言绮语，认作锦心绣肠。","book":"宋·范成大《或劝病中不宜数亲文墨，医亦归咎，题四绝以自戒，末篇又以解嘲》其三"},"example":{"text":"闻之异乡公子如此形状，必是个浪荡之徒，便有～，谁人信他，谁人请他。","book":"明·冯梦龙《警世通言》卷十七"},"similar":["锦心绣口"],"usage":"作宾语；用于文章等"},{"id":45327,"word":"锦心绣腹","pinyin":"jǐn xīn xiù fù","abbr":"jxxf","explanation":"形容优美的文思，华丽的辞藻。","source":{"text":"他有那锦心绣腹，我有那冰肌玉骨。","book":"元·汤式《一枝花·冬景题情》套曲"},"similar":["锦心绣口"],"usage":"作宾语；形容优美的文章"},{"id":45328,"word":"锦片前程","pinyin":"jǐn piàn qián chéng","abbr":"jpqc","explanation":"象锦绣那样的前程。形容前途十分美好。","source":{"text":"想着咱锦片前程，十分恩爱。","book":"元·贾仲名《对玉梳》第四折"},"example":{"text":"那时～，尽俺受用，何处不许游耍，岂但下楼。","book":"清·孔尚任《桃花扇·寄扇》"},"similar":["锦绣前程"],"usage":"作主语、宾语、定语；指美好的前途"},{"id":45329,"word":"锦瑟华年","pinyin":"jǐn sè huá nián","abbr":"jshn","explanation":"比喻青春时代。","source":{"text":"锦瑟无端五十弦， 一弦一柱思华年。","book":"唐·李商隐《锦瑟》诗"},"example":{"text":"喜才子佳人，双双～。","book":"明·汤显祖《紫钗记·花朝合卺》"},"similar":["锦瑟年华"],"usage":"作主语、宾语；比喻青春时代"},{"id":45330,"word":"锦瑟年华","pinyin":"jǐn sè nián huá","abbr":"jsnh","explanation":"比喻青春时代。","source":{"text":"锦瑟无端五十弦， 一弦一柱思华年。","book":"唐·李商隐《锦瑟》诗"},"example":{"text":"凌波不过横塘路，但目送、芳尘去。～谁与度。月台花榭，琐窗朱户，只有春知处。","book":"宋·贺铸《青玉案》词"},"similar":["锦瑟华年"],"usage":"作主语、宾语；比喻青春时代"},{"id":45331,"word":"锦篇绣帙","pinyin":"jǐn piān xiù zhì","abbr":"jpxz","explanation":"指华美的篇章。","source":{"text":"遂使锦篇绣帙，沉埋瓿瓮之间。","book":"清·李渔《闲情偶寄·演习·选剧》"},"usage":"作宾语、定语；用于文章等"},{"id":45332,"word":"锦簇花团","pinyin":"jǐn cù huā tuán","abbr":"jcht","explanation":"锦：有文彩的丝织品；簇：丛聚。形容五彩缤纷，十分鲜艳多彩的景象。也形容文章辞藻华丽。","source":{"text":"自余是什么亲拟，将有限身心向无限中用，……。若无恁么事，饶你攒花簇锦，亦无用处。","book":"宋·释道原《景德传灯录》卷十七"},"example":{"text":"若经义不精，史事不熟，纵然文章作的～，终为无本之学。","book":"清·文康《儿女英雄传》第三十三回"},"similar":["锦团花簇"],"usage":"作宾语、定语；指五彩缤纷"},{"id":45333,"word":"锦绣前程","pinyin":"jǐn xiù qián chéng","abbr":"jxqc","explanation":"象锦绣那样的前程。形容前途十分美好。","source":{"text":"想着咱锦绣前程，十分恩爱。","book":"元·贾仲名《对玉梳》第四折"},"example":{"text":"而使儿子的～毁于一旦。","book":"叶君健《火花》十九"},"similar":["前程万里","前程似锦"],"opposite":["穷途末路","日暮途穷"],"usage":"作主语、宾语、定语；指美好的前途"},{"id":45334,"word":"锦绣山河","pinyin":"jǐn xiù shān hé","abbr":"jxsh","explanation":"高山和河流就像精美鲜艳的丝织品一样。形容美好的国土。","source":{"text":"秦城楼阁烟花里，汉主山河锦绣中。","book":"唐·杜甫《清明二首（其二）》"},"example":{"text":"王侯第宅苍茫外，～感慨中。","book":"元·戴良《秋兴五首（其二）》"},"similar":["锦绣河山"],"opposite":["残山剩水","穷山恶水"],"usage":"作主语、宾语；指美丽的江山"},{"id":45335,"word":"锦绣心肠","pinyin":"jǐn xiù xīn cháng","abbr":"jxxc","explanation":"意思是满腹诗文，善出佳句。同“锦绣肝肠”。","source":{"text":"刚将妄言绮语，认作锦心绣肠。","book":"宋·范成大《或劝病中不宜数亲文墨，医亦归咎，题四绝以自戒，末篇又以解嘲》其三"},"example":{"text":"珠矶咳唾，～。","book":"元·鲜于必仁《折桂令·李翰林》"},"similar":["锦绣肝肠"],"usage":"作宾语；指满腹诗文，善出佳句"},{"id":45336,"word":"锦绣江山","pinyin":"jǐn xiù jiāng shān","abbr":"jxjs","explanation":"象锦绣那样的美好的江山。形容美好的国土。","source":{"text":"秦城楼阁烟花里，汉主山河锦绣中。","book":"唐·杜甫《清明二首（其二）》"},"example":{"text":"不听忠言，信任奸邪，将一座～，弄得粉碎。","book":"清·钱彩《说岳全传》第四十七回"},"similar":["锦绣山河"],"usage":"作宾语；同“锦绣山河”"},{"id":45337,"word":"锦绣河山","pinyin":"jǐn xiù hé shān","abbr":"jxhs","explanation":"形容壮丽华美的祖国山河。","source":{"text":"秦城楼阁烟花里，汉主山河锦绣中。","book":"唐·杜甫《清明二首（其二）》"},"example":{"text":"～收拾好，万民尽作主人翁。","book":"朱德《寄南征诸将》诗"},"similar":["大好河山","锦绣乾坤"],"opposite":["残山剩水","穷山恶水"],"usage":"作主语、宾语、定语；形容壮丽华美的祖国"},{"id":45338,"word":"锦绣肝肠","pinyin":"jǐn xiù gān cháng","abbr":"jxgc","explanation":"意思是满腹诗文，善出佳句。","source":{"text":"兄心肝五藏，皆锦绣耶？不然，何开口成文，挥翰雾散？","book":"唐·李白《冬日于龙门送从弟京兆参军令问之淮南觐省序》"},"example":{"text":"还有人争说，鸣琴手段，教侬重吐，～。","book":"宋·刘过《沁园春·王汝良自长沙归》词"},"similar":["锦绣心肠"],"usage":"作宾语；指满腹诗文，善出佳句"},{"id":45339,"word":"锦胸绣口","pinyin":"jǐn xiōng xiù kǒu","abbr":"jxxk","explanation":"犹言锦心绣口。形容文思优美，词藻华丽。","source":{"text":"锦胸绣口，居然妙绪环生。","book":"清·湘灵子《轩亭冤》序"},"similar":["锦心绣口","锦心绣肠"],"usage":"作谓语、宾语、定语；用于文章等"},{"id":45340,"word":"锦花绣草","pinyin":"jǐn huā xiù cǎo","abbr":"jhxc","explanation":"形容花草长得非常美丽。"},{"id":45341,"word":"锦营花阵","pinyin":"jǐn yíng huā zhèn","abbr":"jyhz","explanation":"喻指风月场所。","source":{"text":"锦营花阵，偎红倚翠。","book":"元·无名氏《云窗梦》第四折"},"example":{"text":"～，旗枪怎当；酒蛇腹剑，机关怎防。","book":"明·孟称舜《死里逃生》第三出"},"similar":["锦阵花营"],"usage":"作宾语、定语；指风月场所"},{"id":45342,"word":"锦衣玉带","pinyin":"jǐn yī yù dài","abbr":"jyyd","explanation":"身上穿着锦衣，腰里系着玉带。形容显贵富有者的华丽的装束。","source":{"text":"晋王深信之，即厚给田宅，仍赐锦衣玉带，军中目为‘刘二哥’。","book":"《旧五代史·刘知俊传》"},"example":{"text":"～雪中眠，醉后诗魂欲上天。","book":"清·张问陶《醉后口占》"}},{"id":45343,"word":"锦衣玉食","pinyin":"jǐn yī yù shí","abbr":"jyys","explanation":"锦衣：鲜艳华美的衣服；玉食：珍美的食品。精美的衣食。形容豪华奢侈的生活。","source":{"text":"锦衣玉食，可颐其形。","book":"《魏书·常景传》"},"example":{"text":"况～者未必能安于荆钗布裙也，与其后悔，莫若无成。","book":"清·沈复《浮生六记·坎坷记愁》"},"similar":["娇生惯养","穷奢极侈"],"opposite":["节衣缩食","省吃俭用","粗衣粝食"],"usage":"作宾语、定语；指奢华的生活"},{"id":45344,"word":"锦衣纨裤","pinyin":"jǐn yī wán kù","abbr":"jywk","explanation":"锦衣：鲜艳华美的衣服；纨裤：古时富贵人家子弟所穿的细绢裤。指达官贵人的后代。","source":{"text":"当此日，欲将已往所赖天恩祖德，锦衣纨裤之时，饫甘餍肥之日，背父兄教育之恩，负师友规训之德，以致今日一技无成，半生潦倒之罪，编述一集，以告天下。","book":"清·曹雪芹《红楼梦》第一回"}},{"id":45345,"word":"锦衣绣袄","pinyin":"jǐn yī xiù ǎo","abbr":"jyxa","explanation":"锦：有彩色花纹的丝织品。指华丽的衣服。","source":{"text":"随即差人，将一包袱锦衣绣袄，与卢俊义穿着，八个小喽啰，抬过一乘轿来，扶卢员外上轿便行。","book":"明·施耐庵《水浒传》第62回"},"usage":"作宾语、定语；用于生活"},{"id":45346,"word":"锦衣肉食","pinyin":"jǐn yī ròu shí","abbr":"jyrs","explanation":"形容豪华奢侈的生活。同“锦衣玉食”。","source":{"text":"锦衣肉食非吾乐，藁操冰心岂自坚。","book":"明·李东阳《生日邃庵太宰贶以长律用韵自述并答雅怀》"},"example":{"text":"他在～中长大，经历过声色犬马的生涯。","book":"柯灵《香雪海·水流千里归大海》"},"similar":["锦衣玉食","玉食锦衣"],"opposite":["粗衣粝食"],"usage":"作宾语、定语；指奢华的生活"},{"id":45347,"word":"锦衣行昼","pinyin":"jǐn yī xíng zhòu","abbr":"jyxz","explanation":"富贵了须回归故里。","source":{"text":"（项王）曰：‘富贵不归故乡，如衣绣夜行，谁知之者！’","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"金印明年如斗。向中州，～。","book":"宋·辛弃疾《水龙吟》"},"similar":["衣锦还乡"],"usage":"作谓语、定语；指富贵须归故里"},{"id":45348,"word":"锦被一床","pinyin":"jǐn bèi yī chuáng","abbr":"jbyc","explanation":"比喻请求别人通融、庇护。","source":{"text":"及德视事教场，诸将执挝用军礼谒拜。琼登而言曰：‘寻常伏事太尉不周，今日乞做一床锦被遮盖。’","book":"宋·周密《齐东野语·淮西之变》"},"example":{"text":"～遮尽丑，乔公不枉叫青天。","book":"明·冯梦龙《醒世恒言》卷八"}},{"id":45349,"word":"锦阵花营","pinyin":"jǐn zhèn huā yíng","abbr":"jzhy","explanation":"喻指风月场所。同“锦营花阵”。","source":{"text":"莫非他锦阵花营不曾厮共，险教咱风月无功。","book":"元·吴昌龄《张天师》第一折"},"similar":["锦营花阵"],"usage":"作宾语、定语；指风月场所"},{"id":45350,"word":"锯牙钩爪","pinyin":"jù yá gōu zhǎo","abbr":"jygz","explanation":"比喻人的凶恶残暴。也比喻武装军队。同“钩爪锯牙”。","source":{"text":"彼锯牙而钩爪，又循江而习流。","book":"北周·庾信《哀江南赋》"},"usage":"作谓语、宾语；指军队"},{"id":45351,"word":"锱珠必较","pinyin":"zī zhū bì jiào","abbr":"zzbj","explanation":"形容非常小气，很少的钱也一定要计较。也比喻气量狭小，很小的事也要计较。","source":{"text":"虽然他们互相请客时出手大方，喝了酒也会亲热得推心置腹，眼泪汪汪。但一谈到生意钱财就会立刻变得冷若冰霜、锱珠必较，有时还会吵得面红耳赤、破口大骂。","book":"王朔《浮出海面》九"}},{"id":45352,"word":"锱铢不爽","pinyin":"zī zhū bù shuǎng","abbr":"zzbs","explanation":"犹言分毫不差。","source":{"text":"条分缕析，一一相配，而锱铢不爽也。","book":"清·周亮工《书影》卷八"},"similar":["分毫不爽"],"usage":"作谓语、定语；用于书面语"},{"id":45353,"word":"锱铢必较","pinyin":"zī zhū bì jiào","abbr":"zzbj","explanation":"锱、铢：都是古代很小的重量单位。形容非常小气，很少的钱也一定要计较。也比喻气量狭小，很小的事也要计较。","source":{"text":"割国之锱铢以赂之，则割定而欲无厌。","book":"《荀子·富国》"},"example":{"text":"就是族中亲派，不论亲疏，但与他财利交往，～，一些情面也没有的。","book":"明·凌濛初《二刻拍案惊奇》卷三十一"},"similar":["锱铢较量","斤斤计较","一毛不拔"],"opposite":["慷慨解囊","满不在乎","豁达大度"],"usage":"作谓语、宾语；指气量小"},{"id":45354,"word":"锱铢较量","pinyin":"zī zhū jiào liàng","abbr":"zzjl","explanation":"指对很少的钱或很小的事，都十分计较。","source":{"text":"况你学业日进，发达有时，何苦锱铢较量，讨人便宜怎的。","book":"明·凌濛初《二刻拍案惊奇》卷四"},"example":{"text":"些须银色小事，何必～。","book":"清·李汝珍《镜花缘》第十一回"},"similar":["斤斤计较","锱铢必较"],"usage":"作谓语、宾语；指气量小"},{"id":45355,"word":"锲而不舍","pinyin":"qiè ér bù shě","abbr":"qebs","explanation":"锲：镂刻；舍：停止。不断地镂刻。比喻有恒心，有毅力。","source":{"text":"锲而舍之，朽木不折；锲而不舍，金石可镂。","book":"《荀子·劝学》"},"example":{"text":"夫固谓一人～，则行美于本性矣。","book":"章炳麟《菌说》"},"similar":["坚持不懈","坚韧不拔"],"opposite":["半途而废","知难而退"],"usage":"作谓语、定语、状语；指坚持不懈","story":["战国末期赵国哲学家荀况在《劝学》中讲到：学习同镂金石一样，刻一下就停下手来，烂木头也刻不断，不停地刻下去，即使是坚硬的金属和石头，也可以把它们刻穿，所以学习要有“锲而不舍”的精神，持之以恒、坚持不懈才会有成效"]},{"id":45356,"word":"锵金铿玉","pinyin":"qiāng jīn kēng yù","abbr":"qjky","explanation":"比喻音节响亮，诗句优美。同“锵金鸣玉”。","source":{"text":"锵金铿玉千余篇，脍吞炙嚼人口传。","book":"五代·齐己《读》诗"},"similar":["锵金鸣玉"],"usage":"作定语、谓语；指文章"},{"id":45357,"word":"锵金鸣玉","pinyin":"qiāng jīn míng yù","abbr":"qjmy","explanation":"金玉相撞而发声。比喻音节响亮，诗句优美。","source":{"text":"绣柱璇题粉壁映，锵金鸣玉王侯盛。","book":"唐·骆宾王《帝京篇》"},"similar":["锵金铿玉"],"usage":"作定语、谓语；指文章"},{"id":45358,"word":"锻炼之吏","pinyin":"duàn liàn zhī lì","abbr":"dlzl","explanation":"指旧时网罗罪名，陷害人的官吏。","source":{"text":"忠孝之人，持心近厚，锻炼之吏，持心近薄。","book":"《后汉书·韦彪传》"}},{"id":45359,"word":"锻炼周内","pinyin":"duàn liàn zhōu nà","abbr":"dlzn","explanation":"锻炼：形容对判罪的文辞很有研究；周：周密；内：通“纳”，使陷入。指罗织罪状，故意陷人于罪。","source":{"text":"上奏畏却，则锻炼而周内之。","book":"东汉《班固·路温舒传》"},"example":{"text":"便加以和《金瓶梅》一样的罪：这是～的。","book":"鲁迅《反对“含泪”的批评家》"},"similar":["锻炼罗织"],"usage":"作谓语、定语；指强加之罪"},{"id":45360,"word":"锻炼周纳","pinyin":"duàn liàn zhōu nà","abbr":"dlzn","explanation":"锻炼：锤炼；周纳：罗织。指罗织罪名，设法使之周密而无遗漏。","source":{"text":"故囚人不胜痛，则饰辞以视之，吏治者利其然，则指道以明之，上奏畏却，则锻炼而周纳之。","book":"汉·陆温舒《上书言宜尚德缓刑》"},"example":{"text":"汉·陆温舒《上书言宜尚德缓刑》：“故囚人不胜痛，则饰辞以视之，吏治者利其然，则指道以明之，上奏畏却，则锻炼而周纳之。”"}},{"id":45361,"word":"锻炼罗织","pinyin":"duàn liàn luó zhī","abbr":"dllz","explanation":"锻炼：形容对判罪的文辞很有研究；罗织：虚构种种罪名，对无辜者加以诬陷。指罗织罪状，故意陷人于罪。","source":{"text":"可见如果将‘差不多说’锻炼罗织起来，自然也可以判作一种挟带私心的不平。","book":"鲁迅《端午节》"},"example":{"text":"请不要～罪名来害人了。"},"similar":["锻炼周内"],"usage":"作谓语、定语；指强加之罪"},{"id":45362,"word":"镂冰劚雪","pinyin":"lòu bīng zhú xuě","abbr":"lbzx","explanation":"比喻构思新颖精巧。","source":{"text":"予唱汝和，无往不复，镂冰劚雪，纂组缤纷。","book":"清·刘大櫆《〈皖江酬唱集〉序》"}},{"id":45363,"word":"镂冰斸雪","pinyin":"lòu bīng zhú xuě","abbr":"lbzx","explanation":"比喻构思新颖精巧。","source":{"text":"予唱汝和，无往不复，镂冰斸雪，纂组缤纷。","book":"清·刘大櫆《皖江酬唱集》序"},"usage":"作定语；用于比喻句"},{"id":45364,"word":"镂冰炊砾","pinyin":"lòu bīng chuī lì","abbr":"lbcl","explanation":"比喻徒劳无益。","source":{"text":"炊沙作糜终不饱，镂冰文字费工巧。","book":"语出宋·黄庭坚《送王郎》诗"},"example":{"text":"楮叶工夫，辛苦似，～。","book":"宋·刘克庄《满江红》词"},"similar":["徒劳无益"],"usage":"作宾语、定语；指徒劳无益"},{"id":45365,"word":"镂冰雕朽","pinyin":"lòu bīng diāo xiǔ","abbr":"lbdx","explanation":"镂、雕：雕刻。雕刻冰块和朽木。比喻劳而无功。","source":{"text":"夫苦心约己，以行无益之事，镂冰雕朽，终无必成之功。","book":"晋·葛洪《抱朴子·论仙》"},"example":{"text":"～，迄用无成。","book":"《北史·儒林传上》"},"similar":["镂尘吹影"],"usage":"作宾语、定语；指劳而无功"},{"id":45366,"word":"镂冰雕琼","pinyin":"lòu bīng diāo qióng","abbr":"lbdq","explanation":"琼：美玉。比喻作品风格明洁或构思新颖精巧。","source":{"text":"刘梦得如镂冰雕琼，流光自照。","book":"明·杨慎《升庵诗话·孙器之评诗》"},"example":{"text":"子安刻意摹拟，词俊而格超，可谓～，心手双绝。","book":"清·陈田《明诗纪事戊签·皇甫涍》"},"usage":"作谓语、定语；指文章构思新颖"},{"id":45367,"word":"镂尘吹影","pinyin":"lòu chén chuī yǐng","abbr":"lccy","explanation":"吹影子，刻尘土。比喻工艺精细到不见形迹。","source":{"text":"言之如吹影，思之如镂尘，圣智造迷，鬼神不识。","book":"《关尹子·一宇》"},"similar":["镂冰雕朽"],"usage":"作宾语、定语；指劳而无功"},{"id":45368,"word":"镂心刻骨","pinyin":"lòu xīn kè gǔ","abbr":"lxkg","explanation":"形容感念深切，难以忘怀。","source":{"text":"妾等蒙陛下眷爱，镂心刻骨，没世难忘。今不幸遭此离乱，陛下欲舍妾身何往？","book":"明·许仲琳《封神演义》第96回"},"example":{"text":"这些东西，我体验很深，可以说是～的。","book":"孙犁《秀露集·文学和生活的路》"},"similar":["刻骨铭心"],"usage":"作谓语、定语；比喻苦心思索"},{"id":45369,"word":"镂心呕血","pinyin":"lòu xīn ǒu xuè","abbr":"lxox","explanation":"比喻苦心构思。","source":{"text":"如许浑辈，皆空吟不学，平生镂心呕血，不过五七言短律而已。","book":"明·杨慎《升庵诗话·假诗》"},"usage":"作谓语；用于作文等"},{"id":45370,"word":"镂心鉥肝","pinyin":"lòu xīn shù gān","abbr":"lxsg","explanation":"比喻苦心钻研。","source":{"text":"夫词于道，艺也。潜学洞古，镂心鉥肝，以蕲鸣一家者，代有之。","book":"张尔田《〈词■（↑艹↓别）〉序》"},"similar":["镂肝鉥肾"],"usage":"作宾语、定语；用于比喻句"},{"id":45371,"word":"镂月裁云","pinyin":"lòu yuè cái yún","abbr":"lycy","explanation":"雕刻月亮，裁剪云彩。比喻手艺极精巧。","source":{"text":"镂月成歌扇，裁云作舞衣。","book":"唐·李义府《堂堂词》"},"example":{"text":"倚声绝艺似珠圆，～过百篇。","book":"清·赵翼《赠张吟芗》"},"usage":"作谓语、定语；比喻手艺极精巧"},{"id":45372,"word":"镂玉裁冰","pinyin":"lòu yù cái bīng","abbr":"lycb","explanation":"比喻构思新颖精美。","source":{"text":"镂玉裁冰著句，高山流水知音。","book":"宋·辛弃疾《西江月·和赵晋臣敷文赋秋水瀑泉》词"},"usage":"作宾语、定语；用于文章或作品等"},{"id":45373,"word":"镂簋朱绂","pinyin":"lòu guǐ zhū fú","abbr":"lgzf","explanation":"镂：刻；簋：盛食物的器具；朱：涂上红彩；绂：古代帽子的系带。用刻有花纹的簋和红色的帽带。形容生活的奢华。","source":{"text":"管仲镂簋朱绂。","book":"宋·司马光《训俭示康》"},"usage":"作谓语、宾语、定语；用于生活"},{"id":45374,"word":"镂肝鉥肾","pinyin":"lòu gān shù shèn","abbr":"lgss","explanation":"比喻苦心钻研。","source":{"text":"■（木丹）廷嗜棋二十年，镂肝鉥肾不论钱。","book":"吴梅《题〈天香石砚室棋谱〉》诗"},"similar":["镂心鉥肾"],"usage":"作宾语、定语；用于比喻句"},{"id":45375,"word":"镂脂翦楮","pinyin":"lòu zhī jiǎn chǔ","abbr":"lzjc","explanation":"雕刻油脂，剪裁楮叶。比喻徒劳无益。","source":{"text":"其人之无成，浮务文藻，镂脂翦楮，何益之有？","book":"清·何绍基《〈使黔草〉自序》"},"usage":"作宾语、定语；用于处事"},{"id":45376,"word":"镂金铺翠","pinyin":"lòu jīn pù cuì","abbr":"ljpc","explanation":"形容缤纷的色彩。","source":{"text":"元·周文质《落梅风》曲：“北高峰离不得三二里，回头看镂金铺翠。”一本作“缕金铺翠”。"},"usage":"作宾语、定语；用于繁华的景色"},{"id":45377,"word":"镂金错彩","pinyin":"lòu jīn cuò cǎi","abbr":"ljcc","explanation":"镂：雕刻；错：涂饰。形容诗文的词藻十分华丽。","source":{"text":"谢诗如芙蓉出水，颜如错彩镂金。","book":"南朝·梁·钟嵘《诗品》卷中"},"example":{"text":"湘中选体，～，玄理固无人能会得些子也。","book":"清·沈曾植《滮湖遗老集序》"},"similar":["错彩镂金"],"usage":"作定语、宾语；形容诗文的词藻十分华丽"},{"id":45378,"word":"镂金错采","pinyin":"lòu jīn cuò cǎi","abbr":"ljcc","explanation":"比喻刻意雕琢文词。","source":{"text":"有意处则情文兼至，姿态横生；无意处虽镂金错采，终觉腻滞可厌。","book":"清·赵翼《瓯北诗话·吴梅村诗》"},"example":{"text":"膏沐谁容，何暇～；朽苴恨晚，宁云扢雅扬风。","book":"清·陈梦雷《拟古十九首》序"},"usage":"作谓语、宾语；用于文章"},{"id":45379,"word":"镂骨铭心","pinyin":"lòu gǔ míng xīn","abbr":"lgmx","explanation":"铭刻在心灵深处。形容记忆深刻，永远不忘。","source":{"text":"追思平昔之指，铭肌镂骨。","book":"北齐·颜之推《颜氏家训·序政》"},"similar":["刻骨铭心","铭心镂骨"],"usage":"作谓语、定语；表示感激之词"},{"id":45380,"word":"镂骨铭肌","pinyin":"lòu gǔ míng jī","abbr":"lgmj","explanation":"比喻牢记不忘。多用为感激之词。","source":{"text":"空怀感涕之心，未获杀身之所，无任感恩思报，镂骨铭肌之至。","book":"北齐·颜之推《颜氏家训·序政》：“追思平昔之指，铭肌镂骨。”唐·元稹《谢准朱书撰田弘正碑文状》"},"example":{"text":"自顶至踵，横嘉惠于不赀；～，怅余年之无几。","book":"宋·陈亮《谢刘丞相启》"},"similar":["刻骨铭心"],"usage":"作宾语、定语；用于比喻句"},{"id":45381,"word":"镇定自若","pinyin":"zhèn dìng zì ruò","abbr":"zdzr","explanation":"指面对灾难时冷静的表现。","source":{"text":"当时女主人公的厄运刚露萌芽，同看电影准备了手帕的女人们还都镇定自若，她便抢先一步哭了。","book":"王朔《过把瘾就死》"},"example":{"text":"他表现出～的样子。"},"similar":["镇定自如"],"opposite":["慌里慌张"],"usage":"作谓语、定语、状语；指人很镇定"},{"id":45382,"word":"镇日镇夜","pinyin":"zhèn rì zhèn yè","abbr":"zrzy","explanation":"整日整夜，日日夜夜。","source":{"text":"他回家之后，便镇日镇夜的蛰居在他那小小的书斋里。","book":"郁达夫《沉沦》"},"example":{"text":"西北风起来了，一切都葬落在愁容的惨淡里，浑河的水还～的流去。","book":"端木蕻良《浑河的急流》"},"similar":["整日整夜"],"usage":"作状语；指整天"},{"id":45383,"word":"镌心铭骨","pinyin":"juān xīn míng gǔ","abbr":"jxmg","explanation":"镌：雕刻。意同“刻骨铭心”。形容永记不忘。","source":{"text":"漂泊留潭府，荷深思解衣推食，自知惭负；又荷吹嘘登云路，娇女肯教同赴，这厚德镌心铭骨。","book":"明·陆采《明珠记·获荫》"},"similar":["刻骨铭心"],"usage":"作谓语、定语；形容印象深刻"},{"id":45384,"word":"镌空妄实","pinyin":"juān kōng wàng shí","abbr":"jkws","explanation":"犹言凭空穿凿，不切实际。","source":{"text":"切不可闭门合目，作镌空妄实之想也。","book":"宋·曾敏行《独酷杂志》"},"usage":"作谓语、定语；指人的言行等"},{"id":45385,"word":"镌脾琢肾","pinyin":"juān pí zhuó shèn","abbr":"jpzs","explanation":"指精心构思，刻意雕琢文辞。","source":{"text":"独念近世以来，其以文章鸣世者，追逐时趋，日就衰坏，独足下镌脾琢肾，辞出于己，淘汰净尽。","book":"清·刘大櫆《与王君书》"},"similar":["精雕细琢"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":45386,"word":"镌骨铭心","pinyin":"juān gǔ míng xīn","abbr":"jgmx","explanation":"镌：雕刻；铭：刻写。指牢牢记在心上。","source":{"text":"吾国对日关系之痛史，宜镌骨铭心，纪其深仇大辱者，有三事焉：曰甲午，曰甲辰，曰甲寅。","book":"李大钊《国民之薪胆》"},"similar":["刻骨铭心"],"usage":"作谓语、定语；形容印象深刻"},{"id":45387,"word":"镕今铸古","pinyin":"róng jīn zhù gǔ","abbr":"rjzg","explanation":"融会贯通古今知识。"},{"id":45388,"word":"镕古铸今","pinyin":"róng gǔ zhù jīn","abbr":"rgzj","explanation":"融会贯通古今知识。同“镕今铸古”。"},{"id":45389,"word":"镜分鸾凤","pinyin":"jìng fēn luán fèng","abbr":"jflf","explanation":"比喻夫妻分离。","source":{"text":"文场选士，纷纷都是才俊徒，少甚么镜分鸾凤。","book":"元·高明《琵琶记·临妆感叹》"},"usage":"作宾语、定语；用于夫妻离散等","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至长安，找到卖破镜的妻子，夫妻团聚"]},{"id":45390,"word":"镜台自献","pinyin":"jìng tái zì xiàn","abbr":"jtzx","explanation":"自己把梳妆台奉献出来。比喻自己做媒。","source":{"text":"却后少日，公报姑云，已觅得婚处，门地粗可，婿身名宦，尽不减峤，因下玉镜台一枚。姑大喜。","book":"南朝·宋·刘义庆《世说新语·假谲》"},"example":{"text":"闻有女公子，未遭良匹，窃不自揣，愿以～。","book":"清·蒲松龄《聊斋志异·辛十四娘》"}},{"id":45391,"word":"镜圆璧合","pinyin":"jìng yuán bì hé","abbr":"jybh","explanation":"比喻圆满。","source":{"text":"乞万岁开一线之恩，赐归皇甫，俾使患难婚姻遂得镜圆璧合。","book":"清·陈瑞生《再生缘》第72回"},"usage":"作宾语、定语；用于比喻句"},{"id":45392,"word":"镜破钗分","pinyin":"jìng pò chāi fēn","abbr":"jpcf","explanation":"比喻夫妻失散、离异。","source":{"text":"惟将旧物表深情，钿合金钗寄将去。钗留一股合一扇，钗擘黄金合分钿。","book":"南朝·陈·徐德言《破镜》诗：“镜与人俱去，镜归人未归，当复姮娥影，空留明月辉。”唐·白居易《长恨歌》"},"example":{"text":"～，粉消香褪，萦方寸，酒美花新，总是思家恨。","book":"元·无名氏《梧桐叶》第一折"},"similar":["破镜分钗"],"opposite":["破镜重圆"],"usage":"作宾语、定语、状语；指夫妻离异","story":["南朝陈将要灭亡时，驸马徐德言与妻乐昌公主估计不能相保，就将铜镜一分为二，双方各执一半分开行动，相约于正月十五日当街卖破镜来取得联系。陈朝灭亡，妻没入杨素家。到期，徐德言辗转依约至长安，找到卖破镜的妻子，夫妻团聚"]},{"id":45393,"word":"镜花水月","pinyin":"jìng huā shuǐ yuè","abbr":"jhsy","explanation":"镜里的花，水里的月。原指诗中灵活而不可捉摸的意境，后比喻虚幻的景象。","source":{"text":"峥嵘栋梁，一旦而摧。水月镜像，无心去来。","book":"唐·裴休《唐故左街僧录内供奉三教谈论引驾大德安国寺上座赐紫方袍大达法师元秘塔碑铭》"},"example":{"text":"我喜欢那种锤炼，那种色彩的配合，那种～。","book":"何其芳《梦中道路》"},"similar":["海市蜃楼","空中楼阁"],"usage":"作主语、宾语、定语；指虚幻的景象"},{"id":45394,"word":"镜里恩情","pinyin":"jìng lǐ ēn qíng","abbr":"jleq","explanation":"指夫妻恩情成了镜中的幻影，空有其名。泛指经不起考验的、虚有其表的感情。","source":{"text":"镜里恩情，更那堪梦里功名。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":45395,"word":"镜里观花","pinyin":"jìng lǐ guān huā","abbr":"jlgh","explanation":"镜子里头看花。指虽看得见，却得不到或摸不着。","source":{"text":"我劝谏他似水里纳瓜，他看觑咱如镜里观花。","book":"元·乔孟符《两世姻缘》第三折"},"similar":["镜里采花"],"usage":"作宾语、定语；指能看到而得不到"},{"id":45396,"word":"镜里采花","pinyin":"jìng lǐ cǎi huā","abbr":"jlch","explanation":"指虽看得见，却得不到或摸不着。同“镜里观花”。","source":{"text":"竹篮子打水，镜里采花，抓不着他。","book":"《白雪遗音·无楼梯儿》"},"similar":["镜里观花"],"usage":"作宾语、定语；指能看到而得不到"},{"id":45397,"word":"镞砺括羽","pinyin":"zú lì kuò yǔ","abbr":"zlky","explanation":"比喻人刻苦磨练，力求精进。镞砺，磨砺箭头；括羽，用羽毛装束箭尾。","source":{"text":"子路曰：‘南山有竹，不柔自直，斩而用之，达于犀革。以此言之，何学之有？’孔子曰：‘括而羽之，镞而砺之，其入之不亦深乎？’","book":"语本《孔子家语·子路初见》"},"example":{"text":"于是有切磋琢磨～之道，圣人以为重。","book":"唐·柳宗元《送豆卢膺秀才南游序》"},"usage":"作谓语、定语；指人努力上进"},{"id":45398,"word":"长七短八","pinyin":"cháng qī duǎn bā","abbr":"cqdb","explanation":"指事情的头绪。","source":{"text":"康顺风一边点头，一边结结巴巴的央求，喉咙里像塞了一团棉花，半天也没说下个长七短八。","book":"马烽《吕梁英雄传》第16回"},"usage":"作宾语；指事情的头绪"},{"id":45399,"word":"长久之计","pinyin":"cháng jiǔ zhī jì","abbr":"cjzj","explanation":"计：计划，策略。长远的打算。","source":{"text":"东垂被虐耗之害，关中有无聊之民，非长久之计。","book":"《战国策·赵策》：“岂非计久长，有子孙相继为王也哉。”《汉书·元帝纪》"},"example":{"text":"《战国策·赵策》：“岂非计久长，有子孙相继为王也哉。”《汉书·元帝纪》：“东垂被虐耗之害，关中有无聊之民，非长久之计。”"},"similar":["持久之计"],"usage":"作宾语；指长远的打算"},{"id":45400,"word":"长乐未央","pinyin":"cháng lè wèi yāng","abbr":"clwy","explanation":"未央：未尽。长久欢乐，永不结束。","source":{"text":"未央：未尽。长久欢乐，永不结束。"},"example":{"text":"我们希望过～的日子。"},"similar":["欢乐无比"],"usage":"作谓语；指长久欢乐"},{"id":45401,"word":"长乐永康","pinyin":"cháng lè yǒng kāng","abbr":"clyk","explanation":"吉祥的颂词。欢乐无穷，永远健康。","source":{"text":"万物备俱，长乐无忧。","book":"汉·焦延寿《易林》"}},{"id":45402,"word":"长亭短亭","pinyin":"cháng tíng duǎn tíng","abbr":"ctdt","explanation":"古时设在路旁的亭舍，常用为饯别处。也指旅程遥远。","source":{"text":"十里五里，长亭短亭。","book":"北周·庾信《哀江南赋》"},"example":{"text":"何处是归程，长亭更短亭。","book":"唐·李白《菩萨蛮》词"},"usage":"作宾语、定语；指旅程遥远"},{"id":45403,"word":"长他人威风，灭自己志气","pinyin":"zhǎng tā rén wēi fēng，miè zì jǐ zhì qì","abbr":"ztrwfmzjzq","explanation":"长：助长。指助长别人的声势，轻视自己的力量。","source":{"text":"这原是国货，何苦违背民族主义，引用外国的学说和事实——长他人威风，灭自己志气呢？","book":"鲁迅《同意和解释》"},"similar":["长别人志气，灭自己威风"],"usage":"作谓语、宾语、定语；用于处事"},{"id":45404,"word":"长他人志气，灭自己威风","pinyin":"zhǎng tā rén zhì qì，miè zì jǐ wēi fēng","abbr":"ztrzqmzjwf","explanation":"指一味助长别人的声势，而看不起自己的力量。","source":{"text":"你两个闭了鸟嘴！长别人志气，灭自己威风。","book":"明·吴承恩《西游记》第三十三回：“众怪上前道：‘大王，怎么长他人志气，灭自己威风 ？'”明·施耐庵《水浒传》第二回"},"example":{"text":"倒塔鬼爆跳如雷道：“你只～。”","book":"《何典》第十回"},"similar":["长他人锐气，灭自己威风"],"usage":"作宾语、定语；用于处事"},{"id":45405,"word":"长他人锐气，灭自己威风","pinyin":"zhǎng tā rén ruì qì，miè zì jǐ wēi fēng","abbr":"ztrrqmzjwf","explanation":"长：助长。指助长别人的声势，轻视自己的力量。","source":{"text":"吾何畏彼哉，公等休长他人锐气，灭自己威风。","book":"明·罗贯中《三国演义》第110回"},"similar":["长别人志气，灭自己威风"],"usage":"作谓语、宾语、定语；用于处事"},{"id":45406,"word":"长傲饰非","pinyin":"zhǎng ào shì fēi","abbr":"zasf","explanation":"滋长骄傲、掩饰过错。","source":{"text":"怙恶不悛，长傲饰非者，古下愚不肖之流。","book":"清·陈确《答张考夫书》"},"usage":"作谓语、定语、宾语；用于处世"},{"id":45407,"word":"长别人志气，灭自己威风","pinyin":"zhǎng bié rén zhì qì，miè zì jǐ wēi fēng","abbr":"zbrzqmzjwf","explanation":"长：助长。指助长别人的声势，轻视自己的力量。","source":{"text":"你两个闭了鸟嘴！长别人志气，灭自己威风。","book":"明·施耐庵《水浒传》第二回"},"similar":["长他人威风，灭自己志气"],"usage":"作谓语、宾语、定语；用于处事"},{"id":45408,"word":"长发其祥","pinyin":"cháng fā qí xiáng","abbr":"cfqx","explanation":"简称发祥。经常有吉祥发达的事情降临。后用为事业发达的吉利话。","source":{"text":"濬哲惟商，长发其祥。","book":"《诗经·商颂·长发》"}},{"id":45409,"word":"长吁短叹","pinyin":"cháng xū duǎn tàn","abbr":"cxdt","explanation":"吁：叹息。长一声、短一声不住地叹气。形容发愁的神情。","source":{"text":"短叹长吁三两声。","book":"《乐府群珠·无名氏＜金字经＞》"},"example":{"text":"少可有一万声～ ，五千遍捣枕槌床。","book":"元·王实甫《西厢记》第一本第二折"},"similar":["唉声叹气","喟然而叹"],"opposite":["欢歌笑语"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":45410,"word":"长吁短气","pinyin":"cháng xū duǎn qì","abbr":"cxdq","explanation":"指叹息不已。","source":{"text":"你家这门馆先生，自从我在学堂中一个月，不曾教我一句书，终日只是长吁短气，不知为何。","book":"元·乔吉《金钱记》第三折"},"similar":["长吁短叹","长嘘短叹"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":45411,"word":"长命富贵","pinyin":"cháng mìng fù guì","abbr":"cmfg","explanation":"既长寿又富裕显贵。","source":{"text":"经云：‘求长命得长命，求富贵得富贵。’","book":"《旧唐书·姚崇传》"},"example":{"text":"原来是一根桃符，上写着～，这杀人贼有了也。","book":"元·郑庭玉《后庭花》第四折"},"usage":"作谓语、宾语；形容长寿与富贵"},{"id":45412,"word":"长命百岁","pinyin":"cháng mìng bǎi suì","abbr":"cmbs","explanation":"寿命很长，能活到一百岁。常用作祝福长寿之词。","source":{"text":"这厮淡则淡到长命百岁。","book":"元·无名氏《蓝采和》第四折"},"example":{"text":"你怕死，你～的活着，好不好？（清·曹雪芹《红楼梦》第二十回）"},"similar":["长生不老"],"usage":"作谓语、宾语；用于祝福"},{"id":45413,"word":"长啜大嚼","pinyin":"cháng chuò dà jué","abbr":"zcdj","explanation":"形容狂饮暴食。","source":{"text":"民皇甫及年十四，暴长七尺余，长啜大嚼，三倍如初，岁余死。","book":"《新唐书·五行志三》"}},{"id":45414,"word":"长嘘短叹","pinyin":"cháng xū duǎn tàn","abbr":"cxdt","explanation":"长声、短声不住地叹息不止","source":{"text":"他将御案上的文书一推，不由地长嘘短叹，喃喃自语说：‘饷呵，饷呵，没有饷这日子如何撑持？’","book":"姚雪垠《李自成》第二卷第29章"},"similar":["长吁短叹","短叹长吁"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":45415,"word":"长嘘短气","pinyin":"cháng xū duǎn qì","abbr":"zxdq","explanation":"长声、短声不住地叹息不止。","example":{"text":"靠～是解决不了问题的。"},"similar":["长吁短气","长嘘短叹"],"usage":"作谓语、宾语、状语；用于人不如意时"},{"id":45416,"word":"长城万里","pinyin":"cháng chéng wàn lǐ","abbr":"ccwl","explanation":"指中国长城。比喻国家所依赖的大将或军队。","source":{"text":"长城万里知谁许，看镜空悲两鬓霜。","book":"宋·陆游《休日留园中至暮乃归》"},"similar":["万里长城"],"usage":"作主语、宾语、定语；指长城"},{"id":45417,"word":"长夜之饮","pinyin":"cháng yè zhī yǐn","abbr":"cyzy","explanation":"指通宵宴饮。","source":{"text":"齐威王之时喜隐，好为淫乐长夜之饮。","book":"《史记·滑稽列传》"},"example":{"text":"有时上皇妆吃化贫子，行乞于中，以取其乐，又为～，以宵达旦。","book":"《大宋宣和遗事》亨集"},"usage":"作主语、宾语；指通宵宴饮"},{"id":45418,"word":"长夜漫漫","pinyin":"cháng yè màn màn","abbr":"cymm","explanation":"漫漫：无边际的样子。漫长的黑夜无边无际。多用来比喻社会的黑暗。","source":{"text":"生不逢尧与舜禅，短布单衣才至骭，从昏饭牛薄夜半，长夜漫漫何时旦。","book":"《古诗源·宁戚〈饭牛歌〉》"},"example":{"text":"鸡啼呢，就好：～何时旦？当你在旅床上辗转不寐，风雨夜雷电交迫的时候，啼鸡一声，就有了盼头了。","book":"吴伯萧《啼晓鸡》"},"similar":["漫漫长夜"],"usage":"作宾语、定语；指夜或比喻社会","story":["春秋时期，齐桓公派管仲去接陈国和曹国的军队联合讨伐宋国。管仲路上遇到了放牛娃宁戚，宁戚骑牛唱道：“生不逢尧与舜禅，短布单衣才至骭，从昏饭牛薄夜半，长夜漫漫何时旦。”齐桓公见他有学问就任他为大夫"]},{"id":45419,"word":"长夜难明","pinyin":"cháng yè nán míng","abbr":"cynm","explanation":"漫长的黑夜难以见到光明。比喻漫长的黑暗统治。","source":{"text":"长夜难明赤县天，百年魔怪舞翩跹，人民五亿不团圆。","book":"毛泽东《浣溪沙·和柳亚子先生》词"},"example":{"text":"在这～的岁月里，真理也会被掩盖的。"},"similar":["长夜漫漫"],"usage":"作宾语、定语；比喻黑暗统治"},{"id":45420,"word":"长天老日","pinyin":"cháng tiān lǎo rì","abbr":"ctlr","explanation":"指夏至及以后的一段时间里的白天，这段时间是夏季昼长的日子。","source":{"text":"你也去，连你母亲也去，长天老日的，在家里也是睡觉。","book":"清·曹雪芹《红楼梦》第二十九回"},"usage":"作宾语、定语；用于口语"},{"id":45421,"word":"长娇美人","pinyin":"cháng jiāo měi rén","abbr":"zjmr","explanation":"娇：美好。身材修长容颜娇好的美女。","source":{"text":"前有楼阙轩辕，后有长娇美人。","book":"西汉·司马迁《史记·苏秦传》"},"usage":"作主语、宾语；用于女性"},{"id":45422,"word":"长安少年","pinyin":"cháng ān shào nián","abbr":"casn","explanation":"旧指都城里豪奢轻狂的贵家子弟。","source":{"text":"燕姬越女，巧自衒鬻于春风之前，冀长安少年，为之一顾。","book":"明·宋濂《序》"},"example":{"text":"游人坌集，士女如云，～多驰骤车马以为乐。","book":"清·富察敦崇《燕京岁时记·大钟寺》"},"usage":"作主语、宾语、定语；用于人"},{"id":45423,"word":"长安居大不易","pinyin":"cháng ān jū dà bù yì","abbr":"cajdby","explanation":"本为唐代诗人顾况以白居易的名字开玩笑。后比喻居住在大城市，生活不容易维持。","source":{"text":"白尚书应举，初至京，以诗谒著作顾况，顾睹姓名，熟视白公曰：‘米价方贵，居亦弗易。’","book":"唐·张固《幽闲鼓吹》"},"example":{"text":"惟是～，乃知囊内钱空，始觉旧游如梦。","book":"清·宣鼎《夜雨秋灯录·记李三三逸事"},"usage":"作宾语；用于感慨人生"},{"id":45424,"word":"长安棋局","pinyin":"cháng ān qí jú","abbr":"caqj","explanation":"比喻动荡不定的政局。","source":{"text":"闻道长安似弈棋，百年世事不胜悲。","book":"唐·杜甫《秋兴》诗之四"},"example":{"text":"～几时休，蕉萃行吟客子愁。","book":"柳亚子《题芷畦燕游续草》诗"},"usage":"作主语、宾语；形容动荡不安的政局"},{"id":45425,"word":"长安道上","pinyin":"cháng ān dào shàng","abbr":"cads","explanation":"长安：古都名，在今陕西西安西北。旧喻名利场所。","source":{"text":"长安道上行客，依旧利深名切。","book":"五代·无名氏《贺圣朝》词"},"usage":"作宾语、定语；指名利场所"},{"id":45426,"word":"长年三老","pinyin":"zhǎng nián sān lǎo","abbr":"znsl","explanation":"古时指船工。","source":{"text":"长年三老遥怜汝，捩舵开头捷有神。","book":"唐·杜甫《拨闷》诗"},"example":{"text":"问：何谓长年三老？云：梢公是也。","book":"宋·陆游《入蜀记》五"},"usage":"作主语、宾语、定语；指船工"},{"id":45427,"word":"长年累月","pinyin":"cháng nián lěi yuè","abbr":"cnly","explanation":"长年：整年；累月：很多个月。形容经过了很多年月。","source":{"text":"高缨《云崖初暖》：“她连一眼也不看那长年累月死尸般坐在火塘边的阿侯蛤嫫。”长年：整年；累月：很多个月。形容经过了很多年月。"},"example":{"text":"～的埋伏与周旋，把游击战争与秘密工作结合在一起。","book":"陈毅《十年》诗"},"similar":["天长日久","久而久之"],"opposite":["一朝一夕","一时一刻"],"usage":"作宾语、定语、状语；形容时间很长"},{"id":45428,"word":"长幼尊卑","pinyin":"zhǎng yòu zūn bēi","abbr":"zyzb","explanation":"指辈分大小，地位高低。","source":{"text":"所以官序贵贱各得其宜也，所以示后世有尊卑长幼之序也。","book":"《礼记·乐记》"},"example":{"text":"部队是最讲究～的。一般都是官衔高的首长谦虚地说：你们就叫我老某好了，透出官兵一致的亲热。其实谁敢叫他老某呢？","book":"毕淑敏《最后一支西地兰》一"},"usage":"作宾语、定语；用于人的辈分"},{"id":45429,"word":"长幼有叙","pinyin":"zhǎng yòu yǒu xù","abbr":"zyyx","explanation":"指年长者和年幼者之间的先后尊卑。亦作“长幼有序”。","source":{"text":"圣人有忧之，使契为司徒，教以人伦，父子有亲，君臣有义，夫妇有别，长幼有叙，朋友有信。","book":"《孟子·滕文公上》"}},{"id":45430,"word":"长幼有序","pinyin":"zhǎng yòu yǒu xù","abbr":"zyyx","explanation":"指年长者和年幼者之间的先后尊卑。同“长幼有叙”。","source":{"text":"人类的大伦有五，故又称五伦，就是父子有亲，君臣有义，夫妇有别，长幼有序，朋友有信。","book":"丁寅生《孔子演义》第73回"},"example":{"text":"～的风气自然而然地形成。"},"opposite":["没大没小"],"usage":"作定语、状语；用于处世"},{"id":45431,"word":"长往远引","pinyin":"cháng wǎng yuǎn yǐn","abbr":"cwyy","explanation":"指引身远行，一去不返。","source":{"text":"兹又奉圣母申命之颁，耿耿孤忠，宁敢自负。但臣今日所祈，非欲长往远引，忍于背违者也。","book":"明·张居正《再乞归葬疏》"},"usage":"作谓语、定语；用于人或事物"},{"id":45432,"word":"长念却虑","pinyin":"cháng niàn què lǜ","abbr":"cnql","explanation":"思前顾后，反覆考虑。却，后。","source":{"text":"人小乘非位，莫不恍忽失守，偷安日日，独能长念却虑，父子作权，近取于户牖之间，况诛猾臣，为君讨贼。","book":"《史记·秦始皇本记》"},"similar":["思前想后"],"usage":"作谓语、宾语；用于考虑事情等"},{"id":45433,"word":"长恶不悛","pinyin":"cháng è bù quān","abbr":"cebq","explanation":"指长期作恶，不肯悔改。","source":{"text":"善不可失，恶不可长，其陈桓公之谓乎，长恶不悛，从自及也。","book":"《左传·隐公六年》"},"example":{"text":"其有久为头首，累受招安，～，及杀人众多，情理巨蠹之人，自合依旧处死。","book":"宋·李纲《申省措置酌情处断招降盗贼状》"},"similar":["长恶靡悛"],"usage":"作谓语、定语；用于坏人"},{"id":45434,"word":"长恶靡悛","pinyin":"cháng è mǐ quān","abbr":"cemq","explanation":"指长期作恶，不肯悔改。","source":{"text":"朕以许其改过，乃诏班师，而长恶靡悛，宴安鸩毒，此而可忍，孰不可容！","book":"《隋书·炀帝纪下》"},"similar":["长恶不悛"],"usage":"作谓语、定语；用于坏人"},{"id":45435,"word":"长戟高门","pinyin":"cháng jǐ gāo mén","abbr":"cjgm","explanation":"门庭高大，门内列戟。形容旧时显贵人家的威仪。","source":{"text":"门庭高大，门内列戟。形容旧时显贵人家的威仪。"},"opposite":["蓬门筚户"],"usage":"作宾语、定语；用于权贵之家"},{"id":45436,"word":"长才广度","pinyin":"cháng cái guǎng dù","abbr":"ccgd","explanation":"指才能出众器量宏大的人。","source":{"text":"然使长才广度，无所不淹，而能不营，乃可贵耳。","book":"三国·魏·嵇康《与山巨源绝交书》"},"usage":"作宾语、定语；用于书面语"},{"id":45437,"word":"长才短驭","pinyin":"cháng cái duǎn yù","abbr":"ccdy","explanation":"犹言大才小用。","source":{"text":"又蒙洪提督保举，调回广东，以为有些好处，谁想只受大南门把总之职。所谓长才短驭，好不令人愤恨。","book":"清·新广东武生《黄萧养回头》"},"similar":["大材小用"],"usage":"作宾语、定语；同“大材小用”"},{"id":45438,"word":"长揖不拜","pinyin":"cháng yī bù bài","abbr":"cybb","explanation":"揖、拜：旧时的拱手、磕头礼。对长者或尊者只弯腰行拱手礼，不跪拜磕头。旧时指相见时态度不恭，为人高傲。","source":{"text":"沛公方倨床，使两女子洗足。郦生长揖不拜。","book":"《史记·高祖本纪》"},"example":{"text":"王趋见，未至，使者三四往。及见，～。","book":"明·宋廉《尊卢沙》"},"similar":["不卑不亢"],"usage":"作谓语、宾语；用于相见时"},{"id":45439,"word":"长斋礼佛","pinyin":"cháng zhāi lǐ fó","abbr":"czlf","explanation":"长斋：终年吃素。吃长斋于佛像之前。形容修行信佛。","source":{"text":"苏晋长斋绣佛前，醉中往往爱逃禅。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"有位姓尹的妈妈，年纪已在五十以上。一人孤居，～。","book":"郭沫若《牧羊哀话》"},"similar":["长斋绣佛"],"usage":"作宾语；形容信佛修行"},{"id":45440,"word":"长斋绣佛","pinyin":"cháng zhāi xiù fó","abbr":"czxf","explanation":"长斋：终年吃素；绣佛：刺绣的佛像。吃长斋于佛像之前。形容修行信佛。","source":{"text":"苏晋长斋绣佛前，醉中往往爱逃禅。","book":"唐·杜甫《饮中八仙歌》"},"example":{"text":"他好～，归依佛门。"},"similar":["长斋礼佛"],"usage":"作宾语；形容修行信佛"},{"id":45441,"word":"长春不老","pinyin":"cháng chún bù lǎo","abbr":"ccbl","explanation":"犹言长生不老。","source":{"text":"各要寻几件希奇礼物上寿，祝他个长春不老。","book":"《醒世恒言·李道人独步云门》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第83回：“奴才只有天天多烧几炉香，叩祝恩帅～罢了。”"},"similar":["长生不老"],"usage":"作谓语、定语；指长久生存，永不衰老"},{"id":45442,"word":"长期打算","pinyin":"cháng qī dǎ suàn","abbr":"cqds","explanation":"长远的谋划。","source":{"text":"必须十分爱惜当地的人力物力，任何地方都要作长期打算，避免滥用和浪费。","book":"毛泽东《论联合政府》"},"example":{"text":"我只好作～了。"},"similar":["长久之计"],"usage":"作主语、宾语、定语；用于谋划"},{"id":45443,"word":"长材小试","pinyin":"cháng cái xiǎo shì","abbr":"ccxs","explanation":"犹言大材小用。","source":{"text":"运贩生涯，锱铢贱业，教俺长材小试，无聊之极。","book":"清·浴日生《海国英雄记·航海》"},"similar":["长才短驭","大材小用"],"usage":"作宾语、定语；同“大材小用”"},{"id":45444,"word":"长材短用","pinyin":"cháng cái duǎn yòng","abbr":"zcdy","explanation":"指人不能充分发挥才能，物不能充分得到利用。","source":{"text":"看此歌妓，声容俱佳，岂可长材短用，还派作正旦罢。","book":"清·孔尚任《桃花扇·选优》"}},{"id":45445,"word":"长材茂学","pinyin":"cháng cái mào xué","abbr":"ccmx","explanation":"指才能高学问大的人。","source":{"text":"开局秉笔，固皆一代之长材茂学，必有所见广圣意者。","book":"明·归有光《嘉靖庚子科乡试对策》之一"},"usage":"作宾语、定语；用于有才学的人"},{"id":45446,"word":"长枕大衾","pinyin":"cháng zhěn dà qīn","abbr":"czdq","explanation":"比喻兄弟友爱。","source":{"text":"唐明皇于诸王为长枕大衾，虽甚亲爱，亦是无以限制之，无足观者。","book":"《朱子语类》卷五八"},"similar":["长枕大被","大衾长枕"],"usage":"作谓语、宾语、定语；比喻兄弟友爱"},{"id":45447,"word":"长枕大被","pinyin":"cháng zhěn dà bèi","abbr":"czdb","explanation":"长形的枕头，宽大的被褥。比喻兄弟友爱。也比喻夫妻关系和谐融洽。","source":{"text":"玄宗为太子，尝制大衾长枕，将与诸王共之。","book":"汉·蔡邕《协和婚赋》：“长枕横施，大被竟床；莞蒻和软，茵褥调良。”《新唐书·让皇帝宪传》"},"example":{"text":"家弟伟夫，筮仕恩平，去家七千里，音书间隔，至终岁不得一达，～，宁复容易乎。","book":"清·佟世思《鲊鱼序》"},"similar":["同床共枕","长枕大衾"],"opposite":["同床异梦"],"usage":"作谓语、宾语、定语；比喻兄弟友爱"},{"id":45448,"word":"长林丰草","pinyin":"cháng lín fēng cǎo","abbr":"clfc","explanation":"幽深的树林，茂盛的野草。指禽兽栖止的山林草野，旧常喻隐居之地。","source":{"text":"虽饰以金镳、飨以嘉肴，逾思长林而志在丰草也。","book":"晋·稽康《与山巨源绝交书》"},"example":{"text":"所以在风尘劳攘的时候，每怀～之思，而今却可赋《遂初》了。","book":"清·吴敬梓《儒林外史》第八回"},"similar":["草木茂盛","丰草长林"],"opposite":["不毛之地"],"usage":"作主语、宾语；比喻隐居之地"},{"id":45449,"word":"长歌代哭","pinyin":"cháng gē dài kū","abbr":"zgdk","explanation":"长歌：放声歌咏，借指写诗文。用放声歌咏来代替痛哭泣，借以抒发胸中的悲愤。","source":{"text":"手挽一章，亦长歌代哭之意。","book":"清·秋瑾《挽故人陈阙生》序"},"similar":["长歌当哭"],"usage":"作定语；形容借歌抒情"},{"id":45450,"word":"长歌当哭","pinyin":"cháng gē dàng kū","abbr":"cgdk","explanation":"长歌：长声歌咏，也指写诗；当：当作。用长声歌咏或写诗文来代替痛哭，借以抒发心中的悲愤。","source":{"text":"悲歌可以当泣，远望可以当归。","book":"宋·郭茂倩《乐府诗集·杂曲歌辞·悲歌》"},"example":{"text":"感怀触绪，聊赋四章，匪曰无故呻吟，亦～之意耳。","book":"清·曹雪芹《红楼梦》第八十七回"},"similar":["长歌代哭"],"usage":"作主语、定语；形容借歌抒情"},{"id":45451,"word":"长此以往","pinyin":"cháng cǐ yǐ wǎng","abbr":"ccyw","explanation":"长期这样下去。","source":{"text":"倘长此以往，恐怕要日见其荒凉。","book":"鲁迅《书信集·致张廷谦》"},"example":{"text":"坚卓者无不灭亡，游移者愈益堕落，～，将使中国无一好人。","book":"鲁迅《书信集·致曹聚仁》"},"similar":["久而久之","长年累月","天长地久"],"opposite":["一时半刻"],"usage":"作分句、状语；指时间久了会有不好的结果"},{"id":45452,"word":"长江后浪催前浪","pinyin":"cháng jiāng hòu làng cuī qián làng","abbr":"zjhlcql","explanation":"比喻事物的不断前进。多指新人新事代替旧人旧事","source":{"text":"人有什么意思，长江后浪催前浪，一辈新人赶旧人。","book":"清·石玉昆《小五义》第108回"},"similar":["长江后浪推前浪"],"usage":"作宾语、分句；指人或事情"},{"id":45453,"word":"长江后浪推前浪","pinyin":"cháng jiāng hòu làng tuī qián làng","abbr":"cjhltql","explanation":"比喻事物的不断前进。多指新人新事代替旧人旧事。","source":{"text":"我闻古人之诗曰：‘长江后浪推前浪，浮事新人换旧人。’","book":"宋·刘斧《青琐高议》"},"example":{"text":"这叫做～，一代更比一代强嘛。","book":"张明礼《孙女考爷爷》"},"similar":["后浪推前浪"],"usage":"作宾语、分句；指人或事情"},{"id":45454,"word":"长江大河","pinyin":"cháng jiāng dà hé","abbr":"cjdh","explanation":"指长江和黄河。形容气势磅礴，奔腾不息。","source":{"text":"韩子之文，如长江大河，浑浩流转。","book":"宋·苏洵《上欧阳内翰书》"},"usage":"作主语、宾语、定语；指长江和黄河"},{"id":45455,"word":"长江天堑","pinyin":"cháng jiāng tiān qiàn","abbr":"cjtq","explanation":"堑：壕沟。长江为天然的坑堑、险要。旧时形容长江地势险要，不可逾越。","source":{"text":"隋师将济江，群官请为备防，范奏曰：‘长江天堑，古来险隔，虏军岂能飞渡？’","book":"《南史·孙范传》"},"example":{"text":"占据江南八郡，隔着～，双比淮西差多少来去。","book":"明·施耐庵《水浒全传》第一百十回"},"similar":["长江天险"],"usage":"作宾语；形容长江"},{"id":45456,"word":"长江天险","pinyin":"cháng jiāng tiān xiǎn","abbr":"zjtx","explanation":"长江为天然的壕沟。形容长江地势险要，不可逾越。","source":{"text":"南阳密迩中原，易以号召四方；又有长江天险，可以固守。","book":"《新刊大宋宣和遗事》"},"example":{"text":"以为～不可突破，他们就押这个宝。","book":"邓小平《从渡江到占领上海》"},"similar":["长江天堑","天堑长江"],"usage":"作宾语、定语；形容长江"},{"id":45457,"word":"长治久安","pinyin":"cháng zhì jiǔ ān","abbr":"czja","explanation":"治：太平；安：安定。形容国家长期安定、巩固。","source":{"text":"建久安之势，成长治之业。","book":"《汉书·贾谊传》"},"example":{"text":"要维持民族和国家的长久地位，还有道德问题，有了很好的道德，国家才能～。","book":"孙中山《民族主义第六讲》"},"similar":["天下太平"],"opposite":["动荡不安","天下大乱"],"usage":"作宾语、定语；形容社会长期安宁"},{"id":45458,"word":"长生不死","pinyin":"cháng shēng bū sǐ","abbr":"csbs","explanation":"生命长存，永不死亡。","source":{"text":"长生不死，以此责圣人，何其多乎？","book":"晋·葛洪《抱朴子·辨问》"},"example":{"text":"真所谓杀身成仁者也，其视死生如黑暮，不尔安能为哉？而反欲学～。","book":"宋·胡仔《苕溪渔隐丛话后集·山谷》"},"similar":["长生不灭"],"usage":"作谓语、定语、宾语；同“长生不老”"},{"id":45459,"word":"长生不灭","pinyin":"cháng shēng bù miè","abbr":"zsbm","explanation":"生命长存，形体不消灭。","source":{"text":"你二人跟我出家，长生不灭。","book":"元·贾仲文《金童玉女》第一折"},"similar":["长生不死"],"usage":"作谓语、定语、宾语；同“长生不老”"},{"id":45460,"word":"长生不老","pinyin":"cháng shēng bù lǎo","abbr":"csbl","explanation":"长生：永生。原为道教的话，后也用作对年长者的祝愿语。","source":{"text":"天一生水，人同自然，肾为北极之枢，精食万化，滋养百骸，赖以永年而长生不老。","book":"《太上纯阳真经·了三得一经》"},"example":{"text":"逍遥自在，超为上仙。正是：玉室丹书著姓，～人家。","book":"明·洪楩《清平山堂话本·蓝桥记》"},"similar":["长生久视","长生不灭"],"opposite":["昙花一现"],"usage":"作谓语、定语；指长久生存，永不衰老","story":["西汉时期，淮南王刘安喜欢求仙问道，他潜心钻研，四处派人打听返老还童之术，访寻长生不老之药，一天一个白发老翁求见，说有返老还童之术，刘安认为老汉不可能有法术，就打发他走，只见一眨眼功夫，老汉就变成了儿童"]},{"id":45461,"word":"长生久视","pinyin":"cháng shēng jiǔ shì","abbr":"csjs","explanation":"久视：不老，耳目不衰。形容长寿。","source":{"text":"有国之母，可以长久，是谓深根固祗，长生久视之道。","book":"《老子》五十九章"},"example":{"text":"岂比尔道者之言，拘拘乎养此幻躯，惟求～，作漏世之精也耶！","book":"明·赵弼《两教辨》"},"similar":["长生不老"],"usage":"作谓语、定语；指长久活下去"},{"id":45462,"word":"长痛不如短痛","pinyin":"cháng tòng bù rú duǎn tòng","abbr":"ztbrdt","explanation":"长期痛苦还不如短期痛苦。指果断处事。","source":{"text":"我赞成应春先生的办法，长痛不如短痛。","book":"高阳《胡雪岩全传·烟消云散》"},"usage":"作宾语、定语；用于处事"},{"id":45463,"word":"长目飞耳","pinyin":"cháng mù fēi ěr","abbr":"cmfe","explanation":"看得远，听得远。比喻消息灵通，知道的事情多。","source":{"text":"一曰长目，二曰飞耳，三曰树明，明知千里之外，隐微之中。","book":"春秋·齐·管仲《管子·九守》"},"example":{"text":"微与湛书曰：‘……比君曰表里，无假～也。","book":"《宋书·王微传》"},"usage":"作谓语、定语；指扩大视听的手段"},{"id":45464,"word":"长眠不起","pinyin":"cháng mián bù qǐ","abbr":"cmbq","explanation":"死亡的别称。","source":{"text":"却说马继增到了辰州，过了一夕，竟尔长眠不起，由队官等上前相呼，已是魂入冥乡，寂无声响了。","book":"蔡东藩《民国通俗演义》第65回"},"example":{"text":"不要等待～的时候才想起要发愤学习。"},"similar":["与世长辞"],"usage":"作谓语、定语；指死亡"},{"id":45465,"word":"长矢射天狼","pinyin":"cháng shǐ shè tiān láng","abbr":"zsstl","explanation":"矢：箭；天狼：星座名，代指侵略边境的人。比喻抵抗侵略者。","source":{"text":"举长矢兮射天狼。","book":"战国·楚·屈原《九歌·东君》"}},{"id":45466,"word":"长筭远略","pinyin":"cháng suàn yuǎn lüè","abbr":"zsyl","explanation":"筭：通“算”。长远的计划、谋略。","source":{"text":"搴旗陷阵，将军事也，长筭远略，老夫事也。","book":"宋·洪迈《容斋续笔·名将晚谬》"}},{"id":45467,"word":"长算远略","pinyin":"cháng suàn yuǎn lüè","abbr":"csyl","explanation":"犹言深谋远虑。","source":{"text":"搴旗陷阵，将军事也，长算远略，老夫事也。","book":"宋·洪迈《容斋续笔·名将晚谬》"},"similar":["深谋远虑","长期打算"],"usage":"作宾语、定语；用于谋划"},{"id":45468,"word":"长篇大套","pinyin":"cháng piān dà tào","abbr":"cpdt","explanation":"大段的议论、言论或长篇的文章。","source":{"text":"见王夫人正和薛姨妈长篇大套的说些家务人情话。","book":"《红楼梦》第七回"},"example":{"text":"得了，得了，我不要再听你这些～似是而非的议论。","book":"欧阳予倩《买卖》"},"similar":["长篇大论","长篇宏论"],"opposite":["短小精悍","言简意赅","简明扼要"],"usage":"作宾语、状语；用于说话或文章等"},{"id":45469,"word":"长篇大章","pinyin":"cháng piān dà zhāng","abbr":"zpdz","explanation":"滔滔不绝的言论。多指内容烦琐、词句重复的长篇发言","source":{"text":"是夜，中宗适来与韦后共寝，交欢事毕，韦后遂以三思之言长篇大章说了一遍。","book":"清·如莲居士《薛刚反唐》第98回"},"similar":["长篇大论","长篇大套"],"usage":"作宾语、状语；用于说话等"},{"id":45470,"word":"长篇大论","pinyin":"cháng piān dà lùn","abbr":"cpdl","explanation":"滔滔不绝的言论。多指内容烦琐、词句重复的长篇发言或文章。","source":{"text":"原稿在哪里？倒要细细看看，长篇大论，不知说的是什么。","book":"清·曹雪芹《红楼梦》第七十八回"},"example":{"text":"诗上所叙闺臣姐姐事迹，～，倒象替他题了一个小照。","book":"清·李汝珍《镜花缘》第八十九回"},"similar":["空洞无物","冗词赘句"],"opposite":["短小精悍","言简意赅","简明扼要"],"usage":"作宾语、状语；用于说话或文章等"},{"id":45471,"word":"长篇宏论","pinyin":"cháng piān hóng lùn","abbr":"cphl","explanation":"滔滔不绝的言论。多指内容烦琐、词句重复的长篇发言或文章。","source":{"text":"雄辩的马国雄正在进行他的不知第几轮发言，长篇宏论地指责田福军这几年所犯的‘错误路线’。","book":"路遥《平凡的世界》第二卷第33章"},"similar":["长篇大论","长篇大套"],"opposite":["短小精悍","言简意赅","简明扼要"],"usage":"作宾语、状语；用于说话或文章等"},{"id":45472,"word":"长篇累牍","pinyin":"cháng piān lěi dú","abbr":"cpld","explanation":"篇幅很长，内容很多。","source":{"text":"连篇累牍，不出月露之形。","book":"《隋书·李谔传》"},"example":{"text":"高会广座，有所征引，～，应口吟诵。","book":"清·黄宗羲《陈令升先生传》"},"similar":["长篇大论","滔滔不绝"],"opposite":["言简意赅","短小精悍","片言之语"],"usage":"作宾语、状语；用于评论写作"},{"id":45473,"word":"长绳系日","pinyin":"cháng shéng jì rì","abbr":"csjr","explanation":"系：拴，缚。用长绳子把太阳拴住。比喻想留住时光。","source":{"text":"岁暮景迈群光绝，安得长绳系白日。","book":"晋·傅玄《九曲歌》"},"example":{"text":"～未是愚，有翁临镜捋白须。","book":"五代·王定保《唐摭言·海叙不遇》"},"similar":["长绳系景"],"usage":"作谓语、定语；比喻想留住时光"},{"id":45474,"word":"长绳系景","pinyin":"cháng shéng xì jǐng","abbr":"csxj","explanation":"指留住时光。","source":{"text":"嗟乎！人生若浮云朝露，宁俟长绳系景，实不愿之。","book":"《周书·萧大圜传》"},"similar":["长绳系日"],"usage":"作谓语、定语；比喻想留住时光"},{"id":45475,"word":"长缨在手","pinyin":"cháng yīng zài shǒu","abbr":"cyzs","explanation":"长缨：长带子，长绳子。比喻所武装力量掌握在手中。","source":{"text":"军自请：愿受长缨，必羁南越王而致阙下。","book":"东汉·班固《汉书·终军传》"},"example":{"text":"今日～，何时缚住苍龙？","book":"毛泽东《清平乐·六盘山》"},"usage":"作谓语；用于战斗等"},{"id":45476,"word":"长舌之妇","pinyin":"cháng shé zhī fù","abbr":"cszf","explanation":"常用来指多嘴多舌、喜欢说长道短、搬弄事非的女人。","source":{"text":"妇有长舌，唯厉之阶。","book":"《诗经·大雅·瞻卬》"},"example":{"text":"苟为妻而贤，何用言矣。亦足以戒～。","book":"唐·李复言《续玄怪录·杜子春》"},"similar":["长舌妇"],"usage":"作主语、宾语；用于挑拨是非的女性"},{"id":45477,"word":"长舌妇","pinyin":"cháng shé fù","abbr":"csf","explanation":"好进谗言的妇人。","source":{"text":"文钱小隙造奇冤：‘都是你这小天杀的，不学好，引这长舌妇开口。","book":"明·冯梦龙《醒世恒言》第34卷"},"example":{"text":"我最讨厌～。"},"similar":["长舌之妇"],"usage":"作主语、宾语、定语；指挑拨是非的人"},{"id":45478,"word":"长虑却顾","pinyin":"cháng lǜ què gù","abbr":"clqg","explanation":"顾及未来而作长远打算。","source":{"text":"纲窃观自古人主，必有亲兵，所以制障表里，为长虑却顾之术也。","book":"宋·李纲《与宰相论捍贼札子》"},"example":{"text":"盖自乙未以后，彼圣主所～，坐席不暖者，独太后之废置我耳。","book":"章炳鳞《驳康有为论革命书》"},"similar":["长虑后顾"],"usage":"作谓语、宾语、定语；指为未来作长远打算"},{"id":45479,"word":"长虑后顾","pinyin":"cháng lǜ hòu gù","abbr":"clhg","explanation":"顾及未来而作长远打算。","source":{"text":"方今公卿大夫，莫肯为陛下长虑后顾，为宗庙万世计。","book":"宋·王安石《上皇帝万言书》"},"similar":["长虑顾后","长虑却顾"],"usage":"作谓语、宾语；顾及未来而作长远打算"},{"id":45480,"word":"长虑顾后","pinyin":"cháng lǜ gù hòu","abbr":"clgh","explanation":"虑：思考；顾：回头看。从长远考虑问题。","source":{"text":"彼固天下之大虑也，将为天下生民之属，长虑顾后，而保万世也。","book":"战国·赵·荀况《荀子·荣辱》"},"example":{"text":"我们考虑问题要～。"},"similar":["深谋远虑","长虑后顾"],"opposite":["只顾眼前"],"usage":"作谓语、宾语；顾及未来而作长远打算"},{"id":45481,"word":"长虺成蛇","pinyin":"zhǎng huǐ chéng shé","abbr":"zhcs","explanation":"虺：小蛇，毒蛇。指养奸遗患。比喻纵容敌人，听任其强大起来。而留下后患。","source":{"text":"养虎自啮，长虺成蛇。","book":"《洛阳伽蓝记·建中寺》"},"similar":["养奸遗患","养虎遗患"],"usage":"作谓语、定语；指纵容敌人"},{"id":45482,"word":"长蛇封豕","pinyin":"cháng shé fēng shǐ","abbr":"csfs","explanation":"长蛇和大猪。比喻贪暴者。","source":{"text":"长蛇封豕，蓄锐深谋，待时而发，其意不浅。","book":"宋·李纲《召赴文字库祗候引对札子》"},"example":{"text":"凶岁大兵俨相接，～欲安归。","book":"吴恭亨《得君复上海书却寄》"},"similar":["封豕长蛇"],"usage":"作主语、宾语；指坏人"},{"id":45483,"word":"长街短巷","pinyin":"cháng jiē duǎn xiàng","abbr":"cjdx","explanation":"犹言大街小巷。","source":{"text":"[朱重]放下被窝等件，买巨锁儿锁了门，便往长街短巷，访求父亲。","book":"《醒世恒言·卖郎独占花魁》"},"similar":["大街小巷"],"usage":"作主语、宾语、定语；指大街小巷"},{"id":45484,"word":"长袖善舞","pinyin":"cháng xiù shàn wǔ","abbr":"cxsw","explanation":"袖子长，有利于起舞。原指有所依靠，事情就容易成功。后形容有财势会耍手腕的人，善于钻营，会走门路。","source":{"text":"长袖善舞，多钱善贾。","book":"《韩非子·五蠹》"},"example":{"text":"李春山～，当时的一班名公巨卿，甚至连醇王都被他巴结上了。","book":"高阳《清宫外史》上册"},"usage":"作谓语、宾语、定语；形容善于钻营","story":["战国时期，魏国出生的范雎做了秦国的丞相，深得秦昭王的赏识。燕国的蔡泽到秦国拜会了范雎，劝范雎激流勇退，范雎将他引荐给秦昭王后就激流勇退。司马迁感叹“衣袖长的人善于跳舞，有钱的人会做买卖。”"]},{"id":45485,"word":"长袖善舞，多钱善贾","pinyin":"cháng xiù shàn wǔ，duō qián shàn gǔ","abbr":"cxswdqsg","explanation":"长衣袖合于舞蹈，本钱多便于做生意。比喻有所凭藉，事业容易成功。也比喻有财势会耍手腕的人，善于钻营，会走门路。","source":{"text":"鄙谚曰：‘长袖善舞，多钱善贾。’此言多资之易为工也。","book":"战国·韩·韩非《韩非子·五蠹》"},"example":{"text":"韩子称‘～’，信哉是言也！","book":"西汉·司马迁《史记·范雎蔡泽列传》"},"similar":["长袖善舞，多财善贾"],"usage":"作宾语、定语、分句；用于书面语"},{"id":45486,"word":"长计远虑","pinyin":"cháng jì yuǎn lǜ","abbr":"cjyl","explanation":"指长远打算。","source":{"text":"然古之人君，所以为子孙长计远虑者，类皆如此。","book":"宋·苏轼《司马温公神道碑》"},"similar":["长期打算"],"usage":"作谓语、宾语、定语；指长期打算"},{"id":45487,"word":"长话短说","pinyin":"cháng huà duǎn shuō","abbr":"chds","explanation":"要说的话很多，一时不能说清，只用扼要的几句话表明主要意思。","source":{"text":"长话短说，你与谭学生是同盟兄弟，他赢了俺一百多银子。","book":"清·李绿园《歧路灯》第36回"},"example":{"text":"～，咱们赶快行动吧！"},"similar":["言简意赅"],"opposite":["说来话长"],"usage":"作谓语、分句；指简单地说"},{"id":45488,"word":"长谈阔论","pinyin":"cháng tán kuò lùn","abbr":"ctkl","explanation":"犹高谈阔论。","source":{"text":"往常间只有宝玉长谈阔论，今日贾政在这里便唯唯而已。","book":"《红楼梦》第二二回"},"similar":["高谈阔论"],"usage":"作谓语、宾语、定语；用于谈话等"},{"id":45489,"word":"长身玉立","pinyin":"cháng shēn yù lì","abbr":"zsyl","explanation":"形容女子身材苗条。","source":{"text":"前一个长身玉立，浓眉大眼……后一个丰容盛鬋，光彩照人。","book":"清·曾朴《孽海花》第三十一回"},"similar":["婷婷玉立"],"usage":"作谓语、定语；用于女性"},{"id":45490,"word":"长身鹤立","pinyin":"cháng shēn hè lì","abbr":"zshl","explanation":"形容瘦长的高个男子像站着的鹤一样。","source":{"text":"就在这一阵笑语声中，有一个长身鹤立的人……两脸腓红，醉态可掬，七跌八撞的冲进房来。","book":"清·曾朴《孽海花》第三十二回"},"usage":"作谓语、定语；指人瘦长"},{"id":45491,"word":"长辔远御","pinyin":"cháng pèi yuǎn yù","abbr":"cpyy","explanation":"①放长缰绳，驾马远行。比喻帝王用某种政策、手段羁縻边远地区。②比喻驾驭创作手段从容达到写作的理想境界。","source":{"text":"长辔远御，妙略潜授。","book":"晋·孙楚《为石仲容与孙皓书》"},"similar":["长辔远驭","长驾远驭"],"usage":"作宾语、定语；指远距离操纵"},{"id":45492,"word":"长辔远驭","pinyin":"cháng pèi yuǎn yù","abbr":"cpyy","explanation":"用长缰绳远远地驾驭拉车的马。比喻远距离操纵，控制另外的人或物。","source":{"text":"是以归略文统，宜宏大体，先博览以精阅，总纲纪而摄契，然后拓衢路，置关键，长辔远驭，从容按节。","book":"南朝·梁·刘勰《文心雕龙·通变》"},"example":{"text":"使其权弱势分，易为羁制，自可永保边塞，俾为藩臣，此实～之道。","book":"《旧唐书·窦威传》"},"similar":["长辔远御"],"usage":"作宾语、定语；指远距离操纵"},{"id":45493,"word":"长途跋涉","pinyin":"cháng tú bá shè","abbr":"ctbs","explanation":"跋涉：翻山越岭、趟水过河。指远距离的翻山渡水。形容路途遥远，行路辛苦。","source":{"text":"妾身身犯国法，理所当然，怎敢劳贤姐长途跋涉？决难从命。","book":"清·钱彩《说岳全传》第66回"},"example":{"text":"我背痛腰酸，真像经过了～似的，我倦得厉害。","book":"巴金《沉默集·附录三》"},"similar":["跋山涉水"],"usage":"作谓语、宾语；指远距离奔走"},{"id":45494,"word":"长颈鸟喙","pinyin":"cháng jǐng niǎo huì","abbr":"cjnh","explanation":"喙：鸟的嘴。长颈项，尖嘴巴。指阴险狠毒者的状貌。","source":{"text":"范蠡遂去，自齐遗大夫种书曰：‘蜚鸟尽，良弓藏；狡兔死，走狗烹。越王为人长颈鸟喙，可与共患难，不可与共乐。子何不去？","book":"《史记·越王勾践世家》"},"example":{"text":"既已灭吴，以勾践为人，～，可与共患难，不可与同逸乐，浮海而去。","book":"明·瞿佑《剪灯新话·龙堂灵会录》"},"similar":["尖嘴猴腮"],"usage":"作谓语、定语；指人的相貌"},{"id":45495,"word":"长风破浪","pinyin":"cháng fēng pò làng","abbr":"cfpl","explanation":"比喻志向远大，不怕困难，奋勇前进。","source":{"text":"悫年少时，炳问其志，悫曰：‘愿乘长风破万里浪。’","book":"《宋书·宗悫传》"},"example":{"text":"唐·李白《行路难》诗：“长风破浪会有时，直挂云帆济沧海。”"},"similar":["乘风破浪"],"opposite":["畏缩不前"],"usage":"作谓语；比喻志向远大","story":["南朝宋国著名将领宗悫从小就有雄心壮志，喜欢舞枪弄剑，他的叔父宗炳问他的志向，他回答说：“愿乘长风破万里浪！”，后来他带兵攻打林邑国，运用计谋取胜，被封为左卫将军"]},{"id":45496,"word":"长驱径入","pinyin":"cháng qū jìng rù","abbr":"cqjr","explanation":"驱：快跑；长驱：策马快跑；径入：直入。迅速向很远的目的地前进。形容进军迅猛顺利，所向无敌。","source":{"text":"吾用兵三十余年，及所闻古之善用兵者，未有长驱径入敌围者。","book":"晋·陈寿《三国志·魏志·徐晃传》"},"similar":["长驱直入","长驱深入"],"usage":"作谓语、定语；用于战争等"},{"id":45497,"word":"长驱深入","pinyin":"cháng qū shēn rù","abbr":"cqsr","explanation":"犹言长驱直入。","source":{"text":"王所部将吏家属，尽在关西，若用此等，即宜长驱深入，直掳京都，所谓疾雷不及掩耳。","book":"《隋书·杨谅传》"},"example":{"text":"且靖康之事，未闻我有一城一邑敢为叛命，而坐视胡虏～，惕息待死屠戮之惨，与五代何异！","book":"宋·叶適《上孝宗皇帝札子》"},"similar":["长驱直入","长驱径入"],"usage":"作谓语、定语；用于战争等"},{"id":45498,"word":"长驱直入","pinyin":"cháng qū zhí rù","abbr":"cqzr","explanation":"长驱：不停顿地策马快跑；直入：一直往前。指长距离不停顿的快速行进。形容进军迅猛，不可阻挡。","source":{"text":"吾用兵三十余年，及所闻古之善用兵者，未有长驱直入敌围者也。","book":"《战国策·燕策二》：“轻卒锐兵，长驱至国。”汉·曹操《劳徐晃令》"},"example":{"text":"我根据数日来的～，满相信着先头部队是已经进入了武昌。","book":"郭沫若《革命春秋·北伐途次》"},"similar":["势如破竹","直捣黄龙"],"opposite":["步步为营","退避三舍","裹足不前"],"usage":"作谓语、定语；用于战争","story":["公元219年，曹操为夺取荆州与刘备在襄阳与樊城一带激战，关羽围住襄阳。曹仁固守樊城，曹操派徐晃率军去救援曹仁，用掐断偃城蜀军的后路来对付关羽的水攻，蜀兵害怕就主动撤军。曹军长驱直入樊城，解了樊城之危"]},{"id":45499,"word":"长驱直进","pinyin":"cháng qū zhí jìn","abbr":"cqzj","explanation":"犹言长驱直入。","source":{"text":"若擒了曹休，便长驱直进，唾手而得寿春，以窥许洛，此万世一时也。","book":"《三国演义》第九六回"},"example":{"text":"再有一种人的意见也是不对的，……具备地说，学北伐战争的～和夺取中城市。","book":"毛泽东《中国革命战争的战略问题》第一章第一节"},"similar":["长驱深入","长驱直入"],"usage":"作谓语、定语；用于战争等"},{"id":45500,"word":"长驱而入","pinyin":"cháng qū ér rù","abbr":"cqer","explanation":"驱：快跑；长驱：策马快跑。迅速向很远的目的地前进。形容进军迅猛顺利，所向无敌。","source":{"text":"未到汉口，传说元将兀良哈歹统领精兵，长驱而入，势如破竹。","book":"明·冯梦龙《醒世恒言》第19卷"},"example":{"text":"清·褚人获《隋唐演义》第34回：“不要说别事，即如一道长城，至今七八百年，外寇不能～，皆此城保障之功也。”"},"similar":["长驱径入","长驱深入"],"usage":"作谓语、定语；用于战争等"},{"id":45501,"word":"长驾远驭","pinyin":"cháng jià yuǎn yù","abbr":"cjyy","explanation":"喻帝王用某种政策、手段羁縻边远地区。","source":{"text":"虽有长驾远驭之君，乘兵力之盛，凿空开边，一旦不能有，则议者纷纷请弃地，或退保九边已耳。","book":"清·龚自珍《安边绥远疏》"},"similar":["长辔远御"],"usage":"作定语；用于政治等"},{"id":45502,"word":"长鸣都尉","pinyin":"cháng míng dōu wèi","abbr":"cmdw","explanation":"鸡的别名。"},{"id":45503,"word":"閒今铸古","pinyin":"róng jīn zhù gǔ","abbr":"rjzg","explanation":"融会贯通古今知识。"},{"id":45504,"word":"閒古铸今","pinyin":"róng gǔ zhù jīn","abbr":"rgzj","explanation":"融会贯通古今知识。同閒今铸古”。"},{"id":45505,"word":"门不停宾","pinyin":"mén bù tíng bīn","abbr":"mbtb","explanation":"宾：宾客。门外不停留客人。形容勤于待客。","source":{"text":"座无虚席，门不停宾。","book":"《晋书·王浑传》"},"example":{"text":"～，古所贵也。","book":"北齐·颜之推《颜氏家训·风操》"},"usage":"作谓语；形容勤于待客"},{"id":45506,"word":"门不夜关","pinyin":"mén bù yè guān","abbr":"mbyg","explanation":"形容社会安宁，风气良好。","source":{"text":"二年，市不豫贾。三年，门不夜关，道不拾遗。","book":"《史记·循吏列传》"},"similar":["夜不闭户","门不夜扃"],"usage":"作宾语、定语；指好的社会风尚"},{"id":45507,"word":"门不夜扃","pinyin":"mén bù yè jiōng","abbr":"mbyj","explanation":"形容社会安宁，风气良好。同“门不夜关”。","source":{"text":"及施八条之约，使人知禁，遂乃邑无淫盗，门不夜扃。","book":"南朝·宋·范晔《后汉书·东夷传论》"},"similar":["门不夜关"],"usage":"作宾语、定语；指好的社会风尚"},{"id":45508,"word":"门内之口","pinyin":"mén nèi zhī kǒu","abbr":"mnzk","explanation":"门内：家里。家中的人口。","source":{"text":"仆门内之口虽不少，司马之俸虽不多，量入俭用，亦可自给。","book":"唐·白居易《与元微之书》"}},{"id":45509,"word":"门到户说","pinyin":"mén dào hù shuō","abbr":"mdhs","explanation":"到各家各户宣传解说。","source":{"text":"言教非门到户至而日见而语之也。","book":"《孝经·广至德》：“君子之教以孝也，非家至而日见之也”汉·郑玄注"},"example":{"text":"天下之人，何可～，使皆坦然邪。","book":"晋·庾亮《让中书令表》"},"similar":["挨家挨户","家喻户晓"],"usage":"作谓语、宾语；指挨家挨户地宣传解说"},{"id":45510,"word":"门前冷落","pinyin":"mén qián lěng luò","abbr":"mqll","explanation":"旧指人失势以后，前来交往的人很少。","source":{"text":"门前冷落车马稀，老大嫁作商人妇。","book":"唐·白居易《琵琶行》"},"example":{"text":"人老了，最怕是～鞍马稀，那心境不好受。","book":"肖复兴《四月的归来·大学风情之一》第二章"}},{"id":45511,"word":"门单户薄","pinyin":"mén dān hù bó","abbr":"mdhb","explanation":"指家道衰微，人口不昌盛。","source":{"text":"但她自觉门单户薄，惹不起人家，便忍气吞声躲进屋去，把门关了，假装没听见。","book":"克非《春潮急》"},"similar":["势单力薄"],"opposite":["人多势众"],"usage":"作宾语；指家道衰微"},{"id":45512,"word":"门可张罗","pinyin":"mén kě zhāng luó","abbr":"mkzl","explanation":"形容十分冷落，宾客稀少。同“门可罗雀”。","source":{"text":"细雨郊园聊种菜，冷官门户可张罗。","book":"《太平广记》卷一八七引唐·韦述《两京记》：“唐初，秘书省唯主写书贮掌勘校而已，自是门可张罗。”宋·苏轼《次韵杨褒早春》诗"},"example":{"text":"西府车骑填凑，东第～。","book":"《资治通鉴·晋安帝隆安三年》"},"similar":["门可罗雀","门堪罗雀"],"opposite":["门庭若市"],"usage":"作谓语、定语、补语；形容门庭冷清"},{"id":45513,"word":"门可罗雀","pinyin":"mén kě luó què","abbr":"mklq","explanation":"罗：张网捕捉。大门之前可以张起网来捕麻雀。形容十分冷落，宾客稀少。","source":{"text":"始翟公为廷尉，宾客阗门；及废，六外可设雀罗。","book":"《史记·汲郑列传》"},"example":{"text":"僮奴婢媪皆散，不半载，～矣。","book":"清·纪昀《阅微草堂笔记》卷二十一"},"similar":["门庭冷落","门堪罗雀"],"opposite":["门庭若市"],"usage":"作谓语、定语、补语；形容门庭冷清","story":["汉朝廷尉翟公的府第总是车来轿往，热闹非凡。翟公自身还养了一些门客，皇帝听信谗言把翟公的官职撤了。平时那些称兄道弟的纷纷改变态度。门客也各走东西，门前非常冷清，鸟雀飞舞，张网就能捕捉到。后来他官复原职就不与他们往来"]},{"id":45514,"word":"门堪罗雀","pinyin":"mén kān luó què","abbr":"mklq","explanation":"形容十分冷落，宾客稀少。同“门可罗雀”。","source":{"text":"然丁晋公诗固尝云‘屋可占乌曾贵仕，门堪罗雀称衰翁’矣。","book":"宋·吴曾《能改斋漫录·沿袭》"},"example":{"text":"体统乖，威仪亵，纲常没半些，又不是～无宾客。","book":"清·李渔《慎鸾交·绝见》"},"similar":["门可罗雀","门可张罗"],"opposite":["车水马龙","门庭若市"],"usage":"作谓语、定语、补语；形容门庭冷清"},{"id":45515,"word":"门墙桃李","pinyin":"mén qiáng táo lǐ","abbr":"mqtl","explanation":"门墙：指师长之门；桃李：比喻后进者或学生。称他人的学生。","source":{"text":"夫春树桃李，夏得阴其下，秋得食其实；春树蒺藜，夏不可采其叶，秋得其刺焉。","book":"《论语·子张》：“夫子之墙数仞，不得其门而入，不见宗庙之美，百官之富。”汉·韩婴《韩诗外传》卷七"},"example":{"text":"天下文章同轨辙，～半公卿。","book":"清·纪昀《阅微草堂笔记》卷二十二"},"usage":"作宾语；比喻他人所栽培的后辈或所教的学生","story":["春秋时期，鲁国大夫叔孙武叔夸奖孔子的学生端木赐（子贡）比孔子强，子贡说自己只能走进孔子的门墙而矣。阳虎在卫国犯了罪，逃到北方的晋国对赵简子说朝廷有一半的官吏都是他的学生，他们不但不帮他反而害他，赵简子说他栽培的不是桃李是蒺藜"]},{"id":45516,"word":"门外万里","pinyin":"mén wài wàn lǐ","abbr":"mwwl","explanation":"指地方上的一切事情皇帝都知道，臣下无法隐瞒。旧时吹捧君王的话。"},{"id":45517,"word":"门外之治","pinyin":"mén wài zhī zhì","abbr":"mwzz","explanation":"旧指朝廷和政治。","source":{"text":"门内之治，恩揜义；门外之治，义断恩。","book":"《礼记·丧服四制》"},"example":{"text":"斯盖～，以义断恩，知君杀父而子不告，是也。","book":"《魏书·窦瑗传》"}},{"id":45518,"word":"门外汉","pinyin":"mén wài hàn","abbr":"mwh","explanation":"指外行人。","source":{"text":"师举东坡宿东林偈……曰：祗如他道，溪声便是广长舌，山色岂非清净身，若不到此田地，如何有这个消息？庵曰：是门外汉耳。","book":"《五灯会元·天竺证悟法师》"},"example":{"text":"起初如果只作～，随他谈什么，也不至出丑。","book":"清·李汝珍《镜花缘》第十八回"},"usage":"作宾语；指外行人"},{"id":45519,"word":"门庭如市","pinyin":"mén tíng rú shì","abbr":"mtrs","explanation":"门：家门；庭：庭院；如：像；市：集市。门前像市场一样。形容来的人很多。","source":{"text":"广通宾客，门庭如市。","book":"晋·袁宏《后汉纪·光武帝纪八》"},"example":{"text":"真正是～，有求必应。","book":"《中国现在记》第七回"},"similar":["门庭若市"],"opposite":["门可罗雀"],"usage":"作宾语、定语；指客人多"},{"id":45520,"word":"门庭若市","pinyin":"mén tíng ruò shì","abbr":"mtrs","explanation":"庭：院子；若：象；市：集市。门前和院子里人很多，象市场一样。原形容进谏的人很多。现形容来的人很多，非常热闹。","source":{"text":"齐王乃下令：‘群臣吏民，能而刺寡人之过者，受上赏；上书谏寡人者，受中赏；能谤讥子市朝，闯寡人之开者，受下赏。’令初下，群臣进谏，门庭若市。","book":"《战国策·齐策一》"},"example":{"text":"声价最高，～者，如常熟则高坵、湖田、退垦桥、乌船头等女巫。","book":"清·壮者《扫迷帚》第十八回"},"similar":["车水马龙"],"opposite":["门可罗雀","门庭冷落"],"usage":"作谓语、定语；用于家庭、商业、服务场所","story":["战国时齐国官员邹忌见齐威王不愿听取别人的意见，他以自己的外貌打比方，妻子偏爱，妾惧怕，客人求他，都说他比徐公貌美。齐威王认为邹忌的话很有道理，就下令在全国范围内纳谏，对有益的建议进行奖励，威王的宫院门庭若市"]},{"id":45521,"word":"门庭赫奕","pinyin":"mén tíng hè yì","abbr":"mthy","explanation":"家门显耀盛大。","source":{"text":"缪千户正在陈友定幕下，当道用事，威权隆重，门庭赫奕。","book":"明·凌濛初《二刻拍案惊奇》卷二十四"},"usage":"作谓语、定语；用于书面语"},{"id":45522,"word":"门当户对","pinyin":"mén dāng hù duì","abbr":"mdhd","explanation":"旧时指男女双方的社会地位和经济情况相当，结亲很适合。","source":{"text":"虽然不是门当户对，也强如陷于贼中。","book":"元·王实甫《西厢记》第二本第一折"},"example":{"text":"我想他两家也就算～了，一说去，自然成的；谁知他这会子来了，说不中用。","book":"清·曹雪芹《红楼梦》第七十二回"},"similar":["望衡对宇"],"opposite":["井浅河深"],"usage":"作谓语、宾语、定语；用于选择配偶上"},{"id":45523,"word":"门户之争","pinyin":"mén hù zhī zhēng","abbr":"mhzz","explanation":"宗派之间的争论。","source":{"text":"然以政见异同，门户之争，牵及朝局，至数十年而未已。","book":"《清史稿·沈桂芬翁同龢等传论》"},"example":{"text":"长期的～，使两位学者都荒废了自己的宝贵时光。","book":"《文摘周报》"},"usage":"作主语、宾语；指宗派之间的争论"},{"id":45524,"word":"门户之见","pinyin":"mén hù zhī jiàn","abbr":"mhzj","explanation":"门户：派别；见：成见。因派别不同而产生的成见。","source":{"text":"今朝廷多山东人，自作门户。","book":"《新唐书·韦云起传》"},"example":{"text":"一迁就不得，则再迁就三迁就之。此则先生～也。","book":"清·恽敬《明儒学案条辩序》"},"similar":["门户之争"],"usage":"作宾语；因派别不同而产生的偏见"},{"id":45525,"word":"门户人家","pinyin":"mén hù rén jiā","abbr":"mhrj","explanation":"指妓院。","source":{"text":"娘，虽则我门户人家，也要顾些仁义，惜些廉耻，何故这等狠毒，天不容地不载呵。","book":"明·黄尊索《说略》：“门户二字，伎院名也。”明·徐霖《绣襦记·生拆鸳鸯》"},"example":{"text":"我们～舞袖歌裙，吃饭庄屯。你不肯学歌，闲着做什么？","book":"清·孔尚任《桃花扇·传歌》"}},{"id":45526,"word":"门户开放","pinyin":"mén hù kāi fàng","abbr":"mhkf","explanation":"开着门或像是开着门做某事。也指在对外关系中减少限制，让外国人进入本国进行某些活动。","source":{"text":"逮门户开放之既实行，举全大陆为彼族长袖善舞之地。","book":"梁启超《生计学学说沿革小史》"},"example":{"text":"我们赞同～政策。"},"similar":["对外开放"],"opposite":["闭关自守"],"usage":"作宾语、定语；指对外开放政策"},{"id":45527,"word":"门户洞开","pinyin":"mén hù dòng kāi","abbr":"mhdk","explanation":"门户：房屋的出入处。比喻险要的地方。大门完全敞开，无遮无拦。","source":{"text":"转瞬间已近月宫，公远扶住车子，玄宗凝眸一望，只见月中宫殿重重，门户洞开。","book":"清·褚人获《隋唐演义》第八十五回"},"example":{"text":"杆子哗变，后路～，致全军处境，万分危急。","book":"姚雪垠《李自成》第二卷第六章"},"similar":["门户开放"],"usage":"作定语、状语；指没遮拦"},{"id":45528,"word":"门无停客","pinyin":"mén wú tíng kè","abbr":"mwtk","explanation":"门外不停留客人。形容勤于待客。","source":{"text":"远近书疏，莫不手答，笔翰如流，未尝壅滞。引接疏远，门无停客。","book":"北齐·颜之推《颜氏家训·风操》：“门不停宾，古所贵也。”《晋书·陶侃传》"}},{"id":45529,"word":"门无杂客","pinyin":"mén wú zá kè","abbr":"mwzk","explanation":"家中没有闲杂的人来作客。形容交友谨慎。同“门无杂宾”。","source":{"text":"居负南郭，时杖策独游，素寡往来，门无杂客。","book":"《宋书·袁粲传》"},"similar":["门无杂宾"],"usage":"作宾语、补语；形容交友谨慎"},{"id":45530,"word":"门无杂宾","pinyin":"mén wú zá bīn","abbr":"mwzb","explanation":"家中没有闲杂的人来作客。形容交友谨慎。","source":{"text":"门无杂宾，尝会神情独得，便超然命驾，径之龙山；顾景酣宴，造夕乃归。","book":"晋·陶潜《晋故征西大将军长史孟府君传》"},"example":{"text":"唐赵大夫崇，凝重清介，～。","book":"宋·孙光宪《北梦琐言》卷三"},"similar":["门无杂客"],"usage":"作宾语、补语；形容交友谨慎","story":["晋朝太守刘耽的儿子刘惔学识过人，他能把著名学者孙盛的哲学文章驳得体无完肤，深得司马昱的赏识，被调到外地当官。他信奉老子与庄子的道家学说，主张清静无为，办事非常严肃，过着隐士般的幽居生活，从未有杂乱的客人上门"]},{"id":45531,"word":"门楣倒塌","pinyin":"mén méi dǎo tā","abbr":"mmdt","explanation":"楣：大门上的横木，旧时富贵人家门楣高大，所以门楣比喻门第。旧指家道衰败破落。"},{"id":45532,"word":"门殚户尽","pinyin":"mén dān hù jìn","abbr":"mdhj","explanation":"指全家死亡。","source":{"text":"建安以来，野战死亡，或门殚户尽；虽有存者，遗孤老弱。","book":"明·罗贯中《三国演义》第105回"},"usage":"作谓语、状语；指全家死亡"},{"id":45533,"word":"门生故吏","pinyin":"mén shēng gù lì","abbr":"msgl","explanation":"故吏：过去的吏属。指学生和老部下。","source":{"text":"袁氏树恩四世，门生故吏遍于天下，若收豪杰以聚徒众，英雄因之而起，则山东非公之有也。","book":"《后汉书·袁绍传》"},"example":{"text":"尊府是一门三鼎甲，四代六尚书，～，天下都散满了。","book":"清·吴敬梓《儒林外史》第三十回"},"similar":["门生故旧"],"usage":"作宾语、定语；指学生和老部下"},{"id":45534,"word":"门生故旧","pinyin":"mén shēng gù jiù","abbr":"msgj","explanation":"指学生和旧友。","source":{"text":"我想公公三十年宦游，岂无几个门生故旧在要路的？","book":"明·冯梦龙《醒世恒言》卷十二五"},"example":{"text":"督师大人是河南人，在开封城中必有很多亲戚、～，怎肯让他们同归于尽？","book":"姚雪垠《李自成》第三卷第五十四章"},"similar":["故旧门生"],"usage":"作主语、宾语、定语；用于老朋友"},{"id":45535,"word":"门禁森严","pinyin":"mén jìn sēn yán","abbr":"mjsy","explanation":"指门前警卫戒备很严密。","source":{"text":"林公馆门禁森严，进去不得。","book":"杨沫《青春之歌》第一部第二章"},"example":{"text":"他的别墅花园～，好不气派。"},"similar":["守备森严"],"usage":"作谓语、定语；指门前警卫戒备很严密"},{"id":45536,"word":"门衰祚薄","pinyin":"mén shuāi zuò bó","abbr":"mszb","explanation":"门庭衰微，福祚浅薄。","source":{"text":"门衰祚薄，晚有儿息。","book":"晋·李密《陈情表》"},"example":{"text":"双慈在堂，下有妹、女，～，终鲜兄弟。","book":"明·夏完淳《狱中上母书》"},"usage":"作谓语、定语；用于自谦"},{"id":45537,"word":"门里出身","pinyin":"mén lǐ chū shēn","abbr":"mlcs","explanation":"出身于有某种行业或技艺传统的家庭。","source":{"text":"门里出身易，身里出门难。","book":"《宋·释普济《五灯会元》卷十三"},"example":{"text":"你虽说是～，可到底也没管过柜上的事儿，成色啦，价钱啦，恐怕也弄不太准。","book":"霍达《穆斯林的葬礼》第十三章"}},{"id":45538,"word":"门门有道，道道有门","pinyin":"mén mén yǒu dào，dào dào yǒu mén","abbr":"mmydddym","explanation":"门门：各行各业；道：门道；道道：办法；门：窍门。各种行业，各有各的诀窍。"},{"id":45539,"word":"门闾之望","pinyin":"mén lǚ zhī wàng","abbr":"mlzw","explanation":"指父母对子女的想望。","source":{"text":"王孙贾年十五，事闵王。王出走，失王之处。其母曰：‘女朝出而晚来，则吾倚门而望；女暮出而不还，则吾倚闾而望。’","book":"西汉·刘向《战国策·齐策六》"},"example":{"text":"春风庭畔，每叨诗礼之闻；夜雨灯前，时念～。","book":"明·陈汝元《金莲记·偕计》"},"usage":"作宾语；指父母对子女的想望"},{"id":45540,"word":"门阶户席","pinyin":"mén jiē hù xí","abbr":"mjhx","explanation":"门里门外的地方。形容到处，随处。","source":{"text":"门阶户席，皆王亲也。","book":"春秋·鲁·左丘明《左传·昭公二十七年》"},"example":{"text":"所造箴铭，积成卷轴，～，寓物垂训。","book":"南朝·梁·任昉《齐竟陵文宣王行状》"},"usage":"作宾语、定语；指内外都是"},{"id":45541,"word":"闩门闭户","pinyin":"shuān mén bì hù","abbr":"smbh","explanation":"闩：门上横木。犹言关门闭户。","source":{"text":"且待候至日落西山，吃过晚膳，不坐马匹，带了八个排军徒步悄悄同行，至半个时辰已到了天王庙。将已二更时候，左右人家多已闩门闭户，庭园寂静无声。","book":"清·李雨堂《五虎征西》第六十七回"},"example":{"text":"由于担心受到骚扰，他很早就～了"},"similar":["关门闭户"],"opposite":["门户开放"],"usage":"作谓语、宾语、定语；用于冷清的场面"},{"id":45542,"word":"闪亮登场","pinyin":"shǎn liàng dēng chǎng","abbr":"sldc","explanation":"原为广告用语，表示一种新产品上市了。现泛指一种新事物出现了。","usage":"多用于褒义。"},{"id":45543,"word":"闪烁其词","pinyin":"shǎn shuò qí cí","abbr":"ssqc","explanation":"言语遮遮掩掩，吞吞吐吐。","source":{"text":"或者定伯故意闪烁其词，更未可定。","book":"《痛史》第二五回"},"example":{"text":"‘馒头上了屉，眼看八成熟。’安天宝～，匆匆进门去。","book":"刘绍棠《小荷才露尖尖角》"},"similar":["含糊其辞","隐约其辞"],"opposite":["直言不讳","心直口快"],"usage":"作谓语、宾语；指说话及文章"},{"id":45544,"word":"闪烁其辞","pinyin":"shǎn shuò qí cí","abbr":"ssqc","explanation":"闪烁：光一闪一闪，比喻说话吞吞吐吐。指说话吞吞吐吐，不肯透露真相或回避要害问题。","source":{"text":"又诘妇缚伤，则云搔破，其词闪烁，疑乙语未必诳也。","book":"清·纪昀《阅微草堂笔记》卷十五"},"example":{"text":"或者定伯故意～，更未可定。","book":"清·吴趼人《痛史》第二十五回"},"similar":["闪烁其词"],"opposite":["直言不讳","心直口快"],"usage":"作谓语、宾语；指说话及文章"},{"id":45545,"word":"闭关主义","pinyin":"bì guān zhǔ yì","abbr":"bgzy","explanation":"闭关自守不与国外进行往来的政策。","example":{"text":"～在中国是行不通的。"},"similar":["闭关政策"],"usage":"作主语、宾语、定语；用于政策"},{"id":45546,"word":"闭关却扫","pinyin":"bì guān què sǎo","abbr":"bgqs","explanation":"却：停止；却扫：不再清扫车迹，意指谢客。关上大门，扫除车迹。指闭门谢客，不和外界往来。","source":{"text":"至乃敬通见抵，罢归田里，闭关却扫，塞门不仕。","book":"南朝·梁·江淹《恨赋》"},"example":{"text":"时来运转，好汉也有惨遭挫败的时候，他就应该～，往日的荣华不必再提。","book":"梁实秋《好汉》"},"similar":["闭门却扫"],"usage":"作谓语、定语；形容封闭自己"},{"id":45547,"word":"闭关绝市","pinyin":"bì guān jué shì","abbr":"bgjs","explanation":"封闭关口，不与外界通商。","source":{"text":"外来之物，皆不过以供玩好，可有可无，即非中国要需，何难闭关绝市。","book":"清·林则徐《拟颁发檄谕英国国王稿》"},"example":{"text":"中国乃～而不能，习故安常而不可。","book":"陈炽《〈盛世危言〉序》"},"similar":["闭关自守"],"opposite":["对外开放","门户开放"],"usage":"作谓语、定语、宾语；指封闭"},{"id":45548,"word":"闭关自主","pinyin":"bì guān zì zhǔ","abbr":"bgzz","explanation":"指关闭关口，不和外国来往。","source":{"text":"见“闭关自守”。"},"example":{"text":"如今不是我们～的时侯了，输入欧西先觉诸邦的艺术也正是我们的急图。","book":"郭沫若《文艺论集·一个宣言》"},"similar":["闭关自守"],"usage":"作谓语、定语；比喻行为保守"},{"id":45549,"word":"闭关自守","pinyin":"bì guān zì shǒu","abbr":"bgzs","explanation":"关闭关口，不和外人来往。比喻因循保守，不愿接触外界事物。","source":{"text":"无事则民勤于耕稼，以广军储；有事则民习于弓矢，以莅武事。此真霸王之资也。闭关自守，又何忧乎？","book":"《新编五代史平话·周史上》"},"example":{"text":"而且厦大也太过于～，此后还应该与他大学往还。","book":"鲁迅《两地书》五十八"},"similar":["闭关锁国","闭门谢客"],"opposite":["广泛交流"],"usage":"作谓语、定语；比喻行为保守"},{"id":45550,"word":"闭关锁国","pinyin":"bì guān suǒ guó","abbr":"bgsg","explanation":"闭关：封闭关口；锁：封锁。闭关自守，不与外国往来。","source":{"text":"先王以至日闭关，商旅不行，后不省方。","book":"《周易·复》"},"example":{"text":"严复的“译事三难信达雅”为打破～，西学东渐开了先河。","book":"柯灵《序》"},"similar":["闭关自守","故步自封"],"opposite":["门户开放","面向世界"],"usage":"作宾语、定语；表示保守，不与外国交往"},{"id":45551,"word":"闭口不言","pinyin":"bì kǒu bù yán","abbr":"bkby","explanation":"紧闭着嘴，什么也不说。","source":{"text":"是以曹丞相日饮醇酒，倪大夫闭口不言。","book":"西汉·桓宽《盐铁论·刺复》"},"example":{"text":"他～这件事。"},"similar":["爱口识羞","哑口无言"],"opposite":["畅所欲言","振振有词"],"usage":"作谓语、宾语；比喻人因各种原因而不说话"},{"id":45552,"word":"闭口不谈","pinyin":"bì kǒu bù tán","abbr":"bkbt","explanation":"紧闭着嘴，什么也不说。","source":{"text":"是以曹丞相日饮醇酒，倪大夫闭口不言。","book":"汉·桓宽《盐铁论·刺复》"},"example":{"text":"只有一样，周炳觉得奇怪的，就是就是一提起卖到广州三家巷去的小妹妹胡杏，他们全就～。","book":"欧阳山《苦斗》五十二"},"similar":["闭口无言","只字不提"],"opposite":["海阔天空","知无不言"],"usage":"作谓语、定语；指保守秘密"},{"id":45553,"word":"闭口捕舌","pinyin":"bì kǒu bǔ shé","abbr":"bkbs","explanation":"犹言甕中捉鳖。比喻敌方已被控制，无法逃脱。","source":{"text":"旋谓基曰：‘綝击其东，我等绝其西，不六旬，天下可定，斯闭口捕舌也。’","book":"《晋书·张玄靓传》"},"example":{"text":"～岂容遁，排山压卵孰与争。","book":"清·钱谦益《送马巽傅归会稽》诗"},"similar":["瓮中捉鳖"],"usage":"作宾语、定语；指已经控制局面"},{"id":45554,"word":"闭口无言","pinyin":"bì kǒu wú yán","abbr":"bkwy","explanation":"闭住嘴巴不言语。形容对事不置可否或事情弄僵，自己觉得理亏而无话可讲时的情态。参见“闭口不言”。","source":{"text":"一席话说得朱博如闭口无言，只得别去。","book":"明·施耐庵《水浒传》第六十四回：“关胜连忙答礼，闭口无言，手脚无措。”清·吴趼人《二十年目睹之怪现状》第一百五回"},"example":{"text":"刘家父女只剩了彼此瞪着，已无话可讲；祥子是～。","book":"老舍《骆驼祥子》十五"},"similar":["哑口无言"],"opposite":["口若悬河"],"usage":"作谓语、状语；指沉默"},{"id":45555,"word":"闭口结舌","pinyin":"bì kǒu jié shé","abbr":"bkjs","explanation":"闭着嘴不说话。犹言闭口藏舌。","source":{"text":"众人问知是郝家难为他，便闭口结舌不来兜搭。","book":"《快心编初集》第一回"},"similar":["闭口藏舌"],"opposite":["喋喋不休","口若悬河"],"usage":"作谓语；形容不敢开口说真话"},{"id":45556,"word":"闭口藏舌","pinyin":"bì kǒu cáng shé","abbr":"bkcs","explanation":"闭着嘴不说话。形容怕惹事而不轻易开口。","source":{"text":"口是祸之门，舌是斩身刀。闭口深藏舌，安身处处牢。","book":"五代·冯道《舌》诗"},"example":{"text":"道成之后，～，何用管人间如许闲事。","book":"宋·楼钥《攻媿集·跋徐神翁真迹》卷七十二"},"similar":["缄口不言"],"opposite":["口若悬河"],"usage":"作谓语；形容不敢开口说真话"},{"id":45557,"word":"闭合思过","pinyin":"bì gé sī guò","abbr":"bhsg","explanation":"指关起门来自我反省。","source":{"text":"民有昆弟相与讼田自言，延寿大伤之……是日移病不听事，因入卧传舍，闭合思过，一县莫知所为。","book":"《汉书·韩延寿传》"}},{"id":45558,"word":"闭合自责","pinyin":"bì gé zì zé","abbr":"bhzz","explanation":"指关起门来自我反省。同“闭合思过”。","source":{"text":"诩（严诩）本以孝行为官，谓掾史为师友，有过辄闭合自责，终不大言。","book":"《汉书何并传》"}},{"id":45559,"word":"闭塞眼睛捉麻雀","pinyin":"bì sè yǎn jīng zhuō má què","abbr":"bsyjzmq","explanation":"比喻盲目地进行工作。","source":{"text":"闭塞眼睛捉麻雀”，“瞎子摸鱼”，粗枝大叶，夸夸其谈，满足于一知半解，这种极坏的作风，这种完全违反马克思列宁主义基本精神的作风，还在我党许多同志中继续存在着。","book":"毛泽东《改造我们的学习》二"},"example":{"text":"‘～’，结果往往麻雀捉不到，还要碰破头。","book":"周立波《暴风骤雨》第一部六"},"similar":["瞎子摸鱼"],"usage":"作宾语、分句；指盲目办事"},{"id":45560,"word":"闭境自守","pinyin":"bì jìng zì shǒu","abbr":"bjzs","explanation":"指封闭四境，严加防守。","source":{"text":"若太原再警，势必鼓行而前，不得闭境自守而已矣。","book":"明·唐顺之《与河南李中丞石叠书》"},"example":{"text":"～的政策只会使国家落后。"},"similar":["闭关自守"],"opposite":["对外开放"],"usage":"作谓语、定语；比喻行为保守"},{"id":45561,"word":"闭壁清野","pinyin":"bì bì qīng yiě","abbr":"bbqy","explanation":"犹言坚壁清野。是作战时采取的一种策略。","source":{"text":"《南齐书·曹虎传》；“部勒小戍，闭壁清野。”"},"similar":["坚壁清野"],"usage":"作谓语、定语、分句；用于军事方面"},{"id":45562,"word":"闭户关门","pinyin":"bì hù guān mén","abbr":"bhgm","explanation":"户：出入的门户。门户都关闭起来。形容冷清寥落。","source":{"text":"石秀心疑。来到市心里，只见人家闭户关门。","book":"明·施耐庵《水浒传》第62回"},"similar":["关门闭户"],"opposite":["门户开放"],"usage":"作谓语、宾语、定语；用于冷清的场面"},{"id":45563,"word":"闭户读书","pinyin":"bì hù dú shū","abbr":"bhds","explanation":"关着门在家里埋头读书。","source":{"text":"盖须切磋起明也。见闭户读书，师心自是。","book":"北齐·颜之推《颜氏家训·勉学第八》卷三"},"example":{"text":"思道读之，多所不解，于是感激，闭户读书，师事河间邢子才。","book":"《隋书·卢思道传》"},"similar":["闭门读书"],"usage":"作谓语、宾语；形容专心学习"},{"id":45564,"word":"闭明塞聪","pinyin":"bì míng sè cōng","abbr":"bmsc","explanation":"堵塞视听。指对外界事物不闻不问或不了解。","source":{"text":"闭明塞聪，爱精自保。","book":"汉·王充《论衡·自纪》"},"similar":["闭目塞听"],"usage":"作宾语、定语；指不闻不问"},{"id":45565,"word":"闭月羞花","pinyin":"bì yuè xiū huā","abbr":"byxh","explanation":"闭：藏。使月亮躲藏，使花儿羞惭。形容女子容貌美丽。","source":{"text":"引动这撩云拨雨心，想起那闭月羞花貌，撇的似绕朱门燕子寻巢。","book":"元·王子一《误入桃源》第四折"},"example":{"text":"此时鲁小姐卸了浓装，换了几件雅淡衣服，蘧公子举眼细看，真有沉鱼落雁之容，～之貌。","book":"清·吴敬梓《儒林外史》第十回"},"similar":["沉鱼落雁","花容月貌"],"usage":"作谓语、定语；形容女子的容貌美"},{"id":45566,"word":"闭目塞听","pinyin":"bì mù sè tīng","abbr":"bmst","explanation":"闭上眼睛不看，堵住耳朵不听。形容对外界事物不闻不问。","source":{"text":"闭目塞聪，爱精自保。","book":"汉·王充《论衡·自纪》"},"example":{"text":"一个～、同客观外界根本绝缘的人，是无所谓认识的。","book":"毛泽东《实践论》"},"similar":["视而不见","听而不闻","闭关自守"],"opposite":["眼观六路","耳听八方"],"usage":"作谓语、宾语、定语；形容与外界隔绝"},{"id":45567,"word":"闭目塞耳","pinyin":"bì mù sè ěr","abbr":"bmse","explanation":"堵塞视听。指对外界事物不闻不问或不了解。","source":{"text":"王乃坐之空馆，严加防守，使其闭目塞耳，永无闻见。","book":"《隋书·东夷传·高丽》"},"example":{"text":"设有人～，跣而疾趋，前遇险阻，安有不颠踬者哉！","book":"宋·司马光《遗表》"},"similar":["闭目塞听","闭目塞聪"],"usage":"作谓语、宾语、定语；形容与外界隔绝"},{"id":45568,"word":"闭目塞聪","pinyin":"bì mù sāi cōng","abbr":"bmsc","explanation":"聪：听觉敏锐，这里指听觉。闭着眼睛，堵住耳朵。形容对外界事物全不了解。","source":{"text":"闭目塞聪，爱精自保。","book":"汉·王充《论衡·自纪》"},"similar":["闭明塞聪"],"usage":"作宾语、定语；指不闻不问"},{"id":45569,"word":"闭门不出","pinyin":"bì mén bù chū","abbr":"bmbc","explanation":"关起门来不外出，指杜绝与外界交往。","source":{"text":"荆竟归田里，称病闭门不出。","book":"南朝·宋·范晔《后汉书·史弼传》"},"example":{"text":"他总是～。"},"similar":["闭门却扫","闭关自守"],"usage":"作谓语、宾语；指与外界不交往"},{"id":45570,"word":"闭门不纳","pinyin":"bì mén bù nà","abbr":"bmbn","explanation":"纳：入，进来。关上门不让人进来。","source":{"text":"欲入城则闭门不纳，将入山则又与贼遇。","book":"明·余继登《典故纪闻》卷十四"},"example":{"text":"～的鲁男子。","book":"明·兰陵笑笑生《金瓶梅词话》第一回"},"opposite":["门户开放"],"usage":"作谓语；指关上门不让人进来"},{"id":45571,"word":"闭门却扫","pinyin":"bì mén què sǎo","abbr":"bmqs","explanation":"却：停止；却扫：不再清扫车迹，意指谢客。关上大门，扫除车迹。指闭门谢客，不和外界往来。","source":{"text":"蜀郡太守颖川刘胜季陵，去官在家，闭门却扫。","book":"汉·应劭《风俗通·十反》"},"example":{"text":"舍馆粗定，衣食稍给，～，收召魂魄。","book":"宋·苏轼《黄州安国寺记》"},"similar":["闭门谢客"],"usage":"作谓语、定语；指不和外界往来"},{"id":45572,"word":"闭门却轨","pinyin":"bì kǒu què guǐ","abbr":"bmqg","explanation":"指杜绝宾客，不与来往。","source":{"text":"见“闭门扫轨”。"},"example":{"text":"说门可罗雀是夸张的，～却是不必要的。","book":"孙犁《秀露集·序》"},"similar":["闭门却扫","闭门扫轨"],"usage":"作谓语、定语；指不和外界往来"},{"id":45573,"word":"闭门合辙","pinyin":"bì kǒu hé shé","abbr":"bmhz","explanation":"犹言闭门造车，出门合辙。比喻互相投合。","source":{"text":"山谷云：东坡墨戏，水活石润，与予草书三昧，所谓闭门合辙。","book":"宋·赵令畤《侯鲭录》卷八"},"usage":"作谓语、定语；指互相投合"},{"id":45574,"word":"闭门埽轨","pinyin":"bì mén sào guǐ","abbr":"bmsg","explanation":"指杜绝宾客，不与来往。"},{"id":45575,"word":"闭门塞户","pinyin":"bì kǒu sè hù","abbr":"bmsh","explanation":"关闭门窗，堵塞洞穴。多谓防备之严。","source":{"text":"见“闭门塞窦”。"},"example":{"text":"～，羞见吾徒。","book":"唐·李复言《续玄怪录·张庚》"},"similar":["闭门塞窦"],"usage":"作宾语、定语；指严密防范"},{"id":45576,"word":"闭门塞窦","pinyin":"bì kǒu sè dòu","abbr":"bmsd","explanation":"关闭门窗，堵塞洞穴。多谓防备之严。","source":{"text":"若有祸患，亦非闭门塞窦所能避也。","book":"《宋史·儒林传四·蔡元定》"},"similar":["闭门塞户"],"usage":"作宾语、定语；指严密防范"},{"id":45577,"word":"闭门墐户","pinyin":"bì kǒu jǐn hù","abbr":"bmjh","explanation":"关闭门窗，堵塞洞穴。多谓防备之严。","source":{"text":"见“闭门塞窦”。"},"example":{"text":"居民互相惊告，以为鬼至，每日向夕，辄～。","book":"清·钮琇《觚剩续编·雁翎刀》"}},{"id":45578,"word":"闭门思愆","pinyin":"bì gé sī qiān","abbr":"bmsq","explanation":"指关起门来自我反省。同“闭閤思过”。","source":{"text":"自谓能以敦厉薄俗，帅之以义。今既不能，表退职，使闭门思愆。","book":"《三国志·蜀志·来敏传》“坐事去职”裴松之注引《诸葛亮集》"},"similar":["闭门思过"],"opposite":["死不改悔"],"usage":"作谓语、定语、状语；用于有过失的人的反省"},{"id":45579,"word":"闭门思过","pinyin":"bì mén sī guò","abbr":"bmsg","explanation":"过：过失。关起门来反省。","source":{"text":"自谓能敦厉薄俗，帅之以义。今既不能，表退职，使闭门思愆。","book":"《汉书·韩延寿传》：“因入卧传舍，闭阁思过。”三国·蜀·诸葛亮《黜来敏教》"},"example":{"text":"小仙自知身获重罪，追悔莫及，惟有～，敬听天命。","book":"清·李汝珍《镜花缘》第六回"},"similar":["反躬自省","闭阁思过"],"opposite":["不思悔改"],"usage":"作谓语、定语、状语；用于有过失的人的反省"},{"id":45580,"word":"闭门扫轨","pinyin":"bì mén sǎo guǐ","abbr":"bmsg","explanation":"轨：车迹。指杜绝宾客，不与来往。","source":{"text":"轨，车迹也。言绝人事。","book":"《后汉书·党锢传·杜密》：“同郡刘胜，亦自蜀郡告归乡里，闭门扫轨，无所干及。”李贤注"},"similar":["闭门扫迹","闭门却轨"],"usage":"作谓语、定语；指不和外界往来"},{"id":45581,"word":"闭门扫迹","pinyin":"bì kǒu sǎo guǐ","abbr":"bmsj","explanation":"指杜绝宾客，不与来往。","source":{"text":"见“闭门扫轨”。"},"example":{"text":"而胡君年逾七十，平生～，上下千古，讨论六经。","book":"清·戴名世《序》"},"similar":["闭门扫轨"],"usage":"作谓语、定语；指不和外界往来"},{"id":45582,"word":"闭门投辖","pinyin":"bì mén tóu xiá","abbr":"bmtx","explanation":"辖：车轴的键，去辖则车不能行。比喻主人留客的殷勤。","source":{"text":"遵耆酒，每大饮，宾客满堂，辄关门，取客车辖投井中，虽有急，终不得去。","book":"东汉·班固《汉书·游侠传·陈遵》"},"example":{"text":"谭嗣同在临刑之前就做了一绝‘～思张俭’，秋瑾女士也有一句‘秋雨秋风愁杀人’。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["取辖投井"],"usage":"作谓语、定语；形容人殷勤好客","story":["西汉末年京兆尹陈遵性格豪爽，很有才气，而且非常好客，各地官员和四方豪杰都仰慕他的大名，经常去拜访他。陈遵大摆宴席，陪客人喝酒，为了留住客人，他命令仆人把客人马车上的辖拆下投到井里，客人只好留下来陪他喝酒"]},{"id":45583,"word":"闭门羹","pinyin":"bì mén gēng","abbr":"bmg","explanation":"拒绝客人进门叫做让客人吃闭门羹。","source":{"text":"下列不相见，以闭门羹待之。","book":"唐·冯贽《云仙杂记》卷一"},"example":{"text":"一次不见，第二次再去，谁知三番五次饱尝～。","book":"高阳《清宫外史》上册"},"usage":"作宾语；用于口语","story":["古代宣城妓女史风长盗标致风流，能歌善舞，十分闻名，那些浪荡公子和好色之徒纷纷登门拜访，把妓院经常围得水泄不通。史风把他们分成不同的等级，上等的客人来，她下楼接待，还做羹款待，下等客人来她不愿同他们见面，关起门来让他吃羹"]},{"id":45584,"word":"闭门自守","pinyin":"bì mén zì shǒu","abbr":"bmzs","explanation":"①闭门不出，洁身自保。②坚壁不出，严加防守。","source":{"text":"力作所得，不足以给贡税。闭门自守，又坐邻伍铸钱挟铜，奸吏因以愁民。","book":"《汉书·王莽传下》"},"example":{"text":"朕若～，虏必纵兵大掠。","book":"唐·吴兢《贞观政要·征伐》"},"similar":["闭门不出"],"usage":"作谓语、定语；指封闭"},{"id":45585,"word":"闭门觅句","pinyin":"bì mén mì jù","abbr":"bmmj","explanation":"形容作诗时冥思苦想。","source":{"text":"闭门觅句陈无己，对客挥毫秦少游。","book":"宋·黄庭坚《病起荆江亭即事》诗之九"},"example":{"text":"～浑闲事，并世何人是作家。","book":"陈去病《昼寝杂感》诗之六"},"usage":"作谓语；形容静心写作"},{"id":45586,"word":"闭门读书","pinyin":"bì mén dú shū","abbr":"bmds","explanation":"关起门来在家里读书。原意是独自学习，而不与别人切磋。后也用以形容专心埋头苦读。","source":{"text":"盖须切磋相起明也。见闭门读书，师心自是。稠人广坐，谬误差失者多矣。","book":"北齐·颜之推《颜氏家训·勉学》"},"similar":["闭户读书"],"usage":"作谓语；形容专心埋头苦读"},{"id":45587,"word":"闭门谢客","pinyin":"bì mén xiè kè","abbr":"bmxk","explanation":"谢：谢绝。关闭家门，谢绝客人来访。","source":{"text":"我从此闭门谢客，永不见人。","book":"清·贪梦道人《彭公案》第11回"},"example":{"text":"他在家～，潜心研究。"},"similar":["闭门却扫"],"opposite":["高朋满座","宾客盈门"],"usage":"作谓语、宾语；指不接待客人"},{"id":45588,"word":"闭门造车","pinyin":"bì mén zào chē","abbr":"bmzc","explanation":"关起门来造车子。比喻脱离实际，只凭主观办事。","source":{"text":"古语所谓闭门造车，出门合辙，盖言其法之同。","book":"宋·朱熹《中庸或问》卷三"},"example":{"text":"自以为～，出而合辙，而门外之辙与其所造之车，果相合否。","book":"严复《救亡决论》"},"similar":["拒谏饰非","独断专行"],"opposite":["集思广益","群策群力"],"usage":"作谓语、定语、状语；多用于批评、劝告"},{"id":45589,"word":"闭门造车，出门合辙","pinyin":"bì mén zào chē，chū mén hé zhé","abbr":"bmzccmhz","explanation":"辙：车轮轧过的痕迹。指按照统一规格，即使关起门来制造车辆，使用起来也能和路上的车辙完全相合。","source":{"text":"尊宿语言问答之间，未尝见面交谈也，而说法度人千里同音，如闭门造车，出门合辙，了无差异。","book":"宋·沈作喆《寓卷》七"},"example":{"text":"自非众议参同，乌能～也。","book":"清·魏源《治篇》一"}},{"id":45590,"word":"闭门酣歌","pinyin":"bì mén hān gē","abbr":"bmhg","explanation":"指闭门不出，尽兴饮酒，尽情歌舞。形容沉缅酒色，尽情享受。","source":{"text":"绲为梁湘东王，镇西谘议参军，颇为声色，侍妾数十，……，便醉而闭门，尽日酣歌。","book":"唐·李延寿《南史·徐绲似》"},"usage":"作谓语、宾语；用于处事"},{"id":45591,"word":"闭阁思过","pinyin":"bì gé sī guò","abbr":"bgsg","explanation":"指关起门来自我反省。","source":{"text":"民有昆弟相与讼田自言，延寿大伤之……是日移病不听事，因入卧传舍，闭阁思过，一县莫知所为。","book":"《汉书·韩延寿传》"},"similar":["闭门思过"],"opposite":["不思悔改"],"usage":"作谓语、定语、状语；用于有过失的人的反省"},{"id":45592,"word":"闭阁自责","pinyin":"bì gé zì zé","abbr":"bgzz","explanation":"指关起门来自我反省。同“闭阁思过”。","source":{"text":"诩（严诩）本以孝行为官，谓掾史为师友，有过辄闭阁自责，终不大言。","book":"《汉书何并传》"},"example":{"text":"民有争诉者，辄～，然后断其讼，以道譬之。","book":"《后汉书·吴祐传》"},"similar":["闭阁思过"],"usage":"作谓语、定语、状语；用于有过失的人的反省"},{"id":45593,"word":"问一知二","pinyin":"wèn yī zhī èr","abbr":"wyze","explanation":"问：询问；知：知道。问一知道二。形容人聪明，见多识广。","source":{"text":"崔祖浚所谓问一知二。","book":"《隋书·崔赜传》"},"example":{"text":"关中人亦甚聪明，～。","book":"宋·李昉《太平广记》卷二百四十八"}},{"id":45594,"word":"问一答十","pinyin":"wèn yī dá shí","abbr":"wyds","explanation":"形容所知甚多或口齿伶俐。","source":{"text":"太尉此去，下官手下有个虞侯，能言快语，问一答十，好与太尉提拨事情。","book":"明·施耐庵《水浒全传》第七十五回"},"example":{"text":"师父就想起你来，说我们不济，说你还是个聪明伶俐之人，常时声叫声应，～。","book":"明·吴承恩《西游记》第三十回"},"similar":["问十道百"],"usage":"作谓语、定语、宾语；用于说话等"},{"id":45595,"word":"问俗问禁","pinyin":"wèn sú wèn jìn","abbr":"wswj","explanation":"问：打听；俗：风俗；禁：禁忌。询问风俗和禁忌。","source":{"text":"入境而问禁，入国而问俗，入门而问讳。","book":"《礼记·曲礼上》"}},{"id":45596,"word":"问十答十","pinyin":"wèn shí dá shí","abbr":"wsds","explanation":"问：询问；答：回答。询问十回答十，即有问必答。形容见多识广。","source":{"text":"两个儿子未为希罕，又生个女儿，名曰小妹，其聪明绝世无双，真个闻一知二，问十答十。","book":"明·冯梦龙《醒世恒言》卷十一"}},{"id":45597,"word":"问十道百","pinyin":"wèn shí dào bǎi","abbr":"wsdb","explanation":"犹言问一答十。形容所知甚多或口齿伶俐。","source":{"text":"只是口嘴快些，凡向人前，说成篇，道成溜，问一答十，问十道百。","book":"明·洪楩《清平山堂话本·快嘴李翠莲记》"},"similar":["问一答十"],"usage":"作谓语、定语、宾语；用于说话等"},{"id":45598,"word":"问天买卦","pinyin":"wèn tiān mǎi guà","abbr":"wtmg","explanation":"求问上天以卜吉凶。","source":{"text":"三娘起对诸亲，奴有愿，问天买卦。","book":"《刘知远诸宫调·君臣弟兄子母夫妇团圆》"},"example":{"text":"明·罗贯中《三国演义》第54回：“恰才～，如破曹兴汉，砍断此石。今果然如此！”"},"usage":"作谓语、定语；用于处事"},{"id":45599,"word":"问天呵壁","pinyin":"wèn tiān hē bì","abbr":"wthb","explanation":"问天：向天发问；呵：大声呵斥。形容文人不得志而发牢骚。","source":{"text":"屈原放逐，忧心愁悴，彷徨山泽，经历陵陆，嗟号昊旻，仰天叹息。……因书其壁，呵而问之，以渫愤懑，舒泻愁思。","book":"汉·王逸《天问序》"},"example":{"text":"又恐惹，冲冠发指，～从头起。","book":"清·黄景仁《霜叶飞·湘江夜泊》"}},{"id":45600,"word":"问安视寝","pinyin":"wèn ān shì qǐn","abbr":"wasq","explanation":"指古代诸侯、王室子弟侍奉父母的孝礼。同“问安视膳”。","source":{"text":"而问安视寝之余，所以察词而观色，因此而得彼者，其端甚众。","book":"宋·陈亮《廷对策》"},"similar":["问安视膳","问寝视膳"],"usage":"作谓语、定语、宾语；指子女侍奉父母"},{"id":45601,"word":"问安视膳","pinyin":"wèn ān shì shàn","abbr":"wass","explanation":"每日必问安，每餐必在左。指古代诸侯、王室子弟侍奉父母的孝礼。","source":{"text":"文王之为世子，朝于王季日三。鸡初鸣而衣服，至于寝门外，问内竖之御者曰：‘今日安否何如？’……食上，必在视寒暖之节，食下，问所膳。","book":"《礼记·文王世子》"},"example":{"text":"太子当鸡鸣而起，～。","book":"《资治通鉴·唐纪文宗开成二年》"},"similar":["问寝视膳"],"usage":"作谓语、定语、宾语；指子女侍奉父母","story":["商朝末年，周文王为世子时，他特别孝顺父母，每天三次去陪侍父母，早晨公鸡刚打鸣就穿好衣服到父母的寝门外，问侍从昨日父母的就寝情况，然后陪父母早餐，在席间他问父母寒暖情况，饭后问饮食情况。他堪称孝顺父母的楷模"]},{"id":45602,"word":"问官答花","pinyin":"wèn guān dá huā","abbr":"wgdh","explanation":"指答非所问。","source":{"text":"安老爷一听这话，心里暗笑说：‘这老头儿这才叫个问官答花——驴唇不对马嘴。这与我的心事甚么相干？’","book":"清·文康《儿女英雄传》第四十回"},"similar":["答非所问"],"usage":"作宾语、定语；用于说话等"},{"id":45603,"word":"问寒问暖","pinyin":"wèn hán wèn nuǎn","abbr":"whwn","explanation":"形容关怀体贴备至。","source":{"text":"他短不了上我屋里来拉扯个时事，还常常问寒问暖问吃问住，亲热的不行。","book":"康濯《我在乡下》"},"example":{"text":"他经常对我～，关怀备至。"},"similar":["关怀备至","问寒问热","问长问短"],"opposite":["漠不关心","不闻不问"],"usage":"作谓语、定语；形容对别人的生活很关心"},{"id":45604,"word":"问寒问热","pinyin":"wèn hán wèn rè","abbr":"whwr","explanation":"经常询问别人的生活情况，形容十分关切。","source":{"text":"有时遇见薛蝌，他便姣姣乔乔、姣姣痴痴的问寒问热，忽喜忽嗔。","book":"清·曹雪芹《红楼梦》第100回"},"similar":["问寒问暖"],"usage":"作谓语、定语；形容对别人的生活很关心"},{"id":45605,"word":"问寝视膳","pinyin":"wèn qǐn shì shàn","abbr":"wqss","explanation":"指古代诸侯、王室子弟侍奉父母的孝礼。同“问安视膳”。","source":{"text":"纲为太子陈君臣父子之道，问寝视膳之方，理顺辞直，听者忘倦。","book":"唐·吴兢《贞观政要·尊敬师傅》"},"similar":["问安视膳","问安视寝"],"usage":"作谓语、定语、宾语；指子女侍奉父母"},{"id":45606,"word":"问心无愧","pinyin":"wèn xīn wú kuì","abbr":"wxwk","explanation":"问心：问问自己。扪心自问，毫无愧色。","source":{"text":"君无须问此，自问自心，问心无愧，即阴律所谓善；问心有愧，即阴律所谓恶。","book":"清·纪昀《阅微草堂笔记·槐西杂志一 》"},"example":{"text":"林冲那时候却觉得在“刀枪无情”的理由下伤害了那汉子的生命，原是冠冕堂皇，～。","book":"茅盾《豹子头林冲》"},"similar":["心安理得","理直气壮"],"opposite":["问心有愧","无地自容","心怀鬼胎"],"usage":"作谓语、宾语、定语；指理直气壮"},{"id":45607,"word":"问心有愧","pinyin":"wèn xīn yǒu kuì","abbr":"wxyk","explanation":"问心：问问自己；愧：惭愧。自己问自己，心中感到不安。指做了对不住别人的事。","source":{"text":"问心：问问自己；愧：惭愧。自己问自己，心中感到不安。指做了对不住别人的事。"},"example":{"text":"问心：问问自己；愧：惭愧。自己问自己，心中感到不安。指做了对不住别人的事。"},"opposite":["问心无愧","心安理得"],"usage":"作谓语、宾语、定语；指理直气壮"},{"id":45608,"word":"问柳寻花","pinyin":"wèn liǔ xún huā","abbr":"wlxh","explanation":"花、柳：原指春景，旧时亦指娼妓。原指赏玩春天的景色。后旧小说用来指宿娼。","source":{"text":"元戎小对出郊外，问柳寻花到野亭。","book":"唐·杜甫《严中丞枉驾见过》"},"example":{"text":"他最好～。"},"similar":["寻花问柳"],"usage":"作谓语、宾语；指嫖妓"},{"id":45609,"word":"问柳评花","pinyin":"wèn liǔ píng huā","abbr":"wlph","explanation":"比喻狎妓。","source":{"text":"这些少年，正是斗鸡走狗、问柳评花的一干游侠纨绔。","book":"清·曹雪芹《红楼梦》第75回"},"usage":"作宾语、定语；用于男性"},{"id":45610,"word":"问牛及马","pinyin":"wèn niú jí mǎ","abbr":"wnjm","explanation":"问：询问；及：达到。询问牛的价格，得知马的贵贱。比喻从旁推究，弄清楚事情真相。","source":{"text":"钩距者，设欲知马贾（价），则先问狗，已问羊，又问牛，然后及马，参伍其贾，以类相准，则知马之贵贱，不失实矣。","book":"《汉书·赵广汉传》"}},{"id":45611,"word":"问牛知马","pinyin":"wèn niú zhī mǎ","abbr":"wnzm","explanation":"比喻从旁推究，弄清楚事情真相。","source":{"text":"钩距者，设欲知马贾（价），则先问狗，已问羊，又问牛，然后及马，参伍其贾，以类相准，则知马之贵贱，不失实矣。","book":"《汉书·赵广汉传》"},"similar":["问羊知马","举一反三"],"opposite":["不求甚解"],"usage":"作谓语、定语；同“问羊知马”","story":["汉宣帝时期，颍川太守赵广汉十分聪明能干，治理地方军政事务很有一套办法，他叫家仆到牲口市场去买马，并告诉他先问狗、羊、牛价，然后再问马价，把价格进行比较就能够以合适的价钱购买了。家仆十分佩服"]},{"id":45612,"word":"问罪之师","pinyin":"wèn zuì zhī shī","abbr":"wzzs","explanation":"问罪：宣布对方罪状，作为出兵的理由。讨伐犯罪者的军队。也比喻前来提出严厉责问的人。","source":{"text":"慷慨匡时略，从容问罪师。","book":"唐·杜牧《樊川诗集·和野人殷潜之题筹笔驿》"},"example":{"text":"日已向辰，喜无～。","book":"清·蒲松龄《聊斋志异·葛巾》"},"usage":"作宾语；比喻前来兴师问罪的人"},{"id":45613,"word":"问羊知马","pinyin":"wèn yáng zhī mǎ","abbr":"wyzm","explanation":"比喻从旁推究，弄清楚事情真相。","source":{"text":"钩距者，设欲知马贾，则先问狗，已问羊，又问牛，然后及马。","book":"东汉·班固《汉书·赵广汉传》"},"example":{"text":"～，钩距兼设。","book":"南朝·陈·徐陵《晋陵太守王励德政碑》"},"similar":["问牛知马","触类旁通"],"usage":"作谓语、定语；指善于类推"},{"id":45614,"word":"问舍求田","pinyin":"wèn shě qiú tián","abbr":"wsqt","explanation":"只知道置产业。比喻没有远大的志向。","source":{"text":"君有国士之名，今天下大乱，帝主失所，望君忧国忘家，有救世之意，而君求田问舍，言无可采，是元龙所讳也，何缘当与君语。","book":"晋·陈寿《三国志·魏志·陈登传》"},"example":{"text":"一年之后，遂为巨贾，～。","book":"清·和邦额《夜谭随录·袁翁》"},"similar":["求田问舍"],"usage":"作谓语、定语；指没有远大的志向"},{"id":45615,"word":"问花访柳","pinyin":"wèn huā fǎng liǔ","abbr":"whfl","explanation":"花、柳：原指春景，旧时亦指娼妓。原指赏玩春天的景色。后旧小说用来指宿娼。","source":{"text":"元戎小队出郊坰，问柳寻花到野处。","book":"唐·杜甫《严中丞枉驾见过》诗"}},{"id":45616,"word":"问诸水滨","pinyin":"wèn zhū shuǐ bīn","abbr":"wzsb","explanation":"滨：水边。比喻不承担责任或两者不相干。","source":{"text":"贡之不入，寡君之罪也，敢不共给？昭王之不复，君其问诸水滨！","book":"《左传·僖公四年》"},"example":{"text":"若夫昭王不返，惟胶舟之故，君其～，寡君不敢任咎。","book":"明·冯梦龙《东周列国志》第二十三回"},"usage":"作谓语；指两者不相干"},{"id":45617,"word":"问道于盲","pinyin":"wèn dào yú máng","abbr":"wdym","explanation":"向瞎子问路。比喻向什么也不懂的人请教，不解决问题。","source":{"text":"足下求速化之术，不于其人，乃以访愈，是所谓借听于聋，求道于盲。","book":"唐·韩愈《答陈生书》"},"example":{"text":"比往来南北，颇承友朋推一日之长，～。","book":"清·顾炎武《与友人论学书》"},"similar":["缘木求鱼","求道于盲"],"usage":"作谓语、定语；也作自谦用语"},{"id":45618,"word":"问长问短","pinyin":"wèn cháng wèn duǎn","abbr":"wcwd","explanation":"问：询问。仔细地问，表示关心。","source":{"text":"王夫人更不用说拉着甄宝玉问长问短，觉得比自己家的宝玉老成些。","book":"清·曹雪芹《红楼梦》第一百二十五回"},"example":{"text":"另外有许多人却挤着庄寿香，～，寿香手舞足蹈的讲给他们听。（清·曾朴《孽海花》第五回）"},"similar":["问这问那","问寒问暖"],"opposite":["不闻不问"],"usage":"作谓语；指表示关切"},{"id":45619,"word":"问鼎中原","pinyin":"wèn dǐng zhōng yuán","abbr":"wdzy","explanation":"问：询问，鼎：古代煮东西的器物，三足两耳。中原：黄河中下游一带，指疆域领土。比喻企图夺取天下。","source":{"text":"传说古代夏禹铸造九鼎，代表九州，作为国家权力的象征。夏、商、周三代以九鼎为传国重器，为得天下者所据有。"}},{"id":45620,"word":"问鼎之心","pinyin":"wèn dǐng zhī xīn","abbr":"wdzx","explanation":"问：询问。打听九鼎的大小轻重。相传禹铸九鼎，作为国家权力的象征。指有夺政权的野心。现也指在比赛中有夺魁的雄心。","source":{"text":"既素有重名，又立大功于江左，专任阃外，手控强兵，群从贵显，威权莫贰，遂欲专制朝廷，有问鼎之心。","book":"《晋书·王敦传》"},"example":{"text":"既属国步多虞，不能竭诚报德，岂可乘人间隙，便有～乎！","book":"《北史·苏湛传》"}},{"id":45621,"word":"问鼎轻重","pinyin":"wèn dǐng qīng zhòng","abbr":"wdqz","explanation":"问鼎的大小轻重。指妄图夺取天下。","source":{"text":"楚子问鼎之大小轻重焉？","book":"《左传·宣公三年》"}},{"id":45622,"word":"闯南走北","pinyin":"chuǎng nán zǒu běi","abbr":"cnzb","explanation":"奔走四方。","source":{"text":"一个女子会几手武艺不难，难的是她是一个尚未出闺的大姑娘，能够带领一班人在江湖上闯南走北。","book":"姚雪垠《李自成》第一卷第21章"},"example":{"text":"他～，见多识广。"},"similar":["走南闯北"],"usage":"作谓语、定语；形容阅历丰富"},{"id":45623,"word":"闯荡江湖","pinyin":"chuǎng dàng jiāng hú","abbr":"cdjh","explanation":"指奔走四方，在外谋生。","source":{"text":"说起许多他们年轻时一起闯荡江湖的故事，感叹着日子不如从前好过。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"我们～，已经习惯了这些生活。"},"similar":["闯南走北"],"usage":"作谓语、宾语；用于生活"},{"id":45624,"word":"闲不容息","pinyin":"xián bù róng xī","abbr":"xbrx","explanation":"连喘息的时间都没有。形容时间短促。","source":{"text":"将军毋失时，时闲不容息。","book":"《史记·张耳陈余列传》"}},{"id":45625,"word":"闲云孤鹤","pinyin":"xián yún gū hè","abbr":"xygh","explanation":"漂浮的云，孤飞的鹤。比喻无拘无束、来去自如的人。","source":{"text":"州亦难添，诗亦不改，然闲云野鹤何天而不可飞邪？","book":"宋·文莹《续湘山野录》"},"example":{"text":"州亦难添，诗亦难改，然～，何天而不可飞。","book":"宋·尤袤《全唐诗话》第六卷"},"similar":["闲云野鹤"],"usage":"作宾语、定语；比喻无拘无束、来去自如的人"},{"id":45626,"word":"闲云野鹤","pinyin":"xián yún yě hè","abbr":"xyyh","explanation":"闲：无拘束。飘浮的云，野生的鹤。旧指生活闲散、脱离世事的人。","source":{"text":"州亦难添，诗亦难改，然闲云孤鹤，何天而不可飞。","book":"宋·尤袤《全唐诗话》卷六"},"example":{"text":"独有妙玉如～，无拘无束。","book":"清·曹雪芹《红楼梦》第一百二十回"},"similar":["闲云孤鹤"],"usage":"作宾语、定语；比喻无拘无束、来去自如的人"},{"id":45627,"word":"闲居无聊","pinyin":"xián jū wú liáo","abbr":"xjwl","explanation":"闲居：独居。单独生活，无所事事。形容寂寞孤单。","source":{"text":"昨闻侯生闲居无聊，欲寻一秦淮佳丽，小弟已替他物色一人，名唤香君。","book":"清·孔尚任《桃花扇·侦戏》"},"similar":["闲极无聊"],"usage":"作谓语、宾语、定语；用于生活"},{"id":45628,"word":"闲情别致","pinyin":"xián qíng bié zhì","abbr":"xqbz","explanation":"指悠闲的心情和安逸的兴致。同“闲情逸致”。","source":{"text":"我们是有公事来的，拿我们丢在一边，倒有闲情别致在里头替人家画画儿！","book":"清·李宝嘉《官场现形记》第四十二回"},"example":{"text":"人那有遥管十余代以后的灰孙子时代的世界的～也哉？","book":"鲁迅《而已集·答有恒先生》"},"similar":["闲情逸致"],"usage":"作宾语、定语；含讥讽"},{"id":45629,"word":"闲情逸志","pinyin":"xián qíng yì zhì","abbr":"xqyz","explanation":"逸：安闲。指悠闲的心情和安逸的兴致","source":{"text":"要知世间好事甚多，谁有那些闲情逸志去做。","book":"清·李汝珍《镜花缘》第84回"},"similar":["闲情逸趣","闲情逸致"],"usage":"作宾语、定语；用于处事"},{"id":45630,"word":"闲情逸致","pinyin":"xián qíng yì zhì","abbr":"xqyz","explanation":"逸：安闲；致：情趣。指悠闲的心情和安逸的兴致。","source":{"text":"此时四处兵荒马乱，朝秦暮楚，我勉强做了一部《旧唐书》，那里还有闲情逸致弄这笔墨。","book":"清·李汝珍《镜花缘》第一百回"},"example":{"text":"古人所谓“穷愁著书”的话，是不大可靠的。穷到透顶，愁得要死的人，那里还有这许多～来著书？","book":"鲁迅《华盖集·“碰壁”之后》"},"similar":["悠哉游哉","悠然自得"],"usage":"作宾语；含讥讽"},{"id":45631,"word":"闲情逸趣","pinyin":"xián qíng yì qù","abbr":"xqyq","explanation":"指悠闲的心情和安逸的兴致。同“闲情逸致”。","source":{"text":"此时四处兵荒马乱，朝秦暮楚，我勉强做了一部《旧唐书》，那里还有闲情逸致弄这笔墨。","book":"清·李汝珍《镜花缘》第一百回"},"example":{"text":"你同意我谈的这些问题吗？你怀疑我有这样的～吗？","book":"李英儒《野火春风斗古城》第十四章"},"similar":["闲情逸致","闲情逸志"],"usage":"作宾语、定语；用于处事"},{"id":45632,"word":"闲愁万种","pinyin":"xián chóu wàn zhǒng","abbr":"xcwz","explanation":"闲愁：说不出的烦恼。莫名的烦恼极多。形容思想空虚，多愁善感。也形容愁情满怀。","source":{"text":"真乃是消磨了闲愁万种。","book":"元·李好古《张生煮海》第一折"},"usage":"作谓语、宾语、定语；形容愁情满怀"},{"id":45633,"word":"闲时不烧香，急来抱佛脚","pinyin":"xián shí bù shāo xiāng，jí lái bào fó jiǎo","abbr":"xsbsxjlbfj","explanation":"谚语。原比喻平时不往来，遇有急难才去恳求。后多指平时没有准备，临时慌忙应付。","source":{"text":"云南南一番国，专尚释教，又犯罪应诛者，捕之急，趋往寺中，抱佛脚悔过，便贳其罪。今谚云：‘闲时不烧香，急来抱佛脚’，乃番僧之语流于中国地。","book":"宋·张世南《宦游纪闻》"},"example":{"text":"正是～，各各暗笑，落得受了买东西吃。","book":"明·冯梦龙《喻世明言》卷十"},"similar":["平时不烧香，急来抱佛脚"],"opposite":["有备而来"],"usage":"作宾语、分句；指临时慌忙应付"},{"id":45634,"word":"闲是闲非","pinyin":"xián shì xián fēi","abbr":"xsxf","explanation":"无关紧要的是非、议论。","source":{"text":"堪笑多愁早老，管他闲是闲非。","book":"宋·赵长卿《西江月·雪江见红梅对酒》词"},"example":{"text":"外人说的～，都不要听他。","book":"明·施耐庵《水浒全传》第二十一回"},"similar":["闲非闲是"],"usage":"作宾语、定语；用于处事"},{"id":45635,"word":"闲曹冷局","pinyin":"xián cáo lěng jú","abbr":"xclj","explanation":"无足轻重的清闲的官署。","source":{"text":"故所引用者，急功近名之士，其迂缓愚诞，皆置诸闲曹冷局，终身不迁其官。","book":"清·昭连《啸亭杂录》卷一"},"example":{"text":"清·昭梿《啸亭杂录·不喜朋党》：“故所引用者，急功近名之士，其迂缓愚诞，皆置诸～，终身不迁其官。”"},"usage":"作宾语、定语；用于书面语"},{"id":45636,"word":"闲杂人等","pinyin":"xián zá rén děng","abbr":"xzrd","explanation":"指与工作无关的人员。","source":{"text":"若七日内主灯不灭，吾寿可增一纪；如灯灭，吾必死矣。闲杂人等，休教放入。","book":"明·罗贯中《三国演义》第一百三回"},"example":{"text":"外来的如吹鼓手、厨茶房，以至抬夫、轿夫这些～过多。","book":"清·文康《儿女英雄传》第三十二回"},"usage":"作主语、宾语；指无关人士"},{"id":45637,"word":"闲磕牙","pinyin":"xián kē yá","abbr":"xky","explanation":"磕牙：指说话。指说闲话，聊天。","source":{"text":"没人处则会闲磕牙，就里空奸诈。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"听蕉声，一阵一阵细雨下。何处与人～？","book":"清·蒲松龄《聊斋志异·凤阳士人》"}},{"id":45638,"word":"闲神野鬼","pinyin":"xián shén yě guǐ","abbr":"xsyg","explanation":"迷信指流散的鬼神。多比喻不务正业，到处游逛，寻事生非的人。","source":{"text":"有我们这样老无知老禽兽，不守本分，惯一招引闲神野鬼，上门闹吵。","book":"明·冯梦龙《喻世明言》卷三十九"},"example":{"text":"清·西周生《醒世姻缘传》第17回：“若是果真有某～，他见了真经，自然是退避的。”"},"similar":["邪神野鬼"],"usage":"作宾语、定语；用于比喻句"},{"id":45639,"word":"闲花埜草","pinyin":"xián huā yě cǎo","abbr":"xhyc","explanation":"野生的花草。比喻男子在妻子以外所玩弄的女子。同“闲花野草”。"},{"id":45640,"word":"闲花野草","pinyin":"xián huā yě cǎo","abbr":"xhyc","explanation":"野生的花草。比喻男子在妻子以外所玩弄的女子。","source":{"text":"他和那青松翠柏为交友，野草闲花作近邻。","book":"元·无名氏《马陵道》楔子：“将军战马今何在？野草闲花满地愁。”元·无名氏《渔樵记》第三折"},"example":{"text":"～休拈，赢得身安心自然。","book":"明·冯梦龙《古今小说·任孝子烈性为神》"},"similar":["野草闲花"],"usage":"作宾语、定语；指男子除妻子以外的女人"},{"id":45641,"word":"闲茶浪酒","pinyin":"xián chá làng jiǔ","abbr":"xclj","explanation":"指没正经的吃喝、浪荡。","source":{"text":"咱与您做参辰卯酉，谁待吃这闲茶浪酒！","book":"元·尚仲贤《气英布》第三折"},"example":{"text":"明·凌濛初《二刻拍案惊奇》第八卷：“少年心性，好的是那歌楼舞榭，倚翠偎红，绿水青山，～。”"},"usage":"作宾语、定语；用于书面语"},{"id":45642,"word":"闲见层出","pinyin":"xián jiàn céng chū","abbr":"xjcc","explanation":"先后一再出现。","source":{"text":"曾未几时，而群妖众异层见叠出，是果何自而来哉？","book":"宋·徐鹿卿《都城灾应诏上封事》"}},{"id":45643,"word":"闲言冷语","pinyin":"xián yán lěng yǔ","abbr":"xyly","explanation":"没有根据的讥刺他人的话。","source":{"text":"才说得骤，便不能入他，须是闲言冷语，掉放那里，说教来不觉。","book":"宋·朱熹《论语集注·子张问明章》"},"example":{"text":"去年重阳在我家遇到四婶与陈姨太吵架，听了些～，回家后很不高兴，以后便托病不再来我家。","book":"巴金《秋》一"},"similar":["闲言淡语"],"usage":"作宾语、定语；用于说话等"},{"id":45644,"word":"闲言泼语","pinyin":"xián yán pō yǔ","abbr":"xypy","explanation":"指与正事无关的话；废话。","source":{"text":"独怜词客与诗人，费多少闲言泼语。","book":"宋·郭应祥《鹊桥仙·丁卯七夕》词"},"similar":["闲言赘语","闲言淡语"],"usage":"作宾语、定语；用于说话等"},{"id":45645,"word":"闲言淡语","pinyin":"xián yán dàn yǔ","abbr":"xydy","explanation":"①无关紧要的话。②犹闲言冷语。没有根据的讥刺他人的话。","source":{"text":"笑杀常何，空有闲言长语多。","book":"宋·沈瀛《减字木兰花》词"},"example":{"text":"这些～，只当作一段开台锣鼓吧！","book":"马烽《吕梁英雄传·起头的话》"},"similar":["闲言冷语"],"usage":"作宾语、定语；用于处事等"},{"id":45646,"word":"闲言碎语","pinyin":"xián yán suì yǔ","abbr":"xysy","explanation":"闲：与正事无关；碎：指说话唠叨。唠叨些与正事无关的话。","source":{"text":"一个道紧急军情奉火牌，闲言碎语须耽待。","book":"明·冯惟敏《端正好·徐我亭归田》"},"example":{"text":"我们尽量不要让别人说～。"},"similar":["流言蜚语"],"usage":"作主语、宾语、定语；指恶意中伤的议论或话"},{"id":45647,"word":"闲言赘语","pinyin":"xián yán zhuì yǔ","abbr":"xyzy","explanation":"无关紧要的话；多余的话。","source":{"text":"一句千锤百炼、寓意深远的说话，就抵得许许多多不着边际的闲言赘语。","book":"秦牧《艺海拾贝·鹩哥的一语》"},"similar":["闲言淡语"],"usage":"作宾语、定语；用于说话等"},{"id":45648,"word":"闲言长语","pinyin":"xián yán cháng yǔ","abbr":"xycy","explanation":"议人长短的唠叨话。","source":{"text":"笑杀常何，空有闲言长语多。","book":"宋·沈瀛《减字木兰花》词"},"example":{"text":"秤搦锤出油，～休。腰缠十万贯，骑鹤上扬州。","book":"宋·释普济《五灯会元》卷十九"},"similar":["闲言碎语"],"usage":"作宾语、定语；用于处事等"},{"id":45649,"word":"闲言闲语","pinyin":"xián yán xián yǔ","abbr":"xyxy","explanation":"指不满意的话；没有根据的话。","source":{"text":"员外道：‘干娘！可奈这妮子……’，又不敢明说，脱口说出一句道：‘册儿上面都是用闲言闲语。’","book":"《平妖传》第三回"},"example":{"text":"宋大爷，～不要轻信，我女儿在家苦苦的盼望你呢。","book":"京剧《乌龙院》第五场"},"similar":["闲言碎语"],"usage":"作主语、宾语、定语；指没有根据的话"},{"id":45650,"word":"闲话休提，书归正传","pinyin":"xián huà xiū tí，shū guī zhèng zhuàn","abbr":"xhxtsgzz","explanation":"提：提说。指不要紧的话不必说了，还是回到正题上来。","source":{"text":"闲话休提，书归正传；看来袭人自己，日子也并不太好过。","book":"王朝闻《论凤姐》第16章"},"similar":["闲话休题，书归正传"],"usage":"作谓语、分句；用于说话"},{"id":45651,"word":"闲话休题","pinyin":"xián huā xiū tí","abbr":"xhxt","explanation":"题：提说。没有用的话就不要说了。多用于章回小说，也指说话和写文章不要扯远。","source":{"text":"且把闲话休题，只说正话。迅速光阴，却早冬来。林冲的绵衣裙袄，都是李小二浑身整治缝补。","book":"明·施耐庵《水浒全传》第十回"},"example":{"text":"～。且说钱典史听见这条门路，便一心一意的想去钻。","book":"清·李宝嘉《官场现形记》第三回"},"similar":["闲话少提"],"usage":"作谓语、分句；用于说话"},{"id":45652,"word":"闲话休题，书归正传","pinyin":"xián huà xiū tí，shū guī zhèng zhuàn","abbr":"xhxtsgzz","explanation":"题：通“提”，提说。指不要紧的话不必说了，还是回到正题上来。","source":{"text":"便从不入三教九流的小说家所谓‘闲话休题，书归正传’这一句套话里，取出‘正传’两个字来，作为名目。","book":"鲁迅《呐喊·阿Q正传》"},"similar":["闲话休提，书归正传"],"usage":"作谓语、分句；用于说话"},{"id":45653,"word":"闲话少提","pinyin":"xián huā shǎo tí","abbr":"xhst","explanation":"没有用的话就不要说了。多用于章回小说，也指说话和写文章不要扯远。","source":{"text":"闲话少提，只以办事为妙。","book":"清·李绿园《歧路灯》第六十五回"},"example":{"text":"～。到了初十以后，就有朱卷送来了。","book":"清·吴趼人《二十年目睹之怪现状》第四十三回"},"similar":["闲话休题"],"usage":"作谓语、分句；用于说话"},{"id":45654,"word":"闲邪存诚","pinyin":"xián xié cún chéng","abbr":"xxcc","explanation":"闲：防备，禁止。约束邪念，保持诚实。","source":{"text":"闲邪存其诚者，言防闲邪恶，当自存其诚实也。","book":"《周易·乾》：“闲存其诚。”孔颖达疏"},"example":{"text":"～，犹恐有阙。","book":"《旧唐书·陆贽传》"},"usage":"作谓语、宾语；指约束邪念，保持诚实"},{"id":45655,"word":"闲静少言","pinyin":"xián jìng shǎo yán","abbr":"xjsy","explanation":"不爱说笑，很少讲话。","source":{"text":"闲静少言，不慕荣利。","book":"晋·陶潜《五柳先生传》"}},{"id":45656,"word":"闲非闲是","pinyin":"xián fēi xián shì","abbr":"xfxs","explanation":"无关紧要的是非、议论。同“闲是闲非”。","source":{"text":"枉了闲烦闲恼，莫管闲非闲是，说甚古和今。","book":"宋·沈瀛《水调歌头》词"},"example":{"text":"～，不挂一丝头，牢闭口，紧降心，人我先除扫。","book":"元·姬翼《蓦山溪》词"},"similar":["闲是闲非"],"usage":"作宾语、定语；用于处事"},{"id":45657,"word":"闲鸥野鹭","pinyin":"xián ōu yě lù","abbr":"xoyl","explanation":"①比喻退隐闲散之人。②比喻非正当男女关系中的女方。","source":{"text":"贱子平生出处，虽则闲鸥野鹭，十五度黄河。","book":"清·龚自珍《水调歌头》词"},"example":{"text":"清·龚自珍《台城路》词：“催我归舟，鸳鸯牒紧，莫恋～。”"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":45658,"word":"闳中肆外","pinyin":"hóng zhōng sì wài","abbr":"hzsw","explanation":"闳：博大；肆：奔放，淋漓尽致。指文章内容丰富，文笔又能尽量发挥。","source":{"text":"先生之于文，可谓闳其中而肆其外矣。","book":"唐·韩愈《进学解》"},"example":{"text":"李、杜之高凌八代，俯视一切者，气之大也。气大则～，致广尽微而有余。","book":"清·无名氏《静居绪言》"},"usage":"作定语、宾语；指文章内容丰富"},{"id":45659,"word":"闳侈不经","pinyin":"hóng chǐ bù jīng","abbr":"hcbj","explanation":"指不着边际，不合常理；近乎荒诞，没有根据。同“闳大不经”。","source":{"text":"揉曲木者，不得不过其直，恣言至其极，则以为鷇卵毛鳞，皆有佛性，其冥极亦与人等。此特其左证之义，觊以齐一四类，而闳侈不经，以至于滥，有牛鼎之意焉。","book":"章炳麟《訄书·平等难》"},"similar":["闳大不经"],"usage":"作谓语、定语；指语言等"},{"id":45660,"word":"闳大不经","pinyin":"hóng dà bù jīng","abbr":"hdbj","explanation":"指不着边际，不合常理；近乎荒诞，没有根据。","source":{"text":"[驺衍]乃深观阴阳消息而作怪迂之变，《终始》、《大圣》之篇十馀万言。其语闳大不经，必先验小物，推而大之，至于无垠。","book":"《史记·孟子荀卿列传》"},"example":{"text":"谓层叠而上之古史阶段，至道家阴阳家而突飞猛进者，非仅以两家之好为荒唐之言，与～之语也，尚有事实之证据在。","book":"罗根泽《诸子考索·晚周诸子反古考·商君书》"},"similar":["闳侈不经"],"usage":"作谓语、定语；指语言等"},{"id":45661,"word":"闳宇崇楼","pinyin":"hóng yǔ chóng lóu","abbr":"hycl","explanation":"指大屋高楼。","source":{"text":"谓厥祖在时，其为智慧武怒者何似，尝有闳宇崇楼，珠玉犬马，尊显胜于凡人。","book":"鲁迅《坟·摩罗诗力说》"},"similar":["高楼大厦"],"usage":"作主语、宾语、定语；指高楼"},{"id":45662,"word":"闳意妙指","pinyin":"hóng yì miào zhǐ","abbr":"hymz","explanation":"指宏大微妙的意旨。指，同“旨”，意义，目的。","source":{"text":"《孝经》者，曾子以后，支流苗裔之书，平易泛滥，无大疵，无闳意妙指，如置之二戴所录中，与《坊记》、《缁衣》、《孔子闲居》、《曾子天圆》比，非《中庸》、《祭义》、《礼运》之伦也。","book":"清·龚自珍《六经正名》"},"similar":["闳意眇指"],"usage":"作宾语、定语；用于说话等"},{"id":45663,"word":"闳意眇指","pinyin":"hóng yì miǎo zhǐ","abbr":"hymz","explanation":"指宏大微妙的意旨。眇，通“妙”。","source":{"text":"今吾子乃抗辞幽说，闳意眇指，独驰骋于有亡之际，而陶治大炉，旁薄群生，历览者兹年矣，而殊不寤。","book":"《汉书·扬雄传下》"},"example":{"text":"九星之为斗，则其义若明若昧。古法具在，而～，无复申理之者矣。","book":"清·俞正燮《癸巳类稿·九宫应九星考》"},"similar":["闳意妙指"],"usage":"作宾语、定语；用于说话等"},{"id":45664,"word":"闳览博物","pinyin":"hóng lǎn bó wù","abbr":"hlbw","explanation":"闳：宏大；闳览：博览群书，见识广博；博：广大。指读书很多，见多识广，能够辨别各种事物。","source":{"text":"呜呼，又何其闳览博物君子也。","book":"《史记·吴太伯世家》"}},{"id":45665,"word":"闳言崇议","pinyin":"hóng yán chóng yì","abbr":"hycy","explanation":"指博大高远的议论。","source":{"text":"若夫闳言崇议，幽微之涂，凙难与览者同也。","book":"《汉书·扬雄传下》"},"similar":["闳言高论"],"usage":"作主语、宾语、定语；用于人的观点等"},{"id":45666,"word":"闳言高论","pinyin":"hóng yán gāo lùn","abbr":"hygl","explanation":"指博大高远的议论。","source":{"text":"故其间钜人硕德闳言高论流铄前后者，恃其所载之在文也。","book":"宋·欧阳修《代人上王枢密求先集序书》"},"similar":["闳言崇议"],"usage":"作主语、宾语、定语；用于人的观点等"},{"id":45667,"word":"闳识孤怀","pinyin":"hóng shí gū huái","abbr":"hsgh","explanation":"远大的见解，独特的情操。","source":{"text":"班氏闳识孤怀，不逮子长远甚。","book":"清·曾国藩《圣哲画像记》"},"example":{"text":"下笔放眼，偃然若有古人之在我眼前，则～，窃叹古今人不数觏矣。","book":"金松芩《文学观》"},"usage":"作宾语；指人的情操"},{"id":45668,"word":"闳远微妙","pinyin":"hóng yuǎn wēi miào","abbr":"hywm","explanation":"闳：宏大；远：深远。宏大深远，极为精妙。","source":{"text":"儒家惟有孟子宏远微妙，缊奥难见，宜在条理之科。","book":"汉·赵岐《孟子题辞》"}},{"id":45669,"word":"间不容发","pinyin":"jiàn bù róng fà","abbr":"jbrf","explanation":"间：空隙。空隙中容不下一根头发。比喻与灾祸相距极近或情势危急到极点。","source":{"text":"系绝于天，不可复结，坠入深渊，难以复出，其出不出，间不容发。","book":"汉·枚乘《上书谏吴王》"},"example":{"text":"这事～，明天就上个折子，一定要争回此事。","book":"清·梁启超《新中国未来记》第一回"},"similar":["间不容缕"],"usage":"作定语；比喻事物很精密或时间紧迫","story":["西汉时期，吴王刘濞准备谋反，他的谋士枚乘认为不可为，就写《上书谏吴王》说：马刚受惊吓就打鼓吓它，线将断又吊重物，这两者危险程度相近，中间容不下一根头发，请大王深思。刘濞没有理睬。枚乘只好改投奔别人了"]},{"id":45670,"word":"间不容息","pinyin":"jiàn bù róng xī","abbr":"jbrx","explanation":"间：中间；容：容纳；息：喘息。中间都不容喘一口气。形容时机紧迫，不容延误。","source":{"text":"时之反侧，间不容息。","book":"西汉·刘安《淮南子·原道训》"},"example":{"text":"两军相持，事机之来，～。","book":"《旧唐书·陆贽传》"},"similar":["间不容缓"],"usage":"作谓语；形容时机紧迫"},{"id":45671,"word":"间不容瞚","pinyin":"jiān bù róng xǐ","abbr":"jbrs","explanation":"指眨眼的时间都没有。形容时间的短促。"},{"id":45672,"word":"间不容瞬","pinyin":"jiān bù róng shùn","abbr":"jbrs","explanation":"指眨眼的时间都没有。形容时间短促。","source":{"text":"至其当发，间不容瞬。","book":"《素问·宝命全形论》"},"similar":["间不容息"],"usage":"作定语、状语；指时间短暂"},{"id":45673,"word":"间不容砺","pinyin":"jiān bù róng lì","abbr":"jbrl","explanation":"指磨治的时间也没有。形容时间的短促。","source":{"text":"佐斗嫁祸，纷若猬毛，曝骨履肠，间不容砺。","book":"《隋书·李德林传》"},"similar":["间不容缕"],"usage":"作谓语、定语、状语；用于书面语"},{"id":45674,"word":"间不容缓","pinyin":"jiān bù róng huǎn","abbr":"jbrh","explanation":"指刻不容缓。","source":{"text":"是否赞同，迅祈赐覆。千钧一发，间不容缓也。","book":"龚振黄《青岛潮》第十章"},"similar":["刻不容缓"],"usage":"作谓语；指刻不容缓"},{"id":45675,"word":"间不容缕","pinyin":"jiān bù róng lǚ","abbr":"jbrl","explanation":"比喻与灾祸相距极近或情势危急到极点。同“间不容发”。","source":{"text":"民之祸福，间不容缕。","book":"宋·苏轼《奉诏祷雨诸庙祝文》"},"similar":["间不容发"],"usage":"作定语；比喻事物很精密或时间紧迫"},{"id":45676,"word":"间见层出","pinyin":"jiàn xiàn céng chū","abbr":"jxcc","explanation":"先后一再出现。","source":{"text":"及其为诗，刿目鉥心，刃迎缕解，钩章棘句，掏擢胃肾，神施鬼设，间见层出。","book":"唐·韩愈《贞曜先生墓志铭》"},"example":{"text":"或对客挥毫，或联句叠韵，新意奇语，～，迫之而不以为难，引之而不知其所穷。","book":"明·李东阳《〈白洲诗集〉序》"},"similar":["层见叠出"],"usage":"作谓语、定语；用于人或事物等"},{"id":45677,"word":"闵乱思治","pinyin":"mǐn luàn sī zhì","abbr":"mlsz","explanation":"指怜悯乱世而思盼治世。"},{"id":45678,"word":"闷嘴葫芦","pinyin":"mèn zuǐ hú lú","abbr":"mzhl","explanation":"不爱说话的人。","example":{"text":"我不喜欢你这个～。"},"similar":["闷葫芦","没嘴葫芦"],"opposite":["多口阿师"],"usage":"作宾语；指不爱说话的人"},{"id":45679,"word":"闷在鼓里","pinyin":"mèn zài gǔ lǐ","abbr":"mzgl","explanation":"被包在鼓里面。比喻受人蒙蔽，对有关的事情一点儿也不知道。","source":{"text":"坐井观天，闷在鼓里，怎么行？","book":"姚雪垠《李自成》第一卷第18章"},"similar":["蒙在鼓里"],"usage":"作谓语；指受人蒙蔽"},{"id":45680,"word":"闷声不响","pinyin":"mēn shēng bù xiǎng","abbr":"msbx","explanation":"不言不语，一声不响。","source":{"text":"客人下光后，先出来了几个飞行员，闷声不响地走过。","book":"王朔《空中小姐》"},"example":{"text":"他～，像一个闷葫芦。"},"similar":["不言不语"],"usage":"作谓语、状语；指不响亮"},{"id":45681,"word":"闷怀顿释","pinyin":"mèn huái dùn shì","abbr":"mhds","explanation":"心中的忧虑、烦闷一下子就消失了。","example":{"text":"听了他的劝告，我已经～了。"},"usage":"作谓语、定语；用于处事"},{"id":45682,"word":"闷海愁山","pinyin":"mèn hǎi chóu shān","abbr":"mhcs","explanation":"忧愁如山，苦闷似海。形容愁闷象山一样大，象海一样深，无法排遣。","source":{"text":"听说罢姓名家乡，这情苦意切，闷海愁山将我心上撇，不由人不泪珠流血。","book":"元·施惠《幽闺记·三十二缨闺拜月》"},"usage":"作宾语、定语；用于比喻句"},{"id":45683,"word":"闷胡卢","pinyin":"mèn hú lú","abbr":"mhl","explanation":"比喻难以猜破的哑谜，或难以弄清楚的事情。","source":{"text":"这是什么闷胡卢，没头没脑的。","book":"鲁迅《彷徨·肥皂》"},"similar":["闷葫芦"],"usage":"作宾语；用于比喻句"},{"id":45684,"word":"闷葫芦","pinyin":"mèn hú lú","abbr":"mhl","explanation":"比喻很难猜透而令人纳闷的话或事情。","source":{"text":"这个鸟闷葫芦教我如何猜得破？","book":"元·纪君祥《赵氏孤儿》第四折：“好着我沉吟半晌无分诉，这画的是徯幸杀我也闷葫芦”。明·施耐庵《水浒传》第二十八回"},"example":{"text":"他们要早告诉了我，何苦叫我打这半天的～呢！","book":"清·文康《儿女英雄传》第二十七回"},"similar":["一声不吭","闷嘴葫芦"],"usage":"作宾语；比喻很难猜透而令人纳闷的事情"},{"id":45685,"word":"闷闷不乐","pinyin":"mèn mèn bù lè","abbr":"mmbl","explanation":"闷闷：心情不舒畅，心烦。形容心事放不下，心里不快活。","source":{"text":"意欲弃布他往，却又不忍；又恐被人嗤笑。乃终日闷闷不乐。","book":"明·罗贯中《三国演义》第十八回"},"example":{"text":"当夜永清～，灯下披甲观书。","book":"清·俞万春《荡寇志》第八十六回"},"similar":["郁郁不乐","闷闷不悦"],"opposite":["喜不自胜"],"usage":"作谓语、定语、状语；形容人不快乐"},{"id":45686,"word":"闷闷不悦","pinyin":"mèn mèn bù yuè","abbr":"mmby","explanation":"闷闷：心情不舒畅，心烦；悦：愉悦。形容心情烦闷不快活。","source":{"text":"‘只可惜他落在别国，倒在此处做了对头。奈何，奈何！’闷闷不悦，这也不题。","book":"明·郭勋《英烈传》第24回"},"example":{"text":"惟蒯公～。","book":"明·冯梦龙《警世通言》第18卷"},"similar":["闷闷不乐"],"opposite":["兴高采烈"],"usage":"作谓语、定语、状语；形容人不快乐"},{"id":45687,"word":"闹中取静","pinyin":"nào zhōng qǔ jìng","abbr":"nzqj","explanation":"指在热闹的环境中保持清静的心态。","source":{"text":"人学得它，便是闹中取静，才算做真闲。","book":"明·冯梦龙《喻世明言》第14卷"},"example":{"text":"我们要学会～，不受外界影响，静心学习。"},"usage":"作宾语、定语；用于生活方式"},{"id":45688,"word":"闹闹哄哄","pinyin":"nào nào hōng hōng","abbr":"nnhh","explanation":"吵吵闹闹，指喧闹的场面。","source":{"text":"学习成了一种可有可无的东西，整天闹闹哄哄地搞各种社会活动。","book":"路遥《平凡的世界》第一卷第16章"},"similar":["吵吵闹闹"],"usage":"作定语、状语；用于口语"},{"id":45689,"word":"闺英闱秀","pinyin":"guī yīng wéi xiù","abbr":"gywx","explanation":"大户人家的才貌娇好的女子。","source":{"text":"凡远亲近友之家，所见的那些闺英闱秀，皆未有稍及黛玉者。","book":"清·曹雪芹《红楼梦》第29回"},"similar":["大家闺秀"],"usage":"作宾语；形容女子"},{"id":45690,"word":"闻一增十","pinyin":"wén yī zēng shí","abbr":"wyzs","explanation":"闻：听到；增：增加。听到一点夸张十倍。形容把听到的事大肆渲染。","source":{"text":"故誉人不增其美，则闻者不快其意；毁人不益其恶，则听者不惬于心。闻一增以为十，见百益以为千。使夫纯朴之事，十剖百判；审然之语，千反万畔。","book":"汉·王充《论衡·艺增》"}},{"id":45691,"word":"闻一知二","pinyin":"wén yī zhī èr","abbr":"wyze","explanation":"听到一点就能理解很多。形容善于类推。","source":{"text":"赐也何敢望回？回也闻一以知十，赐也闻一以知二。","book":"春秋·鲁·孔丘《论语·公冶长》"},"example":{"text":"古人云～，与你说了左转，你便晓得右转。","book":"蔡东藩《慈禧太后演义》第35回"},"similar":["闻一知十"],"usage":"作谓语、定语；指善于类推","story":["春秋时期，孔子的得意门生子贡口才很好，很有外交才能。齐国田常想进攻鲁国，孔子派子贡前去游说，子贡于是挑起齐国、吴国、晋国之间的矛盾，让鲁国免战。孔子问子贡与颜回哪一个优秀一些，子贡说颜回闻一知十，自己只能闻一知二"]},{"id":45692,"word":"闻一知十","pinyin":"wén yī zhī shí","abbr":"wyzs","explanation":"听到一点就能理解很多。形容善于类推。","source":{"text":"赐也何敢望回？回也闻一以知十，赐也闻一以知二。","book":"《论语·公冶长》"},"example":{"text":"后世决狱大师，有能神而明之，～也者，吾不得而尽知也。","book":"清·龚自珍《春秋决事比自序》"},"similar":["闻一知二"],"usage":"作谓语、定语；指善于类推","story":["春秋时期，孔子的得意门生子贡口才很好，很有外交才能。齐国田常想进攻鲁国，孔子派子贡前去游说，子贡于是挑起齐国、吴国、晋国之间的矛盾，让鲁国免战。孔子问子贡与颜回哪一个优秀一些，子贡说颜回闻一知十，自己不如他"]},{"id":45693,"word":"闻义而徙","pinyin":"wén yì ér xǐ","abbr":"wyex","explanation":"闻：听到；义：正义；徙：迁移。听到符合道义的事就心动神往，虚心相就。","source":{"text":"德之不修，学之不讲，闻义不能徙，不善不能改，是吾忧也。","book":"《论语·述而》"}},{"id":45694,"word":"闻名不如见面","pinyin":"wén míng bù rú jiàn miàn","abbr":"wmbrjm","explanation":"只听名声不如见面更能了解。","source":{"text":"吾闻闻名不如见面，小人未见礼教，何足责哉。","book":"《北史·列女传》"},"example":{"text":"王博高也不觉好笑，连说：“老兄真是个爽快人，～。”","book":"清·李宝嘉《官场现形记》第二十七回"},"similar":["眼见为实"],"usage":"作宾语、定语；用于劝诫人"},{"id":45695,"word":"闻名丧胆","pinyin":"wén míng sàng dǎn","abbr":"wmsd","explanation":"听见名字就吓破了胆。形容威名很大，使人听到即甚为恐惧。","source":{"text":"遂在陕西地面三载，绿林贼人闻名丧胆，江湖盗寇望影皆惊。","book":"清·姜振名《永庆升平前传》第八回"},"example":{"text":"郭澄清《大刀记》第六章：“这个吓得鬼子、汉奸～的梁永生，就是当初那个大闹黄家镇的梁永生。”"},"similar":["闻风丧胆"],"usage":"作谓语、定语；用于处事"},{"id":45696,"word":"闻名遐迩","pinyin":"wén míng xiá ěr","abbr":"wmxe","explanation":"遐：远；迩：近。形容名声很大，远近都知道。","source":{"text":"上流声议，遐迩所闻。","book":"《南齐书·高帝纪上》"},"similar":["遐迩闻名"],"opposite":["默默无闻"],"usage":"作谓语、宾语、定语；指名声很大"},{"id":45697,"word":"闻呼即至","pinyin":"wén hū jí zhì","abbr":"whjz","explanation":"闻：听到；呼：呼唤；即：立刻；至：到。听到呼唤立刻就到。形容动作迅速。","source":{"text":"高祖性好棋，每从夜达旦不辍，等辈皆倦寐，惟庆之不寝，闻呼即至，甚见亲赏。","book":"《梁书·陈庆之传》"},"example":{"text":"此时已及黄昏，树德正在饮酒，～。","book":"清·俞万春《荡寇志》第一百二十九回"}},{"id":45698,"word":"闻噎废食","pinyin":"wén yē fèi shí","abbr":"wyfs","explanation":"听到有人吃饭噎了一下，自己就连饭也不吃了。比喻因为怕出问题，索性不干。","source":{"text":"夫有以噎死者，欲禁天下之食，悖。","book":"《吕氏春秋·荡兵》"},"similar":["因噎废食"],"usage":"作谓语、宾语、定语；多用于比喻句"},{"id":45699,"word":"闻声相思","pinyin":"wén shēng xiāng sī","abbr":"wsxs","explanation":"声：名声。指思慕、钦仰有声望的人。","source":{"text":"君臣上下之事，有远而亲，近而疏，就之不用，去之反求，日进前不御，遥闻声而相思。","book":"《鬼谷子·内揵》"},"example":{"text":"朋友～，命驾相仿，也是常事。","book":"清·吴敬梓《儒林外史》第九回"},"usage":"作谓语；指思念"},{"id":45700,"word":"闻宠若惊","pinyin":"wén chǒng ruò jīng","abbr":"wcrj","explanation":"犹言受宠若惊。因为得到宠爱或赏识而又高兴，又不安。","source":{"text":"恐泊泥以浊白水，飘尘以乱清风，是以承命倾筐，闻宠若惊。","book":"南朝·梁·殷芸《小说》第二卷"},"example":{"text":"将启北户之人，向通云南之国，～，奄从深夜。","book":"北周·庾信《罔大将军琅琊定公司马裔墓志铭》"},"similar":["受宠若惊"],"opposite":["麻木不仁"],"usage":"作谓语、定语、状语；指人惊讶"},{"id":45701,"word":"闻所不闻","pinyin":"wén suǒ bù wén","abbr":"wsbw","explanation":"听到从未听到过的。形容事物非常希罕。","source":{"text":"越中无足与语，至生来，令我日闻所不闻。","book":"《史记·郦生陆贾列传》"},"example":{"text":"自吾交仲素，日～，奥学清节，真南州之冠冕也。","book":"《宋史·罗从彦传》"},"similar":["闻所未闻"],"opposite":["习以为常"],"usage":"作谓语、宾语、定语；指道理、内容等","story":["西汉初年，汉高祖刘邦派幕僚陆贾去赐给尉他南越王印授。尉他虽是中原人，久居南越称王，不愿帮助中原人诛暴除逆。陆贾劝慰他早日归顺汉王，说中国人多地大，土地肥沃，物产丰富，政令统一。尉他听到这些闻所未闻的事后就归顺"]},{"id":45702,"word":"闻所未闻","pinyin":"wén suǒ wèi wén","abbr":"wsww","explanation":"闻：听到。听到了从来没有听到过的事。形容事物新奇罕见。","source":{"text":"越中无足与语，至生来，令我日闻所未闻。","book":"《史记·郦生陆贾列传》"},"example":{"text":"今日见了紫菱姐姐飞来飞去，业已奇极；谁知还有海外这些异事，真是～。","book":"清·李汝珍《镜花缘》第六十回"},"similar":["见所未见","闻所不闻"],"opposite":["司空见惯","习以为常"],"usage":"作谓语、宾语、定语；指道理、内容等","story":["西汉初年，汉高祖刘邦派幕僚陆贾去赐给尉他南越王印授。尉他虽是中原人，久居南越称王，不愿帮助中原人诛暴除逆。陆贾劝慰他早日归顺汉王，说中国人多地大，土地肥沃，物产丰富，政令统一。尉他听到这些闻所未闻的事后就归顺"]},{"id":45703,"word":"闻者咋舌","pinyin":"wén zhě zhà shé","abbr":"wzzs","explanation":"闻：听到；咋舌：咬住舌头。听到别人讲的话，咬住自己的舌头。形容听到的人都震惊得不敢出声。","source":{"text":"寅复吟唐人诗‘长安有贫者，宜瑞不宜多’句，闻者咋舌。","book":"《明史·盛寅传》"},"example":{"text":"既而曰：“使后世或妄以许衡、刘因辈贤我，且死不瞑目矣！”～。","book":"《清史稿·傅山传》"}},{"id":45704,"word":"闻融敦厚","pinyin":"wén róng dūn hòu","abbr":"wrdh","explanation":"待人温和宽厚。","example":{"text":"他的个性～，因此许多人乐于与他相交为友。"}},{"id":45705,"word":"闻过则喜","pinyin":"wén guò zé xǐ","abbr":"wgzx","explanation":"过：过失；则：就。听到别人批评自己的缺点或错误，表示欢迎和高兴。指虚心接受意见。","source":{"text":"子路人告之以有过则喜。","book":"《孟子·公孙丑上》"},"example":{"text":"故其～，知过不讳，改过不惮。","book":"宋·陆九渊《与傅全美书》"},"similar":["严于律己","知错必改"],"opposite":["文过饰非","知错不改"],"usage":"作谓语、定语；指虚心接受意见","story":["战国时期，孟子对他的弟子们谈到勇于接受批评的问题时，举出历史上三个善于接受别人意见的人，即子路、禹和舜。春秋时鲁国人子路是孔子的弟子之一，他为人诚实，刚直好勇，别人指出他的缺点时，他虚心接受并且十分高兴"]},{"id":45706,"word":"闻道犹迷","pinyin":"wén dào yóu mí","abbr":"wdym","explanation":"闻：听到，引申为知道；道：道路，指正道；犹：还；迷：迷失。已经知道哪是正路，还是往迷路上走。比喻知错不改，一错到底。","source":{"text":"计若失路不反，闻道犹迷，不南合子阳，则北入文伯耳。","book":"《后汉书·窦融传》"}},{"id":45707,"word":"闻雷失箸","pinyin":"wén léi shī zhù","abbr":"wlsz","explanation":"比喻借别的事情掩饰自己的真实情况。","source":{"text":"是时曹公从容谓先主曰：‘今天下英雄，唯使君与操耳。本初之徒，不足数也。’先主方食，失匕箸。","book":"《三国志·蜀书·先主传》"},"similar":["战栗失箸"],"usage":"作谓语、定语；用于人","story":["东汉末年，刘备因为失势落魄到去投奔曹操，曹操招待他，刘备为掩饰自己的野心，装做种菜，不闻政事。曹操设宴款待刘备，席间与刘备祝酒论英雄，认为他们俩才是真正的英雄。刘备吓得惊慌失措筷子都掉了，刚好雷声掩盖了这一切"]},{"id":45708,"word":"闻风丧胆","pinyin":"wén fēng sàng dǎn","abbr":"wfsd","explanation":"丧胆：吓破了胆。听到风声，就吓得丧失的勇气。形容对某种力量非常恐惧。","source":{"text":"故能望影揣情，已探致虏之术；岂止闻风破胆，益坚慕义之心。","book":"唐·李德裕《授张仲武东面招抚回鹘使制》"},"example":{"text":"打得敌人～，弃尸累累。","book":"魏巍《东方》第五部第一章"},"similar":["丧魂落魄","心惊胆战"],"opposite":["泰然自若","不动声色"],"usage":"作谓语；指极度恐惧"},{"id":45709,"word":"闻风响应","pinyin":"wén fēng xiǎng yīng","abbr":"wfxy","explanation":"听到风声就起而赞同支持。","source":{"text":"随有乡勇章双桂等三千余人，闻风响应。","book":"清·叶廷琯《鸥陂渔话·邹广文效忠图》"},"example":{"text":"《辛亥革命·徐锡麟安庆起义清方档案》：“更恐各处～，刻已分电沿江各省，一体严密防范，以期防患未萌。”"},"usage":"作谓语、定语；用于处事"},{"id":45710,"word":"闻风破胆","pinyin":"wén fēng pò dǎn","abbr":"wfpd","explanation":"听到一点风声就吓破了胆。形容对某种力量的极度惶恐。","source":{"text":"故能望影揣情，已探致虏之术，岂止闻风破胆，益坚慕义之心。","book":"唐·李德裕《授张仲武东面招抚回鹘使制》"},"example":{"text":"秉心忠直，使谗臣战栗不容；同理朝纲，人尽道忠贞辅佐。真个国家得我重如山，边境闻我惊破胆。","book":"明·徐元《八义记》卷六"},"similar":["闻风丧胆"],"usage":"作谓语、宾语；用于处事"},{"id":45711,"word":"闻风而兴","pinyin":"wén fēng ér xīng","abbr":"wfex","explanation":"一听到风声，就立刻起来响应。同“闻风而起”。","source":{"text":"百世之才，犹当复有闻风而兴起者，其志远矣。","book":"宋·朱熹《跋陈了翁责沈后》"},"example":{"text":"甬上之～者，一时多英伟高明之士，吴仲其一也。","book":"清·黄宗羲《董吴仲墓志铭》"},"similar":["闻风而起"],"usage":"作谓语；形容反应迅速"},{"id":45712,"word":"闻风而动","pinyin":"wén fēng ér dòng","abbr":"wfed","explanation":"风：风声，消息。一听到风声，就立刻起来响应。","source":{"text":"登堂莫及，闻风而起。","book":"宋·陈亮《祭赵尉母夫人文》"},"example":{"text":"这时，“石一歌”也～了。","book":"王西彦《骗子和打手》"},"similar":["雷厉风行"],"opposite":["纹丝不动"],"usage":"作谓语、定语；形容行动迅速","story":["春秋时期，孔子带领弟子周游列国，在卫、陈、蔡等国碰壁后，受到了楚国的邀请。陈国串通蔡国放出囚犯围堵孔子，那些囚犯闻风而动，将孔子师徒被围困很多天。孔子师徒断了粮，只有派子贡外出求援。听说楚军到来，囚犯们纷纷抱头鼠窜了"]},{"id":45713,"word":"闻风而至","pinyin":"wén fēng ér zhì","abbr":"wfez","explanation":"一听到消息就来。形容行动迅速。","source":{"text":"舅兄只顾要将细鸟带回船去，刚才被他这阵乱叫，以致众兽闻风而至，几乎性命不保。","book":"清·李汝珍《镜花缘》第21回"},"example":{"text":"老舍《四世同堂》：“早一点下手，把牌子创开，日本人必～，咱们的小羊圈就成了文化中心。”"},"similar":["闻风而动"],"opposite":["无动于衷"],"usage":"作谓语；用于处事"},{"id":45714,"word":"闻风而起","pinyin":"wén fēng ér qǐ","abbr":"wfeq","explanation":"闻：听到；风：风声，消息。一听到风声，就立刻起来响应。","source":{"text":"登堂莫及，闻风而起。","book":"宋·陈亮《祭赵尉母夫人文》"},"example":{"text":"别处的人一定也有～的，这便是救中国的独一无二法门了。","book":"梁启超《新中国未来记》第三回"},"similar":["闻风而动"],"opposite":["纹丝不动"],"usage":"作谓语；形容反应迅速"},{"id":45715,"word":"闻风而逃","pinyin":"wén fēng ér táo","abbr":"wfet","explanation":"风：风声。听到风声，立即逃跑。","source":{"text":"只要望见土匪的影子，早已闻风而逃。","book":"清·李宝嘉《官场现形记》第12回"},"example":{"text":"敌人早就～。"},"similar":["望风而逃"],"usage":"作谓语；指没有战斗力"},{"id":45716,"word":"闻风自遁","pinyin":"wén fēng zì dùn","abbr":"wfzd","explanation":"闻：听到；风：风声，消息；遁：逃跑。听到风声自己逃跑了。形容非常怕对方。","source":{"text":"贾似道打听得蒙古有事北归，鄂州围解，遂将议和称臣纳币之事瞒过不提，上表夸张己功。只说蒙古俱己威名，闻风远遁。","book":"明·冯梦龙《喻世明言》卷二十二"},"example":{"text":"天有久雨，俟晴，破了太原，辽兵～，不必益兵。","book":"明·无名氏《杨家府演义·继业夜观天象》"}},{"id":45717,"word":"闻风远扬","pinyin":"wén fēng yuǎn yáng","abbr":"wfyy","explanation":"风：风声，消息。指听到一点风声就逃得远远的。","source":{"text":"贾似道打听得蒙古有事北归，鄂州围解，遂将议和称臣纳币之事瞒过不提，上表夸张己功。只说蒙古俱己威名，闻风远遁。","book":"明·冯梦龙《古今小说·木绵庵郑虎臣报冤》"},"example":{"text":"财场中闹出事，只有个～的高着。","book":"清·李绿园《歧路灯》第六十五回"},"similar":["闻风远遁"],"usage":"作谓语、定语、宾语；用于处事"},{"id":45718,"word":"闻风远遁","pinyin":"wén fēng yuǎn dùn","abbr":"wfyd","explanation":"风：风声，消息；远遁：远逃。听到一点风声就逃得远远的。","source":{"text":"贾似道打听得蒙古有事北归，鄂州围解，遂将议和称臣纳币之事瞒过不提，上表夸张己功。只说蒙古俱己威名，闻风远遁。","book":"明·冯梦龙《古今小说·木绵庵郑虎臣报冤》"},"similar":["闻风远扬"],"usage":"作谓语、定语；用于处事"},{"id":45719,"word":"闻风逃遁","pinyin":"wén fēng táo dùn","abbr":"wftd","explanation":"风：风声，消息；逃遁：远逃。听到一点风声就逃得远远的。","source":{"text":"只见城门大门，百姓携老扶幼，一路跪接，备说镇守元将，闻风逃遁。","book":"明·徐渭《英烈传》第四十四回"},"example":{"text":"只是易瑛呢？要是～了怎么办？","book":"二月河《乾隆皇帝》三十"}},{"id":45720,"word":"闻香下马","pinyin":"wén xiāng xià mǎ","abbr":"wxxm","explanation":"闻：嗅；香：酒香味。闻到酒的香味，尽管正骑马赶路，也要下马品尝。形容酒非常好。","source":{"text":"那三太爷频频咽涎，象有闻香下马的光景。","book":"清·酌元亭主人《照世杯·百和坊将无作有》"}},{"id":45721,"word":"闻鸡起舞","pinyin":"wén jī qǐ wǔ","abbr":"wjqw","explanation":"闻：听到。听到鸡叫就起来舞剑。后比喻有志报国的人及时奋起。","source":{"text":"中夜闻荒鸡鸣，蹴琨觉，曰：‘此非恶声也。’因起舞。","book":"《晋书·祖逖传》"},"example":{"text":"击楫誓清，～，毕竟英雄得。","book":"宋·松洲《念奴娇·题钟山楼》词"},"similar":["发奋图强","自强不息"],"opposite":["苟且偷安","自暴自弃"],"usage":"作谓语、定语；指人勤奋","story":["东晋时期，北方大部分土地被金人占领，司州主簿祖逖和刘琨两人想要收复北方的领土，他们经常畅谈到深夜，然后听到公鸡打鸣就起床练剑。经过一段时间的刻苦训练，祖逖带兵北伐，收复了黄河以南的大片土地"]},{"id":45722,"word":"闻鼓而进，闻金而退","pinyin":"wén gǔ ér jìn，wén jīn ér tuì","abbr":"wgejwjet","explanation":"作战时听到鼓声就前进，听到鸣金就后退。指军队服从命令，行动一致。"},{"id":45723,"word":"闾巷草野","pinyin":"lǚ xiàng cǎo yě","abbr":"lxcy","explanation":"闾巷：街巷。比喻民间乡野地方。","source":{"text":"臣又求之于闾巷草野之间，而亦未见其多焉。","book":"唐·王勃《上皇帝万言书》"},"example":{"text":"在位之人才既不足，而～之间亦不可用之才，社稷之托，封疆之守。","book":"《宋史·王安石传》"},"usage":"作主语、宾语、定语；指民间"},{"id":45724,"word":"闾阎安堵","pinyin":"lǔ yán ān dǔ","abbr":"lyad","explanation":"指平民安居。","source":{"text":"额捐赀集勇，谨守疆埸，绝济匪之源，挫触藩之锐，卒能化枭为鸠，闾阎安堵。","book":"清昭槤《啸亭杂录·朱白泉狱中上百朱二公书》"},"example":{"text":"游衰世之国者，行于其野，～，击壤以嬉，如是者民类治世。","book":"严复《论中国教化之退》"},"similar":["安居乐业"],"usage":"作宾语；指安居乐业"},{"id":45725,"word":"闾阎扑地","pinyin":"lǘ yán pū dì","abbr":"lypd","explanation":"闾阎：指里巷的门或房屋。里巷遍地。形容房屋众多，市集繁华。","source":{"text":"唐·王勃《滕王阁序》:“闾阎扑地，钟鸣鼎食之家；舸舰迷津，青雀黄龙之轴。”"}},{"id":45726,"word":"阅人多矣","pinyin":"yuè rén duō yǐ","abbr":"yrdy","explanation":"形容人阅历多，跟各种各样的人打过交道，一眼就能看出人的好坏以至于他的前程。","source":{"text":"仆阅人多矣，未见如此郎者，必成伟器。","book":"《旧唐书·房玄龄传》"},"usage":"作谓语；用于处事"},{"id":45727,"word":"阅人成世","pinyin":"yuè rén chéng shì","abbr":"yrcs","explanation":"阅：总，合。总众人而成世。","source":{"text":"川阅水以成川，水滔滔而日度。世阅人而为世，人冉冉而行暮。人何世而弗新，世何人之能故。","book":"晋·陆机《叹逝赋》"}},{"id":45728,"word":"阅后付丙","pinyin":"yuè hòu fù bǐng","abbr":"yhfb","explanation":"看过之后把信件投入火中烧掉。","source":{"text":"绂之区区，未必可行，幸先生恕其狂愚，或以为可教，则一览付火。","book":"宋·岳珂《桯史·大散论赏书》"},"example":{"text":"公速求陆军机以解此围，否则恐有不测。十二月初八日名叩～。（清·遽园《负曝闲谈》得二十五回）"}},{"id":45729,"word":"阆苑琼楼","pinyin":"làng yuàn qióng lóu","abbr":"lyql","explanation":"阆：空旷，宽阔；琼：赤色玉。广大的园林，华美的楼阁。传说中的神仙住处。也指皇帝贵族的宫苑。","source":{"text":"里面阆苑琼楼，奇花异草，奥妙非常。","book":"清·石玉昆《三侠五义》第十一回"},"example":{"text":"又好似游那阆苑琼楼，隔绝了十丈红尘，直喜得眉开眼笑，连连赞美。","book":"许慕义《宋代宫闱史》第二十三回"},"similar":["阆苑瑶台"],"usage":"作宾语；指豪华建筑"},{"id":45730,"word":"阆苑瑶台","pinyin":"làng yuàn yáo tái","abbr":"lyyt","explanation":"阆：空旷；瑶：美玉；瑶台：雕饰华丽、结构精巧的楼台。广大的园林，华美的楼台。","source":{"text":"阆苑瑶台岁月长，一归华表好增伤。","book":"唐·徐夤《鹤》诗"},"example":{"text":"～风露秋，整鬤凝思捧觥筹。","book":"宋·晏殊《浣溪沙》词"},"similar":["阆苑琼楼"],"usage":"作宾语、定语；指仙境"},{"id":45731,"word":"阋墙之衅","pinyin":"xì qiáng zhī xìn","abbr":"xqzx","explanation":"阋墙：兄弟相争于内；衅：缝隙，引申为争端。原指兄弟互相争吵。后比喻兄弟纷争。","source":{"text":"兄弟阋于墙，外御其侮。","book":"《诗经·小雅·常棣》"},"example":{"text":"宋礼立又蹄之约，希蜗角之争。莫大以对床之情，消～。","book":"明·凌濛初《二刻拍案惊奇》卷十"}},{"id":45732,"word":"阋墙御侮","pinyin":"xì qiáng yù wǔ","abbr":"xqyw","explanation":"阋：争吵；阋墙：兄弟相争于内；御侮：抵御外敌。比喻虽有内部争吵，仍能一致对外。","source":{"text":"兄弟阋于墙，外御其务（侮）。每有良朋，烝也无戎。","book":"《诗经·小雅·棠棣》"},"example":{"text":"凡我国民，务念～之忠言，懔同室操戈之大戒，折衷真理，互相提携，忍此小嫌，同扶大局。","book":"蔡东藩、许廑父《民国演义》第一二回"},"usage":"作谓语、定语；用于兄弟"},{"id":45733,"word":"阋墙谇帚","pinyin":"xì qiáng suì zhǒu","abbr":"xqsz","explanation":"指家庭内部争吵不和。谇帚，指妇女吵骂。","source":{"text":"若是者，虽未见其阋墙谇帚，我知其家必不治。","book":"梁启超《新民说》"},"usage":"作宾语、定语；用于书面语"},{"id":45734,"word":"阎王好见，小鬼难当","pinyin":"yán wáng hǎo jiàn，xiǎo guǐ nán dāng","abbr":"ywhjxgnd","explanation":"阎王：传说中主管地狱的神；小鬼：鬼神的差役。指头目见面好说话，喽罗却难缠。","source":{"text":"阎王好见，小鬼难当，旁边若有人帮衬，敲敲边鼓，用一个钱，可得两钱之益。","book":"清·李宝嘉《官场现形记》第十九回"},"example":{"text":"俗话说：～，你得提防点。"},"usage":"作宾语、定语、分句；用于慨叹"},{"id":45735,"word":"阎罗包老","pinyin":"yán luó bāo lǎo","abbr":"ylbl","explanation":"包老：包公。指刚正耿直的人。","source":{"text":"关节不到，有阎罗包老。","book":"《宋史·包拯传》"},"example":{"text":"便～难弹破，除取旨前来撒和。","book":"明·汤显祖《牡丹亭·硬拷》"}},{"id":45736,"word":"阎罗王面前须没放回的鬼","pinyin":"yán luó wáng miàn qián xū méi fàng huí de guǐ","abbr":"ylwmqxmfhdg","explanation":"人死后就不会复活。比喻到手的钱不会再退出来","source":{"text":"这话却似放屁！做公人的‘那个猫儿不吃腥’？阎罗王面前须没放回的鬼。","book":"明·施耐庵《水浒传》第21回"},"usage":"作宾语、定语；用于比喻句"},{"id":45737,"word":"阐幽抉微","pinyin":"chǎn yōu jué wēi","abbr":"cyjw","explanation":"指阐明幽隐，抉发精微。","source":{"text":"一些谈艺术理论的著作为了要‘阐幽抉微’，也往往容易把艺术的道理谈得很深奥。","book":"秦牧《艺海拾贝·象和蚁的童话》"},"similar":["阐幽明微"],"usage":"作谓语、宾语；用于学问等"},{"id":45738,"word":"阐幽探赜","pinyin":"chǎn yōu tàn zé","abbr":"cytz","explanation":"阐；阐明；赜：幽深莫测。阐明和探究深奥精微的道理。","source":{"text":"岂史主于纪大而略小，诗主于阐幽探赜，其为教一而其为体则异耶。","book":"明·唐顺之《吴儒人挽诗》序"},"similar":["阐幽探微"],"usage":"作谓语、宾语；用于学问等"},{"id":45739,"word":"阐幽明微","pinyin":"chǎn yōu míng wēi","abbr":"cymw","explanation":"使幽深隐微的事物或道理显露出来。","source":{"text":"司风教者，重务良多，无暇彰表，则阐幽明微，赖兹刍荛。","book":"清·蒲松龄《聊斋志异·孝子》"},"similar":["阐幽抉微"],"usage":"作谓语、定语；指深入研究"},{"id":45740,"word":"阐幽显微","pinyin":"chǎn yōu xiǎn wēi","abbr":"cyxw","explanation":"阐：阐明；幽：幽深。讲明深奥和精微的道理。形容挖掘深，能启发人认识所未能认识的事物。","source":{"text":"无《易》彰往而察来，而微显阐幽。","book":"《周易·系辞下》"}},{"id":45741,"word":"阐扬光大","pinyin":"chǎn yáng guāng dà","abbr":"cygd","explanation":"发扬光大。指使美好的事物在原来基础上不断发展、扩大和提高。","source":{"text":"待木之人，望兄速了业缘，以阐扬光大此学为不朽事业。","book":"明·李贽《与焦弱侯书》"},"example":{"text":"他要把这个绝技～。"},"similar":["发扬光大"],"usage":"作谓语；指发扬光大"},{"id":45742,"word":"阑风伏雨","pinyin":"lán fēng fú yǔ","abbr":"lffy","explanation":"指夏秋之际的风雨。后亦泛指风雨不已。同“阑风长雨”。","source":{"text":"阑风伏雨催寒食，樱桃一夜花狼藉。","book":"宋·周端臣《清夜游》词：“西园昨夜，又一番、阑风伏雨。”清·纳兰性德《菩萨蛮》词"},"example":{"text":"～吹十日，作比酷暑如蒸燖。","book":"清·黄景仁《夏夜》诗"},"similar":["阑风长雨"],"usage":"作宾语；指风雨不已"},{"id":45743,"word":"阑风长雨","pinyin":"lán fēng zhàng yǔ","abbr":"lfcy","explanation":"阑珊的风，冗多的雨。指夏秋之际的风雨。后亦泛指风雨不已。亦作“阑风伏雨”。","source":{"text":"阑风长雨秋纷纷，四海八荒同一云。","book":"唐杜甫《秋雨叹》诗之二"},"example":{"text":"节里无多好天色，阑风长（原注：去声）雨饯残年。","book":"宋杨万里《过八尺遇雨》诗之一"},"similar":["阑风伏雨"],"usage":"作宾语；指风雨不已"},{"id":45744,"word":"阒其无人","pinyin":"qù qí wú rén","abbr":"qqwr","explanation":"阒：空。指空荡荡，没有一人。","source":{"text":"窥其户，阒其无人。","book":"《周易·丰》"},"example":{"text":"噫！何以二万万方里辽阔之幅员，竟如～也。","book":"黄中黄《孙逸仙》第一章"},"similar":["阒无一人"],"usage":"作谓语；指空荡"},{"id":45745,"word":"阒无一人","pinyin":"qù wú yī rén","abbr":"qwyr","explanation":"阒：空。指空荡荡，没有一人。","source":{"text":"曾梦至一处，见禅床几杖萧然，而阒无一人。","book":"清·刘献廷《广阳杂记》卷四"},"example":{"text":"逾墙入视，则～。","book":"清·纪昀《阅微草堂笔记·姑妄听之二》"},"similar":["阒其无人"],"usage":"作谓语、定语；指空荡"},{"id":45746,"word":"阒无人声","pinyin":"qù wú rén shēng","abbr":"qwrs","explanation":"指静寂得没有一点人声。","source":{"text":"趋至，则破屋前后二间，阒无人声。","book":"清·东轩主人《述异记·僵尸鬼》"},"example":{"text":"这地方十分安静，～，让人害怕。"},"similar":["阒若无人"],"usage":"作谓语、定语；形容安静"},{"id":45747,"word":"阒然无声","pinyin":"qù rán wú shēng","abbr":"qrws","explanation":"形容寂寞得一点声音也没有。","source":{"text":"及期，率众至其家，阒然无声，厨下灯微明，趋视之饮食毕具，盖以待舁棺者，妇已缢死灶旁矣。","book":"《周易·丰》：“窥其户，阒其无人。”《明史·列女专》"},"example":{"text":"须臾，东方月上，照耀得如同万顷玻璃一般。那些眠鸥宿鹭，～。","book":"清·吴敬梓《儒林外史》第一回"}},{"id":45748,"word":"阒若无人","pinyin":"qù ruò wú rén","abbr":"qrwr","explanation":"阒：寂静。寂静得像没人一样。","source":{"text":"予友既抵其处，则见重门紧闭，阒若无人。","book":"孙中山《伦敦蒙难记》"},"similar":["阒无人声"],"usage":"作谓语、定语；形容安静"},{"id":45749,"word":"阔步高谈","pinyin":"kuò bù gāo tán","abbr":"kbgt","explanation":"阔步：迈大步。潇洒地迈着大步，随意地高声交谈。比喻言行不受束缚。","source":{"text":"乃弘三章之教，恺悌之化，欲使曩时累息之民，得阔步高谈，无危惧之心。","book":"《三国志·魏志·文帝纪》：“号曰《皇览》”裴松之注引《魏书·曹丕》"},"similar":["高谈阔步"],"usage":"作谓语、定语；指潇洒的态度"},{"id":45750,"word":"阔论高谈","pinyin":"kuò lùn gāo tán","abbr":"klgt","explanation":"阔：广阔；高：高深。多指不着边际地大发议论。","source":{"text":"高谈阔论若无人，可惜明君不遇真。","book":"唐·吕岩《徽宗斋会》"},"example":{"text":"想才郎丰鉴，貌堂堂～。","book":"元·曾瑞《醉花阴·怀离》"},"similar":["高谈阔论"],"usage":"作宾语；指广博高妙的议论"},{"id":45751,"word":"阖第光临","pinyin":"hé dì guāng lín","abbr":"hdgl","explanation":"阖第：全家；光临：对客人来临的敬辞。旧时用于邀请别人全家参加宴会或喜庆仪式的客套话。","source":{"text":"上面印着‘为舍妹出阁’，‘小儿完姻’，‘敬请观礼’或‘阖第光临’这些……句子。","book":"鲁迅《狗·猫·鼠》"},"example":{"text":"欢迎你～我们的婚礼。"},"usage":"作谓语、宾语；用于邀请的客套语"},{"id":45752,"word":"阖门却扫","pinyin":"hé mén què sǎo","abbr":"hmqs","explanation":"阖：关闭；却：拒绝，停止；却扫：谢客。关上大门，不再打扫庭院路径。指闭门谢客，不和外界往来。","source":{"text":"阖门兮却扫，幽处兮高堂。","book":"汉·王粲《寡妇赋》"},"similar":["闭门却扫"],"usage":"作谓语、定语；指不和外界往来"},{"id":45753,"word":"阖门百口","pinyin":"hé mén bǎi kǒu","abbr":"hmbk","explanation":"指全家所有人。","source":{"text":"[孙嵩]密问岐曰：‘视子非卖饼者，以相问而色动，不有重怨，即亡命乎？我北海孙宾石，阖门百口，势均力敌能相济。’","book":"《后汉书·赵岐传》"},"example":{"text":"臣～，仰戴隆恩，无可报答，惟有竭诚尽力，为臣死忠，为子死孝，庶以少酬造之万一耳。","book":"明张居正《归葬事毕谢恩疏》"},"similar":["举家上下","全家老少"],"usage":"作宾语；指全家所有人"},{"id":45754,"word":"阙一不可","pinyin":"què yī bù kě","abbr":"qybk","explanation":"两种以上因素中，缺少哪一种也不行。","source":{"text":"善以少击众。欲有所举，尽召诸统制与谋，谋定而后战，故有胜无败。猝遇敌不动，故敌为之语曰：‘撼山易，撼岳家军难。’张俊尝问用兵之术，曰：‘仁、智、信、勇、严，阙一不可。’","book":"《宋史·岳飞传》"},"example":{"text":"古之成大事者，规模远大与综理密微，二者～。","book":"《曾国藩家书》"}},{"id":45755,"word":"阪上走丸","pinyin":"bǎn shàng zǒu wán","abbr":"bszw","explanation":"阪：斜坡；丸：弹丸。象在斜坡上滚弹丸。比喻形势发展迅速或工作进行顺利。","source":{"text":"边城皆将相告曰：‘范阳令先下而身富贵’，必相率而降，犹如阪上走丸也。","book":"《汉书·蒯通传》"},"example":{"text":"君弱臣愚，外崩内溃，周人取之犹～也。","book":"隋·卢思道《后周兴亡论》"},"similar":["风云突变"],"usage":"作谓语、定语；比喻形势发展迅速"},{"id":45756,"word":"阮囊羞涩","pinyin":"ruǎn náng xiū sè","abbr":"rnxs","explanation":"阮囊：晋代阮孚的钱袋；羞涩：难为情。比喻经济困难。","source":{"text":"阮孚持一皂囊，游会稽。客问：‘囊中何物？’曰：‘但有一钱看囊，恐其羞涩。’","book":"宋·阴时夫《韵正群玉·阳韵·一钱囊》"},"example":{"text":"～，行止两难。","book":"清·百一居士《壶天录》卷上"},"similar":["囊空如洗","室如悬罄"],"opposite":["腰缠万贯","堆金积玉"],"usage":"作谓语、定语；指手头无钱","story":["东晋时期，“竹林七贤”之一的阮咸的儿子阮孚与他的父亲一样高傲放荡，不与权贵同流合污。他整日衣冠不整，饮酒游玩，从不治家产，因此生活十分贫困，曾经把金貂拿去换酒喝。他经常带的钱袋，穷极时口袋里只保留一枚小钱"]},{"id":45757,"word":"防不及防","pinyin":"fáng bù jí fáng","abbr":"fbjf","explanation":"防：防备。指想到防备却已来不及防备。","source":{"text":"可见小人之伺君子，每于所忽，有防不及防者也。","book":"清·夏敬渠《野叟曝言》第67回"},"example":{"text":"敌人被打得晕头转向、～。"},"similar":["防不胜防"],"opposite":["应付自如"],"usage":"作定语、状语；指无法防备"},{"id":45758,"word":"防不胜防","pinyin":"fáng bù shèng fáng","abbr":"fbsf","explanation":"防：防备；胜：尽。形容防备不过来。","source":{"text":"这种小人，真是防不胜防。","book":"清·吴趼人《二十年目睹之怪现状》第四十七回"},"example":{"text":"叭儿之类，是不足惧的，最可怕的确是口是心非的所谓“战友”，因为～。","book":"鲁迅《致杨霁云信》"},"similar":["猝不及防","突如其来"],"opposite":["万无一失","料事如神"],"usage":"作谓语、定语；表示能力小，难以承受"},{"id":45759,"word":"防人之口，甚于防川","pinyin":"fáng rén zhī kǒu，shèn yú fáng chuān","abbr":"frzksyfc","explanation":"防：阻止；甚：超过；川：河流。想堵住人民的嘴，比堵塞河川还难。指不让人民说话，是不明智的。","source":{"text":"古人为政，防人之口，甚于防川。","book":"《晋书·孔严传》"},"similar":["防民之口，甚于防川"],"usage":"作宾语、定语、分句；用于统治者"},{"id":45760,"word":"防君子不防小人","pinyin":"fáng jūn zǐ bù fáng xiǎo rén","abbr":"fjzbfxr","explanation":"指关门上锁之类预防措施，对那些强盗是不起任何作用的。"},{"id":45761,"word":"防微杜渐","pinyin":"fáng wēi dù jiàn","abbr":"fwdj","explanation":"微：微小；杜：堵住；渐：指事物的开端。比喻在坏事情坏思想萌芽的时候就加以制止，不让它发展。","source":{"text":"若敕政责躬，杜渐防萌，则凶妖消灭，害除福凑矣。","book":"晋·韦謏《启谏冉闵》：“清诛屏降胡，以单于之号以防微杜渐。”  《后汉书·丁鸿传》"},"example":{"text":"有不尽者，亦宜～而禁于未然。","book":"《元史·张桢传》"},"similar":["防患未然"],"opposite":["养痈遗患"],"usage":"作谓语、定语、宾语；指事前预防","story":["汉和帝刘肇即位后，窦太后掌权，她的哥哥窦宪被封为武阳侯，权力越来越大。丁鸿直言不讳地对刘肇说大将军武阳侯窦宪仪仗太后的势力，包揽朝政，这是朝廷的隐患要及时清除。汉和帝采纳了丁鸿的意见，罢免了窦宪等人的官职"]},{"id":45762,"word":"防微杜衅","pinyin":"fáng wēi dù xìn","abbr":"fwdx","explanation":"犹言防微杜渐。","source":{"text":"往奉台翰，怜不肖之愚忠，教以防微杜衅，慎自持爱。","book":"明·张居正《答上师相徐存斋》十九"},"similar":["防微杜渐","防萌杜渐"],"usage":"作谓语、定语、宾语；指事前预防"},{"id":45763,"word":"防微虑远","pinyin":"fáng wēi lǜ yuǎn","abbr":"fwly","explanation":"虑：考虑，思虑。指在错误或坏事刚露头的时候，就加以防止，并考虑长远的计策。","source":{"text":"由是洞启宸衷，大破群议，运筹制胜，举无遗策，防微虑远。","book":"唐·郑亚《唐丞相太尉卫国公李德裕会昌一品制集序》"},"example":{"text":"为建极导民之本思，所以大振朝纲者，为～之图。","book":"宋·朱熹《辞免焕章阁待制侍讲奏状二》"},"usage":"作谓语、宾语、定语；指考虑长远"},{"id":45764,"word":"防心摄行","pinyin":"fáng xīn shè xíng","abbr":"fxsx","explanation":"指防止杂念和注意言行。"},{"id":45765,"word":"防患于未然","pinyin":"fáng huàn yú wèi rán","abbr":"fhywr","explanation":"患：灾祸；未然：没有这样，指尚未形成。防止事故或祸害于尚未发生之前。","source":{"text":"君子防未然。","book":"《周易·既济》：“君子以思患而豫防之。”《乐府诗集·君子行》"},"example":{"text":"臣闻～者易，除患于已然者难。","book":"明·马文升《添风宪以抚流民疏》"},"similar":["防患未然"],"opposite":["临渴掘井"],"usage":"作谓语、宾语；指在事故发生前防范"},{"id":45766,"word":"防患未然","pinyin":"fáng huàn wèi rán","abbr":"fhwr","explanation":"患：灾祸；未然：没有这样，指尚未形成。防止事故或祸害于尚未发生之前。","source":{"text":"君子防未然。","book":"《周易·既济》：“君子以思患而豫防之。”《乐府诗集·君子行》"},"example":{"text":"君子～，这事非同小可。","book":"清·石昆玉《三侠五义》第十二回"},"similar":["防微杜渐","有备无患","未雨绸缪"],"opposite":["临渴掘井","江心补漏","患至呼天"],"usage":"作谓语、宾语、定语；指事前预防","story":["从前一人去探望他的朋友，见朋友家炉灶设计不合理，便提出改灶搬柴的建议，主人没有采纳。不久主人家房子着火，人们纷纷帮助救火，主人备酒杀牛感谢那些焦头烂额的救火人，人们提出应该感谢那个改灶搬柴的人"]},{"id":45767,"word":"防患未萌","pinyin":"fáng huàn wèi méng","abbr":"fhwm","explanation":"防止祸患于未发生之前。","source":{"text":"大局所关，防患未萌，当局必有远虑。","book":"清·黄彭年《代刘蓉函件》之一"},"example":{"text":"或虑民心良莠不齐，恐有意外之变，如设立保甲连环保结；皆能～，有何惧之有？","book":"郑观应《盛世危言·民团上》"},"similar":["防患未然"],"opposite":["江心补漏"],"usage":"作谓语、宾语、定语；指事前预防"},{"id":45768,"word":"防意如城","pinyin":"fáng yì rú chéng","abbr":"fyrc","explanation":"意：心思，指私欲。指严格遏止私心杂念，象守城防敌一样。","source":{"text":"藏六如龟，防意如城，慧与魔战，胜则无患。","book":"唐·道世《法苑珠林》"},"example":{"text":"富郑公有守口如瓶，～之语。","book":"宋·周密《癸辛杂识别集下·守口如瓶》"},"usage":"作补语；指严格遏止私心杂念"},{"id":45769,"word":"防民之口，甚于防川","pinyin":"fáng mín zhī kǒu，shèn yú fáng chuān","abbr":"fmzksyfc","explanation":"防：阻止；甚：超过。阻止人民进行批评的危害，比堵塞河川引起的水患还要严重。指不让人民说话，必有大害。","source":{"text":"防民之口，甚于防川，川壅而溃，伤人必多，民亦如之。是故为川者，决之使导；为民者，宣之使言。","book":"春秋·鲁·左丘明《国语·周语上》"},"example":{"text":"我们不能采取“～”的管理政策。"},"similar":["防民之口，甚于防水"],"opposite":["知无不言，言无不尽"],"usage":"作宾语、定语、分句；指统治者","story":["西周时期，周厉王特别残暴，劭公劝告周厉王不要太过分，周厉王于是派人到路上去监视百姓的言行，使得人们只能道路以目。劭公叹息道，防民之口，甚于防川的做法太过分，是行不通的。没过多久，愤怒的人们起来将周厉王赶下台"]},{"id":45770,"word":"防民之口，甚于防水","pinyin":"fáng mín zhī kǒu，shèn yú fáng shuǐ","abbr":"fmzksyfs","explanation":"防：阻止；甚：超过。想堵住人民的嘴，比堵塞河水还难。指不让人民说话，是不明智的。","source":{"text":"召公曰：是障之也。防民之口，甚于防水。","book":"西汉·司马迁《史记·周本纪》"},"similar":["防民之口，甚于防川"],"usage":"作宾语、定语、分句；用于统治者"},{"id":45771,"word":"防祸于未然","pinyin":"fáng huò yú wèi rán","abbr":"fhywr","explanation":"防止祸患于萌发之前。","source":{"text":"事不当时固争，防祸于未然。","book":"东汉·班固《汉书·外戚传·孝成赵皇后》"},"example":{"text":"杜甫用这个典故，意思是对于‘苍生’要卧薪尝胆地严加警惕，要能～。","book":"郭沫若《李白与杜甫·杜甫的阶级意识》"},"similar":["防患于未然"],"usage":"作谓语、宾语；指在事故发生前防范"},{"id":45772,"word":"防芽遏萌","pinyin":"fáng yá è méng","abbr":"fyem","explanation":"错误或恶事在未显露时，即加以阻止、防范。","source":{"text":"大行皇帝览古戒今，防芽遏萌，虑于千载。","book":"《三国志·卷五十九·吴书·吴主五子传·孙奋传》"},"similar":["防微杜渐","防患未然"],"usage":"作谓语、定语、宾语；指事前预防"},{"id":45773,"word":"防萌杜渐","pinyin":"fáng méng dù jiàn","abbr":"fmdj","explanation":"杜：堵住；渐：指事物的开端；萌：萌芽。在事故或灾害尚未发生时就预防。","source":{"text":"若敕政责躬，杜渐防萌，则凶妖销灭，害除福凑矣。","book":"《后汉书·丁鸿传》"},"example":{"text":"先王制法，有以兵刃至御所者刑之，所以～，备不虞也。","book":"《旧唐书·宗本纪上》"},"similar":["防微杜渐","防微杜衅"],"opposite":["养痈遗患"],"usage":"作谓语、定语、宾语；指事前预防"},{"id":45774,"word":"防蔽耳目","pinyin":"fáng bì ěr mù","abbr":"fbem","explanation":"防：挡；蔽：挡住。堵住耳朵，遮住眼睛。比喻蔽塞视听。","source":{"text":"太后自以行不修，惧宗室所嫌，于是内为朋党，防蔽耳目，肃宗所亲幸者，太后多以事害焉。","book":"《魏书·皇后传》"}},{"id":45775,"word":"阳九之会","pinyin":"yáng jiǔ zhī huì","abbr":"yjzh","explanation":"阳九：古代术数家的说法，四千六百一十七岁为元，初入元一百零六岁，外有灾岁九，称为“阳九”。指灾难之年或厄运。","source":{"text":"予遭阳九之阸，百六之会，枯旱霜蝗，饥馑荐臻。","book":"《汉书·食货志上》"},"example":{"text":"尧汤之运，不能去～。","book":"《北史·高祐传》"},"similar":["阳九之厄","阳九百六"],"usage":"作主语、宾语、定语；用于书面语"},{"id":45776,"word":"阳九之厄","pinyin":"yáng jiǔ zhī è","abbr":"yjze","explanation":"阳九：古代术数家的说法，四千六百一十七岁为元，初入元一百零六岁，外有灾岁九，称为“阳九”。指灾难之年或厄运。","source":{"text":"予受命遭阳九之厄，百六之会，府帑空虚，百姓匮乏，宗庙未修，且袷祭于明堂太庙，夙夜永念，非敢宁息。","book":"《汉书·王莽传》"},"example":{"text":"～，劫灰之运，天亡中国，无可如何。","book":"清·梁启超《论自由》"},"similar":["阳九之会","阳九百六"],"usage":"作主语、宾语、定语；用于书面语"},{"id":45777,"word":"阳九之阸","pinyin":"yáng jiǔ zhī è","abbr":"yjze","explanation":"阳九：古代术数家的说法，四千六百一十七岁为元，初入元一百零六岁，外有灾岁九，称为“阳九”。指灾难之年或厄运。","source":{"text":"予遭阳九之阸，百六之会，枯旱霜蝗，饥馑荐臻。","book":"《汉书·食货志上》"}},{"id":45778,"word":"阳九百六","pinyin":"yáng jiǔ bǎi liù","abbr":"yjbl","explanation":"阳九：古代术数家的说法，四千六百一十七岁为元，初入元一百零六岁，外有灾岁九，称为“阳九”。指灾难之年或厄运。","source":{"text":"予遭阳九之阸，百六之会，枯旱霜蝗，饥馑荐臻。","book":"《汉书·食货志上》"},"example":{"text":"其考～之数，历历灵验，其说可以得闻否？","book":"清·陈森《品花宝鉴》第三十八回"},"similar":["阳九之厄","阳九之会"],"usage":"作主语、宾语、定语；用于书面语"},{"id":45779,"word":"阳儒阴释","pinyin":"yáng rú yīn shì","abbr":"yrys","explanation":"阳：表面上；儒：儒家；阴：暗地里；释：释迦牟尼，泛指佛教。表面上阐述儒家学说，暗地里在宣传佛家观点。形容表里不一。","source":{"text":"故白沙起而厌弃之，然而遂启姚江王氏阳儒阴释诬圣之邪说，其究也，为刑戮之民，为阉贼之党，皆争附焉。","book":"清·王夫之《张子蒙注序论》"},"example":{"text":"小道因与他联络，为～之计，故得暂时保全白祥性命。","book":"清·夏敬渠《野叟曝言》第一百十回"},"usage":"作谓语、定语；用于书面语"},{"id":45780,"word":"阳关三迭","pinyin":"yáng guān sān dié","abbr":"ygsd","explanation":"阳关：古关名，在今甘肃敦煌县西南；三迭：反复歌唱某一句。原指古代送别的曲调。后也比喻离别。","source":{"text":"渭城朝雨浥清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。","book":"唐·王维《渭城曲》诗"},"example":{"text":"旧传《～》，然今世歌者，每句再迭而已。","book":"宋·苏轼《东坡志林》"},"similar":["阳关三叠"],"usage":"作宾语、定语；比喻离别","story":["唐朝时期，太子宾客刘禹锡每天上朝时路过一个平房，听到一个卖烧饼的男子哀叹地唱王维的《渭城曲》：“渭城朝雨邑清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。”他给他一万钱扩大买卖，从此再也听不到他唱此曲了"]},{"id":45781,"word":"阳关大道","pinyin":"yáng guān dà dào","abbr":"ygdd","explanation":"原指古代经过阳关通向西域的大道，后泛指宽阔的长路，也比喻光明的前途。","source":{"text":"绝域阳关道，胡沙与塞尘。","book":"唐·王维《送刘司直赴安西》诗"},"example":{"text":"他们已经跳过了可怕的阶级分化的历史道路，走上社会主义的～了。","book":"秦牧《原始公社的影子》"},"similar":["光明大道","康庄大道"],"opposite":["羊肠小道","穷途末路","山穷水尽"],"usage":"作宾语；指光明的前途"},{"id":45782,"word":"阳台云雨","pinyin":"yáng tái yún yǔ","abbr":"ytyy","explanation":"指男女欢爱之事。","source":{"text":"妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨。朝朝暮暮，阳台之下。","book":"战国·楚·宋玉《高唐赋序》"},"example":{"text":"明·胡文焕《群音类选·》：“关河鸿雁稀，魂迷，～疑。”"},"similar":["巫山云雨","巫云楚雨"],"usage":"作宾语、定语；指男女欢合","story":["传说古代襄王游览高唐地区，十分疲倦就在白天小睡了一会，在梦中看见一个仙女说：“我是高唐人，听说你来了，愿意给你当枕席。”襄王临幸了她。临别她说：“妾在巫山之阳，高丘之阻。旦为朝云，暮为行雨，朝朝暮暮，阳台之下。”"]},{"id":45783,"word":"阳和启蛰","pinyin":"yáng hé qǐ zhé","abbr":"yhqz","explanation":"启蛰：过冬的虫豸开始活动。春天来了，过冬的虫豸都活动了。比喻恶劣的环境过去，顺利和美好的时光开始了。","source":{"text":"条风斯应，候历维新。阳和启蛰，吕物皆春。","book":"《礼记·月令》：“东风解冻，蛰虫始振。”《宋史·乐志》"}},{"id":45784,"word":"阳城一笑","pinyin":"yáng chéng yī xiào","abbr":"ycyx","explanation":"阳在：县名，为楚时贵介公子所封。指美女之笑。","source":{"text":"嫣然一笑，惑阳城，迷下蔡。","book":"战国·楚·宋玉《登徒子好色赋》"}},{"id":45785,"word":"阳奉阴违","pinyin":"yáng fèng yīn wéi","abbr":"yfyw","explanation":"阳：表面上；奉：遵守，听从；阴：暗地里。指玩弄两面派手法，表面上遵从，暗地里违背。","source":{"text":"亦曾当面劝过他，无如卜知府阳奉阴违，也就奈何他不得。","book":"清·李宝嘉《官场现形记》第四十七回"},"example":{"text":"我们说话、做事都应老老实实，不要～。"},"similar":["两面三刀","口是心非","表里不一"],"opposite":["心口如一","表里如一"],"usage":"作谓语、定语、状语；指表里不一"},{"id":45786,"word":"阳春有脚","pinyin":"yáng chūn yǒu jiǎo","abbr":"ycyj","explanation":"用以称誉贤明的官员。","source":{"text":"宋璟爱民恤物，朝野归美，时人咸谓璟为有脚阳春，言所至之处，如阳春煦物也。","book":"五代·王仁裕《开元天宝遗事·有脚阳春》"},"example":{"text":"～，经过百姓人家。","book":"明·汤显祖《牡丹亭》第八出"},"similar":["有脚阳春"],"usage":"作谓语、定语；用于书面语"},{"id":45787,"word":"阳春白雪","pinyin":"yáng chūn bái xuě","abbr":"ycbx","explanation":"原指战国时代楚国的一种较高级的歌曲。比喻高深的不通俗的文学艺术。","source":{"text":"其为《阳阿》、《薤露》，国中属而和者数百人，其为《阳春》、《白雪》，国中属而和者不过数十人而已。","book":"战国·楚·宋玉《对楚王问》"},"example":{"text":"长老听了，赞叹不已道：“真是～，浩气冲霄。”","book":"明·吴承恩《西游记》第六十四回"},"similar":["曲高和寡","鲲鹏图南"],"opposite":["下里巴人","阳阿薤露"],"usage":"作主语、宾语；指文学作品"},{"id":45788,"word":"阳煦山立","pinyin":"yáng xù shān lì","abbr":"yxsl","explanation":"象太阳那样暖和，象山岳那样屹立。比喻人性格温和，品行端正。","source":{"text":"王君阳煦山立，宗庙器也。","book":"宋·胡继宗《书言故事·颜貌类》"},"usage":"作谓语、定语；用于书面语"},{"id":45789,"word":"阳秋可畏","pinyin":"yáng qiū kě wèi","abbr":"yqkw","explanation":"阳秋：原作“春秋”。《春秋》为古代寓褒贬、别善恶的编年体史书，这种有褒有贬秉笔直书的笔法，使有问题的人觉得可怕。","source":{"text":"储瓘为考功郎中，藏否不曲当，一时人士悚然曰；‘阳秋可畏’","book":"《孟子·滕文公下》：“孔子成《春秋》而乱臣贼子惧。”明·焦竑《献徵录》"}},{"id":45790,"word":"阳解阴毒","pinyin":"yáng jiě yīn dú","abbr":"yjyd","explanation":"指表面和解背后下毒手。","source":{"text":"盖彼皆君子路上人，决无有匿怨友人，阳解阴毒之事。","book":"明·李贽《答来书》"},"usage":"作定语；用于书面语"},{"id":45791,"word":"阳阿薤露","pinyin":"yáng ā xiè lù","abbr":"yaxl","explanation":"《阳阿》和《薤露》都是古歌曲名，是春秋时中等水平的歌曲。比喻能为较多的人所接受的文艺作品。","source":{"text":"其为《阳阿》、《薤露》，国中属而和者数百人。","book":"战国·楚·宋玉《对楚王问》"},"example":{"text":"首言客有歌于郢中者，下云其为～，其为阳春白雪，皆曲名。","book":"清·况周颐《蕙风词话》卷一"}},{"id":45792,"word":"阴云密布","pinyin":"yīn yún mì bù","abbr":"yymb","explanation":"浓厚的云层或空气中的大量的烟尘遮蔽天日。比喻形势险恶。","source":{"text":"将近一鼓时分，听半空风响，阴云密布，黑雾迷空，把一轮明月遮掩。","book":"明·许仲琳《封神演义》第二十六回"},"example":{"text":"在淞沪会战激烈进行之际，中国北方也是～，战火熊熊。","book":"马辂《国共和谈演义》第十六回"},"similar":["阴霾密布"],"usage":"作谓语、定语；用于天气等"},{"id":45793,"word":"阴凝冰坚","pinyin":"yīn níng bīng jiān","abbr":"ynbj","explanation":"阴气始凝结而为霜，渐积聚乃成坚冰。比喻小人渐渐得势，地位渐趋稳固。","source":{"text":"履霜坚冰，阴始凝也。","book":"《周易·坤》"},"example":{"text":"～，极于似道。","book":"宋·王应麟《困学纪闻·考史五》"},"usage":"作宾语、定语；指小人得志"},{"id":45794,"word":"阴凝坚冰","pinyin":"yīn níng jiān bīng","abbr":"ynjb","explanation":"阴气始凝结而为霜，渐积聚乃成坚冰。比喻小人渐渐得势，地位渐趋稳固。","source":{"text":"履霜坚冰，阴始凝也。","book":"《易·坤》"}},{"id":45795,"word":"阴刻乐祸","pinyin":"yīn kè lè huò","abbr":"yklh","explanation":"为人阴险刻薄，看到他人有不如意的事就暗中高兴。","source":{"text":"器性阴刻乐祸，残忍寡恩，希旨奏陷贼官准律并合处死。","book":"《旧唐书·崔器传》"}},{"id":45796,"word":"阴山背后","pinyin":"yīn shān bèi hòu","abbr":"ysbh","explanation":"①迷信者称阴间得不到超升的鬼魂所在的地方。②比喻偏僻受冷落的地方。","source":{"text":"我若把真阳丧了，我就身堕轮回，打在那阴山背后，永世不得翻身了。","book":"明·吴承恩《西游记》第八十二回"},"example":{"text":"苦恼俺每这～，就死在这屋里，也没几个人儿来瞅问。","book":"明·兰陵笑笑生《金瓶梅词话》第七十六回"}},{"id":45797,"word":"阴差阳错","pinyin":"yīn chā yáng cuò","abbr":"ycyc","explanation":"比喻由于偶然的因素而造成了差错。","source":{"text":"阴错阳差，有十二月，盖六十甲子分为四段，自甲子、己卯、甲午、己酉，各得十五辰。……甲子、甲午为阳辰，故有阴错；己卯、己酉为阴辰，故有阳差也。","book":"明·王逵《蠡海集·历数》"},"example":{"text":"他们～地把多年渴望见面的机会失掉了。"},"similar":["一差二错","阴错阳差","鬼使神差"],"opposite":["千真万确"],"usage":"作定语、状语、宾语；指偶然因素"},{"id":45798,"word":"阴惨阳舒","pinyin":"yīn cǎn yáng shū","abbr":"ycys","explanation":"古以秋冬为阴，春夏为阳，秋冬忧戚，春夏舒快。指四时的变化","source":{"text":"夫人在阳时则舒，在阴时则惨。","book":"东汉·张衡《西京赋》"},"similar":["阴阳惨舒"],"usage":"作宾语、定语；用于书面语"},{"id":45799,"word":"阴曹地府","pinyin":"yīn cáo dì fǔ","abbr":"ycdf","explanation":"迷信说法，人死后所在的地方。","source":{"text":"我到咱家，不能发送爷爷入土，不能伺候奶奶，倒叫我奶奶伺候我，且了自己爹娘。这个不孝，就是阴曹地府下，也自心不安。","book":"清·李绿园《歧路灯》"},"example":{"text":"清·刘鹗《老残游记续集遗稿》第八回：“我不懂～为什么要用这么重的刑法，以陛下之权力，难道就不能改轻了吗？”"},"similar":["九泉之下"],"opposite":["大千世界"],"usage":"作定语、宾语；指鬼的家园"},{"id":45800,"word":"阴服微行","pinyin":"yīn fú wēi xíng","abbr":"yfwx","explanation":"微行：帝王、官吏隐藏自己身份改装出行。旧指帝王或官吏穿便装，隐瞒自己的身份进行民访。"},{"id":45801,"word":"阴柔害物","pinyin":"yīn róu hài wù","abbr":"yrhw","explanation":"阴：暗地里；柔：温柔；害物：残害万物。外表上一团和气，内心里阴险狠毒。","source":{"text":"义府貌状温恭，与人语必嬉怡微笑，而褊忌阴贼。既处权要，欲人附己，微忤意者，辄加倾陷。故时人言义府笑中有刀，又以其柔而害物，亦谓之‘李猫’。","book":"《旧唐书·李义府传》"},"example":{"text":"李义府～，人谓之笑里藏刀；李林甫奸诡谄人，世谓之口蜜腹剑。","book":"清·程允升《幼学琼林·人事》"}},{"id":45802,"word":"阴灵不散","pinyin":"yīn líng bù sàn","abbr":"ylbs","explanation":"旧时迷信指人死后灵魂不会散去。现多比喻坏人、坏事虽已清除，但不良的影响还在起作用。","source":{"text":"想是他的阴灵不散，你们到前厅烧张纸儿。","book":"清·李绿园《歧路灯》第五十九回"},"similar":["阴魂不散"],"usage":"作谓语、定语；用于坏人或坏事等"},{"id":45803,"word":"阴疑阳战","pinyin":"yīn yí yáng zhàn","abbr":"yyyz","explanation":"比喻侵略者气焰嚣张，逼使被侵略者奋起自卫。","source":{"text":"阴疑于阳必战。","book":"《周易·坤》"},"example":{"text":"城上旌旗城下盟，怒潮已作落潮声。～玄黄血，电挟雷攻水火并。","book":"清·魏源《寰海》诗"},"usage":"作谓语、宾语；指双方较量"},{"id":45804,"word":"阴谋不轨","pinyin":"yīn móu bù guǐ","abbr":"ymbg","explanation":"轨：法度；不轨：不遵守法度。指暗中谋划叛乱。","source":{"text":"而阴谋不轨，以身试祸，岂不痛哉。","book":"汉·陈球《答袁术书》"},"usage":"作谓语、宾语；指叛乱"},{"id":45805,"word":"阴谋秘计","pinyin":"yīn móu mì jì","abbr":"ymmj","explanation":"指暗地里策划坏的害人的坏主意。","source":{"text":"子房阴谋秘计必多，而独著其蹑足偶语，当由妙处不传耳。","book":"明·朱之瑜《留侯像赞》"},"example":{"text":"若我一摇足，则中原非彼所有，所以～，不得不遣使也。","book":"清·毕沅《续资治通鉴》卷一百二十"}},{"id":45806,"word":"阴谋诡计","pinyin":"yīn móu guǐ jì","abbr":"ymgj","explanation":"诡：欺诈，奸滑。指暗地里策划坏的害人的坏主意。","source":{"text":"深陷附蔡京，结为死党，京奸谋诡计得助者多深为首。","book":"《史记·陈丞相世家》：“我多阴谋，是道家之所禁。”《宋史·余深传》"},"example":{"text":"党处于敌人和同盟者的～的包围中，但是没有警觉性。","book":"毛泽东《〈共产党人〉发刊词》"},"similar":["诡计多端"],"opposite":["光明正大"],"usage":"作主语、宾语、定语；指坏主意"},{"id":45807,"word":"阴错阳乱","pinyin":"yīn cuò yáng luàn","abbr":"ycyl","explanation":"使阴与阳相互错乱。比喻颠倒黑白，人伦混乱，道德失常。","source":{"text":"明王有含天下之量，有济天下之心，能进天下之善，除天下之恶。若为君王而不行此四者，则当神冤鬼怒，阴错阳乱，欲使国家荣泰，其可得乎！","book":"良·苏安恒《为魏元忠疏》"}},{"id":45808,"word":"阴错阳差","pinyin":"yīn cuò yáng chā","abbr":"ycyc","explanation":"比喻由于偶然的因素而造成了差错。","source":{"text":"阴错阳差，有十二月，盖六十甲子分为四段，自甲子、己卯、甲午、己酉，各得十五辰。……甲子、甲午为阳辰，故有阴错；己卯、己酉为阴辰，故有阳差也。","book":"明·王逵《蠡海集·历数》"},"example":{"text":"他们～地把多年渴望见面的机会失掉了。"},"similar":["一差二错"],"opposite":["千真万确"],"usage":"作定语、状语、宾语；指偶然"},{"id":45809,"word":"阴阳两面","pinyin":"yīn yáng liǎng miàn","abbr":"yylm","explanation":"当面一套背后另一套，耍两面手法。","example":{"text":"请不要跟我玩～。"},"usage":"作宾语、定语；指两面派"},{"id":45810,"word":"阴阳之变","pinyin":"yīn yáng zhī biàn","abbr":"yyzb","explanation":"早晚和季节的变化。","source":{"text":"审堂下之阴，而知……阴阳之变。","book":"战国·卫·吕不韦《吕氏春秋·察今》"},"usage":"作宾语；指早晚和季节的变化"},{"id":45811,"word":"阴阳交错","pinyin":"yīn yáng jiāo cuò","abbr":"yyjc","explanation":"指把阴和阳搞差了。后比喻由于偶然的因素而造成了差错。","source":{"text":"闻太师这一回阴阳交错，一时失计。","book":"明·许仲琳《封神演义》第三十五回"},"similar":["阴差阳错","阴错阳差"],"usage":"作定语、状语、谓语；指偶然"},{"id":45812,"word":"阴阳怪气","pinyin":"yīn yáng guài qì","abbr":"yygq","explanation":"形容态度怪癖，冷言冷语，不可捉摸。","source":{"text":"为啥故歇几个人才有点阴阳怪气。","book":"清·韩邦庆《海上花列传》第五十六回"},"example":{"text":"他们哪一个上想顺我的心？哪一个不是～。","book":"曹禺《北京人》第二幕"},"similar":["怪声怪气"],"opposite":["字正腔圆"],"usage":"作谓语、状语、定语；指人的态度"},{"id":45813,"word":"阴阳惨舒","pinyin":"yīn yáng cǎn shū","abbr":"yycs","explanation":"古以秋冬为阴，春夏为阳。意为秋冬忧戚，春夏舒快。指四时的变化。","source":{"text":"春秋代序，阴阳惨舒，物色之动，心亦摇焉。","book":"语出汉·张衡《西京赋》：“夫人在阳时则舒，在阴时则惨。”南朝·梁·刘勰《文心雕龙·物色》"},"example":{"text":"视～之节，取震虩泽濡之象。知天而不泥于神怪，知人而不遗于委琐。","book":"唐·刘禹锡《答饶州元使君书》"},"similar":["阴惨阳舒"],"usage":"作宾语、定语；用于书面语"},{"id":45814,"word":"阴阳易位","pinyin":"yīn yáng yì wèi","abbr":"yyyw","explanation":"比喻君臣互换其位或地位截然不同的人物互换其位。","source":{"text":"阴阳易位，时不当兮。","book":"战国·楚·屈原《九章·涉江》"},"usage":"作宾语、定语；用于书面语"},{"id":45815,"word":"阴险歹毒","pinyin":"yīn xiǎn dǎi dú","abbr":"yxdd","explanation":"指人心黑手辣。","example":{"text":"他比豺狼还～。"},"similar":["阴险毒辣"],"usage":"作谓语、定语；指人很坏"},{"id":45816,"word":"阴雨晦冥","pinyin":"yīn yǔ huì míng","abbr":"yyhm","explanation":"晦冥：昏暗。阴雨连绵，天昏地暗。比喻灾祸连绵。","source":{"text":"上下三千余年，兴亡百千万事，大概光风霁月之时少，阴雨晦冥之时多。","book":"宋·无名氏《宣和遗事·前集》"},"usage":"作谓语、定语；用于比喻句"},{"id":45817,"word":"阴霾密布","pinyin":"yīn mái mì bù","abbr":"ymmb","explanation":"浓厚的云层或空气中的大量的烟尘遮蔽天日。比喻形势险恶。","source":{"text":"将近一鼓时分，听半空风响，阴云密布，黑雾迷空，把一轮明月遮掩。","book":"明·许仲琳《封神演义》第二十六回"},"similar":["阴云密布"],"usage":"作谓语、定语；用于天气等"},{"id":45818,"word":"阴魂不散","pinyin":"yīn hún bù sàn","abbr":"yhbs","explanation":"比喻坏人、坏事虽已清除，但不良的影响还在起作用。","source":{"text":"想是他的阴灵不散，你们到前厅烧张纸儿。","book":"清·李绿园《歧路灯》第五十九回"},"example":{"text":"八股文至今还～。"},"similar":["阴灵不散"],"opposite":["灰飞烟灭"],"usage":"作谓语、定语；指坏人"},{"id":45819,"word":"阵马风樯","pinyin":"zhèn mǎ fēng qiáng","abbr":"zmfq","explanation":"樯：船上用的桅杆。风中的樯帆，阵上的战马。比喻气势雄壮，行动迅速。","source":{"text":"风樯阵马，不足为其勇也。","book":"唐·杜牧《李贺诗序》"},"example":{"text":"～见豪举，雪车冰柱得真传。","book":"元·金好问《送刘子东游》诗"},"similar":["风樯阵马"],"usage":"作宾语、定语；指行动迅速"},{"id":45820,"word":"阶下囚","pinyin":"jiē xià qiú","abbr":"jxq","explanation":"指在公堂台阶下受审的犯人；泛指在押的囚犯或俘虏。","source":{"text":"布告玄德曰：‘公为坐上客，布为阶下囚，何不发一言而相宽乎？’","book":"明·罗贯中《三国演义》第19回"},"example":{"text":"他已经沦为我们的～。"},"opposite":["座上客"],"usage":"作主语、宾语；指囚犯或俘虏"},{"id":45821,"word":"阶前万里","pinyin":"jiē qián wàn lǐ","abbr":"jqwl","explanation":"远在万里之外，犹如近在眼前。比喻相隔虽远，却象在眼前一样。","source":{"text":"卿到彼为政甚善，朕皆知之，勿谓其远！此阶前万里也。","book":"《资治通鉴·唐纪·宣宗大中十二年》"},"usage":"作宾语；比喻虽远犹近"},{"id":45822,"word":"阶柳庭花","pinyin":"jiē liǔ tíng huā","abbr":"jlth","explanation":"阶：台阶；庭：庭院。台阶前的垂柳，庭院中的鲜花。指美好的庭院景致。","source":{"text":"阶：台阶；庭：庭院。台阶前的垂柳，庭院中的鲜花。指美好的庭院景致。"},"usage":"作宾语、定语；指景色"},{"id":45823,"word":"阻兵安忍","pinyin":"zú bīng ān rěn","abbr":"zbar","explanation":"阻：倚仗；阻兵：仗恃手握兵权；安忍：安于做残忍的事情。形容行凶作恶而有恃无恐","source":{"text":"夫州吁阻兵而安忍：阻兵无众，安忍无亲；众叛亲离，难以济矣。","book":"春秋·鲁·左丘明《左传·隐公四年》"},"usage":"作谓语、定语；用于书面语"},{"id":45824,"word":"阻山带河","pinyin":"zǔ shān dài hé","abbr":"zsdh","explanation":"靠山环河。指形势险要。","source":{"text":"秦民失望。于是韩生说羽曰：‘关中阻山带河，四塞之地，肥饶，可都以伯。’","book":"《汉书·项籍传》"},"usage":"作谓语、定语；用于书面语"},{"id":45825,"word":"阽危之域","pinyin":"diàn wēi zhī yù","abbr":"dwzy","explanation":"阽危：危险；域：境地。危险的境地。","source":{"text":"故能出人于阽危之域，跻俗于仁寿之地。","book":"南朝·齐·王融《永明十一年策秀才文》"},"usage":"作宾语；指危险的境地"},{"id":45826,"word":"阿世取容","pinyin":"ē shì qǔ róng","abbr":"esqr","explanation":"指迎合世俗，取悦于人。","source":{"text":"至叔孙通，则正以曲学容，非重其能定朝仪，知典礼也。","book":"鲁迅《汉文学史纲要》第六篇"},"example":{"text":"叙述西汉儒学，应该看到多数～的章名小儒，也应该看到少数同情人民的正统儒者。 ◎范文澜蔡美彪等《中国通史》第二编第二章第九节"},"similar":["阿意取容"],"usage":"联合式；作谓语、定语；指迎合世俗去取悦别人"},{"id":45827,"word":"阿世取荣","pinyin":"ē shì qú róng","abbr":"asqr","explanation":"指迎合世俗，取悦于人。","source":{"text":"至叔孙通，则正以曲学容，非重其能定朝仪，知典礼也。","book":"鲁迅《汉文学史纲要》第六篇"},"example":{"text":"叙述西汉儒学，应该看到多数～的章名小儒，也应该看到少数同情人民的正统儒者。","book":"范文澜蔡美彪等《中国通史》第二编第二章第九节"}},{"id":45828,"word":"阿世媚俗","pinyin":"ē shì mèi sú","abbr":"esms","explanation":"指曲意迎合当时社会的陈规陋俗。","source":{"text":"如其《民敌》一书，谓有人宝守真理，不阿世媚俗，而不见容于人群。","book":"鲁迅《坟·文化偏至论》"},"opposite":["格格不入"],"usage":"联合式；作谓语、定语；指违心迎合旧的习俗"},{"id":45829,"word":"阿世盗名","pinyin":"ē shì dào míng","abbr":"esdm","explanation":"阿世：曲意博取世人的欢心。用博取世人的欢心的方法来窃取名誉。","source":{"text":"清·梁启超《新民说》：“才智之士，既得此以为阿世盗名之一秘钥，于是名节闲检，荡然无所顾复。"},"similar":["欺世盗名"],"usage":"联合式；作谓语、定语、宾语；含贬义"},{"id":45830,"word":"阿保之功","pinyin":"ē bǎo zhī gōng","abbr":"abzg","explanation":"阿保：保护，养育。扶持、养育的功劳。","source":{"text":"是时掖庭宫婢则令民夫上书，自陈尝有阿保之功。","book":"东汉·班固《汉书·丙吉传》"},"example":{"text":"每个父母都有～。"},"similar":["阿保之劳"],"usage":"作主语、宾语；指父母的成绩"},{"id":45831,"word":"阿保之劳","pinyin":"ē bǎo zhī láo","abbr":"abzl","explanation":"指扶持、养育的功劳。同“阿保之功”。","source":{"text":"帝以保母周氏有阿保之劳，欲假其名号，内外皆奉诏。","book":"房玄龄《晋书·列传第五十三》"},"example":{"text":"先是，帝以保母周氏有～，欲假其名号，内外皆奉诏。","book":"《晋书·顾和传》"},"similar":["阿保之功"],"usage":"作主语、宾语；指父母的成绩"},{"id":45832,"word":"阿党比周","pinyin":"ē dǎng bǐ zhōu","abbr":"edbz","explanation":"指相互勾结，相互偏袒，结党营私。","source":{"text":"阿党比周，先圣所疾也。","book":"三国·魏·曹操《整齐风俗令》"},"example":{"text":"《论语·卫灵公》“众恶之，必察焉；众好之，必察焉”何晏集解引三国魏王肃曰：“或众～，或其人特立不群，故好恶不可不察也。”"}},{"id":45833,"word":"阿党相为","pinyin":"ē dǎng xiāng wéi","abbr":"edxw","explanation":"〖释义〗阿党：偏袒、偏私一方。为了谋求私利相互偏袒、包庇。","source":{"text":"今以四海之大，曾无伏节死谊之臣，率尽苟合取容，阿党相为，念私门之利，忘国家之政。","book":"《汉书·诸葛丰传》"},"similar":["官官相卫","阿党比周"],"opposite":["两袖清风"],"usage":"联合式；作谓语；含贬义"},{"id":45834,"word":"阿其所好","pinyin":"ē qí suǒ hào","abbr":"eqsh","explanation":"阿：曲从；其：他的；好：爱好。指为取得某人的好感而迎合他的爱好。","source":{"text":"宰我、子贡、有若，智足以知圣人，污不至阿其所好。","book":"《孟子·公孙丑上》"},"example":{"text":"吾何能～为？ ◎鲁迅《坟·摩罗诗力说》"},"similar":["投其所好"],"opposite":["不卑不亢"],"usage":"动宾式；作谓语；含贬义，形容阿谀讨好"},{"id":45835,"word":"阿匼取容","pinyin":"ē kē qǔ róng","abbr":"akqr","explanation":"谄媚他人，以取得其喜悦。同“阿谀取容”。","source":{"text":"居宰相十余年，阿匼取容，无所荐达。","book":"《新唐书·杨再思传》"},"similar":["阿谀取容"],"opposite":["刚正不阿"],"usage":"作谓语、定语；用于人"},{"id":45836,"word":"阿堵物","pinyin":"ē dǔ wù","abbr":"adw","explanation":"西晋的一些士族阶层人士自命清高，耻于言钱，钱被称为“阿堵物”。后人指为钱的别称，有讽刺意义。","source":{"text":"《世说新语》中记载：西晋的王衍是所谓的“品行高尚”的清谈人士，据说他口里从不提到“钱”字。他老婆想试探王衍的虚实，趁王衍熟睡之时，叫仆人绕着王衍的床边铺上一大圈钱。王衍早晨醒来见到床边的钱妨碍他行动。便叫来仆人说“举却阿堵物”。举却：拿开。"},"example":{"text":"爱酒苦无～，寻春乃有主人家。","book":"张耒《和春咎》诗之二"},"similar":["孔方兄"],"usage":"作宾语、定语；用于古汉语","story":["晋朝时期，王衍一生从不谈论钱或说“钱”字，他的妻子故意将钱放在房中，挡住他走路，想逼他说出一个“钱”字。谁知王衍看见了钱，因钱堵住走路，就教他妻子把阿堵物拿开，就是不说出一个“钱”字"]},{"id":45837,"word":"阿姑阿翁","pinyin":"ā gū ā wēng","abbr":"agaw","explanation":"阿：名词的前缀。姑：丈夫的母亲。翁：丈夫的父亲。指公公婆婆。","source":{"text":"既能如此，你我两个，便学个不痴不聋的阿姑阿翁。","book":"清·文康《儿女英雄传》"},"example":{"text":"现代女性最不愿与～生活在一起。"},"similar":["阿家阿翁"],"usage":"作主语、宾语；指公公婆婆"},{"id":45838,"word":"阿娇金屋","pinyin":"ā jiāo jīn wū","abbr":"ajjw","explanation":"阿娇：指汉武帝刘彻的姑母（长公主刘娇）的女儿。原指汉武帝刘彻要用金屋接纳阿娇为妇。这里泛指美丽高贵的女子。","source":{"text":"若得阿娇(姑母之女)作妇，当以金屋贮之。","book":"语出旧题汉·班固《汉武故事》：汉武帝幼时曾对姑母长公主说"},"example":{"text":"～原相配，太其玉镜宁无时？","book":"明·周履靖《锦笺记·诒婚》"},"similar":["金屋藏娇"],"usage":"作宾语、定语；多用于女性"},{"id":45839,"word":"阿家阿翁","pinyin":"ā jiā ā wēng","abbr":"agaw","explanation":"阿：名词的前缀。家：通“姑”，丈夫的母亲。翁：丈夫的父亲。指公公婆婆。","source":{"text":"谚云：不痴不聋，不作阿家阿翁。","book":"唐·赵璘《因话录》第一卷"},"example":{"text":"俗话说：“不痴不聋，不作～”，作为父母就是难得糊涂。"},"similar":["阿公阿婆"],"usage":"作主语、宾语；指公公婆婆"},{"id":45840,"word":"阿尊事贵","pinyin":"ē zūn shì guì","abbr":"azsg","explanation":"尊、贵：指地位官爵高的权贵。迎合和侍奉权贵。","source":{"text":"以不能阿尊事贵，孤特寡助，抑厌遂退，卒不克明。","book":"《汉书·楚元王传》"},"usage":"作谓语、定语、宾语；用于处世"},{"id":45841,"word":"阿平绝倒","pinyin":"ā píng jué dǎo","abbr":"apjd","explanation":"以之比喻对对方的言论极为佩服。亦用为讥讽言论极为乖谬，常贻笑大方。"},{"id":45842,"word":"阿弥陀佛","pinyin":"ā píng jué dǎo","abbr":"emtf","explanation":"佛教语，信佛的人用作口头诵颂的佛号，表示祈祷祝福或感谢神灵的意思。","source":{"text":"张寿友曰：‘阿弥陀佛，这个是谁？’卜儿云：‘这便是媳妇儿。’","book":"元·张国宾《合汗衫》第四折"},"example":{"text":"和尚念经，～。"}},{"id":45843,"word":"阿意取容","pinyin":"ē yì qǔ róng","abbr":"eyqr","explanation":"指曲从其意，以取悦于人。","source":{"text":"季直不能阿意取容，明帝颇忌之，出为辅国长史、北海太守。","book":"《南史·孝义传下·陶季直》"},"example":{"text":"当英景之间，国势初更，人心观望，执政任事之臣多～。 ◎《明史·高穀胡濙等赞》"},"similar":["阿世取容"],"opposite":["刚正不阿"],"usage":"联合式；作谓语、定语；指曲意去取悦别人"},{"id":45844,"word":"阿意苟合","pinyin":"ē yì gǒu hé","abbr":"aygh","explanation":"阿：迎合；苟合：无原则地附和。曲从迎合别人的意思，无原则地附和，以向人讨好。","source":{"text":"阿意苟合，以说其上。","book":"《汉书·公孙刘车王杨蔡陈郑传赞》"},"similar":["阿谀苟合"],"usage":"作谓语、定语、状语；用于处世"},{"id":45845,"word":"阿意顺旨","pinyin":"ē yì shùn zhì","abbr":"aysz","explanation":"阿意：迎合他人心意；顺旨：顺从君主意图。曲意逢迎，顺从君主的意图。","source":{"text":"汉人于交友故旧，动存规戒，其不肯阿意顺旨，以限于非义，此风凛然可喜。","book":"宋·王楙《野客丛书·汉人规戒》"},"similar":["阿谀顺旨"],"usage":"作谓语、定语、状语；用于处世"},{"id":45846,"word":"阿斗太子","pinyin":"ā dǒu tài zǐ","abbr":"adtz","explanation":"阿斗：三国蜀汉刘备之子刘禅的小名。此人庸碌无能，虽有诸葛亮等人全力扶助，也不能振兴蜀汉。后指懦弱无能的人。","source":{"text":"丈夫是个阿斗太子，哪怕你是诸葛亮，也只好叹口气。","book":"高阳《胡雪岩全传·灯火楼台》"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":45847,"word":"阿旨顺情","pinyin":"ē zhǐ shùn qíng","abbr":"azsq","explanation":"逢迎谄媚，顺从别人意旨。同“阿谀顺旨”。","source":{"text":"贞观三年，太宗谓侍臣曰：‘中书、门下，机要之司，擢才而居，委任实重。诏敕如有不稳便，皆须执论。比来惟觉阿旨顺情，唯唯苟过，遂无一言谏诤者，岂是道理？若惟署诏敕、行文书而已，人谁不堪？……’","book":"吴兢《贞观政要》"},"similar":["阿意顺旨","阿谀顺旨"],"usage":"作谓语、定语、状语；用于处世"},{"id":45848,"word":"阿时趋俗","pinyin":"ē shí qū sú","abbr":"esqs","explanation":"阿：迎合。迎合时尚和世俗。","source":{"text":"故办杂志者，当研究社会心理。然此决非阿时趋俗，只以顺其势而利导之耳。","book":"恽代英《再复毕几庵书》"},"similar":["爱素好古"],"opposite":["我行我素"],"usage":"联合式；作谓语、定语；指迎合世俗和时尚"},{"id":45849,"word":"阿毗地狱","pinyin":"ā pí dì yù","abbr":"apdy","explanation":"阿毗：梵语的译音，意译为“无间”，即痛苦无有间断之意。常用来比喻黑暗的社会和严酷的牢狱。又比喻无法摆脱的极其痛苦的境地。","source":{"text":"见“阿鼻地狱”。"},"example":{"text":"生前不曾修福，死堕～。","book":"《敦煌变文集·妙法莲花经讲经文》"}},{"id":45850,"word":"阿狗阿猫","pinyin":"ā gǒu ā māo","abbr":"agam","explanation":"旧时人们常用的小名。引申为任何轻贱的，不值得重视的人或著作。","source":{"text":"然而新的批评家不开口，类似批评家之流便趁势一笔抹杀：‘阿狗阿猫’。","book":"鲁迅《我们要批评家》"},"example":{"text":"我管你什么～，办事就得讲原则。"},"similar":["阿猫阿狗"],"opposite":["达官贵人"],"usage":"作主语、宾语；用于轻视的口吻"},{"id":45851,"word":"阿猫阿狗","pinyin":"ā māo ā gǒu","abbr":"amag","explanation":"旧时人们常用的小名。引申为任何轻贱的，不值得重视的人或著作。","source":{"text":"这和名孩子为阿猫阿狗，完全是一样的意思：容易养大。","book":"鲁迅《我的第一个师父》"},"example":{"text":"在德国无论～见面，一律互相举手高喊：“希特勒万岁”。","book":"邹韬奋《法西斯作风的罪恶》"},"similar":["阿狗阿猫"],"opposite":["头面人物"],"usage":"作主语、宾语；指小人物"},{"id":45852,"word":"阿谀取容","pinyin":"ē yú qǔ róng","abbr":"eyqr","explanation":"阿谀：曲意逢迎；取容：取悦于人。谄媚他人，以取得其喜悦。","source":{"text":"而今猥受过宠，执政操权，其阿谀取容者，则因公褎举，以报私惠。","book":"汉·杨秉《奏劾侯览》"},"example":{"text":"且王驩等～，蔽贤窃位。 ◎明·冯梦龙《东周列国志》"},"similar":["阿谀奉承","阿谀逢迎","阿意取容"],"opposite":["刚正不阿"],"usage":"连动式；作谓语、定语；指采取各种手段去讨好别人"},{"id":45853,"word":"阿谀奉承","pinyin":"ē yú fèng chéng","abbr":"eyfc","explanation":"阿谀：用言语恭维别人；奉承：恭维，讨好。曲从拍马，迎合别人，竭力向人讨好。","source":{"text":"他却小器易盈，况且是个小人，在人前不过一味阿谀奉承。","book":"明·东鲁古狂生《醉醒石》第八回"},"similar":["阿谀逢迎","阿其所好"],"opposite":["刚正不阿"],"usage":"联合式；作谓语、定语、补语；用于讨好拍马"},{"id":45854,"word":"阿谀曲从","pinyin":"ē yú qū cóng","abbr":"eyqc","explanation":"阿谀：曲意逢迎。曲意逢迎讨好别人。","source":{"text":"阿谀曲从，阿上罔下，无大臣辅政之义。","book":"东汉·班固《汉书·匡衡传》"},"similar":["阿谀奉承"],"usage":"作谓语、定语、状语；用于处世"},{"id":45855,"word":"阿谀求容","pinyin":"ē yú qiú róng","abbr":"eyqr","explanation":"容：容色，好的脸色。曲意奉承，取悦于人。","source":{"text":"不度理之所在，而阿谀求容，谄莫甚焉。","book":"《孔丛子·抗志》"},"similar":["阿谀取容","阿匼取容"],"usage":"作谓语、定语；指采取各种手段去讨好别人"},{"id":45856,"word":"阿谀苟合","pinyin":"ē yú gǒu hé","abbr":"eygh","explanation":"阿谀：迎合别人的意思；苟合：无原则地附和。迎合别人的心思，无原则地附和。","source":{"text":"怪遇阿谀苟合之徒，……不可胜数也。","book":"《史记·封禅书》"},"similar":["阿意苟合"],"usage":"作谓语、定语、状语；用于处世"},{"id":45857,"word":"阿谀谄佞","pinyin":"ē yú chǎn nìng","abbr":"aycn","explanation":"阿谀：说别人爱听的话迎合奉承；谄佞：花言巧语谄媚。指用花言巧语谄媚别人。","source":{"text":"这人虽读经书，却是阿谀谄佞之徒，心地匾窄，只要嫉贤妒能，胜如己者害之，不如己者弄之，专在乡里害人。","book":"明·施耐庵《水浒传》第39回"},"usage":"作定语、宾语；用于处世"},{"id":45858,"word":"阿谀谄媚","pinyin":"ē yú chǎn mèi","abbr":"eycm","explanation":"阿谀：迎合别人的意思，向人讨好；谄媚：巴结，奉承。说话做事迎合别人的心意，竭力向人讨好。","source":{"text":"只是这帮阿谀谄媚的，要博相国欢喜，自然重价购买。","book":"明·冯梦龙《喻世明言·裴晋公义还原配》"},"similar":["阿谀奉承"],"usage":"联合式；作谓语、定语、宾语；含贬义"},{"id":45859,"word":"阿谀逢迎","pinyin":"ē yú féng yíng","abbr":"eyfy","explanation":"阿谀：用言语恭维别人；逢迎：迎合别人的心意。奉承，拍马，讨好别人。","source":{"text":"周之与否在君而已，不可阿谀奉迎求其比己也。","book":"《二程全书·伊川易传一》"},"example":{"text":"其时京师有一流棍，名叫李光，专一～，谄事令孜。 ◎明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["阿谀奉承","阿其所好"],"opposite":["刚正不阿","守正不阿"],"usage":"联合式；作谓语、定语、补语；用于讨好拍马"},{"id":45860,"word":"阿谀顺旨","pinyin":"ē yú shùn zhǐ","abbr":"eysz","explanation":"阿谀：用言语恭维别人。逢迎谄媚，顺从别人意旨。","source":{"text":"衍能揣上意，阿谀顺旨。","book":"《后汉书·逸民传·严光传》：“怀仁辅义天下悦，阿谀顺旨要领绝。”《隋书·郭衍传》"},"example":{"text":"非欲其～，惟言莫违也。","book":"《明史·徐溥传》"},"similar":["阿谀顺旨","阿旨顺情"],"usage":"作谓语、定语、状语；用于处世"},{"id":45861,"word":"阿顺取容","pinyin":"ē shùn qǔ róng","abbr":"asqr","explanation":"阿：曲从，迎合。曲意顺从以博取他人的欢悦。","source":{"text":"以辅朕之不逮，慎毋阿顺取容。","book":"《金史·本纪第六世宗》"},"similar":["阿谀奉承"],"usage":"作谓语、定语、补语；用于讨好拍马"},{"id":45862,"word":"阿鼻叫唤","pinyin":"ā bí jiào huàn","abbr":"abjh","explanation":"梵语指陷入阿鼻地狱后的呼叫声。比喻非常悲惨、呼唤求救的声音。","source":{"text":"或者，那个大屯山突喷出火来，瞬间把台北市化为一场阿鼻叫唤的地狱。","book":"龙瑛宗《台北的表情》"},"example":{"text":"断粮后，城内居民至以人肉相食，鸟取城顿成修罗场，一个～的世界。"}},{"id":45863,"word":"阿鼻地狱","pinyin":"ā bí dì yù","abbr":"abdy","explanation":"阿鼻：梵语的译音，意译为“无间”，即痛苦无有间断之意。常用来比喻黑暗的社会和严酷的牢狱。又比喻无法摆脱的极其痛苦的境地。","source":{"text":"下至阿鼻地狱。","book":"语出《法华经·法师功德品》"},"example":{"text":"但也有少数意志薄弱的……逐步上当，终至堕入～。","book":"《上饶集中营·炼狱杂记》"},"similar":["十八层地狱"],"opposite":["极乐世界"],"usage":"作主语、宾语、定语；用于诅咒人"},{"id":45864,"word":"陂湖禀量","pinyin":"bēi hú bǐng liáng","abbr":"bhbl","explanation":"比喻度量宽广恢弘。","source":{"text":"叔度汪汪若千顷陂，澄之不清，淆之不浊，不可量也。","book":"《后汉书·黄宪传》"},"example":{"text":"惟灵金石呈姿，～，伊彼昭代，生乎德明。","book":"唐·黄滔《祭右省李常侍洵》"},"similar":["宽宏大量"],"usage":"作定语、状语；形容人的气量很大"},{"id":45865,"word":"附上罔下","pinyin":"fù shàng wǎng xià","abbr":"fswx","explanation":"附：附和；上：君王，罔：欺骗；下：臣下。亲附君王，欺骗臣下。","source":{"text":"泰誓曰：‘附下而罔上者死，附上而罔下者刑。’","book":"汉·刘向《说苑·臣术》"},"similar":["欺下罔上"],"usage":"作谓语、定语；指上下欺骗"},{"id":45866,"word":"附下罔上","pinyin":"fù xià wǎng shàng","abbr":"fxws","explanation":"附和偏袒同僚或下属，却欺骗君上。","source":{"text":"夫附下罔上者死，附上罔下者刑，与闻国政而无益于民者斥，在上位而不能进贤者退，此所以劝善黜置业恶也。","book":"《汉书·武帝纪》"},"example":{"text":"少师万安恃权怙宠，殊无厌足，少师刘吉～，漫无可否。","book":"明·何良俊《四友斋丛说·史五》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":45867,"word":"附人骥尾","pinyin":"fù rén jì wěi","abbr":"frjw","explanation":"骥：千里马。依附在千里马的尾巴上。比喻依附他人而成名。","source":{"text":"痛责那倡言合作的学生，说他们太无志气，不识潮流，要附人骥尾。","book":"范文澜《中国近代史》第七章"},"similar":["附骥名彰"],"usage":"作谓语、宾语、定语；用于处事"},{"id":45868,"word":"附会穿凿","pinyin":"fù huì chuān záo","abbr":"fhcz","explanation":"将无关之事硬扯在一起牵强地解释。","source":{"text":"此岂可以私意附会穿凿而为之哉。","book":"宋·陈善《扪虱新话·欧阳公信经废传》"},"example":{"text":"董仲舒取《春秋》所记天变灾异广泛地予以～，使《公羊》学彻底的阴阳五行化。","book":"范文澜、蔡美彪等《中国通史》第二编第二章第九节"},"similar":["牵强附会"],"usage":"作谓语、定语、状语；指乱混为一谈"},{"id":45869,"word":"附凤攀龙","pinyin":"fù fèng pān lóng","abbr":"ffpl","explanation":"附：依附；攀：攀援。指巴结投靠有权势的人以获取富贵。","source":{"text":"攀龙鳞，附凤翼。","book":"汉·扬雄《法言·渊骞》"},"example":{"text":"可怜你，附膻逐臭，也自比，～。","book":"清·洪楝国《警黄钟·宫叹》"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指巴结权贵","story":["秦末汉初，出身平民的樊哙、郦商、夏侯婴、灌婴四人因为投靠刘邦而成为显赫人物。樊哙原是杀狗的屠夫，因娶了吕后的妹妹而“附凤”被封舞阳侯。郦商被赐信成君，夏侯婴因救了刘邦的妻儿被封汝阴侯，灌婴被封宣陵君"]},{"id":45870,"word":"附势趋炎","pinyin":"fù shì qū yán","abbr":"fsqy","explanation":"指奉承、依附有权势的人。","source":{"text":"朝庭一时无公道，我难道附势趋炎，把是非颠倒。","book":"明·无名氏《赠书记·奚妈辨本》"},"example":{"text":"～吾不惯，卑躬屈膝太无颜。","book":"粤剧《搜书院》第三幕"},"similar":["趋炎附势"],"opposite":["刚正不阿"],"usage":"作谓语、宾语、定语；指人势利"},{"id":45871,"word":"附声吠影","pinyin":"fù shēng fèi yǐng","abbr":"fsfy","explanation":"比喻盲目附和。","source":{"text":"而附声吠影者流，从而嘘其焰，自惜不能置身在洋务中，而得躬逢其盛也。","book":"清·王韬《洋务上》"},"similar":["吠影吠声"],"usage":"作谓语、定语；用于处事"},{"id":45872,"word":"附庸风雅","pinyin":"fù yōng fēng yǎ","abbr":"fyfy","explanation":"附庸：依傍，追随；风雅：泛指诗歌。指缺乏文化修养的人为了装点门面而结交文人，参加有关文化活动。","source":{"text":"喜欢便宜，暗中上当，附庸风雅，忙里偷闲。","book":"清·李宝嘉《官场现形记》第四十二回"},"example":{"text":"却偏要～，在扬州盖造了不少的花园，因此种花之风，遍及扬州。","book":"清·吴趼人《情变》第八回"},"usage":"作谓语、定语、宾语；指装斯文"},{"id":45873,"word":"附影附声","pinyin":"fù yǐng fù shēng","abbr":"fyfs","explanation":"指盲目附和。","source":{"text":"何意三春出作之时……始觉说痴说梦，无非附影附声。","book":"清·钮琇《觚剩·惠士陈言》"},"similar":["附声吠影"],"usage":"作谓语、定语；用于处事"},{"id":45874,"word":"附炎趋热","pinyin":"fù yán qū rè","abbr":"fyqr","explanation":"比喻趋附时贵权势。","source":{"text":"下官楚大夫登徒履便是，附炎趋热，色厉内茬。","book":"明·王錂《春芜忘·宴赏》"},"similar":["趋炎附势","趋炎附热"],"usage":"作谓语、宾语、定语；指人势利"},{"id":45875,"word":"附翼攀鳞","pinyin":"fù yì pān lín","abbr":"fypl","explanation":"指巴结投靠有权势的人以获取富贵。同“攀龙附凤”。","source":{"text":"位非宠进，功籍势成，附翼攀鳞，郁为佐命之首。","book":"《北史·孙腾斛律羡等传论》"},"example":{"text":"～原不易，杨花生性悔轻狂。","book":"柳亚子《再题〈圭塘倡和集〉》诗"},"similar":["攀龙附凤"],"usage":"作谓语、宾语、定语；指巴结别人"},{"id":45876,"word":"附耳低言","pinyin":"fù ěr dī yán","abbr":"fedy","explanation":"附：贴近。贴近别人的耳朵低声说话。形容和对方密谈要事。","source":{"text":"……遂附耳低言道：‘这桩事，除非先如此如此，种下根基，等待他落入我套中，再与你商量后事。’","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"example":{"text":"出去会见那二府，使出一张牌票看了，～了几句，二府上轿去了。","book":"清·吴敬梓《儒林外史》第二十六回"},"similar":["附耳低语","窃窃私语"],"usage":"作谓语、宾语；形容和对方密谈要事"},{"id":45877,"word":"附耳低语","pinyin":"fù ěr dī yǔ","abbr":"fedy","explanation":"附：贴近。贴近别人的耳朵低声说话。形容和对方密谈要事。","source":{"text":"抱素向李克走进一步，附耳低语道……","book":"茅盾《幻灭》"},"similar":["附耳低言","附耳密谈"],"usage":"作谓语、宾语；形容和对方密谈要事"},{"id":45878,"word":"附耳密谈","pinyin":"fù ěr mì tán","abbr":"femt","explanation":"附：贴近。贴近别人的耳朵低声说话。形容和对方密谈要事。","source":{"text":"胡国光远远地看见王荣昌站在一家小杂货铺前和一个人附耳密谈。","book":"茅盾《动摇》"},"similar":["附耳低言","附耳低语"],"usage":"作谓语、宾语；形容和对方密谈要事"},{"id":45879,"word":"附耳射声","pinyin":"fù ěr shè shēng","abbr":"fess","explanation":"指传闻异辞，捕风捉影。","source":{"text":"陵谷迁移，忘注芜没，郢书燕说，附耳射声。","book":"清·钱谦益《都察院左都御史李公神道碑》"},"similar":["捕风捉影"],"usage":"作谓语、定语；指没实据"},{"id":45880,"word":"附肤落毛","pinyin":"fù fū luò máo","abbr":"fflm","explanation":"比喻赋闲无正事可干。","source":{"text":"恪大笑。射发一矢，拂脊；再一矢，磨腹。皆附肤落毛，上下如一。","book":"晋·范亨《燕书》"},"example":{"text":"丁卯之秋事，～，失诸正鹄，迟回白门。","book":"明·凌濛初《小引》"},"usage":"作谓语、补语；指无正事可干","story":["晋朝时期，贾坚字世固，善于射箭。烈祖听说他的箭术高超想亲自试验他，就牵一头牛放在百步的地方，让贾坚射它。贾坚说：年轻时可能射不中，现年老正好可中，就射一箭，刚好擦背而过，再一箭贴肚皮而过，附肤落毛。第三箭正中牛心"]},{"id":45881,"word":"附膻逐秽","pinyin":"fù shān zhú huì","abbr":"fszh","explanation":"膻：羊臊气。比喻依附和追随权贵，追逐个人利益。","source":{"text":"干进无耻之徒，附膻逐秽，麕集其门。","book":"《明史·董传策传》"},"similar":["附膻逐臭"],"usage":"作谓语、定语；用于处世"},{"id":45882,"word":"附膻逐腥","pinyin":"fù shān zhú xīng","abbr":"fszx","explanation":"膻：羊臊气。比喻依附和追随权贵，追逐个人利益。","source":{"text":"干进无耻之徒，附膻逐秽，麕集其门。","book":"《明史·董传策传》"},"example":{"text":"我们清白门第，断不至于设招权倚势之心，那无知小人，便看得咱家是～之地。","book":"清·李绿园《歧路灯》第八十八回"},"usage":"作谓语、定语、宾语；用于处世"},{"id":45883,"word":"附膻逐臭","pinyin":"fù shān zhú chòu","abbr":"fszc","explanation":"膻：羊臊气。比喻依附和追随奸佞。","source":{"text":"可怜你，附膻逐臭，也自比，附凤攀龙。","book":"清·洪楝园《警黄钟·宫叹》"},"similar":["附膻逐秽"],"usage":"作谓语、定语；用于处世"},{"id":45884,"word":"附赘县疣","pinyin":"fù zhuì xiàn yóu","abbr":"fzxy","explanation":"附生在皮肤上的小瘤。比喻多馀无用之物。","source":{"text":"附生之赘肉，悬系之小疣。","book":"《庄子·骈拇》：“附赘县疣，出乎形哉！而侈于性。”成玄英疏"},"example":{"text":"骈拇枝指，由侈于性；～，实侈于形。","book":"南朝·梁·刘勰《文心雕龙·熔裁》"}},{"id":45885,"word":"附赘悬疣","pinyin":"fù zhuì xuán yóu","abbr":"fzxy","explanation":"附赘：附生于皮肤上的肉瘤；悬疣：皮肤上突起的瘊子。比喻多余无用的东西。","source":{"text":"彼以生为附赘悬疣。","book":"《庄子·大宗师》"},"example":{"text":"写文章应力求简洁，一切～尽量删除。"},"usage":"作谓语、定语；比喻多余无用的东西"},{"id":45886,"word":"附赘悬肬","pinyin":"fù zhuì xuán shé","abbr":"fzxy","explanation":"附生在皮肤上的小瘤。比喻多馀无用之物。同“附赘县疣”。"},{"id":45887,"word":"附赘悬胾","pinyin":"fù zhuì xuán shé","abbr":"fzxs","explanation":"附生在皮肤上的小瘤。比喻多馀无用之物。同附赘县疣”。"},{"id":45888,"word":"附骥名彰","pinyin":"fù jì míng zhāng","abbr":"fjmz","explanation":"附：依附；骥：千里马；彰：显著。依附有名望者，使自己显名于世。","source":{"text":"伯夷、叔齐虽贤，得夫子而名益彰。颜渊虽笃学，附骥尾而行益显。","book":"《史记·伯夷列传》"},"usage":"作谓语、定语；指依附别人而出名"},{"id":45889,"word":"附骥尾","pinyin":"fù jì wěi","abbr":"fjw","explanation":"附着在千里马的尾巴上。比喻仰仗别人而成名。常作谦词。","source":{"text":"附骥尾则涉千里，攀鸿翮则翔四海。","book":"汉·王褒《四子讲德论》"},"example":{"text":"俟破贼立功，庶可～以成名耳。","book":"明·冯梦龙《喻世明言》第八卷"}},{"id":45890,"word":"附骥攀鳞","pinyin":"fù jì pān lín","abbr":"fjpl","explanation":"比喻追随有名望的人左右，依附其成名。","source":{"text":"青天白日心常在，附骥攀龙志未摧。","book":"宋·释惠洪《代夏均甫宴人致语》诗"},"similar":["攀龙附凤"],"usage":"作谓语、定语；指依附名人成名"},{"id":45891,"word":"附骥攀鸿","pinyin":"fù jì pān hóng","abbr":"fjph","explanation":"攀：攀附；鸿：天鹅。比喻依附他人以成名。","source":{"text":"夫蚊虻终日经营，不能越阶序，附骥尾则涉千里；攀鸿翮则翔四海。","book":"汉·王褒《四子讲德论》"},"similar":["攀龙附凤"],"usage":"作谓语、宾语；指依附别人"},{"id":45892,"word":"附骨之疽","pinyin":"fù gǔ zhī jū","abbr":"fgzj","explanation":"疽：一种毒疮。紧贴着骨头生长的毒疮。比喻侵入到内部而又难于除掉的敌对势力。","source":{"text":"阴弃者如瘵病，如附骨之疽。","book":"清·谭嗣同《上欧阳中鹄书》欧阳中鹄批跋"},"example":{"text":"这种行动不但可以截断京汉路的交通，而且北京也受到一定的威胁，所以奉军视为～。","book":"陶菊隐《北洋军阀统治时期史话》第七十七回"},"usage":"作主语、宾语；用于比喻句"},{"id":45893,"word":"际会风云","pinyin":"jì huì fēng yún","abbr":"jhfy","explanation":"遭逢到好的际遇。","source":{"text":"文王应飞熊梦兆，遇吕望际会风云。","book":"《旧五代史·晋书·赵莹传论》：“赵莹际会风云，优游藩辅，虽易箦于绝域，终归柩于故园，盖仁信之行通于遐尔故也。”元·宫天挺《范张鸡黍》第一折"},"example":{"text":"累年蹭蹬，忽然～；终岁凄凉，竟得高悬月旦。","book":"清·吴敬梓《儒林外史》第二回"},"similar":["风云际会","际遇风云"],"usage":"作谓语、定语、分句；比喻能人遇到机会"},{"id":45894,"word":"际地蟠天","pinyin":"jì dì pán tiān","abbr":"jdpt","explanation":"形容遍及天地间。","source":{"text":"上际于天，下蟠于地。","book":"战国·宋·庄周《庄子·刻意》"},"example":{"text":"盖电之为用，～，今所用者未及一万分之一，约而言之，生力、生光二事而已矣。","book":"清·郑观应《盛世危言·电报》"},"usage":"作定语、状语；形容遍及天地间"},{"id":45895,"word":"际遇风云","pinyin":"jì yù fēng yún","abbr":"jyfy","explanation":"遭逢到好的际遇。同“际会风云”。","source":{"text":"际遇风云凡事别，积功日月壮心愆。","book":"宋·陈亮《廷对应制》诗"},"similar":["际会风云"],"usage":"作谓语、定语、分句；比喻能人遇到机会"},{"id":45896,"word":"陆无屋，水无舟","pinyin":"lù wú wū，shuǐ wú zhōu","abbr":"lwwswz","explanation":"陆：陆地。形容无处栖身。","source":{"text":"臣陆处无屋，舟居无水。","book":"《南史·张融传》"},"example":{"text":"～，朝村而暮郭也。","book":"清·蒲松龄《聊斋志异·雷曹》"}},{"id":45897,"word":"陆梁放肆","pinyin":"lù liáng fàng sì","abbr":"llfs","explanation":"陆梁：跳着行走的样子，引申为跋扈。形容十分嚣张，肆无忌惮。","source":{"text":"而便陆梁放肆，顾行吠主。","book":"汉·陈琳《檄吴将样部曲》"},"example":{"text":"李密～，不可以折简致之。","book":"《旧唐书·李密传》"}},{"id":45898,"word":"陆海潘江","pinyin":"lù hǎi pān jiāng","abbr":"lhpj","explanation":"陆：晋朝陆机；潘：晋朝潘岳。陆机的文才如大海，潘岳的文才如长江。比喻学识渊博，才华横溢的人。","source":{"text":"余常言：‘陆才如海，潘才如江。’","book":"南朝·梁·钟嵘《诗品》卷上"},"example":{"text":"～，无不善也。","book":"明·张溥《汉魏六朝百三名家集·潘黄门集题辞》"},"similar":["潘陆江海"],"usage":"作宾语；比喻有文才的人"},{"id":45899,"word":"陆离光怪","pinyin":"lù lí guāng guài","abbr":"llgg","explanation":"形容现象奇异，色彩繁杂。","source":{"text":"见船上扎着无数五色的彩球，夹着各色的鲜花，陆离光怪，纸醉金迷。","book":"清·曾朴《孽海花》第七回"},"example":{"text":"则又即在立旨居～的装饰之中，时或永被沉埋。","book":"鲁迅《且介亭杂文二集·小说二集序》"},"similar":["光怪陆离"],"usage":"作谓语、定语；形容五颜六色的景色"},{"id":45900,"word":"陆离斑驳","pinyin":"lù lí bān bó","abbr":"llbb","explanation":"形容色彩绚丽灿烂。","source":{"text":"不屑屑模文范义，通其义而肆言之，陆离斑驳，不可名状。","book":"清·梁廷柟《曲话》第三卷"},"example":{"text":"重碧大赤，～，以其戟刺，夺人目精，艳矣。","book":"鲁迅《集外集拾遗补编·拟播布美术意见书》"},"similar":["斑驳陆离","光怪陆离"],"opposite":["黯然失色"],"usage":"作谓语、定语；形容景物"},{"id":45901,"word":"陆詟水栗","pinyin":"lù zhé shuǐ lì","abbr":"lzsl","explanation":"指声威远播，四方畏服。","source":{"text":"殊方别区，界绝而不邻，自孝武所不能征，孝宣所不能臣，莫不陆詟水栗，奔走而来宾。","book":"《后汉书·班彪传》"},"usage":"作谓语、定语；用于处事"},{"id":45902,"word":"陆陆续续","pinyin":"lù lù xù xù","abbr":"llxx","explanation":"指有先有后，时断时续。","source":{"text":"自一炮以至三十七炮，内中虽陆陆续续，并未十分间断；此时忽停多时，这是何意？","book":"清·李汝珍《镜花缘》第66回"},"example":{"text":"这样～，东挪西凑牵扯不清，根本是一盘糊涂帐。","book":"高阳《胡雪岩全传·灯火楼台》"},"similar":["断断续续"],"usage":"作定语、状语；多用于口语"},{"id":45903,"word":"陇头音信","pinyin":"lǒng tóu yīn xìn","abbr":"ltyx","explanation":"指寄往或来自远方的书信。","source":{"text":"叹路途千里，日日思亲。青梅如豆，难寄陇头音信。","book":"元·高明《琵琶记·伯喈行路》"},"usage":"作宾语、定语；指书信","story":["南朝时候，宋朝的陆凯与文人范晔关系特别好，经常书信往来。一天陆凯在江南采得梅花一枝，并做诗一首：“折梅逢驿使，寄与陇头人。江南无所有，聊赠一枝春。”，寄给长安的范晔。范晔收到后感动万分"]},{"id":45904,"word":"陈世徇俗","pinyin":"ē shí xùn sú","abbr":"csxs","explanation":"阿：迎合；徇：曲从，曲意顺从。曲从迎合他人，随波逐流，不讲是非。","source":{"text":"乡原是一种小廉曲谨，陈世徇俗之人。","book":"宋·朱熹《答或人书》"}},{"id":45905,"word":"陈保之劳","pinyin":"ē bǎo zhī láo","abbr":"cbzl","explanation":"阿保：保护，养育。扶持、养育的功劳。","source":{"text":"是时掖庭宫婢则令民夫上书，自陈尝有阿保之功。","book":"《汉书·丙吉传》"},"example":{"text":"先是，帝以保母周氏有～，欲假其名号，内外皆奉诏。","book":"《晋书·顾和传》"}},{"id":45906,"word":"陈力就列","pinyin":"chén lì jiù liè","abbr":"cljl","explanation":"陈力：贡献才力；就：担任；列：官职、职位。能贡献才力，担任相应的官职。","source":{"text":"周任有言曰：‘陈力就列，不能者止。’","book":"《论语·季氏》"},"example":{"text":"然量已揆分，自知者审，～，宁敢空言，是以常愿一试，屡成干请。","book":"《梁书·季氏》"},"similar":["量才录用"],"usage":"作谓语、宾语；指量才录用"},{"id":45907,"word":"陈古刺今","pinyin":"chén gǔ cì jīn","abbr":"cgcj","explanation":"即借古讽今。借评论古代某人某事的是非曲直，影射现实。","source":{"text":"《大车》，刺周大夫也。礼义陵迟，男女淫奔，故陈古刺今，大夫不能听男女之讼焉。","book":"《诗·王风·大车序》"},"example":{"text":"若其隐辞寓意，虽～者，诗之乐之，皆无害也。","book":"宋·程大昌《考古编·诗论十七》"},"similar":["借古讽今"],"usage":"作谓语、宾语、定语；用于说话或文章等"},{"id":45908,"word":"陈善闭邪","pinyin":"chén shàn bì xié","abbr":"csbx","explanation":"陈：述说；善：善法美政；闭：堵塞。臣下对君主陈述善法美政，借以堵塞君主的邪心妄念。","source":{"text":"责难于君谓之恭，陈善闭邪谓之敬，吾君不能谓之贼。","book":"《孟子·离娄上》"},"similar":["隐恶扬善"],"usage":"作谓语、宾语；指施政等"},{"id":45909,"word":"陈师鞠旅","pinyin":"chén shī jǖ lǚ","abbr":"csjl","explanation":"陈：陈列；鞠：告；师旅：军队。出征之前，集合军队发布动员令。","source":{"text":"鞠旅陈师，赫然大号。","book":"《诗经·小雅·采芑》：“钲人伐鼓，陈师鞠旅。”《南史·宋本纪上》"},"example":{"text":"一旦去文就武，鼓三军而进之，～，亲为辛苦。","book":"唐·韩愈《与鄂州柳中丞书》"},"similar":["鞠旅陈师"],"usage":"作谓语；指集合军队发布命令"},{"id":45910,"word":"陈平分肉","pinyin":"chén píng fēn ròu","abbr":"cpfr","explanation":"陈平：汉朝开国功臣，官至宰相。陈平分肉分得很公平，比喻一个人处理事情很公正。","source":{"text":"里中社，平为宰，分肉食甚均。父老曰：‘善，陈孺子之为宰。’平曰：‘嗟乎，使平得宰天上，亦如是肉矣。’","book":"《史记·陈丞相世家》"}},{"id":45911,"word":"陈旧不堪","pinyin":"chén jiù bù kān","abbr":"cjbk","explanation":"不堪：不能忍受。陈旧腐朽的不成样子，使人难以忍受。","source":{"text":"那新摆出来的烧饼，更是陈旧不堪，暗想这种烧饼，还有什么人要买呢。","book":"清·吴趼人《二十年目睹之怪现状》第72回"},"example":{"text":"我的这件衣服已经～了。"},"similar":["破旧不堪"],"usage":"作谓语、定语；指陈旧的东西"},{"id":45912,"word":"陈蔡之厄","pinyin":"chén cài zhī è","abbr":"ccze","explanation":"厄：灾难。原指孔子及其弟子从陈国到蔡国的途中被围困，断绝粮食的事。后比喻旅途中遇到食宿上的困难。","source":{"text":"君子之厄于陈蔡之间，无上下之交也。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"人出名旅行难免会遇到～的。"},"similar":["在陈之厄"],"usage":"作宾语；指旅途困境","story":["春秋时期，大思想家孔子为了推行他的仁政及儒家思想，带领弟子数十人周游春秋列国。在楚国受到冷落后，就去陈国及蔡国游说，他们一行走到陈蔡国之间的荒野中发病，只好困在那里，弟子围着孔子而坐，没有粮食。后来他们坚持前行"]},{"id":45913,"word":"陈蕃下榻","pinyin":"chén fān xià tà","abbr":"cfxt","explanation":"陈蕃：汉时汝南人，字至太傅，封高阳侯。徐稚到陈蕃家下榻。后用以比喻礼待贤人。","source":{"text":"蕃在郡不接宾客，唯稚来特设一榻，去则县之。后举有道，家拜太原太守，皆不就。","book":"《后汉书·徐稚传》"},"example":{"text":"人杰地灵，徐孺下～。","book":"唐·王勃《滕王阁序》"}},{"id":45914,"word":"陈规陋习","pinyin":"chén guī lòu xí","abbr":"cglx","explanation":"陈旧不合理的规章制度或习惯。","source":{"text":"要是我们不抗战，今天早已经亡国了。陈规陋习也一样，你不跟它斗，它就会压垮你。","book":"老舍《鼓书艺人》"},"example":{"text":"～必须破除，否则就不能发展。"},"similar":["陋习陈规"],"usage":"作主语、宾语；指不合时宜的东西"},{"id":45915,"word":"陈言务去","pinyin":"chén yán wù qù","abbr":"cywq","explanation":"陈言：陈旧的言辞；务：务必。陈旧的言词一定要去掉。指写作时要排除陈旧的东西，努力创造、革新。","source":{"text":"惟陈言之务去，戛戛乎其难哉！","book":"唐·韩愈《与李翊书》"},"example":{"text":"～，杜诗与韩文同。黄山谷、陈后山诸公学杜在此。","book":"清·刘熙载《艺概·诗概》"},"similar":["务去陈言"],"usage":"作谓语；指必须去掉陈旧的语言"},{"id":45916,"word":"陈言老套","pinyin":"chén yán lǎo tào","abbr":"cylt","explanation":"陈旧的言词和套数。","source":{"text":"专从书上去学文字，即使学的好，也只是些陈言老套，有什么用处呢？","book":"夏丐尊、叶圣陶《文心》十三"},"similar":["陈词滥调"],"usage":"作宾语、定语；用于处世等"},{"id":45917,"word":"陈言肤词","pinyin":"chén yán fū cí","abbr":"cyfc","explanation":"指陈旧而肤浅的言词。","source":{"text":"短文章要能耐读，必须有精彩新鲜的内容，最好要比长文章更多地解决问题，不为陈言肤词，不为疏慢之语。","book":"马南邨《燕山夜话·文章长短不拘》"},"similar":["陈词滥调"],"usage":"作主语、宾语；用于文章或说话等"},{"id":45918,"word":"陈词滥调","pinyin":"chén cí làn diào","abbr":"ccld","explanation":"陈：陈旧，陈腐；滥：浮泛不合实际。指陈腐、空泛的论调。","source":{"text":"里面开列了记者经常使用的一些陈词滥调，诸如‘众所周知’。","book":"萧乾《老报人馀笔·随想录》"},"example":{"text":"不巧的是，凡是长篇散文，新鲜意思却非常之少，语言也是～。","book":"孙犁《澹定集·读一篇散文》"},"similar":["老生常谈","旧调重谈"],"opposite":["言简意赅"],"usage":"作宾语、定语；指没有新意"},{"id":45919,"word":"陈谷子烂芝麻","pinyin":"chén gǔ zi làn zhī má","abbr":"cgzlzm","explanation":"比喻陈旧的无关紧要的话或事物。","source":{"text":"可是我糊涂了，正经说的都没说，且说些陈谷子烂芝麻的。","book":"清·曹雪芹《红楼梦》第四十五回"},"example":{"text":"需要个年老的朋友，好有个地方去播放他的陈谷子烂芝麻。","book":"老舍《四世同堂》二"},"similar":["陈词滥调"],"usage":"作主语、宾语、定语；指过时货"},{"id":45920,"word":"陈辞滥调","pinyin":"chén cí làn diào","abbr":"ccld","explanation":"陈：陈旧，陈腐；滥：浮泛不合实际。指陈腐、空泛的论调。","source":{"text":"逢年过节和皇帝生日以及皇家有喜庆时所上的表笺，照例由学校教官代作，虽然都是陈辞滥调，因为说的都是颂扬话，朱元璋很喜欢阅读。","book":"吴晗《朱元璋传》第七章三"},"example":{"text":"我早已经不相信这些～了。"},"similar":["陈词滥调"],"usage":"作宾语、定语；指没有新意"},{"id":45921,"word":"陈遵投辖","pinyin":"chén zūn tóu xiá","abbr":"cztx","explanation":"陈遵：汉代人；投：丢；辖：大车轴头上穿着的小铁棍。陈遵为留住客人，把客人车上的辖取下投到井里去。比喻主人好客。","source":{"text":"陆贾分金将晏喜，陈遵投辖正留宾。","book":"唐·骆宾王《帝京篇》"}},{"id":45922,"word":"陈陈相因","pinyin":"chén chén xiāng yīn","abbr":"ccxy","explanation":"陈：旧；因：沿袭。原指皇仓之粮逐年增加，陈粮上压陈粮。后多比喻沿袭老一套，无创造革新。","source":{"text":"太仓之粟，陈陈相因，充溢露积于外，至腐败不可食。","book":"《史记·平准书》"},"example":{"text":"而儒者又疏阔，其言庸迂，～。","book":"清·恽敬《上陈笠帆按察书》"},"similar":["墨守成规","因循守旧","萧规曹随"],"opposite":["除旧布新","革故鼎新","推陈出新"],"usage":"作谓语、宾语、定语；比喻毫无创新","story":["西汉初年，刘邦采取一系列措施恢复经济，使得农业生产突飞猛进。汉文帝和汉景帝仍坚持这个既定的国策，因此国库里钱币堆成山，粮库里积压的粮食无数，陈陈相因，仓库容纳不下，只好露天堆放，很多谷子腐烂不能再食用了"]},{"id":45923,"word":"陈雷胶漆","pinyin":"chén léi jiāo qī","abbr":"cljq","explanation":"比喻彼此友情极为深重。","source":{"text":"胶漆自谓坚，不如雷与陈。","book":"《后汉书·雷义传》"},"example":{"text":"咱便似～，你兄弟至死呵不相离。","book":"元·无名氏《鲠直张千替杀妻》楔子"},"similar":["如胶似漆"],"usage":"作宾语、定语；指人关心亲密","story":["汉朝时期，太守张云推举陈重为孝廉，陈重要让给雷义，推让了十几回合，张云不同意。后来陈重和雷义同时为尚书郎，雷义因受谗言被罢官，回到老家，陈重多次上书为雷义辩护无效，就辞官去看雷义"]},{"id":45924,"word":"陋室空堂","pinyin":"lòu shì kōng táng","abbr":"lskt","explanation":"简陋的住房，空空的堂屋。形容贫穷衰败凄凉的景象。","source":{"text":"简陋的住房，空空的堂屋。形容贫穷衰败凄凉的景象。"}},{"id":45925,"word":"陋巷箪瓢","pinyin":"lòu xiàng dān piáo","abbr":"lxdp","explanation":"陋：简陋，窄小；箪：古代盛饭用的圆形竹器。住在陋巷里，用箪吃饭，用瓢喝水。形容生活极为穷苦。","source":{"text":"《论语·雍也》：“子曰：‘贤者回也。一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。贤哉回也。’"},"example":{"text":"仆本窭人子耳，～，何尝不惯。","book":"清·袁枚《小仓山房尺牍》第二十六首"},"similar":["箪食瓢饮"],"usage":"作谓语、宾语、定语；指家境贫寒","story":["春秋时期，孔子在他的学生中最喜欢颜回，他十分尊敬孔子。孔子指出缺点马上就改正，孔子问为何不去谋个一官半职。颜回说只要学到老师的道德学问何必去做官。孔子赞叹颜回箪食瓢饮，住陋巷，不去追名逐利，是一个大贤人"]},{"id":45926,"word":"陋巷菜羹","pinyin":"lòu xiàng cài gēng","abbr":"lxcg","explanation":"陋：简陋，窄小；菜羹：带汁的菜，指粗茶淡饭。住着简陋的房子，吃着普通饭菜。形容生活艰苦。","source":{"text":"人固有薄卿相之官，千乘之位，而甘陋苍菜羹者，同是人也。","book":"唐·韩愈《与崔群书》"}},{"id":45927,"word":"陌路相逢","pinyin":"mò lù xiāng féng","abbr":"mlxf","explanation":"指素不相识的人遇到一起。","source":{"text":"虽然若是，本分衲僧陌路相逢，别具通天正眼始得。","book":"宋·释普济《五灯会元》卷十二"},"example":{"text":"叔宝先年与朕～，全家亏他救护。","book":"清·禇人获《隋唐演义》第五十二回"},"usage":"作谓语、定语；指初次见面"},{"id":45928,"word":"降人以心","pinyin":"xiáng rén yǐ xīn","abbr":"jryx","explanation":"降：降服。使人心服。","source":{"text":"圣人之政，降人以心；贤人之政，降人以礼。","book":"《三略·下略》"},"similar":["降人以礼"],"usage":"作宾语、定语；用于处事"},{"id":45929,"word":"降妖捉怪","pinyin":"xiáng yāo zhuō guài","abbr":"xyzg","explanation":"原指有法术的人可以降伏妖精，捉拿鬼怪。后比喻以强大的力量战胜凶恶的敌人。","source":{"text":"闻说叶天师惯会降妖捉怪，明日便张天师吃鬼迷也。","book":"明·周楫《西湖二集·马神仙骑龙升天》"},"example":{"text":"狄员外合家大小没有一个不感激相大妗子替他家～。","book":"清·西周生《醒世姻缘传》第六十回"},"similar":["降妖除怪"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":45930,"word":"降妖除怪","pinyin":"xiáng yāo chú guài","abbr":"jycg","explanation":"降：降伏。制伏妖魔鬼怪。比喻把凶恶的敌人制伏","source":{"text":"便也绝不顾虑，一口允许，前来替他降妖除怪。","book":"清·无垢道人《八仙全传》第五回"},"similar":["降妖捉怪"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":45931,"word":"降尊临卑","pinyin":"jiàng zūn lín bēi","abbr":"jzlb","explanation":"尊贵的人委曲自己的身分与地位较低的人交往。","source":{"text":"此降尊以就卑也。","book":"西汉·戴圣《礼记·郊特牲》"},"example":{"text":"多谢也～，屈高屈高就下。","book":"元·石子章《竹坞听琴》第二折"},"similar":["降贵纡尊"],"opposite":["盛气凌人","居高临下"],"usage":"作谓语；指屈尊"},{"id":45932,"word":"降尊临卑，屈高就下","pinyin":"jiàng zūn lín bēi，qū gāo jiù xià","abbr":"jzlbqgjx","explanation":"降：降低；临：面临；卑：低微。指地位高的人放下架子与地位低的人交往。","source":{"text":"多谢也降尊临卑，屈高就下。","book":"元·石子章《竹坞听琴》第二折"},"similar":["纡尊降贵"],"usage":"作谓语、定语；可分开使用"},{"id":45933,"word":"降尊纡贵","pinyin":"jiàng zūn yū guì","abbr":"jzyg","explanation":"纡：弯曲，屈抑。降抑尊贵的地位，谦以自处。","source":{"text":"乃实由纡尊降贵，自放弃其贵族之特权，以结欢于处士。","book":"清·梁启超《中国专制政治进化史论》"},"example":{"text":"连国王乔治三世也不惜～，以推动新的农业经营为乐事。"},"similar":["降贵纡尊"],"opposite":["趾高气扬"],"usage":"作谓语、宾语；用于地位高的人"},{"id":45934,"word":"降心下气","pinyin":"jiàng xīn xià qì","abbr":"jxxq","explanation":"指虚心下气。","source":{"text":"降心下气，和那平民党维新党，同心同德，不分畛域，共图抵制外国，一切大祸可免。","book":"清·陈天华《警世钟》"},"similar":["虚心下气"],"usage":"作宾语、定语、状语；用于处事"},{"id":45935,"word":"降心俯首","pinyin":"jiàng xīn fǔ shǒu","abbr":"jxfs","explanation":"指虚心下气，恭顺服从。","source":{"text":"遂今天下学子，虽有绝学高志，不能不降心俯首，以肆力于诗赋帖括之业，而通人硕儒，蹉跎不第。","book":"梁启超《变法通议·论科举》"},"similar":["俯首帖耳"],"usage":"作谓语、宾语、状语；用于处事"},{"id":45936,"word":"降心相从","pinyin":"jiàng xīn xiāng cóng","abbr":"jxxc","explanation":"降心：屈己；从：顺从。降低自己去遵从别人。","source":{"text":"唯我郑国之有谒焉，如旧婚媾，其能降以相从也。","book":"《左传·隐公十一年》"},"example":{"text":"既料中国人必不失和，而孤拔以一水师提督，挟盛气而来，谓闽官必～，船局因垂手可得。","book":"高阳《清宫外史》下册"},"similar":["将心相随","委曲求全"],"usage":"作谓语、宾语；指委屈自己的意愿去服从别人"},{"id":45937,"word":"降心顺俗","pinyin":"jiàng xīn shùn sú","abbr":"jxss","explanation":"降低心志，随顺流俗。","source":{"text":"欲降心顺俗，则诡故不情，亦终不能获无咎无誉。","book":"三国·魏·嵇康《与山巨源绝交书》"},"usage":"作谓语、宾语；用于处事"},{"id":45938,"word":"降志辱身","pinyin":"jiàng zhì rǔ shēn","abbr":"jzrs","explanation":"降低自己的意志，屈辱自己的身分。指与世俗同流合污。","source":{"text":"柳下惠、少连，降志辱身矣。","book":"《论语·微子》"},"example":{"text":"怪不得我问他做甚事，他不肯说，说怕辱没了师傅。不知你肯～，做这等事，正是为人所不能为呢！","book":"清·吴趼人《痛史》第二十四回"},"similar":["忍辱负重"],"opposite":["平反昭雪"],"usage":"作谓语、宾语；指与世俗同流合污"},{"id":45939,"word":"降服而囚","pinyin":"xiang fu er qiu","abbr":"xfeq","explanation":"脱去上衣，象囚犯那样，表示谢罪。"},{"id":45940,"word":"降本流末","pinyin":"jiàng běn liú mò","abbr":"jblm","explanation":"犹言舍本逐末。比喻不抓根本环节，而只在枝节问题上下功夫。","source":{"text":"人才则由实而虚，文教则由振而委，亡弗降本流末暌正趋弊者矣！","book":"明·何景明《序》"},"similar":["舍本逐末"],"usage":"作谓语、宾语、定语、状语；指本末倒置"},{"id":45941,"word":"降格以求","pinyin":"jiàng gé yǐ qiú","abbr":"jgyq","explanation":"格：规格，标准。降低标准去寻求。","source":{"text":"那么到亲戚朋友那里借现钱去罢，怎么会有？于是降格以求，不讲爱国了，要外国银行的钞票。","book":"鲁迅《坟·灯下漫笔》"},"example":{"text":"选拔干部不能～、滥竽充数。"},"usage":"作谓语、宾语；指降低标准去寻求"},{"id":45942,"word":"降格相从","pinyin":"jiàng gé xiāng cóng","abbr":"jgxc","explanation":"降：降低；格：规格，标准。指屈己从人。","source":{"text":"即有一二卷册条幅，又为海内士大夫家珍秘，反不如降格相从，收取明人之易为力耳。","book":"清·钱泳《履园丛话·收藏·总论》"},"similar":["降心相从"],"usage":"作谓语、定语、宾语；用于处事"},{"id":45943,"word":"降贵纡尊","pinyin":"jiàng guì yū zūn","abbr":"jgyz","explanation":"纡：屈抑。指地位高的人降低身分俯就。","source":{"text":"降贵纡尊，躬刊手掇。","book":"南朝·梁·简文帝《昭明太子集序》"},"example":{"text":"但有时也～，跟病人研究研究用啥药合适。","book":"柏杨《暗夜慧灯》"},"similar":["降尊临卑"],"usage":"作谓语、宾语；指地位高的人降低身分俯就"},{"id":45944,"word":"降跽谢过","pinyin":"jiàng jì xiè guò","abbr":"jjxg","explanation":"跽：跪；过：过失。下跪谢罪。","source":{"text":"道士不能胜，降跽谢过。","book":"明·杨士奇《游东山记》"}},{"id":45945,"word":"降邪从正","pinyin":"xiáng xié cóng zhèng","abbr":"jxcz","explanation":"降：降服；从：归从。降伏妖邪，使之改邪归正。","source":{"text":"望爷爷与我们雪恨消灾，早进城降邪从正也。","book":"明·吴承恩《西游记》第44回"},"usage":"作谓语、宾语；用于处事"},{"id":45946,"word":"降颜屈体","pinyin":"jiàng yán qū tǐ","abbr":"jyqt","explanation":"犹言卑躬屈膝。形容没有骨气，低声下气地讨好奉承。","source":{"text":"三年奏最，上台即以两衙门待之，降颜屈体，反祈他日之陶铸；而二甲之为主事者，积资待次，不过两司郡守。","book":"明·沈德符《野获编·府县·邑令轻重》"},"similar":["卑躬屈膝"],"usage":"作谓语、定语、状语；用于处事"},{"id":45947,"word":"降龙伏虎","pinyin":"xiáng lóng fú hǔ","abbr":"xlfh","explanation":"原是佛教故事，指用法力制服龙虎。后比喻有极大的能力，能够战胜很强的对手或克服很大的困难。","source":{"text":"闻两虎交斗，咆响振岩，乃以锡杖中解，各散而去。","book":"南朝梁·慧皎《梁高僧传》卷十：“能以秘咒咒下神龙。”唐·道宣《续高僧传·习禅一·僧稠》"},"example":{"text":"～似平常，斩将封为斗木豸。","book":"明·许仲琳《封神演义》第八十三回"},"similar":["所向无敌","战无不胜"],"opposite":["唯唯诺诺"],"usage":"作谓语、定语；指人的本事大"},{"id":45948,"word":"陟岵瞻望","pinyin":"zhì hù zhān wàng","abbr":"zhzw","explanation":"陟：登、升；岵：有草木的山。指久居在外的人想念父母。","source":{"text":"陟彼枯岵兮，瞻望父兮。……陟彼屺兮，瞻望母兮。","book":"《诗经·魏风·陟岵》"},"example":{"text":"～，惟日惟岁。","book":"《后汉书·李膺传》"},"similar":["陟岵陟屺"],"usage":"作宾语、定语；用于书面语"},{"id":45949,"word":"陟岵陟屺","pinyin":"zhì hù zhì qǐ","abbr":"zhzq","explanation":"陟：登、升；岵：有草木的山；屺：无草木的山。指久居在外的人想念父母。","source":{"text":"陟彼枯岵兮，瞻望父兮。……陟彼屺兮，瞻望母兮。","book":"《诗经·魏风·陟岵》"},"example":{"text":"明·程登吉《幼学琼林》第二卷：“慈母望子，倚门倚闾；游子思亲，～。”"},"similar":["陟岵瞻望"],"usage":"作谓语；指思念父母"},{"id":45950,"word":"陟罚臧否","pinyin":"zhì fá zāng pǐ","abbr":"zfzp","explanation":"赏罚褒贬。","source":{"text":"《三国志·蜀志·诸葛亮传》“宫中府中，俱为一体，陟罚臧否，不宜异同。”"},"example":{"text":"郡邑守令仰望风采，～，在其一言。","book":"章炳麟《革命道德论》"},"usage":"作主语、宾语；用于书面语"},{"id":45951,"word":"陟遐自迩","pinyin":"zhì xiá zì ěr","abbr":"zxze","explanation":"陟：升；陟遐：远行；迩：近。走远路要从近处开始。比喻做事要扎扎实实，循序渐进。","source":{"text":"岂非积微成大，陟遐自迩。","book":"唐·王勃《平台秘略论十首·幼俊》"},"similar":["登高必自卑，行远必自迩"],"usage":"作比喻、定语；用于书面语"},{"id":45952,"word":"陡壁悬崖","pinyin":"dǒu bì xuán yá","abbr":"dbxy","explanation":"形容山势险峻。","example":{"text":"车队几乎就在～边上行驶，司机们格外聚精会神。"},"similar":["悬崖峭壁"],"usage":"作宾语、定语；用于地形等"},{"id":45953,"word":"除奸革弊","pinyin":"chú jiān gé bì","abbr":"cjgb","explanation":"除掉坏人，改革弊端。","source":{"text":"小官职居清廉，理当正直，除奸革弊也呵。","book":"元·无名氏《延安府》第一折"},"example":{"text":"古人都想有～的清官执政。"},"usage":"作谓语、定语；指除掉坏人，改革弊端"},{"id":45954,"word":"除害兴利","pinyin":"chú hài xīng lì","abbr":"chxl","explanation":"根除对人民有害的事，兴办对人民有利的事业。","source":{"text":"善为民除害兴利，故天下之民归之。","book":"《管子·治国》"},"similar":["兴利除害","兴利剔弊"],"usage":"作谓语、定语；指人办事的原则"},{"id":45955,"word":"除尘涤垢","pinyin":"chú chén dí gòu","abbr":"ccdg","explanation":"涤：涤荡；垢：污垢。清除灰尘，涤荡污垢。比喻扫除一切黑暗势力。也比喻清除旧的不合理的事物。"},{"id":45956,"word":"除恶务尽","pinyin":"chú è wù jìn","abbr":"cewj","explanation":"恶：邪恶；务：必须。清除坏人坏事必须干净彻底。","source":{"text":"树德务滋，除恶务本。","book":"《左传·哀公元年》：“树德莫如滋，云疾莫如尽。”《尚书·泰誓下》"},"example":{"text":"消息何殊马牛风，～不相容。","book":"李木庵《一九四九年元旦献词》诗"},"similar":["斩草除根","一网打尽"],"opposite":["养虎遗患","养痈贻患"],"usage":"作谓语、宾语、定语；指消除坏人与坏事","story":["公元前494年，吴王夫差率军在夫椒大败越王勾践，并破了越国的首都。越王勾践派大夫文种向吴国求和，吴王准备答应。伍子胥劝吴王“树德务滋，除恶务尽。”吴王不听他的建议，除恶未尽结果在20年后被勾践所消灭"]},{"id":45957,"word":"除恶务本","pinyin":"chú è wù běn","abbr":"cewb","explanation":"铲除恶势力，必须杜绝根本。","source":{"text":"去恶则务绝根本。","book":"《书·泰誓下》：“树德务滋，除恶务本。”蔡沈集传"},"example":{"text":"周留，贼之巢穴，群凶所聚，除恶务本，须拔其源。","book":"《旧唐书·刘仁规传》"},"similar":["除恶务尽"],"usage":"作谓语、宾语；用于处事"},{"id":45958,"word":"除患兴利","pinyin":"chú huàn xīng lì","abbr":"chxl","explanation":"清除祸患，兴办有利的事业。","source":{"text":"夫君之宠臣，欲以除患兴利；臣之事君，必以杀身靖乱，以功报主也。","book":"《三国志·魏书·任城陈萧王传》"}},{"id":45959,"word":"除患宁乱","pinyin":"chú huàn níng luàn","abbr":"chnl","explanation":"除掉祸患，平息叛乱。","source":{"text":"除患宁乱，克复旧都。","book":"三国·蜀·诸葛亮《后主出军诏》"},"usage":"作谓语、宾语；用于治国等"},{"id":45960,"word":"除旧布新","pinyin":"chú jiù bù xīn","abbr":"cjbx","explanation":"布：安排，开展。清除旧的，建立新的。以新的代替旧的。","source":{"text":"彗，所以除旧布新也。","book":"《左传·昭公十七年》"},"example":{"text":"～识君意，烂烂一星光射人。","book":"清·黄遵宪《西乡星歌》"},"similar":["推陈布新","革故鼎新"],"opposite":["因循守旧","蹈常袭故"],"usage":"作谓语、定语；用于指革新"},{"id":45961,"word":"除旧更新","pinyin":"chú jiù gēng xīn","abbr":"cjgx","explanation":"清除旧的，建立新的。以新的代替旧的。","source":{"text":"彗，所以除旧布新也。","book":"《左传·昭公十七年》"},"example":{"text":"新陈代谢，～，这是历史发展的必然规律。"},"similar":["除旧迎新","推陈出新"],"opposite":["因循守旧","蹈常袭故"],"usage":"作谓语、定语；用于以新的代替旧的"},{"id":45962,"word":"除暴安良","pinyin":"chú bào ān liáng","abbr":"cbal","explanation":"暴：暴徒；良：善良的人。铲除强暴，安抚善良的人民。","source":{"text":"舍之职责，在乎除暴安良。","book":"宋·李昉《太平广记》"},"example":{"text":"俺闻剑客行为莫不至公无私，倘心存偏袒，未有不遭恶报；至除暴安良，尤为切要。","book":"清·李汝珍《镜花缘》第六十回"},"similar":["锄强扶弱","除残去秽"],"opposite":["仗势欺人","以强凌弱"],"usage":"作谓语、宾语、定语；指维持好的社会风尚"},{"id":45963,"word":"除残去暴","pinyin":"chú cán qù bào","abbr":"ccqb","explanation":"残：残暴。暴：残暴，比喻恶势力。清除社会上的残暴、腐朽势力。","source":{"text":"故在济南，始除残去秽，平心选举，违忤诸常待。","book":"汉·曹操《让县自明本志令》"},"example":{"text":"据有江东，兵精粮足，正当横行天下，为国家～。","book":"明·罗贯中《三国演义》第四十四回"}},{"id":45964,"word":"除残去秽","pinyin":"chú cán qù huì","abbr":"ccqh","explanation":"残：残暴。秽：污秽，比喻恶势力。清除社会上的残暴、腐朽势力。","source":{"text":"故在济南，始除残去秽，平心选举，违忤诸常待。","book":"三国·魏·曹操《让县自明本志令》"},"example":{"text":"尚当横行天下，为汉家～。","book":"晋·陈寿《三国志·吴书·周瑜传》"},"similar":["除旧布新"],"usage":"作谓语、定语；指彻底改变"},{"id":45965,"word":"除残祛暴","pinyin":"chú cán qū bào","abbr":"ccqb","explanation":"除：去掉；祛：除去；暴：凶暴。铲除残暴。","source":{"text":"专一除残祛暴，济困扶危。","book":"明·冯梦龙《醒世恒言》第30卷"},"similar":["除残去暴"],"usage":"作谓语、宾语、定语；用于除暴"},{"id":45966,"word":"除狼得虎","pinyin":"chú láng dé hǔ","abbr":"cldh","explanation":"比喻除去一害又来一害。","source":{"text":"近虽遗官谦察，治其奸滥，易其疲软，然代者亦非选择，所谓除狼得虎也。","book":"《金史·陈规传》"},"example":{"text":"孙坚乃东猛虎；若打破洛阳，杀了董卓，正是除狼而得虎也。","book":"《三国演义》第五回"},"usage":"作宾语、定语；用于处事"},{"id":45967,"word":"除疾遗类","pinyin":"chú jí yí lèi","abbr":"cjyl","explanation":"治病却留下病根。比喻去患不彻底，留下祸患。","source":{"text":"越不为沼，吴其泯矣。使医除疾，而曰必遗类焉者，未之有也。","book":"《左传·哀公十一年》"}},{"id":45968,"word":"除秽布新","pinyin":"chú huì bù xīn","abbr":"chbx","explanation":"犹言除旧布新。","source":{"text":"孛星者，恶气所生，或谓之慧星，张为周分。其后世祖都洛阳，除秽布新之象。","book":"晋袁宏《后汉纪光武帝纪一》"},"similar":["除旧布新"],"usage":"作谓语、定语；用于指革新"},{"id":45969,"word":"除邪去害","pinyin":"chú xié qù hài","abbr":"cxqh","explanation":"清除邪恶，去掉祸害。","source":{"text":"长国姑除邪去害，保忠良重镇关津。","book":"元·无名氏《谢金吾》第四折"},"similar":["除邪去恶"],"usage":"作谓语、宾语；用于处事"},{"id":45970,"word":"除邪惩恶","pinyin":"chú xié chéng è","abbr":"cxce","explanation":"惩：处罚。清除邪气，惩办坏人。","source":{"text":"他爱看侠士小说，固此发了游侠狂，硬要到各处去除邪惩恶，碰了种种钉子。","book":"鲁迅《编校后记》"},"example":{"text":"他的小说大多歌颂～的英雄人物。"},"usage":"作谓语、定语；指消除邪恶"},{"id":45971,"word":"陨身糜骨","pinyin":"yǔn shēn mí gǔ","abbr":"ysmg","explanation":"犹言粉身碎骨。","source":{"text":"德泽汪洋，天隆地厚，非臣陨身糜骨所能报称。","book":"宋·司马光《乞罢条例司常平使疏》"},"similar":["粉身碎骨","粉骨碎身","殒身碎首"],"usage":"作谓语、状语；用于书面语"},{"id":45972,"word":"陨雹飞霜","pinyin":"yǔn báo fēi shuāng","abbr":"ybfs","explanation":"指遭受冤枉和诬陷。","source":{"text":"邹衍无罪，见拘于燕，当夏五月，仰天而叹，天为陨霜。","book":"汉·王充《论衡·感虚》"},"example":{"text":"臣知冤状，义激冲冠，代为稽颡。念～，孤忠可亮。","book":"明·屠隆《彩毫记·远谪夜郎》"},"usage":"作谓语、宾语；指灾害"},{"id":45973,"word":"险象环生","pinyin":"xiǎn xiàng huán shēng","abbr":"xxhs","explanation":"危险的局面不断产生。","source":{"text":"乃险象环生，祸机迫切。","book":"蔡东藩《民国通俗演义》第14回"},"example":{"text":"这次旅行真是～、惊心动魄。"},"similar":["岌岌可危","危在旦夕"],"opposite":["安如磐石","风平浪静"],"usage":"作谓语、定语；指危险的局面不断产生"},{"id":45974,"word":"险遭不测","pinyin":"xiǎn zāo bù cè","abbr":"xzbc","explanation":"形容从极危险的境地中逃出了性命。","example":{"text":"他在池中游泳突然抽搐，～，幸有旁人相救，方才逃过一劫。"},"similar":["险遭不幸"],"usage":"作谓语、定语；用于口语"},{"id":45975,"word":"险阻艰难","pinyin":"xiǎn zǔ jiān nán","abbr":"xzjn","explanation":"险阻：危险和障碍。前进道路上的困难、危险和障碍。","source":{"text":"险阻艰难备尝之矣。","book":"《左传·僖公二十八年》"},"example":{"text":"相公在外十余年，而复相国，～，备尝之矣。","book":"五代·王定保《唐摭言》卷六"},"similar":["艰难险阻"],"usage":"作宾语、定语；指困难、危险和障碍等","story":["春秋时期，晋文公重耳励精图治，使晋国日益强大，准备挑战当时的霸主楚成王。公元前632年，晋文公亲率大军进攻曹、卫小国，楚成王派大将子玉前去救援曹，告诫子玉说重耳在外流亡19年，什么艰难险阻都经历过，得小心对"]},{"id":45976,"word":"险陂倾侧","pinyin":"xiǎn bì qīng cè","abbr":"xbqc","explanation":"陂：邪佞。心术邪僻，行为不端。","source":{"text":"谗人罔极，险陂倾侧此之疑。","book":"《荀子·成相》"},"usage":"作宾语、定语；用于书面语"},{"id":45977,"word":"陵上虐下","pinyin":"líng shàng xià nüè","abbr":"lsnx","explanation":"陵：通“凌”，欺侮；虐：残暴，侵害。欺侮在上的人，侵害在下的人。","source":{"text":"为笑千载，皆不以义，陵上虐下故也。","book":"晋·陈寿《三国志·蜀志·后主传》裴松之引诸葛亮集"},"example":{"text":"晋·陈寿《三国志·蜀志·后主传》裴松之引诸葛亮集：“为笑千载，皆不以义，陵上虐下故也。”"},"similar":["凌上虐下"],"usage":"作谓语、宾语；用于坏人"},{"id":45978,"word":"陵劲淬砺","pinyin":"líng jìn cuì lì","abbr":"ljcl","explanation":"指强劲锋利。","source":{"text":"我强调了鲁迅的人民立场……小说平易近人，杂文则陵劲淬砺。我们是应该抓紧那种精神，而分别学习。","book":"郭沫若《洪波曲》第十二章四"},"usage":"作谓语、定语；用于书面语"},{"id":45979,"word":"陵厉雄健","pinyin":"líng lì xióng jiàn","abbr":"llxj","explanation":"猛烈严肃，刚强威武。"},{"id":45980,"word":"陵土未干","pinyin":"líng tǔ wèi gān","abbr":"ltwg","explanation":"陵：陵墓。指皇帝刚死不久。","source":{"text":"天子在外，内起甲兵，陵土未干，遽相诛戮，贞臣之体，宁若此乎。","book":"《晋书·宣帝纪》"}},{"id":45981,"word":"陵弱暴寡","pinyin":"líng ruò bào guǎ","abbr":"lrbg","explanation":"指欺凌弱小者和少数。","source":{"text":"自是之后，以强陵弱，以众暴寡。","book":"语出《庄子·盗跖》"},"example":{"text":"语出《庄子·盗跖》：“自是之后，以强陵弱，以众暴寡。”"},"similar":["凌弱暴寡"],"usage":"作谓语、定语、宾语；指欺侮弱小的"},{"id":45982,"word":"陵谷变迁","pinyin":"líng gǔ biàn qiān","abbr":"lgbq","explanation":"陵：大土山；谷：两山之间的夹道。丘陵变山谷，山谷变丘陵。比喻世事变迁，高下易位。","source":{"text":"高岸为谷，深谷为陵。","book":"《诗经·小雅·十月之交》"},"example":{"text":"后来“～”，这附近的地势抬高，河流改道，就成了一道干涸的川谷。","book":"姚雪垠《李自成》第二卷第二五章"},"similar":["沧海桑田"],"usage":"作宾语、定语；用于比喻句"},{"id":45983,"word":"陵谷沧桑","pinyin":"líng gǔ cāng sāng","abbr":"lgcs","explanation":"陵：山陵；谷：山谷。丘陵变山谷，山谷变丘陵。比喻世事巨变迁。","source":{"text":"又自托于前朝遗老，借陵谷沧桑之感，以掩其一身两姓之惭，其人已无足观。","book":"清·赵翼《瓯北诗话·吴梅村诗一》"},"example":{"text":"我们不能只感叹～，得充分把握现在。"},"similar":["沧海桑田"],"usage":"作宾语、定语；比喻世事巨变迁"},{"id":45984,"word":"陵迁谷变","pinyin":"líng qiān gǔ biàn","abbr":"lqgb","explanation":"陵：大土山；谷：两山之间的夹道。丘陵变山谷，山谷变丘陵。比喻世事变迁，高下易位。","source":{"text":"陵迁谷变须高节，莫向人间作大夫。","book":"《诗经·小雅·十月之交》：“高岸为谷，深谷为陵。”唐·罗隐《小松》诗"},"example":{"text":"菊坡九日登高路，往事知何处。～总成空，回首十年秋思、吹台东。","book":"宋·张元干《虞美人》词"}},{"id":45985,"word":"陵迟","pinyin":"ling chi","abbr":"lc","explanation":"衰微的意思。"},{"id":45986,"word":"陶情养性","pinyin":"táo qíng yǎng xìng","abbr":"tqyx","explanation":"陶：喜，快乐；养：培养，休养。使心情愉快。","source":{"text":"酒可陶情适性，兼能解闷消愁。三杯五盏乐悠悠，痛饮翻能损寿。","book":"明·冯梦龙《醒世恒言》卷三十六"},"example":{"text":"他说音乐只能用来～，假如用来谋生，非饿死不可。","book":"琼瑶《在水一方》二"}},{"id":45987,"word":"陶情适性","pinyin":"táo qíng shì xìng","abbr":"tqsx","explanation":"陶：喜，快乐；适：舒适，畅快。使心情愉快。","source":{"text":"酒可陶情适性，兼能解闷消愁，三杯五盏乐悠悠，痛饮翻能损寿。","book":"明·冯梦龙《醒世恒言》第36卷"},"example":{"text":"吾以此～，且泯彼猜疑也。","book":"清·薛福成《庸庵笔记·史料二》"},"similar":["怡情冶性"],"usage":"作谓语；指使心情愉快"},{"id":45988,"word":"陶然而醉","pinyin":"táo rán ér zuì","abbr":"trez","explanation":"陶然：欢畅的样子。形容酣畅淋漓地醉饮。","source":{"text":"且欲近寻彭泽宰，陶然共醉菊花杯。","book":"唐·崔曙《九日登望仙台》"},"example":{"text":"总陶然而大醉，亦魂清而梦真。","book":"清·蒲松龄《聊斋志异·作大王》"}},{"id":45989,"word":"陶然自得","pinyin":"táo rán zì dé","abbr":"trzd","explanation":"自己觉得快意。","source":{"text":"坐废十年，陶然自得。","book":"宋·苏轼《杨绘可知徐州》"},"similar":["陶陶自得"],"usage":"作谓语、定语、状语；用于处事"},{"id":45990,"word":"陶熔鼓铸","pinyin":"táo róng gǔ zhù","abbr":"trgz","explanation":"比喻给人的思想、性格以有益的影响。","source":{"text":"军机处各大臣，虽经洋翰林、洋进士一番陶熔鼓铸，也只晓得‘立宪，立宪’！","book":"清·李宝嘉《文明小史》第六十回"}},{"id":45991,"word":"陶犬瓦鸡","pinyin":"táo quǎn wǎ jī","abbr":"tqwj","explanation":"陶土做的狗，泥土塑的鸡。比喻徒具形式而无实用的东西。","source":{"text":"陶犬无守夜之警，瓦鸡无司晨之益。","book":"南朝·梁·萧绎《金缕子·立言上》"},"example":{"text":"真是城狐社鼠，空存无用，何殊～。","book":"清·程允升《幼学琼林·鸟兽》"},"opposite":["栋梁之材"],"usage":"作宾语、定语；指无用的东西"},{"id":45992,"word":"陶猗之家","pinyin":"táo yī zhī jiā","abbr":"tyzj","explanation":"陶：陶朱公，即春秋时楚国人范蠡；猗：春秋时鲁国人猗顿；陶猗：泛指富人。指富有的人家。","source":{"text":"陶朱公以治产致富，猗顿以制盐起家。","book":"《史记·货殖列传》"}},{"id":45993,"word":"陶镕鼓铸","pinyin":"táo róng gǔ zhù","abbr":"trgz","explanation":"陶镕：烧制陶器；鼓铸：冶炼金属。比喻给人的思想、性格以有益的影响。","source":{"text":"军机处各大臣，虽经洋翰林、洋进士一番陶镕鼓铸，也只晓得‘立宪，立宪’！","book":"清·李宝嘉《文明小史》第60回"},"example":{"text":"他对我有～般的影响。"},"usage":"作宾语、定语；指教育鼓动"},{"id":45994,"word":"陶陶兀兀","pinyin":"táo táo wù wù","abbr":"ttww","explanation":"形容沉湎于酒，放纵傲慢。","source":{"text":"伶虽陶兀昏放，而机应不差。未尝厝意文翰，惟著《酒德颂》一篇。","book":"《晋书·刘伶传》"},"example":{"text":"～，尊前是我华胥国。","book":"宋·黄庭坚《醉落魄》词"},"usage":"作谓语、分句；指人放纵傲慢"},{"id":45995,"word":"陶陶自得","pinyin":"táo táo zì dé","abbr":"ttzd","explanation":"自己觉得快意。同“陶然自得”。","source":{"text":"但无思无虑，陶陶自得，任兀然而醉，恍然而醒。","book":"宋·林正夫《括沁园春》词"},"similar":["陶然自得"],"usage":"作谓语、定语、状语；用于处事"},{"id":45996,"word":"陷于缧绁","pinyin":"xiàn yú léi xiè","abbr":"xylx","explanation":"缧绁：捆绑犯人的绳索。指被关进监牢。","source":{"text":"若非二哥众位把船相救，我等皆被陷于缧绁。","book":"明·施耐庵《水浒全传》第四十一回"},"similar":["陷身囹圄"],"usage":"作谓语、定语；指被关进监牢"},{"id":45997,"word":"陷入僵局","pinyin":"xiàn rù jiāng jú","abbr":"xrjj","explanation":"指僵持的局面。","example":{"text":"由于对方毫无诚意，使贸易谈判～。"},"usage":"作谓语、定语；用于处境等"},{"id":45998,"word":"陷坚挫锐","pinyin":"xiàn jiān cuò ruì","abbr":"xjcr","explanation":"陷坚：深入或攻克敌人阵地；挫锐：挫伤敌人锐气。指攻克强敌，挫伤敌军的士气。","source":{"text":"其用战也贵胜，久则钝兵挫锐，攻城则力屈，久暴师则国用不足。","book":"《史记·魏其武安侯列传》：“灌孟年老，颍阴侯强请之，郁郁不得意，故战常陷坚，遂死吴军中。”《孙子·作战篇》"},"usage":"作谓语、定语、宾语；用于军事或处事等"},{"id":45999,"word":"陷落计中","pinyin":"xiàn luò jì zhōng","abbr":"xljz","explanation":"指中敌人或对方的诡计。","example":{"text":"周瑜～，让诸葛亮实现了草船借箭的计谋。"}},{"id":46000,"word":"陷身囹圄","pinyin":"xiàn shēn líng yǔ","abbr":"xsly","explanation":"陷身：被拘禁，失去行动自由；囹圄：监狱。指被关进监牢。","source":{"text":"此次奉令北移，突被亲日派阴谋袭击，力竭负伤，陷身囹圄。","book":"毛泽东《为皖南事变发表的命令和谈话》"},"similar":["陷于缧绁"],"usage":"作谓语、定语；指被关进监牢"},{"id":46001,"word":"隆刑峻法","pinyin":"lóng xíng jùn fǎ","abbr":"lxjf","explanation":"指刑法重而严。","source":{"text":"议者以为隆刑峻法，非明王急务，施行日久，岂一朝所厘。","book":"《后汉书·梁统传》"},"similar":["严刑峻法"],"usage":"作宾语、定语；指残暴统治"},{"id":46002,"word":"隆古贱今","pinyin":"lóng gǔ jiàn jīn","abbr":"lgjj","explanation":"推崇古代，轻视当今。","source":{"text":"明白了通变的道理，便不至于一味的隆古贱今，也不至于一味竞今疏古，便能公平的看历史，各各还给它一副本来面目。","book":"朱自清《正变》"},"similar":["厚古贱今"],"usage":"作谓语、定语、宾语；用于处事"},{"id":46003,"word":"隆恩旷典","pinyin":"lóng ēn kuàng diǎn","abbr":"lekd","explanation":"稀有难逢的厚恩。","source":{"text":"老爷隆恩旷典，着众婢子出来择配，以了终身，也是千古奇逢，难得的快事。","book":"清·褚人获《隋唐演义》第十六回"},"usage":"作宾语、定语；指恩礼"},{"id":46004,"word":"隆情厚谊","pinyin":"lóng qíng hòu yì","abbr":"lqhy","explanation":"隆：盛大；谊：交情。情谊深厚。","source":{"text":"许多隆情厚谊，尚未少酬，至今犹自歉然。","book":"清·褚人获《隋唐演义》第24回"},"similar":["深情厚谊"],"opposite":["无情无义"],"usage":"作主语、宾语；指感情深厚"},{"id":46005,"word":"隆情盛意","pinyin":"lóng qíng shèng yì","abbr":"lqsy","explanation":"隆、盛：深厚。深厚的情意。"},{"id":46006,"word":"隈刀避箭","pinyin":"wēi dāo bì jiàn","abbr":"wdbj","explanation":"隈：隐避的地方，躲避。比喻遇战事退缩不前。","example":{"text":"～的战士不是一个合格的战士。"},"similar":["畏刀避箭"],"usage":"作谓语、定语；用于书面语"},{"id":46007,"word":"隋侯之珠","pinyin":"suí hóu zhī zhū","abbr":"shzz","explanation":"隋：古国名。比喻珍贵的物品。","source":{"text":"今且有人于此，以隋侯之珠，弹千仞之雀，世必笑之。是何也？则其所用者重，而所要者轻也。","book":"战国·宋·庄周《庄子·让王》"},"example":{"text":"～，烛众士之好，南垠之金。","book":"《文士传》"},"similar":["随侯之珠"],"usage":"作宾语；比喻珍贵的物品","story":["传说周朝时期，“汉东之国”姓姬的隋侯一次在野外打猎时救了一条蛇，并把它带回家养起来，后来蛇吐出一颗大夜明珠报答他的救命之恩，这颗大夜明珠就是“隋侯之珠”"]},{"id":46008,"word":"隋珠和玉","pinyin":"suí zhū hé yù","abbr":"szhy","explanation":"即隋珠和璧。","source":{"text":"他的质当从来饶本，有的是隋珠和玉，赤仄黄银。","book":"明·徐复祚《一文钱》第二折"},"similar":["隋珠和璧","隋珠荆璧"],"usage":"作主语、宾语、定语；泛指珍宝"},{"id":46009,"word":"隋珠和璧","pinyin":"suí zhū hé bì","abbr":"szhb","explanation":"隋侯之珠与和氏之璧。泛指珍宝。","source":{"text":"隋珠和璧世珍重，眼前点毁终难动。","book":"明·何景明《宋五清先生赴浙江提学歌》"},"similar":["隋珠和玉","隋珠荆璧"],"usage":"作主语、宾语、定语；泛指珍宝"},{"id":46010,"word":"隋珠弹雀","pinyin":"suí zhū tán què","abbr":"sztq","explanation":"隋珠：古代传说中的夜明珠，即隋侯的明月珠。用夜明珠去弹鸟雀。比喻得不偿失。","source":{"text":"今且有人于此，以隋侯之珠，弹千仞之雀，世必笑之。是何也？则其所用者重，而所要者轻也。","book":"《庄子·让王》"},"example":{"text":"犬彘何须辱剑铓？～总堪伤！","book":"明·冯梦龙《东周列国志》第一回"},"similar":["明珠弹雀","得不偿失"],"usage":"作主语、宾语、定语；指得不偿失","story":["鲁哀公听说颜阖非常贤明，就派人给他送礼物请他出山。贫穷的颜阖不受。庄子就此事发表感慨，颜阖无意于富贵，富资送上门，他不欢迎。这样的人难得。而那些不惜牺牲生命去追求富贵就如同“以隋侯之珠，弹千仞之雀”一样不值得"]},{"id":46011,"word":"隋珠荆璧","pinyin":"suí zhū jīng bì","abbr":"szjb","explanation":"即隋珠和璧。","source":{"text":"立神明通天之台，造甲乙之帐，络以隋珠荆璧。","book":"汉·荀悦《汉纪·武帝纪》"},"similar":["隋珠和玉","隋珠和璧"],"usage":"作主语、宾语、定语；泛指珍宝"},{"id":46012,"word":"随世沉浮","pinyin":"suí shì chén fú","abbr":"sscf","explanation":"沉浮：在水面上出没。形容缺乏操守，随俗俯仰。亦作“与世沉浮”、“随俗浮沉”。","source":{"text":"若令子初随世沉浮，容悦玄德，交非其人，何足称为高士乎？","book":"《三国志·蜀志·刘巴传》裴松之注引《零陵先贤传》"},"usage":"作谓语、定语；用于处事"},{"id":46013,"word":"随乡入乡","pinyin":"suí xiāng rù xiāng","abbr":"sxrx","explanation":"到一个地方就按照这一个地方的风俗习惯生活。也比喻到什么地方都能适应。","source":{"text":"天涯节物遮愁眼，旦复随乡便入乡。","book":"《庄子·山木》：“入其俗，从其令。”宋·范成大《秋雨快晴静胜堂席上》诗"},"example":{"text":"“～”，到了你这里，自然把这金珠玉宝一概贬为俗器了。","book":"清·曹雪芹《红楼梦》第四十一回"},"similar":["入乡随俗"],"usage":"作谓语、宾语；同“入乡随俗”"},{"id":46014,"word":"随乡入俗","pinyin":"suí xiāng rù sú","abbr":"sxrs","explanation":"到一个地方就按照这一个地方的风俗习惯生活。也比喻到什么地方都能适应。同“随乡入乡”。","source":{"text":"则怕珍馐不齐，老皇帝也只得随乡入俗了。","book":"《庄子·山木》：“入其俗，从其令。”明·汤显祖《邯郸记》第十三出"},"example":{"text":"我在生活上，无主见，常常是～，随行就市的。","book":"孙犁《记陈肇》"},"similar":["随乡入乡"],"usage":"作谓语、宾语；用于处事"},{"id":46015,"word":"随事制宜","pinyin":"suí shì zhì yí","abbr":"sszy","explanation":"根据事实，采取适当措施。","source":{"text":"如道之正体，却一定于此，而随事制宜，自莫不当。","book":"宋·朱熹《朱子语类》卷三十七"}},{"id":46016,"word":"随人作计","pinyin":"suí rén zuò jì","abbr":"srzj","explanation":"指顺应他人意旨行事。","source":{"text":"男儿必有自立之处，不随人作计，如蚊之同声，蝇之同嗜，以取富贵名誉也。","book":"清·恽敬《答方九江书》"},"usage":"作谓语、定语；用于书面语"},{"id":46017,"word":"随人俯仰","pinyin":"suí rén fǔ yǎng","abbr":"srfy","explanation":"指随波逐流，从俗浮沉。","source":{"text":"侯朝宗随人俯仰，致近徘优。","book":"清·包世臣《再与杨季子书》"},"example":{"text":"你不能没有原则地～。"},"similar":["任人摆布"],"usage":"作谓语、定语；指没有主见"},{"id":46018,"word":"随侯之珠","pinyin":"suí hóu zhī zhū","abbr":"shzz","explanation":"比喻珍贵的物品。同“隋侯之珠”。","source":{"text":"虽出随侯之珠，夜光之壁，犹结怨而不见德。","book":"《史记·鲁仲连邹阳列传》"},"example":{"text":"～，烛众士之好，南垠之金，登窈窕之首。","book":"《三国志·魏志·王粲传》裴松之注引《文干传》"},"similar":["隋侯之珠"],"usage":"作宾语；比喻珍贵的物品"},{"id":46019,"word":"随俗为变","pinyin":"suí sú wéi biàn","abbr":"sswb","explanation":"随：顺从；俗：世俗。指顺随风俗而变化。","source":{"text":"过洛阳，闻周人爱老人，即为耳目痹医；来入咸阳，闻秦人爱小儿，即为小儿医，随俗为变。","book":"《史记·扁鹊仓公列传》"},"example":{"text":"陶铸《崇高的理想》：“扁鹊深入民间，‘周游列国’，‘～’，解除人民疾病的痛苦……”"},"usage":"作谓语、定语；用于处事","story":["战国时期，名医扁鹊天下闻名，经常周游列国为人看病。路过邯郸时，听说有贵妇人得病，就担当起妇科大夫的角色；路过洛阳时，听说周人敬重老人，就担当起五官科大夫的角色；到了咸阳，听说秦人喜爱小孩，他又随俗为变成为小儿科大夫了"]},{"id":46020,"word":"随俗沉浮","pinyin":"suí sú chén fú","abbr":"sscf","explanation":"自己没有一定的想法，随着潮流走。比喻不抱己见，顺从世俗的立志和观点。","source":{"text":"故且从俗浮沉，与时俯仰，以通其狂惑。","book":"汉·司马迁《报任少卿书》"},"example":{"text":"少有俊才，出于寒素，不能～，为时豪所抑。","book":"《晋书·文苑传》"},"similar":["随俗浮沉"],"usage":"作谓语、定语；指没有主见"},{"id":46021,"word":"随俗浮沉","pinyin":"suí sú fú chén","abbr":"ssfc","explanation":"自己没有一定的想法，随着潮流走。","source":{"text":"泰不华尚气节，不随俗浮沉。","book":"《元史·泰不华传》"},"example":{"text":"宁忍～，取舍从违，应早审定。","book":"《清史稿·睿忠亲王多尔衮传》"},"similar":["随俗沉浮"],"usage":"作谓语、定语；指没有主见"},{"id":46022,"word":"随俗雅化","pinyin":"suí sú yǎ huà","abbr":"ssyh","explanation":"随：顺从；俗：指当地的风尚；雅：闲雅，从容。随着当地的风俗而从容变化。","source":{"text":"所以饰后宫、充下陈、娱心意、悦耳目者，必出地秦然后可，则是宛珠之簪、傅玑之珥、阿缟之衣、锦绣之饰不进于前，而随俗雅化、佳冶窈窕赵女不立于侧也。","book":"秦·李斯《谏逐客书》"}},{"id":46023,"word":"随口乱说","pinyin":"suí kǒu luàn shuō","abbr":"skls","explanation":"随便乱说。","example":{"text":"你不该～，害得他解释不清。"},"similar":["随口胡诌"],"usage":"作谓语、宾语；指信口开河"},{"id":46024,"word":"随口胡诌","pinyin":"suí kǒu hú zhōu","abbr":"skhz","explanation":"随便搪塞。","example":{"text":"他不懂时就～对付过去。"},"similar":["随口乱说"],"usage":"作谓语、宾语；指信口开河"},{"id":46025,"word":"随圆就方","pinyin":"suí yuán jiù fāng","abbr":"syjf","explanation":"处事顺应形势和情况的变化；待人随和而不固执。同“随方就圆”。","source":{"text":"濮祖之后，性比山麋，貌同野瘦，随圆就方，似无惟有。","book":"宋·叶绍翁《四朝闻见录·恭孝仪王大节》"},"similar":["随方就圆"],"usage":"作谓语、定语；用于处事"},{"id":46026,"word":"随地随时","pinyin":"suí dì suí shí","abbr":"sdss","explanation":"①指依照当时当地情形；在不同的时间、地点。②任何时间、地点；时时处处。同“随时随地”。","source":{"text":"居近珲春之库尔喀人，分驻佐领，随地随时编丁入军籍，统称为吉林之兵。","book":"清·魏源《圣武记》第一卷"},"similar":["随时随地"],"usage":"作定语、状语；指时时刻刻"},{"id":46027,"word":"随声吠影","pinyin":"suí shēng fèi yǐng","abbr":"ssfy","explanation":"比喻一经他人唆使，便不分是非曲直，对人大加攻击。","source":{"text":"谚曰：一犬吠形，百犬吠声。","book":"汉·王符《潜夫论·贤难》"},"example":{"text":"遂至～，恬然不知耻，悍然罔所顾。","book":"清·王韬《代上广州府冯太守书》"},"similar":["吠影吠声"],"usage":"作谓语、定语；指人云亦云"},{"id":46028,"word":"随声是非","pinyin":"suí shēng shì fēi","abbr":"sssf","explanation":"指自己没有独立的是非观念，别人说是，自己也说是，别人说非，自己也说非。","source":{"text":"或怀妒嫉不考情实，雷同相从，随声是非，岂不哀哉。","book":"汉·荀悦《汉纪·哀帝纪下》"},"usage":"作谓语、定语；用于处事"},{"id":46029,"word":"随声趋和","pinyin":"suí shēng qū hé","abbr":"ssqh","explanation":"自己没有主见，别人怎么说，就跟着怎么说。见“随声附和”。","source":{"text":"其学务穷本原，不为章句训话，其持论雄杰卓立，不苟随声趋和。","book":"宋·孔炜《文安谥议》"},"similar":["随声附和"],"usage":"作谓语、宾语、状语；指没有主见"},{"id":46030,"word":"随声逐响","pinyin":"suí shēng zhú xiǎng","abbr":"sszx","explanation":"指耳听为虚，眼见为实。","source":{"text":"此随声逐响之过也。","book":"东汉·王符《潜夫论·贤难》"},"usage":"作宾语、定语；指人没主见","story":["从前司原氏夜间去田野打猎追逐一只鹿往东跑去，他听见西边一群人正在喧叫抓一头猪，他埋伏下来捉住那头浴白色土的猪，该猪发出亲昵的声音，以为是神物就带回家供养。不久暴雨把猪身上的白色土冲刷掉，原是自己的猪，这是随声逐响造成的错"]},{"id":46031,"word":"随声附和","pinyin":"suí shēng fù hè","abbr":"ssfh","explanation":"和：声音相应。自己没有主见，别人怎么说，就跟着怎么说。","source":{"text":"崇侯虎不过随声附和，实非本心。","book":"明·许仲琳《封神演义》第十一回"},"example":{"text":"放翁（陆游）晚年有得，非～以道学为名高者矣。","book":"清·赵翼《瓯北诗话》卷六"},"similar":["随波逐流","见风使舵","人云亦云"],"opposite":["独具匠心","独出心裁","各抒己见"],"usage":"作谓语、宾语、状语；指没有主见"},{"id":46032,"word":"随大流","pinyin":"suí dà liú","abbr":"sdl","explanation":"顺着多数人说话或办事。","source":{"text":"唉，算啦，算啦，羊随大群不挨打，人随大流不挨罚。","book":"《取经》"},"example":{"text":"我不喜欢～的人。"},"similar":["随大溜"],"opposite":["独树一帜"],"usage":"作谓语、定语、宾语；指中庸"},{"id":46033,"word":"随寓而安","pinyin":"suí yù ér ān","abbr":"syea","explanation":"指能顺应环境，在任何境遇中都能满足。同“随遇而安”。","source":{"text":"安，谓随所寓而安，盖深于静也。","book":"宋·朱熹《朱子语类》卷十四"},"example":{"text":"似此专人来往劳费，亦是未能省事～之病。","book":"明·王阳明《传习录》卷下"},"similar":["随寓随安","随遇而安"],"usage":"作谓语、宾语、定语、状语；指能顺应环境"},{"id":46034,"word":"随寓随安","pinyin":"suí yù suí ān","abbr":"sysa","explanation":"犹言随遇而安。指能顺应环境，在任何境遇中都能满足。","source":{"text":"世念久阑珊，随寓随安。人情犹望衮衣还。","book":"宋·魏了翁《浪淘沙》词"},"similar":["随寓而安","随遇而安"],"usage":"作谓语、宾语、定语、状语；指能顺应环境"},{"id":46035,"word":"随心所欲","pinyin":"suí xīn suǒ yù","abbr":"sxsy","explanation":"随：任凭；欲：想要。随着自己的意思，想要干什么就干什么。","source":{"text":"七十而从心所欲，不逾矩。","book":"《论语·为政》"},"example":{"text":"我们二人并坐，～的漫谈。","book":"臧克家《老舍永在》"},"similar":["为所欲为","自得其乐"],"opposite":["谨小慎微","缩手缩脚"],"usage":"作谓语、宾语、状语；指为所欲为","story":["贾宝玉自从有了秦钟作伴上学后，整天与秦钟混在一起，他本是一个不安本分的人，现在更加随心所欲了。贾政只当他上学，也不怎么管他。宝玉与秦钟忘记了辈分，竟称兄道弟起来，宝玉有时直接叫秦钟的表字，秦钟也习以为常"]},{"id":46036,"word":"随意一瞥","pinyin":"suí yì yī piē","abbr":"syyp","explanation":"匆匆地一瞥。","example":{"text":"我只要～就可以看出你打的什么主意。"},"usage":"作谓语、宾语；指不完全注意"},{"id":46037,"word":"随手拈来","pinyin":"suí shǒu niān lái","abbr":"ssnl","explanation":"拈：用手指捏取东西。随手拿来。多指写文章时能自由纯熟的选用词语或应用典故，用不着怎么思考。","source":{"text":"前身子美只君是，信手拈来俱天成。","book":"宋·苏轼《次韵孔毅甫集古人句见赠》诗"},"example":{"text":"老实说罪魁祸首～不计其数，如果顾鳌等三人都算数，这张名单可以达五百人了。","book":"丁中江《北洋军阀史话》九十七"}},{"id":46038,"word":"随才器使","pinyin":"suí cái qì shǐ","abbr":"scqs","explanation":"根据长处，安排适当的工作。","source":{"text":"或奔驰，或偷骗，各有偏长，真是随才器使。","book":"明·施耐庵《水浒传》第71回"},"similar":["量才录用"],"usage":"作谓语、宾语；用于人事安排"},{"id":46039,"word":"随文释义","pinyin":"suí wén shì yì","abbr":"swsy","explanation":"随：顺着；释：解释。指依据一段话或前后文，对某个不懂的概念做出解释。","source":{"text":"自孔安国以下，为之解者殆百余家，随文释义，人有取焉。","book":"宋·陈亮《郑景望书说邓》"}},{"id":46040,"word":"随方就圆","pinyin":"suí fāng jiù yuán","abbr":"sfjy","explanation":"处事顺应形势和情况的变化；待人随和而不固执。","source":{"text":"好使的钱，你好随的方就的圆，可又分的愚别的贤。","book":"元·马致远《青衫泪》第二折"},"example":{"text":"我们只好～，就地取材了。"},"usage":"作谓语、宾语；指就地取材"},{"id":46041,"word":"随方逐圆","pinyin":"suí fāng zhú yuán","abbr":"sfzy","explanation":"①指立身行事无定则。②根据物体的形状、地形的高低等作出与之相适应的设计构造。","source":{"text":"此犹是应机接物，随方逐圆时节。","book":"宋·克勤说《圆悟佛果禅师语录》四"},"example":{"text":"和光混俗，惟其利欲是前；～，不以廉耻为重。","book":"明·兰陵笑笑生《金瓶梅词话》第五十七回"},"usage":"作谓语、定语、宾语；用于比喻句"},{"id":46042,"word":"随时制宜","pinyin":"suí shí zhì yí","abbr":"sszy","explanation":"随：根据；制：制订，采取；宜：适宜的措施。根据当时的情况，采取适当的措施。","source":{"text":"州将使求援于外，本无定指，随时制宜耳。","book":"《晋书·周崎传》"},"similar":["因时制宜"],"usage":"作谓语；指见机行事"},{"id":46043,"word":"随时变化","pinyin":"suí shí biàn huà","abbr":"ssbh","explanation":"时：时间。随着时间的变化而采取适当的措施。","source":{"text":"是故气性随时变化，岂必有常类哉？","book":"汉·王充《论衡·讲瑞》"},"example":{"text":"五行流迈，日月代征。～，庶物乃成。","book":"《宋书·乐志二》"}},{"id":46044,"word":"随时度势","pinyin":"suí shí duó shì","abbr":"ssds","explanation":"根据当时的情况审度事势的发展趋向。","source":{"text":"可见凡事须随时度势，敢作敢为，方可转祸为福。","book":"清·褚人获《隋唐演义》第94回"},"example":{"text":"她善于～，不会吃亏的。"},"similar":["审时度势"],"usage":"作谓语、宾语；指适应时势"},{"id":46045,"word":"随时施宜","pinyin":"suí shí shī yí","abbr":"sssy","explanation":"根据当时的情况，采取适当的措施。同“随时制宜”。","source":{"text":"推本知变，实有考于将来；随时施宜，亦不为乎无补。","book":"宋·王安石《敕修南郊式表》"},"similar":["随时制宜"],"usage":"作谓语、定语；用于处事"},{"id":46046,"word":"随时随地","pinyin":"suí shí suí dì","abbr":"sssd","explanation":"①指依照当时当地情形；在不同的时间、地点。②任何时间、地点；时时处处。","source":{"text":"游山诗有时地之异宜，随时随地，设色布景，否者皆陈言也。","book":"清·周中孚《郑堂札记》卷一"},"example":{"text":"有人向他建议：多招募民间乡勇，分散在宁波、镇海、定海附近，～以小队水陆分扰乱人。","book":"郭沫若《中国史稿》第五编第一章第一节"},"similar":["随地随时"],"usage":"作定语、状语；指时时刻刻"},{"id":46047,"word":"随机应变","pinyin":"suí jī yìng biàn","abbr":"sjyb","explanation":"机：时机，形势。随着情况的变化灵活机动地应付。","source":{"text":"世充日踧月迫，力尽计穷，悬首面缚，翘足可待。建德远来助虐，粮运阻绝，此是天丧之时。请固武牢，屯军氾水，随机应变，则易为克殄。","book":"《旧唐书·郭孝恪传》"},"example":{"text":"总而言之，我们做官，总要～，能屈能伸，才不会吃亏。","book":"清·李宝嘉《官场现形记》第四十五回"},"similar":["见风使舵","见机行事"],"opposite":["一成不变","刻舟求剑"],"usage":"作谓语、宾语、状语；指灵活处理","story":["三国时期，吴国大将鲁肃邀请庞统去见孙权。孙权看见庞统浓眉黑脸，心中不高兴，就问庞统有什么特长。庞统回答说：“何必拘泥于某一项本事，顺应时机的变化而灵活应付而已。”孙权没有看中他，让他退下回家。庞统仰天长叹而回"]},{"id":46048,"word":"随机而变","pinyin":"suí jī ér biàn","abbr":"sjeb","explanation":"随着时机或情况而变化。形容灵活机敏。","source":{"text":"大凡男子，随机而变，不如降他。","book":"《敦煌变文集·韩擒虎活本》"},"similar":["乘机应变","临机应变"],"usage":"作谓语、宾语；用于处事"},{"id":46049,"word":"随波漂流","pinyin":"suí bō piāo liú","abbr":"sbpl","explanation":"随着波浪起伏，跟着流水漂荡。比喻没有坚定的立场，缺乏判断是非的能力，只能随着别人走。","source":{"text":"泥滞苟且，没而不觉，随波漂流，与熛俱灭者亦甚众多。","book":"汉·陈琳《檄吴将校部曲文》"},"example":{"text":"海中遇风，波涛大起，数十日不止。～，不知所届，忽风止波静，至海岸边。","book":"宋·李昉《太平广记》卷四百八十一"},"similar":["随波逐流","随波逐浪","随波逐尘"],"usage":"作谓语、定语、状语；用于人没个性"},{"id":46050,"word":"随波逐尘","pinyin":"suí bō zhú chén","abbr":"sbzc","explanation":"犹言随波逐流。比喻没有坚定的立场，缺乏判断是非的能力，只能随着别人走。","source":{"text":"他是冰清玉润，怎便肯随波逐尘。","book":"明·高明《玉簪记·诳告》"},"similar":["随波逐浪","随波逐流","随波漂流"],"usage":"作谓语、定语、状语；用于人没个性"},{"id":46051,"word":"随波逐流","pinyin":"suí bō zhú liú","abbr":"sbzl","explanation":"逐：追随。随着波浪起伏，跟着流水漂荡。比喻没有坚定的立场，缺乏判断是非的能力，只能随着别人走。","source":{"text":"看风使舵，正是随波逐流。","book":"《史记·屈原贾生列传》：“夫圣人者，不凝滞于物而能与世推移。举世混浊，何不随其流而扬其波？”《五灯会元》"},"example":{"text":"你心胸开阔，气度那么从容！你不～，也不故步自封。","book":"郭沫若《屈原》第一幕"},"similar":["同流合污","见风使舵"],"opposite":["中流砥柱","坚定不移"],"usage":"作谓语、定语、状语；用于人没个性"},{"id":46052,"word":"随波逐浪","pinyin":"suí bō zhú làng","abbr":"sbzl","explanation":"①颠沛的样子。②谓同行同止。③随着波浪飘荡。④犹言随波逐流，随大流。","source":{"text":"七军乱窜，随波逐浪者，不计其数。","book":"①唐·白居易《浪淘沙》词之六：“随波逐浪到天涯，迁客西还有几家。”②元·孟汉卿《魔合罗》第三折：“详察这生分女作歹为非，更和这忤逆男随波逐浪。”③明·罗贯中《三国演义》第七四回"},"example":{"text":"这样没主意、～的人，不打他便打那个？","book":"④清·西周生《醒世姻缘传》第五十三回"},"similar":["随波逐流","随波逐尘","随波漂流"],"usage":"作谓语、定语、状语；用于人没个性"},{"id":46053,"word":"随物应机","pinyin":"suí wù yīng jī","abbr":"swyj","explanation":"顺应事物而机变。","source":{"text":"禅宗论云间有三种语：其一为随波逐浪句，谓随物应机，不主故常。","book":"宋·叶梦得《石林诗话》上卷"},"usage":"作宾语、定语；用于处事"},{"id":46054,"word":"随物赋形","pinyin":"suí wù fù xíng","abbr":"swfx","explanation":"指针对客观事物本身的不同形态给予形象生动的描绘。","source":{"text":"画奔湍巨浪，与山石曲折，随物赋形，尽水之变，号称神逸。","book":"宋·苏轼《画水记》"},"example":{"text":"清·赵翼《瓯北诗话·黄山谷诗》：“东坡～，信笔挥洒，不拘一格。”"},"usage":"作谓语、定语；用于书面语"},{"id":46055,"word":"随珠和璧","pinyin":"suí zhū hé bì","abbr":"szhb","explanation":"随侯珠与和氏璧的并称。泛指珍宝或珍宝中的上品。事见《韩非子·和氏》、《淮南子·览冥训》。","source":{"text":"传说古代随国姬姓诸侯见一大蛇伤断，以药敷之而愈；后蛇于江中衔明月珠以报德，因曰随侯珠，又称灵蛇珠。楚人卞和于荆山得一璞玉，先后献给武王、文王，均以为石，和以欺君罪被砍断两足；成王登位，使人剖璞，果得夜光宝玉，因命之曰和氏璧。"},"example":{"text":"兴造早乙之帐，落以～。","book":"《汉书·西域传赞》"},"similar":["随珠荆玉"],"usage":"作主语、宾语、定语；指珍宝","story":["春秋时珠宝匠卞和发现一块璞玉，进献给楚厉王，楚厉王砍了他的左脚；进献给楚武王，楚武王砍了他的右脚，只有楚文王识货，这块玉叫“和氏璧”。“汉东之国”姓姬的隋侯救蛇，蛇吐出一颗大珍珠报答他，这颗珍珠就是“隋珠”"]},{"id":46056,"word":"随珠弹雀","pinyin":"suí zhū tán què","abbr":"sztq","explanation":"用夜明珠去弹鸟雀。比喻做事不知道衡量轻重，因而得到的补偿不了失去的。","source":{"text":"今且有人于此，以随侯之珠，弹千仞之雀，世必笑之。是何也？以其所用者重，而所要者轻也。","book":"战国·宋·庄周《庄子·让王》"},"example":{"text":"～，堂溪刈葵。","book":"后汉·张安超《讥青衣赋》"},"similar":["明珠弹雀","得不偿失"],"usage":"作谓语；指得不偿失","story":["鲁哀公听说颜阖非常贤明，就派人给他送礼物请他出山。贫穷的颜阖不受。庄子就此事发表感慨，颜阖无意于富贵，富资送上门，他不欢迎。这样的人难得。而那些不惜牺牲生命去追求富贵就如同“以隋侯之珠，弹千仞之雀”一样不值得"]},{"id":46057,"word":"随珠荆玉","pinyin":"suí zhū jīng yù","abbr":"szjy","explanation":"随侯珠与和氏璧的并称。泛指珍宝或珍宝中的上品。同“随珠和璧”。","source":{"text":"随珠荆玉奇士，金匮名山见异书。","book":"清·姚鼐《过程鱼门墓下作》诗"},"similar":["随珠和璧"],"usage":"作主语、宾语、定语；指珍宝"},{"id":46058,"word":"随类相从","pinyin":"suí lèi xiāng cóng","abbr":"slxc","explanation":"指按类归纳。","source":{"text":"又使诸儒撰集经传，随类相从，凡千余篇，号曰皇览。","book":"《三国志·魏志·文帝纪》"}},{"id":46059,"word":"随缘乐助","pinyin":"suí yuán lè zhù","abbr":"sylz","explanation":"随着缘分的深浅，乐意捐助多少就捐助多少。","source":{"text":"这都是随缘乐助，本不能强人的，或多或少，却是未定，总求大人这里踊跃些便是。","book":"清·黄小配《廿载繁华梦》第二十九回"},"usage":"作谓语；用于捐助别人"},{"id":46060,"word":"随者唱喁","pinyin":"suí zhě chàng yáng","abbr":"szcy","explanation":"喁：应和的声音。形容后者附和前者。","source":{"text":"前者唱于，而随者唱喁。","book":"《庄子·齐物论》"},"similar":["随声附和"],"usage":"作谓语、定语；用于书面语"},{"id":46061,"word":"随行就市","pinyin":"suí háng jiù shì","abbr":"shjs","explanation":"指按市场行情行事。","example":{"text":"一般农副产品的购销，可～，灵活经营。"},"usage":"作谓语；指按市场行情交易"},{"id":46062,"word":"随行逐队","pinyin":"suí xíng zhú duì","abbr":"sxzd","explanation":"指跟着大家一道行动。","source":{"text":"众倭公然登岸，少不得放火杀人，杨八老虽然心中不愿，也不免随行逐队。","book":"明·冯梦龙《喻世明言》第十八卷"},"usage":"作谓语、定语；指随众行事"},{"id":46063,"word":"随语生解","pinyin":"suí yǔ shēng jiě","abbr":"sysj","explanation":"随：顺着；语：话；解：解释。指依据一段话或前后文，对某个不懂的概念做出解释。","source":{"text":"僧问：‘如何是佛？’师呵呵大笑。僧曰：‘何哂之有？’师曰：‘笑你随语生解。’","book":"宋·释普济《五灯会元》卷十七"}},{"id":46064,"word":"随踵而至","pinyin":"suí zhǒng ér zhì","abbr":"szez","explanation":"踵：脚后跟。一个跟着一个前来。形容人来得多，接连不断。","source":{"text":"子来，寡人闻之，千里而一士，是比肩而立，百世而一圣，若随踵而至也，今子一朝而见七士，则士不亦众乎！","book":"《战国策·齐策三》"},"similar":["接踵而至"],"usage":"作谓语；形容人来得多"},{"id":46065,"word":"随车夏雨","pinyin":"suí chē xià yǔ","abbr":"scxy","explanation":"比喻官吏施行仁政及时为民解忧。同“随车致雨”。","source":{"text":"赈凶灾则随车夏雨，诚感人穷。","book":"清·钱谦益《陕西道监察史……加赠奉直大夫制》"},"similar":["随车甘雨","随车致雨"],"usage":"作宾语、定语；用于书面语"},{"id":46066,"word":"随车甘雨","pinyin":"suí chē gān yǔ","abbr":"scgy","explanation":"比喻官吏施行仁政及时为民解忧。同“随车致雨”。","source":{"text":"揽辔清风，随车甘雨，免他供顿徒劳。","book":"清·杨潮观《东莱郡暮夜却金》"},"similar":["随车夏雨","随车致雨"],"usage":"作宾语、定语；用于书面语"},{"id":46067,"word":"随车致雨","pinyin":"suí chē zhì yǔ","abbr":"sczy","explanation":"指时雨跟着车子而降。比喻官吏施行仁政及时为民解忧。","source":{"text":"弘消息繇赋，政不烦苛。行春天旱，随车致雨。","book":"《后汉书·郑弘传》：“政有仁惠，民称苏息”李贤注引三国·吴·谢承《后汉书》"},"similar":["随车夏雨","随车甘雨"],"usage":"作定语；用于书面语"},{"id":46068,"word":"随近逐便","pinyin":"suí jìn zhú biàn","abbr":"sjzb","explanation":"指就近，图方便。","source":{"text":"若随近逐便，先向东都，唐袆告之，理当固守。","book":"《隋书·李密传》"},"usage":"作谓语、定语；用于处事"},{"id":46069,"word":"随遇而安","pinyin":"suí yù ér ān","abbr":"syea","explanation":"随：顺从；遇：遭遇。指能顺应环境，在任何境遇中都能满足。","source":{"text":"随寓而安，斯真隐矣。","book":"清·刘献廷《广阳杂记》一"},"example":{"text":"不过能够～——即有船坐船云云——则比起幻想太多的人们来，可以稍为安稳，能够敷衍下去而已。","book":"鲁迅《两地书》六"},"similar":["与世无争","随俗浮沉"],"opposite":["愤时嫉俗","愤愤不平"],"usage":"作谓语、宾语、定语、状语；指能顺应环境"},{"id":46070,"word":"随陆无武，绛灌无文","pinyin":"suí lù wú wǔ，jiàng guàn wú wén","abbr":"slwwjgww","explanation":"随、陆：随何、陆贾，汉高祖时的文官；绛、灌：绛侯周勃，灌婴，汉高祖时的武将。指人才的面片性，能文者不能武，能武者不能文。","source":{"text":"吾每观书传，常鄙随陆无武，绛灌无文。","book":"《晋书·刘元海载记》"},"example":{"text":"我常耻～。随何陆贾绛侯周勃灌婴，皆汉初功臣。","book":"蔡东藩《两晋演义》第四回"}},{"id":46071,"word":"随随便便","pinyin":"suí suí biàn biàn","abbr":"ssbb","explanation":"不多加斟酌，怎么方便就怎么做。","source":{"text":"‘至嘱’者，非常之嘱也，岂容随随便便，置之不顾！","book":"毛泽东《新民主主义的宪政》"},"example":{"text":"所以我们讲‘五十年’，不是～、感情冲动而讲的，是考虑到中国的现实和发展的需要。","book":"邓小平《中国是信守诺言的》"},"similar":["马马虎虎"],"opposite":["认认真真"],"usage":"作谓语、宾语、定语、状语；用于处事"},{"id":46072,"word":"随风倒柳","pinyin":"suí fēng dǎo liǔ","abbr":"sfdl","explanation":"随着风向摇摆的柳枝。形容没有主见。也指观察事势，相机应对。"},{"id":46073,"word":"随风倒舵","pinyin":"suí fēng dǎo duò","abbr":"sfdd","explanation":"犹言看风使舵。比喻顺着情势的发展而转变态度。","source":{"text":"相风使帆第一筹，随风倒舵更何忧。","book":"宋·陆游《醉歌》"},"example":{"text":"则你这媒人一个个，啜人口似蜜钵，都只是～，索媒钱嫌少争多。","book":"元·王晔《桃花女》第二折"},"similar":["随风转舵"],"usage":"作谓语、宾语、定语；指见机行事"},{"id":46074,"word":"随风而靡","pinyin":"suí fēng ér mǐ","abbr":"sfem","explanation":"靡：倒下。顺风倒下。比喻没有主见。","source":{"text":"虽雅知恽者，犹随风而靡，尚何称誉之有？","book":"南朝·梁·萧统《文选·杨恽〈报孙会宗书〉》"}},{"id":46075,"word":"随风转舵","pinyin":"suí fēng zhuǎn duò","abbr":"sfzd","explanation":"随着风向转换舵位。比喻顺着情势改变态度（含贬义）。","source":{"text":"则你这媒人一个个，啜人口似蜜钵，都只是随风倒舵，索媒钱赚少争多。","book":"元·无名氏《桃花女》第二折"},"example":{"text":"眼见得城池不济事了，各人自思～。","book":"明·施耐庵《水浒全传》第九十八回"},"similar":["见风使舵"],"usage":"作谓语、定语；指见机行事"},{"id":46076,"word":"随风逐浪","pinyin":"suí fēng zhú làng","abbr":"sfzl","explanation":"①奔波；颠沛。②犹言随大流。","source":{"text":"随风逐浪年年别，却笑如期八月槎。","book":"唐·吴融《商人》诗"},"example":{"text":"郭沫若《虎符》第四幕：“人不沉着，就如像水上的浮萍，空中的败叶，是只好～的。”"},"similar":["随波逐流"],"usage":"作谓语、定语；用于书面语"},{"id":46077,"word":"随高就低","pinyin":"suí gāo jiù dī","abbr":"sgjd","explanation":"犹言可高可低，随便怎样。","source":{"text":"苦乐共性，随高就低。","book":"宋·释普济《五灯会元·浮山远禅师法嗣·衡岳奉能禅师》"},"example":{"text":"我老孙不去！不去！俗语谓‘赊三不敌见二’，只望你～的送一副便了。","book":"明·吴承恩《西游记》第三回"},"similar":["随高逐低"],"usage":"作谓语、定语；用于处事"},{"id":46078,"word":"随高逐低","pinyin":"suí gāo zhú dī","abbr":"sgzd","explanation":"犹言随高就低。","source":{"text":"那些人家，或老或少，或男或女，或拿根凳子，或掇张椅子，或铺条凉席，随高逐低，坐在下面，摇着扇子，乘着风凉。","book":"《豆棚闲话·介之推火封妒妇》"},"similar":["随高就低"],"usage":"作谓语、定语；用于处事"},{"id":46079,"word":"隐介藏形","pinyin":"yǐn jiè cáng xíng","abbr":"yjcx","explanation":"介：鳞甲。隐藏形体，使人看不见。","source":{"text":"龙能大能小，能升能隐，大则兴云吐雾，小则隐介藏形。","book":"明·罗贯中《三国演义》第二十一回"},"usage":"作谓语；指藏匿"},{"id":46080,"word":"隐占身体","pinyin":"yǐn zhàn shēn tǐ","abbr":"yzst","explanation":"隐藏、掩护自己真面目的意思。"},{"id":46081,"word":"隐名埋姓","pinyin":"yǐn míng mái xìng","abbr":"ymmx","explanation":"隐瞒自己的真实姓名以求不使人知。同“隐姓埋名”。","source":{"text":"离京邑，出凤城，山林中隐名埋姓。","book":"元·李爱山《寿阳曲·厌纷》曲"},"example":{"text":"在商州以西的丛山中选一个险要的地方驻定以后，李自成～，不使外人知道他的行踪。","book":"姚雪垠《李自成》第一卷第十四章"},"similar":["隐姓埋名"],"usage":"作谓语、定语、状语；用于处事"},{"id":46082,"word":"隐君子","pinyin":"yǐn jūn zǐ","abbr":"yjz","explanation":"隐居逃避尘世的人，借指吸毒成瘾或吸烟成瘾的人。","source":{"text":"老子，隐君子也。","book":"西汉·司马迁《史记·老子韩非列传》"},"usage":"作宾语、定语；用于口语"},{"id":46083,"word":"隐天蔽日","pinyin":"yǐn tiān bì rì","abbr":"ytbr","explanation":"把天遮住，把太阳也挡住了。形容覆盖的面积广大。","source":{"text":"自三峡七百里中，两岸连山，略无阙处，重岩叠嶂，隐天蔽日，自非停午夜分，不见曦月。","book":"北魏·郦道元《水经注·江水》"}},{"id":46084,"word":"隐姓埋名","pinyin":"yǐn xìng mái míng","abbr":"yxmm","explanation":"隐瞒自己的真实姓名，不让别人知道。","source":{"text":"着他隐姓埋名，假说做王同知的女儿。","book":"元·张寿卿《红梨花》第四折"},"example":{"text":"如若答应下来，你只好～，从此再别想出头了。","book":"清·石玉昆《三侠五义》第七十九回"},"similar":["遮人耳目"],"opposite":["抛头露面"],"usage":"作谓语、定语、状语；用于人"},{"id":46085,"word":"隐居求志","pinyin":"yǐn jū qiú zhì","abbr":"yjqz","explanation":"隐居不仕，以实现自己的志愿。","source":{"text":"隐居以求其志，行义以达其道。","book":"春秋·鲁·孔丘《论语·季氏》"},"example":{"text":"是他～。是要明主媒当世。","book":"宋·刘克庄《哨遍》"},"usage":"作谓语；指隐士"},{"id":46086,"word":"隐忍不发","pinyin":"yǐn rěn bù fā","abbr":"yrbf","explanation":"隐忍：勉强忍耐，把事情藏在心里。把事情藏在心里不说。","source":{"text":"特以太后之故，隐忍而不发。","book":"宋·秦观《淮海集·石庆论》"},"example":{"text":"清·褚人获《隋唐演义》第89回：“太子心中好不怀恨，只碍着贵妃得宠，右相当朝，他还身处储位，未揽大权，故～。”"},"similar":["隐忍不言"],"usage":"作谓语、定语；把事情藏在心里不说"},{"id":46087,"word":"隐忍不言","pinyin":"yǐn rěn bù yán","abbr":"yrby","explanation":"隐忍：勉强忍耐，把事情藏在心里。把事情藏在心里不说。","source":{"text":"特以太后之故，隐忍而不发。","book":"宋·秦观《淮海集·石庆论》"},"example":{"text":"且有先集之事相求，即受侮嫚，亦为亲屈，欲终～。（清·归庄《与季沧苇侍御书》）"},"similar":["隐忍不发"],"usage":"作谓语、定语；把事情藏在心里不说"},{"id":46088,"word":"隐志相及","pinyin":"yǐn zhì xiāng jí","abbr":"yzxj","explanation":"隐：忧伤；及：至，到。忧痛之心相通。形容互相同情。","source":{"text":"隐志相及，痛疾相救，忧思相感。","book":"《吕氏春秋·精通》"}},{"id":46089,"word":"隐恶扬善","pinyin":"yǐn è yáng shàn","abbr":"yeys","explanation":"隐：隐匿；扬：宣扬。不谈人的坏处，光宣扬人的好处。","source":{"text":"舜好问而好察迩言，隐恶而扬善。","book":"《礼记·中庸》"},"example":{"text":"他和你是同僚官，虽有些过失，你可隐恶而扬善。","book":"明·施耐庵《水浒全传》第三十三回"},"similar":["人弃我取"],"opposite":["红口白牙"],"usage":"作谓语、定语、宾语；用于劝诫人"},{"id":46090,"word":"隐恶扬美","pinyin":"yǐn è yáng měi","abbr":"yeym","explanation":"隐：隐匿；扬：宣扬。不谈人的坏处，只宣扬人的优点和长处。","source":{"text":"所不掩子之恶，扬子之美者，使其身无终没于越国。","book":"《礼记·中庸》：“舜好问而好察迩言，隐恶而扬善。”《国语·越语下》"}},{"id":46091,"word":"隐晦曲折","pinyin":"yǐn huì qū zhé","abbr":"yhqz","explanation":"隐晦：不明显。指写文章或说话时用隐隐约约、转弯抹角的方式来表达某种思想。","source":{"text":"我们可以大声疾呼，而不要隐晦曲折，使人民大众不易看懂。","book":"毛泽东《在延安文艺座谈会上的讲话》"},"example":{"text":"他的文章很～。"},"similar":["转弯抹角"],"opposite":["开门见山","直言不讳"],"usage":"作宾语、定语、补语；指文辞等"},{"id":46092,"word":"隐然敌国","pinyin":"yǐn rán dí guó","abbr":"yrdg","explanation":"敌国：相当于一国。指对国家起举足轻重作用的人。同“隐若敌国”。","source":{"text":"隐然敌国，咸称细柳之真；贤若长城，岂类棘门之戏。","book":"宋·阳枋《谢交割启》"},"similar":["隐若敌国"],"usage":"作定语；指人作用大"},{"id":46093,"word":"隐约其词","pinyin":"yǐn yuē qí cí","abbr":"yyqc","explanation":"指语意隐晦不明或说话躲躲闪闪。亦作“隐约其辞”。","source":{"text":"刁迈彭隐约其词，似乎嫌张太太一个钱不肯放松，这事总不会了。","book":"清·李宝嘉《官场现形记》第51回"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“一方面～地表示，追击李世贤是郭松林的责任。”"},"similar":["隐约其辞","含糊其辞"],"usage":"作谓语、定语；指故意不明说"},{"id":46094,"word":"隐约其辞","pinyin":"yǐn yuē qí cí","abbr":"yyqc","explanation":"隐约：不明显，不清楚。形容说话躲躲闪闪，使人不易完全明白。","source":{"text":"使白太夫人，谓欲礼佛行也者，迎抵会城卒岁，无功为亲者讳，故隐约其辞不尽也。","book":"清·平步青《霞外捃屑·倪文正公与弟献汝二书》"},"example":{"text":"而一到觉得有些危急之际，也还是故意～。","book":"鲁迅《三闲集·我和的始终》"},"similar":["闪烁其辞","支吾其辞"],"opposite":["直言不讳"],"usage":"作谓语、定语；指故意不明说"},{"id":46095,"word":"隐若敌国","pinyin":"yǐn ruò dí guó","abbr":"yrdg","explanation":"隐：威严庄重的样子；若：象；敌：匹敌，同等；敌国：相当于一国。指对国家起举足轻重作用的人。","source":{"text":"吴楚反时，条侯为太尉，乘传车将至河南，得剧孟，喜曰：‘吴楚举大事而不求孟，吾知其无能为已矣。’天下骚动，宰相得之若得一敌国云。","book":"西汉·司马迁《史记·游侠列传》"},"example":{"text":"天地之内，指麾无前，熊威虎力，～。","book":"唐·吕温《凌烟阁勋臣颂》"},"similar":["隐然敌国"],"usage":"作定语；指人作用大"},{"id":46096,"word":"隐迹埋名","pinyin":"yǐn jì mái míng","abbr":"yjmm","explanation":"隐藏行踪、埋没名姓以求不使人知。","source":{"text":"或有山间林下，怀才抱德，隐迹埋名。","book":"元·关汉卿《裴度还带》第二折"},"example":{"text":"元·关汉卿《裴度还带》第二折：“或有山间林下，怀才抱德，隐迹埋名。”"},"similar":["隐迹藏名"],"usage":"作谓语、定语；指隐姓埋名"},{"id":46097,"word":"隐迹潜踪","pinyin":"yǐn jì qián zōng","abbr":"yjqz","explanation":"隐：隐藏；潜：隐藏埋伏。把自己的行踪隐藏起来。","source":{"text":"那妖正与八戒嚷闹，急听得风响，急回头，见是行者落下云来，却又收了宝杖，一头淬下水，隐迹潜踪，渺然不见。","book":"明·吴承恩《西游记》第二十二回"},"example":{"text":"清·无名氏《说呼全传》第九回：“如此则易于破获，以免～之患。”"},"similar":["潜踪隐迹"],"usage":"作谓语、宾语；用于隐居"},{"id":46098,"word":"隐迹藏名","pinyin":"yǐn jì cáng míng","abbr":"yjcm","explanation":"隐藏踪迹，隐瞒住真姓实名。","example":{"text":"他厌烦官场的尔虞我诈，一心向往～的生活。"},"similar":["隐迹埋名"],"usage":"作谓语、定语；指隐姓埋名"},{"id":46099,"word":"隐隐约约","pinyin":"yǐn yǐn yuē yuē","abbr":"yyyy","explanation":"指看起来或听起来模糊，不很清楚，感觉不很明显。","source":{"text":"只见山坡旁隐隐约约，倒象撺出一箭，直向大虫面上射去。","book":"清·李汝珍《镜花缘》第十回"},"example":{"text":"我对老家有～的记忆。"},"similar":["隐隐绰绰"],"usage":"作定语、状语；指模糊不清"},{"id":46100,"word":"隐隐绰绰","pinyin":"yǐn yìn chuò chuò","abbr":"yycc","explanation":"隐隐约约。","source":{"text":"那云气如飞而至，隐隐绰绰。","book":"清·李百川《绿野仙踪》第88回"},"example":{"text":"我看到远处有人～在行动。"},"similar":["影影绰绰","隐隐约约"],"usage":"作定语、状语；指隐隐约约"},{"id":46101,"word":"隐鳞戢羽","pinyin":"yǐn lín jí yǔ","abbr":"yljy","explanation":"比喻贤者隐居待时。同“隐鳞戢翼”。","source":{"text":"古之文人才士，当其隐鳞戢羽，名闻未彰，必有文章钜公，以片言只字定其声价。","book":"清·钱谦益《序》"},"similar":["隐鳞戢翼"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":46102,"word":"隐鳞戢翼","pinyin":"yǐn lín jí yì","abbr":"yljy","explanation":"龙隐匿鳞甲，凤收敛翅膀。比喻贤者隐居待时。","source":{"text":"在昔晦明，隐鳞戢翼。","book":"南朝·梁·任昉《宣德皇后令》"},"similar":["隐鳞戢羽"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":46103,"word":"隐鳞藏彩","pinyin":"yǐn lín cáng cǎi","abbr":"ylcc","explanation":"比喻潜藏起来，等待时机。","source":{"text":"夫龙不隐鳞，凤不藏羽，网罗高悬，去将安所。","book":"南朝·宋·范晔《后汉书·逸民传·陈留老父》"},"example":{"text":"宁～，若渊中之龙乎？","book":"三国·魏·嵇康《卜疑》"},"usage":"作谓语；指待机而动"},{"id":46104,"word":"隔三差五","pinyin":"gé sān chà wǔ","abbr":"gscw","explanation":"比喻时常发生。","source":{"text":"从此我和贾玲隔三差五就要会战一番。","book":"王朔《过把瘾就死》"},"example":{"text":"她～就与他吵架。"},"usage":"作状语；指时常发生"},{"id":46105,"word":"隔世之感","pinyin":"gé shì zhī gǎn","abbr":"gszg","explanation":"世：古代以三十年为一世。指因人事或景物变化大而引起的、象隔了一个时代似的感觉。","source":{"text":"发常州，平江亲戚故旧来相迓者，陆续于道，恍然如隔世焉。","book":"宋·范成大《吴船录下》"},"example":{"text":"仅仅相隔两年，所写的东西，读起来就已经有～了。","book":"郭沫若《洪波曲·后记》"},"similar":["恍如隔世"],"usage":"作定语；指像隔了一个时代似的感觉"},{"id":46106,"word":"隔二偏三","pinyin":"gé èr piān sān","abbr":"geps","explanation":"隔：偏远。比喻不按顺序，没有条理。","source":{"text":"俺爹这两日隔二偏三的也甚没意思，看姐姐恁的依俺们一句话儿，与他爹笑开了罢。","book":"明·兰陵笑笑生《金瓶梅词话》第二十回"}},{"id":46107,"word":"隔墙有耳","pinyin":"gé qiáng yǒu ěr","abbr":"gqye","explanation":"隔着一道墙，也有人偷听。比喻即使秘密商量，别人也可能知道。也用于劝人说话小心，免得泄露。","source":{"text":"墙有耳，伏寇在侧。墙有耳者，微谋外泄之谓也。","book":"《管子·君臣下》"},"example":{"text":"又谁料知己倾谈，忘了～，全灌进了杨子衢的耳中。","book":"清·曾朴《孽海花》第三十三回"},"similar":["隔墙须有耳，窗外岂无人"],"usage":"作宾语、分句；指小心秘密泄漏"},{"id":46108,"word":"隔墙须有耳，窗外岂无人","pinyin":"gé qiáng xū yǒu ěr，chuāng wài qǐ wú rén","abbr":"gqxyecwqwr","explanation":"须：应当。指秘密的言谈也可能泄漏。","source":{"text":"隔墙须有耳，窗外岂无人。这小贱人无理，瞒着老夫，引着梅香去书房中看梁鸿去了。","book":"元·孟德耀《举案齐眉》第二折"},"example":{"text":"那晓得：～。","book":"清·褚人获《隋唐演义》第12回"},"similar":["隔舍须有耳，窗外岂无人"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":46109,"word":"隔壁听话","pinyin":"gé bì tīng huà","abbr":"gbth","explanation":"指大言无实，空有声调，难鲸揽验。","source":{"text":"盖非特文章气节平生所劼力而事者，既于真性不切及所闻于经书师友与意见之所窥测，而自以为道者，亦竟如隔壁听话，全无交涉。","book":"明·唐顺之《答王遵岩书》"},"usage":"作宾语、定语；用于比喻句"},{"id":46110,"word":"隔壁撺椽","pinyin":"gé bì cuān chuán","abbr":"gbcc","explanation":"比喻办不到的、不自量力的事情。同“隔屋撺椽”。","source":{"text":"隔壁撺椽没忖量，更那堪不大量。","book":"《雍煕乐府·点绛唇·妓者嗟怨》"},"similar":["隔屋撺椽"],"usage":"作宾语、定语；用于处事"},{"id":46111,"word":"隔宿之仇","pinyin":"gé sù zhī chóu","abbr":"gszc","explanation":"宿：夜。隔夜的仇怨。","source":{"text":"谁家两口子没有言差语错呀？夫妻们有隔宿之仇么？","book":"清·西周生《醒世姻缘传》第98回"},"usage":"作主语、宾语；用于口语"},{"id":46112,"word":"隔屋撺椽","pinyin":"gé wū cuān chuán","abbr":"gwcc","explanation":"比喻办不到的、不自量力的事情。","source":{"text":"有那等花木瓜长安少年，他每不斟量隔屋撺椽。","book":"元·乔吉《两世姻缘》第一折"},"similar":["隔壁撺椽"],"usage":"作宾语、定语；用于处事"},{"id":46113,"word":"隔山买老牛","pinyin":"gé shān mǎi lǎo niú","abbr":"gsmln","explanation":"比喻人办事冒失，没有弄清情况，就轻易决定。","example":{"text":"你这样草率决定就是～的做法。"},"usage":"作宾语、定语；指人办事冒失"},{"id":46114,"word":"隔岸观火","pinyin":"gé àn guān huǒ","abbr":"gagh","explanation":"隔着河看人家着火。比喻对别人的危难不去求助，在一旁看热闹。","source":{"text":"隔岸红尘忙似火，当轩青嶂冷如冰。","book":"唐·乾康《投谒齐已》"},"example":{"text":"他原是在～呀。","book":"郭沫若《南冠草》第二幕"},"similar":["冷眼旁观","见死不救","袖手旁观"],"opposite":["见义勇为","身临其境"],"usage":"作谓语、宾语、定语；指袖手旁观"},{"id":46115,"word":"隔年皇历","pinyin":"gé nián huáng lì","abbr":"gnhl","explanation":"皇历：原指清朝廷颁发的历书，后泛指历本。隔了一年的黄历。比喻过时的事物或陈旧的经验，在新的情况下已经用不上。","source":{"text":"隔年的皇历，好一本子冷帐，闲着手要捉虱子，没工夫去揭他了。","book":"清·夏敬渠《野叟曝言》第100回"},"example":{"text":"你不要守着这些～。"},"usage":"作宾语、定语；指过时的东西"},{"id":46116,"word":"隔皮断货","pinyin":"gé pí duàn huò","abbr":"gpdh","explanation":"指隔着封皮，判断货物的好坏。比喻凭外部现象推测内部底细。","source":{"text":"不是为他中了举，便说深远。只是那光景儿，我就估出来六七分。兄弟隔皮断货，是最有眼色的。","book":"《歧路灯》第八回"},"usage":"作宾语、定语；用于比喻句"},{"id":46117,"word":"隔窗有耳","pinyin":"gé chuāng yǒu ěr","abbr":"gcye","explanation":"隔着窗有人偷听。指墙外有人偷听，秘密泄漏。","source":{"text":"蝴蝶过墙，隔窗有耳，莲花瓣卸，堕地无踪。","book":"清·蒲松龄《聊斋志异·胭脂》"},"similar":["隔墙有耳","隔墙须有耳窗外岂无人"],"usage":"作宾语、分句；指小心秘密泄漏"},{"id":46118,"word":"隔舍须有耳，窗外岂无人","pinyin":"gé shě xū yǒu ěr，chuāng wài qǐ wú rén","abbr":"gsxyecwqwr","explanation":"须：应当。指秘密的言谈也可能泄漏。","source":{"text":"正是隔舍须有耳，窗外岂无人！公子听得仔细，即心中转道：‘奇怪，难道他主仆多是女人？’","book":"清·褚人获《隋唐演义》第60回"},"example":{"text":"清·褚人获《隋唐演义》第60回：“正是隔舍须有耳，窗外岂无人！公子听得仔细，即心中转道：‘奇怪，难道他主仆多是女人？’”"},"similar":["隔墙须有耳，窗外岂无人"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":46119,"word":"隔行如隔山","pinyin":"gé háng rú gé shān","abbr":"ghrgs","explanation":"指不是本行的人就不懂这一行业的门道。","source":{"text":"参谋长虽然是日本帝国大学毕业，可是隔行如隔山，和土匪们联络便不如小喜。","book":"赵树理《李家庄的变迁》"},"example":{"text":"这就叫～。"},"usage":"作宾语、定语；指不同行业差别大"},{"id":46120,"word":"隔阔相思","pinyin":"gé kuò xiāng sī","abbr":"gkxs","explanation":"隔：距离、间隔；阔：广、大。相隔很遥远，非常想念。","source":{"text":"隔阔相思发于寐寤，相去步武，而趋舍异归。","book":"《后汉书·臧洪传》"}},{"id":46121,"word":"隔雾看花","pinyin":"gé wù kàn huā","abbr":"gwkh","explanation":"隔：间隔。形容老眼昏花，后也比喻对事物看不真切。","source":{"text":"觉白石《念奴娇》、《惜红衣》二词，犹有隔雾看花之恨。","book":"王国维《人间词话》"},"similar":["雾里看花"],"usage":"作宾语、定语；指看不真切"},{"id":46122,"word":"隔靴抓痒","pinyin":"gé xuē zhuā yǎng","abbr":"gxzy","explanation":"比喻说话作文不中肯，不贴切，没有抓住要点。或做事没有抓住关键。同“隔靴搔痒”。","source":{"text":"若也扬眉瞬目，又是鬼弄精魂，更或拈拂敲床，大似隔靴抓痒。","book":"《续景德传灯录·安德子胜禅师》"},"similar":["隔靴搔痒","隔靴爬痒"],"usage":"作谓语、宾语、定语；指人没有抓住关键"},{"id":46123,"word":"隔靴搔痒","pinyin":"gé xuē sāo yǎng","abbr":"gxsy","explanation":"搔：抓。隔着靴子搔痒痒。比喻说话作文不中肯，不贴切，没有抓住要点。或做事没有抓住关键。","source":{"text":"意贵透澈，不可隔靴搔痒。","book":"宋·严羽《沧浪诗语·诗法》"},"example":{"text":"批语家也必须深入生活，否则，～的事情，总是难免的吧！","book":"秦牧《鲜荔枝和干荔枝》"},"similar":["不得要领","劳而无功"],"opposite":["鞭辟入里","一语破的"],"usage":"作谓语、宾语、定语；指人没有抓住关键"},{"id":46124,"word":"隔靴爬痒","pinyin":"gé xuē pá yǎng","abbr":"gxpy","explanation":"比喻说话作文不中肯，不贴切，没有抓住要点。或做事没有抓住关键。同“隔靴搔痒”。","source":{"text":"《朱子语类》云：圣人只是识得性。百家纷纷，只是不识性字。扬子鹘鹘突突，荀子又所谓隔靴爬痒。","book":"清·钱大昭《迩言》卷六"},"similar":["隔靴抓痒","隔靴搔痒"],"usage":"作谓语、宾语、定语；指人没有抓住关键"},{"id":46125,"word":"隙中观斗","pinyin":"xì zhōng guān dòu","abbr":"xzgd","explanation":"隙：门隙，门缝。从门缝中看争斗。比喻不能看到整个情况。","source":{"text":"彼挟其高大以临我，则我常眩乱反复，如隙中之观斗，又乌知胜负之所在？","book":"宋·苏轼《超然台记》"},"usage":"作宾语、定语；用于比喻句"},{"id":46126,"word":"隙大墙坏","pinyin":"xì dà qiáng huài","abbr":"xdqh","explanation":"墙缝大了就要倒。比喻错误不及时纠正，就会造成祸害。","source":{"text":"蠹众而木折，隙大而墙坏。","book":"《商君书·修权》"},"similar":["蠹众木折，隙大墙坏"],"usage":"作宾语、定语；用于劝诫人"},{"id":46127,"word":"隙末凶终","pinyin":"xì mò xiōng zhōng","abbr":"xmxz","explanation":"隙：嫌隙，仇恨；凶：杀人；终、末：最后，结果。指彼此友谊不能始终保持，朋友变成了仇敌。","source":{"text":"张、陈凶其终，萧、朱隙其末，故知全之者鲜矣。","book":"《后汉书·王丹传》"},"example":{"text":"休言婚媾本相亲，～反丧身。","book":"蔡东藩《南北史演义》第十二回"}},{"id":46128,"word":"隙穴之窥","pinyin":"xì xué zhī kuī","abbr":"xxzk","explanation":"比喻执着地努力，最后达到目的。","source":{"text":"掞区区抱蝼蚁之忠，逞隙穴之窥，于康熙五十六年、五十九年、六十年，奏请册立皇太子，疏前后十余上。","book":"清·龚自珍《太仓王中堂奏疏书后》"},"usage":"作宾语；用于书面语"},{"id":46129,"word":"隳肝尝胆","pinyin":"huī gān cháng dǎn","abbr":"hgcd","explanation":"犹言隳肝沥胆。比喻待人忠心耿耿，赤诚无比。","source":{"text":"忠信获戾，古人之言。惟教义之所矜，乃讥嫌之见及。恨不能隳肝尝胆，徇知己以求申。","book":"唐·张九龄《与李让侍御书》"},"similar":["披肝沥胆"],"usage":"作谓语、状语；指非常忠诚"},{"id":46130,"word":"隳肝沥胆","pinyin":"huī gān lì dǎn","abbr":"hgld","explanation":"隳：毁坏；沥：液体往下滴。比喻待人忠心耿耿，赤诚无比。","source":{"text":"宰物者虽朝许之以纶诰，暮许之以专席，厚则厚矣，遽责有隳肝沥胆同厮养之用力，亦难哉！","book":"唐·元稹《上裴度相公书》"},"similar":["赤胆忠心","披肝沥胆"],"usage":"作谓语、定语；指为人处世"},{"id":46131,"word":"隳胆抽肠","pinyin":"huī dǎn chōu cháng","abbr":"hdcc","explanation":"犹言披肝沥胆。表示真心诚意。","source":{"text":"隳，毁。抽，拔也。言尽心也。","book":"《文选·刘孝标〈广绝交论〉》：“鸡人始唱，鹤盖成阴，高门旦开，流水接轸，皆愿摩顶至踵，隳胆抽肠。”吕延济注"},"similar":["沥胆抽肠","披肝沥胆"],"opposite":["虚情假意"],"usage":"作谓语；指人真心实意"},{"id":46132,"word":"隳节败名","pinyin":"huī jié bài míng","abbr":"hjbm","explanation":"隳：毁坏；节：气节。指毁坏气节和名誉。","source":{"text":"隳节败名，祸止汝身。当官而行，将疚我民。","book":"宋·张孝祥《取友铭》"}},{"id":46133,"word":"隳高堙庳","pinyin":"huī gāo yīn bì","abbr":"hgyb","explanation":"隳：毁坏；高：高处，指山陵；堙：堵塞；庳：低处，指池泽。铲去丘陵，填平池沼。指兴修水利，治理水土。","source":{"text":"昔共工欲壅防百川，隳高堙庳，以害天下。","book":"《国语·周语下》"},"example":{"text":"纵令农学遍行，或准古区田法，～，舄卤化为膏泽，然以气有舒惨，收获犹不可齐。","book":"清·章炳麟《代议然否论》"}},{"id":46134,"word":"隽言妙语","pinyin":"jùn yán miào yǔ","abbr":"jymy","explanation":"指才智过人，语言幽默。","example":{"text":"她迷恋他的～。"},"usage":"作谓语、宾语、定语；用于文章等"},{"id":46135,"word":"难上加难","pinyin":"nán shàng jiā nán","abbr":"nsjn","explanation":"难：不容易。形容极端的难度。","source":{"text":"所有上条陈一事，竟是难上加难。","book":"清·李宝嘉《官场现形记》第七回"},"example":{"text":"这件事真是～。"},"similar":["困难重重","难乎其难"],"opposite":["易如反掌"],"usage":"作谓语、定语；指十分困难"},{"id":46136,"word":"难乎为情","pinyin":"nán hū wéi qíng","abbr":"nhwq","explanation":"指情面上过不去。同“难以为情”。","source":{"text":"斯时也，伤春者有难乎为情之怨，寻胜者作无可奈何之歌。","book":"清·蒲松龄《聊斋志异·绛妃》"},"example":{"text":"我自己觉得有点～。","book":"郭沫若《南京印象》"},"similar":["难以为情"],"usage":"作宾语、定语、状语；指不好处理"},{"id":46137,"word":"难乎为继","pinyin":"nán hū wéi jì","abbr":"nhwj","explanation":"难于继续下去。","source":{"text":"孔子曰：‘哀则哀矣，而难为继也。’","book":"《礼记·檀弓上》"},"example":{"text":"现在则相反，除粮食外，每天每人只有五分大洋的油盐柴菜钱，还是～。","book":"毛泽东《井冈山上的斗争》"},"similar":["难以为继"],"usage":"作谓语、分句；指难以继续下去"},{"id":46138,"word":"难乎其难","pinyin":"nán hū qí nán","abbr":"nhqn","explanation":"指非常困难。","source":{"text":"交人必于贫贱交以恩谊，则后日必收其效果；若于富贵时交人，及望富贵照拂，则难乎其难。","book":"清·秋瑾《致秋誉章书》"},"example":{"text":"但一说到办法，就是～。","book":"曾朴《孽海花》第25回"},"similar":["难上加难"],"usage":"作谓语、定语、宾语；指十分困难"},{"id":46139,"word":"难于上天","pinyin":"nán yú shàng tiān","abbr":"nyst","explanation":"比上天还难。形容极其困难，不易实现。","source":{"text":"必若所欲为，危于累卵，难于上天。","book":"汉·枚乘《上书谏吴王》"},"similar":["难于上青天"],"opposite":["轻而易举"],"usage":"作谓语、定语；指十分困难"},{"id":46140,"word":"难于上青天","pinyin":"nán yú shàng qīng tiān","abbr":"nysqt","explanation":"比上天还难。形容极其困难，不易实现。","source":{"text":"蜀道之难，难于上青天！","book":"唐·李白《蜀道难》"},"example":{"text":"艰难的情况，真比‘～’的蜀道还要难。","book":"冯玉祥《我的生活》第35章"},"similar":["难于上天"],"opposite":["轻而易举"],"usage":"作谓语、定语；指十分困难"},{"id":46141,"word":"难于启齿","pinyin":"nán yǐ qǐ chǐ","abbr":"nyqc","explanation":"启齿：开口。话很难说出口。","source":{"text":"欲告庆父，而难于启齿，乃于门外号啕大哭。","book":"明·冯梦龙《东周列国志》第22回"},"example":{"text":"我～，就只好放弃了。"},"similar":["难以启齿"],"usage":"作谓语、定语；指难言之隐"},{"id":46142,"word":"难以为情","pinyin":"nán yǐ wéi qíng","abbr":"nywq","explanation":"指情面上过不去。","source":{"text":"前日是并起并坐，今日是‘大人、卑职’，未免叫不出口，难以为情。","book":"清·李宝嘉《官场现形记》第三十四回"},"example":{"text":"在唐绍怡，也觉得万里迢迢，空手而归，未免～。","book":"高阳《慈禧全传》一○六"},"similar":["难乎为情"],"usage":"作宾语、定语、状语；指不好处理"},{"id":46143,"word":"难以为继","pinyin":"nán yǐ wéi jì","abbr":"nywj","explanation":"难于继续下去。","source":{"text":"孔子曰：‘哀则哀矣，而难为继也。’","book":"西汉·戴圣《礼记·檀弓上》"},"example":{"text":"这确是～的状态，确实到了不能容忍的地步，人民不能容忍，我们党也不能容忍。","book":"邓小平《精简机构是一场革命》"},"similar":["难乎为继"],"usage":"作谓语、分句；指难以继续下去"},{"id":46144,"word":"难以为颜","pinyin":"nán yǐ wéi yán","abbr":"nywy","explanation":"颜：脸面。指非常难为情，不好意思。","source":{"text":"季孟尝折愧子阳而不受其爵，今更共陆陆，欲往附之，将难为颜乎？","book":"《后汉书·马援传》"}},{"id":46145,"word":"难以启齿","pinyin":"nán yǐ qǐ chǐ","abbr":"nyqc","explanation":"启齿：开口。话很难说出口。","source":{"text":"欲告庆父，而难于启齿，乃于门外号啕大哭。","book":"明·冯梦龙《东周列国志》第二十二回"},"example":{"text":"大家也都如此主张。难的是这话由谁去说？谁也～。","book":"高阳《慈禧全传》三十八"},"similar":["难于启齿"],"usage":"作谓语、定语；指难言之隐"},{"id":46146,"word":"难以忘怀","pinyin":"nán yǐ wàng huái","abbr":"nywh","explanation":"忘怀：忘记。形容记忆深刻，不容易忘掉。"},{"id":46147,"word":"难以挽回","pinyin":"nán yǐ wǎn huí","abbr":"nywh","explanation":"形容事情到了绝境，无法挽救。","example":{"text":"是否可以为争夺智亭山过多地调动白羊店守军的兵力呢？一步棋走错就会造成～的失算。","book":"姚雪垠《李自成》第二卷第十三章"}},{"id":46148,"word":"难以理喻","pinyin":"nán yǐ lǐ yù","abbr":"nyly","explanation":"喻：明白；理：道理。很难用道理去说明。","source":{"text":"此辈不可理喻，亦不足深诘也。","book":"明·沈德符《万历野获编·褐盖》"},"example":{"text":"她审视自己的内心，越是剖析它便越是觉得它～。","book":"张抗抗《隐形伴侣》第四十五章"}},{"id":46149,"word":"难以置信","pinyin":"nán yǐ zhì xìn","abbr":"nyzx","explanation":"不容易相信。","source":{"text":"当真把我的名字牵连到这个不名誉的嫌疑上面，一时实在令人难以置信。","book":"马克·吐温《竞选州长》"},"example":{"text":"这件事情真是让人～。"},"opposite":["确信无疑"],"usage":"作谓语；用于惊讶的场合"},{"id":46150,"word":"难以逆料","pinyin":"nán yǐ nì liào","abbr":"nynl","explanation":"逆：预先；料：料想。很难事先料到。","source":{"text":"凡事如是，难以逆料。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"三国·蜀·诸葛亮《后出师表》：“凡事如是，难以逆料。”"},"similar":["难以预料"],"usage":"作谓语、定语；指不能预料"},{"id":46151,"word":"难以预料","pinyin":"nán yǐ yù liào","abbr":"nyyl","explanation":"预：预先；料：料想，估计。很难预先想到。","source":{"text":"凡事如是，难以逆料。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"我们碰到了一个～的问题"},"similar":["意料不到"],"usage":"作谓语、定语；用于处事"},{"id":46152,"word":"难伸之隐","pinyin":"nán shēn zhī yǐn","abbr":"nszy","explanation":"隐：隐衷，隐情。隐藏在内心深处难以说出口的隐衷。","source":{"text":"姑娘也就难免有难伸之隐。","book":"清·文康《儿女英雄传》第33回"},"similar":["难言之隐"],"usage":"作宾语；指人的苦衷"},{"id":46153,"word":"难作于易","pinyin":"nán zuò yú yì","abbr":"nzyy","explanation":"难：难事。指难事要从简易的地方做起。","source":{"text":"天下之难，必作于易；天下之大，必作于细。是以圣人终不为大，故能成其大。","book":"《老子》第六十三章"}},{"id":46154,"word":"难兄难弟","pinyin":"nàn xiōng nàn dì","abbr":"nxnd","explanation":"指共过患难的人或彼此处于同样困境的人。","source":{"text":"难兄难弟俱白发相逢异乡。无风无雨未黄花不似重阳。","book":"元·张可久《折桂令·湖上饮别》曲"},"example":{"text":"方玉桦一言未发，但看得出她也有点激动，她显然记起他们是一九五七年的～。","book":"郑义《迷雾》"},"similar":["一丘之貉","患难之交"],"opposite":["反目成仇","恩断义绝"],"usage":"作主语、宾语、定语；形容两兄弟都好","story":["东汉时期，颖川县官陈寔廉洁奉公，百姓十分爱戴。他的大儿子元方与小儿子季方也有很高的德行，被朝廷重用，他们的头像被挂在城墙上成为百姓学习的典范。他的孙子们问他们的父亲谁的功德高，陈寔说：“元方难为兄，季方难为弟。”"]},{"id":46155,"word":"难分难舍","pinyin":"nán fēn nán shě","abbr":"nfns","explanation":"分：分离；舍：放下。形容感情很好，不愿分开。亦作“难舍难分。”。","source":{"text":"难舍难分，所以一直就在船上打了‘水公馆’。","book":"清·李宝嘉《官场现形记》"},"example":{"text":"只是在不久以前，他被调到工程局担任总工程师的时候，两人才～地分了手。","book":"杜鹏程《在和平的日子里》第二章"},"similar":["难解难分","依依不舍","难舍难分"],"opposite":["一刀两断","绝裾而去"],"usage":"作谓语、宾语；形容双方感情很好"},{"id":46156,"word":"难分难解","pinyin":"nán fēn nán jiě","abbr":"nfnj","explanation":"指双方争吵、斗争、比赛等相持不下，难以分开。有时也形容双方关系十分亲密，分不开。","source":{"text":"一员将使五股托天叉；一员将使八楞熟铜锤；一员将使五爪烂银抓；三将大战，杀得难解难分。","book":"明·许仲琳《封神演义》第六十九回"},"example":{"text":"这盘棋，两人杀得～，不分高下。"},"similar":["难解难分"],"opposite":["互不相干"],"usage":"作谓语、定语；比喻双方感情很好"},{"id":46157,"word":"难割难分","pinyin":"nán gē nán fēn","abbr":"ngnf","explanation":"形容关系密切，感情融洽，难以取舍。","source":{"text":"次日，探春将要起身，又来辞宝玉。宝玉自然难割难分。","book":"清·曹雪芹《红楼梦》第102回"},"similar":["难舍难分","难解难分"],"opposite":["一刀两断","绝裾而去"],"usage":"作谓语、定语、宾语；指感情深厚"},{"id":46158,"word":"难割难舍","pinyin":"nán gē nán shě","abbr":"ngns","explanation":"形容彼此关系密切，不忍分离。","example":{"text":"我不忍心看到她那～的样子。"},"similar":["难分难舍"],"opposite":["忍痛割爱"],"usage":"作谓语、定语；指关系密切"},{"id":46159,"word":"难如登天","pinyin":"nán rú dēng tiān","abbr":"nrdt","explanation":"形容难办的事。","example":{"text":"要这个守财奴募捐，那真是～。"},"opposite":["易如反掌"],"usage":"作谓语、定语；用于比喻句"},{"id":46160,"word":"难弟难兄","pinyin":"nán dì nán xiōng","abbr":"ndnx","explanation":"形容两兄弟都好，难分上下。现也反用，讽刺两兄弟都坏。同“难兄难弟”。","source":{"text":"太室之胜山内藏，少室之奇山外仰。难弟难兄孰相让。","book":"清·魏源《二室行》"},"similar":["难兄难弟"],"usage":"作主语、宾语、定语；形容两兄弟都好"},{"id":46161,"word":"难得糊涂","pinyin":"nán dé hú tú","abbr":"ndht","explanation":"指人在该装糊涂的时候难得糊涂。","example":{"text":"人生在世，难得糊涂。"},"similar":["糊涂难得"],"opposite":["糊涂一世"],"usage":"作谓语、定语；用于人","story":["清朝乾隆年间，画家郑板桥中了进士，做了山东范县县令。寡妇朱月姣告状说魏善人欺侮她，魏善人说她借了银子想赖帐。郑板桥马上明白其中原委，就装糊涂判魏善人赢，迫使他赔偿她二十两银子，从此郑板桥就有“难得糊涂官”的美称"]},{"id":46162,"word":"难得者时，易失者机","pinyin":"nán dé zhě shí，yì shī zhě jī","abbr":"ndzsyszj","explanation":"难：困难；时：时间；机：机会。难得的是时间，容易失去的是机会。军事上指要抓住战机。","source":{"text":"难得者时，易失者机，迅而行之，速哉。","book":"明·揭喧《兵经百篇》"}},{"id":46163,"word":"难易相成","pinyin":"nán yì xiāng chéng","abbr":"nyxc","explanation":"成：变化。指难和易是相互转化的。","source":{"text":"故有无相生，难易相成，长短相形，高下相倾，音声相和，前后相随。","book":"《老子》第二章"}},{"id":46164,"word":"难更仆数","pinyin":"nán gēng pú shǔ","abbr":"ngps","explanation":"原意是儒行很多，一下子说不完，一件一件说就需要很长时间，即使中间换了人也未必能说完。后形容人或事物很多，数也数不过来。","source":{"text":"遽数之不能终其物，悉数之乃留，更仆未可终也。","book":"西汉·戴圣《礼记·儒行》"},"example":{"text":"告贷之方，～，散借于凡民，则苦其零星散集。","book":"清·马建忠《适可斋纪言》第一卷"},"similar":["数不胜数"],"usage":"作补语、定语；形容人或事物很多"},{"id":46165,"word":"难素之学","pinyin":"nán sù zhī xué","abbr":"nszx","explanation":"难：《难经》；素：《素问》。原指研究《难经》和《素问》。后用作医书的代称。","source":{"text":"精于医，贯穿难素之学。","book":"《金史·张丛正传》"}},{"id":46166,"word":"难者不会，会者不难","pinyin":"nán zhě bù huì，huì zhě bù nán","abbr":"nzbhhzbn","explanation":"害怕难的人学不会，会做的人不感到难。","source":{"text":"这个就叫做难者不会，会者不难了。我如明明的来伙你去骗人，你又怎能知道我伙人来骗你呢？","book":"清·王濬卿《冷眼观》第十二回"}},{"id":46167,"word":"难能可贵","pinyin":"nán néng kě guì","abbr":"nnkg","explanation":"难能：极难做到。指不容易做到的事居然能做到，非常可贵。","source":{"text":"子路之勇，子贡之辩，冉有之智，此三子者，皆天下之所谓难能而可贵者也。","book":"宋·苏轼《荀卿论》"},"example":{"text":"乃墨子于小故一条已能如此，是亦～矣。","book":"章炳麟《诸子学略说》"},"opposite":["不足为奇"],"usage":"作宾语、定语；指不易做到的事"},{"id":46168,"word":"难舍难分","pinyin":"nán shě nán fēn","abbr":"nsnf","explanation":"舍：放下。形容感情很好，不愿分离。亦作“难分难舍。”。","source":{"text":"这样难舍难分的洒泪而别。","book":"老舍《老张的哲学》"},"example":{"text":"他们真是有点～的。"},"similar":["难分难舍","依依不舍","难舍难离"],"opposite":["一刀两断"],"usage":"作谓语、定语、宾语；指感情深厚"},{"id":46169,"word":"难舍难离","pinyin":"nán shě nán lí","abbr":"nsnl","explanation":"形容相互感情很深，不忍分离。","example":{"text":"他们两人感情十分深厚，～。"},"similar":["难分难舍"],"usage":"作谓语、定语；指双方感情深"},{"id":46170,"word":"难解之谜","pinyin":"nán jiě zhī mí","abbr":"njzm","explanation":"难以捉摸的事物，尤指微妙、难以理解或不易觉察、不易探索的事物。","example":{"text":"世界七大奇观真是～。"},"similar":["不解之谜"],"usage":"作主语、宾语；指难以捉摸的事物"},{"id":46171,"word":"难解难分","pinyin":"nán jiě nán fēn","abbr":"njnf","explanation":"指双方争吵、斗争、比赛等相持不下，难以分开。有时也形容双方关系十分亲密，分不开。","source":{"text":"一员将使五股托天叉；一员将使八楞熟铜锤；一员将使五爪烂银抓；三将大战，杀得难解难分。","book":"明·许仲琳《封神演义》第六十九回"},"example":{"text":"这盘棋，两人杀得～，不分高下。"},"similar":["难舍难分","相持不下"],"opposite":["一刀两断"],"usage":"作谓语、定语；比喻双方感情很好"},{"id":46172,"word":"难言之隐","pinyin":"nán yán zhī yǐn","abbr":"nyzy","explanation":"隐：隐情，藏在内心深处的事。隐藏在内心深处不便说出口的原因或事情。","source":{"text":"钱氏少为党魁，晚托禅悦，生平颇多壹郁难言之隐。","book":"清·钱谦益《钱牧斋尺牍·跋留庵》"},"example":{"text":"总觉得无论何等人家，他那家庭之中，总有许多～的。","book":"清·吴趼人《二十年目睹之怪现状》第七十七回"},"similar":["难以启齿","不可告人","秘而不宣"],"opposite":["公布于众","开诚布公"],"usage":"作宾语；指人的苦衷"},{"id":46173,"word":"难言兰臭","pinyin":"nán yán lán xiù","abbr":"nylc","explanation":"难言：谈不上；兰：兰花；臭：味；兰臭：指气味相投的友谊。指很难结下友情。","source":{"text":"二人同心，其利断金，同心之言，其臭如兰。","book":"《周易·系辞上》"},"example":{"text":"只因这一番，有分数教：师生有情意再缔丝萝；朋友各分张～。","book":"清·吴敬梓《儒林外史》第十九回"},"usage":"作宾语、定语；用于书面语"},{"id":46174,"word":"难进易退","pinyin":"nán jìn yì tuì","abbr":"njyt","explanation":"意思是做官前要再三考虑，去官时唯恐不速。","source":{"text":"其难进而易退也，粥粥若无能也。","book":"西汉·戴圣《礼记·儒行》"},"example":{"text":"在亲闱喜少惧多之日，实人子～之时。","book":"清·袁枚《上尹制府乞病启》"},"usage":"作宾语、定语；用于劝诫人"},{"id":46175,"word":"难逢难遇","pinyin":"nán féng nán yù","abbr":"nfny","explanation":"指很少能遇见的人和事。","source":{"text":"光前艳后，难遇难逢；进退去来，希闻希见。两人俱起舞，共劝下官。","book":"唐·张文成《游仙窟》"},"example":{"text":"我闻京师景致比别处不同，何不闲看一遭，也是～之事。","book":"明·冯梦龙《喻世明言》卷二十六"}},{"id":46176,"word":"难遇难逢","pinyin":"nán yù nán féng","abbr":"nynf","explanation":"指很少能遇见的人和事。","source":{"text":"光前艳后，难遇难逢；进退去来，希闻希见。两人俱起舞，共劝下官。","book":"唐·张文成《游仙窟》"}},{"id":46177,"word":"难鸣孤掌","pinyin":"nán míng gū zhǎng","abbr":"nmgz","explanation":"比喻力量单薄，难以成事。","source":{"text":"在朝非守正不阿之臣，思兴利除害，奈随声附和者，讥不识时，则一薛居洲难鸣孤掌。","book":"清·平步青《霞外捃屑·时事·刘庸夫》"},"similar":["孤掌难鸣"],"usage":"作谓语、宾语、定语；用于势力单薄"},{"id":46178,"word":"雀儿肠肚","pinyin":"què ér cháng dù","abbr":"qecd","explanation":"雀儿：麻雀；肚：胃。形容人气量很小。","source":{"text":"曹武肃王密奏曰：‘孟昶王蜀三十年，而蜀道千余里，请擒孟氏而赦其臣以防变。’太祖批其后曰：‘你好雀儿肠肚。’","book":"宋·陈师道《后山谈丛》"}},{"id":46179,"word":"雀喧鸠聚","pinyin":"què xuān jiū jù","abbr":"qxjj","explanation":"形容纷乱吵闹。","source":{"text":"雀喧鸠聚亦汹汹，寂寞秋江愧卧龙。","book":"清·钱谦益《依韵答江上李贯之》诗"},"example":{"text":"清·钱谦益《依韵答江上李贯之》诗：“～亦汹汹，寂寞秋江愧卧龙。”"},"usage":"作主语、定语；用于喧闹场面"},{"id":46180,"word":"雀小脏全","pinyin":"què xiǎo zàng quán","abbr":"qxzq","explanation":"比喻事物体积或规模虽小，具备的内容却很齐全。","example":{"text":"～的事物司空见惯。"},"similar":["麻雀虽小，五脏俱全"],"usage":"作宾语、定语；用于小而全的机构"},{"id":46181,"word":"雀屏中选","pinyin":"què píng zhòng xuǎn","abbr":"qpzx","explanation":"雀屏：画有孔雀的门屏。指得选为女婿。","source":{"text":"乃于门屏画二孔雀，诸公子有求婚者，辄与两箭射之，潜约中目者许之。前后数十辈莫能中。高祖后至，两发各中一目。毅大悦，遂归于我帝。","book":"《旧唐书·高祖窦皇后传》"},"similar":["锦屏射雀"],"usage":"作宾语、定语；指选为女婿","story":["唐朝时期，窦融觉得女儿才貌双全，不能轻易许给平庸之辈，得嫁一个真正的贤人。于是他在门屏上画两个孔雀，表示谁能同时两箭射中两孔雀的眼睛就将女儿嫁给他。很多公子都去射箭比武，可惜都不能如愿。唐高祖一箭射两目而娶得她"]},{"id":46182,"word":"雀目鼠步","pinyin":"què mù shǔ bù","abbr":"qmsb","explanation":"比喻惶恐之极。"},{"id":46183,"word":"雀角之忿","pinyin":"què jiǎo zhī fèn","abbr":"qjzf","explanation":"指雀和鼠都能毁人们的房子，就如同打官司一样。比喻打官司带来的烦恼。","source":{"text":"谁谓雀无角，何以穿我屋？谁谓女无家，何以速我狱。","book":"《诗经·召南·行露》"},"example":{"text":"山村豪气，偶因鹅鸭之争，指起～。","book":"清·蒲松龄《聊斋志异·冤狱》"},"usage":"作宾语；指打官司带来的烦恼"},{"id":46184,"word":"雀角鼠牙","pinyin":"què jiǎo shǔ yá","abbr":"qjsy","explanation":"雀、鼠：比喻强暴者。原指强逼女子成婚而引起的争讼。后泛指狱讼，争吵。","source":{"text":"谁谓雀无角，何以穿我屋？……谁谓鼠无牙，何以穿我墉？","book":"《诗经·召南·行露》"},"example":{"text":"去害马以安驯良，泯～之衅，绝狼吞虎噬之端，不惊不扰，民得宽然，各尽地力。","book":"清·魏秀仁《花月痕》第五十回"},"similar":["鼠牙雀角","鼠雀之牙"],"usage":"作宾语、定语；泛指狱讼"},{"id":46185,"word":"雀跃欢呼","pinyin":"què yuè huān hū","abbr":"qyhh","explanation":"高兴得像麻雀那样跳跃起来。形容十分欢乐的情景。"},{"id":46186,"word":"雀马鱼龙","pinyin":"què mǎ yú lóng","abbr":"qmyl","explanation":"泛指珍禽异兽。","source":{"text":"自是之后，明珠、文甲、通犀、翠羽之珍盈于后宫，蒲梢、龙文、鱼目、汗血之马充于黄门，钜象、师子、猛犬、大雀之群食于外囿。殊方异物，四面而至。","book":"语出《汉书·西域传赞》"},"example":{"text":"宋·秦观《望海潮》：“纹锦制帆，明珠溅雨，宁论～。”"},"usage":"作宾语、定语；用于书面语"},{"id":46187,"word":"雀鼠之争","pinyin":"què shǔ zhī zhēng","abbr":"qszz","explanation":"指强暴侵凌引起的争讼。","source":{"text":"谁谓雀无角，何以穿我屋？……谁谓鼠无牙，何以穿我墉。","book":"《诗·召南·行露》"},"usage":"作宾语；用于书面语"},{"id":46188,"word":"雁南燕北","pinyin":"yàn nán yàn běi","abbr":"ynyb","explanation":"比喻两地分离。","source":{"text":"几载飘零逐转蓬，年来多难与兄同。雁南燕北分飞久，蓦地相逢似梦中。","book":"《说岳全传》第三四回"},"usage":"作宾语、定语；用于书面语"},{"id":46189,"word":"雁去鱼来","pinyin":"yàn qù yú lái","abbr":"yqyl","explanation":"书信往来。雁、鱼均喻书信。","source":{"text":"莺煎燕聒惹相思，雁去鱼来传恨词。","book":"元·汤式《湘妃引·有所赠》曲"},"usage":"作宾语、定语；用于书面语"},{"id":46190,"word":"雁塔名标","pinyin":"yàn tǎ míng biāo","abbr":"ytmb","explanation":"雁塔：西安慈恩寺内的大雁塔，唐代进士多题姓名于塔下。在大雁塔内标名。旧时考中进士的代称。","source":{"text":"进士题名，自神龙之后，过关宴后，率皆期集于慈恩塔下题名。","book":"五代·王定保《唐摭言》卷三"},"example":{"text":"伴旌旗日暖龙蛇动，看宫殿风微燕雀高，～。","book":"元·关汉卿《裴度还带》第三折"}},{"id":46191,"word":"雁塔新题","pinyin":"yàn tǎ xīn tí","abbr":"ytxt","explanation":"旧时考中进士的代称。同“雁塔题名”。","source":{"text":"雁塔新题墨未干，去年灯火向秋阑。","book":"宋·林光朝《次韵奉酬赵校子直》"},"similar":["雁塔题名"],"usage":"作谓语、定语；指中进士"},{"id":46192,"word":"雁塔题名","pinyin":"yàn tǎ tí míng","abbr":"yttm","explanation":"餍塔：西安慈恩寺内的大雁塔。在大雁塔内题名。旧时考中进士的代称。","source":{"text":"进士题名，自神龙之后，过关宴后，率皆期集于慈恩塔下题名。","book":"五代·王定保《唐摭言》卷三"},"example":{"text":"第一件事是劝你女婿读书上进，早早的～。","book":"清·文康《儿女英雄传》第十二回"},"similar":["雁塔新题","金榜题名"],"opposite":["名落孙山"],"usage":"作谓语、定语、宾语；指中进士"},{"id":46193,"word":"雁塔高标","pinyin":"yàn tǎ gāo biāo","abbr":"ytgb","explanation":"雁塔：西安慈恩寺内的大雁塔，唐代进士多题姓名于塔下。在大雁塔内标名。旧时考中进士的代称。","source":{"text":"进士题名，自神龙之后，过关宴后，率皆期集于慈恩塔下题名。","book":"五代·王定保《唐摭言》卷三"}},{"id":46194,"word":"雁序之情","pinyin":"yàn xù zhī qíng","abbr":"yxzq","explanation":"雁序：指雁飞时有序的行列，引申为兄弟。比喻兄弟之情。","source":{"text":"以涯执相权，遂跨蹇驴至京师索米，僦舍经三十余日，始得一见涯于门屏，所望不过一簿尉耳。涯潦倒无雁序之情。","book":"唐·苏鹗《杜阳杂记》卷中"}},{"id":46195,"word":"雁归湖滨，鸡落草棚","pinyin":"yàn guī hú bīn，jī luò cǎo péng","abbr":"yghbjlcp","explanation":"比喻各有特点，各有各的生活习惯和归宿。也比喻有志气的人四海为家，没志气的人只能生活在自己的小家庭里，无所作为。"},{"id":46196,"word":"雁影分飞","pinyin":"yàn yǐng fēn fēi","abbr":"yyff","explanation":"比喻两相分离。","source":{"text":"甚而雁影纷飞，涕空沾于荆树，鸾胶再觅，变遂起于芦花。","book":"清·蒲松龄《聊斋志异·马介甫》"},"usage":"作谓语；用于夫妻或情侣等"},{"id":46197,"word":"雁断鱼沉","pinyin":"yàn duàn yú chén","abbr":"ydyc","explanation":"比喻彼此音讯断绝。同“雁逝鱼沉”。","source":{"text":"雁断鱼沉，久隔音尘，此后相思两地分。","book":"清·湘灵子《轩亭冤·哭墓》"},"similar":["雁杳鱼沉","雁逝鱼沉"],"usage":"作谓语、定语；比喻彼此音讯断绝"},{"id":46198,"word":"雁杳鱼沉","pinyin":"yàn yǎo yú chén","abbr":"yyyc","explanation":"比喻音信断绝。","source":{"text":"想人生最苦离别，雁杳鱼沉，信断音绝。","book":"元·刘廷信《折桂令·忆别》"},"example":{"text":"你如何，～少定踪。","book":"清·陈瑞生《再生缘》第22回"},"similar":["信断音绝","雁断鱼沉","雁逝鱼沉"],"usage":"作谓语、定语；比喻彼此音讯断绝"},{"id":46199,"word":"雁泊人户","pinyin":"yàn bó rén hù","abbr":"ybrh","explanation":"犹雁户。"},{"id":46200,"word":"雁素鱼笺","pinyin":"yàn sù yú jiān","abbr":"ysyj","explanation":"指书信。","source":{"text":"雁素鱼笺，离愁满怀谁与传。","book":"明·邵璨《香囊记·途叙》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":46201,"word":"雁行折翼","pinyin":"yàn háng zhé yì","abbr":"yhzy","explanation":"雁行：指雁飞时有序的行列，引申为兄弟。比喻兄弟的死亡。","example":{"text":"大内飞头难解恨，～最伤心。","book":"梁羽生《江湖三女侠》第四十七回"}},{"id":46202,"word":"雁行有序","pinyin":"yàn háng yǒu xù","abbr":"yhyx","explanation":"雁行：指雁飞时有序的行列，引申为兄弟。指兄长弟幼，年龄有序，如同雁之依行而有次序。","source":{"text":"典职杨乔纠羊柔曰：柔知丞郎，雁行有序。","book":"《诗经·郑风·大叔于田》：“两服上襄，两骖雁行。”《礼记·王制》：“父之齿，随行，兄之齿，雁行。”汉·应劭《汉官仪》"},"example":{"text":"今功臣名将，～。","book":"南朝·梁·丘迟《与陈伯之书》"}},{"id":46203,"word":"雁行鱼贯","pinyin":"yàn háng yú guàn","abbr":"yhyg","explanation":"雁行：像雁飞时排成有序的行列；鱼贯：像游鱼一个挨着一个地连着。形容许多人排成行列有秩序地行进或做某种动作。","source":{"text":"昔《尚书》记言，《春秋》记事，以日月为远近，年世为前后；用使阅之者，雁行鱼贯，皎然可寻。","book":"唐·刘知己《史通·内篇》"},"example":{"text":"水上第一队、第五队，岸上第二队、第六队，从火光中～而进，一齐会集陈家港口。","book":"清·俞万春《荡寇志》第一百二十一回"}},{"id":46204,"word":"雁足传书","pinyin":"yàn zú chuán shū","abbr":"yzcs","explanation":"雁：大雁；书：书信。大雁能传递书信。","source":{"text":"天子射上林中，得雁，足有系帛书，言武等在某泽中。","book":"《汉书·苏武传》"},"example":{"text":"人言～，待尽写、相思寄与。又怎生、说得愁肠，千丝万缕。","book":"宋·袁去华《宴清都》词"}},{"id":46205,"word":"雁足留书","pinyin":"yàn zú liú shū","abbr":"yzls","explanation":"雁：大雁；书：书信。大雁能传递书信。","source":{"text":"天子射上林中，得雁，足有系帛书，言武等在某泽中。","book":"《汉书·苏武传》"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，苏武出使西域匈奴，被匈奴扣下。汉昭帝与匈奴和亲，要求放回苏武等，匈奴假称苏武已死。汉使又到匈奴，常惠买通守卫趁夜与汉使见面。汉使与单于见面说天子在上林打猎，得到苏武在大雁腿上留下的书信，单于不得不承认苏武等还活着"]},{"id":46206,"word":"雁过拔毛","pinyin":"yàn guò bá máo","abbr":"ygbm","explanation":"大雁飞过时也能拔下毛来。原形容武艺高超。后比喻人爱占便宜，见有好处就要乘机捞一把。","source":{"text":"话虽如此，他既没那‘雁过拔毛’的本事，就该悄悄儿走。","book":"清·文康《儿女英雄传》第31回"},"example":{"text":"那武装部长是位‘～’的主儿，谁想从他底下去当兵。","book":"李存葆《山中，那十九座坟茔》"},"similar":["尖酸刻薄","贪得无厌","唯利是图"],"opposite":["廉洁奉公","两袖清风","一尘不染"],"usage":"作谓语、宾语、定语；指趁机捞一把"},{"id":46207,"word":"雁过拨毛","pinyin":"yàn guò bō máo","abbr":"ygbm","explanation":"①比喻武艺高强。②比喻经手办事便捞点好处。","source":{"text":"他既没那‘雁过拨毛’的本事，就该悄悄儿走，怎么好好儿的把人家拆了个稀烂。","book":"《儿女英雄传》第三一回"},"example":{"text":"村里明白人清楚，那武装部长是位‘～’的主儿，谁想从他底下当兵，不给他送点礼，那是门也没有。","book":"李存葆《山中，那十九座坟茔》"}},{"id":46208,"word":"雁过留声","pinyin":"yàn guò liú shēng","abbr":"ygls","explanation":"比喻留名声于身后。","source":{"text":"见被你冷落了潇湘暮景，更打动我边塞离情。还说甚雁过留声，那堪更瑶阶夜永，嫌杀月儿明！","book":"元·马致远《汉宫秋》第四折"},"example":{"text":"我也闹了一辈子，人过留名，～，算是这么件事。老弟，你瞧着行得行不得？","book":"清·文康《儿女英雄传》第三十二回"}},{"id":46209,"word":"雁过长空","pinyin":"yàn guò cháng kōng","abbr":"ygck","explanation":"大雁在高空飞过，没有留下痕迹。比喻往事已过，旧影难寻。","source":{"text":"僧问：‘雁过长空，影沉寒水。雁无遗踪之意，水无沉影之心。还端的也无？’师曰：‘芦花两岸雪，江水一天秋。’","book":"宋·释普济《五灯会元》卷十四"},"example":{"text":"数年后稍稍闻之，亦如～，影沉秋水矣。","book":"清·纪昀《阅微草堂笔记·滦阳续录》"}},{"id":46210,"word":"雁逝鱼沉","pinyin":"yàn shì yú chén","abbr":"ysyc","explanation":"比喻彼此音讯断绝。亦作“雁断鱼沉”。","source":{"text":"山高水阔，难追二国之欢；雁逝鱼沉，久绝八行之赐。","book":"《旧五代史·唐书·李袭吉传》"},"similar":["雁杳鱼沉","雁断鱼沉"],"usage":"作谓语、定语；比喻彼此音讯断绝"},{"id":46211,"word":"雁默先烹","pinyin":"yàn mò xiān pēng","abbr":"ymxp","explanation":"比喻无才者先被淘汰。","source":{"text":"夫子出于山，舍于故人之家。故人喜，命竖子杀雁而烹之。竖子请曰：‘其一能鸣，其一不能鸣，请奚杀？’主人曰：‘杀不能鸣者。’","book":"战国·宋·庄周《庄子·山木》"},"example":{"text":"膏明自爇缘多事，～为不才。","book":"唐·白居易《岁暮》诗"},"usage":"作谓语、定语、宾语；指自然竞争"},{"id":46212,"word":"雄伟壮观","pinyin":"xióng wěi zhuàng guān","abbr":"xwzg","explanation":"气势伟大美丽。","example":{"text":"我们来到～的金门桥时，顿时感到心胸开朗。"}},{"id":46213,"word":"雄兵百万","pinyin":"xióng bīng bǎi wàn","abbr":"xbbw","explanation":"数以百万的英勇的军队。形容军事强大，兵多将广，英勇善战。","source":{"text":"今统雄兵百万，上将千员，欲与将军会猎于江夏，共伐刘备，同分土地，永结盟好。","book":"明·罗贯中《三国演义》第四十三回"},"example":{"text":"他的父亲乃东伯侯姜桓楚，镇于东鲁，～，麾下大将千员。","book":"明·许仲琳《封神演义》第七回"},"similar":["百万雄师","雄师百万","百万雄兵"],"opposite":["残兵败将"],"usage":"作主语、宾语、定语；形容人数多"},{"id":46214,"word":"雄唱雌和","pinyin":"xióng chàng cí hé","abbr":"xcch","explanation":"比喻相互附和。","source":{"text":"盗连为群，雄唱雌和，首尾一身。","book":"唐·韩愈《司徒兼侍中书令赠太尉许国公神道碑铭》"},"similar":["夫唱妇随","一唱一和"],"usage":"作谓语、定语；用于书面语"},{"id":46215,"word":"雄姿英发","pinyin":"xióng zī yīng fā","abbr":"xzyf","explanation":"姿容威武雄壮。","source":{"text":"遥想公瑾当年，小乔出嫁了，雄姿英发。","book":"宋·苏轼《念妈娇·赤壁怀古》词"},"example":{"text":"想君当年，～。","book":"明·罗贯中《三国演义》第五十七回"},"similar":["英姿潇洒"],"usage":"作谓语、定语；用于书面语"},{"id":46216,"word":"雄姿飒爽","pinyin":"xióng zī sà shuǎng","abbr":"xzss","explanation":"雄姿：英勇威武的姿态；飒爽：豪迈矫健。形容英俊威武、精神焕发的样子。","source":{"text":"褒公鄂公毛发动，英姿飒爽来酣战。","book":"唐·杜甫《丹青引赠曹将军霸》"}},{"id":46217,"word":"雄师百万","pinyin":"xióng shī bǎi wàn","abbr":"xsbw","explanation":"雄：威武雄壮；师：军队。人数众多、威武雄壮的军队。","source":{"text":"李密袒臂一呼，聚雄师百万，占了中原。","book":"《宣和遗事》第三集"},"similar":["百万雄兵","雄兵百万","百万雄师"],"opposite":["残兵败将"],"usage":"作主语、宾语、定语；形容人数多"},{"id":46218,"word":"雄心勃勃","pinyin":"xióng xīn bó bó","abbr":"xxbb","explanation":"勃勃：旺盛的样子。形容雄心很大，很有理想。","source":{"text":"最初构思的时候，原也雄心勃勃，打算在我力所能及的广阔画面上把一些最典型的人物事态组织进去。","book":"茅盾《新版后记》"},"example":{"text":"他～地去海南干一番事业。"},"similar":["雄心壮志","野心勃勃"],"opposite":["万念俱灰"],"usage":"作谓语、状语；指有理想"},{"id":46219,"word":"雄心壮志","pinyin":"xióng xīn zhuàng zhì","abbr":"xxzz","explanation":"伟大的理想，宏伟的志愿。","source":{"text":"雄心壮志两峥嵘，谁谓中年志不成。","book":"宋·欧阳修《苏才翁挽诗》之二"},"example":{"text":"英士年纪轻，阅历浅，又是新从外国回来，不知道这一切的景况，我想他那～，终久要受打击的。","book":"冰心《去国》"},"similar":["雄心勃勃","豪情壮志"],"opposite":["万念俱灰"],"usage":"作谓语、定语；指志向很大"},{"id":46220,"word":"雄才伟略","pinyin":"xióng cái wěi lüè","abbr":"xcwl","explanation":"非常杰出的才智和谋略。","source":{"text":"如武帝之雄材大略，不改文、景之恭俭以济斯民，虽《诗》、《书》所称，何有加焉？","book":"《汉书·武帝纪赞》"},"example":{"text":"此人～，豁达大度，包你见了心服。","book":"金庸《神雕侠侣》第十六回"}},{"id":46221,"word":"雄才大略","pinyin":"xióng cái dà lüè","abbr":"xcdl","explanation":"非常杰出的才智和谋略。","source":{"text":"如武帝之雄才大略，不改文、景之恭俭以济斯民，虽《诗》、《书》所称，何有加焉？","book":"《汉书·武帝纪赞》"},"example":{"text":"汉武帝～，命卫青、霍去病两员大将分路出兵，直扫匈奴巢穴，千古第一快事。","book":"清·陈天华《狮子吼》第二回"},"similar":["经天纬地","雄材大略","雄材伟略"],"opposite":["庸庸碌碌"],"usage":"作宾语、定语；指杰出的才智和谋略","story":["西汉时期，经过文景之治，农业得到了空前的发展，国家安定团结。汉武帝即位后，他罢黜百家之言，独尊儒家文化，他广泛收罗人才，兴大学，好大喜功，不关心人们的疾苦。班固在《汉书》中评价：“如武帝之雄材大略，不改文景之恭俭以济斯民。”"]},{"id":46222,"word":"雄才盖世","pinyin":"xióng cái gài shì","abbr":"xcgs","explanation":"盖：压倒。杰出的才能压倒一切。比喻才能高超，无与伦比。","example":{"text":"他～，能成就大业。"},"similar":["才华无双"],"usage":"作谓语、定语；指人才华无与伦比"},{"id":46223,"word":"雄才远略","pinyin":"xióng cái yuǎn lüè","abbr":"xcyl","explanation":"非常杰出的才智和长远的谋略。","source":{"text":"曹公有雄才远略，决机无疑，法一而兵精，能用度外之人，所任各尽其力，必能济大事者也。”","book":"《三国志·魏志·杨阜传》"},"example":{"text":"唐祚将终，籓镇互相吞噬，皆无～，不能戡济多难。","book":"《资治通鉴·唐纪·僖宗光启三年》"}},{"id":46224,"word":"雄文大手","pinyin":"xióng wén dà shǒu","abbr":"xwds","explanation":"擅长写作宏伟诗文的高手。","source":{"text":"叙人情，状物态，一寓于诗，而曲尽其妙，此在雄文大手固不足论，而余独爱其工于用韵也。","book":"宋·欧阳修《六一诗话》"},"example":{"text":"金·王若虚《滹南诗话》中卷：“公～，乐府乃其游戏，顾岂与流俗争胜哉！”"},"usage":"作宾语、定语；用于书面语"},{"id":46225,"word":"雄材伟略","pinyin":"xióng cái wěi lüè","abbr":"xcwl","explanation":"略：计谋。非常杰出的才能，远大的谋略","source":{"text":"王兄，你是雄材伟略，真不忝提戈戡乱。","book":"明·沈鲸《双珠记·辕门遇友》"},"similar":["雄材大略","雄才大略"],"usage":"作宾语、定语；指杰出的才智和谋略"},{"id":46226,"word":"雄材大略","pinyin":"xióng cái dà lüè","abbr":"xcdl","explanation":"杰出的才能和伟大的谋略。","source":{"text":"如武帝之雄材大略，不改文景之恭俭以济斯民，虽《诗》《书》所称何有加焉！","book":"东汉·班固《汉书·武帝纪赞》"},"example":{"text":"三国·魏·曹植《汉二祖优劣论》：“然彼之～，俶傥之节，信当世至豪健壮杰士也。”"},"similar":["雄才大略","雄材伟略"],"usage":"作宾语、定语；指杰出的才智和谋略","story":["西汉时期，经过文景之治，农业得到了空前的发展，国家安定团结。汉武帝即位后，他罢黜百家之言，独尊儒家文化，他广泛收罗人才，兴大学，好大喜功，不关心人们的疾苦。班固在《汉书》中评价：“如武帝之雄材大略，不改文景之恭俭以济斯民。”"]},{"id":46227,"word":"雄深雅健","pinyin":"xióng shēn yǎ jiàn","abbr":"xsyj","explanation":"指文章雄浑而深沉，典雅而有力。","source":{"text":"韩愈评其文曰：‘雄深雅健，似司马子长，崔、蔡不足多也。’","book":"《新唐书·柳宗元传》"},"example":{"text":"林纾《译序》：“苟以～之笔施之，亦尚有其人。”"},"usage":"作谓语、定语；用于文章等"},{"id":46228,"word":"雄纠纠，气昂昂","pinyin":"xióng jiū jiū，qì áng áng","abbr":"xjjqaa","explanation":"纠纠：健壮威武的样子。昂昂：情绪高涨的样子。形容雄壮威武，情绪高昂。","source":{"text":"那贼将季三思、倪慑，领着十余员偏将，雄纠纠，气昂昂的杀奔到城下来。","book":"明·施耐庵《水浒传》第一百六回"},"example":{"text":"忽然烟榻前来了一个彪形大汉，虽然是面目黧黑，形容枯槁，却显出一副～的神情。","book":"清·李宝嘉《官场现形记》第三十回"},"similar":["雄赳赳，气昂昂"],"usage":"作定语、状语；用于口语"},{"id":46229,"word":"雄罴百万","pinyin":"xióng pí bǎi wàn","abbr":"xpbw","explanation":"雄罴：猛兽。比喻众多的勇猛将士","source":{"text":"汝不闻去岁淮甸间，雄罴百万临危堞。","book":"南宋·王迈《观猎行》"},"similar":["雄兵百万"],"usage":"作主语、宾语、定语；形容人数多"},{"id":46230,"word":"雄视一世","pinyin":"xióng shì yī shì","abbr":"xsys","explanation":"形容称雄于一代。","source":{"text":"朝宗始倡欧之学于举世不为之日，遂以古文雄视一世。","book":"清·邵长蘅《侯方域、魏僖传》"},"usage":"作谓语、定语；用于书面语"},{"id":46231,"word":"雄赳赳，气昂昂","pinyin":"xióng jiū jiū，qì áng áng","abbr":"xjjqaa","explanation":"赳赳：雄壮勇武；昂昂：气概轩昂。指人雄壮勇武，气宇轩昂的样子","source":{"text":"则你那雄赳赳，气昂昂，身凛凛，貌堂堂。","book":"元·张国宾《薛仁贵》楔子"},"example":{"text":"麻扶摇《中国人民志愿军战歌》：“～，跨过鸭绿江，保和平，卫祖国，就是保家乡。”"},"similar":["雄纠纠，气昂昂"],"usage":"作定语、状语；用于口语"},{"id":46232,"word":"雄辞闳辩","pinyin":"xióng cí hóng biàn","abbr":"xchb","explanation":"指说理充分，气势宏大的言词。","source":{"text":"其清音幽韵，凄如飘风急雨之骤至；其雄辞闳辩，快如轻车骏马之奔驰。","book":"宋·王安石《祭欧阳文忠公文》"},"example":{"text":"有了他的～，我们不担心失败了"},"similar":["雄辩高谈"],"usage":"作主语、宾语、定语；用于说话等"},{"id":46233,"word":"雄辩强据","pinyin":"xióng biàn qiáng jù","abbr":"xbqj","explanation":"雄健的辩论口才，强有力的证据。","source":{"text":"又间得子厚文，皆雄辩强据，渊源衍长。","book":"宋·王令《代韩退之答柳子厚示浩初序书》"},"usage":"作宾语、定语；用于说话或写作"},{"id":46234,"word":"雄辩高谈","pinyin":"xióng biàn gāo tán","abbr":"xbgt","explanation":"雄：强有力的；高：大而广。大发议论，长于说理。形容能言善辩。","source":{"text":"焦遂五斗方卓然，高谈雄辩惊四筵。","book":"北周·庾信《预麟趾殿校书和刘仪同》：“高谭变白马，雄辩塞飞狐。”唐·杜甫《饮中八仙歌》"},"example":{"text":"却说安老爷的话，一层逼近一层，引得个邓九公～，真情毕露。","book":"清·文康《儿女英雄传》第十六回"},"usage":"作谓语、宾语；用于书面语"},{"id":46235,"word":"雄飞突进","pinyin":"xióng fēi tū jìn","abbr":"xftj","explanation":"形容奋力迅速向前。","source":{"text":"看见了欧美近一百年来的文化，雄飞突进，一日千里。","book":"孙中山《民权主义第五讲》"},"example":{"text":"看不见了欧美近一百年来的文化，雄飞突进，一日千里。","book":"孙中山《民权主义第五讲》"},"usage":"作谓语、定语；用于书面语"},{"id":46236,"word":"雄飞雌伏","pinyin":"xióng fēi cí fú","abbr":"xfcf","explanation":"雄飞：比喻奋发有为；雌伏：比喻隐藏，不进取。要有雄心壮志，不能无所作为。","source":{"text":"大丈夫当雄飞，安能雌伏！","book":"《后汉书·赵典传》"},"usage":"作谓语、定语；用于男性"},{"id":46237,"word":"雄鸡一唱天下白","pinyin":"xióng jī yī chàng tiān xià bái","abbr":"xjyctxb","explanation":"比喻人民开始了新的生活。","source":{"text":"我有迷魂招不得，雄鸡一声天下白。","book":"唐·李贺《致酒行》"}},{"id":46238,"word":"雄鸡夜鸣","pinyin":"xióng jī yè míng","abbr":"xjym","explanation":"古代认为雄鸡夜鸣为异常现象，预兆战事。"},{"id":46239,"word":"雄鸡断尾","pinyin":"xióng jī duàn wěi","abbr":"xjdw","explanation":"断尾：断去尾巴。本指雄鸡因怕做祭祀的牺牲而自残其身。后比喻人怕被杀而自尽。","source":{"text":"宾孟适郊，见雄鸡自断其尾。问之，侍者曰：‘自惮其牺也。’","book":"《左传·昭公二十二年》"},"similar":["断尾雄鸡"],"usage":"作宾语、定语；指装疯卖傻"},{"id":46240,"word":"雅人深致","pinyin":"yǎ rén shēn zhì","abbr":"yrsz","explanation":"雅：高雅，高尚；致：情趣。人品高尚，情趣深远。原是赞赏《诗经·大雅》的作者有深刻的见解。后形容人的言谈举止不俗。","source":{"text":"纡谟定命，远猷辰告。’谓此句偏有雅人深致。","book":"南朝·宋·刘义庆《世说新语·文学》"},"example":{"text":"～，使见者意消；与骂座灌夫，自别是一流人物。","book":"清·纪昀《阅微草堂笔记·如是我闻》"},"similar":["雅人清致"],"usage":"作谓语、定语、宾语；指人的言谈举止","story":["晋朝时期，谢安与子侄们聚会，问他们《毛诗》中最精彩的句子。谢玄说是：“昔我往矣，杨柳依依，今我来思，雨雪霏霏。”谢安则称赞“訏谟定命，远猷辰告。”说该句包含着高雅人的情致"]},{"id":46241,"word":"雅人清致","pinyin":"yǎ rén qīng zhì","abbr":"yrqz","explanation":"形容人的言谈举止不俗。同“雅人深致”。","source":{"text":"《随园食单》所讲求烹调之法，率皆常味蔬菜，并无山海奇珍，不失雅人清致。","book":"清·梁章钜《浪迹续谈·不食物单》"},"similar":["雅人深致"],"usage":"作宾语、定语；指人的言谈举止"},{"id":46242,"word":"雅人韵士","pinyin":"yǎ rén yùn shì","abbr":"yrys","explanation":"高雅而有风致的文人。","source":{"text":"若果如是，则亦艳妆村妇而已矣，乌足动雅人韵士之心哉。","book":"清·李渔《闲情偶寄·词曲·科诨》：“文字佳，情节佳，而科诨不佳，非特俗人怕看，即雅人韵士，亦有瞌睡之时。”又《声容·治服》"},"similar":["文人雅士"],"usage":"作主语、宾语；用于书面语"},{"id":46243,"word":"雅俗共赏","pinyin":"yǎ sú gòng shǎng","abbr":"ysgs","explanation":"形容某些文艺作品既优美，又通俗，各种文化程度的人都能够欣赏。","source":{"text":"闻得有绵驹善歌，雅俗共赏。","book":"明·孙人儒《东郭记·绵驹》"},"example":{"text":"这些虽好，不合老太太的意；不如做些浅近的物儿，大家～才好。","book":"清·曹雪芹《红楼梦》第五十回"},"similar":["喜闻乐见","有口皆碑"],"opposite":["下里巴人","阳春白雪","曲高和寡"],"usage":"作谓语、定语、补语；指文学作品"},{"id":46244,"word":"雅量豁然","pinyin":"yǎ liàng huò rán","abbr":"ylhr","explanation":"雅量：宽宏的度量；豁然：开阔，通达。指人度量豁达。","source":{"text":"敏而好学，雅量豁然。","book":"《晋书·李寿载记》"},"usage":"作谓语、定语；用于为人"},{"id":46245,"word":"雅量高致","pinyin":"yǎ liàng gāo zhì","abbr":"ylgz","explanation":"气度宽宏，情致高雅。","source":{"text":"幹（蒋幹）还，称瑜雅量高致，非言辞所间。","book":"《三国志·吴志·周瑜传》“惟与程普不睦”裴松之注引晋·虞溥《江表传》"},"example":{"text":"周瑜～，非言辞所以能动也。","book":"《三国演义》第四五回"},"usage":"作谓语、定语；用于书面语"},{"id":46246,"word":"雅雀无声","pinyin":"yǎ què wú shēng","abbr":"yqws","explanation":"形容静默之极。雅，“鸦”的古字。","source":{"text":"文樱宣读报告，台下静听，一时雅雀无声的，但闻时钟叮当。","book":"《廿世纪女界文明灯》弹词"},"similar":["鸦雀无声","鸦鹊无声"],"usage":"作谓语、定语、状语；形容非常静"},{"id":46247,"word":"集大成","pinyin":"jí dà chéng","abbr":"jdc","explanation":"融会各方面的优点及成就，以达到完备的程度。","source":{"text":"孔子，圣之时者也，孔子之谓集大成。","book":"《孟子·万章下》"}},{"id":46248,"word":"集思广益","pinyin":"jí sī guǎng yì","abbr":"jsgy","explanation":"指集中众人智能，广泛进行议论。","source":{"text":"国家所以设立衙署，盖欲诸臣共集一堂，互相商榷，佞者既明目共视，难以挟私，贤者亦集思广议，以济其事。","book":"清·昭梿《啸亭杂录·钱南园》"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“说！～，说出来商量。”"},"similar":["群策群力","广开言路"],"opposite":["一意孤行","独断专行"],"usage":"作谓语、定语、状语；指博采有益的意见","story":["三国时期，蜀主刘备死后，刘禅继位，蜀国的大小政事都由丞相诸葛亮处理。诸葛亮在朝野的威望很高，但他并不居功自傲，经常注意听取部下的意见。有部下反对他这样做，他认为这是为了集中众人的智慧和意见，广泛地听取有益的建议"]},{"id":46249,"word":"集思广议","pinyin":"jí sī guǎng yì","abbr":"jsgy","explanation":"集：聚集；思：思考，智慧；议：议论。集中众人智慧，广泛进行议论","source":{"text":"佞者既明目共视，难以挟私，贤者亦集思广议，以济其事。","book":"清·昭梿《啸亭杂录·钱南园》"},"usage":"作谓语、定语；用于处事"},{"id":46250,"word":"集矢之的","pinyin":"jí shǐ zhī dì","abbr":"jszd","explanation":"集矢，指箭射中目标。比喻众人所指责的对象。","source":{"text":"自《临时约法》为集矢之的，而世之谈国情者众。","book":"《左传·襄公二年》：“郑成公疾，子驷请息肩于晋。公曰：‘楚君以郑故，亲集矢于其目。’”李大钊《国情》"},"example":{"text":"今日为国民～，喧传其为卖国贼者，不外曹也，章也，陆也。","book":"《“五四”爱国运动资料·章宗祥之返国》"},"similar":["众矢之的"],"usage":"作宾语、定语；指目标"},{"id":46251,"word":"集腋为裘","pinyin":"jí yè wéi qiú","abbr":"jywq","explanation":"狐狸腋下的皮虽很小，但聚集起来就能制一件皮袍。比喻积少成多。同“集腋成裘”。","source":{"text":"集腋为裘，妄续《幽冥之录》；浮白载笔，仅成孤愤之书。","book":"清·蒲松龄《聊斋志异·自志》"},"example":{"text":"于是剪报的内容便由剪别人的作品到剪自己的作品，～，居然有了几本书。","book":"《新闻出版报》1990.3.21"},"similar":["集腋成裘"],"usage":"作宾语、谓语、宾语；比喻积少成多"},{"id":46252,"word":"集腋成裘","pinyin":"jí yè chéng qiú","abbr":"jycq","explanation":"腋：腋下，指狐狸腋下的皮毛；裘：皮衣。狐狸腋下的皮虽很小，但聚集起来就能制一件皮袍。比喻积少成多。","source":{"text":"狐白之裘，盖非一狐之皮也。","book":"《慎子·知忠》"},"example":{"text":"如今弄多少是多少，也只好是～了。","book":"清·文康《儿女英雄传》第三回"},"similar":["积土成山","积少成多","聚沙成塔"],"opposite":["杯水车薪","一口吃一个胖子"],"usage":"作主语、谓语、宾语；比喻积少成多"},{"id":46253,"word":"集苑集枯","pinyin":"jí yuàn jí kū","abbr":"jyjk","explanation":"集：栖息；苑：茂盛的树木；枯：枯树。有些鸟栖于茂盛的树木，有些鸟栖于枯树。比喻人的志趣不同，趋向各异。","source":{"text":"暇豫这吾吾，不如鸟乌；人皆集于苑，己独集于枯。","book":"《国语·晋语二》"},"similar":["人各有志"],"usage":"作宾语、定语；比喻人的志趣不同"},{"id":46254,"word":"集萤映雪","pinyin":"jí yíng yìng xuě","abbr":"jyyx","explanation":"集萤：晋代车胤少时家贫，夏天以练囊装萤火虫照明读书；映雪：晋代孙康冬天常映雪读书。形容家境贫穷，勤学苦读。","source":{"text":"既笔耕为养，亦拥书成学，至乃集萤映雪，编蒲辑柳。","book":"南朝·梁·任昉《为萧扬州荐士表》"},"similar":["聚萤映雪","聚萤积雪","积雪囊萤"],"usage":"作宾语、定语；用于求学等","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":46255,"word":"雉伏鼠窜","pinyin":"zhì fú shǔ cuàn","abbr":"zfsc","explanation":"指恐惧地躲藏，惊慌地逃窜。","source":{"text":"朝廷命将出师，天威所至，雉伏鼠窜，无有遗者。","book":"明·李东阳《西北备边事宜状》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":46256,"word":"雉头狐腋","pinyin":"zhì tóu hú yè","abbr":"zthy","explanation":"以雉头狐腋做成的裘衣。形容穿着讲究，生活奢侈。","source":{"text":"晋室石崇乃是庶姓，犹能雉头狐腋，画卵雕薪；况我大魏天王，不为华侈？","book":"北魏·杨衒之《洛阳伽蓝记·开善寺》"},"usage":"作宾语、定语；指人的穿着"},{"id":46257,"word":"雌雄未决","pinyin":"cí xióng wèi jué","abbr":"cxwj","explanation":"比喻胜负未定。","source":{"text":"今豪杰竞逐，雌雄未决，当各据其土宇，与陇、蜀合从，高可为六国，下不失尉陀。","book":"《后汉书·窦融传》"},"similar":["不分胜负"],"usage":"作谓语、补语；比喻胜负未定"},{"id":46258,"word":"雌黄黑白","pinyin":"cí huáng hēi bái","abbr":"chhb","explanation":"雌黄：随便乱说；黑白：黑色和白色。指评头论足，胡乱指责。","source":{"text":"雌黄黑白，旁若无人。","book":"蔡东藩《民国通俗演义》第79回"},"example":{"text":"请不要在此～。"},"similar":["评头品足","信口雌黄"],"usage":"作谓语；指胡说"},{"id":46259,"word":"雍容不迫","pinyin":"yōng róng bù pò","abbr":"yrbp","explanation":"形容态度大方，从容不迫。","source":{"text":"敏中平生，身不怀币，口不论钱，义不苟进，进必有所匡救，援据今古，雍容不迫。","book":"《元史·刘敏中传》"},"example":{"text":"他的行动和谈吐都是～。","book":"郭沫若《献身精神的榜样》"},"usage":"作谓语、定语；指人的态度"},{"id":46260,"word":"雍容典雅","pinyin":"yōng róng diǎn yǎ","abbr":"yrdy","explanation":"形容文气舒缓，词藻优美而不俗。","source":{"text":"公之文雍容典雅，纡余宽平，反覆以达其意，无复毫发之遗。","book":"宋·陈亮《书欧阳文粹后》"},"example":{"text":"茅盾《夜读偶记》：“所谓‘台阁体’说得‘雅’一点，是～，说得不客气，就是‘今天天气，哈哈哈’。”"},"similar":["雍容文雅"],"usage":"作谓语、定语；用于说话或文章等"},{"id":46261,"word":"雍容华贵","pinyin":"yōng róng huá guì","abbr":"yrhg","explanation":"形容态度文雅从容，庄重大方。","source":{"text":"姜夫人雍容华贵地走下，盈盈和戚戚恭恭敬敬地陪送出去。","book":"曹禺《王昭君》第一幕"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“这一戴上首饰，越觉她那张鹅蛋脸～，绝不象摇船人家的女儿。”"},"similar":["雍容尔雅","富丽堂皇"],"usage":"作谓语、定语、状语；指人的外表"},{"id":46262,"word":"雍容大度","pinyin":"yōng róng dà dù","abbr":"yrdd","explanation":"文雅大方，有气量，有风度。","source":{"text":"常有大度，不事家人生产作业。","book":"西汉·司马迁《史记·高祖本纪》"},"similar":["雍容尔雅"],"opposite":["忸怩作态"],"usage":"作谓语、状语；指人的风度"},{"id":46263,"word":"雍容大雅","pinyin":"yōng róng dà yǎ","abbr":"yrdy","explanation":"指神态从容不迫，举止文雅大方。同“雍容闲雅”。","source":{"text":"快走，那白白的鞋底与颤动的腿带，会显出轻灵飘洒；慢走，又显出雍容大雅。","book":"老舍《不成问题的问题》"},"similar":["雍容闲雅","雍容尔雅"],"usage":"作谓语、定语、状语；指人的风度气质"},{"id":46264,"word":"雍容尔雅","pinyin":"yōng róng ěr yǎ","abbr":"yrey","explanation":"形容态度大方，举止不俗。","source":{"text":"相如之临邛，从车骑，雍容闲雅甚都。","book":"《史记·司马相如列传》"},"example":{"text":"伴着两公子的～，蘧公孙的俊俏风流，杨执中古貌古心，权勿用怪模怪样：真乃一时胜会。","book":"清·吴敬梓《儒林外史》第十二回"},"similar":["雍容文雅","雍容大雅"],"usage":"作谓语、定语；形容人的举止等"},{"id":46265,"word":"雍容文雅","pinyin":"yōng róng wén yǎ","abbr":"yrwy","explanation":"形容文气舒缓，词藻优美而不俗","source":{"text":"相门华列，儒庭善训，雍容文雅，当代知名。","book":"唐·张说《龙门西龛苏合宫等身观世音菩萨像颂》"},"example":{"text":"暴力、色情作品对那些～的文学作品冲击很大"},"similar":["雍容典雅","雍容闲雅"],"usage":"作谓语、定语；用于说话或文章等"},{"id":46266,"word":"雍容闲雅","pinyin":"yōng róng xián yǎ","abbr":"yrxy","explanation":"指神态从容不迫，举止文雅大方。","source":{"text":"相如之临邛，从车骑，雍容闲雅，甚都。","book":"《史记·司马相如列传》"},"similar":["雍容尔雅","雍容大雅"],"usage":"作谓语、定语、状语；指人的风度气质"},{"id":46267,"word":"雍容雅步","pinyin":"yōng róng yǎ bù","abbr":"yryb","explanation":"指神态从容，举止斯文。","source":{"text":"或雍容雅步，三命而后至；或栖栖遑遑，负鼎而自达。虽徇尚不同，济时一也。","book":"《魏书·世祖纪上》"},"example":{"text":"你～，好像个老官僚阔乡绅。","book":"刘大白《龟》诗"},"similar":["雍容闲雅"],"usage":"作谓语、宾语、定语；形容人的举止"},{"id":46268,"word":"雍荣华贵","pinyin":"yōng róng huá guì","abbr":"yrhg","explanation":"形容态度文雅从容，庄重大方。"},{"id":46269,"word":"雍荣尔雅","pinyin":"yōng róng ěr yǎ","abbr":"yrey","explanation":"雍荣：态度大方，从容不迫；尔雅：文雅。形容态度从容，举止文雅。","source":{"text":"相如之临邛，从车骑，雍荣闲雅甚都。","book":"《史记·司马相如列传》"},"example":{"text":"伴着两公子的～，蘧公孙的俊俏风流，杨执中古貌古心，权勿用怪模怪样：真乃一时胜会。","book":"清·吴敬梓《儒林外史》第十二回"}},{"id":46270,"word":"雍荣闲雅","pinyin":"yōng róng xián yǎ","abbr":"yrxy","explanation":"雍荣：态度大方，从容不迫；闲雅：文雅。形容态度从容，举止文雅。","source":{"text":"相如之临邛，从车骑，雍荣闲雅甚都。","book":"《史记·司马相如列传》"}},{"id":46271,"word":"雍荣雅步","pinyin":"yōng róng yǎ bù","abbr":"yryb","explanation":"形容态度从容大方，举止不俗。","source":{"text":"古之君子，德成业就，才为世使。或雍荣雅步，三命而后至；或棲棲遑遑，负鼎而自达。","book":"《魏书·世祖纪》"}},{"id":46272,"word":"雍门刎首","pinyin":"yōng mén wěn shǒu","abbr":"ymws","explanation":"后用为忠君的典实。","source":{"text":"相传越军至齐境，烈士雍门子狄闻之，刎颈而死。越军知之，曰：“齐王有臣钧如雍门子狄，拟使越社稷不血食。”遂引军而退。齐王葬雍门以上卿之礼。见汉刘向《说苑·立节》。"},"usage":"作宾语、定语；用于书面语","story":["春秋战国时期，越军开赴齐国边境，烈士雍门子狄听说后亲赴越军营前刎颈而死，越军见了纷纷感慨齐国有如此的忠君的义士，肯定是不容易战胜的，于是就引军而退。齐王以上卿之礼收葬了雍门子狄"]},{"id":46273,"word":"雏凤清声","pinyin":"chú fèng qīng shēng","abbr":"cfqs","explanation":"雏凤：比喻优秀子弟；清声：清越的鸣声。比喻后代子孙更有才华。","source":{"text":"桐花万里丹山路，雏凤清于老凤声。","book":"唐·李商隐《寄韩冬郎兼长之员外》"},"usage":"作宾语、定语；用于夸奖别人的子女"},{"id":46274,"word":"雏鹰展翅","pinyin":"chú yīng zhǎn chì","abbr":"cyzc","explanation":"雏：幼鸟。幼鹰展开翅膀飞翔。比喻青年人开始独立生活、工作。","example":{"text":"大学已经毕业了，这正是他～的时侯。"}},{"id":46275,"word":"雕冰画脂","pinyin":"diāo bīng huà zhī","abbr":"dbhz","explanation":"在冰上雕刻，在凝固的油脂上绘画。比喻白费工夫，劳而无功。","source":{"text":"故内无其质，而外学其文，虽有贤师良友，若画脂镂冰，费日损功。","book":"汉·桓宽《盐铁论·殊路》"},"example":{"text":"金碧辉煌，可谓巧绝，然脆薄无用，不异～耳。","book":"明·胡应麟《甲乙剩言·卵灯》"}},{"id":46276,"word":"雕墙峻宇","pinyin":"diāo qiáng jùn yǔ","abbr":"dqjy","explanation":"彩绘的墙壁和高大的屋宇。形容居处豪华奢侈。同“峻宇雕墙”。","source":{"text":"非直雕墙峻宇，深戒前王，而缔构弘敞，有逾清庙。","book":"《周书·武帝纪下》"},"example":{"text":"是有～，列冠盖于宜城；塞陌填街，考春秋于太学。","book":"唐·杨炯《遂州长江县孔子庙堂碑》"},"similar":["峻宇雕墙"],"usage":"作宾语、定语；用于建筑物"},{"id":46277,"word":"雕心刻肾","pinyin":"diāo xīn kè shèn","abbr":"dxks","explanation":"比喻写作的刻意锤炼。同“雕肝琢肾”。","source":{"text":"诗文不朽大业，学者雕心刻肾，穷昼极夜，犹惧弗窥奥妙。","book":"明·胡应麟《诗薮·六朝》"},"similar":["雕肝刻肾"],"usage":"作谓语、宾语、定语；用于写作方面"},{"id":46278,"word":"雕心雁爪","pinyin":"diāo xīn yàn zhǎo","abbr":"dxyz","explanation":"比喻心狠手辣。","source":{"text":"为人雕心雁爪，做事欺大压小，全凭谄佞奸贪，一知受用不了。","book":"元·马致远《破孤雁汉宫秋》楔子"},"example":{"text":"他须是鼠窃狗盗无知辈，～无恩义，鸡肠蛇腹为奸细。","book":"《古今杂剧·聚兽牌》"},"similar":["心狠手辣","雕心鹰爪"],"usage":"作谓语、定语；比喻心狠手辣"},{"id":46279,"word":"雕心鹰爪","pinyin":"diāo xīn yīng zhǎo","abbr":"dxyz","explanation":"比喻心肠残忍，手段毒辣。","source":{"text":"他待使些雕心鹰爪，安排下龙韬虎略。","book":"元·无名氏《千里独行》第三折"},"example":{"text":"倚着他龙蟠虎踞江山霸，人强马壮诸侯怕，～窥天下。","book":"元·无名氏《临潼斗宝》头折"},"similar":["雕心雁爪"],"usage":"作宾语、定语；比喻心狠手辣"},{"id":46280,"word":"雕文刻镂","pinyin":"diāo wén kè lòu","abbr":"dwkl","explanation":"指在宫室、用具等上面雕刻镂花，加以修饰。比喻不务实际，只重表面虚荣，劳民伤财。","source":{"text":"雕文刻镂，伤农事者也，锦绣纂祖，害女红者也。农事伤则饥之本也，女红害则寒之原也。","book":"《汉书·景帝纪》"},"usage":"作谓语、定语、宾语；用于做事"},{"id":46281,"word":"雕文织采","pinyin":"diāo wén zhī cǎi","abbr":"dwzc","explanation":"比喻词藻华丽。","source":{"text":"孝武诗，雕文织采，过为精密，为二藩希慕，见称轻巧矣。","book":"南朝·梁·钟嵘《诗品》下卷"},"usage":"作谓语、定语；用于作文等"},{"id":46282,"word":"雕栏玉砌","pinyin":"diāo lán yù qì","abbr":"dlyq","explanation":"雕：雕绘；栏：栏杆；砌：石阶。形容富丽的建筑物。","source":{"text":"雕栏玉砌应犹在，只是朱颜改，问君能有几多愁，恰似一江春水向东流。","book":"南唐·李煜《虞美人》词"},"example":{"text":"失去了往昔的～，李煜独自悲伤。"},"similar":["雕梁画栋","富丽堂皇","金壁辉煌"],"opposite":["穷巷陋室","绳床瓦灶"],"usage":"作主语、宾语、定语；指建筑物","story":["公元960年，赵匡胤陈桥兵变建立宋朝，消灭了南平、后蜀、南汉等国。南唐后主李煜不问朝政，只会吟诗作词，被宋朝打败，投降后被封为违命侯。李煜作词：“雕栏玉砌应犹在，只是朱颜改。”宋太宗借机杀了他"]},{"id":46283,"word":"雕栏画栋","pinyin":"diāo lán huà dòng","abbr":"dlhd","explanation":"雕：雕绘；栋：支柱。指有彩绘装饰的十分华丽的房屋。","source":{"text":"颓垣破瓦，鼯鼪之所穴而鸠雀之所巢，孰非向之雕栏画栋群萃而管弦歌舞者与？","book":"清·汪琬《寓庐十咏后序》"},"example":{"text":"清·汪琬《寓庐十咏后序》：“颓垣破瓦，鼯鼪之所穴而鸠雀之所巢，孰非向之～群萃而管弦歌舞者与？”"},"similar":["雕梁画栋","雕甍画栋"],"usage":"作宾语、定语；指建筑物很华丽"},{"id":46284,"word":"雕梁画栋","pinyin":"diāo liáng huà dòng","abbr":"dlhd","explanation":"指有彩绘装饰的十分华丽的房屋。","source":{"text":"光闪闪贝阙珠宫，齐臻臻碧瓦朱甍，宽绰绰罗帏绣成栊，郁巍巍画梁雕栋。","book":"元·王子一《误入桃源》第二折"},"example":{"text":"正面五间上房，皆是～，两边穿山游廊厢房，挂着各色鹉画眉等雀儿。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["雕栏玉砌","琼楼玉宇"],"opposite":["蓬门荜户"],"usage":"作宾语、定语；指建筑物很华丽"},{"id":46285,"word":"雕梁绣户","pinyin":"diāo liáng xiù hù","abbr":"dlxh","explanation":"雕：雕刻，雕花；绣户：雕绘华美的门户。指雕绘华美的建筑。","source":{"text":"雕梁绣户都在眼，微命未知何处飞。","book":"清·金人瑞《甲申秋兴》诗"},"usage":"作宾语、定语；用于建筑"},{"id":46286,"word":"雕梁绣柱","pinyin":"diāo liáng xiù zhù","abbr":"dlxz","explanation":"雕：用彩画装饰。用彩画装饰的大梁和用锦绣包裹的柱子。形容建筑物的奢华。","source":{"text":"原来这座酒楼，名贯河北，号为第一；上有三檐滴水，雕梁绣柱，极是造得好。","book":"明·施耐庵《水浒传》第66回"},"example":{"text":"明·冯梦龙《醒世恒言》第39卷：“～，画栋飞甍，金碧耀目。”"},"similar":["雕梁画栋"],"usage":"作宾语、定语；指建筑物很华丽"},{"id":46287,"word":"雕楹碧槛","pinyin":"diāo yíng bì kǎn","abbr":"dybk","explanation":"雕镂彩绘的柱子和碧色栏杆。","source":{"text":"那时船正荡到柳阴中，远望那堤北，彤云阁雕楹碧槛，映着翠盖红衣，大有舟行镜里之概。","book":"《花月痕》第十一回"},"usage":"作宾语、定语；用于建筑物"},{"id":46288,"word":"雕玉双联","pinyin":"diāo yǔ shuāng lián","abbr":"dysl","explanation":"雕玉：用玉雕成，形容华美、工巧；双联：律诗中相对偶的两句。形容属对极为精巧。","source":{"text":"寸截金为句，双雕玉作联。","book":"唐·白居易《江楼夜吟元九律诗成三十韵》诗"}},{"id":46289,"word":"雕甍画栋","pinyin":"diāo méng huà dòng","abbr":"dmhd","explanation":"雕：雕绘；甍：屋脊；栋：支柱。指有彩绘装饰的十分华丽的房屋。","source":{"text":"回廊曲榭何深邃，雕甍画栋真巍峨。","book":"清·钱泳《履园丛话·阅古·元石础》"},"example":{"text":"清·荻岸山人《平山冷燕》第14回：“～吐龙光，凤阁斜张朱网。”"},"similar":["雕栏画栋","雕梁画栋"],"usage":"作宾语、定语；指建筑物很华丽"},{"id":46290,"word":"雕盘绮食","pinyin":"diāo pán qǐ shí","abbr":"dpqs","explanation":"精美的器皿及食物。","source":{"text":"雕盘绮食会众客，吴歌赵舞香风吹。","book":"唐·李白《扶风豪士歌》"},"usage":"作宾语、定语；用于吃的场面"},{"id":46291,"word":"雕章琢句","pinyin":"diāo zhāng zhuó jù","abbr":"dzzj","explanation":"指文章的词句刻意修饰。","source":{"text":"今褒贬之文无核实，则惩劝之道缺矣；美刺之诗不稽政，则补察之义废矣。虽雕章镂句，将焉用之。","book":"唐·白居易《议文章》"},"example":{"text":"诗之不可及处，在乎神识超迈，飘然而来，忽然而去，不屑于～。","book":"清·赵翼《瓯北诗话·李青莲诗一》"},"similar":["咬文嚼字"],"opposite":["含糊不清"],"usage":"作谓语、定语；指对文章字句刻意修饰"},{"id":46292,"word":"雕章绘句","pinyin":"diāo zhāng huì jù","abbr":"dzhj","explanation":"指文章的词句刻意修饰。同“雕章镂句”。","source":{"text":"陈无己云：学诗如学道，此岂寻常雕章绘句者之可拟哉。","book":"宋·蔡梦弼《草堂诗话》卷二"},"similar":["雕章镂句","雕章缋句"],"usage":"作主语、宾语、定语；用于作文等"},{"id":46293,"word":"雕章缋句","pinyin":"diāo zhāng huì jù","abbr":"dzhj","explanation":"雕：雕琢；缋：通“绘”，描绘。比喻刻意修饰文辞。","source":{"text":"金瓶玉筋固华丽，雕章缋句真瑰奇。","book":"宋·王洋《又谢丁执中寄黄龙荣》"},"similar":["雕章绘句","雕章琢句"],"usage":"作主语、宾语、定语；用于作文等"},{"id":46294,"word":"雕章缛彩","pinyin":"diāo zhāng rù cǎi","abbr":"dzrc","explanation":"比喻文彩绚烂。","source":{"text":"此乃绮扬绣合，雕章缛彩，欲称实录，其可得乎？","book":"唐·刘知幾《史通鉴识》"},"usage":"作谓语、定语；用于作文等"},{"id":46295,"word":"雕章镂句","pinyin":"diāo zhāng lòu jù","abbr":"dzlj","explanation":"指文章的词句刻意修饰。","source":{"text":"今褒贬之文无核实，则惩劝之道缺矣；美刺之诗不稽政，则补察之义废矣。虽雕章镂句，将焉用之。","book":"唐·白居易《策林四·议文章碑碣词赋》"},"example":{"text":"他们作文讲究～。"},"similar":["精雕细刻","雕章琢句"],"usage":"作主语、宾语、定语；用于作文等"},{"id":46296,"word":"雕肝掐肾","pinyin":"diāo gān qiā shèn","abbr":"dgqs","explanation":"比喻写作的刻意锤炼。同“雕肝琢肾”。","source":{"text":"雕肝掐肾亦小技，非公所喜非我为。","book":"清·冯桂芳《寄丁中丞粤中》诗"},"similar":["雕肝镂肾","雕肝琢膂"],"usage":"作谓语、宾语、定语；用于写作方面"},{"id":46297,"word":"雕肝琢肾","pinyin":"diāo gān zhuó shèn","abbr":"dgzs","explanation":"比喻写作的刻意锤炼。","source":{"text":"劝君韬养待征招，不用雕琢愁肝肾。","book":"唐·韩愈《赠崔立之评事》诗"},"example":{"text":"朝吟摇头暮蹙眉，～闻退之。","book":"宋·欧阳修《答圣俞莫饮酒》诗"},"similar":["精雕细刻","雕肝镂肾"],"usage":"作谓语、宾语、定语；用于写作方面"},{"id":46298,"word":"雕肝琢膂","pinyin":"diāo gān zhuó lǚ","abbr":"dgzl","explanation":"比喻写作的刻意锤炼。同“雕肝琢肾”。","source":{"text":"师友良矣，非雕肝琢膂，宵咏朝吟，不能有一验其所至之浅深。","book":"明·宋濂《序》"},"similar":["雕肝掐肾","雕肝琢肾","雕心刻肾"],"usage":"作谓语、宾语、定语；用于写作方面"},{"id":46299,"word":"雕肝镂肾","pinyin":"diāo gān lòu shèn","abbr":"dgls","explanation":"比喻写作的刻意锤炼。同“雕肝琢肾”。","source":{"text":"清·许印芳《跋》；“虽极雕肝镂肾，亦终惝恍而无赁。”"},"similar":["雕肝琢肾","雕肝掐肾"],"usage":"作谓语、宾语、定语；用于写作方面"},{"id":46300,"word":"雕花刻叶","pinyin":"diāo huā kè yè","abbr":"dhky","explanation":"雕琢花和叶，构思作诗赋吟咏。","source":{"text":"才情百巧斗风光，却笑雕花刻叶忙。","book":"唐·司空图《力疾山下吴村看杏花》诗"}},{"id":46301,"word":"雕虎焦原","pinyin":"diāo hǔ jiāo yuán","abbr":"dhjy","explanation":"指壮士履险。","source":{"text":"莒国有石焦原者，广寻，长五十步，临百仞之谿，莒国莫敢近也。有以勇见莒子者，独却行剂踵焉。","book":"《尸子》：“中黄伯曰：余左执太行之獶而右搏雕虎。”又"},"example":{"text":"甬有耆旧，居仁由义，河山虽改，诗书不废。～，不异平地，深松茂柏，永无憔悴。","book":"清·黄宗羲《千秋王府君墓志铭》"},"usage":"作宾语、定语；用于凶险环境"},{"id":46302,"word":"雕虫刻篆","pinyin":"diāo chóng kè zhuàn","abbr":"dckz","explanation":"比喻词章小技。同“雕虫篆刻”。","source":{"text":"或问：‘吾子少而好赋？’曰：‘然。童子雕虫篆刻。’俄而曰：‘壮夫不为也。’","book":"汉·扬雄《法言·吾子》"},"example":{"text":"有日眉扬额点，且自～，我这里尽清闲。","book":"明·高濂《玉簪记·下第》"},"similar":["雕虫薄技","雕虫末伎","雕虫小技"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46303,"word":"雕虫小事","pinyin":"diāo chóng xiǎo shì","abbr":"dcxs","explanation":"犹言雕虫小技。","source":{"text":"而司文者考变雅之由，往往归咎于稹。尝以为雕虫小事，不足以自明。","book":"唐元稹《上令狐相公诗启》"},"similar":["雕虫小巧","雕虫小技","雕虫小艺"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46304,"word":"雕虫小巧","pinyin":"diāo chóng xiǎo qiǎo","abbr":"dcxq","explanation":"犹言雕虫小技。","source":{"text":"祜雕虫小巧，壮夫不为。","book":"宋·尤袤《全唐诗话·张祜》"},"similar":["雕虫末技","雕虫小技","雕虫小事"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46305,"word":"雕虫小技","pinyin":"diāo chóng xiǎo jì","abbr":"dcxj","explanation":"雕：雕刻；虫：指鸟虫书，古代汉字的一种字体。比喻小技或微不足道的技能。","source":{"text":"雕虫小技，我不如卿；国典朝章，卿不如我。","book":"《北史·李浑传》"},"example":{"text":"这些玩意儿，尽是些～，不过解闷消闲。我讲的是长枪大戟，东荡西驰的本领。","book":"清·文康《儿女英雄传》第十八回"},"similar":["雕虫篆刻"],"opposite":["雄才大略"],"usage":"作主语、宾语；指文字技巧","story":["唐朝时期，常州人薛登很有学问，知识面很广，每次与人谈话总要广征博引，把道理讲得透彻。他与当时的徐坚、刘子玄齐名。他对朝廷举贤取士过分推重辞赋不满，他引用李谔的话批评曹操父子三人只好雕虫小技、连篇累牍，而不重视其他才能"]},{"id":46306,"word":"雕虫小艺","pinyin":"diāo chóng xiǎo yì","abbr":"dcxy","explanation":"犹言雕虫小技。","source":{"text":"雕虫小艺，无累大道。","book":"南朝·梁·沈约《序》"},"example":{"text":"～，微或相许，至于此处，岂卿所及！","book":"《北史·张普惠传》"},"similar":["雕虫小技"],"opposite":["雄才大略"],"usage":"作宾语；作自谦文字卑陋之词"},{"id":46307,"word":"雕虫末伎","pinyin":"diāo chóng mò jì","abbr":"dcmj","explanation":"犹言雕虫小技。同“雕虫末技”。","source":{"text":"俟公破虏功成，当以向时雕虫末伎，作为铙歌鼓吹曲，以继《采芑》《江汉》之余响。","book":"明·唐顺之《答翁东厓总制书》"},"similar":["雕虫末技","雕虫小技"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46308,"word":"雕虫末技","pinyin":"diāo chóng mò jì","abbr":"dcmj","explanation":"犹言雕虫小技。亦作“雕虫末伎”。","source":{"text":"即诗赋一道，犹可以见贤人君子之用心，若遂薄之为雕虫末技，吾未见扬雄之《法言》、《太玄》可直驾《离骚》而上之。","book":"清·纳兰性德《赋论》"},"similar":["雕虫末伎","雕虫小巧","雕虫小技"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46309,"word":"雕虫篆刻","pinyin":"diāo chóng zhuàn kè","abbr":"dczk","explanation":"比喻词章小技。","source":{"text":"汉·扬雄《法言·吾子》：“或问：‘吾子少而好赋？’曰：‘然。童子雕虫篆刻。’俄而曰；‘壮夫不为也。’”按，“虫”指虫书，“刻”指刻符，各为一种字体。"},"example":{"text":"是以子云譬之～，云夫不为。","book":"南朝·梁·沈约《答陆厥问声韵书》"},"similar":["雕虫小技","雕虫小艺"],"usage":"作宾语、定语；比喻微不足道的技能"},{"id":46310,"word":"雕虫薄技","pinyin":"diāo chóng báo jì","abbr":"dcbj","explanation":"犹言雕虫小技。","source":{"text":"少日亲情，两家中表，羊车竞戏阶前，雕虫薄技，里塾又随肩。","book":"清·陈维崧《满庭芳·赠表兄万大士》词"},"similar":["雕虫小技","雕虫薄伎","雕虫末技"],"usage":"作主语、宾语、定语；指文字技巧"},{"id":46311,"word":"雕蚶镂蛤","pinyin":"diāo hān lòu gé","abbr":"dhlg","explanation":"雕、镂：雕刻；蚶：海产动物，肉味鲜美；蛤：蛤蜊。将蚶、蛤蜊刻意加工。指精致而好吃的食物。","source":{"text":"包凤烹龙，雕蚶镂蛤。","book":"《内典》言饭食之侈曰"}},{"id":46312,"word":"雕镂藻绘","pinyin":"diāo lòu zǎo huì","abbr":"dlzh","explanation":"比喻刻意修饰文辞。","source":{"text":"子云为此书，尝自拟《论语》……《论语》述圣人言行，犹天地之化，子云方且窃之焉，雕镂藻绘而蕲类之，其僭甚哉！","book":"明·方孝孺《读》"},"usage":"作谓语、宾语；用于作文等"},{"id":46313,"word":"雕阑玉砌","pinyin":"diāo lán yù qì","abbr":"dlyq","explanation":"形容富丽的建筑物。","source":{"text":"雕栏玉砌应犹在，只是朱颜老。","book":"南唐·李煜《虞美人》词"},"example":{"text":"但寒烟，满目飞蓬。～，空锁三十六离宫。","book":"宋·曾觌《金人捧露盘·庚寅岁春奉使过京师·感怀作》"}},{"id":46314,"word":"雕风镂月","pinyin":"diāo fēng lòu yuè","abbr":"dfly","explanation":"刻意吟风弄月。","source":{"text":"是使骚人雕风镂月，总是拈花，释子说乘参宗，无非梦草。","book":"明·张煌言《梅岭山居诗引》"},"similar":["吟风咏月"],"usage":"作谓语、宾语；用于文人等"},{"id":46315,"word":"雕龙画凤","pinyin":"diāo lóng huà fèng","abbr":"dlhf","explanation":"刻绘龙凤。","source":{"text":"门上雕龙画凤，粉壁衬着红漆家具，分外耀眼。","book":"胡世香《巧取陈家寨》"},"example":{"text":"高台十丈白玉柱，～放光彩。","book":"《陕北民歌·十送》"},"similar":["雕龙刻凤"],"usage":"作谓语、定语；用于建筑等"},{"id":46316,"word":"雕龙绣虎","pinyin":"diāo lóng xiù hǔ","abbr":"dlxh","explanation":"比喻写作豪放雄健。","source":{"text":"桑民怿才名噪一时，几有雕龙绣虎之称。此卷为盛秋官书者，尤多生平得意语。","book":"明·王世贞《桑民怿》"}},{"id":46317,"word":"雨丝风片","pinyin":"yǔ sī fēng piàn","abbr":"ysfp","explanation":"形容春天的微风细雨。","source":{"text":"朝飞暮卷，云霞翠轩；雨丝风片，烟波画船——锦屏人忒看的这韶光贱！","book":"明·汤显祖《牡丹亭》第十出"},"example":{"text":"姐姐，人言道：‘酒落欢肠’。我与丈夫不能相见，～，刺断人肠久矣，怎能够下咽？","book":"明·董说《西游补》第五回"},"similar":["微风细雨"],"usage":"作宾语、定语；多指春景"},{"id":46318,"word":"雨井烟垣","pinyin":"yǔ jǐng yān yuán","abbr":"yjyy","explanation":"比喻荒凉、冷落的景象。","source":{"text":"明放着花楼酒榭，丢做个雨井烟垣。","book":"清·孔尚任《桃花扇·题画》"},"usage":"作宾语、定语；用于比喻句"},{"id":46319,"word":"雨僝云僽","pinyin":"yǔ chán yún zhòu","abbr":"ycyz","explanation":"指不好的天气把人折磨。","source":{"text":"清人梦魂，千里人长久，君知否？雨僝云僽，格调还依旧。","book":"宋·陈亮《点绛唇·咏梅月》词"},"usage":"作宾语、定语；用于书面语"},{"id":46320,"word":"雨僝风僽","pinyin":"yǔ chán fēng zhòu","abbr":"ycfz","explanation":"指风雨交相摧折。","source":{"text":"昨日春如，十三女儿学绣。一枝枝、不教花瘦。甚无情，便下得，雨僝风僽。向园林、铺作地衣红绉。","book":"宋·辛弃疾《粉蝶儿·和晋臣赋落花》词"},"similar":["雨僽风僝"],"usage":"作宾语、定语；用于书面语"},{"id":46321,"word":"雨僽风僝","pinyin":"yǔ zhòu fēng chán","abbr":"yzfc","explanation":"指风雨交相摧折。","source":{"text":"椿老萱衰，只恐雨僽风僝。","book":"元·柯丹邱《荆钗记·庆诞》"},"similar":["雨僝风僽"],"usage":"作宾语、定语；用于书面语"},{"id":46322,"word":"雨凑云集","pinyin":"yǔ còu yún jí","abbr":"ycyj","explanation":"比喻众多的人或事物聚集一处。","source":{"text":"汴泗秀士，星流电烛；徐阜严兵，雨凑云集。","book":"《宋书·袁淑传》"},"usage":"作定语、状语；用于书面语"},{"id":46323,"word":"雨卧风餐","pinyin":"yǔ wò fēng cān","abbr":"ywfc","explanation":"风口处吃饭，雨地里住宿。形容生活飘泊不定。","source":{"text":"风餐江柳下，雨卧驿楼边。","book":"唐·杜甫《舟中》诗"},"example":{"text":"不辞～里，可惜橙黄橘绿时。","book":"宋·杨万里《早炊童家店》诗"},"similar":["餐风露宿","雨宿风餐"],"usage":"作谓语、定语、宾语；指人的生活"},{"id":46324,"word":"雨后春笋","pinyin":"yǔ hòu chūn sǔn","abbr":"yhcs","explanation":"指春天下雨后，竹笋一下子就长出来很多。比喻事物迅速大量地涌现出来。","source":{"text":"荒林春雨足，新笋迸龙雏。","book":"宋·张耒《食笋》诗"},"example":{"text":"国内废科举，兴学校，好像～，努力学习西方。","book":"毛泽东《论人民民主专政》"},"similar":["漫山遍野","星罗棋布","比比皆是"],"opposite":["凤毛麟角","九牛一毛","硕果仅存"],"usage":"作定语、宾语；指新生事物"},{"id":46325,"word":"雨后送伞","pinyin":"yǔ hòu sòng sǎn","abbr":"yhss","explanation":"比喻事后献殷勤。也比喻帮助不及时。","source":{"text":"不见不见，前些日子朕要死不活的时候，别的阿哥都在这儿侍候，偏偏他［八阿哥］和朕一块病了，如今朕刚回过神儿来，他也好了。雨后送伞，献的哪门子假殷勤呢？","book":"二月河《康熙大帝》第四卷五十三"},"example":{"text":"～的事情时有发生。"},"opposite":["雪中送炭"],"usage":"作宾语、定语；指事后行为"},{"id":46326,"word":"雨宿风餐","pinyin":"yǔ sù fēng cān","abbr":"ysfc","explanation":"意指风口处吃饭，雨地里住宿。形容生活飘泊不定。","source":{"text":"祝融峰下两逢春，雨宿风餐老病身。莫笑五湖萍梗客，海边亦有未归人。","book":"宋·范成大《四明人董峄久居岳市乞诗》"},"similar":["雨卧风餐"],"usage":"作宾语、定语；用于生活"},{"id":46327,"word":"雨巾风帽","pinyin":"yǔ jīn fēng mào","abbr":"yjfm","explanation":"遮蔽风雨的头巾和帽子。常借指浪游之客。","source":{"text":"雨巾风帽，昔追游、谁念旧踪迹。","book":"宋·朱敦儒《感皇恩·游□□园感旧》词：“主人好事，坐客雨巾风帽。”宋·陈三聘《梦玉人引》词"},"usage":"作宾语、定语；用于书面语"},{"id":46328,"word":"雨帘云栋","pinyin":"yǔ lián yún dòng","abbr":"ylyd","explanation":"形容高敞华美的楼阁。","source":{"text":"傍湖开径，雨帘云栋，平地居仙子。","book":"唐·王勃《滕王阁》诗：“昼栋朝飞南浦云，朱帘暮卷西山雨。”宋·杨无咎《青玉案》词"},"example":{"text":"～深窈，歌笑霭春生。","book":"宋·徐宝之《水调歌·湘阴簿新居》词"},"similar":["雨栋风帘"],"usage":"作宾语、定语；用于书面语"},{"id":46329,"word":"雨恨云愁","pinyin":"yǔ hèn yún chóu","abbr":"yhyc","explanation":"①感觉上以为可以惹人愁怨的云和雨。②喻男女间离别之情。","source":{"text":"暗想当初，有多少、幽欢佳会，忌知聚散难期，翻成雨恨云愁。","book":"宋·王禹偁《点绛唇·感兴》词：“雨恨云愁，江南依旧称佳丽。水村渔市，一缕孤烟细。”宋·柳永《曲玉管》词"},"example":{"text":"宋·柳永《曲玉管》词：“暗想当初，有多少、幽欢佳会，岂知聚散难期，翻成～。”"},"usage":"作宾语、定语；用于书面语"},{"id":46330,"word":"雨愁烟恨","pinyin":"yǔ chóu yān hèn","abbr":"ycyh","explanation":"烟雨所引起的人的惆怅哀愁。","source":{"text":"西湖游子，惯识雨愁烟恨。只恐吴娃暗折赠。耿耿。柔丝容易萦损。","book":"宋·史达祖《隔浦莲·荷花》词"},"usage":"作宾语、定语；用于书面语"},{"id":46331,"word":"雨意云情","pinyin":"yǔ yì yún qíng","abbr":"yyyq","explanation":"比喻男女间的爱情。","source":{"text":"雨意云情，酒心花态，孤负高阳客。","book":"宋·柳永《倾杯乐》词"},"example":{"text":"～两罢休，无端懊恼触心头。","book":"明·施耐庵《水浒全传》第二十一回"}},{"id":46332,"word":"雨打梨花","pinyin":"yǔ dǎ lí huā","abbr":"ydlh","explanation":"比喻零乱不堪的狼狈情景。","source":{"text":"张君瑞，想是你分浅缘悭，雨打梨花深闭门。","book":"明·崔时佩《西厢记·回春柬药》"},"example":{"text":"他的这个样子让我想起～的模样。"},"usage":"作宾语、定语；用于比喻句"},{"id":46333,"word":"雨打风吹","pinyin":"yǔ dǎ fēng chuī","abbr":"ydfc","explanation":"原指花木遭受风雨摧残。比喻恶势力对弱小者的迫害。也比喻严峻的考验。","source":{"text":"不如醉里风吹尽，可忍醒时雨打稀。","book":"唐·杜甫《三绝句》"},"example":{"text":"舞榭歌台，风流总被～去。","book":"宋·辛弃疾《永遇乐·京口北固亭怀古》词"},"similar":["风吹雨打"],"usage":"作宾语、定语；指考验"},{"id":46334,"word":"雨收云散","pinyin":"yǔ shōu yún sàn","abbr":"ysys","explanation":"比喻某种现象已经消失。","source":{"text":"惆怅年华暗换。黯销魂、雨收云散。","book":"宋·陆游《水龙吟·春日游摩诃池》词"},"example":{"text":"刚待～后，凶徒恶党又依然。","book":"元·无名氏《碧桃花》第三折"},"similar":["雨歇云收"],"usage":"作宾语、定语；用于书面语"},{"id":46335,"word":"雨散云收","pinyin":"yǔ sàn yún shōu","abbr":"ysys","explanation":"①比喻亲朋离散。② 指雨后转晴。","source":{"text":"当时心事已相关，雨散云收一饷间，便是孤帆从此去，不堪重上望夫山。","book":"唐·温庭筠《送崔郎中赴幕》诗：“心游目送三千里，雨散云收二十年。”唐·慎氏《感夫诗》"},"example":{"text":"不多时候，忽然～，推出一轮红日，顷刻黄河解冻。","book":"清·钱彩《说岳全传》第十八回"},"similar":["雨散云飞"],"usage":"作宾语、定语；用于书面语"},{"id":46336,"word":"雨散云飞","pinyin":"yǔ sàn yún fēi","abbr":"ysyf","explanation":"比喻离散。","source":{"text":"刘郎相约事难谐，雨散云飞自此乖。","book":"唐·白居易《五年秋病后独宿香山寺三绝句》之二：“饮徒歌伴今何在，雨散云飞尽不回。”唐·司空图《游仙诗》之二"},"similar":["雨散风流"],"usage":"作宾语、定语；用于比喻句"},{"id":46337,"word":"雨散风流","pinyin":"yǔ sàn fēng liú","abbr":"ysfl","explanation":"比喻离散。","source":{"text":"余年二十游嘉禾，禾中好友良独多……可怜一别十三载，雨散风流竟安在。","book":"清·方文《送钱而介归槜李》诗"},"similar":["雨散云飞"],"usage":"作宾语、定语；用于比喻句"},{"id":46338,"word":"雨断云销","pinyin":"yǔ duàn yún xiāo","abbr":"ydyx","explanation":"比喻男女恩情断绝。","source":{"text":"归期莫负青笺约。雨断云销，总是初情薄。","book":"宋·石孝友《醉落魄》词"},"usage":"作宾语、定语；用于书面语"},{"id":46339,"word":"雨旸时若","pinyin":"yǔ yáng shí ruò","abbr":"yysr","explanation":"指晴雨适时，气候调和。","source":{"text":"雨旸时若在仁君，鼎鼐调和有大臣。","book":"语本《书·洪范》：“曰肃，时雨若；曰乂，时旸若。”元·马致远《荐福碑》第二折"},"example":{"text":"清·薛福成《代李伯相再答朝鲜国相李裕元书》：“所幸入夏以来，～。”"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":46340,"word":"雨昫时若","pinyin":"yǔ yáng shí ruò","abbr":"yysr","explanation":"指晴雨适时，气候调和。"},{"id":46341,"word":"雨条烟叶","pinyin":"yǔ tiáo yān yè","abbr":"ytyy","explanation":"雨中的柳条，烟雾中的柳叶。形容凄迷的景色。亦比喻情意的缠绵。","source":{"text":"秾蛾叠柳脸红莲。多少雨条烟叶恨，红泪离筵。","book":"宋·晏殊《浣溪沙》词：“只有醉吟宽别恨，不须朝暮促归程。雨条烟叶系人情。”宋·晏几道《浪淘沙·丽曲醉思仙》词"},"example":{"text":"宋·晏幾道《浪淘沙·丽曲醉思仙》词：“秾蛾叠柳脸红莲。多少～恨，红泪离筵。”"},"usage":"作宾语、定语；用于比喻句"},{"id":46342,"word":"雨栋风帘","pinyin":"yǔ dòng fēng lián","abbr":"ydfl","explanation":"形容高敞华美的楼阁。","source":{"text":"昼栋朝飞南浦云，朱帘暮卷西山雨。","book":"唐·王勃《滕王阁》诗"},"example":{"text":"贝阙珠宫开水府，～岂来处。","book":"宋·黄庭坚《宫亭湖》诗"},"similar":["雨帘云栋"],"usage":"作宾语、定语；用于书面语"},{"id":46343,"word":"雨横风狂","pinyin":"yǔ héng fēng kuáng","abbr":"yhfk","explanation":"又猛又急的大风雨。比喻声势浩大，发展急速而猛烈。","source":{"text":"雨横风狂三月暮，门掩黄昏，无计留春住。","book":"宋·欧阳修《蝶恋花》词"},"example":{"text":"春事匆匆。花慵柳困，～。寄语诗人，须烧银烛，与照红妆。","book":"宋·郭应祥《柳梢青·惜花》词"}},{"id":46344,"word":"雨歇云收","pinyin":"yǔ xiē yún shōu","abbr":"yxys","explanation":"比喻男女离散。","source":{"text":"止望待天长地久，谁承望雨歇云收。","book":"元·关汉卿《金线池》第二折：“明知道雨歇云收，还指望待天长地久。”元·无名氏《百花亭》第二折"},"similar":["雨收云散"],"usage":"作宾语、定语；用于比喻句"},{"id":46345,"word":"雨沐风餐","pinyin":"yǔ mù fēng cān","abbr":"ymfc","explanation":"形容在外奔走劳苦，生活不得安定。","source":{"text":"人归人去我何心，雨沐风餐人自老。","book":"宋·刘宰《石翁姥》诗"},"similar":["餐风露宿","栉风沐雨"],"usage":"作谓语、宾语、定语；形容在外奔走劳苦"},{"id":46346,"word":"雨沾云惹","pinyin":"yǔ zhān yún rě","abbr":"yzyr","explanation":"指男女情爱。","source":{"text":"昔者先王尝游高唐，怠而昼寝，梦见一妇人，曰：‘妾，巫山之女也，为高唐之客，闻君游高唐，原荐枕席。’王因幸之。去而辞曰：‘妾在巫山之阳，高丘之阻，旦为朝云，暮为行雨，朝朝暮暮，阳台之下。’","book":"战国·楚·宋玉《高唐赋》"},"example":{"text":"弋槛营中夜未央，～侍襄王。","book":"唐·杜牧《羊栏浦夜陪宴会》诗"},"usage":"作宾语、定语；用于书面语"},{"id":46347,"word":"雨泣云愁","pinyin":"yǔ qì yún chóu","abbr":"yqyc","explanation":"泪下如雨，愁多如云。形容忧愁深重。","source":{"text":"虽然道姻缘不偶，我可一言难就，有多少雨泣云愁。","book":"元·杨显之《潇湘雨》第一折"},"usage":"作宾语、定语；用于比喻句"},{"id":46348,"word":"雨泽下注","pinyin":"yǔ zé xià zhù","abbr":"yzxz","explanation":"雨水往下流。","source":{"text":"百年老屋，尘泥渗漉，雨泽下注。","book":"明·归有光《项脊轩志》"},"similar":["雨下如注"],"usage":"作谓语；指下大雨"},{"id":46349,"word":"雨消云散","pinyin":"yǔ xiāo yún sàn","abbr":"yxys","explanation":"比喻消失得一干二净。","source":{"text":"情爱呢？，可知，这甜情蜜意，禁不起——理性一闪，迟早是——雨消云散。","book":"瞿秋白《赤都心史》八"},"similar":["烟消云散"],"usage":"作谓语、宾语、状语；用于书面语"},{"id":46350,"word":"雨淋日晒","pinyin":"yǔ lín rì shài","abbr":"ylrs","explanation":"雨水淋浇，太阳曝晒。亦形容露天劳作或旅途的辛苦。","source":{"text":"［姚长庚］多少年来，雨淋日晒，脸比石头还粗。","book":"杨朔《三千里江山》第一段"},"similar":["日晒雨淋"],"usage":"作宾语、定语；用于口语"},{"id":46351,"word":"雨淋日炙","pinyin":"yǔ lín rì zhì","abbr":"ylrz","explanation":"炙：烤。雨里淋，太阳晒。形容旅途或野外工作的辛苦。","source":{"text":"雨淋日炙野火燎，鬼物守护烦撝呵。","book":"唐·韩愈《石鼓歌》"},"similar":["日晒雨淋"],"usage":"作宾语、定语；指野外"},{"id":46352,"word":"雨窟云巢","pinyin":"yǔ kū yún cháo","abbr":"ykyc","explanation":"窟：穴洞；巢：窝。指男女暗中幽会的场所。","source":{"text":"外人不知呵，都只说殢君王是我这庸姿劣貌。那知道恋欢娱，别有个雨窟云巢！请陛下早出视朝，妾在此候驾回宫者。","book":"清·洪昇《长生殿·絮阁》"}},{"id":46353,"word":"雨笠烟蓑","pinyin":"yǔ lì yān suō","abbr":"ylys","explanation":"防雨用的蓑衣笠帽，为渔夫的衣饰。亦借指渔夫。","source":{"text":"念丹霞秋冷，风巾雾屦，五湖春暖，雨笠烟蓑。","book":"宋·刘过《沁园春·咏别》词"},"example":{"text":"从今稳作城东客，～不用将。","book":"明·李东阳《得匏安观造雨□诗辄次韵》"},"similar":["雨蓑烟笠"],"usage":"作宾语、定语；用于书面语"},{"id":46354,"word":"雨约云期","pinyin":"yǔ yuē yún qī","abbr":"yyyq","explanation":"指男女约会。","source":{"text":"我呵，怕什么天翻地覆，就顺着他雨约云期。","book":"元·关汉卿《望江亭》第一折"},"example":{"text":"～，楚台巫峡。","book":"明·李日华《南西厢记·乘游逾垣》"},"usage":"作宾语、定语；用于书面语"},{"id":46355,"word":"雨膏烟腻","pinyin":"yǔ gāo yān nì","abbr":"ygyn","explanation":"指花草树木在烟雨中显得肥腴润泽。","source":{"text":"艳杏夭桃，垂杨芳草，各斗雨膏烟腻。","book":"宋·柳永《剔银灯》词"},"usage":"作宾语、定语；用于书面语"},{"id":46356,"word":"雨蓑烟笠","pinyin":"yǔ suō yān lì","abbr":"ysyl","explanation":"防雨用的蓑衣笠帽，为渔夫的衣饰。亦借指渔夫。","source":{"text":"一叶飘然任浪吹，雨蓑烟笠肯忘机。","book":"唐·翁洮《渔者》诗"},"example":{"text":"～傍渔矶，应不是、封侯相。","book":"宋·陆游《一落索·识破浮生虚妄》"},"similar":["雨蓑风笠"],"usage":"作宾语、定语；用于书面语"},{"id":46357,"word":"雨蓑风笠","pinyin":"yǔ suō fēng lì","abbr":"ysfl","explanation":"防雨用的蓑衣笠帽，为渔夫的衣饰。亦借指渔夫。","source":{"text":"天教狂虏灰飞。更莫问儿郎存血衣。把雪裘霜帽，绝交楚徼，雨蓑风笠，投老吴矶。","book":"宋·李曾伯《沁园春·丙辰归里和八窗叔韵》词"},"similar":["雨蓑烟笠"],"usage":"作宾语、定语；用于书面语"},{"id":46358,"word":"雨覆云翻","pinyin":"yǔ fù yún fān","abbr":"yfyf","explanation":"比喻变化无常。","source":{"text":"黄花白发，又匆匆佳节，感今怀昔。雨覆云翻无限态，故国寒烟榛棘。","book":"明·陶宗仪《念奴娇·九日有感》词"},"usage":"作宾语、定语；用于书面语"},{"id":46359,"word":"雨踪云迹","pinyin":"yǔ zōng yún jì","abbr":"yzyj","explanation":"比喻男女情好的往事。","source":{"text":"清宵寂，香闺隔。好梦难寻，雨踪云迹。忆忆忆。","book":"宋·曾觌《清商怨》词"},"similar":["雨迹云踪"],"usage":"作宾语、定语；用于书面语"},{"id":46360,"word":"雨过天晴","pinyin":"yǔ guò tiān qíng","abbr":"ygtq","explanation":"雨后转晴。也比喻政治上由黑暗到光明。","source":{"text":"御批云：‘雨过天青云破处，这般颜色做将来。’","book":"明·谢肇涮《文海披沙记》"},"example":{"text":"～的早晨，空气清新极了。"},"similar":["雨后初霁","云开日出","云消雾散"],"opposite":["彤云密布","天昏地暗","大雨如注"],"usage":"作谓语、定语；指天气或局势"},{"id":46361,"word":"雨过天青","pinyin":"yǔ guò tiān qīng","abbr":"ygtq","explanation":"雨后转晴。也比喻政治上由黑暗到光明。","source":{"text":"御批云：‘雨过天青云破处，这般颜色做将来。’","book":"明·谢肇涮《文海披沙记》"},"example":{"text":"那个软烟罗只有四样颜色：一样～，一样秋色香，一样松绿的，一样就是银红的。","book":"清·曹雪芹《红楼梦》第四十回"},"similar":["雨过天晴"],"opposite":["大雨如注"],"usage":"作谓语、定语；指局势"},{"id":46362,"word":"雨迹云踪","pinyin":"yǔ jì yún zōng","abbr":"yjyz","explanation":"云和雨的踪迹。比喻往事。","source":{"text":"可惜当年，顿乖雨迹云踪。","book":"宋·柳永《雪梅香》"},"example":{"text":"非远，那～才一转，敢依花傍柳还重现。","book":"明·汤显祖《牡丹亭·寻梦》"},"usage":"作宾语、定语；比喻男女情好的往事"},{"id":46363,"word":"雨零星乱","pinyin":"yǔ líng xīng luàn","abbr":"ylxl","explanation":"残败零落貌。常用以比喻溃败。","source":{"text":"王矮虎、一丈青赶了一直，赶不上，呼延灼自投东北上去了。杀的大败亏输，雨零星乱。","book":"明·施耐庵《水浒传》第五十七回"},"similar":["雨零星散"],"usage":"作定语、状语；用于书面语"},{"id":46364,"word":"雨零星散","pinyin":"yǔ líng xīng sàn","abbr":"ylxs","explanation":"残败零落貌。常用以比喻溃败。","source":{"text":"［张清、王英］杀散左哨军兵，如摧枯拉朽的直冲进来，杀得贼兵四分五裂，七断八续，雨零星散，乱窜奔逃。","book":"明·施耐庵《水浒传》第一百九回"},"similar":["雨零星乱"],"usage":"作定语、状语；用于书面语"},{"id":46365,"word":"雨露之恩","pinyin":"yǔ lù zhī ēn","abbr":"ylze","explanation":"滋生万物的雨露的恩情。比喻恩泽、恩情。","source":{"text":"望切者，若云霓之望；思深者，如雨露之恩。","book":"唐·刘禹锡《苏州谢上表》：“江海远地，孤危小臣。虽雨露之恩，幽遐必被；而犬马之恋，亲近为荣。”明·程登吉《幼学琼林·天文》"},"example":{"text":"圣德之君，泽及枯骨，何况我等人民，不沾～。","book":"明·许仲琳《封神演义》第二十三回"},"usage":"作宾语；用于比喻句"},{"id":46366,"word":"雨霾风障","pinyin":"yǔ mái fēng zhàng","abbr":"ymfz","explanation":"指狂恶的风雨。","source":{"text":"尽敛却、雨霾风障，雾沈云暝。远岫四呈青欲滴，长空一抹明于镜。","book":"宋·吴潜《满江红·九日郊行》词"},"similar":["狂风暴雨"],"usage":"作宾语、定语；用于书面语"},{"id":46367,"word":"雨顺风调","pinyin":"yǔ shùn fēng tiáo","abbr":"ysft","explanation":"调：调和；顺：和协。风雨及时适宜。形容风雨适合农时。","source":{"text":"既而克殷，风凋雨顺。","book":"《六韬》"},"example":{"text":"我愿天公怜赤子，莫生尤物为疮痏。～百谷登，民不饥寒为上瑞。","book":"宋·苏轼《荔枝叹》诗"},"similar":["风调雨顺"],"opposite":["赤地千里","暴风骤雨"],"usage":"作宾语、定语；指天气及局势等"},{"id":46368,"word":"雨鬓风鬟","pinyin":"yǔ bìn fēng huán","abbr":"ybfh","explanation":"妇女发髻散乱的样子。","source":{"text":"正洞庭归客，憔悴思还。牧羊龙女，恰相逢、雨鬓风鬟。","book":"清·陈维崧《潇湘逢故人慢·题余氏女子绣柳毅传书图为阮亭赋》词"},"similar":["风鬟雨鬓"],"usage":"作定语；用于女性"},{"id":46369,"word":"雨鬣霜蹄","pinyin":"yǔ liè shuāng tí","abbr":"ylst","explanation":"形容骏马奔驰时马鬃耸起，状如飘雨，四蹄飞翻，色白如霜。","source":{"text":"阴山铁骑千千匹，雨鬣霜蹄神鬼出。","book":"元·吴澄《八骏图》诗"},"usage":"作宾语、定语；指骏马"},{"id":46370,"word":"雪上加霜","pinyin":"xuě shàng jiā shuāng","abbr":"xsjs","explanation":"比喻接连遭受灾难，损害愈加严重。","source":{"text":"饶你道有什么事，犹是头上着头，雪上加霜。","book":"宋·释道原《景德传灯录》卷十九"},"example":{"text":"正在惊慌，偏又转了迎面大风，真是～。","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["祸不单行","避坑落井"],"opposite":["双喜临门","锦上添花"],"usage":"作谓语、宾语、分句；指灾难深重"},{"id":46371,"word":"雪中送炭","pinyin":"xuě zhōng sòng tàn","abbr":"xzst","explanation":"在下雪天给人送炭取暖。比喻在别人急需时给以物质上或精神上的帮助。","source":{"text":"不是雪中须送炭，聊装风景要诗来。","book":"宋·范成大《大雪送炭与芥隐》诗"},"example":{"text":"对于他们，第一步需要还不是“锦上添花”，而是“～”。","book":"毛泽东《在延安文艺座谈会上的讲话》"},"similar":["雪里送炭"],"opposite":["落井下石","投井下石"],"usage":"作谓语、宾语、定语；指帮助及时","story":["南宋时期，著名的诗人范成大一生写了许多脍炙人口的诗歌，深受人们的喜爱，晚年退居故乡石湖，自号石湖居士，他著作被编为《石湖居士诗集》，其中有一首《大雪送炭与芥隐》诗：“不是雪中须送炭，聊装风景要诗来。”"]},{"id":46372,"word":"雪中高士","pinyin":"xuě zhōng gāo shì","abbr":"xzgs","explanation":"梅花","source":{"text":"雪满山中高士卧，月明林下美人来。","book":"明·高启《梅花》诗"},"usage":"作主语、宾语、定语；指梅花"},{"id":46373,"word":"雪中鸿爪","pinyin":"xuě zhōng hóng zhǎo","abbr":"xzhz","explanation":"比喻往事遗留的痕迹。同“雪泥鸿爪”。","source":{"text":"万象雪中鸿爪，一过已忘情。","book":"清·陈维菘《水调歌头·题友人词并示方邺大匡》词"},"similar":["雪鸿指爪","雪泥鸿迹"],"usage":"作宾语、定语；用于书面语"},{"id":46374,"word":"雪兆丰年","pinyin":"xuě zhào fēng nián","abbr":"xzfn","explanation":"指冬天大雪是来年丰收的预兆。","source":{"text":"清·李汝珍《镜花缘》第三回：“古人云：‘雪兆丰年。’朕才登极，就得如此佳兆，明岁自然五谷丰登，天下太平"},"similar":["瑞雪兆丰年"],"usage":"作宾语、定语；用于书面语"},{"id":46375,"word":"雪北香南","pinyin":"xuě běi xiāng nán","abbr":"xbxn","explanation":"多雪的北方和花木飘香的南方。"},{"id":46376,"word":"雪压霜欺","pinyin":"xuě yā shuāng qī","abbr":"xysq","explanation":"比喻备受折磨。","source":{"text":"问平生、雪压霜欺，得似老枝擎独。","book":"宋·吴潜《疏影》词"},"example":{"text":"东君也不爱惜，～。","book":"宋·李邴《汉宫春》词"},"usage":"作宾语、定语；用于书面语"},{"id":46377,"word":"雪后始知松柏操","pinyin":"xuě hòu shǐ zhī sōng bǎi cāo","abbr":"xhszsbc","explanation":"冰天雪地，才显出松柏的高尚节操。比喻只有在危难之时，才能考验一个人的品德和节操。","source":{"text":"雪后始知松柏操，云收方见济河分。","book":"宋·释普济《五灯会元》卷十四"}},{"id":46378,"word":"雪天萤席","pinyin":"xuě tiān yíng xí","abbr":"xtyx","explanation":"比喻不分寒暑，刻苦读书。","source":{"text":"雪天萤席几辛勤，同志当时四五人。","book":"唐·罗隐《湖上岁暮感怀有寄友人》诗"},"similar":["雪窗萤几","雪案萤窗"],"usage":"作宾语、定语；用于书面语"},{"id":46379,"word":"雪恨消灾","pinyin":"xuě hèn xiāo zāi","abbr":"xhxz","explanation":"雪：洗除。洗雪仇恨，消除灾祸","source":{"text":"望爷爷与我们雪恨消灾，早进城降邪从正也。","book":"明·吴承恩《西游记》第44回"},"usage":"作谓语、定语；用于书面语"},{"id":46380,"word":"雪操冰心","pinyin":"xuě cāo bīng xīn","abbr":"xcbx","explanation":"志行品德高尚纯洁。"},{"id":46381,"word":"雪月风花","pinyin":"xuě yuè fēng huā","abbr":"xyfh","explanation":"①代指四时景色。②比喻男女情事。","source":{"text":"古往今来题咏多，雪月风花事事可。","book":"元·贯云石《粉蝶花》套曲"},"example":{"text":"元·李日华《南西厢记·对月琴红》：“～寻笑耍，两家休作是非堆。”"},"similar":["风花雪月"],"usage":"作主语、宾语、定语；用于书面语"},{"id":46382,"word":"雪案萤灯","pinyin":"xuě àn yíng dēng","abbr":"xayd","explanation":"比喻勤学苦读。同“雪窗萤几”。","source":{"text":"送朝昏雪案萤灯，三绝韦编。","book":"元·鲜于必仁《折桂令·书》曲"},"similar":["雪案萤窗","雪窗萤几"],"usage":"作宾语、定语；用于比喻句"},{"id":46383,"word":"雪案萤窗","pinyin":"xuě àn yíng chuāng","abbr":"xayc","explanation":"比喻勤学苦读。同“雪窗萤几”。","source":{"text":"小生年长二十五岁，雪案萤窗，苦攻经史，博古通今。","book":"元·吴昌龄《张天师》第一折：“［小生］雪案萤窗，辛勤十载，淹通诸史，贯串百家。”元·白朴《东墙记》楔子"},"example":{"text":"大相公一向奋志云程鹗荐,埋头～，手不释卷，口不绝吟。","book":"明·徐霖《绣襦记·正学求君》"},"similar":["雪窗萤几","雪案萤灯"],"usage":"作宾语、定语；用于比喻句"},{"id":46384,"word":"雪泥鸿爪","pinyin":"xuě ní hóng zhǎo","abbr":"xnhz","explanation":"雪泥：融化着雪水的泥土。大雁在雪泥上踏过留下的爪印。比喻往事遗留的痕迹。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。","book":"宋·苏轼《和子由渑池怀旧》诗"},"example":{"text":"～，惟留一幅悲怆之影于吾汉族历史之中，良可慨已。","book":"清·陶宗佑《中国文学之概观》"},"similar":["飞鸿踏雪","飞鸿雪爪"],"usage":"作主语、宾语；指往事遗留的痕迹","story":["宋朝时期，苏轼与苏辙兄弟曾在渑池一寺院住过，与寺院老和尚关系很好，并在寺内墙上题诗。后苏轼故地重游作《和子由渑池怀旧》诗大发感慨：“人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。”"]},{"id":46385,"word":"雪泥鸿迹","pinyin":"xuě ní hóng jì","abbr":"xnhj","explanation":"比喻往事遗留的痕迹。同“雪泥鸿爪”。","source":{"text":"去年曾记深宵语，也算雪泥鸿迹。","book":"清·冯珍《摸鱼子·寄戴受兹》词"},"similar":["雪鸿指爪"],"usage":"作宾语、定语；用于书面语"},{"id":46386,"word":"雪海冰山","pinyin":"xuě hǎi bīng shān","abbr":"xhbs","explanation":"形容冰雪漫天盖地，天气极其寒冷。","example":{"text":"我受不了这～的环境。"},"usage":"作宾语、定语；指寒冷天气"},{"id":46387,"word":"雪爪鸿泥","pinyin":"xuě zhǎo hóng ní","abbr":"xzhn","explanation":"大雁在雪泥上踏过留下的爪印。比喻往事遗留的痕迹。","source":{"text":"人生到处知何似，应似飞鸿踏雪泥。泥上偶然留指爪，鸿飞那复计东西。","book":"宋·苏轼《和子由渑池怀旧》诗"}},{"id":46388,"word":"雪牖萤窗","pinyin":"xuě yǒu yíng chuāng","abbr":"xyyc","explanation":"雪牖：指晋朝孙康映雪读书的典故；萤窗：指晋朝车胤囊萤读书的典故。比喻贫穷苦读。","source":{"text":"披经阅史，无怠于光阴；雪牖萤窗，每加于悬刺。","book":"唐·顾云《上池州庾员外启》"}},{"id":46389,"word":"雪碗冰瓯","pinyin":"xuě wǎn bīng ōu","abbr":"xwbo","explanation":"瓯：盆碗之类的器皿。形容碗、盆器皿洁白干净。也比喻诗文清雅。","source":{"text":"葛中羽扇吾方健，雪碗冰瓯子句清。","book":"宋·范成大《次韵甄云卿晚登浮丘亭》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":46390,"word":"雪窑冰天","pinyin":"xuě jiào bīng tiān","abbr":"xybt","explanation":"到处是冰和雪。指严寒地区。","source":{"text":"叹马角之未生，魂销支窑；攀龙髯而莫逮，泪洒冰天。","book":"《宋史·朱弁传》"}},{"id":46391,"word":"雪窖冰天","pinyin":"xuě jiào bīng tiān","abbr":"xjbt","explanation":"窖：收藏东西的地洞。到处是冰和雪。形容天气寒冷，也指严寒地区。","source":{"text":"叹马角之未生，魂销雪窖；攀龙髯而莫逮，泪洒冰天。","book":"《宋史·朱弁传》"},"example":{"text":"今日荷戈边塞去，可堪雪窖复冰天。","book":"清·黄遵宪《归过日本志感》诗"},"similar":["冰天雪窖"],"usage":"作宾语、定语；指严寒地区"},{"id":46392,"word":"雪窗萤几","pinyin":"xuě chuāng yíng jǐ","abbr":"xcyj","explanation":"比喻勤学苦读。","source":{"text":"家贫不常得油，夏月则练囊盛数十萤火以照书，以夜继日焉。","book":"《文选·任昉〈为萧扬州作荐士表〉“集萤映雪”李善注引《孙氏世录》：“孙康家贫，常映雪读书。”《晋书·车胤传》"},"similar":["雪案萤窗","雪案萤灯"],"usage":"作宾语、定语；用于比喻句"},{"id":46393,"word":"雪窗萤火","pinyin":"xuě chuāng yíng huǒ","abbr":"xcyh","explanation":"比喻勤学苦读。同“雪窗萤几”。","source":{"text":"投至得云路鹏程九万里，先受了雪窗萤火十二年。","book":"元·王实甫《西厢记》第一本第一折"},"example":{"text":"卑人～，曾苦志于三冬；云路鹏程，未雄飞于万里。","book":"明·汪廷讷《狮吼记·叙别》"},"similar":["雪窗萤几","雪案萤窗"],"usage":"作宾语、定语；用于比喻句"},{"id":46394,"word":"雪耻报仇","pinyin":"xuě chǐ bào chóu","abbr":"xcbc","explanation":"雪：洗掉。洗掉耻辱，打击仇敌。亦作“报仇雪耻”。","source":{"text":"假若他不敢去用自己的血去雪耻报仇，他自己的子孙将也永远沉沦在地狱中。","book":"老舍《四世同堂》六四"},"similar":["报仇雪耻"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46395,"word":"雪肤花貌","pinyin":"xuě fū huā mào","abbr":"xfhm","explanation":"雪肤：皮肤白皙如雪；花貌：容颜美丽如花。形容女子貌美。","source":{"text":"中有一人字太真，雪肤花貌参差是。","book":"唐·白居易《长恨歌》"},"example":{"text":"宝髻盘云，蛾眉掠月，真个是～，素口蛮腰。","book":"清·张春帆《九尾龟》第六十四回"},"usage":"作宾语、定语；用于比喻句"},{"id":46396,"word":"雪胎梅骨","pinyin":"xuě tāi méi gǔ","abbr":"xtmg","explanation":"比喻高洁。","source":{"text":"小姐这等诗真有雪胎梅骨，冷韵幽香。","book":"清·李渔《怜香伴·香咏》"},"usage":"作宾语、定语；用于比喻句"},{"id":46397,"word":"雪虐冰饕","pinyin":"xuě nüè bīng tāo","abbr":"xnbt","explanation":"虐：暴虐；饕：贪残。又是刮风，又是下雪。形容天气非常寒冷。","source":{"text":"岁弊寒凶，雪虐风饕。","book":"唐·韩愈《祭河南张员外文》"}},{"id":46398,"word":"雪虐风饕","pinyin":"xuě nüè fēng tāo","abbr":"xnft","explanation":"虐：暴虐；饕：贪残。又是刮风，又是下雪。形容天气非常寒冷。","source":{"text":"岁弊寒凶，雪虐风饕。","book":"唐·韩愈《祭河南张员外文》"},"example":{"text":"幽香淡淡影疏疏，～亦自如。","book":"宋·陆游《雪中寻梅》诗"},"similar":["风雪交加"],"usage":"作谓语、定语；形容天气非常寒冷"},{"id":46399,"word":"雪里送炭","pinyin":"xuě lǐ sòng tàn","abbr":"xlst","explanation":"比喻在别人急需时给以物质上或精神上的帮助。同“雪中送炭”。","source":{"text":"破扇停秋，雪里送炭。","book":"唐·德行禅师《四字经·甲乙》"},"example":{"text":"～真难得，合作社比爹娘亲。","book":"甬剧《两兄弟》第一场"},"similar":["雪中送炭"],"usage":"作谓语、宾语、定语；指帮助及时"},{"id":46400,"word":"雪鬓霜毛","pinyin":"xuě bìn shuāng máo","abbr":"xbsm","explanation":"指老年人。同“雪鬓霜鬟”。","source":{"text":"只要他休泄露俺这萍跟浪脚，那知道翻断送他雪鬓霜毛。","book":"元·李寿卿《伍员吹萧》第四折"},"similar":["雪鬓霜鬟"],"usage":"作宾语、定语；用于比喻句"},{"id":46401,"word":"雪鬓霜鬟","pinyin":"xuě bìn shuāng huán","abbr":"xbsh","explanation":"白发。借指老年人。","source":{"text":"云情雨意，虽可抛两月之夫妻；雪鬓霜鬟，更不念八旬之父母。","book":"元本高明《琵琶记·伯喈夫妻分别》"},"similar":["雪鬓霜毛"],"usage":"作宾语、定语；用于比喻句"},{"id":46402,"word":"雪鸿指爪","pinyin":"xuě hóng zhǐ zhǎo","abbr":"xhzz","explanation":"比喻往事遗留的痕迹。同“雪泥鸿爪”。","source":{"text":"雪鸿指爪，又未知竟落何地也。","book":"明·王世贞《与徐子与书》之十五"},"similar":["雪泥鸿迹"],"usage":"作宾语、定语；用于书面语"},{"id":46403,"word":"零丁孤苦","pinyin":"líng dīng gū kǔ","abbr":"ldgk","explanation":"孤单困苦，无所依傍。","source":{"text":"臣少多疾病，九岁不行。零丁孤苦，至于成立。","book":"晋·李密《陈情表》"},"example":{"text":"他～，十分可怜。"},"similar":["孤苦伶仃"],"usage":"作谓语、定语；指无依无靠","story":["晋武帝统一全国后，推行“以孝治天下”，提倡孝敬父母，尊重老人。他想启用西蜀尚书郎李密，就下诏书任命李密为郎中。李密不愿出来做官，就写《陈情表》上书晋武帝，说自己的祖母形影相吊、孤苦伶仃，待伺候祖母后再出来做官"]},{"id":46404,"word":"零七八碎","pinyin":"líng qī bā suì","abbr":"lqbs","explanation":"形容又零碎又乱。也指零散而没有系统的事情或没有大用的东西。","source":{"text":"今天买皮鞋，明天买白帽子，书钱花得不多，零七八碎差一点没叫我破产。","book":"老舍《老张的哲学》"},"example":{"text":"你还是尽快把这些～的东西收起来。"},"similar":["杂乱无章"],"usage":"作定语、宾语；指杂碎"},{"id":46405,"word":"零七碎八","pinyin":"líng qī suì bā","abbr":"lqsb","explanation":"指零零碎碎的东西。","source":{"text":"两个新人的衣服被褥和零七碎八下来，三五十块钱根本不顶事。","book":"路遥《平凡的世界》第二卷第30章"},"similar":["零零碎碎"],"usage":"作宾语、定语；用于口语"},{"id":46406,"word":"零光片羽","pinyin":"líng guāng piàn yǔ","abbr":"lgpy","explanation":"比喻珍贵事物的一小部分。","source":{"text":"其所对北京内外记者所言，皆不过此三种政策之零光片羽，盖孙先生之乐观主义如此。","book":"黄远庸《记者眼光中之孙中山》其三"},"similar":["吉光片羽"],"usage":"作宾语、定语；用于比喻句"},{"id":46407,"word":"零圭断璧","pinyin":"líng guī duàn bì","abbr":"lgdb","explanation":"比喻残破不全的珍贵文物。","source":{"text":"积藓残碑，零圭断璧，重拂人间尘土。","book":"宋·吴文英《齐天乐·与冯深居登禹陵》词"},"usage":"作宾语、定语；用于比喻句"},{"id":46408,"word":"零打碎敲","pinyin":"líng dǎ suì qiāo","abbr":"ldsq","explanation":"形容以零零碎碎、断断续续的办法做事。","source":{"text":"这些话都不过是零敲碎打，信口诌成，也有书本上来的，也有庄家老说古的。","book":"明·贾凫西《木皮词·引子》"},"example":{"text":"我反正招也是死，不招也是死，不如痛痛快快地招了，倒死得干脆些，省得～白叫皮肉受苦！","book":"吴越《括苍山记恩仇》第五十回"},"similar":["零敲碎打"],"opposite":["一气呵成"],"usage":"作谓语、定语、宾语；指断断续续做事"},{"id":46409,"word":"零敲碎受","pinyin":"líng qiāo suì shòu","abbr":"lqss","explanation":"用于折磨人，使人不断遭受痛苦。","source":{"text":"将一把累世不磨的钝刀在你颈上锯来锯去，教你零敲碎受。","book":"清·西周生《醒世姻缘传》引起"}},{"id":46410,"word":"零敲碎打","pinyin":"líng qiāo suì dǎ","abbr":"lqsd","explanation":"形容以零零碎碎、断断续续的方式进行或处理。","source":{"text":"没有一省一县一区一乡的完整的规划，只是零敲碎打地在那里做。","book":"毛泽东《的序言一》"},"example":{"text":"我算了算，加上一次～的开销，数目不会小呵！","book":"沙汀《淘金记》"},"similar":["零打碎敲"],"opposite":["一气呵成"],"usage":"作谓语、定语、宾语；指不系统"},{"id":46411,"word":"零珠片玉","pinyin":"líng zhū piàn yù","abbr":"lzpy","explanation":"比喻零碎的却值得珍惜的事物。","source":{"text":"其下作者如零珠片玉，非无可喜，要非书法之正也。","book":"金·赵秉文《中大夫翰林学士承旨文献党公神道碑》"}},{"id":46412,"word":"零珠碎玉","pinyin":"líng zhū suì yù","abbr":"lzsy","explanation":"比喻零碎的却值得珍惜的事物。亦作“零珠断璧”、“零珠片玉”。","source":{"text":"零珠碎玉，被蕊宫仙子，撒向空抛。","book":"明·冯梦龙《喻世明言》第三十三卷"},"example":{"text":"旧年韵叟刻仔一部诗文，叫《一笠园同人全集》，再有几花～，不成篇幅，如楹联、匾额、印章、器铭、灯谜、酒令之类，一概豁脱好像可惜。","book":"清·韩邦庆《海上花列传》第四十"}},{"id":46413,"word":"零碎不全","pinyin":"líng suì bù quán","abbr":"lsbq","explanation":"指细碎不周全的事物等。","source":{"text":"只有感觉的材料十分丰富（不是零碎不全）和合乎实际（不是错觉），才能根据这样的材料造出正确的概念和论理来。","book":"毛泽东《实践论》"},"similar":["支离破碎","零七碎八"],"usage":"作谓语、定语；用于事物等"},{"id":46414,"word":"零落山丘","pinyin":"líng luò shān qiū","abbr":"llsq","explanation":"零落：凋零，比喻死亡。指死后埋葬在山丘上。","source":{"text":"生在华屋处，零落归山丘。","book":"三国 魏·曹植《箜篌引》"},"usage":"作谓语、定语；指死亡"},{"id":46415,"word":"零零散散","pinyin":"líng líng sǎn sǎn","abbr":"llss","explanation":"分布得很稀，不多。","source":{"text":"道路是凹凸不平的，柴屑粪渣，零零散散地散布在路上。","book":"方志敏《我从事革命斗争的略述》"},"example":{"text":"～的资料难以收集。"},"similar":["稀稀拉拉"],"opposite":["整整齐齐"],"usage":"作谓语、定语、状语；指杂乱稀少"},{"id":46416,"word":"零零星星","pinyin":"líng líng xīng xīng","abbr":"llxx","explanation":"零碎的，少量的。形容零散而不完整。","source":{"text":"元来于大郊见杨化零零星星收下好些包数银子，却不知有多少，心中动了火，思想要谋他的。","book":"明·凌濛初《初刻拍案惊奇》卷十四"},"example":{"text":"我听说还有雅座儿，好极了，就忙忙的叫人提掳着衣裳帽子，～连酒带菜都搬到雅座儿去。","book":"清·文康《儿女英雄传》第三十二回"},"similar":["零零散散","零零碎碎"],"usage":"作谓语、定语、宾语；指不完整的东西"},{"id":46417,"word":"零零碎碎","pinyin":"líng líng suì suì","abbr":"llss","explanation":"细碎的事物。","source":{"text":"还有平日做的打油诗、放屁诗，零零碎碎，一总都就了饭吃了。","book":"清·李汝珍《镜花缘》第22回"},"example":{"text":"请把这些～收拾好。"},"similar":["零七碎八","零零星星"],"opposite":["完完整整"],"usage":"作谓语、定语、宾语；指不完整的东西"},{"id":46418,"word":"雷令风行","pinyin":"léi lìng fēng xíng","abbr":"llfx","explanation":"犹言雷厉风行。象雷那样猛烈，象风那样快。比喻执行政策法令严厉迅速。也形容办事声势猛烈，行动迅速。","source":{"text":"雷令风行，极一时之盛。","book":"清·吴炽昌《客窗闲话初集·孝女》"},"similar":["雷厉风行","雷励风行"],"opposite":["拖泥带水"],"usage":"作谓语、定语、状语；指行动迅速"},{"id":46419,"word":"雷击墙压","pinyin":"léi jī qiáng yā","abbr":"ljqy","explanation":"形容来势猛烈。","source":{"text":"其刑罚繁而信，其诛杀猛而必，闇然如雷击之，如墙压之。","book":"汉·韩婴《韩诗外传》卷六"}},{"id":46420,"word":"雷动风行","pinyin":"léi dòng fēng xíng","abbr":"ldfx","explanation":"①指万物运动变化迅速。②比喻推行政令的严厉迅猛。","source":{"text":"雷动风行，日引月长，上益其侈，下成其私，其费尽出于人，人实何堪其弊？","book":"《易·复》：“复其见天地之心乎”三国·魏·王弼注：“天地虽大，富有万物，雷动风行，运化万变。”唐·白居易《人之困穷由君之奢欲策》"},"example":{"text":"历数攸归，大统以正，德威所及，～，浩浩荡荡，覃及无际。","book":"明·宋濂《送安南使臣杜舜卿序》"},"similar":["雷厉风行","雷励风行"],"opposite":["拖泥带水"],"usage":"作谓语、定语、状语；指行动迅速"},{"id":46421,"word":"雷励风行","pinyin":"léi lì fēng xíng","abbr":"llfx","explanation":"像雷那样猛烈，像风那样快。比喻声势猛烈，行动迅速","source":{"text":"今天调卷，明天提人，颇觉雷励风行。","book":"清·李宝嘉《官场现形记》第33回"},"similar":["雷厉风行"],"opposite":["拖泥带水"],"usage":"作宾语、定语、状语；指行动迅速"},{"id":46422,"word":"雷厉风行","pinyin":"léi lì fēng xíng","abbr":"llfx","explanation":"厉：猛烈。象雷那样猛烈，象风那样快。比喻执行政策法令严厉迅速。也形容办事声势猛烈，行动迅速。","source":{"text":"陛下即位以来，躬亲听断，旋乾转坤；关机阖开，雷厉风行。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"今天调卷，明天提人，颇觉～。","book":"清·李宝嘉《官场现形记》第三十三回"},"similar":["大张旗鼓","闻风而动"],"opposite":["积重难返","拖泥带水","和风细雨"],"usage":"作谓语、定语、状语；指行动迅速","story":["唐朝时期，国子博士韩愈因反对唐宪宗迎佛骨而被贬潮州刺史。他到任后写《潮州刺史谢上表》歌颂唐宪宗能够躬亲听政、旋乾转坤、机关阖开、雷厉风飞。唐宪宗觉得他很忠心就改授他为袁州刺史，后又调为国子祭酒"]},{"id":46423,"word":"雷厉风飞","pinyin":"léi lì fēng fēi","abbr":"llff","explanation":"①象雷那样猛烈，象风那样快。同“雷厉风行”。②严厉威猛。","source":{"text":"部下即位以来，躬亲听断，旋转乾坤，关机阖开，雷厉风飞。","book":"唐·韩愈《潮州刺史谢上表》"},"example":{"text":"不体圣天子抚绥元元之意，鹰扬虎噬，～。","book":"明·陶宗仪《辍耕录·阑驾上书》"},"usage":"作谓语、定语、状语；用于处事"},{"id":46424,"word":"雷同一律","pinyin":"léi tóng yī lǜ","abbr":"ltyl","explanation":"雷同：相互间的声音、说法大致相同；一律：本指同一音律，后指一样。多指诗文套用一种形式，毫无变化。","source":{"text":"异音者不可以一律，异形者不可合于一体。","book":"《礼记·曲礼上》：“毋剿说，毋雷同。”《淮南子·说林训》"},"example":{"text":"伸纸挥毫，～。","book":"清·王夫之《姜斋诗话·夕堂永日结论内编》"}},{"id":46425,"word":"雷嗔电怒","pinyin":"léi chēn diàn nù","abbr":"lcdn","explanation":"暴怒的样子。","source":{"text":"如今且说宝玉只当王夫人不过来搜检搜检，无甚大事，谁知竟这样雷嗔电怒的来了。","book":"清·曹雪芹《红楼梦》第七十七回"},"usage":"作定语、状语；用于盛怒"},{"id":46426,"word":"雷声大，雨点小","pinyin":"léi shēng dà，yǔ diǎn xiǎo","abbr":"lsdydx","explanation":"比喻做起事来声势造得很大，实际行动却很少。","source":{"text":"雷声甚大，雨点全无。","book":"宋·释道原《景德传灯录》卷二十八"},"example":{"text":"贼没廉耻的货，头里那等～，打哩乱哩，及到其间，也不怎么的。","book":"明·兰陵笑笑生《金瓶梅词话》第二十回"},"similar":["雷大雨小"],"usage":"作谓语、宾语、定语；指人做事"},{"id":46427,"word":"雷大雨小","pinyin":"léi dà yǔ xiǎo","abbr":"ldyx","explanation":"比喻说得多，做得少，声势很大，实效很小。","example":{"text":"这种事情都是～，不必那样认真。"},"similar":["雷声大雨点小"],"usage":"作宾语、定语；指没有实效"},{"id":46428,"word":"雷奔云谲","pinyin":"léi bēn yún jué","abbr":"lbyj","explanation":"如雷奔行，如云翻卷。","source":{"text":"今夫水之归壑也，其未至则澎濞汹涌，雷奔云谲，及至于壑则已矣。","book":"清·梅曾亮《陈拜乡诗序》"},"usage":"作谓语、定语；用于比喻句"},{"id":46429,"word":"雷惊电绕","pinyin":"léi jīng diàn rào","abbr":"ljdr","explanation":"雷鸣电闪。比喻落笔如飞的笔画。","source":{"text":"虽自九天分派，不与万李同林。步处雷惊电绕，空余翰墨窥寻。","book":"宋·何蘧《春渚纪闻·赵德麟跋太白帖》"},"usage":"作宾语、定语；用于比喻句"},{"id":46430,"word":"雷打不动","pinyin":"léi dǎ bù dòng","abbr":"ldbd","explanation":"形容态度坚定，不可动摇。也形容严格遵守规定，决不变更。","source":{"text":"每天的劳动可是雷打不动的，从下午两点一直要干到吃晚饭。","book":"路遥《平凡的世界》第一卷第二章"},"example":{"text":"他的决心是～的。"},"similar":["坚如磐石","坚韧不拔"],"opposite":["含冤负屈"],"usage":"作谓语、定语；形容态度坚定，不可动摇"},{"id":46431,"word":"雷电交加","pinyin":"léi diàn jiāo jiā","abbr":"ldjj","explanation":"又是打雷，又是闪电。交加：一起袭来。两种事物同时或错杂出现。","source":{"text":"忽然阴云四合，空中雷电交加，李三身上枷钮尽行脱落。","book":"明·凌濛初《二刻拍案惊奇》卷三十八"},"example":{"text":"是夜二更，风雨大作，～，喊杀之声，闻数十里。","book":"明·冯梦龙《喻世明言》第七卷"},"similar":["风雨交加"],"opposite":["风平浪静"],"usage":"作谓语、定语；形容风雨很大"},{"id":46432,"word":"雷腾云奔","pinyin":"léi téng yún bēn","abbr":"ltyb","explanation":"腾：跳跃。形容速度极快。","source":{"text":"雷腾云奔，百里一瞬。","book":"唐·柳宗元《兴州江运记》"}},{"id":46433,"word":"雷轰电掣","pinyin":"léi hōng diàn chè","abbr":"lhdc","explanation":"电掣：电光闪过。形容来势迅猛，使人猝不及防。","source":{"text":"腾腾烈焰，滚滚烟生。一会家地塌山崩，霎时间雷轰电掣。","book":"明·许仲琳《封神演义》第九十二回"},"example":{"text":"这一番话，象～，使方罗兰忽而攒眉，忽而苦笑，终于低垂了头。","book":"茅盾《动摇》九"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":46434,"word":"雷轰电转","pinyin":"léi hōng diàn zhuàn","abbr":"lhdz","explanation":"形容人马厉声呼叫。","source":{"text":"抵多少雷轰电转，可正是海沸也那河翻。","book":"清·洪昇《长生殿·合围》"}},{"id":46435,"word":"雷陈胶膝","pinyin":"léi chén jiāo qī","abbr":"lcjx","explanation":"雷陈：指东汉时的雷义和陈重。雷义和陈重的友谊比胶膝的粘合性还要牢。形容友谊深厚。","source":{"text":"义归，举茂才，让于陈重。刺史不听，义遂阳狂被发走，不应命。乡里为之语曰：‘胶膝自谓坚，不如雷与陈。’","book":"《后汉书·雷义传》"}},{"id":46436,"word":"雷霆万钧","pinyin":"léi tíng wàn jūn","abbr":"ltwj","explanation":"霆：急雷；钧：古代重量单位，三十斤为一钧。形容威力极大，无法阻挡。","source":{"text":"雷霆之所击，无不摧折者；万钧之所压，无不糜灭者。","book":"汉·贾山《至言》"},"example":{"text":"唯独共产主义的思想体系和社会制度正以排山倒海之势，～之力，磅礴于全世界，……","book":"毛泽东《新民主主义论》"},"similar":["排山倒海","雷厉风行","大张旗鼓"],"opposite":["和风细雨","温文尔雅","微乎其微"],"usage":"作宾语、定语；形容力量强大","story":["西汉时期，贾山写《至言》向汉文帝进谏，阐述广开言路的道理，他认为如广开言路，善于养士，则国家就会强大，好比“雷霆之所击，无不摧折者；万钧之所压，无不糜灭者。”","汉文帝读了觉得很有道理，确实可行，就听取他的意见广开言路"]},{"id":46437,"word":"雷霆之怒","pinyin":"léi tíng wàn j","abbr":"ltzn","explanation":"雷霆：霹雳。象霹雳一样的盛怒。形容愤怒到了极点。","source":{"text":"今不忍小忿，而发雷霆之怒，违垂堂之戒，轻万乘之重，此臣之所惑也。","book":"《三国志·吴志·陆逊传》"},"example":{"text":"主公暂息～，这牛皋是一员勇将，乃是岳飞的结义兄弟也。","book":"清·钱彩《说岳全传》第二十九回"},"similar":["大发雷霆"],"usage":"作宾语；指大怒","story":["公元229年，孙权称帝，国号吴，建都建业。魏国辽东太守公孙渊想与东吴结成同盟。孙权封他为燕王，没想到公孙渊出尔反尔，杀了吴国派去的使臣。孙权听后大发雷霆之怒，准备出兵渡海讨伐公孙渊，被大将陆逊等劝止"]},{"id":46438,"word":"雷鸣瓦釜","pinyin":"léi míng wǎ fǔ","abbr":"lmwf","explanation":"釜：锅。锅发出雷一般的响声。比喻无德无才的人占据高位，声势烜赫。","source":{"text":"黄钟毁弃，瓦釜雷鸣；谗人高张，贤士无名。","book":"战国·楚·屈原《楚辞·卜居》"},"example":{"text":"倩何人与问，～，甚黄钟哑？","book":"宋·辛弃疾《水龙吟·用瓢泉韵》"},"similar":["黄钟毁弃，瓦釜雷鸣"],"usage":"作宾语、定语；指庸人当权"},{"id":46439,"word":"雾兴云涌","pinyin":"wù xīng yún yǒng","abbr":"wxyy","explanation":"见“雾起云涌”。比喻众多的事物迅速出现。","source":{"text":"军兴以后，齐州学者，渐知以识时务，知四国为学中第一义，于是报馆雾兴云涌。","book":"梁启超《翠报叙》"},"similar":["雾起云涌"],"usage":"作谓语、定语；用于比喻句"},{"id":46440,"word":"雾惨云愁","pinyin":"wù cǎn yún chóu","abbr":"wcyc","explanation":"指一种悲壮苍凉的气氛。","source":{"text":"诸国将皆来助战，喊杀处雾惨云愁。","book":"元·安熙《仲冬初吉归途即事》诗：“雾惨云愁结暮阴，游方客子正悲吟。”元·无名氏《马陵道》第四折"},"example":{"text":"将遇将伤，兵逢兵死，直杀得天昏日暗，地裂烟飞，山崩海倒，～。","book":"清·钱彩《说岳全传》第二十七回"},"usage":"作宾语、定语；用于书面语"},{"id":46441,"word":"雾散云披","pinyin":"wù sàn yún pī","abbr":"wsyp","explanation":"比喻变化之快。","source":{"text":"武夫奋略，战士讲锐，电骇风驰，雾散云披。","book":"汉·蔡邕《释诲》"},"usage":"作宾语、定语；用于书面语"},{"id":46442,"word":"雾暗云深","pinyin":"wù àn yún shēn","abbr":"ways","explanation":"迷蒙渺远。比喻相距之遥远。","source":{"text":"玄都观里应遗恨，一抹断烟残缕。愁望处。想雾暗云深，忘却来时路。","book":"宋·冯取洽《摸鱼儿·玉林君为遗蜕山中桃花赋》词"},"usage":"作宾语、定语；用于书面语"},{"id":46443,"word":"雾涌云蒸","pinyin":"wù yǒng yún zhēng","abbr":"wyyz","explanation":"云雾蒸腾的样子。亦比喻盛多的样子。","source":{"text":"绾茁元气同沧海，雾涌云蒸一水山。","book":"南朝·梁·刘孝标《广绝交论》：“故絪緼相感，雾涌云蒸。”元·王王恽《游泰山杂诗》之六"},"example":{"text":"呈材进技，～。","book":"明·蘅芜室主人《再生缘》第四出"},"usage":"作宾语、定语；用于书面语"},{"id":46444,"word":"雾起云涌","pinyin":"wù qǐ yún yǒng","abbr":"wqyy","explanation":"比喻众多的事物迅速出现。","source":{"text":"以兴学育才为急务，于是各行省雾起云涌，学堂学会所在而有。","book":"梁启超《万木草堂书藏征捐图书店》"},"similar":["雾兴云涌"],"usage":"作谓语、定语；用于比喻句"},{"id":46445,"word":"雾释冰融","pinyin":"wù shì bīng róng","abbr":"wsbr","explanation":"雾气消散冰块融化。比喻疑难消除尽净。","source":{"text":"苦思精索，一旦豁然，若有神悟，离章错简，雾释冰融。","book":"明·杨慎《序》"},"usage":"作宾语、定语；用于比喻句"},{"id":46446,"word":"雾里看花","pinyin":"wù lǐ kàn huā","abbr":"wlkh","explanation":"原形容年老视力差，看东西模糊，后也比喻看事情不真切。","source":{"text":"春水船如天上坐，老年花似雾中看。","book":"唐·杜甫《小寒食舟中作》诗"},"example":{"text":"白石写景之作，虽格韵高绝，然如～，终隔一层。","book":"清·王国维《人间词话》"},"similar":["若明若暗"],"opposite":["真真切切"],"usage":"作宾语、定语；指看不真切","story":["唐朝时期，诗人杜甫一生坎坷不平，多半处于艰难困苦之中，他以舟为家，到处飘泊。他飘泊到长沙作《小寒食舟中作》诗：“佳辰强饮食犹寒，隐几萧条戴鹖冠。春水船如天上坐，老年花似雾中看。娟娟戏蝶过闲幔，片片轻鸥下急湍。”"]},{"id":46447,"word":"雾锁烟迷","pinyin":"wù suǒ yān mí","abbr":"wsym","explanation":"指为云雾所掩蔽。","source":{"text":"荡洪波不分一个天地，望前程尚隔雾锁烟迷。","book":"元·无名氏《隔江斗智》第二折"},"usage":"作宾语、定语；用于书面语"},{"id":46448,"word":"雾阁云窗","pinyin":"wù gé yún chuāng","abbr":"wgyc","explanation":"云雾笼罩的楼阁门窗。指高楼。","source":{"text":"雾阁云窗，风亭月户，分明携手同行处。","book":"宋·向子湮《七娘子》词"},"example":{"text":"清·厉鹗《宝莲山是韩平原故宅》诗：“～付渺茫，平原事往径全荒。”"},"usage":"作宾语、定语；指高楼"},{"id":46449,"word":"雾集云合","pinyin":"wù jí yún hé","abbr":"wjyh","explanation":"形容众多的事物聚集在一起。","source":{"text":"张曜日之灵旄，骈罗列布，雾集云合者也。","book":"《晋书·舆服志序》"},"similar":["云合雾集"],"usage":"作宾语、定语；用于书面语"},{"id":46450,"word":"雾鬓云鬟","pinyin":"wù bìn yún huán","abbr":"wbyh","explanation":"头发象飘浮萦绕的云雾。形容女子发美。","source":{"text":"花边雾鬓风鬟满，酒畔云衣月扇香。","book":"宋·苏轼《题毛女贞》诗：“雾鬓风鬟木叶衣，山川良是昔人非。”宋·范成大《新作景亭程咏之提刑赋诗次其韵》"},"example":{"text":"你看他～，冰肌玉骨，花开媚脸，星转双眸。","book":"元·白朴《墙头马上》第一折"},"similar":["雾鬓风鬟"],"usage":"作谓语、宾语；形容女子头发的美"},{"id":46451,"word":"雾鬓风鬟","pinyin":"wù bìn fēng huán","abbr":"wbfh","explanation":"鬓：脸旁靠近耳朵的头发；鬟：环形发髻。形容女子头发的美。也形容女子头发蓬松散乱。","source":{"text":"花边雾鬓风鬟满，酒畔云衣月扇香。","book":"宋·范成大《新作景亭程咏之提刑赋诗次其韵》"},"example":{"text":"山眉水眼且休论，～已无价。","book":"清·梁绍壬《两般秋雨庵随笔·背苏州》"},"similar":["雾鬓云鬟"],"usage":"作谓语、宾语；形容女子头发的美"},{"id":46452,"word":"雾鳞云爪","pinyin":"wù lín yún zhǎo","abbr":"wlyz","explanation":"犹言藏头露尾，畏首畏尾。","source":{"text":"何至雾鳞云爪，首尾不祥若是哉。","book":"清·乐宫谱《毛生》"},"similar":["藏头露尾","畏首畏尾"],"usage":"作宾语、定语；用于比喻句"},{"id":46453,"word":"需沙出穴","pinyin":"xū shā chū xué","abbr":"xscx","explanation":"指遇险凶而能幸免。","source":{"text":"语出《易·需》：“需于沙，小有言，终吉。”和“需于血，出自穴”。"}},{"id":46454,"word":"霁月光风","pinyin":"jī yuè guāng fēng","abbr":"jygf","explanation":"指雨过天晴时的明净景象。用以比喻人的品格高尚，胸襟开阔。","source":{"text":"霁月光风，终然洒落。","book":"宋陈亮《谢罗尚书启》"},"example":{"text":"春台玉烛，～，翘首堪长啸。","book":"明唐寅《忆秦娥王守谷寿词》"},"similar":["光风霁月"],"usage":"作宾语、定语；比喻开阔的胸襟和心地"},{"id":46455,"word":"霁风朗月","pinyin":"jī fēng lǎng yuè","abbr":"jfly","explanation":"和风明月。比喻宽厚祥和的气氛。","source":{"text":"一九六二年春，曾有过一度愉快的促膝长谈。那时政治上正好有一段霁风朗月的日子。","book":"柯灵《序言》"},"usage":"作定语；指祥和的气氛"},{"id":46456,"word":"霄壤之别","pinyin":"xiāo rǎng zhī bié","abbr":"xrzb","explanation":"天和地，一极在上，一级在下，比喻差别极大。","source":{"text":"趋舍所尚，耳目之欲，其为不同，已有天壤之觉（较），冰炭之乖矣。","book":"《抱朴子·内篇·论仙》"},"example":{"text":"比起先前用皂荚时候的只有一层极薄的白沫来，那高底真有～了。","book":"鲁迅《彷徨·肥皂》"},"similar":["天差地别","天壤之别","霄壤之殊"],"opposite":["相差无几"],"usage":"作宾语；比喻差别极大"},{"id":46457,"word":"霄壤之殊","pinyin":"xiāo rǎng zhī shū","abbr":"xrzs","explanation":"霄：云霄，也指天。壤：土地。天和地般不同。形容差别很大。亦作“霄壤之别”。","source":{"text":"善恶智愚，相背绝远，何啻霄壤之殊。","book":"宋·胡仔《苕溪渔隐丛话后集·醉吟先生》"},"similar":["天壤之别","霄壤之别"],"opposite":["彼此彼此"],"usage":"作宾语；用于书面语"},{"id":46458,"word":"霄鱼垂化","pinyin":"xiāo yú chuí huà","abbr":"xych","explanation":"以之来称赞官吏的德政。","source":{"text":"据《吕氏春秋·具备》载，春秋时孔子弟子宓子贱治亶父（今山东省单县），体圣人之化，三年，夜间捕鱼的人能将所得小鱼重归水中。"}},{"id":46459,"word":"震主之威","pinyin":"zhèn zhǔ zhī wēi","abbr":"zzzw","explanation":"主：君主。震动君主的威势。形容臣子的威势极大。","source":{"text":"今足下戴震主之威，挟不赏之功，归楚，楚人不信；归汉，汉人震恐。足下欲持是安归乎？夫势在人臣之位而有震主之威，名高天下，窃为足下危之。","book":"《史记·淮阴侯列传》"},"example":{"text":"自来负不赏之功，挟～者，保全能有几人！（蔡东藩《南北史演义》第十八回）"},"usage":"作宾语；用于书面语"},{"id":46460,"word":"震古烁今","pinyin":"zhèn gǔ shuò jīn","abbr":"zgsj","explanation":"烁：光亮的样子。震动古代，显耀当世。形容事业或功绩非常伟大。","source":{"text":"此等举动，震古铄今。","book":"明·史可法《复多尔衮书》"},"example":{"text":"吴帅无论怎样威望，怎比得上老帅的勋高望重，～。","book":"蔡东藩、许廑父《民国通俗演义》第一二六回"},"similar":["震古铄今"],"usage":"作谓语、定语；指人的事业或功劳"},{"id":46461,"word":"震古铄今","pinyin":"zhèn gǔ shuò jīn","abbr":"zgsj","explanation":"震动古人，显耀当世。形容事业或功绩伟大。","source":{"text":"美释黑奴而封之……称震古铄今之仁政焉。","book":"清·谭嗣同《仁学》四六"},"example":{"text":"工地上，大坝上，到处弥漫着一片开天辟地，～的气势。","book":"徐迟《我们工地的农场》"},"similar":["震古烁今"],"usage":"作谓语、定语；指人的事业或功劳"},{"id":46462,"word":"震天动地","pinyin":"zhèn tiān dòng dì","abbr":"ztdd","explanation":"震：震动；动：摇动。震动了天地。形容声音或声势极大。","source":{"text":"涛涌波襄，雷奔电泄，震天动地。","book":"《三国志·魏志·文帝纪》裴松之注：“惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。”《水经注·河水》"},"example":{"text":"二县百姓号哭之声，～。","book":"明·罗贯中《三国演义》第四十一回"},"similar":["惊天动地","震天骇地"],"opposite":["无声无息"],"usage":"作谓语、定语、状语；形容声势极大"},{"id":46463,"word":"震天撼地","pinyin":"zhèn tiān hàn dì","abbr":"zthd","explanation":"震：震动；动：摇动。震动了天地。形容某一事件令人惊骇。也形容声势浩大或气概雄伟。","source":{"text":"涛涌波襄，雷奔电泄，震天动地。","book":"《三国志·魏志·文帝纪》裴松之注：“惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。”《水经注·河水》"},"example":{"text":"枪声～，火把映山红了安源山。","book":"《毛主席和安源工人》"},"similar":["震天骇地","震天动地","天震地骇"],"usage":"作谓语、定语、状语；形容声势极大"},{"id":46464,"word":"震天铄地","pinyin":"zhèn tiān shuò dì","abbr":"ztsd","explanation":"震：震动。震动了天地。形容某一事件令人惊骇。也形容声势浩大或气概雄伟。","source":{"text":"惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。","book":"《三国志·魏志·文帝纪》裴松之注"},"example":{"text":"吾敢信卷土重来之机会，～之奇观，其决不远也。（梁·梁启超《意大利建国三杰传》）"},"usage":"作谓语、定语；用于书面语"},{"id":46465,"word":"震天骇地","pinyin":"zhèn tiān hài dì","abbr":"zthd","explanation":"震：震动；骇：惊骇。震动了天地。形容某一事件令人惊骇。也形容声势浩大或气概雄伟。","source":{"text":"士卒奔迈，其会如林，烟尘俱起，震天骇地。","book":"《晋书·孙楚传》"},"example":{"text":"岂俟排山之力，乃成破竹之资。火烈风驱，～。（唐·司空图《故盐州防御使王纵追述碑》）"},"similar":["震天撼地","天震地骇","震天动地"],"usage":"作谓语、定语、状语；形容声势极大"},{"id":46466,"word":"震慑人心","pinyin":"zhèn shè rén xīn","abbr":"zsrx","explanation":"《后汉书·任隗传》：“窦宪秉权，专作威福，内外朝臣莫不震慑。”","source":{"text":"窦宪秉权，专作威福，内外朝臣莫不震慑。","book":"南朝·宋·范晔《后汉书·任隗传》"},"usage":"作谓语、定语；用于书面语"},{"id":46467,"word":"震撼人心","pinyin":"zhèn hàn rén xīn","abbr":"zhrx","explanation":"撼：摇动。指某件事对人内心震动很大。","source":{"text":"窦宪秉权，专作威福，内外朝臣莫不震撼。","book":"《后汉书·任隗传》"},"example":{"text":"我听到这～的消息时激动得快要流泪。"},"similar":["激动人心","感人至深"],"opposite":["静若秋水","无动于衷"],"usage":"作宾语、定语；指触动人心"},{"id":46468,"word":"震撼寰宇","pinyin":"zhèn hàn huán yǔ","abbr":"zhhy","explanation":"震撼：震动；寰宇：全球。指震撼了整个世界。","source":{"text":"扬廷出令，震撼寰宇。","book":"《宋史·洪咨夔传》"},"example":{"text":"三峡工程～，造福人们"},"similar":["震天动地","震天撼地","震天骇地"],"usage":"作谓语、定语、状语；形容声势极大"},{"id":46469,"word":"震耳欲聋","pinyin":"zhèn ěr yù lóng","abbr":"zeyl","explanation":"形容声音很大，耳朵都快震聋了。","source":{"text":"每座茶馆里都人声鼎沸，而超越这个，则是茶堂倌震耳欲聋的吆喝声。","book":"沙汀《呼嚎》"},"example":{"text":"这个消息对我们来说是～。"},"similar":["振聋发聩"],"opposite":["万籁无声","万籁俱寂"],"usage":"作谓语、定语、补语；形容声音很大"},{"id":46470,"word":"震聋发聩","pinyin":"zhèn lóng fā kuì","abbr":"zlfk","explanation":"使昏昧糊涂、不明事理的人为之震惊，受到启发","source":{"text":"……声震寰宇绕梁三日震聋发聩惊天动地悦耳动听美妙无比令人心醉……","book":"王朔《千万别把我当人》"},"similar":["振聋发聩"],"usage":"作谓语、定语；用于书面语"},{"id":46471,"word":"震风陵雨","pinyin":"zhèn fēng líng yǔ","abbr":"zfly","explanation":"震：震动，大；陵：大。指疾风暴雨。形容风雨来势猛。","source":{"text":"震风陵雨，然后知夏屋之为帡幪也；虐政虐世，然后知圣人之为郛郭也。","book":"汉·扬雄《法言·吾子》"},"similar":["暴风骤雨","疾风暴雨"],"usage":"作宾语、定语；用于书面语"},{"id":46472,"word":"霍世盗名","pinyin":"huò shì dào míng","abbr":"hsdm","explanation":"迷惑世人，盗取名誉。","source":{"text":"唐虞之法微，三代之教息，大道陵迟，人伦之中不定，于是惑世盗名之徒，因夫民之离圣教日久也。","book":"汉·徐幹《中论·考伪》"}},{"id":46473,"word":"霍然而愈","pinyin":"huò rán ér yù","abbr":"hrey","explanation":"霍然：很快的样子。很快病就好了。","source":{"text":"只一服，便霍然而愈了。","book":"鲁迅《父亲的病》"},"example":{"text":"他的病～了。"},"opposite":["一病不起"],"usage":"作谓语；指很快病就好了"},{"id":46474,"word":"霓裳羽衣","pinyin":"ní cháng yǔ yī","abbr":"ncyy","explanation":"以云霓为裳，以羽毛作衣。形容女子的装束美丽。","source":{"text":"轻拢慢捻抹复挑，初为《霓裳》后《六幺》。","book":"唐·白居易《琵琶行(并序)》"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第七卷：“这些仙女，名为素娥，身上所穿白衣，叫做～。”"},"usage":"作宾语、定语；用于女性","story":["唐朝时期，唐玄宗中秋节在皇宫与方士罗公远欣赏月景，方士取出拐杖抛向天空，顿时化作巍峨华丽的广寒宫。他们立即进入广寒宫，见仙女们翩翩起舞，伴着幽雅的仙乐。唐玄宗暗中记下乐曲回来后让乐师作成《霓裳羽衣》，杨贵妃也扮仙女跳舞"]},{"id":46475,"word":"霜凋夏绿","pinyin":"shuāng diāo xià lǜ","abbr":"sdxl","explanation":"犹言冬去春来。指时光的流逝。","source":{"text":"[王金英]撰有诗句数卷，尚未成书，霜凋夏绿，其稿不知流落何所。","book":"清·纪昀《阅微草堂笔记·槐西杂志一》"},"similar":["霜雕夏绿"],"usage":"作宾语、定语；用于书面语"},{"id":46476,"word":"霜气横秋","pinyin":"shuāng qì héng qiū","abbr":"sqhq","explanation":"霜：秋霜。气：志气。比喻志气凛然，像秋霜一样严峻。","source":{"text":"风情张日，霜气横秋。","book":"南朝·齐·孔稚珪《北山移文》"},"example":{"text":"看阵云截岸，～。千雉严城，五更残角月如钩。","book":"金·折元礼《望海潮》词"}},{"id":46477,"word":"霜行草宿","pinyin":"shuāng xíng cǎo xiǔ","abbr":"sxcx","explanation":"指在霜露中行走，草野中息宿。形容奔波劳苦。","source":{"text":"单身勤苦，霜行草宿，营办棺椁，造立冢墓，葬送母兄，俭而有礼。","book":"《宋书·孝义传·孙法宗》"},"usage":"作谓语、定语；用于旅行等"},{"id":46478,"word":"霜露之思","pinyin":"shuāng lù zhī sī","abbr":"slzs","explanation":"指对父母或祖先的怀念。","source":{"text":"霜露既降，君子履之，必有凄怆之心，非其寒之谓也。","book":"《礼记·祭义》"},"example":{"text":"～既极，宜沾雨露之恩。","book":"明·高则诚《琵琶记·一门旌奖》"},"similar":["霜露之悲"],"usage":"作宾语；指对父母先祖的悲思"},{"id":46479,"word":"霜露之悲","pinyin":"shuāng lù zhī bēi","abbr":"slzb","explanation":"对父母先祖的悲思。","source":{"text":"若报罔极之德，霜露之悲，有时斋供。","book":"北齐·颜之推《颜氏家训·终制》"},"example":{"text":"她经常流露～。"},"similar":["霜露之感","霜露之思"],"usage":"作宾语；指对父母先祖的悲思"},{"id":46480,"word":"霜露之感","pinyin":"shuāng lù zhī gǎn","abbr":"slzg","explanation":"指对父母或祖先的怀念。","source":{"text":"霜露既降，君子履之，必有凄怆之心，非其寒之谓也。","book":"西汉·戴圣《礼记·祭义》"},"example":{"text":"所以称其显亲之心，慰其～。","book":"宋·曾巩《中大夫尚书左丞蒲宗孟父师道赠太子少师制》"},"similar":["霜露之思"],"usage":"作宾语；指对父母先祖的悲思"},{"id":46481,"word":"霜露之疾","pinyin":"shuāng lù zhī jí","abbr":"slzj","explanation":"指因风寒而引起的疾病，指感冒。","source":{"text":"君不幸罹霜露之病，何恙不已？","book":"西汉·司马迁《史记·公孙弘传》"},"example":{"text":"人偶尔都会有～的。"},"similar":["外感内伤"],"usage":"作宾语；指感冒","story":["西汉时期，丞相公孙弘出身牧人家庭，40岁才去读书，很快就被汉武帝拜为丞相，他办事认真，得罪了一些权贵，加上他出身低微，经常被人看不起。他推说自己有病要辞职，汉武帝看出他只不过是霜露之疾罢了，挽留他继续干下去"]},{"id":46482,"word":"霜露之病","pinyin":"shuāng lù zhī bìng","abbr":"slzb","explanation":"因感受风寒而引起的病。","source":{"text":"君不幸罹霜露之病，何恙不已，逎上书归侯，乞骸骨，是章朕之不德也。","book":"《史记·平津侯主父列传》"},"usage":"作宾语；指小疾病"},{"id":46483,"word":"霜露之辰","pinyin":"shuāng lù zhī chén","abbr":"slzc","explanation":"指父母先人的生日。"},{"id":46484,"word":"霞举飞升","pinyin":"xiá jǔ fēi shēng","abbr":"xjfs","explanation":"道教指修行得道者可由云霞托拥，飞升天界。也指腾云驾雾。","example":{"text":"我不相信道教的～说法。"},"usage":"作谓语、宾语、定语；用于道教语"},{"id":46485,"word":"霞光万道","pinyin":"xiá guāng wàn dào","abbr":"xgwd","explanation":"形容日出日落时霞光散射的美丽景象。也形容某种珍宝放出耀眼的光辉。","source":{"text":"但见个东西映着日光，霞光万道，瑞气千条，从门里就冲着他怀里飞来。","book":"清·文康《儿女英雄传》第三十一回"},"example":{"text":"王朔《空中小姐》：“太阳正冉冉升起，～。”"},"similar":["光芒万丈"],"usage":"作谓语、定语；指光芒万丈"},{"id":46486,"word":"霞友云朋","pinyin":"xiá yǒu yún péng","abbr":"xyyp","explanation":"与云霞为朋友。指避世隐居。","source":{"text":"或栖连岗，或泛长流；霞友云朋，造物与游。","book":"宋·叶适《朝请大夫提举江州太平兴国宫陈公墓志铭》"},"usage":"作宾语、定语；用于生活等"},{"id":46487,"word":"霞姿月韵","pinyin":"xiá zī yuè yùn","abbr":"xzyy","explanation":"比喻俊美清雅的仪态和风度。"},{"id":46488,"word":"霞思云想","pinyin":"xiá sī yún xiǎng","abbr":"xsyx","explanation":"绞尽脑汁，深沉地思索。","source":{"text":"此事定须霞思云想，刻意经营，奈何颓唐落墨，便布人间？","book":"清·王晫《今世说·规箴》"},"similar":["冥思苦想","霞思天想"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":46489,"word":"霞思天想","pinyin":"xiá sī tiān xiǎng","abbr":"xstx","explanation":"指苦思冥想。","source":{"text":"居金陵时，每有撰造，必栖踞于乔树之颠，霞思天想。","book":"明·王世贞《艺苑卮言》第七卷"},"similar":["冥思苦想","霞思云想"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":46490,"word":"霞明玉映","pinyin":"xiá míng yù yìng","abbr":"xmyy","explanation":"如霞光明艳，如玉色映现。形容光彩耀人。","source":{"text":"顾庵以文词翱翔诸公游士之间，每一挥毫，霞明玉映，诸翰林皆自以为不及也。","book":"清·王晫《今世说·文学》"},"usage":"作定语；用于书面语"},{"id":46491,"word":"霞蔚云蒸","pinyin":"xiá wèi yún zhēng","abbr":"xwyz","explanation":"比喻景物绚烂缛丽。","source":{"text":"锦心绣口，簇簇能新；霞蔚云蒸，多多益辨。","book":"清·褚人获《坚瓠十集·册封牡丹诏》"},"example":{"text":"曹禺《王昭君》第五幕：“开幕时，～，向晚的草原十分安静。”"},"similar":["云蒸霞蔚"],"usage":"作谓语、定语、状语；指景色"},{"id":46492,"word":"霞裙月帔","pinyin":"xiá qún yuè pèi","abbr":"xqyp","explanation":"以云霞为裙，明月为披肩。借指仙女或美女。","source":{"text":"金似衣裳玉似身，眼如秋水鬓如云，霞裙月帔一群群。","book":"前蜀·韦庄《天仙子》词"},"usage":"作宾语、定语；用于书面语"},{"id":46493,"word":"露人眼目","pinyin":"lù rén yǎn mù","abbr":"lrym","explanation":"显露在人们的眼前，让人看见。","source":{"text":"只愁来历不明，怕惹出是非，不敢露人眼目。","book":"明·冯梦龙《喻世明言》卷一"},"example":{"text":"这东西也要你袖里藏去，不可～。","book":"明·冯梦龙《喻世明言》卷二"}},{"id":46494,"word":"露出马脚","pinyin":"lòu chū mǎ jiǎo","abbr":"lcmj","explanation":"比喻暴露了隐蔽的事实真相或内情无意中泄露出来。","source":{"text":"兄弟，这老儿不好惹，动不动先斩后闻，这一来我们露出马脚来了。","book":"元·无名氏《陈州粜米》第三折"},"example":{"text":"亏他东扯西拉，居然没有～。","book":"清·李宝嘉《官场现形记》第五十三回"}},{"id":46495,"word":"露头露脸","pinyin":"lòu tóu lòu liǎn","abbr":"ltll","explanation":"露：显露。具体显示出来，指在公开场合出现。","example":{"text":"她很想有机会出去～。"},"similar":["出头露面"],"usage":"作宾语、定语；同“出头露面”"},{"id":46496,"word":"露宿风餐","pinyin":"lù sù fēng cān","abbr":"lsfc","explanation":"在露天过夜，在风口吃饭。形容行旅生活的辛苦。","source":{"text":"露宿风餐六百里，明朝饮马南江水。","book":"宋·苏轼《将至筠先寄迟适远三犹子》诗"},"example":{"text":"他离开家后，～地赶路，十分辛苦。"},"similar":["风餐露宿"],"usage":"作谓语、定语；形容行旅途或野外生活的艰苦"},{"id":46497,"word":"露尾藏头","pinyin":"lù wěi cáng tóu","abbr":"lwct","explanation":"藏起了头，露出了尾。形容说话躲躲闪闪，不把真实情况全部讲出来。","source":{"text":"早休官弃职，远红尘是非，省藏头露尾。","book":"元·张可久《点绛唇·翻归去来辞》套曲"},"example":{"text":"我虽然句句的～，被你二人层层的寻根觅活，话也大概说明白了。","book":"清·文康《儿女英雄传》第八回"},"similar":["藏头露尾"],"usage":"作谓语、宾语；指人说话或做事"},{"id":46498,"word":"露己扬才","pinyin":"lù jǐ yáng cái","abbr":"ljyc","explanation":"显露自己的才能。也比喻炫耀才能，表现自己。同“露才扬己”。","source":{"text":"［遁逸之士］若出而求陛下之试，是其人非高蹈者，则皆露己扬才，干时谒进者也。","book":"宋·苏舜钦《投匦疏》"},"similar":["露才扬己","扬己露才","衒才扬己"],"usage":"作谓语、定语、宾语；指显露自己的才能"},{"id":46499,"word":"露影藏形","pinyin":"lù yǐng cáng xíng","abbr":"lycx","explanation":"躲躲闪闪貌。犹言藏头露尾。","source":{"text":"躲躲闪闪貌。犹言藏头露尾。"},"similar":["藏头露尾"],"opposite":["开门见山"],"usage":"作谓语、状语；用于做事和说话等"},{"id":46500,"word":"露往霜来","pinyin":"lù wǎng shuāng lái","abbr":"lwsl","explanation":"比喻岁月迁移，时光流逝。","source":{"text":"露，秋也。霜，冬也。除，去也。言秋往冬来，日月将去。","book":"《文选·左思〈吴都赋〉》：“露往霜来，日月其除。”吕延济注"},"example":{"text":"～，雕墙半圮。","book":"宋·刘从乂《重修文宣王庙记》"},"similar":["寒来暑往"],"usage":"作宾语、定语、状语；用于时间变化"},{"id":46501,"word":"露才扬己","pinyin":"lù cái yáng jǐ","abbr":"lcyj","explanation":"露：显露；扬：表现。显露自己的才能。也比喻炫耀才能，表现自己。","source":{"text":"今若屈原，露才扬己，竞乎危国群小之间，以离谗贼。","book":"汉·班固《离骚序》"},"example":{"text":"既失博学知服之义，且开～之风，此学者之大病也。","book":"清·陈澧《东塾读书记·郑学》"},"similar":["露己扬才"],"usage":"作谓语、定语、宾语；指显露自己的才能"},{"id":46502,"word":"露水夫妻","pinyin":"lù shuǐ fū qī","abbr":"lsfq","explanation":"指不正当的男女关系；亦指暂时结合的非正式夫妻。","source":{"text":"我的哥哥，这一家都谁是疼你的？都是露水夫妻，再醮货儿！唯有奴知道你的心，你知道奴的意。","book":"明·兰陵笑笑生《金瓶梅词话》第十二回"},"example":{"text":"乃武这样温柔的人，反成了～，如今越发成了薄幸郎君，自己好不命苦，心来如何能安然度日？","book":"《杨乃武与小白菜》第十二回"},"similar":["露水鸳鸯"],"usage":"作宾语、定语；用于口语"},{"id":46503,"word":"露水姻缘","pinyin":"lù shuǐ yīn yuán","abbr":"lsyy","explanation":"指短暂或临时结合的情缘。","source":{"text":"因为看到马逢时目不转睛地看着孙干娘，决心成全他们这一段露水姻缘。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"我不羡慕别人外去期间有～。"},"similar":["露水鸳鸯"],"usage":"作主语、宾语、定语；用于临时男女"},{"id":46504,"word":"露纂雪钞","pinyin":"lù zuǎn xuě chāo","abbr":"lzxc","explanation":"指勤于收辑抄录，昼夜寒暑不停。同“露钞雪纂”。","source":{"text":"露纂雪钞，累累成帙。","book":"郑逸梅《〈陈瘦愚编年词选〉序》"},"similar":["露钞雪纂"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":46505,"word":"露红烟紫","pinyin":"lù hóng yān zǐ","abbr":"lhyz","explanation":"形容花木的色彩鲜艳。","source":{"text":"小碧阑干四月天，露红烟紫不胜妍。","book":"宋·曾巩《芍药厅》诗"},"similar":["露红烟绿"],"usage":"作宾语、定语；用于景物描写"},{"id":46506,"word":"露红烟绿","pinyin":"lù hóng yān lǜ","abbr":"lhyl","explanation":"形容花木的色彩鲜艳。同“露红烟紫”。","source":{"text":"催花雨小，著柳风柔，都似去年时侯好。露红烟绿，尽有狂情斗春早。","book":"宋·晏幾道《泛清波摘遍》词"},"similar":["露红烟紫"],"usage":"作宾语、定语；用于景物描写"},{"id":46507,"word":"露胆披肝","pinyin":"lù dǎn pī gān","abbr":"ldpg","explanation":"披露肝胆。比喻待人坦诚之至。","source":{"text":"擘肌分理，有谢于昔时；露胆披肝，请从于今日。","book":"唐·李远《蝉蜕赋》"},"example":{"text":"此言一一咸依实，～愿照知。","book":"《敦煌变文集·降魔变文》"},"similar":["露胆披诚"],"usage":"作宾语、谓语；指诚心待人"},{"id":46508,"word":"露胆披诚","pinyin":"lù dǎn pī chéng","abbr":"ldpc","explanation":"比喻待人坦诚之至。同“露胆披肝”。","source":{"text":"露胆披诚，何能以酬屡顾。","book":"《梁书·王僧孺传》"},"similar":["赤胆忠心","露胆披肝"],"usage":"作宾语、谓语；指诚心待人"},{"id":46509,"word":"露钞雪纂","pinyin":"lù chāo xuě zuǎn","abbr":"lcxz","explanation":"指勤于收辑抄录，昼夜寒暑不停。","source":{"text":"露钞雪纂旧愈富，何啻邺侯三万轴。","book":"元·黄溍《题李氏白石山房》诗"},"similar":["露纂雪钞"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":46510,"word":"露面抛头","pinyin":"lù miàn pāo tóu","abbr":"lmpt","explanation":"抛：暴露。露出头和面孔。原指妇女出现在大庭广众之中。现指公开露面。","source":{"text":"倘久后此城一破，使我妻女擒往朝歌，露面抛头，尸骸残暴，惹天下诸侯笑我为无谋之辈；不若先杀其妻妇，然后自刎，庶几不失丈夫之所为。","book":"明·许仲琳《封神演义》第三回"},"similar":["抛头露面"],"opposite":["深居简出"],"usage":"作谓语、定语、宾语、分句；指公开露面"},{"id":46511,"word":"露餐风宿","pinyin":"lù cān fēng sù","abbr":"lcfs","explanation":"在露天中吃饭，在风中住宿。形容旅途艰辛。","source":{"text":"沿途露餐风宿，到了汛地，驻扎数月。","book":"蔡东藩《清史通俗演义》第33回"},"similar":["餐风露宿"],"usage":"作谓语、定语；指旅途艰辛"},{"id":46512,"word":"露马脚","pinyin":"lòu mǎ jiǎo","abbr":"lmj","explanation":"比喻暴露了隐蔽的事实真相。","source":{"text":"但张轨如这个先生与别个先生不同，原意不在书，又肯使两个瞎钱，又一团和气，肯奉承人，因此大大小小都与他讲得来，虽有些露马脚的所在，转都替他遮盖过了。","book":"明·荻岸散人《玉娇梨》第八回"},"example":{"text":"如果照本抄誊，倘若抚宪传问起来，还不出这几个人的出典，就要～。","book":"清·李宝嘉《官场现形记》第七回"},"usage":"作谓语、宾语；指暴露"},{"id":46513,"word":"霸王之资","pinyin":"bà wáng zhī zī","abbr":"bwzz","explanation":"资：凭借。争霸称王的资本。","source":{"text":"无事则民勤于耕稼，以广军储；有事则民习于弓矢，以莅武事。此真霸王之资也。闭关自守，又何忧乎？","book":"《新编五代史平话·周史上》"},"example":{"text":"我已经具备了～。"},"usage":"作主语、宾语；指称霸的资本"},{"id":46514,"word":"霸王别姬","pinyin":"bà wáng bié jī","abbr":"bwbj","explanation":"姬：指西楚霸王项羽的宠妾虞姬。形容英雄末路的悲壮情景。现多比喻独断专行，脱离群众，最终垮台。","source":{"text":"《史记·项羽本纪》记载：霸王项羽在和刘邦夺封建统治权的战争中，最后兵败，自知大势已去，在突围前夕，不得不和虞姬决别。"},"example":{"text":"不是有一出戏叫《～》吗？这些同志如果总是不改，难免有一天要“别姬”就是了。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"usage":"作宾语、定语；指强行办事","story":["楚汉相争时，西楚霸王项羽在和刘邦为了争夺帝位，进行长达十几年的战争。最后项羽在乌江兵败，自知大势已去，在突围前夕，不得不和虞姬决别，最后自刎身亡"]},{"id":46515,"word":"霸王风月","pinyin":"bà wáng fēng yuè","abbr":"bwfy","explanation":"比喻用粗暴的态度对待幽雅的事情。","source":{"text":"今主上催花，与众不同，纯用火攻，可谓“霸王风月”了。","book":"清·李汝珍《镜花缘》第五回"},"usage":"作宾语；指粗暴作风"},{"id":46516,"word":"霸道横行","pinyin":"bà dào héng xíng","abbr":"bdhx","explanation":"犹言横行霸道。指依仗权势为非作歹。","source":{"text":"及到江南，则玩易官府，欺凌民船，霸道横行，莫敢正视。","book":"清·黄钧宰《金壶浪墨·漕弊》"},"example":{"text":"还有等刁民恶棍，结交官府，盘剥乡愚，仗着银钱～，无恶不作。","book":"《儿女英雄伟》第八回"},"similar":["横行霸道"],"usage":"作谓语、定语；形容人无礼"},{"id":46517,"word":"霸陵伤别","pinyin":"bà líng shāng bié","abbr":"blsb","explanation":"比喻送客上路，黯然伤怀。","source":{"text":"年年柳色，霸陵伤别。","book":"唐·李白《忆秦娥》词"}},{"id":46518,"word":"霸陵醉尉","pinyin":"bà líng zuì wèi","abbr":"blzw","explanation":"形容失官之后受人侵辱。","source":{"text":"尝夜从一骑出，从人田间饮。还至霸陵亭，霸陵醉尉，呵止广。……","book":"《史记·李将军列传》"}},{"id":46519,"word":"霹雳列缺","pinyin":"pī lì luè quē","abbr":"pllq","explanation":"霹雳：炸雷，指突发的响雷；列缺：古时指天上的裂缝。指雷鸣电闪。","source":{"text":"辟雳列缺，吐火施鞭。","book":"《汉书·扬雄传上》"}},{"id":46520,"word":"霹雳手","pinyin":"pī lì shǒu","abbr":"pls","explanation":"指断案敏捷的人。","source":{"text":"崇义大惊，谢曰：‘公何忍藏锋以成鄙夫之过！’由是大知名，号为‘霹雳手’。","book":"《旧唐书·裴漼传》"},"example":{"text":"诉牒旁午来，剖断不留宿，虽非～，遇事颇神速。","book":"明·于谦《昼夜昼夜长短》"},"usage":"作宾语、定语；指能吏","story":["唐朝时期，年轻漂亮的裴琰之任同州司户参军，刺史李崇义看不起他，给他出难题，把州中积压多年的旧案数百件交给他，让他短期内判完。裴琰之很快判完，而且判词非常妥当。李崇义大吃一惊，从此刮目相看。裴琰之因此获“霹雳手”的美称"]},{"id":46521,"word":"青丝白马","pinyin":"qīng sī bái mǎ","abbr":"qsbm","explanation":"指作乱的人。","source":{"text":"南朝·梁·普通年间，“有童谣曰：‘青丝白马寿阳来。’”其后侯景作乱，乘白马以青丝为缰，兵皆青衣，从寿春进军建康。见《梁书·侯景传》、《隋书·五行志上》。"}},{"id":46522,"word":"青云万里","pinyin":"qīng yún wàn lǐ","abbr":"qywl","explanation":"比喻前程远大。","source":{"text":"论做人要光前耀后。劝我儿青云万里，早当驰骤。","book":"元·高明《琵琶记》第二出"},"example":{"text":"今仁兄～，亦由今始，愿努力自爱。","book":"明·冯梦龙《醒世恒言》第二十五卷"},"similar":["鹏程万里"],"usage":"作谓语、宾语；指前程远大"},{"id":46523,"word":"青云之上","pinyin":"qīng yún zhī shàng","abbr":"qyzs","explanation":"比喻官高显赫。","source":{"text":"须贾顿首言死罪，曰：‘贾之意君能自致于青云之上。’","book":"《史记·范雎蔡泽列传》"},"example":{"text":"况有那身在～，拔人于淤泥之中，重捐己资，曲全婚配。","book":"明·凌濛初《初刻拍案惊奇》卷二十"}},{"id":46524,"word":"青云得意","pinyin":"qīng yún dé yì","abbr":"qydy","explanation":"比喻人仕途得意，步步高升。","source":{"text":"况白头能几，定应独往，青云得意，风说长存。","book":"宋·辛弃疾《沁园春》词"},"example":{"text":"后来尼若牟～，做到教王的首相。","book":"金庸《倚天屠龙记》三十"},"similar":["青云得路","青云直上"],"usage":"作谓语、定语；用于仕途等"},{"id":46525,"word":"青云得路","pinyin":"qīng yún dé lù","abbr":"qydl","explanation":"宋·姚勉《沁园春·太学补试归涂作》：“剑吼蛟龙怒。问苍天、功名两字，几时分付。生个英雄为世用，须早青云得路。却底事、知音未遇。两度入天飞折翼，谩教人、欲叹儒冠误。竟不晓，是何故。”","source":{"text":"故人直是不相忘，把酒看、沙头鸥鹭。～，兰台乌府。 ★元·虞集《鹊桥仙》词"},"similar":["青云得意"],"usage":"作谓语、定语；用于仕途等"},{"id":46526,"word":"青云独步","pinyin":"qīng yún dú bù","abbr":"qydb","explanation":"比喻人的地位或学问无与伦比。","source":{"text":"发悬梁，锥刺股；如囊萤，雪当烛。必不叫尔自辛苦。到后来，才得这万里鹏程，青云独步。","book":"《白雪遗音·八角鼓·才郎夜读书》"},"similar":["独步一时"],"usage":"作谓语、宾语、定语；用于能人"},{"id":46527,"word":"青云直上","pinyin":"qīng yún zhí shàng","abbr":"qyzs","explanation":"青云：指青天；直上：直线上升。指迅速升到很高的地位。","source":{"text":"度白雪以方洁，干青云而直上。","book":"《史记·范睢蔡泽列传》：“贾不意君能自致于青云之上。”南朝齐·孔稚圭《北山移文》"},"example":{"text":"洪承畴是万历年间的进士出身，登第时年岁很轻，从此步步～，一帆风顺。","book":"姚雪垠《李自成》第一卷第五章"},"similar":["平步青云","一步登天","飞黄腾达"],"opposite":["一落千丈"],"usage":"作谓语、定语；指人的地位","story":["战国时期，魏国人范雎跟随魏中大夫须贾出访齐国，齐襄王很赏识他，给他黄金，他拒绝接受。回国后相国魏齐叫人痛打范雎并弃之荒野。范雎逃到秦国改名张禄并当上相国。须贾向秦求和见到范雎，向他赔罪并恭贺他青云直上"]},{"id":46528,"word":"青出于蓝","pinyin":"qīng chū yú lán","abbr":"qcyl","explanation":"青：靛青；蓝：蓼蓝之类可作染料的草。青是从蓝草里提炼出来的，但颜色比蓝更深。比喻学生超过老师或后人胜过前人。","source":{"text":"青，取之于蓝，而青于蓝。","book":"《荀子·劝学》"},"example":{"text":"愈变愈妙，可谓～矣。","book":"清·平步清《霞外捃屑》卷六"},"similar":["后来居上"],"opposite":["每况愈下"],"usage":"作谓语、宾语；指后人胜过前人","story":["北魏文人李谧学习很用功，在文学博士孔璠门下做学生，勤奋刻苦，虚心好学，提高很快。几年后，李谧的学问超过了他的老师孔璠，孔璠反过来向李谧求教。同学们做歌：“青成蓝，蓝谢青，师何常，在明经。”"]},{"id":46529,"word":"青出于蓝而胜于蓝","pinyin":"qīng chū yú lán ér shèng yú lán","abbr":"qcylesyl","explanation":"青从蓝草中提炼出来，但颜色比蓝草更深。","source":{"text":"青出于蓝而胜于蓝。小林，老江何必派我来帮助你？","book":"杨沫《青春之歌》第二部第36章"},"example":{"text":"你们年轻人真是～。"},"similar":["青出于蓝"],"usage":"作宾语、分句；指后人胜过前人","story":["北魏文人李谧学习很用功，在文学博士孔璠门下做学生，勤奋刻苦，虚心好学，提高很快。几年后，李谧的学问超过了他的老师孔璠，孔璠反过来向李谧求教。同学们做歌：“青成蓝，蓝谢青，师何常，在明经。”"]},{"id":46530,"word":"青口白舌","pinyin":"qīng kǒu bái shé","abbr":"qkbs","explanation":"指说话不知轻重，触犯忌讳。","source":{"text":"这样的好风水，保桥还来不及呢！岂可青口白舌，轻易说拆去么？","book":"洪深《五奎桥》第一幕"},"similar":["赤口白舌"],"usage":"作宾语、定语、状语；用于说话"},{"id":46531,"word":"青史不泯","pinyin":"qīng shǐ bù mǐn","abbr":"qsbm","explanation":"青史：古代在竹简上记史，故用以称史书。比喻永载史册，永不泯灭。","source":{"text":"古人日以远，青史字不泯。","book":"唐·杜甫《赠郑十八贲》诗"}},{"id":46532,"word":"青史传名","pinyin":"qīng shǐ chuán míng","abbr":"qscm","explanation":"青史：史书。历史上留下好名声。","source":{"text":"俺不能勾青史标名，留芳万古。","book":"元·无名氏《昊天塔》第一折"},"example":{"text":"同心报国，～，有何不美。","book":"明·施耐庵《水浒全传》第七十一回"},"similar":["青史流芳"],"usage":"作谓语、宾语；指流芳百世"},{"id":46533,"word":"青史垂名","pinyin":"qīng shǐ chuí míng","abbr":"qscm","explanation":"青史：青指竹简，古代在竹简上记事，因称史书。垂：流传下去。指在历史上留名，永垂不朽。","source":{"text":"且图青史垂名稳，从道前贤自滞多。","book":"唐·李咸用《依韵修睦上人山居十首》诗之八"},"example":{"text":"上图尽忠报国，次要修身敬士，三来练军爱民。尔等功名富贵，全始全终，以期～不朽。","book":"明·方汝浩《禅真逸史》第三十六回"}},{"id":46534,"word":"青史标名","pinyin":"qīng shǐ biāo míng","abbr":"qsbm","explanation":"青史：史书。标：记下。在史书上记下姓名。比喻在历史上留下好的名声。亦作“青史留名”、“青史传名”、“青史名留”、“青史流芳”。","source":{"text":"俺不能勾青史标名，留芳万古。","book":"元·无名氏《昊天塔》第一折"},"example":{"text":"到我国朝，初时三途并用，多有名公大臣不由科甲出身，一般也替朝廷干功立业，～不朽。","book":"明·凌濛初《初刻拍案惊奇》卷二十九"},"similar":["青史传名","青史流芳"],"usage":"作谓语、定语、宾语；用于劝诫人等"},{"id":46535,"word":"青史流芳","pinyin":"qīng shǐ liú fāng","abbr":"qslf","explanation":"指在历史上留下好名声。","source":{"text":"看古来孝诸贤俊，到如今青史流芳世不湮。","book":"元·沈僖《一枝花·题张思恭望云思亲卷》套曲"},"similar":["青史标名","青史留名"],"usage":"作谓语、定语、宾语；用于劝诫人等"},{"id":46536,"word":"青史留名","pinyin":"qīng shǐ liú míng","abbr":"qslm","explanation":"青史：史书。在历史上留下好名声。","source":{"text":"俺不能勾青史标名，留芳万古。","book":"元·无名氏《昊天塔》第一折"},"example":{"text":"同心报国，～，有何不美。","book":"明·施耐庵《水浒全传》第七十一回"},"similar":["青史传名","青史标名"],"usage":"作谓语、定语、宾语；用于劝诫人等"},{"id":46537,"word":"青史留芳","pinyin":"qīng shǐ liú fāng","abbr":"qslf","explanation":"青史：史书。在历史上留下好名声。","source":{"text":"俺不能勾青史标名，留芳万古。","book":"元·无名氏《昊天塔》第一折"},"example":{"text":"看古来孝诸贤俊，到如今～不湮。","book":"元·沈僖《一枝花·题张思恭望云思亲卷》"}},{"id":46538,"word":"青堂瓦舍","pinyin":"qīng táng wǎ shè","abbr":"qtws","explanation":"堂：高大的屋子。青灰砖砌的堂屋，灰瓦盖顶的住房。指大瓦房。","source":{"text":"你在这青堂瓦舍里坐着，到也自在，你这等涎皮赖脸的，俺管监的吃风！","book":"明·李开先《宝剑记》第十四出"},"example":{"text":"树叶透缝的地方，往往露出一带渔村，～，就和我小时候在海市里望见的一模一样。","book":"杨朔《海市》"},"usage":"作宾语、定语；指砖瓦构筑的房舍"},{"id":46539,"word":"青天白日","pinyin":"qīng tiān bái rì","abbr":"qtbr","explanation":"指大白天。也比喻明显的事情或高洁的品德。","source":{"text":"青天白日，奴隶亦知其清明。","book":"唐·韩愈《与崔群书》"},"example":{"text":"其为汉复仇之志，如～，人人得而知之。","book":"宋·朱熹《答魏元履书》"},"similar":["光天化日","青霄白日"],"usage":"作宾语、分句；指大白天"},{"id":46540,"word":"青天霹雳","pinyin":"qīng tiān pī lì","abbr":"qtpl","explanation":"霹雳：响雷。晴天打响雷。比喻突然发生意外的，令人震惊的事件。","source":{"text":"放翁病过秋，忽起作醉墨。正如久蛰龙，青天飞霹雳。","book":"宋·陆游《四日夜鸡未鸣起作》诗"},"example":{"text":"叫他们议奏，正如～，平地风波，这却自私好呢？？（清·李宝嘉《文明小史》第六十回）"},"similar":["晴天霹雳"],"usage":"作宾语；指令人震惊的事情"},{"id":46541,"word":"青女素娥","pinyin":"qīng nǚ sù é","abbr":"qnse","explanation":"青女：福州传说中的霜雪之神；素娥：传说中嫦娥的别称。形容天上的神仙美女。","source":{"text":"青女素娥俱耐冷，月中霜里斗婵娟。","book":"唐·李商隐《霜月》诗"},"example":{"text":"更兼他容貌才情，真是寡二少双，惟有～可以仿佛一二。","book":"清·曹雪芹《红楼梦》第97回"},"usage":"作宾语、定语；用于女性"},{"id":46542,"word":"青山一发","pinyin":"qīng shān yī fà","abbr":"qsyf","explanation":"青山远望，其轮廓仅如发丝一样。形容极其遥远。也借指中原。","source":{"text":"杳杳天低鹘没处，青山一发是中原。","book":"宋·苏轼《澄迈驿通潮阁》诗之二"},"example":{"text":"～愁蒙蒙，干戈已满天南东。","book":"宋·林景熙《题陆放翁诗卷后》"},"usage":"作宾语；借指中原"},{"id":46543,"word":"青山不老","pinyin":"qīng shān bù lǎo","abbr":"qsbl","explanation":"比喻永存。也比喻时间久长。","source":{"text":"青山不老，绿水长存。他日事成，必当后报。","book":"明·罗贯中《三国演义》第六十回"},"similar":["青山不老，绿水长存"],"usage":"作宾语、定语；指时间久"},{"id":46544,"word":"青山不老，绿水长存","pinyin":"qīng shān bù lǎo，lǜ shuǐ cháng cún","abbr":"qsbllscc","explanation":"指经过的时间长久，比喻永存。","source":{"text":"青山不老，绿水长存。他日事成，必当厚报。","book":"明·罗贯中《三国演义》第60回"},"similar":["青山不老"],"usage":"作宾语、定语；指时间久"},{"id":46545,"word":"青山处处埋忠骨","pinyin":"qīng shān chù chù mái zhōng gǔ","abbr":"qsccmzg","explanation":"各处的青山都可以埋葬自己的身躯。形容为着理想，不惜牺牲一切的豪情。","source":{"text":"青山是处可埋骨，白发向人羞折腰。","book":"宋·陆游《醉中出西门偶书》"}},{"id":46546,"word":"青山绿水","pinyin":"qīng shān lǜ shuǐ","abbr":"qsls","explanation":"泛称美好山河。","source":{"text":"问：‘牛头未见四祖时如何？’师曰：‘青山绿水。’曰：‘见后如何？’师曰：‘绿水青山。’","book":"宋·释普济《五灯会元》"},"example":{"text":"历遍了～，看不尽野草闲花。","book":"明·吴承恩《西游记》第二十三回"},"similar":["山青水秀"],"usage":"作宾语；泛称美好山河"},{"id":46547,"word":"青州从事","pinyin":"qīng zhōu cóng shì","abbr":"qzcs","explanation":"青州：古代州名，在今山东东部；从事：古代官名。好酒的代称。","source":{"text":"恒公有主簿善别酒，有酒则令先尝，好者谓‘青州从事’，恶者谓‘平原督邮’。","book":"南朝宋·刘义庆《世说新语·术解》"},"example":{"text":"～孔方君，终日纷纷喜事生。","book":"宋·李清照《感怀》"},"similar":["琼浆玉液"],"opposite":["平原督邮"],"usage":"作宾语；指好酒的代称","story":["魏晋时期，桓温手下的一个主簿善于辨别酒的好坏，他把好酒叫做“青州从事”，因为青州有个齐郡，齐与脐同音，好酒力一直达到脐部。把次酒叫做“平原督邮”，因为平原郡有个鬲县，鬲与膈同音，次酒的酒力只能到达胸腹之间"]},{"id":46548,"word":"青春不再","pinyin":"qīng chūn bù zài","abbr":"qcbz","explanation":"再：两次或第二次。青春过后就不会再来。形容青春时光宝贵。","source":{"text":"白日莫空过，青春不再来。","book":"唐·林宽《少年行》诗"},"example":{"text":"如果她也有悲哀的时候，大概是想起～。","book":"茅盾《幻灭》四"},"similar":["青春难再"],"usage":"作谓语、定语；用于中老年人"},{"id":46549,"word":"青春两敌","pinyin":"qīng chū liǎng dí","abbr":"qcld","explanation":"敌：匹敌，相当。指两人都处在青年时期，在年龄上相当。","source":{"text":"妾承兄弟，事君王，妾自以为秦楚相当，青春两敌。","book":"明·冯梦龙《东周列国志》第七十一回"},"usage":"作宾语、定语；用于书面语"},{"id":46550,"word":"青春难再","pinyin":"qīng chūn nán zài","abbr":"qcnz","explanation":"再：两次或第二次。青春过后就不会再来。形容青春时光宝贵。","source":{"text":"白日莫空过，青春不再来。","book":"唐·林宽《少年行》诗"},"example":{"text":"自古道～，喜相逢笑口齐开。","book":"明·冯惟敏《黄钟醉花阴·酬金白屿》"},"similar":["青春不再"],"usage":"作谓语、定语、宾语；用于中老年人"},{"id":46551,"word":"青松落色","pinyin":"qīng sōng luò sè","abbr":"qsls","explanation":"松树失去了青翠的颜色。旧时比喻世道衰败时人情的冷落、淡薄。","source":{"text":"近世交道衰，青松落颜色。","book":"唐·孟郊《衰松》诗"}},{"id":46552,"word":"青林黑塞","pinyin":"qīng lín hēi sài","abbr":"qlhs","explanation":"比喻指知己朋友所在之处。","source":{"text":"魂来枫林青，魂返关塞黑。","book":"唐·杜甫《梦李白》诗"},"example":{"text":"知我者，其在～间乎！","book":"清·蒲松龄《聊斋志异·聊斋自志》"},"usage":"作宾语、定语；比喻知己朋友所在之处"},{"id":46553,"word":"青枝绿叶","pinyin":"qīng zhī lǜ yè","abbr":"qzly","explanation":"①青绿色的枝叶。多指生长茂盛的树木。②比喻年轻。","source":{"text":"他把我的杨柳枝拔了去，放在炼丹炉里，炙得焦干，送来还我，是我拿了插在瓶中，一昼夜，复得青枝绿叶，与旧相同。","book":"明·吴承恩《西游记》第二十六回"},"example":{"text":"老孙头说，‘老了呀，老弟，要是在你这样～的年纪，别说这五十个胡子，就是五百，五千，也挡得住。’","book":"周立波《暴风骤雨》第一部十九"},"usage":"作宾语、定语；用于年轻人"},{"id":46554,"word":"青梅竹马","pinyin":"qīng méi zhú mǎ","abbr":"qmzm","explanation":"青梅：青的梅子；竹马：儿童以竹竿当马骑。形容小儿女天真无邪玩耍游戏的样子。现指男女幼年时亲密无间。","source":{"text":"郎骑竹马来，绕床弄青梅。同居长干里，两小无嫌猜。","book":"唐·李白《长干行》诗"},"example":{"text":"那少年时期的～，在他心灵里留下了多少难忘的记忆啊！","book":"魏巍《东方》第一部第九章"},"similar":["两小无猜","亲密无间"],"opposite":["背信弃义"],"usage":"作主语、宾语、定语；指男女亲密关系","story":["古代金陵城长干里街道住着两户人家，两家均有孩子，他们从小在一起玩耍，小男孩骑着竹竿当马，欢快地跑出来，女孩见梅树上长着许多青梅就叫男孩去摘。男孩给他摘下许多。后来两个小孩长大结为夫妻，双双恩爱白头到老"]},{"id":46555,"word":"青楼楚馆","pinyin":"qīng lóu chǔ guǎn","abbr":"qlcg","explanation":"犹言秦楼楚馆。指歌舞场所。亦指妓院。","source":{"text":"青楼楚馆，骚人词客，杂沓其中，投赠楹联，障壁为满。","book":"清·百一居士《壶天录》卷上"},"similar":["秦楼楚馆"],"usage":"作宾语、定语；指歌榭妓院"},{"id":46556,"word":"青毡旧物","pinyin":"qīng zhān jiù wù","abbr":"qzjw","explanation":"青毡子是家传的故物。比喻珍贵之物。","source":{"text":"偷儿，青毡我家旧物，可特置之。","book":"《晋书·王献之传》"},"example":{"text":"～也是很值钱的。"},"similar":["旧物青毡"],"usage":"作主语、宾语、定语；比喻珍贵之物","story":["东晋时期，大书法家王献之为人宽宏大量。一天夜晚，他因工作到深夜就睡在书房，恰好那天晚上有几个小偷潜入书房，大肆把书房内值钱的东西都装了起来，当他偷一块旧毡子时，王献之说：“你们把值钱的东西拿走，青毡子留下。”"]},{"id":46557,"word":"青灯古佛","pinyin":"qīng dēng gǔ fó","abbr":"qdgf","explanation":"青荧的油灯和年代久远的佛像。借指佛门寂寞的生涯。","source":{"text":"可怜绣户侯门女，独卧青灯古佛旁!","book":"清·曹雪芹《红楼梦》第一一八回"},"example":{"text":"想我智能年方二九，难道真将我的青春献给～不成？","book":"欧阳予倩《馒头庵》第二场"},"usage":"作宾语、定语；用于修行"},{"id":46558,"word":"青灯黄卷","pinyin":"qīng dēng huáng juàn","abbr":"qdhj","explanation":"光线青荧的油灯和纸张泛黄的书卷。借指清苦的攻读生活。","source":{"text":"你既爱青灯黄卷，却不要随机而变。","book":"元·叶颙《书舍寒灯》诗：“青灯黄卷伴更长，花落银釭午夜香。”  元·关汉卿《拜月亭》第四折"},"example":{"text":"十载～，萤窗苦勉旃。","book":"明·兰陵笑笑生《金瓶梅词话》第三十六回"},"similar":["黄卷青灯"],"usage":"作宾语、定语；指修行学佛的孤寂生活"},{"id":46559,"word":"青白眼","pinyin":"qīng bái yǎn","abbr":"qby","explanation":"青眼：眼珠在中间，是正视时的目光；白眼：眼珠偏向一侧，是斜视时的目光。用青、白两种眼光看人。比喻待人因人地位不同而不同。","source":{"text":"阮籍母终，籍见礼俗之士，以白眼对之。及嵇喜来吊，籍作白眼，喜不怿而退。喜弟康闻之，乃赍酒挟琴造焉，籍大悦，乃见青眼。","book":"《晋书·阮籍传》"},"example":{"text":"阮籍嗜酒善啸，不循礼法，平居尝为～，与人莫逆，方觉垂青，否即反白。","book":"蔡东藩《两晋演义》第十回"}},{"id":46560,"word":"青眼白眼","pinyin":"qīng yǎn bái yǎn","abbr":"qyby","explanation":"青眼：正视的眼光；白眼：斜视的眼光。形容用不同的眼光看待自己好恶的人。","source":{"text":"及嵇喜来吊，籍作白眼，喜不择而退。喜弟康闻之，乃筴酒挟琴造焉，籍大悦，乃见青眼。","book":"唐·房玄龄《晋书·阮籍传》"},"usage":"作宾语、定语；指看人的态度","story":["魏晋时期，阮籍性格狂放不羁，做事总是由着性子，他的母亲病故，嵇康的弟弟嵇喜前去吊丧。阮籍不喜欢他就以白眼相待。嵇喜回去对嵇康倾诉受到冷遇。嵇康带上酒与琴前去吊丧，阮籍见了大喜，马上变作青眼热情招待"]},{"id":46561,"word":"青眼相加","pinyin":"qīng yǎn xiāng jiā","abbr":"qyxj","explanation":"青眼：眼睛平视。表示对人喜欢或尊敬。","source":{"text":"及嵇喜来吊，籍作白眼，喜不择而退。喜弟康闻之，乃筴酒挟琴造焉，籍大悦，乃见青眼。","book":"唐·房玄龄《晋书·阮籍传》"},"usage":"作宾语、定语；用于对人","story":["魏晋时期，阮籍性格狂放不羁，做事总是由着性子，他的母亲病故，嵇康的弟弟嵇喜前去吊丧。阮籍不喜欢他就以白眼相待。嵇喜回去对嵇康倾诉受到冷遇。嵇康带上酒与琴前去吊丧，阮籍见了大喜，马上变作青眼热情招待"]},{"id":46562,"word":"青眼相看","pinyin":"qīng yǎn xiāng kàn","abbr":"qyxk","explanation":"青眼：眼睛正视，黑眼珠在中间，比喻对人尊重或喜欢。形容以看得起的态度相待。亦作“青眼相待”、“青眼待”。","source":{"text":"唐·白居易《春雪过皇甫家》诗：“晚来篮舆雪中回，喜遇君家门正开。唯要主人青眼待，琴诗谈笑自将来。"},"example":{"text":"何况袁将军少年有为，正是建功立业之时，闯王一定会～。","book":"姚雪垠《李自成》第三卷第三十一章"}},{"id":46563,"word":"青竹丹枫","pinyin":"qīng zhú dān fēng","abbr":"qzdf","explanation":"青竹生南方，丹枫长北地。借指南北。","source":{"text":"君向楚，我归秦，便分路青竹丹枫。","book":"宋·朱敦儒《醉思仙·淮阴与杨道孚》词"},"usage":"作宾语、定语；用于书面语"},{"id":46564,"word":"青紫拾芥","pinyin":"qīng zǐ shí jiè","abbr":"qzsj","explanation":"青紫：古时公卿服饰，借喻高官显爵。得到一个大官就象捡一根草那样容易。常比喻恃才自傲，不屑走仕途之路。","source":{"text":"士病不明经术，经术苟明，其取青紫，犹俯拾地芥耳。","book":"《汉书·夏侯胜传》"},"example":{"text":"小楷书，八韵诗，～惊童儿；书小楷，诗八韵，将相文武此中进。","book":"清·魏源《都中吟》"}},{"id":46565,"word":"青紫被体","pinyin":"qīng zǐ pī tǐ","abbr":"qzpt","explanation":"青紫：古时公卿服饰，借喻高官显爵；被：同“披”。指身居高官。","source":{"text":"青紫，并贵者服饰也。","book":"汉·扬雄《解嘲》：“纡青拖紫。”李善注引《东观汉记》：“印绶，汉制公侯紫绶，九卿青绶。”刘良注"},"example":{"text":"青紫虽被体，不如早还乡。","book":"唐·杜甫《夏夜叹》诗"},"usage":"作宾语、定语；用于书面语"},{"id":46566,"word":"青紫被身","pinyin":"qīng zǐ pī shēn","abbr":"qzbs","explanation":"青紫：古时公卿服饰，借喻高官显爵；被：同“披”。指身居高官。","source":{"text":"青紫，并贵者服饰也。","book":"汉·扬雄《解嘲》：“纡青拖紫。”李善注引《东观汉记》：“印绶，汉制公侯紫绶，九卿青绶。”刘良注"}},{"id":46567,"word":"青红皁白","pinyin":"qīng hóng tóu bái","abbr":"qhzb","explanation":"①比喻是非、好歹。②比喻底细、情由。③犹言水落石出。"},{"id":46568,"word":"青红皂白","pinyin":"qīng hóng zào bái","abbr":"qhzb","explanation":"皂：黑色。青、红、黑、白四色。比喻事情的是非或原因。","source":{"text":"也不管他青红皂白，左右！且拏一面大枷来，把他枷着送在牢中再做计较。","book":"明·无名氏《梁山七虎闹铜台》"},"example":{"text":"妈妈和哥哥且别叫喊，消消停停的，就有个～了。","book":"清·曹雪芹《红楼梦》第三十四回"},"similar":["是非曲直","是非黑白"],"opposite":["是非分明"],"usage":"作宾语；指是非曲直"},{"id":46569,"word":"青肝碧血","pinyin":"qīng gān bì xuè","abbr":"qgbx","explanation":"比喻以身殉国的精神。"},{"id":46570,"word":"青脸獠牙","pinyin":"qīng liǎn liáo yá","abbr":"qlly","explanation":"獠牙：露出嘴唇的长牙。形容面貌极其凶恶狰狞。","source":{"text":"那真君抖搜精威，摇身一变，变得身高万丈……青脸獠牙，朱红头发，恶狠狠，望大圣着头就砍。","book":"明·吴承恩《西游记》第六回"},"similar":["青面獠牙"],"usage":"作定语、宾语、状语；指面目可憎"},{"id":46571,"word":"青苔黄叶","pinyin":"qīng tāi huáng yè","abbr":"qthy","explanation":"青苔遍地，落叶纷飞。形容山居人家沉静荒凉的景象。","source":{"text":"欲扫柴门迎远客，青苔黄叶满贫家。","book":"唐·刘长卿《酬李穆见寄》诗"}},{"id":46572,"word":"青蓝冰水","pinyin":"qīng lán bīng shuǐ","abbr":"qlbs","explanation":"“青出于蓝，冰寒于水”的略语。比喻学生超过老师或后人胜过前人。","source":{"text":"桐城派古文，望谿开之，海峰继之，至惜抱而其传始大，此天下之公言也。惜抱出于刘门，世几有青蓝冰水之喻。","book":"清·陈康祺《燕下乡脞录》卷四"},"usage":"作宾语、定语；用于事理"},{"id":46573,"word":"青藜学士","pinyin":"qīng lí xué shì","abbr":"qlxs","explanation":"指博学之士。","source":{"text":"刘向于成帝之末，校书天禄阁，专精覃思。夜有老人，著黄衣，直青藜杖，叩阁而进。见向暗中独坐诵书，老父乃吹杖端，烟然，因以见向，授《五行洪范》之文。至曙而来，请问姓名，云：我是太乙之精，天帝闻卯金之子有博学者，下而观焉。","book":"《三辅黄图·阁》"},"example":{"text":"尔昔为～，今为白头老监，岂非馆阁之嘉话，朝廷之盛举欤！","book":"宋·刘克庄《徐复除秘书少监制》"},"usage":"作宾语、定语；用于书面语","story":["西汉成帝时期，传说刘向在天禄阁聚精会神校书，夜晚有一个穿黄衣的拄着青藜拐杖的老人进入，看见刘向暗中独坐诵书，就吹气青藜杖，向他传授《五行洪范》，刘向担心遗漏就撕开自己的衣服一一记上。到第二天早晨太乙之精老人才离去"]},{"id":46574,"word":"青蚨飞来","pinyin":"qīng fú fēi lái","abbr":"qffl","explanation":"青蚨：传说中的虫，比喻金钱。比喻花出去的钱又回来了。","source":{"text":"皆因我襄里缺青蚨。","book":"谷子敬《城南柳》"},"usage":"作宾语、定语；比喻花出去的钱又回来","story":["传说古代一些不法商人利用青蚨母子永不分离的特点，抓大量的青蚨，把它们母子分开，分别取它们的血涂在钱上，然后将涂有母蚨的血钱放在家里，把涂有子蚨血的钱拿出去买东西。一到晚上那涂有子蚨血的钱会自动飞回来的"]},{"id":46575,"word":"青蝇之吊","pinyin":"qīng yíng zhī diào","abbr":"qyzd","explanation":"死后只有青蝇来吊。比喻生前没有知己朋友的人。","source":{"text":"自恨疏节，骨体不媚，犯上获罪，当长没海隅。生无可与语，死以青蝇为吊客。","book":"《三国志·吴书·虞翻传》裴松之注引《虞翻别传》"},"example":{"text":"差免～，空营彩凤之栖，姬于玉舟其有情耶，其无情耶？","book":"清·捧花生《秦淮画舫录·纪丽·朱芸官》"}},{"id":46576,"word":"青蝇吊客","pinyin":"qīng yíng diào kè","abbr":"qydk","explanation":"死后只有青蝇来吊。比喻生前没有知己朋友的人。","source":{"text":"自恨疏节，骨体不媚，犯上获罪，当长没海隅。生无可与语，死以青蝇为吊客。","book":"《三国志·吴书·虞翻传》裴松之注引《虞翻别传》"},"example":{"text":"青蝇为吊客，黄犬寄家书。","book":"宋·计有功《谪汀州》"},"opposite":["高朋满座"],"usage":"作定语；指没有知己朋友","story":["三国时期，会稽人虞翻在孙权手下任都尉，他为人狂放不拘，敢于直言劝谏，他醉酒骂张昭与孙权。孙权一气之下就把他流放到交州。他在流放途中潜心钻研古籍，广收门生。感慨自己没人可以交谈，死后只有青蝇作为吊唁的宾客"]},{"id":46577,"word":"青蝇染白","pinyin":"qīng yíng rǎn bái","abbr":"qyrb","explanation":"指小人用谗言诬害好人。同“青蝇点素”。","source":{"text":"疾青蝇之染白，悲小弁之靡托。","book":"《艺文类聚》卷二六引三国·魏·丁仪《厉志赋》"},"similar":["青蝇点素","青蝇点璧"],"usage":"作宾语、定语；指小人用谗言诬害好人"},{"id":46578,"word":"青蝇点玉","pinyin":"qīng yíng diǎn yù","abbr":"qydy","explanation":"比喻白璧有微瑕。","source":{"text":"青蝇点玉原非病，沧海遗珠世所嗟。","book":"唐·牟融《寄永平友人》诗之二"},"similar":["白璧微瑕"],"usage":"作主语、定语；用于事物或人"},{"id":46579,"word":"青蝇点璧","pinyin":"qīng yíng diǎn bì","abbr":"qydb","explanation":"指小人用谗言诬害好人。同“青蝇点素”。","source":{"text":"昔在词林，宿承休问，中见青蝇点璧，每切不平。","book":"明·张居正《答司成姜凤阿书》"},"similar":["青蝇点素"],"usage":"作宾语、定语；用于比喻句"},{"id":46580,"word":"青蝇点素","pinyin":"qīng yíng diǎn sù","abbr":"qyds","explanation":"青蝇：苍蝇，比喻进谗言的人；素：白色的生绢。苍蝇玷污素练。指小人用谗言诬害好人。","source":{"text":"清受尘，白取垢；青蝇所汙，常在练素。","book":"《诗·小雅·青蝇》：“营营青蝇，止于樊，岂弟君子，无信谗言。”汉·王充《论衡·累害》"},"example":{"text":"而～，同兹在藩。","book":"《后汉书·杨震传》"},"similar":["青蝇点璧","青蝇染白"],"usage":"作宾语、定语；指小人用谗言诬害好人"},{"id":46581,"word":"青衣乌帽","pinyin":"qīng yī wū mào","abbr":"qywm","explanation":"青衣：自汉以后即为卑贱者之服；乌帽：乌纱帽，本为官帽，隋唐以后流行于民间。平民的衣着。","source":{"text":"忠烈青衣乌帽。","book":"清·全祖望《梅花岭记》"},"similar":["青鞋布袜"],"usage":"作主语、宾语、定语；指平民的衣着"},{"id":46582,"word":"青衫凉笠","pinyin":"qīng shān liáng lì","abbr":"qsll","explanation":"衫：单衣；笠：斗笠。比喻夏天的衣服和帽子。","source":{"text":"流光箭紧，正柳林蝉噪，荷沼香喷，轻衫凉笠。","book":"清·孔尚任《桃花扇·孤吟》"}},{"id":46583,"word":"青衫司马","pinyin":"qīng shān sī mǎ","abbr":"qssm","explanation":"喻指失意之官吏。","source":{"text":"唐·白居易贬官江州司马时，所作《琵琶引》有“座中泣下谁最多，江州司马青衫湿”之句。"},"example":{"text":"看逸韵，自名流，～且江州。","book":"宋·辛弃疾《鹧鸪天·郑厚卿席上谢余伯山》词"},"usage":"作宾语、定语；用于官场等"},{"id":46584,"word":"青裙缟袂","pinyin":"qīng qún gǎo mèi","abbr":"qqgm","explanation":"青布裙、素色衣。谓贫妇的服饰。借指农妇，贫妇。","source":{"text":"火冷饧稀杏粥稠，青裙缟袂饷田头。","book":"宋·苏轼《次韵田国博部夫南京见寄二绝》之二"},"example":{"text":"细语道家常，生小不矜珠翠。他日郎家消受，愿～。","book":"清·龚自珍《好事近·录言》词"},"usage":"作宾语、定语；用于书面语"},{"id":46585,"word":"青过于蓝","pinyin":"qīng guò yú lán","abbr":"qgyl","explanation":"青从蓝草中提炼出来，但颜色比蓝草更深。比喻学生胜过老师，或后人胜过前人。同“青出于蓝”。","source":{"text":"青，取之于蓝，而青于蓝。","book":"《荀子·劝学》"},"example":{"text":"东坡盖学徐浩书，山谷盖学沈传师书，皆～者。","book":"宋·胡仔《苕溪渔隐丛话后集·山谷下》"},"similar":["青出于蓝","青出于蓝而胜于蓝"],"usage":"作谓语、宾语、定语；指后人胜过前人"},{"id":46586,"word":"青钱万选","pinyin":"qīng qián wàn xuǎn","abbr":"qqwx","explanation":"比喻文章出众。","source":{"text":"员外郎员半千数为公卿称鷟文辞犹青铜钱，‘万选万中’。时号鷟‘青钱学士’。","book":"《新唐书·张荐传》"},"example":{"text":"游梁赋客多风味，莫惜～才。","book":"宋·宴殊《示张寺丞王校勘》诗"},"usage":"作宾语；指人的才华","story":["唐朝工部侍郎张荐的爷爷张文成在唐高宗李治时考中进士，被任命为歧王李范府里的参军，因为他不善于巴结，官运一直不好。他想通过科举考试去解决官职问题，他一连考了八次，每次都是“甲科”均没有安排，人称他是“青钱学士”"]},{"id":46587,"word":"青钱学士","pinyin":"qīng qián xué shì","abbr":"qqxs","explanation":"以之誉称才学之士。","source":{"text":"员外郎员半千数为公卿称‘鷟（张鷟）文辞犹青铜钱，万选万中’，时号鷟‘青钱学士’。","book":"《新唐书·张荐传》"},"example":{"text":"～妙文章，便合含毫侍帝旁。","book":"宋·刘子翚《有怀·张巨山》诗"},"usage":"作宾语、定语；指有学问的人"},{"id":46588,"word":"青门种瓜","pinyin":"qīng mén zhòng guā","abbr":"qmzg","explanation":"在京城东门外种瓜。指隐居不当官。","example":{"text":"你不会去～吧。"},"usage":"作宾语、定语；指隐居不当官","story":["秦朝东陵侯召平深得西汉丞相萧何的赏识，他曾经在刘邦杀韩信、彭越时劝萧何献出家产作为补贴军用，拒收封赏以巩固地位。召平本人不愿做官，接受萧何的挽留，住在京城长安东门外青门靠种瓜为生，以显示他的清高"]},{"id":46589,"word":"青霄白日","pinyin":"qīng xiāo bái rì","abbr":"qxbr","explanation":"犹言青天白日。比喻心地光明。","source":{"text":"苟一毫衷赤不尽，尚有纤芥为名作诳语之，青霄白日，照耀我心。","book":"明·李贽《复邓石阳书》"},"similar":["青天白日"],"usage":"作宾语、分句；指大白天"},{"id":46590,"word":"青霄直上","pinyin":"qīng xiāo zhí shàng","abbr":"qxzs","explanation":"指迅速升到很高的地位。同“青云直上”。","source":{"text":"青霄直上云梯易，白首能坚铁壁难。","book":"宋·刘克庄《送洪侍御》诗之一"},"similar":["青云直上"],"usage":"作谓语、定语；指人的地位"},{"id":46591,"word":"青面獠牙","pinyin":"qīng miàn liáo yá","abbr":"qmly","explanation":"青面：脸上泛着青色；獠牙：露在外面的长牙。旧时神怪故事中形容凶神恶鬼的面貌。现形容人面貌极其凶恶。","source":{"text":"吴道子画地狱变相，青面獠牙，尽化作一团清气。","book":"明·张岱《水浒牌序》"},"example":{"text":"子牙见对营门一人，三首六臂，～。","book":"明·许仲琳《封神演义》第六十三回"},"similar":["呲牙咧嘴","横眉竖眼"],"opposite":["慈眉善目","和颜悦色"],"usage":"作定语、补语；指面目可憎"},{"id":46592,"word":"青鞋布袜","pinyin":"qīng xié bù wà","abbr":"qxbw","explanation":"原指平民的服装。旧时比喻隐士的生活。","source":{"text":"吾独何为在泥滓？青鞋布袜从此始。","book":"唐·杜甫《奉先刘少府新画山水障歌》"},"example":{"text":"某则不然，～，即日行矣。","book":"清·平步清《霞外捃屑》卷七"},"similar":["青衣乌帽"],"usage":"作宾语、定语；比喻隐士或平民的生活"},{"id":46593,"word":"青鸟传信","pinyin":"qīng niǎo chuán xìn","abbr":"qncx","explanation":"青鸟：传说中受西王母役使的神鸟，后借指传递信息的使者。比喻使者传递信息。","source":{"text":"七月七日，上于承华殿斋，正中，忽有一青鸟从西方来，集殿前。上问东方朔，朔曰：‘此西王母欲来也。’有顷王母至。","book":"唐·欧阳洵《艺文类聚·青鸟》引《汉武故事》"},"example":{"text":"瑶词～到，说群仙飞下丹霄。","book":"《雍熙乐府·第二卷·端正好》"}},{"id":46594,"word":"青鸟传音","pinyin":"qīng niǎo chuán yīn","abbr":"qncy","explanation":"青鸟：传说中西王母娘娘的神鸟。指使者传递信息。","source":{"text":"有二青鸟如乌，侠侍王母旁。","book":"《汉武帝故事》"},"example":{"text":"瑶池～到，说群仙飞下丹霄。","book":"《康熙乐府·端正好·元日朝贺》"},"similar":["青鸟使者"],"usage":"作宾语、定语；用于交往等","story":["西汉时期，晚年的汉武帝特别迷信，总希望自己能长生不老，他对神特别尊敬。经常在承华殿斋戒静坐，一天见天空中飞来两只青色的鸟围着大殿转，就问东方朔，东方朔告诉他这是王母娘娘的青鸟使者，他就更加虔诚地敬神了"]},{"id":46595,"word":"青鸟使者","pinyin":"qīng niǎo shǐ zhě","abbr":"qnsz","explanation":"指传递书信的使者。","source":{"text":"有二青鸟如乌，侠侍王母旁。","book":"《汉武帝故事》"},"example":{"text":"她喜欢干～的工作。"},"similar":["绿衣使者","青鸟传音"],"usage":"作主语、宾语、定语；指邮递员","story":["西汉时期，晚年的汉武帝特别迷信，总希望自己能长生不老，他对神特别尊敬。经常在承华殿斋戒静坐，一天见天空中飞来两只青色的鸟围着大殿转，就问东方朔，东方朔告诉他这是王母娘娘的青鸟使者，他就更加虔诚地敬神了"]},{"id":46596,"word":"青鸟殷勤","pinyin":"qīng niǎo yīn qín","abbr":"qnyq","explanation":"青鸟：古代传说中传送信件的使者。比喻常通信息，传递消息。","source":{"text":"蓬莱此去无多路，青鸟殷勤为探看。","book":"唐·李商隐《无题》诗"}},{"id":46597,"word":"青黄不交","pinyin":"qīng huáng bù jiāo","abbr":"qhbj","explanation":"青：未成熟的庄稼；黄：已成熟的庄稼。旧粮已经吃完，新粮尚未接上。比喻新旧失去衔接。","source":{"text":"来年青黄不交之际，常平有钱无米。","book":"宋·苏轼《奏浙西灾伤第一状》"},"similar":["青黄不接","青黄未接"],"opposite":["后继有人"],"usage":"作谓语、定语；指新旧连接不上"},{"id":46598,"word":"青黄不接","pinyin":"qīng huáng bù jiē","abbr":"qhbj","explanation":"青：田时的青苗；黄：成熟的谷物。旧粮已经吃完，新粮尚未接上。也比喻人才或物力前后接不上。","source":{"text":"即日正是青黄不接之际，各处物斛涌贵。","book":"《元典章·户部·仓库》"},"example":{"text":"总算安然改业，否则也许还有一段～的失业时期。","book":"邹韬奋《经历·英文教员》"},"similar":["难以为继","后继无人"],"opposite":["陈陈相因","后继有人"],"usage":"作谓语、定语；指新旧连接不上"},{"id":46599,"word":"青黄无主","pinyin":"qīng huáng wú zhǔ","abbr":"qhwz","explanation":"脸色一会儿青一会儿黄，无法控制。形容因惊恐而神色不定。","source":{"text":"四个侍妾见管小姐说的言语利害，惊得青黄无主，没话答应，走了出来。","book":"清·天花藏主人《玉支矶》第十三回"}},{"id":46600,"word":"青黄未接","pinyin":"qīng huáng wèi jiē","abbr":"qhwj","explanation":"旧粮已经吃完，新粮尚未接上。也比喻人才或物力前后接不上。同“青黄不接”。","source":{"text":"城市之民，青黄未接，食于常平者十家而九。","book":"宋·叶適《上宁宗皇帝札子》之二"},"similar":["青黄不接"],"usage":"作谓语、定语；指新旧连接不上"},{"id":46601,"word":"青黄沟木","pinyin":"qīng huáng gōu mù","abbr":"qhgm","explanation":"为无心仕进的典故。","source":{"text":"百年之木，破为牺尊，青黄而文之，其断在沟中。比犠尊于沟中之断，则美恶有间矣，其于失性一也。","book":"《庄子·天地》"}},{"id":46602,"word":"青龙白虎同行","pinyin":"qīng lóng bái hǔ tóng xíng","abbr":"qlbhth","explanation":"青龙：古称吉神；白虎：古称凶神。比喻吉凶未分，事情的发展难以预料。","source":{"text":"青龙自虎同行，吉凶全然末保。","book":"明·冯梦龙《喻世明言》卷六"}},{"id":46603,"word":"青龙金匮","pinyin":"qīng lóng jīn kuì","abbr":"qljk","explanation":"指六辰。指良辰吉日。旧时星命家以为，青龙、明堂、金匮、天德、司命等六辰为吉神，六辰值日，诸事皆宜，为黄道吉日。"},{"id":46604,"word":"靓妆炫服","pinyin":"jìng zhāng xuàn fú","abbr":"jzxf","explanation":"靓妆：美丽的装饰；炫服：华丽的服装。形容服饰打扮十分艳丽。也指打扮得十分艳丽的人。","source":{"text":"如洛之牡丹，蜀之海棠，之芍药，当其盛时，靓妆炫服，各极姿态。","book":"唐·载浮《广异记·王光本》：“忽见李氏自帏而出，靓妆炫服，有逾平素。”宋·刘克庄《小孤山记》"},"example":{"text":"二人坐在一个亭子上，看着出入的短衣硬领、细腰长裙、团扇轻衫、～的中西士女。","book":"清·曾朴《孽海花》第二回"}},{"id":46605,"word":"靓妆艳服","pinyin":"jìng zhāng yàn fú","abbr":"jzyf","explanation":"靓妆：美丽的装饰；艳服：艳丽的服装。形容服饰打扮十分艳丽。也指打扮得十分艳丽的人。","source":{"text":"靓妆艳服游川上，箫鼓声中俗自欢。","book":"唐·载浮《广异记·王光本》：“忽见李氏自帏而出，靓妆炫服，有逾平素。”宋·梅尧臣《依韵和乌程李著作四首》其三"},"example":{"text":"因为寺庙是～妇女集中之地，所以游手好闲的浪荡子弟、地痞流氓，每日必到。","book":"高阳《清官册》五"}},{"id":46606,"word":"靖言庸回","pinyin":"jìng yán yōng huí","abbr":"jyyh","explanation":"语言善巧而行动乖违。犹言口是行非。同“靖言庸违”。","source":{"text":"共鲧之徒，弗能塞也；靖言庸回，弗能惑也。","book":"汉·王符《潜夫论·明暗》"},"example":{"text":"共驩四子，于尧皆葭莩姻娅也，～，而尧亦不得不任用之。","book":"章炳麟《驳康有为论革命书》"},"similar":["靖言庸违"],"usage":"作谓语、定语；指人言行不一"},{"id":46607,"word":"靖言庸违","pinyin":"jìng yán yōng wéi","abbr":"jyyw","explanation":"指言语巧饰而行动乖违。","source":{"text":"伤害阴阳，为国家忧，无承用诏书之意，靖言庸违，象龚滔天。","book":"东汉·班固《汉书·王尊传》"},"example":{"text":"此乃欺罔天听，～，当伏共兜之诛，以清唐虞之治。","book":"宋·司马光《辞知制诰第四状》"},"similar":["言行不一","靖言庸回"],"usage":"作谓语、宾语；指言行不一"},{"id":46608,"word":"靖谮庸回","pinyin":"jìng zèn yōng huí","abbr":"jzyh","explanation":"语言善巧而行动乖违。犹口是行非。同“靖言庸回”。","source":{"text":"靖，安也；庸，用也；回，邪也。","book":"《左传·文公十八年》：“崇饰恶言，靖谮庸回。”杜预注"},"example":{"text":"～，削灭无类。","book":"宋·曾巩《韩琦制》"},"similar":["靖言庸违"],"usage":"作谓语、宾语；用于昏庸的领导"},{"id":46609,"word":"静不露机","pinyin":"jìng bù lù jī","abbr":"jblj","explanation":"静：平静，安静；露：泄露；机：机密。指在心里暗暗谋划计策，外表不露任何声色。","source":{"text":"宁伪作不知不为，不伪作假知妄为，静不露机，云雷屯也。","book":"《三十六计·假痴不癫》"}},{"id":46610,"word":"静中思动","pinyin":"jìng zhōng sī dòng","abbr":"jzsd","explanation":"静：平静，静止；动：变动。指在生活平静中希望有所改变。也指事物的静止状态达到极点就会向动的方向转化。","source":{"text":"一时忽然静中思动，因命牡丹、兰花众仙子看守洞府，去访百草仙子，不意适值外出。","book":"清·李汝珍《镜花缘》第二回"},"similar":["静极思动"],"usage":"作宾语；指事物的变化"},{"id":46611,"word":"静如处女，动如脱兔","pinyin":"jìng rú chǔ nǚ，dòng rú tuō tù","abbr":"jrcndrtt","explanation":"处女：未嫁的女子；脱兔：逃跑的兔子。指军队未行动时象未出嫁的姑娘那样持重；一行动就象飞跑的兔子那样敏捷。","source":{"text":"是故始如处女，敌人开户；后如脱兔，敌不及拒。","book":"《孙子·九地》"},"similar":["静如处女","动如脱兔"],"usage":"作宾语、定语；用于处事"},{"id":46612,"word":"静影沉璧","pinyin":"jìng yǐng chén bì","abbr":"jycb","explanation":"平静的月影映在水底，好似沉下的一块玉。"},{"id":46613,"word":"静极思动","pinyin":"jìng jí sī dòng","abbr":"jjsd","explanation":"指生活平静到了极点，就希望有所改变。亦指事物的静止状态达到极点，便会向动的方向转化。","source":{"text":"一时忽然静中思动，去访百草仙子，不意适值外出。","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"正是～，阴尽生阳。","book":"清·曾朴《孽海缘》第七回"},"similar":["静中思动"],"usage":"作宾语；指事物的变化"},{"id":46614,"word":"静若处子，动若脱兔","pinyin":"jìng ruò chǔ zǐ，dòng ruò tuō tù","abbr":"jrczdrtt","explanation":"指军队未行动时就像未出嫁的女子那样沉静，一行动就像逃脱的兔子那样敏捷。","source":{"text":"是故始如处女，敌人开户；后如脱兔，敌不及拒。","book":"孙武《孙子·九地》"},"example":{"text":"古人说‘～’，也是不动的时候要像大姑娘深藏闺中，动起来像脱网的兔子那么快。","book":"姚雪垠《李自成》第二卷第35章"},"similar":["静如处女，动如脱兔"],"usage":"作分句、定语；形容行动有章法"},{"id":46615,"word":"静观默察","pinyin":"jìng guān mò chá","abbr":"jgmc","explanation":"不动声色，仔细观察。","source":{"text":"则夫急政大务，所当静观默察者，安得复有精神以为之运用耶？","book":"宋·袁甫《右史直前奏事第二札子》"},"example":{"text":"例如画家的画人物，也是～，烂熟于心，然后凝神结想，一挥而就。","book":"鲁迅《且介亭杂文末编·“出关”的“关”》"},"usage":"作宾语、定语；用于处事"},{"id":46616,"word":"静言令色","pinyin":"jìng yán lìng sè","abbr":"jyls","explanation":"静：安静；令：和善。指用花言巧语和媚态来迷惑他人。","source":{"text":"兄宣静言令色，外巧内嫉。","book":"东汉·班固《汉书·翟方进传》"},"example":{"text":"～，即巧言令色。","book":"清·王念孙《读书杂志·汉书十三》"},"similar":["巧言令色"],"usage":"作谓语、定语；指人的言行"},{"id":46617,"word":"静言庸违","pinyin":"jìng yán yōng wéi","abbr":"jyyw","explanation":"语言善巧而行动乖违。犹言口是行非。","source":{"text":"静则能言，用则违背也。","book":"《书·尧典》：“静言庸违，象恭滔天。”孔传：“静，谋，滔，漫也。言共工自为谋言，起用行事而违背之。”蔡沈集传"},"usage":"作宾语、定语；用于处事"},{"id":46618,"word":"非业之作","pinyin":"fēi yè zhī zuò","abbr":"fyzz","explanation":"非业：不急的事务。所从事的并不是当务之急。","source":{"text":"远离父母妻子，劳于非业之作。","book":"《汉书·元帝纪》"}},{"id":46619,"word":"非亲非故","pinyin":"fēi qīn fēi gù","abbr":"fqfg","explanation":"故：老友。不是亲属，也不是熟人。表示彼此没有什么关系。","source":{"text":"佩玉与铿金，非亲亦非故。","book":"唐·马戴《寄贾岛》诗"},"example":{"text":"虽承王翁盛意，～，难以打搅。","book":"明·冯梦龙《警世通言》卷三十四"},"opposite":["沾亲带故","息息相关"],"usage":"作谓语、定语；指没有关系"},{"id":46620,"word":"非人不传","pinyin":"fēi rén bù chuán","abbr":"frbc","explanation":"不是适当的人就不传授。","source":{"text":"大抵学者用笔有法，自古秘之，必口口亲授，非人不传。","book":"宋·赵佶《宣和书谱·行书·蔡京》"},"usage":"作谓语、定语；用于技艺等"},{"id":46621,"word":"非分之念","pinyin":"fēi fèn zhī niàn","abbr":"ffzn","explanation":"分：本分；非分：不属自己分内的。指超出本分的想法念头。","source":{"text":"手上戴有两副赤金镯子，因此触动了一部分士兵的非分之念。","book":"冯玉祥《我的生活》第五章"},"example":{"text":"你不能对她有～。"},"similar":["非分之想"],"opposite":["自知之明"],"usage":"作宾语；常与“有”连用"},{"id":46622,"word":"非分之想","pinyin":"fēi fèn zhī xiǎng","abbr":"ffzx","explanation":"非分：不属自己分内的。妄想得到本分以外的好处。","source":{"text":"不信运命，学不能‘安分’，穷人买奖券，便是一种‘非分之想’。","book":"鲁迅《花边文学·命运》"},"example":{"text":"你不能对她有～。"},"similar":["痴心妄想","胡思乱想","想入非非"],"opposite":["自知之明"],"usage":"作宾语；常与“有”连用"},{"id":46623,"word":"非分之财","pinyin":"fēi fèn zhī cái","abbr":"ffzc","explanation":"不是自己应得的钱财。指本身不应该拿的钱财。","example":{"text":"～我一分也不要。"},"similar":["不义之财"],"usage":"作主语、宾语；用于钱财等"},{"id":46624,"word":"非刑吊拷","pinyin":"fēi xíng diào kǎo","abbr":"fxdk","explanation":"非刑：法律外的残酷肉刑。指使用残酷的肉刑进行审讯逼供。","source":{"text":"我实不曾为盗，你们非刑吊拷，务要我招认。","book":"明·冯梦龙《警世通言》第15卷"},"similar":["非刑逼拷","非刑拷打"],"usage":"作谓语、定语、宾语；用于刑事等"},{"id":46625,"word":"非刑拷打","pinyin":"fēi xíng kǎo dǎ","abbr":"fxkd","explanation":"非刑：法律外的残酷肉刑。指使用残酷的肉刑进行审讯逼供。","source":{"text":"在渣滓洞对江姐进行非刑拷打，很显然，这是敌人疯狂的报复！","book":"罗广斌《红岩》第15章"},"similar":["非刑吊拷","非刑逼拷"],"usage":"作谓语、定语、宾语；用于刑事等"},{"id":46626,"word":"非刑逼拷","pinyin":"fēi xíng bī kǎo","abbr":"fxbk","explanation":"非刑：法律外的残酷肉刑。指使用残酷的肉刑进行审讯逼供。","source":{"text":"他非刑逼拷，打死平民，纳贿诈财。","book":"明·东鲁古狂生《醉醒石·假虎威古玩流殃》"},"similar":["非刑吊拷","非刑拷打"],"usage":"作谓语、定语、宾语；用于刑事等"},{"id":46627,"word":"非同儿戏","pinyin":"fēi tóng ér xì","abbr":"ftex","explanation":"比喻事情很重要，不是闹着玩的。","source":{"text":"但终身大事，一生至一死，非同儿戏。","book":"清·曹雪芹《红楼梦》第六十五回"},"example":{"text":"玩是玩，笑是笑，这个事～，你可别混说！（清·曹雪芹《红楼梦》第九十四回）"},"similar":["非同小可"],"opposite":["区区小事"],"usage":"作谓语；比喻事情很重要","story":["贾宝玉从贾母那里回来后，十分得意，因为他与贾环、贾兰比试诗文胜出。在更换衣服时，袭人见他脖子上的那块通灵宝玉不见了，就问宝玉。宝玉随便扯个理由搪塞，袭人就问丫鬟麝月，麝月觉得此事非同儿戏，就与大家翻箱倒笼地找，结果一无所获"]},{"id":46628,"word":"非同寻常","pinyin":"fēi tóng xún cháng","abbr":"ftxc","explanation":"寻常：平常。形容人和事物很突出，不同于一般。","source":{"text":"况且他也是王爷之分，非同寻常可比。","book":"清·李宝嘉《官场现形记》第52回"},"example":{"text":"他是一个非同寻常的人物。"},"similar":["非同小可"],"opposite":["区区小事"],"usage":"作谓语、定语、状语；用于人与事物"},{"id":46629,"word":"非同小可","pinyin":"fēi tóng xiǎo kě","abbr":"ftxk","explanation":"小可：寻常的。指情况严重或事情重要，不能轻视。","source":{"text":"元·孟汉卿《魔合罗》第三折：”萧令史，我与你说，人命事关天关地，非同小可！”"},"example":{"text":"进了郑家门，这一惊～，只见郑老爹两眼哭得通红。","book":"清·吴敬梓《儒林外史》第二十回"},"similar":["非同寻常","非同一般"],"opposite":["区区小事","无足轻重"],"usage":"作谓语、定语；指事关重大","story":["蒋门神依仗张团练的势力霸占施恩的酒店，施恩向武松报告此事，说蒋门神称王称霸，求武松去帮忙讨回酒店。武松十分气愤，就随施恩一起去快活林，他的武功非同小可，把蒋门神收拾得服服贴贴，乖乖将酒店退回给施恩"]},{"id":46630,"word":"非同等闲","pinyin":"fēi tóng děng xián","abbr":"ftdx","explanation":"非：不；等闲：寻常，一般。指情况严重或事情重要，不能忽视。","source":{"text":"除非他自承怯弱，抛弃了这憧憬，不然，他不得不做一个非同等闲的人。","book":"《追求》"},"similar":["非同小可","非通小可"],"usage":"作谓语、定语；用于口语"},{"id":46631,"word":"非君莫属","pinyin":"fēi jūn mò shǔ","abbr":"fjms","explanation":"君：你，表示尊敬对方；莫：没有谁；属：归属，引申为占用。俇了您没有谁可以占有的。也指只有您来承担此事才能成功。"},{"id":46632,"word":"非圣诬法","pinyin":"fēi shèng wū fǎ","abbr":"fswf","explanation":"非：讥议；圣：圣人；诬：诽谤；法：法度。讥议圣人，诽谤法度。","source":{"text":"非圣诬法，大乱之殃。","book":"《汉书·金日磾传》"}},{"id":46633,"word":"非学无以广才","pinyin":"fēi xué wú yǐ guǎng cái","abbr":"fxwygc","explanation":"不学习就无从增长知识，提高才干。","source":{"text":"才须学也，非学无以广才，非志无以成学。","book":"三国·蜀·诸葛亮《诫子书》"}},{"id":46634,"word":"非常之谋","pinyin":"fēi cháng zhī móu","abbr":"fczm","explanation":"非常：不平常。不是一般的阴谋。指阴谋篡夺帝位。","source":{"text":"故世必有非常之变，然后乃有非常之谋。","book":"《汉书·孝成赵皇后传》"},"example":{"text":"大阉亦逡巡畏义，～，难于猝发。","book":"明·张溥《五人墓碑记》"},"usage":"作宾语；指阴谋篡夺帝位"},{"id":46635,"word":"非异人任","pinyin":"fēi yì rén rèn","abbr":"fyrr","explanation":"异人：别人；任：承担。不是别人的责任。表示某事应由自己负责。","source":{"text":"楚君以郑故，亲集矢于其目，非异人任，寡人也。","book":"《左传·襄公二年》"},"example":{"text":"君气概磊落，心志发扬，他日建高牙，拥大纛，非异人任也。","book":"清·王韬《淞隐漫录·阿怜阿爱》"},"similar":["匪异人任"],"usage":"作谓语；表示某事应由自己负责"},{"id":46636,"word":"非意相干","pinyin":"fēi yì xiāng gān","abbr":"fyxg","explanation":"非意：意料之外；干：冒犯。意外的无故冒犯。","source":{"text":"玠尝以人有不及，可以情恕；非意相干，可以理遣。","book":"《晋书·卫玠传》"},"example":{"text":"将午，当有匠饼者负囊而至，囊中有钱二千余，而必～也，可闭关戒妻孥勿轻应对。","book":"唐·段成式《酉阳杂俎·前集卷二·壶史》"},"usage":"作谓语；指意外的无故冒犯"},{"id":46637,"word":"非愚则诬","pinyin":"fēi yú zé wū","abbr":"fyzw","explanation":"诬：诬蔑。不是生性愚蠢的话，就是故意污蔑。","source":{"text":"盖师是而无非，师治而无乱呼？是未明天地之理，万物之情者也。是犹师天而无地，师阴而无阳，其不可行明矣。然且语而不舍，非愚则诬也。","book":"《庄子·秋水》"},"usage":"作谓语、定语；指人的做事方式"},{"id":46638,"word":"非我族类","pinyin":"fēi wǒ zú lèi","abbr":"fwzl","explanation":"族类：同族的人。指不是跟自己一条心的人。","source":{"text":"史佚之《志》有之，曰：‘非我族类，其心必异。’楚虽大，非吾族也，其肯字我乎？","book":"《左传·成公四年》"},"example":{"text":"兵不厌诈，中外皆然，～，其心必异，亦是中外皆然。","book":"高阳《清宫外史》下册"},"usage":"作谓语；常与“其心必异”连用"},{"id":46639,"word":"非我族类，其心必异","pinyin":"fēi wǒ zú lèi，qí xīn bì yì","abbr":"fwzlqxby","explanation":"族类：同族的人。我是我们同族的人，他们必定不同我们一条心。指不是跟自己一条心的人。","source":{"text":"史佚之《志》有之，曰：‘非我族类，其心必异。’楚虽大，非吾族也，其肯字我乎？","book":"《左传·成公四年》"},"example":{"text":"兵不厌诈，中外皆然，～，亦是中外皆然。","book":"高阳《清宫外史》下册"},"usage":"作宾语、定语；用于口语"},{"id":46640,"word":"非我莫属","pinyin":"fēi wǒ mò shǔ","abbr":"fwms","explanation":"莫：没有；属：隶属。除我以外不能属于任何人。","source":{"text":"以为非我莫属也。","book":"西汉·司马迁《史记·屈原列传》"},"example":{"text":"吴景濂久怀着总理一席～的念头，而今竟被别人夺去，不觉又气又恨。","book":"蔡东藩《民国通俗演义》第152回"},"similar":["舍我其谁"],"usage":"作谓语、宾语、定语；指只能是我"},{"id":46641,"word":"非战之罪","pinyin":"fēi zhàn zhī zuì","abbr":"fzzz","explanation":"不是战争本身的罪过。一般用来作为战争失败开脱罪责之辞。","source":{"text":"然今卒困于此，此天之亡我，非战之罪也。","book":"《史记·项羽本纪》"},"example":{"text":"臣涡阳退衄，～，实由陛下君臣相与见误。","book":"《梁书·侯景传》"},"usage":"作谓语、宾语；用于战争失败的托词"},{"id":46642,"word":"非所计也","pinyin":"fēi suǒ jì yě","abbr":"fsjy","explanation":"计：计算，考虑。不是所要考虑的事情。"},{"id":46643,"word":"非日非月","pinyin":"fēi rì fēi yuè","abbr":"frfy","explanation":"非：无论；日：白昼；月：月夜。不论白天还是月夜。形容不分昼夜。","source":{"text":"非日非月，为天下明。","book":"《葛子·赋篇》"},"example":{"text":"～，苍生仰其照临。","book":"南朝·徐陵《为贞阳侯与王僧辨书》"},"similar":["没日没夜"],"usage":"作定语、状语；指不分昼夜干事"},{"id":46644,"word":"非昔是今","pinyin":"fēi xī shì jīn","abbr":"fxsj","explanation":"昔：过去。今：现在。认为过去是错误的，现在是正确的。","source":{"text":"秦并六国一统天下，欲愚黔首，自我作古，往往非昔是今。","book":"《宣和书谱·隶书叙论》"},"similar":["今是昔非"],"usage":"作谓语、宾语；指否定过去"},{"id":46645,"word":"非此即彼","pinyin":"fēi cǐ jí bǐ","abbr":"fcjb","explanation":"非：不是；此：这个；即：便是；彼：那个。不是这一个，就是那一个。","example":{"text":"这种～的判断不十分准确。"},"similar":["非彼即此"],"usage":"作定语、分句；指不是这一个，就是那一个"},{"id":46646,"word":"非池中物","pinyin":"fēi chí zhōng wù","abbr":"fczw","explanation":"不是长期蛰居池塘中的小动物。比喻有远大抱负的人终究要做大事。","source":{"text":"恐蛟龙得云雨，终非池中物也。","book":"《三国志·吴书·周瑜传》"},"example":{"text":"子建怀才抱智，终～；若不早除，必为后患。","book":"明·罗贯中《三国演义》第七十九回"},"opposite":["等闲之辈"],"usage":"作谓语、宾语；指人有抱负"},{"id":46647,"word":"非熊非罴","pinyin":"fēi xióng fēi pí","abbr":"fxfp","explanation":"圣主将得贤臣的征兆。也指辅佐帝王的重臣。","source":{"text":"将大获，非熊非罴，天遗汝师以佐昌。","book":"《史记·齐太公世家》：“西伯将出猎，卜之，曰：‘所获非龙非彨，非虎非罴，所获霸王之辅。”《宋书·符瑞志上》"},"example":{"text":"大微上将，文昌贵相，～，令问令望。宠踰丰，荣参武帐。","book":"唐·杨炯《唐右将军魏哲神道碑》"},"similar":["非罴非熊"],"usage":"作谓语、定语；用于书面语"},{"id":46648,"word":"非知之难，行之惟艰","pinyin":"fēi zhī zhī nán，xíng zhī wéi jiān","abbr":"fzznxzwj","explanation":"知道它并不难，去做它就难了。","source":{"text":"非知之难，行之惟艰；非行之难，终之斯难。","book":"唐·魏征《十渐不克终疏》"},"similar":["知之非艰，行之惟艰"],"usage":"作宾语、分句；用于劝诫人"},{"id":46649,"word":"非罴非熊","pinyin":"fēi pí fēi xióng","abbr":"fpfx","explanation":"罴：熊的一种。不是熊也不是罴。旧指圣主得贤臣的征兆。","source":{"text":"公之功烈，如岳如嵩，公之遇合，非罴非熊。","book":"清·张岱《祭少师朱恒岳公文》"},"similar":["非熊非罴"],"usage":"作谓语、定语；用于书面语"},{"id":46650,"word":"非誉交争","pinyin":"fěi yù jiāo zhēng","abbr":"fyjz","explanation":"非：同“诽”；交：交替；争：争执。诽谤和赞誉交织在一起，争持不下。","source":{"text":"人主释法而以臣备臣，则相爱者比周而相誉，相憎者朋党而相非，非誉交争，则主惑乱矣。","book":"《韩非子·南面》"}},{"id":46651,"word":"非议诋欺","pinyin":"fēi yì dǐ qī","abbr":"fydq","explanation":"指诬蔑毁谤。","source":{"text":"俗人乃造端作基，非议诋欺。","book":"《汉书·刘向传》"}},{"id":46652,"word":"非请莫入","pinyin":"fēi qǐng mò rù","abbr":"fqmr","explanation":"没有被邀请请不要进入。","example":{"text":"药房重地，～。"},"opposite":["不速之客"],"usage":"作宾语、定语；用于警示牌"},{"id":46653,"word":"非通小可","pinyin":"fēi tōng xiǎo kě","abbr":"ftxk","explanation":"非：不；通：同“同”；小可：寻常，一般。指情况严重或事情重要，不能忽视。","source":{"text":"这的是人命事，非通小可。","book":"《永乐大典戏文·》"},"similar":["非同小可","非同等闲"],"usage":"作谓语、定语；指事关重大"},{"id":46654,"word":"非钱不行","pinyin":"fēi qián bù xíng","abbr":"fqbx","explanation":"没有钱就办不成。旧指由于贪官污吏的勒索，很多事情都必须用钱打通关节才能办到。","source":{"text":"郑愔为吏部侍郎，掌选，赃污狼籍。有选人系百钱于靴带上。愔问故，答曰：‘当今之选，非钱不行。’","book":"唐·张鷟《朝野佥载》"},"example":{"text":"你们知道现在是～的世界了。","book":"清·刘鹗《老残游记》第一回"},"usage":"作谓语、定语；用于处事","story":["唐朝时期，郑愔被派去任吏部侍郎，掌管下级官吏的选拔，当时官场十分黑暗，贪污腐化成风，不向吏部官员行贿就要不到美差。有一个待选的官吏把100钱系到靴带上，郑愔见了觉得奇怪，就问他缘故。对方说：“当今之选，非钱不行。”"]},{"id":46655,"word":"非非之想","pinyin":"fēi fēi zhī xiǎng","abbr":"ffzx","explanation":"指不合逻辑的，荒诞、怪异、不能实现的种种幻想。"},{"id":46656,"word":"非驴非马","pinyin":"fēi lǘ fēi mǎ","abbr":"flfm","explanation":"不是驴也不是马。比喻不伦不类，什么也不象。","source":{"text":"驴非驴，马非马，若龟兹王，所谓骡也。","book":"《汉书·西域传下》"},"example":{"text":"屈以巡按使兼总司令，布告中外，～，惊骇万分。","book":"蔡东藩、许厪父《民国通俗演义》第六九回"},"similar":["不伦不类","不三不四"],"opposite":["一本正经"],"usage":"作谓语、状语、补语；常与“不伦不类”连用","story":["汉朝时，西域有一个龟兹国国王绛宾，在汉宣帝时多次访问汉朝，他对汉朝的文化特别喜欢，回国后大力推广汉朝的文化，这与西域的传统习俗大相径庭，人们认为他的这一套似是而非的东西是驴马杂交的骡子"]},{"id":46657,"word":"靠天吃饭","pinyin":"kào tiān chī fàn","abbr":"ktcf","explanation":"指依赖自然条件来过日子。","source":{"text":"为什么人家说，靠天吃饭，赖地穿衣呢？","book":"清·文康《儿女英雄传》第33回"},"example":{"text":"我们的农业至今还不能摆脱～的局面。"},"usage":"作谓语、定语、宾语；指落后的农业"},{"id":46658,"word":"靠山吃山，靠水吃水","pinyin":"kào shān chī shān，kào shuǐ chī shuǐ","abbr":"kscskscs","explanation":"比喻自己所在的地方有什么条件，就依靠什么条件生活。","source":{"text":"自古道，靠山吃山，靠水吃水。","book":"明·冯梦龙《醒世恒言》第三卷"},"example":{"text":"～，靠阎王吃小鬼。","book":"《上饶集中营·集中营在福建》"},"similar":["近水楼台"],"usage":"作谓语、宾语、定语、分句；指充分利用资源"},{"id":46659,"word":"靠胸贴肉","pinyin":"kào xiōng tiē ròu","abbr":"kxtr","explanation":"形容十分亲密的样子。","source":{"text":"我两个是他靠胸贴肉的徒弟，我师父却又好道爱贤，只听见说个‘道’字，就也接出大门。","book":"明·吴承恩《西游记》第四十四回"}},{"id":46660,"word":"靡不所措","pinyin":"mǐ zhī suǒ cuò","abbr":"mbsc","explanation":"靡：不；措：处理。不知该如何办才好。","source":{"text":"惠怀多难，帝主不造，夷狄豺狼，肆其暴乱，京都倾覆，宗庙为墟，孤悼心失图，靡知所措。","book":"晋·元帝《改元赦令》"}},{"id":46661,"word":"靡不有初，鲜克有终","pinyin":"mǐ bù yǒu chū，xiǎn kè yǒu zhōng","abbr":"mbycxkyz","explanation":"靡：无；初：开始；鲜：少；克：能。事情都有个开头，但很少能到终了。多用以告诫人们为人做事要善始善终。","source":{"text":"荡荡上帝，下民之辟。疾威上帝，其命多辟。天生烝民，其命匪谌。靡不有初，鲜克有终。","book":"《诗经·大雅·荡》"},"example":{"text":"你如今那里想俺家，道不得个～。","book":"元·王实甫《西厢记》第五本第四折"},"usage":"作分句；用以告诫人们做事要善始善终"},{"id":46662,"word":"靡哲不愚","pinyin":"mǐ zhé bù yú","abbr":"mzby","explanation":"靡：没有；哲：哲人。没有一个哲人不出现愚蠢的时候。比喻任何人都会犯错误。","source":{"text":"人亦有言，靡哲不愚。","book":"《诗经·大雅·抑》"}},{"id":46663,"word":"靡坚不摧","pinyin":"mí jiān bù cuī","abbr":"mjbc","explanation":"指能摧毁任何坚固的东西。形容力量强大。","source":{"text":"有一国焉，度其兵力之厚，靡坚不摧。","book":"汪东《革命今势论》"},"example":{"text":"汪东《革命今势论》：“有一国焉，度其兵力之厚，～。”"},"similar":["无坚不摧"],"usage":"作谓语、定语；指力量大"},{"id":46664,"word":"靡室靡家","pinyin":"mǐ shì mǐ jiā","abbr":"msmj","explanation":"靡：没有。没有家室。","source":{"text":"曰归曰归，岁亦莫止。靡室靡家，猃狁之故。","book":"《诗经·小雅·采薇》"}},{"id":46665,"word":"靡所不为","pinyin":"mǐ suǒ bù wéi","abbr":"msbw","explanation":"靡：无，没有；为：做。没有不干的事情。指什么坏事都干。","source":{"text":"男好女犹可言也，女好男，遂至无耻丧心，灭伦败纪，靡所不为，如武后、韦后、安乐公主、太平公主等是也。","book":"清·褚人获《隋唐演义》第78回"},"similar":["无所不为"],"usage":"作谓语、定语；指什么坏事都干"},{"id":46666,"word":"靡所底止","pinyin":"mí suǒ dǐ zhǐ","abbr":"msdz","explanation":"指没有止境。","source":{"text":"胡转予于恤，靡所底止。","book":"《诗经·小雅·祈父》"},"example":{"text":"风俗日趋于奢淫，～，安得有敦古朴之君子，力挽江河。","book":"清·王永彬《围炉夜话》"},"usage":"作谓语、定语；用于书面语"},{"id":46667,"word":"靡所适从","pinyin":"mí suǒ shì cóng","abbr":"mssc","explanation":"不知何所依从。","source":{"text":"或拟议不定，靡所适从。","book":"明·张居正《请裁定宗藩事例疏》"},"example":{"text":"明·张居正《请裁定宗藩事例疏》：“或拟议不定，靡所适从。”"},"similar":["无所适从"],"usage":"作谓语、宾语、定语；形容不知怎么办"},{"id":46668,"word":"靡旗辙乱","pinyin":"mǐ qí zhé luàn","abbr":"mqzl","explanation":"靡：倒下。指车迹错乱，军旗倒下。形容军队溃败。","source":{"text":"未有凭陵我郊沂，侵轶我河县，而不焚师殪甲，靡旗辙乱者也。","book":"《宋书·沈攸之传》"},"similar":["辙乱旗靡"],"usage":"作谓语、定语、状语；用于军事或集体活动"},{"id":46669,"word":"靡日不思","pinyin":"mǐ rì bù sī","abbr":"mrbs","explanation":"靡：没有。没有一天不思念的。形容非常想念。","source":{"text":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。","book":"《诗经·国风·邶风》"},"example":{"text":"苹蘩芳滋，同谁掇之。愿言贤德，～。","book":"《宋史·乐志十四》"}},{"id":46670,"word":"靡有孑遗","pinyin":"mǐ yǒu jié yí","abbr":"myjy","explanation":"靡：无，没有；孑遗：遗留，剩余。没有剩余。","source":{"text":"周余黎民，靡有孑遗。","book":"《诗经·大雅·云汉》"},"example":{"text":"是故每有太古最繁之种，风气渐革，越数百年数千年，消磨歇绝，至于～，如矿学家所见之古兽古禽是已。","book":"严复《原强》"},"usage":"作谓语；指没有剩余"},{"id":46671,"word":"靡然乡风","pinyin":"mǐ rán xiàng fēng","abbr":"mrxf","explanation":"靡：倒下；乡：同“向”：趋向，向着。形容纷纷趋附、效尤而成风气。","source":{"text":"黜黄老、刑名、延文学儒者以百数，而公孙弘以治《春秋》为丞相封侯，天下学士，靡然乡风。","book":"《汉书·儒林传》"},"similar":["靡然从风","靡然向风"],"usage":"作谓语；指形成风气"},{"id":46672,"word":"靡然从风","pinyin":"mǐ rán cóng fēng","abbr":"mrcf","explanation":"指群起效尤而成风气。","source":{"text":"然非龙溪先生五六十年守其师说，不少改变，亦未必靡然从风，一至此也。","book":"明·李贽《答马历山书》"},"example":{"text":"惜抱振兴绝学，海内～。","book":"清·王先谦《〈续古文辞类纂〉例略》"},"similar":["靡然成风","靡然向风"],"usage":"作谓语；指形成风气"},{"id":46673,"word":"靡然向风","pinyin":"mí rán xiàng fēng","abbr":"mrxf","explanation":"指群起效尤而成风气。亦作“靡然乡风”。亦作“靡然乡风”。","source":{"text":"黜黄老、刑名、延文学儒者以百数，而公孙弘以治《春秋》为丞相封侯，天下学士，靡然乡风。","book":"《汉书·儒林传》"},"example":{"text":"自敕下之后，天下士大夫之子弟，莫不～，笃于为学。","book":"清·毕沅《续资治通鉴》卷四十七"},"similar":["靡然从风"],"usage":"作谓语；指形成风气"},{"id":46674,"word":"靡然成风","pinyin":"mí rán chéng fēng","abbr":"mrcf","explanation":"指群起效尤而成风气。","source":{"text":"谈虚论寂，靡然成风。","book":"《明史·张岳传》"},"example":{"text":"当是时，李献吉以学杜雄压海内，窜窃剽贼，～。","book":"清·周亮工《书影》卷七"},"similar":["靡然从风","靡然乡风","蔚然成风"],"usage":"作谓语；指形成风气"},{"id":46675,"word":"靡然顺风","pinyin":"mí rán shùn fēng","abbr":"mrsf","explanation":"指望风顺从。","source":{"text":"黜黄老、刑名、延文学儒者以百数，而公孙弘以治《春秋》为丞相封侯，天下学士，靡然乡风。","book":"《汉书·儒林传》"},"example":{"text":"幅员万里，驯致九泽，诏书下日，～。","book":"唐·张说《文州都督岭南按察五府经略使宋公遗爱碑颂》"},"usage":"作谓语；表示臣服"},{"id":46676,"word":"靡知所措","pinyin":"mí zhī suǒ cuò","abbr":"mzsc","explanation":"靡：无、不。措：处理。不知该如何办才好。","source":{"text":"京都倾覆，宗庙为墟，孤悼心失图，靡知所措。","book":"晋·元帝《改元赦令》"},"similar":["不知所措"],"opposite":["从容自若"],"usage":"作谓语、状语、定语；指处境很为难"},{"id":46677,"word":"靡衣偷食","pinyin":"mǐ yī tōu shí","abbr":"myts","explanation":"靡：华丽；偷：苟且。美衣甘食，苟且偷生。","source":{"text":"众庶莫不辍作怠惰，靡衣偷食，倾耳以待命者。","book":"东汉·班固《汉书·韩信传》"},"example":{"text":"昔毛玠在朝，士大夫不敢～。","book":"《梁书·武帝纪上》"},"usage":"作谓语、定语；形容富贵的人苟且偷"},{"id":46678,"word":"靡衣媮食","pinyin":"mǐ yī tōu shí","abbr":"myts","explanation":"靡：华丽；媮：苟且。身穿丽服，苟且而食。形容富贵的人苟且偷生。","source":{"text":"众庶莫不辍作怠惰，靡衣媮食，倾耳以待命者。","book":"《汉书·韩信传》"}},{"id":46679,"word":"靡衣玉食","pinyin":"mǐ yī yù shí","abbr":"myys","explanation":"靡衣：鲜艳华美的衣服；玉食：珍美的食品。精美的衣食。形容豪华奢侈的生活。","source":{"text":"亮协固凶党，作威作福，靡衣玉食，女乐盈房。","book":"《梁书·王亮传》"},"example":{"text":"～以馆于上者，不可胜数。","book":"宋·苏轼《论养士》"},"similar":["锦衣玉食"],"opposite":["粗衣粝食"],"usage":"作宾语、定语；指生活浪费"},{"id":46680,"word":"靡靡之乐","pinyin":"mǐ mǐ zhī yuè","abbr":"mmzy","explanation":"指柔弱、颓靡的音乐。","source":{"text":"于是使师涓作新淫声，北里之舞，靡靡之乐。","book":"《韩非子·十过》：“此师延之所作，与纣为靡靡之乐也……先此声者，其国必削。”《史记·殷本纪》"},"example":{"text":"三代之衰，邪音间起，则有烂漫～兴焉。","book":"北齐·魏收《魏书·乐志》"},"similar":["靡靡之音","靡靡之声"],"usage":"作主语、宾语；指庸俗音乐"},{"id":46681,"word":"靡靡之声","pinyin":"mǐ mǐ zhī shēng","abbr":"mmzs","explanation":"指柔弱、颓靡的音乐。同“靡靡之音”。","source":{"text":"事毕，将奏靡靡之声。","book":"《南史·宋纪中·前废帝》"},"example":{"text":"现代流行乐曲不乏～"},"similar":["靡靡之音"],"usage":"作主语、宾语；指庸俗音乐"},{"id":46682,"word":"靡靡之音","pinyin":"mǐ mǐ zhī yīn","abbr":"mmzy","explanation":"靡靡：柔弱，萎靡不振。使人萎靡不振的音乐。指颓废的、低级趣味的乐曲。","source":{"text":"北里之舞，靡靡之乐。","book":"《韩非子·十过》：“此师延之所作，与纣为靡靡之乐也。”《史记·殷本纪》"},"example":{"text":"从此以后，以管弦的情绪代替了鼓的情绪，结果都是“～”。","book":"闻一多《时代的歌手》"},"similar":["亡国之音"],"opposite":["钧天广乐"],"usage":"作主语、宾语；指颓废的音乐","story":["春秋末年，晋平公在城外建造一座豪华的宫殿。卫灵公带涓乐师前去祝贺，席间涓乐师把在濮水边听来的乐曲弹了一遍。晋国的旷乐师马上制止说是商末延乐师为纣王所作的靡靡之音，听了会沉湎声色中。3年后，晋平公因贪色而亡"]},{"id":46683,"word":"靡颜腻理","pinyin":"mǐ yán nì lǐ","abbr":"mynl","explanation":"靡：美丽；颜：面容；腻：细腻；理：肌理。形容容貌美丽，皮肤细腻柔滑。","source":{"text":"靡颜腻理，遗视绵些。","book":"战国·楚·宋玉《招魂》"},"example":{"text":"拜见之下，果然～。","book":"清·袁枚《小仓山房尺牍》第96回"},"usage":"作谓语、定语；指人的肌肤"},{"id":46684,"word":"面不改容","pinyin":"miàn bù gǎi róng","abbr":"mbgr","explanation":"指脸色不改变。形容遇到危难时，镇定自若。","source":{"text":"吉平面不改容，略无惧怯。","book":"明·罗贯中《三国演义》第23回"},"similar":["面不改色"],"opposite":["大惊失色"],"usage":"作谓语、定语、状语；指人镇定自若"},{"id":46685,"word":"面不改色","pinyin":"miàn bù gǎi sè","abbr":"mbgs","explanation":"脸色不变。形容从容镇静的样子。","source":{"text":"我这虎头寨上，但凡拿住的人呵，见了俺，丧胆亡魂，今朝拿住这厮，面不改色。","book":"元·秦简夫《赵礼让肥》第二折"},"example":{"text":"（秦王）叱左右前缚（蔺）相如，相如～。","book":"明·冯梦龙《东周列国志》第九十六回"},"similar":["神色自若","镇定自若"],"opposite":["大惊失色","惊惶失措"],"usage":"作谓语、定语、状语；指人镇定自若"},{"id":46686,"word":"面争庭论","pinyin":"miàn zhēng tíng lùn","abbr":"mztl","explanation":"指直言敢谏。同“面折庭争”。","source":{"text":"他日闻有立天子陛下，直辞正色，面争庭论者，必范君也。","book":"宋·欧阳修《上范司谏书》"},"usage":"作宾语、定语；指为人敢说话"},{"id":46687,"word":"面从后言","pinyin":"miàn cóng hòu yán","abbr":"mchy","explanation":"从：听从，顺从。当面顺从，背后乱说。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"人心不同，各如其面。～，古人之所诫也。","book":"《三国志·蜀志·蒋琬传》"},"similar":["面从背言"],"usage":"作谓语、定语；用于人表里不一"},{"id":46688,"word":"面从心违","pinyin":"miàn cóng xīn wéi","abbr":"mcxw","explanation":"表面顺从，心里不以为然。","source":{"text":"世兄果为嫌家伯语重，何难回头是岸，万不可面从腹诽。","book":"清·李绿园《歧路灯》第六十三回"},"example":{"text":"倘～，致失朝廷实事求是本旨，非朕所望也。","book":"《清史稿·德宗本纪二》"}},{"id":46689,"word":"面从背言","pinyin":"miàn cóng bèi yán","abbr":"mcby","explanation":"从：听从，顺从。当面顺从，背后乱说。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"当时皆谓祸不及身，～，不以为患。","book":"唐·吴兢《贞观政要·政体》"},"similar":["面从后言"],"usage":"作谓语、定语；用于人表里不一"},{"id":46690,"word":"面从背违","pinyin":"miàn cóng bèi wéi","abbr":"mcbw","explanation":"面：当面；从：顺从；背：背后。当面顺从，背后有意见，说坏话。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"自古人心难测，～；知外而不知内，如内而不知心。","book":"明·许仲琳《封神演义》第二十一回"}},{"id":46691,"word":"面从腹诽","pinyin":"miàn cóng fù fěi","abbr":"mcff","explanation":"诽：毁谤。表面顺从，心里不以为然。","source":{"text":"世兄果为嫌家伯语重，何难回头是岸，万不可面从腹诽。","book":"清·李绿园《歧路灯》第六十三回"}},{"id":46692,"word":"面从腹非","pinyin":"miàn cóng fù fēi","abbr":"mcff","explanation":"从：听从，顺从。表面顺从，心里反对。","source":{"text":"世兄果不嫌家伯语重，何难回头是岸，万不可面从腹非。","book":"清·李绿园《歧路灯》第63回"},"similar":["面从后言"],"usage":"作谓语、定语；用于人表里不一"},{"id":46693,"word":"面似靴皮","pinyin":"miàn sì xuē pí","abbr":"msxp","explanation":"脸上皮肤如同靴皮。形容满脸皱纹。","source":{"text":"田元均为人宽厚长者，其在三同，深厌干请者，虽不能从，然不欲峻拒之，每温颜强笑之，尝谓人曰：‘作三司使数年，强笑多矣，直笑得面似靴皮。’","book":"宋·欧阳修《归田录》卷二"},"usage":"作谓语、状语、定语；指满脸皱纹"},{"id":46694,"word":"面冷言横","pinyin":"miàn lěng yán hèng","abbr":"mlyh","explanation":"横：粗暴。面孔冷漠，说话蛮横。","source":{"text":"格尔思表示，条约改议，外国尚有之，罪使从古未有。面冷言横。","book":"高阳《清宫外史》"},"usage":"作谓语、定语；用于人的态度"},{"id":46695,"word":"面北眉南","pinyin":"miàn běi méi nán","abbr":"mbmn","explanation":"指脸面相背，互不理睬。形容相处不合，各不照面。","source":{"text":"既然是你为我来，须回避，且做个面北眉南，你东咱西。","book":"元·无名氏《马陵道》第三折"},"example":{"text":"明·贾仲名《萧淑兰》第二折：“俺那崔氏女正红愁绿惨，你个张君瑞待～。”"},"usage":"作宾语、定语；指关系不融洽"},{"id":46696,"word":"面命耳提","pinyin":"miàn mìng ěr tí","abbr":"mmet","explanation":"面：当面。不仅是当面告诉他，而且是提着他的耳朵向他讲。形容长辈教导热心恳切。","source":{"text":"匪面命之，言提其耳。","book":"《诗经·大雅·抑》"},"example":{"text":"幸以翰墨小技，待罪视草，词意有未稳处，仰荷明主亲洒奎画，不啻～。","book":"宋·刘克庄《拟撰科诏回奏》"},"similar":["耳提面命"],"usage":"作谓语；形容长辈教导热心恳切"},{"id":46697,"word":"面命耳训","pinyin":"miàn mìng ěr xùn","abbr":"mmex","explanation":"命：训诫。提着耳朵当面告诉他。形容长辈教导热心恳切，要求严格。","source":{"text":"而对于秦始皇，也俨然就像在面命耳训的一样。","book":"郭沫若《十批判书·吕不韦与秦王政的批评》"},"similar":["耳提面命"],"usage":"作谓语、定语、状语；用于长辈对晚辈"},{"id":46698,"word":"面和心不和","pinyin":"miàn hé xīn bù hé","abbr":"mhxbh","explanation":"表面上很和气，心里却有矛盾。","source":{"text":"为此两下面和意不和，巴不能刘家有些事故，幸灾乐祸。","book":"明·冯梦龙《醒世恒言》卷八"},"example":{"text":"既然他俩平日～，怕临时闹别扭坏了大事，我替你去督战吧，看谁敢不齐心！","book":"姚雪垠《李自成》第二卷第四章"},"similar":["面和意不和","貌合神离"],"usage":"作谓语、定语、状语；用于人际关系"},{"id":46699,"word":"面和意不和","pinyin":"miàn hé yì bù hé","abbr":"mhybh","explanation":"意：心意。表面上很和气，心里却有矛盾。","source":{"text":"为此两下面和意不和，巴不能刘家有些事故，幸灾乐祸。","book":"明·冯梦龙《醒世恒言》卷八"},"example":{"text":"原来这班水手，与船头～，也有个缘故。","book":"明·冯梦龙《醒世恒言》卷三十六"},"similar":["面和心不和"],"usage":"作谓语、定语、状语；用于人际关系"},{"id":46700,"word":"面善心恶","pinyin":"miàn shàn xīn è","abbr":"msxe","explanation":"面貌善良，心里却很恶毒。形容两面派的狡猾阴险。","source":{"text":"发作要鹰捉勇猛，外静胆大，机要熟运，切勿畏惧迟疑，心小胆大，面善心恶。","book":"宋·岳飞《武穆遗书·九要论》"},"example":{"text":"可是世上～之辈正多，这彭长老何尝不是笑容可掬，和蔼得很？","book":"金庸《神雕侠侣》第三十回"}},{"id":46701,"word":"面团团","pinyin":"miàn tuán tuán","abbr":"mtt","explanation":"形容脸又胖又圆。也形容人软弱，无棱角。","source":{"text":"索头连背暖，漫裆畏肚寒。只缘心混混，所以面团团。","book":"唐·欧阳洵《嘲长孙无忌》诗"},"example":{"text":"自然，人们中尽不乏～地活到八十九十，而且心地太平，并无苦恼的。","book":"鲁迅《文序跋集·出了象牙之塔》"}},{"id":46702,"word":"面墙而立","pinyin":"miàn qiáng ér lì","abbr":"mqel","explanation":"比喻不学之人，如面对墙壁而立，一无所见。","source":{"text":"人而不学，其犹正墙面而立。","book":"《尚书·周官》：“不学墙面。”孔安国传"},"example":{"text":"古今成败，不可不知，退朝之暇，念观典籍，～，不成人也。","book":"《晋书·凉武昭王李玄盛传》"},"usage":"作宾语、定语；指一无所知"},{"id":46703,"word":"面壁九年","pinyin":"miàn bì jiǔ nián","abbr":"mbjn","explanation":"面壁：佛家语，指面对墙壁默坐静修。原指中国佛教禅宗始祖达摩在少林寺面壁静修了九年。后比喻在学习上下得功夫极深。","source":{"text":"惆怅洛阳人未来，面壁九年空冷坐。","book":"宋·释普济《五灯会元》卷十七"},"example":{"text":"～看二祖，一花五叶亲分付。","book":"宋·黄庭坚《渔家傲》词"}},{"id":46704,"word":"面壁功深","pinyin":"miàn bì gōng shēn","abbr":"mbgs","explanation":"面壁：佛家语，指面对墙壁默坐静修。和尚面壁静修，道行很深。比喻某人在某一方面造诣很深。","source":{"text":"寓于嵩山少林寺，面壁而坐，终日默然，人莫之测，谓之壁观婆罗门。","book":"宋·释普济《五灯会元·东土祖师》"},"example":{"text":"你听说达摩老祖～的故事吗？"},"usage":"作宾语、定语；指人的修行","story":["南朝时期，天竺国和尚佑达摩（达摩老祖）到南朝梁首都建业同梁武帝萧衍谈佛家，话不投机就到嵩山少林寺住下，讲解《易筋经》，他整天整夜面对石洞的墙壁“壁观婆罗门”静坐，一句话不说，这样坚持了九年，一直到老死"]},{"id":46705,"word":"面壁磨砖","pinyin":"miàn bì mó zhuān","abbr":"mbmz","explanation":"比喻事不能成功。","source":{"text":"开元中有沙门道一住传法院，常日坐禅……师乃取一砖，於彼庵前石上磨。一曰：‘师作什麽？’师曰：‘磨作镜。’一曰：‘磨砖岂能成镜邪？’（师曰）：‘坐禅岂得作佛邪？’","book":"《景德传灯录·南岳怀让禅师》"},"example":{"text":"守株待兔虽达者之不为，～亦古人之常事。","book":"宋·陈师道《请月长老再住荐福疏》"},"usage":"作宾语、定语；用于处事","story":["唐玄宗开元年间，沙门有个住在传法院和尚道一，经常面壁坐禅，修炼法术。他的禅师见他的修炼不对，就拿一块砖在庵前的大石头上磨来磨去。道一问他为什么要这样，禅师说磨作镜子。道一说：“磨砖岂能成镜邪？”，禅师说：“坐禅岂得作佛邪？”"]},{"id":46706,"word":"面壁而已","pinyin":"miàn bì ér yǐ","abbr":"mbey","explanation":"面壁：面向墙壁；而已：罢了。面向墙壁呆坐罢了。比喻无所事事。","source":{"text":"谢奕性粗，尝忿述，极言骂之。述无所应，面壁而已，居半日，奕去，始复坐。人以此称之。","book":"《晋书·王述传》"},"example":{"text":"垂帏痛饮，～。","book":"宋·郑文宝《南唐近事》"}},{"id":46707,"word":"面壁虚构","pinyin":"miàn bì xū gòu","abbr":"mbxg","explanation":"对着墙壁凭空造出来的。比喻凭空捏造。","source":{"text":"这位名震一时的北洋派勇将，完全变成了一个面壁虚构的神话家。","book":"陶菊隐《北洋军阀统治时期史话》第72章"},"similar":["乡壁虚造","凭空捏造","向壁虚构"],"usage":"作谓语、宾语、定语；指凭空捏造"},{"id":46708,"word":"面如傅粉","pinyin":"miàn rú fǔ fěn","abbr":"mrff","explanation":"形容男子美貌。","source":{"text":"何平叔美姿仪，面至白；魏明帝疑其傅粉。正夏月，与热汤饼。既啖，大汗出，以朱衣自拭，色转皎然。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"这两人，～，唇若涂朱，举止风流，芳兰竞体。","book":"清·吴敬梓《儒林外史》第34回"},"similar":["傅粉何郎"],"usage":"作谓语、定语；形容男子美貌"},{"id":46709,"word":"面如冠玉","pinyin":"miàn rú guān yù","abbr":"mrgy","explanation":"比喻男子徒有其表。也用来形容男子的美貌。","source":{"text":"绛侯、灌婴等咸谗陈平曰：‘平虽美丈夫，如冠玉耳，其中未必有也。’","book":"西汉·司马迁《史记·陈丞相世家》"},"example":{"text":"玄德见孔明身长八尺，～，头戴纶巾。","book":"明·罗贯中《三国演义》第38回"},"similar":["面如傅粉","美如冠玉"],"usage":"作谓语、定语；形容男子的美貌"},{"id":46710,"word":"面如凝脂","pinyin":"miàn rú níng zhī","abbr":"mrnz","explanation":"凝脂：凝结的脂肪。相貌白净而丰润。","source":{"text":"面如凝脂，眼如点漆，此神仙中人。","book":"南朝·宋·刘义庆《世说新语·容止》"},"similar":["面如傅粉"],"usage":"作谓语、定语；指人的相貌"},{"id":46711,"word":"面如土色","pinyin":"miàn rú tǔ sè","abbr":"mrts","explanation":"脸色呈灰白色。形容惊恐之极。","source":{"text":"李白重读一遍，读得音韵铿锵，番使不敢则声，面如土色，不免呼拜舞辞朝。","book":"《敦煌变文集·捉季布变文》：“归到壁前看季布，面如土色结眉频。”明·冯梦龙《警世通言》卷九"},"example":{"text":"这是谁干的，我并没得罪人，为什么这么坑我？”（清·曹雪芹《红楼梦》第九十三回","book":"贾芹拾来一看，吓得～，说道"},"similar":["面无人色","面色如土"],"opposite":["面不改色"],"usage":"作谓语、定语、补语、状语；指惊恐","story":["南宋时期，秀才俞良步行8千里到达京城杭州应试，结果名落孙山，他身无分文，就到杭州西湖边作鹊桥仙词然后准备自杀被救。太上皇在梦中认定俞良是人才，派人到旅店找他，吓得店主孙婆面如土色，俞良从此被封为大官"]},{"id":46712,"word":"面如方田","pinyin":"miàn rú fāng tián","abbr":"mrft","explanation":"面：脸。脸方得像“田”字，指富贵相。","source":{"text":"帝大惊，目安人曰：‘卿面如方田，状封侯也。’","book":"《南齐书·李安人传》"},"usage":"作谓语；指人的长相"},{"id":46713,"word":"面如死灰","pinyin":"miàn rú sǐ huī","abbr":"mrsh","explanation":"死灰：冷却的灰烬。形容因心情沮丧或受惊吓而脸色灰白。","source":{"text":"昼吟宵哭，面若死灰，颜色霉墨，涕液交集。","book":"《淮南子·修务训》"},"example":{"text":"听了明珠这番话，徐乾学和余国柱像被雷击了似的僵立在地，～。","book":"二月河《康熙大帝》二十五"},"similar":["面若死灰"],"usage":"作谓语、状语、定语；指人的脸色差"},{"id":46714,"word":"面如满月","pinyin":"miàn rú mǎn yuè","abbr":"mrmy","explanation":"脸盘圆圆的、白白的，象满月一样。形容相貌白净丰满而有神采。","source":{"text":"其相貌也，面如满月，目若青莲。","book":"《敦煌变文集·维摩诘经讲经文》"},"example":{"text":"木吒出城，见一道人，挽双抓髻，穿淡黄服，～，三柳长髯。","book":"明·许仲琳《封神演义》第五十八回"},"usage":"作谓语、定语；指人的面相"},{"id":46715,"word":"面如灰土","pinyin":"miàn rú huī tǔ","abbr":"mrht","explanation":"脸色如泥土一样。形容极端恐惧。亦形容病态。","source":{"text":"州佐解襆出函，公拆视未竟，面如灰土。","book":"《敦煌变文集·捉季布变文》：“归到壁前看季布，面如土色结眉频。”清·蒲松龄《聊斋志异·王者"},"example":{"text":"这位毛驴太君，站在孙振邦的尸身前面，直着两只眼看着他，真是～，心似裂竹。","book":"刘流《烈火金刚》第二十三回"},"similar":["面如土色","面色如土"],"usage":"作谓语、定语、补语、状语；指惊恐"},{"id":46716,"word":"面市盐车","pinyin":"miàn shì yán chē","abbr":"msyc","explanation":"形容遍地大雪。","source":{"text":"人似游面市，马似困盐车。","book":"唐·李商隐《喜雪》诗"}},{"id":46717,"word":"面引廷争","pinyin":"miàn yǐn tíng zhēng","abbr":"mytz","explanation":"指直言敢谏。同“面折廷争”。","source":{"text":"故京兆尹王章资质忠直，敢面引廷争。","book":"东汉·班固《汉书·梅福传》"},"similar":["面折廷争","面折庭争"],"usage":"作谓语、定语；指朝廷议事"},{"id":46718,"word":"面折人过","pinyin":"miàn zhé rén guò","abbr":"mzrg","explanation":"面折：当面指责，批评；过：过错。当面指责别人的过失，不宽容，不留余地。","source":{"text":"汲为人，性倨少礼，面折，不能容人之过。","book":"《史记·汲郑列传》"},"example":{"text":"质性卞急，以廉介自持，好～。","book":"清·毕沅《续资治通鉴》卷四"}},{"id":46719,"word":"面折庭争","pinyin":"miàn shé tíng zhēng","abbr":"mstz","explanation":"指直言敢谏。同“面折廷争”。","source":{"text":"每朝会议，开陈其端，使人主自择，不肯面折庭争。","book":"东汉·班固《汉书·公孙弘传》"},"similar":["面折廷争","面折廷诤"],"usage":"作谓语、定语；指朝廷议事"},{"id":46720,"word":"面折廷争","pinyin":"miàn zhé tíng zhēng","abbr":"mztz","explanation":"面折：当面指责别人的过失；廷争：在朝廷上争论。指直言敢谏。","source":{"text":"于今面折廷争，臣不如君；夫全社稷，定刘氏之后，君亦不如臣。","book":"西汉·司马迁《史记·吕太后本纪》"},"example":{"text":"耶律楚材～，言人所难言，人皆危之。","book":"《续资治通鉴·宋理宗淳祐二年》"},"similar":["面折庭争","直言敢谏"],"usage":"作谓语、定语；指朝廷议事","story":["西汉时期，吕后专政想让她的兄弟子侄都做王，征询右丞相王陵的意见，王陵面折廷争，坚决不同意，而左丞相陈平与太尉周勃则从长计议就同意吕后的意见。王陵因此被罢官。吕后去世，陈平与周勃用计杀死想夺取政权的吕产、吕禄"]},{"id":46721,"word":"面折廷诤","pinyin":"miàn shé tíng zhèng","abbr":"mstz","explanation":"指直言敢谏。同“面折廷争”。","source":{"text":"于今面折廷争，臣不如君；夫全社稷，定刘氏之后，君亦不如臣。","book":"《史记·吕太后本纪》"},"example":{"text":"争变法者，吾未见其有～，千人皆靡者也。","book":"清·章炳麟《变法箴言》"},"similar":["面折廷争"],"usage":"作谓语、定语；指朝廷议事"},{"id":46722,"word":"面授方略","pinyin":"miàn shòu fāng lǜè","abbr":"msfl","explanation":"授：给予，付予；方略：方法策略。当面指示处理事务的方针、办法等。","source":{"text":"初，曹彬等师未出，上命韶州刺史王明为黄州刺史，面授方略。","book":"宋·李焘《续资治通鉴长编·太祖开宝八年》"},"example":{"text":"皇上同文臣们会议已完，正忙着分别召见重要将领，～。","book":"姚雪垠《李自成》第五卷第十八章"}},{"id":46723,"word":"面授机宜","pinyin":"miàn shòu jī yí","abbr":"msjy","explanation":"授：给予，付予；机宜：机密之事。当面指示处理事务的方针、办法等。","source":{"text":"经臣遴委得候补道胡统领，统带水陆各军，面授机宜，督师往剿，幸而士卒用命，得以一扫而平。","book":"清·李宝嘉《官场现形记》第十六回"},"example":{"text":"左良玉在他退出后，立刻召集诸将，～。","book":"姚雪垠《李自成》第二卷第二十三章"},"similar":["口授机宜"],"opposite":["幕后指使"],"usage":"作谓语；指当面教给处理事务的对策或措施"},{"id":46724,"word":"面方如田","pinyin":"miàn fāng rú tián","abbr":"mfrt","explanation":"脸形方正，象田字一样。旧时迷信星相的人认为方脸是富贵相。","source":{"text":"帝大惊，目安人曰：‘卿面方如田，封侯状也。’","book":"《南齐书·李安人传》"}},{"id":46725,"word":"面无人色","pinyin":"miàn wú rén sè","abbr":"mwrs","explanation":"脸色没有一点血色。形容恐惧到极点或非常虚弱。","source":{"text":"广为匈奴所败，吏士皆无人色，广意气自若。","book":"《汉书·李广传》"},"example":{"text":"不过一钟茶的时候，那马兵押着车子已到。吴举人抢到面前，见他三人～。","book":"清·刘鹗《老残游记》第四回"},"similar":["面如土色"],"opposite":["红光满面"],"usage":"作谓语、定语；形容恐惧到极点或非常虚弱","story":["西汉时期，能征善战的将军李广领兵抗击北方的匈奴入侵，他率领4千骑兵被匈奴左贤王以4万骑兵团团围住，士卒们十分恐惧，个个吓得面无人色，李广则神色自若，指挥有方，终于杀出重围，获得胜利"]},{"id":46726,"word":"面无惭色","pinyin":"miàn wú cán sè","abbr":"mwcs","explanation":"惭：羞愧。脸上没有一点羞愧的神色。","source":{"text":"若以爱民惜库物，遭大王杀死，仆见先王于地下，面无惭色矣。","book":"宋·无名氏《新编五代史平话·唐史》"},"example":{"text":"下见西山，料他日、～。","book":"宋·刘克庄《满江红》词"},"similar":["面无愧色"],"usage":"作谓语、定语；指人不惭愧"},{"id":46727,"word":"面是心非","pinyin":"miàn shì xīn fēi","abbr":"msxf","explanation":"指表面上是一套，心底里又是一套，表里不一。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"姬昌外若忠诚，内怀奸诈，以利口而惑众，～，终非善良。","book":"明·许仲琳《封神演义》第十一回"},"similar":["面是背非"],"opposite":["心口如一"],"usage":"作谓语、定语；用于人表里不一"},{"id":46728,"word":"面是背非","pinyin":"miàn shì bèi fēi","abbr":"msbf","explanation":"当面赞成，背后反对。","source":{"text":"予违汝弼，汝无面从，退有后言。","book":"《尚书·益稷》"},"example":{"text":"甚则～，幸灾乐祸，此吾平时所深恨者。","book":"明·冯梦龙《警世通言》卷二十五"},"similar":["表里不一","面从腹非"],"opposite":["心口如一"],"usage":"作谓语、定语；用于人表里不一"},{"id":46729,"word":"面有愧色","pinyin":"miàn yǒu kuì sè","abbr":"myks","explanation":"愧：惭愧。脸上露出惭愧的神色。形容有所内疚。","source":{"text":"于是越王默然不悦，面有愧色。","book":"汉·赵晔《吴越春秋·勾践阴谋外传》"},"example":{"text":"虎儿斑先领戎兵，多有损折，来见桓公，～。","book":"明·冯梦龙《东周列国志》第二十一回"}},{"id":46730,"word":"面有菜色","pinyin":"miàn yǒu cài sè","abbr":"mycs","explanation":"菜色：饥饿的脸色。形容因饥饿而显得营养不良的样子。","source":{"text":"故禹十年水，汤七年旱，而天下无菜色者。","book":"《礼记·王制》：“虽有凶旱水溢，民无菜色。”《荀子·富国》"},"example":{"text":"饱一餐，饿两顿，人人～。","book":"冯玉祥《我的生活》第三十五章"},"opposite":["红光满面"],"usage":"作谓语、定语、状语；指营养不良的样子"},{"id":46731,"word":"面有难色","pinyin":"miàn yǒu nán sè","abbr":"myns","explanation":"脸上露出为难的神色。","source":{"text":"贾大少爷因为奎官之事，面有难色，尚未回答得出。","book":"清·李宝嘉《官场现形记》第25回"},"example":{"text":"看到他～，我只好另想办法。"},"usage":"作谓语、定语；指为难"},{"id":46732,"word":"面有饥色","pinyin":"miàn yǒu jī sè","abbr":"myjs","explanation":"饥色：饥饿的脸色。形容因饥饿而显得营养不良的样子。","source":{"text":"孙叔敖相楚，栈车牝马，粝饼菜羹，枯鱼之膳，冬羔裘，夏葛衣，面有饥色，则良大夫也。","book":"《韩非子·外储说左下》"},"example":{"text":"片刻之间，一个衣服破烂、～、鬓发灰白的老妇被带到丹墀上来。","book":"姚雪垠《李自成》第二卷第五十四章"}},{"id":46733,"word":"面朋口友","pinyin":"miàn péng kǒu yǒu","abbr":"mpky","explanation":"指非真诚相交的朋友。","source":{"text":"面朋口友，固不足怪。欲明通财之义，非道义之交不可。","book":"清·和邦额《夜谭随录·崔秀才》"},"opposite":["生死之交"],"usage":"作主语、宾语、定语；指口头上的朋友"},{"id":46734,"word":"面朋面友","pinyin":"miàn péng miàn yǒu","abbr":"mpmy","explanation":"表面上的朋友，交情不深，貌合神离。","source":{"text":"朋而不心，面朋也；友而不心，面友也。","book":"汉·扬雄《法言·学行》"},"example":{"text":"朋友心不孚，曰～。","book":"宋·胡继宗《书言故事·朋友类》"}},{"id":46735,"word":"面目一新","pinyin":"miàn mù yī xīn","abbr":"mmyx","explanation":"样子完全改变，有了崭新的面貌。","source":{"text":"似乎大抵受着英国的什么人做的《支那人气质》的影响，但到近来，却也有了面目一新的结论了。","book":"鲁迅《且介亭杂文二集·内山完造作序》"},"example":{"text":"……和整党工作所造成的农村中～的气象。","book":"毛泽东《在晋绥干部会议上的讲话》"},"similar":["面目全非"],"opposite":["依然如故"],"usage":"作谓语、定语、补语；指人或局面"},{"id":46736,"word":"面目全非","pinyin":"miàn mù quán fēi","abbr":"mmqf","explanation":"非：不相似。样子完全不同了。形容改变得不成样子。","source":{"text":"举手则面目全非。","book":"清·蒲松龄《聊斋志异·陆判》"},"example":{"text":"它的厄运，是在好书被有权者用相似的本子来掉换，年深月久，弄得～。","book":"鲁迅《而已集·谈所谓“大内档案”》"},"similar":["面目一新","改头换面"],"opposite":["依然如故","一成不变"],"usage":"作谓语、定语、状语；指变化大"},{"id":46737,"word":"面目可憎","pinyin":"miàn mù kě zēng","abbr":"mmkz","explanation":"憎：厌恶。面貌神情卑陋，使人看了厌恶。","source":{"text":"凡所以使吾面目可憎，语言无味者，皆子之志也。","book":"唐·韩愈《送穷文》"},"example":{"text":"士人三日不读书，则～，语言无味。","book":"明·东鲁古狂生《醉醒石》第七回"},"similar":["獐头鼠目"],"opposite":["眉清目秀"],"usage":"作谓语、定语；指人的相貌等"},{"id":46738,"word":"面目犁黑","pinyin":"miàn mù lí hēi","abbr":"mmlh","explanation":"面貌黑黄色。形容憔悴的样子。","source":{"text":"形容枯槁，面目犁黑，状有愧色。","book":"西汉·刘向《战国策·秦策》"},"similar":["面目黎黑","面目黧黑"],"opposite":["白白净净","容光焕发"],"usage":"作谓语、定语、状语；用于人的长相等"},{"id":46739,"word":"面目狰狞","pinyin":"miàn mù zhēng níng","abbr":"mmzn","explanation":"狰狞：面目凶恶。形容面目凶狠可怕。亦作“面貌狰狞”、“狰狞面目”。","source":{"text":"另外还有两人……都是身材骄健，面目狰狞。","book":"清·吴趼人《九命奇冤》第13回"},"example":{"text":"做一个名人也是有很大的危险的，孩子，可怕的敌人不一定是～的。","book":"傅雷《傅雷家书·1955年4月21日夜》"},"similar":["面貌狰狞"],"usage":"作宾语、定语；用于人的外貌"},{"id":46740,"word":"面目黎黑","pinyin":"miàn mù lí hēi","abbr":"mmlh","explanation":"面貌黑黄色。形容憔悴的样子。","source":{"text":"手足胼胝，面目黎黑。","book":"西汉·司马迁《史记·李斯列传》"},"similar":["面目黧黑","面目犁黑"],"opposite":["白白净净","容光焕发"],"usage":"作谓语、定语、状语；用于人的长相等"},{"id":46741,"word":"面目黧黑","pinyin":"miàn mù lí hēi","abbr":"mmlh","explanation":"黧：黑中带黄的颜色。满脸黑黄色。形容面色憔悴。","source":{"text":"年老力弱，面目黧黑。","book":"《列子·黄帝》"},"example":{"text":"当今之世，任变法者，吾未见其有～，窍气不通者也。","book":"清·章炳麟《变法箴言》"},"similar":["面目犁黑","面目黎黑"],"opposite":["白白净净","容光焕发"],"usage":"作谓语、定语、状语；用于人的长相等"},{"id":46742,"word":"面红耳热","pinyin":"miàn hóng ěr rè","abbr":"mher","explanation":"形容因紧张、急躁、害羞等而脸上发红的样子。","source":{"text":"可怜裴兰孙是个娇滴滴的闺中处子，见了一个陌生人，也要面红耳热的。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"想到这里，不免～起来，也就讪讪的进房梳洗去了。","book":"清·曹雪芹《红楼梦》第一百九回"},"similar":["面红耳赤","面红过耳"],"usage":"作状语、定语；用于激动、发怒、羞愧"},{"id":46743,"word":"面红耳赤","pinyin":"miàn hóng ěr chì","abbr":"mhec","explanation":"脸笔耳朵都红了。形容因激动或羞惭而脸色发红。","source":{"text":"今人有些小利害，便至于头红耳赤；子文却三仕三已，略无喜愠。","book":"《朱子语类》卷二九"},"example":{"text":"不住的～，意往神弛，身上不知怎样才好。","book":"清·吴趼人《二十年目睹之怪现状》第一回"},"similar":["羞愧满面"],"opposite":["面不改色"],"usage":"作谓语、状语、补语；形容羞愧的样子","story":["清朝时期，一浪子决心痛改前非，给自己取别号“死里逃生”，他在街上遇到一汉子拿着一本小说要卖，他好奇地看到是“九死一生笔记”《二十年目睹之怪现状》，看后不住面红耳赤，意往神驰，他把这本书改作章回小说发表"]},{"id":46744,"word":"面红脖子粗","pinyin":"miàn hóng bó zǐ cū","abbr":"mhbzc","explanation":"脸红脖子变粗。形容因激动、窘迫、发怒或羞渐而脸色涨红的样子。","source":{"text":"皇帝面红脖子粗地大骂言官沽名钓誉，恭王与醇王自恃长亲，渺视皇帝，话越说越多，也越离谱了。","book":"高阳《玉座珠帘》"},"similar":["面红耳赤"],"usage":"作谓语、状语、定语；用于激动、发怒"},{"id":46745,"word":"面红过耳","pinyin":"miàn hóng guò ěr","abbr":"mhge","explanation":"形容因激动、窘迫、发怒或羞渐而脸色涨红的样子。","source":{"text":"今人有些小利害，便至于头红耳赤；子文却三仕三已，略无喜愠。","book":"宋·朱熹《朱子语类》卷二十九"},"example":{"text":"看了一遍，不觉～，真是众日之下，羞愧难当，几乎把酒都羞醒了。","book":"清·李汝珍《镜花缘》第四回"},"similar":["面红耳热","面红耳赤","面红颈赤"],"usage":"作状语、定语；用于激动、发怒"},{"id":46746,"word":"面红面绿","pinyin":"miàn hóng miàn lǜ","abbr":"mhml","explanation":"形容因紧张、急躁、害羞等而脸上发红的样子。","source":{"text":"子他行怕行羞，和我也面红面赤。","book":"元·王伯成《李太白贬夜郎》第三折"},"example":{"text":"自己进他门以来，未有半点～，他不负我，我怎好负他？","book":"清·黄小配《廿载繁华梦》第九回"},"similar":["面红面赤"],"usage":"作宾语、状语、定语；用于激动、发怒等"},{"id":46747,"word":"面红面赤","pinyin":"miàn hóng miàn chì","abbr":"mhmc","explanation":"指双方因争执而变脸。","source":{"text":"子他行怕行羞，和我也面红面赤。","book":"元·王伯成《李太白贬夜郎》第三折"},"example":{"text":"虽不曾生半个儿女，未曾～，半点相争。","book":"明·施耐庵《水浒全传》第八回"},"similar":["面红面绿"],"usage":"作宾语、状语、定语；用于激动、发怒等"},{"id":46748,"word":"面红颈赤","pinyin":"miàn hóng jǐng chì","abbr":"mhjc","explanation":"形容因激动或羞渐而脸色发红。同“面红耳赤”。","source":{"text":"倘有不达时务的，捉空摘了一花一蕊，那老便要面红颈赤，大发喉急。","book":"明·冯梦龙《喻世明言》卷四"},"example":{"text":"萧静园听了，那里答应得出来，默默无言，逼得～。","book":"清·张春帆《九尾龟》第五十八回"},"similar":["面红耳赤"],"usage":"作状语、定语；用于激动、发怒"},{"id":46749,"word":"面缚舆榇","pinyin":"miàn fù yú chèn","abbr":"mfyc","explanation":"面缚：反绑着手面向胜利者，表示放弃抵抗；舆榇：把棺材装在车上。表示不再抵抗，自请受刑。这是古代君主战败投降的仪式。","source":{"text":"许男面缚衔璧，大夫衰经，士舆榇。","book":"《左传·僖公六年》"},"example":{"text":"次日，魏兵大至。后主率太子诸王，及群臣六十余人，～，出北门十里而降。","book":"明·罗贯中《三国演义》第一百十八回"},"similar":["负荆请罪","面缚衔璧"],"usage":"作谓语、宾语；用于战争投降"},{"id":46750,"word":"面缚衔璧","pinyin":"miàn fù xián bì","abbr":"mfxb","explanation":"两手反绑而面向前，口含碧玉以示不生。古人用以表示投降请罪。","source":{"text":"许男面缚衔璧，大夫衰绖，士舆榇。","book":"《左传·僖公六年》"},"example":{"text":"许僖公见楚救不至，乃～，向晋军中乞降，大出金帛犒军。","book":"明·许仲琳《封神演义》第四十三回"},"similar":["面缚舆榇"],"usage":"作谓语、宾语；用于战争投降"},{"id":46751,"word":"面色如土","pinyin":"miàn sè rú tǔ","abbr":"msrt","explanation":"形容惊恐之极。同“面如土色”。","source":{"text":"董昌面色如土。众兵都面面厮觑，不敢则声。","book":"明·施耐庵《水浒传》第一回：“惊得洪太尉目睁口呆，罔知所措，面色如土，奔到廊下，只见真人向前叫苦不迭。”《西湖二集·吴越王再世索江山》"},"example":{"text":"学徒淘米河边，照见～。","book":"刘复《学徒苦》诗"},"similar":["面如灰土"],"usage":"作定语、宾语、状语；指惊恐"},{"id":46752,"word":"面色如生","pinyin":"miàn sè rú shēng","abbr":"msrs","explanation":"指死人的脸色象活着时一样。","source":{"text":"免胄入狄师，死焉。狄人归其元，面如生。","book":"《左传·僖公三十三年》"},"example":{"text":"天佑忙着来时，只见他～。","book":"清·吴趼人《痛史》第二十二回"}},{"id":46753,"word":"面若死灰","pinyin":"miàn ruò sǐ huī","abbr":"mrsh","explanation":"形容因心情极度沮丧或惊恐而脸色灰暗。","source":{"text":"昼吟宵哭，面若死灰，颜色霉墨，涕液交集。","book":"西汉·司马迁《史记·修务训》"},"example":{"text":"清·李百川《绿野仙踪》第八回：“只见那妇人～，无一点生人血色。”"},"similar":["面如死灰"],"usage":"作谓语、状语、定语；指人的脸色差"},{"id":46754,"word":"面誉不忠","pinyin":"miàn yù bù zhōng","abbr":"mybz","explanation":"誉：称赞；忠：忠诚。好当面称赞别人的人，一定不忠实。","source":{"text":"且吾闻之，好面誉之人者，亦好背而毁之。","book":"《庄子·盗跖》"}},{"id":46755,"word":"面誉背毁","pinyin":"miàn yù bèi huǐ","abbr":"mybh","explanation":"当面称赞，背后诋毁。","source":{"text":"面誉背毁，吾不忍见，群居纵言，未尝及人之短，常有不可犯之色，故小人远焉。","book":"隋·王通《文中子·关朗篇》"},"similar":["面誉背非","面谀背毁"],"usage":"作谓语、定语、状语；用于处事为人"},{"id":46756,"word":"面誉背非","pinyin":"miàn yù bèi fēi","abbr":"mybf","explanation":"指当面称赞，背后诽谤。同“面誉背毁”。","source":{"text":"面誉背毁，吾不忍见，群居纵言，未尝及人之短，常有不可犯之色，故小人远焉。","book":"《庄子·盗跖》：“且吾闻之，好面誉之人者，亦好背而毁之。”隋·王通《文中子·关朗篇》"},"example":{"text":"杲性虚诞，与人交，好～。","book":"《宋史·范杲传》"},"similar":["面谀背毁","面誉背毁"],"opposite":["表里如一"],"usage":"作谓语、定语、状语；用于处事为人"},{"id":46757,"word":"面谀背毁","pinyin":"miàn yú bèi huǐ","abbr":"mybh","explanation":"指当面称赞，背后诽谤。同“面誉背毁”。","source":{"text":"面誉背毁，吾不忍见，群居纵言，未尝及人之短，常有不可犯之色，故小人远焉。","book":"《庄子·盗跖》：“且吾闻之，好面誉之人者，亦好背而毁之。”隋·王通《文中子·关朗篇》"},"example":{"text":"惟近世以来，朋友道弊，群居之时，笑侮戏谑，～，善不相告，失不相正。","book":"宋·陈克蔚《双溪书院揭示》"},"similar":["面誉背非","面誉背毁"],"opposite":["毕恭毕敬"],"usage":"作谓语、定语、状语；用于处事为人"},{"id":46758,"word":"面谩腹诽","pinyin":"miàn màn fù fěi","abbr":"mmff","explanation":"指当面欺诳，心怀毁谤。","source":{"text":"又以不得一品，面谩腹诽，无大臣礼。","book":"《明史·万镋传》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":46759,"word":"面貌一新","pinyin":"miàn mào yī xīn","abbr":"mmyx","explanation":"样子完全改变，出现了崭新的面貌。","source":{"text":"现在农村面貌一新，百分之九十的人生活改善了。","book":"邓小平《政治上发展民主，经济上实行改革》"},"similar":["面目一新","焕然一新"],"usage":"作谓语、定语、补语；指人或局面"},{"id":46760,"word":"面貌狰狞","pinyin":"miàn mào zhēng níng","abbr":"mmzn","explanation":"狰狞：样子凶恶。形容面貌凶恶可怕。","source":{"text":"一个个身长臂大，面貌狰狞。","book":"明·冯梦龙《醒世恒言》第30卷"},"similar":["面目狰狞"],"usage":"作宾语、定语；用于人的外貌"},{"id":46761,"word":"面长面短","pinyin":"miàn cháng miàn duǎn","abbr":"mzmd","explanation":"指没见过面，不知对方是长脸还是方脸。","source":{"text":"指没见过面，不知对方是长脸还是方脸。"},"example":{"text":"你别以为你长得五官端正些，就有权利挑剔人家～！","book":"张爱玲《多少恨》"}},{"id":46762,"word":"面面俱全","pinyin":"miàn miàn jù quán","abbr":"mmjq","explanation":"俱：全。各方面都能照顾到，没有遗漏疏忽。也指虽然照顾到各方面，但一般化。","source":{"text":"这位单道台办事一向是面面俱到，不肯落一点褒贬的。","book":"清·李宝嘉《官场现形记》第五十七回"},"example":{"text":"这样一来，润翁向东家开口要款子也容易些，厂里也派着二万块的用途，存货也松动松动；这倒是～的法子。","book":"茅盾《多角关系》七"}},{"id":46763,"word":"面面俱到","pinyin":"miàn miàn jù dào","abbr":"mmjd","explanation":"各方面都能照顾到，没有遗漏疏忽。也指虽然照顾到各方面，但一般化。","source":{"text":"这位单道台办事一向是面面俱到，不肯落一点褒贬的。","book":"清·李宝嘉《官场现形记》第五十七回"},"example":{"text":"宾馆服务周全，衣食住行～，令客人非常满意。"},"similar":["包罗万象","面面皆到"],"opposite":["顾此失彼"],"usage":"作谓语、定语、状语；指全面"},{"id":46764,"word":"面面俱圆","pinyin":"miàn miàn jù yuán","abbr":"mmjy","explanation":"各方面都能照顾到，十分周全。也指虽然照顾到各方面，但重点不突出。","source":{"text":"只有单道台却做了一个面面俱圆：抚台见面夸奖他，说了能办事；领事心上也感激他弹压百姓，没有闹出事来，见了抚台亦很替他说好话；至于绅衿一面，一直当他是回护百姓的，更不消说得了。","book":"清·李宝嘉《官场现形记》第五十七回"},"similar":["面面俱到","面面圆到"],"opposite":["顾此失彼"],"usage":"作谓语、定语、状语；指全面"},{"id":46765,"word":"面面厮觑","pinyin":"miàn miàn sī qù","abbr":"mmsq","explanation":"相视无言。形容因紧张或惊惧而束手无策之状。","source":{"text":"[崔宁]到家中问丈人丈母，两个面面厮觑。","book":"《京本通俗小说·碾玉观音》"},"example":{"text":"两个入进楼中，见三个尸首，横在血泊里，惊得～，做声不得。","book":"明·施耐庵《水浒传》第三十一回"},"similar":["面面相觑","面面相看"],"usage":"作谓语、定语、状语；形容惊慌的表情"},{"id":46766,"word":"面面周到","pinyin":"miàn miàn zhōu dào","abbr":"mmzd","explanation":"各方面都照顾到。虽然照顾到各方面，但很一般化，重点不突出。","source":{"text":"弟于创作即素持此种态度，不求一时即面面周到，唯老老实实努力下去。","book":"余秋雨《山居笔记·谈“小人”》"},"example":{"text":"余秋雨《山居笔记·谈“小人”》：“弟于创作即素持此种态度，不求一时即～，唯老老实实努力下去。”"},"similar":["面面俱到"],"usage":"作谓语、定语、状语；指全面"},{"id":46767,"word":"面面圆到","pinyin":"miàn miàn yuán dào","abbr":"mmyd","explanation":"各方面都能照顾到，十分周全。也指虽然照顾到各方面，但重点不突出。","source":{"text":"所以看客对于他们不很敬畏，也不大留心，除了念佛老妪和她的孙子们为面面圆到起见，也照例给他们一个‘不胜屏营待命之至’的仪节。","book":"鲁迅《朝花夕拾·无常》"},"example":{"text":"这种新见解，对于古书的矛盾可谓～。","book":"郭沫若《今昔集·论儒家的发生》"},"similar":["面面俱到","面面周到"],"usage":"作谓语、定语、状语；指全面"},{"id":46768,"word":"面面皆到","pinyin":"miàn miàn jiē dào","abbr":"mmjd","explanation":"各方面都能照顾到，十分周全。也指虽然照顾到各方面，但重点不突出。","source":{"text":"后数日而部行新令始至，复令改制一联，云：‘来去有前因，遗范难忘联襼日；宽严能并济，新恩惜在盖棺时。’则面面皆到矣。","book":"清·梁章钜《楹联续话·挽词》"},"similar":["面面俱到"],"opposite":["顾此失彼"],"usage":"作谓语、定语、状语；指全面"},{"id":46769,"word":"面面相看","pinyin":"miàn miàn xiāng kàn","abbr":"mmxk","explanation":"相视无言。形容因紧张或惊惧而束手无策之状。","source":{"text":"这一言不打紧，唬得贾政上下人等面面相看，喜得番役家人摩拳擦掌，就要往各处动手。","book":"清·曹雪芹《红楼梦》第一零五回"},"example":{"text":"申耀宗和他手下的保卫团都～，不言声儿。","book":"孔厥 袁静《新儿女英雄传》第一回"},"similar":["面面相窥"],"usage":"作谓语、定语、状语；形容惊慌的表情"},{"id":46770,"word":"面面相睹","pinyin":"miàn miàn xiāng dǔ","abbr":"mmxd","explanation":"相视无言。形容因紧张或惊惧而束手无策之状。","source":{"text":"诸亲九眷面面相睹，无不失惊。","book":"《清平山堂语本·快嘴李翠莲记》"},"similar":["面面相觑","面面厮觑"],"usage":"作谓语、定语、状语；形容惊慌的表情"},{"id":46771,"word":"面面相窥","pinyin":"miàn miàn xiāng kuī","abbr":"mmxk","explanation":"相视无言。形容因紧张或惊惧而束手无策之状。","source":{"text":"麝月等依言分头各处追问，人人不晓，个个惊疑。麝月等回来，俱目瞪口呆，面面相窥。","book":"清·曹雪芹《红楼梦》第九十四回"},"example":{"text":"就指着衣服向于家父子道：‘你说这衣服那里来的？’于家父子～，都回不出。","book":"清·刘鹗《老残游记》第四回"},"similar":["面面相看","目目相觑"],"usage":"作谓语、定语、状语；形容惊慌的表情"},{"id":46772,"word":"面面相觑","pinyin":"miàn miàn xiāng qù","abbr":"mmxq","explanation":"觑：看。你看我，我看你，不知道如何是好。形容人们因惊惧或无可奈何而互相望着，都不说话。","source":{"text":"舟起如簸，人皆瞑眩，蒙被僵卧，懊丧此来，面面相觑而已。","book":"明·张岱《海志》"},"example":{"text":"墙外有数十人，～，各有惊异之状。","book":"明·洪楩《清平山堂话本·死生交范张鸡黍》"},"similar":["瞠目结舌","面面相看"],"opposite":["从容不迫"],"usage":"作谓语、定语、状语；形容惊慌的表情","story":["三国时期，曹操率兵攻打徐州，吕布趁机攻占曹操的兖州和濮阳，曹操挥师保家，与吕布在濮阳城外大战，曹操听取于禁建议，攻占吕布的西寨，吕布率援军赶到，曹军人困马乏，面面相觑，幸亏典韦英勇奋战，夏侯率军解围"]},{"id":46773,"word":"面额焦烂","pinyin":"miàn é jiāo làn","abbr":"mejl","explanation":"因受炮烙之刑或烧伤，脸颊和额头被烧得焦糊的样子。","source":{"text":"微指左公处，则席地倚墙而坐，面额焦烂不可辨。","book":"清·方苞《左忠毅公逸事》"}},{"id":46774,"word":"面黄肌瘦","pinyin":"miàn huáng jī shòu","abbr":"mhjs","explanation":"脸色发黄，身体瘦削。形容人营养不良或有病的样子。","source":{"text":"哥也，你这般面黄肌廋，怎生赢的人也。","book":"元·无名氏《独角牛》第一折"},"example":{"text":"寻到厨房后面一间小屋，见几个老和尚坐地，一个个～。","book":"明·施耐庵《水浒全传》第六回"},"similar":["面有菜色"],"opposite":["容光焕发"],"usage":"作谓语、定语、补语；形容人的脸色不好"},{"id":46775,"word":"靦面相迎","pinyin":"miǎn miàn xiāng yíng","abbr":"tmxy","explanation":"靦面：面带愧色。带着羞愧的样子去迎人。","source":{"text":"那呆子放下钉耙，整整直裰，摆摆摇摇，充作个斯文气象，一直的靦面相迎。","book":"明·吴承恩《西游记》"},"usage":"作谓语、定语；用于处事"},{"id":46776,"word":"靦颜事仇","pinyin":"tiǎn yán shì chóu","abbr":"tysc","explanation":"谓不知羞耻地为仇敌做事。","source":{"text":"若靦颜事仇，为虎作伥，心果安在耶？","book":"罗正纬《滦州革命先烈事略·王金铭》"},"example":{"text":"对于无法撤退的居民应该给以有力的政治教育和相当的组织，使得即使在日寇占领之下，亦能不～。","book":"《新华日报》1938.11.28"},"similar":["认贼作父"],"usage":"作谓语、定语；用于处世等"},{"id":46777,"word":"靦颜人世","pinyin":"tiǎn yán rén shì","abbr":"tyrs","explanation":"靦颜：表现出惭愧的脸色。形容丧气失节，厚颜无耻地活在世上。","source":{"text":"岂可偷生屈节，靦颜天壤邪！","book":"《晋书·郗鉴传》"},"similar":["苟且偷生","靦颜天壤"],"usage":"作谓语、宾语；指厚颜无耻","story":["晋元帝为了钳制王敦，任郗鉴为安西将军，镇守合肥，统领江西、扬州等地的军队。王敦则推荐他为尚书令。郗鉴回京途中去拜谒王敦，双方就当年满武秋当机立断效忠贾后发表看法。郗鉴认为危急之时不能偷生屈节厚着脸皮活在世上"]},{"id":46778,"word":"靦颜天壤","pinyin":"tiǎn yán tiān rǎng","abbr":"tytr","explanation":"靦颜：表现出惭愧的脸色；天壤：天地，指人世间。形容丧失气节，厚着脸皮活在世上。","source":{"text":"岂可偷生屈节，靦颜天壤邪！","book":"《国语·越语下》：“余虽靦然而人面哉，吾犹禽兽也。”《晋书·郗鉴传》"},"similar":["忝颜偷生"],"usage":"作谓语、定语；用于书面语","story":["晋元帝为了钳制王敦，任郗鉴为安西将军，镇守合肥，统领江西、扬州等地的军队。王敦则推荐他为尚书令。郗鉴回京途中去拜谒王敦，双方就当年满武秋当机立断效忠贾后发表看法。郗鉴认为危急之时不能偷生屈节厚着脸皮活在世上"]},{"id":46779,"word":"革凡成圣","pinyin":"gé fán chéng shèng","abbr":"gfcs","explanation":"革除凡习，成为圣哲。","source":{"text":"老子、周公、孔子等虽是如来弟子，而为化既邪，止是世间之善，不能革凡成圣。","book":"南朝·梁武帝《敕舍道事佛》"},"similar":["革凡登圣"],"usage":"作谓语、宾语；用于人的行为等"},{"id":46780,"word":"革凡登圣","pinyin":"gé fán dēng shèng","abbr":"gfds","explanation":"革除凡习，成为圣哲。同“革凡成圣”。","source":{"text":"世世生生，师资不阙，革凡登圣，给侍无亏。","book":"隋炀帝《答释智顗遗旨书》"},"similar":["革凡成圣"],"usage":"作谓语、宾语；用于人的行为等"},{"id":46781,"word":"革刚则裂","pinyin":"gé gāng zé liè","abbr":"ggzl","explanation":"革：皮革；刚：硬。皮革太硬就容易断裂。比喻人或集团过分强硬就容易遭致失败或灭亡。","source":{"text":"金刚则折，革刚则裂，人君刚则国家灭，人臣刚则交友绝。","book":"汉·刘向《说苑·敬慎》"}},{"id":46782,"word":"革命创制","pinyin":"gé mìng chuàng zhì","abbr":"gmcz","explanation":"指变革天命，创立新制。多指改朝换代。","source":{"text":"革命创制，三章是纪，应天顺民，五星同晷。","book":"《汉书·叙传下》"},"example":{"text":"～，竹素之道稍彰，纪事记言，笔墨之官渐著。","book":"《隋书·许善心传》"},"similar":["改朝换代","革命反正"],"usage":"作谓语、宾语；用于社会等"},{"id":46783,"word":"革命反正","pinyin":"gé mìng fǎn zhèng","abbr":"gmfz","explanation":"变革天命，使之恢复正常。借指改朝换代。","source":{"text":"拨乱世，反诸正，莫近诸《春秋》。","book":"《周易·革》“汤武革命，顺乎天而应乎人。”《公羊传·哀公十四年》"},"example":{"text":"人怀汉德，～，易以为功。","book":"《晋书·王导传》"},"similar":["拨乱反正","改朝换代","革命创制"],"usage":"作谓语；借指改朝换代"},{"id":46784,"word":"革图易虑","pinyin":"gé tú yì lǜ","abbr":"gtyl","explanation":"改变计谋策略。","source":{"text":"若乃天启尊心，革图易虑，则我将军匍匐悲号于将军股掌之上。","book":"《后汉书·袁绍传》"},"usage":"作谓语；指改变计谋策略"},{"id":46785,"word":"革奸铲暴","pinyin":"gé jiān chǎn bào","abbr":"gjcb","explanation":"清除奸佞，铲除暴虐。","example":{"text":"国家要稳步向前发展，就必须革奸铲暴，创造一个良好的社会环境。"}},{"id":46786,"word":"革带移孔","pinyin":"gé dài yí kǒng","abbr":"gdyk","explanation":"形容身体因老病而日惭消瘦。","source":{"text":"言已老病，百日数旬，革带常应移孔。","book":"《南史·沈约传》"},"usage":"作谓语；指人年老消瘦"},{"id":46787,"word":"革心易行","pinyin":"gé xīn yì xíng","abbr":"gxyx","explanation":"指改正错误思想，改变错误行为。","source":{"text":"于是革心易行，衣苴布，食疄(田改丰)馂，昼学道而夕讲之。","book":"汉·贾谊《新书·先醒》"},"example":{"text":"南越王甚嘉被惠泽，蒙休德，愿～，身从使者入谢。","book":"《汉书·严助传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":46788,"word":"革故立新","pinyin":"gé gù lì xīn","abbr":"gglx","explanation":"旧指朝政变革或改朝换代。现泛指除去旧的，建立新的。同“革故鼎新”。","source":{"text":"他是以宽厚出名的，讲究忠信。是一个励精图治，革故立新的单于。","book":"曹禺《王昭君》第二幕"}},{"id":46789,"word":"革故鼎新","pinyin":"gé gù dǐng xīn","abbr":"ggdx","explanation":"革：改变，革除；故：旧的；鼎：树立。旧指朝政变革或改朝换代。现泛指除去旧的，建立新的。","source":{"text":"革，去故也，鼎，取新也。","book":"《周易·杂卦》"},"example":{"text":"北京地方，受历代君主的压力，害得毫无生气，此后～，当有一番佳境。","book":"蔡东藩、许廑父《民国通俗演义》第七回"},"similar":["除旧布新","吐故纳新"],"opposite":["陈陈相因","抱残守缺"],"usage":"作谓语、定语；指革新"},{"id":46790,"word":"革新变旧","pinyin":"gé xīn biàn jiù","abbr":"gxbj","explanation":"指更造新的，改易旧的。","source":{"text":"今臣所立，易以取信。但踪核始终，大存缓密，革新变旧，有约有繁。","book":"《南齐书·文学传·祖冲之》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":46791,"word":"革旧从新","pinyin":"gé jiù cóng xīn","abbr":"gjcx","explanation":"旧指朝政变革或改朝换代。现泛指除去旧的，建立新的。同“革故鼎新”。","source":{"text":"今革旧从新，为里党之法，在所牧守，宜以喻民，使知去烦即简之要。","book":"《魏书·食货志》"},"similar":["革旧鼎新","革旧维新"],"usage":"作谓语、宾语；用于处事"},{"id":46792,"word":"革旧图新","pinyin":"gé jiù tú xīn","abbr":"gjtx","explanation":"抛弃旧的事物，谋求新的途径。","source":{"text":"国势岌岌如此，乞下哀痛之诏，风厉有位，革旧图新，以回天意。","book":"宋·刘克庄《宝学颜尚书神道碑》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":46793,"word":"革旧立新","pinyin":"gé jiù lì xīn","abbr":"gjlx","explanation":"指革除旧的创建新的。","source":{"text":"他是以宽厚出名的，讲究忠信，是一个励精图治，革旧立新的单于。","book":"曹禺《王昭君》第二幕"},"similar":["革旧鼎新","革旧维新","革旧从新"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46794,"word":"革旧维新","pinyin":"gé jiù wéi xīn","abbr":"gjwx","explanation":"革：废除；维新：反对旧的，提倡新的。专指政治上的改良。改变旧的，提倡新的。","source":{"text":"文武氏革旧维新，周公礼百王兼备。","book":"元·宫大用《范张鸡黍》"},"similar":["革故鼎新"],"usage":"作谓语、宾语；指改良"},{"id":46795,"word":"革旧鼎新","pinyin":"gé jiù dǐng xīn","abbr":"gjdx","explanation":"旧指朝政变革或改朝换代。现泛指除去旧的，建立新的。同“革故鼎新”。","source":{"text":"切以诵经者，所以明心见性，礼忏者，所以革旧鼎新。","book":"明·李贽《代深有告文》之二"},"example":{"text":"是故社会上种种之积弊，使女子而有～之志焉。","book":"柳隅《〈留日女学会杂志〉题辞》"},"similar":["革旧从新","革旧维新"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46796,"word":"革职拿问","pinyin":"gé zhí ná wèn","abbr":"gznw","explanation":"革：革除；拿：逮捕。革除职务，逮捕问罪。","source":{"text":"上回书交待的是安公子因安老爷革职拿问……他把家中的地亩折变，带上银子，同着他的奶公华忠南来。","book":"清·文康《儿女英雄传》第四回"},"example":{"text":"既至京师，则降旨解肃顺大学士之任，旋～，遂诛之。","book":"《清朝野史大观》第一卷"},"similar":["革职查办"],"usage":"作谓语、定语、宾语；用于官场等"},{"id":46797,"word":"革邪反正","pinyin":"gé xié fǎn zhèng","abbr":"gxfz","explanation":"革除错误，回到正道上。","source":{"text":"荡汰积埃，革邪反正。","book":"晋·葛洪《抱朴子·勖学》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":46798,"word":"革面悛心","pinyin":"gé miàn quān xīn","abbr":"gmqx","explanation":"比喻彻底改过，重新做人。同“革面洗心”。","source":{"text":"以忠义感胁从之伍，以含弘安反侧之徒。革面悛心，期乎不日。","book":"唐·刘禹锡《代谢赴行营表》"},"similar":["革面革心","革面洗心"],"usage":"作谓语、定语；指彻底悔改"},{"id":46799,"word":"革面敛手","pinyin":"gé miān liǎn shǒu","abbr":"gmls","explanation":"指改恶从善，不敢恣意妄为。","source":{"text":"于是豪民猾吏，革面敛手，家有忠信，人怀耻格。","book":"唐·独孤及《唐故太子宾客……张公遗爱碑颂》"},"example":{"text":"这些不法分子不得不～。"},"similar":["洗心革面"],"usage":"作谓语；用于坏人"},{"id":46800,"word":"革面洗心","pinyin":"gé miàn xǐ xīn","abbr":"gmxx","explanation":"清除旧思想，改变旧面貌。比喻彻底改过，重新做人。","source":{"text":"君子豹变，小人革面。","book":"《周易·革》"},"example":{"text":"阿里骨凶狡反覆，必无～之理。","book":"宋·苏轼《乞约鬼章讨阿里骨札子》"},"similar":["洗心革面","改过自新","洗心回面"],"usage":"作谓语、定语；指彻底悔改"},{"id":46801,"word":"革面革心","pinyin":"gé miàn gé xīn","abbr":"gmgx","explanation":"比喻彻底改过，重新做人。同“革面洗心”。","source":{"text":"笑鄙夫畏首尾，蔚蔚九变豹，俾心人革面革心，惠我无私。","book":"明·杨慎《送薛曲泉之镇雄勘夷手卷词》"},"example":{"text":"复勤恳化导，设书院六，义学百，楚苗駸駸向学，呈求考试，遂已～。","book":"清·魏源《圣武记》卷七"},"similar":["革面悛心","革面洗心"],"usage":"作谓语、定语；指彻底悔改"},{"id":46802,"word":"革风易俗","pinyin":"gé fēng yì sú","abbr":"gfys","explanation":"改变风气和习俗。","example":{"text":"我们要革风易俗，形成讲科学的好风气。"},"similar":["移风易俗"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":46803,"word":"靴刀誓死","pinyin":"xuē dāo shì sǐ","abbr":"xdss","explanation":"指战死沙场的决心。","source":{"text":"及是击贼，常纳短刀于靴中，有决死之志，城上面西拜舞，三军感动。","book":"《旧唐书·李光弼传》"},"usage":"作宾语、定语；用于书面语"},{"id":46804,"word":"鞅鞅不乐","pinyin":"yāng yāng bù lè","abbr":"yybl","explanation":"因不满意而很不快乐。鞅，通“怏”。","source":{"text":"武真人，名元照，会稽萧山民女也……年稍长，议以妻邑之富人，既受币，照鞅鞅不乐。","book":"宋·洪迈《夷坚丁志·武真人》"},"example":{"text":"既废，居汴中，常～。","book":"《金史·赤盏合喜传》"},"similar":["闷闷不乐"],"opposite":["心满意足"],"usage":"作谓语、定语、状语；指不高兴"},{"id":46805,"word":"鞋弓袜小","pinyin":"xié gōng wà xiǎo","abbr":"xgwx","explanation":"指旧时妇女小脚。","source":{"text":"鞋弓袜小行不便，却如何跋涉颠连？","book":"明·周朝俊《红梅记·夜走》"},"example":{"text":"许多随驾去的臣宰尚不能逃，公主～，如何脱离得归来？","book":"明·凌濛初《初刻拍案惊奇》卷二"},"similar":["鞋弓袜浅"],"usage":"作谓语、定语；形容女性"},{"id":46806,"word":"鞋弓袜浅","pinyin":"xié gōng wà qiǎn","abbr":"xgwq","explanation":"指旧时妇女小脚。同“鞋弓袜小”。","source":{"text":"顾不的鞋弓袜浅；讲不起抛头露面。手拨琵琶，原非自遣，要诉出衷肠一片。","book":"清·李渔《闲情偶寄·演习》附《琵琶记·寻夫》改本"},"similar":["鞋弓袜小"],"usage":"作宾语、定语；形容女性"},{"id":46807,"word":"鞋弓襪小","pinyin":"xié gōng wà xiǎo","abbr":"xgwx","explanation":"指旧时妇女小脚。"},{"id":46808,"word":"鞋弓襪浅","pinyin":"xié gōng wà qiǎn","abbr":"xgwq","explanation":"指旧时妇女小脚。同“鞋弓襪小”。"},{"id":46809,"word":"鞍不离马背，甲不离将身","pinyin":"ān bù lí mǎ bèi，jiǎ bù lí jiàng shēn","abbr":"ablmbjbljs","explanation":"甲：铠甲。马不卸鞍，人不解甲。处于高度警惕状态。","source":{"text":"鞍不离马背，甲不离将身。","book":"《敦煌变文集·汉将王陵变》"},"example":{"text":"他传令将士做到～，处于高度戒备状态。"},"similar":["枕戈待旦"],"usage":"作定语、宾语、分句；指处于高度警惕状态"},{"id":46810,"word":"鞍不离马，甲不离身","pinyin":"ān bù lí mǎ，jiǎ bù lí shēn","abbr":"ablmjbls","explanation":"甲：铠甲，古人打仗时穿的护身衣。马不卸鞍，人不解甲。处于高度警惕状态。","source":{"text":"鞍不离马背，甲不离将身。","book":"唐《敦煌变文集·卷一·汉将王陵变》"},"similar":["鞍不离马背，甲不离将身"],"usage":"作定语、宾语、分句；指处于高度警惕状态"},{"id":46811,"word":"鞍前马后","pinyin":"ān qián mǎ hòu","abbr":"aqmh","explanation":"马前马后。指追随左右。","source":{"text":"鞍前马后跟你跑，出生入死为你干。","book":"王树元《杜鹃山》第五场"},"example":{"text":"丈夫终日为首长们～奔走劳累，在那些永无穷尽的材料堆里研究不完。","book":"《南方周末》1991.9.27"},"usage":"作状语；形容跟随某人"},{"id":46812,"word":"鞍马之劳","pinyin":"ān mǎ zhī láo","abbr":"amzl","explanation":"鞍马：鞍子和马，指长途跋涉或打仗。形容旅途或战斗的劳苦。","source":{"text":"耳不闻兵戈之声，眼不见伐之事，身不受鞍马之劳，心不悬胜败之扰。","book":"明·许仲琳《封神演义》第二十二回"},"example":{"text":"唐铉说：“此话以后再说。请到那边入座，少饮几杯水酒，以解二位～。”","book":"姚雪垠《李自成》第三卷第三十四章"}},{"id":46813,"word":"鞍马劳倦","pinyin":"ān mǎ láo juàn","abbr":"amlj","explanation":"指长途跋涉或战斗中备尝困乏。","source":{"text":"实不相瞒太公说：老母鞍马劳倦，昨夜心痛病发。","book":"明·施耐庵《水浒传》第二回"},"example":{"text":"他受不了旅途的～而病倒。"},"similar":["鞍马劳顿"],"usage":"作谓语、宾语；形容旅途劳累"},{"id":46814,"word":"鞍马劳困","pinyin":"ān mǎ láo kùn","abbr":"amlk","explanation":"指长途跋涉或战斗中备尝困乏。","source":{"text":"不觉的一阵昏沉上来，皆因老夫年纪高大，鞍马劳困之故。","book":"元·关汉卿《窦娥冤》第四折"},"example":{"text":"明·施耐庵《水浒传》第63回：“～，你且去馆驿内安下，待我会官商议。”"},"similar":["鞍马劳顿"],"usage":"作谓语、宾语；形容旅途劳累"},{"id":46815,"word":"鞍马劳神","pinyin":"ān mǎ láo shén","abbr":"amls","explanation":"形容旅途劳累。同“鞍马劳顿”。","source":{"text":"众位尊兄，鞍马劳神不易。","book":"明·施耐庵《水浒传》第50回"},"example":{"text":"经受这～的考验，我们终于达到目的地。"},"similar":["鞍马劳顿","鞍马劳倦"],"usage":"作谓语、宾语；形容旅途劳累"},{"id":46816,"word":"鞍马劳顿","pinyin":"ān mǎ láo dùn","abbr":"amld","explanation":"顿：困顿。骑马赶路过久，劳累疲困。形容旅途劳累。","source":{"text":"兴儿，我一路上鞍马劳顿，我权且歇息。","book":"元·杨显之《潇湘雨》第四折"},"example":{"text":"恐王侄一路远来，～，故令王侄回营安歇。","book":"清·钱彩《说岳全传》第四二回"},"similar":["鞍马劳倦","鞍马劳神"],"usage":"作谓语、宾语；形容旅途劳累"},{"id":46817,"word":"鞘里藏刀","pinyin":"qiào lǐ cáng dāo","abbr":"qlcd","explanation":"刀室中藏着利刀。比喻暗藏杀心。","example":{"text":"我们不怕直接冲突，只是要提防那些～的敌人。"},"similar":["笑里藏刀"],"usage":"作宾语、定语；用于比喻句"},{"id":46818,"word":"鞠为茂草","pinyin":"jū wéi mào cǎo","abbr":"jwmc","explanation":"指杂草塞道。形容衰败荒芜的景象。鞠，通“鞫”。","source":{"text":"诚知晋之宗庙鞠为茂草，亦犹洪川东逝，往而不还。","book":"《晋书·石勒载记》"},"example":{"text":"瑶瓦芝楣，～。","book":"清·陈康祺《郎潜纪闻》第一卷"},"similar":["鞫为茂草"],"usage":"作谓语、分句；形容荒败"},{"id":46819,"word":"鞠旅陈师","pinyin":"jū lǚ chén shī","abbr":"jlcs","explanation":"鞠：告；陈：陈列；师、旅：军队。出征之前，集合军队发布命令。","source":{"text":"鞠旅陈师，赫然大号。","book":"《诗经·小雅·采芑》：“钲人伐鼓，陈师鞠旅。”《南史·宋本纪上》"},"example":{"text":"然犹谦德自扌为，公忠日懋；吐哺握发，延览英雄；～，日闲舆卫。","book":"清·魏子安《花月痕》第二十六回"},"similar":["陈师鞠旅"],"usage":"作谓语；指集合军队发布命令"},{"id":46820,"word":"鞠躬君子","pinyin":"jū gōng jūn zǐ","abbr":"jgjz","explanation":"指谨敬尽职的人。"},{"id":46821,"word":"鞠躬尽力","pinyin":"jū gōng jìn lì","abbr":"jgjl","explanation":"指恭敬谨慎，竭尽心力。同“鞠躬尽瘁”。","source":{"text":"臣鞠躬尽力，死而后已，至于成败利钝，非臣之明所能逆睹也。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"所谓誓不与贼俱生，所谓～，死而后已，亦义也。","book":"宋·文天祥《指南录》后序"},"similar":["鞠躬尽瘁","鞠躬尽力，死而后已"],"usage":"作谓语、定语；指恭敬谨慎"},{"id":46822,"word":"鞠躬尽力，死而后已","pinyin":"jú gōng jìn lì，sǐ ér hòu yǐ","abbr":"jgjlsehy","explanation":"恭敬勤谨，尽心竭力工作，一直到死为止。","source":{"text":"臣鞠躬尽力，死而后已，至于成败利钝，非臣之明所能逆睹也。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"所谓誓不与贼俱生，所谓～，亦义也。","book":"宋·文天祥《指南录》后序"},"similar":["鞠躬尽瘁，死而后已"],"usage":"作谓语、定语、宾语；指恭敬谨慎","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，把国内的军政大权交给诸葛亮处理。诸葛亮一面联吴伐魏，南征孟获，积极准备两次北伐，在最后一次北伐前夕给阿斗写《后出师表》表示自己为国鞠躬尽瘁、死而后已"]},{"id":46823,"word":"鞠躬尽瘁","pinyin":"jū gōng jìn cuì","abbr":"jgjc","explanation":"指恭敬谨慎，竭尽心力。","source":{"text":"祖妣夫人与显考鞠躬尽瘁，誓勿蹶其门。","book":"明·宋濂《先府君蓉峰处士阡表》"},"example":{"text":"臣只有一片愚忠，～。","book":"欧阳予倩《忠王李秀成》第三幕"},"similar":["鞠躬尽力"],"usage":"作谓语、定语；指恭敬谨慎","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，把国内的军政大权交给诸葛亮处理。诸葛亮一面联吴伐魏，南征孟获，积极准备两次北伐，在最后一次北伐前夕给阿斗写《后出师表》表示自己为国鞠躬尽瘁、死而后已"]},{"id":46824,"word":"鞠躬尽瘁，死而后已","pinyin":"jū gōng jìn cuì，sǐ ér hòu yǐ","abbr":"jgjcsehy","explanation":"鞠躬：弯着身子，表示恭敬、谨慎；尽瘁：竭尽劳苦；已：停止。指勤勤恳恳，竭尽心力，到死为止。","source":{"text":"臣鞠躬尽力，死而后已。","book":"三国·蜀·诸葛亮《后出师表》"},"example":{"text":"臣兄荷皇上知遇，～，不敢言病。","book":"清·黄宗羲《巡抚天津右佥都御史留仙冯公神道碑铭》"},"usage":"作谓语、定语、宾语；指恭敬谨慎","story":["三国时期，蜀主刘备死后，昏庸无能的阿斗继位，他只知享乐，把国内的军政大权交给诸葛亮处理。诸葛亮一面联吴伐魏，南征孟获，积极准备两次北伐，在最后一次北伐前夕给阿斗写《后出师表》表示自己为国鞠躬尽瘁、死而后已"]},{"id":46825,"word":"鞠躬屏气","pinyin":"jū gōng bǐng qì","abbr":"jgbq","explanation":"指弯腰曲体，屏住呼吸，一副恭谨畏葸的样子。","source":{"text":"摄齐升堂，鞠躬如也，屏气似不息者。","book":"先秦·孔子《论语·乡党》"},"example":{"text":"江西乡衮求谒者旅集，及分宜（严嵩）延客入，皆～。","book":"明·沈德符《野获编·谐谑·谑语》"},"usage":"作谓语；指恭谨畏葸的样子"},{"id":46826,"word":"鞫为茂草","pinyin":"jū wéi mào cǎo","abbr":"jwmc","explanation":"指杂草塞道。形容衰败荒芜的景象。","source":{"text":"掓掓周道，鞫为茂草。","book":"《诗经·小雅·小弁》"},"similar":["鞠为茂草"],"usage":"作谓语、分句；形容荒败"},{"id":46827,"word":"鞬櫜干戈","pinyin":"jiān gāo gān gē","abbr":"jggg","explanation":"鞬櫜：古代盛盔甲、弓箭的口袋，引申为收藏；干戈：兵器，武器。把武器收藏于袋中。比喻刀枪入库，停战休兵，天下太平。","source":{"text":"我太宗文皇帝櫜鞬干戈。","book":"《左传·僖公二十三年》：“左执鞭弭，右属櫜鞬。”唐·元稹《对才识兼茂明于体用策》"}},{"id":46828,"word":"鞭不及腹","pinyin":"biān bù jí fù","abbr":"bbjf","explanation":"及：到。原意是鞭子虽长，也不能打马肚子。比喻相隔太远，力量达不到。","source":{"text":"虽鞭之长，不及马腹。","book":"《左传·宣公十五年》"},"example":{"text":"则脉络相连，可以应援，邈在鄂渚，岂无～之虑。","book":"《宋史·李宗勉传》"},"similar":["鞭长莫及"],"opposite":["绰绰有余"],"usage":"作谓语、定语；指力量达不到","story":["春秋时期楚庄王仗着势力强大不征得宋国同意派大夫申舟经宋国出使齐国，宋国杀了申舟。楚庄王派兵攻打宋国。宋国向晋国求援，大夫伯宗向晋景公建议不要出兵，说“虽鞭之长，不及马腹”，没有理由为了宋国而得罪楚国"]},{"id":46829,"word":"鞭丝帽影","pinyin":"biān sī mào yǐng","abbr":"bsmy","explanation":"马鞭和帽子。借指出游。","source":{"text":"塞月征尘，鞭丝帽影，常把流年虚占。","book":"宋陆游《齐天乐·左绵道中》词"},"example":{"text":"世固有一事不问，一书不读，而～，日夕驰逐于歌衫舞袖之场，以为祖国之俱乐部者。","book":"柳亚子《二十世纪大舞台发刊词》"},"usage":"作宾语、定语；指旅行"},{"id":46830,"word":"鞭墓戮尸","pinyin":"biān mù lù shī","abbr":"bmls","explanation":"鞭：鞭打；戮：杀戮。把死人从墓里挖出来，加以鞭打和杀戮。形容报恨雪耻的极端举动。","source":{"text":"及吴兵入郢，伍子胥求昭王。既不得，乃掘楚平王墓，出其尸，鞭之三百，然后已。","book":"《史记·伍子胥列传》"},"example":{"text":"～，以舒其愤。","book":"《后汉书·苏不韦传》"}},{"id":46831,"word":"鞭打快牛","pinyin":"biān dǎ kuài niú","abbr":"bdkn","explanation":"越是走得快的牛，越是用鞭子打它，让它走得更快。比喻赏罚不明，奖懒罚勤。","example":{"text":"我们不能干～的事情。"},"similar":["枪打出头鸟"],"usage":"作宾语、定语；指赏罚不公"},{"id":46832,"word":"鞭擗向里","pinyin":"biān bì xiàng lǐ","abbr":"bpxl","explanation":"意指深入剖析，使靠近最里层。形容探求透彻，深入精微。同“鞭辟近里”。","source":{"text":"近来士子肯向学者，亦时有之，但实作工夫耐久者极难得也。且是要鞭擗向里，如此下工，方自觉病痛多耳。","book":"宋张栻《答胡季随书》"},"similar":["鞭约近里"],"usage":"作谓语；指人的学习等"},{"id":46833,"word":"鞭擗进里","pinyin":"bīan pì jìn lǐ","abbr":"bpjl","explanation":"意指深入剖析，使靠近最里层。形容探求透彻，深入精微。同“鞭辟近里”。","source":{"text":"第三是生理学的假说……这种假说，是把心脏的鼓动和肺脏的呼吸，认为节奏之起源。这觉得很能鞭擗进里了。","book":"郭沫若《文艺论集·论节奏》"},"similar":["鞭辟着里"],"usage":"作谓语、定语、状语；形容分析透彻"},{"id":46834,"word":"鞭笞天下","pinyin":"biān chì tiān xià","abbr":"bctx","explanation":"笞：鞭打。指驱使天下的人。","source":{"text":"执棰附而鞭笞天下，威振四海。","book":"汉·贾谊《过秦论》"},"example":{"text":"汉王起巴蜀，～，劫诸侯，遂诛项羽，五年之内，海内平定。","book":"东汉·班固《汉书·陆贾传》"},"usage":"作谓语、定语；指执政"},{"id":46835,"word":"鞭约近里","pinyin":"biān yuē jīn lǐ","abbr":"byjl","explanation":"犹言鞭辟近里。","source":{"text":"凡事自立章程，鞭约近里，勿令心志流漫。","book":"宋·朱熹《答范伯崇书》"},"similar":["鞭擗向里"],"usage":"作谓语；指人的学习等"},{"id":46836,"word":"鞭辟入里","pinyin":"biān pì rù lǐ","abbr":"bprl","explanation":"鞭辟：鞭策，激励；里：最里层。形容作学问切实。也形容分析透彻，切中要害。","source":{"text":"侄忝承付托，责无旁贷，必当鞭辟入里，成一完全商办大厂，为天下创。","book":"盛宣怀《上张香帅书》"},"example":{"text":"他们的思力不足，不足剖析入微，～。","book":"朱自清《山野掇拾》"},"similar":["鞭辟近里"],"opposite":["无的放矢"],"usage":"作谓语、定语、状语；形容分析透彻"},{"id":46837,"word":"鞭辟向里","pinyin":"biān bì xiàng lǐ","abbr":"bbxl","explanation":"意指深入剖析，使靠近最里层。形容探求透彻，深入精微。","source":{"text":"随处体认天理之说，大约未尝不是，只要根究下落，即未免捕风捉影，纵令鞭辟向里，亦与圣门致良知之功，尚隔一尘。","book":"明·王守仁《寄邹谦之书》"},"similar":["鞭辟入里","鞭辟着里"],"usage":"作谓语、补语、状语；形容分析透彻"},{"id":46838,"word":"鞭辟着里","pinyin":"biān bì zhuó lǐ","abbr":"bbzl","explanation":"意指深入剖析，使靠近最里层。形容探求透彻，深入精微。","source":{"text":"一则文字知见义袭于外，原不曾鞭辟着里，真参实悟。","book":"清·李顒《南庠汇语》十六"},"similar":["鞭辟向里","鞭辟入里"],"usage":"作谓语、补语、状语；形容分析透彻"},{"id":46839,"word":"鞭辟近里","pinyin":"biān bì jìn lǐ","abbr":"bpjl","explanation":"鞭辟：鞭策，激励；里：最里层。古代洛阳方言。意指深入剖析，使靠近最里层。形容探求透彻，深入精微。宋儒常用语。","source":{"text":"学只要鞭辟近里，著己而已。","book":"《二程全书·遗书十一》"},"example":{"text":"～一言，实吾人顶门针、对症药。","book":"清·李颙《答顾宁人书》"},"similar":["鞭辟入里","切中要害"],"usage":"作谓语、补语；形容分析透彻"},{"id":46840,"word":"鞭长不及","pinyin":"biān cháng bù jí","abbr":"bcbj","explanation":"指力所不能及。","source":{"text":"见“鞭长不及马腹”。"},"example":{"text":"楚国和秦国的仇恨最深，秦国的势力也有点～，将来天下大乱的时候，一定从那儿开头。","book":"郭沫若《高渐离》第四幕"},"similar":["鞭长莫及"],"opposite":["绰绰有余"],"usage":"作谓语、宾语、定语；表示距离远而无力相助","story":["春秋时期，楚庄王仗着势力强大不征得宋国同意派大夫申舟经宋国出使齐国，宋国杀了申舟。楚庄王派兵攻打宋国。宋国向晋国求援，大夫伯宗向晋景公建议不要出兵，说“虽鞭之长，不及马腹”，没有理由为了宋国而得罪楚国"]},{"id":46841,"word":"鞭长不及马腹","pinyin":"biān cháng bù jí mǎ fù","abbr":"bcbjmf","explanation":"指鞭子虽然很长，但是不应该打到马肚上。后以之比喻力所不能及。","source":{"text":"言非所击。","book":"语出《左传·宣公十五年》：“古人有言曰：‘虽鞭之长，不及马腹。’”杜预注"},"example":{"text":"他未曾明白，隔了一省，就是～了。","book":"清·吴趼人《二十年目睹之怪现状》第六四回"},"similar":["鞭长莫及"],"opposite":["绰绰有余"],"usage":"作谓语、宾语、定语；同“鞭长莫及”","story":["春秋时期楚庄王仗着势力强大不征得宋国同意派大夫申舟经宋国出使齐国，宋国杀了申舟。楚庄王派兵攻打宋国。宋国向晋国求援，大夫伯宗向晋景公建议不要出兵，说“虽鞭之长，不及马腹”，没有理由为了宋国而得罪楚国"]},{"id":46842,"word":"鞭长莫及","pinyin":"biān cháng mò jí","abbr":"bcmj","explanation":"及：到。原意是鞭子虽长，也不能打马肚子。比喻相隔太远，力量达不到。","source":{"text":"虽鞭之长，不及马腹。","book":"《左传·宣公十五年》"},"example":{"text":"除掉腹地里几省外国人～，其余的虽然没有摆在面子上瓜分，暗地里都各有了主子了。","book":"清·李宝嘉《官场现形记》第五十四回"},"similar":["爱莫能助","力不从心","鞭长不及"],"opposite":["不在话下","绰绰有余"],"usage":"作谓语、定语；表示距离远而无力相助","story":["春秋时期，楚庄王仗着势力强大不征得宋国同意派大夫申舟经宋国出使齐国，宋国杀了申舟。楚庄王派兵攻打宋国。宋国向晋国求援，大夫伯宗向晋景公建议不要出兵，说“虽鞭之长，不及马腹”，没有理由为了宋国而得罪楚国"]},{"id":46843,"word":"鞭长驾远","pinyin":"biān cháng jià yuǎn","abbr":"bcjy","explanation":"指路途遥远。","source":{"text":"故自古梁州自为一道……距省会远者或二千里，鞭长驾远，稂莠丰茂。","book":"清·魏源《严公神道碑铭》"},"usage":"作谓语；指路途遥远"},{"id":46844,"word":"鞭驽策蹇","pinyin":"biān nú cè jiǎn","abbr":"bncj","explanation":"鞭打跑不快的马、驴。比喻自己能力低，但受到严格督促，勤奋不息。用作谦词。","source":{"text":"盖五年于兹，而今始克就，鞭驽策蹇，宁靡寸劳。","book":"明·张居正《纂修书成辞恩命疏》"},"usage":"作谓语；用于自谦"},{"id":46845,"word":"鞭麟笞凤","pinyin":"biān lín chì fèng","abbr":"blcf","explanation":"旧指仙人乘鸾凤鞭策其前行。","source":{"text":"陈公子，我之故人柏台吏，三年不得书一纸，鞭麟笞凤作官府。","book":"元·李孝光《送陈君礼之婺女兼寄徐仲礼》"}},{"id":46846,"word":"韦布匹夫","pinyin":"wéi bù pǐ fū","abbr":"wbpf","explanation":"韦布：韦带布衣，指粗陋之服；匹夫：平民。泛指普通百姓。","source":{"text":"小生乃草莱下士，韦布匹夫。","book":"明·陆采《怀香记·托婢传情》"},"similar":["平民百姓"],"usage":"作主语、宾语、定语；用于书面语"},{"id":46847,"word":"韦弦之佩","pinyin":"wéi xián zhī pèi","abbr":"wxzp","explanation":"韦：熟牛皮，弦：弓弦。原指西门豹性急，佩韦自戒；董安于性缓，佩弦自戒。原形容随时警戒自己。后常比喻有益的规劝。","source":{"text":"西门豹之性急，故佩韦以缓己；董安于之性缓，故佩弦，故佩弦以自急。","book":"《韩非子·观行》"},"usage":"作宾语；指有益的规劝"},{"id":46848,"word":"韦编三绝","pinyin":"wéi biān sān jué","abbr":"wbsj","explanation":"韦编：用熟牛皮绳把竹简编联起来；三：概数，表示多次；绝：断。编连竹简的皮绳断了三次。比喻读书勤奋。","source":{"text":"读《易》，韦编三绝。","book":"《史记·孔子世家》"},"example":{"text":"我们提倡～的读书精神，更提倡学以致用，期待创新人才的大量涌现。"},"similar":["三绝韦编"],"usage":"作谓语、宾语；指人读书勤奋","story":["春秋时期孔子十分好学，晚年还坚持研究《易经》，他反复钻研该书，把该书的捆竹简的牛皮带都磨断了三次，终于把研究的心得写成十篇文章，即《十翼》。后人把《十翼》与《易经》附在一起，作为《易经》的补充部分"]},{"id":46849,"word":"韦裤布被","pinyin":"wéi kù bù bèi","abbr":"wkbb","explanation":"韦：熟皮叫韦，生皮称革。熟皮作裤子，粗布作被。形容生活很节俭。","source":{"text":"遵为人廉约小心，克己奉公，赏赐辄尽与士卒，家无私财，身衣韦裤布被，夫人裳不加缘。帝以是重焉。","book":"《后汉书·祭尊传》"}},{"id":46850,"word":"韩信将兵","pinyin":"hán xìn jiàng bīng","abbr":"hxjb","explanation":"韩信：刘邦的将军；将：统率，指挥。比喻越多越好。","source":{"text":"上曰：‘于君何如？’曰：‘臣多多而益善耳。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"毛泽东《关于农业互助合作的两次谈话》：“有强的领导骨干，办得好，那是～，多多益善。”"},"similar":["多多益善"],"opposite":["宁缺毋滥"],"usage":"作宾语、定语；常与“多多益善”连用","story":["西汉初期，韩信最初投奔项羽，没有得到重用，就去投奔刘邦，经丞相萧何极力推荐，才担任汉军的大将军。一次刘邦问韩信能够带多少兵，韩信回答说越多越好，因此得罪了刘邦。后来西汉巩固后，韩信被封为淮阴侯，不久就朝廷所杀"]},{"id":46851,"word":"韩信将兵，多多益善","pinyin":"hán xìn jiàng bīng，duō duō yì shàn","abbr":"hxjbddys","explanation":"将：统率，指挥。比喻越多越好。","source":{"text":"上曰：‘于君何如？’曰：‘臣多多而益善耳。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"有强的领导骨干，办得好，那是～。","book":"毛泽东《关于农业互助合作的两次谈话》"},"similar":["多多益善"],"usage":"作宾语、分句；比喻越多越好","story":["西汉初期，韩信最初投奔项羽，没有得到重用，就去投奔刘邦，经丞相萧何极力推荐，才担任汉军的大将军。一次刘邦问韩信能够带多少兵，韩信回答说越多越好，因此得罪了刘邦。后来西汉巩固后，韩信被封为淮阴侯，不久就朝廷所杀"]},{"id":46852,"word":"韩信用兵，多多益办","pinyin":"hán xìn yòng bīng，duō duō yì bàn","abbr":"hxybddyb","explanation":"比喻越多越好。同“韩信将兵，多多益善”。","source":{"text":"韩信用兵，多多益办。此是化工造物之妙，与文同用。","book":"明·王世贞《艺苑卮言》卷三"},"similar":["韩信将兵，多多益善"],"usage":"作宾语、分句；比喻越多越好"},{"id":46853,"word":"韩信登坛","pinyin":"hán xìn dēng tán","abbr":"hxdt","explanation":"汉王刘邦设立拜将坛，用极为隆重的仪式拜韩信为大将军。后指授予要职，委以重任。","source":{"text":"何曰：‘王素慢无礼，今拜大将如呼小儿耳，此乃信所以去也。王必欲拜之，择良日，斋戒，设坛场，具礼，乃可耳。’王许之。","book":"《史记·淮阴侯列传》"},"example":{"text":"既班三事，又贰六宫，卫青受诏，～。","book":"北周·庾信《周大将军崔说神道碑》"}},{"id":46854,"word":"韩卢逐块","pinyin":"hán lú zhú kuài","abbr":"hlzk","explanation":"比喻白费精力。","source":{"text":"直须狮子咬人，莫学韩卢逐块。","book":"宋·释普济《五灯会元》"},"usage":"作宾语；比喻白费精力"},{"id":46855,"word":"韩卢逐逡","pinyin":"hán lú zhú qūn","abbr":"hlzq","explanation":"逡，狡兔名。比喻争强斗胜，两败俱伤。","source":{"text":"逡，狡兔名。","book":"《战国策·齐策三》：“韩子卢者，天下之疾犬也。东郭逡者，海内之狡兔也。韩子卢逐东郭逡，环山者三，腾山者五，兔极于前，犬废于后，犬兔俱罢，各死其处。”鲍彪注"},"example":{"text":"宁骖罢服羸全以自终，岂能与～而斗行步之工。","book":"明·何景明《蹇赋》"},"similar":["韩卢逐鵕"],"usage":"作宾语、定语；用于比喻句","story":["传说古代天下跑得最快的狗是韩子卢，而跑得最快而且狡猾的兔子是东郭逡。一天一只韩子卢追逐东郭逡，围绕三座山跑了五圈，韩子卢还是没有追上东郭逡，结果两者都累死了。一个农夫刚好路过，轻易地捉住韩子卢和东郭逡"]},{"id":46856,"word":"韩寿偷香","pinyin":"hán shòu tōu xiāng","abbr":"hstx","explanation":"比喻男女暗中通情。","source":{"text":"《晋书·贾谧传》、南朝宋刘义庆《世说新语·惑弱》载：晋韩寿美姿容，贾充辟为司空掾。充少女午见而悦之，使侍婢潜修音问，及期往宿，家中莫知，并盗西域异香赠寿。充僚属闻寿有奇香，告于充。充乃考问女之左右，具以状对。充秘其事，遂以女妻寿。"},"example":{"text":"不但偷铃，～，方法也是我教他的。","book":"明·沈鲸《双珠记·遇淫持正》"},"similar":["偷香窃玉","韩寿分香"],"usage":"作宾语、定语；指男女私通","story":["晋朝时期，权臣贾充任命风流潇洒的韩寿为司空堟，韩寿经常出入贾充府中，贾充的女儿贾午看上了韩寿，就打发侍婢与韩寿联络幽会事宜，并把皇帝送给贾充的西域香料偷来送给韩寿。贾充发现韩寿身上有西域香味，经询问就把贾午许配给他"]},{"id":46857,"word":"韩寿分香","pinyin":"hán shòu fēn xiāng","abbr":"hsfx","explanation":"指男女暗中偷情。","source":{"text":"南朝·宋·刘义庆《世说新语·惑溺》及《晋书·贾充传》载：晋韩寿与大臣贾充之女贾午私通，午以晋武帝赐父奇香偷赠韩寿。"},"example":{"text":"虽似安仁掷果，未闻～。","book":"五代·欧阳炯《春光好》"},"similar":["韩寿偷香"],"usage":"作宾语、定语；指男女私通"},{"id":46858,"word":"韩康卖药","pinyin":"hán kāng mài yào","abbr":"hkmy","explanation":"隐士逃名避世。指卖药。","source":{"text":"韩康，字伯休，一名恬休，京兆霸陵人。家世著姓。常采药名山，卖于长安市。","book":"南朝·宋·范晔《后汉书·韩康传》"},"example":{"text":"刘商观弈罢，～还。","book":"元·张雨《梧叶儿》"},"usage":"作宾语、定语；指隐士卖药","story":["汉朝时期，出身豪门的韩康不愿入仕当官，经常游名山采药到长安市场上去卖，三十年如一日坚持言不二价。有一次，一个女子向韩康买药，讨价还价，女子说她早就知道韩康言不二价，韩康叹息自己隐名避世还是被人认出，就隐遁于霸陵山中"]},{"id":46859,"word":"韩海苏潮","pinyin":"hán hǎi sū cháo","abbr":"hhsc","explanation":"指唐朝韩愈和宋朝苏轼的文章气势磅礴，如海如潮。","source":{"text":"国朝萧墨《经史管窥》引李耆卿《文章精义》云：‘韩如海，柳如泉，欧如澜，苏如潮。’","book":"清·俞樾《茶香室从钞》卷八"},"similar":["韩潮苏海"],"usage":"作宾语；指文章的风格"},{"id":46860,"word":"韩潮苏海","pinyin":"hán cháo sū hǎi","abbr":"hcsh","explanation":"指唐朝韩愈和宋朝苏轼的文章气势磅礴，如海如潮。","source":{"text":"观其上下五千年，纵横九万里，直兼乎韩潮苏海，则不啻读《经世文编》焉。","book":"清·杨毓辉《〈盛世危言〉跋》"},"similar":["韩海苏潮"],"usage":"作宾语；指文章的风格"},{"id":46861,"word":"韩陵片石","pinyin":"hán líng piàn shí","abbr":"hlps","explanation":"比喻少见的好文章。","source":{"text":"惟有韩陵一片石堪共语；薛道衡、卢思道，少解把笔，其余驴鸣狗吠，聒耳而已。","book":"唐·张鷟《朝野佥载》卷六"},"similar":["寒山片石","片石韩陵"],"usage":"作宾语；用于比喻句","story":["南北朝时期，梁朝的庾信从南朝到北方，文士很多看不起他。庾信把《枯树赋》给他们看，自后没有人敢说什么。庾信也是根据温子升的《韩陵山寺碑》一文写的。后来南方人问庾信北方的文士水平怎样？庾信说只有韩陵片石的温子升可相提并论"]},{"id":46862,"word":"韫匵而藏","pinyin":"yùn dú ér cáng","abbr":"ydec","explanation":"韫匵：藏在柜子里。把东西放在柜子里藏起来。旧时比喻怀才隐退。","source":{"text":"有美玉于斯，韫匵而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"晋楚相持，吾王正在用人之际，两位将军，有此神箭，当奏闻吾王，美玉不可～。（明·冯梦龙《东周列国志》第五十八回）"}},{"id":46863,"word":"韫匵藏珠","pinyin":"yùn dú cáng zhū","abbr":"ydcz","explanation":"韫：藏；匵：木匣子。把珠宝藏在匣子里，等待高价出售。比喻怀才待用或怀才隐退。","source":{"text":"有美玉于斯，韫匵而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"酒家眠，权休息，～隐尘迹，万里前程在咫尺。（元·施惠《幽闺记》第三十一出）"}},{"id":46864,"word":"韫椟待价","pinyin":"yùn dú dài jià","abbr":"yddj","explanation":"韫椟：藏在匣子里。把玉藏在匣子里，等待高价出售。比喻怀才待用或怀才隐退。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"similar":["韫椟藏珠","韫玉待价"],"usage":"作谓语、定语；用于书面语"},{"id":46865,"word":"韫椟未酤","pinyin":"yùn dú wèi gū","abbr":"ydwg","explanation":"韫椟：藏在柜子里；酤：卖。藏在匣子里尚未出售。比喻怀才待用或怀才隐退。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"不计治萃，名与殊路，知我者希，～。","book":"三国·魏·刘桢《处士国文甫碑》"},"similar":["韫玉待价","韫椟待价"],"usage":"作谓语、定语；用于书面语"},{"id":46866,"word":"韫椟而藏","pinyin":"yùn dú ér cáng","abbr":"ydec","explanation":"韫椟：藏在柜子里。把东西放在柜子里藏起来。旧时比喻怀才隐退。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"晋楚相恃，吾王正在用人之际，两位将军，有此神箭，当奏闻吾王，美玉不可～。","book":"明·冯梦龙《东周列国志》第五十八回"},"similar":["韫椟藏珠"],"usage":"作谓语；比喻怀才待用"},{"id":46867,"word":"韫椟藏珠","pinyin":"yùn dú cáng zhū","abbr":"ydcz","explanation":"韫：蕴藏。椟：木匣子。指珠宝藏在木匣里，等待高价出售。比喻怀才待用或怀才隐退。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"酒家眠，权休息，～隐尘迹，万里前程在咫尺。","book":"元·无名氏《幽闺记·英雄应辟》"},"similar":["韫椟而藏"],"usage":"作谓语、定语；用于书面语"},{"id":46868,"word":"韫玉待价","pinyin":"yùn yù dài jià","abbr":"yydj","explanation":"韫玉：把玉藏在匣子里。把玉藏在匣子里，等待高价出售。比喻怀才待用或怀才隐退。","source":{"text":"有美玉于斯，韫椟而藏诸，求善贾而沽诸？","book":"《论语·子罕》"},"example":{"text":"难道《诗经》二句诗在手帕上写的，你还不明白么？那明是～之意。（清·石玉昆《三侠五义》第八十九回）"},"similar":["韫椟待价"],"usage":"作谓语、定语；用于书面语"},{"id":46869,"word":"韬光俟奋","pinyin":"tāo guāng sì fèn","abbr":"tgsf","explanation":"指掩藏才智，待时奋起。《晋书·慕容垂载记》：","source":{"text":"但时来之运未至，故韬光俟奋耳。","book":"《晋书·慕容垂载记》"},"similar":["韬光隐晦"],"usage":"作谓语、定语；用于处事"},{"id":46870,"word":"韬光养晦","pinyin":"tāo guāng yǎng huì","abbr":"tgyh","explanation":"指隐藏才能，不使外露。","source":{"text":"贤侄休怪老夫说，似你这般人物，不争就此罢休。你此去，须韬光养晦，再看天时。","book":"清·俞万春《荡寇志》第76回"},"example":{"text":"他急于～，不想出山。"},"similar":["韬光晦迹"],"usage":"作谓语；指隐藏才能，不使外露"},{"id":46871,"word":"韬光敛彩","pinyin":"tāo guāng liǎn cǎi","abbr":"tglc","explanation":"收敛光采。比喻隐匿才华，无声无息。","source":{"text":"自是益韬光敛彩，系情山水间。","book":"明·宋濂《史处士墓碑文》"},"usage":"作谓语、定语；用于处事"},{"id":46872,"word":"韬光敛迹","pinyin":"tāo guāng liǎn jì","abbr":"tglj","explanation":"指隐藏才能，不使外露。同“韬光晦迹”。","source":{"text":"学道人须是韬光敛迹，勿露锋芒，故曰潜曰密。","book":"明·袁宏道《德山尘谭》"},"similar":["韬光灭迹"],"usage":"作谓语、定语；用于处事"},{"id":46873,"word":"韬光晦迹","pinyin":"tāo guāng huì jì","abbr":"tghj","explanation":"韬光：把才华隐藏起来；晦迹：不让人知道自己的踪迹。指隐藏才能，不使外露。","source":{"text":"历太和会昌朝，愈事韬晦，群居游处，未尝有言。","book":"宋·李昉《太平御览》卷五十六引《高僧传》：“释僧同，韬光晦迹，人莫能知，居寒山。”《旧唐书·宣宗记》"},"example":{"text":"单说这自古至今有那一等怀才抱德，～的文人秀才，就比那奇珍异宝，良金美玉，藏于泥土之中。","book":"明·冯梦龙《醒世恒言》卷四十"},"similar":["韬光养晦"],"usage":"作谓语、定语；指隐藏才能，不使外露"},{"id":46874,"word":"韬光灭迹","pinyin":"tāo guāng miè jì","abbr":"tgmj","explanation":"指隐藏自己行迹，不使外人得知。","source":{"text":"妾之先宗，羞共戴天，虑其后患，乃率其族，韬光灭迹，易姓变名，避仇于新平真宁县安村。","book":"唐·无名氏《灵应传》"},"similar":["韬光敛迹"],"usage":"作谓语、定语；用于处事"},{"id":46875,"word":"韬光用晦","pinyin":"tāo guāng yòng huì","abbr":"tgyh","explanation":"指隐藏才能，不使外露。同“韬光养晦”。","source":{"text":"圣人所以立言于彼，垂训于后，将令学者得韬光用晦之机，不使来人有衒实矜华之丑。","book":"唐·黄滔《知白守黑赋》"},"similar":["韬光隐晦","韬光养晦"],"usage":"作谓语、定语；用于处事"},{"id":46876,"word":"韬光隐晦","pinyin":"tāo guāng yǐn huì","abbr":"tgyh","explanation":"指隐藏才能，不使外露。同“韬光养晦”。","source":{"text":"这也与其说是由于信陵君的悲观、失望而至于消极，倒宁可说是由于魏王的猜忌、残忍，而使他不得不韬光隐晦的。","book":"郭沫若《附录·写作缘起》"},"similar":["韬光俟奋","韬光用晦"],"usage":"作谓语、定语；用于处事"},{"id":46877,"word":"韬光隐迹","pinyin":"tāo guāng yǐn jì","abbr":"tgyj","explanation":"指隐藏才能，不使外露。同“韬光晦迹”。","source":{"text":"妾之先宗，羞共戴天，虑其后患，乃率其族，韬光灭迹，易姓变名，避仇于新平真宁县安村。","book":"唐·无名氏《灵应传》"},"example":{"text":"怀美玉，便～，二十余年。","book":"金·马钰《满庭芳·和公师叔词》"},"similar":["韬光灭迹","韬光晦迹"],"usage":"作谓语、定语；用于处事"},{"id":46878,"word":"韬光韫玉","pinyin":"tāo guāng yùn yù","abbr":"tgyy","explanation":"隐匿光采，韫藏宝玉。比喻隐藏才华，不露光芒。","source":{"text":"君商时度世，引己倍权，守静彻冗，韬光韫玉，以远悔咎。","book":"《隶释·汉小黄门谯敏碑》"},"opposite":["锋芒毕露"],"usage":"作谓语、定语；用于书面语"},{"id":46879,"word":"韬声匿迹","pinyin":"tāo shēng nì jì","abbr":"tsnj","explanation":"隐匿音信踪迹。指不被人所见闻。","source":{"text":"投簪卷带，韬声匿迹。","book":"晋·挚虞《徵士胡昭赞》"},"similar":["韬神晦迹"],"usage":"作谓语、定语；用于处事"},{"id":46880,"word":"韬形灭影","pinyin":"tāo xíng miè yǐng","abbr":"txmy","explanation":"指藏匿踪迹，不露于世。","source":{"text":"物之寓世，未尝不韬形灭影、隐质遐外，以全性栖命者也。","book":"北齐·刘昼《新论·韬光》"}},{"id":46881,"word":"韬戈偃武","pinyin":"tāo gē yǎn wǔ","abbr":"tgyw","explanation":"指收藏兵器，停止武备，以修文治。","source":{"text":"译靡绝时，书无虚目，韬戈偃武，天下晏如。","book":"《隋书·炀帝纪上》"},"similar":["韬戈卷甲"],"usage":"作谓语、宾语；用于书面语"},{"id":46882,"word":"韬戈卷甲","pinyin":"tāo gē juǎn jiǎ","abbr":"tgjj","explanation":"韬戈：收藏兵器；卷甲：卷束铠甲。指休兵停战。","source":{"text":"韬戈卷甲，伫候指挥。","book":"《旧唐书·陈少游传》"},"similar":["韬戈偃武"],"usage":"作谓语、宾语；用于书面语"},{"id":46883,"word":"韬晦之计","pinyin":"tāo huì zhī jì","abbr":"thzj","explanation":"韬：把才华隐藏起来；晦：不让人知道自己的踪迹。指隐藏才能，不使外露。","source":{"text":"历太和会昌朝，愈事韬晦，群居游处，未尝有言。","book":"《旧唐书·宣宗记》"},"example":{"text":"玄德也防曹操谋害，就下处后园种菜，亲自浇灌，以为～。 ◎明·罗贯中《三国演义》第二十一回"}},{"id":46884,"word":"韬晦待时","pinyin":"tāo huì dài shí","abbr":"thds","explanation":"指暂时掩藏锋芒，隐匿踪迹，等待时机而动。","source":{"text":"辛亥那年国光就加入革命，后来时事日非，只好韬晦待时。","book":"茅盾《蚀·动摇六》"},"similar":["韬光俟奋"],"usage":"作谓语、定语；用于处事"},{"id":46885,"word":"韬曜含光","pinyin":"tāo yào hán guāng","abbr":"tyhg","explanation":"掩藏隐匿光明。指不显耀名声。","source":{"text":"出则施声教，款遐荒，臻盛美，流休详；处则韫椟深藏，韬曜含光。","book":"明·何景明《七述》"},"usage":"作谓语、定语；用于处事"},{"id":46886,"word":"韬神晦迹","pinyin":"tāo shén huì jì","abbr":"tshj","explanation":"指隐藏踪迹。","source":{"text":"粤若高祖文皇帝，诞圣降灵，则赤光照室，韬神晦迹，则紫气腾天。","book":"《晋书·卢道衡传》"},"similar":["韬声匿迹"],"usage":"作谓语、定语；用于处事"},{"id":46887,"word":"韬迹隐智","pinyin":"tāo jì yǐn zhì","abbr":"tjyz","explanation":"指藏匿踪迹，不露才智。","source":{"text":"是以古之有德者，韬迹隐智，以密其外。","book":"北齐·刘昼《新论·韬光》"},"similar":["韬光灭迹"],"usage":"作谓语、定语；用于处事"},{"id":46888,"word":"音与政通","pinyin":"yīn yǔ zhèng tōng","abbr":"yyzt","explanation":"音：音乐；政：政治。音乐与政治是相联系的。指音乐是社会生活的反映。","source":{"text":"乃知法曲本华风，苟能审音与政通。","book":"《礼记·乐记》：“亡国之音哀以思，其民困。声音之道，与政通矣。唐·白居易《法曲·美列圣，正华声也》"}},{"id":46889,"word":"音信杳无","pinyin":"yīn xìn yǎo wú","abbr":"yxyw","explanation":"没有一点消息。","source":{"text":"盼前程音信杳无。","book":"明·吾邱瑞《运甓记·剪发延宾》"},"similar":["杳无音信"],"usage":"作谓语、定语；用于书面语"},{"id":46890,"word":"音信杳然","pinyin":"yīn xìn yǎo rán","abbr":"yxyr","explanation":"没有一点消息。","source":{"text":"马道长一去，音信杳然，定非吉兆；明日且与姜尚会战，看是如何，再探马道长消息。","book":"明·许仲琳《封神演义》第六十一回"},"example":{"text":"目今又当大比之年，此时想已放榜，怎么～？难道我相公又下第了不成？","book":"明·叶宪祖《鸾鎞记》第二十三出"}},{"id":46891,"word":"音吐明畅","pinyin":"yīn tǔ míng chàng","abbr":"ytmc","explanation":"声音洪亮而且畅达。","source":{"text":"帝元日大飨含元殿，钧年八十，升降如仪，音吐鸿畅，举朝咨叹。","book":"《新唐书·卢钧传》"},"example":{"text":"每对御读所试进士辞赋，～，经读者多中高第。","book":"《宋史·王沔传》"}},{"id":46892,"word":"音吐鸿畅","pinyin":"yīn tǔ hóng chàng","abbr":"ythc","explanation":"声音洪亮而且畅达。","source":{"text":"帝元日大飨含元殿，钧年八十，升降如仪，音吐鸿畅，举朝咨叹。","book":"《新唐书·卢钧传》"},"example":{"text":"宣德初，授御史。奏对，～，帝为倾听。","book":"《明史·于谦传》"}},{"id":46893,"word":"音声如钟","pinyin":"yīn shēng rú zhōng","abbr":"ysrz","explanation":"形容声音响亮。","source":{"text":"身长八尺二寸，音声如钟。","book":"《后汉书·卢植传》"},"similar":["声如洪钟"],"usage":"作谓语、定语；用于人说话等"},{"id":46894,"word":"音容凄断","pinyin":"yīn róng qī duàn","abbr":"yrqd","explanation":"形容声音容貌哀伤到极点的情态。","source":{"text":"后一日，梦妇女来别，音容凄断，曰：‘已是前长史女，死殡在城东南角。’","book":"唐·戴君孚《广异记·阎陟》"},"usage":"作谓语、状语；用于人的状态"},{"id":46895,"word":"音容如在","pinyin":"yīn róng rú zài","abbr":"yrrz","explanation":"声音和容貌仿佛还在。形容对死者的想念。同“音容宛在”。","source":{"text":"真堪爱，如花似玉风流态。风流态，眠思梦想，音容如在。","book":"《何典》第八回"},"similar":["音容宛在"],"usage":"作谓语；形容对死者的想念"},{"id":46896,"word":"音容宛在","pinyin":"yīn róng wǎn zài","abbr":"yrwz","explanation":"音：声音；容：容颜；宛：仿佛。声音和容貌仿佛还在。形容对死者的想念。","source":{"text":"年年旧事音容在，日日谁家梦想频。应是荆山留不住，至今犹得睹芳尘。","book":"唐·曹松《巫峡》"},"similar":["音容如在"],"usage":"作谓语；形容对死者的想念"},{"id":46897,"word":"音容笑貌","pinyin":"yīn róng xiào mào","abbr":"yrxm","explanation":"谈笑时的容貌和神态。用以怀念故人的声音容貌和神情。","source":{"text":"恭俭岂可以声音笑貌为哉？","book":"《孟子·离娄上》"},"example":{"text":"所以直到现在，先生的～，还在目前，而所讲的《说文解字》却一句也不记得了。（鲁迅《关于太炎先生二三事》）"},"usage":"作主语、宾语；指人的全貌"},{"id":46898,"word":"音稀信杳","pinyin":"yīn xī xìn yǎo","abbr":"yxxy","explanation":"没有音讯和消息。","source":{"text":"想杀人也天，盼杀人也天，短命冤家，音稀信杳，莫不误约盟言。","book":"元·无名氏《字字锦》曲"},"similar":["杳无音信"],"opposite":["音问相继"],"usage":"作谓语、定语；用于书面语"},{"id":46899,"word":"音耗不绝","pinyin":"yīn hào bù jué","abbr":"yhbj","explanation":"音耗：音信，消息。指保持联系，音信不断。","source":{"text":"生留旬月，乃挈妻孥归青齐，自是李君音耗不绝。","book":"唐·张读《宣室志·计真》"},"usage":"作谓语、定语；用于交往等"},{"id":46900,"word":"音问两绝","pinyin":"yīn wèn liǎng jué","abbr":"ywlj","explanation":"书信与消息都断绝。亦作“音问杳然”。","source":{"text":"后楚卒，元方护丧居江陵，数年间，音问两绝。","book":"唐·李复言《续玄怪录·卢造》"},"similar":["音问杳然"],"opposite":["音问相继"],"usage":"作谓语、定语；用于书面语"},{"id":46901,"word":"音问杳然","pinyin":"yīn wèn yǎo rán","abbr":"ywyr","explanation":"不通书信与消息。","source":{"text":"后楚卒，元方护丧居江陵，数年间，音问两绝。","book":"唐·李复言《续玄怪录·卢造》"},"similar":["音问两绝"],"opposite":["音问相继"],"usage":"作谓语、定语；用于书面语"},{"id":46902,"word":"音问相继","pinyin":"yīn wèn xiāng jì","abbr":"ywxj","explanation":"书信消息来往不断。","source":{"text":"令狐仆射与予投分素深，纵山川阻峭，然音问相继。","book":"唐·刘禹锡《令狐仆射》诗序"},"opposite":["音问杳然","音问两绝"],"usage":"作谓语、定语；用于书面语"},{"id":46903,"word":"韶光似箭","pinyin":"sháo guāng sì jiàn","abbr":"sgsj","explanation":"韶光：美好的时光。美好的光阴像飞箭一样流逝","source":{"text":"端的是韶光似箭催人老，日月如梭赶少年。","book":"明·黄元吉《流星马》第一折"},"similar":["光阴似箭"],"usage":"作宾语、定语；指时光流逝"},{"id":46904,"word":"韶光淑气","pinyin":"sháo guāng shū qì","abbr":"sgsq","explanation":"韶光：美好的时光；淑：美好。春天的美好景象","source":{"text":"韶光开令序，淑气动芳年。","book":"唐·李世民《春日玄武门宴群臣》诗"},"usage":"作谓语、定语、状语；指春光"},{"id":46905,"word":"韶光荏苒","pinyin":"sháo guāng rěn rǎn","abbr":"sgrr","explanation":"韶光：美好的时光；荏苒：流逝。指美好的春光渐渐过去","source":{"text":"韶光荏苒，叹桑榆暮景，贫困相兼。","book":"明·柯丹丘《荆钗记·分别》"},"similar":["韶光似箭"],"usage":"作宾语、定语；指时光流逝"},{"id":46906,"word":"韶华如驶","pinyin":"shǎo huá rú shǐ","abbr":"shrs","explanation":"韶华：美好的时光，常指春光。比喻美好的春光如马飞逝而过。","source":{"text":"玉辇何年来帝子，更淹淹蹉跎岁时。看过眼韶华如驶，长日伴飞絮游丝。","book":"明·无名氏《红叶记·御沟得叶》"},"usage":"作宾语、定语；多用于感叹"},{"id":46907,"word":"韶颜稚齿","pinyin":"sháo yán zhì chǐ","abbr":"syzc","explanation":"韶颜：美好的容貌；稚齿：指年少。指青春年少","source":{"text":"我为女子，薄命如斯，君是丈夫，负心若此。韶颜稚齿，饮恨而终。","book":"唐·蒋防《霍小玉传》"},"example":{"text":"《剪灯新话·牡丹灯记》：“生于月下视之，～，真国色也。”"},"usage":"作宾语、定语；用于比喻句"},{"id":46908,"word":"顶冠束带","pinyin":"dǐng guān shù dài","abbr":"dgsd","explanation":"头上戴着朝冠，腰上束着玉带。旧指朝廷命官的装束。","source":{"text":"本来历史是最不可靠的东西，奉敕编纂的史官，不过是顶冠束带的抄胥。","book":"清·曾朴《孽海花》第三十五回"}},{"id":46909,"word":"顶名冒姓","pinyin":"dǐng míng mào xìng","abbr":"dmmx","explanation":"指冒充他人。","source":{"text":"恐系外乡光棍，顶名冒姓。","book":"《儒林外史》第四五回"},"similar":["冒名顶替"],"usage":"作谓语、定语、宾语；指作假"},{"id":46910,"word":"顶名替身","pinyin":"dǐng míng tì shēn","abbr":"dmts","explanation":"犹言顶名冒姓。","source":{"text":"顶名替身者取首级，交头互耳者取首级。","book":"《西游记》第十五回"},"usage":"作宾语、定语；指作假"},{"id":46911,"word":"顶天立地","pinyin":"dǐng tiān lì dì","abbr":"dtld","explanation":"头顶云天，脚踏大地。形容形象高大，气慨豪迈。","source":{"text":"我韩厥是一个顶天立地的男儿。","book":"宋·释普济《五灯会元》卷五十六：“汝等诸人，个个顶天立地。”元·纪君祥《赵氏孤儿》第一折"},"example":{"text":"先生是楚国的栋梁，是～的柱石。","book":"郭沫若《屈原》第三幕"},"similar":["英姿勃勃","威风凛凛","气概不凡"],"opposite":["瞻前顾后"],"usage":"作谓语、定语、补语；多用于男人"},{"id":46912,"word":"顶天踵地","pinyin":"dǐng tiān zhǒng dì","abbr":"dtzd","explanation":"犹言顶天立地。指生存于天地之间。","source":{"text":"夫人顶天踵地，惟呼最灵。","book":"五代·王定保《唐摭言·没用处》"},"similar":["顶天立地"],"usage":"作谓语、定语、补语；多用于男人"},{"id":46913,"word":"顶头上司","pinyin":"dǐng tóu shàng sī","abbr":"dtss","explanation":"本人或本单位的直接领导人或部门。","source":{"text":"对于我们的‘顶头上司’，也以极诚恳的态度，商量挽救这一个文化堡垒的办法。","book":"邹韬奋《抗战以来·“诸葛亮”和“阿斗”搏斗》"},"example":{"text":"他的～真不会做人。"},"similar":["直接上司"],"usage":"作宾语、定语；指直接领导"},{"id":46914,"word":"顶头风","pinyin":"dǐng tóu fēng","abbr":"dtf","explanation":"逆风。比喻遭受困难或挫折。","source":{"text":"屋漏更遭连夜雨，船迟又被打头风。","book":"明·冯梦龙《古今小说》卷九"}},{"id":46915,"word":"顶盔掼甲","pinyin":"dǐng kuī guàn jiá","abbr":"dkgj","explanation":"戴上头盔，披上战甲。指全身武装。","example":{"text":"战士们～，快速进入战斗。"},"usage":"作谓语、定语；指全身武装"},{"id":46916,"word":"顶礼膜拜","pinyin":"dǐng lǐ mó bài","abbr":"dlmb","explanation":"顶礼：佛教拜佛时的最敬礼，人跪下，两手伏地，以头顶着受礼人的脚；膜拜：佛教徒的另一种敬礼，两手加额，跪下叩头。虔诚地跪拜。","source":{"text":"又添一个青年女子，顶礼膜拜，行状举止，仿佛慧娘。","book":"清·俞万春《荡寇志》第一百十四回"},"example":{"text":"这句话传扬开去，一时哄动了吉州百姓，扶老携幼，都来～。","book":"清·吴趼人《痛史》第二十回"},"similar":["五体投地","肃然起敬","奉若神明"],"opposite":["不以为然"],"usage":"作谓语；指十分崇拜"},{"id":46917,"word":"顶踵尽捐","pinyin":"dǐng zhǒng jìn juān","abbr":"dzjj","explanation":"犹言顶踵捐糜。指捐躯，牺牲。"},{"id":46918,"word":"顶踵捐糜","pinyin":"dǐng zhǒng juān mí","abbr":"dzjm","explanation":"指捐躯，牺牲。"},{"id":46919,"word":"顶针续麻","pinyin":"dǐng zhēn xù má","abbr":"dzxm","explanation":"首尾相连，循环往复的一种文字游戏。如：成语接龙等。","source":{"text":"宋、元以来的一种文字游戏。即一人说一条成语或诗文，下一个人以其尾字为首字，再接着说，说不出者为负，罚饮酒或其他。"},"example":{"text":"就从妹子说一句书，无论经史子集，大家都～依次接下去。","book":"清·李汝珍《镜花缘》第七十八回"},"usage":"作宾语；指文字游戏"},{"id":46920,"word":"顶门一针","pinyin":"dǐng mén yī zhēn","abbr":"dmyz","explanation":"针灸时自脑门所下的一针。比喻切中要害而能使人觉醒的言语举动。","source":{"text":"盏事上十年，聒聒顶门一针，每言治乱，原于君心。","book":"宋·刘克庄《题毋惰赵公辞执政恩数简》"},"example":{"text":"至于玉娘、玉郎当面煞风景，尤为痴情者～。","book":"明·祁彪佳《远山堂剧品·有情痴》"}},{"id":46921,"word":"顶门壮户","pinyin":"dǐng mén zhuàng hù","abbr":"dmzh","explanation":"指支撑门户，光耀门第。","source":{"text":"这也不枉你大哥哥死了，你大嫂子拉扯他一场，日后也替你大哥哥顶门壮户。","book":"清·曹雪芹《红楼梦》第88回"},"example":{"text":"她家就靠她～了。"},"similar":["顶门立户"],"usage":"作谓语、定语；指支撑门户","story":["贾母与李纨母子在一起聊天，贾宝玉提着蝈蝈笼进来，贾母指责他怎么不学习，同时夸奖贾兰有出息，将来肯定会替贾珠顶门壮户。李纨想起贾珠来不住地流泪，见宝玉在就说要经常夸奖孩子，这样一来二去，孩子就会有长进"]},{"id":46922,"word":"顶门立户","pinyin":"dǐng mén lì hù","abbr":"dmlh","explanation":"支撑门户。指独立成家。","source":{"text":"三官虽然已经另外顶门立户，但是打鱼的一切生财器具还是和他大哥、二哥共有着。","book":"吴组缃《山洪》三"},"example":{"text":"还没成人，就叫他自己～，自己奔日子。","book":"浩然《机灵鬼》"},"usage":"作谓语、定语；指家庭主心骨"},{"id":46923,"word":"顷刻之间","pinyin":"qǐng kè zhī jiān","abbr":"qkzj","explanation":"顷刻：片刻。指极其短暂的时间。","source":{"text":"纷纭而逼胁愈间，顷刻之间，安危莫保。","book":"《旧五代史·周书·太祖记》"},"example":{"text":"这座大厦～化为乌有。"},"similar":["转瞬之间","须臾之间"],"usage":"作宾语、状语；指很短的时间"},{"id":46924,"word":"项庄之剑，志在沛公","pinyin":"xiàng zhuāng zhī jiàn，zhì zài pèi gōng","abbr":"xzzjzzpg","explanation":"比喻说话和行动的真实意图别有所指。同“项庄舞剑，意在沛公”。","source":{"text":"盖项庄之剑，志在沛公，青岛之用兵，不在报德之前仇，非在履英之盟约，殆欲借端以树兵威于我大陆，作强暴要索之先声耳。","book":"李大钊《国民之薪胆》"},"example":{"text":"李大钊《国民之薪胆》：“盖～，青岛之用兵，不在报德之前仇，非在履英之盟约。”"},"similar":["项庄舞剑，意在沛公"],"usage":"作宾语、分句；指别有所图","story":["公元前208年，项羽率40万大军开往咸阳，被刘邦的守军挡住。项伯请刘邦到鸿门赴宴。刘邦到鸿门后，项羽设计让项庄舞剑助兴，意在乘机杀了刘邦。项伯也舞剑助兴，百般保护刘邦，刘邦手下樊哙冲进营帐来保护刘邦，刘邦借机逃离"]},{"id":46925,"word":"项庄舞剑","pinyin":"xiàng zhuāng wǔ jiàn","abbr":"xzwj","explanation":"比喻说话和行动的真实意图别有所指。同“项庄舞剑，意在沛公”","source":{"text":"［定兴］乃于署督篆任内，奏参银元局及淮山盐务，牵涉敝署，不无激射之词，论者谓为项庄舞剑，而弟因未尝稍存芥蒂也。","book":"清·刘坤一《致张香涛书》"},"example":{"text":"清·刘坤一《致张香涛书》：“不无激射之词，论者谓为～，而弟因未尝稍存芥蒂也。”"},"similar":["项庄舞剑，意在沛公"],"usage":"作宾语、定语；指别有所图","story":["公元前208年，项羽率40万大军开往咸阳，被刘邦的守军挡住。项伯请刘邦到鸿门赴宴。刘邦到鸿门后，项羽设计让项庄舞剑助兴，意在乘机杀了刘邦。项伯也舞剑助兴，百般保护刘邦，刘邦手下樊哙冲进营帐来保护刘邦，刘邦借机逃离"]},{"id":46926,"word":"项庄舞剑，志在沛公","pinyin":"xiàng zhuāng wǔ jiàn，zhì zài pèi gōng","abbr":"xzwjzzpg","explanation":"比喻说话和行动的真实意图别有所指。同“项庄舞剑，意在沛公”。","source":{"text":"在康有为之意，志在成名（余成名），如项庄舞剑，志在沛公，今见成名动也不动，已自愧悔。","book":"清·黄小配《大马扁》第四回"},"example":{"text":"《大马扁》第四回：“在康有为之意，志在成各，如～，今见成各也不动，已自愧悔。”"},"similar":["项庄之剑，志在沛公"],"usage":"作宾语、分句；指别有所图","story":["公元前208年，项羽率40万大军开往咸阳，被刘邦的守军挡住。项伯请刘邦到鸿门赴宴。刘邦到鸿门后，项羽设计让项庄舞剑助兴，意在乘机杀了刘邦。项伯也舞剑助兴，百般保护刘邦，刘邦手下樊哙冲进营帐来保护刘邦，刘邦借机逃离"]},{"id":46927,"word":"项庄舞剑，意在沛公","pinyin":"xiàng zhuāng wǔ jiàn，yì zài pèi gōng","abbr":"xzwjyzpg","explanation":"项庄席间舞剑，企图刺杀刘邦。比喻说话和行动的真实意图别有所指。","source":{"text":"今者项庄拔剑舞，其意常在沛公也。","book":"《史记·项羽本纪》"},"example":{"text":"在讨论会上，他的一番话却暗有所指，～。"},"similar":["项庄舞剑"],"usage":"作宾语、分句；指别有所图","story":["公元前208年，项羽率40万大军开往咸阳，被刘邦的守军挡住。项伯请刘邦到鸿门赴宴。刘邦到鸿门后，项羽设计让项庄舞剑助兴，意在乘机杀了刘邦。项伯也舞剑助兴，百般保护刘邦，刘邦手下樊哙冲进营帐来保护刘邦，刘邦借机逃离"]},{"id":46928,"word":"项背相望","pinyin":"xiàng bèi xiāng wàng","abbr":"xbxw","explanation":"项：颈项。原指前后相顾。后多形容行人拥挤，接连不断。","source":{"text":"监司项背相望，与同疾灰。","book":"《后汉书·左雄传》"},"example":{"text":"海内求文者，～，碑版之镌，照耀乎四方！（明·刘基《宋景濂学士文集序》）"},"usage":"作谓语、宾语、定语；形容行人拥挤"},{"id":46929,"word":"项领之功","pinyin":"xiàng lǐng zhī gōng","abbr":"xlzg","explanation":"项领：首要。指第一功。","source":{"text":"升之与君，有项领之功。令一言而二功俱解，岂愿闻之乎？","book":"《南史·孝义·乐预传》"}},{"id":46930,"word":"顺之者兴，逆之者亡","pinyin":"shùn zhī zhě xīng，nì zhī zhě wáng","abbr":"szzxnzzw","explanation":"指顺从天道的就生存，违背天道的则灭亡。同“顺之者昌，逆之者亡”。","source":{"text":"以万丈之气焰，磅礴冲击于全世界人人之脑中，顺之者兴，逆之者亡。","book":"梁启超《国家思想变迁异同论》"},"similar":["顺之者昌，逆之者亡"],"usage":"作宾语、定语、分句；用于处事"},{"id":46931,"word":"顺之者成，逆之者败","pinyin":"shùn zhī zhě chéng，nì zhī zhě bài","abbr":"szzcnzzb","explanation":"顺：顺从；成：成功；逆：违逆；败：失败。顺从他的就能成功，违逆他的必会失败。","source":{"text":"然区区鄙意，常窃以为画古今只是一体，顺之者成，逆之者败，固非古之圣贤所能独然。","book":"宋·朱熹《寄陈同甫书》"},"usage":"作宾语、定语、分句；用于书面语"},{"id":46932,"word":"顺之者昌，逆之者亡","pinyin":"shùn zhī zhě chāng，nì zhī zhě wáng","abbr":"szzcnzzw","explanation":"顺：顺从；昌：昌盛；逆：违背；亡：灭亡。顺从他的就可以存在和发展，违抗他的就叫你灭亡。形容剥削阶级的独裁统治。","source":{"text":"夫阴阳四时，八位，十二度，二十四节各有教令，顺之者昌，逆之者不死则亡。","book":"《史记·太史公自序》"},"example":{"text":"吴玉章《从甲午战争前后到辛亥革命前后的回忆》：“我深深地感到群众力量的伟大，真是～。”"},"similar":["顺之者兴，逆之者亡"],"usage":"作宾语、定语、分句；用于处事"},{"id":46933,"word":"顺人应天","pinyin":"shùn rén yìng tiān","abbr":"sryt","explanation":"应：适应，适合。顺应天命，合乎人心。旧时常用于颂扬建立新的朝代。","source":{"text":"天地革而四时成，汤武革命，顺乎天而应乎人，革之事大矣哉。","book":"《周易·革》"},"example":{"text":"元·杨梓《豫让吞炭》第四折：“岂不闻顺天者昌，逆天者亡，赵氏既昌，合当～，不宜苦苦直要报仇。”"},"similar":["顺天应人"],"usage":"作谓语、定语；常用于颂扬建立新的朝廷"},{"id":46934,"word":"顺人者昌，逆人者亡","pinyin":"shùn rén zhě chāng，nì rén zhě wáng","abbr":"srzcnrzw","explanation":"顺：顺从；昌：昌盛；逆：违背；亡：灭亡。顺应民众的就能兴旺，违逆民众的定要衰亡。","source":{"text":"夫圣人不以独见为明，而以万物为心。顺人者昌，逆人者亡，此古今之所共也。","book":"《后汉书·申屠刚传》"},"usage":"作宾语、定语；用于劝诫人"},{"id":46935,"word":"顺从其美","pinyin":"shùn cóng qí měi","abbr":"scqm","explanation":"顺从：随势相依从；美：好事，美德。顺势相助，成全美事。","source":{"text":"将顺其美，匡救其恶，故上下能相亲也。","book":"《孝经·事君》"},"example":{"text":"璟刚正，多所裁断，颋皆～，璟甚悦之。","book":"宋·王谠《唐语林·政事下》"},"similar":["将顺其美"],"usage":"作谓语、定语；用于处事"},{"id":46936,"word":"顺口开河","pinyin":"shùn kǒu kāi hé","abbr":"skkh","explanation":"犹言信口开河。不假深思，不负责任地随口乱说。","source":{"text":"我原来是私访，为何顺口开河？好不是东西！快些走罢。","book":"清·石玉昆《三侠五义》第十回"},"example":{"text":"吃了我的糖，到天上多说几句好话，别不三不四地～，瞎扯！","book":"老舍《正红旗下》一"},"similar":["信口开河","信口开合","信口开喝"],"usage":"作谓语、宾语、状语；指随口乱说"},{"id":46937,"word":"顺口溜","pinyin":"shùn kǒu liū","abbr":"skl","explanation":"民间的一种句子长短不等口头韵文。","source":{"text":"群众中广泛流传的几句顺口溜形象地概括了眼下的形势：上面放，下面望，中间有些顶门杠！","book":"路遥《平凡的世界》第三卷第六章"},"usage":"作主语、宾语、定语；用于语言等"},{"id":46938,"word":"顺口谈天","pinyin":"shùn kǒu tán tiān","abbr":"sktt","explanation":"指随便说话。","source":{"text":"听差原只顺口谈天，也说不出个所以然。","book":"朱自清《择偶记》"},"example":{"text":"听差原只～，也说不出个所以然。","book":"朱自清《择偶记》"},"usage":"作谓语、宾语、状语；指随口说说"},{"id":46939,"word":"顺天从人","pinyin":"shùn tiān cóng rén","abbr":"stcr","explanation":"顺应天命，合乎人心。旧时常用于颂扬建立新的朝代。同“顺天应人”。","source":{"text":"及嗣守大位，行其所闻，顺天从人，传授圣嗣。","book":"唐·韩愈《进表状》"},"similar":["顺天应人","顺人应天"],"usage":"作谓语、定语；常用于颂扬建立新的朝廷"},{"id":46940,"word":"顺天应人","pinyin":"shùn tiān yìng rén","abbr":"styr","explanation":"应：适应，适合。顺应天命，合乎人心。旧时常用于颂扬建立新的朝代。","source":{"text":"天地革而四时成，汤武革命，顺乎天而应乎人，革之事大矣哉。","book":"《周易·革》"},"example":{"text":"逮周文、武创业，～，诚信忠厚，加于百姓，德泽休泰，兴乎颂声。","book":"唐·陈子昂《谏政理书》"},"similar":["顺天从人","顺人应天"],"usage":"作谓语、定语；常用于颂扬建立新的朝廷"},{"id":46941,"word":"顺天应命","pinyin":"shùn tiān yìng mìng","abbr":"stym","explanation":"顺应天意，遵从天命。","source":{"text":"大君代天司命，君命即是天命，天命所在，便是条意外的岔路，顺天应命，安知非福。","book":"清·文康《儿女英雄传》第四十回"},"usage":"作谓语、定语；用于处事"},{"id":46942,"word":"顺天应时","pinyin":"shùn tiān yìng shí","abbr":"stys","explanation":"顺：顺从；应：适应。指上遵天命，下合时机。","source":{"text":"先帝顺天应时，西平巴蜀，南和吴会，海内得以休息，兆庶有乐安之心。","book":"《晋书·羊祜传》"},"example":{"text":"钱钟书《围城》：“后间隔为两间暗不见日、漏雨透风、夏暖冬凉、～的客房。”"},"usage":"作谓语、定语、宾语；用于处事"},{"id":46943,"word":"顺天恤民","pinyin":"shùn tiān xù mín","abbr":"stxm","explanation":"顺应天意，体恤民众。","source":{"text":"朕与单于俱由此道，顺天恤民，世世相传，施之无穷，天下莫不咸嘉。","book":"《汉书·匈奴传》"},"usage":"作谓语、定语；用于处事"},{"id":46944,"word":"顺天者存，逆天者亡","pinyin":"shùn tiān zhě cún，nì tiān zhě wáng","abbr":"stzcntzw","explanation":"指顺从天道的就生存，违背天道的则灭亡。","source":{"text":"天下有道，小德役大德，小贤役大贤；天下无道，小役大，弱役强，斯二者，天也。顺天者存，逆天者亡","book":"《孟子·离娄上》"},"example":{"text":"～。今吾周凤鸣岐山，英雄间出，豪杰归心，道兄何得逆天而行，任一己私意哉。","book":"明·许仲琳《封神演义》第五十八回"},"similar":["顺天者昌，逆天者亡"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":46945,"word":"顺天者昌，逆天者亡","pinyin":"shùn tiān zhě chāng，nì tiān zhě wáng","abbr":"stzcntzw","explanation":"指顺从天道的就生存，违背天道的则灭亡。同“顺天者存，逆天者亡”","source":{"text":"岂不闻顺天者昌，逆天者亡，赵氏既昌，合当顺人应天，不宜苦苦直要报仇。","book":"元·杨梓《豫让吞炭》第四折"},"example":{"text":"明·许仲琳《封神演义》第56回：“我思：‘～。’不若归周，共享安康，以伐无道。”"},"similar":["顺天者存，逆天者亡"],"usage":"作宾语、定语、分句；用于劝诫人"},{"id":46946,"word":"顺天者逸，逆天者劳","pinyin":"shùn tiān zhě yì，nì tiān zhě láo","abbr":"stzyntzl","explanation":"顺：顺从；天：天意；逸：安乐；劳：劳苦。指顺应天理的就能得到安乐，违背天理的就要受到苦劳。","source":{"text":"岂不闻顺天者逸，逆天者劳；数之所在，理不得而夺之；命之所在，人不得而强之乎？","book":"明·罗贯中《三国演义》第三十七回"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":46947,"word":"顺德者吉，逆天者凶","pinyin":"shùn dé zhě jí，nì tiān zhě xiōng","abbr":"sdzjntzx","explanation":"顺：依顺；吉：吉利；逆：违逆；凶：凶祸。依顺符合道德的就可以得到吉利，违背天意就必然遭到凶祸。","source":{"text":"你道顺德者吉，逆天者凶，我怎肯二意三心，背义忘恩，有始无终。","book":"元·杨梓《豫让吞炭》第四折"},"usage":"作宾语、定语、分句；用于处世等"},{"id":46948,"word":"顺德者昌，逆德者亡","pinyin":"shùn dé zhě chāng，nì dé zhě wáng","abbr":"sdzcndzw","explanation":"符合道德的就可以昌盛，违逆道德的就遭到灭亡。","source":{"text":"臣闻顺德者昌，逆德者亡，兵出无名，事故不成。","book":"《汉书·高帝纪》"},"example":{"text":"～，欲一天下，当顺民心。","book":"明·朱鼎《玉镜台记·石勒称王》"},"similar":["顺道者昌，逆德者亡"],"usage":"作宾语、定语、分句；用于处世等"},{"id":46949,"word":"顺我者吉，逆我者衰","pinyin":"shùn wǒ zhě jí，nì wǒ zhě shuāi","abbr":"swzjnwzs","explanation":"顺：顺从；吉：吉利；逆：违逆；衰：衰败。顺从我的就会吉利，违背我的就会衰亡。","source":{"text":"承玄步虚，上蹑玉机，衣斗履斗，流铃焕威，顺我者吉，逆我者衰，我行天真，万里廓开。","book":"宋·张君房《云笈七签》第20卷"},"similar":["顺我者昌，逆我者亡"],"usage":"作宾语、定语、分句；用于处事"},{"id":46950,"word":"顺我者昌，逆我者亡","pinyin":"shùn wǒ zhě chāng，nì wǒ zhě wáng","abbr":"swzcnwzw","explanation":"顺：顺从；昌：昌盛；逆：违背；亡：灭亡。顺从我的就可以存在和发展，违抗我的就叫你灭亡。形容剥削阶级的独裁统治。","source":{"text":"顺吾意则生，逆吾心则死。","book":"《庄子·盗跖》"},"example":{"text":"在她控制的文艺阵地，疯狂地实行“～”的法西斯统治。","book":"周立波《一个伟大文献的诞生》"},"similar":["顺昌逆亡","顺我者生，逆我者死"],"usage":"作定语、分句；指独裁统治"},{"id":46951,"word":"顺我者生，逆我者死","pinyin":"shùn wǒ zhě shēng，nì wǒ zhě sǐ","abbr":"swzsnwzs","explanation":"顺从我的心意才能生存，违抗我的心意就要灭亡。","source":{"text":"顺吾意则生，逆吾意则死。","book":"语出《庄子·盗跖》"},"example":{"text":"聂绀弩《兔先生的发言》：“这些头等角色，摆着～的狰狞面目。”"},"similar":["顺我者昌，逆我者亡"],"usage":"作宾语、定语、分句；用于处事"},{"id":46952,"word":"顺手人情","pinyin":"shùn shǒu rén qíng","abbr":"ssrq","explanation":"乘方便的时机，捎带着给人做好事。"},{"id":46953,"word":"顺手牵羊","pinyin":"shùn shǒu qiān yáng","abbr":"ssqy","explanation":"顺手把人家的羊牵走。比喻趁势将敌手捉住或乘机利用别人。现比喻乘机拿走别人的东西。","source":{"text":"效马效羊者右牵之。","book":"《礼记·曲礼上》"},"example":{"text":"据说座山雕的部下有个～的老方子，一撮毛可能是想施展这个伎俩。","book":"曲波《林海雪原》十二"},"similar":["信手拈来"],"opposite":["困难至极"],"usage":"作谓语、定语、状语；指顺便行事","story":["梁山泊好汉们在宋江的带领下打败辽国的入侵，又奉命清剿河北的田虎暴动。在清剿的过程中，田虎的大将马灵会巫术，被公孙胜破解。马灵如飞逃去，戴宗作法也追不上。恰好碰到花和尚鲁智深，一禅杖把马灵打倒，顺手牵羊把他捆了交戴宗看押"]},{"id":46954,"word":"顺时施宜","pinyin":"shùn shí shī yí","abbr":"sssy","explanation":"顺应不同时势而灵活地采取相应措施。","source":{"text":"王者必因前王之礼，顺时施宜，有所损益，即民之心，稍稍制作，至太平而大备。","book":"《汉书·礼乐志》"},"usage":"作谓语、定语；用于书面语"},{"id":46955,"word":"顺时而动","pinyin":"shùn shí ér dòng","abbr":"ssed","explanation":"顺应时势而行动。","source":{"text":"度德而处，量力而行之，相时而动，无累后人。","book":"春秋·鲁·左丘明《左传·隐公十一年》"},"example":{"text":"～，用晦而明。","book":"唐·王勃《益州夫子庙碑》"},"similar":["顺势而行"],"usage":"作谓语；指顺应时势而行动"},{"id":46956,"word":"顺时随俗","pinyin":"shùn shí suí sú","abbr":"ssss","explanation":"顺应时势，随从习俗。","source":{"text":"察乃博引经籍，独违群议……其不顺时随俗，皆此类也。","book":"《陈书·姚察传》"},"similar":["入乡随俗"],"usage":"作谓语、定语、宾语；用于处事"},{"id":46957,"word":"顺比滑泽","pinyin":"shùn bǐ huá zé","abbr":"sbhz","explanation":"顺比：顺着别人的意思；滑泽：言语圆滑。用圆滑的语言，顺着人家的意思说。","source":{"text":"所以难言者，言顺比滑泽，洋洋纚纚然，则见以为华而不实。","book":"《韩非子·难言》"}},{"id":46958,"word":"顺水人情","pinyin":"shùn shuǐ rén qíng","abbr":"ssrq","explanation":"利用机会顺便给人的好处。也指不费力的人情。","source":{"text":"守将和军卒都受了贿赂，落得做个顺水人情。","book":"明·冯梦龙《东周列国志》第九十九回"},"example":{"text":"好在他匿丧与我们无干，我们乐得答应他，做个～，彼此有益。","book":"清·李宝嘉《官场现形记》第四十回"},"similar":["顺手人情","借花献佛"],"opposite":["诚心诚意"],"usage":"作宾语；指不费力的人情"},{"id":46959,"word":"顺水推舟","pinyin":"shùn shuǐ tuī zhōu","abbr":"sstz","explanation":"顺着水流的方向推船。比喻顺着某个趋势或某种方便说话办事。","source":{"text":"天地也做得个怕硬欺软，却原来也这般顺水推船。","book":"元·关汉《窦娥冤》第三折"},"example":{"text":"他若留我，乐得～。","book":"清·李宝嘉《官场现形记》第十回"},"similar":["因势利导","趁风使舵","顺水推船"],"opposite":["横生枝节","节外生枝"],"usage":"作谓语、宾语；指顺便行事"},{"id":46960,"word":"顺水推船","pinyin":"shùn shuǐ tuī chuán","abbr":"sstc","explanation":"顺着水流的方向推船。比喻顺着某个趋势或某种方便说话办事。","source":{"text":"天地也做得个怕硬欺软，却原来也这般顺水推船。","book":"元·关汉卿《窦娥冤》第三折"},"example":{"text":"欧阳山《苦斗》：“何贵听了周炳的话，就～地说：‘世界上的事儿呢……’”"},"similar":["顺水放船","顺水推舟","顺水行舟"],"opposite":["横生枝节"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":46961,"word":"顺水放船","pinyin":"shùn shuǐ fàng chuán","abbr":"ssfc","explanation":"比喻顺应当时的情势，采取相应的行动。","source":{"text":"万用自然，不劳心力。到这里唤作顺水放船，且道逆风兴楫，谁是好手？","book":"宋·释普济《五灯会元·石霜圆禅师法嗣·大宁道宽禅师》"},"similar":["顺水推船"],"usage":"作宾语、定语；用于比喻句"},{"id":46962,"word":"顺水行舟","pinyin":"shùn shuǐ xíng zhōu","abbr":"ssxz","explanation":"顺着水流的方向行船。比喻顺应情势说话行事。","source":{"text":"小的闻得老爷补升此任，亦系贾府王府之力，此薛蟠即贾府之亲，老爷何不顺水行舟，作个整人情，将此案了结，日后也好去见贾府王府。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"这男女二家，便～，不费推移之力。","book":"清·李绿园《歧路灯》第一○七回"},"similar":["顺水推船","顺水行舟","顺水推舟"],"opposite":["横生枝节"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":46963,"word":"顺水行船","pinyin":"shùn shuǐ xíng chuán","abbr":"ssxc","explanation":"顺着水流的方向行船。比喻顺应情势说话行事。","source":{"text":"原来两人商议就一路，也有个打发老厌物的意思，趁这个机会，正好顺水行船，试试这药灵不灵。","book":"清·丁耀亢《续金瓶梅》第三十二回"}},{"id":46964,"word":"顺水顺风","pinyin":"shùn shuǐ shùn fēng","abbr":"sssf","explanation":"比喻运气好，做事顺利，没有阻碍。","source":{"text":"唐淑贞只有一年多的实际经验，而且是一条枪的，自此下手以来，一直是顺水顺风。","book":"李劼人《天魔舞》第26章"},"usage":"作谓语、定语；用于口语"},{"id":46965,"word":"顺流而下","pinyin":"shùn liú ér xià","abbr":"slex","explanation":"顺着河流的方向一直下去。形容毫无阻碍。","source":{"text":"竺领命，驾小舟顺流而下，迳至周瑜大寨前。","book":"明·罗贯中《三国演义》第四十五回"},"example":{"text":"宋子英便叫水手开船，水手们答应一声，抽起跳板把船拦开，点了一篙，那船便～。","book":"清·张春帆《九尾龟》第六十回"}},{"id":46966,"word":"顺理成章","pinyin":"shùn lǐ chéng zhāng","abbr":"slcz","explanation":"顺：依顺；理：条理；章：章法。指写文章或做事情顺着条理就能做好。也比喻某种情况自然产生某种结果。","source":{"text":"文者，顺理而成章之谓。","book":"《朱子全书》"},"example":{"text":"事情这样做～，既解决了问题，又受到群众的拥护。"},"similar":["水到渠成","马到成功"],"opposite":["颠三倒四","语无伦次"],"usage":"作谓语、宾语、定语；指水到渠成"},{"id":46967,"word":"顺美匡恶","pinyin":"shùn měi kuāng è","abbr":"smke","explanation":"歌颂美善，纠正过失。","source":{"text":"子曰：君子之事上也，进思尽忠，退思补过，将顺其美，匡救其恶。","book":"《孝经·事君》"},"example":{"text":"太康败德，五子咸怨；～，其来久矣。","book":"南朝·梁·刘勰《文心雕龙·明诗》"},"usage":"作谓语；指歌颂美善，纠正过失"},{"id":46968,"word":"顺耳悦目","pinyin":"shùn ěr yuè mù","abbr":"seym","explanation":"顺耳：合乎心意，听着舒服；悦：好看。听着舒服，看着好看。指言行迎合人的心意。","source":{"text":"趋求顺耳悦目，随阿遂指，不图远虑为国深计故也。","book":"《三国志·蜀志·法正传》"}},{"id":46969,"word":"顺蔓摸瓜","pinyin":"shùn màn mō guā","abbr":"smmg","explanation":"比喻按照某个线索查究事情。同“顺藤摸瓜”。","source":{"text":"依我看，我们现在应该抓紧，但不要去惊扰他，同时可以顺蔓摸瓜，最后弄清楚情况。","book":"王士美《铁旋风》第一部第六章"},"example":{"text":"我看还是～为好"},"similar":["顺藤摸瓜"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46970,"word":"顺藤摸瓜","pinyin":"shùn téng mō guā","abbr":"stmg","explanation":"摸：寻找。比喻按照某个线索查究事情。","source":{"text":"由此顺藤摸瓜，很快破获了这起盗窃案。","book":"《人民日报》1982.6.30"},"example":{"text":"我们～，终于发现一大秘密。"},"similar":["顺藤摘瓜"],"opposite":["缘木求鱼"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46971,"word":"顺过饰非","pinyin":"shùn guò shì fēi","abbr":"sgsf","explanation":"指徇私迁就而掩饰错误。","source":{"text":"忠辅于《易》粗窥大衍之旨，创立日法，撰演新历，不敢以言者，诚惧太史顺过饰非。","book":"《宋史·律历志》"},"usage":"作谓语、定语；用于处事"},{"id":46972,"word":"顺道者昌，逆德者亡","pinyin":"shùn dào zhě chāng，nì dé zhě wáng","abbr":"sdzcndzw","explanation":"符合道德的就可以昌盛，违逆道德的就遭到灭亡。同“顺德者昌，逆德者亡”。","source":{"text":"古人有言‘顺道者昌，逆德者亡’。","book":"晋·司马彪《战略》"},"similar":["顺德者昌，逆德者亡"],"usage":"作宾语、定语、分句；用于处世等"},{"id":46973,"word":"顺非而泽","pinyin":"shùn fēi ér zé","abbr":"sfez","explanation":"顺从错误言行且加以润饰。","source":{"text":"人有恶者五，而盗窃不与焉；一曰心达有险，二曰行辟而坚，三曰言伪为辨，四曰记丑而博，五曰顺非而泽。","book":"《荀子·宥坐》"},"example":{"text":"少正卯也是闻人，徒以“心逆而险，行僻而坚，言伪而辩，记丑而博，～”，不免孔子之诛。姚雪垠《李自成》第二卷第三十二章）"},"usage":"作谓语、定语；用于处事"},{"id":46974,"word":"顺顺利利","pinyin":"shùn shùn lì lì","abbr":"ssll","explanation":"指做事十分顺当，没有遇到任何阻碍和困难","source":{"text":"但陌生的人光靠几句指点，却无论如何休想顺顺利利地走出门去。","book":"清·无垢道人《八仙全传》第13回"},"similar":["顺顺当当"],"opposite":["百折千回","千难万阻"],"usage":"作定语、状语；用于处事"},{"id":46975,"word":"顺顺当当","pinyin":"shùn shùn dàng dàng","abbr":"ssdd","explanation":"指十分顺利，没挫折。","source":{"text":"但她不是心里一点波澜不起就顺顺当当接受下来、适应过来的。","book":"王朔《空中小姐》"},"similar":["顺顺利利"],"usage":"作定语、状语；用于处事等"},{"id":46976,"word":"顺风人情","pinyin":"shùn fēng rén qíng","abbr":"sfrq","explanation":"利用机会顺便给人的好处。也指不费力的人情。","source":{"text":"守将和军卒都受了贿赂，落得做个顺水人情。","book":"明·冯梦龙《东周列国志》第九十九回"},"example":{"text":"现在他借我的李团同行，我正可教李团在前方监视，乐得做个～。","book":"蔡东藩、许廑父《民国通俗演义》第一百五十五回"}},{"id":46977,"word":"顺风使帆","pinyin":"shùn fēng shǐ fān","abbr":"sfsf","explanation":"顺着风势扯帆行船。比喻趁着有利的情势行事。","source":{"text":"大丈夫磊磊落落，当用处把定，立处皆真。顺风使帆，上下水皆可。因斋庆赞，去留自在。","book":"宋·释普济《五灯会元》卷二十"},"example":{"text":"于是神宗～，竟将许国等原疏，及时行密揭，一并颁发出来。","book":"蔡东藩《明史演义》第七十五回"},"similar":["顺风扯帆","顺风张帆","顺风使舵"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46978,"word":"顺风使舵","pinyin":"shùn fēng shǐ duò","abbr":"sfsd","explanation":"比喻顺着情势改变态度（含贬义）。同“顺风转舵”。","source":{"text":"来一个委曲求全、顺风使舵呢？这真是左右为难的事儿。","book":"浩然《艳阳天》第三部第123章"},"similar":["见风使舵","顺风转舵","见机行事"],"usage":"作谓语、宾语；指借机行事"},{"id":46979,"word":"顺风使船","pinyin":"shùn fēng shǐ chuán","abbr":"sfsc","explanation":"顺着风势驾船。比喻趁着有利条件做事，容易成功。也指借机行事。","source":{"text":"但是凡那下坡走马顺风使船以至买好名儿戴高帽儿的那些营生我都不会作。","book":"清·文康《儿女英雄传》第八回"},"similar":["人云亦云","顺风驶船"],"usage":"作谓语、宾语；指借机行事"},{"id":46980,"word":"顺风吹火","pinyin":"shùn fēng chuī huǒ","abbr":"sfch","explanation":"比喻乘便行事，并不费力。","source":{"text":"顺风吹火，幸附骥尾，易为功力，因权受福。","book":"汉·焦赣《易林·井之临》"},"example":{"text":"我虽叨在宦途，要举荐你广游大人门下，不过～，不为难事。","book":"《石点头·感恩鬼三古传题旨》"},"similar":["举手之劳","轻而易举"],"usage":"作谓语、定语；指因势乘便行事"},{"id":46981,"word":"顺风张帆","pinyin":"shùn fēng zhāng fān","abbr":"sfzf","explanation":"比喻趁着有利的情势行事。同“顺风使帆”。","source":{"text":"看文字，当如高舟我大艑，顺风张帆，一日千里，方得。","book":"宋·朱熹《朱子语类》第十卷"},"example":{"text":"我们～，组织一场大讨论"},"similar":["顺风扯帆","顺风使帆","见风使舵"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46982,"word":"顺风扯帆","pinyin":"shùn fēng chě fān","abbr":"sfcf","explanation":"比喻顺应趋势办事。","source":{"text":"把祸事全推到他这个小‘先锋’脑壳上，又听李克口气，分明晓得了他们背后的阴谋知道不赶快顺风扯帆不行。","book":"克非《春潮急》"},"example":{"text":"他马上～，组织群众抗震救灾"},"similar":["顺风使帆","见风使舵","顺风使舵"],"usage":"作谓语、宾语、定语；用于处事"},{"id":46983,"word":"顺风扯旗","pinyin":"shùn fēng chě qí","abbr":"sfcq","explanation":"顺着风向扯起旗子。比喻因势乘便行事。","example":{"text":"我喜欢干～的事。"},"similar":["扯顺风旗","因势乘便"],"usage":"作谓语、定语；指因势乘便"},{"id":46984,"word":"顺风而呼","pinyin":"shùn fēng ér hū","abbr":"sfeh","explanation":"顺着风向呼喊，声音传得远，使人听得清。比喻凭借外力可有较好效果。","source":{"text":"登高而招，臂非加长也，而见者远；顺风而呼，声非加疾也，而闻者彰。","book":"战国·赵·荀况《荀子·劝学》"},"example":{"text":"比如～，其势激也。","book":"西汉·司马迁《史记·游侠列传》"},"similar":["顺风扯旗"],"usage":"作谓语、宾语；指顺势而为"},{"id":46985,"word":"顺风行船","pinyin":"shùn fēng xíng chuán","abbr":"sfxc","explanation":"顺着风势行船。比喻趁着有利情势做事，用力小而收效大。","source":{"text":"如今的人眼明手快，捷足高才，遇着世事，如顺风行船，不劳余力。","book":"《豆棚闲话·空青石蔚子开盲》"},"similar":["顺风驶船","顺风使帆","顺风张帆"],"usage":"作谓语、宾语；指借机行事"},{"id":46986,"word":"顺风转舵","pinyin":"shùn fēng zhuǎn duò","abbr":"sfzd","explanation":"随着风向转换舵位。比喻顺着情势改变态度（含贬义）。","source":{"text":"则你这媒人一个个，啜人口似蜜钵，都只是随风倒舵，索媒钱赚少争多。","book":"元·无名氏《桃花女》第二折"},"example":{"text":"于是民族主义文学家也只好～，改为对于这事件的啼哭、叫喊了。","book":"鲁迅《且介亭杂文·中国文坛上的鬼魅》"},"similar":["见风使舵","见机行事","顺风使舵"],"usage":"作谓语、宾语；指借机行事"},{"id":46987,"word":"顺风驶船","pinyin":"shùn fēng shǐ chuán","abbr":"sfsc","explanation":"比喻自己没有主意，跟着别人说话或办事。","source":{"text":"我这个人虽是个多事的人，但是凡那下坡走马，顺风驶船，以至买好名儿、戴高帽儿的那些营生，我都不会作。","book":"清·文康《儿女英雄传》第八回"},"similar":["顺风使船","顺风行船","顺风转舵"],"usage":"作谓语、宾语；指借机行事"},{"id":46988,"word":"须发皆白","pinyin":"xū fà jiē bái","abbr":"xfjb","explanation":"胡须头发全都白了。指年事以高。","source":{"text":"那太公年近六旬之上，须发皆白，头戴遮尘暖帽，身穿直缝宽衫，腰系皂丝绦，足穿熟皮靴。","book":"明·施耐庵《水浒传》第二回"}},{"id":46989,"word":"须弥芥子","pinyin":"xū mí jiè zǐ","abbr":"xmjz","explanation":"意思是偌大一个须弥山塞进一粒小小的菜籽之中刚刚合适。形容佛法无边，神通广大。也形容诗文波诡变幻，才思出众。","source":{"text":"若菩萨住是解脱者，以须弥之高广，内芥子中，无所增减。","book":"《维摩经不思议品》"},"example":{"text":"休说～，看取鹃鹏斥鷃，小大若为同。","book":"宋·辛弃疾《水调歌头·题永丰杨少游提点一枝堂》"},"usage":"作宾语、定语；用于书面语"},{"id":46990,"word":"须弥黍米","pinyin":"xū mí shǔ mǐ","abbr":"xmsm","explanation":"意思是偌大一个须弥山塞进一粒小小的米粒之中刚刚合适。形容佛法无边，神通广大。也形容诗文波诡变幻，才思出众。","source":{"text":"法王自在，置世界于微尘，纳须弥于黍米。","book":"《维摩经不思议品》：“若菩萨住是解脱者，以须弥之高广，内芥子中，无所增减。”《北齐书·文苑传·樊逊》"}},{"id":46991,"word":"须眉交白","pinyin":"xū méi jiāo bái","abbr":"xmjb","explanation":"交：都。胡须和眉毛都白了。","source":{"text":"有渔父者下船而来，须眉交白，被发揄袂。","book":"《庄子·渔父》"},"usage":"作谓语、定语；形容年老"},{"id":46992,"word":"须眉巾帼","pinyin":"xū méi jīn guó","abbr":"xmjg","explanation":"须眉：胡须和眉毛，借指男子汉，大丈夫；巾帼：古代妇女配戴的头巾和发饰，后借指妇女。具有男子汉气慨的女子。","source":{"text":"如僕者，亦岂须眉而巾帼者哉？","book":"清·沈起凤《谐鳏·巾帼暮宾》"},"example":{"text":"放毫谁写长松图？～南海何。","book":"柳亚子《长松山房歌》"},"similar":["巾帼英雄","巾帼须眉"],"usage":"作宾语、定语；用于女性"},{"id":46993,"word":"须眉毕现","pinyin":"xū méi bì xiàn","abbr":"xmbx","explanation":"现：显现，显露。形容作品中人物的刻画传神而逼真。","source":{"text":"设科之嬉笑怒骂，如白描人物，须眉毕现，引人入胜者，全借乎此。","book":"清·孔尚任《桃花扇·凡例》"}},{"id":46994,"word":"须眉男子","pinyin":"xū méi nán zǐ","abbr":"xmnz","explanation":"须眉：胡须和眉毛。古时男子以须、眉长得稠密为美。指堂堂的男子汉。","source":{"text":"丫环之中，尚有全忠全孝顶天立地之人，何况须眉男子。","book":"明·周楫《西湖二集·侠女散财殉节》"},"example":{"text":"临事作为，却又有才有胆，赛过～。","book":"明·名教中人《好逑传》第三回"},"usage":"作宾语、定语；用于书面语"},{"id":46995,"word":"须眉皓然","pinyin":"xū méi hào rán","abbr":"xmhr","explanation":"胡须眉毛都白了。形容年老。","source":{"text":"俄而有一老人，须眉皓然，身长七尺，褐裘韦带，从二青衣而出。","book":"唐·薛渔思《河东记·韦丹》"},"example":{"text":"唐·薛渔思《河东记·韦丹》：“俄而有一老人，～，身长七尺，褐裘韦带。”"},"usage":"作谓语、定语；用于老年人"},{"id":46996,"word":"须臾之间","pinyin":"xū yú zhī jiān","abbr":"xyzj","explanation":"须臾：片刻。指极短的时间。","source":{"text":"须臾之间，只见那些不中选的诗，纷纷的飘下楼来。","book":"清·褚人获《隋唐演义》第76回"},"example":{"text":"清·褚人获《隋唐演义》第76回：“～，只见那些不中选的诗，纷纷的飘下楼来。”"},"similar":["顷刻之间"],"usage":"作宾语、状语；指很短的时间"},{"id":46997,"word":"须髯如戟","pinyin":"xū rán rú jǐ","abbr":"xrrj","explanation":"髯：两颊上的胡子。戟：古代的一种兵器，长杆头上附有月牙状的利刃。胡须又长又硬，一根根像戟似的怒张着。旧时形容丈夫气概。","source":{"text":"君须髯如戟，何无丈夫意？","book":"《南史·褚彦回传》"},"example":{"text":"柳亚子《别谢一超、蓝奋才、袁嘉猷、连贯》：“～头颅贱，涉水登山愧友生。”"},"similar":["紫髯如戟","苍髯如戟"],"usage":"作谓语、定语；用于书面语"},{"id":46998,"word":"须髯若神","pinyin":"xu ran ruo sheng","abbr":"xrrs","explanation":"指胡须长得很美，如同神人。"},{"id":46999,"word":"顽冥不灵","pinyin":"wán míng bù líng","abbr":"wmbl","explanation":"顽冥：愚钝无知；不灵：不聪明。形容愚昧无知。","source":{"text":"不然则是鳄鱼冥顽不灵，刺史虽有言，不闻不知也。","book":"唐·韩愈《祭鳄鱼文》"},"example":{"text":"这人想是～，也不晓得宗师的美意。","book":"清·西周生《醒世姻缘传》第三十九回"}},{"id":47000,"word":"顽固不化","pinyin":"wán gù bù huà","abbr":"wgbh","explanation":"化：改变。坚持错误，不肯改悔。","source":{"text":"卑府从前在那府里，也做过一任知县，地方上的百姓，极其顽固不化。","book":"清·李宝嘉《文明小史》第六回"},"example":{"text":"说我～，为游击主义翻案；蔑视中央，搅乱军心等待。","book":"梁信《从奴隶到将军》上集第六章"},"similar":["墨守陈规"],"opposite":["迷途知返"],"usage":"作谓语、定语；指不知变通"},{"id":47001,"word":"顽固堡垒","pinyin":"wán gù bǎo lěi","abbr":"wgbl","explanation":"比喻顽固不化的人。","example":{"text":"你放心，我一定攻克他这个～。"},"usage":"作主语、宾语；指不知变通的人"},{"id":47002,"word":"顽廉懦立","pinyin":"wán lián nuò lì","abbr":"wlnl","explanation":"使贪婪的人能够廉洁，使怯弱的人能够自立。旧时形容感化力量之大。","source":{"text":"故闻伯夷之风者，顽夫廉，懦夫有立志。","book":"战国·邹·孟轲《孟子·万章下》"},"example":{"text":"这些烈士的壮烈行为同时也使我们～，把我们的士气和民气，愈见鼓舞。","book":"郭沫若《羽书集·抗战与觉悟》"},"similar":["廉顽立懦"],"usage":"作谓语；指教育等"},{"id":47003,"word":"顽梗不化","pinyin":"wán gěng bù huà","abbr":"wgbh","explanation":"形容非常顽固而不知变通。","source":{"text":"你往年同严仲子做过朋友，他的顽梗不化，你是明白的。","book":"郭沫若《棠棣之花》第三幕第一场"},"example":{"text":"我讨厌那～的人。"},"similar":["顽固不化"],"usage":"作谓语、定语、宾语；指不知变通"},{"id":47004,"word":"顽父嚚母","pinyin":"wán fù yín mǔ","abbr":"wfym","explanation":"指愚顽暴虐的家长。","source":{"text":"父顽，母嚚，象傲。","book":"《尚书·尧典》"},"example":{"text":"有本领，遇着贤父兄自然不必说，便遇着～，也可以渐渐劝化。","book":"清·颐琐《黄绣球》第23回"},"usage":"作主语、宾语；指愚顽暴虐的家长"},{"id":47005,"word":"顽皮贼骨","pinyin":"wán pí zéi gǔ","abbr":"wpzg","explanation":"指品行不端，无赖狡诈的人。","source":{"text":"这顽皮贼骨，不打不招。左右，与我采下去，着实打呀！","book":"元·李行道《灰阑记》第二折"},"example":{"text":"咱和你又无甚别仇隙，怎这般狠布摆，领着火～浑无赖，也不问个朱楼画壁谁家界，霎时间早雕栏玉砌都安在。","book":"元·无名氏《谢金吾》第一折"},"similar":["顽皮赖肉","顽皮赖骨"],"usage":"作宾语、定语；用于书面语"},{"id":47006,"word":"顽皮赖肉","pinyin":"wán pí lài ròu","abbr":"wplr","explanation":"指品行不端、无赖狡诈。也指品行不端、无赖狡诈的人。同“顽皮赖骨”。","source":{"text":"掤、扒、吊、拷，备受苦楚，这些顽皮赖肉只不肯招。","book":"明·凌濛初《二刻拍案惊奇》卷五"},"similar":["顽皮赖骨","顽皮贼骨"],"usage":"作宾语、定语；用于书面语"},{"id":47007,"word":"顽皮赖骨","pinyin":"wán pí lài gǔ","abbr":"wplg","explanation":"①指品行不端、无赖狡诈。②指品行不端、无赖狡诈的人。","source":{"text":"这样顽皮赖骨，私下问他如何肯说？","book":"《京本通俗小说·错斩崔宁》：“你这等顽皮赖骨，不打如何肯招？”明·凌濛初《二刻拍案惊奇》卷二十五"},"example":{"text":"这个～，不打如何肯招！","book":"明·施耐庵《水浒传》第六十二回"},"similar":["顽皮赖肉","顽皮贼骨"],"usage":"作宾语、定语；用于书面语"},{"id":47008,"word":"顽石点头","pinyin":"wán shí diǎn tóu","abbr":"wsdt","explanation":"顽石：无知觉的石头。连无知觉的石头都点头认可。形容道理说得透彻，使人心服。","source":{"text":"竺道生入虎丘山，聚石为徒，讲《涅槃经》，群石皆点头。","book":"晋·无名氏《莲社高贤传·道生法师》"},"example":{"text":"文相公这一番议论，真可使～，胜如药饵百倍，了缘师之病，大约可以霍然矣。","book":"清·夏敬渠《野叟曝言》第十一回"},"opposite":["顽固不化"],"usage":"作宾语、定语；指说服力强，使人心服","story":["传说道生法师被师父逐出，回到南方，住到虎丘山的寺庙里，终日为石头讲《涅槃经》，讲到精彩处，就问石头通佛性不？群石都为此点头示意。围观者将这一奇迹传扬开去，不到十天拜他为师的人越来越多"]},{"id":47009,"word":"顽钝固执","pinyin":"wán dùn gù zhí","abbr":"wdgz","explanation":"顽：顽固；钝：迟钝。愚昧而又坚持成见。","source":{"text":"顽钝固执之辈，乃持天圆地方之说，以与人争。","book":"清·吴趼人《俏皮话·地方》"}},{"id":47010,"word":"顽铁生光","pinyin":"wán tiě shēng guāng","abbr":"wtsg","explanation":"清·褚人获《隋唐演义》第十四回：“俗语道得好：运去黄金减价，时来顽铁生光。”","example":{"text":"只要你有真才实学，就会有～的时候"},"similar":["顽铁生辉"],"usage":"作宾语、定语；用于比喻句"},{"id":47011,"word":"顽铁生辉","pinyin":"wán tiě shēng huī","abbr":"wtsh","explanation":"顽铁：铁块。铁块发同了光辉。比喻人遇到了好时机，境况发生了出人意料的变化。","source":{"text":"运退黄金失色，时来顽铁生辉。","book":"明·凌濛初《初刻拍案惊奇》卷一"},"similar":["顽铁生光"],"usage":"作宾语、定语；用于比喻句"},{"id":47012,"word":"顾三不顾四","pinyin":"gù sān bù gù sì","abbr":"gsbgs","explanation":"只顾这一面，不顾那一面。","source":{"text":"以后可还再顾三不顾四的不了？以后还单听叔叔的话，不听婶娘的话不了？","book":"清·曹雪芹《红楼梦》第六十八回"},"similar":["顾此失彼"],"usage":"作谓语、定语；指顾此失彼"},{"id":47013,"word":"顾全大局","pinyin":"gù quán dà jú","abbr":"gqdj","explanation":"指从整体的利益着想，使不遭受损害。","source":{"text":"然而要顾全大局呢，也有个无可奈何的时候；到了无可奈何的时候，就不能不自己开解自己。","book":"清·吴趼人《二十年目睹之怪现状》第九十一回"},"example":{"text":"倘若东林、复社两党的朋友，能够～，解除纠纷，也未尝不可一变士林的风气。","book":"欧阳予倩《桃花扇》第一幕"},"similar":["顾大局，识大体"],"usage":"作分句；指从整体的利益着想"},{"id":47014,"word":"顾内之忧","pinyin":"gù nèi zhī yōu","abbr":"gnzy","explanation":"顾：照管，照顾。指对后方的忧虑、担心。","source":{"text":"赏厚则人无顾内之忧，恩深则士有效死之志。","book":"《宋史·李处耘传》"},"similar":["后顾之忧"],"usage":"作宾语；指后方的忧患"},{"id":47015,"word":"顾前不顾后","pinyin":"gù qián bù gù hòu","abbr":"gqbgh","explanation":"只顾及前面而忘了后面。形容做事或考虑事不仔细周到。","source":{"text":"明日你自己当家立业，难道也这么顾前不顾后的？","book":"清·曹雪芹《红楼梦》第三十一回"},"example":{"text":"一听见有人告诉了，把我吓昏了，才这么着急的～了。","book":"清·曹雪芹《红楼梦》第六十八回"},"similar":["顾头不顾尾"],"opposite":["左右兼顾"],"usage":"作宾语、定语、分句；指考虑不周全","story":["这年端阳节，贾府自然大摆筵席，热闹非凡。筵席散后，贾宝玉去找林黛玉，林黛玉只是闷闷不乐不理他，晴雯上来给宝玉换衣服，不幸把扇子掉地损坏，宝玉气得骂她顾前不顾后。口齿伶俐的晴雯毫不示弱与他顶嘴，袭人忙上来解围"]},{"id":47016,"word":"顾名思义","pinyin":"gù míng sī yì","abbr":"gmsy","explanation":"顾：看；义：意义，含义。从名称想到所包含的意义。","source":{"text":"欲使汝曹顾名思义，不敢违越也。","book":"《三国志·魏书·王昶传》"},"example":{"text":"桂花蝉～，想是香味如桂花，或因桂花开时乃有，未详。","book":"鲁迅《两地书》七七"},"similar":["望文生义"],"usage":"作谓语、分句；指看到名称就想到所包含的意","story":["三国时期，魏文帝曹丕的老师王昶为人正直，注重名节，他给儿子、侄子起名时注意用谦实的字，为的是让他们顾名思义，不要做违背名字的事情，如儿子王浑字玄冲，王深字道冲，侄子王默字处静，王沈字处道等"]},{"id":47017,"word":"顾后瞻前","pinyin":"gù hòu zhān qián","abbr":"ghzq","explanation":"顾：回头看；瞻：向前看。看看前面，又看看后面。形容做事之前考虑周密慎重。也形容顾虑太多，犹豫不决。","source":{"text":"瞻前而顾后兮，相观民之计极。","book":"战国·楚·屈原《离骚》"},"example":{"text":"你往我来，遭着兵刃命随倾；～，错了心神身不保。","book":"明·许仲琳《封神演义》第五十三回"},"similar":["瞻前顾后"],"usage":"作谓语、宾语、定语、状语；指顾虑太多"},{"id":47018,"word":"顾复之恩","pinyin":"gù fù zhī ēn","abbr":"gfze","explanation":"顾：回头看；复：反复。比喻父母养育的恩德。","source":{"text":"《诗经·小雅·蓼莪》：“父兮生我，母兮鞠我……顾我复我，出入腹我。"},"example":{"text":"吾闻父子之亲，出自天性。子虽不孝，为父者未尝失其～。","book":"元·石君宝《曲江柳》第四折"},"similar":["养育之恩"],"usage":"作宾语；比喻父母养育的恩德"},{"id":47019,"word":"顾大局，识大体","pinyin":"gù dà jú，shí dà tǐ","abbr":"gdjsdt","explanation":"指从整体的利益着想，使不受损害。","source":{"text":"我们相信，我们的人民是顾大局、识大体、守纪律的。","book":"邓小平《解放思想，实事求是，团结一致向前看》"},"similar":["顾全大局"],"usage":"作谓语、定语、宾语；用于处世"},{"id":47020,"word":"顾头不顾尾","pinyin":"gù tóu bù gù wěi","abbr":"gtbgw","explanation":"形容做事或考虑事不仔细周到。","source":{"text":"你皆因年小时候，托着老子娘的福，吃喝惯了，如今所以有了钱就顾头不顾尾，没了钱就瞎生气。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"他这是～，头戴棉帽，脚穿拖鞋。"},"similar":["顾前不顾后"],"opposite":["瞻前顾后"],"usage":"作宾语、分句；指考虑不周","story":["王熙凤连了宗的远方亲戚王狗儿，生了一儿一女，家里靠种农活为生，王家祖上也是京官，后家道衰落。王狗儿不如意在家生闷气，岳母刘姥姥数落他：“你皆因年小时候，托着老子娘的福，吃喝惯了，如今所以有了钱就顾头不顾尾，没了钱就瞎生气。”"]},{"id":47021,"word":"顾头不顾脚","pinyin":"gù tóu bù gù jiǎo","abbr":"gtbgj","explanation":"比喻只顾眼前，不顾今后，缺乏通盘打算。形容做事或考虑事不仔细周到。","example":{"text":"我们做事不能～。"},"similar":["顾头不顾尾"],"usage":"作宾语、分句；指考虑不周"},{"id":47022,"word":"顾客盈门","pinyin":"gù kè yíng mén","abbr":"gkym","explanation":"盈：满。形容来买东西的人很多。","source":{"text":"我们占领遵义后，全市商店顾客盈门。","book":"成仿吾《长征回忆录》五"}},{"id":47023,"word":"顾小失大","pinyin":"gù xiǎo shī dà","abbr":"gxsd","explanation":"因贪图小利而损失大利。","source":{"text":"戴盆望天，不见星辰，顾小失大，福逃墙外。","book":"汉·焦赣《易林·贲之蒙》"},"example":{"text":"中国知金钱而不知时间，～，大都如是。","book":"孙中山《要实行社会革命》"},"similar":["贪小失大"],"usage":"作谓语、定语、宾语；指人眼光短浅"},{"id":47024,"word":"顾左右而言他","pinyin":"gù zuǒ yòu ér yán tā","abbr":"gzyeyt","explanation":"看着两旁的人，说别的话。形容无话对答，有意避开本题，用别的话搪塞过去。","source":{"text":"曰：‘四境之内不治则如之何？’王顾左右而言他。","book":"《孟子·梁惠王下》"},"example":{"text":"耿尔除了苦笑，只好～了。","book":"陈若曦《耿尔在北京》"},"similar":["顾而言他"],"usage":"作谓语、分句；指有意避开主题而搪塞","story":["齐宣王喜欢穷兵黩武，聚敛财物，上大夫封悦请孟子劝告齐宣王。孟子问齐宣王朋友受托而不尽责与官员不称职该怎么办，齐宣王回答道断交与撤职。当孟子问到君主对外用兵、对内敛财该怎么办？齐宣王东张西望而不回答"]},{"id":47025,"word":"顾影弄姿","pinyin":"gù yǐng nòng zī","abbr":"gynz","explanation":"顾影：看着自己的身影；弄姿：做出各种姿态。对着自己的身影，做出各种姿态。形容卖弄身形，自我欣赏。","source":{"text":"二姊葛氏，为人狡黠善辨，顾影弄姿，貌不及江城，而悍妒忌与埒。姊妹相逢无他语，惟各以阃威自鸣得意。","book":"清·蒲松龄《聊斋志异·江城》"},"example":{"text":"相貌其实平常，然而～，自以为倾国倾城；且以有异性之追求为乐事。","book":"茅盾《清明前后》第三幕"},"similar":["搔首弄姿"],"usage":"作谓语；指卖弄姿色"},{"id":47026,"word":"顾影惭形","pinyin":"gù yǐng cán xíng","abbr":"gycx","explanation":"形：形体。看着自己的身影，对自己的体态不满意，而生出愧疚之感。表示自己不配享受某种荣誉、称号而感到惭愧。","source":{"text":"天时运幸，得生贵门，遇以亲戚，少荷光宠，窃位列侯，荣曜当世，顾影惭形，流汗反侧。","book":"三国·魏·曹植《封二子为公谢恩章》"},"example":{"text":"芬芳并发，我秽其馨，德音光宣，我累厥声；岂伊不愧，～。","book":"晋·傅咸《申怀赋》"},"similar":["顾景惭形"],"usage":"作谓语、定语；用于书面语"},{"id":47027,"word":"顾影自怜","pinyin":"gù yǐng zì lián","abbr":"gyzl","explanation":"顾：看；怜：怜惜。回头看看自己的影子，怜惜起自己来。形容孤独失意的样子，也指自我欣赏。","source":{"text":"伫立望故乡，顾影凄自怜。","book":"晋·陆机《赴洛道中作》"},"example":{"text":"科亦～，矜其容色，高其声价，不屑一切。","book":"清·张潮《虞初新志·板桥杂记》"},"similar":["孤苦伶仃","孤芳自赏","形单影只"],"opposite":["自高自大","妄自尊大"],"usage":"作谓语、定语；形容孤独失意"},{"id":47028,"word":"顾彼失此","pinyin":"gù bǐ shī cǐ","abbr":"gbsc","explanation":"顾：照顾，照管。顾了这个，丢了那个。形容不能全面照顾。","source":{"text":"若彼声西击东，而我军出大同，未免顾彼失此。","book":"明·余继登《典故纪闻》第16卷"},"similar":["顾此失彼"],"usage":"作谓语、定语；形容不能兼顾"},{"id":47029,"word":"顾彼忌此","pinyin":"gù bǐ jì cǐ","abbr":"gbjc","explanation":"顾：顾虑；忌：忌讳。顾虑这个，忌讳那个。形容作事顾忌太多，放不开手脚。","source":{"text":"执笔之际，避实就虚，顾彼忌此，实在危闷。","book":"鲁迅《致台静农》"}},{"id":47030,"word":"顾景兴怀","pinyin":"gù jǐng xīng huái","abbr":"gjxh","explanation":"看见眼前的景物而产生某种情怀。","source":{"text":"石间波纹水迹，亦不知何时有之。其间唐宋游人提名，不可殚记，览者顾景兴怀云。","book":"宋·周密《武林旧事记》卷五"}},{"id":47031,"word":"顾景惭形","pinyin":"gù yǐng cán xíng","abbr":"gycx","explanation":"看着身影，对自己的形体感到羞愧。指自认不配享受某种荣誉、称号等而感到惭愧。景，同“影”","source":{"text":"天时运幸，得生贵门。遇以亲戚，少荷光宠。窃位列侯，荣曜当世。顾景惭形，流汗反侧。","book":"三国·魏·曹植《封二子为公谢恩章》"},"similar":["顾影惭形"],"usage":"作谓语、定语；用于书面语"},{"id":47032,"word":"顾曲周郎","pinyin":"gù qǔ zhōu láng","abbr":"gqzl","explanation":"原指周瑜业于音乐。后泛指通音乐戏曲的人。","source":{"text":"瑜少精意于音乐，虽三爵之后，其有阙误，瑜必知之，知之必顾，故时有人谣曰：‘曲有误，周郎顾。’","book":"《三国志·吴书·周瑜传》"},"example":{"text":"看花李益无同伴，～有后身。","book":"宋·刘克庄《哭孙李蕃》诗"},"usage":"作宾语；指通音乐戏曲的人","story":["三国时期，吴国都督周瑜不但有卓越的政治和军事才能，为人足智多谋，而且他对音乐也很精通，有很高的鉴赏能力，就是多喝了几杯酒也照样能够发现演奏者的错误。唐代诗人李端在《听筝》中写道：“欲得周郎顾，时时误拂弦。”"]},{"id":47033,"word":"顾此失彼","pinyin":"gù cǐ shī bǐ","abbr":"gcsb","explanation":"顾了这个，丢了那个。形容忙乱或慌张的情景。","source":{"text":"分军为三：一军攻麦城，一军攻纪南城，大五率大军直捣郢都，彼疾雷不及掩耳，顾此失彼，二城若破，郢不守矣。","book":"明·冯梦龙《东周列国志》第七十六回"},"example":{"text":"于是敌军处于一种恐怖气氛中，～，疲于奔命。","book":"冯玉祥《我的生活》第三十三章"},"similar":["捉襟见肘"],"opposite":["面面俱到"],"usage":"作谓语、定语；形容不能兼顾"},{"id":47034,"word":"顾犬补牢","pinyin":"gù quǎn bǔ láo","abbr":"gqbl","explanation":"比喻事情出了差错，宜及时设法补救。","source":{"text":"见兔而顾犬，未为晚也；亡羊而补牢，未为迟也。","book":"《战国策·楚策四》"},"example":{"text":"后之视今，犹今之视昔，～，未为迟也。","book":"清·梁启超《日本国志后序》"},"similar":["亡羊补牢"],"usage":"作谓语；用于事后"},{"id":47035,"word":"顾盼多姿","pinyin":"gù pàn duō zī","abbr":"gpdz","explanation":"形容眉目传神，姿态动人。同“顾盼生姿”。","source":{"text":"王昭君，十九岁……一双秋水似的眼睛，神采清明，顾盼多姿。","book":"曹禺《王昭君》第一幕"}},{"id":47036,"word":"顾盼生姿","pinyin":"gù pàn shēng zī","abbr":"gpsz","explanation":"姿：姿色，姿态。回首抬眼之间就有美妙的姿色。形容眉目传神，姿态动人。","source":{"text":"风驰电逝，蹑景追风；凌历中原，顾盼生姿。","book":"三国·魏·嵇康《赠秀才入军》"},"example":{"text":"华见其总角风流，洁白如玉，举动容止，～，雅重之。","book":"晋·干宝《搜神记·张茂行》"},"similar":["眉目传神","顾盼生辉"],"usage":"作谓语、定语；形容女子姿态动人"},{"id":47037,"word":"顾盼生辉","pinyin":"gù pàn shēng huī","abbr":"gpsh","explanation":"回首抬眼之间就有美妙的姿色。形容眉目传神，姿态动人。","source":{"text":"风驰电逝，蹑景追风；凌历中原，顾盼生姿。","book":"三国·魏·嵇康《赠秀才入军》"},"example":{"text":"士有余粮，马多剩草。一呼百诺，～。此送彼迎，尊荣莫及。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["顾盼生姿"],"usage":"作谓语、定语；形容女子姿态动人"},{"id":47038,"word":"顾盼神飞","pinyin":"gù pàn shén fēi","abbr":"gpsf","explanation":"左右顾视，目光炯炯，神采飞扬。","source":{"text":"第二个削肩细腰，长挑身材，鹅蛋脸儿，俊眼修眉，顾盼神飞，文彩精华，见之忘俗。","book":"《红楼梦》第三回"},"example":{"text":"生得杏脸蜂腰，修眉俊眼，亭亭玉立，～，正从梅花小径闪身出来。","book":"《东欧女豪杰》第二回"},"usage":"作谓语、定语；用于人的神态"},{"id":47039,"word":"顾盼自如","pinyin":"gù pàn zì rú","abbr":"gpzr","explanation":"顾盼：左顾右盼；自如：按自己的意愿行事。很灵活左顾右盼。","example":{"text":"他装作～的样子，企图引开别人的注意力。"},"usage":"作谓语、定语；用于人的神态"},{"id":47040,"word":"顾盼自得","pinyin":"gù pàn zì dé","abbr":"gpzd","explanation":"顾盼：左顾右盼；自得：自己很得意。环顾四周，觉得自己很了不起。形容得意忘形。","source":{"text":"犹如脚底抹油，犹如乘风滑翔，钱康神采奕奕，顾盼自得，仿佛他是天下自我感觉最好的人。","book":"王朔《无人喝彩》"},"example":{"text":"我看不惯她那～的样子。"},"similar":["得意忘形"],"usage":"作谓语、定语；指人得意忘形"},{"id":47041,"word":"顾盼自豪","pinyin":"gù pàn zì háo","abbr":"gpzh","explanation":"形容得意忘形的样子。同“顾盼自雄”。","source":{"text":"袁总统得此奇袭，未免顾盼自豪。","book":"蔡东藩、许廑父《民国通俗演义》第三六回"},"example":{"text":"或猜拳，或赋诗，酒酣耳热，～。","book":"曹禺《北京人》第三幕"},"similar":["顾盼自雄"],"usage":"作谓语；形容得意忘形的样子"},{"id":47042,"word":"顾盼自雄","pinyin":"gù pàn zì xióng","abbr":"gpzx","explanation":"左看右看，自以为了不起。形容得意忘形的样子。","source":{"text":"跃马顾盼，自以为一世之雄。","book":"《宋书·范晔传》"},"example":{"text":"少年恃其刚悍，～，视乡党如无物。","book":"清·纪昀《阅微草堂笔记·姑妄听之》"},"similar":["顾盼自豪"],"usage":"作谓语；形容得意忘形的样子"},{"id":47043,"word":"顾而言他","pinyin":"gù ér yán tā","abbr":"geyt","explanation":"形容无话对答，有意避开本题，用别的话搪塞过去。同“顾左右而言他”。","source":{"text":"那三人见话不投机，便顾而言他。","book":"《扫迷帚》第二一回"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“郁四怕他为难，自己收篷，～。”"},"similar":["顾左右而言他"],"usage":"作谓语、定语；指有意避开主题而搪塞"},{"id":47044,"word":"顾虑重重","pinyin":"gù lǜ chóng chóng","abbr":"glcc","explanation":"重重：一层又一层。一层又一层的顾虑。形容顾虑极多，难于放手行事。","example":{"text":"他总是～的样子，让人不能信用他的办事能力。"},"similar":["瞻前顾后"],"usage":"作谓语、定语；用于处事"},{"id":47045,"word":"顾说他事","pinyin":"gù shuō tā shì","abbr":"gsts","explanation":"转过头去说别的事情。表示不愿意交谈对方提起的话题。","source":{"text":"孟孙阳因顾与其徒说他事。","book":"《列子·杨朱》"}},{"id":47046,"word":"顿兵坚城","pinyin":"dùn bīng jiān chéng","abbr":"dbjc","explanation":"顿：停留；坚城：坚固的城池。把军队停驻在敌人的坚固城池下。","source":{"text":"顿之燕坚城之下。","book":"《史记·淮阴侯列传》"},"example":{"text":"若先攻西安，不能卒下，～，死伤必多。","book":"《资治通鉴·汉纪·光武帝五年》"}},{"id":47047,"word":"顿口拙腮","pinyin":"dùn kǒu zhuō sāi","abbr":"dkzs","explanation":"比喻嘴笨，不善于说话。","source":{"text":"好妹妹，我是顿口拙腮，可不能一句一句同你套！","book":"清·李汝珍《镜花缘》第八十回"}},{"id":47048,"word":"顿口无言","pinyin":"dùn kǒu wú yán","abbr":"dkwy","explanation":"张口结舌，说不出话。","source":{"text":"王庆被范全说得顿口无言。","book":"明·施耐庵《水浒全传》第一百四回"},"example":{"text":"他的一席话，使在场的人个个～。"},"similar":["张口结舌","哑口无言"],"opposite":["伶牙俐齿"],"usage":"作谓语、状语；形容张口结舌"},{"id":47049,"word":"顿学累功","pinyin":"dùn xué lěi gōng","abbr":"dxlg","explanation":"愚笨的人只要刻苦学习，也能取得成就。","source":{"text":"钝学累功，不妨精熟。","book":"北齐·颜之推《颜氏家训·文章》"}},{"id":47050,"word":"顿开茅塞","pinyin":"dùn kāi máo sè","abbr":"dkms","explanation":"顿：立刻；茅塞：喻人思路闭塞或不懂事。比喻思想忽然开窍，立刻明白了某个道理。","source":{"text":"山径之蹊间，介然用之而成路；为间不用，则茅塞之矣。今茅塞子之心矣。","book":"《孟子·尽心下》"},"example":{"text":"只不过短短十多分钟的谈话，可是他好像使林道静～似的，忽然知道了好多事情。","book":"杨沫《青春之歌》第一部第六章"},"similar":["豁然开朗","恍然大悟"],"opposite":["大惑不解","一窍不通","冥顽不灵"],"usage":"作谓语、定语；形容一下子打开思路","story":["战国时期，高子在学习上三天打鱼两天晒网，不能坚持到底。孟子批评他说：“山上的小道虽窄，如果经常有人走，就会变成一条大路，如果一段时间没人走，就会被茅草堵塞。你的心被茅草堵塞了，所以不能进步。”"]},{"id":47051,"word":"顿挫抑扬","pinyin":"dùn cuò yì yáng","abbr":"dcyy","explanation":"形容诗文作品或音乐声响等高低起伏、停顿转折，和谐而有节奏。","source":{"text":"陶渊明罢彭泽令，赋《归去来》，而自命曰辞。迨今人歌之，顿挫抑扬，自协声律，盖其词高甚。","book":"宋·魏庆之《诗人玉屑·靖节·休斋论〈归去来辞〉》"},"example":{"text":"但这是当时的风气，要激昂慷慨，～，才能被称为好文章。","book":"鲁迅《〈集外集〉序言》"},"similar":["抑扬顿挫"],"opposite":["平铺直叙"],"usage":"作定语、状语、补语；形容声音"},{"id":47052,"word":"顿纲振纪","pinyin":"dùn gāng zhèn jì","abbr":"dgzj","explanation":"整顿朝纲，重振法纪。","source":{"text":"顿，谓整顿。","book":"《资治通鉴·周显王四十八年》：“夫贤者，其德足以敦化正俗，其才足以顿纲振纪。”胡三省注"},"usage":"作谓语、宾语；用于治国"},{"id":47053,"word":"顿脚捶胸","pinyin":"dùn jiǎo chuí xiōng","abbr":"djcx","explanation":"形容情绪激烈的样子。同“顿足搥胸”。","source":{"text":"可是国王顿脚捶胸地骂道：‘没用的东西们，如果发现碗上有一道裂纹，就反你们每本个中绞死一个！’","book":"《中国民间故事选·打碎的碗》"},"example":{"text":"有时候，工作没有做好，就～，恨不得把自己撕成几半。","book":"昊运铎《把一切献给党·我们的工厂》"},"similar":["顿足捶胸"],"usage":"作谓语、状语；形容极度悲痛的样子"},{"id":47054,"word":"顿腹之言","pinyin":"dùn fù zhī yán","abbr":"dfzy","explanation":"犹言肺腑之言。","source":{"text":"常言酒发顿腹之言。","book":"明·兰陵笑笑生《金瓶梅词话》第25回"},"example":{"text":"请仔细回味他这番～。"},"similar":["肺腑之言"],"usage":"作主语、宾语；指真心话"},{"id":47055,"word":"顿足不前","pinyin":"dùn zú bù qián","abbr":"dzbq","explanation":"停顿下来不前进。","example":{"text":"她～，害怕有人从中作梗。"},"similar":["停滞不前","裹足不前"],"opposite":["快步流星"],"usage":"作谓语、定语；指停滞不前"},{"id":47056,"word":"顿足失色","pinyin":"dùn zú shī sè","abbr":"dzss","explanation":"顿足：跺脚。失色：因惊恐而变以脸色。形容十分惊慌。","source":{"text":"成仓猝莫如所救，顿足失色。","book":"清·蒲松龄《聊斋志异·促织》"}},{"id":47057,"word":"顿足捩耳","pinyin":"dùn zú liè ěr","abbr":"dzle","explanation":"形容束手无策的困态。","source":{"text":"晋公候于阁门，见其甚久。则顿足捩耳云：‘无及矣。’","book":"宋·王銍《默记》卷上"},"usage":"作定语、状语；用于人的神态"},{"id":47058,"word":"顿足捶胸","pinyin":"dùn zú chuí xiōng","abbr":"dzcx","explanation":"用脚跺地，以拳捶胸。形容极度悲痛或恼怒，到了极点。","source":{"text":"他那里醉朦胧语言都不省，只获得顿足捶胸也，短叹长吁千万声。","book":"元·无名氏《白兔记》第十四折"},"example":{"text":"只见杨子哀号哽咽，～，抚棺长恨，欲拔剑自刎。","book":"明·吴元泰《东游记》第七回"},"similar":["呼天抢地"],"opposite":["手舞足蹈"],"usage":"作谓语、状语；形容极度悲痛的样子"},{"id":47059,"word":"顿足搓手","pinyin":"dùn zú cuō shǒu","abbr":"dzcs","explanation":"顿：以脚扣地；搓：手相摩。形容着急惋惜的样子。","source":{"text":"顿：以脚扣地；搓：手相摩。形容着急惋惜的样子。"},"example":{"text":"他在山上急得～，还是无法下山。"},"similar":["抓耳挠腮"],"opposite":["镇定自若"],"usage":"作谓语、状语；指着急的样子"},{"id":47060,"word":"顿足搥胸","pinyin":"dùn zú duī xiōng","abbr":"dzcx","explanation":"边跺脚边击打胸脯。形容情绪激烈的样子。","source":{"text":"王砉顿足搥胸道：‘是我不该来看那逆种！’","book":"《水浒传》第一○二回"},"example":{"text":"灵车队，万众心相随，只见灵车去，不见总理归，～悲欲绝，呼唤总理泪纷飞。","book":"《光明日报》1977.1.9"}},{"id":47061,"word":"顿足椎胸","pinyin":"dùn zú zhuī xiōng","abbr":"dzzx","explanation":"形容情绪激烈的样子。同“顿足搥胸”。","source":{"text":"社会人心异常兴奋，甚至妇人、孺子、车夫、苦力，风元不口谈抵制，戟批痛骂，握拳怒目，顿足椎胸。","book":"刘立凯《五四——六三爱国运动大事日录·广州众捣毁日货》"},"similar":["顿足捶胸","顿脚捶胸"],"usage":"作谓语、状语；形容极度悲痛的样子"},{"id":47062,"word":"顿首再拜","pinyin":"dùn shǒu zài bài","abbr":"dszb","explanation":"顿首：以头叩地而拜；再拜：拜两次。古代的一种跪拜礼。亦指旧时信札中常用作向对方表示敬意的客套语。","source":{"text":"勾践顿首再拜曰：‘孤尝不料力，乃与吴战，困于会稽，痛入于骨髓，日夜焦唇干舌，徙欲与吴王接踵而死，孤之愿也。’","book":"西汉·司马迁《史记·仲尼弟子列传》"},"example":{"text":"新正，伏冀为国自重。某～。","book":"宋·王安石《与王宣书徽》"},"usage":"作谓语、状语；用于客套语"},{"id":47063,"word":"颂古非今","pinyin":"sòng gǔ fēi jīn","abbr":"sgfj","explanation":"指不加分析地颂扬古代的，否定现代的。","source":{"text":"有敢偶语《诗》《书》者弃市，以古非今者族。","book":"《史记·秦始皇本纪》"},"example":{"text":"是给历史以一定的科学的地位，是尊重历史的辩证法的发展，而不是～，不是赞扬任何封建的毒素。","book":"毛泽东《新民主主义论》"},"similar":["是古非今"],"opposite":["后今薄古"],"usage":"作谓语、定语；指颂扬古代的，否定现代的"},{"id":47064,"word":"颂声载道","pinyin":"sòng shēng zǎi dào","abbr":"sszd","explanation":"赞颂之声充满道路。极言称赞者多。","source":{"text":"威王自周返齐，一路颂声载道，皆称其贤。","book":"明·冯梦龙《东周列国志》第八十六回"},"example":{"text":"不但山西百姓～，就是山西官员，从巡抚以下，也没有一个不感激他的。","book":"清·李宝嘉《官场现形记》第三十四回"},"similar":["交口称赞"],"opposite":["怨声载道"],"usage":"作谓语、定语；用于书面语"},{"id":47065,"word":"颂德咏功","pinyin":"sòng dé yǒng gōng","abbr":"sdyg","explanation":"颂、咏：颂扬。颂扬功绩和德行。","source":{"text":"鸾舆幽蔼，龙旗太常，爰迄太庙，钟鼓锽锽，颂德咏功，八佾锵锵。","book":"《史记·周本纪》：“民皆歌乐之，颂其德。”《三国志·魏志·文帝纪》"}},{"id":47066,"word":"颂德歌功","pinyin":"sòng dé gē gōng","abbr":"sdgg","explanation":"颂扬恩德，赞美功绩。","source":{"text":"民皆歌乐之，颂其德。","book":"《史记·周本纪》"},"example":{"text":"使得为鸡皮三少之女，前鱼不泣之男，地下有灵，方～之不暇，而忍以矫制责之哉？","book":"清·李渔《闲情偶寄·演习部》"},"similar":["歌功颂德"],"usage":"作谓语、宾语、定语；指赞扬人"},{"id":47067,"word":"预搔待痒","pinyin":"yù sāo dài yǎng","abbr":"ysdy","explanation":"痒还未发作便预先搔抓。比喻事先作多余的准备。","source":{"text":"师曰：‘不可预搔而待痒。’","book":"宋·释道原《景德传灯录·洪忍禅师》"},"example":{"text":"寂然不动，感而遂通古人，恁么说话，大似～。","book":"宋·释普济《五灯会元·育王裕禅师嗣》"},"usage":"作谓语、定语、宾语；指多余的行动"},{"id":47068,"word":"领异标新","pinyin":"lǐng yì biāo xīn","abbr":"lybx","explanation":"指与众不同，独创一格。","source":{"text":"下至淫巧奇技，亦领异标新，锥刀竞逐，穷天地之精华，竭闾阎之脂膏。","book":"郑观应《盛世危言·商战上》"},"example":{"text":"革党在汉阳兵力约一万三四千人，其各种防守工程颇有～出人意表者。","book":"中国近代史资料丛刊《辛亥革命·武昌起义清方档案·关于民清军交战情况》"},"similar":["标新立异","与众不同"],"opposite":["平平淡淡"],"usage":"作谓语、定语；指与众不同"},{"id":47069,"word":"领袖后进","pinyin":"lǐng xiù hòu jìn","abbr":"lxhj","explanation":"指后辈中才华出众，遥遥领先的人。","source":{"text":"叔宝理遣之谈，彦辅名教之乐，故以晖映先达，领袖后进。","book":"《梁书·王暕传》"}},{"id":47070,"word":"颊上三毛","pinyin":"jiá shàng sān máo","abbr":"jssm","explanation":"比喻文章或图画的得神之处。","source":{"text":"顾长康画裴叔则，颊上益三毛。人问其故？顾曰：‘裴楷俊朗有识具，正此是其识具。看画者寻之，定觉益三毛如有神明，殊胜未安时。’","book":"南朝·宋·刘义庆《世说新语·巧艺》"},"example":{"text":"待画个岭上孤松，当做～。","book":"清·李渔《意中缘·卷帘》"},"similar":["颊上三毫"],"usage":"作宾语；比喻文章或图画的得神之处"},{"id":47071,"word":"颊上三毫","pinyin":"jiá shàng sān háo","abbr":"jssh","explanation":"比喻文章或图画的得神之处。同“颊上三毛”。","source":{"text":"至其论赞，则淡淡数语，非颊上三毫，则睛中一画。","book":"清·张岱《石匮书自序》"},"example":{"text":"幼闻故老传先生（史湘浦）轶事，可异焉。～，匪遂正相，而神以传也。","book":"清·史震林《西清散记》卷一"},"similar":["颊上三毛"],"usage":"作宾语；比喻文章或图画的得神之处"},{"id":47072,"word":"颊上添毫","pinyin":"jiá shàng tiān háo","abbr":"jsth","explanation":"颊：面颊；毫：毫毛。给人画像时在脸上添上几根毫毛。比喻文章经润色后更加精采。","source":{"text":"尝图裴楷橡，颊上夹三毛，观者觉神明殊胜。","book":"《晋书·顾恺之传》"},"example":{"text":"《雪中人》一剧，写吴六奇，～，栩栩欲活。","book":"清·梁廷枏《曲话》卷三"},"similar":["颊上三毛"],"usage":"作宾语、定语；用于比喻句"},{"id":47073,"word":"颐养天年","pinyin":"yí yǎng tiān nián","abbr":"yytn","explanation":"指保养年寿。","source":{"text":"老太君年过百年，就该颐养天年，何必身履险地？","book":"京剧《杨门女将》"},"example":{"text":"他对佛教已经一往情深，肯定会抱守着这些陈旧的信条去～的。","book":"《十月》1981年第1期"},"usage":"作谓语、宾语、定语；指养老"},{"id":47074,"word":"颐养神性","pinyin":"yí yǎng shén xìng","abbr":"yysx","explanation":"颐：保养；神：精神；性：性情。保养精神，使性情得到陶冶。","source":{"text":"放无用之物，委之川泽，取乐琴书，颐养神性。","book":"汉·马融《广成颂》：“夫乐而不荒，忧而不困，先王所以平和府藏，颐养精神，致之无疆。”《魏书·崔光传》"},"example":{"text":"或鼓琴、投壶、习射以～，享名教不穷之乐，固嵩岳无涯之寿，岂不休哉！","book":"清·毕沅《续资治通鉴》卷一百五十二"}},{"id":47075,"word":"颐养精神","pinyin":"yí yǎng jīng shén","abbr":"yyjs","explanation":"《后汉书·马融传》：“夫乐而不荒，优而不困，先王所以平和府藏，颐养精神，致之无疆。”","source":{"text":"夫乐而不荒，忧而不困，先王所以平和府藏，颐养精神，致之无疆。","book":"南朝·宋·范晔《后汉书·马融传》"},"similar":["颐神养性"],"usage":"作谓语、定语；用于处事"},{"id":47076,"word":"颐性养寿","pinyin":"yí xìng yǎng shòu","abbr":"yxys","explanation":"指保养精神元气。","source":{"text":"《尔雅》曰：颐，养也。","book":"《文选·嵇康〈幽愤诗〉》：“永啸长吟，颐性养寿。”李善注"},"example":{"text":"此岂嵇康‘～’时也？","book":"明·李贽《读史·幽愤诗》"},"similar":["颐神养寿"],"usage":"作谓语、定语；用于书面语"},{"id":47077,"word":"颐指如意","pinyin":"yí zhǐ rú yì","abbr":"yzry","explanation":"颐指：用面部表情来指挥人；如意：符合自己的心意。形容指挥起来称心如意。","source":{"text":"今陛下力制天下，颐指如意。","book":"《汉书·贾谊传》"},"usage":"作谓语、定语；用于处事"},{"id":47078,"word":"颐指气使","pinyin":"yí zhǐ qì shǐ","abbr":"yzqs","explanation":"颐指：动下巴示意，指挥别人；气使：用神情气色支使人。不说话而用面部表示表情示意。形容有权势的人指挥别人的傲慢态度。","source":{"text":"见朝士，皆颐指气使，旁若无人。","book":"《汉书·贡禹传》：“家富势足，目指气使。”《资治通鉴·唐纪·昭宣帝天佑二年》"},"example":{"text":"他～，心狠手辣。","book":"林平《从夏三虫说开去》"},"similar":["盛气凌人","趾高气扬","神气活现"],"opposite":["唯唯诺诺","低三下四","奴颜婢膝"],"usage":"作谓语、宾语、定语；指态度傲慢","story":["唐朝末年，朱温杀了宰相崔胤，强迫唐昭宗迁都洛阳，朱温不放心，派李振到洛阳去监视唐昭宗及百官。李振仗着朱温的权势，趾高气扬，目空一切，他经常用动动下巴和盛气凌人的态度去指使别人，遇到不顺眼的就训斥"]},{"id":47079,"word":"颐指气役","pinyin":"yí zhǐ qì yì","abbr":"yzqy","explanation":"颐指：动下巴示意，指挥别人；气役：用神情气色支使人。不说话而用面部表示表情示意。形容有权势的人指挥别人的傲慢态度。","source":{"text":"今王将东面，目指气使以求臣，则厮役之材至矣。","book":"汉·刘向《说苑·君道》"}},{"id":47080,"word":"颐指进退","pinyin":"yí zhǐ jìn tuì","abbr":"yzjt","explanation":"颐指：用面部表情来指挥人。形容指挥别人时态度傲慢。","source":{"text":"麾下老将若李怀光辈数十人，皆王侯重贵，子仪颐指进退，如仆隶焉。","book":"《旧唐书·郭子仪传》"},"usage":"作谓语、定语；用于处事"},{"id":47081,"word":"颐指风使","pinyin":"yí zhǐ fēng shǐ","abbr":"yzfs","explanation":"以下巴的动向和脸色来指挥人。常以形容指挥别人时的傲慢态度。","source":{"text":"累年以来，朝廷使臣以致中书省枢密院御史台内外诸衙门一切出使臣人等，每到外路，挟恃威势，颐指风使，外路官司抑曲将迎，恐咈其意。","book":"《元典章·户部二·使臣》"},"similar":["颐指气使"],"usage":"作谓语、宾语、定语；指态度傲慢"},{"id":47082,"word":"颐神养寿","pinyin":"yí shén yǎng shòu","abbr":"ysys","explanation":"指保养精神元气。同“颐性养寿”。","source":{"text":"永啸长吟，颐神养寿。","book":"《晋书·嵇康传》"},"similar":["颐性养寿"],"usage":"作谓语、定语；用于书面语"},{"id":47083,"word":"颐神养性","pinyin":"yí shén yǎng xìng","abbr":"ysyx","explanation":"指保养精神元气。","source":{"text":"其践升帝位，克广洪业，以光祖宗之烈，使朕优游履道，颐神养性，可不善欤？","book":"《魏书·显祖纪》"},"example":{"text":"～，省畋游之娱；去奢从俭，减工役之费。","book":"《旧唐书·岑文本传》"},"similar":["颐养精神","颐神养气"],"usage":"作谓语、定语；用于书面语"},{"id":47084,"word":"颐神养气","pinyin":"yí shén yǎng qì","abbr":"ysyq","explanation":"犹言颐神养性。","source":{"text":"蓬头垢面，秘奥埋名。颐神养气忘形。","book":"金·马钰《满庭芳》词"},"similar":["颐神养性"],"usage":"作谓语、定语；用于书面语"},{"id":47085,"word":"颐精养气","pinyin":"yí jīng yǎng qì","abbr":"yjyq","explanation":"颐：保养。保养精神，使性情得到陶冶。","source":{"text":"其践升帝位，克广洪业，以光祖宗之烈，使朕优游履道，颐神养性，可不善欤？","book":"《魏书·显祖纪》"}},{"id":47086,"word":"颐精养神","pinyin":"yí jīng yǎng shén","abbr":"yjys","explanation":"保养精神元气。同“颐养精神”。","source":{"text":"公宜颐精养神，保卫太和，以究遐福。","book":"唐·房玄龄《晋书·郑冲传》"},"similar":["颐养精神"],"usage":"作谓语、定语；用于书面语"},{"id":47087,"word":"颓垣废井","pinyin":"tuí yuán fèi jǐng","abbr":"tyfj","explanation":"倒塌了的墙，废弃不用的井。形容荒凉破败的景象。","source":{"text":"虽然，不可以不一言，使数百年之后，得此文于颓垣废井之间者，茫然长思而一叹也。","book":"宋苏轼《密州通判厅题名记》"},"similar":["颓垣废址","颓垣败井","颓垣败壁"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47088,"word":"颓垣废址","pinyin":"tuí yuán fèi zhǐ","abbr":"tyfz","explanation":"犹颓垣废井。形容荒凉破败的景象。","source":{"text":"今其江山虽在，而颓垣废址，荒烟野草，过而览者，莫不为之踌躇而凄怆。","book":"宋欧阳修《有美堂记》"},"similar":["颓垣废井","颓垣败井","颓垣败壁"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47089,"word":"颓垣断堑","pinyin":"tuí yuán duàn piàn","abbr":"tydq","explanation":"犹颓垣废井。形容荒凉破败的景象。","source":{"text":"园之广百亩，而流水横其前，清池浸其右，高台起其北……此前日之颓垣断堑而荒墟也。","book":"宋欧阳修《真州东园记》"},"similar":["颓垣废井","颓垣败井","颓垣败壁"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47090,"word":"颓垣断壁","pinyin":"tuí yuán duàn bì","abbr":"tydb","explanation":"残垣断壁。","example":{"text":"地震过后，到处都是～。"},"similar":["颓垣败壁"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47091,"word":"颓垣败井","pinyin":"tuí yuán bài jǐng","abbr":"tybj","explanation":"犹颓垣废井。形容荒凉破败的景象。","source":{"text":"破庙荒凉，草深一尺，见一群的羊在那里吃草，颓垣败井，廊庑倾欹。","book":"《花月痕》第四五回"},"similar":["颓垣废井","颓垣败壁","颓垣断堑"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47092,"word":"颓垣败壁","pinyin":"tuí yuán bài bì","abbr":"tybb","explanation":"犹颓垣废井。形容荒凉破败的景象。","source":{"text":"走了半里多路，只见一处烧不尽的颓垣败壁。","book":"《恨海》第六回"},"example":{"text":"闹市尽处，～之旁，二人方抵掌而谈。","book":"刘复《两盗》"},"similar":["颓垣断壁","颓垣败井","颓垣废井"],"usage":"作主语、宾语、定语；指荒凉残败的景象"},{"id":47093,"word":"颓堕委靡","pinyin":"tuì duò wěi mǐ","abbr":"tdwm","explanation":"衰颓不振作。","source":{"text":"泊与淡相遭，颓堕委靡，溃败不可收拾。","book":"唐·韩愈《送高闲上人序》"},"example":{"text":"昏昏然，冥冥然，～，入而不知出焉。","book":"清·戴名士《醉乡记》"}},{"id":47094,"word":"颔下之珠","pinyin":"hàn xià zhī zhū","abbr":"hxzz","explanation":"颔：下巴。骊龙下巴下的珍珠。比喻难得的珍品。","source":{"text":"夫千金之珠，必在九重之渊，而骊龙颔下。","book":"《庄子·列御寇》"}},{"id":47095,"word":"颖悟绝人","pinyin":"yǐng wù jué rén","abbr":"ywjr","explanation":"颖悟：聪颖。绝人：超过同辈。聪明过人。同“颖悟绝伦”。","source":{"text":"明·宋濂《元史·铁木兒塔识传论》铁木兒塔识，字九龄，国王脱脱之子。资禀宏伟，补国子学诸生，读书颖悟绝人。"},"similar":["颖悟绝伦"],"usage":"作谓语、定语；用于夸奖别人"},{"id":47096,"word":"颖悟绝伦","pinyin":"yǐng wù jué lún","abbr":"ywjl","explanation":"颖悟：聪颖。绝伦：超过同辈。聪明过人。亦作“颖悟绝人”。","source":{"text":"张方平，字安道，南京人。少颖悟绝伦，家贫无书，从人假三史，旬日即归之，曰：‘吾已得其详矣。’","book":"元·脱脱《宋史·张方平传》"},"similar":["颖悟绝人"],"usage":"作谓语、定语；用于夸奖别人"},{"id":47097,"word":"颖拔绝伦","pinyin":"yǐng bá jué lún","abbr":"ybjl","explanation":"聪敏过人，找不出第二个人。","source":{"text":"却说守将乃元总管胡深，字仲渊，处州龙泉人。颖拔绝伦，倜傥好施。","book":"明·郭勋《英烈传》第26回"},"example":{"text":"她是我们班～的小诗人。"},"similar":["出类拔萃"],"usage":"作谓语、定语；用于书面语"},{"id":47098,"word":"颖脱而出","pinyin":"yǐng tuō ér chū","abbr":"ytec","explanation":"颖，锥芒。言锥芒全部脱出。比喻有才能的人得到机会，即能全部显现出来。","source":{"text":"平原君曰：‘夫贤士之处世也，譬若锥之处囊中，其末立见……’毛遂曰：‘臣乃今日请处囊中耳。使遂早得处囊中，乃颖脱而出，非特其末见而已。’","book":"《史记·平原君虞卿列传》"},"example":{"text":"愿君侯不以富贵而骄之，寒贱而忽之，则三千宾中有毛遂，使自得～，即其人焉。","book":"唐·李白《与韩荆州书》"},"similar":["脱颖而出"],"opposite":["不露锋芒"],"usage":"作谓语；指显现才能"},{"id":47099,"word":"颗粒无存","pinyin":"kē lì wú cún","abbr":"klwc","explanation":"颗粒：一颗一粒。指粮食没有收成。","source":{"text":"这些野兽就算嘴馋好吃，也不能吃得颗粒无存。","book":"清·李汝珍《镜花缘》第九回"},"example":{"text":"船上米粮，都被劫的～，如今饿的头晕眼花，哪有气力还去拿蒿弄柁？","book":"清·李汝珍《镜花缘》第五十一回"},"similar":["颗粒无收"],"usage":"作谓语、定语、状语；指没有收成"},{"id":47100,"word":"颗粒无收","pinyin":"kē lì wú shōu","abbr":"klws","explanation":"收：收成。连一粒米也没收获到。多指因灾祸造成绝收。","source":{"text":"定额租稍轻，但不论虫伤天旱，颗粒无收均须照纳。","book":"吕振羽《简明中国通史》第15章"},"example":{"text":"这场水灾使得农作物～。"},"similar":["颗粒无存"],"usage":"作谓语、定语、状语；指没有收成"},{"id":47101,"word":"题名道姓","pinyin":"tí míng dào xìng","abbr":"tmdx","explanation":"犹指名道姓。指对人不尊敬。","source":{"text":"这个穷弟子孩儿，要钱则要钱，题名道姓怎的。","book":"元郑廷玉《忍字记》第一折"},"example":{"text":"你进门几日，就～叫我，我是你手里使的人也怎的？","book":"《金瓶梅词话》第九一回"},"similar":["指名道姓","提名道姓"],"usage":"作谓语、宾语；指直呼他人姓名"},{"id":47102,"word":"颜丹鬓绿","pinyin":"yán dān bìn lǜ","abbr":"ydbl","explanation":"面红，头发黑。形容年少之貎。","source":{"text":"酌我五石云母钟，我能令公颜丹鬓绿而与年少争光风。","book":"清·龚自珍《能令公少年行》"},"example":{"text":"我乡我土大有好山水，犹能令我～，不复齿发嗟调零。","book":"清·黄遵宪《放歌用前韵》"},"usage":"作谓语、定语；用于书面语"},{"id":47103,"word":"颜筋柳骨","pinyin":"yán jīn liǔ gǔ","abbr":"yjlg","explanation":"颜：唐代书法家颜真卿；柳：唐代书法家柳公权。指颜柳两家书法挺劲有力，但风格有所不同。也泛称书法极佳。","source":{"text":"曼卿之笔，颜筋柳骨。","book":"宋·范仲淹《祭石学士文》"},"example":{"text":"却是断肠诗词，堪为字史，～，献之、羲之。","book":"元·关汉卿《普天乐·喜得家书》"},"similar":["颜骨柳筋"],"usage":"作宾语、定语；指书法"},{"id":47104,"word":"颜精柳骨","pinyin":"yán jīng liǔ gǔ","abbr":"yjlg","explanation":"指颜柳两家书法挺劲有力，但风格有所不同。也泛称书法极佳。同“颜筋柳骨”。","source":{"text":"曼卿之笔，颜精柳骨，散落人间，宝为神物。","book":"宋·范仲淹《祭石学士文》"},"similar":["颜骨柳筋","颜筋柳骨"],"usage":"作宾语、定语；指书法"},{"id":47105,"word":"颜面扫地","pinyin":"yán miàn sǎo dì","abbr":"ymsd","explanation":"比喻面子丧失干净。","source":{"text":"戴过一次高帽子的，从此颜面扫地，做不起人。","book":"毛泽东《湖南农民运动考察报告》"},"usage":"作谓语、定语；用于处世"},{"id":47106,"word":"颜骨柳筋","pinyin":"yán gǔ liǔ jīn","abbr":"yglj","explanation":"颜：唐代书法家颜真卿；柳：唐代书法家柳公权。指颜柳两家书法挺劲有力，但风格有所不同。也泛称书法极佳。","source":{"text":"曼卿之笔，颜筋柳骨。","book":"宋·范仲淹《祭石学士文》"},"example":{"text":"此书～，无一笔不合法。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"similar":["颜精柳骨","颜筋柳骨"],"usage":"作宾语、定语；指书法"},{"id":47107,"word":"额外主事","pinyin":"é wai zhǔ shì","abbr":"ewzs","explanation":"明清时为各部司员的低级官吏。一般由没有考中庶吉士的进士充任，也可以由皇帝赏赐。"},{"id":47108,"word":"额手加礼","pinyin":"é shǒu jiā lǐ","abbr":"esjl","explanation":"表示敬意。","source":{"text":"外人之额手加礼者，今且相与鄙夷。","book":"章炳麟《与上海国民党函》"},"usage":"作谓语、定语；表示敬意"},{"id":47109,"word":"额手相庆","pinyin":"é shǒu xiāng qìng","abbr":"esxq","explanation":"把手放在额上，表示庆幸。同“额手称庆”。","source":{"text":"泥金高揭，邻里喧哗，挤庭下几满。喜极入告，额手相庆。","book":"清·王韬《淞滨琐话·卢双月》"},"example":{"text":"不抵抗将军下台，上峰易人，我士兵莫不～。","book":"鲁迅《伪自由书·“有名无实”的反驳》"},"similar":["额手称颂","额手称庆"],"usage":"作宾语、谓语、定语、状语；指令人称快的事"},{"id":47110,"word":"额手称庆","pinyin":"é shǒu chēng qìng","abbr":"escq","explanation":"额手：以手加额。把手放在额上，表示庆幸。","source":{"text":"文公至绛，国人无不额手称庆。百官朝贺，自不必说。","book":"明·冯梦龙《东周列国志》第三十七回"},"example":{"text":"他“～”，实在高兴得太快了。","book":"鲁迅《伪自由书·“有名无实”的反驳》"},"similar":["欣喜若狂","额手相庆"],"opposite":["垂头丧气"],"usage":"作宾语、谓语、定语、状语；指令人称快的事","story":["宋朝时期，司马光因著《资治通鉴》而名垂青史。他成为翰林学士，与王安石是好朋友，但不支持王安石变法，只好辞职去洛阳著书。宋哲宗即位后，司马光回京任尚书左仆射，人们额手称庆。司马光上任后马上废除新法，把王安石给气死了"]},{"id":47111,"word":"额手称颂","pinyin":"é shǒu chēng sòng","abbr":"escs","explanation":"把手放在额上，表示庆幸。同“额手称庆”。","source":{"text":"须臾，任公等喜孜孜的陆续了出来，诉说所以，没一个不咋舌惊叹，如醉如梦，额手称颂，欣喜欲狂。","book":"《野叟曝言》第五七回"},"example":{"text":"然至军国大计所关，及用人之尤重大者，孝贞偶行一事，人皆～。","book":"徐珂《清稗类钞·宫闱·孝贞后娴礼法》"},"similar":["额手称庆","额手相庆"],"usage":"作宾语、谓语、定语、状语；指令人称快的事"},{"id":47112,"word":"额蹙心痛","pinyin":"é cù xīn tòng","abbr":"ecxt","explanation":"极度忧愁伤心的样子。","source":{"text":"《渔阳》意气，泉路难灰，世人假慈悲学大菩萨，而勤王断国之徒，多在涂脂调粉之辈，此文长所为额蹙心痛者乎。","book":"明天放道人《〈四声猿〉序》"},"opposite":["兴高采烈"],"usage":"作谓语、定语；指人伤心痛苦"},{"id":47113,"word":"额首称庆","pinyin":"é shōu chēng qìng","abbr":"escq","explanation":"把手放在额上，表示庆幸。"},{"id":47114,"word":"颠三倒四","pinyin":"diān sān dǎo sì","abbr":"dsds","explanation":"三、四：表示杂乱。形容说话做事错杂紊乱。","source":{"text":"连拜了三四日，就把子牙拜的颠三倒四，坐卧不安。","book":"明·许仲琳《封神演义》第四十四回"},"example":{"text":"奶奶年岁大了，做起事来常常是～的。"},"similar":["语无伦次","乱七八糟","杂乱无章"],"opposite":["有条不紊","井然有序","有条有理"],"usage":"作谓语、定语、状语；指人说话"},{"id":47115,"word":"颠乾倒坤","pinyin":"diān qiān dǎo kūn","abbr":"dqdk","explanation":"乾坤：指天地。能把天地颠倒。形容本领非常大。","source":{"text":"我平生有个癖见，以为天地间最可宝贵的是两种人物，都是龙跳虎踞的精神，颠乾倒坤的手段，你道是什么呢？","book":"清·曾朴《孽海花》第十二回"},"similar":["颠倒乾坤"],"usage":"作谓语、定语、宾语；指人的本事"},{"id":47116,"word":"颠仆流离","pinyin":"diān pú liú lí","abbr":"dpll","explanation":"由于灾荒或战乱而流转离散。形容生活艰难，四处流浪。同“颠沛流离”。","source":{"text":"己酉冬，金自江西犯饶信，所在居民皆空城去，颠仆流离道上。","book":"宋·叶梦得《避暑录话》卷下"},"similar":["颠沛流离"],"usage":"作谓语、定语、状语；用于人的处境等"},{"id":47117,"word":"颠倒乾坤","pinyin":"diān dǎo qián kūn","abbr":"ddqk","explanation":"比喻本领十分高强。","source":{"text":"以为天地间最可宝贵的是两种人物，都是有龙跳虎踞的精神，颠倒乾坤的手段，你道是什么呢？","book":"曾朴《孽海花》第12回"},"example":{"text":"我没有～的本领。"},"similar":["颠乾倒坤"],"usage":"作谓语、定语；指人的本事"},{"id":47118,"word":"颠倒干坤","pinyin":"diān dǎo gàn kūn","abbr":"ddgk","explanation":"比喻本领十分高强。"},{"id":47119,"word":"颠倒是非","pinyin":"diān dǎo shì fēi","abbr":"ddsf","explanation":"是：对；非：错。把错的说成对的，对的说成错的。把是非弄颠倒了。","source":{"text":"古圣人言，其旨密微，笺注纷罗，颠倒是非。","book":"唐·韩愈《施先生墓铭》"},"example":{"text":"我们希望这种～的时代快些过去。","book":"毛泽东《论联合政府》"},"similar":["混淆是非","指鹿为马","颠倒黑白"],"opposite":["实事求是"],"usage":"作谓语、定语；指故意颠倒"},{"id":47120,"word":"颠倒衣裳","pinyin":"diān dǎo yī cháng","abbr":"ddyc","explanation":"颠倒：上下倒置；衣裳：古时上为衣，下为裳。形容匆忙而乱了顺序。","source":{"text":"东方未明，颠倒衣裳。颠之倒之，自公召之。","book":"《诗经·齐风·东方未明》"},"example":{"text":"夜则废寝，昼则忘餐。～，不知所措。","book":"元·董解元《西厢记诸宫调》卷一"},"similar":["颠衣到裳"],"usage":"作谓语、定语；形容匆忙而乱了顺序"},{"id":47121,"word":"颠倒错乱","pinyin":"diān dǎo cuò luàn","abbr":"ddcl","explanation":"颠倒：本末倒置；错乱：错杂混乱。把本来的顺序完全搞乱，完全失去正常状态。","source":{"text":"玄析之为三，颠倒错乱，皆率胸臆，曾无典据，何足可凭。","book":"《旧唐书·礼仪志一》"},"example":{"text":"今则疾病侵陵，精神恍惚，～，如痴如醉。","book":"宋·袁燮《絜斋集·乞归田里状》"}},{"id":47122,"word":"颠倒阴阳","pinyin":"diān dǎo yīn yáng","abbr":"ddyy","explanation":"犹言颠倒是非，混淆黑白。","source":{"text":"那人王乃四海九州之主，代天宣化，岂肯颠倒阴阳，强人所难？","book":"清·李汝珍《镜花缘》第二回"},"example":{"text":"我们不能干～的事情。"},"similar":["颠倒是非","混淆黑白"],"usage":"作谓语、宾语、定语；同“颠倒是非”"},{"id":47123,"word":"颠倒黑白","pinyin":"diān dǎo hēi bái","abbr":"ddhb","explanation":"把黑的说成白的，白的说成黑的。比喻歪曲事实，混淆是非。","source":{"text":"变白以为黑兮，倒上以为下。","book":"战国·楚·屈原《九章·怀沙》"},"example":{"text":"终日终夜，只是躺在烟铺上，公事大小，一概不问，任着幕宾胥使，～。","book":"清·彭养鸥《黑籍冤魂》第七回"},"similar":["颠倒是非","混淆是非","指鹿为马"],"opposite":["实事求是"],"usage":"作谓语、定语；指故意的","story":["战国时期著名的诗人屈原深得楚怀王的信赖，他对内主张改革，对外采取联齐抗秦，引起贵族上官大夫靳尚和令尹子兰的不满，他们颠倒黑白，恶意中伤和诬陷屈原，使得屈原被流放到湘水地区，屈原报国无门，只好投江而死"]},{"id":47124,"word":"颠唇簸嘴","pinyin":"diān chún bò zuǐ","abbr":"dcbz","explanation":"指搬弄口舌。","source":{"text":"王家若男若女，若大若小，那一个不欣羡潘小官人美貌，如潘安再出，暗暗地颠唇簸嘴，批点那飞天夜叉之丑。","book":"《醒世恒言·两县令竞义婚孤女》"},"similar":["搬嘴递舌","搬弄是非"],"usage":"作谓语、宾语、定语；用于处事"},{"id":47125,"word":"颠头播脑","pinyin":"diān tóu bō nǎo","abbr":"dtbn","explanation":"点头晃脑。多用以表示赞同、赞赏。","source":{"text":"马上说同心，止不住颠头播脑。","book":"《英烈传》第十九回"},"example":{"text":"后来看见信里有‘渭阳’两个字，不觉～，反而称赞这位文案有才情。","book":"清·李宝嘉《官场现形记》第四十二回"},"similar":["颠头簸脑","颠头耸脑"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":47126,"word":"颠头簸脑","pinyin":"diān tóu bǒ nǎo","abbr":"dtbn","explanation":"头部上下晃动摆动。","source":{"text":"那老头儿拄了拐杖儿，颠头簸脑走了进来。","book":"明·杨尔曾《韩湘子全传》第六回"},"example":{"text":"从今那复容高傲？免不得改稿上～，说堂时垂手呵腰。","book":"清·戴璐《藤阴杂记·韩春湖》"},"similar":["颠头播脑","颠头耸脑"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":47127,"word":"颠头耸脑","pinyin":"diān tóu sǒng nǎo","abbr":"dtsn","explanation":"点头晃脑。多用以表示赞同、赞赏。同“颠头播脑”。","source":{"text":"饭店中客人，个个颠头耸脑，看他说他，胡猜乱语。","book":"明·凌濛初《初刻拍案惊奇》卷四"},"similar":["颠头播脑","颠头簸脑"],"usage":"作谓语、定语、状语；用于人的神态"},{"id":47128,"word":"颠寒作热","pinyin":"diān hán zuò rè","abbr":"dhzr","explanation":"一会儿嫌冷，一会又嫌热。形容喜怒无常，故作娇态。","source":{"text":"话说潘金莲在家，侍宠生娇，颠寒作热，镇日夜不得个宁静。","book":"明·兰陵笑笑生《金瓶梅词话》第十一回"},"example":{"text":"那赵玉娥正在妙龄，那李管营怎能遂其所欲？因此一味～，撒娇撒痴。","book":"清·陈忱《水浒后传》第四回"}},{"id":47129,"word":"颠扑不破","pinyin":"diān pū bù pò","abbr":"dpbp","explanation":"颠：跌；扑：敲。无论怎样摔打都破不了。比喻理论学说完全正确，不会被驳倒推翻。","source":{"text":"既能体之而乐，则亦不患不能守，须如此而言，方是颠扑不破，绝渗漏，无病败耳。","book":"《朱子全书·性理三》"},"example":{"text":"何况六斤比伊的的曾祖，少了三斤，比伊的父亲七斤，又少了一斤，这真是一条～的实例。","book":"鲁迅《呐喊·风波》"},"similar":["牢不可破","无可辩驳","勿庸置疑"],"opposite":["不堪一击","不攻自破","荒谬绝伦"],"usage":"作谓语、定语；用于理论、学说等"},{"id":47130,"word":"颠扑不碎","pinyin":"diān pū bù suì","abbr":"dpbs","explanation":"颠：跌到；扑：拍打。无论怎样摔打都破碎不了。比喻理论、学说完全正确，无可辩驳。","source":{"text":"天地间只一个‘诚’字，更颠扑不碎。","book":"宋·文天祥《西间书院释菜讲义》"},"similar":["颠扑不破","颠扑不磨"],"usage":"作谓语、定语；用于理论、学说等"},{"id":47131,"word":"颠扑不磨","pinyin":"diān pū bù mó","abbr":"dpbm","explanation":"比喻道理正确，推翻不了。同“颠扑不破”。","source":{"text":"这样说来，那个平民主义，正是战则必胜的公理，你不信，试看将来不远的，便应有一个穷源反本，颠扑不磨的定论。","book":"清·岭南羽衣女士《东欧女豪杰》第三回"},"similar":["颠扑不破","颠扑不碎"],"usage":"作谓语、定语；用于理论、学说等"},{"id":47132,"word":"颠斤播两","pinyin":"diān jīn bō liǎng","abbr":"djbl","explanation":"较量轻重。常用以比喻品评优劣或形容计较微细之事。","source":{"text":"起先不过房里院外吐些颠斤播两的说话，讥刺几句，使如玉知道。","book":"《绿野仙踪》第四四回"},"similar":["掂斤播两"],"usage":"作谓语、定语；形容过分计较"},{"id":47133,"word":"颠来倒去","pinyin":"diān lái dǎo qù","abbr":"dldq","explanation":"翻过来倒过去，来回重复。","source":{"text":"将简帖儿掂，将妆盒儿按，开拆封皮孜孜看，颠来倒去不害心烦。","book":"元·王实甫《西厢记》第三本第二折"},"example":{"text":"这天鲁总爷买着便宜货，心上非常之喜，～看了几遍，连说便宜。","book":"清·李宝嘉《官场现形记》第十六回"},"similar":["反反复复","颠三倒四"],"usage":"作谓语、定语；指来回重复"},{"id":47134,"word":"颠来播去","pinyin":"diān lái bō qù","abbr":"dlbq","explanation":"连续、反覆地颠簸。同“颠来簸去”。","source":{"text":"我们只能把性命先保住，随着波浪颠来播去便了。","book":"许地山《空山灵雨·海》"},"similar":["颠来簸去"],"usage":"作宾语、状语；指不平稳"},{"id":47135,"word":"颠来簸去","pinyin":"diān lái bǒ qù","abbr":"dlbq","explanation":"连续、反覆地颠簸。","source":{"text":"车子虽然走得慢，但是震动得十分厉害，把站立的客人颠来簸去。","book":"巴金《发的故事·星七》"},"similar":["颠来播去"],"usage":"作宾语、状语；指不平稳"},{"id":47136,"word":"颠毛种种","pinyin":"diān máo zhǒng zhǒng","abbr":"dmzz","explanation":"指衰老。","source":{"text":"余发如此种种，余奚能为？","book":"春秋·鲁·左丘明《左传·昭公三年》"},"example":{"text":"仆年过五十，～，一身百病。","book":"明·唐顺之《答王鉴川兵备书》"},"usage":"作谓语；借指衰老"},{"id":47137,"word":"颠沛流离","pinyin":"diān pèi liú lí","abbr":"dpll","explanation":"颠沛：跌倒，比喻穷困，受挫折；流离：浪落。由于灾荒或战乱而流转离散。形容生活艰难，四处流浪。","source":{"text":"窃见关东困极，人民流离。","book":"《诗经·大雅·荡》：“人亦有言，颠沛之揭。”《汉书·薛广德传》"},"example":{"text":"我所感到悲哀的，是有几个同我来的学生，至今还找不到学校进，还在～。","book":"鲁迅《而已集·通信》"},"similar":["流离失所","流离转徒"],"opposite":["安家立业","安家落户","安居乐业"],"usage":"作谓语、定语、状语；用于人的处境等"},{"id":47138,"word":"颠簸不破","pinyin":"diān bǒ bù pò","abbr":"dbbp","explanation":"无论怎样摔打都破不了。比喻理论学说完全正确，不会被驳倒推翻。同“颠扑不破”。","source":{"text":"伊川（程颐）‘性即理也’，横（张载）‘心统性情’二句，颠簸不破！","book":"《朱子语类》卷五"},"example":{"text":"‘干部决定一切’，这是句～的至理名言。","book":"邹韬奋《事业管理与职业修养·关于干部与待遇二》"},"similar":["颠扑不破","颠扑不碎"],"usage":"作谓语、定语；用于理论、学说等"},{"id":47139,"word":"颠衣到裳","pinyin":"diān yī dào shang","abbr":"dyds","explanation":"到，通“倒”。形容匆忙而乱了顺序。同“颠倒衣裳”。","source":{"text":"次六。升于堂，颠衣到裳，廷人不庆。","book":"汉·扬雄《太玄·上》"},"similar":["颠倒衣裳"],"usage":"作谓语；形容匆忙而乱了顺序"},{"id":47140,"word":"颠越不恭","pinyin":"diān yuè bù gōng","abbr":"dybg","explanation":"颠越：陨坠，损害；恭：恭敬。指损害礼法，对上命不恭。","source":{"text":"乃有不吉不迪颠越不恭，暂遇奸宄，我乃劓殄灭之，无遗余。","book":"《尚书·盘庚中》"}},{"id":47141,"word":"颠连无告","pinyin":"diān lián wú gào","abbr":"dlwg","explanation":"颠连：困苦；告：告借。生活困苦又无处借贷。","source":{"text":"凡天下疲癃残疾，惸独鳏寡，皆吾兄弟之颠连无告者也。","book":"宋·张载《西铭》"},"example":{"text":"乞贪～之民，免其南北运库子马役解尸之类，此亦可以少纾目前之急也。","book":"明归有光《论三区赋役水利书》"},"similar":["告贷无门"],"usage":"作谓语、定语；指穷困"},{"id":47142,"word":"颠连穷困","pinyin":"diān lián qióng kùn","abbr":"dlqk","explanation":"颠连：困苦。形容非常贫穷困苦。","source":{"text":"连阡累陌，一片荆榛，居民间有孑遗，颠连穷困之状，有不能殚述者。","book":"范文澜《中国近代史》上册第三章"},"usage":"作谓语、定语；指穷困"},{"id":47143,"word":"颠颠倒倒","pinyin":"diān diān dǎo dǎo","abbr":"dddd","explanation":"①指神思迷糊错乱。②指事情不顺或言行无条理，不可置信。","source":{"text":"彼此夙缘，颠颠倒倒，皆非偶然也。","book":"《朱子全书》卷六：“向时有一截学者贪多务得，要读《周礼》、诸史、本朝典故，一向尽要理会，得许多没紧要底工夫，少刻，自己都恁自地颠颠倒倒，没顿放处。”《二刻拍案惊奇》卷十七"},"example":{"text":"这老头儿还读过四书五经，可是教出这些个儿女来——全做些～的事！","book":"张天翼《儿女们》二"},"usage":"作谓语、定语、状语；用于人或事物等"},{"id":47144,"word":"颠鸾倒凤","pinyin":"diān luán dǎo fèng","abbr":"dldf","explanation":"比喻顺序失常。旧小说用来形容男女交欢。","source":{"text":"朝镜惜蹉跎，一年年来日无多，无情六合乾坤里，颠鸾倒凤，撑庭裂月，直被消磨。","book":"金·元好问《捉伯丑奴儿》词"},"example":{"text":"你绣帷里效绸缪，～百事有。","book":"元·王实甫《西厢记》第四本第二折"},"similar":["倒凤颠鸾"],"usage":"作谓语；比喻顺序失常"},{"id":47145,"word":"颤颤巍巍","pinyin":"chàn chàn wēi wēi","abbr":"ccww","explanation":"震颤而动作不准确的样子。","source":{"text":"贾母扶着小丫头，颤颤巍巍站起来，答应道：‘托娘娘洪福，起居尚健。’","book":"清·曹雪芹《红楼梦》第83回"},"example":{"text":"路遥《平凡的世界》第六卷第35章：“玉厚老汉说着，便从衣服大襟的口袋里～拿出了一捆子人民币，放在儿子家的炕席片上。”"},"usage":"作定语、状语；多用于老年人"},{"id":47146,"word":"颦有为颦，笑有为笑","pinyin":"pín yǒu wéi pín，xiǎo yǒu wéi xiào","abbr":"pywpxywx","explanation":"颦：愁眉苦脸。指或哭或笑，都有其原因。","source":{"text":"吾闻明主之爱一嚬一笑，嚬有为嚬，而笑有为笑。","book":"《韩非子·内储说上》"},"example":{"text":"所以古人云：～。颦笑之间，最宜谨慎。","book":"明·冯梦龙《醒世恒言》卷三十三"}},{"id":47147,"word":"颦眉蹙頞","pinyin":"pín méi cù è","abbr":"pmce","explanation":"颦：皱；蹙：收缩；頞：鼻梁。皱眉毛、缩鼻子。形容愁苦的样子。","source":{"text":"举疾首蹙頞而相告。","book":"《孟子·梁惠王下》"}},{"id":47148,"word":"风不鸣条","pinyin":"fēng bù míng tiáo","abbr":"fbmt","explanation":"和风轻拂，树枝不发出声响。比喻社会安定。","source":{"text":"风不鸣条，雨不破块，五日一风，十日一雨。","book":"汉·桓宽《盐铁论·水旱》：“周公载纪而天下太平，国无夭伤，岁无荒年。当此之时，雨不破塊，风不鸣条。”汉·王充《论衡·是应》"},"example":{"text":"却道数十年，真是五日一风，十日一雨，～，雨不破块，夜湿昼晴，信是太平有象。","book":"《醒世姻缘》第二十四回"},"usage":"作定语、补语；比喻社会安定"},{"id":47149,"word":"风不鸣条，雨不破块","pinyin":"fēng bù míng tiáo，yǔ bù pò kuài","abbr":"fbmtybpk","explanation":"鸣：发出声响；条：新生的柳枝；破：冲破；块：土块。没有大风吹响树枝，没有暴雨伤害农田。比喻社会安定，风调雨顺。","source":{"text":"风不鸣条，雨不破块，五日一风，十日一雨。","book":"汉·王充《论衡·是应》"}},{"id":47150,"word":"风丝不透","pinyin":"fēng sī bù tòu","abbr":"fsbt","explanation":"透：通过，穿过。风刮不进，雨透不过。形容封闭十分紧密。","source":{"text":"村庄本不甚大，三百名官兵……团圆周匝，围得风丝不透。","book":"清·李绿园《歧路灯》第91回"},"similar":["密不透风","风雨不透"],"usage":"作状语；用于比喻句"},{"id":47151,"word":"风中之烛","pinyin":"fēng zhōng zhī zhú","abbr":"fzzz","explanation":"在风里晃动的烛光。比喻随时可能死亡的老年人。也比喻随时可能消灭的事物。","source":{"text":"时年五十有三，或恐风烛奄及，聊遗教于子孙耳。","book":"晋·王羲之《题卫夫人笔陈图后》"},"example":{"text":"老拙夫妇年近七旬，如～，早暮难保。","book":"明·冯梦龙《醒世恒言》卷十"},"similar":["风中残烛","风烛残年"],"usage":"作宾语；比喻临近死亡的人或事物"},{"id":47152,"word":"风中秉烛","pinyin":"fēng zhōng bǐng zhú","abbr":"fzbz","explanation":"秉：拿着。风中拿着烛易灭。比喻临近死亡的人或行将消灭的事物。","source":{"text":"我将世事都参透，幻身躯似风中秉烛，可怜见便似兀那水上浮沤。","book":"元·无名氏《海门张仲村乐堂》第一折"},"similar":["风中之烛"],"usage":"作宾语、定语；指即将消灭的事物"},{"id":47153,"word":"风举云摇","pinyin":"fēng jǔ yún yáo","abbr":"fjyy","explanation":"凭借风云飞腾而上。亦比喻飞黄腾达。","source":{"text":"风举云摇，历神都而一憩。","book":"汉·班固《西都赋》：“遂乃风举云摇，浮游溥览。”唐·王勃《九成宫颂》"},"example":{"text":"赐金分帛奉恩辉，～人紫微。","book":"唐·宋之问《桂州三月三日》诗"},"similar":["风举云飞"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":47154,"word":"风举云飞","pinyin":"fēng jǔ yún fēi","abbr":"fjyf","explanation":"凭借风云飞腾而上。同“风举云摇”。","source":{"text":"神驾来思，风举云飞。","book":"《宋史·乐志七 》"},"similar":["风举云摇"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":47155,"word":"风云万变","pinyin":"fēng yún wàn biàn","abbr":"fywb","explanation":"风云：比喻变化动荡的局势。像风云那样变化不定。比喻局势复杂，变化迅速，难以预料。","source":{"text":"风云万变一瞬息，红尘奔走真徒劳。","book":"宋·胡宏《题上封寺》"},"example":{"text":"世界局势～，我们还是好好保护自己。"},"similar":["风云变幻"],"usage":"作谓语、宾语、定语；形容自然及局势的变化"},{"id":47156,"word":"风云不测","pinyin":"fēng yún bù cè","abbr":"fybc","explanation":"比喻变幻莫测的局势。","source":{"text":"谁知好事多磨，风云不测，台谏官员看见同佥富豪宕，上本参论他赃私，奉旨发下西台御史，免不得收下监中。","book":"《初刻拍案惊奇》卷九"},"example":{"text":"战乱动荡时期，～，人们皆有朝不保夕之感。"},"usage":"作宾语、定语；用于口语"},{"id":47157,"word":"风云之志","pinyin":"fēng yún zhī zhì","abbr":"fyzz","explanation":"像风云那样雄大高远的志向。","source":{"text":"始游庠塾，不无儒者之荣；或见兵书，遂有风云之志。","book":"北周·庚信《周兖州剌史广饶公宇文公神道碑》"},"example":{"text":"吾少无～，因官至此，不图此郡士人忽尔见推。","book":"《晋书·凉武昭王李玄盛传》"},"usage":"作宾语；指志向远大"},{"id":47158,"word":"风云人物","pinyin":"fēng yún rén wù","abbr":"fyrw","explanation":"指活跃一时，言论行为能影响大局的人物。","source":{"text":"被马歇尔看中，做了驻华大使，成为马歇尔系统中的风云人物之一。","book":"毛泽东《别了，司徒雷登》"},"example":{"text":"这班人虽然能成为一时～，却未必能成就大事。","book":"姚雪垠《李自成》第一卷第28章"},"similar":["风流人物"],"opposite":["无名小卒","无名鼠辈"],"usage":"作主语、宾语、定语；指影响大局的人物"},{"id":47159,"word":"风云会合","pinyin":"fēng yún huì hé","abbr":"fyhh","explanation":"风云：指难得的好机会；会合：遇合。比喻有能力的人遇上好机会。","source":{"text":"一旦风云会合……便可以坐福一世苍生。","book":"宋·陈亮《与陈君举》"},"similar":["风云际会","风云际遇"],"usage":"作谓语、定语、分句；比喻能人遇到机会"},{"id":47160,"word":"风云变幻","pinyin":"fēng yún bià huàn","abbr":"fybh","explanation":"象风云那样变化不定。比喻时局变化迅速，动向难以预料。","source":{"text":"年代殊之民俗，风云更盛衰。","book":"南朝·梁·庾信《入彭城馆》诗"},"example":{"text":"然而那么～的事，恐怕世界上是不多有的，我没有料到，未曾描写，可见我还不很有“毒笔”。","book":"鲁迅《三闲集·通信》"},"similar":["风云突变","云谲风诡"],"opposite":["一成不变"],"usage":"作谓语、宾语、定语；形容自然及局势的变化"},{"id":47161,"word":"风云变态","pinyin":"fēng yún biàn tài","abbr":"fybt","explanation":"变态：改变常态。风云改变常态。形容诗文变化多姿。","source":{"text":"风云变态，花草精神，海之波澜，山之嶙峋。","book":"唐·司空图《二十四诗品·形容》"},"example":{"text":"先生之文，日丽春敷，～。","book":"清·方宗诚《桐城文录序》"},"similar":["风云变幻"],"usage":"作定语、谓语；形容诗文变化多姿"},{"id":47162,"word":"风云变色","pinyin":"fēng yún bià sè","abbr":"fybs","explanation":"风和云都吓得改变了颜色。形容声威极大。","source":{"text":"喑鸣则山岳崩颓，叱咤则风云变色。","book":"唐·骆宾王《为徐敬业讨武瞾檄》"},"example":{"text":"而绥远之西，阿拉善和额济纳蒙古一带，也在酝酿着～。","book":"范长江《塞上行·行纪·忆西蒙》"},"usage":"作宾语、定语；用于局势等"},{"id":47163,"word":"风云叱咤","pinyin":"fēng yún chì zhà","abbr":"fycz","explanation":"叱咤：发怒吆喝。一声呼喊、怒喝，可以使风云变色。形容声势威力极大。","source":{"text":"我军威宣播，风云叱咤呼。","book":"明·吾丘瑞《运甓记·广州运甓》"},"example":{"text":"医生的老婆～地一路走回来，门大声地响着，碰倒了一张凳子，又踩住了自己的被子。","book":"丁玲《在医院中》"},"similar":["叱咤风云"],"usage":"作宾语、定语；形容有重大影响力的人"},{"id":47164,"word":"风云开阖","pinyin":"fēng yún kāi hé","abbr":"fykh","explanation":"阖：关闭；开：散开。风和云聚散变化不定。比喻局势动荡不安。","source":{"text":"盖亭之所见，南北百里，东西一舍。波澜汹涌，风云开阖。","book":"宋·苏辙《黄州快哉亭记》"},"usage":"作宾语、定语；用于局势等"},{"id":47165,"word":"风云月露","pinyin":"fēng yún yuè lù","abbr":"fyyl","explanation":"指绮丽浮靡，吟风弄月的诗文。","source":{"text":"连篇累牍，不出月露之形，积案盈箱，唯是风云之状。","book":"《隋书·李谔传》"},"example":{"text":"必有补于世道，贤于～之作远矣。","book":"宋·刘克庄《题董朴发干文藁》"},"usage":"作宾语；指绮丽浮靡，吟风弄月的诗文"},{"id":47166,"word":"风云突变","pinyin":"fēng yún tū biàn","abbr":"fytb","explanation":"风云：比喻变幻动荡的局势。局势突然发生了变化。","source":{"text":"风云突变，军阀重开战。洒向人间都是怨，一枕黄粱再现。","book":"毛泽东《清平乐·蒋桂战争》词"},"example":{"text":"在这～的时刻，我们最好要把握方向。"},"similar":["风云变幻","风云万变"],"opposite":["一成不变"],"usage":"作谓语、定语、宾语、状语；指政局等"},{"id":47167,"word":"风云际会","pinyin":"fēng yún jì huì","abbr":"fyjh","explanation":"风云：比喻难得的机会；际会：遇合。比喻有能力的人遇上好机会。","source":{"text":"良辅超拔于际会。","book":"《周易·乾·文言》：“云从龙，风从虎，圣人作万物睹。”汉·王充《论衡·偶会》"},"example":{"text":"盖圣上既奉天运承了大统，天下闺中自应广育英才，以为辅弼，亦如古之八元、八恺，～。","book":"清·李汝珍《镜花缘》第五回"},"similar":["高朋满座","胜友如云"],"opposite":["狭路相逢","冤家路窄"],"usage":"作谓语、定语、分句；比喻能人遇到机会"},{"id":47168,"word":"风云际遇","pinyin":"fēng yún jì yù","abbr":"fyjy","explanation":"风云：指难得的好机会；际遇：遭遇。比喻有能力的人遇上好机会。","source":{"text":"其实自古为良相的并不是都从举业出身，一靠自己确实有经济之才，二靠风云际遇耳。","book":"姚雪垠《李自成》第一卷第26章"},"similar":["风云际会","风云会合"],"usage":"作谓语、定语、分句；比喻能人遇到机会"},{"id":47169,"word":"风从响应","pinyin":"fēng cóng xiǎng yìng","abbr":"fcxy","explanation":"风从：顺风而从。闻风而动，呼应迅速。","source":{"text":"无有远迩，风从响应，载考载稽，名实相称。","book":"宋·邵博《闻见后录》"},"example":{"text":"内之君臣，习尚如此，则外而抚按守令之官，～。","book":"《明史·刘安传》"},"usage":"作谓语、宾语；用于事物等"},{"id":47170,"word":"风从虎，云从龙","pinyin":"fēng cóng hǔ，yún cóng lóng","abbr":"fchycl","explanation":"比喻事物之间的相互感应。","source":{"text":"同声相应，同气相求。水流湿，火就燥。云从龙，风从虎。圣人作而万物睹。","book":"《周易·乾》"},"example":{"text":"其余揭竿而呼，争先刺秦者如林如薮，于时乱浩浩，兵憧憧，～，三灵昏而四海空。","book":"唐·李观《项籍碑铭》"},"similar":["风虎云龙"],"usage":"作定语、分句；比喻事物之间的相互感应"},{"id":47171,"word":"风仪严峻","pinyin":"fēng yí yán jùn","abbr":"fyyj","explanation":"风仪：风度和仪容。风度仪容庄重严肃。"},{"id":47172,"word":"风俗习惯","pinyin":"fēng sú xí guàn","abbr":"fsxg","explanation":"个人或集体的传统风尚、礼节、习性。","source":{"text":"例如执行三大纪律八项注意，尊重藏民的风俗习惯、宗教信仰。","book":"邓小平《关于西南少数民族问题》"},"example":{"text":"我们到一个地方就要尊重当地的～。"},"similar":["风土人情"],"usage":"作宾语、定语；指传统风尚、礼节、习性"},{"id":47173,"word":"风俗人情","pinyin":"fēng sú rén qíng","abbr":"fsrq","explanation":"指一地相沿而成的风尚、礼节、习惯等。","source":{"text":"因言燕赵间山川夷险，教令风俗人情之所短长。","book":"唐·杜牧《唐故范阳卢秀才墓志》"},"example":{"text":"她问他关于日本的～。","book":"巴金《雾》"},"similar":["风土人情"],"usage":"作宾语；指风俗习惯等"},{"id":47174,"word":"风信年华","pinyin":"fēng xìn nián huá","abbr":"fxnh","explanation":"指女子二十四岁时。","source":{"text":"那轿中走出来一个风信年华的丽人，便是年羹尧的爱妾。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"她正值～，显得格外楚楚动人。"},"similar":["花信年华"],"usage":"作宾语、定语；指女性"},{"id":47175,"word":"风僝雨僽","pinyin":"fēng chá yǔ zhòu","abbr":"fcyz","explanation":"僝、僽：烦恼憔悴。形容历经磨难，十分烦恼憔悴。","source":{"text":"似这般风僝雨僽，到有个天长地久。更才子多情，佳人留意。","book":"明·徐复祚《红梨记·投雍》"},"example":{"text":"八十年兵燹，苦历半生，嫠纬痛，如一昔～。","book":"清·虞名《指南公·举义》"},"usage":"作宾语、定语；用于生活"},{"id":47176,"word":"风光旖旎","pinyin":"fēng guāng yǐ nǐ","abbr":"fgyn","explanation":"形容景色柔和美好。","source":{"text":"人们怎能不热爱这个风光旖旎的南国花市，怎能不从这个盛大的花市享受着生活的温馨呢！","book":"秦牧《花市》"},"example":{"text":"南国的春天～，使人陶醉。"},"usage":"作谓语、定语；指风景"},{"id":47177,"word":"风光月霁","pinyin":"fēng guāng yuè jì","abbr":"fgyj","explanation":"指雨过天晴时明净清新的景象。亦比喻胸襟开阔、心地坦白。","source":{"text":"风光月霁，是吾心太虚真境；鸟语花阴，是吾心无尽生意。","book":"明·苏濬《鸡鸣偶记》"},"usage":"作宾语、定语；用于比喻句"},{"id":47178,"word":"风兴云蒸","pinyin":"fēng xīng yún zhēng","abbr":"fxyz","explanation":"蒸：上升。大风刮起，乌云蒸腾。比喻事物迅速兴起，声势浩大。","source":{"text":"风兴云蒸，一龙一蛇与道翱翔，与时变化，夫岂守一节哉？","book":"南朝·宋·范晔《后汉书·冯衍传》"},"similar":["风起云蒸"],"usage":"作谓语；比喻声势浩大"},{"id":47179,"word":"风兵草甲","pinyin":"fēng bīng cǎo jiǎ","abbr":"fbcj","explanation":"犹言草木皆兵。","source":{"text":"况我兵惊恐，凡杯蛇鬼车，风兵草甲，无往非撼志之物。","book":"《水浒传》第九五回"},"similar":["草木皆兵"],"usage":"作宾语、定语；指人惊慌"},{"id":47180,"word":"风凉话","pinyin":"fēng liáng huà","abbr":"flh","explanation":"打消别人积极性的嘲讽话。","source":{"text":"况且没有把柄的事儿，给一个低三下四的奴才含血喷人，自己倒站着听风凉话儿！","book":"曾朴《孽海花》第18回"},"example":{"text":"当然，那些说～的人还在继续说着。","book":"路遥《平凡的世界》第六卷第35章"},"usage":"作主语、宾语、定语；用于口语"},{"id":47181,"word":"风刀霜剑","pinyin":"fēng dāo shuāng jiàn","abbr":"fdsj","explanation":"寒风象刀，严霜象剑。形容气候寒冷，刺人肌肤。也比喻恶劣的环境。","source":{"text":"一年三百六十日，风刀霜剑严相逼。","book":"清·曹雪芹《红楼梦》第十七回中林黛玉的《葬花辞》"},"similar":["风刀雪剑"],"usage":"作主语、宾语；指环境恶劣"},{"id":47182,"word":"风前月下","pinyin":"fēng qián yuè xià","abbr":"fqyx","explanation":"指良辰美景。","source":{"text":"借问风前兼月下，不知何客对胡床。","book":"唐·刘禹锡《洛中逢白监同话游梁之乐因寄宣武令孤相公》诗"},"example":{"text":"～抚心琴，龙吟虎啸来参侍。","book":"金·马钰《踏云行》"},"similar":["花前月下"],"usage":"作定语；指良辰美景"},{"id":47183,"word":"风前残烛","pinyin":"fēng qián cán zhú","abbr":"fqcz","explanation":"比喻随时可能死亡的老年人。也比喻随时可能消灭的事物。","source":{"text":"常言道，小不忍则乱大谋。我儿不可逞强。况我已是病弱之体，如那风前残烛，再也经不得事了。","book":"郭戈《金瓶梅传奇》第十七回"},"example":{"text":"他在～岁月里还不忘发挥余热。"},"similar":["风中残烛","风中之烛"],"usage":"作宾语、定语；用于比喻句"},{"id":47184,"word":"风华正茂","pinyin":"fēng huá zhèng mào","abbr":"fhzm","explanation":"风华：风采、才华；茂：旺盛。正是青春焕发、风采动人和才华横溢的时候。形容青年朝气蓬勃、奋发有为的精神面貌。","source":{"text":"恰同学年少，风华正茂；书生意气，挥斥方遒。","book":"毛泽东《沁园春·长沙》"},"example":{"text":"你们正处～的时代，应该好好学好知识。"},"similar":["年富力强","朝气勃勃","年轻有为"],"opposite":["老态龙钟","年逾古稀","风烛残年"],"usage":"作谓语、定语；指正当年"},{"id":47185,"word":"风华浊世","pinyin":"fēng huá zhuó shì","abbr":"fhzs","explanation":"指佼佼不凡。","source":{"text":"他一看，见是个风华浊世的佳公子，先觉得人如其文。","book":"清·文康《儿女英雄传》第36回"},"usage":"作定语；用于书面语"},{"id":47186,"word":"风华绝代","pinyin":"fēng huá jué dài","abbr":"fhjd","explanation":"风华：风采才华；绝代：冠绝当世。意思是风采才华为当世第一。","source":{"text":"时谢混风华为江左第一，尝与晦俱在武帝前，帝目之曰：‘一时顿有两玉人耳。’","book":"《南史·谢晦传》"},"usage":"作定语；指人的风采"},{"id":47187,"word":"风卷残云","pinyin":"fēng juǎn cán yún","abbr":"fjcy","explanation":"大风把残云卷走。比喻一下子把残存的东西一扫而光。","source":{"text":"风卷残云暮雪晴，红烟洗尽柳条轻。","book":"唐·戎昱《霁雪》"},"example":{"text":"叫一声“请！”一齐举箸，却如～一般，早去了一半。","book":"清·吴敬梓《儒林外史》第二回"},"similar":["横扫千军","风卷残雪"],"usage":"作宾语、定语、状语；比喻将残存的东西扫荡"},{"id":47188,"word":"风卷残雪","pinyin":"fēng juǎn cán xuě","abbr":"fjcx","explanation":"卷：收。大风把残存的雪卷走。比喻一下子把残存的东西扫荡干净。","source":{"text":"都一阵风卷残雪，吃了个精光，就忘了教平安儿吃。","book":"明·兰陵笑笑生《金瓶梅词话》第35回"},"similar":["风卷残云"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":47189,"word":"风发泉涌","pinyin":"fēng fā quán yǒng","abbr":"ffqy","explanation":"风发：形容迅速猛烈；涌：向上冒出。大风刮起，喷泉涌现。比喻多种力量或事物并发，发展迅速，声势大。","source":{"text":"两样功夫互乘，属题构思，竟成了风发泉涌。","book":"清·李绿园《歧路灯》第108回"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":47190,"word":"风口浪尖","pinyin":"fēng kǒu làng jiān","abbr":"fklj","explanation":"比喻激烈尖锐的社会斗争前哨。","source":{"text":"现在到了风口浪尖，是咱挺身的时候了，为了党，为了人民，为了抗日，一定要干出个英雄样来！","book":"向春《煤城怒火》第21章"},"example":{"text":"在这～上，我们要谨慎从事。"},"usage":"作宾语、定语；指斗争激烈的地方"},{"id":47191,"word":"风号雨泣","pinyin":"fēng háo yǔ qì","abbr":"fhyq","explanation":"风声像是怒号，雨声像是哭泣。渲染悲壮的气氛。","source":{"text":"或如风号雨泣，鸟悲兽骇，亡国之恨顿生。","book":"清·黄宗羲《柳敬亭传》"},"opposite":["风和日丽"],"usage":"作谓语、定语；指凄凉的气氛"},{"id":47192,"word":"风向草偃","pinyin":"fēng xiàng cǎo yǎn","abbr":"fxcy","explanation":"偃：卧倒，倒伏。风一吹草就倒下。比喻庶民被德教感化而顺从君主。也比喻有声望的人言行影响世态俗情。","source":{"text":"引用驽庸，以为党援，而望风向草偃，庶事之康，何异悬瓦砾而责夜光，弦不调而索清音哉！","book":"晋·葛洪《抱朴子·审举》"},"similar":["风行草偃","风行草从"],"usage":"作谓语、定语、分句；用于书面语"},{"id":47193,"word":"风吹云散","pinyin":"fēng chuī yún sàn","abbr":"fcys","explanation":"比喻事物的消失、完结。","source":{"text":"这事儿是风吹云散，往后谁也不许提啦！","book":"康濯《春种秋收》"},"usage":"作谓语、宾语；用于事物等"},{"id":47194,"word":"风吹日晒","pinyin":"fēng chuī rì shài","abbr":"fcrs","explanation":"狂风吹，烈日晒。形容无所遮挡。","source":{"text":"你风吹日晒地辛苦一年，连个痛快年也过不上。","book":"梁斌《红旗谱》二十七"},"example":{"text":"过去被忘却了的煤堆，～，现在忽然大家争着去把他团成煤球收藏起来。","book":"《路标》"},"similar":["风吹日炙"],"usage":"作宾语；用于口语"},{"id":47195,"word":"风吹日炙","pinyin":"fēng chuī rì zhì","abbr":"fcrz","explanation":"狂风吹，烈日晒。形容无所遮挡。","example":{"text":"这些岩石经过长时间的～，终于开始风化了。"},"similar":["风吹日晒"],"usage":"作宾语；用于书面语"},{"id":47196,"word":"风吹浪打","pinyin":"fēng chuī làng dǎ","abbr":"fcld","explanation":"比喻险恶的遭遇或严峻的考验。","source":{"text":"可怜一对鸳鸯，风吹浪打，直恁的遭强霸。","book":"清·洪昇《长生殿》第二十五出"},"example":{"text":"不管～，胜似闲庭信步。","book":"毛泽东《水调歌头·游泳》"},"similar":["风吹雨打","千锤百炼"],"opposite":["风平浪静","风和日丽"],"usage":"作宾语；与“经得住”等连用"},{"id":47197,"word":"风吹草动","pinyin":"fēng chuī cǎo dòng","abbr":"fccd","explanation":"风稍一吹，草就摇晃。比喻微小的变动。","source":{"text":"偷踪窃道，饮气吐声。风吹草动，即便藏形。","book":"《敦煌变文集·伍子胥变文》"},"example":{"text":"万一后边有些～，被人发觉，不要说道无颜面见令尊，传将出去，小生如何做得人成？","book":"明·凌濛初《二刻拍案惊奇》卷二十三"},"similar":["蛛丝马迹"],"usage":"作宾语、定语；与“有”等连用","story":["春秋时期，楚平王十分昏庸荒淫，竟霸占自己的儿媳妇，太子老师伍奢认为不妥被抓起来，楚平王命他写信叫回外地的儿子伍尚与伍员（伍子胥）。伍尚回去后与父亲被杀，伍子胥历尽艰辛，昼伏夜出，十分小心风吹草动，终于逃到吴国"]},{"id":47198,"word":"风吹雨打","pinyin":"fēng chuī yǔ dǎ","abbr":"fcyd","explanation":"原指花木遭受风雨摧残。比喻恶势力对弱小者的迫害。也比喻严峻的考验。","source":{"text":"不如醉里风吹尽，可忍醒时雨打稀。","book":"唐·杜甫《三绝句》"},"example":{"text":"不是夸大和开心，它本身就太轻飘，禁不起～的缘故吗？","book":"鲁迅《且介亭杂文二集·非有复译不可》"},"similar":["风吹浪打","千锤百炼"],"opposite":["风和日丽","风平浪静"],"usage":"作宾语；常与“管”、“怕”等词连用"},{"id":47199,"word":"风吹马耳","pinyin":"fēng chuī mǎ ěr","abbr":"fcme","explanation":"比喻对别人的话无动于衷。","source":{"text":"世人闻此皆掉头，有如东风射马耳。","book":"唐·李白《答王十二寒夜独酌有怀》诗"},"example":{"text":"我嘴皮都磨起茧巴，他都当成～。","book":"克非《春潮急》"},"usage":"作宾语、定语；用于比喻句"},{"id":47200,"word":"风和日丽","pinyin":"fēng hé rì lì","abbr":"fhrl","explanation":"和风习习，阳光灿烂。形容晴朗暖和的天气。","source":{"text":"是日风和日丽，众多官员，都来祭奠。","book":"元·李爱山《集贤宾·春日伤别》：“那时节和风丽日满东园，花共柳红娇绿软。”清·吴趼人《痛史》"},"example":{"text":"是时～，遍地金黄，青衫红袖，越阡度陌，蝶蜂乱飞，令人不饮自醉。","book":"清·沈复《浮生六记》卷二"},"similar":["风柔日暖"],"opposite":["风雨如晦","风雨交加"],"usage":"作谓语、定语、分句；形容晴朗暖和的天气"},{"id":47201,"word":"风和日暄","pinyin":"fēng hé rì xuān","abbr":"fhrx","explanation":"微风和畅，阳光温暖。见“风和日暖”。","source":{"text":"风和日暄，燕交飞触碎胭脂片。","book":"明·汪廷讷《狮吼记·赏春》"},"similar":["风和日暖"],"usage":"作谓语、定语；形容天气很好"},{"id":47202,"word":"风和日暖","pinyin":"fēng hé rì nuǎn","abbr":"fhrn","explanation":"风很平静，阳光暖人。","source":{"text":"不久，海上风和日暖。","book":"宋·刘斧《青琐高义·别集》卷二"},"example":{"text":"天生兄弟三人，送至外护，候素臣开船，见～，帆正波平，放心回岛。","book":"清·夏敬渠《野叟曝言》第八十回"},"similar":["风和日丽","风和日暄"],"opposite":["风雨交加"],"usage":"作谓语、定语；形容天气很好"},{"id":47203,"word":"风和日美","pinyin":"fēng hé rì měi","abbr":"fhrm","explanation":"微风和畅，阳光明丽。同“风和日丽”。","source":{"text":"风和日美，余掉短胕，老母揭女孙泛汝仇湖。","book":"清·黄宗羲《敬槐诸君墓志铭》"},"similar":["风和日丽","风暖日丽"],"usage":"作谓语、定语、分句；形容晴朗暖和的天气"},{"id":47204,"word":"风回电激","pinyin":"fēng huí diàn jī","abbr":"fhdj","explanation":"形容像风那样回旋，像闪电那样迅速。","source":{"text":"玄宗东西驱突，风回电激，所向无前。","book":"唐·封演《封氏闻见记·打球》"},"usage":"作谓语、定语、状语；指迅速"},{"id":47205,"word":"风土人情","pinyin":"fēng tú rén qíng","abbr":"ftrq","explanation":"风土：山川风俗、气候等的总称；人情：人的性情、习惯。一个地方特有的自然环境和风俗、礼节、习惯的总称。","source":{"text":"又问了问褚一官走了几省，说了些那省的风土人情，论了些那省的山川形胜。","book":"清·文康《儿女英雄传》第十四回"},"example":{"text":"我们这村上的人，一个个如此模样，难怪～如此颓败。","book":"清·颐琐《黄绣球》第一回"},"similar":["风俗人情"],"usage":"作宾语；指地方习俗等"},{"id":47206,"word":"风声目色","pinyin":"fēng shēng mù sè","abbr":"fsms","explanation":"指纵情声色。","source":{"text":"殿中侍御史王旭括宅中别宅女妇，风声目色。","book":"唐·张鷟《朝野佥载》卷二"},"usage":"作谓语、定语、宾语；用于生活"},{"id":47207,"word":"风声鹤唳","pinyin":"fēng shēng hè lì","abbr":"fshl","explanation":"唳：鹤叫声。形容惊慌失措，或自相惊忧。","source":{"text":"闻风声鹤唳，皆以为王师已至。","book":"唐·房玄龄《晋书·谢玄传》"},"example":{"text":"直到后来，听到了那些～的传说，见到了举室仓皇的不安状态。","book":"郁达夫《出奔》"},"similar":["草木皆兵"],"opposite":["风平浪静"],"usage":"作谓语、定语、补语；用于战争等","story":["东晋时期，前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃的过程中听到风声或鹤叫声，都以为是追兵"]},{"id":47208,"word":"风声鹤唳，草木皆兵","pinyin":"fēng shēng hè lì，cǎo mù jiē bīng","abbr":"fshlcmjb","explanation":"唳：鸟鸣。听到风声和鹤叫声，都疑心是追兵。形容人在惊慌时疑神疑鬼。","source":{"text":"闻风声鹤唳，皆以为王师已至。","book":"《晋书·谢玄传》"},"example":{"text":"我听了这话，心里觉得梦兆不祥，也和理翁的见解一样，大有～之感。","book":"清·曾朴《孽海花》第二十五回"},"similar":["惊惶失措"],"usage":"作定语、分句；可分开使用","story":["东晋时期前秦国王苻坚企图消灭东晋，东晋宰相谢安派谢石为征讨大都督，分兵三路夹击秦军。苻坚登上寿阳城，看见晋君阵容整齐有些畏惧。晋军用计围攻苻坚的秦军，秦军大败，在溃逃中听到风声或鹤叫声，看到草木阴影，都以为是追兵"]},{"id":47209,"word":"风姿绰约","pinyin":"fēng zī chuò yuē","abbr":"fzcy","explanation":"绰约：形容女子体态柔美的样子。指女子体态柔美丰满。","source":{"text":"那回观看的，何止挨山塞海，内中有两个女子，双鬟高髻，并肩而立。丰神绰约，宛然若并蒂芙蓉。","book":"明·凌濛初《初刻拍案惊奇》卷十七"},"example":{"text":"李文益～，冰雪聪明。","book":"清·李斗《扬州画舫录·新城兆录下》"},"similar":["风度娴雅","绰约多姿"],"opposite":["丑态百出"],"usage":"作谓语、定语；用于书面语"},{"id":47210,"word":"风娇日暖","pinyin":"fēng jiāo rì nuǎn","abbr":"fjrn","explanation":"娇：柔媚。微风吹拂，阳光温暖。","source":{"text":"红外风娇日暖，翠边水秀山明。","book":"宋·高观国《风入松》词"},"usage":"作谓语、定语；用于天气等"},{"id":47211,"word":"风宿水餐","pinyin":"fēng sù shuǐ cān","abbr":"fssc","explanation":"餐：吃饭。在水上进食，在风中歇宿。形容行旅生活的艰辛。","source":{"text":"烟波万里谁为伴，忘机数点白鸥闲，东西没牵绊，风宿水餐。","book":"明·邵璨《香囊记·题诗》"},"example":{"text":"我已经习惯了旅行中～的生活。"},"similar":["风餐水宿"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47212,"word":"风寒暑湿","pinyin":"fēng hán shǔ shī","abbr":"fhss","explanation":"冷风、寒气、中者、潮湿。指致病的四种原因。又泛指致病的各种原因。","source":{"text":"他的病可着我猜，我依着他便了。你不是风寒暑湿吗？","book":"元·无名氏《来生债》楔子"},"usage":"作宾语、定语；用于口语"},{"id":47213,"word":"风尘之会","pinyin":"fēng chén zhī huì","abbr":"fczh","explanation":"风尘：比喻战乱；会：时机。指战乱发生之际。","source":{"text":"彼皆蹑风尘之会，履颠沛之势。","book":"东汉·班固《答宾戏》"},"example":{"text":"《晋书·慕容垂载记》：“遇～，必有陵霄之志。”"},"usage":"作宾语；指战乱发生之际"},{"id":47214,"word":"风尘之变","pinyin":"fēng chén zhī biàn","abbr":"fczb","explanation":"风尘：比喻战乱。指战争的灾乱。","source":{"text":"夫风尘之变，出于非常。","book":"《晋书·陶璜传》"},"similar":["风尘之会"],"usage":"作宾语；指战争的灾乱"},{"id":47215,"word":"风尘之声","pinyin":"fēng chén zhī shēng","abbr":"fczs","explanation":"指蜚短流长的言语。","source":{"text":"诸所谮引，言非一事，长涂万里，无路自明，风尘之声，日有滋甚。","book":"《宋书·氐胡传略阳清水氐扬氏》"},"similar":["风尘之言","流言蜚语"],"usage":"作主语、宾语；指流言蜚语"},{"id":47216,"word":"风尘之志","pinyin":"fēng chén zhī zhì","abbr":"fczz","explanation":"风尘：比喻纷乱或污浊的生活，旧指仕宦。指作官的志向。","source":{"text":"安穷乐志，无风尘之慕；砥节砺行，有井渫之洁。","book":"晋·陆机《与赵王伦笺荐戴渊》"}},{"id":47217,"word":"风尘之惊","pinyin":"fēng chén zhī jīng","abbr":"fczj","explanation":"风尘：战乱。战乱发生的警报。","source":{"text":"归葬时，东夷有风尘之惊，廷臣喧嚣，仓黄促战。","book":"王闿运《振威将军张威墓志铭》"},"similar":["风尘之警"],"usage":"作宾语；用于战争等"},{"id":47218,"word":"风尘之慕","pinyin":"fēng chén zhī mù","abbr":"fczm","explanation":"风尘：比喻纷乱或污浊的生活，旧指仕宦。羡慕作官的思想。","source":{"text":"安穷乐志，无风尘之慕；砥节砺行，有井渫之洁。","book":"晋·陆机《与赵王伦笺荐戴渊》"}},{"id":47219,"word":"风尘之言","pinyin":"fēng chén zhī yán","abbr":"fczy","explanation":"风尘：污浊。指谗言。","source":{"text":"赐慧龙玺书曰：‘义隆畏将军如虎，欲相中害，朕自知之，风尘之言，想不足介意也。","book":"《魏书·王慧龙传》"},"example":{"text":"～不可信。"},"similar":["流言蜚语","风尘之声"],"usage":"作主语、宾语；指流言蜚语"},{"id":47220,"word":"风尘之警","pinyin":"fēng chén zhī jǐng","abbr":"fczj","explanation":"指战争或骚乱的警报。","source":{"text":"边境时有风尘之警，臣宣被坚执锐，当矢石，启前行。","book":"《汉书·终军传》"},"example":{"text":"皇阶甫辟，犹劳尉侯之虚；天步初夷，尚有～。","book":"唐·杨炯《原州百泉县令李君神道碑》"},"similar":["风尘之惊"],"usage":"作宾语；用于战争等"},{"id":47221,"word":"风尘仆仆","pinyin":"fēng chén pú pú","abbr":"fcpp","explanation":"风尘：指行旅，含有辛苦之意；仆仆：行路劳累的样子。形容旅途奔波，忙碌劳累。","source":{"text":"你索是远路风尘的故人。","book":"元·尚仲贤《柳毅传书》"},"example":{"text":"三人拣了一家客店住下，一路上～，到了此时，不免早些歇息。","book":"清·吴趼人《痛史》第八回"},"similar":["栉风沐雨","餐风宿露"],"usage":"作定语、状语；形容行旅的奔波劳累"},{"id":47222,"word":"风尘外物","pinyin":"fēng chén wài wù","abbr":"fcww","explanation":"指超越世俗的杰出人物。","source":{"text":"王衍神姿高彻，如瑶林琼树，自然是风尘表物。","book":"《晋书·王戎传》"},"similar":["风尘表物","风尘物表"],"usage":"作宾语、定语；用于特出人物"},{"id":47223,"word":"风尘物表","pinyin":"fēng chén wù biǎo","abbr":"fcwb","explanation":"风尘：指污浊、纷扰的世俗生活。超越世俗的特出人物。","source":{"text":"晋王戎目王衍，自然是风尘物表。","book":"宋·马永易《实宾录》"},"similar":["风尘表物","风尘外物"],"usage":"作宾语、定语；用于特出人物"},{"id":47224,"word":"风尘碌碌","pinyin":"fēng chén lù lù","abbr":"fcll","explanation":"碌碌：辛苦忙碌的样子。形容在旅途上辛苦忙碌的样子。","source":{"text":"风尘碌碌惜年华，选胜陪游帝子家。","book":"明·金毓峒《金鹤冲诗·按部泾原韩国主招宴暧泉二首（其一）》"},"usage":"作宾语、定语；用于旅途"},{"id":47225,"word":"风尘肮脏","pinyin":"fēng chén āng zāng","abbr":"fcaz","explanation":"在污浊的人世间挣扎。风尘：指污浊，纷扰的生活。肮脏：高亢刚直的样子，引申为强项挣扎的意思。"},{"id":47226,"word":"风尘表物","pinyin":"fēng chén biǎo wù","abbr":"fcbw","explanation":"指超越世俗的杰出人物。","source":{"text":"王衍神姿高彻，如瑶林琼树，自然是风尘表物。","book":"《晋书·王戎传》"},"similar":["风尘外物","风尘物表"],"usage":"作宾语、定语；用于特出人物"},{"id":47227,"word":"风平波息","pinyin":"fēng píng bō xī","abbr":"fpbx","explanation":"风和波浪都没有。比喻平静无事。","source":{"text":"武当山祖师大显威灵，逢难救难，遇危救危，四海风平波息，发感神威。","book":"《四海记·祖师复下凡间救苦》"},"similar":["风平浪静"],"usage":"作谓语；比喻平静无事"},{"id":47228,"word":"风平浪静","pinyin":"fēng píng làng jìng","abbr":"fplj","explanation":"指没有风浪。比喻平静无事。","source":{"text":"僧问：‘风恬浪静时如何？’师曰：‘吹倒南墙。’","book":"宋·释普济《五灯会元》卷七"},"example":{"text":"有孩儿在这里，不要怕他，包管～。","book":"清·吴趼人《二十年目睹之怪现状》第十八回"},"similar":["平安无事","天下太平"],"opposite":["惊涛骇浪","轩然大波"],"usage":"作谓语、定语、宾语；比喻事情平息"},{"id":47229,"word":"风度翩翩","pinyin":"fēng dù piān piān","abbr":"fdpp","explanation":"风度：风采气度，指美好的举止姿态；翩翩：文雅的样子。举止文雅优美。","source":{"text":"平原君，翩翩浊世之佳公子也。","book":"西汉·司马迁《史记·平原君列传》"},"example":{"text":"他西装革履，～。"},"similar":["风华正茂"],"opposite":["尖嘴猴腮"],"usage":"作谓语、定语；形容男子"},{"id":47230,"word":"风张风势","pinyin":"fēng zhāng fēng shì","abbr":"fzfs","explanation":"风：通“疯”。比喻故意装出疯癫痴呆的样子。","source":{"text":"你这和尚，风张风势，说谎调皮，没些儿至诚的。","book":"元·李寿卿《度柳翠》楔子"},"similar":["风风势势","装疯卖傻"],"usage":"作谓语、定语、状语；用于口语"},{"id":47231,"word":"风影敷衍","pinyin":"fēng yǐng fū yān","abbr":"fyfy","explanation":"指罗织罪名，捕风捉影，诬赖人。","source":{"text":"清·孔尚任《桃花扇·朗丁》：“飞霜冤，不比黑盆冤，一件件风影敷衍”。"},"example":{"text":"他这个人从不实事求是，惯于～，你不要相信他。"},"usage":"作谓语、宾语、定语；用于口语"},{"id":47232,"word":"风微浪稳","pinyin":"fēng wēi làng wěn","abbr":"fwlw","explanation":"指没有风浪。比喻平静无事。","source":{"text":"还过大江，风微浪稳，舟楫安然。","book":"宋·胡仔《苕溪渔隐丛话后集·本朝杂记上》"},"similar":["风平浪静"],"usage":"作谓语、定语；用于水上旅行等"},{"id":47233,"word":"风急浪高","pinyin":"fēng jí làng gāo","abbr":"fjlg","explanation":"形容风浪很大。","source":{"text":"出海口附近波涛汹涌，风急浪高。","book":"《文汇报》1992.3.2"},"example":{"text":"江上～，我们得小心行船。"},"similar":["波涛汹涌"],"usage":"作谓语、定语；形容风浪很大"},{"id":47234,"word":"风恬月朗","pinyin":"fēng tián yuè lǎng","abbr":"ftyl","explanation":"恬：平静，安适；朗：明亮。风静月明。形容夜色宁静幽美。比喻清白高洁。","source":{"text":"尔夜风恬月朗。","book":"南朝·宋·刘义庆《世说新语·赏誉》"},"usage":"作谓语、定语；用于夜色"},{"id":47235,"word":"风恬浪静","pinyin":"fēng tián làng jìng","abbr":"ftlj","explanation":"恬：静。没有风流。比喻平安无事。","source":{"text":"物触轻舟心自知，风恬浪静月光微。","book":"唐·薛莹《郑德璘传》"},"example":{"text":"临危蹈险，江心漏船，惟愿得～，早见平安。","book":"明·陆采《怀香记·问卜决疑》"},"similar":["风平浪静"],"usage":"作谓语、定语、状语；用于旅途"},{"id":47236,"word":"风情月债","pinyin":"fēng qíng yuè zhài","abbr":"fqyz","explanation":"比喻有关男女恋爱的事情。","source":{"text":"司人间之风情月债，掌尘世之女怨男痴。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"他到处欠下～。"},"usage":"作宾语；指男女恋爱的事情"},{"id":47237,"word":"风情月思","pinyin":"fēng qíng yuè sī","abbr":"fqys","explanation":"指男女相互爱恋的情思。","source":{"text":"记当年与那人初见，只指望邮亭一夜姻缘，谁想他风情月思深留恋，殊甜静，乐幽闲。","book":"明·胡文焕《群音类选·玉环记·韦皋结友》"},"example":{"text":"京兆府当年指腹，女贞观重会玉簪；慢写出～，画堂前侑酒承欢。","book":"明·高濂《玉簪记·合庆》"},"similar":["风情月意"],"usage":"作宾语、定语；用于男女间"},{"id":47238,"word":"风情月意","pinyin":"fēng qíng yuè yì","abbr":"fqyy","explanation":"指男女相互爱恋的情思。同“风情月思”。","source":{"text":"眉似初春柳叶，常含着雨恨云愁；脸如三月桃花，暗带着风情月意。","book":"明·兰陵笑笑生《金瓶梅词话》第九回"},"similar":["风情月思"],"usage":"作宾语、定语；用于男女间"},{"id":47239,"word":"风成化习","pinyin":"fēng chéng huà xí","abbr":"fchx","explanation":"指形成风气。","source":{"text":"纷扰日久，求竞成俗，或推货贿以龙跃，或阶党援以凤起，风成化习，大道渐芜。","book":"《抱朴子·逸民》"},"similar":["习惯俗成"],"usage":"作谓语、宾语；用于习俗等"},{"id":47240,"word":"风掣雷行","pinyin":"fēng chè léi xíng","abbr":"fclx","explanation":"掣：闪过。风闪雷鸣。形容像刮风和响雷那样迅速。","source":{"text":"洋场马路，纵横井井，虽不及上海之平坦，而马车洋车往来络绎，风掣雷行","book":"清·无名氏《游越南记》"},"usage":"作谓语、定语；指迅速"},{"id":47241,"word":"风斯在下","pinyin":"fēng sī zài xià","abbr":"fszx","explanation":"斯：语助词。是因为大风在它下面。指大鹏鸟凭借风力而高飞。比喻超越前贤。","source":{"text":"风之积也不厚，则其负大翼也无力。故九万里，则风斯在下矣，而后乃今培风。","book":"战国·宋·庄周《庄子·逍遥游》"},"example":{"text":"王右军书本学卫夫人，其后遂妙天下，所谓～也。","book":"宋·陈善《扪虱新话》"},"usage":"作宾语、定语；用于书面语"},{"id":47242,"word":"风旋电掣","pinyin":"fēng xuán diàn chè","abbr":"fxdc","explanation":"掣：闪过；旋：奔跑。你风一样飞驰而过，像闪电一样一角即逝。形容非常迅速。","source":{"text":"奋威四人，主择材力，论兵革，风驰电掣，扫除妖魅。","book":"《六韬·王翼》"},"example":{"text":"乃一手挥刀格斗，一手掷妇于床，如～，已无踪。","book":"清·纪昀《阅微草堂笔记·如是我闻二》"},"similar":["风驰电掣"],"usage":"作宾语、定语、状语；形容迅速"},{"id":47243,"word":"风景不殊","pinyin":"fēng jǐng bù shū","abbr":"fjbs","explanation":"殊：不同。用以悲叹国土破碎或沦亡。","source":{"text":"风景不殊，举目有江河之异。","book":"晋·王隐《晋书·王导传》"},"example":{"text":"～休举目，夕阳衰草事堪哀。","book":"叶叶《九秋》"},"usage":"作谓语；指悲叹国土破碎或沦亡"},{"id":47244,"word":"风暖日丽","pinyin":"fēng nuǎn rì lì","abbr":"fnrl","explanation":"丽：美丽。风恬日暖，轻风柔和，阳光灿烂。形容天气晴朗暖和。","source":{"text":"因为从‘清明’到‘谷雨’这二十天内，风暖日丽，正是‘行乐’的时令。","book":"茅盾《香市》"},"similar":["风和日丽"],"usage":"作谓语、定语、分句；形容晴朗暖和的天气"},{"id":47245,"word":"风月场","pinyin":"fēng yuè cháng","abbr":"fyc","explanation":"指男女情爱的场所。","source":{"text":"几句若远若近的话儿，加克虽然是风月场中的魔儿，也弄得没了话儿。","book":"曾朴《孽海花》第16回"},"example":{"text":"曾朴《孽海花》第16回：“几句若远若近的话儿，加克虽然是～中的魔儿，也弄得没了话儿。”"},"usage":"作宾语、定语；用于交际等"},{"id":47246,"word":"风月子弟","pinyin":"fēng yuè zǐ dì","abbr":"fyzd","explanation":"沉湎于风月场的人。","example":{"text":"他整天与一帮～搅和在一起。"},"usage":"作主语、宾语、定语；用于人"},{"id":47247,"word":"风月常新","pinyin":"fēng yuè cháng xīn","abbr":"fycx","explanation":"指情爱长久如新。","source":{"text":"以绸缪记印于臂上，文曰：‘风月常新。’印毕，渍以桂红膏，则水洗色不退。","book":"唐·张泌《妆楼记·印臂》"},"example":{"text":"我不相信风月场～的佳话。"},"usage":"作宾语、定语；用于男女之间"},{"id":47248,"word":"风月无涯","pinyin":"fēng yuè wú yá","abbr":"fywy","explanation":"极言风景之佳胜。同“风月无边”。","source":{"text":"光阴有限同归老，风月无涯可慰颜。","book":"宋·邵雍《世上吟》"},"similar":["风月无边"],"usage":"作宾语、定语；用于风景等"},{"id":47249,"word":"风月无边","pinyin":"fēng yuè wú biān","abbr":"fywb","explanation":"极言风景之佳胜。","source":{"text":"风月无边，庭草交翠。","book":"宋·朱熹《六先生画像·濂溪先生》"},"example":{"text":"西湖～景，都在诗翁杖履中。","book":"金·侯克中《过友生新居》诗"},"similar":["风月无涯"],"usage":"作宾语、定语；用于风景等"},{"id":47250,"word":"风木之思","pinyin":"fēng mù zhī sī","abbr":"fmzs","explanation":"比喻父母亡故，不及孝养而生的思念之情。","source":{"text":"臣谨以山川形胜、陵宫规制，各为一图，用备九重瞻览，少慰风木之思。","book":"明·张居正《承天大志纪赞·陵寝纪》"},"example":{"text":"只是漂流已久，岂无～，伉俪重谐，方有室家之恋。今欲暂归祭扫，后当图效涓埃。","book":"明·张凤翼《红拂记·杨公完偶》"},"similar":["风木之悲"],"usage":"作宾语；指父母亡故的思念"},{"id":47251,"word":"风木之悲","pinyin":"fēng mù zhī bēi","abbr":"fmzb","explanation":"风木：同“风树”，比喻因父母亡故，不能奉养。指丧父母的悲伤。","source":{"text":"早年失怙，常怀风木之悲；壮岁鼓盆，久虚琴瑟之乐。","book":"明·顾大典《青衫记·元白揣摩》"},"example":{"text":"～何及！","book":"清·顾炎武《与李湘北书》"},"similar":["风木含悲","风木叹"],"usage":"作宾语；指父母亡故的悲伤"},{"id":47252,"word":"风木叹","pinyin":"fēng mù tàn","abbr":"fmt","explanation":"风木：同“风树”，比喻因父母亡故，不能奉养。指丧父母的悲伤。","source":{"text":"早岁已形风木叹，余生永废《蓼莪》诗。","book":"宋·陆游《焚黄》"},"similar":["风木含悲","风木之悲","风树悲"],"usage":"作宾语；指父母亡故的悲伤"},{"id":47253,"word":"风木含悲","pinyin":"fēng mù hán bēi","abbr":"fmhb","explanation":"比喻因父母亡故，孝子不能奉养的悲伤。","source":{"text":"树欲静而风不止，子欲养而亲不待也。","book":"汉·韩婴《韩诗外传》卷九"},"example":{"text":"先父公弼，作宦黄州，因而流寓岐亭，不幸～，年来独与妻房柳氏，谐其伉俪。","book":"明·汪廷讷《狮吼记·叙别》"},"similar":["风木之悲"],"usage":"作宾语、定语；指丧父母的悲痛"},{"id":47254,"word":"风栉雨沐","pinyin":"fēng zhì yǔ mù","abbr":"fzym","explanation":"栉：梳头发；沐：洗头发。风梳发，雨洗头。形容人经常在外面不顾风雨地辛苦奔波。","source":{"text":"沐甚雨，栉疾风。","book":"《庄子·天下》"},"example":{"text":"相我祖宗，～，昔同其劳，今共兹福。","book":"《元史·礼乐志三》"},"similar":["沐雨栉风"],"usage":"作谓语、定语；形容奔波劳苦"},{"id":47255,"word":"风树之悲","pinyin":"fēng shù zhī bēi","abbr":"fszb","explanation":"风树：比喻因父母亡故，不能奉养。指丧父母的悲伤。","source":{"text":"临朝端默，过隙子思弥轸；垂拱岩廊，风树之悲逾切。","book":"唐·道宣《续高僧传·译经·释宝唱》"},"example":{"text":"逮其成长，事与心违，曷胜～，顾瞻松楸，未尝不流涕太息。","book":"金·王若虚《赠昭毅大将军高公墓碣》"},"similar":["风树之感","风树悲","风木之悲"],"usage":"作主语、宾语；指父母亡故的悲伤"},{"id":47256,"word":"风树之感","pinyin":"fēng shù zhī gǎn","abbr":"fszg","explanation":"比喻父母已亡故，不得孝养的感伤之情。","source":{"text":"树欲静而风不止，子欲养而亲不待也。","book":"汉·韩婴《韩诗外传》第九卷"},"example":{"text":"特以丁运孤贫，养礼多阙，～，夙自缠心。","book":"《南齐书·虞玩之传》"},"similar":["风树之悲","风木之悲"],"usage":"作主语、宾语；指父母亡故的悲伤"},{"id":47257,"word":"风树悲","pinyin":"fēng shù bēi","abbr":"fsb","explanation":"指丧父母的悲伤。","source":{"text":"庶使孝子心，皆无风树悲。","book":"唐·白居易《赠友》诗"},"similar":["风木之悲","风木含悲","风木叹"],"usage":"作宾语；指父母亡故的悲伤"},{"id":47258,"word":"风樯阵马","pinyin":"fēng qiáng zhèn mǎ","abbr":"fqzm","explanation":"樯：船上用的桅杆。风中的樯帆，阵上的战马。比喻气势雄壮，行动迅速。","source":{"text":"风樯阵马，不足为其勇也，瓦棺篆鼎，不足为其古也。","book":"唐·杜牧《李贺诗序》"},"example":{"text":"军书羽檄，汗简错互，～，笔墨横飞。","book":"清·钱谦益《杜弢武全集序》"},"similar":["阵马风樯"],"usage":"作谓语、定语；比喻气势雄壮，行动迅速"},{"id":47259,"word":"风檐刻烛","pinyin":"fēng yán kè zhú","abbr":"fykz","explanation":"风檐：科举时代的考场。指科举时代考场寒冷，时间紧迫，十分艰苦。","source":{"text":"查林二公乃能于风檐刻烛时，立就二十三艺，洵未易才。","book":"清·钮琇《觚剩·五经中式》"},"similar":["风檐寸晷"],"usage":"作宾语、定语；用于书面语"},{"id":47260,"word":"风檐寸晷","pinyin":"fēng yán cùn guǐ","abbr":"fycg","explanation":"风檐：不能蔽风雨的场屋；晷：日影，时间。在不蔽风雨的破檐下争取一寸的时光。形容旧时科举考试的紧张状态。","source":{"text":"应试之士，于风檐寸晷之中，欲其文可为程式者，盖已绝无间有。","book":"明·焦竑《玉堂丛语》"},"example":{"text":"呀，～，立扫千言，可敬可敬。","book":"明·汤显祖《还魂记·耽听》"},"similar":["风檐刻烛"],"usage":"作宾语、定语；用于书面语"},{"id":47261,"word":"风波平地","pinyin":"fēng bō píng dì","abbr":"fbpd","explanation":"风波：比喻事变。平地上起风浪。比喻突然发生意料不到的纠纷或事故。","source":{"text":"因辐辏旧日姻盟，潜归去，风波平地，夫妇各飘零。","book":"明·许三阶《节侠记·开宗》"},"similar":["平地风波"],"usage":"作宾语、定语；比喻突然发生意料不到"},{"id":47262,"word":"风派人物","pinyin":"fēng pài rén wù","abbr":"fprw","explanation":"指善于迅速改变自己立场或观点的人。","example":{"text":"他是～，很快就改变主意。"},"opposite":["立场坚定"],"usage":"作宾语、定语；指立场不稳"},{"id":47263,"word":"风流事过","pinyin":"fēng liú shì guò","abbr":"flsg","explanation":"指细小的过错。","source":{"text":"自此怀恨董县丞，寻两件风流事过，参与上司，罢官而去。","book":"明·冯梦龙《醒世恒言》第29卷"},"similar":["风流罪犯"],"usage":"作宾语、定语；用于口语"},{"id":47264,"word":"风流云散","pinyin":"fēng liú yún sàn","abbr":"flys","explanation":"象风和云那样流动散开。比喻在一起的人分散到四面八方。","source":{"text":"风流云散，一别如雨。","book":"三国·魏·王粲《赠蔡子笃》诗"},"example":{"text":"今则天各一方，～，兼之玉碎香埋，不堪回首矣。","book":"清·沈复《浮生六记·闲情记趣》"},"similar":["烟消云散","如鸟兽散"],"opposite":["风起云涌","风云际会"],"usage":"作谓语、定语、补语；指朋友亲人的分散"},{"id":47265,"word":"风流人物","pinyin":"fēng liú rén wù","abbr":"flrw","explanation":"风流：英俊的、杰出的。指对一个时代有很大影响的人物。有时也指举止潇洒或惯于调情的人。","source":{"text":"大江东去，浪淘尽，千古风流人物。","book":"宋·苏轼《念奴娇·赤壁怀古》词"},"example":{"text":"数～，还看今朝。","book":"《毛泽东诗词·沁园春·雪》"},"similar":["风云人物"],"opposite":["芸芸众生"],"usage":"作主语、宾语、定语；指杰出不凡的人"},{"id":47266,"word":"风流佳事","pinyin":"fēng liú jiā shì","abbr":"fljs","explanation":"风流：指男女相互爱悦之事；佳事：美事。指男女情爱的美事。","source":{"text":"今忽见宝玉也有麒麟，便恐借此生隙，同湘云也做出那些风流佳事来，因而悄悄地走来，见机行事，以察二人之意。","book":"清·曹雪芹《红楼梦》第32回"},"similar":["风流佳话"],"usage":"作主语、宾语、定语；用于男女间等"},{"id":47267,"word":"风流佳话","pinyin":"fēng liú jiā huà","abbr":"fljh","explanation":"有关男女相爱婚配之类的好事或趣事。","source":{"text":"咱们多做个保亲，正是风流佳话。","book":"明·凌濛初《二刻拍案惊奇·小道人一着饶天下》"},"example":{"text":"清·荑荻散人《玉娇梨》第13回：“闺中路上，担不了许多透骨相思；月下花前，又添出一段～。”"},"similar":["风流佳事"],"usage":"作主语、宾语、定语；用于男女间等"},{"id":47268,"word":"风流倜傥","pinyin":"fēng liú tì tǎng","abbr":"fltt","explanation":"风流：有才学而不拘礼法；倜傥：卓异，洒脱不拘。形容人有才华而言行不受世俗礼节的拘束。","source":{"text":"羡英年壮节堪多，似冰心在玉壶，散财结客，侠比三河，风流倜傥，名倾六辅。","book":"明·许三阶《节侠记·私仰》"},"example":{"text":"其中虢国夫人，更～，玄宗常与相狎，凡宫中的服食器用，时蒙赐赉，又另赐第宅一所于集庆坊。","book":"清·禇人获《隋唐演义》第八十回"},"similar":["风流潇洒","风度翩翩"],"opposite":["衣衫褴褛"],"usage":"作谓语、定语；指人很潇洒"},{"id":47269,"word":"风流儒雅","pinyin":"fēng liú rú yǎ","abbr":"flry","explanation":"风流：有文采且不拘礼法；儒雅：学识深湛，气度不凡。指人文雅洒脱，学识渊博。","source":{"text":"殷仲文风流儒雅，海风知名，伐异时移，出为东阳太守。","book":"北周·庾信《枯树赋》"},"example":{"text":"杲之为人也，～，为一代之和到此为止；昂之为人也，文章卓荦，为四海之随珠。","book":"唐·卢照邻《五悲·悲才难》"},"similar":["风流潇洒"],"usage":"作谓语、定语；指人举止文雅洒脱"},{"id":47270,"word":"风流冤孽","pinyin":"fēng liú yuān niè","abbr":"flyn","explanation":"男女风情事而造成的冤仇罪孽。","source":{"text":"因近来风流冤孽，缠绵於此处，是以前来访察机会，布散相思。","book":"清·曹雪芹《红楼梦》第五回"}},{"id":47271,"word":"风流千古","pinyin":"fēng liú qiān gǔ","abbr":"flqg","explanation":"指风雅之事久远流传。","source":{"text":"风流千古，一时人物，好记尊前语。","book":"宋·李流谦《青玉案》词"},"example":{"text":"帝子之阁，～，有子之文，使吾等今日雅会。","book":"明·冯梦龙《醒世恒言》"},"similar":["流芳百世"],"usage":"作谓语、定语；指风雅之事"},{"id":47272,"word":"风流博浪","pinyin":"fēng liú bó làng","abbr":"flbl","explanation":"风流：风度。风流浪荡。","source":{"text":"文嫂便把怎的说念林氏，夸奖老爹人品家道，怎样结识官府，又怎的仗义疏财，风流博浪。","book":"明·兰陵笑笑生《金瓶梅词话》第69回"},"example":{"text":"他的儿子是～的人，专门寻花问柳。"},"usage":"作谓语、定语；用于为人"},{"id":47273,"word":"风流宰相","pinyin":"fēng liú zǎi xiàng","abbr":"flzx","explanation":"不拘礼节和法度的宰相。","source":{"text":"俭常谓人曰：‘江左风流宰相，惟有谢安。’盖自况也。","book":"《南史·王俭传》"},"usage":"作宾语、定语；用于口语"},{"id":47274,"word":"风流才子","pinyin":"fēng liú cái zǐ","abbr":"flcz","explanation":"旧指洒脱不拘，富有才学的人。","source":{"text":"风流才子多春思，肠断萧娘一纸书。","book":"唐·元稹《莺莺传》"},"example":{"text":"读书一目十行，举笔即便成文，元是个～。","book":"明·冯梦龙《警世通言》卷二十四"},"similar":["风流人物"],"usage":"作宾语、定语；指富有才学的人"},{"id":47275,"word":"风流旖旎","pinyin":"fēng liú yǐ nǐ","abbr":"flyn","explanation":"风流：风度和韵致；旖旎：愿意指旌旗飘扬的样子，引申为柔美的样子。形容风韵娇柔。多指妇女的神态。","source":{"text":"我这女儿吹弹歌舞，书画琴棋，无不精妙，更是风流旖旎，机巧聪明。","book":"元·乔孟符《两世姻缘》第一折"},"example":{"text":"清·褚人获《隋唐演义》第50回：“线娘亦在马上看罗成人材出众，～。”"},"usage":"作谓语、定语；用于女性"},{"id":47276,"word":"风流水性","pinyin":"fēng liú shuǐ xìng","abbr":"flsx","explanation":"性情风流浮荡，如水一样随势而流。比喻妇女爱情不专一。","source":{"text":"这贵妃又是个风流水性，他也不必以貌取人，只是爱少年，喜壮士。","book":"清·褚人获《隋唐演义》第80回"},"similar":["水性杨花"],"usage":"作宾语、定语；多用于女性"},{"id":47277,"word":"风流浪子","pinyin":"fēng liú làng zǐ","abbr":"fllz","explanation":"风流成性不受习俗惯例和道德规范约束的放荡不羁的人。指不务正业过着放荡生活的人。","example":{"text":"我们得采取得当的教育方式来改变这些～。"},"usage":"作主语、宾语、定语；用于口语"},{"id":47278,"word":"风流潇洒","pinyin":"fēng liú xiāo sǎ","abbr":"flxs","explanation":"英俊有才华，气度超脱。","source":{"text":"素娘，似你这般风流潇洒，如花似玉，向在风尘，知心有几。","book":"明·徐复祚《红梨记·投雍》"},"example":{"text":"臭花娘见他美如冠玉，～的，必里也十分爱慕，巴不得要他送上大门。","book":"清·张南庄《何典》第七回"},"similar":["风流倜傥"],"usage":"作谓语、定语；指人的气度"},{"id":47279,"word":"风流缊藉","pinyin":"fēng liú yùn jiè","abbr":"flyj","explanation":"风流：风度，标格。形容人风雅潇洒，才华横溢。也形容文章诗画意趣飘逸含蓄。","source":{"text":"晏元献公、欧阳文忠公，风流缊藉，一时莫及，而温润秀洁，亦无其比。","book":"宋·王灼《碧鸡漫志》第二卷"},"similar":["风流蕴藉","风流酝藉"],"usage":"作谓语、宾语、定语；指文章等"},{"id":47280,"word":"风流罪犯","pinyin":"fēng liú zuì fàn","abbr":"flzf","explanation":"指轻微的过失。","source":{"text":"把孩儿风流罪犯寻些个，吊着脚腕又不敢将脚尖那。","book":"元·杨显之《酷寒亭》第三折"},"similar":["风流事过"],"usage":"作宾语、定语；指小过错"},{"id":47281,"word":"风流罪过","pinyin":"fēng liú zuì guò","abbr":"flzg","explanation":"风流：原为封建士大夫的所谓风雅。原指因为风雅而致的过错。后也指因搞男女关系而犯下的罪。","source":{"text":"在官写书，亦是风流罪过。","book":"《北齐书·郎基传》"},"example":{"text":"公瑾教我十日办完，工匠料物，都不应手，将这一件～，明白要杀我。","book":"明·罗贯中《三国演义》第四十六回"},"usage":"作宾语、定语；指男女风情过失"},{"id":47282,"word":"风流自赏","pinyin":"fēng liú zì shǎng","abbr":"flzs","explanation":"以卓越的才华和超俗的风范而自我欣赏。","source":{"text":"会是风流赏，惟君内史贤。","book":"唐·羊士谔《郡中玩月寄江南李少尹虞部孟员外三首》"},"example":{"text":"毅然以乡先达自居，勉之以修己之学，济物之功，而戒其毋以～。","book":"清·梁章钜《归田琐记·郑苏年师》"}},{"id":47283,"word":"风流蕴藉","pinyin":"fēng liú yùn jiè","abbr":"flyj","explanation":"蕴藉：平和宽厚，含蓄内秀。形容人风雅潇洒，才华横溢。也形容文章诗画意趣飘逸含蓄。","source":{"text":"学识有风训，生九子，并风流蕴藉，世号王氏九龙。","book":"《北齐书·王昕传》"},"example":{"text":"张世文《新草池塘》、《紫燕双飞》二首，～，不减周秦。","book":"清·沈谦《填词杂说·张世文词警策》"},"similar":["风流儒雅","风度翩翩"],"opposite":["俗不可耐","庸懦无能"],"usage":"作谓语、宾语、定语；指文章等"},{"id":47284,"word":"风流警拔","pinyin":"fēng liú jǐng bá","abbr":"fljb","explanation":"警：敏悟；拔：突出。风雅且文思很敏捷。","source":{"text":"为太原公开府记室，与杨愔友善，相遇则清淡竟日，愔每曰：‘此人风流警拔，裴文季为不亡矣。’","book":"《北齐书·裴让之传》"}},{"id":47285,"word":"风流跌宕","pinyin":"fēng liú diē dàng","abbr":"fldd","explanation":"跌宕：为人放纵，不拘束。气度超脱，潇洒放逸。","source":{"text":"所谓无道学气者，非但风流跌宕之曲、花前月下之情，当以板腐为戒。","book":"清·李渔《闲情偶寄·词曲·词采》"},"example":{"text":"那宝玉素闻北静王的贤德，且才貌俱全，～，不为官俗国体所缚。","book":"清·曹雪芹《红楼梦》第14回"},"similar":["风流潇洒"],"usage":"作谓语、定语；用于为人"},{"id":47286,"word":"风流酝藉","pinyin":"fēng liú yùn jiè","abbr":"flyj","explanation":"风流：风度，标格。形容人风雅潇洒，才华横溢。也形容文章诗画意趣飘逸含蓄。","source":{"text":"善之通博，在何妥之下，然以风流酝藉，俯仰可观，音韵清朗，听者忘倦，由是为后进所归。","book":"《隋书·儒林传·元善》"},"example":{"text":"张世文《新草池塘》、《紫燕双飞》二首，～，不减周秦。","book":"清·沈谦《填词杂说·张世文词警策》"},"similar":["风流蕴藉","风流缊藉"],"usage":"作谓语、宾语、定语；指文章等"},{"id":47287,"word":"风流雅事","pinyin":"fēng liú yǎ shì","abbr":"flys","explanation":"雅：风雅。风雅而有情趣的事。","source":{"text":"命探春依次抄录妥协，自己编次，叙其优劣，又命在大观园勒石，为千古风流雅事。","book":"清·曹雪芹《红楼梦》第23回"},"similar":["风流韵事"],"usage":"作主语、宾语、定语；多指男女私情"},{"id":47288,"word":"风流雨散","pinyin":"fēng liú yǔ sàn","abbr":"flys","explanation":"散：分散。风吹过，雨飘散，踪迹全消。比喻经常在一起的人飘零离散。","source":{"text":"饮御酣，宾旅旋，车马雷骇，轰轰阗阗，若风流雨散，漫乎数百里之间。","book":"晋·左思《蜀都赋》"},"example":{"text":"徒以士之相见，人之相知，必欲轩盖逢迎，朝游夕处，亦常烟波阻绝，～。","book":"唐·杨炯《送海孙尉诗序》"},"similar":["风流云散","云散风流"],"usage":"作谓语、定语、补语；指朋友亲人的分散"},{"id":47289,"word":"风流韵事","pinyin":"fēng liú yùn shì","abbr":"flys","explanation":"风雅而有情趣的事。旧指文人诗歌吟咏及琴棋书画等活动。也指男女私情。","source":{"text":"人各却步立，不敢询姓氏，及移烛烛之，则倩扶也。一座哗然，此亦风流之韵事，承平之佳话。","book":"清·王韬《瀛壖杂志》"},"example":{"text":"他常常带着张小桃进出他的律师事务所。他的～还多得很。","book":"巴金《家》三十一"},"similar":["风流佳话"],"usage":"作主语、宾语、定语；指男女私情"},{"id":47290,"word":"风清弊绝","pinyin":"fēng qīng bì jué","abbr":"fqbj","explanation":"贪污、舞弊的事情没有了。形容坏事绝迹，社会风气良好。","source":{"text":"上安下顺，风清弊绝。","book":"宋·周敦颐《拙赋》"},"example":{"text":"到得郓城不久，就兴利除害，～，吏民无不欢喜。","book":"清·俞万春《荡寇志》第八十回"},"similar":["弊绝风清"],"usage":"作谓语、定语；形容社会风气良好"},{"id":47291,"word":"风清月明","pinyin":"fēng qīng yuè míng","abbr":"fqym","explanation":"微风清凉，月光明朗。形容夜景美好。同“风清月朗”。","source":{"text":"又闻柯亭有美竹，可为笛，风清月明，登楼一吹，可以来凤凰，惊蛰龙，真奇事也。","book":"明·刘基《横碧楼记》"},"similar":["风清月朗"],"usage":"作定语、补语；形容夜景"},{"id":47292,"word":"风清月朗","pinyin":"fēng qīng yuè lǎng","abbr":"fqyl","explanation":"风凉爽，月明亮。","source":{"text":"时春季夜间，风清月朗。","book":"唐·段成式《酉阳杂俎·支诺皋下》"},"example":{"text":"西方极乐真幽境，～天籁定。","book":"明·许仲琳《封神演义》第七十九回"},"similar":["风清月明"],"usage":"作定语、补语；形容夜景"},{"id":47293,"word":"风清月白","pinyin":"fēng qīng yuè bái","abbr":"fqyb","explanation":"微风清凉，月色皎洁。形容夜景幽美宜人。同“风清月皎”。","source":{"text":"风清月白偏宜夜，一片琼田。","book":"宋·欧阳修《采桑子》词"},"example":{"text":"后～之夕，每见其魂在墓前松柏下，摇首独步。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录三》"},"similar":["风清月皎","月白风清"],"usage":"作谓语、宾语、定语；指夜色"},{"id":47294,"word":"风清月皎","pinyin":"fēng qīng yuè jiāo","abbr":"fqyj","explanation":"轻风清凉，月光皎洁。形容夜景优美宜人。","source":{"text":"及夜风清月皎，见阶间有三美女，笑话而至。","book":"唐·无名氏《薛昭传》"},"example":{"text":"端的是天晴日晓，更堪那～。","book":"明·无名氏《紫微宫》第二折"},"similar":["风清月白"],"usage":"作谓语、宾语、定语；指夜色"},{"id":47295,"word":"风潇雨晦","pinyin":"fēng xiāo yǔ huì","abbr":"fxyh","explanation":"潇：冷落，没有生气；晦：昏暗。形容风急雨骤，天色昏暗。也比喻形势险恶。","source":{"text":"风雨潇潇，鸡鸣胶胶，既见君子，云胡不瘳。风雨如晦，鸡鸣不已，既见君子，云胡不喜。","book":"《诗经·郑风·风雨》"},"example":{"text":"当此国基甫定，～之时，正全体国民卧薪尝胆之日。","book":"清·梁启超《政府大政方针宣言书》"},"similar":["狂风暴雨"],"usage":"作谓语、定语；比喻形势险恶"},{"id":47296,"word":"风激电飞","pinyin":"fēng jī diàn fēi","abbr":"fjdf","explanation":"形容势猛。","source":{"text":"云合雾集，风激电飞，量时揆宜，用取世资。","book":"《三国志·蜀志·郤正传》"},"similar":["风激电骇"],"usage":"作宾语、定语、状语；形容迅速"},{"id":47297,"word":"风激电骇","pinyin":"fēng jī diàn hài","abbr":"fjdh","explanation":"形容势猛。同“风激电飞”。","source":{"text":"凭险作守，兵食兼资，风激电骇，莫不震叠。","book":"《南史·梁纪上·武帝》"},"similar":["风激电飞"],"usage":"作宾语、定语、状语；形容迅速"},{"id":47298,"word":"风烛之年","pinyin":"fēng zhú zhī nián","abbr":"fzzn","explanation":"比喻人到了接近死亡的晚年。","source":{"text":"时年五十有三，或恐风烛奄及，聊遗教于子孙耳。","book":"晋·王羲之《题卫夫人笔陈图后》"},"example":{"text":"他们充分利用～来为社会作贡献。"},"similar":["风烛残年"],"usage":"作宾语、定语、分句；指人的晚年"},{"id":47299,"word":"风烛残年","pinyin":"fēng zhú cán nián","abbr":"fzcn","explanation":"风烛：被风吹的蜡烛，容易熄灭；残年：残余的岁月，指在世不太久。比喻人到了接近死亡的晚年。","source":{"text":"时年五十有三，或恐风烛奄及，聊遗教于子孙耳。","book":"晋·王羲之《题卫夫人笔陈图后》"},"example":{"text":"有许多象祁老者的老人，希望在太平中度过～，而侵略者的枪炮打碎了他们的希望。","book":"老舍《四世同堂》六"},"similar":["风中之烛","风前残烛"],"opposite":["风华正茂","年富力强"],"usage":"作宾语、定语、分句；指人的晚年"},{"id":47300,"word":"风烛草露","pinyin":"fēng zhú cǎo lù","abbr":"fzcl","explanation":"风中之烛易灭，草上之露易干。比喻人已衰老，临近死亡。","source":{"text":"人生一世，犹如石火电光，寿算百年，恍若风烛草露。","book":"明·杨慎《洞天玄记》四折"},"example":{"text":"他的处境像～一样危险。"},"usage":"作宾语、定语；多用于比喻句"},{"id":47301,"word":"风牛马不相及","pinyin":"fēng niú mǎ bù xiāng jí","abbr":"fnmbxj","explanation":"比喻事物彼此毫不相干。同“风马牛不相及”。","source":{"text":"夫孰知兰之生产，与彼风牛马不相及之猫，有此若大关系乎？","book":"梁启超《天演学初祖达尔文之学说及其传略》"}},{"id":47302,"word":"风狂雨横","pinyin":"fēng kuáng yǔ héng","abbr":"fkyh","explanation":"狂：猛烈；横：粗暴。形容狂猛而迅急的风雨。","source":{"text":"风狂雨横，是邀勒园林，几多桃李。","book":"宋·辛弃疾《念奴娇·和信守王道夫席上韵》"},"usage":"作谓语、定语；用于风雨"},{"id":47303,"word":"风环雨鬓","pinyin":"fēng huán yǔ bìn","abbr":"fhyb","explanation":"鬓：两颊的头发。形容女子头发美丽或蓬松散乱。","example":{"text":"对面来了一个～的女子，顿时引来围观者。"},"similar":["风鬟雨鬓"],"usage":"作谓语、定语；形容女子头发美丽"},{"id":47304,"word":"风禾尽起","pinyin":"fēng hé jìn qǐ","abbr":"fhjq","explanation":"比喻顺应天心，得到天助。","source":{"text":"秋，大熟。未穫，天大雷电以风，禾尽偃……王出郊，天乃雨，反风，禾则尽起。","book":"《书·金縢》"},"example":{"text":"如必不得已，则请去监国之号，仍以醇亲王暂行摄政，以示贬损，如诸臣带罪图功之例。衮衣东归，～。此上策也。","book":"《辛亥革命·武昌起义清方档案·清吏条陈》"},"usage":"作宾语、定语；用于比喻句","story":["西周时期，周武王死后，周公摄政，镇压了武王的弟弟管叔、蔡叔的叛乱。周武王的儿子周成王因受流言影响，怀疑周公的忠诚，于是“天大雷电，禾尽偃，大木斯拔，邦人大恐。”后来周公重新执政，大风把吹倒的禾苗重新竖起，从此国泰民安"]},{"id":47305,"word":"风移俗变","pinyin":"fēng yí sú biàn","abbr":"fysb","explanation":"移：改变。转移风气，改变习俗。","source":{"text":"虽遗风盛业，不逮魏晋之辰，而风移俗变，抑亦近代之美也。","book":"《周书·儒林传序》"},"similar":["风移俗改","风移俗易"],"usage":"作谓语、宾语、定语；用于风俗等"},{"id":47306,"word":"风移俗改","pinyin":"fēng yí sú gǎi","abbr":"fysg","explanation":"移：改变。转移风气，改变习俗。","source":{"text":"迁济阴太守，以德让为政，风移俗改。","book":"晋·李氏《先贤行状》"},"similar":["风移俗变","风移俗易"],"usage":"作谓语、宾语、定语；用于风俗等"},{"id":47307,"word":"风移俗易","pinyin":"fēng yí sú yì","abbr":"fysy","explanation":"移：改变。转移风气，改变习俗。","source":{"text":"因势合变，遇时之容，风移俗易，乖迕而不可通者，非君子之法也。","book":"汉·班固《答宾戏》"},"example":{"text":"使四海亿兆，皆能仪刑斯人，取法将来，～，教美化行，唐、虞、三代，诚可追配。","book":"元·高明《琵琶记·旌表》"},"similar":["风移俗改","风移俗变"],"usage":"作谓语、宾语、定语；用于风俗等"},{"id":47308,"word":"风舂雨硙","pinyin":"fēng chōng yǔ wèi","abbr":"fcyw","explanation":"舂：把谷壳用杵捣去；硙：石磨，也指用磨磨掉谷壳。比喻某种事情发生前会有一定的征兆。","source":{"text":"《释虫》曰：‘蠓虫小于蚊。’郭《图赞》曰：‘小虫似蚋，风舂雨葖。’谓其飞上如舂则天风，回旋如靡则天雨。","book":"清·段玉裁《说文解字注》"},"usage":"作宾语、定语；用于比喻句"},{"id":47309,"word":"风花雪夜","pinyin":"fēng huā xuě yè","abbr":"fhxy","explanation":"原指旧时诗文里经常描写的自然景物。后比喻堆砌词藻、内容贫乏空洞的诗文。","example":{"text":"我们对过去那些描写～的作品，要用历史唯物主义的观点加以分析。"}},{"id":47310,"word":"风花雪月","pinyin":"fēng huā xuě yuè","abbr":"fhxy","explanation":"原指旧时诗文里经常描写的自然景物。后比喻堆砌词藻、内容贫乏空洞的诗文。也指爱情之事或花天酒地的荒淫生活。","source":{"text":"虽死生荣辱，转战于前，曾未入于胸中，则何异四时风花雪月一过乎眼也。","book":"宋·邵雍《伊川击壤集序》"},"example":{"text":"小弟每常见前辈批语，有些～的字样，被那些后生们看不见，便要想到诗词歌赋那条路上去，便要坏了心术。","book":"清·吴敬梓《儒林外史》"},"similar":["花天酒地","花前月下"],"usage":"作定语、宾语；指风月场"},{"id":47311,"word":"风萍浪迹","pinyin":"fēng píng làng jì","abbr":"fplj","explanation":"比喻漂泊不定。","source":{"text":"萧涧秋在这六年之中，风萍浪迹，跑过中国底大部分的疆土。","book":"柔石《二月》"},"usage":"作谓语、定语；用于生活"},{"id":47312,"word":"风虎云龙","pinyin":"fēng hǔ yún lóng","abbr":"fhyl","explanation":"虎啸生风，龙起生云。指同类事物相互感应。旧时也比喻圣主得贤臣，贤臣遇明君。","source":{"text":"云从龙，风从虎。","book":"《周易·乾》"},"example":{"text":"古来真主百灵扶，～自不孤。","book":"明·冯梦龙《东周列国志》第二十七回"},"similar":["风从虎，云从龙"],"usage":"作定语、状语；比喻圣主、贤臣遇合"},{"id":47313,"word":"风行一世","pinyin":"fēng xíng yī shì","abbr":"fxys","explanation":"指一个时期在社会上盛行。","source":{"text":"只有那‘明心见性，不立文字’的禅宗，仍旧风行一世。","book":"胡適《清代学者的治学方法》"},"example":{"text":"他们的言论机关便是月刊杂志的《蜀报》。文字是当时～的半解放的闱墨式文章。","book":"郭沫若《反正前后》第一篇"},"similar":["风行一时"],"usage":"作谓语、定语；指在一个时期内非常流行"},{"id":47314,"word":"风行一时","pinyin":"fēng xíng yī shī","abbr":"fxys","explanation":"风行：象刮风一样流行。形容事物在一个时期内非常盛行。","source":{"text":"不是弟妄下雌黄，只怕唐兄印行的《不息斋稿》，虽然风行一时，决不能望《五丁阁稿》的项背哩！","book":"清·曾朴《孽海花》第三回"},"example":{"text":"特别是一政法学校的设立～，在成都一个省城里，竟有了四五十座私立政法学校出现。","book":"郭沫若《学生时代·我的学生时代》"},"similar":["风靡一时"],"opposite":["经久不衰"],"usage":"作谓语、定语；指在一个时期内非常流行"},{"id":47315,"word":"风行水上","pinyin":"fēng xíng shuǐ shàng","abbr":"fxss","explanation":"比喻自然流畅，不矫揉造作。","source":{"text":"象曰：风行水上，涣。","book":"《周易·涣》"},"example":{"text":"～，涣然成文章，非有意于为文也。","book":"宋·释惠洪《石门文字禅》"},"usage":"作谓语、定语；比喻自然流畅，不矫揉造作"},{"id":47316,"word":"风行电击","pinyin":"fēng xíng diàn jī","abbr":"fxdj","explanation":"形容气势迅猛。","source":{"text":"文安请为前锋，王以大军继后，风行电击，顿于霸上，咸阳以东可指麾而定。","book":"《隋书·扬谅传》"},"example":{"text":"清河公房彦藻，近秉戎律，略地东南，师之所临，～。","book":"《旧唐书·李密传》"},"similar":["风驰电击"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":47317,"word":"风行电扫","pinyin":"fēng xíng diàn sǎo","abbr":"fxds","explanation":"形容气势迅猛。同“风行电击”。","source":{"text":"公鸿勋大业，名高望重，率将戎旅，抚慰彼方，风行电扫，咸应稽服。","book":"《隋书·韦洸传》"},"similar":["风行电击"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":47318,"word":"风行电掣","pinyin":"fēng xíng diàn chè","abbr":"fxdc","explanation":"掣：闪过。像风一样飞驰而过，像闪电一样一闪即逝。形容非常迅速。","source":{"text":"先生触目，洞中机要，剖决若神，风行电掣。","book":"清·姜承烈《序》"},"similar":["风驰电掣","风驰电卷"],"usage":"作宾语、定语；形容非常迅速"},{"id":47319,"word":"风行电照","pinyin":"fēng xíng diàn zhào","abbr":"fxdz","explanation":"形容迅速威猛。","source":{"text":"将军向者经虏城下，震扬威灵，风行电照。然穷冠难量，还营愿从它道矣。","book":"《后汉书·臧宫传》"},"usage":"作宾语、定语、状语；用于比喻句"},{"id":47320,"word":"风行草从","pinyin":"fēng xíng cǎo cóng","abbr":"fxcc","explanation":"比喻有声望者的言行影响世态俗情。同“风行草偃”。","source":{"text":"故《周南》之德，《关雎》政本。本立道生，风行草从，澄其源者流清，溷其本者末浊。","book":"《后汉书·郎顗传》"},"similar":["风行草偃","风向草偃"],"usage":"作谓语、定语、分句；用于书面语"},{"id":47321,"word":"风行草偃","pinyin":"fēng xíng cǎo yǎn","abbr":"fxcy","explanation":"偃：倒伏。风一吹草就倒下。比喻道德文教的感化人。","source":{"text":"君子之德风，小人之德草，草上之风，必偃。","book":"《论语·颜渊》"},"example":{"text":"世俗日浅，小小举措已足以震动一世，使秘书得展其所为，于今日断可以～。","book":"宋·陈亮《又癸卯秋书》"},"similar":["风行草从","风向草偃"],"usage":"作谓语、定语、分句；用于书面语"},{"id":47322,"word":"风行草靡","pinyin":"fēng xíng cǎo mí","abbr":"fxcm","explanation":"比喻强大的势力能制服一切。","source":{"text":"麾旆所临，风行草靡，神算所指，龙举云属。","book":"《南齐书·高帝纪上》"},"similar":["风驰草靡"],"usage":"作谓语、定语；用于书面语"},{"id":47323,"word":"风行雨散","pinyin":"fēng xíng yǔ sàn","abbr":"fxys","explanation":"比喻在一起的人分散到四面八方。同“风流云散”。","source":{"text":"又闻本朝王公，都人士女，风行雨散，东播西流。","book":"南朝·陈徐陵《与杨仆射书》"},"similar":["风流云散"],"usage":"作谓语、定语；用于人或事物"},{"id":47324,"word":"风行雷厉","pinyin":"fēng xíng léi lì","abbr":"fxll","explanation":"形容气势的迅疾猛烈。后多比喻执行政事法令等的迅速严格。","source":{"text":"官差紧者，为黄巾钩党严厉莫停者，怕鼠窜掉头者，东溪望忙行边。","book":"明·许自昌《水浒记·纵骑》"},"example":{"text":"戒严令～。不准集会，也不准罢课。","book":"茅盾《路》"},"similar":["雷厉风行"],"usage":"作谓语、定语、状语；指行动迅速"},{"id":47325,"word":"风行革偃","pinyin":"fēng xíng gé yǎn","abbr":"fxgy","explanation":"风一吹草就倒下。比喻道德文教的感化人。","source":{"text":"君子之德风，小人之德草，草上之风，必偃。","book":"《论语·颜渊》"}},{"id":47326,"word":"风角鸟占","pinyin":"fēng jiǎo niǎo zhān","abbr":"fjnz","explanation":"风角：用风声来占卜吉凶；鸟占：用鸟的飞鸣占卜吉凶。泛指占卜术。","source":{"text":"有一术士，号富春子，善风角鸟占。","book":"明·冯构龙《古今小说》卷二十二"}},{"id":47327,"word":"风言俏语","pinyin":"fēng yán qiào yǔ","abbr":"fyqy","explanation":"风流之言，俏皮之语。","source":{"text":"雯青本是花月总持，风流教主，风言俏语，从不让人。","book":"清·曾朴《孽海花》第八回"},"usage":"作主语、宾语、定语；用于说话"},{"id":47328,"word":"风言影语","pinyin":"fēng yán yǐng yǔ","abbr":"fyyy","explanation":"捕风捉影的话语。","source":{"text":"猥以春来王粲之不归，论传海外东坡之忆死，风言影语，莫识来因，一介鲰生，何忌何惜！","book":"清·梁绍壬《两般秋雨庵随笔·致赵秋舲书》"},"similar":["风言雾语"],"usage":"作主语、宾语、定语；用于说话"},{"id":47329,"word":"风言醋语","pinyin":"fēng yán cù yǔ","abbr":"fycy","explanation":"散布嫉妒性的中伤语言。","source":{"text":"华言风语，乱相诳误。","book":"汉·焦赣《易林》"},"example":{"text":"阿福尚在那里寻瑕索瘢，～，所以连通信的人都没有，只好肚里叫苦罢了。","book":"清·曾朴《孽海花》第十七回"},"similar":["风言风语"],"usage":"作宾语；指中伤语言"},{"id":47330,"word":"风言雾语","pinyin":"fēng yán wù yǔ","abbr":"fywy","explanation":"指隐约其辞的传闻。","source":{"text":"大先生得了此电，很为着急，在省城里叠派干员侦查，虽有些风言雾语，到底探不出个实在。","book":"《孽海花》第二九回"},"similar":["风言影语"],"usage":"作主语、宾语、定语；用于说话"},{"id":47331,"word":"风言风语","pinyin":"fēng yán fēng yǔ","abbr":"fyfy","explanation":"没有根据的、不怀好意的、带有讥讽的话。另指私下议论暗中传说。","source":{"text":"华言风语，乱相诳误。","book":"汉·焦赣《易林》"},"example":{"text":"为她高高丰满的胸脯和厚实的脚板，母亲忍受过许多～的责难。","book":"冯德英《苦菜花》第一章"},"similar":["流言蜚语","流短蜚长"],"opposite":["义正言辞"],"usage":"作主语、宾语、状语；指中伤语言"},{"id":47332,"word":"风语不透","pinyin":"fēng yǔ bù tòu","abbr":"fybt","explanation":"形容异常严密。"},{"id":47333,"word":"风调雨顺","pinyin":"fēng tiáo yǔ shùn","abbr":"ftys","explanation":"调：调和；顺：和协。风雨及时适宜。形容风雨适合农时。","source":{"text":"既而克殷，风凋雨顺。","book":"《六韬》"},"example":{"text":"自后国泰民安，～，五谷丰登，人物康阜，真是升平世界。","book":"清·陈忱《水浒后传》第四十回"},"similar":["五谷丰登","人寿年丰"],"opposite":["大灾三年"],"usage":"作谓语、定语、宾语；指好气候"},{"id":47334,"word":"风谲云诡","pinyin":"fēng jué yún guǐ","abbr":"fjyg","explanation":"谲：欺诈；诡：欺诈，怪诞。风云怪诞，变幻不定。比喻局势复杂多变，神秘怪诞。","source":{"text":"世事风谲云诡，你要把握好斗争的方向。"},"example":{"text":"世事～，你要把握好斗争的方向"},"similar":["风云变幻","云谲波诡"],"usage":"作谓语、定语；指社会局势"},{"id":47335,"word":"风起云布","pinyin":"fēng qǐ yún bù","abbr":"fqyb","explanation":"布：展开，铺开。大风起来，乌云密布。","source":{"text":"众知妪即罗真人也，于是见处焚香以告焉，俄而，风起云布，微雨已至。","book":"宋·张君房《云笈七签》第119卷"},"usage":"作谓语、定语；用于天气等"},{"id":47336,"word":"风起云涌","pinyin":"fēng qǐ yún yǒng","abbr":"fqyy","explanation":"大风刮起，乌云涌现。比喻新事物相继兴起，声势很盛。","source":{"text":"划然长啸，草木震动，山鸣谷应，风起水涌。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"下笔～，能为载记之言。","book":"清·蒲松龄《聊斋志异·各本序跋题辞·唐序》"},"similar":["风起潮涌","方兴未艾"],"opposite":["风流云散"],"usage":"作谓语、定语、状语；用于天气或事物"},{"id":47337,"word":"风起云蒸","pinyin":"fēng qǐ yún zhēng","abbr":"fqyz","explanation":"大风刮起，乌云蒸腾。比喻事物迅速兴起，声势浩大。","source":{"text":"秦失其政，而陈涉发迹，诸侯作难，风起云蒸，卒亡秦族。","book":"《史记·太史公自序》"},"similar":["风起云涌","风兴云蒸"],"usage":"作谓语；比喻声势浩大"},{"id":47338,"word":"风起云飞","pinyin":"fēng qǐ yún fēi","abbr":"fqyf","explanation":"秋风起，白云飞。指触景伤怀。","source":{"text":"秋风起兮白云飞……箫鼓鸣兮发戟歌。","book":"汉·刘彻《秋风辞》"},"example":{"text":"当时汾水楼船意，～尽感吁。","book":"宁调元《燕京杂诗》"},"usage":"作宾语、定语；用于伤怀的情绪"},{"id":47339,"word":"风起水涌","pinyin":"fēng qǐ shuǐ yǒng","abbr":"fqsy","explanation":"大风刮起，水波汹涌。","source":{"text":"划然长啸，草木震动，山鸣谷应，风起水涌。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"今兹之～，谓将以救死亡也。","book":"清·梁启超《俄罗斯革命之影响》"},"similar":["风起潮涌"],"usage":"作谓语、宾语；指声势浩大"},{"id":47340,"word":"风起泉涌","pinyin":"fēng qǐ quán yǒng","abbr":"fqqy","explanation":"涌：冒出。比喻事物大量迅速地涌现。","source":{"text":"现在本国的工程师人材已风起泉涌，随处都是本国的人材。","book":"邹韬奋《萍踪寄语》"},"example":{"text":"但在散文一方面，作家却～，极一时之盛。","book":"郑振铎《插图本中国文学史》第五章"},"similar":["风起水涌"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":47341,"word":"风起浪涌","pinyin":"fēng qǐ làng yǒng","abbr":"fqly","explanation":"涌：向上升起，冒出。大风刮起，波浪汹涌。比喻事物相继兴起，声势浩大。","source":{"text":"尝与孙绰等泛海，风起浪涌，诸人并惧，安吟啸自若。","book":"《晋书·谢安传》"},"similar":["风起水涌"],"usage":"作谓语、宾语；指声势浩大"},{"id":47342,"word":"风起潮涌","pinyin":"fēng qǐ cháo yǒng","abbr":"fqcy","explanation":"涌：向上升起，冒出。大风刮起，水波汹涌。比喻事物相继兴起，声势浩大。","source":{"text":"比人家那如火如荼的新潮，那风起潮涌的新人运动，尚不知相差几千万里？","book":"李大钊《新旧思想之激战》"},"example":{"text":"～的自由战激励他们驱逐地主，打破封建遗毒的偶像。","book":"瞿秋白《饿乡纪程》"},"similar":["风起水涌"],"usage":"作谓语、定语、宾语；指声势浩大"},{"id":47343,"word":"风趣横生","pinyin":"fēng qù héng shēng","abbr":"fqhs","explanation":"形容十分幽默、诙谐。","source":{"text":"尤善指画，尝画黄初平叱石成羊，或已成羊而起立，或将成而未起，或半成而未离为石，风趣横生。","book":"《清史稿·高其佩传》"},"example":{"text":"他那～的言谈让她折服。"},"similar":["妙趣横生"],"usage":"作宾语、定语；形容十分幽默"},{"id":47344,"word":"风车云马","pinyin":"fēng chē yún mǎ","abbr":"fcym","explanation":"指神灵的车马。亦用以比喻迅疾、快速。同“风车雨马”。","source":{"text":"风车云马，其来仙仙，圣会于此。","book":"宋·欧阳修《会圣宫颂》"},"example":{"text":"古来历落吾辈人，～知何极？","book":"明·陈子龙《与客登任城太白酒楼歌》"},"similar":["风车雨马","风马云车"],"usage":"作宾语、定语；多用于比喻句"},{"id":47345,"word":"风车雨马","pinyin":"fēng chē yǔ mǎ","abbr":"fcym","explanation":"指神灵的车马。亦用以比喻迅疾、快速。","source":{"text":"风车雨马不持去，蜡独啼红怨天曙。","book":"唐·李商隐《燕台诗·冬》之四"},"similar":["风车云马","风马云车"],"usage":"作宾语、定语；多用于比喻句"},{"id":47346,"word":"风轻云净","pinyin":"fēng qīng yún jìng","abbr":"fqyj","explanation":"微风轻拂，浮云淡薄。形容天气晴好。同“风轻云淡”。","source":{"text":"风轻云净，绝胜蓬莱佳境。","book":"《群英类选〈分钗记·春游遇妓〉》"},"similar":["风轻云淡","云淡风轻"],"usage":"作谓语、定语、宾语；用于天气"},{"id":47347,"word":"风轻云淡","pinyin":"fēng qīng yún dàn","abbr":"fqyd","explanation":"微风轻拂，浮云淡薄。形容天气晴好。同“风轻云净”、“云淡风轻”。","source":{"text":"元定下的夫妻怎断，咱茶浓酒酣，趁着风轻云淡，省得着我倚门终日盼停骖。","book":"元·杨暹《西游记》第四本第十三出"},"example":{"text":"寒食春归御柳条，～日轮高。","book":"明·无心子《金雀记·定婚》"},"similar":["风轻云净"],"usage":"作谓语、定语、宾语；用于天气"},{"id":47348,"word":"风轻日暖","pinyin":"fēng qīng rì nuǎn","abbr":"fqrn","explanation":"微风轻拂，日光温暖。","source":{"text":"有如风轻日暖好鸟语，夜静山响春泉鸣。","book":"宋·欧阳修《赠沈遵》"},"similar":["风和日暖"],"usage":"作谓语、定语；用于天气等"},{"id":47349,"word":"风通道会","pinyin":"fēng tōng dào huì","abbr":"ftdh","explanation":"风：风俗，风气；通：通“同”，共同；会：共同。指风俗人情有共同之处。","source":{"text":"晋王与君邻藩，虽山河阻绝，风通道会，故来修好，君何怪焉！","book":"宋·司马光《资治通鉴·晋穆帝永和十二年》"},"usage":"作谓语、定语；用于两地之间"},{"id":47350,"word":"风里来雨里去","pinyin":"fēng lǐ lái yǔ lǐ qù","abbr":"fllylq","explanation":"形容生活、工作勤苦。","source":{"text":"我们种一年地，～的，还是吃不饱肚子。"},"example":{"text":"我们种一年地，～的，还是吃不饱肚子"},"similar":["泥里来水里去"],"usage":"作谓语、状语；指工作勤苦"},{"id":47351,"word":"风里杨花","pinyin":"fēng lǐ yáng huā","abbr":"flyh","explanation":"像风中的杨树花漂浮不定。比喻事物或事情的发展变化不定。","source":{"text":"恰便似风里杨花，水上幻泡。","book":"元·刘唐卿《降桑椹》第二折"},"example":{"text":"你就是那～，滚上滚下，如今又兴起如意儿贼歪刺骨来了。","book":"明·兰陵笑笑生《金瓶梅词话》第72回"},"usage":"作宾语、定语；用于比喻句"},{"id":47352,"word":"风门水口","pinyin":"fēng mén shuǐ kǒu","abbr":"fmsk","explanation":"指要冲。","source":{"text":"如今听得朝廷起大军来，与方腊厮杀，我这里正是风门水口。有些人家都搬了别处去躲。只留下老身，在这里看屋。","book":"明·施耐庵《水浒传》第一百十一回"},"similar":["风口浪尖"],"usage":"作宾语、定语；指要冲"},{"id":47353,"word":"风雨不改","pinyin":"fēng yǔ bù gǎi","abbr":"fybg","explanation":"遇到风雨也不更改。比喻处于恶劣环境中不变其节操。","source":{"text":"风雨思君子也。乱世则思君子不改其度焉。","book":"《诗经·郑风·风雨序》"},"example":{"text":"岂所谓徐公之行已有常，而诗人之～耶。","book":"唐·元稹《授韩皋尚书左仆射制》"},"usage":"作谓语、定语；比喻处于恶劣环境中不变其节"},{"id":47354,"word":"风雨不测","pinyin":"fēng yǔ bù cè","abbr":"fybc","explanation":"风和云都不可预测。比喻事物或局势像风云变幻那样不可预测。","source":{"text":"谁知好事多磨，风云不测，台谏官员看见同佥富贵豪宕，上本参论他赃私，奉圣旨下西台御史勘问，免不得收下监中。","book":"明·凌濛初《初刻拍案惊奇》第九卷"}},{"id":47355,"word":"风雨不透","pinyin":"fēng yǔ bù tòu","abbr":"fybt","explanation":"风刮不进，雨水透不过。形容封闭或包围得十分紧密。","source":{"text":"那小道士也不顾拾烛剪，爬起来往外还要跑，正值宝钗等下车，众婆娘媳妇正围随的风雨不透。","book":"清·曹雪芹《红楼梦》第二十九回"},"example":{"text":"里三层，外三层，把老爷和公子围了个～，都挤着要听听这到底是怎么一桩事。","book":"清·文康《儿女英雄传》第四十回"},"similar":["水泄不通","风丝不透"],"usage":"作状语、定语；形容封闭或包围得十分紧密"},{"id":47356,"word":"风雨交加","pinyin":"fēng yǔ jiāo jiā","abbr":"fyjj","explanation":"又是刮风，又是下雨。比喻几种灾难同时袭来。","source":{"text":"冬至前后，则连日阴噎，风雨交加，逾月不止。","book":"清·梁章钜《浪迹丛谈·除夕元旦两诗》"},"example":{"text":"难以想象，他是怎样渡过那～的日子的。"},"similar":["风雨凄凄"],"opposite":["风和日丽"],"usage":"作谓语、定语；形容天气十分恶劣"},{"id":47357,"word":"风雨共舟","pinyin":"fēng yǔ gòng zhōu","abbr":"fygz","explanation":"比喻共同经历患难。","example":{"text":"他俩平日相处虽不甚和睦，但在面临共同危难之时，还是～，患难与共。"}},{"id":47358,"word":"风雨凄凄","pinyin":"fēng yǔ qī qī","abbr":"fyqq","explanation":"凄凄：寒冷。风雨交加，清冷凄凉。","source":{"text":"风雨凄凄，鸡鸣喈喈。","book":"《诗经·郑风·风雨》"},"example":{"text":"歌台暧响，春光融融。舞殿冷袖，～。","book":"唐·杜牧《阿房宫赋》"},"similar":["风雨交加"],"opposite":["风和日丽"],"usage":"作谓语、定语；指清冷凄凉"},{"id":47359,"word":"风雨剥蚀","pinyin":"fēng yǔ bō shí","abbr":"fybs","explanation":"剥：侵蚀；蚀：损坏。物体因受风雨的侵蚀而损坏。","source":{"text":"汉隶岁久，风雨剥蚀，故其字无复锋芒。","book":"宋·陆游《老学庵笔记》卷四"},"usage":"作宾语、定语；用于物件等"},{"id":47360,"word":"风雨同舟","pinyin":"fēng yǔ tóng zhōu","abbr":"fytz","explanation":"在狂风暴雨中同乘一条船，一起与风雨搏斗。比喻共同经历患难。","source":{"text":"夫吴人与越人相恶也，当其同舟共济，遇风，其相救也如左右手。","book":"《孙子·九地》"},"example":{"text":"诸公热诚毅力，十倍仲恺，当有善法，济此艰难。庶几～，危亡共拯。","book":"廖仲恺《辞财政部长职通电》"},"similar":["同舟共济","休戚相关"],"opposite":["过河拆桥","背信弃义"],"usage":"作谓语、定语、状语；指共患难"},{"id":47361,"word":"风雨如晦","pinyin":"fēng yǔ rú huì","abbr":"fyrh","explanation":"指白天刮风下雨，天色暗得象黑夜一样。形容政治黑暗，社会不安。","source":{"text":"风雨如晦，鸡鸣不已。","book":"《诗经·郑风·风雨》"},"example":{"text":"游子归来了，在这～之晨，游子归来了。","book":"郭沫若《星空·归来》"},"similar":["风雨如磐","凄风苦雨"],"opposite":["天朗气清","风和日丽"],"usage":"作谓语、定语；常与“鸡鸣不已”连用"},{"id":47362,"word":"风雨如晦，鸡鸣不已","pinyin":"fēng yǔ rú huì，jī míng bù yǐ","abbr":"fyrhjmby","explanation":"晦：黑暗；已：止。风雨交加天色昏暗的早晨，雄鸡啼叫不止。比喻在黑暗的社会里不乏有识之士。","source":{"text":"风雨如晦，鸡鸣不已。既见君子，云胡不喜。","book":"《诗经·郑风·风雨》"},"example":{"text":"依仁蹈义，舍命不渝，～，让爵让产，史不绝书。","book":"清·梁启超《中国古代思潮》第三章"}},{"id":47363,"word":"风雨如盘","pinyin":"fēng yǔ rú pán","abbr":"fyrp","explanation":"盘：大石头。形容风雨极大。","source":{"text":"诗僧贯休《侠客》诗云：‘黄昏风雨黑如盘，别我不知何处去？’","book":"宋·孙光宪《兆北琐言·逸文·丁秀才奇术致物》"},"example":{"text":"愁病之躯，斗室独坐，林莽深绕，～，豪客狂临而欲呼救，声嘶力竭，谁则听闻。","book":"梁启超《中日交涉汇评》"}},{"id":47364,"word":"风雨如磐","pinyin":"fēng yǔ rú pán","abbr":"fyrp","explanation":"磐：大石头。形容风雨极大。","source":{"text":"诗僧贯休《侠客》诗云：‘黄昏风雨黑如磐，别我不知何处去？’","book":"宋·孙光宪《兆北琐言·逸文·丁秀才奇术致物》"},"example":{"text":"愁病之躯，斗室独坐，林莽深绕，～，豪客狂临而欲呼救，声嘶力竭，谁则听闻。","book":"梁启超《中日交涉汇评》"},"similar":["暴风骤雨"],"usage":"作谓语、定语；形容风雨极大"},{"id":47365,"word":"风雨对床","pinyin":"fēng yǔ duì chuáng","abbr":"fydc","explanation":"指兄弟或亲友久别后重逢，共处一室倾心交谈的欢乐之情。","source":{"text":"宁知风雨夜，复此对床眠。","book":"唐·韦应物《示全真元常》"},"example":{"text":"从沈孟养处寄奉手书，不啻五年前～之快。","book":"清·许思湄《与陈凝之》"},"similar":["对床风雨","风雨连床"],"usage":"作谓语；指兄弟或亲友久别后重逢"},{"id":47366,"word":"风雨摇摆","pinyin":"fēng yǔ yáo bǎi","abbr":"fyyb","explanation":"在风雨中飘荡不安，比喻局势动荡不安。","example":{"text":"该国经过接二连三的大罢工和游行示威的冲击，内阁已在～之中，随时可能被迫辞职。"}},{"id":47367,"word":"风雨无阻","pinyin":"fēng yǔ wú zǔ","abbr":"fywz","explanation":"不受刮风下雨的阻碍。指预先约好的事情，一定按期进行。","source":{"text":"黄秀才从陆路短船，风雨无阻，所以赶着了。","book":"明·冯梦龙《醒世恒言》卷三十二"},"example":{"text":"宝钗说道：“一月只要两次就够了。拟定日期，风雨无阻。”","book":"清·曹雪芹《红楼梦》第三十七回"},"usage":"作谓语、定语；指持之以恒"},{"id":47368,"word":"风雨时若","pinyin":"fēng yǔ shí ruò","abbr":"fysr","explanation":"指风调雨顺。","source":{"text":"君行敬，则时雨顺之。","book":"《书·洪范》：“曰肃，时雨若……曰圣，时风若。”孔传"},"example":{"text":"亭无枹鼓之警，里有室家之乐。士气始奋，而人和始洽。至于～，田出自倍。","book":"宋·曾巩《福州上执政书》"},"similar":["风调雨顺"],"usage":"作谓语；用于局面"},{"id":47369,"word":"风雨晦冥","pinyin":"fēng yǔ huì míng","abbr":"fyhm","explanation":"指风雨交加，天色昏暗犹如黑夜。同“风雨晦暝”。","source":{"text":"乙巳迟明，至江岸，风雨晦冥，诸将皆以为未可渡，帝不从。","book":"《元史·世祖纪一》"},"similar":["风雨晦暝","风雨如晦"],"usage":"作谓语、定语；用于时局等"},{"id":47370,"word":"风雨晦暝","pinyin":"fēng yǔ huì míng","abbr":"fyhm","explanation":"指风雨交加，天色昏暗犹如黑夜。","source":{"text":"遂起视之，则风雨晦暝，缠绕此树，电光晃耀，忽上忽下。","book":"唐·王度《古镜记》"},"similar":["风雨晦冥","风雨如晦"],"usage":"作谓语、定语；用于时局等"},{"id":47371,"word":"风雨漂摇","pinyin":"fēng yǔ piāo yáo","abbr":"fypy","explanation":"比喻局势动荡不安，很不稳定。同“风雨飘摇”。","source":{"text":"风雨漂摇，支体鳞皴。","book":"唐·李华《二孝赞》"},"example":{"text":"释晨错温清之忧，而怀～之惧。","book":"清·钱谦益《〈孙楚惟诗稿〉序》"},"similar":["风雨飘摇"],"usage":"作谓语、定语、宾语；形容政权等"},{"id":47372,"word":"风雨萧条","pinyin":"fēng yǔ xiāo tiáo","abbr":"fyxt","explanation":"萧条：寂寞。风雨交加，显出冷落的景象。","source":{"text":"访遗踪于女峡，风雨萧条，征往事于姑泉，弦歌响亮。","book":"唐·崔融《嵩山启母庙碑》"},"example":{"text":"春香侍春小姐，伤春伤到深秋，今夕中秋佳节，～。","book":"明·汤显祖《还魂记·闹殇》"},"usage":"作定语；指冷落的景象"},{"id":47373,"word":"风雨连床","pinyin":"fēng yǔ lián chuáng","abbr":"fylc","explanation":"指兄弟或亲友久别后重逢，共处一室倾心交谈的欢乐之情。同“风雨对床”。","source":{"text":"回忆省垣聚首，风雨连床，曾几何时？谁怜一别，竟无会面之期。","book":"清·秋瑾《挽故人陈阕生》诗序"},"similar":["对床风雨","对床夜雨"],"usage":"作定语、宾语；指亲友或兄弟久别重逢"},{"id":47374,"word":"风雨飘摇","pinyin":"fēng yǔ piāo yáo","abbr":"fypy","explanation":"飘摇：飘荡。在风雨中飘荡不定。比喻局势动荡不安，很不稳定。","source":{"text":"予室翘翘，风雨所飘摇。","book":"《诗经·豳风·鸱号》"},"example":{"text":"我现在离家已十二三年，值此新秋，又是～的深夜，天涯羁客不胜落寞的情怀。","book":"郭沫若《学生时代·芭蕉花》"},"similar":["摇摇欲坠"],"opposite":["稳如泰山"],"usage":"作谓语、定语、宾语；形容政权等"},{"id":47375,"word":"风雨飘零","pinyin":"fēng yǔ piāo líng","abbr":"fypl","explanation":"受风雨吹打而飘失零落。","source":{"text":"风雨飘零，心神不宁，骨节疼痛，都足以引起他们剧列的忿怒。","book":"叶圣陶《倪焕之》十二"},"usage":"作谓语、定语；用于生活等"},{"id":47376,"word":"风雨飘飖","pinyin":"fēng yǔ piāo yáo","abbr":"fypy","explanation":"比喻局势动荡不安，很不稳定。同“风雨飘摇”。","source":{"text":"壬寅仲冬，便道过访虽座上客满，不异曩时，而风雨飘飖，渐觉朱颜非昔矣。","book":"清·珠泉居士《续板桥杂记·丽品》"},"similar":["风雨飘摇"],"usage":"作谓语、定语、宾语；形容政权等"},{"id":47377,"word":"风雪交加","pinyin":"fēng xuě jiāo jiā","abbr":"fxjj","explanation":"风和雪同时袭来。","source":{"text":"风雪交加冻不醒，抱琴谁共赏《湘灵》。","book":"元·程文海《浣溪沙·题湘水行吟》词"},"example":{"text":"一个～的夜晚，他回到了我们中间。"},"similar":["狂风暴雪"],"usage":"作谓语、定语；指风雪很大"},{"id":47378,"word":"风雷之变","pinyin":"fēng léi zhī biàn","abbr":"flzb","explanation":"指上天示警的灾异现象。","source":{"text":"据《书·金縢》载：周武王死后，周公摄政，镇压了武王的弟弟管叔、蔡叔等的叛乱。武王子成王因受流言影响，怀疑周公的忠诚，于是“天大雷电以风，禾尽偃，大木斯拔，邦人大恐。”"},"example":{"text":"夏四月，京师地震。癸巳司空陈褒以灾异免。于是犹有～，有司复以追咎三公。","book":"《后汉纪·安帝纪下》"},"usage":"作宾语；用于天气等","story":["西周时期，周武王死后，周公摄政，镇压了武王的弟弟管叔、蔡叔的叛乱。周武王的儿子周成王因受流言影响，怀疑周公的忠诚，于是“天大雷电，禾尽偃，大木斯拔，邦人大恐。”后来周公重新执政，大风把吹倒的禾苗重新竖起，从此国泰民安"]},{"id":47379,"word":"风雷火炮","pinyin":"fēng léi huǒ pào","abbr":"flhp","explanation":"形容十分急躁。","source":{"text":"上前天我们才到上海，货还没有起完，到了半夜里，忽然宪太太来了，风雷火炮的一阵，马上就要开船，脸上很带点怒色。","book":"清·吴研人《二十年目睹之怪现状》第五十二回"},"usage":"作宾语、定语；用于比喻句"},{"id":47380,"word":"风霜雨雪","pinyin":"fēng shuāng yǔ xuě","abbr":"fsyx","explanation":"比喻经历了种种艰难困苦。","source":{"text":"一梦中十八年，见了酒色财气，人我是非，贪嗔痴爱，风霜雨雪。","book":"元·马致远《黄梁梦》第四折"},"similar":["风风雨雨"],"usage":"作主语、宾语、定语；多用于比喻句"},{"id":47381,"word":"风静浪平","pinyin":"fēng jìng làng píng","abbr":"fjlp","explanation":"静：安静；平：安定。风已平息，浪已安静。指没有风浪。比喻平静无事。","source":{"text":"待到～时，我们再推出这项改革措施。"},"example":{"text":"待到～时，我们再推出这项改革措施"},"similar":["风平浪静"],"usage":"作定语、谓语；比喻事情平息"},{"id":47382,"word":"风靡一世","pinyin":"fēng mǐ yī shì","abbr":"fmys","explanation":"靡：倒下；风靡：风行。随风一边倒。形容事物在一个时期内非常流行。","source":{"text":"个人主义，渐得势力，所谓民约说、人权论等，渐风靡一世。","book":"梁启超《生计学学说沿革小史》"},"similar":["风靡一时"],"usage":"作谓语、定语；指流行"},{"id":47383,"word":"风靡一时","pinyin":"fēng mǐ yī shí","abbr":"fmys","explanation":"风靡：草木随风倒下，引伸为很风行。形容事物在一个时期里极其盛行，象风吹倒草木一样。","source":{"text":"于是一时风靡，议论如出一口。","book":"明·沈德符《野获编》第15卷"},"example":{"text":"《牡丹亭》的故事曾经那么～，赚了不少人的热泪。","book":"秦牧《艺海拾贝·幻想的彩翼》"},"similar":["风行一时","盛极一时"],"opposite":["久盛不衰"],"usage":"作谓语、定语；指流行"},{"id":47384,"word":"风靡云涌","pinyin":"fēng mǐ yún yǒng","abbr":"fmyy","explanation":"涌：水腾跃，涌现。大风刮起来，乌云涌上来。比喻新生事物相继兴起，声势浩大。","source":{"text":"这种世界的社会力，在人间一有动荡，世界各处都有风靡云涌、山鸣谷应的样子。","book":"李大钊《Bolshevism的胜利》"},"similar":["风起云涌"],"usage":"作谓语、定语、状语；用于天气或事物"},{"id":47385,"word":"风靡云蒸","pinyin":"fēng mǐ yún zhēng","abbr":"fmyz","explanation":"靡：倒向；蒸：向上。比喻事物迅猛而普遍出现。","source":{"text":"况八纮既奄，风靡云争，抱玉者联肩，握珠者踵武。","book":"南朝·梁·钟嵘《诗品·总论》"},"usage":"作谓语、定语；用于事物等"},{"id":47386,"word":"风韵犹存","pinyin":"fēng yùn yóu cún","abbr":"fyyc","explanation":"形容中年妇女仍然保留着优美的风姿。","source":{"text":"其母虽属徐娘，丰韵犹饶，老蚌固宜出此明珠。","book":"清·王韬《淞隐漫录》"},"example":{"text":"她虽然已有五十几岁，但～。"},"similar":["风姿绰约","丰韵犹存"],"opposite":["人老珠黄","老态龙钟"],"usage":"作谓语、定语；常和“半老徐娘”连用"},{"id":47387,"word":"风风势势","pinyin":"fēng fēng shì shì","abbr":"ffss","explanation":"举动不正常，易情绪冲动。","example":{"text":"请远离这个～的人，以免受到伤害。"},"similar":["疯疯癫癫","风张风势"],"usage":"作谓语、定语、状语；用于口语"},{"id":47388,"word":"风风火火","pinyin":"fēng fēng huǒ huǒ","abbr":"ffhh","explanation":"形容急急忙忙，冒冒失失的样子。","source":{"text":"妈千叮咛万叮咛，务必要平稳，切不可像在娘家门上那样风风火火，得罪了人。","book":"王吉呈《女御史》"},"example":{"text":"他那～的性格是很难改变的。"},"similar":["冒冒失失","匆匆忙忙"],"usage":"作谓语、定语；用于口语"},{"id":47389,"word":"风风雨雨","pinyin":"fēng fēng yǔ yǔ","abbr":"ffyy","explanation":"不断地刮风下雨。比喻障碍重重。又比喻时代动荡，谣言纷传。","source":{"text":"风风雨雨清明，莺莺燕燕关情。","book":"元·张可久《晋天乐·忆鉴湖》"},"example":{"text":"若闹闹嚷嚷，弄得满坝～，不是逗得人暗里朝他说怪话吗？（克非《春潮急》二十六）"},"usage":"作宾语；用于人的经历"},{"id":47390,"word":"风风韵韵","pinyin":"fēng fēng yùn yùn","abbr":"ffyy","explanation":"①形容韵致、意态美好。②声音悠长婉转的样子。","source":{"text":"好风风韵韵，捻捻腻腻，济济楚楚。","book":"金·董解元《西厢记诸宫调》卷三"},"example":{"text":"月下金觥，膝上瑶筝，口口声声，～。","book":"元·张可久《折桂令·酒边分得卿字韵》曲"},"usage":"作谓语、定语；多用于女性"},{"id":47391,"word":"风飑电击","pinyin":"fēng biāo diàn jī","abbr":"fbdj","explanation":"飑：强风突然发作。风雨雷电交加。比喻风气或某种现象极盛。","source":{"text":"游说之徒，风飑电击。","book":"汉·班固《答宾戏》"}},{"id":47392,"word":"风飞云会","pinyin":"fēng fēi yún huì","abbr":"ffyh","explanation":"会：会合，聚合。比喻有才能的人遭逢时会或君臣遇合。","source":{"text":"一旦风飞云会，加之百官之上，立于庙堂之内，以数尺之身，任天下之责，方寸之心，关天下之虑。","book":"元·揭傒斯《与尚书右丞相书》"},"usage":"作宾语、定语；用于比喻句"},{"id":47393,"word":"风飧水宿","pinyin":"fēng sūn shuǐ sù","abbr":"fsss","explanation":"飧：晚餐；宿：住宿，过夜。风里吃饭，露天睡觉。形容旅途或野外工作的辛苦。","source":{"text":"路由扬州过了长江，进了润州，风飧水宿，夜住晓行，来到平江。","book":"明·凌濛初《二刻拍案惊奇》第六卷"},"similar":["风飧露宿","风餐露宿"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47394,"word":"风飧露宿","pinyin":"fēng sūn lù sù","abbr":"fsls","explanation":"飧：晚餐；露：露水，露天；宿：住宿，过夜。风里吃饭，露天睡觉。形容旅途或野外工作的辛苦。","source":{"text":"风飧露宿宁非苦，且试平时铁石心。","book":"宋·陆游《壮士吟》"},"similar":["风餐露宿","风飧水宿"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47395,"word":"风餐水宿","pinyin":"fēng cān shuǐ sù","abbr":"fcss","explanation":"在风中吃饭，在船上过夜。","source":{"text":"风餐水宿六十里，蛇退猿啼百八盘。","book":"宋·黄庭坚《上南陵坡》"},"example":{"text":"我老身与女儿行至此间，～，受了多少辛苦。","book":"明·顾大典《青衫记·兴遇蛮素》"},"similar":["风飧水宿","风餐水栖"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47396,"word":"风餐水栖","pinyin":"fēng cān shuǐ qī","abbr":"fcsq","explanation":"在风中进食，在水上歇宿。形容行旅生活的艰辛。","example":{"text":"我已经过惯了～的生活。"},"similar":["风餐水宿","风餐露宿"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47397,"word":"风餐雨宿","pinyin":"fēng cān yǔ sù","abbr":"fcys","explanation":"在风中吃饭，在雨地住宿。形容旅途生活的艰苦。","source":{"text":"露宿风餐六百里，明朝饮马南江水。","book":"宋·苏轼《将至筠先寄迟适远三犹子》诗"},"example":{"text":"～，走了二十八个日头，正月十四日，进了顺城门，在河漕边一个小庵内住了，安顿了行李。","book":"清·西周生《醒世姻缘传》第五回"},"similar":["风餐水宿","风餐露宿"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47398,"word":"风餐露宿","pinyin":"fēng cān lù sù","abbr":"fcls","explanation":"风里吃饭，露天睡觉。形容旅途或野外工作的辛苦。","source":{"text":"露宿风餐六百里，明朝饮马南江水。","book":"宋·苏轼《将至筠先寄迟适远三犹子》诗"},"example":{"text":"宋·苏轼《将至筠先寄迟适远三犹子》诗：“露宿风餐六百里，明朝饮马南江水。”"},"similar":["栉风沐雨","草行露宿","餐风饮露"],"usage":"作谓语、定语、状语；形容旅途艰辛"},{"id":47399,"word":"风饕雪虐","pinyin":"fēng tāo xuě nüè","abbr":"ftxn","explanation":"饕：贪残；虐：暴虐。又是刮风，又是下雪。形容天气非常寒冷。","source":{"text":"岁弊寒凶，雪虐风饕。","book":"唐·韩愈《祭河南张员外文》"},"example":{"text":"吾不能学桃杏辈趋时，故际穷年，～，零落如此。","book":"元·王冕《竹斋集·梅先生传》"}},{"id":47400,"word":"风马不接","pinyin":"fēng mǎ bù jiē","abbr":"fmbj","explanation":"犹言风马牛不相及。","source":{"text":"凡祖离送别，必在有情，下官与殷风马不接，无缘扈从。","book":"《宋书·隐逸传·王弘之》"},"similar":["风马牛不相及"],"usage":"作谓语、定语；用于不相干的事"},{"id":47401,"word":"风马云车","pinyin":"fēng mǎ yún chē","abbr":"fmyc","explanation":"指神灵的车马。","source":{"text":"风马云车，肃焉徘徊。","book":"唐·柳宗元《雷塘祷雨文》"},"example":{"text":"～历历，见桂葆乍迎娇如雪。","book":"清·龚自珍《霓裳中序第一》词"},"similar":["风车雨马"],"usage":"作宾语、定语；多用于比喻句"},{"id":47402,"word":"风马牛","pinyin":"fēng mǎ niú","abbr":"fmn","explanation":"风：放逸，走失。指齐楚两地相离甚远，马牛不会走失至对方地界。后用以比喻事物之间毫不相干。同“风马牛不相及”。","source":{"text":"唐责之：‘某与公风马牛耳，不意盱眙相遇，实慕君子，何至驺卒不若也。’","book":"唐·段成式《酉阳杂俎·盗侠》"},"example":{"text":"至于释迦牟尼，可更与文艺界～了。","book":"鲁迅《热风·反对含泪的批评家》"},"similar":["风马牛不相及"],"usage":"作谓语、宾语、定语；用于不相干的事"},{"id":47403,"word":"风马牛不相及","pinyin":"fēng mǎ niú bù xiāng jí","abbr":"fmnbxj","explanation":"风：走失；及：到。本指齐楚相去很远，即使马牛走失，也不会跑到对方境内。比喻事物彼此毫不相干。","source":{"text":"君处北海，寡人处南海，唯是风马牛不相及也。","book":"《左传·僖公四年》"},"example":{"text":"咱们彼此其实没有丝毫关联，望帝和杜鹃也～。","book":"郭沫若《百花齐放·杜鹃花》"},"similar":["驴唇不对马嘴"],"opposite":["唇齿相依","息息相关"],"usage":"作宾语、定语、补语；用于事情","story":["春秋时期，齐桓公任用管仲做丞相，在管仲的治理下，国力强大。楚国不向齐国朝贡，齐桓公就派兵攻打楚国，楚国使臣说：“你们齐国与楚国一南一北，相距很远，风马牛不相及，为何要发动战争呢？”经谈判，楚国与齐国修好"]},{"id":47404,"word":"风驰云卷","pinyin":"fēng chí yún juǎn","abbr":"fcyj","explanation":"形容迅速席卷。","source":{"text":"西北则张乐行等风驰云卷，天下已非满洲所有，其督师大臣赛尚阿、和春一败涂地，事无可为。","book":"邹鲁《中国同盟会》"},"example":{"text":"邹鲁《中国同盟会》：“西北则张乐行等～，天下已非满洲所有，其督师赛尚阿、和春一败涂地，事无可为。”"},"usage":"作宾语、定语、状语；多用于比喻句"},{"id":47405,"word":"风驰云走","pinyin":"fēng chí yún zǒu","abbr":"fcyz","explanation":"形容奔驰疾速。","source":{"text":"三奏金革，四门出兵，连旗万计，风驰云走，两皆列阵。","book":"唐·牛僧孺《玄怪录·岑顺》"},"example":{"text":"骋骅骝，～，防他重伤未死，一息尚弥留。","book":"清·伤时子《苍鹰击·劫械》"},"usage":"作宾语、定语、状语；多用于比喻句"},{"id":47406,"word":"风驰电击","pinyin":"fēng chí diàn jī","abbr":"fcdj","explanation":"形容迅速出击。","source":{"text":"奋威四人，主择材力，论兵革，风驰电击，不知所由。","book":"《六韬·龙韬·王翼》"},"example":{"text":"王师北伐如宣王，～复土疆。","book":"宋·陆游《观运粮图》诗"},"similar":["风驰霆击"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":47407,"word":"风驰电卷","pinyin":"fēng chí diàn juǎn","abbr":"fcdj","explanation":"形容像刮风和闪电那样迅速。同“风驰电掣”。","source":{"text":"突厥所长，惟恃骑射，见利即前，知难便走，风驰电卷，不恒其陈。","book":"唐·温大雅《大唐创业起居注》卷一"},"example":{"text":"马夫拉动缰绳，一会儿～，把一个青年会会员陈千秋，不知赶到哪里去了。","book":"清·曾朴《孽海花》第二九回"},"similar":["风驰电掣","风驰云卷"],"usage":"作谓语、定语、状语；用于书面语"},{"id":47408,"word":"风驰电掣","pinyin":"fēng chí diàn chè","abbr":"fcdc","explanation":"驰：奔跑；掣：闪过。形容非常迅速，象风吹电闪一样。","source":{"text":"奋威四人，主择材力，论兵革，风驰电掣，不知所由。","book":"《六韬·龙韬·王翼》"},"example":{"text":"黄飞虎枪法如～，往来如飞。","book":"明·许仲琳《封神演义》第六十回"},"similar":["流星赶月","电炮火石"],"opposite":["老牛破车","蜗行牛步"],"usage":"作谓语、定语、状语；用于书面语"},{"id":47409,"word":"风驰电赴","pinyin":"fēng chí diàn fù","abbr":"fcdf","explanation":"形容迅速赶赴。","source":{"text":"如其迷逆不化，复欲送死者，南北诸军风驰电赴，若身手之救痛痒，率然之应首尾，山陵既固，中夏小康。","book":"《晋书·孙绰传》"},"usage":"作谓语、状语；用于行动等"},{"id":47410,"word":"风驰电逝","pinyin":"fēng chí diàn shì","abbr":"fcds","explanation":"形容像刮风和闪电那样迅速。同“风驰电掣”。","source":{"text":"风驰电逝，蹑景追风；凌历中原，顾盼生姿。","book":"三国·魏·嵇康《赠秀才入军》"},"example":{"text":"柏夭导车，造父为右，～三千里。","book":"《云笈七签》卷一一四"},"similar":["风驰电卷","风驰电掣","风驰电骋"],"usage":"作谓语、定语、状语；用于书面语"},{"id":47411,"word":"风驰电骋","pinyin":"fēng chí diàn chěng","abbr":"fcdc","explanation":"形容像刮风和闪电那样迅速。同“风驰电掣”。","source":{"text":"故字曰至柔，名曰无形，是以无形之物不以坚，坚不以壮。壮，故能敝天地，销铜铁，风驰电骋，经极日月，周流上下。","book":"汉·严遵《道德指归论·至柔》"},"similar":["风驰电掣"],"usage":"作谓语、状语；用于行动等"},{"id":47412,"word":"风驰草靡","pinyin":"fēng chí cǎo mǐ","abbr":"fccm","explanation":"比喻强大的势力能制服一切。同“风行草靡”。","source":{"text":"敦煌公至盩厔，所过诸县及诸贼界，莫不风驰草靡，裹粮卷甲，唯命是从。","book":"唐·温大雅《大唐创业起居注》卷二"},"similar":["风行草靡"],"usage":"作谓语、定语；用于书面语"},{"id":47413,"word":"风驰雨骤","pinyin":"fēng chí yǔ zhòu","abbr":"fcyz","explanation":"形容像风雨一样迅捷猛烈。","source":{"text":"每敦阵整旅，左旋右抽，虽风驰雨骤，亦无以喻其迅捷也，故当时骑士咸乐为用。","book":"《旧五代史·梁书·谢彦章传》"},"example":{"text":"任大老爷亲自骑着快马，带着八十名亲兵小队，～的在后赶来。","book":"清·张春帆《宦海》第十二回"},"usage":"作宾语、定语、状语；用于风雨"},{"id":47414,"word":"风驰霆击","pinyin":"fēng chí tíng jī","abbr":"fctj","explanation":"形容迅速出击。同“风驰电击”。","source":{"text":"华盛顿以编户之细民，苦英人之虐政，风驰霆击，崛起美洲。","book":"陈炽《庸书·议院》"},"similar":["风驰电击"],"usage":"作宾语、定语、状语；用于比喻句"},{"id":47415,"word":"风驱电击","pinyin":"fēng qū diàn jī","abbr":"fqdj","explanation":"形容迅速出击。同“风驰电击”。","source":{"text":"散骑常侍、骁骑将军段宏铁马二千，风驱电击，步自竟陵，直至鄢郢。","book":"《宋书·谢晦传》"},"similar":["风驱电扫"],"usage":"作宾语、定语；用于比喻句"},{"id":47416,"word":"风驱电扫","pinyin":"fēng qū diàn sǎo","abbr":"fqds","explanation":"形容像刮风、闪电那样迅速驰赴和扫除。","source":{"text":"征虏将军投袂以先国急，束马旅师，横江竞济，风驱电扫，制胜转丸。","book":"《南齐书·裴叔业崔慧景等传论》"},"example":{"text":"平生闻谭公胸中数万甲兵，所至～，今治蜀顾如此，乃知宏才不器，无适非宜，哲士达权，随时善变也。","book":"明·张居正《答蜀中开府谭二华书》"},"similar":["风驱电击"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":47417,"word":"风骨峭峻","pinyin":"fēng gǔ qiào jùn","abbr":"fgqj","explanation":"峭峻：山又高又陡。形容人很有骨气，刚直不阿。也比喻诗文书画雄健有力的风格。","source":{"text":"孔丞别我适临汝，风骨峭峻遗尘埃。","book":"唐·韩愈《感春》诗"},"usage":"作谓语、定语；指人或诗画作品"},{"id":47418,"word":"风高放火，月黑杀人","pinyin":"fēng gāo fàng huǒ，yuè hēi shā rén","abbr":"fgfhyhsr","explanation":"风高：风非常大。月黑：指黑夜。趁风大放火，趁黑夜杀人。形容盗匪趁机作案的行径。","source":{"text":"欧阳公与人行令，各作诗两句，须犯徒以上罪者……一云：‘月黑杀人夜，风高放火天。’","book":"元·元怀《拊掌录》"},"example":{"text":"～，无粮同饿，得肉均分。","book":"明·冯梦龙《警世通方·范鳅儿又镜重圆》"},"similar":["杀人放火"],"usage":"作宾语、定语、分句；指干坏事"},{"id":47419,"word":"风鬟雨鬓","pinyin":"fēng huán yǔ bìn","abbr":"fhyb","explanation":"形容妇女在外奔波劳碌，头发散乱。","source":{"text":"见大王爱女牧羊于野，风鬟雨鬓，所不忍视。","book":"唐·李朝威《柳毅》"},"example":{"text":"～，偏是来无准。倦倚玉栏看月晕，容易语低香近。","book":"清·纳兰性德《忆梁汾》"},"similar":["风鬟雾鬓","风环雨鬓"],"usage":"作谓语、定语；形容女子头发美丽"},{"id":47420,"word":"风鬟雾鬓","pinyin":"fēng huán wù bìn","abbr":"fhwb","explanation":"鬟：环形发髻；鬓：脸旁靠近耳朵的头发。形容女子头发的美。也形容女子头发蓬松散乱。","source":{"text":"花边雾鬓风鬟满，酒畔云衣月扇香。","book":"宋·苏轼《题毛女贞》诗：“雾鬓风鬟木叶衣，山川良是昔人非。”宋·范成大《新作景亭程咏之提刑赋诗次其韵》"},"example":{"text":"如今憔悴，～，怕见夜间出去。","book":"宋·李清照《永遇乐》词"},"similar":["风鬟雨鬓"],"usage":"作谓语、定语；形容女子头发美丽"},{"id":47421,"word":"风魔九伯","pinyin":"fēng mó jiǔ bó","abbr":"fmjb","explanation":"风：通“疯”；风魔：疯癫。疯狂痴癫。","source":{"text":"休怪！我曾见风魔九伯，不曾见这般个神狗乾郎在。","book":"金·董解元《西厢记诸宫调》第五卷"},"example":{"text":"才五更天气，你敢～，引的我那里去？","book":"元·关汉卿《鲁斋郎》第二折"},"usage":"作宾语、定语；用于口语"},{"id":47422,"word":"飒爽英姿","pinyin":"sà shuǎng yīng zī","abbr":"ssyz","explanation":"飒爽：豪迈矫健；英姿：英勇威武的姿态。形容英俊威武、精神焕发的样子。","source":{"text":"褒公鄂公毛发动，英姿飒爽来酣战。","book":"唐·杜甫《丹青引赠曹将军霸》"},"example":{"text":"～五尺枪，曙光初照演兵场。中华儿女多奇志，不爱红装爱武装。","book":"毛泽东《为女民兵题照》诗"},"similar":["英姿飒爽"],"usage":"作谓语、定语；形容人的精神饱满"},{"id":47423,"word":"飘如游云","pinyin":"piāo rú yóu yún","abbr":"pryy","explanation":"飘：飘逸；游云：流动的云彩。形容书法和人的仪容俊逸潇洒。","source":{"text":"时人目王右军飘如游云，矫若惊龙。","book":"南朝·宋·刘义庆《世说新语·容止》"},"usage":"作谓语、定语；用于书法或人的神态"},{"id":47424,"word":"飘樊落溷","pinyin":"piāo fán luò hùn","abbr":"pflh","explanation":"比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同“飘籓坠溷”。","source":{"text":"凡良家女子，遇风雨之摧残，而堕烟花之小劫者，随在皆是，飘樊落溷，狼籍堪悲；逐水沾泥，凄凉何极！","book":"清·王韬《海陬冶游附录》中卷"},"similar":["飘藩坠溷"],"usage":"作宾语、定语；用于人的命运"},{"id":47425,"word":"飘泊无定","pinyin":"piāo bó wú dìng","abbr":"pbwd","explanation":"飘：随水漂流；泊：停留，暂住。比喻东奔西走，生活不安定。","source":{"text":"遥怜好兄弟，飘泊雨江村。","book":"宋·范成大《元夜忆群从》"},"example":{"text":"他一生都是～，到处流浪。"},"similar":["居无定所"],"opposite":["安居乐业"],"usage":"作补语、定语；指生活不安定"},{"id":47426,"word":"飘洋航海","pinyin":"piāo yáng háng hǎi","abbr":"pyhh","explanation":"渡过海洋。多指去异国他乡或远处。同“飘洋过海”。"},{"id":47427,"word":"飘洋过海","pinyin":"piāo yáng guò hǎi","abbr":"pygh","explanation":"渡过海洋。多指去异国他乡或远处。","source":{"text":"据说好几百年以前，是大群中国人飘洋过海，帮助当地人民辛勤开辟才逐渐繁荣起来的。","book":"秦牧《回国》"},"example":{"text":"我不想～到异国去生活。"},"similar":["远涉重洋"],"usage":"作谓语、宾语；指到异国"},{"id":47428,"word":"飘然欲仙","pinyin":"piāo rán yù xiān","abbr":"pryx","explanation":"轻飘飘好像要超脱尘世变成神仙。形容洋洋得意。也形容动作优美轻盈。同“飘飘欲仙”。","source":{"text":"循若耶溪行……使人飘然欲仙，不知在人间世。","book":"宋·邓牧《伯牙琴·续补·自陶山游云门》"},"example":{"text":"手里一把白马尾拂尘，风儿吹过，绸大衫在下部飘起，白拂尘遮满前胸，长头发散在项后，上中下三部迎风乱舞，真是～。","book":"老舍《老张的哲学》第二七"},"similar":["飘飘欲仙"],"usage":"作谓语、定语；指人忘乎所以"},{"id":47429,"word":"飘然而至","pinyin":"piāo rán ér zhì","abbr":"prez","explanation":"飘然：轻快或潇洒的样子。形容轻快或潇洒地来到。"},{"id":47430,"word":"飘然若仙","pinyin":"piāo rán ruò xiān","abbr":"prrx","explanation":"飘然：神形潇洒的样子。神形潇洒好像神仙。形容人的动作潇洒自如轻盈优美。","example":{"text":"她那～的样子让人着迷。"},"similar":["飘然欲仙"],"usage":"作谓语、定语；用于人的神态"},{"id":47431,"word":"飘然远翥","pinyin":"piāo rán yuǎn zhù","abbr":"pryz","explanation":"翥：向上飞。指轻快地飞向高空。比喻乐于抛弃官禄而远离庸俗的官场。","source":{"text":"侪辈中果有三数人身先引退，飘然远翥，实足以对于今日号称伟人志士、英雄豪杰……","book":"清·蔡锷《致唐继尧皓电》"},"usage":"作谓语、定语；用于比喻句"},{"id":47432,"word":"飘瓦虚舟","pinyin":"piāo wǎ xū zhōu","abbr":"pwxz","explanation":"比喻凭空加害于人而又无从追究的事物。","source":{"text":"方舟而济于河，有虚船来触舟，虽有惼心之人不怒。","book":"战国·宋·庄周《庄子·达生》：“虽有忮心者不怨飘瓦。”《山木》"},"example":{"text":"～岂有因，谁当入爨惜劳薪。","book":"清·查慎行《惠研溪庶常从京……》"},"usage":"作谓语、宾语；指凭空加害人又无从追究"},{"id":47433,"word":"飘籓坠溷","pinyin":"piāo fān zhuì hùn","abbr":"pfzh","explanation":"比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同“飘茵堕溷”。"},{"id":47434,"word":"飘籵坠溷","pinyin":"piāo fān zhuì hùn","abbr":"pfzh","explanation":"比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同飘茵堕溷”。"},{"id":47435,"word":"飘茵堕溷","pinyin":"piāo yīn duò hùn","abbr":"pydh","explanation":"比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。","source":{"text":"《梁书·儒林传·范缜》：“子良（竟陵王萧子良）问曰：‘君不信因果，世间何得有富贵，何得有贱贫？’缜答曰：‘人之生譬如一树花，同发一枝，俱开一蒂，随风而堕，自有拂帘幌坠于茵席之上，自有关篱墙落于粪混之侧。坠茵席者，殿下是也；落粪溷者"},"example":{"text":"～各前因，地下怜香有几人？抵死只逢皮相士，伤心岂独是真真。","book":"清·百一居士《壶天录》卷下"},"similar":["飘茵落溷","飘茵随溷"],"usage":"作谓语、定语；用于书面语","story":["南朝梁代时期，子良与无神论者范缜在一起谈人生富贵之事，问富贵与因果的关系。范缜回答说：“人生就同一树花，虽然同处于一根树枝上，突然刮起了大风，花瓣有随风飘到富贵人家的座垫上，也有飘到人家厕所里的，因果在起作用。”"]},{"id":47436,"word":"飘茵落溷","pinyin":"piāo yīn luò hùn","abbr":"pylh","explanation":"随风而落，有的飘在茵席上，有的落在粪坑里。比喻由于偶然的机缘而有富贵贫贱的不同命运。也指女子堕落风尘。","source":{"text":"人之生譬如一树花，同发一枝，俱开一蒂，随风而堕，自有拂帘幌坠于茵席之上，自有关篱墙落于粪溷之侧。坠茵席者，殿下是也；落粪溷者，下官是也。","book":"《梁书·儒林传·范缜》"},"example":{"text":"～事争差，狼藉高枝一朵花。今日回头声价减，可怜彩凤已随雅。","book":"清·竹恬《青溪杂忆诗柬捧花生同赋》"},"similar":["飘茵随溷","飘茵堕溷"],"usage":"作谓语、定语；指人的处境","story":["南朝梁代时期，子良与无神论者范缜在一起谈人生富贵之事，问富贵与因果的关系。范缜回答说：“人生就同一树花，虽然同处于一根树枝上，突然刮起了大风，花瓣有随风飘到富贵人家的座垫上，也有飘到人家厕所里的，因果在起作用。”"]},{"id":47437,"word":"飘茵随溷","pinyin":"piāo yīn suí hùn","abbr":"pysh","explanation":"比喻由于偶然的机缘而有富贵贫贱的不同命运。亦多指女子堕落风尘。同“飘茵堕溷”。","source":{"text":"虽然是苦结局伤心断魂，煞强如没收煞飘茵随溷。","book":"清·吴梅《风洞山·殉烈》"},"similar":["飘茵堕溷","飘茵落溷"],"usage":"作谓语、定语；用于书面语"},{"id":47438,"word":"飘萍断梗","pinyin":"piāo píng duàn gěng","abbr":"ppdg","explanation":"随波逐流的浮萍和植物的断茎。比喻飘泊无定的身世。","source":{"text":"契阔十年才道旧，问关千里又言旋。飘萍断梗无根柢，愁唤羸童理破鞯。","book":"宋·周行己《再和文叔》"},"usage":"作宾语、定语；用于比喻句"},{"id":47439,"word":"飘萍浪迹","pinyin":"piāo péng làng jì","abbr":"pplj","explanation":"飘：飘浮；浪：流浪。飘浮不定的踪影，到处流浪的足迹。形容踪迹漂泊不定，就象流水和浮萍一样。","source":{"text":"小生飘蓬浪迹，幸蒙令尊一见如故，解衣推食，恩已过甚。","book":"明·凌濛初《二刻拍案惊奇》卷十一"},"usage":"作定语；用于生活"},{"id":47440,"word":"飘蓬断梗","pinyin":"piāo péng duàn gěng","abbr":"ppdg","explanation":"飘飞的蓬草和随波逐流的断树枝。比喻到处漂泊，行踪无定。","source":{"text":"全家百指，如飘蓬断梗，一在天之涯，一在地之角。","book":"宋·宗泽《上郑龙图求船书》"},"example":{"text":"惊岁月之逝波，伤美人之迟暮，～，不复问人世事矣。","book":"吴梅《风洞山·旅吟》"},"similar":["飘泊无定","飘萍断梗"],"opposite":["安居乐业"],"usage":"作谓语、补语；比喻生活不安定，到处漂泊"},{"id":47441,"word":"飘藩坠溷","pinyin":"piāo fān zhuì hùn","abbr":"pfzh","explanation":"藩：篱笆；溷：厕所。飘落篱笆上，坠入茅厕中。比喻偶然的机遇产生不同的命运。多指女性堕落风尘。","source":{"text":"韵兰，未识其人，似以良家而误堕风尘者。飞絮落花，飘藩坠溷，亦殊可惜已。","book":"清·王韬《淞隐漫录·三十六鸳鸯谱》"},"similar":["飘樊落溷"],"usage":"作宾语、定语；用于人的命运"},{"id":47442,"word":"飘零书剑","pinyin":"piāo líng shū jiàn","abbr":"plsj","explanation":"古时谓文人携带书剑，游学四方，到处飘泊。","source":{"text":"如今虽是飘零书剑，家里也还有一百亩田，三四带房子住着。","book":"明·兰陵笑笑生《金瓶梅词话》第56回"},"usage":"作宾语、定语；用于书面语"},{"id":47443,"word":"飘零蓬断","pinyin":"piāo líng péng duàn","abbr":"plpd","explanation":"漂泊零落，如蓬草一样随风飞转，转徒无常。","source":{"text":"只是汉庭无狗监之游扬，北海乏孔融之赏鉴，以故漂零蓬断，世业渐雕，燕喜桃夭，室家未遂。","book":"明·杨珽《龙膏记·旅况》"}},{"id":47444,"word":"飘风不终朝","pinyin":"piāo fēng bù zhōng cháo","abbr":"pfbzc","explanation":"飘风：暴风；朝：早晨。暴风刮不完一个早晨就会停息。比喻来势虽猛，但持续的时间不会长久。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"}},{"id":47445,"word":"飘风急雨","pinyin":"piāo fēng kǔ yǔ","abbr":"pfjy","explanation":"形容天气恶劣。","source":{"text":"今若天飘风苦雨，溱溱而至者，此天之所以罚百姓之不上同于天者也。","book":"战国·宋·墨翟《墨子·尚同上》"},"similar":["飘风暴雨","飘风骤雨"],"usage":"作主语、宾语、定语；形容大雨"},{"id":47446,"word":"飘风暴雨","pinyin":"piāo fēng bào yǔ","abbr":"pfby","explanation":"来势急遽","source":{"text":"时雨甘露不将，飘风暴雨数臻。","book":"管仲《管子·小匡》"},"example":{"text":"～可思惟，鹤望巢门敛翅飞。","book":"唐·郭仁表《梦中辞》诗"},"similar":["狂风暴雨"],"opposite":["毛毛细雨"],"usage":"作主语、宾语；形容大雨"},{"id":47447,"word":"飘风苦雨","pinyin":"piāo fēng kǔ yǔ","abbr":"pfky","explanation":"形容天气恶劣","source":{"text":"今若天飘风苦雨，溱溱而至者，此天之所以罚百姓之不上同于天者也。","book":"战国·宋·墨翟《墨子·尚同上》"},"usage":"作宾语、定语；用于书面语"},{"id":47448,"word":"飘风过耳","pinyin":"piāo fēng guò ěr","abbr":"pfge","explanation":"比喻对某件事情漠不关心或不当一回事。","source":{"text":"任你说得舌敝唇穿，也只当做飘风过耳。","book":"明·天然痴叟《石点头·贪婪汉六院卖风流》"},"usage":"作宾语、定语；同“耳旁风”"},{"id":47449,"word":"飘风骤雨","pinyin":"piāo fēng zhòu yǔ","abbr":"pfzy","explanation":"飘风：疾风。骤：迅疾，猛快。来势急遽而猛烈的风雨。","source":{"text":"故飘风不终朝，骤雨不终日。","book":"《老子》第二十三章"},"example":{"text":"～惊飒飒，落花飞雪何茫茫。","book":"唐·李白《草书歌行》"},"similar":["飘风急雨"],"usage":"作主语、宾语、定语；形容大雨"},{"id":47450,"word":"飘飘摇摇","pinyin":"piāo piāo yáo yáo","abbr":"ppyy","explanation":"物体在空中随风漂浮摇动。","source":{"text":"那风筝飘飘摇摇，只管往后退了去，一时只有鸡蛋大小，展眼只剩了一点黑星，再展眼不知落到那里去了。","book":"清·曹雪芹《红楼梦》第70回"},"similar":["飘浮不定"],"usage":"作谓语、定语、状语；指物体晃动"},{"id":47451,"word":"飘飘欲仙","pinyin":"piāo piāo yù xiān","abbr":"ppyx","explanation":"欲：将要。飘飞上升，像要超脱尘世而成仙。多指人的感受轻松爽快。亦形容诗文、书法等的情致轻快飘逸。","source":{"text":"飘飘乎遗世独立，羽化而登仙。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"七古、近体，豪宕磊落，～。","book":"清·归庄《顾天石诗序》"},"similar":["超尘出世","得意洋洋","沾沾自喜"],"usage":"作谓语、定语；指人忘乎所以"},{"id":47452,"word":"飘飘然","pinyin":"piāo piāo rán","abbr":"ppr","explanation":"由于迷恋某人或怀有极大的骄傲自大情绪而感到轻飘飘。形容得意。","source":{"text":"神清气爽，飘飘然有凌云之意。","book":"唐·李复言《续玄怪录·裴湛》"},"example":{"text":"因湖上三夜的畅游，叫我觉得～如轻烟，如浮云。","book":"朱自清《毁灭》"},"similar":["忘乎所以"],"usage":"作宾语、定语；指得意"},{"id":47453,"word":"飘飘零零","pinyin":"piāo piāo líng líng","abbr":"ppll","explanation":"指花、叶等凋谢脱落。比喻人漂泊流落。","source":{"text":"把手去移动时，只见花瓣儿多飘飘零零的落将下来。","book":"清·褚人获《隋唐演义》第99回"},"usage":"作定语、状语；用于生活等"},{"id":47454,"word":"飙举电至","pinyin":"biāo jǔ diàn zhì","abbr":"bjdz","explanation":"飙：疾风、暴风。风起云涌闪电到。形容声势猛烈。","source":{"text":"匈奴贪狼，因时而动，乘可而发，飙举电至。","book":"汉·桓宽《盐铁论·世务》"},"similar":["飙举电举"],"usage":"作谓语、定语；形容声势迅猛"},{"id":47455,"word":"飙发电举","pinyin":"biāo fā diàn jù","abbr":"bfdj","explanation":"形容声势迅猛。","source":{"text":"大猷老将务持重，继光则飙发电举，屡摧大寇，名更出大猷上。","book":"《明史·戚继光传》"},"example":{"text":"德参赞～，而额经略节制山立，谋勇相资，卒戡大难。","book":"清·魏源《圣武记》卷宗十三"},"similar":["飙发电至"],"usage":"作谓语、定语；形容速度快"},{"id":47456,"word":"飞书走檄","pinyin":"fēi shū zǒu xí","abbr":"fszx","explanation":"迅速地书写文件。","source":{"text":"绣衣貂裘明积雪，飞书走檄如飘风。","book":"唐·李白《送程刘二侍御兼独孤判官赴安西幕府》诗"},"example":{"text":"论都及政者宗班张，～者征陈琳。","book":"唐·崔祐甫《穆氏四子讲艺记》"},"usage":"作谓语、宾语、定语；用于官场等"},{"id":47457,"word":"飞云掣电","pinyin":"fēi yún chè diàn","abbr":"fycd","explanation":"掣：闪过。像流云飞和闪电一样。形容非常迅速。","source":{"text":"不说追兵随后飞云掣电而来。","book":"明·许仲琳《封神演义》第二十一回"},"example":{"text":"鬼卒即去牵过一匹马来，不由分说，把胡迪扶上了马，加上一鞭，那马如～一般跑去。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["风驰电掣"],"usage":"作宾语、状语；形容非常迅速"},{"id":47458,"word":"飞冤驾害","pinyin":"fēi yuān jià hài","abbr":"fyjh","explanation":"无中生有，捏造罪名陷害人。"},{"id":47459,"word":"飞刍挽粒","pinyin":"fēi chú wǎn lì","abbr":"fcwl","explanation":"指迅速运送粮草。同“飞刍挽粟”。","source":{"text":"金城布险，峻垒绵疆，飞刍挽粒，事难支继。","book":"《南齐书·徐孝嗣沈文季传论》"},"similar":["飞刍挽粟","飞刍挽粮"],"usage":"作谓语；指迅速运送粮草"},{"id":47460,"word":"飞刍挽粟","pinyin":"fēi chú wǎn sù","abbr":"fcws","explanation":"飞：形容极快；刍：饲料；挽：拉车或船；粟：小米，泛指粮食。指迅速运送粮草。","source":{"text":"又使天下飞刍挽粟。","book":"《汉书·主父偃传》"},"example":{"text":"鸡肋蚕丛，尚烦戎略；～，岂顾民生。","book":"清·顾炎武《答徐甥公肃书》"},"similar":["飞刍挽粒"],"usage":"作谓语；指迅速运送粮草"},{"id":47461,"word":"飞刍挽粮","pinyin":"fēi chú wǎn liáng","abbr":"fcwl","explanation":"指迅速运送粮草。同“飞刍挽粟”。","source":{"text":"而文定决意进兵，一无顾惜。飞刍挽粮，縻数十万。","book":"《明史·伍文定传》"},"similar":["飞刍挽粒","飞刍转饷"],"usage":"作谓语；指迅速运送粮草"},{"id":47462,"word":"飞刍转饷","pinyin":"fēi chú zhuǎn xiǎng","abbr":"fczx","explanation":"指迅速运送粮草。同“飞刍輓粟”。","source":{"text":"建牙吹角浩无际，飞刍转饷遥相望。","book":"明·王世贞《与高大夫游盘山歌》"},"similar":["飞刍挽粮","飞刍挽秣","飞粮挽粟"],"usage":"作谓语、宾语；指迅速运送粮草"},{"id":47463,"word":"飞升腾实","pinyin":"fēi shēng téng shí","abbr":"fsts","explanation":"飞：飞扬；腾：上升。指名声和实际都好。"},{"id":47464,"word":"飞土逐宍","pinyin":"fēi tǔ zhú ròu","abbr":"ftzr","explanation":"宍：同“肉”，指禽兽。抛掷土丸以驱逐禽兽。","source":{"text":"故歌曰：‘断竹续竹，飞土逐宍’之谓也。","book":"汉·赵晔《吴越春秋·勾践阴谋外传》"},"similar":["飞土逐肉"],"usage":"作谓语、宾语、定语；用于打猎"},{"id":47465,"word":"飞土逐害","pinyin":"fēi tǔ zhú hài","abbr":"ftzh","explanation":"抛掷土丸以逐禽兽。","source":{"text":"孝子不忍见其父母为禽兽所食，故作弹以守之，绝鸟兽之害。故歌曰‘断竹续竹，飞土逐害’之谓也。","book":"汉·赵晔《吴越春秋·勾践阴谋外传》"},"similar":["飞土逐肉","飞土逐宍"],"usage":"作谓语、宾语、定语；用于打猎"},{"id":47466,"word":"飞土逐网","pinyin":"fēi tǔ zhú ròu","abbr":"ftzw","explanation":"土：指泥土弹丸；肉：指鸟兽。抛掷土丸以追逐鸟兽。指用弹弓猎物。","source":{"text":"故歌曰：‘断竹续竹，飞土逐肉’之谓也。","book":"先秦·无名氏《弹歌》：“断竹续竹。飞土逐宍。”汉·赵晔《吴越春秋·勾践阴谋外传》"},"example":{"text":"无～，儿戏之常。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录五》"}},{"id":47467,"word":"飞土逐肉","pinyin":"fēi tǔ zhú ròu","abbr":"ftzr","explanation":"抛掷土丸以逐禽兽。同“飞土逐害”。","source":{"text":"夫飞土逐肉，儿戏之常。","book":"清·纪昀《阅微草堂笔记·滦阳续录五》"},"similar":["飞土逐宍","飞土逐害"],"usage":"作谓语、宾语、定语；用于打猎"},{"id":47468,"word":"飞墙走壁","pinyin":"fēi qiáng zǒu bì","abbr":"fqzb","explanation":"飞：形容迅速如飞。指能飞越房檐，攀登墙壁。形容武艺高强，身体矫捷如飞。","source":{"text":"拿出飞墙走壁的本事，进到庵中。","book":"清·西周生《醒世姻缘传》第65回"},"similar":["飞檐走壁","飞檐走脊"],"usage":"作谓语、宾语、定语；形容武艺高强"},{"id":47469,"word":"飞声腾实","pinyin":"fēi shēng téng shí","abbr":"fsts","explanation":"飞：飞扬；腾：上升。指名声和实际都好。","source":{"text":"其茂亲则有鲁卫、梁楚，其疏属则有凡蒋、荆燕，咸能飞声腾实，不泯于百代之后。","book":"《周书·邵惠公颢等传论》"},"example":{"text":"咸能～，不灭于百代之后。","book":"《北史·周宗室传》"},"usage":"作谓语、宾语；指人的名声"},{"id":47470,"word":"飞将奇数","pinyin":"fēi jiàng jī shù","abbr":"fjjs","explanation":"飞将：汉朝名将李广；奇数：命运不好。泛指人不走运。","source":{"text":"李广老，数奇。","book":"西汉·司马迁《史记·李将军列传》"},"similar":["李广不侯"],"usage":"作宾语、定语；指人命运不好","story":["西汉时期，中郎将李广任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。他一生不被重用，没有封侯的奖赏，最后被逼自杀。而他的堂兄弟李蔡才能不如他却官至丞相，古人认为奇数不吉利，司马迁评价为“李广老，数奇。”"]},{"id":47471,"word":"飞将数奇","pinyin":"fēi jiàng shù jī","abbr":"fjsj","explanation":"飞将：汉朝名将李广；数奇：命运不好。泛指人不走运。","source":{"text":"李广老，数奇。","book":"西汉·司马迁《史记·李将军列传》"},"example":{"text":"时人以“～”来形容李广的运气不佳。"},"similar":["飞将奇数"],"usage":"作宾语、定语；指人命运不好","story":["西汉时期，中郎将李广任边境上谷太守，他英勇善战，匈奴称他为飞将军，闻风丧胆。他一生不被重用，没有封侯的奖赏，最后被逼自杀。而他的堂兄弟李蔡才能不如他却官至丞相，古人认为奇数不吉利，司马迁评价为“李广老，数奇。”"]},{"id":47472,"word":"飞将难封","pinyin":"fēi jiàng nán fēng","abbr":"fjnf","explanation":"飞将：飞将军，指汉代名将李广；难：困难；封：赐封。飞将军难以封侯。泛指人不走运。","source":{"text":"冯唐易老，李广难封。","book":"唐·王勃《滕王阁序》"},"example":{"text":"只因这一番，有分教：甘棠有荫，空留后人之思；～，徒博数奇之叹。","book":"清·吴敬梓《儒林外史》第三十九回"}},{"id":47473,"word":"飞必冲天","pinyin":"fēi bì chōng tiān","abbr":"fbct","explanation":"一飞起来，就必定会冲上青天。比喻不干则已，一干就能创造出惊人的成绩来。","source":{"text":"三年不翅，将以长羽翼，不飞不鸣，将与观民则。虽无飞，飞必冲天，虽无鸣，鸣必惊人。","book":"《韩非子·喻老》"}},{"id":47474,"word":"飞扬浮躁","pinyin":"fēi yáng fú zào","abbr":"fyfz","explanation":"轻浮急躁。","source":{"text":"飞扬浮躁，所学安能坚固。","book":"《朱子全书·论语一》"},"usage":"作谓语、定语、状语；用于人的性格"},{"id":47475,"word":"飞扬跋扈","pinyin":"fēi yáng bá hù","abbr":"fybh","explanation":"飞扬：放纵；跋扈：蛮横。原指意态狂豪，不爱约束。现多形容骄横放肆，目中无人。","source":{"text":"景专制河南十四年矣，常有飞扬跋扈志。","book":"《北史·齐高祖纪》"},"example":{"text":"痛饮狂歌空度日，～为谁雄？","book":"唐·杜甫《赠李白》诗"},"similar":["盛气凌人"],"opposite":["平易近人"],"usage":"作谓语、定语、宾语；形容人很骄横","story":["南北朝时期，北魏定州刺史投靠高欢，高欢死后，他又率兵归降南朝梁武帝萧衍。不久发动了叛乱，攻陷梁都建康，改国号汉。他每次出兵作战均要屠城，下令不许两人以上交谈，搞得民怨沸腾。湘东王萧铎出兵击败侯景，杀了这个飞扬跋扈的人"]},{"id":47476,"word":"飞文染翰","pinyin":"fēi wén rǎn hàn","abbr":"fwrh","explanation":"挥笔疾书。","source":{"text":"承业之曰：公称文士，即合飛文染翰，以济霸国，尝命草辞，自陈短拙，及留职务，又以为辞，公所能者何也。","book":"《旧五代史·唐书·卢程传》"},"example":{"text":"词人才子，则名溢于缥囊；～，则卷盈乎缃帙。","book":"南朝梁·萧统《文选序》"},"usage":"作谓语、宾语；用于写作"},{"id":47477,"word":"飞来横祸","pinyin":"fēi lái hèng huò","abbr":"flhh","explanation":"意外的灾祸。","source":{"text":"若卒遇飞祸，无得殡敛。","book":"《后汉书·周荣传》"},"example":{"text":"不到得惹出～。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"similar":["意外之灾"],"usage":"作宾语；指灾祸"},{"id":47478,"word":"飞檐反宇","pinyin":"fēi yán fǎn yǔ","abbr":"fyfy","explanation":"飞檐：屋檐上翘其角更加突出，犹如飞翼；反宇：屋檐上仰起的瓦头。屋檐上翘，瓦头仰起。形容楼阁、宫殿等建筑外形精巧美观。","source":{"text":"反宇业业，飞檐献献。","book":"汉·张衡《西京赋》"}},{"id":47479,"word":"飞檐走壁","pinyin":"fēi yán zǒu bì","abbr":"fyzb","explanation":"旧小说中形容有武艺的人身体轻捷，能够跳上房檐，越过墙壁。","source":{"text":"醉了时丢砖掠瓦，到晚来飞檐走壁。","book":"元·刘唐卿《降桑椹蔡顺奉母》第一折"},"example":{"text":"且说时迁是个～的人，不从正路入城，夜间越墙而过。","book":"明·施耐庵《水浒全传》第六十六回"},"similar":["飞檐走脊"],"usage":"作谓语、宾语、定语；形容武艺高强"},{"id":47480,"word":"飞檐走脊","pinyin":"fēi yán zǒu jǐ","abbr":"fyzj","explanation":"旧小说中形容有武艺的人身体轻捷，能够跳上房檐，越过墙壁。同“飞檐走壁”。","source":{"text":"小的曾学过飞檐走脊的本事，还能飞石打人，百发百中。","book":"《天雨花》第十一回"},"similar":["飞檐走壁","飞墙走壁"],"usage":"作谓语、宾语、定语；形容武艺高强"},{"id":47481,"word":"飞殃走祸","pinyin":"fēi yāng zǒu huò","abbr":"fyzh","explanation":"意外的灾祸。同“飞来横祸”。"},{"id":47482,"word":"飞沙扬砾","pinyin":"fēi shā yáng lì","abbr":"fsyl","explanation":"沙：沙土；砾：小石块。沙土飞扬，小石块滚动。形容风势很猛。","source":{"text":"路中甚寒，多饶风雪，飞沙走铄，举止皆满，唯土谷浑城左右暧于余处。","book":"北魏·杨衒之《洛阳伽蓝记·禅虚寺》"},"example":{"text":"庚子，京师大风自西北起，～，白日昏暗。","book":"《元史·顺帝本纪十》"},"similar":["飞沙走砾","飞砂扬砾"],"usage":"作谓语、定语；形容风势很猛"},{"id":47483,"word":"飞沙走石","pinyin":"fēi shā zǒu shí","abbr":"fszs","explanation":"沙土飞扬，石块滚动。形容风势狂暴。","source":{"text":"苍梧、南海，岁有风瘴气之害，风则折木，飞沙转石，气则雾郁，飞鸟不经。","book":"《三国志·吴志·陆凯传》"},"example":{"text":"尤窍怒号天噫气，～乱伤人。","book":"明·吴承恩《西游记》第二十八回"},"similar":["雷虐风号","天昏地暗"],"opposite":["风和日丽","春光明媚"],"usage":"作谓语、定语、分句；形容风势迅猛","story":["三国时期，东吴御史陆胤因力保太子孙和而得罪孙权，被捕入狱，后经人保举为西陵督，中书丞华罦上书推荐说：“陆胤天资聪颖，很有才干，在苍梧南海当地方官时，治理那里的飞沙走石有功，老百姓受益匪浅，而他自己却十分廉洁。”"]},{"id":47484,"word":"飞沙走砾","pinyin":"fēi shē zǒu lì","abbr":"fszl","explanation":"沙：沙土；砾：小石块。沙土飞扬，小石块滚动。形容风势很猛。","source":{"text":"路中甚寒，多饶风雪，飞沙走砾，举目皆满。","book":"北魏·杨衒之《洛阳伽蓝记·闻义里》"},"example":{"text":"冻风时作，作则～。","book":"明·袁宏道《满井游记》"},"similar":["飞砂走石","飞沙扬砾"],"usage":"作谓语、定语；形容风势很猛"},{"id":47485,"word":"飞沙转石","pinyin":"fēi shā zhuǎi shí","abbr":"fszs","explanation":"飞：使飞扬；转：滚动。沙土飞扬，石块滚动。形容风势迅猛。","source":{"text":"苍梧、南海，岁有风瘴气之害，风则折木，飞砂转石，气则雾郁，飞鸟不经。","book":"晋·陈寿《三国志·吴志·陆凯陆胤传》"},"similar":["飞砂走石","狂风大作"],"opposite":["风和日丽"],"usage":"作谓语、定语、分句；形容风势迅猛","story":["三国时期，东吴御史陆胤因力保太子孙和而得罪孙权，被捕入狱，后经人保举为西陵督，中书丞华罦上书推荐说：“陆胤天资聪颖，很有才干，在苍梧南海当地方官时，治理那里的飞沙转石有功，老百姓受益匪浅，而他自己却十分廉洁。”"]},{"id":47486,"word":"飞沿走壁","pinyin":"fēi yán zǒu bì","abbr":"fyzb","explanation":"旧小说中形容有武艺的人身体轻捷，能够跳上房檐，越过墙壁。"},{"id":47487,"word":"飞流直下","pinyin":"fēi liú zhí xià","abbr":"flzx","explanation":"飞流：指瀑布；直下：垂直泻下。瀑布垂直泻下。形容瀑布垂直泻下的壮观景象。","source":{"text":"日照香炉生紫烟，遥看瀑布挂前川。飞流直下三千尺，疑是银河落九天。","book":"唐·李白《望庐山瀑布》"}},{"id":47488,"word":"飞流短长","pinyin":"fēi liú duǎn cháng","abbr":"fldc","explanation":"飞、流：散布；短、长：指是非、善恶。指散播谣言，中伤他人。","source":{"text":"故有谀言顺容积微之谗，以基所毁，四邻之地，更效递笑，飞流短长，天下闻矣。","book":"唐·沈亚之《送韩北渚赴江西序》"},"similar":["飞短流长"],"usage":"作谓语、宾语；指谣言中伤"},{"id":47489,"word":"飞灾横祸","pinyin":"fēi zāi hèng huò","abbr":"fzhh","explanation":"意外的灾祸。","source":{"text":"若卒遇飞祸，无得殡敛。","book":"《后汉书·周荣传》"},"example":{"text":"自己年纪可也不小了，家中又碰见这样～，不知如何了局。","book":"清·曹雪芹《红楼梦》第九十回"},"similar":["天灾人祸"],"usage":"作宾语、定语；指意外的灾祸"},{"id":47490,"word":"飞熊入梦","pinyin":"fēi xióng rù mèng","abbr":"fxrm","explanation":"原指周文王梦飞熊而得太公望。后比喻圣主得贤臣的征兆。","source":{"text":"西伯将出猎，卜之，曰‘所获非龙非彲，非虎非罴；所获霸王之辅’。","book":"《史记·齐太公世家》"},"example":{"text":"昔商高宗曾有～，得傅说于版筑之间。","book":"明·许仲琳《封神演义》第二十三回"},"usage":"作宾语、定语；比喻圣主得贤臣的征兆","story":["商朝末年，周文王姬昌急需一个能文能武的人来辅佐，他苦苦寻找。一天他做了一个梦，梦见一只生有双翅的熊飞进自己的怀中。第二天他叫人占卜预示即可找到这个人，于是带领人马到渭水边找到直钩钓鱼的姜尚，他号飞熊，从此文王如虎添翼"]},{"id":47491,"word":"飞燕游龙","pinyin":"fēi yàn yóu lóng","abbr":"fyyl","explanation":"像飞燕一样地轻快，像游龙一样地柔曲。形容体态轻盈柔美。","source":{"text":"宛若翾风回雪，恍如飞燕游龙。","book":"清·洪昇《长生殿·舞盘》"},"usage":"作宾语、定语；用于比喻句"},{"id":47492,"word":"飞珠溅玉","pinyin":"fēi zhū jiàn yù","abbr":"fzjy","explanation":"形容水的飞溅犹如珠玉一般。","example":{"text":"船后跳动着～，十分漂亮。"},"usage":"作宾语、定语；用于比喻句"},{"id":47493,"word":"飞眼传情","pinyin":"fēi yǎn chuán qíng","abbr":"fycq","explanation":"借眼睛来传递感情。","source":{"text":"我们也少不得对人家瞧瞧，朝人家笑笑，人家就说我们飞眼传情了，少不得更亲近点。","book":"清·刘鹗《老残游记·续集遗稿》第三回"},"similar":["眉眼传情"],"usage":"作谓语、定语；用于情人之间等"},{"id":47494,"word":"飞短流长","pinyin":"fēi duǎn liú cháng","abbr":"fdlc","explanation":"飞、流：散布；短、长：指是非、善恶。指散播谣言，中伤他人。","source":{"text":"故有谀言顺容积微之谗，以基所毁，四邻之地，更效递笑，飞流短长，天下闻矣。","book":"唐·沈亚之《送韩北渚赴江西序》"},"example":{"text":"妾来当须秘密，造言生事者，～，所不堪受。","book":"清·蒲松龄《聊斋志异·封三娘》"},"similar":["造谣生事","拨弄是非","拨乱视听"],"opposite":["秉公直言","仗义直言"],"usage":"作主语、谓语、宾语；指流言","story":["从前有一个美女范十一娘，一次在庙会上见到一个漂亮女子封三娘，两人谈得非常投机，相约到范家去玩。封三娘没有去，范因此得病。后来范见到封，封对她说她只能偷偷的来，不要让闲人知道，流言蜚语难听。原来封三娘是狐狸精"]},{"id":47495,"word":"飞砂扬砾","pinyin":"fēi shā yáng lì","abbr":"fsyl","explanation":"形容风势很猛。同“飞沙走砾”。","source":{"text":"京师大风自北起，飞砂扬砾，白日昏暗。","book":"《元史·顺帝纪十》"},"similar":["飞沙扬砾","飞沙走砾"],"usage":"作谓语、定语；形容风势很猛"},{"id":47496,"word":"飞砂走石","pinyin":"fēi shā zǒu shí","abbr":"fszs","explanation":"砂土飞扬，小石翻滚。形容风力迅猛。","source":{"text":"飞砂走石，风则从箕，月离于毕。","book":"唐·韩鄂《岁华纪丽·风》"},"example":{"text":"狂风大作，～，如同骤雨。","book":"明·罗贯中《三国演义》第90回"},"similar":["飞沙走石","飞砂转石"],"opposite":["风和日丽"],"usage":"作谓语、定语；形容风力迅猛"},{"id":47497,"word":"飞砂转石","pinyin":"fēi shā zhuǎn shí","abbr":"fszs","explanation":"形容风势狂暴。同“飞沙走石”。","source":{"text":"风则折木，飞砂转石。","book":"《三国志·吴志·陆胤传》"},"similar":["飞砂走石","飞沙走石","走石飞沙"],"usage":"作谓语、定语、分句；形容风势迅猛","story":["三国时期，东吴御史陆胤因力保太子孙和而得罪孙权，被捕入狱，后经人保举为西陵督，中书丞华罦上书推荐说：“陆胤天资聪颖，很有才干，在苍梧南海当地方官时，治理那里恶劣的飞砂转石环境有功，老百姓受益匪浅，而他自己却十分廉洁。”"]},{"id":47498,"word":"飞禽走兽","pinyin":"fēi qín zǒu shòu","abbr":"fqzs","explanation":"禽：鸟；兽：野兽。飞翔的禽鸟，奔跑的野兽。泛指鸟类和兽类。","source":{"text":"飞禽走兽，因木生姿。","book":"汉·王延寿《鲁灵光殿赋》"},"example":{"text":"铃儿乃金丹之宝，又不是～，如何辨得雌雄？","book":"明·吴承恩《西游记》第七十一回"},"usage":"作宾语、定语；指动物"},{"id":47499,"word":"飞箭如蝗","pinyin":"fēi jiàn rú huáng","abbr":"fjrh","explanation":"飞：飞快，迅速；蝗：蝗虫。飞快的箭像成群的蝗虫一样多。形容激烈的战斗。"},{"id":47500,"word":"飞米转刍","pinyin":"fēi mǐ zhuǎn chú","abbr":"fmzc","explanation":"指迅速运送粮草。同“飞刍挽粟”。","source":{"text":"今高昌诛灭，威动四夷，然自王师始征，河西供役，飞米转刍，十室九匮，五年未可复。","book":"《新唐书·西域传上·高昌》"},"similar":["飞刍挽粒","飞刍挽粮","飞刍转饷"],"usage":"作谓语、宾语；指迅速运送粮草"}]
