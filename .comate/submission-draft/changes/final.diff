+[{"id":35001,"word":"秩序井然","pinyin":"zhì xù jǐng rán","abbr":"zxjr","explanation":"井然：形容整齐。仔细整理或安排好的有序场面。","source":{"text":"只好抹桌另起从头写来，方才有头有绪，秩序井然。","book":"清·无垢道人《八仙全传》第17回"},"example":{"text":"我们过着～的生活。"},"similar":["井井有条"],"opposite":["乱七八糟"],"usage":"作谓语、定语；指整齐、有序"},{"id":35002,"word":"积不相能","pinyin":"jī bù xiāng néng","abbr":"jbxn","explanation":"积：积久而成的；能：亲善。指一向不和睦。","source":{"text":"子与刘公积不相能，而信其虚谈，不为之备，终受制矣。","book":"《左传·襄公二十一年》：“栾桓子娶于范宣子，生怀子，范鞅以其亡也，怨栾氏，故与栾盈为公族大夫而不相能。”《后汉书·吴汉传》"},"example":{"text":"再有那狭量的人，以及平日与他～的，遂拿着稿子去见东家，说他种种不是。","book":"清·彭养鸥《黑籍冤魂》第二十二回"},"usage":"作谓语；指一向不和睦","story":["公元23年，更始帝刘玄派刘秀率军同谢躬的军队一起去攻打在邯郸称帝的王郎。刘秀与谢躬向来不合。但刘秀很有心计，表面称赞谢躬，请他配合打仗。谢躬的妻子提醒他要防范刘秀，因为他们长期不友善。刘秀用计杀害了谢躬全家"]},{"id":35003,"word":"积久弊生","pinyin":"jī jiǔ bì shēng","abbr":"jjbs","explanation":"积：积累；久：时间长；弊：弊病，弊端。事物久而不变，就会产生弊病。"},{"id":35004,"word":"积习成俗","pinyin":"jī xí chéng sú","abbr":"jxcs","explanation":"一种做法反复多次实施就成了习俗。","source":{"text":"宰相侯王，迭以侈丽相尚，风靡之化，积习成俗，卧薪之谕，未足甚焉。","book":"晋·申绍《上疏陈时务》"},"usage":"作谓语、宾语；指逐渐形成风俗"},{"id":35005,"word":"积习成常","pinyin":"jī xí chéng cháng","abbr":"jxcc","explanation":"习：习惯。一种做法长期相仍成为惯例，视为正常。","source":{"text":"汉置九郡，儋耳预焉，民好徒跣，耳广垂以为饰，中男女亵露不以为羞。暑亵薄日，自使人黑，积习为常，以黑为美。","book":"北魏·郦道元《水经注·温水》"},"similar":["习惯成自然","积习成俗"],"usage":"作宾语、定语；用于处事"},{"id":35006,"word":"积习渐靡","pinyin":"jī xí jiàn mó","abbr":"jxjm","explanation":"靡：通“摩”，接触。指长期养成的习惯是从细微处开始，逐渐形成的。","source":{"text":"积习渐靡，物之微者也，其入人不知，习忘乃为常。","book":"汉·董仲舒《春秋繁露·天道施》"},"usage":"作宾语、定语；用于书面语"},{"id":35007,"word":"积习生常","pinyin":"jī xí shēng cháng","abbr":"jxsc","explanation":"指积弊已久，习以为常。","source":{"text":"且夫玉卮无当，虽宝非用；侈言无验，虽丽非经，而论者莫不诋讦其研精，作者大氐举为宪章，积习生常，有自来矣。","book":"晋·左思《三都赋》序"},"example":{"text":"昔魏末不纲，太祖匡辅元氏；有周受命，晋公复执威权。～，便谓法应须尔，岂有三十岁天子而为人所制乎。","book":"《周书·齐炀王宪传》"},"usage":"作宾语、定语；用于人的习惯等"},{"id":35008,"word":"积习相沿","pinyin":"jī xí xiāng yán","abbr":"jxxy","explanation":"沿：沿袭。长期养成的习惯被承袭下来。","source":{"text":"以士庶之别，为贵贱之分。积习相沿，遂成定制。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"黄为中央正色，民间吉礼不敢妄用，而齐衰期服，发辫皆系黄缕，～，毫不为怪。","book":"清·甘熙《白下琐言》"}},{"id":35009,"word":"积习难改","pinyin":"jī xí nán gǎi","abbr":"jxng","explanation":"积习：长期形成的旧习惯。长期形成的旧习惯很难更改。","source":{"text":"真是积习难改，拿起笔，就像扭开了龙头，水荷荷地流个不停。","book":"巴金《小序》"},"example":{"text":"我就不相信～，关键在于要找到改的方法。"},"similar":["积重难返","故态复萌"],"opposite":["痛改前非","除旧布新","推陈出新"],"usage":"作谓语、宾语、定语、分句；指习惯难改"},{"id":35010,"word":"积习难除","pinyin":"jī xí nán chú","abbr":"jxnc","explanation":"长期形成的旧习惯很难更改。同“积习难改”。","source":{"text":"我们早就呼喊着人民文艺的创造但积习难除，一拿起笔来，总要忸怩作态的。","book":"郭沫若《序〈白毛女〉》"},"similar":["积习难改"],"usage":"作谓语、宾语、定语、分句；指习惯难改"},{"id":35011,"word":"积于忽微","pinyin":"ji yu hu wei","abbr":"jyhw","explanation":"从细小的事情上累积发展起来。"},{"id":35012,"word":"积以为常","pinyin":"jī yǐ wéi cháng","abbr":"jywc","explanation":"指习惯成自然。同“习以为常”。","source":{"text":"今姚府所置之官……唯知诡谋狡算，恣情割剥，贪叨动掠，积以为常。","book":"《旧唐书·张柬之传》"},"similar":["习以为常"],"usage":"作宾语、定语；用于书面语"},{"id":35013,"word":"积功兴业","pinyin":"jī gōng xīng yè","abbr":"jgxy","explanation":"指建立功业，实现抱负。","source":{"text":"傅子曰：‘诸葛亮诚一时之异人也，治国有分，御军有法，积功兴业，事得其机。","book":"《意林》卷五引晋·杨泉《物理论》"},"similar":["建功立业"],"usage":"作谓语、定语；用于书面语"},{"id":35014,"word":"积劳成疾","pinyin":"jī láo chéng jí","abbr":"jlcj","explanation":"积劳：长期劳累过度；疾：病。因长期工作，劳累过度而生了病。","source":{"text":"公孙归生积劳成病，卧不能起，城中食尽，饿死者居半，守者疲困，不能御敌。","book":"《荀子·王制》：“彼日积劳，我日积佚。”明·冯梦龙《东周列国志》第六十九回"},"example":{"text":"昨在剑南剿灭倭冠，颇为出力，现在～。","book":"清·李汝珍《镜花缘》第五回"},"similar":["疾病缠身","鞠躬尽瘁","身心交瘁"],"opposite":["养尊处优"],"usage":"作谓语、分句；指因长期过度劳累而得病"},{"id":35015,"word":"积劳成病","pinyin":"jī láo chéng bìng","abbr":"jlcb","explanation":"积劳：长期劳累过度。因长期工作，劳累过度而生了病。","source":{"text":"彼日积劳，我日积佚。","book":"《荀子·王制》"},"example":{"text":"公孙归生～，卧不能起，城中食尽，饿死者居半，守者疲困，不能御敌。","book":"明·冯梦龙《东周列国志》第六十九回"},"similar":["积劳成疾","积劳成瘁"],"usage":"作谓语、宾语；指因长期过度劳累而得病"},{"id":35016,"word":"积劳成瘁","pinyin":"jī láo chéng cuì","abbr":"jlcc","explanation":"积：积之而成的；瘁：忧病，困病。因劳苦过度而致害病。","source":{"text":"连年野处，积劳成瘁。","book":"唐·陆贽《李澄赠司空制》"},"similar":["积劳成病","积劳成疾","积劳致疾"],"usage":"作谓语、宾语；指因长期过度劳累而得病"},{"id":35017,"word":"积劳致疾","pinyin":"jī láo zhì jí","abbr":"jlzj","explanation":"积：积之而成的。因劳苦过度而致害病。","source":{"text":"积劳而致疾，突发未能痊。","book":"董必武《挽沈骊英女士》"},"similar":["积劳成病","积劳成疾","积劳成瘁"],"usage":"作谓语、宾语；指因长期过度劳累而得病"},{"id":35018,"word":"积厚成器","pinyin":"jī hòu chéng qì","abbr":"jhcq","explanation":"指根基深厚，养成才干。","source":{"text":"降神挺材，积厚成器，中蕴深闳之量，外标严重之姿。","book":"《旧唐书·韩弘传》"},"usage":"作谓语、定语；用于书面语"},{"id":35019,"word":"积厚流光","pinyin":"jī hòu liú guāng","abbr":"jhlg","explanation":"积累的功业越深厚，则流传给后人的恩德越广。","source":{"text":"故有天下者事七世，有一国者事五世，有五乘之地者事三世，有三乘之地者事二世，持手而食者不得立宗庙，所以别积厚者流泽广，积薄者流泽狭也。","book":"战国·赵·荀况《荀子·礼论》"},"example":{"text":"箕裘之美，侔于带砺，～，斯已信矣。","book":"清·钱谦益《和州鲁氏先茔神道碑》"},"similar":["积厚流广"],"usage":"作谓语、定语；指功业深厚"},{"id":35020,"word":"积厚流广","pinyin":"jī hòu liú guǎng","abbr":"jhlg","explanation":"根基深厚，影响广远。","source":{"text":"所以别积厚，积厚者流泽广，积薄者流泽狭也。","book":"战国·赵·荀况《荀子·礼论》"},"example":{"text":"这样做有～的作用。"},"similar":["积厚流光"],"usage":"作谓语、定语；指影响广远"},{"id":35021,"word":"积善之家，必有余庆","pinyin":"jī shàn zhī jiā，bì yǒu yú qìng","abbr":"jszjbyyq","explanation":"积：积累；善：善事；余庆：指先代的遗泽。积德行善之家，恩泽及于子孙。","source":{"text":"积善之家，必有余庆；积不善之家，必有余殃。","book":"《周易·坤·文言》"},"example":{"text":"遥受着洛京县令职名，圣人道：～。","book":"元·无名氏《刘弘嫁婢》"},"similar":["善有善报"],"opposite":["恶有恶报","积恶余殃"],"usage":"作宾语、定语；用于劝诫人"},{"id":35022,"word":"积善余庆","pinyin":"jī shàn yú qìng","abbr":"jsyq","explanation":"积：积累；善：善事；余庆：指先代的遗泽。积德行善之家，恩泽及于子孙。","source":{"text":"积善之家，必有余庆；积不善之家，必有余殃。","book":"《周易·坤·文言》"},"example":{"text":"～，积恶余殃。","book":"南朝·宋·释法明《答李交州难佛不见形》"},"similar":["积善之家，必有余庆"],"usage":"作谓语；指积德行善之家，恩泽及于子孙"},{"id":35023,"word":"积善成德","pinyin":"jī shàn chéng dé","abbr":"jscd","explanation":"善：善行，好事；德：高尚的品德。长期行善，就会形成一种高尚的品德。","source":{"text":"积善成德，而神明自得。","book":"《荀子·劝学》"},"example":{"text":"惟考我祖，～，宜享其隆。","book":"宋·欧阳修《泷冈阡表》"},"usage":"作宾语、定语；用于劝诫人"},{"id":35024,"word":"积土为山，积水为海","pinyin":"jī shuǐ wéi shān，jī shuǐ wéi hǎi","abbr":"jtwsjswh","explanation":"把土堆起来可以成山，把水蓄起来可以成海。比喻积少成多。","source":{"text":"积土而为山，积水而为海。","book":"《荀子·儒效》"},"usage":"作宾语、定语；用于书面语"},{"id":35025,"word":"积土成山","pinyin":"jī shuǐ wéi shān","abbr":"jtcs","explanation":"累土可以堆成山，比喻积少成多。","source":{"text":"积土成山，风雨兴焉；积水成渊，蛟龙生焉。","book":"荀况《荀子·劝学》"},"example":{"text":"～，积水成渊"},"similar":["积年累月","集腋成裘"],"opposite":["狗熊掰棒子","一口吃个胖子"],"usage":"作谓语、宾语、分句；比喻积少成多"},{"id":35026,"word":"积基树本","pinyin":"jī jī shù běn","abbr":"jjsb","explanation":"缔造基础，树立根本。","source":{"text":"故其积基树本，经纬礼俗，节理人情，恤隐民事，如此之缠绵也。","book":"晋·干宝《晋纪总论》"},"usage":"作宾语、定语；用于处事"},{"id":35027,"word":"积小成大","pinyin":"jī xiǎo chéng dà","abbr":"jxcd","explanation":"积累少量的东西，能成为巨大的数量。","source":{"text":"为小恶者，如积小以成大；从微至著，为一恶以至于万恶，一一而皆有祸应。","book":"《汉书·董仲舒传》：“聚少成多，积小致巨。”宋·张君房《云笈七签》卷九十"},"similar":["积少成多","聚沙成塔"],"usage":"作谓语、宾语；指积少成多"},{"id":35028,"word":"积小致巨","pinyin":"jī xiǎo zhì jù","abbr":"jxzj","explanation":"致：达到；巨：大。一点一滴的积累，就会从小到大。","source":{"text":"臣闻众小成多，积小致巨，故圣人莫不以暗致明，以微至显。","book":"东汉·班固《汉书·董仲舒传》"},"usage":"作谓语、宾语、定语；用于积累"},{"id":35029,"word":"积少成多","pinyin":"jī shǎo chéng duō","abbr":"jscd","explanation":"积累少量的东西，能成为巨大的数量。","source":{"text":"聚少成多，积小致巨。","book":"《战国策·秦策四》：“积薄而为厚，聚少而为多。”《汉书·董仲舒传》"},"example":{"text":"其实一个人做一把刀、一个勺子是有限得很，然而～，这笔账就难算了，何况更是历年如此呢。","book":"《二十年目睹之怪现状》第二十九回"},"similar":["日积月累","积水成渊","聚沙成塔"],"opposite":["杯水车薪"],"usage":"作谓语、宾语、分句；用于事物的逐渐聚积"},{"id":35030,"word":"积岁累月","pinyin":"jī suì lěi yuè","abbr":"jsly","explanation":"指经过的时间长。同“积年累月”。","source":{"text":"昔谢病山居，手植榆柳，今已郁然参天。若以官法为之，积岁累月，竟成虚谬矣。","book":"明·张居正《答总统凌洋山言边地种树设险书》"},"similar":["积年累月","积年累岁"],"usage":"作状语、分句；指经过的时间长久"},{"id":35031,"word":"积年累岁","pinyin":"jī nián lěi suì","abbr":"jnls","explanation":"指经过的时间长。同“积年累月”。","source":{"text":"[贼人]只得招出实话来：乃是积年累岁遇着节令盛时，即便四出剽窃，以及平时略贩子女，伤害性命。","book":"《二刻拍案惊奇》卷五"},"similar":["积年累月","积岁累月"],"usage":"作状语、分句；指经过的时间长久"},{"id":35032,"word":"积年累月","pinyin":"jī nián lěi yuè","abbr":"jnly","explanation":"积年：多年；累月：连月。指经过的时间长。","source":{"text":"积年累月，安有孝子乎？","book":"北齐·颜之推《颜氏家训·后娶》"},"example":{"text":"盖有所待，～，得遭其时，不忍自弃。","book":"宋·苏舜钦《上集贤文相书》"},"similar":["长年累月","积岁累月"],"usage":"作状语、分句；指经过的时间长久"},{"id":35033,"word":"积微成著","pinyin":"jī wēi chéng zhù","abbr":"jwcz","explanation":"微：细微；著：显著。微不足道的事物，经过长期积累，就会变得显著。","source":{"text":"夫尽小者大，积微成著，德至者色泽洽，行尽而声问远。","book":"《荀子·大略》"},"example":{"text":"连日累岁，～。","book":"《宋书·历志上》"},"similar":["积少成多","积微致著"],"usage":"作谓语、宾语；指积少成多"},{"id":35034,"word":"积微致著","pinyin":"jī wēi zhì zhù","abbr":"jwzz","explanation":"微：细微；著：显著。微不足道的事物，经过长期积累，就会变得显著。","source":{"text":"积微致著，累浅成深，鸿羽所以沉龙舟，群轻所以折劲轴，寸飚所以燔百寻之室，蠹蝎所以仆连抱之木也。","book":"《荀子·大略》：“夫尽小者大，积微者箸，德至者色泽洽，行尽而声问远。”晋·葛洪《抱朴子·疾谬》"},"similar":["积微成著"],"usage":"作谓语、宾语；指积少成多"},{"id":35035,"word":"积德累仁","pinyin":"jī dé lěi rén","abbr":"jdlr","explanation":"积累功德与仁义。","source":{"text":"李氏灭矣·自太公已来，积德累仁，何以遇此？","book":"《后汉书·李固传》"},"example":{"text":"盖取夫～，为海内所归往，武王因之，遂成大业。","book":"唐·梁肃《西伯受命称王议》"},"similar":["积德累功"],"usage":"作谓语、宾语；指积累仁德与功业"},{"id":35036,"word":"积德累功","pinyin":"jī dé lěi gōng","abbr":"jdlg","explanation":"积累仁德与功业。","source":{"text":"宣力之佐，比积德累功，忠勤帝室。","book":"三国·魏·曹髦《改元大赦诏》"},"example":{"text":"周从后稷到文武，～世勤苦，岂知才及四代孙，心轻王业如灰土。","book":"唐·白居易《八骏图》"},"similar":["积德累仁"],"usage":"作谓语、宾语；指积累仁德与功业"},{"id":35037,"word":"积德累善","pinyin":"jī dé lěi shàn","abbr":"jdls","explanation":"积累德行与善事。","source":{"text":"娄敬曰：‘陛下取天下与周室异。周之先自后稷，尧封之邰，积德累善十有余世。","book":"《史记·韩信卢绾列传论》：“韩信、卢绾非素积德累善之世，徼一时权变，以诈力成功。”又《刘敬叔孙通列传》"},"usage":"作谓语、定语；用于处世"},{"id":35038,"word":"积德裕后","pinyin":"jī dé yù hòu","abbr":"jdyh","explanation":"指积累德行，则后世昌盛。","source":{"text":"姊丈以一身榰柱百世之重，今继嗣未立，诚可忧也。况姻母太夫人年亦高矣，尤不能不以此为念也。积德裕后，古岂吾欺，今犹未验，何也！","book":"清·朱仕琇《又答李磻玉书》"},"usage":"作谓语、定语；用于处世"},{"id":35039,"word":"积忧成疾","pinyin":"jī yōu chéng jí","abbr":"jycj","explanation":"忧：忧虑。长久忧虑就会得病。","source":{"text":"了翁积忧成疾，三疏求贤不得请，迁起居郎。","book":"《宋史·儒林传·魏了翁》"},"example":{"text":"他一向不会照顾自己，又不注意营养，～，发烧到摄氏38度。","book":"徐迟《哥德巴赫猜想》"},"usage":"作谓语、宾语；指长久忧虑就会得病"},{"id":35040,"word":"积思广益","pinyin":"jī sī guǎng yì","abbr":"jsgy","explanation":"指集中众人的智慧，可使效果更大更好。","source":{"text":"三国·蜀·诸葛亮《教与军师长史参军掾属》：“夫参署者，集众思，广忠益也。”集，亦作“积”。"},"example":{"text":"古人兴事建功必先～，岂有言脱诸口，必使人同声并谈面莫予违也。","book":"宋·魏了翁《被召除礼部尚书内引奏事第四札》"},"similar":["集思广益"],"usage":"作谓语、定语、状语；指博采有益的意见"},{"id":35041,"word":"积恶余殃","pinyin":"jī è yú yāng","abbr":"jeyy","explanation":"多行不善，则会遭受恶报。劝人不要行恶，以免祸延子孙。","source":{"text":"《易经·坤卦·文言曰》：“积善之家，必有余庆；积不善之家，必有余殃。”南朝宋·释法明《答李交州难佛不见形》：“积善余庆，积恶余殃，虽新新生灭，交臂代谢，善恶之业，不得不受。”"},"example":{"text":"南朝·宋·释法明《答李交州难佛不见形》：“积善余庆，～。”"},"similar":["恶有恶报"],"opposite":["积善余庆"],"usage":"作宾语、定语；用于劝诫人"},{"id":35042,"word":"积愤不泯","pinyin":"jī fèn bù mǐn","abbr":"jfbm","explanation":"愤：怨愤；泯：灭。久积的怨恨难以消除。"},{"id":35043,"word":"积日累久","pinyin":"jī rì lěi jiǔ","abbr":"jrlj","explanation":"指经过的时间长。","source":{"text":"且古所谓功者，以任官称职为差，非所谓积日累久也。","book":"《汉书·董仲舒传》"},"similar":["成年累月"],"usage":"作补语、定语；指久经时日"},{"id":35044,"word":"积日累劳","pinyin":"jī rì lěi láo","abbr":"jrll","explanation":"积日：一天又一天；累：多。任职时间长，立下的功劳多。形容资历很深。","source":{"text":"下之不能积日累劳，取尊官厚禄，以为宗族交游光宠。","book":"汉·司马迁《报任少卿书》"}},{"id":35045,"word":"积日累岁","pinyin":"jī rì lěi suì","abbr":"jrls","explanation":"形容时间长久。","source":{"text":"或饮食过度，或劳佚不时，积日累岁，其来已久，以至元气弊亏，痰邪洨结。","book":"明·李东阳《求退录》"},"similar":["积年累岁","积日累月"],"usage":"作状语、分句；指经过的时间长久"},{"id":35046,"word":"积日累月","pinyin":"jī rì lěi yuè","abbr":"jrly","explanation":"指经过的时间长。同“积年累月”。","source":{"text":"若积日累月，万机之微，所失可胜言耶！","book":"宋·无名氏《靖康要录》卷一"},"example":{"text":"自以古文诗赋时艺～所择而存者，或尚未可传，藉令可传而亦不必传。","book":"清·谢增《〈说文通训定声〉跋》"},"similar":["积日累岁","积年累岁"],"usage":"作状语、分句；指经过的时间长久"},{"id":35047,"word":"积时累日","pinyin":"jī shí lěi rì","abbr":"jslr","explanation":"形容时间长久。","source":{"text":"在睡着时，偶得趾离过爱，引领我到回忆之乡，过那游离的日子，更不得不随醒随记，积时累日，成此小册。","book":"许地山《〈空山灵雨〉弁言》"},"similar":["经年累月","积日累月"],"usage":"作状语、分句；指经过的时间长久"},{"id":35048,"word":"积本求原","pinyin":"jī běn qiú yuán","abbr":"jbqy","explanation":"从根本上探求。","source":{"text":"后世之学琐屑支离，正所谓采摘汲引，其间亦宁无小补，然终非积本求原之学，句句是，字字合。","book":"明·王守仁《与王纯甫书》之三"},"usage":"作宾语、定语；用于处事"},{"id":35049,"word":"积案盈箱","pinyin":"jī àn yíng xiāng","abbr":"jayx","explanation":"案：桌；盈：满。堆满书桌，塞满书箱。形容书籍、文稿、卷宗等非常多。","source":{"text":"连篇累牍，不出月露之形；积案盈箱，惟是风云之状。","book":"《隋史·李谔传》"},"usage":"作谓语、定语；用于书面语"},{"id":35050,"word":"积毁消骨","pinyin":"jī huǐ xiāo gǔ","abbr":"jhxg","explanation":"指不断的毁谤能使人毁灭。同“积毁销骨”。","source":{"text":"昔鲁听季孙之说逐孔子，宋信子冉之计逐墨翟，以孔墨之辩而不能自免，何则？众口铄金，积毁消骨。","book":"汉·刘向《新序·杂事三》"},"example":{"text":"～，巧言铄金，市虎成于三人，投杼起于屡至。","book":"宋·苏轼《代滕甫辨谤乞郡书》"},"similar":["积毁销骨","积谗磨骨","积谗靡骨"],"usage":"作谓语、定语；用于书面语"},{"id":35051,"word":"积毁销金","pinyin":"jī huǐ xiāo jīn","abbr":"jhxj","explanation":"指不断的毁谤能使人毁灭。同“积毁销骨”。","source":{"text":"言毁谗之深，能销磨金石之坚。","book":"《文选·江淹〈诣建平王上书〉》：“下官闻积毁销金，积谗磨骨，远则直生取疑于盗金，近则伯鱼被名于不义。”吕向注"},"example":{"text":"人生实难，逢此织罗。～，沉忧作歌。","book":"唐·李白《雪谗诗赠友人》"},"similar":["积毁销骨","积谗磨骨","积谗靡骨"],"usage":"作谓语、定语；用于书面语"},{"id":35052,"word":"积毁销骨","pinyin":"jī huǐ xiāo gǔ","abbr":"jhxg","explanation":"积：聚；毁：毁谤；销：熔化。指不断的毁谤能使人毁灭。","source":{"text":"众口铄金，积毁销骨。","book":"《史记·张仪列传》"},"example":{"text":"而股肱之臣不惟国体，职竞寻常，自相楚剥，为害转深，～。","book":"《晋书·刘乔传》"},"similar":["人言可畏","积谗磨骨"],"usage":"作谓语、定语；常与“众口铄金”连用"},{"id":35053,"word":"积水成渊","pinyin":"jī shuǐ chéng yuān","abbr":"jscy","explanation":"渊：深水潭。点点滴滴的水聚积起来，就能形成一个深潭。比喻积小成多。","source":{"text":"积土成山，风雨兴焉；积水成渊，蛟龙生焉。","book":"《荀子·劝学》"},"similar":["积土成山","积少成多"],"usage":"作谓语、宾语、分句；比喻积少成多"},{"id":35054,"word":"积沙成塔","pinyin":"jī shā chéng tǎ","abbr":"jsct","explanation":"聚细沙成宝塔。原指儿童堆塔游戏。后比喻积少成多。","source":{"text":"乃至童子戏，聚沙为佛塔。","book":"《妙法莲华经·方便品》"},"similar":["聚沙成塔"],"usage":"作宾语、定语、分句；指积少成多"},{"id":35055,"word":"积沙成滩","pinyin":"jī shā chéng tān","abbr":"jsct","explanation":"比喻积少成多。","source":{"text":"虽然鱼群分散，但捕一网得一网，积沙成滩，化小胜为大胜，使淡季也取得较好的收获。","book":"《人民日报》1970.12.30"},"similar":["积少成多","聚沙成塔"],"usage":"作谓语、定语；比喻积少成多"},{"id":35056,"word":"积玉堆金","pinyin":"jī yù duī jīn","abbr":"jydj","explanation":"金玉多得可以堆积起来。形容聚敛的财富极多。","source":{"text":"堆金积玉夸豪毅。","book":"唐·李贺《嘲少年》诗"},"example":{"text":"阳世间是一条好善的穷汉，那世里却是个～的长者。","book":"明·吴承恩《西游记》第十二回"},"similar":["堆金积玉"],"usage":"作谓语、定语；指财富极多"},{"id":35057,"word":"积甲如山","pinyin":"jī jiǎ rú shān","abbr":"jjrs","explanation":"兵甲堆叠如山。极言其多。同“积甲山齐”。","source":{"text":"受降则积甲如山，振旅则执同听凯。","book":"清·张惠言《馆试灵台偃伯赋》"},"similar":["积甲山齐"],"usage":"作宾语、定语；指数量很多"},{"id":35058,"word":"积甲山齐","pinyin":"jī jiǎ shān qí","abbr":"jjsq","explanation":"兵甲堆叠如山。极言其多。","source":{"text":"樊崇乃将盆子及丞相徐宣以下三十余人肉袒降，上所得传国玺绶、更始七尺宝剑及玉璧各一，积兵甲宜阳城西，与熊耳山齐。","book":"《后汉书·刘盆子传》"},"example":{"text":"～而有余，收马谷量而未尽。","book":"唐·张说《赠凉州都督上柱国太原郡开国公郭君碑》"},"similar":["积甲如山"],"usage":"作宾语、定语；指数量很多"},{"id":35059,"word":"积简充栋","pinyin":"jī jiǎn chōng dòng","abbr":"jjcd","explanation":"书简堆积，充塞屋子。形容文章极多。","source":{"text":"窃惟我皇上盛德崇功，嘉言善政，虽积简充栋，未能殚尽。","book":"清·方苞《万年宝历颂》"},"similar":["汗牛充栋"],"usage":"作谓语、定语；用于比喻句"},{"id":35060,"word":"积箧盈藏","pinyin":"jī qiè yíng cáng","abbr":"jqyc","explanation":"箧：小箱子；盈：充满；藏：储存东西的地方。箱子堆积，仓库充盈。形容积聚的财物多。","source":{"text":"至于积箧盈藏，未尝登体；溢俎充庖，既沃斯弃。","book":"南朝·梁·沈约《舍身愿铭》"},"usage":"作宾语、定语；用于书面语"},{"id":35061,"word":"积素累旧","pinyin":"jī sù lěi jiù","abbr":"jslj","explanation":"指多年交往。","source":{"text":"昔宁戚商歌，以干齐桓；越石负刍，而寤晏婴：非有积素累旧之欢，皆涂觏卒遇而以为亲者也。","book":"汉·王褒《四子讲德论》"},"example":{"text":"恍然，凝思，忆番禺举子刘文秀，美貎年少，行义甚高，与生有～之欢。","book":"苏曼殊《焚剑记》"},"usage":"作谓语、定语；用于交往"},{"id":35062,"word":"积羞成怒","pinyin":"jī xiū chéng nù","abbr":"jxcn","explanation":"犹恼羞成怒。指羞愧至极，转生愤怒。","source":{"text":"既而臣民犯颜，友邦侧目，志不得逞，遂乃积羞成怒，大兴党狱。","book":"梁启超《清议报一百册祝辞并论报馆之责任及本馆之经历》"},"similar":["恼羞成怒"],"usage":"作谓语、定语、状语；指发怒"},{"id":35063,"word":"积羽沉舟","pinyin":"jī yǔ chén zhōu","abbr":"jycz","explanation":"羽毛虽轻，积多了也能把船压沉。比喻小小的坏事积累起来就会造成严重的后果。","source":{"text":"臣闻积羽沉舟，群轻折轴。","book":"《战国策·魏策一》"},"example":{"text":"难道是～，这金银呵反为轻载。","book":"元·无名氏《来生债》第三折"},"similar":["蚁穴溃堤"],"usage":"作谓语、定语；比喻积小患可致大灾","story":["战国时期，秦国的相国张仪发现齐、楚、燕、赵、韩、魏六国的合纵盟约十分牢固，就辞去相位，到魏国出任相国，他想劝说魏王与秦国联合，退出合纵盟约。魏王不听。秦国就出兵攻打。张仪说魏国如忽视这些不利因素就会积羽沉舟的"]},{"id":35064,"word":"积羽沉舟，群轻折轴","pinyin":"jī yǔ chén zhōu，qún qīng zhé zhóu","abbr":"jyczqqzz","explanation":"羽毛虽轻，积多了也能把船压沉；东西虽轻，积攒多了也能把车轴压断。比喻小小的坏事积累起来就会造成严重的后果。","source":{"text":"臣闻积羽沉舟，群轻折轴。","book":"《战国策·魏策一》"}},{"id":35065,"word":"积而能散","pinyin":"jī ér néng sàn","abbr":"jens","explanation":"积：积蓄；散：散发。能把自己的积蓄散发给贫困的人。","source":{"text":"爱而知其恶，憎而知其善，积而能散，安安而能迁。","book":"《礼记·曲礼上》"}},{"id":35066,"word":"积苏累块","pinyin":"jī sū lěi kuài","abbr":"jslk","explanation":"苏：柴草；累：重叠；块：土块。堆积的柴草和重迭的土块。形容居住的地方很简陋。","source":{"text":"帝之所居，王俯而视之，其宫榭若累块积苏焉。","book":"《列子·周穆王》"},"example":{"text":"积苏与累块，分明是九垓。","book":"金·元好问《游泰山》"}},{"id":35067,"word":"积草囤粮","pinyin":"jī cǎo tún liáng","abbr":"jcdl","explanation":"积：积累；囤：囤积。指储存粮食和草料等战备物资。","source":{"text":"蜂屯蚁聚施威武，积草囤粮待战争。","book":"清·钱彩《说岳全传》第35回"},"similar":["积草屯粮"],"usage":"作谓语、宾语；指储存战备物资"},{"id":35068,"word":"积草屯粮","pinyin":"jī cǎo tún liáng","abbr":"jctl","explanation":"积、屯：积存，储存。储存粮食和草料。指聚积战备物资。","source":{"text":"如今且收兵回营，操军练士，积草屯粮，整溯人马，慢慢的再与孙坚交战。","book":"元·郑德辉《三战吕布》第一折"},"example":{"text":"立竖招军旗号，买马招军，～。","book":"明·施耐庵《水浒全传》第一百五回"},"similar":["积草囤粮"],"usage":"作谓语、宾语；指储存战备物资"},{"id":35069,"word":"积薪候燎","pinyin":"jī xīn hòu liáo","abbr":"jxhl","explanation":"比喻自取灭亡。燎，火炬。","source":{"text":"尔朱荣马邑小胡，人才凡鄙，不度德量力，长戟指阙，所谓穷辙拒轮，积薪候燎！","book":"北魏·杨衒之《洛阳伽蓝记·永宁寺》"},"usage":"作宾语、定语；用于比喻句"},{"id":35070,"word":"积薪厝火","pinyin":"jī xīn cuò huǒ","abbr":"jxch","explanation":"薪：柴草；厝：同：“措”，放置。把火放在柴堆下面。比喻隐藏着很大的危险，后患无穷。","source":{"text":"积薪厝火，其焰立见。","book":"清·张岱《越绝诗小序》"},"example":{"text":"幸能～，得获暂时之安逸。","book":"黄远庸《北京之新年》"},"similar":["厝火积薪"],"usage":"作宾语、定语；指藏着很大的危机"},{"id":35071,"word":"积衰新造","pinyin":"jī shuāi xīn zào","abbr":"jsxz","explanation":"指长期衰颓，刚刚得到重建。","source":{"text":"中原之强固百倍于匈奴，虽积衰新造，而犹足以制之也。","book":"宋·苏洵《审敌》"},"usage":"作宾语、定语；用于书面语"},{"id":35072,"word":"积讹成蠹","pinyin":"jī é chéng dù","abbr":"jecd","explanation":"指谬误积久，败坏人心。","source":{"text":"京师，诸夏之本也，将以观理，而豪猾时逾检；太学，明教之源也，期于变风，而生徒多堕业；列郡在乎颁条，而干禁或未绝；又在乎按度，而淫巧或未格。俗恬风靡，积讹成蠹。","book":"唐·沈亚之《贤良方正能直言极谏策》"},"usage":"作谓语、定语；用于书面语"},{"id":35073,"word":"积谗磨骨","pinyin":"jī chán mó gǔ","abbr":"jcmg","explanation":"指不断的毁谤能使人毁灭。同“积毁销骨”。","source":{"text":"《文选·江淹〈诣建平王上书〉》：“下官闻积毁销金，积谗磨骨，远则直生取疑于盗金，近则伯鱼被名于不义。”吕向注：“言毁谗之深，能销磨金石之坚。”《梁书·江淹传》引作“积谗糜骨”。"},"similar":["积毁销骨","积毁消骨","积谗糜骨"],"usage":"作谓语、定语；用于书面语"},{"id":35074,"word":"积谗糜骨","pinyin":"jī chán méi gǔ","abbr":"jcmg","explanation":"指不断的毁谤能使人毁灭。同“积谗磨骨”。","source":{"text":"言毁谗之深，能销磨金石之坚。","book":"《梁书·江淹传》：“下官闻积毁销金，积谗糜骨，远则直生取疑于盗金，近则伯鱼被名于不义。”吕向注"},"similar":["积毁销骨","积毁消骨","积谗磨骨"],"usage":"作谓语、定语；用于书面语"},{"id":35075,"word":"积谷防饥","pinyin":"jī gǔ fáng jī","abbr":"jgfj","explanation":"储存粮食，防备饥荒。","source":{"text":"书云：积谷防饥，养子防老。","book":"《敦煌变文集·父母恩重经讲经文》"},"example":{"text":"又道是养儿代老，～。","book":"元·高则诚《琵琶记·谏父》"},"similar":["养儿防老","有备无患"],"usage":"作宾语；指储存粮食，防备饥荒"},{"id":35076,"word":"积财千万，不如薄技在身","pinyin":"jī cái qiān wàn，bù rú bó jì zài shēn","abbr":"jcqwbrbjzs","explanation":"积蓄财产，不如学点技术。","source":{"text":"谚曰：‘积财千万，不如薄技在身。’技之易习而可贵者，无过读书也。","book":"北齐·颜之推《颜氏家训·勉学》"},"usage":"作宾语、分句；指积蓄财产，不如学点技术"},{"id":35077,"word":"积财吝赏","pinyin":"jī cái lìn shǎng","abbr":"jcls","explanation":"吝：使不得。尽管积累了很多财富，却舍不得赏赐给下属。形容非常吝啬。","source":{"text":"吾为汝御后，费力劳心，汝今积财吝赏，何以使士卒效命乎？","book":"明·罗贯中《三国演义》第六十二回"},"usage":"作谓语、定语；指人很吝啬"},{"id":35078,"word":"积重不反","pinyin":"jī zhòng bù fǎn","abbr":"jzbf","explanation":"经过长时间形成的思想作风或习惯，很难改变。同“积重难返”。","source":{"text":"当明之初，以科目网罗天下之士，已而诸科皆罢，独以时文相尚，而进士一途遂成积重不反之势。","book":"清·戴名世《〈三山存业〉序》"},"similar":["积重不返","积重难返","积重难反"],"usage":"作宾语、定语、分句；指习惯难改"},{"id":35079,"word":"积重不返","pinyin":"jī zhòng bù fǎn","abbr":"jzbf","explanation":"经过长时间形成的思想作风或习惯，很难改变。同“积重难返”。","source":{"text":"故余谓偏伐阳者，韩非刑名之学；偏补阳者，商鞅富强之术。初用皆有功，积重不返，其损伤根本则一也。","book":"清·纪昀《阅微草堂笔记·滦阳消夏录三》"},"similar":["积重不反","积重难返","积重难反"],"usage":"作宾语、定语、分句；指习惯难改"},{"id":35080,"word":"积重难反","pinyin":"jī zhòng nán fǎn","abbr":"jznf","explanation":"积：积累；重：严重；反：同“返”，返回。经过长时间形成的思想作风或习惯，很难改变","source":{"text":"近来风俗人情，积习生弊，有颓靡不振之渐，有积重难反之几，若不稍加改易，恐无以新天下之耳目，一天下之心志。","book":"明·张居正《除六事疏》"},"similar":["积重不返","积重难返","积重不反"],"usage":"作宾语、定语、分句；指习惯难改"},{"id":35081,"word":"积重难返","pinyin":"jī zhòng nán fǎn","abbr":"jznf","explanation":"经过长时间形成的思想作风或习惯，很难改变。同“积重难返”。","source":{"text":"近来风俗人情，积习生弊，有颓靡不振之渐，有积重难反之几。若不稍加改易，恐无以新天下之耳目，一天下之心志。","book":"明·张居正《陈六事疏》"},"example":{"text":"鲁迅《且介亭杂文二集·论毛笔之类》：“虽然为了‘～’，终于也造不出什么东西来。”"},"similar":["积性难改","根深蒂固"],"opposite":["痛改前非","拨乱反正"],"usage":"作宾语、定语、分句；指习惯难改"},{"id":35082,"word":"积金累玉","pinyin":"jī jīn lèi yù","abbr":"jjly","explanation":"金玉堆积。形容财富很多。","source":{"text":"怀银纾紫，未必稷、契之才；积金累玉，未必陶朱之智。","book":"汉·王充《论衡·命禄》"},"similar":["堆金积玉"],"usage":"作谓语、定语；指十分富有"},{"id":35083,"word":"积金至斗","pinyin":"jī jīn zhì dǒu","abbr":"jjzd","explanation":"北斗星。堆积起来的金子能触到北斗星。比喻积累的财富极多。","source":{"text":"亿万持衡价，锱珠挟契论。堆时过北斗，积处满西园。","book":"唐·杜牧《昔事文皇帝三十二韵》诗"},"example":{"text":"～，知公情不可移。","book":"《旧唐书·尉迟敬德传》"},"usage":"作谓语、定语；用于书面语"},{"id":35084,"word":"积铢累寸","pinyin":"jī zhū lěi cùn","abbr":"jzlc","explanation":"形容一点一滴地积累。","source":{"text":"如有盈余，积铢累寸，今年买半亩，明年买半亩。","book":"何刚德《客座偶谈》第四卷"},"similar":["聚沙成塔"],"usage":"作谓语、定语；指积聚不遗细小"},{"id":35085,"word":"积雪囊萤","pinyin":"jī xuě náng yíng","abbr":"jxny","explanation":"积雪：南朝孙康映雪读书。见《尚友录》卷四。囊萤：晋代车胤把萤火虫装在口袋里，借荧光读书。见《晋书·车胤传》。形容刻苦攻读。","source":{"text":"咱祖父乃文林华胄，况外戚是儒业簪缨，哀先相几乎绝嗣，使小姐振厥家声，又何须悬头刺股、积雪囊萤，那里也齐家治国、显姓扬名。","book":"元·郑光祖《梅香》第一折"},"similar":["囊萤积雪","集萤映雪"],"usage":"作宾语、定语；用于求学等","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":35086,"word":"积雪封霜","pinyin":"jī xuě fēng shuāng","abbr":"jxfs","explanation":"形容操守高洁坚贞。","source":{"text":"常忽忽不乐，著《修柏赋》以见志，曰：‘……冲风不能摧其枝，积雪不能改其性。’","book":"《南史·齐江夏王锋传》"},"example":{"text":"非夫禀乾坤之秀气，含宇宙之淳精，孰能负凌云慨日之姿，抱～之骨。","book":"唐·骆宾王《浮查》诗序"},"usage":"作宾语、定语；用于比喻句"},{"id":35087,"word":"积露为波","pinyin":"jī lù wéi bō","abbr":"jlwb","explanation":"比喻积少成多。","source":{"text":"衲子欲言面羞涩，试介乌纱作檀越，积露为波江可得，东邻北里贤相识。","book":"明·袁宏道《题龙堂僧募册》诗"},"similar":["积少成多","集腋成裘"],"usage":"作宾语、定语；用于比喻句"},{"id":35088,"word":"积非习贯","pinyin":"jī fēi xí guàn","abbr":"jfxg","explanation":"指错误长久沿袭，已成习惯。贯，通“惯”。","source":{"text":"至于俗间行语，众所共传，积非习贯，莫能原察。","book":"汉·应劭《〈风俗通〉序》"},"usage":"作谓语、定语；用于习惯等"},{"id":35089,"word":"积非成是","pinyin":"jī fēi chéng shì","abbr":"jfcs","explanation":"指长期所形成的错误，往往被当作正确的。","source":{"text":"治经之士，莫能综贯，习所见闻，积非成是，余言恐未足以振兹坠绪也。","book":"清·戴震《孟子字义疏证·原善序》"},"example":{"text":"对于一些早已～、具有广泛群众基础的误读音，就不能太拘泥于语音本身的发展规律。","book":"胡明扬《词典学概论》第七章第二节"},"similar":["是非混淆","将错就错","积重难返"],"opposite":["拨乱反正"],"usage":"作谓语；指长期所形成的错误被当成正确的"},{"id":35090,"word":"称体裁衣","pinyin":"chèn tǐ cái yī","abbr":"ctcy","explanation":"称：适合。按照身材来裁剪衣服。比喻按照实际情况办事。","source":{"text":"今送一通故衣，意谓虽故，乃胜新也，是吾所著，已令裁减称卿之体。","book":"《南齐书·张融传》"},"example":{"text":"我们办任何事情都要～。"},"similar":["称身裁衣","量体裁衣"],"usage":"作谓语、宾语、分句；指实事求是"},{"id":35091,"word":"称体载衣","pinyin":"chèn tǐ cái yī","abbr":"ctzy","explanation":"称：适合。按照身材剪载衣服。比喻根据实际情况办事。","source":{"text":"今送一通故衣，意谓虽故，乃胜新也，是吾所著，已令裁减称卿之体。","book":"《南齐书·张融传》"}},{"id":35092,"word":"称兄道弟","pinyin":"chēng xiōng dào dì","abbr":"cxdd","explanation":"朋友间以兄弟相称。形容关系亲密。","source":{"text":"见了同事周老爷一班人，格外显得殷勤，称兄道弟，好不热闹。","book":"清·李宝嘉《官场现形记》第12回"},"example":{"text":"公安局通缉的杀人犯，可以住在他公馆里不受法律制裁，公安局长跟他照样～，","book":"高云览《小城春秋》第七章"},"similar":["情同手足","亲如手足"],"opposite":["行同陌路"],"usage":"作谓语、定语；形容关系密切"},{"id":35093,"word":"称功诵德","pinyin":"chēng gōng sòng dé","abbr":"cgsd","explanation":"称：称道；功：功绩；德：德行。颂扬功绩和德行。","source":{"text":"但凡下人，肚肠极是窄狭，得了须微之利，便极口称功诵德，欢声溢耳。","book":"明·冯梦龙《醒世恒言》第27卷"},"example":{"text":"清·荻岸山人《平山冷燕》第一回：“这表章无非是～，没甚大关系，便各各逞才，极其精工富丽。”"},"similar":["称功颂德","歌功颂德"],"usage":"作谓语、宾语、定语；指赞扬人"},{"id":35094,"word":"称功颂德","pinyin":"chēng gōng sòng dé","abbr":"cgsd","explanation":"称颂功德。","source":{"text":"何必借我们，你鼓唇摇舌的，自己开心作戏，却说是称功颂德呢。","book":"清·曹雪芹《红楼梦》第六十三回"},"similar":["歌功颂德","称功诵德"],"usage":"作谓语、宾语、定语；指赞扬人"},{"id":35095,"word":"称名道姓","pinyin":"chēng míng dào xìng","abbr":"cmdx","explanation":"称：称道。称呼姓名。","source":{"text":"今日两贼相逢，何用称名道姓，君为芦中之事，我为船上之人，意义足亦可知，富贵不须相忘。","book":"《敦煌变文集·伍子胥变文》"},"example":{"text":"曾朴《孽海花》第八回：“谁要你们～的作弄人。”"},"similar":["提名道姓"],"usage":"作谓语、宾语、定语；用于口语"},{"id":35096,"word":"称奇道绝","pinyin":"chēng qí dào jué","abbr":"cqdj","explanation":"觉得奇怪难得。","source":{"text":"宝玉听了这呆话，独合了他的呆性，不觉又喜又悲，又称奇道绝。","book":"清·曹雪芹《红楼梦》第五十八回"},"usage":"作谓语、宾语；用于奇特的事物"},{"id":35097,"word":"称孤道寡","pinyin":"chēng gū dào guǎ","abbr":"cgdg","explanation":"孤、寡：古代帝王自称。指自封为王。也比喻狂妄地以首领自居。","source":{"text":"俺哥哥称孤道寡世无双，我关某疋马单刀镇荆襄。","book":"元·关汉卿《关大王独赴单刀会》三折"},"example":{"text":"象钱王生于乱世，独霸一方，做了一十四州之王，～，非同小可。","book":"明·冯梦龙《古今小说》卷二十一"},"similar":["独霸一方","独断专行","横行霸道"],"opposite":["低声下气","谦虚谨慎","克己奉公"],"usage":"作谓语；比喻狂妄自大，为所欲为"},{"id":35098,"word":"称家有无","pinyin":"chèn jiā yǒu wú","abbr":"cjyw","explanation":"称：适合，相符。与家庭经济情况相符。指办理婚、丧等事不可过奢或过俭。","source":{"text":"子游问丧具，夫子曰：‘称家之有亡（无）。’","book":"《礼记·檀弓上》"},"example":{"text":"乃遗书喻其子曰：“尔当营治丧具，～。”","book":"明·赵弼《新繁胡大尹传》"},"usage":"作谓语；指办事与家庭经济情况相符"},{"id":35099,"word":"称帝称王","pinyin":"chēng dì chēng wáng","abbr":"cdcw","explanation":"帝：帝王；王：君王。比喻凭借势力，飞扬跋扈，独断专行，狂妄自大。","source":{"text":"设使国家无有孤，不知当几人称帝，几人称王。","book":"三国·魏·曹操《让县自明本志令》"},"example":{"text":"～非一个，国家不可便无孤。","book":"宋·刘克庄《魏志》诗"},"similar":["称王称霸","称王称伯"],"usage":"作谓语、宾语；比喻独断专行为所欲为"},{"id":35100,"word":"称德度功","pinyin":"chēng dé duó gōng","abbr":"cddg","explanation":"称：衡量；度：估量。对被任用的人既要考虑到他的品德，也要考虑到他的功劳。","source":{"text":"称德度功，劝其所能。","book":"《管子·君臣下》"},"usage":"作谓语；指用人之道"},{"id":35101,"word":"称心如意","pinyin":"chèn xīn rú yì","abbr":"cxry","explanation":"形容心满意足，事情的发展完全符合心意。","source":{"text":"称心如意，剩活人间几岁？","book":"宋·朱敦儒《感皇恩》词"},"example":{"text":"但是这个贵州，十分瘠苦，处万山之中，又是晴少雨多，吃的、用的、穿的，无一样能够～。","book":"清·吴趼人《糊涂世界》卷五"},"similar":["心满意足","如愿以偿","尽如人意"],"opposite":["大失所望","事与愿违"],"usage":"作谓语、宾语、定语；指合符心意"},{"id":35102,"word":"称心快意","pinyin":"chèn xīn kuài yì","abbr":"cxky","explanation":"遇事如意，心情舒畅。称心：恰合心愿。快意：心情爽快舒适。","source":{"text":"若得如此，亡魂俱称心快意了。","book":"明·凌濛初《初刻拍案惊奇》第25卷"},"example":{"text":"如今，要革掉这个忘八犊子的狗命，他是～的。","book":"周立波《暴风骤雨》第一部"},"similar":["心满意足"],"opposite":["大失所望"],"usage":"作谓语、定语；指满意"},{"id":35103,"word":"称心满意","pinyin":"chèn xīn mǎn yì","abbr":"cxmy","explanation":"称心如意。","source":{"text":"我果有功名之分，若得一日称心满意，就死何恨。","book":"明·冯梦龙《古今小说·木绵庵郑虎臣报冤》"},"example":{"text":"等候在前头的，是志同道合的伴侣，是～的事业，是理想与事实的一致。","book":"叶圣陶《倪焕之》"},"similar":["心满意足","称心如意"],"opposite":["大失所望"],"usage":"作谓语、定语；指满意"},{"id":35104,"word":"称心满愿","pinyin":"chèn xīn mǎn yuàn","abbr":"cxmy","explanation":"称心如意。","source":{"text":"俺两个得成双，称心满愿。","book":"元·无名氏《碧桃花》第三折"},"similar":["称心如意"],"opposite":["事与愿违"],"usage":"作谓语、宾语、定语；指合符心意"},{"id":35105,"word":"称斤掂两","pinyin":"chēng jīn diān liǎng","abbr":"cjdl","explanation":"称：衡量轻重；掂：掂量。计算轻重分量。比喻计较轻重得失。","source":{"text":"一次搞购粮工作，找全县的干部来布置任务，有个别干部，称斤掂两的，怕任务重了完不成。","book":"王愿坚《粮食的故事》"},"similar":["称斤约两","斤斤计较"],"usage":"作谓语、定语；用于抉择"},{"id":35106,"word":"称斤注两","pinyin":"chēng jīn zhù liǎng","abbr":"cjzl","explanation":"形容只注重小节而没有气势。","source":{"text":"那时士人所做文字极粗，更无委曲柔弱之态，所以亦养得气宇，只看如今称斤注两，作两句破头，如此是多少衰气。","book":"宋·朱嘉《朱子语类·论取士》"},"usage":"作谓语、宾语；用于为人"},{"id":35107,"word":"称斤约两","pinyin":"chēng jīn yuē liǎng","abbr":"cjyl","explanation":"称：衡量轻重。计算轻重分量。比喻权衡轻重得失。","source":{"text":"申耀宗也没睡着，他肚子里大大小小几杆秤，正在称斤约两的活动呢。","book":"孔厥《新儿女英雄传》第13回"},"similar":["称斤掂两"],"usage":"作谓语、定语、状语；用于抉择"},{"id":35108,"word":"称柴而爨","pinyin":"chēng chái ér cuàn","abbr":"ccec","explanation":"称了薪柴才去生火煮饭。比喻斤斤于细节而不识大体。同“称薪而爨”。","source":{"text":"积财聚谷，日不暇给。真个是数米而炊，称柴而爨。","book":"明·冯梦龙《警世通言》卷五"},"similar":["称薪而爨"],"usage":"作谓语、定语；用于生活拮据"},{"id":35109,"word":"称物平施","pinyin":"chēng wù píng shī","abbr":"cwps","explanation":"根据东西的轻重、多少，公平合理地分给他人。比喻一样对待，不分厚薄。","source":{"text":"君子以裒多益寡，称物平施。","book":"《周易·谦》"},"example":{"text":"～，出一代经纶之手；议狱缓死，佐九重断制之仁。","book":"宋·陈亮《谢胡参政启》"},"usage":"作谓语、定语；用于处事"},{"id":35110,"word":"称王称伯","pinyin":"chēng wáng chēng bà","abbr":"cwcb","explanation":"王：君王；伯：通“霸”，霸主。比喻凭借势力，飞扬跋扈，独断专行，狂妄自大。","source":{"text":"今人拘于宋人之说诗，而不问唐人违合，莫不称王称伯，狐魅后学，使尊奉己学。","book":"清·吴乔《答万季崊诗问》"},"similar":["称王称霸"],"usage":"作谓语、宾语；比喻独断专行为所欲为"},{"id":35111,"word":"称王称霸","pinyin":"chēng wáng chēng bà","abbr":"cwcb","explanation":"王：帝王；霸：古代诸侯联盟的首领。比喻凭借权势横行一方，或狂妄地以首脑自居。","source":{"text":"刘项称王称霸，关张无命无功。","book":"三国·魏·曹操《让县自明本志令》：“设使国家无有孤，不知当几人称帝，几人称王。”宋·汪元量《读史》"},"example":{"text":"决不可把自己关在小房子里，自吹自擂，～。","book":"毛泽东《在陕甘宁边区参议会的演说》"},"similar":["称孤道寡","盛气凌人","飞扬跋扈"],"opposite":["谦谦君子"],"usage":"作谓语、宾语；比喻独断专行为所欲为"},{"id":35112,"word":"称臣纳贡","pinyin":"chēng chén nà gòng","abbr":"ccng","explanation":"旧时指小国向大国臣服而年年进贡。","source":{"text":"旧时指小国向大国臣服而年年进贡。"},"example":{"text":"我们不能干～的事。"},"similar":["俯首称臣"],"opposite":["称王称霸"],"usage":"作谓语、定语；指臣服"},{"id":35113,"word":"称薪而爨","pinyin":"chēng xīn ér cuàn","abbr":"cxec","explanation":"薪：柴；爨：烧火煮饭。称了柴草煮饭。比喻只注意小事，不从大处着眼。","source":{"text":"称薪而爨，数米而炊，可以治小而未可以治大也。","book":"《淮南子·泰族训》"},"example":{"text":"积财聚谷，日不暇给。真个是数米而炊，称柴而爨。","book":"明·冯梦龙《警世通言》卷五"},"similar":["称柴而爨"],"usage":"作谓语、定语；常与“数米而炊”连用"},{"id":35114,"word":"称薪而爨，数米而炊","pinyin":"chēng xīn ér cuàn，shǔ mǐ ér chuī","abbr":"cxecsmec","explanation":"薪：柴；爨：烧火煮饭。称柴草，数米粒做饭。比喻只注意小事，不从大处着眼。","source":{"text":"称薪而爨，数米而炊，可以治小而未可以治大也。","book":"《淮南子·泰族训》"},"similar":["称薪而爨，数粒乃炊"],"usage":"作谓语、定语；用于生活"},{"id":35115,"word":"称薪而爨，数粒乃炊","pinyin":"chēng xīn ér cuàn，shǔ lì nǎi chuī","abbr":"cxecslnc","explanation":"称：衡量；薪：柴；爨：烧火煮饭。称了柴草数着米粒煮饭。比喻只注意小事，斤斤计较，形容吝啬或贫穷。","source":{"text":"明者举大略细，不忮不求，故能取威定功，成天平地，岂肯称薪而爨，数粒乃炊，并瑕弃璧。","book":"晋·葛洪《抱朴子·接疏》"},"similar":["称薪而爨，数米而炊"],"usage":"作谓语、定语；用于生活"},{"id":35116,"word":"称薪量水","pinyin":"chēng xīn liáng shuǐ","abbr":"cxls","explanation":"比喻精打细算地过日子。","source":{"text":"安老爷虽是研究铸史的通品，却是个称薪量水的外行。","book":"清·文康《儿女英雄传》第33回"},"example":{"text":"过日子到了～的地步，人就没有希望了。"},"similar":["称薪而爨"],"usage":"作宾语、定语；用于生活"},{"id":35117,"word":"称贤使能","pinyin":"chēng xián shǐ néng","abbr":"cxsn","explanation":"称：举；使：用。举用贤能人士，使其发挥所长。","source":{"text":"泉深而鱼鳖归之，草木茂而鸟兽归之，称贤使能、官有材而士归之。","book":"《逸周书·大聚》"},"opposite":["妒贤嫉能"],"usage":"作谓语、宾语；用于选拔人才"},{"id":35118,"word":"称贤荐能","pinyin":"chēng xián jiàn néng","abbr":"cxjn","explanation":"称：称扬。指重视人才，推举贤能。","source":{"text":"接士，多可而有别，称贤荐能，未尝倦。","book":"唐·白居易《有唐善人墓碑》"},"example":{"text":"要重视人才，～。"},"usage":"作谓语、定语；指用人"},{"id":35119,"word":"称赏不已","pinyin":"chēng shǎng bù yǐ","abbr":"csby","explanation":"赏：赞赏。不已：继续不止。连连称赞。","source":{"text":"讨论撰定，皆合事宜，威称赏不已。","book":"《五代史平话·周史》"},"example":{"text":"面对如此精细的工艺，我们～。"},"similar":["赞不绝口"],"usage":"作谓语、定语；用于书面语"},{"id":35120,"word":"称赏不置","pinyin":"chēng shǎng bù zhì","abbr":"csbz","explanation":"称赏：赞美；不置：不住地。不住地赞美。形容对事物的喜爱。"},{"id":35121,"word":"称身裁衣","pinyin":"chèn shēn cái yī","abbr":"cscy","explanation":"称：适合。按照身材来裁剪衣服。比喻按照实际情况办事。","source":{"text":"今送一通故衣，意谓虽故，乃胜新也。是吾所著，已令裁减称卿之体。","book":"《南齐书·张融传》"},"similar":["量体裁衣","称体裁衣"],"usage":"作谓语、宾语、分句；指实事求是"},{"id":35122,"word":"称量而出","pinyin":"chēng liáng ér chū","abbr":"clec","explanation":"称量：用秤称，用斗量。用秤、斗仔细测定后才拿出来。比喻说话、写文章经过斟酌，恰如其分。","source":{"text":"我听他近来的演说，有两三回也是这么精悍，字字句句好似称量而出。","book":"朱自清《中国学术的大损失——悼闻一多先生》"}},{"id":35123,"word":"称锤落井","pinyin":"chèng chuí luò jǐng","abbr":"cclj","explanation":"称：通“秤”，衡器；称锤：秤砣。比喻不见踪影，没有消息。","source":{"text":"福州资福善禅师：自此一别，称锤落井。","book":"宋·释晓莹《罗湖野录》第一卷"},"example":{"text":"他这一去就如同～一样再无音信。"},"similar":["石沉大海"],"usage":"作宾语；指没有消息"},{"id":35124,"word":"称雨道晴","pinyin":"chēng yǔ dào aíng","abbr":"cydq","explanation":"比喻说话说不到一块。","source":{"text":"县官甚不和，长官称雨，赞府道晴，终日如此不和也。","book":"明·邹善长《汇苑详注》第15卷"},"example":{"text":"他们～说不到一处。"},"similar":["话不投机"],"opposite":["情投意合"],"usage":"作谓语、定语；指话不投机"},{"id":35125,"word":"移丘换段","pinyin":"yí qiū huàn duàn","abbr":"yqhd","explanation":"改动地段的区划来谋取私利。","source":{"text":"若将田土移坵换段，挪移等则，以高作下，减瞒粮额……罪亦如之。","book":"《明律·户律·田宅》"}},{"id":35126,"word":"移东就西","pinyin":"yí dōng jiù xī","abbr":"ydjx","explanation":"彼此挪动转移。比喻只求暂时应付，不作长久打算。","source":{"text":"移东就西，便为课续。取此适彼，遂号羡余。","book":"唐·陆贽《论裴延龄奸蠹书》"},"similar":["移东补西"],"usage":"作谓语、定语；指临时应付"},{"id":35127,"word":"移东换西","pinyin":"yí dōng huàn xī","abbr":"ydhx","explanation":"比喻生活不安定。","source":{"text":"则恐一生只得如此，移东换西，终是不成家计也。","book":"宋·朱熹《答吕子约》"},"usage":"作谓语、定语；用于书面语"},{"id":35128,"word":"移东掩西","pinyin":"yí dōng yǎn xī","abbr":"ydyx","explanation":"用这方面的钱、物弥补那方面的亏空或不足。比喻只求暂时应付，不作长久打算。","source":{"text":"移东就西，便为课续。取此适彼，遂号羡余。","book":"唐·陆贽《论裴延龄奸蠹书》"},"example":{"text":"我是个老实人，有一句便说一句，从来不晓得将没作有，～，哄骗别人。","book":"清·无名氏《定情人》第五回"}},{"id":35129,"word":"移东篱，掩西障","pinyin":"yí dōng lí，yǎn xī zhàng","abbr":"ydlyxz","explanation":"比喻只求暂时应付，不作长久打算。","source":{"text":"移东就西，便为课续。取此适彼，遂号羡余。","book":"唐·陆贽《论裴延龄奸蠹书》"}},{"id":35130,"word":"移东补西","pinyin":"yí dōng bǔ xī","abbr":"ydbx","explanation":"用之方面的钱、物弥补那方面的亏空或不足。比喻只求暂时应付，不作长久打算。","source":{"text":"移东就西，便为课续。取此适彼，遂号羡余。","book":"唐·陆贽《论裴延龄奸蠹书》"},"example":{"text":"衣之破者，～，必整必洁。","book":"清·沈复《浮生六记·闲情记趣》"},"similar":["拆东补西"],"usage":"作谓语、定语；指暂时应付"},{"id":35131,"word":"移商换羽","pinyin":"yí shāng huàn yǔ","abbr":"yshy","explanation":"本指乐曲换调。“宫”、“商”、“羽”均为古代乐曲五音中之音调名。①比喻事情起了变化。②比喻随声附和。","source":{"text":"移商换羽。花底流莺语。唱彻秦娥君且住。肠断能消几许。","book":"宋·袁去华《清平乐（移商换羽）》词"},"example":{"text":"替那女子送暖偎寒，～，都是你这老贱人了。","book":"明·叶宪祖《团花凤》第二折"},"similar":["移宫换羽"],"usage":"作谓语；指改变方式"},{"id":35132,"word":"移国动众","pinyin":"yí guó dòng zhòng","abbr":"ygdz","explanation":"动摇国基及民心。","source":{"text":"若民有淫行邪性，树为淫辞，作为淫巧，以上谄君上，而下惑百姓，移国动众，以害民务者，其刑死流。","book":"《管子·五辅》"},"usage":"作谓语、定语；用于书面语"},{"id":35133,"word":"移天徙日","pinyin":"yí tiān xǐ rì","abbr":"ytxr","explanation":"比喻盗弄政权。同“移天易日”。","source":{"text":"往者元叉执政，移天徙日。","book":"《北史·广阳王深传》"},"similar":["移天易日"],"usage":"作谓语、定语；指篡权"},{"id":35134,"word":"移天换日","pinyin":"yí tiān huàn rì","abbr":"ythr","explanation":"改变天，更换日。比喻价目表使用欺骗手段篡夺政权。","source":{"text":"赵庶人听任孙秀移天易日。","book":"《晋书·齐王冏传》"},"example":{"text":"里头呢，亲近弄臣，～，外头呢，少年王公，颠波作浪，不晓得要闹成什么世界呢。","book":"清·曾朴《孽海花》第二十一回"},"similar":["移天易日"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":35135,"word":"移天易日","pinyin":"yí tiān yì rì","abbr":"ytyr","explanation":"易：更换。比喻野心家篡夺政权。","source":{"text":"赵庶人听任孙秀移天易日。","book":"《晋书·齐王冏传》"},"similar":["移天徙日"],"usage":"作谓语、定语；指篡权"},{"id":35136,"word":"移孝为忠","pinyin":"yí xiào wéi zhōng","abbr":"yxwz","explanation":"指把孝顺父母之心转为效忠君主。","source":{"text":"君子之事亲孝，故忠可移于君。","book":"语出《孝经·广扬名》"},"example":{"text":"《传》云：去食存信，信而有征。《经》云：～，孝则不匮。","book":"唐·张说《郑国夫人神道碑奉敕撰》"},"similar":["移孝作忠"],"usage":"作谓语、宾语；用于处事"},{"id":35137,"word":"移孝作忠","pinyin":"yí xiào zuò zhōng","abbr":"yxzz","explanation":"指把孝顺父母之心转为效忠君主。同“移孝为忠”。","source":{"text":"不错，封建社会曾把养父母这件事涂上一些神秘色彩。它是利用人类热爱父母——‘孝亲’的自然伦理，要人民‘移孝作忠’。","book":"谢觉哉《不惑集·爱父母》"},"similar":["移孝为忠"],"usage":"作谓语、宾语；用于处事"},{"id":35138,"word":"移宫换羽","pinyin":"yí dōng huàn yǔ","abbr":"yghy","explanation":"宫、羽：古代乐曲中的两种曲调名。原指乐曲换调。后也比喻事情的内容有所变更。","source":{"text":"知音见说无双，解移宫换羽，未怕周郎。","book":"宋·周邦彦《意难忘·美人》词"},"example":{"text":"～虽非巧，仿古依今教尔曹。","book":"元·柯丹丘《荆钗记·团圆》"},"similar":["移商换羽"],"usage":"作谓语；指改变方式"},{"id":35139,"word":"移宫易羽","pinyin":"yí gōng yì yǔ","abbr":"ygyy","explanation":"宫、羽：古代乐曲中的两种曲调名。原指乐曲换调。后也比喻事情的内容有所变更。","source":{"text":"知音见说无双，解移宫换羽，未怕周郎。","book":"宋·周邦彦《意难忘·美人》词"},"example":{"text":"馀香应未泯，凭君重唱金缕。～，纵有离愁休怨诉。","book":"宋·杨无咎《倒垂柳》词"}},{"id":35140,"word":"移山倒海","pinyin":"yí shān dǎo hǎi","abbr":"ysdh","explanation":"搬动大山，翻倒大海。比喻人类改造自然的巨大力量和雄伟气概。","source":{"text":"这大圣正算计耍掼，原来那怪就知道了，且会遣山，就使一个移山倒海的法术。","book":"明·吴承恩《西游记》第三十三回"},"example":{"text":"他有～之术。","book":"清·钱彩《说岳全传》第七十八回"},"similar":["天旋地转","排山倒海","天崩地裂"],"opposite":["和风细雨","温文尔雅"],"usage":"作谓语、定语、宾语；指改变自然"},{"id":35141,"word":"移山回海","pinyin":"yí shān huí hǎi","abbr":"yshh","explanation":"移动山岳，旋转大海。比喻竭尽全力，克服巨大困难。","source":{"text":"移山回海，招赘相公宅。多就了除名烟月牌。","book":"《南宫词纪·题情·琥珀猫儿坠》"},"usage":"作谓语、状语；用于书面语"},{"id":35142,"word":"移山填海","pinyin":"yí shān tián hǎi","abbr":"ysth","explanation":"移动山岳，填平大海。指仙术法力高超。现多比喻人类征服自然、改造自然的伟大力量和气魄。","source":{"text":"俺众仙各施神通，移山填海，水尽枯干，教你无处潜藏。","book":"明·无名氏《八仙过海》第二折"},"example":{"text":"最后浮士德因忧愁了盲了目，在盲目中想象到他所从事着的～的工作和在那新土地上人民安居乐业的乌托邦景象。","book":"郭沫若《努力把自己改造成为无产阶级的文化工人》"},"similar":["填海移山"],"usage":"作谓语、定语；用于书面语"},{"id":35143,"word":"移山拔海","pinyin":"yí shān bá hǎi","abbr":"ysbh","explanation":"移动大山，拔起大海。形容力量巨大。","source":{"text":"势力足以移山拔海，吹呼能令泥象登云。","book":"晋·葛洪《抱朴子·交际》"},"example":{"text":"让神话里的～的英雄在上空叹息？！","book":"郭小川《闪耀吧，青春的火光》诗"},"similar":["移山竭海"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":35144,"word":"移山竭海","pinyin":"yí shān jié hǎi","abbr":"ysjh","explanation":"移动山岳，使大海干竭。比喻力量巨大。","source":{"text":"力动乾坤，移山竭海。","book":"《云笈七签》卷二三"},"similar":["移山拔海"],"usage":"作谓语、宾语、定语；用于书面语"},{"id":35145,"word":"移山跨海","pinyin":"yí shān kuà hǎi","abbr":"yskh","explanation":"移动山岳，跨越大海。比喻力量巨大。","source":{"text":"《列子》有移山跨海之谈，《淮南》有倾天折地之说。","book":"南朝·梁·刘勰《文心雕龙·诸子》"},"usage":"作宾语、定语；用于书面语"},{"id":35146,"word":"移山造海","pinyin":"yí shān zào hǎi","abbr":"yszh","explanation":"移动山岳，造出大海。比喻人类征服自然的伟大力量和气魄。","source":{"text":"移山造海志掀天，千万人民涌向前。","book":"朱德《和何香凝主任〈农村〉原韵》之二"},"example":{"text":"那些～的人们，几万、几万在劳动着，最多的时候曾达十几万人。秦牧《花城·古董》"},"usage":"作谓语、定语、宾语；用于书面语"},{"id":35147,"word":"移形换步","pinyin":"yí xíng huàn bù","abbr":"yxhb","explanation":"犹移步换形。形容变化多端。","source":{"text":"八旬之内，势变多端，尽寸之间，移形换步。正所谓波澜独老成也。","book":"清·钱谦益《与方尔止书》"},"similar":["移步换形"],"usage":"作谓语、定语；用于书面语"},{"id":35148,"word":"移情遣意","pinyin":"yí qíng qiǎn yì","abbr":"yqqy","explanation":"变易情志，消遣烦闷。","source":{"text":"若夫词章一道，本无经济殊科，词章不妨放达，故虽极蜃楼海市，惝恍迷离，皆足以移情遣意。","book":"严复《救亡决论》"},"usage":"作谓语、宾语；用于书面语"},{"id":35149,"word":"移日卜夜","pinyin":"yí rì bǔ yè","abbr":"yrby","explanation":"指昼夜相继。","source":{"text":"清·钱谦益《黄埔及六十寿序》：“清歌妙舞，移日卜夜。”v"},"usage":"作宾语、定语；用于书面语"},{"id":35150,"word":"移易迁变","pinyin":"yí yì qiān biàn","abbr":"yyqb","explanation":"指迁移变化。","source":{"text":"意生分段之身，刹那移易迁变，人乌得而知之。","book":"明·张居正《答中溪李尊师论禅》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":35151,"word":"移星换斗","pinyin":"yí xīng huàn dǒu","abbr":"yxhd","explanation":"形容法术神妙或手段高超。","source":{"text":"缚怪擒魔称第一，移星换斗鬼神愁。","book":"明·叶宪祖《团花凤》第四折：“你道是移星换斗少人知，又谁知藏鹦隐鹭须见。”明·吴承恩《西游记》第六十七回"},"example":{"text":"不怕你有喜新厌旧的心肠，我自有～的手段。","book":"清·文康《儿女英雄传》第二十七回"},"usage":"作宾语、定语；用于书面语"},{"id":35152,"word":"移有足无","pinyin":"yí yǒu zú wú","abbr":"yyzw","explanation":"指用多余的部分弥补不足的部分。","source":{"text":"运动四国，权衡万货，平准其价，移有足无，然后天下之务举矣。","book":"宋·苏舜钦《上范公参政书·谘目三》"},"usage":"作谓语、定语；用于书面语"},{"id":35153,"word":"移根换叶","pinyin":"yí gēn huàn yè","abbr":"yghy","explanation":"比喻彻底变换处境。","source":{"text":"怎禁得栖惶。待与伊移根换叶，试又何妨。","book":"宋·苏轼《意难忘·妓馆》词"},"usage":"作谓语、宾语；指改变环境"},{"id":35154,"word":"移根接叶","pinyin":"yí gēn jiē yè","abbr":"ygjy","explanation":"喻指牵引媒介。","source":{"text":"小人做官媒呵，移根接叶，种就了多少并头莲。","book":"明·吴炳《情邮记·选艳》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":35155,"word":"移樽就教","pinyin":"yí zūn jiù jiào","abbr":"yzjj","explanation":"樽：古代盛酒器；就：凑近。端着酒杯离座到对方面前共饮，以便请教。比喻主动去向人请教。","source":{"text":"也罢，我们移樽就教罢。","book":"清·李汝珍《镜花缘》第二十一回"},"example":{"text":"因惦着晚饭是舅母、岳母～，给父母贺喜。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作谓语；指主动去向人请教"},{"id":35156,"word":"移步换形","pinyin":"yí bù huàn xíng","abbr":"ybhx","explanation":"移动脚步，情景也随之变换。形容景色变化多端。亦比喻逐步起着变化。","source":{"text":"大抵雁荡诸峰，巧通造化，移步换形。","book":"清·戴名世《雁荡记》"},"example":{"text":"心斋由吴返镇后，即以所得于卞汪者，薰陶徐龚，渐渐～。","book":"《扫迷帚》第二一回"},"similar":["移形换步"],"usage":"作谓语、定语；用于书面语"},{"id":35157,"word":"移气养体","pinyin":"yí qì yǎng tǐ","abbr":"yqyt","explanation":"改变气质和保养身体。","source":{"text":"孟子自范之齐，望见齐王之子，喟然叹曰：‘居移气，养移体。大哉居乎！’","book":"战国·邹·孟轲《孟子·尽心上》"},"example":{"text":"此人本与我契好，但目下～，大非昔比了。","book":"《雪岩外传》第五回"},"similar":["居移气，养移体"],"usage":"作谓语、定语；指改变气质和保养身体"},{"id":35158,"word":"移的就箭","pinyin":"yí dì jiù jiàn","abbr":"ydjj","explanation":"移动箭靶靠近箭。比喻曲意迁就。","source":{"text":"移的就箭，曲取相谐。","book":"唐·刘知幾《史通·书志》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":35159,"word":"移祸于人","pinyin":"yí huò yú rén","abbr":"yhyr","explanation":"把祸害转嫁到别人身上","source":{"text":"移祸于人，此井又是官井，真真的这个囚徒行事古怪！","book":"清·无名氏《刘公案》第21回"},"similar":["嫁祸于人"],"usage":"作谓语、宾语、定语；指转嫁给别人"},{"id":35160,"word":"移祸枯桑","pinyin":"yí huò kū sāng","abbr":"yhks","explanation":"比喻甲方直接受害，乙方也不免受到牵连。"},{"id":35161,"word":"移缓就急","pinyin":"yí huǎn jiù jí","abbr":"yhjj","explanation":"放开缓办的事，去做急于要办的事。","source":{"text":"略分先后，以为移缓就急之谋，则川事尚可为也。","book":"中国近代史资料丛刊《辛亥革命·保路运动·四川铁路案档案》"},"usage":"作谓语、定语；用于处事"},{"id":35162,"word":"移编绝简","pinyin":"yí biān jué jiǎn","abbr":"ybjj","explanation":"古人留下的文字。","source":{"text":"西游上国，谒见当代名公，错综其事，移编绝简，往往遇之。","book":"唐·怀素《自叙》"}},{"id":35163,"word":"移船就岸","pinyin":"yí chuán jiù àn","abbr":"ycja","explanation":"就：凑近，靠近。改变原来主张，乘势凑上去办成某事。也比喻不招自来。","source":{"text":"那薛蝌若有悔心，自然移船就岸。","book":"清·曹雪芹《红楼梦》第九十一回"},"example":{"text":"清·李宝嘉《官场现形记》第50回：“只要说得领事害怕，仍可望～。”"},"similar":["引船就岸"],"usage":"作谓语、宾语、定语；比喻就范"},{"id":35164,"word":"移船就泊","pinyin":"yí chuán jiù bó","abbr":"ycjp","explanation":"就：凑近，靠近。改变原来主张，乘势凑上去办成某事。也比喻不招自来。","source":{"text":"那薛蝌若有悔心，自然移船就岸。","book":"清·曹雪芹《红楼梦》第九十一回"}},{"id":35165,"word":"移花换柳","pinyin":"yí huā huàn liǔ","abbr":"yhhl","explanation":"把一种花木的枝条或嫩芽嫁接在另一种花木上。比喻暗中用手段更换人或事物来欺骗别人。","source":{"text":"同窗友认假作真，女秀才移花接木。","book":"明·凌濛初《二刻拍案惊奇》卷十七"}},{"id":35166,"word":"移花接木","pinyin":"yí huā jiē mù","abbr":"yhjm","explanation":"把一种花木的枝条或嫩芽嫁接在另一种花木上。比喻暗中用手段更换人或事物来欺骗别人。","source":{"text":"同窗友认假作真，女秀才移花接木。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"example":{"text":"不过中国的有一些士大夫，总爱无中生有，～的造出故事来，他们不但歌颂升平，还粉饰黑暗。","book":"鲁迅《且介亭杂文·病后杂谈》"},"similar":["移天换日","移宫换羽","偷梁换柱"],"opposite":["按部就班"],"usage":"作谓语、定语；指偷换手段","story":["从前有个花匠辛苦一年赚不到什么钱，一天他突发奇想，他把两种普通花的枝条嫁接起来培育出一种漂亮的花，卖了一个好的价钱。因此赚了不少钱。他高兴得在外边拼命喝酒，别人趁他醉酒从他口中探出他移花接木的秘密。第二年就卖不出好价钱了"]},{"id":35167,"word":"移风崇教","pinyin":"yí fēng chóng jiào","abbr":"yfcj","explanation":"移转风气，崇尚教化。","source":{"text":"移风崇教，生而不杀，布惠施恩，仁不偏与。","book":"《韩诗外传》卷八"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":35168,"word":"移风平俗","pinyin":"yí fēng píng sú","abbr":"yfps","explanation":"转变风气，改变习俗。","source":{"text":"凡音乐通乎政，而移风平俗者也。","book":"《吕氏春秋·侈乐》"},"similar":["移风革俗","移风振俗","移风易俗"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":35169,"word":"移风振俗","pinyin":"yí fēng zhèn sú","abbr":"yfzs","explanation":"改变风气，振兴习俗。","source":{"text":"以去就之官，临苟且之民，欲移风振俗，乌可得乎？","book":"《新唐书·刘祥道传》"},"similar":["移风易尚","移风易俗","移风改俗"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":35170,"word":"移风改俗","pinyin":"yí fēng gǎi sú","abbr":"yfgs","explanation":"改变旧的风俗习惯。同“移风易俗”。","source":{"text":"移风改俗，致和乐之极。","book":"《宋书·乐志一》"},"example":{"text":"公闲邪纳正，～。","book":"《南史·宋纪上·武帝》"},"similar":["移风革俗","移风易俗","移风易尚"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":35171,"word":"移风易俗","pinyin":"yí fēng yì sú","abbr":"yfys","explanation":"移：改变；易：变换。改变旧的风俗习惯。","source":{"text":"乐者，圣人之所乐也，而可以善民心，其感人深，其移风易俗，故先王导之以礼乐而民和睦。","book":"《荀子·乐论》"},"example":{"text":"我们要～，形成讲科学的好风气。"},"similar":["推陈出新","破旧立新"],"opposite":["因循守旧","一成不变","墨守成规"],"usage":"作谓语、定语、宾语；指改变风俗等","story":["西汉初年，社会秩序很不安定，虽然国力得到一定的恢复，但社会风气没有大的改观。贾谊看到这个问题深为忧虑，就上书汉文帝：虽然政权已经改变，但社会遗风余俗依然存在，而移风易俗、使人心趋向正道的使命不能推卸，不能只用文书往来应付"]},{"id":35172,"word":"移风易尚","pinyin":"yí fēng yì shàng","abbr":"yfys","explanation":"改变旧的风俗习惯。同“移风易俗”。","source":{"text":"移风易尚之机，实肇于此。","book":"明·刘基《〈苏平仲文集〉序》"},"similar":["移风振俗","移风易俗","移风改俗"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":35173,"word":"移风革俗","pinyin":"yí fēng gé sú","abbr":"yfgs","explanation":"改变旧的风俗习惯。同“移风易俗”。","source":{"text":"移风革俗，天保载定。","book":"《魏书·高闾传》"},"example":{"text":"故威行于下则坏法犯贵之风移矣，礼适其中则破产伤生之俗革矣，～其在兹乎！","book":"唐·白居易《策林四·禁厚葬》"},"similar":["移风改俗","移风易俗","移风易尚"],"usage":"作谓语、定语、宾语；指改变风俗等"},{"id":35174,"word":"秽德垢行","pinyin":"huì dé gòu xíng","abbr":"hdgx","explanation":"指自污浊其德行以避祸患。","source":{"text":"中材解体，销声灭影，秽德垢行，以避此名。","book":"宋·叶适《辩兵部郎官朱元晦状》"},"usage":"作宾语；指不好的德行"},{"id":35175,"word":"秽德彰闻","pinyin":"huì dé zhāng wén","abbr":"hdzw","explanation":"秽德：丑恶的品质和行为；彰：明显。丑恶的品质和行为已经为人所共知。","source":{"text":"无辜吁天，秽德彰闻。","book":"《尚书·泰誓中》"},"example":{"text":"这等的～，焉得不人皆掩鼻。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作宾语、定语；用于书面语"},{"id":35176,"word":"秽言污语","pinyin":"huì yán wū yǔ","abbr":"hywy","explanation":"指粗俗下流、不堪入耳的话。","source":{"text":"莫学愚妇，不问根源，秽言污语，触突尊贤。","book":"唐·宋若华、宋若昭《女语论·和柔章》"},"example":{"text":"（明月、清风）指着唐僧，秃前秃后，～，不绝口的乱骂。","book":"明·吴承恩《西游记》第二十四回"},"similar":["污言秽语"],"usage":"作宾语、定语；指下流话"},{"id":35177,"word":"秽语污言","pinyin":"huì yǔ wū yán","abbr":"hywy","explanation":"秽：污浊，肮脏。指粗俗下流、不堪入耳的话。","source":{"text":"指着唐僧，秃前秃后，秽语污言，不绝口的乱骂。","book":"明·吴承恩《西游记》第24回"},"example":{"text":"～影响社会精神文明建设。"},"similar":["污言秽语"],"usage":"作主语、宾语、定语；指下流话"},{"id":35178,"word":"稀世之宝","pinyin":"xī shì zhī bǎo","abbr":"xszb","explanation":"稀世：世所稀有。世上稀有的珍宝。","source":{"text":"当时卿相及好事者，得居寀父子图障卷簇，家藏户宝，为稀世之珍。","book":"宋·黄休复《益州名画录》"},"example":{"text":"难道你不希望我们中国人的艺术品在外国人眼里被看作～吗？","book":"何力力《落日夏威夷》"},"similar":["无价之宝","价值连城"],"opposite":["鸡毛蒜皮"],"usage":"作宾语；指稀罕的东西"},{"id":35179,"word":"稀世之珍","pinyin":"xī shì zhī zhēn","abbr":"xszz","explanation":"世间罕见的珍宝。比喻极宝贵的东西。","source":{"text":"当时卿相及好事者，得居寀图障卷簇，家藏户宝，为稀世之珍。","book":"宋·黄休复《益州名画录》"},"example":{"text":"清·无垢道人《八仙全传》第19回：“见那丸色如金黄，润若渥丹，小如芥子，重逾铜钱，端的～。”"},"similar":["希世之珍"],"usage":"作宾语；指稀罕的东西"},{"id":35180,"word":"稀句绘章","pinyin":"xī jù huì zhāng","abbr":"xjhz","explanation":"绘：雕绘。雕饰文章字句，使之增加文采。","source":{"text":"高祖、太宗大难始夷，沿江左余风，稀句绘章，揣合低印，故王、杨为之伯。","book":"《新唐书·文艺传·序》"},"similar":["稀章绘句"],"usage":"作宾语、定语；用于书面语"},{"id":35181,"word":"稀奇古怪","pinyin":"xī qí gǔ guài","abbr":"xqgg","explanation":"指很少见，很奇异，不同一般。","source":{"text":"稀奇古怪，我法我派。一钱不值，万钱不卖。","book":"清邵梅臣《画耕偶录》"},"example":{"text":"老残道：“这也罢了，只是你赶紧说你那～的案情罢。”","book":"《老残游记》第十三回"},"similar":["离奇古怪"],"opposite":["平淡无奇"],"usage":"作谓语、定语；指奇特的东西"},{"id":35182,"word":"稀汤寡水","pinyin":"xī tāng guǎ shuǐ","abbr":"xtgs","explanation":"形容粥稀或汤里油水少。","example":{"text":"我们过的是～的日子。"},"similar":["清汤寡水"],"opposite":["山珍海味"],"usage":"作宾语、定语；指生活清苦"},{"id":35183,"word":"稀稀拉拉","pinyin":"xī xī lā lā","abbr":"xxll","explanation":"稀少疏落，形容对自己要求不严，随随便便。","source":{"text":"他在人迹稀稀拉拉的石圪节街上毫无目的地溜达着。","book":"路遥《平凡的世界》第一卷第23章"},"example":{"text":"他的头上只有～的头发。"},"similar":["稀稀落落"],"opposite":["密密麻麻"],"usage":"作谓语、定语；指不认真"},{"id":35184,"word":"稀稀烂烂","pinyin":"xī xī làn làn","abbr":"xxll","explanation":"破碎到极点。","example":{"text":"我把碟子摔得～。"},"usage":"作定语、状语；用于口语"},{"id":35185,"word":"稀稀落落","pinyin":"xī xī luò luò","abbr":"xxll","explanation":"稀疏冷落的样子。","source":{"text":"一片白茫茫不辨人影，只有几个巡捕稀稀落落的在街上站着。","book":"曾朴《孽海花》第16回"},"example":{"text":"不大一会儿功夫，饭场上就～的没有几个人了。","book":"路遥《平凡的世界》第一卷第一章"},"similar":["稀稀拉拉"],"usage":"作定语、状语；用于口语"},{"id":35186,"word":"稀章绘句","pinyin":"xī zhāng huì jù","abbr":"xzhj","explanation":"绘：雕绘。雕饰文章字句，使之增加文采。","example":{"text":"～的文章不一定出色。"},"similar":["稀句绘章"],"usage":"作宾语、定语；用于写作"},{"id":35187,"word":"稀里哗啦","pinyin":"xī lǐ huā lā","abbr":"xlhl","explanation":"象声词，形容雨、东西倒塌等发出的声音。形容被彻底破坏或零零散散。","source":{"text":"三更时候，又赶上大风大雨，只听得稀里哗啦，那黄河水就像山一样的倒下去了。","book":"清·刘鹗《老残游记》第13回"},"example":{"text":"大雨～地泼下来。"},"similar":["稀溜哗啦","稀哩哗啦"],"usage":"作定语、状语；用于口语"},{"id":35188,"word":"稀里糊涂","pinyin":"xī lǐ hú tú","abbr":"xlht","explanation":"不明白，迷糊，不认真，随意。","source":{"text":"我稀里糊涂地回答说她家里有事来了个亲戚。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"他～地接受她的请求。"},"similar":["糊里糊涂"],"opposite":["明明白白"],"usage":"作谓语、状语；用于口语"},{"id":35189,"word":"稀里马虎","pinyin":"xī lǐ mǎ hū","abbr":"xlmh","explanation":"不认真，马马虎虎。","example":{"text":"我们不能～地过日子。"},"similar":["稀里糊涂","马马虎虎","稀里马哈"],"opposite":["认认真真"],"usage":"作谓语、定语、状语；指粗心大意"},{"id":35190,"word":"稂不稂莠不莠","pinyin":"láng bù láng yǒu bù yǒu","abbr":"lblyby","explanation":"既不象稂，也不象莠。比喻不成材，没出息。","source":{"text":"人生世上，难得的是这碗现成饭，只管‘稂不稂莠不莠’的到几时。","book":"清·吴敬梓《儒林外史》第二回"},"example":{"text":"他一辈子就这样～的。"},"usage":"作谓语、分句、定语；指没出息"},{"id":35191,"word":"稂莠不齐","pinyin":"láng yǒu bù qí","abbr":"lybq","explanation":"有好人也有坏人，好的坏的混在一起。","example":{"text":"这班学生因为～，所以管教不易。"}},{"id":35192,"word":"稇载而归","pinyin":"kǔn zài ér guī","abbr":"kzeg","explanation":"稇载：满载；归：返回。东西装得满满地回来。形容收获极丰富。","source":{"text":"诸侯之使垂橐而入，稇载而归。","book":"春秋·鲁·左丘明《国语·齐语》"},"similar":["满载而归","捆载而归"],"usage":"作谓语、定语；指收获大"},{"id":35193,"word":"程门度雪","pinyin":"chéng mén dù xuě","abbr":"cmdx","explanation":"程：宋代理学家程颐。比喻尊师重教。","source":{"text":"一架绳床共众同，坐虚使院仰清风。独惭三十无能立，难向程门度雪中。","book":"清·金埴《不下带编》第一卷"},"similar":["程门立雪"],"usage":"作宾语、定语；比喻尊师重教"},{"id":35194,"word":"程门立雪","pinyin":"chéng mén lì xuě","abbr":"cmlx","explanation":"旧指学生恭敬受教。比喻尊师。","source":{"text":"一日见颐，颐偶瞑坐，时与游酢侍立不去。颐既觉，则门外雪深一尺矣。","book":"《宋史·道学传二·杨时》"},"example":{"text":"～的故事提醒我们要尊师重教。"},"similar":["尊师重教","程门度雪"],"usage":"作宾语、定语；比喻尊师重教","story":["北宋时期著名哲学家杨时，淡薄名利，放弃做官的机会，拜著名的理学大师程顥与程颐兄弟为师学习理学，学成后回南方讲学。程顥病故后，杨时去拜访程颐，见程颐正在休息，便恭恭敬敬站在院外的雪地里等恩师的醒来"]},{"id":35195,"word":"程门飞雪","pinyin":"chéng mén fēi xuě","abbr":"cmfx","explanation":"程：宋代理学家程颐。比喻尊师重教。","source":{"text":"程门飞雪，贻误多时。","book":"鲁迅《书信集·致许广平》"},"example":{"text":"尊师重教并不一定要效仿～。"},"similar":["程门立雪"],"usage":"作宾语、定语；比喻尊师重教"},{"id":35196,"word":"稍关打节","pinyin":"shāo guān dǎ jié","abbr":"sgdj","explanation":"指暗中贿赂，拉关系，说人情。也称通关节。","source":{"text":"俺则待稍关打节，怕有那惯施舍的经商不请言馀。","book":"元·关汉卿《望江亭》第三折"},"similar":["捎关打节"],"usage":"作谓语、宾语、定语；指耍手段"},{"id":35197,"word":"稍安毋躁","pinyin":"shāo ān wú zào","abbr":"sawz","explanation":"暂且耐心等待一下，不要急躁。","source":{"text":"曾皓（带着那种稍安毋躁的神色）：不，不，你让她自己考虑。","book":"曹禺《北京人》第一幕"},"example":{"text":"请～，不要冲动。"},"similar":["少安毋躁"],"usage":"作谓语、定语；用于劝诫人"},{"id":35198,"word":"稍纵则逝","pinyin":"shāo zòng zé shì","abbr":"szzs","explanation":"纵：放松；逝：失去。稍微一放松就消失了。形容时间或机会等很容易过去。","source":{"text":"当其触物兴怀情来神会，机栝跃如，如兔起鹘落，稍纵则逝矣。","book":"清·郎廷槐《师友诗传录》"},"similar":["稍纵即逝"],"usage":"作谓语、定语；用于时间或时机"},{"id":35199,"word":"稍纵即逝","pinyin":"shāo zòng jí shì","abbr":"szjs","explanation":"纵：放；逝：消失。稍微一放松就消失了。形容时间或机会等很容易过去。","source":{"text":"振笔直遂，以追其所见，如兔起鹘落，少纵则逝矣。","book":"宋·苏轼《文与可画画云当谷偃竹记》"},"example":{"text":"事机万变，～。","book":"蔡东藩、许廑父《民国通俗演义》第三十四回"},"similar":["光阴似箭","昙花一现","稍纵则逝"],"opposite":["旷日持久","遥遥无期"],"usage":"作谓语、定语；用于时间或时机"},{"id":35200,"word":"稍胜一筹","pinyin":"shāo shèng yī chóu","abbr":"ssyc","explanation":"筹：筹码，古代用以计数的工具，多用竹子制成。比较起来，稍微好一些。","source":{"text":"小生所以忝出君上者，以起处数语，略高一筹耳。","book":"清·蒲松龄《聊斋志异·辛十四娘》"},"example":{"text":"废物利用又何尝不是“消磨生命”之术，但也许比“纵酒”～罢。","book":"鲁迅《两地书》二五"},"similar":["略胜一筹"],"opposite":["稍逊一筹"],"usage":"作谓语；指稍微好一些"},{"id":35201,"word":"稍逊一筹","pinyin":"shāo xùn yī chóu","abbr":"sxyc","explanation":"稍：稍微；逊：逊色。比较起来，稍微差一点。","source":{"text":"才锋笔藻可继还魂，其稍逊一筹者，则在气与力之间耳。","book":"清·李渔《闲情偶寄·演习·脱套》"},"example":{"text":"而后起的模拟者总不免比创始者要～。","book":"范文澜《中国通史》第三编第七章第五节"},"similar":["略逊一筹"],"opposite":["稍胜一筹","略胜一筹"],"usage":"作谓语、定语；指稍微差一点"},{"id":35202,"word":"稔恶不悛","pinyin":"rěn è bù quān","abbr":"rebq","explanation":"长期作恶而不悔改。","source":{"text":"苟能去逆效顺，悉从厚宥；或稔恶不悛，城一破，悔无及矣。","book":"明·宋濂《胡公神道碑铭》"},"example":{"text":"按诸公皆一时名硕，用之多不尽其材，而～如汪鋐者，乃持权久任如此。","book":"明·沈德符《野获编·吏部一·屡兼二品正卿》"},"usage":"作谓语、定语；用于为人等"},{"id":35203,"word":"稔恶盈贯","pinyin":"rěn è yíng guàn","abbr":"reyg","explanation":"指所积罪恶之多，达于极点。","source":{"text":"我中华亦有流寇之难，讨伐不时，将帅亟易，遂得使虏穷凶极恶，肆其驰突，外劫朝鲜，内围京邑，稔恶盈贯，亦陨其命。","book":"章炳麟《讨满洲檄》"},"usage":"作谓语、定语；用于书面语"},{"id":35204,"word":"稔恶藏奸","pinyin":"rěn è cáng jiān","abbr":"recj","explanation":"长期作恶，包藏祸心。","source":{"text":"丙申，上以准噶尔噶尔丹策零稔恶藏奸，终为边患，命傅尔丹为靖边大将军……征讨准噶尔。","book":"《清史稿·世宗纪》"},"usage":"作谓语、定语；用于书面语"},{"id":35205,"word":"稗官小说","pinyin":"bài guān xiǎo shuō","abbr":"bgxs","explanation":"即野史小说，街谈巷说之言。","source":{"text":"盖自诸史百家星官堪舆道书释经，下至稗官小说，皆能陟其津涯而发之诗歌。","book":"明·唐顺之《仪宾立公墓志铭》"},"example":{"text":"又好为～而懒于著书。","book":"清·江藩《汉学师承记·纪昀》"},"similar":["稗官野史"],"opposite":["官修正史"],"usage":"作主语、宾语、定语；旧时小说、杂史的统称"},{"id":35206,"word":"稗官野史","pinyin":"bài guān yě shǐ","abbr":"bgys","explanation":"稗官：古代的一种小官，专给帝王搜集街谈巷语，道听途说，以供省览，后称小说或小说家为稗官。指旧时的小说和私人编撰的史书。","source":{"text":"小说家者流，盖出于稗官，街谈巷语，道听途说者之所造也。","book":"《汉书·艺文志》"},"example":{"text":"如今我要将这碑记付给文人墨士，做为～，流传海内。","book":"清·李汝珍《镜花缘》第七十回"},"similar":["稗官小说","奇文轶事"],"opposite":["官修正史"],"usage":"作主语、宾语、定语；旧时小说、杂史的统称"},{"id":35207,"word":"稗耳贩目","pinyin":"bài ěr fàn mù","abbr":"befm","explanation":"比喻见闻浅薄的人。","source":{"text":"此可见诸儒师资有自，非同后世稗耳贩目之学也。","book":"清·赵翼《廿二史札记·北朝经学》"},"usage":"作宾语、定语；指商贩等"},{"id":35208,"word":"稚齿婑媠","pinyin":"zhì chǐ wǒ tuǒ","abbr":"zcwt","explanation":"稚齿：年少；婑媠：美好的样子。指年轻的美女。","source":{"text":"穆之后庭，比房数十，皆择稚齿婑媠者以盈之。","book":"《列子·杨朱》"},"usage":"作宾语、定语；指年轻的美女"},{"id":35209,"word":"稠人广众","pinyin":"chóu rén guǎng zhòng","abbr":"crgz","explanation":"稠：多而密。指人很多的场合。","source":{"text":"稠人广众，荐宠下辈。","book":"《史记·很其武安侯列传》"},"example":{"text":"大家听了他，都说他是个痴子，这些话岂可在～的地方说的。","book":"清·李宝嘉《官场现形记》第三十五回"},"similar":["大庭广众"],"opposite":["荒无人烟","人烟稀少"],"usage":"作定语、宾语；指人群众多"},{"id":35210,"word":"稠人广坐","pinyin":"chóu rén guǎng zuò","abbr":"crgz","explanation":"坐：同“座”。指人很多的地方，即公共场合。","source":{"text":"见有闭门读书，师心自是，稠人广坐，谬误差失者多矣。","book":"北齐·颜之推《颜氏家训·勉学》"},"example":{"text":"如玄德在～，关张侍立，终日不倦。","book":"明·罗贯中《三国演义》第二回"},"similar":["大庭广众","高朋满座"],"opposite":["荒无人烟"],"usage":"作定语；指人多的地方"},{"id":35211,"word":"稠人广座","pinyin":"chóu rén guǎng zuò","abbr":"crgz","explanation":"指人很多的场合。","source":{"text":"稠人广众，荐宠下辈。","book":"《史记·很其武安侯列传》"}},{"id":35212,"word":"稠迭连绵","pinyin":"chóu dié lián mián","abbr":"cdlm","explanation":"稠迭：稠密而重迭。形容山岭稠密重迭相连。","source":{"text":"岩峭岭稠迭，洲萦诸连绵。","book":"南朝·宋·谢灵运《过始宁墅》"}},{"id":35213,"word":"稳吃三注","pinyin":"wén chī sān zhù","abbr":"wcsz","explanation":"四人赌博，一个人赢三个人的赌注。比喻凭空的大量收获。","source":{"text":"他们辛苦收拾，是该剩些钱粘补的；我们怎么好‘稳吃三注’呢？","book":"清·曹雪芹《红楼梦》第56回"},"usage":"作谓语；比喻凭空的大量收获"},{"id":35214,"word":"稳坐钓鱼台","pinyin":"wěn zuò diào yú tái","abbr":"wzdyt","explanation":"不管外界有何变化，只照老规矩办事。非常镇静，沉得住气，稳居于自己的位置上。","source":{"text":"人家呢，稳坐钓鱼台，对住你察颜观色。","book":"康濯《牲畜专家》"},"example":{"text":"他任凭风浪起，～。"},"similar":["任凭风浪起，稳坐钓鱼台"],"usage":"作谓语；指能沉得住气"},{"id":35215,"word":"稳坐钓鱼船","pinyin":"wěn zuò diào yú chuán","abbr":"wzdyc","explanation":"比喻不管发生什么变化，仍然沉着镇静。","source":{"text":"就可以任凭风浪起，稳坐钓鱼船。","book":"毛泽东《在中国共产党第八届中央委员会第二次会议上的讲话》"},"example":{"text":"任凭风浪起，～。","book":"俗话说"},"similar":["稳坐钓鱼台"],"usage":"作谓语；指能沉得住气"},{"id":35216,"word":"稳如泰山","pinyin":"wěn rú tài shān","abbr":"wrts","explanation":"形容象泰山一样稳固，不可动摇。","source":{"text":"变所欲为，易于反掌，安于泰山。","book":"汉·枚乘《上书谏吴王》"},"example":{"text":"武后恃有高关，又仗武氏弟兄骁勇，自谓～，十分得意。","book":"清·李汝珍《镜花缘》第三回"},"similar":["坚如磐石","纹丝不动"],"opposite":["摇摇欲坠","惊慌失措"],"usage":"作谓语、状语；指不可动摇"},{"id":35217,"word":"稳如磐石","pinyin":"wěn rú pán shí","abbr":"wrps","explanation":"形容像磐石一样稳固，不可动摇。","source":{"text":"周智道：‘忒稳，稳如磐石。’","book":"明·伏雌教主《醋葫芦》第五回"},"similar":["稳如泰山"],"usage":"作谓语、状语；指不可动摇"},{"id":35218,"word":"稳扎稳打","pinyin":"wěn zhā wěn dǎ","abbr":"wzwd","explanation":"扎：安营。稳当而有把握地打击敌人。比喻有把握、有步骤地工作。","source":{"text":"现在郑军既已到齐，仍须稳扎稳打，不可轻进求速。","book":"清·刘坤一《书牍七·复王雨庵》"},"example":{"text":"我们的方针是～，不求速效。","book":"毛泽东《关于情况的通报》"},"similar":["步步为营"],"opposite":["轻举妄动"],"usage":"作谓语、定语、状语；指战术"},{"id":35219,"word":"稳拿把纂","pinyin":"wěn ná bǎ zuǎn","abbr":"wnbz","explanation":"稳：有把握。指确有十分把握。","example":{"text":"这事已经～了，你不必担心。"},"similar":["十拿九稳"],"usage":"作谓语、定语、宾语；多用于口语"},{"id":35220,"word":"稳操左券","pinyin":"wén cāo zuǒ quàn","abbr":"wczq","explanation":"左券：古代契约分左右两联，双方挌执一联，左券就是左联，常用作索偿的凭证。比喻有充分的把握。","source":{"text":"公常执左券以责于秦韩。","book":"《史记·田敬仲完世家》"},"similar":["稳操胜算"],"usage":"作谓语、宾语、定语；形容有十分的把握"},{"id":35221,"word":"稳操胜券","pinyin":"wén cāo shèng quàn","abbr":"wcsq","explanation":"稳：有把握；操：掌握；胜券：能够制胜的计谋。指有把握取得胜利。","source":{"text":"且虞卿操其两权，事成，操右券以责。","book":"西汉·司马迁《史记·平原君传》"},"example":{"text":"我没想到自己觉得～的求爱，竟得到如此的回答。","book":"《收获》1981年第4期"},"similar":["万无一失","十拿九稳"],"opposite":["一筹莫展","心中无数"],"usage":"作谓语、宾语、定语；形容有十分的把握"},{"id":35222,"word":"稳操胜算","pinyin":"wén cāo shèng suàn","abbr":"wcss","explanation":"稳：有把握；操：掌握；胜算：能够制胜的计谋。指有把握取得胜利。","source":{"text":"故明操必胜之数，以治必用之民。","book":"《管子·明法解》"},"example":{"text":"已逸待劳，以众御寡，可以～。","book":"姚雪垠《李自成》第二卷第二十六章"},"similar":["稳操胜券"],"opposite":["一筹莫展"],"usage":"作谓语、宾语、定语；形容有十分的把握"},{"id":35223,"word":"稳步前进","pinyin":"wén bù qián jìn","abbr":"wbqj","explanation":"稳当可靠。","source":{"text":"现在她又在你们身边，你们就稳稳妥妥给她找个人家。","book":"路遥《平凡的世界》第一卷第21章"},"example":{"text":"路遥《平凡的世界》第一卷第21章：“现在她又在你们身边，你们就～给她找个人家。”"},"similar":["稳稳当当"],"usage":"作定语、状语；用于处事"},{"id":35224,"word":"稳稳当当","pinyin":"wěn wěn dāng dāng","abbr":"wwdd","explanation":"牢靠妥当。","source":{"text":"对于我们这样发展中的大国来说，经济要发展得快一点，不可能总是那么平平静静、稳稳当当。","book":"邓小平《在武昌、深圳、珠海、上海等地的谈话要点》"},"example":{"text":"我们希望～地过日子。"},"similar":["平平稳稳","四平八稳"],"opposite":["动荡不安"],"usage":"作谓语、宾语、定语；指十分平稳"},{"id":35225,"word":"稳稳静静","pinyin":"wěn wěn jìng jìng","abbr":"wwjj","explanation":"沉稳镇静。","example":{"text":"他那～的处事作风值得我们学习。"},"usage":"作谓语、定语、状语；用于处事"},{"id":35226,"word":"稳若泰山","pinyin":"wěn ruò tài shān","abbr":"wrts","explanation":"形容象泰山一样稳固，不可动摇。","source":{"text":"变所欲为，易于反掌，安于泰山。","book":"汉·焦延寿《易林》卷一：“安如泰山，福喜屡臻。”汉·枚乘《上书谏吴王》"},"example":{"text":"而午门外站立着六只高大的驯象，由彩衣象奴牵引，每一阙门两只，相向守门，纹丝不动，～。","book":"姚雪垠《李自成》第四卷第二十三章"}},{"id":35227,"word":"稷蜂社鼠","pinyin":"jì fēng shè shǔ","abbr":"jfss","explanation":"稷：五谷之神；社：土地庙。谷神庙里的马蜂，土地庙里的老鼠。比喻倚势作恶的人。","source":{"text":"稷蜂不攻而社鼠不熏，非以稷蜂社鼠之神，其所托者善。","book":"汉·韩婴《韩诗外传》卷八"},"similar":["城狐社鼠"],"usage":"作主语、宾语；比喻倚势作恶的人"},{"id":35228,"word":"稻粱谋","pinyin":"dào liáng móu","abbr":"dlm","explanation":"谋：谋求。禽鸟寻找食物。比喻人谋求衣食。","source":{"text":"君看随阳雁，各有稻粱谋。","book":"唐·杜甫《同诸公登慈恩寺塔》诗"},"example":{"text":"避席畏闻文字狱，著书都为～。","book":"清·龚自珍《咏史》诗"},"usage":"作宾语；指谋生"},{"id":35229,"word":"稼穑艰难","pinyin":"jià sè jiān nán","abbr":"jsjn","explanation":"稼穑：播种和收获。指农事劳苦。","source":{"text":"先知稼穑之艰难，乃逸。","book":"《尚书·无逸》"},"example":{"text":"自以为上等之人，习成一身轻薄，～，全然不知。","book":"明·冯梦龙《醒世恒言》卷十七"},"usage":"作宾语；指农事劳苦"},{"id":35230,"word":"稽古振今","pinyin":"jī gǔ zhèn jīn","abbr":"jgzj","explanation":"指考查古事作为借鉴，以振兴现代。","source":{"text":"稽古振今，士风一奋。","book":"清谭嗣同《报贝元微书》"},"usage":"作宾语、定语；用于处事"},{"id":35231,"word":"稽古揆今","pinyin":"jī gǔ zhèn jīn","abbr":"jgkj","explanation":"指考古衡今。","source":{"text":"望稽古揆今，复君之位，以安天下。","book":"宋罗大经《鹤林玉露》卷十五"},"similar":["考古衡今"],"usage":"作谓语、宾语、定语；用于处事"},{"id":35232,"word":"稽疑送难","pinyin":"jī yí sòng nán","abbr":"jysn","explanation":"指考察疑端，排除难点。","source":{"text":"听断之暇，进其子弟之秀美者，稽疑送难，亹亹而启迪之。","book":"清张三光《蒋石原先生传》"},"usage":"作谓语；指学问及问题等"},{"id":35233,"word":"稽颡膜拜","pinyin":"qǐ sǎng mó bài","abbr":"jsmb","explanation":"稽颡：古代一种跪拜礼，屈膝下拜，以额触地，表示极度的虔诚。古代行稽颡礼后举手加额，长跪而拜，表示极度恭敬。","example":{"text":"汉奸对鬼子～以换取荣华富贵，实在可耻。"},"similar":["顶礼膜拜"],"usage":"作谓语、定语；用于处事"},{"id":35234,"word":"稽首再拜","pinyin":"qǐ shǒu zài bài","abbr":"qszb","explanation":"稽首：以头叩地面；再拜：拜两次。","source":{"text":"于卒也，摽使者出诸大门之外，北面稽首再拜而不受。","book":"《孟子·万章下》"},"example":{"text":"～之，自愧非仙才。","book":"唐·李白《游泰山六首》其一"}},{"id":35235,"word":"穆如清风","pinyin":"mù rú qīng fēng","abbr":"mrqf","explanation":"指和美如清风化养万物。","source":{"text":"吉甫作诵，穆如清风。","book":"《诗经·大雅·烝民》"},"example":{"text":"化先仁惠，不严之治，～。","book":"南朝·梁·裴子野《丹阳尹湘东王善政碑》"},"usage":"作谓语；指和美如清风化养万物"},{"id":35236,"word":"穰穰满家","pinyin":"ráng ráng mǎn jiā","abbr":"rrmj","explanation":"穰穰：丰盛。形容获得丰收，粮食满仓。","source":{"text":"瓯窭满篝，污邪满车，五谷蕃熟，穰穰满家。","book":"《史记·滑稽列传》"},"example":{"text":"钟鼎校铭，珪琮著考。秦权汉日，～。","book":"严复《救亡决论》"},"usage":"作谓语、定语；指粮食满仓"},{"id":35237,"word":"穴处之徒","pinyin":"xué chǔ zhī tú","abbr":"xczt","explanation":"比喻见识浅陋的人。","source":{"text":"而王之将吏，群居穴处之徒。","book":"《后汉书·隗嚣传》"},"example":{"text":"群居～，人人抵掌，欲为不善之计。","book":"蔡东藩《后汉演义》第十八回"},"usage":"作宾语；用于比喻句"},{"id":35238,"word":"穴处知雨","pinyin":"xué chǔ zhī yǔ","abbr":"xczy","explanation":"兽类久居洞中，习性所积而能预知风雨。比喻有所经验。","source":{"text":"知日蚀地震之效昭然可明，犹巢居知风，穴处知雨。","book":"《汉书·翼奉传》"},"usage":"作宾语、定语；用于书面语"},{"id":35239,"word":"穴处野居","pinyin":"xué chǔ yě jū","abbr":"xcyj","explanation":"穴：洞；处：居住。居住在洞里生活在荒野。形容原始人的生活状况。","source":{"text":"天下人民，野居穴处，未有室屋，则与禽兽同域。","book":"汉·陆贾《新语·道基》"},"example":{"text":"凶贼之徒，固合～，宵行昼伏。","book":"唐·陈子昂《奏白鼠表》"}},{"id":35240,"word":"穴居野处","pinyin":"xué jū yě chǔ","abbr":"xjyc","explanation":"穴：洞；处：居住。居住在洞里生活在荒野。形容原始人的生活状况。","source":{"text":"上古穴居而野处，后世圣人易之以宫室，上栋下宇，以待风雨，盖取诸大壮。","book":"《易·系辞下》"},"example":{"text":"原始人～，过着渔猎生活。"},"similar":["穴居野处"],"opposite":["豪华居室"],"usage":"作谓语、定语；形容原始人的生活状况"},{"id":35241,"word":"穴见小儒","pinyin":"xué jiàn xiǎo rú","abbr":"xjxr","explanation":"穴见：一孔之见。比喻见识狭小的学者。","source":{"text":"耳听小士，穴见小儒，不知五五之开方。","book":"清·汪藩《汉学师承记》卷六"},"usage":"作宾语、定语；用于书面语"},{"id":35242,"word":"穷不与富斗，富不与官斗","pinyin":"qióng bù yǔ fù dòu，fù bù yǔ guān dòu","abbr":"qbyfdfbygd","explanation":"穷：穷人；富：富人；斗：争夺，斗争；官：官吏。穷人斗争不过富人，富人斗不过官府。","source":{"text":"自古道：‘穷不与富斗，富不与官斗。’况在途路之中，众人只得隐忍，自行收拾。","book":"清·褚人获《隋唐演义》第五回"},"usage":"作宾语、定语、分句；用于劝诫人"},{"id":35243,"word":"穷不失义","pinyin":"qióng bù shī yì","abbr":"qbsy","explanation":"义：礼义。虽然穷困，但不失礼义。","source":{"text":"故士穷不失义，达不离道。","book":"《孟子·尽心上》"},"usage":"作谓语、宾语；指人有骨气"},{"id":35244,"word":"穷且益坚","pinyin":"qióng qiě yì jiān","abbr":"qqyj","explanation":"穷：穷困；益：更加。处境越穷困，意志应当越坚定。","source":{"text":"丈夫为志，穷当益坚，老当益壮。","book":"《后汉书·马援传》"},"example":{"text":"老当益壮，宁移白首之心，～，不坠青云之志。","book":"唐·王勃《滕王阁饯别序》"},"similar":["穷当益坚"],"usage":"作谓语、宾语；用于劝诫人"},{"id":35245,"word":"穷乡僻壤","pinyin":"qióng xiāng pì rǎng","abbr":"qxpr","explanation":"壤：地。荒远偏僻的地方。","source":{"text":"穷陬僻壤，无一物之不遂。","book":"明·李时勉《北京赋》"},"example":{"text":"～，有这样读书君子，却被守钱奴如此凌虐，足令人怒发冲冠。","book":"清·吴敬梓《儒林外史》第九回"},"similar":["穷山恶水","不毛之地","穷陬僻壤"],"opposite":["沃野千里"],"usage":"作主语、宾语、定语；指偏僻的地方"},{"id":35246,"word":"穷亡解沮","pinyin":"qing wang jie ju","abbr":"qwjj","explanation":"困窘逃亡，瓦解丧败。"},{"id":35247,"word":"穷侈极奢","pinyin":"qióng chǐ jí shē","abbr":"qcjs","explanation":"穷：极，尽；奢：奢侈。极端奢侈，尽情享受，荒淫腐化。","source":{"text":"又逆征数年之赋，穷侈极奢。","book":"《通典·食货》"},"similar":["穷奢极侈","穷侈极欲"],"usage":"作谓语、定语；指极端奢侈"},{"id":35248,"word":"穷侈极欲","pinyin":"qióng chǐ jí yù","abbr":"qcjy","explanation":"穷：极，尽；侈：奢侈。极端奢侈，尽情享受，荒淫腐化。","source":{"text":"方自谓功德盛五帝，迈三王，穷侈极欲，使天下士肝脑涂地，户口殚耗，盗贼日滋。","book":"《新唐书·孙伏伽传》"},"similar":["穷侈极奢","穷奢极侈"],"usage":"作谓语、定语；指极端奢侈"},{"id":35249,"word":"穷儿乍富","pinyin":"qióng ér zhà fù","abbr":"qezf","explanation":"乍：骤然。指原来很穷的人骤然富有起来。多指因不正当手段而暴富。","source":{"text":"儿子比抄得《唐书》一部，又借得《前汉》欲抄。若了此二书，便是穷儿暴富也。","book":"宋·苏轼《答程全父推官六首》"},"example":{"text":"尊神，这等～，瞒心昧己，欺天诳地，只要损别人安自己，正是一世儿不能够发迹的。","book":"元·无名氏《看钱奴》第一折"},"similar":["穷儿暴富"],"usage":"作宾语、定语；用于暴发户"},{"id":35250,"word":"穷儿暴富","pinyin":"qióng ér bào fù","abbr":"qebf","explanation":"穷人骤然发了大财。比喻学问大增。","source":{"text":"儿子比抄得《唐书》一部，又借得《前汉》欲抄。若了此二书，便是穷儿暴富也。","book":"宋·苏轼《答程全父推官六首》"},"example":{"text":"罗四姐的意思是，升斗小民突然中了奖券，也就是拿～的譬喻，来形容她自己的心境。","book":"高阳《红顶商人胡雪岩》第五章"},"similar":["乞儿暴富","穷儿乍富"],"usage":"作宾语、定语；用于暴发户"},{"id":35251,"word":"穷光蛋","pinyin":"qióng guāng dàn","abbr":"qgd","explanation":"指贫苦人民。","source":{"text":"这次兵灾当然使许多有钱、有房子的人流落做穷光蛋，同时也让许多不知多少穷光蛋有机会追溯自己为过去的富翁。","book":"钱钟书《围城》"},"example":{"text":"作为栖惶了一辈子的老～，他还再敢侈望什么呢？","book":"路遥《平凡的世界》第五卷第六章"},"usage":"作主语、宾语、定语；用于口语"},{"id":35252,"word":"穷兵极武","pinyin":"qióng bīng jí wǔ","abbr":"qbjw","explanation":"穷：竭尽；极：用尽。极力使用武力，不断发动侵略战争。形容极其好战。","source":{"text":"奢侈无限，穷兵极武，百姓空竭，万民疲弊。","book":"汉·荀悦《汉纪·武帝纪》"},"example":{"text":"自古以来，～，未有不亡者也。","book":"唐·吴兢《贞观政要·议征伐》"},"similar":["穷兵黩武"],"usage":"作谓语、宾语、定语；指好战"},{"id":35253,"word":"穷兵黩武","pinyin":"qióng bīng dú wǔ","abbr":"qbdw","explanation":"穷：竭尽；黩：随便，任意。随意使用武力，不断发动侵略战争。形容极其好战。","source":{"text":"而听诸将徇名，穷兵黩武，动费万计，士卒雕瘁，寇不为衰，见我已大病矣。","book":"《三国志·吴书·陆抗传》"},"example":{"text":"王氏今降心纳贡，愿修旧好，明公乃欲～，残灭同盟，天下其谓公何？","book":"宋·孙光宪《北梦琐言》卷十七"},"similar":["兴师动众","勤兵黩武"],"opposite":["和平共处","解甲归田"],"usage":"作谓语、宾语、定语；指好战","story":["三国时期，吴国皇帝孙皓是一个十足的暴君，他任用那些拍马屁的小人做大官，大兴土木，建豪华宫殿。同时还不断扩充军队，使军队的人数占百姓人数的十分之一，军费开支庞大，陆抗打败晋军的进攻后上书孙皓，让他不要再继续穷兵黩武"]},{"id":35254,"word":"穷凶极恶","pinyin":"qióng xiōng jí è","abbr":"qxje","explanation":"穷：极端。形容极端残暴凶恶。","source":{"text":"穷他极恶，流毒诸夏。","book":"《汉书·王莽传赞》"},"example":{"text":"最后侯殿坤～，提起嗓子宣布：“谁也不准埋，谁埋与共产党同罪。”","book":"曲波《林海雪原》二八"},"similar":["无恶不作","罪恶滔天"],"opposite":["和蔼可亲","大慈大悲","悲天悯人"],"usage":"作谓语、定语、状语；指极端残暴","story":["西汉末年，王莽凭借国丈的身份，改国号“新”，声称变法，实际是复古，使农业与商业受到很大的打击，他大肆搜集民间美女进宫，实行残暴统治，搜刮民脂民膏，把长安城闹得鸡犬不宁。《汉书》评论他是穷凶极恶，流毒诸夏"]},{"id":35255,"word":"穷凶极悖","pinyin":"qióng xiōng jí bèi","abbr":"qxjb","explanation":"悖：违反。做事凶残不合礼法。","source":{"text":"义符长嗣，属当天位，不谓穷凶极悖，一至于此。","book":"《宋书·少帝纪》"},"similar":["穷凶极逆"],"usage":"作谓语、定语；用于为人"},{"id":35256,"word":"穷凶极暴","pinyin":"qióng xiōng jí bào","abbr":"qxjb","explanation":"穷：极。形容极端残暴凶恶。","source":{"text":"故自金虏猖獗以来，靖康、建炎之间，穷凶极暴，则有绍兴之和。","book":"宋·陆游《上殿札子》"},"example":{"text":"明·方孝孺《梁武帝》：“虽～之人，能幡然自悔，则可以成佛。”"},"similar":["穷凶极恶","穷凶极悖"],"usage":"作谓语、定语、状语；指极端残暴"},{"id":35257,"word":"穷凶极虐","pinyin":"qióng xiōng jí nüè","abbr":"qxjn","explanation":"穷：极；虐：残暴。形容极端残暴凶恶。","source":{"text":"穷凶极虐，荼酷备加。","book":"南朝·宋·宋文帝《诛徐羡之等诏》"},"example":{"text":"《北齐书·封隆之传》：“逆胡尔朱兆～，天地之所不容，人神之所捐弃。”"},"similar":["穷凶极恶"],"usage":"作谓语、定语、状语；指极端残暴"},{"id":35258,"word":"穷凶极逆","pinyin":"qióng xiōng jí nì","abbr":"qxjn","explanation":"逆：违背。做事凶残不合礼法。","source":{"text":"皇太后奉临，又加锋刃，穷凶极逆，旷古未闻。","book":"《陈书·始兴王叔陵传》"},"example":{"text":"《陈书·始兴王叔陵传》：“皇太后奉临，又加锋刃，～，旷古未闻。”"},"similar":["穷凶极悖"],"usage":"作谓语、定语；用于为人"},{"id":35259,"word":"穷则变，变则通","pinyin":"qióng zé biàn，biàn zé tōng","abbr":"qzbbzt","explanation":"穷：穷尽，困窘。指事物到了尽头就要发生变化，变化了就会继续向前发展。","source":{"text":"易，穷则变，变则通，通则久。","book":"《周易·系辞下》"},"example":{"text":"文章之道，如夏、殷、周之立法，～。","book":"清·袁枚《答友人论文第二书》"}},{"id":35260,"word":"穷则思变","pinyin":"qióng zé sī biàn","abbr":"qzsb","explanation":"原指事物到了尽头就要发生变化。现指在穷困艰难的时候，就要想办法改变现状。","source":{"text":"《易》，穷则变，变则通，通则久。","book":"《周易·系辞下》"},"example":{"text":"凡人之情，～。","book":"唐·陆贽《论左降官准赦合量移事状》"},"similar":["穷极思变"],"usage":"作谓语、定语、分句；指人的习性","story":["远古时期，伏羲氏做国王，他根据天空星罗棋布的星象发明了八卦，利用八卦的原理发明了渔网，让人们可以捕到更多的鱼。后来神农氏当国王，他根据八卦的“穷则变，变则通，通则久”原理，发明木犁，开垦大量的土地"]},{"id":35261,"word":"穷原竟委","pinyin":"qióng yuán jìng wěi","abbr":"qyjw","explanation":"比喻深入探求事物的始末。","source":{"text":"三王之祭川也，皆先河而后海，或源也，或委也，此之谓务本。","book":"西汉·戴圣《礼记·学记》"},"example":{"text":"别人亦只能略举大凡，不能～。","book":"《负曝闲谈》"},"similar":["穷源竟委"],"usage":"作谓语、定语；指彻底搞清楚事情的始末"},{"id":35262,"word":"穷唱渭城","pinyin":"qióng chàng wèi chéng","abbr":"qcwc","explanation":"指穷的时候才唱《渭城曲》。","source":{"text":"贵后，不能复唱《渭城》。","book":"明·王世贞《艺苑厄言》"},"example":{"text":"～的故事暗示人不能忘本。"},"usage":"作宾语、定语；指穷的时候才唱的歌曲","story":["唐朝时期，太子宾客刘禹锡每天上朝时路过一个平房，听到一个卖烧饼的男子哀叹地唱王维的《渭城曲》：“渭城朝雨邑清尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。”他给他一万钱扩大买卖，从此再也听不到他唱此曲了"]},{"id":35263,"word":"穷困潦倒","pinyin":"qióng kùn liáo dǎo","abbr":"qkld","explanation":"穷困：贫穷、困难；潦倒：失意。生活贫困，失意颓丧。","source":{"text":"艰难苦恨繁霜鬓，潦倒新停浊酒杯。","book":"唐·杜甫《登高》诗"},"example":{"text":"破了房县，又有一些～而没有出路的读书人参加了他的义军。","book":"姚雪垠《李自成》第二卷第二十三章"},"similar":["穷愁潦倒"],"usage":"作谓语、定语；指生活失意"},{"id":35264,"word":"穷坑难满","pinyin":"qióng kēng nán mǎn","abbr":"qknm","explanation":"本指贪心不足。转用以比喻食量极大。","source":{"text":"时推官某善饮啖，抵邑公会，以谚语戏曰：‘小器易盈真县尉。’刘答曰：‘穷坑难满是推官。’","book":"清·翟灏《风俗通·地理》引《复斋漫录》"},"usage":"作宾语、定语；用于比喻句"},{"id":35265,"word":"穷大失居","pinyin":"qióng dà shī jū","abbr":"qdsj","explanation":"指居大位者骄奢无度，必覆灭而失所居。后形容多而不适用。","source":{"text":"穷大者必失其居。","book":"《周易·序卦》"},"example":{"text":"诚能以昭代之典章文字读《六经》，而又能以《六经》读昭代之典章文字，其于是编也，又何～之有？（清·魏源《国朝古文类钞序》）"},"usage":"作补语、定语；形容多而不适用"},{"id":35266,"word":"穷天极地","pinyin":"qióng tiān jí dì","abbr":"qtjd","explanation":"指天涯海角。形容极边远的地方。","source":{"text":"升平，无外事，穷天极地，俱沐恩光。","book":"宋·姚述尧《满庭芳》词"},"example":{"text":"元之盛时，外夷朝贡者千余国，可谓～，罔不宾服。","book":"明·谢肇淛《五杂俎·地部二》"},"similar":["天涯海角"],"usage":"作宾语、定语；用于地方"},{"id":35267,"word":"穷奢极侈","pinyin":"qióng shē jí chǐ","abbr":"qsjc","explanation":"穷：极；奢、侈：奢侈。极端奢侈，尽量享受。形容挥霍浪费，荒淫腐化。","source":{"text":"末世衰主，穷奢极侈，造作无端。","book":"南朝·宋·范晔《后汉书·陆康传》"},"example":{"text":"郭尚父立勋业，出入将相，～。","book":"宋·王谠《唐语林·言语》"},"similar":["荒淫无度","骄奢淫逸","荒淫无耻"],"opposite":["艰苦朴素","克勤克俭","节衣缩食"],"usage":"作谓语、定语；指极端奢侈"},{"id":35268,"word":"穷奢极欲","pinyin":"qióng shē jí yù","abbr":"qsjy","explanation":"穷：极；奢：奢侈；欲：享乐的观念。奢侈和贪欲到了极点。","source":{"text":"穷奢极侈，湛湎荒淫。","book":"《汉书·谷永传》"},"example":{"text":"且～，衰将及之。","book":"严复《道学外传》"},"similar":["穷奢极侈"],"opposite":["艰苦朴素","克勤克俭","节衣缩食"],"usage":"作谓语、定语；指奢侈和贪欲到了极点"},{"id":35269,"word":"穷奸极恶","pinyin":"qióng jiān jí è","abbr":"qjje","explanation":"穷：极。形容极其奸诈凶恶。","source":{"text":"如惠卿、汲，穷奸极恶，不待臣言而知。","book":"宋·苏轼《缴词头奏状·吴荀》"},"usage":"作宾语、定语；用于坏人"},{"id":35270,"word":"穷妙极巧","pinyin":"qióng miào jí qiǎo","abbr":"qmjq","explanation":"形容极其美好。","source":{"text":"穷妙极巧，旷以日月。然后成器，其音如彼。","book":"汉·马融《长笛赋》"},"example":{"text":"峄阳之桐，殖颖岩摽，清泉润根，女萝被条，尔乃楚班制器，～。","book":"唐·欧阳洵《艺文类聚·箜篌》"},"similar":["穷极要妙","穷极其妙"],"usage":"作谓语、定语；形容美好"},{"id":35271,"word":"穷家富路","pinyin":"qióng jiā fù lù","abbr":"qjfl","explanation":"在家可节约开支，出门却宜多备盘缠。","source":{"text":"银子虽多，贤弟只管拿去。俗语说得好：‘穷家富路。’","book":"清·石玉昆《三侠五义》第23回"},"example":{"text":"出外旅行要记住～的道理。"},"usage":"作宾语、定语；指出门事宜"},{"id":35272,"word":"穷家薄业","pinyin":"qióng jiā bó yè","abbr":"qjby","explanation":"指家底薄，没什么积蓄。","source":{"text":"再说，咱这穷家薄业，就爸爸一个人拉扯着你们，没个帮手不行啊！","book":"路遥《平凡的世界》第一卷第11章"},"usage":"作宾语、定语；用于口语"},{"id":35273,"word":"穷寇勿迫","pinyin":"qióng kòu wù pò","abbr":"qkwp","explanation":"穷寇：势穷力竭的敌人。对陷于绝境中的敌人，不要追迫太急，以防敌人情急反扑，造成自己不应有的损失。","source":{"text":"归师勿遏，围师必阙，穷寇勿迫，此用兵之法也。","book":"春秋·齐·孙武《孙子·军争》"},"similar":["穷寇勿追"],"usage":"作宾语、定语；指不追无路可走的敌人"},{"id":35274,"word":"穷寇勿追","pinyin":"qióng kòu wù zhuī","abbr":"qkwz","explanation":"穷寇：走投无路的敌人。不追无路可走的敌人，以免敌人情急反扑，造成自己的损失。也比喻不可逼人太甚。","source":{"text":"穷寇勿迫，此用兵之法也。","book":"《孙子·军争》"},"example":{"text":"庞涓，你岂不知归师勿掩，～，你苦苦追赶我做什么？（元·无名氏《马陵道》第四折）"},"similar":["穷寇勿迫"],"usage":"作宾语、定语；指不追无路可走的敌人"},{"id":35275,"word":"穷寇莫追","pinyin":"qióng kòu mò zhuī","abbr":"qkmz","explanation":"穷寇：走投无路的敌人。不追无路可走的敌人，以免敌人情急反扑，造成自己的损失。也比喻不可逼人太甚。","source":{"text":"穷寇勿迫，此用兵之法也。","book":"《孙子·军争》"},"example":{"text":"兵法云：“归师莫掩，～。”","book":"明·罗贯中《三国演义》第九十五回"},"similar":["穷寇勿追","穷寇勿迫"],"usage":"作宾语、定语；指不追无路可走的敌人"},{"id":35276,"word":"穷富极贵","pinyin":"qióng fù jí guì","abbr":"qfjg","explanation":"形容极其富贵。","source":{"text":"故穷富极贵，不足以诱之焉。","book":"《抱朴子·畅玄》"},"example":{"text":"父子皆受旌节，子与孙虽在幼童者亦为好官，～，宠荣耀天下。","book":"唐·李翱《韩吏部行状》"},"similar":["穷贵极富"],"usage":"作谓语、定语；多用于富人"},{"id":35277,"word":"穷山僻壤","pinyin":"qióng shān pì rǎng","abbr":"qspr","explanation":"壤：地。荒远偏僻的地方。","source":{"text":"故州城县郭所在之乡，其产不甚重，与穷山僻壤至有相倍蓗者，此逐乡产钱租额，所以本来已有轻重之所由也。","book":"宋·朱熹《条奏经界状·贴黄》"},"example":{"text":"这都毁版厉禁几十年了，～里头仍在讲逆犯著的书！","book":"二月河《乾隆皇帝》十八"},"similar":["穷乡僻壤"],"usage":"作主语、宾语、定语；指偏僻的地方"},{"id":35278,"word":"穷山恶水","pinyin":"qióng shān è shuǐ","abbr":"qses","explanation":"穷山：荒山；恶水：经常引起灾害的河流湖泊等。形容自然条件非常差。","source":{"text":"且山虽明而寸草不生，是为穷山；水虽秀而只鳞莫睹，是为恶水。","book":"清·王濬卿《冷眼观》"},"example":{"text":"它使我想起很多事情，想起在阜平～之间度过的三年战斗的岁月。","book":"孙犁《山地回忆》"},"similar":["穷乡僻壤","不毛之地"],"opposite":["山青水秀","锦绣河山"],"usage":"作主语、宾语、定语；指条件恶劣的地方"},{"id":35279,"word":"穷山竭泽","pinyin":"qióng shān jié zé","abbr":"qsjz","explanation":"穷：寻求到尽头。寻遍所有的山与河。","source":{"text":"麟，人罕识之兽也，以见公之穷山竭泽而尽取，至于不识之兽，皆搜索而之。","book":"《新五代史·前蜀世家·王建》"},"usage":"作谓语、宾语、状语；用于寻找"},{"id":35280,"word":"穷岁累月","pinyin":"qióng suì lěi yuè","abbr":"qsly","explanation":"穷：尽。指经过很长的时间。形容连续不断，时间长久。","source":{"text":"及穿剥三藏，穷岁累月，稍稍出而观今之宗师者，发露其败阙。","book":"清·黄宗羲《前乡进士泽望黄君圹志》"},"similar":["穷年累月"],"usage":"作谓语、定语；用于时间久远"},{"id":35281,"word":"穷崖绝谷","pinyin":"qióng yá jué gǔ","abbr":"qyjg","explanation":"高山深谷。形容地形荒僻险恶。","source":{"text":"外至四海九州，名山大泽，穷崖绝谷，荒林破冢，神仙鬼物诡怪所传，莫不皆有。","book":"宋·欧阳修《序》"},"similar":["高山深谷"],"usage":"作主语、宾语、定语；用于地形"},{"id":35282,"word":"穷工极变","pinyin":"qióng gōng jí biàn","abbr":"qgjb","explanation":"穷：极。形容十分精巧而变化多端。","source":{"text":"时复拈笔为制举义，穷工极变。","book":"明·无名氏《袁宗道传》"},"usage":"作谓语、定语；用于事物"},{"id":35283,"word":"穷工极巧","pinyin":"qióng gōng jí qiǎo","abbr":"qgjq","explanation":"形容工艺极其精巧。","source":{"text":"于葛岭起建楼台亭榭，穷工极巧。","book":"明·冯梦龙《喻世明言》第22卷"},"example":{"text":"～迷人目，尽是民间脂与膏。","book":"清·陈瑞生《再生缘》第80回"},"similar":["穷工极变"],"usage":"作谓语、定语；用于事物"},{"id":35284,"word":"穷工极态","pinyin":"qióng gōng jí tài","abbr":"qgjt","explanation":"穷：极。形容极其精致。","source":{"text":"诗之穷工极态，于斯而至。","book":"明·蒋一葵《长安客话·海淀》"},"usage":"作谓语、定语、宾语；用于事物"},{"id":35285,"word":"穷巷掘门","pinyin":"qióng xiàng jué mén","abbr":"qxjm","explanation":"掘：通“窟”，土屋。荒僻的里巷，简陋的土屋。","source":{"text":"且夫苏秦特穷巷掘门，桑户惓枢之土耳。","book":"西汉·刘向《战国策·秦策》"},"usage":"作主语、宾语；用于房屋"},{"id":35286,"word":"穷巷陋室","pinyin":"qióng xiàng lòu shì","abbr":"qxls","explanation":"穷巷：偏僻的里巷；陋室：狭小的房屋。指僻陋狭小的住处。","source":{"text":"虽隐居穷巷陋室，无置锥之地，而庄公不能与争名矣。","book":"汉·韩婴《韩诗外传》卷五"},"similar":["穷阎陋屋"],"usage":"作宾语、定语；指僻陋狭小的住处"},{"id":35287,"word":"穷年尽气","pinyin":"qióng nián jìn qì","abbr":"qnjq","explanation":"穷：尽。竭尽毕生的力量。","source":{"text":"予将穷年尽气以恣探之不暇，又何至有废卷之叹乎！","book":"清·高阜《序》"},"usage":"作谓语、状语；用于处事"},{"id":35288,"word":"穷年屡月","pinyin":"qióng nián lǚ yuè","abbr":"qnly","explanation":"累：接连。形容经历的时间长久。","source":{"text":"这个斗争非常剧烈，从甲骨文上可以看到穷年屡月的大战。","book":"郭沫若《今昔集·论古代文学》"},"similar":["穷年累月"],"usage":"作谓语、定语；用于时间久远"},{"id":35289,"word":"穷年没世","pinyin":"qióng nián mò shì","abbr":"qnms","explanation":"没世：一辈子。形容经历的时间长久。","source":{"text":"必有大节而无小过者然后得为谏诤之臣，则穷年没世不可得其人矣。","book":"宋·秦观《任臣下》"},"similar":["穷年累世","穷年屡月","穷年累月"],"usage":"作谓语、定语；用于时间久远"},{"id":35290,"word":"穷年累世","pinyin":"qióng nián lěi shì","abbr":"qnls","explanation":"形容时间长久。","source":{"text":"然而穷年累世，不知不足，是人之情也。","book":"《荀子·荣辱》"},"similar":["穷年累月","穷年累岁"],"usage":"作谓语、定语；用于时间久远"},{"id":35291,"word":"穷年累岁","pinyin":"qióng nián lěi suì","abbr":"qnls","explanation":"累：接连。形容经历的时间长久。","source":{"text":"然而穷年累世，不知不足，是人之情也。","book":"《荀子·荣辱》"},"example":{"text":"与夫伏生、孔安国之徒，其于六经之余，～，不遗余力矣。","book":"宋·陈亮《策·传注》"},"similar":["穷年累月","穷年屡月"],"usage":"作谓语、定语；用于时间久远"},{"id":35292,"word":"穷年累月","pinyin":"qióng nián lěi yuè","abbr":"qnly","explanation":"穷年：年初到年底；累月：持续几个月。形容接连不断，历时久远。","source":{"text":"然而穷年累世，不知不足，是人之情也。","book":"《荀子·荣辱》"},"example":{"text":"那都是坐在自己的书斋里，查群籍，翻类书，～，这才脱稿的，然而仍然有“未详”，有错误。","book":"鲁迅《花边文学·考场三丑》"},"similar":["长年累月","穷年累世"],"opposite":["一朝一夕","顷刻之间"],"usage":"作谓语、定语；用于时间久远"},{"id":35293,"word":"穷幽极微","pinyin":"qióng yōu jí wēi","abbr":"qyjw","explanation":"深入探求玄奥的学问。","source":{"text":"穷幽极微，至纤无际。","book":"宋·张君房《云笈七签》卷一○二"},"example":{"text":"圣叹之评《西厢》，可谓晰毛辨发，～，无复有遗议于其间矣。","book":"清·李渔《闲情偶寄·填词余论》"},"similar":["穷纤入微"],"usage":"作谓语、宾语；用于求学"},{"id":35294,"word":"穷当益坚","pinyin":"qióng dāng yì jiān","abbr":"qdyj","explanation":"空：穷困。处境越穷困，意志应当越坚定。","source":{"text":"丈夫为志，穷当益坚，老当益壮。","book":"《后汉书·马援传》"},"example":{"text":"“大丈夫立志，～，老当益壮。”大伙儿认为这是很宝贵的教训。","book":"林汉达《前后汉故事新编·三分天下》"},"similar":["穷且益坚"],"usage":"作谓语、宾语；用于劝诫人"},{"id":35295,"word":"穷形尽相","pinyin":"qióng xíng jì xiàng","abbr":"qxjx","explanation":"原指描写刻画细致生动，现在指丑态毕露。","source":{"text":"虽离方而遁员，期穷形而尽相。","book":"晋·陆机《文赋》"},"example":{"text":"其所以爱之之故无他道焉，不外～，引人入胜而已。","book":"清·陶宗佑《论小说之势力及其影响》"},"similar":["绘声绘色","原形毕露"],"opposite":["平铺直叙"],"usage":"作谓语、状语；形容丑态毕露"},{"id":35296,"word":"穷形尽致","pinyin":"qióng xíng jìn zhì","abbr":"qxjz","explanation":"原指描写刻画细致生动，现在指丑态毕露。","source":{"text":"虽离方而遁员，期穷形而尽相。","book":"晋·陆机《文赋》"},"example":{"text":"众人见他说的～，也不理他。","book":"清·李宝嘉《官场现形记》第三十一回"}},{"id":35297,"word":"穷形极状","pinyin":"qióng xíng jí zhuàng","abbr":"qxjz","explanation":"穷：尽，极。指描写刻画十分细致生动，也指丑态毕露。","source":{"text":"虽离方而遁员，期穷形而尽相。","book":"晋·陆机《文赋》"},"example":{"text":"若是将这些牙酸肉麻的情况，写的～，未免蹈小说家窠臼。","book":"清李绿园《歧路灯》第二十二回"},"similar":["穷形极相"],"usage":"作谓语、状语；用于文章或绘画等"},{"id":35298,"word":"穷形极相","pinyin":"qióng xíng jí xiàng","abbr":"qxjx","explanation":"穷：尽，极；相：象。指描写刻画十分细致生动，也指丑态毕露。","source":{"text":"虽离方而遁员，期穷形而尽相。","book":"晋·陆机《文赋》"},"example":{"text":"自己远远坐在一边，冷眼旁观，看他眼珠凸出，不断咽口水的～，心里越发泰然。","book":"高阳《红顶商人胡雪岩》第八章"},"similar":["穷形尽相","穷形极状"],"usage":"作谓语、状语；用于文章或绘画等"},{"id":35299,"word":"穷心剧力","pinyin":"qióng xīn jù lì","abbr":"qxjl","explanation":"尽心尽力，全力以赴。","source":{"text":"今夫穷心剧力，茫然日以雕刻为事，而不暇外顾者，其成何哉？","book":"宋·王令《答刘公著微之书》"},"similar":["尽心尽力"],"usage":"作谓语、状语；同“尽心尽力”"},{"id":35300,"word":"穷态极妍","pinyin":"qióng tài jí yán","abbr":"qtjy","explanation":"妍：美丽。形容把各种美姿都表现出来。","source":{"text":"一肌一容，尽态极妍，缦立远而望幸焉。","book":"唐·杜牧《阿房宫赋》"},"example":{"text":"又绣过一幅“停针图”，真是～，而且无法分辨是画、是绣。","book":"高阳《红顶商人胡雪岩》第五章"},"usage":"作谓语；用于美好的事物"},{"id":35301,"word":"穷思极想","pinyin":"qióng sī jí xiǎng","abbr":"qsjx","explanation":"穷：极。形容苦苦思索。","source":{"text":"张生穷思极想，方才下得一着，小道人只随手应去。","book":"明·凌濛初《二刻拍案惊奇》第二卷"},"example":{"text":"而投闲置散之员，更于此时～，条陈聚敛之法。","book":"清·吴趼人《俏皮话·捐躯报国》"},"similar":["穷思竭想","冥思苦想"],"usage":"作谓语、宾语；用于思考"},{"id":35302,"word":"穷思毕精","pinyin":"qióng sī bì jīng","abbr":"qsbj","explanation":"毕：尽。用尽所有的精力。","source":{"text":"曾不得奏薄伎于从官之内，隶御之间，穷思毕精，以赎罪过。","book":"唐·韩愈《潮州刺史谢上表》"},"usage":"作谓语、定语；用于处事"},{"id":35303,"word":"穷思竭想","pinyin":"qióng sī jié xiǎng","abbr":"qsjx","explanation":"绞尽脑汁，苦思苦想。","example":{"text":"我～，也没有好的办法。"},"similar":["冥思苦想"],"usage":"作谓语；指绞尽脑汁"},{"id":35304,"word":"穷愁潦倒","pinyin":"qióng chóu liáo dǎo","abbr":"qcld","explanation":"穷愁：穷困愁伤；潦倒：颓丧，失意。穷困愁苦，失意消沉。形容读书人境遇困苦，意志消沉。","source":{"text":"盘费全无怎去家，穷愁潦倒驻京华。","book":"清·无名氏《都门竹枝词·教官十首》"},"example":{"text":"我从此认得笑庵，不是饭颗山头，～的诗人，倒是瑶台桃树下，玩世不恭的奇士了。","book":"清·曾朴《孽海花》第三十五回"},"similar":["穷困潦倒"],"usage":"作谓语、定语；用于人的处境"},{"id":35305,"word":"穷折腾","pinyin":"qióng zhē téng","abbr":"qzt","explanation":"翻来覆去地做某事，没有任何效果。","source":{"text":"整天就是搞这运动那运动，穷折腾个没完！","book":"路遥《平凡的世界》第一卷第25章"},"example":{"text":"他只是～罢了。"},"similar":["瞎折腾"],"usage":"作谓语、定语、宾语；用于口语"},{"id":35306,"word":"穷措大","pinyin":"qióng cuò dà","abbr":"qcd","explanation":"措：读书人。比喻贫穷的读书人。","source":{"text":"你何不从之而孜孜事一个穷措大，有何长进！纵不然，堂头官人，丰衣足食，所往无不克。","book":"五代·王定保《唐摭言·贤仆夫》"},"example":{"text":"方才贵昆仑已经来说过。我们几个～今儿要吃大户了！","book":"二月河《乾隆皇帝》十九"},"similar":["穷醋大"],"usage":"作宾语、定语；用于书面语"},{"id":35307,"word":"穷搜博采","pinyin":"qióng sōu bó cǎi","abbr":"qsbc","explanation":"搜：搜罗。广泛地搜集采摘。","source":{"text":"自是穷搜博采，选录大题文及小题文各千余篇，多世间之所未见。","book":"清·戴名世《序》"},"example":{"text":"清·戴名世《序》：“自是～，选录大题文及小题文各千余篇，多世间之所未见。”"},"usage":"作宾语、谓语；用于搜集资料"},{"id":35308,"word":"穷日之力","pinyin":"qióng rì zhī lì","abbr":"qrzl","explanation":"穷：意尽。原指一天之内，使尽全力。比喻尽一天的力量、工夫。","source":{"text":"予岂若是小丈夫然哉！谏于其君而不受，则怒，悻悻然见于其面，去则穷日之力而后宿哉。","book":"《孟子·公孙丑下》"},"example":{"text":"且一论一策，～不足以致其精，虽有实学，无以自见。","book":"清·毕沅《续资治通鉴》卷一百三十四"},"usage":"作宾语；指一天的时间"},{"id":35309,"word":"穷日落月","pinyin":"qióng rì luò yuè","abbr":"qrly","explanation":"白天连着晚上。形容加紧工作或学习。","source":{"text":"研经订史，未尝不穷日落月。","book":"明·高攀龙《光州学正薛公以身墓志铭》"},"example":{"text":"李子有贵客，邀梅山。客故豪酒，梅山亦豪酒。深觞细杯，～。","book":"明·李梦阳《梅山先生墓志铭》"},"usage":"作谓语、状语；指日夜不停"},{"id":35310,"word":"穷本极源","pinyin":"qióng běn jí yuán","abbr":"qbjy","explanation":"穷：寻求到尽头。探求事物的本源。","source":{"text":"务求象山之所以非，晦庵之所以是，穷本极源，真有以见其几微得失于毫忽之间。","book":"明·王守仁《答徐成之》"},"example":{"text":"所以～，我们现在要恢复民族的地位。","book":"孙中山《三民主义》第六讲"},"similar":["追根溯源"],"usage":"作谓语；指探求事物的本源"},{"id":35311,"word":"穷村僻壤","pinyin":"qióng cūn pì rǎng","abbr":"qcpr","explanation":"穷：贫穷；僻：偏僻。荒远偏僻的地方。","source":{"text":"虽穷村僻壤，莫不感颂其政。","book":"清·汪琬《工部尚书充经筵讲官汤公墓志铭》"},"similar":["穷乡僻壤"],"usage":"作主语、宾语、定语；指偏僻的地方"},{"id":35312,"word":"穷极其妙","pinyin":"qióng jí qí miào","abbr":"qjqm","explanation":"形容极其美好。","source":{"text":"孝元皇帝多才艺，善史书，鼓琴吹洞箫，自度声曲，分别节度，穷极要妙。","book":"汉·荀悦《汉纪·元帝纪下》"},"example":{"text":"既坐，行酒命乐，又美人十数，歌者舞者，丝竹既发，～。","book":"唐·张读《宣室志·张鋋》"},"similar":["穷极要妙","穷妙极巧"],"usage":"作谓语、定语；形容美好"},{"id":35313,"word":"穷极凶恶","pinyin":"qióng jí xiōng è","abbr":"qjxe","explanation":"穷：极。形容极端残暴凶恶。","source":{"text":"虽守府之身，未能穷极凶恶，而一言坏法，实能驯至乱流。","book":"章炳麟《为辛亥同志俱乐部纠正段祺瑞废止法统令通电》"},"similar":["穷凶极恶","穷凶极虐"],"usage":"作谓语、定语、状语；指极端残暴"},{"id":35314,"word":"穷极则变","pinyin":"qióng jí zé biàn","abbr":"qjzb","explanation":"原指事物到了尽头就要发生变化。现指在穷困艰难的时候，就要想办法改变现状。","source":{"text":"凡人之情，穷则思变。","book":"《周易·系辞下》：“易，穷则变，变则通，通则久。”《资治通鉴·唐德宗贞元十年》"},"example":{"text":"天下 事，惟陷之深者，其出愈速；～，理有固然。","book":"清·夏敬渠《野叟曝言》第三十一回"},"similar":["穷则思变"],"usage":"作谓语、定语、分句；指人的习性"},{"id":35315,"word":"穷极思变","pinyin":"qióng jí sī biàn","abbr":"qjsb","explanation":"指在穷困艰难的时候，就要想办法改变现状。","source":{"text":"热极生风，穷极思变。","book":"宋·程颐"},"example":{"text":"～，我们得赶紧想办法走出困境。"},"similar":["穷则思变"],"usage":"作宾语、定语；指思考改变现状"},{"id":35316,"word":"穷极无聊","pinyin":"qióng jí wú liáo","abbr":"qjwl","explanation":"穷极：极端；无聊：无所依托。原指光景穷困，精神无所寄托。现也形容无事可做，非常无聊。","source":{"text":"虞卿亦何命，穷极若无聊。","book":"宋·费昶《思公子》诗"},"example":{"text":"却被一个～的刘浩三，一个乡愚无知的余知化，提倡实业；工商两途，大受影响。","book":"清·姬文《市声》第三十六回"},"similar":["无所事事","百无聊赖"],"opposite":["精神饱满"],"usage":"作谓语、定语；指无所事事"},{"id":35317,"word":"穷极要妙","pinyin":"qióng jí yào miào","abbr":"qjym","explanation":"形容精妙到极点。多形容乐声。","source":{"text":"孝元皇帝多才艺，善史书，鼓琴吹洞箫，自度声曲，分别节度，穷极要妙。","book":"汉·荀悦《汉纪·元帝纪下》"},"similar":["穷极其妙"],"usage":"作谓语、定语；形容美好"},{"id":35318,"word":"穷根寻叶","pinyin":"qióng gēn xún yè","abbr":"qgxy","explanation":"指弄清楚事情的真相。","source":{"text":"追逮证验，穷根寻叶，狼虎满路，狴牢充塞。","book":"唐·杜牧《上李太尉论江贼书》"},"similar":["寻根究底"],"usage":"作谓语、宾语、状语；指弄清来龙去脉"},{"id":35319,"word":"穷根究底","pinyin":"qióng gēn jiū dǐ","abbr":"qgjd","explanation":"究：查究；底：底细。追求根底。一般指追问一件事的原由。","source":{"text":"淑华穷根究底地问道：‘三爸跟你谈过什么事吗？’","book":"巴金《秋》"},"example":{"text":"她～地问个没完。"},"similar":["追根究底"],"usage":"作谓语、宾语、状语；指追究事物的根底"},{"id":35320,"word":"穷池之鱼","pinyin":"qióng chí zhī yú","abbr":"qczy","explanation":"穷池：失水之池。比喻处境非常困难的人。","source":{"text":"即日到白水城，谨遣私署散骑常侍王幼奉笺以闻，并敕州郡投戈释杖。穷池之鱼，待命漏刻。","book":"《晋书·李势传》"},"example":{"text":"何乃进不偶用，退不获安，呼吸若～，行止比失林之鸟，忧伤之心，不能亡已。","book":"清·褚人获《隋唐演义》第三回"},"similar":["失林之鸟"],"usage":"作宾语；用于比喻句"},{"id":35321,"word":"穷泉朽壤","pinyin":"qióng quán xiǔ rǎng","abbr":"qqxr","explanation":"穷泉：泉下，地层深处；朽壤：腐烂的土壤。指人死后埋葬的地方。","source":{"text":"委兰房兮繁华，袭穷泉兮朽壤。","book":"晋·潘岳《哀永逝文》"},"usage":"作宾语、定语；用于书面语"},{"id":35322,"word":"穷波讨源","pinyin":"qióng bō tǎo yuán","abbr":"qbty","explanation":"穷：尽。追根寻源。多用于比喻深入研究学问。","source":{"text":"今皆穷波讨源，搆会甄释。","book":"唐·颜师古《汉书叙例唐正议大夫行秘书少监琅邪县开国子》"},"example":{"text":"诋蔡谟以牴牾，自谓～，构会甄释，无復遗恨。","book":"宋·司马光《资治通鉴·序》"}},{"id":35323,"word":"穷泰极侈","pinyin":"qióng tài jí chǐ","abbr":"qtjc","explanation":"穷：极；泰：骄恣；侈：奢侈。极端奢侈，尽情享受，生活荒淫腐化。","source":{"text":"历十二年之延祚，故穷泰而极侈。","book":"汉·班固《西都赋》"},"example":{"text":"于是帮官～，提闸之费，一处或至五十金，沿途莫不有所沾溉。","book":"清·冯桂芬《致曾侯相书》"},"similar":["穷奢极侈"],"usage":"作谓语、定语；指极端奢侈"},{"id":35324,"word":"穷源推本","pinyin":"qióng yuán yuī běn","abbr":"qytb","explanation":"推究事物的本源。","source":{"text":"明珠悬顶，穷源推本应根究。图功业志气从新，思骨肉宗支寻旧。","book":"明·沈鲸《双珠记·卖儿系珠》"},"similar":["推本穷源"],"usage":"作谓语、宾语；用于探求"},{"id":35325,"word":"穷源朔流","pinyin":"qióng yuán shuò liú","abbr":"qysl","explanation":"比喻探究和追溯事物的原由。"},{"id":35326,"word":"穷源溯流","pinyin":"qióng yuán sù liú","abbr":"qysl","explanation":"源：河流发源的地方；溯：逆流而上。原指逆流而上探寻河流的源头。现比喻探究和追溯事物的原由。","source":{"text":"为诗要穷源溯流，先辨诸家之派。","book":"清·王十禛《然灯记闻》"},"example":{"text":"他喜欢对任何事物都要～。"},"similar":["穷源竟委"],"usage":"作谓语、宾语；同“穷源竟委”"},{"id":35327,"word":"穷源竟委","pinyin":"qióng yuán jìng wěi","abbr":"qyjw","explanation":"穷、竟：彻底推求；源：水流的源头；委：水的下流。比喻彻底搞清楚事情的始末。","source":{"text":"三王之祭川也，皆先河而后海，或源也，或委也，此之谓务本。","book":"《礼记·学记》"},"example":{"text":"又遍历诸河，～，将大行疏濬。","book":"《明史·徐贞明传》"},"similar":["穷原竟委"],"usage":"作谓语、定语；指彻底搞清楚事情的始末"},{"id":35328,"word":"穷猿失木","pinyin":"qióng yuán shī mù","abbr":"qysm","explanation":"比喻流离失所，无家可归。","source":{"text":"寒日经檐短，穷猿失木悲。","book":"唐·杜甫《寄杜位》诗"},"usage":"作宾语、定语；用于比喻句"},{"id":35329,"word":"穷猿奔林","pinyin":"qióng yuán bēn lín","abbr":"qybl","explanation":"穷猿：被猎人紧追的猿猴。比喻在穷困中急于找一个栖身的地方。","source":{"text":"北门之叹，久已上闻。穷猿奔林，岂暇择木。","book":"南朝宋·刘义庆《世说新语·言语》"},"similar":["穷猿投林"],"usage":"作宾语；比喻人处穷困，急于找栖身的地方","story":["传说古代李弘度经常感叹自己怀才不遇，殷扬州知道他家贫就问他能否屈志百里不？李弘度感慨回答：“《北门》之叹，久已上闻。穷猿奔林，岂暇择木！”殷扬州决定录用他为剡县县令，李弘度感激不尽"]},{"id":35330,"word":"穷猿投林","pinyin":"qióng yuán tóu lín","abbr":"qytl","explanation":"穷猿：被猎人紧追的猿猴。比喻在穷困中急于找一个栖身的地方。","source":{"text":"穷猿投林，岂睱择木。","book":"《晋书·李充传》"},"example":{"text":"近在常置得一小庄子，岁可得百石，似可足食。非不知扬州之美，～，不暇择木也。","book":"宋·苏轼《答定国三首》"},"similar":["穷猿奔林"],"usage":"作宾语；比喻人处穷困，急于找栖身的地方"},{"id":35331,"word":"穷理尽妙","pinyin":"qióng lǐ jìn miào","abbr":"qljm","explanation":"指系统深入地研究事物的原理，以达到精深奥妙的境地。","source":{"text":"发言抗论，穷理尽微。","book":"三国·魏·吴志《答魏太子笺》"},"example":{"text":"宝刀既成，～繁文波回，流光电照。","book":"晋·张协《文身刀铭》"}},{"id":35332,"word":"穷理尽微","pinyin":"qióng lǐ jìn wēi","abbr":"qljw","explanation":"指系统深入地研究事物的原理，以达到精深奥妙的境地。","source":{"text":"发言抗论，穷理尽微。","book":"三国·魏·吴志《答魏太子笺》"}},{"id":35333,"word":"穷理尽性","pinyin":"qióng lǐ jìn xìng","abbr":"qljx","explanation":"原指彻底推究事物的道理，透彻了解人类的天性。后泛指穷究事理。","source":{"text":"穷理尽兴，以至于命。","book":"《易·说卦》"},"example":{"text":"然务为～之学，真知文知精意。","book":"清·方宗诚《桐城文录序》"},"usage":"作谓语、宾语、定语；泛指穷究事理"},{"id":35334,"word":"穷神知化","pinyin":"qióng shén zhī huà","abbr":"qszh","explanation":"指深究事物的精微道理。","source":{"text":"穷神知化，德之盛也。","book":"《周易·系辞下》"},"example":{"text":"～，亿兆所以归心。","book":"《南齐书·高帝纪上》"},"similar":["穷神观化"],"usage":"作谓语、宾语；用于观察事物"},{"id":35335,"word":"穷神观化","pinyin":"qióng shén guān huà","abbr":"qsgh","explanation":"穷：寻求到尽头。探求事物的神妙，了解事物的变化。","source":{"text":"穷神知化，德之盛也。","book":"《周易·系辞下》"},"example":{"text":"～，望影揣清。","book":"晋·陆机《汉高祖功臣颂》"},"similar":["穷神知化"],"usage":"作谓语、宾语；用于观察事物"},{"id":35336,"word":"穷纤入微","pinyin":"qióng xiān rù wēi","abbr":"qxrw","explanation":"穷：寻求到尽头；纤：细小。深入探求深奥的学问。","source":{"text":"虽曰九数，其能穷纤入微，探测无方，至于以法相传。","book":"三国·魏·刘徽《序》"},"similar":["穷幽极微"],"usage":"作谓语、宾语；用于求学"},{"id":35337,"word":"穷老尽气","pinyin":"qióng lǎo jìn qì","abbr":"qljq","explanation":"一直到了很大年纪，用尽了一生气力。形容一个人把毕生精力都消耗在某种学业之上。","source":{"text":"处则充栋宇，出则汗牛马，或合而隐，或乖而显，后之学者穷老尽气，左视右顾,莫得而本。","book":"唐·柳宗元《唐故给事中皇太子侍志陆文通先生墓表》"},"example":{"text":"通才硕学，研精覃思，～，仅乃十得其七八。","book":"鲁迅《集外集拾遗补编·补救世道文件四种》"}},{"id":35338,"word":"穷而后工","pinyin":"qióng ér hòu gōng","abbr":"qehg","explanation":"工：精巧，精彩。旧时认为文人越是穷困不得志，诗文就写得越好。","source":{"text":"然则非诗之能穷人，殆穷者而后工也。","book":"宋·欧阳修《梅圣俞诗集序》"},"example":{"text":"伏念诗人～之说，原为衰世之言。","book":"清·袁枚《小仓山房尺牍》卷一○一"},"usage":"作谓语、宾语；指文人"},{"id":35339,"word":"穷苗苦根","pinyin":"qióng miáo kǔ gēn","abbr":"qmkg","explanation":"比喻处境贫苦的人。","source":{"text":"穷苗苦根带土铲，黄连换来甘蔗杆。","book":"《中国歌谣资料·一颗比一颗甜》"},"usage":"作主语、宾语、定语；指贫苦人们"},{"id":35340,"word":"穷荒绝徼","pinyin":"qióng huāng jué jiào","abbr":"qhjj","explanation":"徼：边界，边塞。极远的边塞。","source":{"text":"穷荒绝徼，圣人以爪甲视之。","book":"明·刘基《郁离子·千里马》"},"example":{"text":"皇考临御六十年，四征不庭，凡～，无不指日奏凯。","book":"清·魏源《圣武记》第九卷"},"usage":"作宾语、定语；用于书面语"},{"id":35341,"word":"穷街陋巷","pinyin":"qióng jiē lòu xiàng","abbr":"qjlx","explanation":"贫穷破旧的街巷。","example":{"text":"昔日的～现在已经不见了，变得十分繁华。"},"usage":"作主语、宾语、定语；用于地方"},{"id":35342,"word":"穷言杂语","pinyin":"qióng yán zá yǔ","abbr":"qyzy","explanation":"指各种各样的说法。","source":{"text":"有的说他死有余恨，还该灭他三族，穷搜他的党羽；穷言杂语，激聒个不了。","book":"清·西周生《醒世姻缘传》第15回"},"example":{"text":"不要理会这些～。"},"usage":"作主语、宾语、定语；指各种各样的说法"},{"id":35343,"word":"穷贵极富","pinyin":"qióng guì jí fù","abbr":"qgjf","explanation":"形容极其富贵。","source":{"text":"故穷富极贵，不足以诱之焉。","book":"《汉书·王商史丹傅喜传》：“自宜、元、成、哀外戚兴者，许、史、三王、丁、傅之家，皆重侯累将，穷贵极富，见其位矣，未见其人也。”《抱朴子·畅玄》"},"example":{"text":"彦博虽～，而平居接物谦下，尊德乐善，如恐不及。","book":"《宋史·文彦博传》"},"similar":["穷富极贵"],"usage":"作谓语、定语；多用于富人"},{"id":35344,"word":"穷达有命","pinyin":"qióng dá yǒu mìng","abbr":"qdym","explanation":"指穷困或通达皆由命定。","source":{"text":"是故穷达有命，吉凶由人。","book":"汉·荀悦《汉纪·平帝纪》"},"example":{"text":"夫人～，不在巧图，惟忠孝乃吾事也。","book":"清·毕沅《续资治通鉴》卷一百五十一"},"similar":["穷通皆命"],"usage":"作宾语、定语；用于书面语"},{"id":35345,"word":"穷追不舍","pinyin":"qióng zhuī bù shě","abbr":"qzbs","explanation":"勇敢地追赶不放松。","source":{"text":"但是如果她是一个普通人家的女儿，我一定穷追不舍。","book":"林海音《婚姻的故事》"},"example":{"text":"我们对敌人要～，坚决打击。"},"similar":["穷追猛打"],"usage":"作谓语、定语、宾语；指追赶不放松"},{"id":35346,"word":"穷追猛打","pinyin":"qióng zhuī měng dǎ","abbr":"qzmd","explanation":"对于溃败的敌人不断追击。","source":{"text":"北军不敢穷追猛打，南军也不反攻，湖南战场就从此冷静下来了。","book":"陶菊隐《北洋军阀统治时期史话》第37章"},"example":{"text":"对落水狗要～。"},"usage":"作谓语、宾语；指不放弃打击"},{"id":35347,"word":"穷途之哭","pinyin":"qióng tú zhī kū","abbr":"qtzk","explanation":"本意是因车无路可行而悲伤，后也指处于困境所发的绝望的哀伤。","source":{"text":"阮籍猖狂，岂效穷途之哭！","book":"《晋书·阮籍传》：“时率意独驾，不由径路，车迹所穷，辄痛哭而返。”唐王勃《滕王阁序》"},"example":{"text":"阮籍猖狂，岂效～。","book":"唐·王勃《滕王阁序》"},"usage":"作宾语；指绝望的哀伤"},{"id":35348,"word":"穷途末路","pinyin":"qióng tú mò lù","abbr":"qtml","explanation":"穷途：处境困窘。形容到了无路可走的地步。","source":{"text":"子胥曰：‘夫人赈穷途，少饭亦何嫌哉？","book":"《吴越春秋·王僚伎公子光传》"},"example":{"text":"你如今是～，举目无依。（清·文康《儿女英雄传》第五回）"},"similar":["山穷水尽","走投无路"],"opposite":["四通八达","前途无量"],"usage":"作宾语、定语；指陷入绝境"},{"id":35349,"word":"穷途潦倒","pinyin":"qióng tú liáo dǎo","abbr":"qtld","explanation":"形容无路可走，十分失意。","source":{"text":"他的一生，尽管够得上是盘根错节，穷途潦倒的一生。","book":"傅抱石《前言》"},"example":{"text":"他过着～的一生。"},"similar":["穷途落魄"],"opposite":["平步青云"],"usage":"作定语；指人没有出路"},{"id":35350,"word":"穷途落魄","pinyin":"qióng tú luò pò","abbr":"qtlp","explanation":"比喻处境困难，潦倒失意。","source":{"text":"临海穷途落魄，幕府草檄，非必出于本心。","book":"清·陈熙晋《临海集序》"},"example":{"text":"她～，十分凄惨。"},"similar":["穷途潦倒"],"opposite":["青云直上"],"usage":"作谓语、定语；指人落魄失意"},{"id":35351,"word":"穷通得失","pinyin":"qióng tōng dé shī","abbr":"qtds","explanation":"穷：不得志；通：畅达。遭遇的坎坷与顺利，利益的得与失。指人生遭遇。","source":{"text":"看来此意无今昨。都不论、穷通得失，镇长和乐。","book":"宋·魏了翁《贺新郎·虞万州刚简生日用所惠词韵》词"},"example":{"text":"这个不过暂屈一时，～，本来没有一定的。","book":"清·吴趼人《二十年目睹之怪现状》第六十五回"},"usage":"作宾语、定语；用于人生"},{"id":35352,"word":"穷通皆命","pinyin":"qióng tōng jiē mìng","abbr":"qtjm","explanation":"指穷困或通达皆由命定。","source":{"text":"常恐填沟壑，无由振羽仪。穷通若有命，欲向论中推。","book":"汉·荀悦《汉纪·平帝纪》：“是故穷达有命，吉凶由人。”唐·孟浩然《晚春卧病寄张八》"},"example":{"text":"若论才艺，仲尼年少，便合封侯，～也。","book":"元·马致远《女冠子·枉了闲愁套·么篇》"},"similar":["穷达有命"],"usage":"作宾语、定语；用于书面语"},{"id":35353,"word":"穷酸饿醋","pinyin":"qióng suān è cù","abbr":"qsec","explanation":"指贫寒而迂腐的书生。","source":{"text":"与了一个富家，也不枉了；却与了这个穷酸饿醋。","book":"元·王实甫《西厢记》第五本第三折"},"example":{"text":"近日除将这个～来做个正知寨，这厮又是文官，又没本事。","book":"明·施耐庵《水浒传》第32回"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":35354,"word":"穷里空舍","pinyin":"qióng lǐ kōng shě","abbr":"qlks","explanation":"穷里：僻巷。指偏僻无人的地方。","source":{"text":"长安少年数人，会穷里空舍，谋共劫人。","book":"东汉·班固《汉书·赵广汉传》"},"similar":["穷乡僻壤"],"usage":"作宾语、定语；用于地方"},{"id":35355,"word":"穷阎漏屋","pinyin":"qióng yán lòu wū","abbr":"qylw","explanation":"穷阎：偏僻的里巷；漏屋：通“陋”，狭小的房屋。指僻陋狭小的住处。","source":{"text":"虽隐于穷阎漏屋，人莫不贵，贵道诚存也。","book":"《荀子·儒效》"},"similar":["穷巷陋室"],"usage":"作宾语、定语；指僻陋狭小的住处"},{"id":35356,"word":"穷陬僻壤","pinyin":"qióng zōu pì rǎng","abbr":"qzpr","explanation":"穷：贫穷；僻：偏僻。荒远偏僻的地方。","source":{"text":"穷陬僻壤，无一物之不遂。","book":"明·李时勉《北京赋》"},"similar":["穷乡僻壤"],"usage":"作主语、宾语、定语；指偏僻的地方"},{"id":35357,"word":"穷鸟入怀","pinyin":"qióng niǎo rù huái","abbr":"qnrh","explanation":"穷鸟：困窘的鸟；怀：投入怀抱。比喻处境困难而投靠别人。","source":{"text":"政投原曰：‘穷鸟入怀。’原曰：‘安知斯怀之可入邪？’","book":"《三国志·魏志·邴原传》：“政窘急，往投原。”裴松之注引《魏氏春秋》"},"example":{"text":"～，仁人所悯，况死士归我，当弃之乎！","book":"北齐·颜之推《颜氏家训·省事》"},"similar":["穷鸟投人","穷鸟归人"],"usage":"作宾语、定语；指人投靠别人"},{"id":35358,"word":"穷鸟归人","pinyin":"qióng niǎo guī rén","abbr":"qngr","explanation":"无处可飞的鸟被迫投入人的怀抱。比喻因处境艰难而投靠别人。","source":{"text":"夫穷鸟归人，尚或兴恻。","book":"《魏书·张普惠传》"},"similar":["穷鸟投人"],"usage":"作宾语、定语；用于人处于困境时"},{"id":35359,"word":"穷鸟投人","pinyin":"qióng niǎo tóu rén","abbr":"qntr","explanation":"投：投入。无处可飞的鸟被迫投入人的怀抱。比喻因处境艰难而投靠别人。","source":{"text":"穷鸟投人，尚或矜愍，况诸王如何弃乎？","book":"《北齐书·元韶传》"},"example":{"text":"《魏书·苏湛传》：“王本以～，赖朝廷假王羽翼，荣宠至此。”"},"similar":["穷鸟归人","穷鸟入怀"],"usage":"作宾语、定语；用于人处于困境时"},{"id":35360,"word":"穷鸟触笼","pinyin":"qióng niǎo chù lóng","abbr":"qncl","explanation":"穷：窘困。比喻处境窘迫而挣扎不脱。","source":{"text":"既知四隅断绝，百计奔冲，如穷鸟触笼，似飞蛾赴焰。","book":"《旧唐书·僖宗纪》"},"usage":"作宾语、定语；用于比喻句"},{"id":35361,"word":"穷鼠啮狸","pinyin":"qióng shǔ niè lí","abbr":"qsnl","explanation":"啮：咬；狸：狸猫。无路可逃的老鼠也会咬猫。比喻受人欺压，虽然敌不过，也会拼死抵抗。","source":{"text":"死不再生，穷鼠啮狸。","book":"汉·桓宽《盐铁论·诏圣》"},"similar":["困兽犹斗","狗急跳墙"],"usage":"作宾语、补语；指困兽犹斗"},{"id":35362,"word":"空中楼阁","pinyin":"kōng zhōng lóu gé","abbr":"kzlg","explanation":"悬在半空中的阁楼。比喻虚幻的事物或脱离实际的空想。","source":{"text":"空中结楼殿，意表出云霞。","book":"《史记·天官书》：“海旁蜃气象楼台，广野气成宫阙然。”唐·宋之问《游法华寺》诗"},"example":{"text":"实者，就事敷陈，不假造作，有根有据之谓也；虚者，～，随意构成，无影无形之谓也。","book":"清·李渔《闲情偶寄·结构第一》"},"similar":["虚无飘渺","海市蜃楼"],"opposite":["脚踏实地"],"usage":"作主语、宾语；指虚幻的事物","story":["从前一位非常富有的傻财主生性愚钝，尽做傻事。一天他到邻村的一位财主家做客，见他家有一栋三层楼十分漂亮，回家后找工匠也要盖一座一模一样的楼。工匠开始打地基，傻财主则指挥说：“你们不要盖一二层，只盖第三层就行。”"]},{"id":35363,"word":"空中结构","pinyin":"kòng zhōng jié gòu","abbr":"kzjg","explanation":"结构：构造房屋。比喻凭空虚构。","source":{"text":"当时用个骗法，一哄哄出，老翁那知是行者空中结构。","book":"《西游补》第13回"},"example":{"text":"我不相信他描绘的～。"},"usage":"作宾语；指虚无"},{"id":35364,"word":"空前未有","pinyin":"kōng qián wèi yǒu","abbr":"kqwy","explanation":"前所未有，以前从来没有的。","source":{"text":"须知正是在国民党十一中全会之后，内战危机是空前未有的。","book":"毛泽东《评国民党十一中全会和三届二次国民参政会》"},"example":{"text":"已经在1949年获得了全国范围内的胜利，实现了～的国家统一。","book":"邓小平《关于修改党的章程的报告》"},"similar":["前所未有"],"opposite":["司空见惯"],"usage":"作谓语、定语；用于唯一的东西"},{"id":35365,"word":"空前绝后","pinyin":"kōng qián jué hòu","abbr":"kqjh","explanation":"从前没有过，今后也不会再有。夸张性地形容独一无二。","source":{"text":"顾（顾恺之，晋代画家）冠于前，张（张僧繇，南朝梁代画家）绝于后，而道子（吴道子，唐代画家）乃兼有之。","book":"宋·赵佶《宣和画谱》"},"example":{"text":"祖孙三代倒做了三朝元老，真可以算得“～”的了。","book":"清·吴趼人《痛史》第十六回"},"similar":["绝无仅有","亘古未有","史无前例"],"opposite":["比比皆是"],"usage":"作谓语、定语；形容极不寻常的盛况","story":["晋朝大画家顾恺之所画人物神态逼真，形象生动。南朝梁代画家张僧繇善于画山水人物，传说他画龙点睛。唐朝画家吴道子集绘画与书法于一身，让人叫绝。后人说顾恺之的成就超越前人，张僧繇的成就后人莫及，吴道子则是空前绝后"]},{"id":35366,"word":"空口无凭","pinyin":"kōng kǒu wú píng","abbr":"kkwp","explanation":"单凭嘴说而没有什么作为凭据。只要用实物来证明。","source":{"text":"空口无凭的话，门生也不敢朝着老师来说。","book":"清·李宝嘉《官场现形记》第二十七回"},"example":{"text":"你说的这些事，～，我无法相信。"},"similar":["空话无凭","无凭无据"],"opposite":["铁证如山","白纸黑字"],"usage":"作宾语、定语；指无凭无据的空口白话"},{"id":35367,"word":"空口白话","pinyin":"kōng kǒu bái huà","abbr":"kkbh","explanation":"形容只说不实行，或只说而没有事实证明。","source":{"text":"我只道本利已在手了，原来还是空口说白话，眼饱肚中饥。","book":"明·冯梦龙《醒世恒言》卷三十五"},"example":{"text":"～，你们做官人，翻脸不认人，我可不上当，你须写上凭据来。","book":"清·曾朴《孽海花》第七回"}},{"id":35368,"word":"空口说白话","pinyin":"kōng kǒu shuō bái huà","abbr":"kksbh","explanation":"形容光说不做事，或光说而没有实际行动证明。","source":{"text":"凡好事口说则易，躬行则难。卿等既言之，须行之，勿空口说。","book":"《旧唐书·宪宗本纪》"},"example":{"text":"我与其坐冷板凳，听那牛郎中～，不如趁空来看看我们社里的红薯种。","book":"周立波《山那边人家》"},"similar":["空口白话"],"usage":"作谓语、宾语；形容光说不做事"},{"id":35369,"word":"空口说空话","pinyin":"kōng kǒu shuō kōng huà","abbr":"kkskh","explanation":"形容光说不做事，或光说而没有实际行动证明。","source":{"text":"你们广西有几百万人，不是几个人能够教得成的，也不是空口说空话可以算得事的。","book":"孙中山《说知难行易》"},"similar":["空口说白话"],"usage":"作谓语、宾语；形容光说不做事"},{"id":35370,"word":"空古绝今","pinyin":"kōng gǔ jué jīn","abbr":"kgjj","explanation":"古来不曾有过，今世也不会再有。指自古以来是独一无二。","source":{"text":"这人真是经天纬地之才，空古绝今之学。","book":"清·吴敬梓《儒林外史》第11回"},"similar":["空前绝后"],"usage":"作谓语、定语；用于独一无二"},{"id":35371,"word":"空城计","pinyin":"kōng chéng jì","abbr":"kcj","explanation":"指在危急处境下，掩饰空虚，骗过对方的策略。","source":{"text":"‘如魏兵到时，不可擅动，吾自有计。’孔明乃披鹤氅，戴纶巾，引二小童携琴一张，于城上敌楼前，凭栏而坐，焚香操琴。","book":"明·罗贯中《三国演义》第95回"},"example":{"text":"你不能老是用“～”"},"usage":"作宾语；指欺骗对手","story":["三国时期，魏国派司马懿挂帅进攻蜀国街亭，诸葛亮派马谡驻守失败。司马懿率兵乘胜直逼西城，诸葛亮无兵迎敌，但沉着镇定，大开城门，自己在城楼上弹琴。司马懿怀疑设有埋伏，引兵退去。等得知西城是空城回去再战，赵云赶回解围"]},{"id":35372,"word":"空大老脬","pinyin":"kōng dà lǎo pāo","abbr":"kdlp","explanation":"脬：膀胱。比喻虽然外表伟大，而实际则虚浮萎弱。"},{"id":35373,"word":"空头人情","pinyin":"kōng tóu rén qíng","abbr":"ktrq","explanation":"虚假的情意。","source":{"text":"贾琏笑道：‘罢，罢！这空头人情我不领；你不盘察我，就够了。’","book":"清·曹雪芹《红楼梦》"},"example":{"text":"你的～我领了。"},"similar":["虚情假意"],"opposite":["深情厚意"],"usage":"作主语、宾语、定语；指虚情假意"},{"id":35374,"word":"空头冤家","pinyin":"kōng tóu yuān jiā","abbr":"ktyj","explanation":"指没来由的冤家对头。","source":{"text":"看着康姨太太的行为，心上虽然有些疑惑，却想着大家井水不犯河水，又拿不着他的凭据，那个肯来做这样的空头冤家？","book":"清·张春帆《九尾龟》第一百二十回"},"example":{"text":"只要他见情于我，我又何苦同他做此～呢？","book":"清·李宝嘉《官场现形记》第五十七回"}},{"id":35375,"word":"空头支票","pinyin":"kōng tóu zhī piào","abbr":"ktzp","explanation":"空头：有名无实的。指不能兑现，即取不到钱的支票。比喻不准备实现的诺言。","source":{"text":"他们以为放出一个‘九年预备’的空头支票，可以缓和空气。","book":"邹韬奋《三十年前的民主运动》"},"example":{"text":"给到你手里的是什么呢？闹半天原来是一张～！","book":"杨沫《青春之歌》第二部第27章"},"similar":["言而无信","自食其言","食言而肥"],"opposite":["言而有信","一诺千金"],"usage":"作主语、宾语；指不能实现的诺言"},{"id":35376,"word":"空室清野","pinyin":"kōng shì qīng yě","abbr":"ksqy","explanation":"在对敌斗争时，把家里的东西和田里的农产品藏起来，使敌人到来后什么也得不到，什么也利用不上。","source":{"text":"今东方皆已收麦，必坚壁清野以待将军。","book":"《三国志·魏书·荀彧传》"},"example":{"text":"沿途不是闭栅放炮，就是～，桂军只好一路以抢掠为生，军纪愈发废弛。","book":"刘凤舞《民国春秋》第三十九章"},"similar":["空舍清野"],"usage":"作谓语、定语；同“坚壁清野”"},{"id":35377,"word":"空室蓬户","pinyin":"kōng shì péng hù","abbr":"ksph","explanation":"空室：空屋子；蓬户：简陋的茅屋草舍。形容穷困，住着破旧简陋的房屋。","source":{"text":"故季饮、原宪终身空室蓬户，褐衣疏食不厌。死而已四百余年，而弟子志之不倦。","book":"《史记·游侠列传》"}},{"id":35378,"word":"空对空","pinyin":"kōng duì kōng","abbr":"kdk","explanation":"空：没有内容。以空头对付空头。形容空虚不实。","source":{"text":"皆从妄所妄，无非空对空。","book":"南朝·梁·武帝《灵空》"}},{"id":35379,"word":"空心架子","pinyin":"kōng xīn jià zǐ","abbr":"kxjz","explanation":"空话、谎言或无实际内容的东西。","source":{"text":"人也不认得，你在那个面前捣鬼，扯甚么空心架子！","book":"明·吴承恩《西游记》第24回"},"usage":"作主语、宾语、定语；用于无实际内容"},{"id":35380,"word":"空心汤团","pinyin":"kōng xīn tāng tuán","abbr":"kxtt","explanation":"比喻徒有虚名而无实利或不能落实的诺言。","source":{"text":"他等了半天，末了吃个空心汤团。","book":"叶圣陶《外国旗》"},"example":{"text":"我不相信他的～。"},"similar":["空心汤圆"],"usage":"作宾语、定语；指空话"},{"id":35381,"word":"空心汤圆","pinyin":"kōng xīn tāng yuán","abbr":"kxty","explanation":"比喻徒有虚名而无实利或不能落实的诺言。","source":{"text":"华盛顿也许要来‘周年’：重申《九国条约》，再给高等华人空心汤圆。","book":"茅盾《“九一八”周年》"},"example":{"text":"别指望他许给你的～。"},"similar":["空心汤团"],"usage":"作宾语、定语；指空话"},{"id":35382,"word":"空心老大","pinyin":"kōng xīn lǎo dà","abbr":"kxld","explanation":"指装腔作势、无真实本领的人。","source":{"text":"读者自有确当的批判，不再受空心老大的欺骗了。","book":"鲁迅《且介亭杂文末编·苏联作家七人集序》"},"example":{"text":"他其实就是典型的～。"},"similar":["空心萝卜"],"usage":"作主语、宾语、定语；指无真实本领的人"},{"id":35383,"word":"空心老官","pinyin":"kōng xīn lǎo guān","abbr":"kxlg","explanation":"形容表面阔绰实际并没有钱的人。","source":{"text":"所以那空心大老官居然成为上海的土产物。","book":"清·吴趼人《二十年目睹之怪现状》第一回"}},{"id":35384,"word":"空心萝卜","pinyin":"kōng xīn luó bó","abbr":"kxlb","explanation":"比喻无用，肚里无货的人。","example":{"text":"别看他们咋呼老百姓吹胡子瞪眼睛挺有能耐，其实呀，都是些～。"},"similar":["空心老大"],"usage":"作宾语、定语；指无真实本领的人"},{"id":35385,"word":"空手套白狼","pinyin":"kōng shǒu tào bái láng","abbr":"kstbl","explanation":"徒手抓住白狼。指无本买卖。","source":{"text":"我们都是急性子，无利不起早，讲究的是空手套白狼。","book":"王朔《玩儿的就是心跳》"},"usage":"作宾语、定语；用于口语"},{"id":35386,"word":"空拳赤手","pinyin":"kōng quán chì shǒu","abbr":"kqcs","explanation":"赤手：空手。两手空空，一无所有。比喻无任何凭借或一无所有","source":{"text":"正在那里耀武扬威，看他空拳赤手打得一班家人走投无路，喊痛叫天。","book":"清·无垢道人《八仙全传》第五回"},"similar":["赤手空拳"],"usage":"作谓语、定语、状语；用于书面语"},{"id":35387,"word":"空有其表","pinyin":"kōng yǒu qí biǎo","abbr":"kyqb","explanation":"表：表面，外貌。空有好看的外表，实际上不行。指有名无实。","source":{"text":"嵩既成，上掷其草于地，曰：‘虚有其表耳。’","book":"唐·郑处诲《明皇杂录》"},"example":{"text":"仆以君有胆力，故来一窥梗概，不谓～，直一无胆懦夫耳。","book":"清·沈起凤《谐铎·镜戏》"}},{"id":35388,"word":"空洞无物","pinyin":"kōng dòng wú wù","abbr":"kdww","explanation":"空空洞洞，没有什么内容。多指言谈、文章极其空泛。","source":{"text":"此中空洞无物，然容卿辈数百人。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"出了口吻、技巧和声调之外，八股文里是～的。","book":"朱自清《经典常谈·文第十三》"},"similar":["空空如也","有名无实"],"opposite":["名副其实","言之有物"],"usage":"作谓语、宾语、定语；用于文章及说话","story":["东晋时期，大臣周伯仁很有名望，他谈吐幽默诙谐，为人宽宏大量，不拘小节。曾经辅助司马睿建立东晋的丞相王导与他私交很好。一天王导指着周伯仁的肚子问里面有什么。周伯仁回答说：“空洞无物，但可装下几百个像你这样的人。”"]},{"id":35389,"word":"空穴来风","pinyin":"kōng xué lái fēng","abbr":"kxlf","explanation":"穴：孔、洞；来：招致。有了洞穴才进风。比喻消息和谣言的传播不是完全没有原因的。也比喻流言乘机会传开来。","source":{"text":"臣闻于师：枳句来巢，空穴来风。","book":"战国·楚·宋玉《风赋》"},"example":{"text":"然而银行当事人，安能逃避责任，～，理有固然。","book":"清·梁启超《续论市民与银行》"},"similar":["流言蜚语","无中生有","捕风捉影"],"opposite":["斑斑可考"],"usage":"作谓语、宾语、定语；指流言蜚语","story":["战国时期，宋玉陪楚顷襄王到兰台游玩，楚王迎着凉风感慨他与百姓共享它，宋玉借风劝谏他说：“枳句来巢，空穴来风”，不同条件会产生不同的风，你的风经过明山秀水是芳香的，百姓身处陋巷混浊之地是腐臭的"]},{"id":35390,"word":"空空如也","pinyin":"kōng kōng rú yě","abbr":"kkry","explanation":"空空：诚恳，虚心。原形容诚恳、虚心的样子。现形容一无所有。","source":{"text":"有鄙夫问于我，空空如也，我叩其两端而竭焉。","book":"《论语·子罕》"},"example":{"text":"多少只眼睛也都向王忠的座位搜寻的时候，却见这个小人儿的座位早已～。","book":"杨沫《青春之歌》第二部第三十八章"},"similar":["一无所知","一无所有"],"opposite":["应有尽有"],"usage":"作谓语、定语；形容一无所有","story":["春秋时期，有人对孔子十分崇拜，恭维孔子知识渊博，孔子不承认自己很有学问，他说自己到乡下去见到农民们驾轻就熟地干他们的农活，农夫问他“空空如也”的含义，他反复推究才有所领悟，然后尽量告诉他准确的含义"]},{"id":35391,"word":"空空妙手","pinyin":"kōng kōng miào shǒu","abbr":"kkms","explanation":"指小偷。也形容手中一无所有。","source":{"text":"后夜当使妙手空空儿继至。空空儿之神术，人莫能窥其用，鬼莫得蹑其踪。","book":"宋·李昉《太平广记》卷一百九十四引裴刑《传奇·聂隐娘》"}},{"id":35392,"word":"空空洞洞","pinyin":"kōng kōng dòng dòng","abbr":"kkdd","explanation":"空虚，空无所有。","source":{"text":"为什么一定要写得那么长，又那么空空洞洞的呢？只有一种解释，就是下决心不让群众看。","book":"毛泽东《反对党八股》"},"example":{"text":"一间～的房屋，又脏又冷。"},"similar":["空洞无物"],"opposite":["实实在在"],"usage":"作谓语、定语；指空无所有"},{"id":35393,"word":"空空荡荡","pinyin":"kōng kōng dàng dàng","abbr":"kkdd","explanation":"形容冷冷清清，空无所有的情景或指心里没着落的感觉。","source":{"text":"小学院子里刹那间就一片空空荡荡了。","book":"路遥《平凡的世界》第一卷第九章"},"example":{"text":"一切已被收拾得干干净净，也～。","book":"章诒和《往事并不如烟·一片青山了此身》"},"similar":["空空如也","冷冷清清"],"usage":"作谓语、定语、状语；用于口语"},{"id":35394,"word":"空群之选","pinyin":"kōng qún zhī xuǎn","abbr":"kqzx","explanation":"群众之中所没有的人选。指才能出众的人。"},{"id":35395,"word":"空腹便便","pinyin":"kōng fù pián pián","abbr":"kfpp","explanation":"便便：肥胖的样子。比喻并无真才实学。","source":{"text":"峥嵘岁月还秋暮，空腹便便无好句。","book":"宋·廖行之《青玉案》词"},"similar":["腹中空空"],"usage":"作谓语、定语；指无真才实学"},{"id":35396,"word":"空腹高心","pinyin":"kōng fù gāo xīn","abbr":"kfgx","explanation":"腹内空虚而目空一切。形容并无真才实学。","source":{"text":"假金方用真金镀，若是真金不镀金。十载长安得一第，何须空腹用高心。","book":"五代·王定保《唐摭言·矛盾》"},"example":{"text":"至于大姓，实不过承祖宗余荫，以旧业骄人，～，当然使人不耐。","book":"鲁迅《坟·论“他妈的”》"},"similar":["眼高手低"],"opposite":["真才实学"],"usage":"作谓语、定语；指无真才实学"},{"id":35397,"word":"空臆尽言","pinyin":"kōng yì jìn yán","abbr":"kyjy","explanation":"臆：胸。胸中毫无隐藏，把知道的东西全都说出来。","source":{"text":"今蕡所对，敢空臆尽言，汉魏以来，无与蕡比。","book":"《新唐书·刘蕡传》"},"usage":"作谓语；用于说话"},{"id":35398,"word":"空花阳焰","pinyin":"kōng huā yáng yàn","abbr":"khyy","explanation":"空花：虚幻之花；阳焰：日光中浮动的烟尘。比喻不切实际的想法。","example":{"text":"你的这个计划如同～一样不实用。"},"usage":"作宾语、定语；用于比喻句"},{"id":35399,"word":"空言无补","pinyin":"kōng yán wú bǔ","abbr":"kywb","explanation":"指空洞不切实际的言论，于事无补。","source":{"text":"孔子作春秋，空言无补，乱臣贼子何缘便惧？且何足为春秋之一治？","book":"宋·朱《朱子语类·孟子五》"},"example":{"text":"或狃于老成忧国，以为旧章必应墨守，新法必当摈除。众喙哓哓，～。","book":"蔡东藩《清史演义》第八十六回"},"similar":["空谈无补"],"usage":"作谓语、定语、宾语；用于说话"},{"id":35400,"word":"空言虚语","pinyin":"kōng yán xū yǔ","abbr":"kyxy","explanation":"不实在的话语。","source":{"text":"吾闻帝贤者有也，空言虚语，非所守也，吾不敢当帝位。","book":"西汉·司马迁《史记·高祖本纪》"},"example":{"text":"～，虽得道心，人犹不信。","book":"东汉·王充《论衡·薄葬》"},"similar":["浮文巧语"],"usage":"作主语、宾语、定语；指不实在的话语","story":["楚汉相争时期，刘邦与韩信、彭越合兵围攻项羽，项羽在乌江兵败自刎。各路诸侯与刘邦手下的大臣纷纷要求刘邦称帝，刘邦谦虚地说只有贤人才能称帝，空言虚语的人不能登基。在众人的强烈要求下，刘邦在汜水北岸祭天登基"]},{"id":35401,"word":"空言虚辞","pinyin":"kōng yán xū cí","abbr":"kyxc","explanation":"不实在的话语。","source":{"text":"至治之世，其民不好空言虚辞。","book":"《吕氏春秋·知度》"},"example":{"text":"言仙道洪濛不可识，如王乔赤松，皆～，迂怪难信，当观圣道而已。","book":"唐·吴兢《乐府古题要解·长歌行》"}},{"id":35402,"word":"空话连篇","pinyin":"kōng huà lián piān","abbr":"khlp","explanation":"连篇：整篇。整篇都是空话，缺乏具体内容。","source":{"text":"党八股的第一条罪状是：空话连篇，言之无物。","book":"毛泽东《反对党八股》"},"example":{"text":"我不喜欢～的文章。"},"similar":["废话连篇"],"opposite":["言之有据"],"usage":"作宾语、定语；指内容空洞"},{"id":35403,"word":"空谈快意","pinyin":"kōng tán kuài yì","abbr":"ktky","explanation":"快意：使内心感到痛快。信口开河地高谈阔论，却不付诸行动，只是为了口头痛快。","source":{"text":"或者只是空谈快意，并不准备真正去做。","book":"毛泽东《论持久战》"},"example":{"text":"别被他的～迷惑了。"},"similar":["信口开河"],"usage":"作宾语；指口头痛快"},{"id":35404,"word":"空谈无补","pinyin":"kōng tán wú bǔ","abbr":"ktwb","explanation":"空洞不切实际的言论于事没有帮助。","source":{"text":"少许胜人，空谈无补。","book":"《新笑史》"},"similar":["空言无补"],"usage":"作谓语、定语、宾语；用于说话"},{"id":35405,"word":"空谷之音","pinyin":"kōng gǔ zhī yīn","abbr":"kgzy","explanation":"在寂静的山谷里听到的声音。比喻极难得到音信、言论或来访。","source":{"text":"闻人足音跫然而喜也。","book":"《诗经·小雅·白驹》：“皎皎白驹，在彼空谷。”《庄子·徐无鬼》"},"example":{"text":"得手书，如～，弟谓兄真可安心矣。","book":"明·袁宏道《答陶周望》"}},{"id":35406,"word":"空谷传声","pinyin":"kōng gǔ chuán shēng","abbr":"kgcs","explanation":"在山谷里叫喊一声，立刻听到回声。比喻反应极快。","source":{"text":"空谷传声，虚堂习听。","book":"南朝·梁·萧衍《净业赋》：“若空谷之应声，似游形之有影。”南朝·梁·周兴嗣《千字文》"},"example":{"text":"兰芬又教众人“～”。","book":"清·李汝珍《镜花缘》第七十九回"},"similar":["立竿见影"],"opposite":["杳无音信"],"usage":"作宾语；形容说话、做事立刻就有效应"},{"id":35407,"word":"空谷幽兰","pinyin":"kōng gǔ yōu lán","abbr":"kgyl","explanation":"山谷中优美的兰花。形容十分难得，常用来比喻人品高雅。","source":{"text":"空谷幽兰，真想不到这种地方，会有这样高人。","book":"清·刘鹗《老残游记》第五回"},"example":{"text":"她素来以貌美自负，而今见了这个少女，宛如～，既清且艳，顿觉自愧不如。","book":"梁羽生《萍踪侠影录》第十八回"},"usage":"作宾语、定语；指人的人品"},{"id":35408,"word":"空谷白驹","pinyin":"kōng gǔ bái jū","abbr":"kgbj","explanation":"驹：小壮的马。很好的一匹折马，却放在山谷里不用。比喻不能任用贤能。","source":{"text":"皎皎白驹，在彼空谷。","book":"《诗经·小雅·白驹》"},"usage":"作宾语、定语；用于比喻句"},{"id":35409,"word":"空谷足音","pinyin":"kōng gǔ zú yīn","abbr":"kgzy","explanation":"在寂静的山谷里听到脚步声。比喻极难得到音信、言论或来访。","source":{"text":"闻人足音跫然而喜也。","book":"《诗经·小雅·白驹》：“皎皎白驹，在彼空谷。”《庄子·徐无鬼》"},"example":{"text":"幸～，得见君子，机缘难再，千载一时，故忍耻相投。","book":"清·纪昀《阅微草堂笔记》卷十七"},"similar":["稀世之珍","千载难逢","凤毛麟角"],"opposite":["多如牛毛","门庭若市","比比皆是"],"usage":"作宾语；形容事物等"},{"id":35410,"word":"空谷跫音","pinyin":"kōng gǔ qióng yīn","abbr":"kgqy","explanation":"跫：脚踏地的声音。在寂静的山谷里听到脚步声。比喻极难得到音信、言论。","source":{"text":"《柏舟》之诗，不作久矣，余于妇庄，宁不若闻空谷跫音乎！","book":"明·宋濂《贞节堂记》"},"similar":["空谷足音"],"usage":"作宾语；形容事物等"},{"id":35411,"word":"空费词说","pinyin":"kōng fèi cí shuō","abbr":"kfcs","explanation":"说的话别人不听，等于白说。","source":{"text":"仆有一计，于兄甚便。只恐兄溺 枕席之爱，未必能行，使仆空费词说耳！","book":"明·冯梦龙《警世通言》卷三十三"},"similar":["白费口舌"],"usage":"作谓语、宾语；指白费口舌"},{"id":35412,"word":"穿一条裤子","pinyin":"chuān yī tiáo kù zǐ","abbr":"cytkz","explanation":"比喻两人关系密切，利害一致，遇事持同样的态度。","source":{"text":"你们穿一条裤子，早编好了哄我的话。","book":"刘绍棠《田野落霞》"},"example":{"text":"贪官和这些奸商～，一起欺诈老百姓。"},"similar":["一个鼻孔出气"],"usage":"作谓语、定语；用于口语"},{"id":35413,"word":"穿云裂石","pinyin":"chuān yún liè shí","abbr":"cyls","explanation":"穿破云天，震裂石头。形容声音高亢嘹亮。","source":{"text":"善吹铁笛，嘹然有穿云裂石之声。","book":"宋·苏轼《〈水龙吟〉序》"},"example":{"text":"一个小小子走到鲍廷玺身边站着，拍着手，唱李太白《清平调》。真乃～之声，引商刻羽之奏。","book":"清·吴敬梓《儒林外史》第二十九回"},"similar":["震耳欲聋"],"usage":"作谓语、定语；形容声音之激越"},{"id":35414,"word":"穿井得人","pinyin":"chuān jǐng dé rén","abbr":"cjdr","explanation":"穿井：打井。指家中打井后省得一个劳力，却传说成打井时挖得一个人。比喻话传来传去而失真。","source":{"text":"丁氏穿家井，井中得一人。","book":"汉·王充《论衡·书虚》"},"example":{"text":"我们经常会碰到“～”之类的谣言。"},"similar":["丁公凿井"],"usage":"作宾语、定语；指谣言","story":["传说春秋时宋国有一个姓丁的人家家里没有水井，每天要到外面很远的地方取水。后来他请人和自己一起打水井，他觉得自己上阵省了一个劳动力，于是逢人便说：“吾穿井得一人”。外面就把这句话传成了丁家打井挖到了一个人"]},{"id":35415,"word":"穿凿傅会","pinyin":"chuān záo fù huì","abbr":"czfh","explanation":"生拉硬扯，牵强解释。","source":{"text":"与夫五行之学，皆出于异端穿凿傅会之私，儒者不宜据以解经。","book":"明·王廷相《答许廷纶》"},"similar":["穿凿附会"],"usage":"作谓语、定语、状语；用于说话等"},{"id":35416,"word":"穿凿附会","pinyin":"chuān záo fù huì","abbr":"czfh","explanation":"穿凿：把讲不通的硬要讲通；附会：把不相干的事拉在一起。把讲不通的或不相干的道理、事情硬扯在一起进行解释。","source":{"text":"用是知好奇者欲穿凿附会固各有说云。","book":"宋·洪迈《容斋续笔·义理之说无穷》卷二"},"example":{"text":"但在解释经文的时候，却往往一个字一个字的咬嚼；这一咬嚼，便不顾上下文～起来了。","book":"朱自清《经典常谈·春秋三传第六》"},"similar":["牵强附会"],"opposite":["融会贯通"],"usage":"作谓语、宾语、定语；同“牵强附会”"},{"id":35417,"word":"穿壁引光","pinyin":"chuān bì yǐn guāng","abbr":"cbyg","explanation":"穿：凿通；引：引进。凿通墙壁，引进烛光。形容家贫读书刻苦。","source":{"text":"匡衡字稚圭，勤学而无烛，邻舍有烛而不逮。衡乃穿壁引其光，以书映光而读之。","book":"晋·葛洪《西京杂记》第二卷"},"example":{"text":"～的故事一直鼓励着我。"},"similar":["凿壁偷光"],"usage":"作谓语、定语；指人读书刻苦","story":["西汉宰相匡衡从小因为家贫，没有条件进学堂，他白头帮人干活，晚上没钱买灯油，就只好在家里土墙上凿一个洞，借隔壁的灯光来读书，甚至到有书的人家去免费帮工换取书本，他刻苦学习终于在汉元帝时期当上太子少傅"]},{"id":35418,"word":"穿房入户","pinyin":"chuān fáng rù hù","abbr":"cfrh","explanation":"在人家内室里出出进进。形容和主人的关系极为密切。","source":{"text":"两只脚穿房入户，一双手偷东拿西。","book":"元·关汉卿《四春园》第二折"},"example":{"text":"只有牙婆是～的，女眷们怕冷静时，十个九个倒要扳她来往。","book":"明·冯梦龙《古今小说》卷一"},"usage":"作谓语、定语；形容和主人的关系极为密切"},{"id":35419,"word":"穿房过屋","pinyin":"chuān fáng guò wū","abbr":"cfgw","explanation":"比喻友情深厚，往来密切，妻儿不避。"},{"id":35420,"word":"穿文凿句","pinyin":"chuān wén záo jù","abbr":"cwzj","explanation":"钻研文字，琢磨词句。后用作为文牵强附会之意。","source":{"text":"君年少，何以轻穿文凿句，而妄讥诮老子耶？","book":"《艺文类聚》卷七九引南朝·宋·刘义庆《幽明录》"},"similar":["雕章琢句"],"usage":"作谓语、宾语；用于作文等"},{"id":35421,"word":"穿杨贯虱","pinyin":"chuān yáng guàn shī","abbr":"cygs","explanation":"战国时养由基射箭能百步穿杨，纪昌射箭能正中虱心。事见《战国策·西周策》和《列子·汤问》。后形容技艺高超。","source":{"text":"但战阵之上，洞胸彻札，功必归于挽强者。而下力倘能穿杨贯虱，则以巧胜也。","book":"明·宋应星《天工开物·弧矢》"},"example":{"text":"科举自来皆撞着，必无～之技。","book":"明·归有光《与沈敬甫书》"},"usage":"作谓语、宾语、定语；用于人的箭术"},{"id":35422,"word":"穿着打扮","pinyin":"chuān zhuó dǎ bàn","abbr":"czdb","explanation":"穿戴的服饰形式。","example":{"text":"一个人的～可以反映出这个人的身份和素养。"},"similar":["穿红着绿"],"usage":"作主语、宾语；指人的穿戴的服饰形式"},{"id":35423,"word":"穿穴逾墙","pinyin":"chuān xué yú qiáng","abbr":"cxyq","explanation":"指偷窃行为。","source":{"text":"坎之为卦，外阴柔而内刚狠，有穿穴逾墙乘墉伏莽之状也。","book":"明·杨慎《〈易·说卦〉“坎为盗”》"},"usage":"作谓语、宾语；指偷盗"},{"id":35424,"word":"穿窬之盗","pinyin":"chuān yú zhī dào","abbr":"cyzd","explanation":"穿：指穿壁；窬：通“逾”，从墙上爬过去。从墙上爬过去。指钻洞和爬墙的盗贼。","source":{"text":"色厉而内荏，譬诸小人，其犹穿窬之盗也与！","book":"《论语·阳货》"},"example":{"text":"伤残犹剽掠之徒，贪鄙胜～。","book":"清·钱彩《说岳全传》第七十三回"},"similar":["梁上君子"],"usage":"作宾语；指盗贼"},{"id":35425,"word":"穿红着绿","pinyin":"chuān hóng zhuó lǜ","abbr":"chzl","explanation":"形容衣着鲜艳华丽。","source":{"text":"那颜俊虽丑陋，最好妆扮，穿红着绿，低声强笑，自以为美。","book":"明·冯梦龙《醒世恒言·钱秀才错占凤凰俦》"},"example":{"text":"台阶上坐着几个～的丫头。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["穿着打扮"],"usage":"作谓语；形容衣着鲜艳华丽"},{"id":35426,"word":"穿花纳锦","pinyin":"chuān huā nà jǐn","abbr":"chnj","explanation":"以穿纱的方法做成的刺绣花样。","source":{"text":"行者一一观之，都是些穿花纳锦，刺绣销金之物。","book":"明·吴承恩《西游记》第十六回"}},{"id":35427,"word":"穿花蛱蝶","pinyin":"chuān huā jiá dié","abbr":"chjd","explanation":"穿戏花丛中的蝴蝶。后以喻迷恋女色者。","source":{"text":"穿花蛱蝶深深见，点水蜻蜓款款飞。","book":"唐·杜甫《曲江》诗之二"},"example":{"text":"只为师兄五戒，暗淫女子红莲，戒犯如来，身沉恶道。～，暂夺了座右鹦哥；戏水鸳鸯，权当了佛前狮子。","book":"明·陈汝元《红莲债》第二折"},"usage":"作宾语、定语；用于好色"},{"id":35428,"word":"穿荆度棘","pinyin":"chuān jīng dù jí","abbr":"cjdj","explanation":"穿越荆棘丛生处。比喻多经艰难路途。","source":{"text":"原来那孙大圣与八戒、沙僧，牵着马，挑着担，一夜不曾住脚，穿荆度棘，东寻西找。","book":"明·吴承恩《西游记》第六十四回"},"usage":"作谓语、宾语、定语；用于旅途"},{"id":35429,"word":"穿衣吃饭","pinyin":"chuān yī chī fàn","abbr":"cycf","explanation":"指人的基本需求。","source":{"text":"军队的人数增加很多，军费开支占国家预算的比重增大，把很多钱花费在人员的穿衣吃饭上面。","book":"邓小平《军队要整顿》"},"similar":["衣食住行"],"usage":"作主语、宾语、定语；指人的基本需要"},{"id":35430,"word":"穿针引线","pinyin":"chuān zhēn yǐn xiàn","abbr":"czyx","explanation":"使线的一头通过针眼。比喻从中联系、拉拢。","source":{"text":"万乞吴二娘怎生做个方便，到黄府亲见小姐询其下落，做个穿针引线之人。","book":"汉·刘向《说苑·善说》：“缕困针而入，不因针而急；嫁女因媒而成，不因媒而亲。”明·周楫《西湖二集》卷一二"},"example":{"text":"从前是贩卖云土和军火的大商人，现在给老头子和外国人～……。","book":"梁信《从奴隶到将军》上集第二章"},"similar":["牵线搭桥"],"opposite":["挑拨离间"],"usage":"作谓语、定语；指起中间联系作用"},{"id":35431,"word":"穿针走线","pinyin":"chuān zhēn zǒu xiàn","abbr":"czzx","explanation":"像穿针走线活动样地表演或行动。","example":{"text":"他忙得～似的不停顿。"},"usage":"作定语、状语；指不停顿"},{"id":35432,"word":"穿靴带帽","pinyin":"chuān xuē dài mào","abbr":"cxdm","explanation":"原指官员的打扮。现也比喻在文章的开头和结尾生硬地加上公式化的套话。","source":{"text":"捷讥的扮官员穿靴带帽，付净的取笑搽土抹灰。","book":"《雍熙乐府·第五卷·点绛唇（风月佳期）》"}},{"id":35433,"word":"穿靴戴帽","pinyin":"chuān xuē dài mào","abbr":"cxdm","explanation":"穿着衣服鞋帽的方式或习惯。比喻在写文章或讲话的前后硬加进一些例行的政治说教。","source":{"text":"捷讥的扮官员穿靴戴帽，付净的取欢笑搽土抹灰。","book":"《雍熙乐府》第五卷"},"example":{"text":"～，各有所好。"},"similar":["穿鞋戴帽"],"usage":"作主语、宾语；指穿着衣服鞋帽的方式或习惯"},{"id":35434,"word":"突兀森郁","pinyin":"tū wù sēn yù","abbr":"twsy","explanation":"突兀：山峰高高耸起的样子；森郁：形容树木多而茂盛。形容山势险峻，树木繁茂。","example":{"text":"看那山势时而层峦叠嶂，时而～，景观煞是迷人。"}},{"id":35435,"word":"突如其来","pinyin":"tū rú qí lái","abbr":"trql","explanation":"突如：突然。出乎意料地突然发生。","source":{"text":"突如其来如，焚如死如弃如。","book":"《易·离》"},"example":{"text":"其在前曰：真为素昧平生，～，难怪妾之得罪。","book":"元·王实甫《西厢记》第二本第三折"},"similar":["出乎意料","从天而降"],"opposite":["不出所料"],"usage":"作定语、状语；形容突发事件"},{"id":35436,"word":"突梯滑稽","pinyin":"tū tī huá jī","abbr":"tthj","explanation":"突梯：圆滑的样子；滑稽：圆转随俗。委婉顺从，圆滑而随俗。","source":{"text":"将突梯滑稽，如脂如韦，以洁楹乎。","book":"战国·楚·屈原《卜居》"},"example":{"text":"郭沫若《创造十年续篇》：“吴稚晖在那儿发表过一些～的论文，把读书界轰动过一下。”"},"usage":"作谓语、宾语；用于书面语"},{"id":35437,"word":"突然袭击","pinyin":"tū rán xí jī","abbr":"trxj","explanation":"指军事上出其不意地攻击。","source":{"text":"使用的战术差不多，出其不意的突然袭击。","book":"胡雪《惊人相似的一幕》"},"example":{"text":"对同志不能搞～。"},"usage":"作谓语、宾语；指军事上出其不意地进攻"},{"id":35438,"word":"突飞猛进","pinyin":"tū fēi měng jìn","abbr":"tfmj","explanation":"突、猛：形容急速。形容进步和发展特别迅速。","source":{"text":"进步文化的突飞猛进，虽有利于国家民族，虽有利于人民大众，但却是顽固派反动派的莫大的障碍物。","book":"邹韬奋《患难馀生记》第三章"},"example":{"text":"他本期学习成绩～。"},"similar":["日新月异","一日千里"],"opposite":["停滞不前","江河日下","老牛破车"],"usage":"作谓语、宾语、定语；指快速"},{"id":35439,"word":"窃位素餐","pinyin":"qiè wèi sù cān","abbr":"qwsc","explanation":"素：空；餐：吃饭，指俸禄。窃居高位，无功受禄。旧指高级官员饱食终日，无所用心。后也用作谦词。","source":{"text":"已负窃位素餐之责久矣。","book":"《汉书·杨恽传》"},"example":{"text":"孔子作《春秋》而乱臣贼子惧；梁竦作《七序》而～者惭。","book":"明·李贽《初潭集·师友二》"},"similar":["饱食终日"],"usage":"作谓语、定语；用作谦词"},{"id":35440,"word":"窃势拥权","pinyin":"qiè shì yōng quán","abbr":"qsyq","explanation":"窃：盗取。盗用别人的权势。","source":{"text":"窃势拥权，黩明王之彝典；穷奢纵侈，假凶竖之余威。","book":"《晋书·王国宝传论》"},"usage":"作谓语、宾语；多用于奸臣等"},{"id":35441,"word":"窃啮斗暴","pinyin":"qiè niè dòu bào","abbr":"qndb","explanation":"啮：咬。老鼠偷食啃东西，互相争斗。","source":{"text":"昼累累与人兼行，夜则窃啮斗暴，其声万状，不可以寝。","book":"唐·柳宗元《三戒·永某氏之鼠》"}},{"id":35442,"word":"窃幸乘宠","pinyin":"qiè xìng chéng chǒng","abbr":"qxcc","explanation":"指窃取和利用皇帝的宠信。","source":{"text":"中常侍张让等窃幸乘宠，浊乱海内。","book":"《三国志·魏书·董卓传》"}},{"id":35443,"word":"窃弄威权","pinyin":"qiè nòng wēi quán","abbr":"qnwq","explanation":"指玩弄权柄。","source":{"text":"骠骑谘议参军茹千秋协辅宰相，起自微贱，窃弄威权，衒卖天官。","book":"《晋书·简文三子传》"},"example":{"text":"长孙无忌，～，构害忠良，宗社有灵，应当族灭，勿谓福可长享呢！","book":"蔡东藩《唐史演义》第二十四回"},"usage":"作谓语、定语、宾语；用于官场等"},{"id":35444,"word":"窃据要津","pinyin":"qiè jù yào jīn","abbr":"qjyj","explanation":"比喻用阴谋手段占据重要的职位。","source":{"text":"若夫暗藏之汪精卫则招摇过市，窃据要津；匿影藏形，深入社会。","book":"毛泽东《向国民党的十点要求》"},"usage":"作谓语；指占据重要地位"},{"id":35445,"word":"窃时肆暴","pinyin":"qiè shí sì bào","abbr":"qssb","explanation":"老鼠放肆地偷吃东西。比喻得势时胡作非为，横行霸道。","example":{"text":"你不要～。"},"similar":["得意忘形","为所欲为"],"usage":"作宾语、定语；指肆无忌惮","story":["唐朝文学家柳宗元在《永某氏之鼠》中讲述一个这样的故事：永州一个属鼠的人特别喜欢老鼠，不准手下人捕捉老鼠，任其在家胡作非为，咬烂粮仓和衣服，明目张胆地四处活动。不久他搬家了，新主人进驻，下令把老鼠消灭过精光"]},{"id":35446,"word":"窃玉偷花","pinyin":"qiè yù tōu huā","abbr":"qyth","explanation":"窃玉：指唐朝杨贵妃偷窃宁王玉笛。比喻男女私通。","source":{"text":"你犯天条，窃玉偷花，不想落地狱，带锁披枷。","book":"明·孟称舜《死里逃生》第一出"},"similar":["窃玉偷香"],"usage":"作谓语、定语、宾语；指男女私通"},{"id":35447,"word":"窃玉偷香","pinyin":"qiè yù tōu xiāng","abbr":"qytx","explanation":"比喻引诱妇女。","source":{"text":"时西域有贡奇香，一著人则经月不歇，帝甚贵之，惟以赐充及大司马陈骞。其女密盗以遗寿，充僚属与寿燕处，闻其芬馥，称之于充。……","book":"《晋书·贾充传》"},"example":{"text":"则这～的急心性，冷落了那画屏。","book":"元·张寿卿《红梨花》第二折"},"similar":["窃玉偷花","弄玉偷香"],"usage":"作谓语、定语；指男女私通"},{"id":35448,"word":"窃窃偶语","pinyin":"qiè qiè ǒu yǔ","abbr":"qqoy","explanation":"窃窃：偷偷；语：说话。背地里小声说话。","source":{"text":"每窃窃偶语，不知议何事。","book":"《金史·唐括辩传》"},"similar":["窃窃私语","窃窃私议","窃窃细语"],"usage":"作谓语、定语；用于人小声说话"},{"id":35449,"word":"窃窃私议","pinyin":"qiè qiè sī yì","abbr":"qqsy","explanation":"背地里小声议论。","source":{"text":"虽叛两使事，未尝以簿书为意，日引其党屏人切切细语，谋夺官者兵，以制四海之命。","book":"唐·韩愈《顺宗实录·永贞五年》"},"example":{"text":"宗、胡两人，正在～。","book":"清·吴趼人《痛史》第十三回"},"similar":["窃窃私语"],"opposite":["大声喧哗"],"usage":"作谓语；用于人小声说话"},{"id":35450,"word":"窃窃私语","pinyin":"qiè qiè sī yǔ","abbr":"qqsy","explanation":"背地里小声说话。","source":{"text":"虽叛两使事，未尝以簿书为意，日引其党屏人切切细语，谋夺官者兵，以制四海之命。","book":"唐·韩愈《顺宗实录·永贞五年》"},"example":{"text":"又故意与行酒侍儿，～，羋氏两次问话，俱失应答。","book":"明·冯梦龙《东周列国志》第四十六回"},"similar":["窃窃私议","窃窃偶语"],"opposite":["大声喧哗"],"usage":"作谓语、定语；用于人小声说话"},{"id":35451,"word":"窃窃细语","pinyin":"qiè qiè xì yǔ","abbr":"qqxy","explanation":"背地里小声说话。","source":{"text":"虽叛两使事，未尝以簿书为意，日引其党屏人切切细语，谋夺官者兵，以制四海之命。","book":"唐·韩愈《顺宗实录·永贞五年》"},"example":{"text":"他们在～，不知道说些什么？"},"similar":["窃窃私语","窃窃偶语"],"usage":"作谓语、定语；用于人小声说话"},{"id":35452,"word":"窃窃诩诩","pinyin":"qiè qiè xǔ xǔ","abbr":"qqxx","explanation":"窃窃：暗中，私下。形容暗自夸耀。","source":{"text":"而习俗卑下，学者祰于旧闻，不复知有学术，窃窃诩诩，苟且自恕。","book":"明·方孝孺《与赵伯钦书》"},"usage":"作谓语、定语、状语；用于书面语"},{"id":35453,"word":"窃簪之臣","pinyin":"qiè zān zhī chén","abbr":"qzzc","explanation":"比喻有一小技可解危难者。","source":{"text":"亦有以遇者，窃簪之臣，鸡鸣之客是也。","book":"汉·王充《论衡·逢遇》"},"usage":"作宾语；用于书面语","story":["春秋时期，一次齐国军队进攻楚国，楚国有位善于偷盗的人，他连续偷走了齐军将领的枕头、发簪之类的东西。楚军将领派人一一送还齐军，齐军将领非常吃惊，害怕那偷盗的人暗中杀了自己，就带领军队撤退"]},{"id":35454,"word":"窃衣取温","pinyin":"qiè yī qǔ wēn","abbr":"qyqw","explanation":"窃：偷取。比喻用不当的手段谋取利益。","source":{"text":"以此得官，谓为才力，何异益食致饱，窃衣取温哉！","book":"北齐·颜之推《颜氏家训·省事》"},"usage":"作宾语、定语；指盗窃"},{"id":35455,"word":"窃语私议","pinyin":"qiè yǔ sī yì","abbr":"qysy","explanation":"私：私下。背地里小声议论。","source":{"text":"若见窃语私议，便舍起，勿使忌人也。","book":"三国·魏·嵇康《家诫》"}},{"id":35456,"word":"窃钟掩耳","pinyin":"qiè zhōng yǎn ěr","abbr":"qzye　","explanation":"掩：遮蔽，遮盖。从事钟时堵上自己的耳朵。比喻自欺欺人。","source":{"text":"百姓有得钟者，欲负而走，则钟大不可负。以椎毁之，钟况然有声。恐人闻之而夺己也，遽掩其耳。","book":"《吕氏春秋·自知》"},"example":{"text":"亦犹～，以众人为不闻；锐意盗金，谓市中为莫睹。","book":"《晋书·宣帝纪》"},"similar":["掩耳盗铃","自欺欺人"],"usage":"作谓语、定语、状语；指自欺欺人","story":["从前有个小偷发现人家家门口挂着一口很大的铜钟，他想偷但一个人搬不动，想把他敲碎卖碎铜，担心敲钟时别人听到声音而偷不成，终于想出一个绝妙的主意，就是把自己的耳朵用棉花塞住听不到声音，结果偷窃时被当场逮住"]},{"id":35457,"word":"窃钩盗国","pinyin":"qiè gōu dào guó","abbr":"qgdg","explanation":"偷钩的要处死，篡夺政权的人成为诸侯。讽刺小盗被杀、大盗窃国的反常现象。","source":{"text":"窃钩盗国将谁咎？扃鐍缄滕只自欺。","book":"廖仲恺《有感》"},"similar":["窃钩者诛，窃国者侯"],"usage":"作宾语、定语；用于处事"},{"id":35458,"word":"窃钩窃国","pinyin":"qiè gōu qiè guó","abbr":"qgqg","explanation":"偷钩的要处死，篡夺政权的人反倒成为诸侯。旧时用以讽刺法律的虚伪和不合理。","source":{"text":"彼窃钩者诛，窃国者为诸侯；诸侯之门而仁义存焉。","book":"《庄子·胠箧》"},"similar":["窃钩盗国"],"usage":"作宾语、定语；用以讽刺法律的虚伪和不合理"},{"id":35459,"word":"窃钩者诛，窃国者侯","pinyin":"qiè gōu zhě zhū，qiè guó zhě hóu","abbr":"qgzzqgzh","explanation":"偷钩的要处死，篡夺政权的人反倒成为诸侯。旧时用以讽刺法律的虚伪和不合理。","source":{"text":"彼窃钩者诛，窃国者为诸侯；诸侯之门，而仁义存焉。","book":"战国·宋·庄周《庄子·胠箧》"},"example":{"text":"～，侯之门仁义存。","book":"西汉·司马迁《史记·游侠列传序》"},"similar":["窃钩窃国"],"usage":"作分句；指不同的手段有不同的结果"},{"id":35460,"word":"窄门窄户","pinyin":"zhǎi mén zhǎi hù","abbr":"zmzh","explanation":"比喻小户人家。","source":{"text":"若是小媳妇那里，窄门窄户，敢招惹这个事！","book":"《金瓶梅词》第六九回"},"similar":["小户人家"],"usage":"作宾语、定语；指小户人家"},{"id":35461,"word":"窈窈冥冥","pinyin":"yǎo yǎo míng míng","abbr":"yymm","explanation":"窈窈：深远；冥冥：幽深。形容深远微妙","source":{"text":"至道之精，窈窈冥冥；至道之极，昏昏默默。","book":"战国·宋·庄周《庄子·在寮》"},"example":{"text":"西汉·刘安《淮南子·精神训》：“古未有天地之时，惟像无形，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":35462,"word":"窈窕冥冥","pinyin":"yǎo tiǎo míng míng","abbr":"ytmm","explanation":"形容精深微妙。","source":{"text":"至道之精，窈窕冥冥；至道之极，昏昏默默。","book":"《庄子·在宥》"}},{"id":35463,"word":"窈窕淑女","pinyin":"yǎo tiǎo shū nǚ","abbr":"ytsn","explanation":"窈窕：美好的样子。美好的女子。","source":{"text":"窈窕淑女，君子好逑。","book":"《诗经·周南·关睢》"},"example":{"text":"因为在前边领路的那位～明明很从容地就走过去了。","book":"萧乾《海外行踪》"},"similar":["沉鱼落雁","羞花闭月","秀色可餐"],"opposite":["面目可憎","其貌不扬","獐头鼠目"],"usage":"作主语、宾语、定语；用于女性"},{"id":35464,"word":"窒碍难行","pinyin":"zhì ài nán xíng","abbr":"zanx","explanation":"窒：阻塞不通。阻碍太多，难以实行。","source":{"text":"夫支孽尽封，则国祚愈长久，愈窒碍难行，寰海不能容支孽。","book":"清·龚自珍《答人问关内侯》"},"similar":["寸步难行"],"opposite":["一帆风顺"],"usage":"作谓语、定语；指困难"},{"id":35465,"word":"窒隙蹈瑕","pinyin":"zhì xì dǎo xiá","abbr":"zxdx","explanation":"窒：阻塞不通；隙：缝；蹈：踩；瑕：污点。堵塞缝隙，踩住短处。比喻抓住别人缺点趁机谋利。","source":{"text":"是以士颇得信其舌而奋其笔，窒隙蹈瑕而无所诎也。","book":"汉·扬雄《解嘲》"},"example":{"text":"矫情役智，扬逸名利之间；～，干没翘之地。（唐·王勃《平台秘略论十首·褒客七》）"},"usage":"作宾语、定语；用于处事"},{"id":35466,"word":"窗外有耳","pinyin":"chuāng wài yǒu ěr","abbr":"cwye","explanation":"指秘密言谈可能泄密。","source":{"text":"展爷连忙摆手说：‘四弟悄言，岂不闻窗外有耳？’","book":"清·石玉昆《三侠五义》第39回"},"example":{"text":"小心～，我们得注意保密。"},"similar":["隔墙有耳"],"usage":"作宾语、定语；指泄密"},{"id":35467,"word":"窗明几净","pinyin":"chuāng míng jī jìng","abbr":"cmjj","explanation":"几：小桌。形容房间干净明亮。","source":{"text":"欣然为我解东阁，明窗净几舒华茵。","book":"宋·苏辙《寄范文景仁》诗"},"example":{"text":"～，是一间雅洁的书房。","book":"华而实《汉衣冠·序幕》"},"similar":["安室利处"],"opposite":["满屋尘灰"],"usage":"作谓语、宾语、定语；形容房间清洁干净"},{"id":35468,"word":"窗间过马","pinyin":"chuāng jiān guò mǎ","abbr":"cjgm","explanation":"形容时间过得很快。","source":{"text":"风尘天外飞沙，日月窗间过马。风俗扫地伤王化，谁正人伦大雅。","book":"元·吴弘道《醉高歌·叹世》曲"},"similar":["白驹过隙"],"opposite":["度日如年"],"usage":"作宾语、定语；指时间流逝"},{"id":35469,"word":"窜端匿迹","pinyin":"cuàn duān nì jì","abbr":"cdnj","explanation":"比喻掩盖事情的真相。","source":{"text":"聊窜端而匿迹兮，嗼寂默而无声。","book":"战国·楚·屈原《楚辞·严忌》"},"example":{"text":"夫事之所以难知者，以其～。","book":"西汉·刘安《淮南子·人家训》"},"usage":"作谓语；比喻掩盖事情的真相"},{"id":35470,"word":"窝停主人","pinyin":"wō tíng zhǔ rén","abbr":"wtzr","explanation":"藏匿盗匪、赃物的人或人家。","source":{"text":"为盗有求不惬，诬为窝停主人，诉于郡，不见察，故陷党中。","book":"宋洪迈《夷坚癸志·李五郎》"},"usage":"作宾语、定语；用于书面语"},{"id":35471,"word":"窝儿里反","pinyin":"wō ér lǐ fǎn","abbr":"welf","explanation":"发生在家族或集团内部的冲突。","source":{"text":"一个单位就怕～。"}},{"id":35472,"word":"窝儿里横","pinyin":"wō ér lǐ hèng","abbr":"welh","explanation":"只会在家里耍横发脾气。","example":{"text":"她骂丈夫是～。"},"usage":"作宾语、定语；用于方言"},{"id":35473,"word":"窝囊废","pinyin":"wō nāng fèi","abbr":"wnf","explanation":"指怯懦无能的人。","source":{"text":"在两个老人的眼里，他是一个窝囊废，是一个被鬼迷了心窍的人。","book":"路遥《平凡的世界》第四卷第48章"},"example":{"text":"她是一个十足的～。"},"usage":"作宾语、定语；用于骂人"},{"id":35474,"word":"窝囊气","pinyin":"wō náng qì","abbr":"wnq","explanation":"憋在心里的不能说或不愿说的怨气。","example":{"text":"憋在心里的不能说或不愿说的怨气。"},"usage":"作宾语、定语；用于口语"},{"id":35475,"word":"窝火憋气","pinyin":"wō huǒ biē qì","abbr":"whbq","explanation":"把屈辱或恼怒强压在心底，不敢或不能发泄。","source":{"text":"李青山有些胆怯，他退到门边，嘴头咕噜着：‘滚就滚吧！’扭转身子，窝火憋气地迈出门去了。","book":"周立波《暴风骤雨》第一部五"},"example":{"text":"怎么受压？嘿，说起来叫人～呗！","book":"王士美《铁旋风》第一部第五章"},"similar":["憋气窝火"],"usage":"作谓语、状语、定语；指憋在心里"},{"id":35476,"word":"窝窝囊囊","pinyin":"wō wō nāng nāng","abbr":"wwnn","explanation":"受委屈之后表现出的烦恼，窝气或指人懦弱，没本事。","source":{"text":"如果窝窝囊囊不中用，或者虽中用是个半吊子，便另有打算。","book":"高阳《胡雪岩全传·平步青云》下册"},"example":{"text":"我不能再这样～地活着。"},"usage":"作谓语、状语；指没本事"},{"id":35477,"word":"窝里反","pinyin":"wō lǐ fǎn","abbr":"wlf","explanation":"发生在家族或集团内部的冲突。","source":{"text":"那一来变成‘窝里反’了，不好，不好。","book":"高阳《胡雪岩全传·萧瑟洋场》"},"example":{"text":"一个单位就怕～。"},"similar":["窝儿里反"],"usage":"作宾语、定语；用于方言"},{"id":35478,"word":"窥伺效慕","pinyin":"kuī sì xiào mù","abbr":"ksxm","explanation":"窥伺：暗中观察动静；效慕：模仿。背地里偷看并模仿。","source":{"text":"视驼所种树，或迁徙，无不活。且硕茂，蚤实以蕃。他植者虽窥伺效慕，莫能如也。","book":"唐·柳宗元《种树郭橐驼传》"},"usage":"作宾语、定语；用于书面语"},{"id":35479,"word":"窥伺间隙","pinyin":"kuī sì jiàn xì","abbr":"ksjx","explanation":"窥：暗中观察；伺：守候，等待机会。暗中观察，准备伺机采取行动。","source":{"text":"内用商鞅、李斯之谋，外用白起、王翦之兵，窥间伺隙，既并海内之后，以威力为至道，以权诈为要术。","book":"汉·吾丘寿王《骠骑论功论》"},"example":{"text":"必能使寇贼奸宄不敢～，则江淮足以高枕而卧。","book":"唐·独孤及《为杭州李使君论李藏用守杭州功表》"}},{"id":35480,"word":"窥测一斑","pinyin":"kuī cè yī bān","abbr":"kcyb","explanation":"窥测：窥探推测。只窥探到一点斑纹。形容只看到局部而未看到整体。"},{"id":35481,"word":"窥测方向，以求一逞","pinyin":"kuī cè fāng xiàng，yǐ qiú yī chěng","abbr":"kcfxyqyc","explanation":"窥测：暗中观察猜测；逞：如愿。暗地里探测方向，企图达到不可告人的目的。","example":{"text":"眼下盘据费邑的公山不狃正在～，他早已不把定公和季桓子放在眼里。","book":"曹尧德、宋均平、杨佐仁《孔子传》第二十章"}},{"id":35482,"word":"窥涉百家","pinyin":"kuī shè bǎi jiā","abbr":"ksbj","explanation":"窥涉：涉猎，学习；百家：学术上的各种流派。广泛学习，汲取各派的长处。","source":{"text":"通人知士，虽博览古今，窥涉百家，条入叶贯，不能审知。惟圣心贤意，方比物类，为能实之。","book":"汉·王充《论衡·薄葬》"},"usage":"作谓语、定语；用于书面语"},{"id":35483,"word":"窥牖小儿","pinyin":"kuī yǒu xiǎo ér","abbr":"kyxe","explanation":"窥牖：从窗上向屋里偷看。后多形容小偷。","source":{"text":"时东方朔窃从殿南厢朱鸟牖中窥母，母顾之，谓帝曰：‘此窥牖小儿，尝三来，盗吾此桃。’","book":"晋·张华《博物志》第三卷"},"similar":["梁上君子"],"usage":"作宾语、定语；指小偷"},{"id":35484,"word":"窥牗小儿","pinyin":"kuī yǒu xiǎo ér","abbr":"kyxe","explanation":"窥牗：从窗上向屋里窥视。指小偷。","source":{"text":"此窥牗小儿，尝三来，盗吾此桃。","book":"晋·张华《博物志》卷三"}},{"id":35485,"word":"窥窃神器","pinyin":"kuī qiè shén qì","abbr":"kqsq","explanation":"神器：帝位、政权。窥伺机会，窃取帝位。","source":{"text":"犹复包藏祸心，窥窃神器。","book":"唐·骆宾王《为徐敬业讨武瞾檄》"},"example":{"text":"为布告事：迩以袁氏背叛国家，～。","book":"蔡东藩《民国通俗演义》第61回"},"similar":["篡位夺权"],"usage":"作谓语、宾语、定语；用于人的野心"},{"id":35486,"word":"窥窬分毫","pinyin":"kuī yú fēn háo","abbr":"kyfh","explanation":"商贾自谦之词。指谋求小利。","source":{"text":"目语额瞬，动頞塞鼻，谈智于尺寸之间，窥窬于分毫之际。","book":"晋·成粲《平乐市赋》"}},{"id":35487,"word":"窥见一斑","pinyin":"kuī jiàn yī bān","abbr":"kjyb","explanation":"指只了解一二。","source":{"text":"一向不知阳明、象山学问来历，前在舟中似窥见其一斑。","book":"《高子遗书·会语九八》"},"example":{"text":"明代吴中山歌的风靡流布，还可以从明代小说中的描写～。","book":"关德栋《序》"},"similar":["窥豹一斑"],"usage":"作谓语；指只了解一二"},{"id":35488,"word":"窥觎非望","pinyin":"kuī yú fēi wàng","abbr":"kyfw","explanation":"窥觎：伺机行动；非望：非分的希望。寻找实机实现非分的希望。旧时多指谋求帝位。","source":{"text":"然以雄武专朝，窥觎非望。","book":"《晋书·桓温传》"},"usage":"作宾语、定语；用于书面语"},{"id":35489,"word":"窥豹一斑","pinyin":"kuī bào yī bān","abbr":"kbyb","explanation":"从竹管的小孔里看豹，只看到豹身上的一块斑纹。比喻只看到事物的一部分，指所见不全面或略有所得。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"有的人孤陋寡闻，～，却喜欢夸夸其谈，炫耀自己。"},"similar":["可见一斑","坐井观天"],"opposite":["巨细无遗","具体而微"],"usage":"作主语、宾语；比喻只看到事物的一部分","story":["晋朝书法家王羲之的儿子王献之从小开始学习写字、绘画，聪明过人，深得父亲的喜爱。一次父亲的朋友及门生在玩骰子时，王献之在旁观看，说了一句“南风不竞！”门生听了笑道：“小孩子是管中窥豹，只看到一个斑点。”"]},{"id":35490,"word":"窥闲伺隙","pinyin":"kuī xián sì xì","abbr":"kxsx","explanation":"窥：暗中观察；伺：守候，等待机会。暗中观察，准备伺机采取行动。","source":{"text":"内用商鞅李斯之谋，外用白起王剪之兵，窥间伺隙，既并海内之后，以威力为至道，以权诈为要术。","book":"汉·吾丘寿王《骠骑论功论》"}},{"id":35491,"word":"窥间伺隙","pinyin":"kuī jiàn sì xì","abbr":"kjsx","explanation":"窥：暗中观察；伺：守候，等待机会。暗中观察，准备伺机采取行动。","source":{"text":"（秦）内用商鞅、李斯之谋，外用白起、王翦之兵，窥间伺隙，既并海内之后，以威力为至道，以权诈为要术。","book":"汉·吾丘寿王《骠骑论功论》"},"example":{"text":"彼谓衅皆由我，～，造此纷坛，亦理所应有也。","book":"明·朱之瑜《与佐藤弥四郎书》"},"usage":"作谓语；形容待机寻衅"},{"id":35492,"word":"窸窸窣窣","pinyin":"xī xī sū sū","abbr":"xxss","explanation":"象声词，形容摩擦等轻微细小的声音。","source":{"text":"我听到窸窸窣窣收拾书的声音，恶意地笑着说：‘我叫你害怕了。’","book":"王朔《一半是火焰，一半是海水》"},"example":{"text":"王朔《一半是火焰，一半是海水》：“我听到～收拾书的声音，恶意地笑着说：‘我叫你害怕了。’”"},"usage":"作定语、状语；用于声音等"},{"id":35493,"word":"立业安邦","pinyin":"lì yè ān bāng","abbr":"lyab","explanation":"建立国家，安定天下。同“立国安邦”。","source":{"text":"想五帝之世，求贤用士，立业安邦，你是不知也。","book":"元·郑光祖《伊尹耕莘》第一折"},"similar":["立国安邦"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":35494,"word":"立业成家","pinyin":"lì yè chéng jiā","abbr":"lycj","explanation":"在事业上或家业上有所成就。","source":{"text":"问：‘牛头未见四祖时如何？’师曰：‘成家立业。’曰：‘见后如何？’曰：‘立业成家。’","book":"宋·释普济《五灯会元》卷二十七"}},{"id":35495,"word":"立于不败之地","pinyin":"lì yú bù bài zhī dì","abbr":"lybbzd","explanation":"立于：处在。使自己处在不会失败的地位。","source":{"text":"故善战者，立于不败之地，而不失敌之败也。","book":"《孙子·军形》"},"example":{"text":"毛主席的正确的路线，和高度发展了的马克思主义的军事艺术，是使我军～的唯一保证。","book":"刘伯承《回忆长征》"},"similar":["百战百胜"],"opposite":["屡战屡败"],"usage":"作谓语、宾语；用于组织或个人"},{"id":35496,"word":"立人达人","pinyin":"lì rén dá rén","abbr":"lrdr","explanation":"立：建树，成就；达：发达，显贵。旧指帮助人建立功业，提高地拉。","source":{"text":"夫仁者，己欲立而立人，己欲达而达人。能近取譬，可谓仁之方也已！","book":"《论语·雍也》"},"usage":"作谓语；指帮助人建立功业、地位"},{"id":35497,"word":"立仗之马","pinyin":"lì zhàng zhī mǎ","abbr":"lzzm","explanation":"立仗马：唐时，曾用马作仪仗，排列于宫门外。比喻因贪恋高官厚禄而不敢有所作为的人。","source":{"text":"君等独不见立仗马呼？终日无声，而饫三品刍豆，一鸣则黜之矣，后虽欲不鸣，得乎？","book":"《新唐书·李林甫传》"},"example":{"text":"诸君不见～乎，日食三品料；若一鸣，便斥去矣。","book":"清·褚人获《隋唐演义》第八十一回"}},{"id":35498,"word":"立功立事","pinyin":"lì gōng lì shì","abbr":"lgls","explanation":"树立功勋成就事业。","source":{"text":"《太誓》曰：‘正稽古立功立事，可以永年，丕天之大律。’","book":"《汉书·郊祀志》"},"example":{"text":"汝～，乃登相位，朝廷是赖，年虽及，未可去也。","book":"清·毕沅《续资治通鉴》卷一百四十八"},"usage":"作谓语、宾语；用于处事"},{"id":35499,"word":"立功立德","pinyin":"lì gōng lì dé","abbr":"lgld","explanation":"立德：树立圣人这德；立功：建立功绩。旧指树立德业和功绩，为民除难，全面施舍，以救济众生。","source":{"text":"大上有立德，其次是立功，其次是立言，虽久不废。","book":"《左传·襄公二十四年》"}},{"id":35500,"word":"立功自效","pinyin":"lì gōng zì xiào","abbr":"lgzx","explanation":"效：报效，献出。指立功以作贡献。","source":{"text":"江边诸将，各欲立功自效，多陈便宜，有所掩袭。","book":"《资治通鉴·魏纪二》"},"example":{"text":"只将郭子仪手下仆人失慎的，就地正法，赦郭子仪之罪，许其自后～。","book":"清·褚人获《隋唐演义》第八十三回"},"usage":"作谓语；用于处事"},{"id":35501,"word":"立功自赎","pinyin":"lì gōng zì shú","abbr":"lgzs","explanation":"建立功绩弥补自己的过失。","source":{"text":"知其无与进于时而信于人，终将废矣，则思效用以自补，立功以自赎。","book":"宋·石介《上范经略书》"},"example":{"text":"士英逃至台州，大铖介绍投诚，即命士英说降方国安，同破金华，～。","book":"明·张岱《马士英传》"}},{"id":35502,"word":"立功赎罪","pinyin":"lì gōng shú zuì","abbr":"lgsz","explanation":"赎罪：抵销所犯的罪过。以立功来抵偿罪过。","source":{"text":"使未至幽州，而宏晖已立功赎罪，竟免诛。","book":"《旧唐书·王孝杰传》"},"example":{"text":"赵衰应曰：“当革职，使～。”","book":"明·冯梦龙《东周列国志》第四十回"},"similar":["将功补过","将功折罪"],"opposite":["罪上加罪"],"usage":"作谓语、定语、宾语；用于有过错的人"},{"id":35503,"word":"立吃地陷","pinyin":"lì chī dì xiàn","abbr":"lcdx","explanation":"指光是消费而不从事生产，即使有堆积如山的财富，也要耗尽。","source":{"text":"那钱物则有出去的，无有进来的，便好道坐吃山空，立吃地陷。","book":"元·秦简夫《东堂老》第一折"},"example":{"text":"古人原说：‘坐吃山空，～。’","book":"明·罗贯中《平妖传》第20回"},"similar":["坐吃山空"],"usage":"作谓语、宾语；用于劝诫人"},{"id":35504,"word":"立命安身","pinyin":"lì mìng ān shēn","abbr":"lmas","explanation":"立命：精神上安定；安身：指得以容身。指精神上有寄托，生活上有着落。","source":{"text":"僧问：‘学人不据地时如何？’师云：‘汝向什么处安身立命？’","book":"宋·释道原《景德传灯录》卷十"},"example":{"text":"不但这样，还要给他～。那时才算当完了老哥哥的差。","book":"清·文康《儿女英雄传》第十六回"},"similar":["安身立命"],"usage":"作谓语、定语；指人的精神"},{"id":35505,"word":"立国安邦","pinyin":"lì guó ān bāng","abbr":"lgab","explanation":"建立国家，安定天下。亦作“立业安邦”。","source":{"text":"自开基起运，立国安邦，坐筹帷幄，竭力疆场。","book":"元·关汉卿《裴度还带》第一折：“你看我立国安邦为相宰,那其间日转千阶，喜笑迎腮，挂印悬牌。”元·宫大用《七里滩》第一折"},"example":{"text":"圣朝卿相，一个个忠君上，～，扶持万载山河壮。","book":"元·无名氏《射柳捶丸》第一折"},"similar":["立业安邦"],"usage":"作谓语、定语、宾语；用于书面语"},{"id":35506,"word":"立地书厨","pinyin":"lì dì shū chú","abbr":"ldsc","explanation":"比喻人读书多，学识渊博。","source":{"text":"时敏于为文，未尝属稿，落笔已就，两学目之曰‘立地书厨’。","book":"《宋史·吴时传》"},"similar":["立地书橱"],"opposite":["一字不识"],"usage":"作宾语；比喻学识渊博的人","story":["北宋时期，华州郑县令吴时学识渊博，办事灵活，他提出的“移兵就食”为朝廷节约了大量的人才物力。他经常上书宋徽宗提出许多合理化建议。后来被调到京城做官，国子监的人与他接触后都认为他学识渊博，尊称他为“立地书橱”"]},{"id":35507,"word":"立地书橱","pinyin":"lì dì shū chú","abbr":"ldsc","explanation":"比喻人读书多，学识文博。","source":{"text":"每于为文，未尝属稿，落笔已成，两学目之曰立地书橱。","book":"《宋史·吴时传》"},"similar":["著脚书楼","硕学鸿儒"],"opposite":["一字不识"],"usage":"作宾语；比喻学识渊博的人","story":["北宋时期，华州郑县令吴时学识渊博，办事灵活，他提出的“移兵就食”为朝廷节约了大量的人才物力。他经常上书宋徽宗提出许多合理化建议。后来被调到京城做官，国子监的人与他接触后都认为他学识渊博，尊称他为“立地书橱”"]},{"id":35508,"word":"立地成佛","pinyin":"lì dì chéng fó","abbr":"ldcf","explanation":"佛家语，禅宗认为人皆有佛性，弃恶从善，即可成佛。此为劝善之语。","source":{"text":"广额正是个杀人不眨眼底汉。放下屠刀，立地成佛。","book":"宋·释普济《五灯会元·昭觉勤禅师法嗣》"},"example":{"text":"既然“～”有了保证，屠刀便不妨随时拿起，随时放下，随时放下，随时拿起。","book":"闻一多《画展》"},"similar":["一改故辙","一步登天"],"opposite":["千夫所指","万劫不复"],"usage":"作主语、宾语；用于否定句"},{"id":35509,"word":"立地擎天","pinyin":"lì dì qíng tiān","abbr":"ldqt","explanation":"擎：往上托举。顶天立地。形容英雄气慨。","source":{"text":"披文握武镇荆襄，立地擎天作栋梁。","book":"元·乔孟符《两世姻缘》第三折"}},{"id":35510,"word":"立地生根","pinyin":"lì dì shēng gēn","abbr":"ldsg","explanation":"比喻过于性急，立刻就要办好事情。","source":{"text":"他想要的东西就～地叫人家赶快买来。"},"example":{"text":"他想要的东西就～地叫人家赶快买来"},"similar":["落地生根"],"usage":"作宾语、状语；方言"},{"id":35511,"word":"立地金刚","pinyin":"lì dì jīn gāng","abbr":"ldjg","explanation":"比喻人力大气壮，异常威武。","source":{"text":"马似掀天狮子，人如立地金刚。","book":"清·钱彩《说岳全传》第14回"},"usage":"作宾语、定语；指人勇武"},{"id":35512,"word":"立场不稳","pinyin":"lì chǎng bù wěn","abbr":"lcbw","explanation":"对问题所持的观点态度不能持之以恒。","source":{"text":"这说明我的立场不稳，认识模糊，以十分不严肃的态度，对待国家政策。","book":"章诒和《往事并不如烟·正在有情无思间》"},"example":{"text":"对于那些～的人，我们应该尽快清除出组织。"},"similar":["人云亦云"],"opposite":["立场坚定"],"usage":"作谓语、定语；指没有立场的人"},{"id":35513,"word":"立定脚跟","pinyin":"lì dìng jiǎo gēn","abbr":"ldjg","explanation":"指脚踏实地，老老实实做事。","source":{"text":"从此各人立定脚跟，安分守己，作一个清白良民。","book":"清·文康《儿女英雄传》第二十一回"},"example":{"text":"顺着龙头往下走，拐弯抹角，走了半天才找到龙尾，～，不久回头一看，龙尾又不知伸展得何处去了。","book":"梁实秋《排队》"},"similar":["站稳脚跟","立场坚定"],"opposite":["站不住脚"],"usage":"作谓语、宾语；指脚踏实地"},{"id":35514,"word":"立少观多","pinyin":"lì shǎo guān duō","abbr":"lsgd","explanation":"指略一作为而影响很大。","source":{"text":"立少而观多，则天下怀之矣。","book":"《管子·七法》"},"usage":"作宾语、定语；用于书面语"},{"id":35515,"word":"立德立言","pinyin":"lì dé lì yán","abbr":"ldly","explanation":"立德：指推行德政；立言：著书立说。指树立有益于民的政教措施作为后世的典范并流传后世。","source":{"text":"大上有立德，其次是立功，其次是立言，虽久不废。","book":"《左传·襄公二十四年》"},"example":{"text":"便是著书立说，无非言忠言孝，自有一番～的事业，方不枉生在圣明之时。","book":"清·曹雪芹《红楼梦》第一百十五回"}},{"id":35516,"word":"立扫千言","pinyin":"lì sǎo qiān yán","abbr":"lsqy","explanation":"形容才思敏捷，文章写得很快。","source":{"text":"风檐寸晷，立扫千言，可敬可敬。","book":"明·汤显祖《还魂记·耽试》"},"similar":["下笔千言"],"usage":"作谓语、定语；指人的文思快捷"},{"id":35517,"word":"立时三刻","pinyin":"lì shí sān kè","abbr":"lssk","explanation":"立刻、马上。","source":{"text":"有天听了朋友一句玩笑话，便立时三刻逼我母亲出去，一刻不能相容。","book":"清·李宝嘉《官场现形记》第51回"},"example":{"text":"他～就去要人。"},"usage":"作状语；指立刻"},{"id":35518,"word":"立木南门","pinyin":"lì mù nán mén","abbr":"lmnm","explanation":"立木：竖木于地上。用具体事实来证明新的法令、制度一定要推行开来。多用于形容取信于民。","source":{"text":"令既具，未布，恐民之不信，已乃立三丈于国都市南门，募民有能徙置北门者予十金，民怪之，莫敢徙……有一人行徒之，辄予五十金，以明不欺。","book":"《史记·商君列传》"},"similar":["徙木为信"],"usage":"作宾语、定语；用于处事","story":["战国时期，商鞅在秦孝公的支持下进行变法，新法公布以后，为使人们相信新法一定要执行，商鞅命人在国都南门处立了一根三丈多高的木柱，声明谁搬动到北门就赏五十金。有一个胆大而力大的人果然得到五十金，人们认为商鞅言出必行就按新法行事"]},{"id":35519,"word":"立此存照","pinyin":"lì cǐ cún zhào","abbr":"lccz","explanation":"照：查考，察看。写下字据保存进来，以作凭证。","source":{"text":"执凭公文，在此存照。","book":"明·施耐庵《水浒全传》第二十二回"},"example":{"text":"我们担心时间长了就空口无凭，只好～。"},"similar":["立此为证"],"opposite":["空口无凭"],"usage":"作谓语；指写下字据保存进来，以作凭证"},{"id":35520,"word":"立爱惟亲","pinyin":"lì ài wéi qīn","abbr":"lawq","explanation":"爱先施于亲人，逐渐及于疏远的人。","source":{"text":"立爱惟亲，立敬为长，始于家，终于四海。","book":"《尚书·伊训》"},"example":{"text":"自家而国，治道必有所先；～，君德莫先于孝。","book":"《元史·后妃二》"}},{"id":35521,"word":"立盹行眠","pinyin":"lì dǔn xíng mián","abbr":"ldxm","explanation":"站立、行走时都在睡觉。形容十分疲倦。","source":{"text":"只他这风风雨雨强将程途来践，走的我筋舒力尽浑身战，一身疼痛十分倦，我、我、我，立盹行眠。","book":"元·杨显之《潇湘雨》第四折"},"usage":"作谓语、状语；用于处事"},{"id":35522,"word":"立眉瞪眼","pinyin":"lì méi dèng yǎn","abbr":"lmdy","explanation":"倒竖双眉，圆瞪二目。形容暴怒的样子。","example":{"text":"你干嘛～的？"},"similar":["立眉横眼","立眉竖眼"],"opposite":["和颜悦色"],"usage":"作谓语、定语；指大怒"},{"id":35523,"word":"立眉竖眼","pinyin":"lì méi shù yǎn","abbr":"lmsy","explanation":"指耸眉瞪眼，形容怒目相视，态度凶狠的样子。","source":{"text":"那几个小子立眉竖眼、七嘴八舌地证明：他就是说了，而且还说过不止一次呢！","book":"路遥《平凡的世界》第一卷第18章"},"similar":["横眉竖眼"],"opposite":["喜眉笑脸","和颜悦色"],"usage":"作谓语、定语、状语；指耸眉瞪眼"},{"id":35524,"word":"立竿见影","pinyin":"lì gān jiàn yǐng","abbr":"lgjy","explanation":"在阳光下把竿子竖起来，立刻就看到影子。比喻立刻见到功效。","source":{"text":"立竿见影，呼谷传响。","book":"汉·魏伯阳《参同契》卷下"},"example":{"text":"你说你莲花化身，清净无为，其如五行变化，～。","book":"明·许仲琳《封神演义》第七十八回"},"similar":["马到成功","立见成效"],"opposite":["旷日持久","劳而无功"],"usage":"作谓语、定语、宾语；比喻事物见效快"},{"id":35525,"word":"立言不朽","pinyin":"lì yán bù xiǔ","abbr":"lybx","explanation":"立言：指创立学说；不朽：永存。创立的学说，永远能流传下去。","source":{"text":"其次有立言，虽久不废，此之谓不朽。","book":"《左传·襄公二十四年》"}},{"id":35526,"word":"立谈之间","pinyin":"lì tán zhī jiān","abbr":"ltzj","explanation":"站着说话的一会儿时间。形容时间极短。","source":{"text":"或七十说而不遇，或立谈而封侯。","book":"汉·扬雄《解嘲》"},"example":{"text":"安有～，而遽为人痛哭哉！","book":"宋·苏轼《贾谊论》"},"similar":["转瞬之间"],"usage":"作宾语；形容时间极短"},{"id":35527,"word":"立贤无方","pinyin":"lì xián wú fāng","abbr":"lxwf","explanation":"指推举贤人不拘一格。","source":{"text":"汤执中立贤无方。","book":"《孟子·离娄下》"},"example":{"text":"此必得虚名为国，淡名利，忘报复之人，柄政当朝，～，庶可人此。","book":"明·刘若愚《酌中志·内府衙门执掌》"},"usage":"作宾语、定语；用于书面语"},{"id":35528,"word":"立足之地","pinyin":"lì zú zhī dì","abbr":"lzzd","explanation":"站脚的地方。也比喻容身的处所。","source":{"text":"你们这班狂妄之徒，还有立足之地么？","book":"清·湘灵子《轩亭冤》卷上"},"example":{"text":"母亲如此说，儿子无～了。","book":"清·曹雪芹《红楼梦》第三十三回"},"similar":["安营扎寨","立锥之地","安家落户"],"opposite":["无处容身","无地自容"],"usage":"作主语、宾语；用于艰难的环境"},{"id":35529,"word":"立身处世","pinyin":"lì shēn chǔ shì","abbr":"lscs","explanation":"立身：做人；处世：在社会上活动，与人交往。指人在社会上待人接物的种种活动。","source":{"text":"夫乾坤覆载，以人为贵；立身处世，以礼仪为本。","book":"晋·无名氏《沙弥十戒法并威仪序》"},"example":{"text":"我们要在社会里混出头，只求不僵，只求不落伍，这是现代人～的名言。","book":"鲁迅《伪自由书·颂萧》"},"similar":["为人处世","人情世故"],"usage":"作主语、宾语；指人待人接物的态度"},{"id":35530,"word":"立身扬名","pinyin":"lì shēn yáng míng","abbr":"lsym","explanation":"立身：使自己在社会上有相当地位；扬：传播。使自己立足于社会，名声远扬。","source":{"text":"立身行道，扬名于后世，以显父母，孝之终也。","book":"《孝经·开宗明义》"},"example":{"text":"丈夫壮而～以显父母。","book":"明·瞿佑《剪灯新话·爱卿传》"},"usage":"作谓语；指使修养自身以求名声远扬"},{"id":35531,"word":"立身行事","pinyin":"lì shēn xíng shì","abbr":"lsxs","explanation":"立身：指为人；行事：指行为。指处世待人的行为。","source":{"text":"降及司马相如，始以自序为传，然其所叙者，但记自少及长立身行事而已。","book":"唐·刘知己《史通·序传》"},"example":{"text":"文自审～，早已为天下共见。","book":"孙中山《第二次讨袁宣言》"}},{"id":35532,"word":"立身行己","pinyin":"lì shēn xíng jǐ","abbr":"lsxj","explanation":"存身自立，行为有度。","source":{"text":"既为君子，自有立身行己的大节义。","book":"《三国志·魏志·王昶传》：“欲使汝曹立身行己，遵儒者之教，履道家之言，故以玄默冲虚为名，欲使汝曹顾名思义，不敢违越也。”《好逑传》第十回"},"example":{"text":"凡～，利物济人，皆吾本分内事，即便磨竭终身，必不改柯易节。","book":"清·李盘《与李仲林》"},"usage":"作谓语；用于书面语"},{"id":35533,"word":"立身行道","pinyin":"lì shēn xíng dào","abbr":"lshd","explanation":"修养自身，奉行道义。","source":{"text":"明公儒学稽古，淳厚笃诚，立身行道，始终如一。","book":"《孝经·开宗明义》：“立身行道，扬名于后世，以显父母，孝之终也。”南朝·梁·萧统《与晋安王纲令》"},"example":{"text":"我爹爹是个大儒，指望～；今遭此患难，那有出头之日。","book":"明·沈鲸《双珠记·僧榻传音》"},"usage":"作谓语、定语；用于处事"},{"id":35534,"word":"立锥之土","pinyin":"lì zhuī zhī tǔ","abbr":"lzzt","explanation":"立锥：插锥子。插锥尖的一点地方。形容能容身的极小地方。","source":{"text":"子弟无尺寸之封，功臣无立锥之土。","book":"曹冏《六代论》"},"similar":["立锥之地"],"usage":"作主语、宾语；指小地方"},{"id":35535,"word":"立锥之地","pinyin":"lì zhuī zhī dì","abbr":"lzzd","explanation":"插锥尖的一点地方。形容极小的一块地方。也指极小的安身之处。","source":{"text":"灭六国之后，使无立锥之地。","book":"《庄子·盗跖》：“尧舜有天下，子孙无置锥之地。”《史记·留侯世家》"},"example":{"text":"天地如此之大，难道竟连一个十八岁的女孩子的～都没有？","book":"杨沫《青春之歌》第一部第四章"},"similar":["插针之地","立足之地"],"opposite":["广阔天地","广土众民"],"usage":"作主语、宾语；用于否定句","story":["楚汉相争时，刘邦被项羽打败，就向谋士郦食其讨教。郦生给刘邦出主意分封六国那些无立锥之地的后人，讨取民心就可以战胜项羽。张良坚决反对郦生的这种做法，认为刘邦天下都还没得到，分封他们，他们就各自为政，没人帮他打天下了"]},{"id":35536,"word":"立雪求道","pinyin":"lì xuě qiú dào","abbr":"lxqd","explanation":"旧指恭敬虔诚地求道。","source":{"text":"十二月九日夜，天大雨雪，光坚立不动，迟明，积雪过膝。师悯而问曰：‘汝久立雪中，当求何事？’光悲泪曰：‘惟愿和尚慈悲，开甘露门，广度群品。’","book":"宋·释道原《景德传灯录》卷三"}},{"id":35537,"word":"立雪程门","pinyin":"lì xuě chéng mén","abbr":"lxcm","explanation":"旧指学生恭敬受教。比喻尊师。","source":{"text":"见程颐于洛，时盖年四十矣。一日见颐，颐偶瞑坐，时与游酢侍立不云。颐既觉，则门外雪深一尺矣。","book":"《宋史·杨时传》"},"example":{"text":"负笈千里，苏章从师之殷；～，游杨敬师之至。","book":"清·程允升《幼学琼林·师生》"}},{"id":35538,"word":"立马万言","pinyin":"lì mǎ wàn yán","abbr":"lmwy","explanation":"倚靠在马旁，马上写成一篇文章。形容才思敏捷。","source":{"text":"唐翰林应长庚之梦，世号谪仙人，立马万言，而文章为天下之法。","book":"宋·王十朋《梅溪王忠文公集·上太守李端明书》"},"similar":["倚马千言"],"usage":"作谓语、定语；指写文章"},{"id":35539,"word":"立马盖轿","pinyin":"lì mǎ gài jiào","abbr":"lmgj","explanation":"形容十分迅速。","source":{"text":"讨了房契去看了，一口就还了原价，内臣性儿，立马盖轿就成了。","book":"明·兰陵笑笑生《金瓶梅词话》第七十一回"}},{"id":35540,"word":"竖子不足与谋","pinyin":"shù zǐ bù zú yǔ móu","abbr":"szbzym","explanation":"竖子：小子，对人的蔑称；不足：不值得；与：相与；谋：商量。这小子不足以同谋大事。表示对人极大的轻蔑。","source":{"text":"亚父受玉斗，置之地，拔剑撞而破之，曰：‘唉，竖子不足与谋。夺项王天下者，必沛公也，吾属今为之虏矣。’","book":"《史记·项羽本纪》"},"example":{"text":"众诸侯皆言不可轻动。操大怒曰：“～！”","book":"明·罗贯中《三国演义》第六回"},"usage":"作宾语、定语；用于处事"},{"id":35541,"word":"竖子成名","pinyin":"shù zǐ chéng míng","abbr":"szcm","explanation":"指无能者侥幸得以成名。","source":{"text":"（阮籍）尝登广武，观楚汉战处，叹曰：‘时无英雄，使竖子成名。’","book":"《晋书·阮籍传》"},"example":{"text":"鬼雄入梦二三辈，～千百场。","book":"傅専《哭杨笃生》"},"usage":"作谓语；指无能者侥幸得以成名"},{"id":35542,"word":"竖起脊梁","pinyin":"shù qǐ jí liáng","abbr":"sqjl","explanation":"比喻振作精神。","source":{"text":"伯恭钦夫敏妙固未易及，然正大之体，挺特之气，竖起脊梁，当时轻重有无，独于门下归心而已。","book":"宋·陈亮《癸卯秋答朱元晦秘书书》"},"example":{"text":"汝旧呼狄三，今名道川，川即三耳；能～办个事，其道如川之增，若放倒，则依旧狄三也。","book":"清·翟灏《通俗编·身体》引《指月录》"},"similar":["挺直腰板"],"usage":"作谓语；用于劝诫人"},{"id":35543,"word":"站不住脚","pinyin":"zhàn bù zhù jiǎo","abbr":"zbzj","explanation":"比喻观点等经不起推敲与反驳。","source":{"text":"急急忙忙地改成‘以拯救一百几十个战犯为前提’，那你们可要仔细，你们就一定站不住脚。","book":"毛泽东《国民党反动派由“呼吁和平”变为呼吁战争》"},"example":{"text":"你的说法～。"},"opposite":["站稳脚跟","颠扑不破"],"usage":"作谓语、定语；用于观点等"},{"id":35544,"word":"站干岸儿","pinyin":"zhàn gān àn ér","abbr":"zgae","explanation":"站在河岸上，不沾水。比喻置身事外，不卷入其中。","source":{"text":"‘坐山观虎斗’，‘借剑杀人’，‘引风吹火’，‘站干岸儿’，‘推倒油瓶不扶’，都是全挂子的武艺。","book":"清·曹雪芹《红楼梦》第十六回"},"example":{"text":"不是我～说河涨的话，男人在外头做事从不和家里商量，待到出了事还要累你替他上下跑腿说话。（二月河《乾隆皇帝》三十一）"}},{"id":35545,"word":"站稳脚跟","pinyin":"zhàn wěn jiǎo gēn","abbr":"zwjg","explanation":"指在一地站稳或指占有一席之地。","source":{"text":"反对美蒋和地方上最反动的分子，以便于我们消灭敌人，站稳脚跟。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"opposite":["站不住脚"],"usage":"作谓语、定语；用于处事"},{"id":35546,"word":"竞今疏古","pinyin":"jìng jīng shū gǔ","abbr":"jjsg","explanation":"指重视现代的，轻视古代的。犹厚今薄古。","source":{"text":"惟而论之，则黄、唐淳而质……宋初论而新：从质及论，弥迈弥澹。何则？竞今疏古，风味气衰也。","book":"南朝梁刘勰《文心雕龙·通变》"},"example":{"text":"明白了通变的道理，便不至于一味的隆古贱今，也不至于一味的～，便能公平的看历代，各各还给它一付本来面目。","book":"朱自清《正变》"},"similar":["厚今薄古"],"usage":"作宾语、定语；指轻视现在"},{"id":35547,"word":"竞新斗巧","pinyin":"jìng xīn dòu qiǎo","abbr":"jxdq","explanation":"竞、斗：比赛争胜。比新奇，赛巧妙。"},{"id":35548,"word":"竞短争长","pinyin":"jìng duǎn zhēng cháng","abbr":"jdzc","explanation":"长、短：指是与非。争论谁是谁非。多指在不大重要的事情上过于计较。","source":{"text":"竞短争长，无复此梦。","book":"宋·陈亮《谢张侍御启》"},"example":{"text":"或是妯娌们言错语差，或是姑嫂们～。","book":"清·西周生《醒世姻缘传》第三十回"},"usage":"作谓语、宾语；用于竞争"},{"id":35549,"word":"竟达空函","pinyin":"jìng dá kōng hán","abbr":"jdkh","explanation":"竟：最后，终于；达：送去；函：信件。最后寄出去的却是一封空信。比喻做事过分小心反而会出错。","source":{"text":"浩欣然许焉，将答书，虑有谬误，开闭者数，竟达空函。","book":"《晋书·殷浩传》"},"example":{"text":"李克让～，刘元普双生贵子。","book":"明·凌濛初《初刻拍案惊奇》卷二十"}},{"id":35550,"word":"章决句断","pinyin":"zhāng jué jù duàn","abbr":"zjjd","explanation":"文章正确句子明了，不含糊其辞。","source":{"text":"章决句断，各有终始。","book":"汉·袁康《越绝书·德序外传记》"},"example":{"text":"汉·袁康《越绝书·德序外传记》：“～，各有终始。”"},"usage":"作宾语、定语；用于书面语"},{"id":35551,"word":"章句之徒","pinyin":"zhāng jù zhī tú","abbr":"zjzt","explanation":"指不能通达大义而拘泥于辨析章句的儒生。","source":{"text":"见“章句小儒”。"},"example":{"text":"当其亡事也，～相与坐而守之，亦亡所患。","book":"《汉书·扬雄传下》"},"similar":["章句小儒"],"usage":"作主语、宾语；用于书面语"},{"id":35552,"word":"章句小儒","pinyin":"zhāng jù xiāo rú","abbr":"zjxr","explanation":"指不能通达大义而拘泥于辨析章句的儒生。","source":{"text":"建所谓章句小儒，破碎大道。","book":"《汉书·夏侯胜传》"},"similar":["章句之徒"],"usage":"作主语、宾语、定语；指书生"},{"id":35553,"word":"章台之柳","pinyin":"zhāng tái zhī liǔ","abbr":"ztzl","explanation":"章台：长安章台下街名。指妓女或不洁之妇","source":{"text":"章台之柳，虽已折于他人；玄都之花，尚不改于前度。","book":"明·凌濛初《二刻拍案惊奇》第六卷"},"similar":["章台杨柳"],"usage":"作主语、宾语；用于书面语"},{"id":35554,"word":"章台杨柳","pinyin":"zhāng tái yáng liǔ","abbr":"ztyl","explanation":"比喻窈窕美丽的女子。","source":{"text":"章台柳，章台柳，昔日青青今在否？纵使长条似旧垂，亦应攀折他人手。","book":"唐韩翃有姬柳氏，以艳丽称。韩获选上第归家省亲；柳留居长安，安史乱起，出家为尼。后韩使人寄柳诗曰"},"example":{"text":"西州士女章台柳，南国江山玉树花。","book":"清吴伟业《赠荆州守袁大韫》诗之二"},"similar":["章台之柳"],"usage":"作主语、宾语；用于书面语","story":["唐代韩栩有姬柳氏，以艳丽著称。安史之乱起，二人失散，柳出家为尼。后韩栩为平卢节度使侯希逸书记．使人寄诗给柳说：“章台柳，章台柳，昔日青青今在否？纵使长条似旧垂，亦应攀折他人手。”时柳己为番将沙吃利所劫。侯希逸部将设计终使二人团"]},{"id":35555,"word":"章往考来","pinyin":"zhāng wǎng kǎo lái","abbr":"zwkl","explanation":"章：同“彰”，弄清；考：考察。弄清过去，考察将来。","source":{"text":"彰往而察来，显微而阐幽。","book":"《周易·系辞下》"}},{"id":35556,"word":"章甫荐履","pinyin":"zhān fǔ jiàn lǚ","abbr":"zfjl","explanation":"冠被垫在鞋子下。比喻上下颠倒。","source":{"text":"章甫荐履，渐不可久兮。","book":"《文选·贾谊》"},"example":{"text":"《南史·刘虬传》：“是以握瑜怀玉之士，瞻郑邦而知退，～之人，望闽乡而叹息。”"},"usage":"作宾语、定语；用于书面语"},{"id":35557,"word":"童叟无欺","pinyin":"tóng sǒu wú qī","abbr":"tswq","explanation":"童：未成年的孩子；叟：年老的男人；欺：蒙骗。既不欺骗小孩也不欺骗老人。指买卖公平。","source":{"text":"他这是招徕生意之一道呢。但不知可有‘货真价实，童叟无欺’的字样没有？","book":"清·吴趼人《二十年目睹之怪现状》第五回"},"example":{"text":"做生意要～。"},"similar":["童叟不欺","公平买卖"],"usage":"作宾语、定语；用于生意场合"},{"id":35558,"word":"童子何知","pinyin":"tóng zǐ hé zhī","abbr":"tzhz","explanation":"对年轻人的轻蔑之称。小孩子懂什么。也用作自廉之辞。","source":{"text":"国之存亡，天也，童子何知焉！","book":"《左传·成公十六年》"},"example":{"text":"～？也来多言！","book":"蔡东藩《后汉演义》第一百回"},"usage":"作宾语、定语；多用于蔑视的口吻"},{"id":35559,"word":"童山濯濯","pinyin":"tóng shān zhuó zhuó","abbr":"tszz","explanation":"没有树木，光秃秃的山。","source":{"text":"人见其濯濯也，以为未尝有材焉，此其山之性也。","book":"战国·邹·孟轲《孟子·告子上》"},"example":{"text":"但是常德到桃源的路上，依然满眼～，一直没人移裁。","book":"冯玉祥《我的生活》第25章"},"similar":["濯濯童山"],"usage":"作宾语、定语；指光秃秃的山"},{"id":35560,"word":"童心未泯","pinyin":"tóng xīn wèi mǐn","abbr":"txwm","explanation":"指年岁虽大而犹存天真之心。","source":{"text":"花前自笑童心在，更伴群儿竹马嘻。","book":"宋·陆游《园中作》"},"example":{"text":"她～，很快就打入少儿圈。"},"similar":["犹有童心"],"usage":"作谓语、定语；指孩子气"},{"id":35561,"word":"童牛角马","pinyin":"tóng niú jiǎo mǎ","abbr":"tnjm","explanation":"童牛：没有角的牛；角马：长角的马。比喻不伦不类的东西。也比喻违反常理，不可能存在的事物。","source":{"text":"童牛角马，不今不古。","book":"汉·扬雄《太玄经·更》"},"usage":"作宾语、定语；指虚无的东西"},{"id":35562,"word":"童男童女","pinyin":"tóng nán tóng nǚ","abbr":"tntn","explanation":"未婚的男孩与女孩。","source":{"text":"使人仍赍童男童女，入海求之。","book":"西汉·司马迁《史记·封禅书》"},"example":{"text":"远处传来了～的歌声。"},"similar":["少男少女"],"usage":"作主语、宾语、定语；指少男少女"},{"id":35563,"word":"童言无忌","pinyin":"tóng yán wú jì","abbr":"tywj","explanation":"旧俗迷信于新年时厅堂多贴此四字，意指孩子说话不必忌讳，即使说了不吉利的话也无妨碍。","source":{"text":"老太爷因为觉群在堂屋里说了不吉利的话，便写了‘童言无忌，大吉大利’的红纸条，拿出来贴在门柱上。","book":"巴金《家》"},"example":{"text":"～，不必在乎小孩子的话。"},"similar":["童口无忌"],"usage":"作谓语；用于劝诫人"},{"id":35564,"word":"童颜鹤发","pinyin":"tóng yán hè fà","abbr":"tyhf","explanation":"颜：脸色。仙鹤羽毛似雪白的头发，孩子似的红润的面色。形容老年人气色好。","source":{"text":"自言非神亦非仙，鹤发童颜古无比。","book":"唐·田颖《梦游罗浮》"},"example":{"text":"（华佗）～，飘然有出世之姿。","book":"明·罗贯中《三国演义》第十五回"},"similar":["鹤发童颜"],"usage":"作宾语、定语；用于老年人"},{"id":35565,"word":"竦然起敬","pinyin":"sǒng rán qǐ jìng","abbr":"srqj","explanation":"竦然：肃敬的样子；起敬：产生尊敬的心情。形容产生严肃敬仰的感情。","source":{"text":"其为人忠诚悃愊，人望之者，不言而竦然起敬。","book":"明·归有光《少傅陈公六十寿诗序》"},"example":{"text":"明·冯梦龙《醒世恒言》第32卷：“黄生见其仪容古雅，～。”"},"similar":["肃然起敬"],"opposite":["漠然置之"],"usage":"作谓语、定语、状语；指尊敬的心情"},{"id":35566,"word":"竭力尽能","pinyin":"jíe lì jìn néng","abbr":"jljn","explanation":"竭：尽；力：力量；能：能力。使出全部力气与能耐。","source":{"text":"臣下竭力尽能，以立功于国。","book":"《礼记·燕义》"}},{"id":35567,"word":"竭力虔心","pinyin":"jíe lì qián xīn","abbr":"jlqx","explanation":"诚心诚意地用全力做某件事情。","source":{"text":"始得展身敬，方乃遂心虔。","book":"南朝·梁·萧衍《游钟山大爱敬寺》诗"},"example":{"text":"了办好这所学校，大家都是～地工作着。"},"usage":"作定语、状语；用于处事"},{"id":35568,"word":"竭尽全力","pinyin":"jié jìn quán lì","abbr":"jjql","explanation":"竭尽：用尽。用尽全部力量。","source":{"text":"诛戮群公及何迈等，莫不尽心竭力，故帝凭其爪牙，无所忌惮。","book":"《宋书·宗越传》"},"example":{"text":"～地去反对第一个可能性，争取第二个可能性，反对第一个前途，争取第二个前途。","book":"毛泽东《论联合政府》"},"similar":["声嘶力竭","尽心竭力"],"opposite":["养精蓄锐"],"usage":"作谓语、状语；形容做出最大的努力","story":["东汉末年，新郑长杨沛资助曹操军粮受到曹操的任用，升为长社令。他不畏权势，秉公执法，受到曹操的赞许。将他提拔为京兆尹。他上任前向曹操保证要竭尽全力大力宣扬法治。地方的豪强地主和皇亲国戚听说杨沛要来邺城，纷纷收敛自己"]},{"id":35569,"word":"竭尽心力","pinyin":"jié jìn xīn lì","abbr":"jjxl","explanation":"竭：尽，用尽。用尽全部力量。","source":{"text":"竭尽心力，奉宣科法。","book":"《三国志·魏志·贾逵传》裴松之注引《魏略》"},"example":{"text":"所以无人再逢者，当由过去生中原未受恩，故不肯～缩地补天耳。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"}},{"id":35570,"word":"竭心尽意","pinyin":"jié xīn jìn yì","abbr":"jxjy","explanation":"竭：尽。尽心尽意。","source":{"text":"故竭心尽意，不敢为非耳。","book":"《三国志·吴志·诸葛瑾传》"}},{"id":35571,"word":"竭忠尽智","pinyin":"jié zhōng jìn zhì","abbr":"jzjz","explanation":"毫无保留地献出一片忠诚和所有才智。","source":{"text":"屈平正道直行，竭忠尽智，以事其君。","book":"《屈原列传》"}},{"id":35572,"word":"竭忠尽节","pinyin":"jié zhōng jìn jié","abbr":"jzjj","explanation":"竭尽忠诚和气节。","source":{"text":"欲危刘氏，赖忠正大臣绛侯、朱虚侯等竭诚尽节以灭之。","book":"汉·刘向《极谏用外戚封事》"},"example":{"text":"太尉庞参，～，徒以直道不能曲心，孤立群邪之间，自处中伤之地。","book":"《后汉书·庞参传》"}},{"id":35573,"word":"竭智尽力","pinyin":"jié zhì jìn lì","abbr":"jzjl","explanation":"用尽智慧和力量。","source":{"text":"臣虽尽力竭智，死不复见于王矣。","book":"西汉·刘向《战国策·赵策四》"},"example":{"text":"～，求得这种最大的贡献。","book":"邹韬奋《经历》五一"},"similar":["竭尽全力"],"usage":"作谓语；指竭尽全力"},{"id":35574,"word":"竭智尽忠","pinyin":"jié zhì jìn zhōng","abbr":"jzjz","explanation":"竭：尽。用尽智力，竭尽忠诚。","source":{"text":"屈原既放，三年不得复见，竭智尽忠。","book":"战国·楚·屈原《卜居》"},"usage":"作谓语；指用尽智力，竭尽忠诚"},{"id":35575,"word":"竭泽焚薮","pinyin":"jié zé fén sǒu","abbr":"jzfs","explanation":"竭：排水；薮：指草野。排干池水捕鱼，烧光草野捉兽。比喻做事不留余地，只顾眼前利益。","source":{"text":"竭泽而渔，岂不获得，而明年无鱼；焚薮而田，岂不获可，而明年无兽。诈伪之道，虽今偷可，后将无复，非长术也。","book":"《吕氏春秋·义赏》"},"similar":["竭泽焚林"],"usage":"作宾语、定语；用于处事"},{"id":35576,"word":"竭泽而渔","pinyin":"jié zé ér yú","abbr":"jzey","explanation":"泽：池、湖。掏干了水塘捉鱼。比喻取之不留余地，只图眼前利益，不作长远打算。也形容反动派对人民的残酷剥削。","source":{"text":"竭泽而渔，岂不获得，而明年无鱼。","book":"战国·卫·吕不韦《吕氏春秋·义赏》"},"example":{"text":"另外的错误观点，就是不顾人民困难，只顾政府和军队的需要，～，诛求无已。","book":"毛泽东《抗日时期的经济问题和财政问题》"},"similar":["杀鸡取卵","不留余地"],"opposite":["从长计议"],"usage":"作谓语、宾语、定语；指不作长远打算","story":["春秋时期，晋文公率军在城濮与楚国对峙，他问狐偃如何胜强大的楚军。狐偃献计用欺骗的办法。他又问雍季如何处理，雍季说用欺骗的办法只能是把池水弄干捉鱼，到第二年就没鱼捉了，打仗还是要靠实力。晋文公综合他们意见取得胜利"]},{"id":35577,"word":"竭诚以待","pinyin":"jié chéng yǐ dài","abbr":"jcyd","explanation":"竭诚：竭尽诚意；待：对待。竭尽诚意地对待别人。","source":{"text":"盖在殷忧，必竭诚以待下，既得志，则纵情以傲物。","book":"唐·魏徵《谏太宗十思疏》"}},{"id":35578,"word":"竭诚尽节","pinyin":"jié chéng jìn jié","abbr":"jcjj","explanation":"诚：忠诚；节：气节。竭尽忠诚和气节。","source":{"text":"赖忠正大臣绛侯、朱虚侯等竭诚尽节以诛灭之，然后刘氏复安。","book":"汉·刘向《极谏用外戚封事》"},"example":{"text":"公之弟兄，青紫交映，当谓～，上答鸿恩。","book":"《隋书·游元传》"},"usage":"作谓语、宾语；指竭尽忠诚和气节"},{"id":35579,"word":"竭诚相待","pinyin":"jié chéng xiāng dài","abbr":"jcxd","explanation":"竭诚：竭尽诚意；待：对待。竭尽诚意地对待别人。","source":{"text":"盖在殷忧，必竭诚以待下，既得志，则纵情以傲物。","book":"唐·魏徵《谏太宗十思疏》"},"example":{"text":"翌日，乃入谢汉王，汉王却～，礼意兼优，比那昨日情形不相同。","book":"蔡东藩《前汉演义》第二十六回"},"similar":["竭诚相见"],"usage":"作谓语、宾语；用于交往"},{"id":35580,"word":"端人正士","pinyin":"duān rén zhèng shì","abbr":"drzs","explanation":"指端庄正直的人。","source":{"text":"他好放肆，见端人正士以礼自持，却恐他来检点。","book":"宋·朱熹《朱子语类》第180卷"},"example":{"text":"盖亦替‘天朝’扫除～，使更易于长驱而入者。","book":"鲁迅《书信集·指杨霁云》"},"usage":"作宾语、定语；指端庄正直的人"},{"id":35581,"word":"端倪可察","pinyin":"duān ní kě chá","abbr":"dnkc","explanation":"端倪：线索。事情已经可以看出眉目来了。","source":{"text":"反复始终，不知端倪。","book":"《庄子·大宗师》"},"usage":"作谓语、定语；用于做事等"},{"id":35582,"word":"端本正源","pinyin":"duān běn zhèng yuán","abbr":"dbzy","explanation":"端：端正，清理。本：根本。源：根源。指从根本上加以整顿清理。","source":{"text":"端本正源者，虽不能无危，其危易持。","book":"《晋书·殷仲堪传》"},"similar":["端本清源"],"usage":"作谓语、宾语、定语；指从根本上治理"},{"id":35583,"word":"端本清源","pinyin":"duān běn qīng yuán","abbr":"dbqy","explanation":"端：端正，清理；本：根本；源：根源。指从根本上加以整顿清理。","source":{"text":"端本清源，立经陈纪，使阴邪退听。","book":"宋·朱熹《答龚参政书》"},"similar":["端本正源"],"usage":"作谓语、宾语、定语；指从根本上治理"},{"id":35584,"word":"端本澄源","pinyin":"duān běn chéng yuán","abbr":"dbcy","explanation":"犹正本清源。从根本上加以整顿清理。","source":{"text":"春秋之时，天王之使，交驰于列国，而列国之君，如京师者绝少。夫子谨而书之，固以正列国之罪，而端本澄源之意，其致责于天王者尤深矣。","book":"宋·罗大经《鹤林玉露》卷二"},"example":{"text":"《易》闲有家，《礼》严内则，皆以齐家为～之要，先生窥其深矣。","book":"清·周亮工《书影》卷一"},"similar":["端本清源","端本正源"],"usage":"作宾语、定语；指从根本上治理"},{"id":35585,"word":"端端正正","pinyin":"duān duān zhèng zhèng","abbr":"ddzz","explanation":"形式上、结构上或安排上协调相称，正正规规。","source":{"text":"粉光脂艳，端端正正坐在那里，手内拿着小铜火箸儿拨手炉内的灰。","book":"清·曹雪芹《红楼梦》第六回"},"example":{"text":"清·曹雪芹《红楼梦》第六回：“粉光脂艳，～坐在那里，手内拿着小铜火箸儿拨手炉内的灰。”"},"opposite":["歪歪斜斜"],"usage":"作定语、状语；用于有序的事物"},{"id":35586,"word":"竹头木屑","pinyin":"zhú tóu mù xiè","abbr":"ztmx","explanation":"比喻可利用的废物。","source":{"text":"时造船，木屑及竹头，悉令举掌之，咸不解所以。","book":"《晋书·陶侃传》"},"example":{"text":"时节相存问，缓急相周致，虽～亦有以应吾之须者，笃吾妹之分义于我也。","book":"宋·陈亮《祭妹夫周英伯》"},"similar":["木屑竹头"],"usage":"作主语、宾语、定语；指小东西","story":["东晋时期江西官吏陶侃秉公执法，诚恳待人，在担任武昌太守期间，处处以百姓的利益放在首位。他十分注重节约，把造船剩下的木屑用作冬天铺在雪上垫路之用，把剩下的竹头做成战船的竹钉又重新用到船上，人民纷纷称赞他"]},{"id":35587,"word":"竹帛之功","pinyin":"zhú bó zhī gōng","abbr":"zbzg","explanation":"竹帛：竹简和绢，古时用来写字，借指典籍。指名垂史册的功绩。","source":{"text":"今足下还归，扬名于匈奴，功显于汉室，虽古竹帛所载，丹青所画，何以过子卿！","book":"《汉书·苏武传》"},"example":{"text":"莫不持绳待试，贾勇争先；思垂～，誓雪朝廷之耻。（《旧唐书·郑畋传》）"}},{"id":35588,"word":"竹报平安","pinyin":"zhú bào píng ān","abbr":"zbpa","explanation":"凭借竹子报告平安。比喻报平安的家信。","source":{"text":"北都惟童子寺有竹一窠，才长数尺。相传其寺纲维每日报竹平安。","book":"唐·段成式《酉阳杂俎续集·支植下》"},"example":{"text":"无客问生死，有～。","book":"宋·韩元吉《水调歌头·席上次韵德和》词"},"usage":"作宾语、分句；指平安家信"},{"id":35589,"word":"竹杖化龙","pinyin":"zhú zhàng huà lóng","abbr":"zzhl","explanation":"借指得道成仙。","source":{"text":"忧不得到家，公以一竹枝与之，曰：‘但骑此得到家耳。’房骑竹杖辞去，忽如睡觉，已到家……所骑竹杖弃葛陂中，视之，乃青龙耳。","book":"语出晋·葛洪《神仙传》"}},{"id":35590,"word":"竹杖成龙","pinyin":"zhú zhàng chéng lóng","abbr":"zzcl","explanation":"竹杖化作一条龙。比喻得道成仙。","source":{"text":"忧不得到家，公以一竹杖与之曰：‘但骑此得到家耳。’房骑竹杖辞去，忽如睡觉，已到家……所骑竹杖弃葛陂中，视之，乃青龙耳。","book":"晋·葛洪《神仙传·壶公》"},"example":{"text":"蘋风入驭来应易，～去不难。（唐·骆宾王《代女道士王灵妃赠道士李荣》）"}},{"id":35591,"word":"竹杖芒鞋","pinyin":"zhú zhàng máng xié","abbr":"zzmx","explanation":"竹杖：用竹子做的手杖；芒鞋：草鞋。这些都是古人外出漫游地常备用具。也指到处漫游。","source":{"text":"芒鞋竹杖寒冻时，玉霄忽去非有期。","book":"唐·贯休《寒月送玄道士入天台》"},"example":{"text":"～轻胜马，谁怕？一蓑烟雨任平生。（宋·苏轼《定风波》词）"}},{"id":35592,"word":"竹杖芒鞵","pinyin":"zhú zhàng máng xié","abbr":"zzmx","explanation":"鞵：鞋。穿着草鞋，拿着竹杖。","source":{"text":"竹杖芒鞵轻胜马，谁怕，一蓑烟雨任平生。","book":"宋·苏轼《定风波》"},"similar":["芒鞋竹杖"],"usage":"作宾语、定语；用于书面语"},{"id":35593,"word":"竹林之游","pinyin":"zhú lí zhī yóu","abbr":"zlzy","explanation":"指无视名利的正人君子之间的交往。","source":{"text":"吾昔与嵇叔夜、阮嗣宗共酣饮於此垆。竹林之游，亦预其末。自嵇生夭、阮公亡以来，便为时所羁绁。今日视此虽近，邈若山河。","book":"南朝·宋·刘义庆《世说新语·伤逝》"},"example":{"text":"戎每与籍为～，戎尝后至。（《晋书·王戎传》）"},"usage":"作宾语；用于书面语"},{"id":35594,"word":"竹柏异心","pinyin":"zhú bǎi yì xīn","abbr":"zbyx","explanation":"比喻志向不合或表象不同。","source":{"text":"竹心空，屈原自喻志通达也；柏心实，以喻君暗塞也。言己性达道德，而君闭塞，其志不合，若竹柏之异心也。","book":"《楚辞·东方朔〈七谏·初放〉》：“孰知其不合兮，若竹柏之异心。”王逸注"},"example":{"text":"张衡通赡，蔡邕精雅，文史彬彬，隔世相望，是则～而同贞，金玉殊质而皆宝也。","book":"南朝·梁·刘勰《文心雕龙·才略》"},"usage":"作宾语、定语；用于比喻句"},{"id":35595,"word":"竹清松瘦","pinyin":"zhú qīng sōng shòu","abbr":"zqss","explanation":"形容人的外貌清瘦有神","source":{"text":"酒如春色好，春色年年如旧，青春元不老，君知否？席上看君，竹清松瘦，待与青春斗长久。","book":"宋·辛弃疾《感皇恩·为范倅寿》词"},"usage":"作宾语、定语；用于比喻句"},{"id":35596,"word":"竹烟波月","pinyin":"zhú yān bō yuè","abbr":"zyby","explanation":"烟：烟雾。雾气中的竹林和月照下的波纹。比喻月光下秀美的景色","source":{"text":"酒酣琴罢，又命乐童登中岛亭，合奏《霓裳散序》，声随风飘，或凝或散，悠扬子竹烟波月之际者久之。","book":"唐·白居易《池上篇》序"},"usage":"作宾语、定语；用于书面语"},{"id":35597,"word":"竹篮打水","pinyin":"zhú lán dá shuǐ","abbr":"zlds","explanation":"比喻白费气力，劳而无功。","source":{"text":"我见瞒人汉，如篮盛水走，一气将归家，篮里何曾有？","book":"唐·寒山《诗》"},"example":{"text":"唐二古怪和唐春早父子俩，年年～，两手空空。","book":"刘绍棠《蛾眉》"},"similar":["徒劳无益"],"usage":"作宾语、定语；指白费气力"},{"id":35598,"word":"竹篮打水一场空","pinyin":"zhú lán dǎ shuǐ yī chǎng kōng","abbr":"zldsyck","explanation":"比喻费了力没有效果。","source":{"text":"咳，这一业，竹蓝打水一场空了！","book":"梁斌《红旗谱》"},"example":{"text":"你别弄到一个～的下场。"},"similar":["徒劳无益"],"usage":"作宾语、定语、分句；指徒劳无益"},{"id":35599,"word":"竹篱茅舍","pinyin":"zhú lí máo shè","abbr":"zlms","explanation":"常指乡村中因陋就简的屋舍。","source":{"text":"尘风薄雪，残杯冷炙，掩青灯我竹篱茅舍。","book":"元·乔吉《卖花声·悟世》"},"example":{"text":"众人瞧那签上，画着一枝老梅，是写着“霜晓寒姿”四字，那一面旧诗是：～自甘心。","book":"清·曹雪芹《红楼梦》第六十三回"},"usage":"作宾语、定语；用于书面语"},{"id":35600,"word":"竹罄南山","pinyin":"zhú qìng nán shān","abbr":"zqns","explanation":"罄：尽，完。形容人罪恶极多，书写不尽","source":{"text":"到此是森罗殿上无私款，镜台前明照胆，要把君孽案重重彻里翻，竹罄南山。","book":"清·感惺《断头台·受献》"},"similar":["罄竹难书"],"usage":"作谓语、定语；用于书面语"},{"id":35601,"word":"竹苞松茂","pinyin":"zhú bāo sōng mào","abbr":"zbsm","explanation":"苞：茂盛。松竹繁茂。比喻家门兴盛。也用于祝人新屋落成。","source":{"text":"如竹苞矣，如松茂矣。","book":"《诗经·小雅·斯干》"},"example":{"text":"亲寿享，愿～，日月悠长。","book":"明·范世彦《磨忠记·杨涟家庆》"},"usage":"作宾语；用于祝人新屋落成或祝寿颂词"},{"id":35602,"word":"竹钉木屑","pinyin":"zhú dīng mù xiè","abbr":"zdmx","explanation":"屑：碎末。制造竹木器物剩下的废料。比喻细微的事物。也比喻可利用的废物。","source":{"text":"略五千架，圬墁赭垩，烛乎一川，竹钉木屑，皆适所用，前镇未之有也。","book":"唐·顾况《宛陵公署记》"},"example":{"text":"须知用世真经纶，正在～间。（清·李绿园《歧路灯》第九十三回）"}},{"id":35603,"word":"竹马之交","pinyin":"zhú mǎ zhī jiāo","abbr":"zmzj","explanation":"竹马：小孩当马骑的竹竿。童年时代就要好的朋友。","source":{"text":"郎骑竹马来，绕床弄青梅，同居长千里，两小无嫌猜。","book":"唐·李白《长干行》"},"example":{"text":"他和蔡文姬是～，他们是太亲密了。","book":"郭沫若《蔡文姬》第四幕第一场"},"similar":["青梅竹马","竹马之好","竹马之友"],"usage":"作宾语；指好朋友"},{"id":35604,"word":"竹马之友","pinyin":"zhú mǎ zhī yǒu","abbr":"zmzy","explanation":"指儿童时期的朋友。","source":{"text":"少时吾与浩共骑竹马，我弃去，浩辄取之。","book":"《晋书·殷浩传》"},"example":{"text":"他和明治天皇是～，自维新以来。","book":"郭沫若《羽书集·忠告日本政治家》"},"similar":["竹马之交","竹马之好"],"usage":"作宾语；指好朋友"},{"id":35605,"word":"竹马之好","pinyin":"zhú mǎ zhī hǎo","abbr":"zmzh","explanation":"指少年时骑竹马为戏之友。","source":{"text":"卿故复忆竹马之好不？","book":"南朝·宋·刘义庆《世说新语·方正》"},"similar":["竹马之交","竹马之友"],"usage":"作宾语；指好朋友"},{"id":35606,"word":"竿头一步","pinyin":"gān tóu yī bù","abbr":"gtyb","explanation":"比喻更进一步。","source":{"text":"勇猛精进，竿头一步。","book":"梁启超《南海康先生传》"},"similar":["百尺竿头，更进一步"],"usage":"作宾语、定语；用于学业等"},{"id":35607,"word":"竿头日上","pinyin":"gān tóu rí shàng","abbr":"gtrs","explanation":"竿头：竹竿尖头；上：上升。比喻学业进步很快。","source":{"text":"招贤大师赠一偈曰：百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。","book":"《秉烛谈》"},"similar":["竿头日进"],"usage":"作谓语、宾语；指学业等","story":["宋朝时期长沙高僧景岑佛学造诣高深，时常到各地去传道讲经，他讲得深入浅出，娓娓动听，听众与他谈论有关佛教的最高境界。他拿出偈帖给大家念道：“百丈竿头不动人，虽然得人未为真。百丈竿头须进步，十方世界是全身。”"]},{"id":35608,"word":"竿头日进","pinyin":"gān tóu rì jìn","abbr":"gtrj","explanation":"佛家语，比喻道行、造诣虽深，仍需修炼提高。比喻虽已达到很高的境地，但不能满足，还要进一步努力。","source":{"text":"（青青柳）复吟云：‘学问无穷水接天，竿头日进古人言。’","book":"清·无名氏《后会仙记》"},"example":{"text":"又春航数年前所唱西曲，无如今日之美满，实觉～，剧界前途，大有望于斯人云。","book":"苏曼殊《冯春航谈》"},"similar":["蒸蒸日上"],"usage":"作谓语；比喻学问不断上进"},{"id":35609,"word":"竿头直上","pinyin":"gān tóu zhí shàng","abbr":"gtzs","explanation":"比喻进步很快。"},{"id":35610,"word":"笃信好古","pinyin":"dǔ xìn hào gǔ","abbr":"dxhg","explanation":"笃：诚笃；信：诚实；好：热爱。坚持自己的信仰，喜爱古代的典籍。","source":{"text":"情贯经史，蜚声痒序，而弗竞弗求，笃信好古。","book":"明·刘基《陈司户墓志铭》"},"usage":"作谓语、宾语；用于书面语"},{"id":35611,"word":"笃信好学","pinyin":"dǔ xìn hào xué","abbr":"dxhx","explanation":"笃信：忠实地信仰。指对道德和事业抱有坚定的信心，勤学好问。","source":{"text":"子曰：‘笃信好学，守死善道。’","book":"《论语·泰伯》"},"example":{"text":"若夫～，志在生民者，略有三数。","book":"清·章炳麟《革命道德说》"},"usage":"作谓语；用于学习方面"},{"id":35612,"word":"笃学不倦","pinyin":"dǔ xué bù juàn","abbr":"dxbj","explanation":"笃学：专心好学；倦：疲倦。专心好学，不知疲倦。","source":{"text":"足下淳明慈良，有君子之器，又笃学不倦，其至于古人也奚御，愿益加之意，以果所望。","book":"明·方孝孺《与郑叔度书》"},"example":{"text":"年轻人要有～的治学精神。"},"similar":["好学不倦"],"usage":"作谓语、定语；指好学"},{"id":35613,"word":"笃学好古","pinyin":"dǔ xué hào gǔ","abbr":"dxhg","explanation":"笃学：专心好学。指专心致至地学习古代曲籍。","source":{"text":"济阴人马普笃学好古，瑜厚礼之。","book":"晋·陈寿《三国志·吴志·孙瑜传》"},"example":{"text":"情贯经史，蜚声痒序，而弗竞弗求，～。","book":"明·刘基《陈司户墓志铭》"},"usage":"作谓语；用于学习方面","story":["三国时期，东吴丹杨太守孙瑜特别喜欢研读古书，还勉励部下的子弟们读。他对笃学好古、知识渊博的济阴人马普十分尊敬，请他到府中教授将吏的子弟读书，并借机在丹杨、庐江两郡设立学宫，他自己常去讲课，学生达数百人"]},{"id":35614,"word":"笃定泰山","pinyin":"dǔ dìng tài shān","abbr":"ddts","explanation":"像泰山那样稳定。比喻有绝对把握，无须忧虑。","source":{"text":"那没问题，包在我身上，笃定泰山。","book":"周而复《上海的早晨》第一部"},"example":{"text":"这点配件就～可以完成。"},"similar":["十拿九稳"],"usage":"作谓语、状语、分句；指很有把握"},{"id":35615,"word":"笃实好学","pinyin":"dǔ shí hào xué","abbr":"dshx","explanation":"笃实：踏实，实在。认真踏实，爱好学问。","source":{"text":"衮笃实好学，有文才。","book":"《北史·张衮传》"},"example":{"text":"金陵邵衍字仲昌，～。","book":"宋·何薳《春渚纪闻·后土词读慢》"},"similar":["勤奋好学"],"usage":"作谓语、定语；用于学习"},{"id":35616,"word":"笃志不倦","pinyin":"dǔ zhì bù juàn","abbr":"dzbj","explanation":"笃志：志向专一；倦：厌倦。指学习志趣专一，不知疲倦。","source":{"text":"蒙始就学，笃志不倦。","book":"《江表传》"},"similar":["笃学不倦"],"usage":"作谓语、定语；用于学习"},{"id":35617,"word":"笃志好学","pinyin":"dǔ zhì hǎo xué","abbr":"dzhx","explanation":"笃志：专心一志，立志不变。专心致志，勤奋好学。","source":{"text":"笃志好学，师事九江太守房元。","book":"《后汉书·侯霸传》"},"example":{"text":"［曹摅］～，参南国中郎将，迁高密王左司马。","book":"郑振铎《插图本中国文学史》第十一章三"},"usage":"作谓语、宾语；用于学习"},{"id":35618,"word":"笃志爱古","pinyin":"dǔ zhì ài gǔ","abbr":"dzag","explanation":"笃志：志向专一。志趣专一，爱好古典。","source":{"text":"十六通《杜氏春秋》，下帷读书，笃志爱古。","book":"《北史·景穆十二王传》"},"usage":"作谓语、宾语；用于书面语"},{"id":35619,"word":"笃新怠旧","pinyin":"dǔ xīn dài jiù","abbr":"dxdj","explanation":"犹言喜新厌旧。喜欢新的，厌弃旧的。多指爱情不专一。","source":{"text":"人情多笃新怠旧，而况违隔二年，遥遥五千里外，而民之歌之，犹邠人之思古公也。","book":"明·吴承恩《〈留思录〉序》"},"similar":["喜新厌旧"],"usage":"作谓语、宾语、定语；指感情不专一"},{"id":35620,"word":"笃而论之","pinyin":"dǔ ér lùn zhī","abbr":"delz","explanation":"笃：切实。确切地论述。","source":{"text":"林公云：‘文度著腻颜，挟《左传》，逐郑康成，自为高足弟子；笃而论之，不离尘垢囊也！’","book":"晋·裴启《语林》"},"example":{"text":"追观光武二十八将，下及马援之徒，忠贞智勇无所不有，～，非减曩时。","book":"南朝·梁·元帝《金楼子·立言下》"},"usage":"作分句；用于说话或文章等"},{"id":35621,"word":"笃论高言","pinyin":"dǔ lùn gāo yán","abbr":"dlgy","explanation":"确切高明的言论。","source":{"text":"笃论高言，谆谆训诫，沃我心灵，开我眉瞆。","book":"清·王悔生《祭海峰先生文》"},"usage":"作宾语、定语；用于说话或文章等"},{"id":35622,"word":"笃近举远","pinyin":"dǔ jìn jǔ juǎn","abbr":"djjy","explanation":"笃：忠实，厚道；举：举荐，选拔。对关系近的厚道，对关系远的举荐，指同等待人。","source":{"text":"故圣人一视而同仁，笃近而举远。","book":"唐·韩愈《原人》"},"usage":"作谓语、定语；用于处世"},{"id":35623,"word":"笑不可仰","pinyin":"xiào bù kě yǎng","abbr":"xbky","explanation":"笑得直不起腰来。","source":{"text":"芳云又掩口语姝，两人皆笑不可仰。","book":"清·蒲松龄《聊斋志异·仙人岛》"},"example":{"text":"金玉姊妹合丫头们已经～，便是太太那等厚道人也就撑不住要笑。","book":"清·文康《儿女英雄传》第三十七回"},"usage":"作谓语、状语；用于欢笑时"},{"id":35624,"word":"笑中有刀","pinyin":"xiào zhōng yǒu dāo","abbr":"xzyd","explanation":"形容对人外表和气，内心却十分阴险毒辣。","source":{"text":"看不见李义府之辈笑欣欣，笑中有刀潜杀人。","book":"唐·白居易《天可度》诗"},"example":{"text":"既处权要，欲人附己，微忤意者，辄加倾陷。故时人言其～，又以其柔而害物，亦谓之‘李猫’。","book":"《旧唐书·李义府传》"},"similar":["笑里藏刀","笑处藏刀"],"usage":"作谓语、宾语、定语；指内心狠毒","story":["唐朝大臣李义府听说狱中有一个美貌的女犯，他叫狱吏毕正义释放她，然后就占为己有，大臣王义方告发毕正义。李义府逼毕正义上吊自杀，同时还在皇帝面前诋毁王义方，把他革职流放到边远地区。李义府表面谦和，暗中害人，笑里藏刀"]},{"id":35625,"word":"笑傲风月","pinyin":"xiào ào fēng yuè","abbr":"xafy","explanation":"犹言吟风弄月。形容心情悠闲自在。","source":{"text":"在草庐之中，但笑傲风月，抱膝危坐。","book":"明·罗贯中《三国演义》第四十三回"},"similar":["啸傲风月"],"usage":"作谓语、定语；用于书面语"},{"id":35626,"word":"笑处藏刀","pinyin":"xiào chù cáng dāo","abbr":"xccd","explanation":"形容对人外表和气，内心却十分阴险毒辣。","source":{"text":"威权震主，势焰薰人，笑处藏刀，毒性有如蜂虿。","book":"清·李渔《蜃中楼·点差》"},"similar":["笑里藏刀","笑中藏刀"],"usage":"作谓语、宾语、定语；指内心狠毒"},{"id":35627,"word":"笑容可掬","pinyin":"xiào róng kě jū","abbr":"xrkj","explanation":"掬：双手捧取。形容笑容满面。","source":{"text":"果见孔明坐于城楼之上，笑容可掬，焚香操琴。","book":"明·罗贯中《三国演义》第九十五回"},"example":{"text":"这些学生们一天总是那么活泼开朗，～。"},"similar":["眉开眼笑","喜形于色"],"opposite":["愁眉苦脸","咬牙切齿"],"usage":"作谓语、定语、状语；形容人很高兴的样子","story":["三国时期，司马懿率军进攻蜀国街亭，诸葛亮派马谡驻守失败。司马懿乘胜直逼西城，诸葛亮无兵迎敌，但沉着镇定，大开城门，笑容可掬地坐在城楼上弹琴。司马懿怀疑设有埋伏，引兵退去。等得知西城是空城回去再战，赵云急忙赶回解围"]},{"id":35628,"word":"笑容满面","pinyin":"xiào róng mǎn miàn","abbr":"xrmm","explanation":"满脸洋溢着喜笑的容颜。形容内心欣喜、满脸和悦的神态。","source":{"text":"张劭笑容满面，再拜于地。","book":"明·冯梦龙《喻世明言》卷十六"},"example":{"text":"那姓焦的心上虽然焦躁，看着秋谷～的好好和他讲话，便也发作不出来。","book":"清·张春帆《九尾龟》第一百三十九"},"similar":["满面笑容","笑容可掬"],"opposite":["愁眉苦脸"],"usage":"作谓语、定语、状语；用于人的表情"},{"id":35629,"word":"笑比河清","pinyin":"xiào bǐ hé qīng","abbr":"xbhq","explanation":"形容态度严肃，难见笑容。","source":{"text":"立朝刚毅，贵戚宦官为之敛手，闻者皆惮之。人以包拯笑比黄河清。","book":"《宋史·包拯传》"},"example":{"text":"老着那副～的面孔，三句话不合，便反插了两只眼睛叫将起来。","book":"清·文康《儿女英雄传》第35回"},"usage":"作谓语、宾语、补语；形容态度严肃"},{"id":35630,"word":"笑而不答","pinyin":"xiào ér bù dá","abbr":"xebd","explanation":"只是微笑着，不作正面回答。","source":{"text":"问余何意栖碧山，笑而不答心自闲。","book":"唐·李白《山中问答》诗"},"example":{"text":"钱钟书《围城》：“大家都说辛楣心平气和得要成‘圣人’了，圣人～。”"},"usage":"作谓语、状语；用于处事"},{"id":35631,"word":"笑语指麾","pinyin":"xiào yǔ zhǐ huī","abbr":"xyzh","explanation":"麾：通“挥”，指挥。指边笑边谈，边调度指挥。","source":{"text":"纂辞奋笔，涣若不思；公牒盈前，笑语指麾。","book":"唐·韩愈《杜君墓志铭》"},"usage":"作谓语、定语；用于处事"},{"id":35632,"word":"笑貌声音","pinyin":"xiào mào shēng yīn","abbr":"xmsy","explanation":"谈笑的神态，说话的声音。原指虚伪的言语、表情。后泛指言谈、态度。","source":{"text":"恭俭岂可以声音笑貌为哉？","book":"《孟子·离娄上》"},"example":{"text":"女辗转床第，绝而复苏者数次，迨至转危为安，～，不殊常度，而言动举止，如出两人。","book":"清·淮阴百一居士《壶天录》卷下"},"similar":["声音笑貌"],"usage":"作主语、宾语、定语；指人的言谈、表情等"},{"id":35633,"word":"笑逐颜开","pinyin":"xiào zhú yán kāi","abbr":"xzyk","explanation":"逐：追随；颜：脸面，面容；开：舒展开来。笑得使面容舒展开来。形容满脸笑容，十分高兴的样子。","source":{"text":"宋江见了，喜从天降，笑逐颜开。","book":"明·施耐庵《水浒全传》第四十二回"},"example":{"text":"他们听到这个好消息，一个个～。"},"similar":["眉开眼笑","喜眉笑眼"],"opposite":["忧心忡忡","闷闷不乐"],"usage":"作谓语、定语、状语；指高兴的样子"},{"id":35634,"word":"笑里藏刀","pinyin":"xiào lǐ cáng dāo","abbr":"xlcd","explanation":"形容对人外表和气，却阴险毒辣。","source":{"text":"义府貌状温恭，与人语必嬉怡微笑，而褊忌阴贼。既处要权，欲人附己，微忤意者，辄加倾陷。故时人言义府笑中有刀。","book":"《旧唐书·李义府传》"},"example":{"text":"他把我丕的来药倒，烟生七窍，冰浸四稍，谁承望～，眼见的丧荒郊。","book":"元·孟汉卿《魔合罗》第二折"},"similar":["佛口蛇心","口是心非","笑处藏刀"],"opposite":["心口不一","推心置腹"],"usage":"作谓语、宾语、定语；指内心狠毒","story":["唐朝大臣李义府听说狱中有一个美貌的女犯，他叫狱吏毕正义释放她，然后就占为己有，大臣王义方告发毕正义。李义府逼毕正义上吊自杀，同时还在皇帝面前诋毁王义方，把他革职流放到边远地区。李义府表面谦和，暗中害人，笑里藏刀"]},{"id":35635,"word":"笑面夜叉","pinyin":"xiào miàn yè chā","abbr":"xmyc","explanation":"比喻面带笑容而居心狠毒的人。","source":{"text":"时人目之为笑面夜叉，天下之所共知也。","book":"宋·陈次升《弹蔡京第三状》"},"example":{"text":"他这个～不好对付。"},"similar":["笑面虎"],"usage":"作主语、宾语、定语；指内心狠毒的人","story":["宋朝时期，蔡卞等人广植党羽、朋比为奸，朝野上下都是他们的党羽。陈次升对此非常愤慨，多次给宋哲宗上书弹劾他，他在《弹蔡京第三状》中写道：“蔡京过分挑剔别人的缺点，恶意中伤大臣。蔡卞是笑面夜叉，他们的劣迹目不忍闻。”"]},{"id":35636,"word":"笑面老虎","pinyin":"xiào miàn lǎo hǔ","abbr":"xmlh","explanation":"比喻外表善良，心地凶狠的人。","source":{"text":"现在，我算领教到他这微笑的厉害了——简直是笑面老虎。","book":"李良杰《人生》"},"similar":["笑面虎"],"usage":"作主语、宾语、定语；指心地凶狠的人"},{"id":35637,"word":"笑面虎","pinyin":"xiào miàn hǔ","abbr":"xmh","explanation":"比喻外表善良，心地凶狠的人。","source":{"text":"公衮性甚和，平居常若嬉笑，人谓之笑面虎。","book":"宋·庞元英《谈薮》"},"example":{"text":"～是比较难对付的。"},"similar":["笑面老虎"],"opposite":["凶神恶煞"],"usage":"作主语、宾语、定语；指心地凶狠的人"},{"id":35638,"word":"笑骂从汝","pinyin":"xiào mà cóng rǔ","abbr":"xmcr","explanation":"指对他人的讥讽置之不理。","source":{"text":"笑骂从汝，好官须我为之。","book":"《宋史·邓绾传》"},"example":{"text":"走我自己的路，～吧。"},"similar":["笑骂由人"],"usage":"作谓语、定语；指不屑一顾","story":["北宋时期，王安石推行新法，邓绾想巴结王安石就上书宋神宗赵顼，露骨地吹捧王安石等人像伊尹、吕尚一样，推行青苗法、免役法深得人心。王安石将他推荐给宋神宗，神宗任命他为集贤院校理，他对别人的笑骂置之不理"]},{"id":35639,"word":"笑骂由人","pinyin":"xiào mà yóu rén","abbr":"xmyr","explanation":"指对他人的讥讽置之不顾。","source":{"text":"乡人在都者皆笑且骂，绾曰：‘笑骂从汝，好官须我为之。’","book":"《宋史·邓绾传》"},"example":{"text":"欺夫婆子怕婆夫，～我自吾。","book":"清·褚人获《隋唐演义》第七十六回"},"similar":["笑骂从汝"],"usage":"作谓语、定语；用于处事"},{"id":35640,"word":"笑骂由他笑骂，好官我自为之","pinyin":"xiào mà yóu tā xiào mà，hǎo guān wǒ zì wéi zhī","abbr":"xmytxmhgwzwz","explanation":"指为官声名很坏，任凭人们笑骂，还是泰然自若当自己的官。","source":{"text":"笑骂从汝，好官须我为之。","book":"《宋史·邓绾传》"},"example":{"text":"并劝他‘下野以示坦白’，不要‘～’。","book":"陶菊隐《北洋军阀统治时期史话》第53章"},"usage":"作宾语、定语；用于处事等","story":["北宋时期，王安石推行新法，邓绾想巴结王安石就上书宋神宗赵顼，露骨地吹捧王安石等人像伊尹、吕尚一样，推行青苗法、免役法深得人心。王安石将他推荐给宋神宗，神宗任命他为集贤院校理，他对别人的笑骂置之不理"]},{"id":35641,"word":"笔下春风","pinyin":"bǐ xià chūn fēng","abbr":"bxcf","explanation":"形容绘画、作文栩栩如生，如同春风来到笔底下。也比喻能使人受惠的文字。","source":{"text":"当时妙手貌不成，君王笔下春风生。","book":"宋·王庭珪《卢溪集·题宣和御画》"},"example":{"text":"西飞青雀几时还，贝阙琳宫缥缈间。～殊未老，蟠桃积核已如山。","book":"元·黄溍《瑶池春宴图》"}},{"id":35642,"word":"笔下有铁","pinyin":"bǐ xià yǒu tiě","abbr":"bxyt","explanation":"铁：兵器，如刀剑之类。形容文笔锋利。"},{"id":35643,"word":"笔下生花","pinyin":"bǐ xià shēng huā","abbr":"bxsh","explanation":"比喻文人才思俊逸，写作的诗文极佳。","source":{"text":"李太白少时梦所用之笔头上生花，后天才赡逸，名闻天下。","book":"五代·王仁裕《开元天宝遗事下》"},"example":{"text":"晚唐诗人杜牧才气过人，～，创作了许多诗文佳品，尤以《阿房宫赋》传诵千古。"},"similar":["妙笔生花"],"usage":"作谓语、定语；指能写好文章"},{"id":35644,"word":"笔下留情","pinyin":"bǐ xià liú qíng","abbr":"bxlq","explanation":"指写文章时作者的措词和用意委婉留有情面。","example":{"text":"记者同志，请～。"},"usage":"作谓语、宾语；用于作文等"},{"id":35645,"word":"笔下超生","pinyin":"bǐ xià chāo shēng","abbr":"bxcs","explanation":"超生：佛家语，指人死后灵魂投生为人。为了免使他人受难，书写时，在用意和措词方面都给予宽容或开脱。","source":{"text":"实是不忍他含冤负屈，故此来到台前控诉，乞老爷笔下超生。","book":"明·凌濛初《二刻拍案惊奇》第11卷"},"example":{"text":"果照此说，我实在应该谢谢你～了。","book":"巴金《家·附录二》"},"similar":["笔底超生"],"usage":"作谓语；指尽可能宽容"},{"id":35646,"word":"笔伐口诛","pinyin":"bǐ fá kǒu zhū","abbr":"bfkz","explanation":"伐：声讨，攻打；诛：痛斥，责罚。从口头和书面上对坏人坏事进行揭露和声讨。","source":{"text":"明·汪廷讷《三祝记·同谪》：“他捐廉弃耻，向权门富贵贪求，全不知口诛笔伐是诗人句，垄上璠间识者羞。"},"example":{"text":"而吾辈不畏强御，不避斧钺，～，大声疾呼。","book":"清·忧患余生《官场现形记序》"},"similar":["口诛笔伐"],"usage":"作谓语、宾语、定语；表示对坏人坏事的揭发"},{"id":35647,"word":"笔冢研穿","pinyin":"bǐ zhǒng yán chuān","abbr":"bzyc","explanation":"秃笔成坟，砚磨穿孔。指写作著述功力极深。","source":{"text":"支言俚说不足供酱瓿，而翼飞胫走，较拈髭呕血笔冢研穿者，售不售反霄壤隔也。","book":"明·凌濛初《〈二刻拍案惊奇〉小引》"},"usage":"作定语；指人的文笔"},{"id":35648,"word":"笔削褒贬","pinyin":"bǐ xiāo bāo biǎn","abbr":"bxbb","explanation":"笔：记载；削：删改。原指孔子作《春秋》，用文字来评论人物的好坏。也指用文字褒扬、贬斥人或事。","source":{"text":"《春秋》自孔子加笔削褒贬，为后世立法，而后《春秋》不仅为记事之书。","book":"清·皮锡瑞《经学历史·经学开辟时代》"},"usage":"作宾语、定语；指修改文章"},{"id":35649,"word":"笔力独扛","pinyin":"bǐ lì dú gāng","abbr":"bldk","explanation":"扛：用两手举。形容文笔雄健，文章的气势极大。","source":{"text":"龙文百斛鼎，笔力可独扛。","book":"唐·韩愈《病中赠张十八》"}},{"id":35650,"word":"笔参造化","pinyin":"bǐ cān zào huà","abbr":"bczh","explanation":"造化：创造化育。一支笔参与了创造化育。形容文笔高妙。","source":{"text":"笔参造化，学究天人。","book":"唐·李白《与韩荆州书》"},"usage":"作谓语、定语；指人的文笔"},{"id":35651,"word":"笔墨之林","pinyin":"bǐ mò zhī lín","abbr":"bmzl","explanation":"斯文萃集的地方。","source":{"text":"汉家极笔墨之林，书论之造，汉家尤多。","book":"汉·王充《论衡·对作》"},"example":{"text":"使其间稍伏机心，略藏匕首，造物且诛之不暇，肯容自作孽者老而不死，独得佯狂自肆于～哉！","book":"清·李渔《闲情偶寄·词曲·结构》"},"usage":"作主语、宾语；指文化场所等"},{"id":35652,"word":"笔墨官司","pinyin":"bǐ mò guān sī","abbr":"bmgs","explanation":"笔墨：指文字或文章。比喻用文字进行的辩论、争执。","source":{"text":"借他人酒杯，浇自己块垒，非仅为懵懂辈饶舌，打无谓笔墨官司也。","book":"清·许叶芬《红楼梦辨》"},"example":{"text":"雍正、乾隆都自负才辩，喜欢跟臣下打～，御笔上谕动辄数百言。","book":"《玉座珠帘》上册"},"similar":["笔枪纸弹","笔诛墨伐"],"opposite":["刀兵相见"],"usage":"作宾语、定语；比喻用文字争论"},{"id":35653,"word":"笔墨横姿","pinyin":"bǐ mò héng zī","abbr":"bmhz","explanation":"指书画诗文美妙多姿。","source":{"text":"虽间涉游戏三昧，而奇情壮采，议论风生，笔墨横姿，几令读者心目俱眩，亦异才也。","book":"清·伍崇曜《〈陶庵梦忆〉跋》"},"usage":"作谓语；指人的文笔"},{"id":35654,"word":"笔墨纸砚","pinyin":"bǐ mò zhǐ yàn","abbr":"bmzy","explanation":"指书写工具。","source":{"text":"就叫家人将带来的笔墨纸砚分在各人面前，大家做诗。","book":"清·荑荻散人《玉娇梨》第16回"},"similar":["文房四宝","文房四侯","文房四物"],"usage":"作主语、宾语；指书写工具"},{"id":35655,"word":"笔大如椽","pinyin":"bǐ dà rú chuán","abbr":"bdrc","explanation":"形容著名的文章。也指有名的作家。","source":{"text":"珣梦人以大笔如椽与之，既觉，语人曰：‘此当有大手笔事。’","book":"《晋书·王珣传》"},"example":{"text":"词清若玉，～。","book":"清·陶曾佑《论小说之势力及其影响》"},"similar":["如椽大笔","笔力扛鼎"],"usage":"作谓语、状语；用于大作家、大书法家等"},{"id":35656,"word":"笔头生花","pinyin":"bǐ tóu shēng huā","abbr":"btsh","explanation":"比喻写作能力大有进步。也形容文章写得很出色。","source":{"text":"李太白少梦笔头生花，后天才瞻逸，名闻天下。","book":"唐·冯贽《云仙杂记》第十卷"},"example":{"text":"他很想～。"},"similar":["笔底生花"],"usage":"作谓语、宾语；指文章写得好","story":["唐代大诗人李白少年时曾经做过一个奇特的梦，他梦见自己使用的笔尖头开出了鲜艳的花朵，一张张白纸自动飞到他眼前，他高兴极了，就抓起妙笔飞快地写了起来，落在纸上的却是一朵朵盛开的鲜花，他的许多著名的诗篇流传至今"]},{"id":35657,"word":"笔底春风","pinyin":"bǐ dǐ chūn fēng","abbr":"bdcf","explanation":"形容绘画、诗文生动，如春风来到笔下。","source":{"text":"西飞青雀几时还，贝阙琳宫缥缈间，笔底春风殊未老，蟠桃积核已如山。","book":"元·黄溍《瑶池春宴图》诗"},"usage":"作主语、宾语；用于文章等"},{"id":35658,"word":"笔底烟花","pinyin":"bǐ dǐ yān huā","abbr":"bdyh","explanation":"比喻文章写得生动、出色。","source":{"text":"笔底烟花传海国，袖中诗句落吴船。","book":"清·钱泳《履园丛话·画学·画中人》"},"similar":["笔底生花"],"usage":"作主语、谓语；指文章写得好"},{"id":35659,"word":"笔底生花","pinyin":"bǐ dǐ shēng huā","abbr":"bdsh","explanation":"形容文采特异，作品华丽。","source":{"text":"有的同学则富于想象，笔底生花，具有当诗人的气质。","book":"谢冕《远方的星》"},"example":{"text":"她～，下笔千言。"},"similar":["笔头生花"],"usage":"作谓语；指文章写得好"},{"id":35660,"word":"笔底超生","pinyin":"bǐ dǐ chāo shēng","abbr":"bdcs","explanation":"犹言笔下超生。超生：佛家语。为了免使他人受难，书写时，在用意和措词方面都给予宽容或开脱。","source":{"text":"严冷无情的法官定了你的死罪之后，就从不会有笔底超生的事。","book":"苏雪林《闲话战争·齿患》"},"similar":["笔下超生"],"usage":"作谓语、定语；指尽可能宽容"},{"id":35661,"word":"笔底龙蛇","pinyin":"bǐ dǐ lóng shé","abbr":"bdls","explanation":"犹言笔走龙蛇。形容书法生动而有气势。","source":{"text":"闻公博学广记，笔底龙蛇，真才子也。","book":"明·兰陵笑笑生《金瓶梅词话》第三十一回"},"similar":["笔走龙蛇"],"usage":"作谓语、定语；指人的书法或文笔"},{"id":35662,"word":"笔扫千军","pinyin":"bǐ sǎo qiān jūn","abbr":"bsqj","explanation":"形容笔力雄健，如同有横扫千军万马的气势。","source":{"text":"词源倒流三峡水，笔阵横扫千人军。","book":"唐·杜甫《醉歌行》诗"},"example":{"text":"～空自负，学传三箧意何施。","book":"元·李庭《吊郭器之二首》"},"usage":"作谓语、宾语；形容笔力雄健"},{"id":35663,"word":"笔枪纸弹","pinyin":"bǐ qiāng zhǐ dàn","abbr":"bqzd","explanation":"以笔为枪，以纸为子弹。指用文字作为战斗的武器。","source":{"text":"现丰很流行的用语，指笔和书报为‘笔枪纸弹’。","book":"邹韬奋《抗战以来·“笔杆暴动”》"},"usage":"作主语、宾语、定语；指文人的工具"},{"id":35664,"word":"笔歌墨舞","pinyin":"bǐ gē mò wǔ","abbr":"bgmw","explanation":"指文笔奇妙精采。","source":{"text":"只见当朝圣人出的是三个富丽堂皇的题目，想着自然要取几篇笔歌墨舞的文章。","book":"清·文康《儿女英雄传》第三十四回"},"usage":"作宾语、定语；指写作"},{"id":35665,"word":"笔笔直直","pinyin":"bǐ bǐ zhí zhí","abbr":"bbzz","explanation":"非常直，没有曲折、弯弧或棱角。","example":{"text":"我们经过一条～的大道就到达了目的地。"},"opposite":["弯弯曲曲"],"usage":"作谓语、定语、状语；用于物体或道路等"},{"id":35666,"word":"笔精墨妙","pinyin":"bǐ jīng mò miào","abbr":"bjmm","explanation":"笔触精到，着墨巧妙。形容书法、绘画、诗文等的技法巧妙，笔意精微。","source":{"text":"吾观文士多利用，笔精墨妙诚堪重。","book":"唐·鲁收《怀素上人草书歌》"},"example":{"text":"非～，情高格逸，其能与于此耶？","book":"《宣和画谱·孙位》卷二"}},{"id":35667,"word":"笔翰如流","pinyin":"bǐ hàn rú liú","abbr":"bhrl","explanation":"指文笔快捷无滞。","source":{"text":"远近书疏，莫不手答，笔翰如流未尝壅滞。","book":"《晋书·陶侃传》"},"usage":"作谓语、定语；指人的文笔"},{"id":35668,"word":"笔老墨秀","pinyin":"bǐ lǎo mò xiù","abbr":"blmx","explanation":"指笔姿老到而墨韵清秀。","source":{"text":"李侍郎微之，谓笔老墨秀，挟海上风涛之气，当为海内苏书第一，诚知言也。","book":"明·宋濂《跋东坡书〈乳泉赋〉后》"},"usage":"作谓语、定语；指人的文笔"},{"id":35669,"word":"笔耕砚田","pinyin":"bǐ gēng yàn tián","abbr":"bgyt","explanation":"比喻从事脑力劳动，以读写为业。","source":{"text":"既笔耕为养，亦佣书成学。","book":"汉·许慎《说文解字》：“庶有达者理而董之”句下段玉裁注：“每诵先王父诗句云：‘不种砚田无乐事，不撑铁骨莫支贫。’”《文选·任昉·为萧扬州荐士表》"},"usage":"作谓语；指以读写为职业"},{"id":35670,"word":"笔补造化","pinyin":"bǐ bǔ zào huà","abbr":"bbzh","explanation":"笔墨可以弥补自然界的不足。形容笔墨的作用大，笔力高超。","source":{"text":"二十八宿罗胸中，元精耿耿贯当中。殿前作赋声摩空，笔补造化天无功。","book":"唐·李贺《高轩过》"},"example":{"text":"不赞元戎赞丞相，～裨盐梅。","book":"宋·杨万里《寄题周元吉湖北漕司志功堂》"}},{"id":35671,"word":"笔诛墨伐","pinyin":"bǐ zhū mò fá","abbr":"bzmf","explanation":"笔、墨：指文字。诛：谴责。伐：声讨。通过文字加以谴责，进行声讨。","example":{"text":"我们通过～，终于迫使他向大家道歉。"},"similar":["口诛笔伐"],"usage":"作谓语、宾语、定语；用于对坏人坏事等"},{"id":35672,"word":"笔走龙蛇","pinyin":"bǐ zǒu lóng shé","abbr":"bzls","explanation":"形容书法生动而有气势。","source":{"text":"时时只见龙蛇走，左盘右蹙旭惊电。","book":"唐·李白《草书歌行》"},"example":{"text":"秀才肖王宾胸藏锦绣，～。","book":"明·凌濛初《初刻拍案惊》卷二十"},"similar":["龙飞凤舞","字走龙蛇"],"usage":"作谓语；形容书法笔势矫健多姿","story":["唐朝时期，秘书监贺知章在府上宴请宾客，李白在席上作诗《草书歌行》。玄奘法师的弟子怀素善长草书，当众被要求作书法，怀素援笔蘸墨，凝神运气挥毫，很快写就，贺知章赞叹道：“上人书写，左盘右旋，真是笔走龙蛇。”"]},{"id":35673,"word":"笔酣墨饱","pinyin":"bǐ hān mò bǎo","abbr":"bhmb","explanation":"指文章表达流畅，内容充足。","source":{"text":"那些作品的作者在节骨眼上，没有真正做到笔酣墨饱，因此，便不能获得预期的作用了。","book":"秦牧《艺海拾贝·巨日》"},"example":{"text":"钱钟书《围城》：“而上面开的地址‘外交部欧美司’六字，～，字字端楷，文盲在墨夜里也该一目了然的。”"},"similar":["笔饱墨酣"],"usage":"作宾语、定语；指文学作品"},{"id":35674,"word":"笔饱墨酣","pinyin":"bǐ bǎo mò hān","abbr":"bbmh","explanation":"笔力饱满，用墨充足。形容诗文酣畅浑厚。","source":{"text":"张孝祥《六州歌头》，淋漓痛快，笔饱墨酣，读之令人起舞。","book":"清·陈廷焯《白雨斋诗话》"},"similar":["笔酣墨饱"],"usage":"作宾语、定语；用于文章"},{"id":35675,"word":"笙歌鼎沸","pinyin":"shēng gē dǐng fèi","abbr":"sgdf","explanation":"形容乐声歌声热闹非凡。","source":{"text":"此日又有龙舟可观，都人不论贫富，倾城而出，笙歌鼎沸，鼓吹喧天。","book":"宋·吴自牧《梦梁录·清明节》"},"example":{"text":"元·高明《琵琶记·新进士宴杏园》：“黄旗影里，～。”"},"usage":"作谓语、定语；用于书面语"},{"id":35676,"word":"笙磬同音","pinyin":"shēng qìng tóng yīn","abbr":"sqty","explanation":"笙：簧管乐器；磬：古代石制打击乐器。笙和磬发出的音响和谐。比喻人事协调，关系和睦。","source":{"text":"鼓瑟鼓琴，笙磬同音。","book":"《诗经·小雅·鼓钟》"},"example":{"text":"～，惟房与杜。","book":"《旧唐书·房玄龄杜如晦传赞》"},"opposite":["琴瑟不调"],"usage":"作谓语、定语；指关系融洽"},{"id":35677,"word":"笞杖徒流","pinyin":"chī zhàng tú liú","abbr":"cztl","explanation":"笞：鞭打；杖：棒打；徒：徒刑；流：流放。指古代的四种刑罚。","source":{"text":"本是些风花雪月，都做了笞杖徒流。","book":"元·乔孟符《金钱记》第三折"},"usage":"作宾语、定语；指刑罚"},{"id":35678,"word":"笨口拙舌","pinyin":"bèn kǒu zhuō shé","abbr":"bkzs","explanation":"没有口才，不善言谈。","source":{"text":"部队作风，说话又尖又硬，丝毫不留情面，又满有一套理论，笨口拙舌的大老粗。","book":"秦兆阳《在田野上前进》第一章"},"example":{"text":"她～，说不出两句话。"},"similar":["笨嘴拙舌"],"opposite":["伶牙俐齿"],"usage":"作谓语、定语；指口才不好"},{"id":35679,"word":"笨嘴拙腮","pinyin":"bèn zuǐ zhuō sāi","abbr":"bzzs","explanation":"口才不行，不会说话。","source":{"text":"这个身高一米八的小伙子，还是像小时候一样笨嘴拙腮的。","book":"熊尚志《藕和花的故事》"},"example":{"text":"～的王老吉此时活跃起来了。"},"similar":["笨嘴笨舌"],"opposite":["伶牙俐齿"],"usage":"作谓语、定语；指口才不好"},{"id":35680,"word":"笨嘴拙舌","pinyin":"bèn zuǐ zhuō shé","abbr":"bzzs","explanation":"拙：不巧。形容没有口才，不善言辞。","source":{"text":"刘公之低着头，用大手搓着大腿，挺为难地说：‘我这个人，笨嘴拙舌的，谈什么呢？’","book":"杨朔《石油城》"},"example":{"text":"部队作风，说话又尖又硬，丝毫不留情面，又满有一套理论，～的大老粗，真说不过他。","book":"秦兆阳《在田野上前进》第一章"},"similar":["拙嘴笨脑","笨口拙舌"],"opposite":["伶牙俐齿","口若悬河","能说会道"],"usage":"作谓语、定语；用于谦辞"},{"id":35681,"word":"笨嘴笨腮","pinyin":"bèn zuǐ bèn sāi","abbr":"bzbs","explanation":"笨：不灵巧。说话表达能力很差。","source":{"text":"笨：不灵巧。说话表达能力很差。"},"similar":["笨嘴笨舌"],"opposite":["伶牙俐齿"],"usage":"作谓语、定语；指没有口才"},{"id":35682,"word":"笨嘴笨舌","pinyin":"bèn zuǐ bèn shé","abbr":"bzbs","explanation":"说话表达能力很差，没有口才。","source":{"text":"冯永祥平时以能说会道出名于工商界的，现在却变得好像是一个笨嘴笨舌的人了。","book":"周而复《上海的早晨》第一部"},"example":{"text":"我怎么会变得～呢？"},"similar":["笨嘴拙舌"],"opposite":["油嘴滑舌","能说会道"],"usage":"作谓语、定语、状语；指没有口才"},{"id":35683,"word":"笨头笨脑","pinyin":"bèn tóu bèn nǎo","abbr":"btbn","explanation":"笨：愚钝。形容不聪明，头脑反应迟钝。","example":{"text":"他一向都是～的。"},"similar":["笨手笨脚"],"opposite":["聪明伶俐"],"usage":"作谓语、定语；指人迟钝"},{"id":35684,"word":"笨手笨脚","pinyin":"bèn shǒu bèn jiǎo","abbr":"bsbj","explanation":"形容动作不灵活。","source":{"text":"才是笨手笨脚，无啥人来搭耐装烟。","book":"清·韩邦庆《海上花列传》第24回"},"example":{"text":"他这个人做事来～的。"},"similar":["笨头笨脑"],"opposite":["聪明伶俐"],"usage":"作谓语、定语、状语；指不灵活"},{"id":35685,"word":"笨鸟先飞","pinyin":"bèn niǎo xiān fēi","abbr":"bnxf","explanation":"行动笨拙的鸟要先飞。比喻能力差的人怕落后，做事比别人先动手。","source":{"text":"我和你有个比喻：我似那灵禽在后，你这等坌（笨）鸟先飞。","book":"元·关汉卿《陈母教子》第一折"},"example":{"text":"女儿刻苦、自觉、用功，全靠～保持了各门功课全班第一。","book":"毕飞宇《九层电梯》"},"similar":["慢鸟先飞","坌鸟先飞"],"opposite":["坐以待毙"],"usage":"作谓语、定语；比喻能力差的人加倍努力"},{"id":35686,"word":"第一夫人","pinyin":"dì yī fū rén","abbr":"dyfr","explanation":"一国中国家元首的妻子。","source":{"text":"她很想当～。"},"example":{"text":"她很想当～"},"usage":"作主语、宾语、定语；用于女性"},{"id":35687,"word":"笼中之鸟","pinyin":"lóng zhōng zhī niǎo","abbr":"lzzn","explanation":"比喻受困而不自由的人，也比喻易于擒拿的敌人。","source":{"text":"一目之罗，不可以得雀；笼中之鸟空窥不出。","book":"《鹖冠子·世兵》"},"example":{"text":"今六帅齐奋，诸侯同举，此～耳。","book":"宋·司马光《资治通鉴·齐顺帝昇明元年》"},"similar":["笼中穷鸟"],"usage":"作主语、宾语；形容丧失自由"},{"id":35688,"word":"笼中穷鸟","pinyin":"lóng zhōng qióng niǎo","abbr":"lzqn","explanation":"被关在笼中的鸟。比喻受困而不自由的人；也比喻易于擒拿的敌人。","source":{"text":"那人呵，好似笼中穷鸟，釜底枯鱼，顷刻成擒。","book":"明·许自昌《水浒传·义什》"},"similar":["笼中之鸟"],"usage":"作主语、宾语；用于比喻句"},{"id":35689,"word":"笼山络野","pinyin":"lóng shān luò yě","abbr":"lsly","explanation":"指笼罩、围绕高山平原。","source":{"text":"罘网连紘，笼山络野。","book":"汉·班固《西都赋》"},"example":{"text":"邓宗龄有《太学石鼓歌》：……～布罘网，风毛雨血神飞扬。","book":"明·蒋一葵《长安客话·石鼓》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":35690,"word":"笼禽槛兽","pinyin":"lóng qín jiàn shòu","abbr":"lqks","explanation":"关闭在笼中之鸟兽。喻指不自由之身。","source":{"text":"既出郭，其心欣欣然，若笼禽槛兽之得逸，莫我如也。","book":"唐·李复言《续玄怪录·薛伟》"},"similar":["笼鸟槛猿"],"usage":"作宾语、定语；指没有自由的人"},{"id":35691,"word":"笼络人心","pinyin":"lǒng luò rén xīn","abbr":"llrx","explanation":"笼络：笼和络原是羁绊牲口的工具，引伸为用手段拉拢。耍弄手段，拉拢别人。","source":{"text":"自蔡京得政，士大夫无不受其笼络，超然远迹不为所污者如安国者实鲜。","book":"《宋史·胡安国传》"},"example":{"text":"因为当时那元主，要～，访求宋朝遗逸，中外鞑官和一班反颜事敌的宋朝旧臣，都交章保荐谢枋得。","book":"清·吴趼人《痛史》第二十回"},"similar":["收买人心"],"opposite":["众叛亲离"],"usage":"作谓语、宾语；指收买人心"},{"id":35692,"word":"笼而统之","pinyin":"lóng ér tǒng zhī","abbr":"letz","explanation":"混合不分。","source":{"text":"……事实是我们不能完全照办。理由很多，其中最有力的一项是，以普通话为标准，我们已经没有入声。笼而统之说，字字照《诗韵》发音，不只不可能，而且太麻烦。","book":"张中行《诗词读写丛话·关键字》"}},{"id":35693,"word":"笼街喝道","pinyin":"lóng jiē hè dào","abbr":"ljhd","explanation":"喝道：古时官员出行差役叫行人让道。表示仪仗的威风。","source":{"text":"臣闻元和长庆中，中丞行李不过半坊，今乃远至两坊，谓之笼街喝道。","book":"《旧唐书·温造传》"},"usage":"作宾语、定语；用于官员出行"},{"id":35694,"word":"笼鸟槛猿","pinyin":"lóng niǎo jiàn yuán","abbr":"lnjy","explanation":"笼中鸟槛中猿。比喻受拘禁没有自由的人。","source":{"text":"笼鸟槛猿俱未死，人间相见是何年！","book":"唐·白居易《山中与元九书因题书后》诗"},"similar":["笼中之鸟"],"usage":"作宾语、定语；指没有自由的人"},{"id":35695,"word":"笼鸟池鱼","pinyin":"lóng niǎo shi yú","abbr":"lncy","explanation":"关在笼里的鸟，养在池中的鱼。比喻受困失去自由的人。","source":{"text":"譬犹池鱼笼鸟，有江湖山薮之思。","book":"晋·潘岳《秋兴赋》"},"example":{"text":"譬笼鸟与池鱼，本山川而有思。","book":"南朝·梁·裴子野《游华林园赋》"}},{"id":35696,"word":"等价交换","pinyin":"děng jià jiāo huàn","abbr":"djjh","explanation":"相同的价值进行平等交易。","source":{"text":"我们在贸易上实行等价交换，但是有时还要有意识地准备赔钱。","book":"邓小平《关于西南少数民族问题》"},"similar":["公平交易"],"usage":"作谓语、宾语；用于商业等"},{"id":35697,"word":"等价连城","pinyin":"děng jià lián chéng","abbr":"djlc","explanation":"同样价值连城。比喻同样贵重。","source":{"text":"晋棘、荆和，等价连城，骅骝、騄骊，俱致千里。","book":"《梁书·儒林传·范缜》"},"example":{"text":"这件宝物真是～。"},"similar":["价值连城"],"opposite":["不值一钱"],"usage":"作谓语、定语；比喻同样贵重"},{"id":35698,"word":"等因奉此","pinyin":"děng yīn fèng cǐ","abbr":"dyfc","explanation":"等因：旧公文用以结束表示理由说明原因的上文；奉此：用以引起重心所在的下文。比喻例行公事，官样文章。","source":{"text":"否则岂不仍是‘等因奉此’的一纸公文在老爷们的桌上转来转去？","book":"邹韬奋《抗战以来·对保障人民权利的再呼吁》"},"example":{"text":"我们对于上级的文件绝不能～一番就完事大吉。"},"similar":["官样文章","例行公事"],"opposite":["照章办事"],"usage":"作谓语、定语；用于旧时公文"},{"id":35699,"word":"等夷之志","pinyin":"děng yì zhī zhì","abbr":"dyzz","explanation":"等夷：匹敌。指臣下僭越朝廷之心。即夺权篡位之野心。","source":{"text":"及文后崩殂，诸子冲幼，群公怀等夷之志，天下有去就之心，卒能变魏为周，捍危获者，护之力也。","book":"《北史·周宗室传论》"}},{"id":35700,"word":"等礼相亢","pinyin":"děng lǐ xiāng kàng","abbr":"dlxk","explanation":"犹言分庭抗礼。以平等之礼相待。","source":{"text":"今王将东面，目指气使以求臣，则厮役之材至矣；南面听朝，不失揖让之礼以求臣，则人臣之材至矣；西面等礼相亢，下之以色，不乘势以求臣，则朋友之材至矣。","book":"汉·刘向《说苑·君道》"},"similar":["分庭抗礼"],"usage":"作谓语、宾语；用于双方"},{"id":35701,"word":"等米下锅","pinyin":"děng mǐ xià guō","abbr":"dmxg","explanation":"等着米来下锅烧饭。比喻生活困难，缺少钱用。","source":{"text":"我在这衙门内已经三代了，外头也有些体面，家里还过得，就规规矩矩伺候本官升了还能够，不象那些等米下锅的。","book":"清·曹雪芹《红楼梦》第九十九回"},"example":{"text":"岂但不肯多出钱，照时值估价，还要少几两，分明知道我～，要杀我的巧。","book":"清·吴敬梓《儒林外史》第十六回"},"similar":["寅吃卯粮"],"opposite":["腰缠万贯"],"usage":"作谓语、定语；形容境况很窘迫"},{"id":35702,"word":"等而上之","pinyin":"děng ér shàng zhī","abbr":"desz","explanation":"按某一等级，由此再往上。","source":{"text":"古者五家置比长，等而上之，为闾，为旅，为党，皆置官焉。","book":"宋·朱燮《絜斋集·高鞅论》"},"example":{"text":"～，则孔子之温良恭俭，言不过物。","book":"清·方苞《书杨维斗先生传后》"},"similar":["锦上添花"],"opposite":["等而下之"],"usage":"作谓语、定语；指向上"},{"id":35703,"word":"等而下之","pinyin":"děng ér xià zhī","abbr":"dexz","explanation":"由这一等逐级往下。指跟某一事物比较起来更差。","source":{"text":"乡之贫者，或不及于此，则以此法等而下之。","book":"宋·楼钥《攻愧集》"},"example":{"text":"他这种做法，比起纪昀，就更～了。","book":"孙犁《秀露集·关于纪昀的通信》"},"similar":["每况愈下","相形见绌"],"opposite":["锦上添花","更上一层楼"],"usage":"作谓语；指更差"},{"id":35704,"word":"等身著作","pinyin":"děng shēn zhù zuò","abbr":"dszz","explanation":"著作叠起来与身高相等。形容著述非常丰富。","source":{"text":"黄中幼聪悟，方五岁，玭每旦令正立，展书卷比之，谓之等身书，课其诵读。","book":"《宋史·贾黄中传》"},"example":{"text":"～推君健，旷世才名愧我虚。","book":"柳亚子《呈符老宇澄》"},"similar":["著作等身"],"usage":"作谓语、定语；指作品多"},{"id":35705,"word":"等量齐观","pinyin":"děng liàng qí guān","abbr":"dlqg","explanation":"等：同等；量：衡量，估量；齐：一齐，同样。指对有差别的事物同等看待。","source":{"text":"托雨露而成润，意境可以稍变，然而乌可等量齐观也。","book":"清·况周颐《惠风词话》"},"example":{"text":"后来列国纷纷称王，国王更不算回事，他们至多能和宋、鲁等小国君主～罢了。","book":"朱自清《经典常谈·战国策八》"},"similar":["一视同仁","相提并论","混为一谈"],"opposite":["大相径庭","迥然不同","厚此薄彼"],"usage":"作谓语；用于否定句"},{"id":35706,"word":"等闲之人","pinyin":"děng xián zhī rén","abbr":"dxzr","explanation":"等闲：寻常，一般。指普通人。","source":{"text":"魏有邓艾，足智多谋，非等闲之辈。","book":"明·罗贯中《三国演义》第一百一十五回"},"example":{"text":"女人听了，重新把闯王浑身上下打量一眼，看相貌不是～。","book":"姚雪垠《李自成》第一卷第二十四章"},"similar":["等闲之辈"],"usage":"作宾语；多用于否定句"},{"id":35707,"word":"等闲之辈","pinyin":"děng xián zhī bèi","abbr":"dxzb","explanation":"等闲：寻常，一般。无足轻重的寻常人。","source":{"text":"魏有邓艾，足智多谋，非等闲之辈。","book":"明·罗贯中《三国演义》"},"example":{"text":"一看他就知他非～。"},"similar":["凡夫俗子","芸芸众生","等闲之人"],"opposite":["巾帼英雄","英雄好汉","风云人物"],"usage":"作宾语；用于否定句"},{"id":35708,"word":"等闲人家","pinyin":"děng xián rén jiā","abbr":"dxrj","explanation":"等闲：寻常，一般。指普通寻常的家庭。","source":{"text":"沈将仕看时，虽不怎的大摆设，却多精美雅洁，色色在行，不是等闲人家办得出的。","book":"明·凌濛初《二刻拍案惊奇》卷八"}},{"id":35709,"word":"等闲人物","pinyin":"děng xián rén wù","abbr":"dxrw","explanation":"等闲：寻常，平常。指普通人。","source":{"text":"操还营自思：‘孙权非等闲人物……’于是有退兵之意。","book":"明·罗贯中《三国演义》第61回"},"example":{"text":"他不是～。"},"similar":["等闲之辈"],"usage":"作宾语；指一般人"},{"id":35710,"word":"等闲视之","pinyin":"děng xián shì zhī","abbr":"dxsz","explanation":"等闲：寻常，一般。把它看成平常的事，不预重视。","source":{"text":"汝勿以等闲视之，失吾大事。","book":"明·罗贯中《三国演义》第九十五回"},"example":{"text":"秦牧《跋》：“为了更进一步提高无产阶级文艺的思想、艺术感染力，技巧问题是决不能～的。”"},"similar":["满不在乎","淡然置之"],"opposite":["非同小可","刮目相看","小题大作"],"usage":"作谓语、宾语；多用于否定句，反问句"},{"id":35711,"word":"筋信骨强","pinyin":"jīn shēn gǔ qiáng","abbr":"jxgq","explanation":"信：同“伸”，伸展。筋能伸展，骨骼强健。形容身体强壮。","source":{"text":"人能正静，皮肤裕宽，耳目聪明，筋信而骨强，乃能戴大圆而履大方。","book":"《管子·内业》"}},{"id":35712,"word":"筋疲力倦","pinyin":"jīn pí lì juàn","abbr":"jplj","explanation":"犹言筋疲力尽。","source":{"text":"就是上海工厂里做工至少每天十点的工人，到晚快边就一定筋疲力倦，受伤的事情是大抵出在那时候的","book":"鲁迅《花边文学·安贫乐道法》"},"similar":["筋疲力尽","筋疲力竭","筋疲力敝"],"usage":"作谓语、定语、状语、补语；指非常辛苦"},{"id":35713,"word":"筋疲力尽","pinyin":"jīng pí lì jìn","abbr":"jplj","explanation":"精神疲乏，气力用尽。形容精神和身体极度疲劳。","source":{"text":"虽时侵掠，小有所得，力尽筋疲，不偿其费。","book":"汉·焦延寿《焦氏易林·巽》：“蹇驴不材，骏骥失时，筋劳力尽，罢于沙丘。”唐·韩愈《论淮西事宜状》"},"example":{"text":"我才逃到这里来，已经～了，还有什么办法呢？","book":"巴金《寒夜》"},"similar":["身心交瘁","心力交瘁","精疲力竭"],"opposite":["精神焕发","精神抖擞"],"usage":"作谓语、定语、状语、补语；指非常辛苦"},{"id":35714,"word":"筋疲力敝","pinyin":"jīn pí lì bì","abbr":"jplb","explanation":"筋：筋骨；疲：疲劳。形容非常劳累。","source":{"text":"筋疲力敝不入腹，未议县官租税促。","book":"宋·司马光《道傍田家》诗"},"similar":["筋疲力尽","筋疲力竭","筋疲力倦"],"usage":"作谓语、定语、状语、补语；指非常辛苦"},{"id":35715,"word":"筋疲力竭","pinyin":"jīn pí lì jié","abbr":"jplj","explanation":"筋：筋骨；疲：疲劳。形容非常疲乏","source":{"text":"精卫衔芦塞海溢，枯鱼喷沫救池燔。筋疲力竭波更大，鳍焦甲裂身已干。","book":"唐·元稹《有酒》诗"},"example":{"text":"鲁迅《故事新编·奔月》：“马只能认着白色的田塍走，而且早已～，自然走得更慢了。”"},"similar":["筋疲力尽","精疲力竭"],"opposite":["精神抖擞","精力充沛"],"usage":"作谓语、定语；形容非常疲乏"},{"id":35716,"word":"筐箧中物","pinyin":"kuāng qiè zhōng wù","abbr":"kqzw","explanation":"比喻平常的事情。","source":{"text":"此人家筐箧中物耳。","book":"《三国志·吴书·韦曜传》"},"example":{"text":"袁生所谓家人筐箧中物，不可扬于王庭。","book":"《北史·崔浩传》"},"opposite":["奇珍异宝"],"usage":"作主语、宾语；比喻平常的事物"},{"id":35717,"word":"筑台募士","pinyin":"zhù tái mù shì","abbr":"ztms","explanation":"募：招寡。比喻广泛招纳贤士","source":{"text":"汤五聘伊尹，文王躬迎吕望，周公握发吐哺以待白屋之士，郑武公好贤而诗雅歌之，燕昭王筑台募士而智者归之。","book":"宋·范仲淹《帝王好尚论》"},"usage":"作宾语、定语；用于书面语","story":["燕昭王即位后，为报齐国侵犯燕国之仇，“卑身厚币，以招贤者”。他专程向贤者郭隗请教，郭隗给他讲千金市马的故事后说：“今王诚欲致仕，先从隗始。”于是昭王为隗筑宫而拜师。后来乐毅、邹衍、剧辛等名士纷纷来投奔"]},{"id":35718,"word":"筑坛拜将","pinyin":"zhù tán bài jiàng","abbr":"ztbj","explanation":"指仰仗贤能。","source":{"text":"计将安在？小生当筑坛拜将。","book":"《汉书·高帝纪上》：“汉王齐戒设坛场，拜信（韩信）为大将军，问以计策。”元·王实甫《西厢记·第三本》第一折"},"example":{"text":"一遇汉祖，～，捧毂推轮，后封王爵以酬其功。","book":"明·冯梦龙《喻世明言·闹阴司司马貌断狱》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":35719,"word":"筑室反耕","pinyin":"zhù shì fǎn gēng","abbr":"zsfg","explanation":"筑：建造；反：通“返”，归返。指部队做长久驻扎的打算。","source":{"text":"筑室反耕者，宋必听命。","book":"春秋·鲁·左丘明《左传·宣公十五年》"},"example":{"text":"匡困补乏，以悦天下，何图～哉！","book":"晋·陈寿《三国志·魏志·臧洪传》"},"similar":["安营扎寨"],"usage":"作谓语、定语；指长期驻扎"},{"id":35720,"word":"筑室谋道","pinyin":"zhù shì móu dào","abbr":"zsmd","explanation":"筑：建造；室：房屋；谋道：与过路的人商量。比喻做事自己没有主见，缺乏计划，一会儿听这个，一会儿听那个，终于一事无成。","source":{"text":"如彼筑室于道谋，是用不渍于成。","book":"《诗经·小雅·小旻》"},"example":{"text":"应知政事先军旅，岂有～旁？","book":"陈毅《秋过濮阳，月下与人谈毛主席飞渝事》"}},{"id":35721,"word":"筑室道谋","pinyin":"zhù shì dào móu","abbr":"zsdm","explanation":"筑：建造；室：房屋；道谋：与过路的人商量。比喻做事自己没有主见，缺乏计划，一会儿听这个，一会儿听那个，终于一事无成。","source":{"text":"如彼筑室于道谋，是用不渍于成。","book":"《诗经·小雅·小旻》"},"example":{"text":"这宗事，若教门生们议将来，只成～，不如老师断以己见。","book":"清·李绿园《歧路灯》第五回"},"similar":["三心二意","见异思迁","优柔寡断"],"opposite":["当机立断","一心一意"],"usage":"作谓语、定语、宾语；指没有主见","story":["东汉时期，汉章帝想命令博士曹褒负责修订礼乐工作，班固则主张召集京城所有的儒生共同研究制定礼乐。汉章帝认为让儒生来做就等于“作舍道傍，三年不成。”，就坚持让曹褒完成，经审阅，共采纳150篇"]},{"id":35722,"word":"筑岩钓渭","pinyin":"zhù yán diào wèi","abbr":"zydw","explanation":"筑岩：商朝大臣傅说在傅岩从事版筑；钓渭：吕尚在渭水边垂钓。指贤士隐居待时","source":{"text":"史臣至比之为筑岩钓渭，亦过矣哉！","book":"宋·葛立方《韵语阳秋》第18卷"},"usage":"作宾语、定语；用于书面语"},{"id":35723,"word":"筑巢引凤","pinyin":"zhù cháo yǐn fèng","abbr":"zcyf","explanation":"修好巢穴，引来凤凰。比喻国家或地方政府等完善投资环境，以招商引资、吸引人才。"},{"id":35724,"word":"筑舍道傍","pinyin":"zhù shè dào bàng","abbr":"zsdb","explanation":"傍：通“旁”。在路旁盖房子，同路人讨论事情。比喻人多口杂，办不成事。","source":{"text":"此所谓筑舍道傍，无时可成。","book":"宋·司马光《资治通鉴·晋孝武帝太元七年》"},"similar":["筑室道谋"],"usage":"作宾语、定语；指没有主见","story":["东汉时期，汉章帝想命令博士曹褒负责修订礼乐工作，班固则主张召集京城所有的儒生共同研究制定礼乐。汉章帝认为让儒生来做就等于“作舍道傍，三年不成。”，就坚持让曹褒完成，经审阅，共采纳150篇"]},{"id":35725,"word":"答问如流","pinyin":"dá wèn rú liú","abbr":"dwrl","explanation":"答：回答。形容答对流畅。","source":{"text":"此时秦宓语言清朗，答问如流，满座皆惊。","book":"明·罗贯中《三国演义》第86回"},"similar":["对答如流"],"opposite":["结结巴巴"],"usage":"作谓语；指人机灵"},{"id":35726,"word":"答非所问","pinyin":"dá fēi suǒ wèn","abbr":"dfsw","explanation":"回答的不是所问的内容。","source":{"text":"老爷正觉得他答非所问，程相公那里就打听说：‘什么叫做希希罕儿？’","book":"清·文康《儿女英雄传》第三十八回"},"example":{"text":"按照着次序一问一答，没有～的弊病，就算情意格外浓厚。","book":"叶圣陶《隔膜》"},"similar":["文不对题"],"opposite":["对答如流"],"usage":"作谓语、状语；指回答的不是所问的内容"},{"id":35727,"word":"策勋饮至","pinyin":"cè xūn yǐn zhì","abbr":"cxyz","explanation":"策勋：把功勋记载在简策上；饮至：指诸侯朝、会、盟、伐后回宗庙饮酒庆功。庆功祝捷。","source":{"text":"凡公行告于宗庙，反行饮至，舍爵策勋焉。","book":"春秋·鲁·左丘明《左传·桓公二年》"},"example":{"text":"～，方同廊庙之幻；偃武橐弓，借尔文儒之首。","book":"唐·陈子昂《登蓟城西北楼送崔著作入都序》"},"usage":"作宾语、定语；用于庆功"},{"id":35728,"word":"策名委质","pinyin":"cè míng wěi zhì","abbr":"cmwz","explanation":"用以指因仕宦而献身于朝廷之事。","source":{"text":"古之仕者于所臣之人书己名于策，以明系属之也。","book":"《左传·僖公二十三年》：“策名委质，贰乃辟也。”杜预注：“名书于所臣之策。”孔颖达疏"},"example":{"text":"遂乃弹冠筮仕，～。","book":"唐·杨炯《薛振行状》"},"similar":["策名就列"],"opposite":["挂冠而去"],"usage":"作宾语、定语；用于做官"},{"id":35729,"word":"策名就列","pinyin":"cè míng jiù liè","abbr":"cmjl","explanation":"书名于策，就位朝班。意指做官。","source":{"text":"然情存今古，世踵浇季，而策名就列，或乖大礼。","book":"《旧唐书·太宗纪上》"},"similar":["策名委质"],"opposite":["告老还乡"],"usage":"作宾语、定语；用于做官"},{"id":35730,"word":"策无遗算","pinyin":"cè wú yí suàn","abbr":"cwys","explanation":"所出的谋略周密准确，没有遗漏失算之处。","source":{"text":"以策无遗算，乃益骄纵。","book":"《北齐书·幼主纪》"},"example":{"text":"他的计划顺利实现真是～。"},"similar":["百发百中","算无遗策"],"usage":"作宾语；指十分准确"},{"id":35731,"word":"策顽磨钝","pinyin":"cè wán mó dùn","abbr":"cwmd","explanation":"鞭策愚顽，磨砺迟钝。极言勉力奋进。","source":{"text":"我可也为甚的甘受贫，不厌勤，抵多少策顽磨钝，也只为不如人，学做儒人。","book":"元·无名氏《合同文字》第二折"},"similar":["策驽砺钝"],"usage":"作谓语、定语；用于书面语"},{"id":35732,"word":"策马飞舆","pinyin":"cè mǎ fēi yú","abbr":"cmfy","explanation":"指驾马车疾行。","source":{"text":"车驰人走，越王策马飞舆，遂复宫阙。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"usage":"作谓语；指赶车飞奔"},{"id":35733,"word":"策驽砺钝","pinyin":"cè nú lì dùn","abbr":"cnld","explanation":"驱策劣马，磨砺钝刀。指勉为其难，努力从事。驽，低能的马；钝，不锋利的刀。","source":{"text":"伏蒙陛下亲洒宸翰，铺述三子屯田足食之事，俯以赐臣，臣敢不策驽砺钝，仰副圣意万一。","book":"宋·岳飞《御书屯田三事跋》"},"similar":["策顽磨钝"],"usage":"作谓语、定语；用于书面语"},{"id":35734,"word":"筚路蓝缕","pinyin":"bì lù lán lǚ","abbr":"blll","explanation":"筚路：柴车；蓝缕：破衣服。驾着简陋的车，穿着破烂的衣服去开辟山林。形容创业的艰苦。","source":{"text":"筚路蓝缕，以启山林。","book":"《左传·宣公十二年》"},"example":{"text":"～，孙公既开其先；发扬光大，我公宜善其后。","book":"蔡东藩、许廑父第九回《民国通俗演义》"},"similar":["荜路蓝缕","风餐露宿","寝苫枕块"],"opposite":["轻而易举","养尊处优","坐享其成"],"usage":"作谓语、定语、状语；用于书面语","story":["春秋时期，楚庄王率军攻打郑国，郑国派大夫皇戍到晋国求援，并称楚人很骄傲，现在出兵可以大败楚军。下军副将栾书极力反对，说楚王灭庸以后经常教育百姓不要忘记楚国先君若敖开创基业时筚路蓝缕的生活。晋国出兵，结果被楚军打败"]},{"id":35735,"word":"筚路蓝褛","pinyin":"bì lù lán lǚ","abbr":"blll","explanation":"筚路：柴车；蓝褛：破衣服。坐着柴车，穿着破衣服，去开辟山林。形容创业的艰苦。","source":{"text":"虽未必有精湛不磨的成功，然而他的筚路蓝褛，以开荒荆的功绩，则已不小了。","book":"郑振铎《梁任公先生传》"},"similar":["筚路蓝缕"],"opposite":["养尊处优"],"usage":"作谓语、定语、状语；用于书面语"},{"id":35736,"word":"筚路褴褛","pinyin":"bì lù lán lǚ","abbr":"blll","explanation":"形容开创新事业的艰难。同“筚路蓝缕”。","source":{"text":"我们筚路褴褛，孤军苦战，非为金钱，非为名誉，不厌不倦，但求心之所安。","book":"应修人《上海通信图书馆与读书自由》"},"example":{"text":"开创任何事业，总是要经过～，艰苦奋斗的过。"},"similar":["筚路蓝缕"],"usage":"作谓语、定语、状语；用于书面语"},{"id":35737,"word":"筚门圭窦","pinyin":"bì mén guī dòu","abbr":"bmgd","explanation":"筚门：柴门（用竹条或树枝编成的门）。圭窦：上尖下方的圭形的门洞。形容住室极其简陋。旧指穷人住处。","source":{"text":"筚门圭窦之人，而皆陵其上，其难为上矣。","book":"《左传·襄公十年》"},"example":{"text":"吾倚吾～而以为安也。","book":"宋·邓牧《伯牙琴·见尧赋》"},"similar":["筚门闺窦"],"usage":"作宾语、定语；形容穷人的住宿"},{"id":35738,"word":"筚门圭窬","pinyin":"bì mén guī yú","abbr":"bmgy","explanation":"同“筚门闺窦”。柴门小户。喻指穷人的住处。","source":{"text":"儒有一亩之宫，环堵之室，筚门圭窬，蓬户瓮牖。","book":"《礼记·儒行》"},"similar":["筚门圭窦"],"usage":"作宾语、定语；形容穷人的住宿"},{"id":35739,"word":"筚门闺窦","pinyin":"bì mén guī dòu","abbr":"bmgd","explanation":"筚门：柴门；圭窦：上尖下方的圭形门洞。形容穷苦人家的住处。","source":{"text":"筚门闺窦之人而皆陵其上，其难为上矣。","book":"《左传·襄公十年》"},"example":{"text":"我不禁暗暗称奇，不料这～中，竟有这等明理女子。","book":"清·吴趼人《二十年目睹之怪现状》第三十四回"},"similar":["筚门圭窦"],"usage":"作宾语、定语；形容穷人的住宿"},{"id":35740,"word":"筚门闺窬","pinyin":"bì mén guī yú","abbr":"bmgy","explanation":"筚门：用荆条或竹子编成篱笆作门；窬：通“窦”，门旁小户。柴门小户，比喻穷人的简陋住处。","source":{"text":"筚门闺窬之人，敢唏天望之冀。","book":"晋·陆云《与陆典书书》"},"similar":["筚门圭窬"],"usage":"作宾语、定语；形容穷人的住宿"},{"id":35741,"word":"筛锣擂鼓","pinyin":"shāi luó léi gǔ","abbr":"sllg","explanation":"敲锣打鼓。形容大声吵闹。也比喻竭力把事情夸大。","source":{"text":"或有那遭网的，遇扣的，夹活儿拿去了，教他跳圈做戏，翻筋斗，竖蜻蜓，当街上筛锣擂鼓，无所不为的顽耍。","book":"明·吴承恩《西游记》第二十八回"},"similar":["敲锣打鼓"],"usage":"作谓语；指虚张声势"},{"id":35742,"word":"简丝数米","pinyin":"jiǎn sī shǔ mǐ","abbr":"jssm","explanation":"简择丝缕，查点米粒。比喻工作琐细。","source":{"text":"凡所考论，虽复简丝数米，或涉琐眉，于作述闳旨未窥百一。","book":"孙诒让《〈札迻〉自叙》"},"usage":"作宾语、定语；用于比喻句"},{"id":35743,"word":"简傲绝俗","pinyin":"jiǎn ào jué sú","abbr":"jajs","explanation":"指高傲而超越世俗。","source":{"text":"亡友文小勇有句云：‘人谁从问字，风不可开门。’于江西宗派体中自居胜地，而其荒凉寒苦之状，简傲绝俗之致，亦概可见矣。","book":"清·王夫之《姜斋诗话》卷三"},"usage":"作谓语、定语；用于人"},{"id":35744,"word":"简切了当","pinyin":"jiǎn qiè liǎo dàng","abbr":"jqld","explanation":"指简单明白。","source":{"text":"无忌，我简切了当的告诉你吧。你是爱如姬的，是不是？","book":"郭沫若《虎符》第三幕"},"similar":["简截了当","直截了当"],"opposite":["转弯抹角"],"usage":"作谓语、定语、状语；指说话直截了当"},{"id":35745,"word":"简单明了","pinyin":"jiǎn dān míng liǎo","abbr":"jdml","explanation":"简明扼要，一看就明白。"},{"id":35746,"word":"简在帝心","pinyin":"jiǎn zài dì xīn","abbr":"jzdx","explanation":"指能被皇帝所知者。","source":{"text":"帝臣不蔽，简在帝心。","book":"《论语·尧曰》"},"example":{"text":"他老人家官声甚好，早已～，将来润翁引见之后，指日就要放缺的。","book":"《官场现形记》第二四回"},"usage":"作谓语；用于书面语"},{"id":35747,"word":"简忽所见","pinyin":"jiǎn hū suǒ jiàn","abbr":"jhsj","explanation":"简忽：怠慢疏忽；见：见解。指肤浅的见解。","source":{"text":"俗人拘文牵古，不达权制，奇伟所闻，简忽所见，乌可与论国家之大事哉。","book":"《后汉书·崔寔传》"}},{"id":35748,"word":"简截了当","pinyin":"jiǎn jié liǎo dàng","abbr":"jjld","explanation":"指语言、文字简明，清楚，直截了当。","source":{"text":"描写差不多没有，偶然有，也只就那农村生活里取喻，简截了当。","book":"朱自清《论通俗化》"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“‘不是！’陈世龙～地答说。”"},"similar":["简捷了当"],"opposite":["转弯抹角"],"usage":"作谓语、定语、状语；指说话直截了当"},{"id":35749,"word":"简捷了当","pinyin":"jiǎn jié liǎo dàng","abbr":"jjld","explanation":"直截了当。","source":{"text":"然而将麻雀牌送给世界，且以此自豪的人民，对于这样简捷了当，没有意外之利的办法，是终于耐不下去的。","book":"鲁迅《三闲集·书籍和财色》"},"example":{"text":"就不必请求什么别的，～要表兄带自己和妻到外边去就行了。","book":"吴组缃《山洪》"},"similar":["简截了当","直截了当"],"opposite":["转弯抹角"],"usage":"作谓语、定语；指直截了当"},{"id":35750,"word":"简断编残","pinyin":"jiǎn duàn biān cán","abbr":"jdbc","explanation":"简：竹简；编：穿竹简的皮条或绳子。指残缺不全的书籍或形容书籍磨损残破。","source":{"text":"简断编残字欲无，吾儿不负乃翁书。","book":"宋·陆游《冬夜读书示子聿》"},"similar":["残篇断简"],"usage":"作宾语、定语；用于书面语"},{"id":35751,"word":"简明扼要","pinyin":"jiǎn míng é yào","abbr":"jmey","explanation":"指说话、写文章简单明了，能抓住要点。","source":{"text":"讲话、演说、写文章和写决议案，都应当简明扼要。","book":"毛泽东《党委会的工作方法》"},"example":{"text":"他把此事～作了汇报。"},"similar":["短小精悍"],"opposite":["长篇累牍","长篇大论"],"usage":"作谓语、定语、状语；指简单明了"},{"id":35752,"word":"简约详核","pinyin":"jiǎn yuē xiáng hé","abbr":"jyxh","explanation":"指简要翔实。","source":{"text":"言舆地形质之学，则有慕维廉之《地理全志》上下编，上编纪实载时事，析论情势，尤简约详核称焉。","book":"清·王韬《瓮牗馀谈·西儒实学》"},"usage":"作谓语、定语；用于说话或文章等"},{"id":35753,"word":"简纲捷端","pinyin":"jiǎn gāng jié duān","abbr":"jgjd","explanation":"纲：纲要；端：头绪。简化提纲，减少头绪。即省略。"},{"id":35754,"word":"简练揣摩","pinyin":"jiǎn liàn chuǎi mó","abbr":"jlcm","explanation":"简：简选，选择；练：练习；揣：忖度；摩：琢磨。指在学术或技艺上苦练、琢磨。","source":{"text":"得太公《阴符》之谋，伏而诵之，简练以为揣摩。","book":"《战国策·秦策一》"},"example":{"text":"敬亭退而凝神定气，～。","book":"清·黄宗羲《柳敬亭传》"},"usage":"作谓语、定语；用于书面语"},{"id":35755,"word":"简而言之","pinyin":"jiǎn ér yán zhī","abbr":"jeyz","explanation":"简括地说，长话短说。","example":{"text":"～，我们得尽快办好。"},"similar":["长话短说"],"usage":"作分句、宾语；用于说话或文章"},{"id":35756,"word":"简能而任","pinyin":"jiǎn néng ér rèn","abbr":"jner","explanation":"简：选择；任：作用。选择有才能的人委以重任。","source":{"text":"简能而任之，择善而从之。","book":"《旧唐书·魏征传》"},"usage":"作谓语、宾语；用于选拔人才"},{"id":35757,"word":"简落狐狸","pinyin":"jiǎn luò hú lí","abbr":"jlhl","explanation":"抓住狐狸。落，通“络”。比喻制裁奸邪小丑。","source":{"text":"前虽纠诛王甫、段熲，盖简落狐狸，未足宣示天下。愿假臣一月，必令豺狼鸱枭各服其辜。","book":"《后汉书·酷吏传·阳球》"},"example":{"text":"公以国家之败由官邪也，方欲条品人物，～，易危亡之辙。","book":"清·黄宗羲《徐公神碑铭》"},"usage":"作谓语、宾语；用于比喻句"},{"id":35758,"word":"简要不烦","pinyin":"jiǎn yào bù fán","abbr":"jybf","explanation":"简明扼要，不烦琐累赘。","example":{"text":"他～地作了汇报。"},"similar":["简明扼要"],"usage":"作谓语、定语、状语；用于说话或文章等"},{"id":35759,"word":"简要清通","pinyin":"jiǎn yào qīng tōng","abbr":"jyqt","explanation":"指处事简练扼要，明白通达。","source":{"text":"吏部郎阙，文帝问其人于锺会，会曰：‘裴楷清通，王戎简要，皆其选也。’","book":"语出南朝·宋·刘义庆《世说新语·赏誉》"},"example":{"text":"许身何必定夔皋，～已足豪。","book":"清·龚自珍《己亥杂诗》之十五"},"usage":"作谓语、定语；指人的处事"},{"id":35760,"word":"简贤任能","pinyin":"jiǎn xián rèn néng","abbr":"jxrn","explanation":"指选用贤能。","source":{"text":"委诸相以简贤任能，付老臣以练兵御侮，则黎元自理，寇盗自平，中兴之功，旬月可冀。","book":"《旧唐书·郭子仪传》"},"similar":["选贤任能"],"usage":"作谓语、宾语、定语；指爱惜人才"},{"id":35761,"word":"简贤附势","pinyin":"jiǎn xián fù shì","abbr":"jxfs","explanation":"轻视贤良，依附权势。","source":{"text":"简，略也。贤而无势则略之，不贤有势则附之。","book":"《书·仲虺之诰》：“简贤附势，实繁有徒。”孔传"},"example":{"text":"以移风易俗为虚语，以～为知几。","book":"宋·范仲淹《上执政书》"},"usage":"作谓语、定语、宾语；用于处世"},{"id":35762,"word":"箕山之志","pinyin":"jī shān zhī zhì","abbr":"jszz","explanation":"旧时用以称誉不愿在乱世做官的人。同“箕山之节”。","source":{"text":"伟长独怀文抱质，恬淡寡欲，有箕山之志，可谓彬彬君子者也。","book":"三国·魏·曹丕《与吴质书》"},"example":{"text":"文帝问曰：‘闻有～，何以在此？’秀曰：‘以为巢许狷介之士，未达尧心，岂足多慕。’帝甚悦。","book":"《晋书·向秀传》"},"similar":["箕山之节","箕山之操"],"usage":"作宾语；用于人的节操"},{"id":35763,"word":"箕山之操","pinyin":"jī shān zhī cāo","abbr":"jszc","explanation":"旧时用以称誉不愿在乱世做官的人。同“箕山之节”。","source":{"text":"大丈夫生世，遁无箕山之操，仕无伊吕之勋，天不我与，复何言哉！","book":"《后汉书·赵岐传》"},"similar":["箕山之节","箕山之志"],"usage":"作宾语；用于人的节操"},{"id":35764,"word":"箕山之节","pinyin":"jī shān zhī jié","abbr":"jszj","explanation":"箕山：古代传说唐尧时的隐士许由、巢父隐居的地方。节：名节，节操。指归隐以保全节操。旧时用以称誉不愿在乱世做官的人。亦作“箕山之志”、“箕山之操”。","source":{"text":"昔尧朝许由于沛泽之中，曰：‘……请属天下于夫子。’许由辞曰：‘为天下之不治与？而既已治矣。自为与？啁噍巢于林，不过一枝；偃鼠饮于河，不过满腹。归已君乎！恶用天下？’遂之箕山之下，颖水之阳，耕而食，终身无经天下之色。","book":"《吕氏春秋·求人》"},"example":{"text":"尧舜在上，下有巢由，今明主方隆唐虞之德，小臣欲守～也。","book":"《汉书·鲍宣传》"},"similar":["箕山之操","箕山之志"],"usage":"作宾语；用于人的节操","story":["西汉末年，小有才气的薛方一度担任郡椽祭酒，朝廷多次想起用他，他都不愿离开。后来，王莽用豪华大车高标准去迎接薛方。薛方客气地谢绝使者说：“尧舜在上，下有巢由，今明主方隆唐虞之德，小臣欲守箕山之节也。”"]},{"id":35765,"word":"箕山之风","pinyin":"jī shān zhī fēng","abbr":"jszf","explanation":"指隐士的风范。","source":{"text":"[丁药园]谪居五载，略无迁谪状，躬耕自乐，洒然有箕山之风。","book":"清·王晫《今世说·雅量》"},"usage":"作宾语；指隐士的风范"},{"id":35766,"word":"箕山挂瓢","pinyin":"jī shān guà piáo","abbr":"jsgp","explanation":"用为隐居不仕之典。","source":{"text":"明·敬虚子《小隐书·许由》载：相传许由隐居箕山之下，颖水之阳，躬耕自食，以手掬饮。人遗一瓢，挂于树，风吹历历作声，以为烦，弃之。"},"example":{"text":"湖海伴渔樵，任尘埃暗宝刀，枕流漱石吾堪老，因此上～，缑山弄箫，幽怀尽付闲花草。","book":"明·王錂《春芜记·访友》"},"usage":"作宾语、定语；用于比喻句","story":["相传唐尧时期，不愿当首领的许由隐居在箕山一带，他过着自食其力的简约生活。一次他在颍水边用手捧水喝时，有人送他一只水瓢，挂在树上，风吹得乒乓作响。许由心里很烦，把它丢到一边，头也不回就走了"]},{"id":35767,"word":"箕帚之使","pinyin":"jī zhǒu zhī shǐ","abbr":"jzzs","explanation":"持箕帚，以供扫除之役。借作己妻之谦称。","source":{"text":"楚庄王使使赍金百斤聘北郭先生，先生曰：‘臣有箕帚之使，愿入计之。’","book":"《韩诗外传》卷九"},"usage":"作宾语；指妻子","story":["春秋时期，楚庄王派使者带上黄金百斤去聘北郭先生，先生说要与他的箕帚之使（妻子）去商议，他进去对妻子说：“楚欲以我为相，今日相，即结驷列骑，食方丈于前，如何？”他的妻子表示尊重他自己的抉择"]},{"id":35768,"word":"箕引裘随","pinyin":"jī yǐn qiú suí","abbr":"jyqs","explanation":"比喻子弟能继承父兄之业。","source":{"text":"良治之子，必学为裘，良弓之子，必学为箕。","book":"语出《礼记·学记》"},"example":{"text":"升其堂，则箕引而裘随；周其庑，则壎唱而箎和；临其阶，则珠联而玉缀：提镇公之后嗣何多贤哉！","book":"明·宋濂《题张如心初修谱叙后》"},"similar":["箕裘相继","箕裘堂构"],"usage":"作谓语、定语；用于书面语"},{"id":35769,"word":"箕裘不坠","pinyin":"jī qiú bù zhuì","abbr":"jqbz","explanation":"比喻前辈的事业后继有人而不会中断。","source":{"text":"良冶之子，必学为裘；良弓之子，必学为箕。","book":"《礼记·学记》"},"example":{"text":"知足下留心正学，师门～，喜何如之。","book":"清·陆陇其《答柏乡魏荔彤》"}},{"id":35770,"word":"箕裘之业","pinyin":"jī qiú zhī yè","abbr":"jqzy","explanation":"箕：簸箕；裘：皮袍。指子承父业。","source":{"text":"良冶之子，必学为裘；良弓之子，必学为箕。","book":"《礼记·学记》"}},{"id":35771,"word":"箕裘堂构","pinyin":"jī qiú táng gòu","abbr":"jqtg","explanation":"指子孙继承先辈的事业。","source":{"text":"说父子相关切处，令人感注，似由阅历而得者，非泛作箕裘堂构语者所能梦见。","book":"清·李绿园《歧路灯》第五十六回"},"similar":["箕裘相继","箕引裘随","肯堂肯构"],"usage":"作谓语、定语；用于书面语"},{"id":35772,"word":"箕裘相继","pinyin":"jī qiú xiāng jì","abbr":"jqxj","explanation":"箕：簸箕。裘：皮袍。比喻子继父业。","source":{"text":"言善冶之家，其子弟见其父兄世业陶铸金铁，使之柔合，以补冶破器，皆令全好，故此子弟仍能学为袍裘补续兽皮，片片相合，以至完全也……","book":"语出《礼记·学记》：“良冶之子，必学为裘；良弓之子，必学为箕。”孔颖达疏"},"example":{"text":"愿百年奕叶传芳，好儿孙～。","book":"明·无名氏《精忠记·赏春》"},"similar":["箕裘相继","肯堂肯构","箕引裘随"],"usage":"作谓语、定语；用于书面语"},{"id":35773,"word":"箕裘颓堕","pinyin":"jī qiú tuí duò","abbr":"jqtd","explanation":"箕裘：比喻先辈的事业；颓堕：衰落，颓废。比喻先辈的事业没有人继承。","source":{"text":"迨兹陵谷变迁，箕裘废坠，寂寞阙以时之　，凄凉同乏祀之悲。","book":"唐·钱昱《忠懿王庙碑文》"},"example":{"text":"～皆从敬，家事消亡首罪宁，宿孽总因情！","book":"清·曹雪芹《红楼梦》第四回"}},{"id":35774,"word":"箕风毕雨","pinyin":"jī fēng bì yǔ","abbr":"jfby","explanation":"箕、毕：均为星名。古时认为月亮经过箕星时风多，经过毕星时雨多。原比喻人民的好恶不一样。后用于称赞为政体恤民情。","source":{"text":"庶民惟星，星有好风，星有好雨。","book":"《尚书·洪范》"},"example":{"text":"～，育岭生峨。","book":"南朝·梁·吴均《八公山赋》"},"similar":["毕雨箕风"],"usage":"作宾语；指官吏施政应顺应民情"},{"id":35775,"word":"算减一升","pinyin":"suàn jiǎn yī shēng","abbr":"sjys","explanation":"形容计算精妙准确。","source":{"text":"曹元理算东西米，东不差圭合；西差一升，因为里面藏有一只大鼠，其体积可容一升。","book":"晋·葛洪《西京杂记》卷四"}},{"id":35776,"word":"算尽锱铢","pinyin":"suàn jìn zī zhū","abbr":"sjzz","explanation":"极微小的数量也要算。指苛敛钱财。","source":{"text":"其父为西安驻防，家甚富，尝牟利于主算者，主算者算尽锱铢，其父犹以为未足。","book":"清·昭梿《啸亭续录·吴制府》"},"usage":"作谓语、定语；用于处事"},{"id":35777,"word":"算无遗策","pinyin":"suàn wú yí cè","abbr":"swyc","explanation":"算：计划；遗策：失算。形容策划精密准确，从来没有失算。","source":{"text":"自谓安若太山，算无遗策。","book":"三国·魏·曹植《王仲宣诔》：“算无遗策，画无失理。”《南史·梁简文帝纪论》"},"example":{"text":"孟德智有所穷，则荀彧、郭嘉、荀攸、高柔之徒左右之，以～。","book":"清·王夫之《读通鉴论·三国·十一》"},"similar":["策无遗算","谋无遗策"],"usage":"作谓语、定语；指非常准确"},{"id":35778,"word":"算沙抟空","pinyin":"suàn shā tuán kōng","abbr":"sstk","explanation":"指驾御繁难，能人之所不能。","source":{"text":"鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里。","book":"《太平御览》卷七四引《鲁连子》：“淄渑之沙，计儿不能数。”《庄子·逍遥游》"},"example":{"text":"故相宗性海，即彼教中之耑门者，尚且入而迷其向背。泽望乃能～，其精也，乃其所谓愤撼之甚者耶。","book":"清·黄宗羲《黄泽望圹志》"},"usage":"作谓语、宾语、定语；用于比喻句"},{"id":35779,"word":"算盘脑袋","pinyin":"suàn pán nǎo dài","abbr":"spnd","explanation":"比喻吝啬的人。有讥讽的含义。"},{"id":35780,"word":"箝口侧目","pinyin":"qián kǒu cè mù","abbr":"qkcm","explanation":"箝口：闭口不说话；侧目：怒目而视。闭嘴怒目而视。形容敢怒不敢言。","source":{"text":"上司荐之曰干员，同僚推之曰能吏，小民之受其鱼肉者，虽痛心疾首箝口侧目，而无奈何也。","book":"清·郑观应《盛世危言·吏治上》"},"similar":["敢怒不敢言"],"usage":"作谓语、定语；指敢怒不敢言"},{"id":35781,"word":"箝口结舌","pinyin":"qián kǒu jié shé","abbr":"qkjs","explanation":"结舌：舌头转不动。闭口不说话。形容不敢讲话。","source":{"text":"是诏书始于求谏，而终于拒谏也，臣恐天下之士益箝口结舌，非国家之福也。","book":"宋·司马光《乞改求谏诏书札子》"},"example":{"text":"国内颇纷纭多事，简直无从说起，生人～，尚虞祸及，读明末稗史，情形庶几近之。","book":"鲁迅《书信集·致李秉中》"},"similar":["钳口结舌"],"usage":"作谓语、宾语；指闭口不说"},{"id":35782,"word":"管中窥天","pinyin":"guǎn zhōng kuī tiān","abbr":"gzkt","explanation":"管：竹管；窥：从小孔或缝隙里看。通过竹管子的孔看天。比喻见闻狭隘或看事片面。","source":{"text":"是直用管窥天，用锥指地也，不亦小乎？","book":"《庄子·秋水》"},"example":{"text":"少见之人，如从～也。","book":"《史记·梁孝王世家》"},"similar":["坐井观天"],"usage":"作宾语、定语；用于人的见识等"},{"id":35783,"word":"管中窥豹","pinyin":"guǎn zhōng kuī bào","abbr":"gzkb","explanation":"从竹管的小孔里看豹，只看到豹身上的一块斑纹。比喻只看到事物的一部分，指所见不全面或略有所得。","source":{"text":"此郎亦管中窥豹，时见一斑。","book":"南朝·宋·刘义庆《世说新语·方正》"},"example":{"text":"向～寻知外，坐井观天又出来，运斧般门志何大，出削个好歹。","book":"元·周德清《一枝花·遗张伯元》"},"similar":["窥豹一斑","管窥所及","以管窥天"],"opposite":["洞若观火","一目了然"],"usage":"作谓语、定语、状语；指片面看问题","story":["晋朝书法家王羲之的儿子王献之从小开始学习写字、绘画，聪明过人，深得父亲的喜爱。一次父亲的朋友及门生在玩骰子时，王献之在旁观看，说了一句“南风不竞！”门生听了笑道：“小孩子是管中窥豹，只看到一个斑点。”"]},{"id":35784,"word":"管仲随马","pinyin":"guǎn zhòng suí mǎ","abbr":"gzsm","explanation":"管仲：春秋齐桓公的相国；随：跟从。管仲随着马走。比喻尊重前人的经验。","source":{"text":"管仲：春秋齐桓公的相国；随：跟从。管仲随着马走。比喻尊重前人的经验。"},"example":{"text":"战国·韩·韩非《韩非子·说林》：“管仲、隰朋从于桓公而伐孤竹，春往冬返，迷惑失道，管仲曰：‘老马之智可用也。’乃放老马而随之，遂得道。”"},"usage":"作宾语、定语；用于处事","story":["春秋时期，齐桓公率兵攻打山戎，山戎首领密庐投奔孤竹。孤竹国君答里呵听从宰相兀律的建议，杀掉密庐假降齐军，并把齐军引向旱海沙漠。齐军在沙漠迷路，齐桓公采纳管仲的建议，挑选几匹漠北的老马给齐军带路，走出沙漠，乘机攻占孤竹"]},{"id":35785,"word":"管城子","pinyin":"guǎn chéng zǐ","abbr":"gcz","explanation":"毛笔的别名。","source":{"text":"秦皇帝使恬赐之汤沐，而封诸管城，号曰‘管城子’。","book":"唐·韩愈《毛颖传》"},"example":{"text":"拔毫已付～，烂首曾封关内侯。","book":"宋·刘过《羊腰肾羹》"},"similar":["管城公","管城君"],"usage":"作主语、宾语、定语；指毛笔"},{"id":35786,"word":"管城毛颖","pinyin":"guǎn chéng máo yǐng","abbr":"gcmy","explanation":"管城、毛颖均为笔的代称。","source":{"text":"平居之时无所嗜好，独左右图书与管城毛颖相周旋。","book":"《宣和画谱·墨竹》"},"usage":"作宾语、定语；指毛笔"},{"id":35787,"word":"管宁割席","pinyin":"guǎn níng gē xí","abbr":"gngx","explanation":"管宁：人名；席：坐卧用的编织物。比喻朋友间的情谊一刀两断，中止交往。","source":{"text":"管宁、华歆尝同席读书，有乘轩冕过门者，宁读如故，歆废书出看。宁割席分座，曰：‘子非吾友也。’","book":"南朝·宋·刘义庆《世说新语·德行》"},"example":{"text":"像那种不仁不义的朋友，早该“～，一刀两断。”"},"similar":["割席分座"],"usage":"作宾语、定语；比喻朋友间的情谊一刀两断","story":["汉朝末年，读书人管宁与华歆从小在一起读书，是非常要好的朋友。但两人性格不一样，管宁读书刻苦，不贪慕富贵，华歆行事浮躁，羡慕荣华富贵，渐渐地管宁厌恶他，就把两人共坐的席子割成两半，分席而坐，从此两人断绝交情"]},{"id":35788,"word":"管弦繁奏","pinyin":"guǎn xián fán zòu","abbr":"gxfz","explanation":"许多的管乐、弦乐混合在一起演奏。形容声音繁杂。也比喻文章气势急促或情绪激烈高昂。","source":{"text":"管弦繁奏，夔先聆其音。","book":"《晋书·庾亮传》"},"example":{"text":"文章最要节奏，譬之～中，必有希声窈渺处。","book":"清·刘大櫆《论文偶记》"},"usage":"作宾语、定语；用于场面"},{"id":35789,"word":"管秃唇焦","pinyin":"guǎn tū chún jiāo","abbr":"gtcj","explanation":"管：笔管，指笔；焦：干燥。笔写秃，嘴唇说干。比喻办事交涉很费力。","source":{"text":"外部以咨商藩部为辞，藩部以官民不便为说，虽管秃唇焦，而终无如彼何。","book":"清·薛福成《通筹南洋各岛添设领事官保护华民疏》"},"usage":"作宾语、定语、状语；用于办事"},{"id":35790,"word":"管窥之见","pinyin":"guǎn kuī zhī jiàn","abbr":"gkzj","explanation":"管窥：从小孔、缝隙中看。多用作谦词，比喻所见往往不够高明。","source":{"text":"仰恃皇宿眷之隆，敢陈愚昧管窥之见。","book":"《魏书·魏收传》"},"example":{"text":"清·李汝珍《镜花缘》第52回：“据妹子细绎经旨，以～，择其要旨而论，其义似乎有三：第一，明分义；其次，正名实；第三：著几微。”"},"similar":["管见所及","管窥之说"],"usage":"作宾语；多为自谦之辞"},{"id":35791,"word":"管窥之说","pinyin":"guǎn kuī zhī shuō","abbr":"gkzs","explanation":"管窥：从管中看物。比喻见解局限、偏颇、肤浅。","source":{"text":"陀思妥夫斯基的人和他的作品，本是一时研究不尽的，统论全般，决非我的能力所及，所以这只好算作管窥之说。","book":"鲁迅《集外集·小引》"},"similar":["管窥之见"],"usage":"作宾语；多为自谦之辞"},{"id":35792,"word":"管窥筐举","pinyin":"guǎn kuī kuāng jǔ","abbr":"gkkj","explanation":"比喻学识浅陋，见闻不广。","source":{"text":"子虽光丽，既美且绝艳，管窥筐举，守厥所见。","book":"《三国志·蜀书·正传》"},"similar":["才疏学浅","孤陋寡闻"],"opposite":["见多识广"],"usage":"作谓语、补语、定语；指见闻不广"},{"id":35793,"word":"管窥蛙见","pinyin":"guǎn kuī wā jiàn","abbr":"gkwj","explanation":"管窥：从管中看物。比喻所见者小；蛙见：井蛙之见。比喻见识狭隘，看问题短视。","source":{"text":"只以管窥蛙见之识，谬语同心；虚表帜于词坛，以待将来作者。","book":"清·李渔《闲情偶寄·词曲·音律》"},"usage":"作宾语、定语；用于人的见识等"},{"id":35794,"word":"管窥蠡测","pinyin":"guǎn kuī lǐ cè","abbr":"gklc","explanation":"管：竹管；蠡：贝壳做的瓢。从竹管里看天，用瓢测量海水。比喻对事物的观察和了解很狭窄，很片面。","source":{"text":"以管窥天，以蠡测海，以筳撞钟，岂能通其条贯，考其文理，发其音声哉。","book":"汉·东方朔《答客难》"},"example":{"text":"～，知其孤陋。","book":"清·梁启超《西学书目表序》"},"similar":["盲人摸象","坐井观天","以管窥天"],"opposite":["洞若观火"],"usage":"作主语、谓语、宾语；指看问题很片面","story":["西汉文学家东方朔很有才能，但经常讽刺汉武帝因而只担任太中大夫等小官，没有得到汉武帝的重用。他写一篇《答客难》抒发自己怀才不遇的心情，他把自己与苏秦、张仪比较，他认为有才能的人不能管窥蠡测，要注意自己的行为与节操"]},{"id":35795,"word":"管蠡窥测","pinyin":"guǎn lǐ kuī cè","abbr":"glkc","explanation":"窥：从小孔中看物。从竹管里看天，用瓢测量海水。比喻对事物的观察和了解很狭窄、片面，见识短浅。","source":{"text":"唐以来选诗不下数十家，皆管蠡窥测，刊落靡芜，独存大雅者一人，高廷礼氏。","book":"明·胡应麟《诗薮·唐下》"},"similar":["管窥蠡测"],"usage":"作主语、定语、宾语；指看问题很片面"},{"id":35796,"word":"管见所及","pinyin":"guǎn jiàn suǒ jí","abbr":"gjsj","explanation":"管见：从管子里看东西，指见识浅陋。谦虚的说法，表示自己见识不广，意见未必正确。","source":{"text":"故世间道士知金丹之事者万无一者。而管见之属，谓仙法当具在于纷若之书，及于祭礼拜伏之间而已矣。","book":"《抱朴子·勤求》"},"example":{"text":"以上观点真是～，望赐教。"},"similar":["管窥之见"],"usage":"作谓语、定语；用于自谦"},{"id":35797,"word":"管间窥豹","pinyin":"guǎn jiān kuī bào","abbr":"gjkb","explanation":"窥：从小孔看。从竹管的小孔中看豹，只看到豹身上的一块斑纹。比喻只看到事物的一部分。","source":{"text":"张衡、左思等辈，于道如从管间窥豹，故所作文赋，紧持扬、马襟袖。","book":"宋·吕南公《与汪秘校论文书》"},"similar":["管中窥豹","窥豹一斑"],"usage":"作谓语、定语、状语；指片面看问题"},{"id":35798,"word":"管鲍之交","pinyin":"guǎn bào zhī jiāo","abbr":"gbzj","explanation":"春秋时，齐人管仲和鲍叔牙相知最深。后常比喻交情深厚的朋友。","source":{"text":"生我者也，知我者鲍叔也。此世称管鲍善交也。","book":"《列子·力命》"},"example":{"text":"前与苏子瞻山河订誓，本为～，名位相倾，顿起孙庞之隙。","book":"明·陈汝元《金莲记·诗案》"},"similar":["生死之交","管鲍之好"],"opposite":["点头之交","孙庞之隙"],"usage":"作宾语；用于好朋友","story":["春秋时期，齐国的管仲与鲍叔牙关系特别好，他们合伙做生意，鲍叔牙总是多出本钱少分利，乐意帮助贫寒的管仲。管仲率军打仗兵败，只有鲍叔牙了解他的苦衷。小白执政齐国后，鲍叔牙把相国的位子让给管仲，管仲说：“知我者鲍子也。”"]},{"id":35799,"word":"管鲍之好","pinyin":"guǎn bào zhī hǎo","abbr":"gbzh","explanation":"春秋时齐人管仲和鲍叔牙相知最深。后常比喻交情深厚的朋友。","source":{"text":"家公与蔡伯有管鲍之好。","book":"郭沫若《再谈蔡文姬的》"},"similar":["管鲍之交"],"opposite":["孙庞之隙"],"usage":"作宾语；用于好朋友"},{"id":35800,"word":"管鲍分金","pinyin":"guǎn bào fēn jīn","abbr":"gbfj","explanation":"管：管仲；鲍：鲍叔牙，战国时齐国的名相；金：钱财。比喻情谊深厚，相知相悉。","source":{"text":"管仲曰：‘吾始困时，尝与鲍叔贾，分财利多自与，鲍叔不以我为贪，知我贫也’","book":"《史记·管晏列传》"},"example":{"text":"两公交谊，至于如此，世人艳称～，不足齿冷耶？（清·夏敬渠《野叟曝言》第一百四十六回）"},"similar":["管鲍之交"],"usage":"作宾语、定语；指人情意深","story":["春秋时期，齐国的管仲与鲍叔牙关系特别好，他们年轻时候经常合伙做生意，鲍叔牙总是多出本钱而少分利，他知道管仲家贫，乐意帮助贫寒的管仲。小白执政齐国后，鲍叔牙把相国的位子让给管仲，管仲说：“知我者鲍子也。”"]},{"id":35801,"word":"箪瓢屡空","pinyin":"dān piáo lǚ kōng","abbr":"dplk","explanation":"箪：盛饭竹器；瓢：舀水器。吃的喝的匮乏。形容生活非常贫困。","source":{"text":"环堵萧然，不蔽风日，短褐穿结，箪瓢屡空。","book":"晋·陶渊明《五柳先生传》"},"example":{"text":"争奈此人～，若待媒证求亲，俺父亲决然不肯。","book":"明·冯梦龙《警世通言》卷六"},"similar":["箪食瓢饮"],"opposite":["食前方丈"],"usage":"作谓语、定语；指生活贫困"},{"id":35802,"word":"箪瓢屡罄","pinyin":"dān piáo lǚ qìng","abbr":"dplq","explanation":"箪：盛饭的竹器；瓢：舀水器。吃的喝的匮乏。形容生活非常清苦贫寒。","source":{"text":"箪瓢屡罄，希谷瓢饮。","book":"晋·陶渊明《自祭文》"},"similar":["箪瓢屡空"],"opposite":["食前方丈"],"usage":"作谓语、定语；指生活贫困"},{"id":35803,"word":"箪瓢陋室","pinyin":"dān piáo lòu shì","abbr":"dpls","explanation":"箪：古代盛饭的圆形竹器；瓢：古代装水的小容器。一箪食物，一瓢汤水。形容生活简朴，安贫乐道。","source":{"text":"箪瓢陋室，若饫万钟。","book":"明·方孝孺《祭太史公》"},"similar":["箪瓢陋巷"],"usage":"作主语、宾语、定语；形容生活简朴"},{"id":35804,"word":"箪瓢陋巷","pinyin":"dān piáo lòu xiàng","abbr":"dplx","explanation":"箪：古代盛饭的圆形竹器；瓢：古代装水的小容器。一箪食物，一瓢汤水。形容生活简朴，安贫乐道。","source":{"text":"一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。","book":"春秋·鲁·孔丘《论语·雍也》"},"example":{"text":"须学取～，暂乐田园。","book":"明·朱鼎《玉镜台记·议婚》"},"similar":["箪食瓢饮","箪瓢屡空"],"usage":"作主语、宾语、定语；形容生活简朴","story":["春秋时期，孔子在他的学生中最喜欢颜回，他十分尊敬孔子。孔子指出缺点马上就改正，孔子问他为什么不去谋个一官半职。颜回说只要学到老师的道德学问何必去做官。孔子赞叹颜回吃的是一竹筐饭，喝的是一瓢水，住在陋巷，是一个大贤人"]},{"id":35805,"word":"箪豆见色","pinyin":"dān dòu jiàn sè","abbr":"ddjs","explanation":"比喻计较小利。","source":{"text":"好名之人能让千乘之国，苟非其人，箪食豆羹见于色。","book":"战国·邹·孟轲《孟子·尽心下》"},"example":{"text":"是何异～，而曰我通功利派之哲学，饮博无赖。","book":"梁启超《论自由》"},"similar":["芝麻绿豆"],"usage":"作谓语、定语；指斤斤计较"},{"id":35806,"word":"箪醪投川","pinyin":"dān láo tóu chuān","abbr":"dltc","explanation":"醪：醇酒。相传古有一良将，将所得酒倒在河里，让兵士从河中取水共饮。后表示将领爱惜部下，与部下同甘共苦。","source":{"text":"昔良将之用兵也，人有馈一箪之醪，投河，而三军为致死者，以滋味及之也。","book":"晋·张协《七命》：“单（箪）醪投川，可使三军告捷。”李善注引《黄石公记》"},"usage":"作宾语、定语；用于人际交往"},{"id":35807,"word":"箪食与饿","pinyin":"dān sì yǔ è","abbr":"dsye","explanation":"与：给与。用箪盛饭给与饥饿的人。","source":{"text":"晋赵宣子舍于翳桑，见灵辄饿，为箪食以与之。","book":"清·张英等《渊鉴类涵·施惠三》"}},{"id":35808,"word":"箪食壶浆","pinyin":"dān sì hú jiāng","abbr":"dshj","explanation":"食：食物；浆：汤。百姓用箪盛饭，用壶盛汤来欢迎他们爱戴的军队。形容军队受到群众热烈拥护和欢迎的情况。","source":{"text":"箪食壶浆以迎王师。","book":"《孟子·梁惠王上》"},"example":{"text":"时操引得胜之兵，陈列于河上，有土人～以迎之。","book":"明·罗贯中《三国演义》第三十一回"},"similar":["壶浆箪食","壶浆塞道"],"usage":"作宾语、状语；常与“迎接”连用","story":["战国时期燕国相国子之暴政，大将子被、太子平率兵讨伐，国内大乱。齐宣王趁机出兵攻打燕国并控制大部分领土，燕国老百姓用箪送吃的，用壶装喝的欢迎齐军，齐宣王想侵吞了燕国咨询孟子，孟子说：“你会让他们生活在水深火热中的。”"]},{"id":35809,"word":"箪食壶酒","pinyin":"dān sì hú jiǔ","abbr":"dshj","explanation":"箪：盛饭竹器。一箪食，一壶酒。指少量饮食。","source":{"text":"今以箪食壶酒与人则终身不忘，惟天德帝力广大莫测，故有终身囿之而不知者。","book":"明·李东阳《中书舍人徐君寿六十序》"},"similar":["箪食瓢饮"],"usage":"作宾语、定语；指少量饮食"},{"id":35810,"word":"箪食瓢饮","pinyin":"dān sì piáo yǐn","abbr":"dspy","explanation":"一箪食物，一瓢饮料。形容读书人安于贫穷的清高生活。","source":{"text":"一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。","book":"《论语·雍也》"},"example":{"text":"而又有～，足以不死。","book":"唐·韩愈《与李翱书》"},"similar":["节衣缩食","粗茶淡饭"],"opposite":["大吃大喝","穷奢极侈","大块朵颐"],"usage":"作主语、宾语、定语；形容生活简朴","story":["春秋时期，孔子在他的学生中最喜欢颜回，他十分尊敬孔子。孔子指出缺点马上就改正，孔子问他为什么不去谋个一官半职。颜回说只要学到老师的道德学问何必去做官。孔子赞叹颜回吃的是一竹筐饭，喝的是一瓢水，是一个大贤人"]},{"id":35811,"word":"箪食豆羹","pinyin":"dān sì dòu gēng","abbr":"dsdg","explanation":"箪：盛饭用的竹器；豆：古代盛食物的器皿。一箪饭食，一豆羹汤。形容食物很少。也比喻小利。","source":{"text":"好名之人，能让千乘之国，苟非其人，箪食豆羹见于色。","book":"《孟子·告子上》：“一箪食，一豆羹，得之则生，弗得则死。”《孟子·尽心下》"},"example":{"text":"天下之富，是～之积也。","book":"宋·苏轼《伊尹论》"},"usage":"作宾语、定语；用于生活"},{"id":35812,"word":"箫韶九成","pinyin":"xiāo sháo jiǔ chéng","abbr":"xsjc","explanation":"箫韶：虞舜时的乐章；九成：九章。指箫韶音乐奏了九章。","source":{"text":"箫韶九成，凤凰来仪。","book":"《尚书·益稷》"},"example":{"text":"猛听得仙音院凤管鸣，更说甚～。","book":"元·马致远《汉宫秋》第四折"},"usage":"作宾语、定语；指箫韶音乐奏了九章"},{"id":35813,"word":"箭不虚发","pinyin":"jiàn bù xū fā","abbr":"jbxf","explanation":"虚：空。形容箭术高超，百发百中。","source":{"text":"弓不虚发，应声而倒。","book":"汉·司马相如《上林赋》"},"example":{"text":"你说天下有这等得心应手，～的美事。","book":"清·蒋士铨《香祖楼》十六"},"similar":["百发百中","剑无虚发","弹无虚发"],"opposite":["无的放矢","百无一存"],"usage":"作谓语、宾语；形容办事有充分的把握"},{"id":35814,"word":"箭在弦上","pinyin":"jiàn zài xián shàng","abbr":"jzxs","explanation":"箭已搭在弦上。比喻为形势所迫，不得不采取某种行动。","source":{"text":"矢在弦上，不可不发。","book":"三国·魏·陈琳《为袁绍檄豫州》注引《魏志》"},"example":{"text":"我觉得以文字结怨于小人，是不值得的。至于我，其实乃是～。","book":"《鲁迅书信集·致杨霁云》"},"similar":["不得不发","矢在弦上","如箭在弦"],"usage":"作宾语、定语；比喻情况危急","story":["东汉末年，袁绍为了攻打曹操，让陈琳写一篇《为袁绍檄豫州》的檄文，列举曹操的罪状，大骂曹操祖宗三代。袁绍官渡之战败给曹操，陈琳也趁机投靠曹操。曹操问陈琳为什么写那篇檄文，陈琳说那时箭在弦上被袁绍所逼而写"]},{"id":35815,"word":"箭在弦上，不得不发","pinyin":"jiàn zài xián shàng，bù dé bù fā","abbr":"jzxsbdbf","explanation":"箭：弓箭；弦：弓上用以发箭的牛筋绳子。箭已搭在弦上，不得不发射。比喻事情到了不得不采取行动的时候。","source":{"text":"矢在弦上，不可不发。","book":"三国·魏·陈琳《为袁绍檄豫州》李善注引《魏志》"},"example":{"text":"至于我，其实乃是～。","book":"《鲁迅书信集》"},"similar":["箭在弦上"],"usage":"作宾语、定语；比喻情况危急","story":["东汉末年，袁绍为了攻打曹操，让陈琳写一篇《为袁绍檄豫州》的檄文，列举曹操的罪状，大骂曹操祖宗三代。袁绍官渡之战败给曹操，陈琳也趁机投靠曹操。曹操问陈琳为什么写那篇檄文，陈琳说那时箭在弦上被袁绍所逼而写"]},{"id":35816,"word":"箭拔弩张","pinyin":"jiàn bá nǔ zhāng","abbr":"jbnz","explanation":"箭：弓箭；弩：古代一种用机械力量射箭的弓。比喻形势紧张，一触即发","source":{"text":"冯永祥看他们箭拔弩张，形势不妙，赶紧站起来，走到他们当中。","book":"周而复《上海的早晨》第四部"},"example":{"text":"洪深《电影戏剧表演术》：“大部分的时候是含精养锐的，必要时才一用力，正不必面红耳赤，～的。”"},"similar":["一触即发","剑拔弩张"],"opposite":["风平浪静"],"usage":"作谓语、宾语、定语；指形势紧张"},{"id":35817,"word":"箭无空发","pinyin":"jiàn wú kōng fā","abbr":"jwkf","explanation":"形容箭术高超，百发百中。","source":{"text":"汉·司马相如《上林赋》：“弓不虚发，应声而倒。"},"example":{"text":"朱伺与贼水战，左右三人上弩以结同，伺望敌射之，～。","book":"《晋书·陶侃传》"}},{"id":35818,"word":"箭无虚发","pinyin":"jiàn wú xū fā","abbr":"jwxf","explanation":"箭：弓箭；虚：空。箭射得准，每发必中。形容箭术高明。","source":{"text":"朱伺与贼水战，左右三人上弩给伺，伺望敌射之，箭无虚发。","book":"《晋书·陶侃传》"},"example":{"text":"吴蜀联军～，魏军被打得落花流水。"},"similar":["箭不虚发","矢无虚发"],"opposite":["无的放矢"],"usage":"作谓语、宾语；形容办事有充分的把握"},{"id":35819,"word":"箭穿雁口","pinyin":"jiàn chuān yàn kǒu","abbr":"jcyk","explanation":"箭：弓箭；穿：通过，穿通。比喻闭嘴不出声。","source":{"text":"似箭穿雁口，没个人敢咳嗽。","book":"元·马致远《汉宫秋》"},"similar":["箭穿雁嘴"],"usage":"作宾语、定语；用于比喻句"},{"id":35820,"word":"箭穿雁嘴","pinyin":"jiàn chuān yàn zuǐ","abbr":"jcyz","explanation":"比喻不开口说话。","source":{"text":"诸将见李逵等杀了这一阵，众人都胆颤心寒，不敢出战。问了数声，如箭穿雁嘴，钩搭鱼腮，默默无言，无人敢应。","book":"明·施耐庵《水浒传》第一百十二回"},"similar":["箭穿雁口","钩搭鱼鳃"],"usage":"作宾语、定语；用于比喻句"},{"id":35821,"word":"箴规磨切","pinyin":"zhēn guī mó qiē","abbr":"zgmq","explanation":"箴规：规谏，劝戒；切：切磋。互相批评，互相帮助。","source":{"text":"朋友道缺绝久，无有相箴规磨切之道。","book":"唐·韩愈《答冯宿书》"},"similar":["切磨箴规"],"usage":"作谓语、宾语、定语；指互相帮助"},{"id":35822,"word":"箸长碗短","pinyin":"zhù chàng wǎn duǎn","abbr":"zcwd","explanation":"形容家用器物凌乱不全。","source":{"text":"灿若自王氏亡后，日食用度，箸长碗短，十分的不像意。","book":"明·凌濛初《初刻拍案惊奇》第16卷"},"example":{"text":"他们家～，十分简单。"},"usage":"作谓语、定语；指人贫穷"},{"id":35823,"word":"篆刻虫雕","pinyin":"zhuàn kè chóng diāo","abbr":"zkcd","explanation":"比喻使小技","source":{"text":"篆刻虫雕笑壮夫，凿山铸铁叹阳湖。","book":"姚锡钧《论诗绝句》"},"usage":"作宾语、定语；用于书面语"},{"id":35824,"word":"篝火狐鸣","pinyin":"gōu huǒ hú míng","abbr":"ghhm","explanation":"夜里把火放在笼里，使隐隐约约象磷火，同时又学狐叫。这是陈涉、吴广假托狐鬼之事以发动群众起义的故事。后用来比喻策划起义。","source":{"text":"又间令吴广之次所旁丛祠中，夜篝火，狐鸣呼曰：‘大楚兴，陈胜王。’","book":"《史记·陈涉世家》"},"example":{"text":"后人把疑神见鬼等情，说做～，便是引用陈胜、吴广的古典。","book":"蔡东藩《前汉演义》第九回"},"similar":["狐鸣篝火"],"usage":"作谓语、定语；比喻策划起义","story":["秦朝末年，陈胜、吴广被抓去当兵，因大雨耽误了行程，只好起来造反。造反前陈胜请算命先生算了一卦，在白绸子写“陈胜王”塞入鱼腹，半夜在古庙用竹笼罩上篝火，学狐狸叫“陈胜王”，为起来造势，第二天就起义，建立张楚政权"]},{"id":35825,"word":"篝灯呵冻","pinyin":"gōu dēng hē dòng","abbr":"gdhd","explanation":"置灯于笼中，并以口气嘘物取暖。比喻写作之勤奋。","source":{"text":"因为简择数条，附此录之末，以不没其篝灯呵冻之劳。","book":"清·纪昀《阅微草堂笔记·滦阳续录》"},"usage":"作宾语、定语；用于比喻句"},{"id":35826,"word":"篡位夺权","pinyin":"cuàn wèi duó quán","abbr":"cwdq","explanation":"篡：夺取，特指臣子夺取君位。夺取君主的位置及其权柄。","source":{"text":"那凶玩很劣，奸滑侥幸，则待篡位夺权。","book":"元·尚仲贤《三夺槊》第四折"},"similar":["篡党夺权"],"usage":"作谓语、宾语；指篡位"},{"id":35827,"word":"篡党夺权","pinyin":"cuàn dǎng duó quán","abbr":"cddq","explanation":"篡夺党和国家的领导权。","source":{"text":"林彪、‘四人帮’早就勾结在一起，阴谋篡党夺权。","book":"邓小平《在全军政治工作会议上的讲话》"},"example":{"text":"在这无花的春天里，‘四人帮’加快了～的步伐。","book":"张书绅《正气歌》"},"similar":["篡位夺权"],"usage":"作谓语、定语；指篡位"},{"id":35828,"word":"篱壁间物","pinyin":"lí bì jiān wù","abbr":"lbjw","explanation":"指家乡所产的平常之物。","source":{"text":"德之休明，肃慎负其楛矢，如其不尔，篱壁间物亦不可得也。","book":"南朝·宋·刘义庆《世说新语·排调》"},"usage":"作主语、宾语、定语；指家常用品","story":["晋朝时期，桓玄向来看不起桓崖。当时桓崖在京城栽了很多桃树，桃树上结满了桃。桓玄多次去桓崖家要桃，桓崖只给他一些差桃，好桃留给自己。桓玄于是给殷仲文写信嘲笑说：“德之休明，肃慎负其楛矢；如其不尔，篱壁间物亦不可得也。”"]},{"id":35829,"word":"篱牢犬不入","pinyin":"lí láo quǎn bù rù","abbr":"llqbr","explanation":"篱笆编得结实，狗就钻不进来。比喻自己品行端正，坏人就无法勾引。","source":{"text":"嫂嫂把得家定，我哥哥烦恼做甚么？岂不闻古人言：‘篱牢犬不入。’","book":"明·施耐庵《水浒传》第二十四回"},"opposite":["红杏出墙"],"usage":"作宾语、分句；用于女性居多"},{"id":35830,"word":"簇锦团花","pinyin":"cù jǐn tuán huā","abbr":"cjth","explanation":"簇：聚成团。锦：有花纹的丝织品。形容五色缤纷，繁华艳丽的景象。","source":{"text":"正出朝门，恰遇知心好友，现做太尉，叫做哈麻，领着一班女乐，都穿着绝样簇锦团花白寿衣，都戴着七星摇拽堕马妆角髻，都履着绒扣锦帮三寸凤头鞋……约有五十余人进宫而来。","book":"明·郭勋《英烈传》第一回"},"example":{"text":"在这～的季节里，我们快乐地成长。"},"similar":["花团锦簇"],"usage":"作宾语、定语；指五彩缤纷"},{"id":35831,"word":"簟纹如水","pinyin":"diàn wén rú shuǐ","abbr":"dwrs","explanation":"簟：竹。竹席细密的纹理像清凉的水一样。常用以形容夏夜的清凉。","source":{"text":"扫地焚香闭阁眠，簟纹如水帐如烟。","book":"宋·苏轼《南堂五首》"},"example":{"text":"纱厨如舞，～，别有生凉处。","book":"宋·辛弃疾《御街行》"},"usage":"作宾语；形容夏日的清凉"},{"id":35832,"word":"簠簋不修","pinyin":"fǔ guǐ bù xiū","abbr":"fgbx","explanation":"簠、簋：古代食器、祭器。借指贪污。","source":{"text":"公下车，召人吏告之曰：‘官吏有簠簋不修者……未至前一无所问，而今而后，义不相容。","book":"唐·颜真卿《赠司空上柱国陇西郡开国公李公神道碑》"},"similar":["簠簋不饬","簠簋不饰"],"usage":"作谓语、定语；旧时弹劾贪吏常用此语"},{"id":35833,"word":"簠簋不饬","pinyin":"fǔ guǐ bù chì","abbr":"fgbc","explanation":"簠、簋：都是古代食器，也用作放祭品；不饬：不整饬。借指贪污。旧时弹劾贪吏常用此语。","source":{"text":"古者大臣有坐不廉而废者，不谓不廉，曰：‘簠簋不饬’。","book":"《汉书·贾谊传》"},"example":{"text":"至夫～，下官不职者，吾居是邑则不敢非。","book":"明·赵弼《繁邑古祠对》"},"similar":["簠簋不饰","簠簋不修"],"usage":"作谓语、定语；旧时弹劾贪吏常用此语"},{"id":35834,"word":"簠簋不饰","pinyin":"fǔ guǐ bù shì","abbr":"fgbs","explanation":"簠簋：古代的食器、祭器；不饰：不整齐。指为官不清正廉洁的人。","source":{"text":"古者大臣有坐不廉而废者，不谓不廉，曰‘簠簋不饰’。","book":"东汉·班固《汉书·贾谊传》"},"example":{"text":"沙老先生就有什么～处，也须明正其罪，朝廷从无此拳足相加之法。","book":"清·名教中人《好逑传》第二回"},"similar":["簠簋不饬","簠簋不修"],"usage":"作宾语、定语；用于弹劾贪官污吏的用语"},{"id":35835,"word":"簠簋之风","pinyin":"fǔ guǐ zhī fēng","abbr":"fgzf","explanation":"簠簋：古代食器、祭器。指官吏贪财受贿的风气。","source":{"text":"于是干谒不行，孤寒吐气，簠簋之风为之一变。","book":"清·陈康祺《郎潜纪闻》第六卷"},"similar":["簠簋不饰"],"usage":"作主语、宾语；用于社会风气等","story":["清朝康熙时期，官场腐败，贪污成风。莱阳赵仑阆仙，康熙21年在江南任督学，他从自身做起，想改变当时的簠簋之风，在过长江的船上击楫发誓：如果贪一毫之私就不能生还江北。他十分清廉，去拜谒地方官时也是空手而去，一时传为佳话"]},{"id":35836,"word":"簪盍良朋","pinyin":"zān hé liáng péng","abbr":"zhlp","explanation":"簪：聚拢；盍：同“合”，聚合。指好朋友相聚。","source":{"text":"簪盍良朋，把酒论文。","book":"宋·王十朋《蓬莱阁赋》"},"usage":"作谓语、定语；用于书面语"},{"id":35837,"word":"簪笔磬折","pinyin":"zān bǐ qìng zhé","abbr":"zbqz","explanation":"古代插笔备礼，曲体作揖，以示尊敬。","source":{"text":"西门豹簪笔磬折，向河立待良久。","book":"《史记·滑稽列传》"},"usage":"作谓语、定语；用于书面语"},{"id":35838,"word":"簪缨世族","pinyin":"zān yīng shì zú","abbr":"zysz","explanation":"簪和缨，古时达官贵人的冠饰，用来把冠固着在头上。旧时指世代作官的人家。","source":{"text":"空余老宾客，身上愧簪缨。","book":"唐·杜甫《八哀诗·赠左仆射郑国公严公武》"},"similar":["簪缨之族"],"usage":"作宾语、定语；指世代作官的人家"},{"id":35839,"word":"簪缨世胄","pinyin":"zān yīng shì zhòu","abbr":"zysz","explanation":"簪：发针；缨：帽带；世胄：封建社会中世代相传的官宦家庭。指世代做官的人家.","source":{"text":"贤士乃簪缨世胄，堪为元戎帅首也。","book":"唐·杜甫《八哀诗·赠左仆射郑国公严公武》：“空余老宾客，身上愧簪缨。”元·郑德辉《王粲登楼》第二折"},"example":{"text":"舍人是～，况又是黉宫名士，指日飞腾，岂分什么文武门楣？（明·凌濛初《二刻拍案惊奇》卷十七）"},"similar":["簪缨门第"],"usage":"作宾语、定语；指世代作官的人家"},{"id":35840,"word":"簪缨之族","pinyin":"zān yīng zhī zú","abbr":"zyzz","explanation":"簪缨：古时达官贵人的冠饰，借指宦官。旧时指世代作官的人家","example":{"text":"他出身～，肯定能成功"},"similar":["簪缨世族","簪缨世胄"],"usage":"作宾语、定语；指世代作官的人家"},{"id":35841,"word":"簪缨门第","pinyin":"zān yīng mén dì","abbr":"zymd","explanation":"旧指显贵人家。","source":{"text":"这安老爷家，通共算起来，内外上下也有三二十口人，虽然算不得簪缨门第、钟鼎人家，却倒过得亲亲热热，安安静静。","book":"清·文康《儿女英雄传》第一回"},"example":{"text":"即便他恩情金石样，他家是～也不相当。","book":"欧阳予倩《馒头庵》第二场"},"similar":["簪缨之族","簪缨世族"],"usage":"作宾语、定语；用于书面语"},{"id":35842,"word":"簪蒿席草","pinyin":"zān hāo xí cǎo","abbr":"zhxc","explanation":"以蒿作簪，以草为席。形容生活艰苦。","source":{"text":"［杜林］于河西得漆书古文《尚书经》一卷，每遭困厄，握抱此经。寄隗嚣地，终不降志辱身，至簪蒿席草，不食其粟。","book":"《东观汉记·杜林传》"},"usage":"作谓语、定语；用于书面语"},{"id":35843,"word":"簸之扬之，糠秕在前","pinyin":"bǒ zhī yáng zhī，kāng bǐ zài qián","abbr":"bzyzkbzq","explanation":"糠秕：谷皮和瘪谷，比喻无价值的东西。形容自己不如别人。","source":{"text":"簸之扬之，糠秕在前。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"亦曰‘～’云尔。","book":"明·睡乡居士《序》"},"similar":["簸扬糠秕"],"usage":"作定语、分句；用于自谦","story":["东晋时期，司马昱邀请王坦之和范启前去议事，范启年龄大而官位小，王坦之年龄小而官位大。他们两人互相谦让让对方走前头。王坦之走在范启前开玩笑说“簸之扬之，糠秕在前。”范启反唇相讥：“淘啊汰啊，沙砾在后。”"]},{"id":35844,"word":"簸土扬沙","pinyin":"bǒ tǔ yáng shā","abbr":"btys","explanation":"指虚张声势。","source":{"text":"你这般摇旗呐喊，簸土扬沙。","book":"元·乔吉《两世姻缘》第三折"},"similar":["虚张声势"],"usage":"作谓语；指虚张声势"},{"id":35845,"word":"簸扬糠秕","pinyin":"bǒ yáng kāng bǐ","abbr":"bykb","explanation":"糠秕：谷皮和瘪谷，比喻无价值的东西。形容自己不如别人，无才而居前列。","source":{"text":"儿曹徼时厚幸，并登仕版，而懋修又邋居文孙之首，簸扬糠秕，殊为惭汗。","book":"明·张居正《答宗伯董浔阳书》"},"usage":"作谓语、定语；指位卑而居前列","story":["东晋时期，司马昱邀请王坦之和范启前去议事，范启年龄大而官位小，王坦之年龄小而官位大。他们两人互相谦让让对方走前头。王坦之走在范启前开玩笑说“簸之扬之，糠秕在前。”范启反唇相讥：“淘啊汰啊，沙砾在后。”"]},{"id":35846,"word":"米已成炊","pinyin":"mǐ yǐ chéng chuī","abbr":"mycc","explanation":"比喻事已做出，无可挽回。","example":{"text":"事前没计划好，现在～，要亡羊补牢也来不及了。"}},{"id":35847,"word":"米烂成仓","pinyin":"mǐ làn chéng cāng","abbr":"mlcc","explanation":"仓：粮仓。一仓一仓的粮食腐烂了。形容家中十分富有。","source":{"text":"家中钱过北斗，米烂成仓，黄的是金，白的是银，圆的是珠，放光的是宝，也有犀牛头上角，大象口中牙。","book":"明·兰陵笑笑生《金瓶梅词话》第三回"},"example":{"text":"真像古人说的：钱过北斗，～，僮仆成群，朱马成行。","book":"周而复《上海的早晨》六"},"usage":"作宾语、定语；指人非常富有"},{"id":35848,"word":"米珠薪桂","pinyin":"mǐ zhū xīn guì","abbr":"mzxg","explanation":"珠：珍珠。米贵得象珍珠，柴贵得象桂木。形容物价昂贵，人民生活极其困难。","source":{"text":"楚国之食贵于玉，薪贵于桂。","book":"《战国策·楚策三》"},"example":{"text":"长安～，居大不易。","book":"姚雪垠《李自成》第一卷第二十六章"},"similar":["食玉炊桂","桂薪玉粒"],"usage":"作谓语、定语；指物价昂贵","story":["战国时期，纵横家苏秦擅长辩论，凭一张嘴到处游说。他去楚国要求见楚王，把守宫门的谒者索贿不成，故意陷害他，让他先住三天，卖给他的东西特别贵。楚王见苏秦后，谈得非常投机。苏秦说楚国的米像珍珠、柴火像桂木一样贵"]},{"id":35849,"word":"米盐凌杂","pinyin":"mǐ yán líng zá","abbr":"mylz","explanation":"凌杂：错杂零乱；米盐：形容细碎。形容零乱琐碎。","source":{"text":"近世十二诸侯七国相王，言纵横者继踵，而皋唐甘石因时务论其书传，故其占验凌杂米盐。","book":"《史记·天官书》"},"example":{"text":"见君鸡鸣而起，夜分不息，检摄官中文书、狱讼，以及宾从、隶圉～，细大不遗。","book":"清·方苞《李皋侯墓志铭》"}},{"id":35850,"word":"米盐博辩","pinyin":"mǐ yán bó biàn","abbr":"mybb","explanation":"比喻议论广博细杂。","source":{"text":"米盐博辩 ，则以为多而交之。","book":"《韩非子·说难》"},"usage":"作宾语；用于文章等"},{"id":35851,"word":"米粒之珠","pinyin":"mǐ lì zhī zhū","abbr":"mlzz","explanation":"比喻细微弱小的东西。","source":{"text":"料尔等米粒之珠，吐光不大；蝇翅飞腾，去而不远。","book":"明·许仲琳《封神演义》第五十三回"},"example":{"text":"～，也放光华！","book":"梁羽生《狂侠天娇魔女》第七十一回"},"usage":"作主语、宾语；指细小的东西"},{"id":35852,"word":"类同相召","pinyin":"lèi tóng xiāng zhāo","abbr":"ltxz","explanation":"召：召唤。同类者相互招引、呼应。","source":{"text":"类同相召，气同则合，声比则应。","book":"《吕氏春秋·召类》"}},{"id":35853,"word":"类是而非","pinyin":"lèi shì ér fēi","abbr":"lsef","explanation":"类：类似；是：正确的；非：错误的。貌似正确的，实际上是错误的。也指是非不分明，模棱两可。","source":{"text":"辞多类非而是，多类是而非，是非之径，不可不分。","book":"《吕氏春秋·察传》"}},{"id":35854,"word":"类聚群分","pinyin":"lèi jù qún fēn","abbr":"ljqf","explanation":"各种方术因种类相同而聚合，各种事物因类别不同而区分。","source":{"text":"可谓类聚群分，杂而不越，文质彬彬，最可得而论也。","book":"《北史·江式传》"},"example":{"text":"方天地设位之初，～，以戴其尤能者为之长君。","book":"宋·陈亮《回答》上"},"similar":["分门别类"],"usage":"作谓语、定语；指分门别类"},{"id":35855,"word":"粉墙朱户","pinyin":"fěn qiáng zhū hù","abbr":"fqzh","explanation":"粉：涂饰；朱：红色。白粉墙砖红漆大门。指富贵人家。","source":{"text":"知远将身奔入那庄门，只见粉墙朱户，画阁琼楼。","book":"《新编五代史平话·汉史》"},"usage":"作宾语、定语；用于比喻句"},{"id":35856,"word":"粉墨登场","pinyin":"fěn mò dēng chǎng","abbr":"fmdc","explanation":"粉、墨：搽脸和画眉用的化妆品。原指演员化妆上台演戏。比喻坏人经过一番打扮，登上政治舞台。","source":{"text":"而关汉卿辈至躬践排场，而傅粉墨。","book":"臧懋循《元曲选后序》"},"example":{"text":"及至北平攻陷，这些地痞流氓自然没有～的资格与本领，而日本也并未准备下多少官吏来马上发号施令。","book":"老舍《四世同堂》七"},"similar":["走马上任","抛头露面"],"opposite":["匿影藏形","消声匿迹"],"usage":"作谓语、定语；表讥讽"},{"id":35857,"word":"粉妆玉琢","pinyin":"fěn zhuāng yù zhuó","abbr":"fzyz","explanation":"白粉装饰的，白玉雕成的。形容女子妆饰的漂亮或小孩长得白净。也用来形容雪景。","source":{"text":"士隐见女儿越发生得粉装玉琢，乖觉可喜，便伸手接来抱在怀中斗他玩耍一回；","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"头抬起来时，～似的双颊泛上一阵红晕。","book":"叶圣陶《倪焕之》十六"},"similar":["粉妆玉砌","粉装玉琢"],"usage":"作谓语、补语、定语；形容女子妆饰白净"},{"id":35858,"word":"粉妆玉砌","pinyin":"fěn zhuāng yù qì","abbr":"fzyq","explanation":"用白粉装饰，用白玉砌成。形容雪景及人皮肤白嫩。","source":{"text":"山川、河流、树木、房屋，全都罩上了一层厚厚的雪，万里江山，变成了粉妆玉砌的世界。","book":"《第一场雪》"},"similar":["粉妆玉琢","粉装玉琢"],"usage":"作谓语、补语、定语；用于白色景观"},{"id":35859,"word":"粉妆银砌","pinyin":"fěn zhuāng yín qì","abbr":"fzyq","explanation":"以白粉装修，以银砖砌成。形容庭院的雪景。","source":{"text":"贾母笑着，挽着凤姐的手，仍上了轿，带着众人说笑，出了夹道东门，四面粉妆银砌。","book":"清·曹雪芹《红楼梦》第五十回"},"similar":["粉妆玉砌"],"usage":"作谓语、补语、定语；用于白色景观"},{"id":35860,"word":"粉白墨黑","pinyin":"fěn bái mò hēi","abbr":"fbmh","explanation":"以粉傅面、以黛画眉。谓女子修饰容颜。同“粉白黛黑”。","source":{"text":"彼郑周之女，粉白墨黑，立于衢闾非知而见之者，以为神。","book":"《战国策·楚策三》"},"similar":["粉白黛黑"],"usage":"作宾语、定语；指女子的妆饰"},{"id":35861,"word":"粉白黛绿","pinyin":"fěn bái dài lǜ","abbr":"fbdl","explanation":"泛指女子的妆饰。","source":{"text":"粉白黛黑，施芳泽只。","book":"战国·楚·屈原《大招》"},"example":{"text":"一时～，燕语莺啼，顿时把餐室客厅，化做碧城锦谷。","book":"清·曾朴《孽海花》第三十一回"},"similar":["粉白黛黑"],"usage":"作定语；指女子的妆饰"},{"id":35862,"word":"粉白黛黑","pinyin":"fěn bái dài hēi","abbr":"fbdh","explanation":"粉白：在脸上搽粉，使脸更白；黛黑：画眉毛，使眉毛更黑。泛指女子的妆饰。","source":{"text":"衣阿锡，曳齐纨，粉白黛黑，佩玉环杂。","book":"战国·郑·列御寇《列子·周穆王》"},"example":{"text":"虽～，弗能为美者。","book":"西汉·刘安《淮南子·修务训》"},"similar":["粉白墨黑"],"usage":"作宾语、定语；指女子的妆饰"},{"id":35863,"word":"粉装玉琢","pinyin":"fěn zhuāng yù zhuó","abbr":"fzyz","explanation":"琢：雕琢。形容女子妆饰白皙、漂亮或白色晶莹透亮的景观","source":{"text":"这时候，石洞的上下四周，全都堆满了积雪，粉装玉琢，成了名副其实的雪洞了。","book":"吴越《括苍山恩仇记》第38回"},"example":{"text":"叶圣陶《倪焕之》：“头抬起来时，～似的双颊泛上一阵红晕。”"},"similar":["粉妆玉砌","粉妆银砌"],"usage":"作谓语、补语、定语；用于白色景观"},{"id":35864,"word":"粉身灰骨","pinyin":"fěn shēn huī gǔ","abbr":"fshg","explanation":"身体粉碎而死。比喻为了某种目的或遭到什么危险而丧失生命。同“粉身碎骨”。","source":{"text":"玉馔珍奇，非常厚重，粉身灰骨，不能酬谢。","book":"唐·张鷟《游仙窟》"},"similar":["粉身碎骨","粉骨碎身"],"usage":"作谓语、定语、状语、宾语；用于人"},{"id":35865,"word":"粉身碎骨","pinyin":"fěn shēn suì gǔ","abbr":"fssg","explanation":"身体粉碎而死。比喻为了某种目的或遭到什么危险而丧失生命。","source":{"text":"平生志愿，今日获从，粉骨碎身，誓不相舍。","book":"三国·魏·曹植《谢封甄城王表》：“臣愚驽垢秽，才质疵下，过受陛下日月之恩，不能摧身碎首，以答陛下厚德。”唐·蒋防《霍小玉传》"},"example":{"text":"如果战争狂人胆敢轻举妄动，发动战争，结果必然会被压在大山底下，弄得～。","book":"杨朔《东风第一枝》"},"similar":["肝脑涂地","身首异处","杀身成仁"],"opposite":["完好无损"],"usage":"作谓语、定语、状语、宾语；用于人"},{"id":35866,"word":"粉面含春","pinyin":"fěn miàn hán chūn","abbr":"fmhc","explanation":"粉面：指女子的脸；含：饱含，充满；春：和颜悦色。女子面容含着春色。形容女子和蔼的面容。","source":{"text":"粉面含春威不露，丹唇未启笑先闻。","book":"清·曹雪芹《红楼梦》第三回"},"similar":["和颜悦色"],"usage":"作谓语、定语、状语；用于女性"},{"id":35867,"word":"粉面朱唇","pinyin":"fěn miàn zhū chún","abbr":"fmzc","explanation":"白面红唇。有时形容面颜姣美。","source":{"text":"说着，果然出去带进一个小后生来，较宝玉略瘦些，眉清目秀，粉面朱唇，身材俊俏，举止风流，似在宝玉之上。","book":"清·曹雪芹《红楼梦》第七回"},"example":{"text":"他（活无常）出来了，服饰比画上还简单，不拿铁索，也不带算盘，就是雪白的一条莽汉，～，眉黑如漆，蹇着，不知道是在笑还是在哭。","book":"鲁迅《朝花夕拾·无常》"},"usage":"作谓语、宾语、定语；多用于女性"},{"id":35868,"word":"粉面油头","pinyin":"fěn miàn yóu tóu","abbr":"fmyt","explanation":"脸上扑粉，头上抹油。形容女子的化妆。","source":{"text":"皓齿明眸，粉面油头，点花牌，行酒令。","book":"元·钟嗣成《骂玉郎过感恩采茶歌·四景》"},"example":{"text":"那里人都是长裙短袄，～，不分老少，尽是妇女。","book":"明·施耐庵《西游记》第五十四回"},"similar":["油头粉面"],"usage":"作定语；指人的化妆"},{"id":35869,"word":"粉饰场面","pinyin":"fěn shì chǎng miàn","abbr":"fscm","explanation":"粉饰：打扮，装饰。比喻只把外表装饰得很美观。","source":{"text":"在昆明的几位教授参政员，也多感觉到仅仅粉饰场面，实在没有意思。","book":"邹韬奋《抗战以来·第二届国民参政会的前夜》"},"similar":["粉饰门面"],"usage":"作谓语、宾语；用于做事"},{"id":35870,"word":"粉饰太平","pinyin":"fěn shì tài píng","abbr":"fstp","explanation":"粉饰：涂饰表面。把社会黑暗混乱的状况掩饰成太平的景象。","source":{"text":"岂有别生义理，曲加粉饰而能欺天下哉。","book":"宋·苏轼《再上皇帝书》"},"example":{"text":"有着～的职责的人们是可原谅的，因为他们也有理由麻木。","book":"闻一多《可怕的冷静》"},"similar":["弄虚作假"],"usage":"作谓语、定语；表示弄虚作假"},{"id":35871,"word":"粉饰门面","pinyin":"fěn shì mén miàn","abbr":"fsmm","explanation":"粉饰：打扮，装饰。比喻只把外表装饰得很美观。","source":{"text":"各级参议会、新县制等，都是粉饰门面的欺人摆设。","book":"周恩来《论中国的法西斯主义——新专制主义》"},"similar":["粉饰场面"],"usage":"作谓语、宾语、定语；用于做事"},{"id":35872,"word":"粉骨捐躯","pinyin":"fěn gǔ juān qū","abbr":"fgjq","explanation":"指粉身碎骨，献出生命。","source":{"text":"势当戮力尽瘁，粉骨捐躯，知无不为，见死宁避！","book":"唐·杜牧《又谢赐批答表》"},"example":{"text":"九鼎百朋，不足以喻其荣重矣。～，不敢忘报。","book":"明·张居正《四辞恩命疏》"},"similar":["粉骨糜躯","粉身碎骨"],"usage":"作谓语、宾语、定语；用于为了事业等"},{"id":35873,"word":"粉骨碎身","pinyin":"fěn gǔ suì shēn","abbr":"fgss","explanation":"指身躯粉碎，牺牲生命。","source":{"text":"兰孙道：‘相公、夫人正是重生父母，虽粉骨碎身，无可报答。’","book":"唐·蒋防《霍小玉传》：“平生志愿，今日获从，粉骨碎身，誓不相舍。”明·凌濛初《初刻拍案惊奇》卷二十"},"example":{"text":"俺不免乘此，到那厮跟前，痛骂一场，出了这口愤气。便～，也说不得了。","book":"清·洪昇《长生殿·骂贼》"},"similar":["粉身碎骨","粉身灰骨"],"usage":"作谓语、定语、状语、宾语；用于人"},{"id":35874,"word":"粉骨糜身","pinyin":"fěn gǔ mí shēn","abbr":"fgms","explanation":"犹言粉骨碎身。","source":{"text":"苟非木石，宁不自知？每誓粉骨糜身，以图报称。","book":"宋·岳飞《奏乞解军务札子》"},"similar":["粉身碎骨","粉骨糜躯"],"usage":"作谓语、宾语、定语；用于为了事业等"},{"id":35875,"word":"粉骨糜躯","pinyin":"fěn gǔ mí qū","abbr":"fgmq","explanation":"犹粉身碎骨。","source":{"text":"粉骨糜躯，罔知攸答。","book":"唐·王维《为薛使君谢婺州刺史表》：“臣纵粉骨糜躯，不报万分之一。”唐·颜真卿《谢户部侍郎表》"},"similar":["粉骨捐躯","粉身碎骨"],"usage":"作谓语、宾语、定语；用于为了事业等"},{"id":35876,"word":"粒米束薪","pinyin":"lì mǐ shù xīn","abbr":"lmsx","explanation":"极言粮草之少。","source":{"text":"粒米束薪家里无备，妻子只是怨怅啼哭。","book":"明·凌濛初《二刻拍案惊奇》卷二十四"},"usage":"作主语、宾语；指储备少"},{"id":35877,"word":"粒米狼戾","pinyin":"lì mǐ láng lì","abbr":"lmll","explanation":"谷粒撒得满地都是。形容粮食充盈。","source":{"text":"乐岁，粒米狼戾。","book":"先秦·孟轲《孟子·滕文公上》"},"example":{"text":"今岁再得一稔，想见～。","book":"《续资治通鉴·宋孝宗乾道八年》"},"usage":"作宾语；指粮食充盈"},{"id":35878,"word":"粗中有细","pinyin":"cū zhōng yǒu xì","abbr":"czyx","explanation":"形容人说话做事表面好像粗鲁、随便，实际上却是审慎、细心。","source":{"text":"沙僧听说，厉声道：‘好！好！好！正是粗中有细，果然急处从宽。’","book":"明·吴承恩《西游记》第五十五回"},"example":{"text":"《三国演义》中的张飞是一个～的大将。"},"opposite":["粗心大意"],"usage":"作谓语、定语；形容表面粗率，实际却很细致"},{"id":35879,"word":"粗俗之辈","pinyin":"cū sú zhī bèi","abbr":"cszb","explanation":"指庄稼人或佃农，现指缺乏文化教养、行为、意识粗野庸俗的人。","example":{"text":"别跟他这种～一般见识。"},"similar":["村夫俗子"],"opposite":["文人雅士"],"usage":"作宾语、定语；指没有文化的人"},{"id":35880,"word":"粗具梗概","pinyin":"cū jù gēng gài","abbr":"cjgg","explanation":"粗：粗略；具：具有；梗概：大概。粗略地具有一个大概。表示只是大体上有了轮廓，尚待精细加工。","source":{"text":"惟文笔则远不逮，词不达意，粗具梗概而已。","book":"鲁迅《中国小说史略》第十四篇"},"usage":"作谓语、定语；用于文章或事物等"},{"id":35881,"word":"粗制滥造","pinyin":"cū zhì làn zào","abbr":"czlz","explanation":"滥：过多，不加节制。写文章或做东西马虎草率，只求数量，不顾质量。","source":{"text":"如果并不以卖文为活，因此也无须‘粗制滥造’。","book":"鲁迅《花边文学·商贾的批评》"},"example":{"text":"所谓爱工，就是～，不管质量的恶劣。","book":"范文澜《中国通史》第二编第五章第二节"},"similar":["偷工减料","敷衍了事"],"opposite":["精雕细刻","细针密缕"],"usage":"作谓语、宾语、定语；用于工作等方面"},{"id":35882,"word":"粗声粗气","pinyin":"cū shēng cū qì","abbr":"cscq","explanation":"指人说话嗓门很粗。","source":{"text":"‘叫救护车叫救护车。’冯小刚粗声粗气地喊。","book":"王朔《你不是一个俗人》"},"example":{"text":"他～地对我说话。"},"similar":["粗声大气"],"usage":"作状语；用于人说话"},{"id":35883,"word":"粗心大意","pinyin":"cū xīn dà yì","abbr":"cxdy","explanation":"粗：粗蔬。指做事马虎，不细心。","source":{"text":"去尽皮方见肉，去尽肉方见骨，终骨方见髓，使粗心大气不得。","book":"宋·朱熹《朱子语类·学四》"},"example":{"text":"这是我～，我若不进去，他怎得出来？","book":"清·文康《儿女英雄传》第四回"},"similar":["粗枝大叶"],"opposite":["小心谨慎","小心翼翼"],"usage":"作谓语、宾语、定语；用于考虑事情或做事"},{"id":35884,"word":"粗心大气","pinyin":"cū xīn dà qì","abbr":"cxdq","explanation":"粗：粗疏；气：人的精神状态。指做事不细心，随便马虎。","source":{"text":"去尽皮方见肉，去尽肉方见骨，终骨方见髓，使粗心大气不得。","book":"宋·朱熹《朱子语类·读书法》"},"similar":["粗心大意"],"usage":"作谓语、宾语、定语；用于考虑事情或做事"},{"id":35885,"word":"粗心浮气","pinyin":"cū xīn fú qì","abbr":"cxfq","explanation":"浮：浮躁。形容人不细心，不沉着。","source":{"text":"学诗者不可忽略古人，亦不可附会古人。忽略古人，粗心浮气，仅猎古人皮毛。","book":"清·叶燮《原诗外篇》卷四"},"example":{"text":"《新光》中作者皆少年，往往～，傲然凌人，势所难免。","book":"鲁迅《书信集·致郑振铎》"},"similar":["心浮气躁","粗心大意"],"opposite":["小心谨慎","小心翼翼"],"usage":"作谓语、定语；形容办事急躁不细心"},{"id":35886,"word":"粗有眉目","pinyin":"cū yǒu méi mù","abbr":"cymm","explanation":"粗：略微；眉目：比喻事情的头绪或轮廓。事情大体上有了头绪。","source":{"text":"办理粗有眉目，即回京复命去了。","book":"蔡东藩、许廑父《民国通俗演义》第七十七回"},"usage":"作谓语、定语、状语；用于办事等"},{"id":35887,"word":"粗服乱头","pinyin":"cū fú luàn tóu","abbr":"cflt","explanation":"粗服：粗布衣服；乱头：蓬头乱发。形容不讲究修饰。","source":{"text":"裴令公有俊容仪，脱冠冕，粗服乱头皆好。时人以为玉人。","book":"南朝·宋·刘义庆《世说新语·容止》"},"example":{"text":"书极潦草，中有结法，时时得佳字，岂晋人所谓裴叔则～亦自好耶？（明·王士桢《题祝希哲小简》）"},"similar":["不修边幅"],"usage":"作谓语、定语；形容不加修饰"},{"id":35888,"word":"粗枝大叶","pinyin":"cū zhī dà yè","abbr":"czdy","explanation":"绘画，画树木粗枝大叶，不用工笔。比喻工作粗糙，不认真细致。","source":{"text":"《书序》恐不是孔安国做，汉文粗枝大叶，今《书序》细腻，只似六朝时文字。","book":"《朱子语类》卷七八"},"example":{"text":"这么细细给你说，三天三夜也说不完，还是～告诉你吧！","book":"赵树理《地板》"},"similar":["粗心大意"],"opposite":["精雕细刻","小心谨慎"],"usage":"作谓语、宾语、定语、状语；比喻作风草率"},{"id":35889,"word":"粗株大叶","pinyin":"cū zhū dà yè","abbr":"czdy","explanation":"粗：粗疏，粗略。原比喻简略或概括。现比喻工作粗糙，做事不认真细致。","source":{"text":"小景至四十外始拓为大幅，粗株大叶，草草而成。","book":"明·文征明《题沈石田临王叔明小景》"},"similar":["粗枝大叶"],"usage":"作谓语、宾语、定语、状语；比喻作风草率"},{"id":35890,"word":"粗粗笨笨","pinyin":"cū cū bèn bèn","abbr":"ccbb","explanation":"指物体笨重或人不灵巧。","source":{"text":"登云虽然表面上看来粗粗笨笨，但这人有心计，办事能下手！","book":"路遥《平凡的世界》第二卷第39章"},"opposite":["小巧玲珑"],"usage":"作谓语、定语、状语；用于口语"},{"id":35891,"word":"粗茶淡饭","pinyin":"cū chá dàn fàn","abbr":"ccdf","explanation":"粗：粗糙、简单；淡饭：指饭菜简单。形容饮食简单，生活简朴。","source":{"text":"粗茶淡饭饱即休，补破遮寒暖即休，三平二满过即休，不贪不妒老即休。","book":"宋·黄庭坚《四休导士诗序》"},"example":{"text":"连顿～也吃不饱。","book":"清·李宝嘉《官场现形记》第三十四回"},"similar":["家常便饭","粗衣粝食"],"opposite":["山珍海味"],"usage":"作主语、谓语、宾语；形容饭食简单生活清苦"},{"id":35892,"word":"粗衣恶食","pinyin":"cū yī è shí","abbr":"cyes","explanation":"粗劣的衣食。形容生活俭朴。","source":{"text":"虽在军旅，常粗衣恶食，俭以率下。","book":"《三国志·魏志·司马朗传》"},"example":{"text":"夫人在狱中，～，所有金钱，尽敬诸贫囚。","book":"清·梁启超《罗兰夫人传》"},"similar":["粗衣淡饭","粗衣粝食"],"opposite":["锦衣玉食"],"usage":"作定语、宾语；指生活艰苦"},{"id":35893,"word":"粗衣淡饭","pinyin":"cū yī dàn fàn","abbr":"cydf","explanation":"粗：粗糙、简单；淡饭：指饭菜简单。形容饮食简单，生活简朴。","source":{"text":"粗茶淡饭饱即休，补破遮寒暖即休，三平二满过即休，不贪不妒老即休。","book":"宋·黄庭坚《四休导士诗序》"},"example":{"text":"似这等～且淹消，任天公饶不饶。","book":"元·范子安《竹叶舟》第四折"},"similar":["粗茶淡饭"],"opposite":["锦衣玉食"],"usage":"作宾语、定语；指生活简朴"},{"id":35894,"word":"粗衣粝食","pinyin":"cū yī lì shí","abbr":"cyls","explanation":"粝：粗米。穿粗布衣，吃粗米饭。形容生活水平很低。也指不追求生活享受。","source":{"text":"粗衣遮寒，粝食活命。","book":"宋·释普济《五灯会元》卷三"},"example":{"text":"～，三十年如一日。","book":"清·叶廷绾《鸥陂渔话·侯忠节公父子为僮宾作书》"},"similar":["粗茶淡饭","粗衣恶食"],"opposite":["锦衣玉食","山珍海味"],"usage":"作谓语、定语、宾语；形容生活清苦"},{"id":35895,"word":"粗袍粝食","pinyin":"cū páo lì shí","abbr":"cpls","explanation":"粗劣的衣食。形容生活俭朴。","source":{"text":"[袁彭]行至清，为吏粗袍粝食，终于议郎。","book":"《后汉书·袁京传》"},"similar":["粗衣粝食","粗衣恶食"],"opposite":["锦衣玉食"],"usage":"作定语、宾语；形容生活清苦"},{"id":35896,"word":"粗通文墨","pinyin":"cū tōng wén mò","abbr":"ctwm","explanation":"粗：略微；通：通晓。文墨：指写文章。稍微懂得一些写作方面的学问。","source":{"text":"有一少年，姓王名臣，长安人氏，略知书史，粗通文墨。","book":"明·冯梦龙《醒世恒言》第六卷"},"opposite":["倚马可待","学富五车"],"usage":"作谓语、定语；用于人的文化水平"},{"id":35897,"word":"粗风暴雨","pinyin":"cū fēng bào yǔ","abbr":"cfby","explanation":"指风雨之来势急骤狂猛。","source":{"text":"莫讲粗风暴雨，不能招架，就是小小一阵凉飕，只怕也难支持了。","book":"清·李汝珍《镜花缘》第88回"},"example":{"text":"刚才还是清风明月，眨眼之间就是一个殛雷，顿时闹起～来。","book":"梁斌《播火记》"},"similar":["暴风骤雨"],"usage":"作主语、宾语、定语；指大风雨"},{"id":35898,"word":"粘吝缴绕","pinyin":"nián lìn jiǎo rào","abbr":"zljr","explanation":"粘：粘贴，胶合；吝：贪；缴绕：烦琐。形容下棋一味贪子纠缠，烦琐不堪。","source":{"text":"善棋者，觉一处少屈，则经营他处，率以取胜；不善棋者，黏吝缴绕，不肯暂舍，率以取败。","book":"宋·李纲《与吕安老书》"},"similar":["黏吝缴绕"],"usage":"作谓语、定语；用于下棋等"},{"id":35899,"word":"粘皮带骨","pinyin":"zhān pí dài gǔ","abbr":"zpdg","explanation":"形容言行不干脆，不爽快。","source":{"text":"比来更知所作韵俗，下笔不浏漓，如禅家粘皮带骨语，因此不复作。","book":"宋·黄庭坚《钟离跋尾》"},"example":{"text":"我是一刀两断的性子，不学那～。","book":"明·冯梦龙《警世通言》卷十一"},"similar":["粘皮著骨"],"opposite":["干脆利落"],"usage":"作宾语、定语；指人办事刻板"},{"id":35900,"word":"粘皮着骨","pinyin":"nián pí zhuó gǔ","abbr":"zpzg","explanation":"粘：粘贴。比喻人固执呆板。","source":{"text":"此理本常理，但异端说得粘皮着骨。","book":"宋·罗大经《鹤林玉露》第十卷"},"similar":["粘皮著骨","粘皮带骨"],"usage":"作宾语、定语、状语；指人办事刻板"},{"id":35901,"word":"粘皮著骨","pinyin":"zhān pí zhuó gǔ","abbr":"zpzg","explanation":"粘：粘贴，胶合。形容言行办事不干脆爽利，执着刻板。","source":{"text":"其深浅在人，不必恁地粘皮著骨去说。","book":"宋·朱熹《朱子全书》第18卷"},"similar":["粘皮带骨","粘皮着骨"],"usage":"作宾语、定语、状语；指人办事刻板"},{"id":35902,"word":"粘花惹絮","pinyin":"nián huā rě xù","abbr":"zhrx","explanation":"粘：粘贴；惹：招引，挑逗。指男女间的挑逗引诱，淫乱。","source":{"text":"人前巧做出猜嫌计，正好粘花惹絮。","book":"明·胡文焕《群音类选·》"},"similar":["粘花惹草"],"usage":"作谓语、定语、宾语；指男子勾引女子"},{"id":35903,"word":"粘花惹草","pinyin":"zhān huā rě cǎo","abbr":"zhrc","explanation":"惹：招惹；草、花：比喻好。比喻到处留情，多指男女间的挑逗引诱。","source":{"text":"粘花惹草心，招揽风流事。","book":"元·商衜《一枝花·远寄》"},"similar":["拈花惹草"],"usage":"作谓语、定语、宾语；指男子勾引女子"},{"id":35904,"word":"粜风卖雨","pinyin":"tiào fēng mài yǔ","abbr":"tfmy","explanation":"比喻招摇撞骗。","source":{"text":"这杨大郎名唤杨光彦，绰号铁指甲，专一粜风卖雨，架谎凿空。","book":"明·兰陵笑笑生《金瓶梅词话》第九十二回"},"usage":"作谓语；指作事虚假"},{"id":35905,"word":"粝粢之食","pinyin":"lì zī zhī shí","abbr":"lzzs","explanation":"粝：粗米；粢：稻饼。粗糙的饭食。","source":{"text":"尧之王天下也，茅茨不翦，彩椽不斫，粝粢之食，藜藿之羹，冬日麑裘，夏日葛衣。","book":"《韩非子·五蠹》"}},{"id":35906,"word":"粝食粗衣","pinyin":"lì shí cū yī","abbr":"lscy","explanation":"粝：粗米。粗布衣服，粗劣的食品。比喻生活清苦。","source":{"text":"奴供备粝食粗衣。","book":"宋·无名氏《张协状元·大公资助张协》"},"example":{"text":"不耻蓬首垢面，不嫌～。","book":"元·马钰《西江月》"},"similar":["粗衣粝食"],"opposite":["锦衣玉食"],"usage":"作宾语、定语；指生活贫困"},{"id":35907,"word":"粝食粗餐","pinyin":"lì shí cū cān","abbr":"lscc","explanation":"粝：粗米；餐：饭食。指食物粗糙。","source":{"text":"常著大布缊袍，粝食粗餐。","book":"《东观汉记·桓鸾传》"},"similar":["粗茶淡饭"],"opposite":["山珍海味"],"usage":"作宾语、定语；用于人的饮食"},{"id":35908,"word":"粟红贯朽","pinyin":"sù hóng guàn xiǔ","abbr":"shgx","explanation":"粟：小米；红：指腐烂变质；贯：穿线的绳子；朽：腐烂。谷子变色了，钱串子损坏了。形容太平时期富饶的情况。","source":{"text":"太仓之粟，红腐而不可食；都内之钱，贯朽而不可校。","book":"东汉·班固《汉书·贾捐之传》"},"example":{"text":"膏梁素封，～，问以十字，不识八九。","book":"清·褚人获《坚瓠十集·反乞巧文》"},"similar":["粟陈贯朽"],"usage":"作定语；指十分富足"},{"id":35909,"word":"粟陈贯朽","pinyin":"sù chén guàn xiǔ","abbr":"scgx","explanation":"形容太平时期富饶的情况。同“粟红贯朽”。","source":{"text":"你如今万廪千仓，粟陈贯朽，每日劳劳碌碌，使尽机谋，如今半百之秋，又无男女，还不修善，更待何时？","book":"明·范受益《寻亲记·告借》"},"similar":["粟红贯朽"],"usage":"作定语；指十分富足"},{"id":35910,"word":"粤犬吠雪","pinyin":"yuè quǎn fèi xuě","abbr":"yqfx","explanation":"粤：广东的简称。广东很少下雪，狗看见下雪就叫。比喻少见多怪。","source":{"text":"前六七年，仆来南，二年冬，幸大雪逾岭被南越中数州。数州之犬皆苑黄吠噬狂走者累日，至无雪乃已。","book":"唐·柳宗元《答韦中立论师道书》"},"example":{"text":"～非差事，粤人语冰夏虫似。","book":"宋·杨万里《荔枝歌》"},"similar":["蜀犬吠日","少见多怪"],"usage":"作宾语、定语；指少见多怪"},{"id":35911,"word":"粤若稽古","pinyin":"yuè ruò jī gǔ","abbr":"yrjg","explanation":"粤：助词，与“曰”通：顺；稽：考。顺考古代之道理。","source":{"text":"若，顺；稽，考也。能顺考古道而行之者帝尧。","book":"《尚书·尧典》：“曰若稽古帝尧。”孔安国传"},"example":{"text":"～，崇德象贤，统承先王，修其礼物。（唐·杨炯《酅国公墓志铭》）"}},{"id":35912,"word":"粥少僧多","pinyin":"zhōu shǎo sēng duō","abbr":"zssd","explanation":"比喻东西少而人多，不够分配。","source":{"text":"小学教员比较是刻苦一点，可是各地因为粥少僧多，常常为争夺饭碗而闹得乌烟瘴气。","book":"邹韬奋《学校与商场》引星翁文"},"example":{"text":"～，向隅者自然在所难免。","book":"聂绀弩《莎士比亚应该后悔》"},"similar":["僧多粥少"],"usage":"作宾语、定语；指不够分配"},{"id":35913,"word":"粥粥无能","pinyin":"zhōu zhōu wú néng","abbr":"zzwn","explanation":"粥粥：柔弱无能的样子。形容谦卑、柔弱而没有能力。","source":{"text":"其难进而易退也，粥粥若无能也。","book":"《礼记·儒行》"},"example":{"text":"自服官日，取汉唐以来代不数见之人以自律，故自视若～者。","book":"清·方苞《尹元孚墓志铭》"},"similar":["碌碌无为"],"usage":"作谓语、定语；指无能的人"},{"id":35914,"word":"粪土不如","pinyin":"fèn tú bù rú","abbr":"ftbr","explanation":"还比不上粪便和泥土。形容极无价值的东西。","source":{"text":"偏生要把前妻男女，百般凌虐，粪土不如。","book":"明·冯梦龙《醒世恒言》第27卷"},"example":{"text":"他的这种行为真是～。"},"similar":["猪狗不如"],"usage":"作谓语、定语；形容毫无价值的东西"},{"id":35915,"word":"粪土之墙不可杇","pinyin":"fèn tú zhī qiáng bù kě wū","abbr":"ftzqbkw","explanation":"粪土：秽土；杇：指粉刷。用秽土筑成的墙壁难以粉刷好。比喻很难教养。","source":{"text":"朽木不可雕也，粪土之墙不可杇也，于予与何诛。","book":"《论语·公冶长》"},"example":{"text":"斗筲之器成何用，～。","book":"元·王氏《寄情人》"}},{"id":35916,"word":"粪堆上长灵芝","pinyin":"fèn duī shàng zhǎng líng zhī","abbr":"fdszlz","explanation":"灵芝：菌类植物，古人以为吃了可以长生。比喻在卑下的环境中产生出高贵的东西。","source":{"text":"敢则是鸦窝里出凤凰，粪堆上长灵芝，这言语信有之。","book":"元·杨文奎《儿女团圆》第四折"},"usage":"作宾语、定语；多用于比喻句"},{"id":35917,"word":"粮多草广","pinyin":"liáng duō cǎo guǎng","abbr":"ldcg","explanation":"比喻战备物资充足。","source":{"text":"俺这蒲州，地方宽阔，粮多草广，军民好汉，我何不起兵播乱。","book":"明·无名氏《桃园结义》第一折"},"usage":"作谓语、定语；指战备物资充足"},{"id":35918,"word":"粮尽援绝","pinyin":"liáng jìn yuán jué","abbr":"ljyj","explanation":"粮食用尽，援兵断绝。比喻战斗处于十分艰难的境地。","source":{"text":"时冠军将军陈祐守洛阳，众不过二千，劲自表求配祐效力，因以劲补冠军长史，令自募壮士，得千余人，以助祐击贼，频以寡制众。而粮尽援绝，祐惧不能保全。","book":"《晋书·沈劲传》"},"example":{"text":"一旦拖延时日，我军～，而敌人却会人马愈战愈多。","book":"姚雪垠《李自成》第二卷第四十三章"},"similar":["弹尽粮绝"],"opposite":["粮多草广"],"usage":"作宾语、定语；指十分艰难的境地"},{"id":35919,"word":"粲然可观","pinyin":"càn rán kě guān","abbr":"crkg","explanation":"粲然：鲜明的样子。形容事物色彩鲜明。指成绩卓著，达到很高的水平。","source":{"text":"表古雅之道，粲然可观。","book":"南朝·梁·萧统《〈文选〉序》"},"example":{"text":"作壁上观是编在，则开国之政治，必～。","book":"清·朱彝尊《书传会选跋》"},"usage":"作谓语、定语；指人的成绩卓著"},{"id":35920,"word":"粲花之舌","pinyin":"càn huā zhī shé","abbr":"chzs","explanation":"粲花：鲜艳的花朵。形容人的言论精妙绝伦。","source":{"text":"此自师粲花之舌耳。然默验人情，实亦为理之所有。","book":"清·纪昀《阅微草堂笔记》第七卷"},"similar":["粲花之论"],"usage":"作宾语；用于人的言论"},{"id":35921,"word":"粲花之论","pinyin":"càn huā zhī lùn","abbr":"chzl","explanation":"粲花：鲜艳的花朵；论：言论。称赞言论的典雅隽妙。","source":{"text":"每与人谈论，皆成句读，如春葩丽藻，粲于齿牙之下，时人号曰：‘李白粲花之论。’","book":"五代后周·王仁裕《开元天宝遗事·粲花之论》"},"example":{"text":"此自师粲花之舌耳。然默验人情，实亦为理之所有。","book":"清·纪昀《阅微草堂笔记》卷七"},"similar":["粲花之舌"],"opposite":["荒缪之言"],"usage":"作宾语；指人的言论"},{"id":35922,"word":"精义入神","pinyin":"jīng yì rù shén","abbr":"jyrs","explanation":"精研事物的微义，达到神妙的境地。","source":{"text":"精义入神，以致用也。","book":"《易·系辞下》"},"example":{"text":"～，事豫吾内，求利吾外也。","book":"宋·张载《正蒙·神化》"},"usage":"作谓语、定语；指人的学习"},{"id":35923,"word":"精兵勇将","pinyin":"jīng bīng yǒng jiàng","abbr":"jbyj","explanation":"精良的士兵，勇猛的将领。形容战斗力很强的将士。","source":{"text":"现受汝宁郡都统制，手下多有精兵勇将。","book":"明·施耐庵《水浒传》第54回"},"similar":["精兵强将"],"usage":"作主语、宾语、定语；用于口语"},{"id":35924,"word":"精兵强将","pinyin":"jīng bīng qiáng jiàng","abbr":"jbqj","explanation":"精良的士兵，勇猛的将领。形容战斗力很强的将士。","source":{"text":"使君若顾二帝，自可不行，宜急下檄文，速遣精兵猛将。","book":"《晋书·郗鉴传》"},"similar":["精兵勇将"],"usage":"作主语、宾语、定语；用于口语"},{"id":35925,"word":"精兵猛将","pinyin":"jīng bīng měng jiàng","abbr":"jbmj","explanation":"精：精锐；猛：勇猛。精良的士兵，勇猛的将领。形容战斗力很强的将士。","source":{"text":"使君若顾二帝，自可不行，宜急下檄文，速遣精兵猛将。","book":"《晋书·郗鉴传》"},"example":{"text":"今闻刘备亲自领兵来取汉中，可速奏魏王，早发～，前来策应。","book":"明·罗贯中《三国演义》第七十一回"},"similar":["精兵强将"],"usage":"作主语、宾语、定语；指战斗力很强"},{"id":35926,"word":"精兵简政","pinyin":"jīng bīng jiǎn zhèng","abbr":"jbjz","explanation":"精减人员，缩减机构。","source":{"text":"徐陵为吏部尚史，精简人物。","book":"《南史·陈暄传》"},"example":{"text":"只要肯认真抗战，这种～，分头并进，倒也似乎更要合理些了。","book":"郭沫若《洪波曲》第十四章"},"similar":["精打细算","缩衣节食"],"opposite":["叠床架屋","尾大不掉"],"usage":"作主语、宾语、定语；指精减人员，缩减机构"},{"id":35927,"word":"精力充沛","pinyin":"jīng lì chōng pèi","abbr":"jlcp","explanation":"体力强盛，精神充足。","source":{"text":"让年轻一些的同志多做工作，他们精力充沛，比我做得更好。","book":"邓小平《在中央顾问委员会第三次全体会议上的讲话》"},"example":{"text":"他始终都是～、斗志昂扬。"},"similar":["精力旺盛"],"opposite":["精疲力竭"],"usage":"作谓语、定语；指体力强盛，精神充足"},{"id":35928,"word":"精力过人","pinyin":"jīng lì guò rén","abbr":"jlgr","explanation":"精力旺盛，超过一般人。","source":{"text":"你世农夫，至衡好学，庸作以供资用，精力尤过绝人。","book":"《汉书·匡衡传》"},"example":{"text":"不过他～，一大早起身，接见属员以后，总是到各处营伍去看操。","book":"高阳《母子君臣》九十一"}},{"id":35929,"word":"精卫填海","pinyin":"jīng wèi tián hǎi","abbr":"jwth","explanation":"精卫：古代神话中的鸟名。精卫衔来木石，决心填平大海。旧时比喻仇恨极深，立志报复。后比喻意志坚决，不畏艰难。","source":{"text":"炎帝之少女名曰女娃。女娃游于东海，溺而不返，故为精卫，常衔西山之木石，以堙于东海。","book":"《山海经·北山经》"},"example":{"text":"宾南如～，每不自量。","book":"清·阮葵生《茶余客话》卷十"},"similar":["矢志不移","愚公移山","移山倒海"],"usage":"作宾语、定语；比喻意志坚决","story":["神话传说，上古时期炎帝最疼爱的小女儿女娃在东海游泳被水淹死，她的灵魂于是化成一只作精卫鸟，经常飞到西山去叼小石头和小树枝扔进东海，发誓要填平东海为自己报仇，她就这样一直飞来飞去，但最终也没有将东海填平"]},{"id":35930,"word":"精奇古怪","pinyin":"jīng qí gǔ guài","abbr":"jqgg","explanation":"形容十分奇特，不同一般。","source":{"text":"精奇古怪事堪观，编撰于中美。","book":"元·无名氏《张协状元》第二出"},"example":{"text":"你～虚头弄。","book":"明·汤显祖《还魂记·硬拷》"},"similar":["稀奇古怪"],"usage":"作谓语、定语；指奇特"},{"id":35931,"word":"精妙入神","pinyin":"jīng miào rù shén","abbr":"jmrs","explanation":"精彩绝妙，出神入化。","source":{"text":"埽素写《道经》，笔精妙入神。","book":"宋·吴曾《能改斋漫录·黄庭博鹅》"},"example":{"text":"且其艺～，不难邀知遇于君上，致感动于神仙，使其身所遭逢之事，传为千秋佳话。","book":"清·褚人获《隋唐演义》第九回"},"usage":"作谓语、定语；用于事物等"},{"id":35932,"word":"精妙绝伦","pinyin":"jīng miào jué lún","abbr":"jmjl","explanation":"精：精巧。绝伦：无与伦比。精巧美妙到了极点。","source":{"text":"灯只至多，苏福为冠，新安晚出，精妙绝伦。","book":"宋·周密《武林旧事·灯品》"},"example":{"text":"他的手工作品真是～。"},"similar":["精妙入神","精美绝伦"],"opposite":["粗制滥造"],"usage":"作谓语、定语；同“精美绝伦”"},{"id":35933,"word":"精强力壮","pinyin":"jīng qiáng lì zhuàng","abbr":"jqlz","explanation":"精力充沛。","example":{"text":"～的战士们个个都是比武能手。"},"similar":["年轻力壮"],"usage":"作谓语、定语、状语；指人的精神"},{"id":35934,"word":"精彩逼人","pinyin":"jīng cǎi bī rén","abbr":"jcbr","explanation":"形容人神采奕奕或文章言语精彩感人。","source":{"text":"君精彩逼人，虽老而健。","book":"宋·洪迈《夷坚丙志·徐大夫》"},"example":{"text":"他的《唐诗杂论》虽然只有五篇，但都是～之作。","book":"朱自清《中国学术的大损失》"},"similar":["神采奕奕"],"usage":"作谓语、定语；用于文章及言语等"},{"id":35935,"word":"精心励志","pinyin":"jīng xīn lì zhì","abbr":"jxlz","explanation":"磨炼意志，使心意纯正专一。","source":{"text":"此时若能精心励志，尚可救其一二焉。","book":"宋·张君房《云笈七签》卷五十九"},"usage":"作谓语、定语；用于书面语"},{"id":35936,"word":"精忠报国","pinyin":"jīng zhōng bào guó","abbr":"jzbg","explanation":"为国家竭尽忠诚，牺牲一切。","source":{"text":"初命何铸鞫之，飞裂裳以背示铸，有‘尽忠报国’四大字，深入肤理。","book":"《北史·颜之仪传》：“公等备受朝恩，当尽忠报国。”《宋史·岳飞传》"},"example":{"text":"我今日祝告天地祖宗，要在你背上刺下“～”四字。","book":"清·钱彩《说岳全传》第二十二回"},"similar":["尽忠报国"],"opposite":["卖国求荣"],"usage":"作谓语、定语；形容非常爱国","story":["北宋末年，女真族建立大金国，直接威胁北宋的生存。岳飞的母亲在岳飞的背上刻下“精忠报国”四个大字，送19岁的岳飞从军。岳飞在抗金19年战斗中，打了许许多多胜仗，让金兵闻风丧胆。北宋灭亡后，他继续坚持抗金直到被害"]},{"id":35937,"word":"精悍短小","pinyin":"jīng hàn duǎn xiǎo","abbr":"jhdx","explanation":"悍：勇敢。形容人身材短小而精明强干。也形容文章、言论等简短有力。","source":{"text":"淳熙间，以勇名于军，精悍短小，盖骁将也。","book":"宋·叶绍翁《四朝闻见录·毕再遇》"},"similar":["短小精悍","短小精干"],"usage":"作谓语、定语；用于人或文章等"},{"id":35938,"word":"精意覃思","pinyin":"jīng yì tán sī","abbr":"jyts","explanation":"覃思：深思。精心研究，深入思考。","source":{"text":"善属文，举笔便成，无所改定，时人常以为宿构；然正复精意覃思，亦不能加也。","book":"《三国志·魏志·王粲传》"}},{"id":35939,"word":"精打细算","pinyin":"jīng dǎ xì suàn","abbr":"jdxs","explanation":"打：规划。精密地计划，详细地计算。指在使用人力物力时计算得很精细。","source":{"text":"教给他们记帐，看看钱都花在哪里，教给他们精打细算。","book":"冰心《咱们的五个孩子》"},"example":{"text":"我们要学会～、勤俭持家。"},"similar":["克勤克俭","一丝不苟"],"opposite":["大手大脚","粗心大意"],"usage":"作谓语、宾语、定语；指会持家"},{"id":35940,"word":"精明强干","pinyin":"jīng míng qiáng gàn","abbr":"jmqg","explanation":"机灵聪明，办事能力强。","source":{"text":"弁通学术，吏事精明，承延龄后，平赋缓役，略烦苛，人赖其宽。","book":"《新唐书·苏弁传》"},"example":{"text":"承辉这个人，甚是～。","book":"清·吴趼人《二十年目睹之怪现状》第一百六回"},"similar":["精明干练"],"opposite":["碌碌无为"],"usage":"作谓语、宾语、定语；指办事能力强","story":["清朝时期，捻军起义，百姓因不堪忍受清政府的重压和盘剥，纷纷响应，清政府调集僧格林沁、袁甲三、毛昶熙等率军镇压。毛昶熙认为捻军起义是官逼民反，官员只顾搜刮民脂民膏，百姓苦不堪言，应该选拔一些精明强干、爱民如子的官员"]},{"id":35941,"word":"精明能干","pinyin":"jīng míng néng gàn","abbr":"jmng","explanation":"机灵聪明，办事能力强。","source":{"text":"弁通学术，吏事精明，承延龄后，平赋缓役，略烦苛，人赖其宽。","book":"《新唐书·苏弁传》"},"example":{"text":"吴为成的脸方上透露着～的神气。","book":"茅盾《子夜》十"},"similar":["精明强干"],"usage":"作谓语、宾语、定语；指人办事能力强"},{"id":35942,"word":"精疲力倦","pinyin":"jīng pí lì juàn","abbr":"jplj","explanation":"倦：疲倦，劳累。犹言精疲力尽。","source":{"text":"湍制台被他闹的早已精疲力倦。一回想到九姨太脾气不好，不免恨骂两声；一回又想到他俩恩情，不免又私自一人落泪。","book":"清·李宝嘉《官场现形记》第三十六回"}},{"id":35943,"word":"精疲力尽","pinyin":"jīng pí lì jìn","abbr":"jplj","explanation":"疲：疲倦，劳累。精神疲惫，力气用尽。形容精神和身体极度疲劳","source":{"text":"我已筋疲力尽，不能行动。","book":"明·冯梦龙《醒世恒言》第21卷"},"example":{"text":"瞿秋白《饿乡纪程》：“走得～，想找一辆马车，也找不着。”"},"similar":["精疲力竭","筋疲力尽"],"opposite":["精神抖擞","精力充沛"],"usage":"作谓语、宾语、定语；形容精神和身体疲惫","story":["宋高宗时宰相李纲对国家赤胆忠心，一贯主张抗金，反对抗金割地求和，当了70天的宰相就被贬，在金兵围困时，他亲自指挥作战。他的《病牛》诗感慨自己：“耕犁千亩实千箱，力尽筋疲谁复伤？但得众生皆得饱，不辞羸病卧残阳。”"]},{"id":35944,"word":"精疲力竭","pinyin":"jīng pí lì jié","abbr":"jplj","explanation":"竭：尽。精神、力气消耗已尽。形容非常疲劳。","source":{"text":"筋疲力弊不入腹，未议县官租税促。","book":"宋·司马光《司马温公文集·卷二·道傍田家》诗"},"example":{"text":"他～地倒在沙发靠背上，一口一口地喘着气。","book":"巴金《秋》十四"},"similar":["筋疲力尽","精疲力尽"],"opposite":["精神抖擞"],"usage":"作定语、状语；指体力消耗已尽"},{"id":35945,"word":"精白之心","pinyin":"jīng bái zhī xīn","abbr":"jbzx","explanation":"精白：精纯洁白。指纯洁的心。","source":{"text":"二公怀精白之心，行忠正之道。","book":"汉·桓谭《盐铁论·讼贤》"},"example":{"text":"傅恒到此，奉赐招抚大任，必以～上对圣主、下临三军。","book":"二月河《乾隆皇帝》十二"},"usage":"作主语、宾语；指纯洁的心"},{"id":35946,"word":"精益求精","pinyin":"jīng yì qiú jīng","abbr":"jyqj","explanation":"精：完美，好；益：更加。好了还求更好。","source":{"text":"言治骨角者，既切之而复磋之；治玉石者，既琢之而复磨之，治之已精，而益求其精也。","book":"《论语·学而》：“《诗》云：‘如切如磋，如琢如磨。’其斯之谓与？”宋·朱熹注"},"example":{"text":"白求恩同志是个医生，他以医疗为职业，对技术～；在整个八路军医务系统中，他的医术是很高明的。","book":"毛泽东《纪念白求恩》"},"similar":["锦上添花"],"opposite":["粗制滥造","得过且过","因陋就简"],"usage":"作谓语、定语；指要求更加好"},{"id":35947,"word":"精神恍忽","pinyin":"jīng shén huǎng hū","abbr":"jshh","explanation":"精神：心神；恍忽：神志不清。形容心神不定，神志模糊。","source":{"text":"精神恍忽，若有所喜。","book":"战国·楚·宋玉《神女赋》"},"similar":["精神恍惚"],"usage":"作谓语、定语；形容精神不集中"},{"id":35948,"word":"精神恍惚","pinyin":"jīng shén huǎng hū","abbr":"jshh","explanation":"恍忽：糊里糊涂的样子。形容神思不定或神志不清。","source":{"text":"精神怳忽，若有所喜。","book":"战国·楚·宋玉《神女赋〉》"},"example":{"text":"在大姐失踪之后，我～。领导上这时又要我写个大姐的简历，要进行追功。","book":"茹志鹃《高高的白杨树》"},"similar":["神魂颠倒"],"opposite":["精神焕发"],"usage":"作谓语；形容精神不集中"},{"id":35949,"word":"精神抖擞","pinyin":"jīng shén dǒu sǒu","abbr":"jsds","explanation":"抖擞：振动，引伸为振作。形容精神振奋。","source":{"text":"（僧）问：‘光吞万象从师道，心月孤圆意若何？’师曰：‘抖擞精神着。’","book":"宋·释道原《景德传灯录·杭州光庆寺遇安禅师》"},"example":{"text":"我则见玳筵前摆列着英雄辈，一个个～。","book":"元·无名氏《隔江斗智》第二折"},"similar":["容光焕发","生龙活虎"],"opposite":["委靡不振","意志消沉"],"usage":"作谓语、定语、状语；指人的精神"},{"id":35950,"word":"精神涣散","pinyin":"jīng shén huàn sàn","abbr":"jshs","explanation":"精神：神志，心神；涣散：分散，散漫。形容精神分散不集中。","source":{"text":"精神涣散，离其躬身。","book":"汉·焦延寿《易林》第14卷"},"example":{"text":"他最近～，没有生气。"},"opposite":["聚精会神"],"usage":"作谓语、宾语；指精神不集中"},{"id":35951,"word":"精神满腹","pinyin":"jīng shén mǎn fù","abbr":"jsmf","explanation":"形容富有才智，满腹经纶。","source":{"text":"深结钱凤，为之声誉；每曰：‘钱世仪精神满腹。’峤素有知人之称，凤闻而悦之。","book":"《晋书·温峤传》"},"example":{"text":"博通书传，尤精《左氏》及地理学。为人有干局，心所到则绝人远甚。故时人称其～。","book":"《金史·李献甫传》"},"similar":["满腹经纶"],"usage":"作谓语、定语；形容富有才智"},{"id":35952,"word":"精神焕发","pinyin":"jīng shén huàn fā","abbr":"jshf","explanation":"焕发：光彩四射的样子。形容精神振作，情绪饱满。","source":{"text":"生觉丹田火热，精神焕发。","book":"清·蒲松龄《聊斋志异·莲香》"},"example":{"text":"在故乡，我到处都可以看到那种久经战争锻炼的、在任何时候都是～斗志昂扬勇往直前的人们。","book":"峻青《故乡杂记》"},"similar":["容光焕发"],"opposite":["没精打采","委靡不振"],"usage":"作谓语、定语、状语；指人的精神"},{"id":35953,"word":"精神百倍","pinyin":"jīng shén bǎi bèi","abbr":"jsbb","explanation":"形容特别有精神。","source":{"text":"想罢，取下玉牌，把朱草从根折断，齐放掌中，连揉带搓，果然玉已成泥，其色甚红。随即放人口内，只觉芳馨透脑。方才吃完，陡然精神百倍。","book":"清·李汝珍《镜花缘》第九回"},"example":{"text":"午觉醒来，～，于是学说也就压倒了涛声了。","book":"《鲁迅选集·理水》"}},{"id":35954,"word":"精禽填海","pinyin":"jīng qín tián hǎi","abbr":"jqth","explanation":"精禽：传说炎帝的女儿在东海淹死，灵魂化作精卫鸟，常衔西山木石填东海。比喻意志坚决，不畏艰难。","source":{"text":"精禽填海，斥鷃笑其大愚；杜宇啼枝，行人闻而堕泪。","book":"梁启超《新罗马》楔子"},"example":{"text":"～感沉冤，六月霜飞鉴水昏。","book":"柳亚子《巢南初度将及》"},"similar":["精卫填海"],"usage":"作宾语、定语；比喻意志坚决","story":["神话传说，上古时期炎帝最疼爱的小女儿女娃在东海游泳被水淹死，她的灵魂于是化成一只作精卫鸟，经常飞到西山去叼小石头和小树枝扔进东海，发誓要填平东海为自己报仇，她就这样一直飞来飞去，但最终也没有将东海填平"]},{"id":35955,"word":"精细入微","pinyin":"jīng xì rù wēi","abbr":"jxrw","explanation":"考虑问题十分仔细，注意到很小的细节。","example":{"text":"他考虑问题～。"},"similar":["无微不至"],"opposite":["粗心大意"],"usage":"作谓语、定语、状语；指注意到小的细节"},{"id":35956,"word":"精美绝伦","pinyin":"jīng měi jué lún","abbr":"jmjl","explanation":"绝伦：没有比得上的。精致美妙，无与伦比。","source":{"text":"灯只至多，苏、福为冠，新安晚出，精妙绝伦。","book":"宋·周密《武林旧事·灯品》"},"example":{"text":"少数民族的手工艺品真是～。"},"similar":["精妙绝伦","精妙入神"],"opposite":["粗制滥造"],"usage":"作谓语、定语；指精致美妙"},{"id":35957,"word":"精耕细作","pinyin":"jīng gēng xì zuò","abbr":"jgxz","explanation":"指农业上认真细致地耕作。","source":{"text":"我们靠精耕细作吃饭，人多一点，还是有饭吃。","book":"毛泽东《做革命的促进派》"},"example":{"text":"我们要～才能有收获。"},"opposite":["粗制滥造"],"usage":"作谓语、定语、宾语；指耕种或做工作"},{"id":35958,"word":"精诚团结","pinyin":"jīng chéng tuán jié","abbr":"jctj","explanation":"精诚：真诚。一心一意，团结一致。","source":{"text":"真者，精诚之至也，不精不诚，不能动人。","book":"《庄子·渔父》"},"example":{"text":"困难当头，更要～。"},"similar":["风雨同舟","齐心协力"],"opposite":["四分五裂","分道扬镳"],"usage":"作主语、宾语、定语；指真心诚意"},{"id":35959,"word":"精诚所加，金石为亏","pinyin":"jīng chéng suǒ jiā，jīn shí wéi kuī","abbr":"jcsjjswk","explanation":"谓人的诚心所到，能感动天地，使金石为之开裂。","source":{"text":"精诚所加，金石为亏。","book":"汉·王充《论衡·感虚篇》"},"similar":["精诚所至，金石为开"],"usage":"作宾语、定语；用于书面语"},{"id":35960,"word":"精诚所加，金石为开","pinyin":"jīng chéng suǒ jiā，jīn shí wéi kāi","abbr":"jcsjjswk","explanation":"谓人的诚心所到，能感动天地，使金石为之开裂。同“精诚所加，金石为亏”。","source":{"text":"精诚所加，金石为开","book":"《后汉书·广陵思王荆传》"},"similar":["精诚所加，金石为亏"],"usage":"作宾语、定语；用于书面语"},{"id":35961,"word":"精诚所至","pinyin":"jīng chéng suǒ zhì","abbr":"jcsz","explanation":"人的真诚的意志所到。","source":{"text":"精诚所至，金石为开。果然勇猛，自有神来。","book":"明·凌濛初《初刻拍案惊奇》卷四十"},"example":{"text":"～，金石为开。"},"similar":["精诚团结"],"opposite":["土崩瓦解"],"usage":"作谓语、宾语；指人的意志"},{"id":35962,"word":"精诚所至，金石为开","pinyin":"jīng chéng suǒ zhì，jīn shí wéi kāi","abbr":"jcszjswk","explanation":"人的诚心所到，能感动天地，使金石为之开裂。比喻只要专心诚意去做，什么疑难问题都能解决。","source":{"text":"精诚所至，金石为开。","book":"《庄子·渔父》：“真者，精诚之至也，不精不诚，不能动人。”汉·王充《论衡·感虚篇》"},"example":{"text":"明·凌濛初《初刻拍案惊奇》第九卷：“～，贞心不寐，死后重谐。”"},"similar":["精诚所加，金石为开"],"usage":"作宾语、定语；用于书面语"},{"id":35963,"word":"精诚贯日","pinyin":"jīng chéng guàn rì","abbr":"jcgr","explanation":"精：精神；贯：贯通；日：太阳。精神和太阳贯通起来。形容极端忠诚。","source":{"text":"君执大节，精贯白日，奋其武怒，运其神策。","book":"《三国志·魏书·武帝纪》"},"example":{"text":"把金汤固守，～，衣冠不改，意气横秋。","book":"元·白朴《沁园春·十二月十四日为平章吕公寿》"},"similar":["精贯白日"],"usage":"作谓语、宾语；形容极端忠诚"},{"id":35964,"word":"精贯白日","pinyin":"jīng guàn bái rì","abbr":"jgbr","explanation":"形容极端忠诚。","source":{"text":"君执大节，精贯白日，奋其武怒，运其神策。","book":"晋·陈寿《三国志·魏志·武帝纪》"},"example":{"text":"慢叱凶徒，～，虽古忠烈无以加焉。","book":"《新唐书·文艺传下·李翰》"},"similar":["精诚贯日"],"usage":"作谓语、宾语；形容极端忠诚"},{"id":35965,"word":"精进不休","pinyin":"jīng jìn bù xiū","abbr":"jjbx","explanation":"精进：专心努力上进；休：停止。指人不停追求进步。","source":{"text":"刻苦，沉着，精进不休。","book":"《追求》"},"usage":"作谓语、定语；指人追求进步"},{"id":35966,"word":"精进勇猛","pinyin":"jīng jìn yǒng měng","abbr":"jjym","explanation":"原意是勤奋修行。现指勇敢有力地向前进。","source":{"text":"勇猛精进，志愿无倦。","book":"《无量寿经》卷上"}},{"id":35967,"word":"精采秀发","pinyin":"jīng cǎi xiù fā","abbr":"jcxf","explanation":"精采：精神、神采；秀发：焕发。形容人的精神焕发。","source":{"text":"精采秀发，容止可观。","book":"《晋书·慕容超载记》"},"usage":"作谓语、定语；指人的精神"},{"id":35968,"word":"精金百炼","pinyin":"jīng jīn bǎi liàn","abbr":"jjbl","explanation":"比喻德才修养锻炼十分到家。","source":{"text":"精金成炼，在割能断。功则治人，职思靖乱。","book":"南朝·宋·刘义庆《世说新语·文学》"},"usage":"作宾语、定语；指锻炼人才"},{"id":35969,"word":"精金美玉","pinyin":"jīng jīn měi yù","abbr":"jjmy","explanation":"精金：精炼的金。纯金美玉。比喻人品纯洁或物品精美。","source":{"text":"欧阳文忠公言文章如精金美玉，市有定价，非人所能以口舌定贵贱也。","book":"宋·苏轼《答谢民师书》"},"example":{"text":"那点～，同心意合，媚滋一人。","book":"清·文康《儿女英雄传》第三十四回"},"similar":["精金良玉"],"usage":"作宾语、定语；比喻纯洁完美"},{"id":35970,"word":"精金良玉","pinyin":"jīng jīn liáng yù","abbr":"jjly","explanation":"精金：精炼的金；良玉：美玉。纯金美玉。比喻人品纯洁或物品精美。","source":{"text":"先生资禀既异，而充养有道，纯粹如精金，温润如良玉。","book":"宋·程颐《程明道先生行状》"},"similar":["精金美玉"],"usage":"作宾语、定语；比喻纯洁完美"},{"id":35971,"word":"精锐之师","pinyin":"jīng ruì zhī shī","abbr":"jrzs","explanation":"精锐：指军队装备优良，战斗力强；师：军队。指战斗能力很强的部队。","source":{"text":"明公据山河之固，拥精锐之师，以顺万人思汗之心，则天下谁人不从？","book":"《后汉书·铫期传》"},"usage":"作宾语；指战斗能力很强的部队"},{"id":35972,"word":"精雕细刻","pinyin":"jīng diāo xì kè","abbr":"jdxk","explanation":"精心细致地雕刻。形容创作艺术品时的苦心刻画。也比喻认真细致地加工。","source":{"text":"过去冀鲁豫的工作比太行热闹得多，太行的工作不够热闹，但是精雕细刻。","book":"邓小平《提倡深入细致的工作》"},"example":{"text":"山顶上当中有个八角亭子，名叫洗心亭，里面放着汉白玉的桌子和坐礅，都是～，十分考究。","book":"陈荫荣《兴唐传》"},"similar":["巧夺天工","自成机杼"],"opposite":["偷工减料","粗制滥造"],"usage":"作谓语、定语、状语；指做事精细"},{"id":35973,"word":"糊口度日","pinyin":"hú kǒu dù rì","abbr":"hkdr","explanation":"糊口：本是喝粥的意思。度日：过日子。勉强维持生活，打发日子。","example":{"text":"《五代史评话·梁史》：“但是小生自小兀坐书斋，不谙其他生活，只得把这教学糊口度日，为之奈何？”"},"usage":"作谓语、定语；用于口语"},{"id":35974,"word":"糊涂到顶","pinyin":"hú tú dào dǐng","abbr":"htdd","explanation":"人头脑十分不清楚或不明事理。","example":{"text":"你真是～了。"},"opposite":["聪明绝顶"],"usage":"作谓语、定语、状语；指人处事"},{"id":35975,"word":"糊涂虫","pinyin":"hú tú chóng","abbr":"htc","explanation":"不明事理的人。","source":{"text":"云岫这东西，不给他两句，他当人家一辈子都是糊涂虫呢。","book":"清·吴趼人《二十年目睹之怪现状》第20回"},"example":{"text":"你这个～整天稀里糊涂的。"},"usage":"作宾语、定语；用于口语骂人"},{"id":35976,"word":"糊涂账","pinyin":"hú tú zhàng","abbr":"htz","explanation":"算不清楚的账，比喻弄不清楚的问题。","source":{"text":"咱们虽说赚了一点钱，可这是一笔糊涂账！这钱是咱们两个苦熬出来的，但家里人人有份！","book":"路遥《平凡的世界》第三卷第15章"},"example":{"text":"他们之间的事至今还是一笔～。"},"usage":"作主语、宾语、定语；用于人际关系等"},{"id":35977,"word":"糊糊涂涂","pinyin":"hú hú tū tū","abbr":"hhtt","explanation":"无感觉的，麻木的或茫然的状态。","source":{"text":"口里糊糊涂涂，又说好些，总不过肉麻说话。","book":"明·凌濛初《二刻拍案惊奇》第38卷"},"example":{"text":"一夜没有安稳睡觉，又是一天辛勤工作，这时昏昏欲睡、～的了。"},"similar":["糊里糊涂"],"opposite":["清清楚楚","明明白白"],"usage":"作谓语、定语、状语；指人不清醒"},{"id":35978,"word":"糊里糊涂","pinyin":"hú lǐ hú tú","abbr":"hlht","explanation":"认识模糊，不明事理。也形容思想处于模糊不清的状态。","source":{"text":"吃了这鱼，成了神仙，虽是快活，就只当中死的二百年，糊里糊涂，令人难熬。","book":"清·吴趼人《二十年目睹之怪现状》第三十一回：“至于那以后的批评，糊里糊涂预写下的，灵不灵那个去管他呢。”清·李汝珍《镜花缘》第十五回"},"example":{"text":"难道龚定庵就这么～的给他们药死了吗？","book":"清·曾朴《孽海花》第三回"},"similar":["浑浑噩噩","稀里糊涂"],"opposite":["清清楚楚"],"usage":"作定语、状语；指对事物认识不清"},{"id":35979,"word":"糖舌蜜口","pinyin":"táng shé mì kǒu","abbr":"tsmk","explanation":"甜言蜜语，说讨人喜欢的动听的话。","source":{"text":"起初时为闲游，到后来被啜哄，糖舌蜜口随他弄。","book":"《群英类选·〈海神记·王诉神〉》"},"similar":["甜言蜜语"],"usage":"作宾语、定语、状语；用于说话"},{"id":35980,"word":"糖衣炮弹","pinyin":"táng yī pào dàn","abbr":"typd","explanation":"用糖衣裹着的炮弹；比喻用腐蚀、拉拢、诱惑等手段去牟取自己的利益。","source":{"text":"不要中了敌人的糖衣炮弹，被人家拉过去。","book":"陈登科《风雷》第一部第49章"},"example":{"text":"一些意志薄弱的人容易被～所击倒。"},"similar":["甜言蜜语"],"opposite":["一尘不染"],"usage":"作主语、宾语、定语；指诱惑人的甜头"},{"id":35981,"word":"糜烂不堪","pinyin":"mí làn bù kān","abbr":"mlbk","explanation":"糜烂：破败；不堪：无法收拾。比喻事物破败到了不可收拾的地步。","source":{"text":"一请明降谕旨，饬直隶总督转令各将士从速剿匪，免使糜烂不堪，从来安内乃可攘外，势必肃清畿辅，始固人心。","book":"清·张之洞《书信二通》其一"},"example":{"text":"中原乃国家腹心之地，多年来各股流贼纵横，～。","book":"姚雪垠《李自成》第二卷第五十一章"}},{"id":35982,"word":"糜躯碎首","pinyin":"mí qū suì shǒu","abbr":"mqss","explanation":"指粉身碎骨。","source":{"text":"今太子欲灭悁悁之耻，除久久之恨，此实臣所当糜躯碎首而不避也。","book":"战国·燕·婅武《报燕太子书》"},"similar":["粉身碎骨"],"usage":"作宾语；指粉身碎骨"},{"id":35983,"word":"糜饷劳师","pinyin":"mí xiǎng láo shī","abbr":"mxls","explanation":"糜：浪费：师：军队。浪费军饷，劳顿军队。","source":{"text":"旷日绵岁，劳师废财。","book":"唐·陆贽《收河东后请兵状》"},"example":{"text":"～，皆林则徐等办理不善之所致。","book":"《清史稿·林则徐传》"}},{"id":35984,"word":"糜鹿姑苏","pinyin":"mí lù gū sū","abbr":"mlgs","explanation":"糜：鹿的一种。糜鹿游姑苏台。比喻亡国。","source":{"text":"臣闻子胥谏吴王，吴王不用，乃曰臣今见糜鹿游姑苏之台也。","book":"《史记·淮南衡山列传》"},"example":{"text":"谁向若耶溪上，倩美人西去，～。","book":"宋·辛弃疾《汉宫春·会稽蓬莱阁怀古》词"}},{"id":35985,"word":"糟糠不厌","pinyin":"zāo kāng bù yàn","abbr":"zkby","explanation":"糟糠：用以充饥的酒糟糠皮等粗劣的食物；厌：满足。就连酒糟、米糠这样粗劣的食物也吃不饱。形容生活极其困苦。","source":{"text":"且七十子之徒，仲尼独荐颜渊为好学。然回也屡空，糟糠不厌，而卒蚤夭。","book":"《史记·伯夷列传》"},"example":{"text":"闾阎之～，而燕私之供奉自如，则人不悦。（《宋史·赵景纬传》）"},"usage":"作谓语、定语；用于书面语"},{"id":35986,"word":"糟糠之妇","pinyin":"zāo kāng zhī fù","abbr":"zkzf","explanation":"糟糠：穷人用来充饥的酒渣、米糠等粗劣食物。指共过患难的妻子","source":{"text":"允备贞洁韦柔之德，糟糠之妇，今始见之。","book":"元·高则诚《琵琶记·一门旌奖》"},"similar":["糟糠之妻"],"usage":"作主语、宾语；指患难发妻"},{"id":35987,"word":"糟糠之妻","pinyin":"zāo kāng zhī qī","abbr":"zkzq","explanation":"糟糠：穷人用来充饥的酒渣、米糠等粗劣食物。借指共过患难的妻子。","source":{"text":"（光武帝）谓弘曰：‘谚言贵易交，富易妻，人情乎？’弘曰：‘臣闻贫贱之知不可忘，糟糠之妻不下堂。’","book":"《后汉书·宋弘传》"},"example":{"text":"生辞曰：‘～不下堂，宁死不敢承命。王如听臣自赎，倾家可也。’","book":"清·蒲松龄《聊斋志异·八大王》"},"similar":["糟糠之妻不下堂"],"usage":"作主语、宾语；指患难发妻","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":35988,"word":"糟糠之妻不下堂","pinyin":"zāo kāng zhī qī bù xià táng","abbr":"zkzqbxt","explanation":"糟糠：用以充饥的酒糟糠皮等粗劣的食物；堂：正房。不要遗弃共过患难的妻子。","source":{"text":"臣闻贫贱之知不可忘，糟糠之妻不下堂。","book":"《后汉书·宋弘传》"},"example":{"text":"～，宁死不敢承命，王如听臣自赎，倾家可也。","book":"清·蒲松龄《聊斋志异·八大王》"},"usage":"作宾语、定语；指爱惜患难之妻","story":["东汉初年，刘秀起用西汉时期的侍中宋弘，并升他为“太中大夫”。刘秀的姐姐守寡并看上了宋弘，刘秀想把姐姐嫁给宋弘，问宋弘对“贵易交，富易妻”的看法，宋弘回答道：“贫贱之交不可忘，糟糠之妻不下堂”，刘秀只好放弃"]},{"id":35989,"word":"糠秕在前","pinyin":"kāng bǐ zài qián","abbr":"kbzq","explanation":"糠秕：谷皮和瘪谷，比喻无价值的东西。形容自己不如别人。","source":{"text":"簸之扬之，糠秕在前。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"凿齿曰：‘簸之扬之，～。’","book":"《晋书·孙绰传》"},"similar":["簸之扬之，糠秕在前"],"usage":"作宾语、定语；用于自谦","story":["东晋时期，司马昱邀请王坦之和范启前去议事，范启年龄大而官位小，王坦之年龄小而官位大。他们两人互相谦让让对方走前头。王坦之走在范启前开玩笑说“簸之扬之，糠秕在前。”范启反唇相讥：“淘啊汰啊，沙砾在后。”"]},{"id":35990,"word":"糠菜半年粮","pinyin":"kāng cài bàn nián liáng","abbr":"kcbnl","explanation":"一年之中有半年用糠和菜代替粮食。形容旧社会劳动人民的生活极其贫困。","source":{"text":"总是个糠菜半年粮哇，今年可要早动手，多按上两瓮豆叶菜。","book":"刘江《太行风云》"},"example":{"text":"中国农民的～生活是不会再出现了。"},"usage":"作宾语、定语；指生活困苦"},{"id":35991,"word":"糠豆不瞻","pinyin":"kāng dòu bù shàn","abbr":"kdbz","explanation":"糠：从稻、麦等谷物上脱下的皮、壳；豆：豆类；瞻：供养。连吃糠皮等粗劣的杂粮也供养不起。形容生活十分穷困。","source":{"text":"妻子豆不瞻，裋褐不完。","book":"《汉书·贡禹传》"}},{"id":35992,"word":"糠豆不赡","pinyin":"kāng dòu bù shàn","abbr":"kdbs","explanation":"就是吃糠皮杂粮也供养不起。形容生活十分贫困。","source":{"text":"妻子糠豆不赡，饾褐不完。","book":"东汉·班固《汉书·贡禹传》"},"usage":"作谓语、定语；指生活贫困"},{"id":35993,"word":"系之苇苕","pinyin":"xì zhī wěi tiáo","abbr":"xzws","explanation":"系：依附；苇苕：芦苇的嫩条。鸟巢筑在纤脆的芦苇上。比喻所依附的基础不牢，有很大的危险。","source":{"text":"南方有鸟焉，名曰蒙鸠，以羽为巢而编之以发，系之苇苕，风至苕折，卵破子死。","book":"《荀子·劝学》"}},{"id":35994,"word":"系而不食","pinyin":"xì ér bù shí","abbr":"xebs","explanation":"系：结。光挂着却不吃。指中看不中吃的东西。","source":{"text":"吾岂綔瓜也哉！鄢能系而不食。","book":"春秋·鲁·孔丘《论语·阳货》"},"similar":["中看不中吃"],"usage":"作谓语、定语；指中看不中吃的东西"},{"id":35995,"word":"系铃解铃","pinyin":"xì líng jiě líng","abbr":"xljl","explanation":"系：缚，系上。比喻谁惹出来的麻烦，还得由谁去解决。","source":{"text":"眼一日问众：‘虎项金铃，是谁解得？’众无对。师适至，眼举前语问，师曰：‘系者解得。’","book":"明·瞿汝稷《指月录》第23卷"},"example":{"text":"我不妨和他见了面，窥察他的神气语意，如果事由他起，则～，原须一人。","book":"清·颐琐《黄绣球》第五回"},"similar":["解铃须用系铃人"],"usage":"作宾语、定语；用于处事","story":["南唐时期，法眼宗始祖法眼法师在金陵清凉寺给众僧讲佛经，希望他们潜心向佛，遵守清规戒律。法灯和尚却偏偏不爱遵守这些清规戒律，但人很聪明。法眼法师问谁能从凶猛的老虎脖子上取下金铃来，法灯和尚回答道解铃还须系铃人"]},{"id":35996,"word":"系颈牵羊","pinyin":"xì jǐng qiān yáng","abbr":"xjqy","explanation":"系：拴缚。用绳系住脖子，用手牵着羊。形容投降请罪的样子。","source":{"text":"祺读至‘免系颈牵羊’之语，太后泣谓帝曰：‘荷天子圣恩，汝宜拜谢。","book":"清·毕沅《续资治通鉴·宋帝显德佑二年》"},"usage":"作宾语、定语；用于书面语"},{"id":35997,"word":"系风捕影","pinyin":"xì fēng bǔ yǐng","abbr":"xfby","explanation":"拴住风，捉住影子。比喻无法办到的事。也比喻说话做事以不可靠的传闻或表面现象作根据。","source":{"text":"听其辞，洋洋满耳，若将可遇；求之，荡荡若系风捕影，终不可得。","book":"汉·荀悦《汉纪·成帝纪三》"},"example":{"text":"夫门人疑一贯之说，如～之难，而曾子断断然以忠恕尽之。","book":"明·焦竑《焦氏笔乘续集·读》"},"similar":["捕风捉影","系风捕景","捕影拿风"],"usage":"作谓语、定语；同“捕风捉影”"},{"id":35998,"word":"系风捕景","pinyin":"xì fēng bǔ jǐng","abbr":"xfbj","explanation":"①比喻不可能做到的事。②比喻不露形迹。亦作“系风捕影”。","source":{"text":"听其言，洋洋满耳，若将可遇；求之，荡荡如系风捕景，终不可得。","book":"东汉·班固《汉书·郊祀志》"},"example":{"text":"南朝·宋·谢惠连《秋胡行》：“～，诚知不得，念彼奔波，意虑回惑。”"},"similar":["系风捕影","捕风系影","捕风捉影"],"usage":"作谓语、定语；用于比喻句"},{"id":35999,"word":"系马埋轮","pinyin":"xì mǎ mái lún","abbr":"xmml","explanation":"指敌人进攻时，系住马，埋车轮于地，以示固守不退。","source":{"text":"方，缚马也；埋轮，示不动也。","book":"语出《孙子·九地》：“是故方马埋轮，未足恃也。”曹操注"},"example":{"text":"孰能被坚执锐，长驱深入，～，奋不顾身，以先士卒者乎？","book":"《南史·虞寄传》"},"usage":"作谓语、定语；用于书面语"},{"id":36000,"word":"素不相能","pinyin":"sù bù xiāng néng","abbr":"sbxn","explanation":"能：亲善。指一向不和睦。","source":{"text":"子与刘公积不相能，而信其虚谈，不为之备，终受制矣。","book":"《左传·襄公二十一年》：“栾桓子娶于范宣子，生怀子，范鞅以其亡也，怨栾氏，故与栾盈为公族大夫而不相能。”《后汉书·吴汉传》"},"example":{"text":"其实举人老爷和赵秀才～，在理本不能有“共患难”的情谊。","book":"鲁迅《阿Ｑ正传》"},"opposite":["亲密无间"],"usage":"作谓语、定语；指一向不和睦"},{"id":36001,"word":"素不相识","pinyin":"sù bù xiāng shí","abbr":"sbxs","explanation":"素：平素，向来。向来不认识。","source":{"text":"我与你素不相识，一旦为你寄书，因而戏言，岂意遂为眷属。","book":"元·尚仲贤《柳毅传书》第四折"},"example":{"text":"船儿只管乘风破浪的一直的走，走向那～的他乡。","book":"冰心《寄小读者·通讯十八》"},"similar":["素昧平生"],"opposite":["一见如故"],"usage":"作谓语、定语；用于人","story":["三国时期，吴国人陆逊的弟弟陆瑁性情豪爽，心地善良，同郡的徐厚和他一样为人耿直，虽与他素不相识，但非常仰慕他的为人，临终时留下遗书，把儿女托付给陆瑁。陆瑁待他们如同自己的亲骨肉，让他们受良好的教育"]},{"id":36002,"word":"素丝羔羊","pinyin":"sù sī gāo yáng","abbr":"ssgy","explanation":"指正直廉洁的官吏。","source":{"text":"羔羊之皮，素丝五陀，退食自公，委蛇委蛇。","book":"《诗经·周南·羔羊》"},"example":{"text":"其令将相大夫会葬，加赐钱十万，及其在殡，以全～之洁焉。","book":"《后汉书·宋弘传》"},"usage":"作宾语；指正直廉洁的官吏"},{"id":36003,"word":"素丝良马","pinyin":"sù sī liáng mǎ","abbr":"sslm","explanation":"以之为礼遇贤士之辞。","source":{"text":"言卫大夫乘此车马，建此旌旄，以见贤者。","book":"《诗·鄘风·干旄》：“素丝纰之，良马四之。”郑玄笺：“素丝者以为缕，以缝纰旌旗之旒縿。”朱熹集传"},"usage":"作宾语、定语；用于书面语"},{"id":36004,"word":"素位而行","pinyin":"sù wèi ér xíng","abbr":"swex","explanation":"素位：安于平常所处的地位。指安于现在所处的地位，并努力做好应当做的事情。","source":{"text":"君子素其位而行，不愿乎其外。","book":"《礼记·中庸》"},"example":{"text":"过了数日，卢柟差人打听陆公已是回县，要去作谢。他却也～，换了青衣小帽。","book":"明·冯梦龙《醒世恒言》卷二十六"}},{"id":36005,"word":"素口骂人","pinyin":"sù kǒu mà rén","abbr":"skmr","explanation":"以茹素之口骂人。比喻伪善。","source":{"text":"古语两句甚好：宁可荤口念佛，莫将素口骂人。","book":"宋·李之彥《东谷所见·茹素》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":36006,"word":"素昧平生","pinyin":"sù mèi píng shēng","abbr":"smps","explanation":"昧：不了解；平生：平素、往常。彼此一向不了解。指与某人从来不认识。","source":{"text":"鸥鸟忘机翻浃洽，交亲得路昧平生。","book":"唐·李商隐《赠田叟》"},"example":{"text":"其在前曰：真为～，突如其来，难怪妾之得罪。","book":"元·王实甫《西厢记》第二本第三折"},"similar":["素不相识","萍水相逢"],"opposite":["莫逆之交","刎颈之交"],"usage":"作谓语、定语；指过去没见过面的人"},{"id":36007,"word":"素昧生平","pinyin":"sù mèi shēng píng","abbr":"smsp","explanation":"彼此一向不了解。指与某人从来不认识。同“素昧平生”。","source":{"text":"时筱仁因彼此素昧生平，也乐得装作不知，以免拖累。","book":"《官场现形记》第二八回"},"example":{"text":"清·名教中人《好逑传》第13回：“长兄又～，不知何故不惮一二千里之遥，跋涉到此？”"},"similar":["素昧平生"],"usage":"作谓语、定语；指过去没见过面的人"},{"id":36008,"word":"素未谋面","pinyin":"sù wèi móu miàn","abbr":"swmm","explanation":"谋面：见面。指平素没有见过面。","source":{"text":"谋面用丕训德。","book":"《尚书·立政》"}},{"id":36009,"word":"素波银涛","pinyin":"sù bō yín tāo","abbr":"sbyt","explanation":"素：白。指云彩。"},{"id":36010,"word":"素王之业","pinyin":"sù wáng zhī yè","abbr":"swzy","explanation":"素王：旧称孔子有德无位，故称素王。旧指孔子删订《春秋》的事业。","source":{"text":"孔子不王，素王之业在于《春秋》。然则桓君山素丞相之迹，存《新论》者也。","book":"汉·王充《论衡·定贤》"},"example":{"text":"此二十篇，寻其条理，求其恉趣，而太平之治、～备焉。","book":"《清史稿·宋翔凤传》"}},{"id":36011,"word":"素绠银瓶","pinyin":"sù gěng yín píng","abbr":"sgyp","explanation":"素绠：汲水用的桶绳；银瓶：汲水器。指从井下汲水的器具。","source":{"text":"几度美人照影来，素绠银瓶濯纤玉。","book":"唐·贯休《行路难》"},"example":{"text":"寒泉不食人喝死，～我心恻。","book":"宋·陆游《寄仗锡平老借用其听琴诗韵》"},"similar":["银瓶素绠"],"usage":"作主语、宾语；用于书面语"},{"id":36012,"word":"素衣化缁","pinyin":"sù yī huà zī","abbr":"syhz","explanation":"缁：黑衣。白衣变成了黑衣。比喻灰尘极多。","source":{"text":"京洛多风尘，素衣化为缁。","book":"晋·陆机《为顾彦先赠妇》"},"example":{"text":"故质改化，曰：～。","book":"宋·胡继宗《书言故事·衣服类》"},"usage":"作宾语、定语；用于书面语"},{"id":36013,"word":"素见成事","pinyin":"sù jiàn chéng shì","abbr":"sjcs","explanation":"素：向来。事先预见到事情的结果。","source":{"text":"夫谋，必素见成事焉，而后履之。","book":"《国语·吴语》"}},{"id":36014,"word":"素负盛名","pinyin":"sù fù shèng míng","abbr":"sfsm","explanation":"素：一向；负：享有；盛名：很大的名望。历来享有很高的名望。"},{"id":36015,"word":"素车朴马","pinyin":"sù chē pǔ mǎ","abbr":"scpm","explanation":"素车：古代用白土涂饰的车子。旧时办丧事用的车马，后用作送葬的语词。","source":{"text":"若其有罪，绞缢以戮，桐棺三寸，不设属辟，素车朴马，无入于兆，下卿之罚也。","book":"《左传·哀公二年》"},"example":{"text":"子乌古达，器度弘达，袭长宿卫，父没，凡赗赙之物，一无所受，以～归葬其先茔。","book":"《清·毕沅《续资治通鉴》卷一百九十一"}},{"id":36016,"word":"素车白马","pinyin":"sù chē bái mǎ","abbr":"scbm","explanation":"旧时办丧事用的车马，后用作送葬的语词。","source":{"text":"遂停柩移时，乃见有素车白马，号哭而来。","book":"《尸子》卷上：“汤之救旱也，乘素车白马，著布衣，身婴白茅，以身为牲，祷于桑木之野。”《后汉书·范武传》"},"example":{"text":"要什么～，断送出古陌荒阡。","book":"元·关汉卿《窦娥冤》第三折"},"similar":["白马素车"],"usage":"作宾语、定语；用作送葬的语词","story":["春秋时期，吴王夫差不听伍子胥的劝告，同越王勾践和好，并且听信谗言，赐剑让伍子胥自尽，将他的尸首抛入江中，从此江中波涛汹涌，从海门山滚滚而来，越过钱塘鱼浦，波浪才减弱。早晚有时可以看到伍子胥乘白马素车站在潮头"]},{"id":36017,"word":"素门凡流","pinyin":"sù mén fán liú","abbr":"smfl","explanation":"指寒门之族，平凡之人。","source":{"text":"臣素门凡流，轮翻无取。","book":"南朝·梁·任昉《为范尚书让吏部封侯第一表》"},"usage":"作宾语、定语；用于书面语"},{"id":36018,"word":"素隐行怪","pinyin":"sù yǐn xíng guài","abbr":"syxg","explanation":"隐：隐暗的事；行：从事；怪：怪事。求索隐暗的事情，而行怪迂之道。意指身居隐逸的地方，行为怪异，以求名声。","source":{"text":"孔子曰：‘索隐行怪，后世有述焉，吾不为之矣。","book":"《汉书·艺文志》"},"similar":["索隐行怪"],"usage":"作谓语、定语；指怪人"},{"id":36019,"word":"素面朝天","pinyin":"sù miàn cháo tiān","abbr":"smct","explanation":"妇女不施脂粉，入朝觐见天子。","source":{"text":"虢国不施脂粉，自衒美艳，常素面朝天。","book":"宋·乐史《杨太真外传》"},"example":{"text":"～的她有花容玉貌。"},"usage":"作宾语、定语；用于女性","story":["唐朝时期，唐玄宗死了宠爱的武惠妃以后见到寿王李瑁的妃子杨玉环，于是招她进宫，并封她的三个姐姐为韩国夫人、虢国夫人、秦国夫人。还经常与她们在一起淫乱，虢国夫人经常素面朝天，唐玄宗对她宠爱有加"]},{"id":36020,"word":"素餐尸位","pinyin":"sù cān shī wèi","abbr":"scsw","explanation":"素餐：白吃饭；尸位：空占职位，不尽职守。空占着职位而不做事，白吃饭。","source":{"text":"虚食主禄，素餐尸位而但事淫侈，坐作骄奢，破败而不及传世者也。","book":"《尚书·五子之歌》：“太康尸位，以逸豫灭厥德。”汉·王符《潜夫论·思贤》"},"example":{"text":"清·昭梿《啸亭杂录·钱南园》：“今诸臣皆～，致使豺狼遍野而上不知，安用谏官为哉？”"},"similar":["尸位素餐"],"usage":"作谓语、定语、宾语；指白吃饭不干活"},{"id":36021,"word":"素餐尸禄","pinyin":"sù cān shī lù","abbr":"scsl","explanation":"素餐：白吃饭；尸禄：空领俸禄，不尽职守。光拿钱而不做事。","source":{"text":"臣禹犬马之齿八十一，血气衰竭，耳目不聪明，非复能有补益，所谓素餐尸禄洿朝之臣也。","book":"《汉书·贡禹传》"},"example":{"text":"～，积有年岁，彼土安危，窃所具悉。","book":"《魏书·尉元传》"}},{"id":36022,"word":"索垢吹瘢","pinyin":"suǒ gòu chuī bān","abbr":"sgcb","explanation":"犹言吹毛求疵。","source":{"text":"指望双星圆七夕，谁知银汉阻良姻。狰狞关吏多威陷，索垢吹瘢不放行。","book":"清·心青《二十世纪女界文明灯弹词·拒约》"},"similar":["索垢寻疵"],"usage":"作谓语、定语；用于比喻句"},{"id":36023,"word":"索垢寻疵","pinyin":"suǒ gòu xún cī","abbr":"sgxc","explanation":"犹言吹毛求疵。","source":{"text":"被咱家识破他行止，因此上索垢寻疵。","book":"元·无名氏《杀狗劝夫》第四折"},"similar":["索垢吹瘢"],"usage":"作谓语、定语；用于比喻句"},{"id":36024,"word":"索垢指瘢","pinyin":"suǒ gòu zhǐ bān","abbr":"sgzb","explanation":"垢：污垢；瘢：瘢痕。洗掉污垢来寻找瘢痕。比喻想尽办法挑剔别人的缺点。","source":{"text":"所好，则钻皮出其毛屑；所恶，则洗垢求其瘢痕。","book":"汉·赵壹《刺世疾邪赋》"},"example":{"text":"钱牧翁撰《列朝诗》，大旨在尊李西涯，贬李空同、李沧溟及弇州，～，不遗余力。","book":"清·王士慎《带经堂诗话·评驳类》"}},{"id":36025,"word":"索尽枯肠","pinyin":"suǒ jìn kū cháng","abbr":"sjkc","explanation":"比喻费尽心思。","source":{"text":"采秋的令烦难得很，令人索尽枯肠。","book":"清·魏子安《花月痕》第三十回"},"similar":["搜索枯肠"],"usage":"作谓语；比喻费尽心思"},{"id":36026,"word":"索居离群","pinyin":"suǒ jū lí qún","abbr":"sjlq","explanation":"索：孤单。离开集体或群众，过孤独的生活。","source":{"text":"吾离群而索居，亦已久矣。","book":"《礼记·檀弓上》"},"example":{"text":"迩年以来，诸君子分处离散，余亦就食青毡，～，莫加督责，而学复荒落矣。","book":"清·黄百家《学箕初稿·赠陈子文北上序》"}},{"id":36027,"word":"索然俱散","pinyin":"suǒ rán jù sàn","abbr":"srjs","explanation":"索然：离散的样子；俱：全。形容很快离散的样子。","source":{"text":"至刘禅降服，诸营堡者索然俱散。","book":"《晋书·羊祜传》"}},{"id":36028,"word":"索然寡味","pinyin":"suǒ rán guǎ wèi","abbr":"srgw","explanation":"寡：少，缺少。毫无意味或毫无兴致的样子。","source":{"text":"然以空疏者为之，则枯木朽荄，索然寡味，仅得其转折波澜。","book":"刘师培《论近世文学之变迁》"},"example":{"text":"现在依旧是那些红缎对联，那些题款，但当他凝神望定它们的时候，他的兴致却～了。","book":"沙汀《困兽记》二二"},"similar":["淡而无味"],"opposite":["津津有味"],"usage":"作谓语、定语、状语；用于文章或说话"},{"id":36029,"word":"索然无味","pinyin":"suǒ rán wú wèi","abbr":"srww","explanation":"索然：没有意味、没有兴趣的样子。形容事物枯燥无味（多指文章）。","source":{"text":"一口气走到书局门看时，谁知大门还不曾开，不觉索然无味。","book":"清·吴趼人《近十年之怪现状》第十二回"},"example":{"text":"我情愿做一回“文剪公”，因为事情和文章都有意思，太删节了怕会～。","book":"鲁迅《且介亭杂文附集·“立此存照”（三）》"},"similar":["枯燥无味"],"usage":"作谓语、定语；指没有趣味"},{"id":36030,"word":"索莫乏气","pinyin":"suǒ mò fá qì","abbr":"smfq","explanation":"索莫：消沉的样子；乏：缺少；气：生气。指枯寂而毫无生气的样子。","source":{"text":"思不不周，索莫乏气。","book":"南朝·梁·刘勰《文心雕龙·风骨》"}},{"id":36031,"word":"索隐行怪","pinyin":"suǒ yǐn xíng guài","abbr":"syxg","explanation":"索：探索；隐：隐暗的事；行：从事；怪：怪事。求索隐暗的事情，而行怪迂之道。意指身居隐逸的地方，行为怪异，以求名声。","source":{"text":"孔子曰：‘索隐行怪，后世有述焉，吾不为之矣。","book":"东汉·班固《汉书·艺文志》"},"example":{"text":"举凡旧日一应～之习，荒谬妄诞之谈。","book":"太平天国·洪仁玕《英杰归真》"},"similar":["素隐行怪"],"usage":"作宾语、定语；指行为怪异"},{"id":36032,"word":"紧打慢敲","pinyin":"jǐn dǎ màn qiāo","abbr":"jdmq","explanation":"比喻用各种办法催迫。","source":{"text":"发在监里，紧打慢敲，怕他不来上钩。","book":"明·施耐庵《水浒传》第九回"},"example":{"text":"我们～着他，希望他能进步。"},"similar":["紧敲慢打"],"usage":"作谓语、宾语、定语；比喻用各种办法催迫"},{"id":36033,"word":"紧箍咒","pinyin":"jǐn gū zhòu","abbr":"jgz","explanation":"小说《西游记》中唐僧用来制服孙悟空的咒语，能使孙悟空头上的金箍紧缩，头痛欲裂。后用来比喻束缚人的东西。","source":{"text":"我那里还有一篇咒儿，唤做‘定心真言’，又名做‘紧箍儿咒’，你可暗暗的念熟，牢记心头，再莫泄漏一人知道。","book":"明·吴承恩《西游记》第十四回"},"example":{"text":"反腐倡廉的～要经常念"},"usage":"作主语、宾语、定语；用于比喻句"},{"id":36034,"word":"紧行无善踪","pinyin":"jǐn xíng wú shàn zōng","abbr":"jxwsz","explanation":"比喻做事急于求成就不可能完美无缺。","example":{"text":"做事要记住～的道理。"},"similar":["紧行无好步"],"usage":"作宾语、定语；用于处事"},{"id":36035,"word":"紧行无好步","pinyin":"jǐn xíng wú hǎo bù","abbr":"jxwhb","explanation":"走得太急步子就迈不稳。比喻过于仓促，事情就做不好。","source":{"text":"禁（于禁）曰：‘紧行无好步，当缓图之。’庞德不知于禁之意，只懊悔不已。","book":"《三国演义》第七十四回"},"example":{"text":"俗话说：～，我们还是考虑周详后才行事吧"},"similar":["紧行无善踪"],"usage":"作宾语、定语；用于处事"},{"id":36036,"word":"紧要关头","pinyin":"jǐn yào guān tóu","abbr":"jygt","explanation":"关头：关口。比喻有关事情成败的关键或时机。","source":{"text":"十三妹同安龙媒、张金凤，并张老夫妻，柳林话别——是这书的开场紧要关头。","book":"清·文康《儿女英雄传》第11回"},"example":{"text":"在这～我们绝不能退却。"},"similar":["切要关头"],"usage":"作宾语、定语；指关键时刻"},{"id":36037,"word":"紧追不舍","pinyin":"jǐn zhuī bù shě","abbr":"jzbs","explanation":"使差距接近，势均力敌。","example":{"text":"我～，终于成为前三名。"},"similar":["步步紧逼"],"usage":"作谓语、宾语；指紧跟不放松"},{"id":36038,"word":"紧锣密鼓","pinyin":"jǐn luó mì gǔ","abbr":"jlmg","explanation":"锣鼓点敲得很密。比喻公开活动前的紧张气氛和舆论准备。","source":{"text":"绿树葱茏的太子镇里，传出一阵阵紧锣密鼓的喧响。","book":"刘绍棠《狼烟》四"},"example":{"text":"经过一阵～之后，新计划终于得以实施。"},"similar":["密锣紧鼓","呼之欲出"],"usage":"作宾语、定语、状语；用于大事开始前"},{"id":36039,"word":"紫气东来","pinyin":"zǐ qì dōng lái","abbr":"zqdl","explanation":"传说老子过函谷关之前，关尹喜见有紫气从东而来，知道将有圣人过关。果然老子骑着青牛而来。旧时比喻吉祥的征兆。","source":{"text":"老子西游，关令尹喜望见有紫气浮关，而老子果乘青牛而过也。","book":"汉·刘向《列仙传》"},"example":{"text":"～，瑶池西望，翩翩青鸟舞前降。","book":"清·洪昇《长生殿》第十六出"},"similar":["东来紫气"],"usage":"作宾语、定语；指好兆头"},{"id":36040,"word":"紫玉成烟","pinyin":"zǐ yù chéng yān","abbr":"zycy","explanation":"指少女逝世","example":{"text":"我从书本上了解～的故事"},"usage":"作宾语、定语；用于书面语","story":["春秋时，吴王夫差之女紫玉因想嫁给韩重不成郁闷而死。韩重游学归来吊唁，紫玉现形并送他一颗明珠。夫差得知韩重有颗明珠，认为他是发冢取物要拘捕他。小玉为洗脱韩重罪名亲自向夫差说明原委。夫人听说小玉归来，想拥抱她，小玉已化作青烟"]},{"id":36041,"word":"紫电清霜","pinyin":"zǐ diàn qīng shuāng","abbr":"zdqs","explanation":"形容武器锋利精良。","source":{"text":"紫电清霜，王将军之武库。","book":"唐·王勃《滕王阁序》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":36042,"word":"紫绶金章","pinyin":"zǐ shòu jīn zhāng","abbr":"zsjz","explanation":"紫色印绶和金印，古丞相所用。借指高官显爵。","source":{"text":"芙蓉冠，金璧辉煌。玉簪珠履，紫绶金章。","book":"明·吴承恩《西游记》第四回"},"example":{"text":"明·陆采《明珠记·访侠》：“正是不贪～贵，留得苍颜白发身。”"},"usage":"作宾语、定语；用于书面语"},{"id":36043,"word":"紫色蛙声","pinyin":"zǐ sè wā shēng","abbr":"zsws","explanation":"紫色：不正之色；蛙：淫邪之声。比喻以假乱真。","source":{"text":"紫色蛙声，余分闰位。","book":"汉·班固《汉书·王莽传赞》"}},{"id":36044,"word":"紫芝眉宇","pinyin":"zǐ zhī méi yǔ","abbr":"zzmy","explanation":"为称颂人德行高洁之词。","source":{"text":"元德秀字紫芝，河南河南人。质厚少缘饰……德秀善文辞，作《蹇士赋》以自况。房琯每见德秀，叹息曰：‘见紫芝眉宇，使人名利之心都尽。’","book":"《新唐书·卓行传·元德秀》"},"example":{"text":"清简诗章抛粪土，～漫灰尘。","book":"清·钱谦益《二哀诗·刘司空敬仲》"},"usage":"作宾语、定语；用于书面语"},{"id":36045,"word":"紫袍玉带","pinyin":"zǐ páo yù dài","abbr":"zpyd","explanation":"穿紫袍，系玉带。比喻高官。","source":{"text":"户列簪缨姓字香，紫袍玉带气昂昂。","book":"明·无名氏《万国来朝》第三折"},"usage":"作宾语、定语；用于书面语"},{"id":36046,"word":"紫陌红尘","pinyin":"zǐ mò hóng chén","abbr":"zmhc","explanation":"紫陌：帝京的道路；红尘：尘埃。指京城道上热闹非常，尘土飞扬。比喻虚幻的荣华。","source":{"text":"紫陌红尘拂面来，无人不道看花回。玄都观里桃千树，尽是刘朗去后栽。","book":"唐·刘禹锡《元和十九年自朗州承召至京，戏赠看花诸君子》诗"},"example":{"text":"～都是梦，者堪嗟。","book":"明·胡文焕《群音类选·胡全庵〈浪淘沙·道情〉之四》"},"usage":"作宾语、定语；用于书面语"},{"id":36047,"word":"紫髯如戟","pinyin":"zǐ rán rú jǐ","abbr":"zrrj","explanation":"髯：两颊上的胡子；戟：兵器。胡子像戟一样坚硬。形容男子容貌威猛","example":{"text":"他已到了～的年龄了"},"similar":["苍髯如戟","须髯如戟"],"usage":"作谓语、定语；用于书面语"},{"id":36048,"word":"累世通好","pinyin":"lěi shì tōng hǎo","abbr":"lsth","explanation":"累：连续。世世代代友好往来。多指国与国之间。","source":{"text":"先君孔子与君先人李老君，同德比义而相师友，则融与君累世通家也。","book":"《后汉书·孔融传》"}},{"id":36049,"word":"累世通家","pinyin":"lěi shì tōng jiā","abbr":"lstj","explanation":"累：接连；通家：世交。世世代代互相交好。","source":{"text":"先君孔子与君先人李老君，同德比义而相师友，则融与君累世通家也。","book":"《续汉书》"},"usage":"作宾语、定语；用于交往等"},{"id":36050,"word":"累卵之危","pinyin":"lěi luǎn zhī wēi","abbr":"llzw","explanation":"累：堆积。好比堆叠起来的蛋，极容易打碎。比喻情况极其危险。","source":{"text":"秦王之国，危如累卵，得臣则安。","book":"汉·王符《潜夫论》卷三：“居累卵之危而图泰山之安。”《史记·范雎蔡泽列传》"},"example":{"text":"大兵见屯临潼关下，损兵杀将，大肆狂暴，真～，其祸不小。","book":"明·许仲琳《封神演义》第八十五回"},"similar":["危如累卵"],"opposite":["泰山之安"],"usage":"作宾语；指十分危险","story":["春秋时期，晋灵公为了享乐，要建一座九层高的楼台，造了三年还没有造好，弄得民不聊生，晋灵公还不准大臣劝谏。荀息想了一计，在晋灵公面前先用12个棋子垒在一起，然后在上面垒九个鸡蛋，最后鸡蛋倒下砸碎。晋灵公明白后下令停工"]},{"id":36051,"word":"累及无辜","pinyin":"lěi jí wú gū","abbr":"ljwg","explanation":"累：带累，使受害。辜：罪。使受牵连；连累到没有罪过的人。","source":{"text":"至搜查之时，俱系官员亲身督验，断不至栽赃陷害，累及无辜。","book":"清·吴趼人《糊涂世界》第九回：“制台只得转告首县，又叫他三天之内一定要破案，却不许累及无辜。”清·林则徐《会谕尖沙嘴英国各船货具结进埔告示稿》"},"example":{"text":"还有等奸刁捕役，唆道指扳，～。","book":"《快心编》第九回"},"similar":["殃及池鱼"],"usage":"作谓语、宾语；指伤害别人"},{"id":36052,"word":"累土聚沙","pinyin":"lěi tǔ jù shā","abbr":"ltjs","explanation":"比喻积累收聚。","source":{"text":"苟能精致，累土聚沙，福钟不朽。","book":"《魏书·释老志》"},"usage":"作宾语、定语；指积聚"},{"id":36053,"word":"累土至山","pinyin":"lěi tǔ zhì shān","abbr":"ltzs","explanation":"比喻由小到大，积少成多。","source":{"text":"累丝至疋，累土至山，累业至圣，累灵至真，故万里之涉累足乃达。","book":"宋·张君房《云笈七签》第九十卷"},"similar":["积土成山"],"usage":"作谓语、宾语、定语；指积少成多"},{"id":36054,"word":"累块积苏","pinyin":"lěi kuài jī sū","abbr":"lkjs","explanation":"重迭的土块和堆积的柴草。形容居住的地方很简陋。","source":{"text":"帝之所居，王俯而视之，其宫榭若累块积苏焉。","book":"《列子·周穆王》"},"similar":["累苏积块"],"usage":"作宾语、定语；借指简陋的居室"},{"id":36055,"word":"累屋重架","pinyin":"lěi wū chóng jià","abbr":"lwcj","explanation":"累：重叠。指层次重叠。","source":{"text":"滥觞肇迹，容或可观，累屋重架，无乃太甚。","book":"唐·刘知几《史通·序例》"},"usage":"作谓语、宾语、定语；指层次重叠"},{"id":36056,"word":"累教不改","pinyin":"lěi jiào bù gǎi","abbr":"ljbg","explanation":"经过多次教育仍然不改正。","example":{"text":"他真是～，一意孤行。"},"similar":["屡教不改"],"opposite":["知错就改"],"usage":"作谓语；指经过多次教育仍然不改正"},{"id":36057,"word":"累月经年","pinyin":"lěi yuè jīng nián","abbr":"lyjn","explanation":"累：累积。月复一月，年复一年。形容经历的时间很长。","source":{"text":"头似大山，三江难满。无闻浆水之名，累月经年，受饥赢之苦。","book":"《敦湟变文集·大目乾运冥间救母变文》"},"similar":["经年累月"],"usage":"作宾语、状语；指长期"},{"id":36058,"word":"累棋之危","pinyin":"lěi qí zhī wēi","abbr":"lqzw","explanation":"堆迭的棋子，高则易倒。比喻形势危险。","source":{"text":"迥累棋之危，或堆山之固。","book":"《战国策·秦策》：“致至而危，累棋是也。”南朝·宋·傅亮《司徒刘穆之碑》"}},{"id":36059,"word":"累死累活","pinyin":"lèi sǐ lèi huó","abbr":"lslh","explanation":"形容十分劳累。","example":{"text":"我～还不是为了你。"},"usage":"作定语、状语；用于口语"},{"id":36060,"word":"累牍连篇","pinyin":"lěi dú lián piān","abbr":"ldlp","explanation":"累：重叠；牍：古代写字的木片。指用过多的篇幅叙述。","source":{"text":"寸晷之下，惟务贪多，累牍连篇，何由精妙。","book":"《隋书·李谔传》：“连篇累牍，不出月露之形。”《宋史·选举志二》"},"example":{"text":"狡狯之文，偶一为之，以资惩劝，亦无所不可；如～，动成卷卷帙，则非著书之体矣。","book":"清·纪昀《阅微草堂笔记·滦阳续录四》"},"similar":["连篇累牍"],"usage":"作定语、宾语；指用过多的篇幅叙述"},{"id":36061,"word":"累珠妙曲","pinyin":"lěi zhū miào qǔ","abbr":"lzmq","explanation":"形容歌声婉转，如珍珠成串。","source":{"text":"歌者上如抗，下如队，曲如折……累累乎端如贯珠。","book":"《礼记·乐记》"},"example":{"text":"侍姬持觞临劝，～，闻所未闻，至今感悦也。","book":"宋·孙觌《与庄宣教》"}},{"id":36062,"word":"累瓦结绳","pinyin":"lěi wǎ jié shéng","abbr":"lwjs","explanation":"比喻没有用的言词。","source":{"text":"骈于辩者，累瓦结绳，窜句游心于坚白同异之间，而敝跬誉无用之言词非乎？而杨墨是已。","book":"《庄子·骈拇》"},"usage":"作定语；指没用的言词"},{"id":36063,"word":"累累如珠","pinyin":"lěi lěi rú zhū","abbr":"llrz","explanation":"累累：连接成串。一个紧接一个，就像一串珠子。","source":{"text":"师乙论音，累如贯珠。","book":"《礼记·乐记》：“累累乎端如贯珠。”刘师培《文说》"},"example":{"text":"我爱繁花老干的杏，临风婀娜的小红桃，贴梗～的紫荆。","book":"朱自清《看花》"},"usage":"作谓语、定语；形容数量多"},{"id":36064,"word":"累苏积块","pinyin":"lěi sū jī kuài","abbr":"lsjk","explanation":"重迭的土块和堆积的柴草。形容居住的地方很简陋。同“累块积苏”。","source":{"text":"恍然生身色界上，累苏积块何足省。","book":"清·钱谦益《自拂水步至吾谷登南岩憩维摩寺》诗"},"similar":["累块积苏"],"usage":"作宾语、定语；借指简陋的居室"},{"id":36065,"word":"累见不鲜","pinyin":"lěi jiàn bù xiān","abbr":"ljbx","explanation":"形容数量多，见怪不怪。","source":{"text":"一岁中往来过他客，率不过再三过，数见不鲜，天久慁公为也。","book":"《史记·郦生陆贾列传》"},"example":{"text":"这种事情已经是～了。"},"similar":["屡见不鲜","司空见惯"],"usage":"作谓语、定语；指见怪不怪"},{"id":36066,"word":"累诫不戒","pinyin":"lěi jiè bù jiè","abbr":"ljbj","explanation":"诫：告诫；戒：戒备，戒除。指多次受到警告和批评仍不改正。"},{"id":36067,"word":"累足成步","pinyin":"lěi zú chéng bù","abbr":"lzcb","explanation":"比喻不断积累，便能成功。","source":{"text":"故累足成步，著备成德。","book":"宋·张君房《云笈七签》卷九十"},"similar":["聚沙成塔"],"usage":"作宾语、定语；用于劝诫人"},{"id":36068,"word":"絮果兰因","pinyin":"xù guǒ lán yīn","abbr":"xgly","explanation":"兰因：比喻美好的结合；絮果：比喻离散的结局。比喻男女婚事初时美满，最终离异。","source":{"text":"初，郑文公有贱妾曰燕姞，梦天使与己兰。","book":"春秋·鲁·左丘明《左传·宣公三年》"},"example":{"text":"玉生又道：‘骚人韵士，～’八个字更好。","book":"清·吴趼人《二十年目睹之怪现状》第32回"},"similar":["兰因絮果"],"usage":"作宾语、定语；用于夫妻"},{"id":36069,"word":"絮絮叨叨","pinyin":"xù xù dāo dāo","abbr":"xxdd","explanation":"形容说话罗嗦，唠叨。","source":{"text":"自成了人后，夜里和李郎絮叨叨到四五更鼓，番来覆去，那里睡来？","book":"明·汤显祖《紫箫记·胜游》"},"example":{"text":"那呆子～，只管念诵着陪礼，爬起来与沙僧又进。","book":"明·吴承恩《西游记》第四十九回"},"similar":["婆婆妈妈","啰啰嗦嗦"],"opposite":["干脆利索"],"usage":"作谓语、状语；指人说话"},{"id":36070,"word":"絮絮聒聒","pinyin":"xù xù guō guō","abbr":"xxgg","explanation":"唠叨不休。","source":{"text":"那十一厢禁军口里喃喃讷讷地怨怅起来，两个虞候在老都管面前絮絮聒聒地搬口。","book":"明·施耐庵《水浒传》第16回"},"example":{"text":"清·荑荻散人《玉娇梨》第一回：“当不得杨御史在旁～，只管催逼，白公又吃得一杯。”"},"similar":["絮絮叨叨"],"usage":"作谓语、状语；指人说话"},{"id":36071,"word":"絺句绘章","pinyin":"zhǐ jù huì zhāng","abbr":"cjhz","explanation":"雕琢文辞，修饰章句","source":{"text":"高祖、太宗，大难始夷，沿江左余风，絺句绘章，揣合低卬，故王杨为之伯。","book":"《新唐书·文艺传序》"},"example":{"text":"林纾《序》：“而古文一道，又岂为竞胜之具？然人卒莫胜者，载道之文，固非～者之所能掩也。”"},"similar":["絺绘章句","絺章绘句","絺辞绘句"],"usage":"作宾语、定语；用于书面语"},{"id":36072,"word":"絺章绘句","pinyin":"zhǐ zhāng huì jù","abbr":"czhj","explanation":"雕琢文辞，修饰章句","source":{"text":"变絺章绘句之习，岂薄技之能堪；以救时行道为贤，尚前猷之可仰。","book":"宋·真德秀《谢除翰林学士表》"},"example":{"text":"陶曾佑《中国文学之概观》：“唐初沿江左余风，～，固卢、骆、王、杨之特色也。”"},"similar":["絺句绘章","絺辞绘句","絺章饰句"],"usage":"作宾语、定语；用于书面语"},{"id":36073,"word":"絺章饰句","pinyin":"zhǐ zhāng shì jù","abbr":"czsj","explanation":"雕琢文辞，修饰章句","source":{"text":"历观古人作，亦有不尽佳，要其研精殚力，积数年十年而后成，自有一家面目在，夫岂徒以絺章饰句为事哉？","book":"清·王韬《自序》"},"similar":["絺章绘句","絺绘章句","絺句绘章"],"usage":"作宾语、定语；用于书面语"},{"id":36074,"word":"絺绘章句","pinyin":"zhǐ huì zhāng jù","abbr":"chzj","explanation":"雕琢文辞，修饰章句","source":{"text":"高宗试进士于南省，戒饬有司，毋以絺绘章句为工，当以渊源学问为尚。","book":"清·叶名沣《桥西杂记·宋绍兴十八年同年录》"},"similar":["絺辞绘句","絺句绘章","絺章绘句"],"usage":"作宾语、定语；用于书面语"},{"id":36075,"word":"絺辞绘句","pinyin":"zhǐ cí huì jù","abbr":"cchj","explanation":"雕琢文辞，修饰章句","source":{"text":"是诗之传……则为移风易俗之益又岂小哉！其视絺辞绘句道淫而宣骄者何如也？","book":"明·宋濂《序》"},"similar":["絺句绘章","絺绘章句"],"usage":"作宾语、定语；用于书面语"},{"id":36076,"word":"綦溪利跂","pinyin":"qí xī lì guì","abbr":"qxlq","explanation":"指故作高深，立异离群。","source":{"text":"《苟子·非十二子》：“忍情性，綦溪利跂，苟以分异人为高，不足以合大众，明大分。”王先谦集解：“綦溪，犹言极深耳，利与离同……离世独立，故曰离跂。”一说，綦溪，邪径；利跂，利其歧途而不循正途。"},"usage":"作谓语、宾语；用于书面语"},{"id":36077,"word":"縠觫伏罪","pinyin":"hú sù fú zuì","abbr":"hsfz","explanation":"縠觫：害怕颤抖的样子。十分害怕，浑身颤抖地表示认罪。","source":{"text":"二人一同入朝，公子宋随班行礼，全无縠觫伏罪之语。","book":"明·冯梦龙《东周列国志》第五十二回"}},{"id":36078,"word":"繁丝急管","pinyin":"fán sī jí guǎn","abbr":"fsjg","explanation":"繁：杂；丝：弦乐器；管：管乐器。指管弦之音繁密而急促。","source":{"text":"桃花飘俎柳垂筵，繁丝急管一时合。","book":"唐·韦应物《酒肆行》"},"similar":["繁弦急管"],"usage":"作宾语、定语；用于音乐等"},{"id":36079,"word":"繁刑重敛","pinyin":"fán xíng zhòng liǎn","abbr":"fxzl","explanation":"繁：多；敛：征收。繁重的刑罚和赋税。","source":{"text":"只为着土木疲民，况边庭黩武连年，繁刑重敛谁不怨？","book":"明·张凤翼《红拂记·张娘心许》"},"similar":["繁刑重赋"],"usage":"作主语、宾语、定语；用于政策等"},{"id":36080,"word":"繁刑重赋","pinyin":"fán xíng zhòng fù","abbr":"fxzf","explanation":"繁重的刑罚和赋税。","source":{"text":"齐景公不繁刑重赋，虽有田氏，齐不可取。","book":"宋·苏轼《东坡志林》卷五"},"example":{"text":"只为着土木疲民，况边庭黩武连年，繁刑重敛谁不怨？","book":"明·张凤翼《红拂记·张娘心许》"},"similar":["繁刑重敛"],"usage":"作主语、宾语、定语；用于政策等"},{"id":36081,"word":"繁剧纷扰","pinyin":"fán jù fēn rǎo","abbr":"fjfr","explanation":"繁剧：极其繁杂；纷扰：纷乱干扰。极其繁杂而纷乱的干扰。","source":{"text":"坐之于繁剧纷扰之中而不乱。","book":"宋·苏洵《养才》"},"usage":"作定语、状语；用于书面语"},{"id":36082,"word":"繁华损枝","pinyin":"fán huá sǔn zhī","abbr":"fhsz","explanation":"比喻文采过于华丽，将损及文章内容。","source":{"text":"然逐末之俦，蔑弃其本，虽读千赋，愈惑体要，遂使繁华损枝，膏谀害骨，无贵风轨，莫益劝戒。","book":"南朝·梁·刘勰《文心雕龙·诠赋》"},"usage":"作宾语、定语；用于作文等"},{"id":36083,"word":"繁华胜地","pinyin":"fán huá shèng dì","abbr":"fhsd","explanation":"繁华：热闹，繁盛；胜地：有名且风景优美的地方。热闹的名胜之地。","source":{"text":"因游学来至嘉禾地方，这是古秀州，乃江南繁华胜地。","book":"元·武汉臣《玉壶春》第一折"},"usage":"作宾语、定语；用于口语"},{"id":36084,"word":"繁弦急管","pinyin":"fán xián jí guǎn","abbr":"fxjg","explanation":"形容各种乐器同时演奏的热闹情景。","source":{"text":"作暮雨兮愁空山，悲急管，思繁弦。","book":"唐·王维《送神曲》"},"example":{"text":"～催献酬，倏若飞空生羽翼。","book":"唐·钱起《玛瑙杯歌》"},"similar":["繁丝急管"],"usage":"作宾语、定语；形容多种乐器同时演奏的情景"},{"id":36085,"word":"繁征博引","pinyin":"fán zhēng bó yǐn","abbr":"fzby","explanation":"引用多方面的资料作为证明。","example":{"text":"说明这样简单的问题，不需要小题大作，～，只须简明扼要地解说一下就够了。"}},{"id":36086,"word":"繁文末节","pinyin":"fán wén mò jié","abbr":"fwmj","explanation":"文：规定、仪式；节：礼节。过分繁琐的仪式和礼节。比喻琐碎多余的事情。","source":{"text":"议者必又曰：省去繁文末节，则一岁可以再郊。","book":"宋·苏轼《上圆丘合祭六议》"},"example":{"text":"故世之～圣人之所以穷神知化者也。","book":"宋·陈亮《经书发题·礼记》"},"similar":["繁文缛节"],"opposite":["言简意赅"],"usage":"作宾语、定语；指琐碎多余的事项"},{"id":36087,"word":"繁文缛礼","pinyin":"fán wén rù lǐ","abbr":"fwrl","explanation":"繁：杂而多；文：仪式；缛：繁重。过分繁琐的仪式或礼节。也比喻其他繁琐多余的事项。","source":{"text":"朕明年有事于南郊，谒清宫，朝太庙，繁文缛礼，予心懵然。","book":"唐·元稹《王永太常博士制》"},"example":{"text":"他非常注意浮面上的～，以为这是士大夫门第的必不可少的家教。","book":"曹禺《北京人》第一幕"},"similar":["繁文缛节","烦文缛礼","繁文末节"],"usage":"作主语、宾语、分句；比喻烦琐、多余"},{"id":36088,"word":"繁文缛节","pinyin":"fán wén rù jié","abbr":"fwrj","explanation":"文：规定、仪式；缛：繁多；节：礼节。过分繁琐的仪式或礼节。也比喻其他繁琐多余的事项。","source":{"text":"仪者必又曰：省去繁文末节，则一岁可以再郊。","book":"宋·苏轼《上圆丘合祭六仪》"},"example":{"text":"不知道南宋比现今如何，但对外敌，却明明已经称臣，惟独在国内特多～以及唠叨的碎话。","book":"鲁迅《坟·看镜有感》"},"similar":["附赘悬疣","连篇累牍"],"usage":"作主语、宾语、分句；比喻烦琐、多余"},{"id":36089,"word":"繁枝细节","pinyin":"fán zhī xì jié","abbr":"fzxj","explanation":"繁多且细小的枝节。比喻事物的琐细部分。","source":{"text":"这种单纯的对照教人觉得这座建筑是整整的一块。好像直上云霄的松柏，老干亭亭，没有一些繁枝细节。","book":"朱自清《罗马》"},"example":{"text":"做事情不能光考虑这些～。"},"usage":"作宾语、定语；比喻事物的琐细部分"},{"id":36090,"word":"繁礼多仪","pinyin":"fán lǐ duō yí","abbr":"fldy","explanation":"礼节繁重，仪式太多。形容过分地讲究排场。","source":{"text":"今绍有十败，公有十胜，绍兵虽盛，不足惧也。绍繁礼多仪，公体任自然，此道胜也。","book":"明·罗贯中《三国演义》第十八回"},"usage":"作谓语、宾语、定语；用于交往等"},{"id":36091,"word":"繁称博引","pinyin":"fán chēng bó yǐn","abbr":"fcby","explanation":"繁：多；博：广。指行文中的广泛援引。","source":{"text":"而论文但崇体要，不尚繁称博引。","book":"清·曾国藩《序》"},"similar":["旁征博引"],"usage":"作谓语、宾语；用于写作"},{"id":36092,"word":"繁花似锦","pinyin":"fán huā sì jǐn","abbr":"fhsj","explanation":"繁：多而且茂盛。锦：织有彩色花纹的锦缎。许多色彩纷繁的鲜花，好像富丽多彩的锦缎。形容美好的景色和美好的事物。","source":{"text":"我们坐在……繁花似锦的花丛中，听她谈起沙村公社来。","book":"曹靖华《点苍山下金花娇》"},"example":{"text":"春天的世博园，～，五彩缤纷。"},"similar":["满园春色","花红柳绿"],"opposite":["残枝败柳"],"usage":"作谓语、定语；形容百花盛开的景象"},{"id":36093,"word":"繁荣兴旺","pinyin":"fán róng xīng wàng","abbr":"frxw","explanation":"形容事业或经济状况发达昌盛，生机蓬勃。","example":{"text":"祖国的繁荣兴旺是我们的义务。"},"similar":["繁荣昌盛","兴旺发达","欣欣向荣"],"opposite":["满目疮痍","赤地千里"],"usage":"作宾语、定语、补语；形容事业兴旺发达"},{"id":36094,"word":"繁荣富强","pinyin":"fán róng fù qiáng","abbr":"frfq","explanation":"形容各项事业蓬勃发展，日益富足强大。","source":{"text":"我们的祖国，更加繁荣富强。","book":"峻青《壮志录》"},"example":{"text":"祖国的～离不开每个劳动者的辛勤劳动。"},"similar":["繁荣昌盛","兴旺发达","蒸蒸日上"],"opposite":["赤地千里","民困国贫"],"usage":"作谓语、定语、补语；指国家等"},{"id":36095,"word":"繁荣昌盛","pinyin":"fán róng chāng shèng","abbr":"frcs","explanation":"繁荣：兴旺发达；昌盛：兴旺。指国家兴旺发达，欣欣向荣。","source":{"text":"为什么不能在胜利以后建设一个繁荣昌盛的国家呢？","book":"毛泽东《中国人民站起来了》"},"example":{"text":"中国现在越来越～了。"},"similar":["兴旺发达","蒸蒸日上","欣欣向荣"],"opposite":["满目疮痍","江河日下","国破家亡"],"usage":"作谓语、定语；指社会或事物等"},{"id":36096,"word":"繁言蔓词","pinyin":"fán yán màn cí","abbr":"fymc","explanation":"蔓：蔓延。繁多而头绪纷杂的言词。表示说话、写文章烦琐而不简炼。","source":{"text":"踣毙沉埋，岂繁言蔓词之为渎。","book":"宋·陈亮《谢罗尚书启》"},"similar":["烦言碎语"],"usage":"作主语、宾语、定语；用于文章或说话等"},{"id":36097,"word":"繁音促节","pinyin":"fán yīn cù jié","abbr":"fycj","explanation":"繁：杂；促：急迫，急促。繁密的音调，急促的节奏。","source":{"text":"乐府之妙，全在繁音促节，其来于于，其去徐徐。","book":"清·沈德潜《说诗晬语》上卷"},"example":{"text":"这支乐曲虽然大多是～，但还是婉转动人。"},"similar":["繁弦急管"],"usage":"作主语、宾语、定语；用于音乐等"},{"id":36098,"word":"繁鸟萃棘","pinyin":"fán niǎo cuì jí","abbr":"fncj","explanation":"萃：聚集；棘：酸枣树。众多的鸟儿聚集在树上。表示虽无人在旁，还有许多鸟看着。比喻暗中干坏事是掩盖不住的。","source":{"text":"何繁鸟萃棘，负子肆情。","book":"《楚辞·天问》"},"usage":"作宾语、定语；多用于比喻句","story":["战国时期，晋国大夫解居父受到吴国的聘任，在上任的途中，路过陈国的墓门，看到一个年轻的妇人报着幼子在路边，想上前去调戏她，以发泄自己的情欲。那妇人引用《诗经》的诗句：“墓门有棘，有鸮萃止。”来解围，解居父只好作罢"]},{"id":36099,"word":"纚风沐雨","pinyin":"xǐ fēng mù yǔ","abbr":"lfmy","explanation":"纚：古代束发的布帛。风吹头，雨洗发。形容四处奔波，十分辛苦。","source":{"text":"执事自西北控东南之议不复可行，恐纚风沐雨正无已时。","book":"清·冯桂芬《公启曾协揆》"},"similar":["栉风沐雨"],"usage":"作宾语、定语；用于书面语"},{"id":36100,"word":"纠合之众","pinyin":"jiū hé zhī zhòng","abbr":"jhzz","explanation":"指纠集起来的百姓。","source":{"text":"足下起纠合之众，收散乱之兵，不满万人。","book":"《史记·郦生陆贾列传》"},"similar":["乌合之众"],"usage":"作宾语；指乌合之众"},{"id":36101,"word":"纠缠不清","pinyin":"jiū chán bù qīng","abbr":"jcbq","explanation":"形容纷乱，理不出头绪。亦指有意找麻烦，抓住一点不肯放手。","source":{"text":"秋痕叹道：‘你如今一请就来，往后又是纠缠不清。","book":"清·魏子安《花月痕》第25回"},"example":{"text":"你怎么老是跟他～。"},"similar":["藕断丝连","牵扯不清"],"opposite":["一刀两断"],"usage":"作谓语、宾语；指混乱"},{"id":36102,"word":"纠缪绳违","pinyin":"jiū miù shéng wéi","abbr":"jmsw","explanation":"缪：通“谬”。纠正错误，对违法者绳之以法。","source":{"text":"入梁，为御史司宪，纠缪绳违，不避豪右。","book":"《旧五代史·唐书·崔沂传》"},"usage":"作谓语、宾语；用于改正"},{"id":36103,"word":"纡余为妍","pinyin":"yū yú wéi yán","abbr":"yywy","explanation":"纡余：指有才气的人态度从容大方；妍：美。指人的才气、气度也是一种美。纡余：指有才气的人态度从容大方；妍：美。指人的才气、气度也是一种美。","source":{"text":"登明选公，杂进巧拙，纡余为妍，卓荦为杰，校短量长，惟器是适者，宰相之方也。","book":"唐·韩愈《进学解》"}},{"id":36104,"word":"纡余委备","pinyin":"yū yú wěi bèi","abbr":"yywb","explanation":"纡余：婉转回旋有余；委：委曲；备：详备。婉转回旋有余且委曲详备。形容文章写的非常婉转、曲折。","source":{"text":"执事之文，纡余委备，往复百折，而条达疏畅，无所间断。","book":"宋·苏洵《上欧阳内翰第一书》"}},{"id":36105,"word":"纡佩金紫","pinyin":"yū pèi jīn zǐ","abbr":"ypjz","explanation":"身佩印绶。指身居高位。金，指印；紫，指绶色。","source":{"text":"纡佩金紫，光国垂勋。","book":"汉·蔡邕《陈太丘碑文》"},"example":{"text":"猥先诸君～，且喜且惭。","book":"《后汉书·马援传》"},"similar":["纡金曳紫","纡青佩紫"],"usage":"作谓语、定语；用于书面语"},{"id":36106,"word":"纡尊降贵","pinyin":"yū zūn jiàng guì","abbr":"yzjg","explanation":"纡：屈抑。指地位高的人降低身分，做本不应自己做的事。","source":{"text":"降贵纡尊，躬刊手掇。","book":"南朝·梁·简文帝《昭明太子集序》"},"example":{"text":"乃实由～，自放弃贵族之特权，以结欢于处士。","book":"清·梁启超《中国专制政治进化史论》"},"similar":["降贵纡尊"],"usage":"作谓语、宾语；指贵人"},{"id":36107,"word":"纡朱怀金","pinyin":"yū zhū huái jīn","abbr":"yzhj","explanation":"纡：系结；朱：朱绂，系印的红色丝带；怀：怀藏；金：金印。比喻做了大官。","source":{"text":"或曰使我纡朱怀金，其乐不可量也。","book":"汉·扬雄《法言·学行》"},"example":{"text":"若夫高冠长剑，～者，布满宫闱。","book":"《后汉书·宦者传序》"},"similar":["纡青拖紫"],"usage":"作谓语、定语；指做了大官"},{"id":36108,"word":"纡朱拖紫","pinyin":"yū zhū tuō zǐ","abbr":"yztz","explanation":"形容地位显贵。同“纡朱曳紫”。","source":{"text":"若并如今是全活，纡朱拖紫且开眉。","book":"唐·白居易《岁暮寄微之》诗之三"},"example":{"text":"～，揖让人主之前；当轴秉衡，平章军国之重。","book":"明·张居正《再辞恩命疏》"},"similar":["纡青拖禁","纡朱曳紫","纡青佩紫"],"usage":"作谓语、定语；用于书面语"},{"id":36109,"word":"纡朱曳紫","pinyin":"yū zhū yè zǐ","abbr":"yzyz","explanation":"形容地位显贵。朱、紫指高官所佩印绶之颜色。","source":{"text":"何必纡朱曳紫，服冕乘轺。","book":"晋·葛洪《抱朴子·逸民》"},"similar":["纡朱拖紫"],"usage":"作谓语、定语；用于书面语"},{"id":36110,"word":"纡郁难释","pinyin":"yū yù nán shì","abbr":"yyns","explanation":"纡郁：几经蕴结的愁苦；释：化解。几经蕴结的愁苦、忧患难以化解。","source":{"text":"愿假簧以舒忧兮，志纡郁其难释。","book":"汉·刘向《九叹·忧苦》"},"usage":"作谓语、定语；用于处事"},{"id":36111,"word":"纡金曳紫","pinyin":"yū jīn yè zǐ","abbr":"yjyz","explanation":"佩带金印紫绶。指身居高位。","source":{"text":"纡金曳紫者，多摧兰折玉之叹。","book":"明·袁宗道《贺阳曲金令君父母荣封序》"},"similar":["纡金拖紫","纡佩金紫"],"usage":"作谓语、定语；用于书面语"},{"id":36112,"word":"纡青佩紫","pinyin":"yū qīng pèi zǐ","abbr":"yqpz","explanation":"比喻显贵。同“纡青拖紫”。","source":{"text":"外呈厚貌，内蕴百心，繇是则纡青佩紫，牧州典郡。","book":"《隋书·卢思道传》"},"similar":["纡青拖紫","纡佩金紫","纡朱拖紫"],"usage":"作谓语、定语；用于书面语"},{"id":36113,"word":"纡青拖紫","pinyin":"yū qīng tuō zǐ","abbr":"yqtz","explanation":"纡：系结；青、紫：古代官吏抽佩印绶的颜色。比喻地位显贵。","source":{"text":"纡青拖紫，朱丹其毂。","book":"汉·扬雄《解嘲》"},"example":{"text":"当时历金门，上玉堂，～，朱丹其毂者，一出王氏之学而已。","book":"宋·毛滂《上苏内翰书》"},"similar":["纡青佩紫"],"usage":"作谓语、定语；指贵人"},{"id":36114,"word":"红不棱登","pinyin":"hóng bù lēng dēng","abbr":"hbld","explanation":"令人生厌的红色。","example":{"text":"那件衣服洗得～的，难看极了。"},"usage":"作定语、状语；用于口语"},{"id":36115,"word":"红丝待选","pinyin":"hóng sī dài xuǎn","abbr":"hsdx","explanation":"指为女择婿。","source":{"text":"元振欣然从命，遂牵一红丝线，得第三女，大有姿色，后果随夫贵达也。","book":"五代·王仁裕《开元天宝遗事·牵红丝娶妇》"},"example":{"text":"红楼此日，～，须教红叶传情。","book":"明·高则诚《琵琶记·奉旨招婿》"},"usage":"作宾语、定语；用于择亲","story":["传说古代郭元振年轻时很有才艺，而且风度翩翩，宰相张嘉正想招他为婿。元振知道他有五个女儿，不知许配哪个。张宰相想出一个办法，让五个女儿各持一条丝线站在丝幔前，元振牵上一条红丝线，于是得到他的第三个美女。后来随夫贵达"]},{"id":36116,"word":"红丝暗系","pinyin":"hóng sī àn jì","abbr":"hsax","explanation":"相传月下老人掌管人间的姻缘，以红绳系夫妇之足。旧指男女双方经由媒人介绍而成亲。","source":{"text":"固问囊中何物，曰：‘赤绳子耳！以系夫妻之足，及其生则潜用相系，虽仇敌之家，贵贱悬隔，天涯从宦，吴楚异乡，此绳一系，终不可绾。’","book":"唐·李复言《续玄怪录·定婚店》"},"example":{"text":"还不曾～，先弄得白刃相加。","book":"清·文康《儿女英雄传》第十回"},"similar":["红绳系足","赤绳系足"],"usage":"作宾语、定语；指男女结成婚姻"},{"id":36117,"word":"红光满面","pinyin":"hóng guāng mǎn miàn","abbr":"hgmm","explanation":"形容人的气色好，脸色红润，满面光彩。","source":{"text":"嘴边衔著牙嘴香烟，鼻端架著墨晶眼镜，红光满面，气象不同，直上楼头，东张西望。","book":"清·韩邦庆《海上花列传》第37回"},"example":{"text":"她～，精神很好。"},"similar":["春风满面"],"opposite":["面黄肌瘦"],"usage":"作谓语、定语；指人的气色"},{"id":36118,"word":"红口白牙","pinyin":"hóng kǒu bái yá","abbr":"hkby","explanation":"指一口咬定或指某句话确实说过。","source":{"text":"你不要红口白牙枉说我的娃娃！金富不是那样的人！他是我的小子，是好是坏碍不着两旁世人。","book":"路遥《平凡的世界》第三卷第十章"},"example":{"text":"他～地咬定了此事。"},"similar":["赤口白牙"],"usage":"作宾语、状语；指一口咬定"},{"id":36119,"word":"红叶之题","pinyin":"hóng yè zhī tí","abbr":"hyzt","explanation":"红叶上题的诗。比喻姻缘巧合或天赐良缘。","source":{"text":"毕竟是百年姻眷了，数当明白。相会有日，君不见红叶之题乎？","book":"明·张景《飞丸记·旅邸揣摩》"},"similar":["红叶题诗"],"usage":"作宾语、定语；比喻姻缘的巧合","story":["唐僖宗巡视四川带去宫中侍书宫娥芳子，芳子很有学问，一天她在红叶上题诗：“流水何太急？深宫尽日闲。殷勤谢红叶，好去到人间。”，题完后就顺手抛进水沟，被襄州进士李茵拾到，恰好在一山民家相遇，两人遂成良缘"]},{"id":36120,"word":"红叶题诗","pinyin":"hóng yè tí shī","abbr":"hyts","explanation":"唐代宫女良缘巧合的故事。比喻姻缘的巧合。","source":{"text":"唐·孟棨《本事诗》载红叶题诗的故事。"},"similar":["红叶之题"],"usage":"作宾语、定语；比喻姻缘的巧合","story":["唐僖宗巡视四川带去宫中侍书宫娥芳子，芳子很有学问，一天她在红叶上题诗：“流水何太急？深宫尽日闲。殷勤谢红叶，好去到人间。”，题完后就顺手抛进水沟，被襄州进士李茵拾到，恰好在一山民家相遇，两人遂成良缘"]},{"id":36121,"word":"红头文件","pinyin":"hóng tóu wén jiàn","abbr":"htwj","explanation":"党、政机关下发的文件，刊头的名称常印成红字。","source":{"text":"这是中央的‘红头文件’，还是田专员的信口开河？","book":"路遥《平凡的世界》第三卷第四章"},"example":{"text":"我们不能小看那些～的作用。"},"usage":"作主语、宾语、定语；指政府公函"},{"id":36122,"word":"红妆素裹","pinyin":"hóng zhuāng sù guǒ","abbr":"hzsg","explanation":"红妆：妇女的红色装饰；素裹：淡雅装束。指妇女艳丽和淡雅装束。用以形容雪过天晴，红日和白雪交相辉映的美丽景色。","source":{"text":"须晴日，看红妆素裹，分外妖娆。","book":"毛泽东《沁园春·雪》"},"example":{"text":"早晨雪停了，好一派～的绚丽景象。"},"usage":"作宾语、定语、状语；形容雪过天晴的景象"},{"id":36123,"word":"红尘客梦","pinyin":"hóng chén kè mèng","abbr":"hckm","explanation":"旧时比喻尘世虚幻或在官场追名逐利的无聊生涯。","source":{"text":"遥望见城南苍翠山色好，把红尘客梦全消。","book":"清·孔尚任《桃花扇·归山》"},"usage":"作宾语、定语；用于口语"},{"id":36124,"word":"红得发紫","pinyin":"hóng dé fā zǐ","abbr":"hdfz","explanation":"形容一个人走红，受重视到了过分的程度。","source":{"text":"她仗着出身好，业务好，红得发紫。","book":"靳凡《公开的情书》"},"example":{"text":"他在公司～。"},"similar":["大红大紫"],"opposite":["默默无闻"],"usage":"作谓语、定语；形容名人"},{"id":36125,"word":"红情绿意","pinyin":"hóng qíng lǜ yì","abbr":"hqly","explanation":"红：指红花；绿：指绿叶。形容艳丽的春天景色。","source":{"text":"花随红意发，叶就绿情新。","book":"唐·赵彦昭《立春日侍宴内出剪彩花应制》"},"example":{"text":"～知多少，尽入泾川万树花。","book":"宋·文同《约春》诗"},"usage":"作宾语、定语；形容艳丽的春日景色"},{"id":36126,"word":"红愁绿惨","pinyin":"hóng chóu lǜ cǎn","abbr":"hclc","explanation":"比喻愁思满怀，容易伤感。","source":{"text":"我则见绿惨红愁减了精神，为何因，背地里将啼痕来揾。","book":"元·无名氏《村乐堂》第四折"},"example":{"text":"画眉人去，兰闺深掩。羞见差池双燕，～。","book":"元·顾大典《青衫记·蛮素闻捷》"},"similar":["惨红愁绿"],"usage":"作谓语、宾语；指人的心情"},{"id":36127,"word":"红旗报捷","pinyin":"hóng qí bào jié","abbr":"hqbj","explanation":"清代军队出征，打了胜仗，派专人手持红旗，急驰进京报捷。现用作报喜的意思。","source":{"text":"刚才部里来送信，说剑南倭寇已被文隐平定，一两日就有红旗报捷到京。","book":"清·李汝珍《镜花缘》第六十四回"},"example":{"text":"指日～，甚么司马黄堂，都是指顾间事。","book":"清·李宝嘉《官场现形记》第十二回"},"usage":"作宾语；用作报喜的意思"},{"id":36128,"word":"红旗招展","pinyin":"hóng qí zhāo zhǎn","abbr":"hqzz","explanation":"招展：飘动。形容气势壮大，场面热烈。","source":{"text":"法正见曹兵倦怠，锐气已堕，多下马坐息，乃将红旗招展。鼓角齐鸣，喊声大震。","book":"明·罗贯中《三国演义》第七十一回"}},{"id":36129,"word":"红日三竿","pinyin":"hóng rì sān gān","abbr":"hrsg","explanation":"指天已大亮，时候不早。","source":{"text":"永明五年十一月丁亥，日出高三竿，朱色赤黄。","book":"《南齐书·天文志上》"},"example":{"text":"《南齐书·天文志上》：“永明五年十一月丁亥，日出高三竿，朱色赤黄。”"},"similar":["日高三丈","日出三竿"],"opposite":["半夜三更"],"usage":"作宾语、状语；指天已大亮，时候不早"},{"id":36130,"word":"红晕冲口","pinyin":"hóng yùn chōng kǒu","abbr":"hyck","explanation":"晕：光影色泽模糊的部分；口：指马的嘴部。马的嘴唇色泽鲜艳。形容马匹优良，十分好看。","source":{"text":"红晕冲口，紫光腾目，言马之俊也。","book":"宋·叶廷珪《海录碎事·鸟兽·马驴》"}},{"id":36131,"word":"红杏出墙","pinyin":"hóng xìng chū qiáng","abbr":"hxcq","explanation":"形容春色正浓，情趣盎然。","source":{"text":"春色满园关不住，一支红杏出墙来。","book":"宋·叶绍翁《游小园不值》诗"},"example":{"text":"你要小心她干出～的事来。"},"usage":"作主语；指妻子有外遇"},{"id":36132,"word":"红灯绿酒","pinyin":"hóng dēng lǜ jiǔ","abbr":"hdlj","explanation":"指欢乐的生活。形容奢侈糜烂的生活。","source":{"text":"遥闻长官高堂上，红灯绿酒欢未足。","book":"清·黄遵宪《邻妇叹》诗"},"example":{"text":"今日何在，正是故国的岁除，～之间不知有多少盈盈的笑语。","book":"冰心《寄小读者》"},"similar":["灯红酒绿"],"usage":"作主语、定语；指生活糜烂"},{"id":36133,"word":"红炉点雪","pinyin":"hóng lú diǎn xuě","abbr":"hldx","explanation":"大火炉里放进一点雪，立即融化。比喻领悟、接受迅速，思想改变快。","source":{"text":"颜子克己，若红炉点雪，不必言难，天下归仁。","book":"《高子遗书·会语》"},"example":{"text":"诗得一字之师，如～，乐不可言。","book":"清·袁枚《随园诗话》第四卷"},"similar":["洪炉点雪"],"usage":"作宾语；比喻对问题领会极快"},{"id":36134,"word":"红男绿女","pinyin":"hóng nán lǜ nǚ","abbr":"hnln","explanation":"指穿着各种漂亮服装的青年男女。","source":{"text":"红男绿女，到如今野草荒田。","book":"清·舒位《修箫谱传奇》"},"example":{"text":"没有人这么早来逛庙，他自己也并不希望看见什么豆汁摊子，大糖葫芦，沙雁，风车与那些～。","book":"老舍《四世同堂》三十五"},"similar":["绿女红男"],"usage":"作主语、宾语；指穿着漂亮服装的青年男女"},{"id":36135,"word":"红瘦绿肥","pinyin":"hóng shòu lǜ féi","abbr":"hslf","explanation":"绿叶茂盛，红花凋谢。形容暮春景色。","source":{"text":"画桥流水飞花舞，柳外斜风细雨。红瘦绿肥春暮，肠断桃源路。","book":"宋·吴礼文《桃源忆故人暮春》词"},"similar":["绿肥红瘦"],"usage":"作主语、宾语、定语；指暮春景色"},{"id":36136,"word":"红白喜事","pinyin":"hóng bái xǐ shì","abbr":"hbxs","explanation":"红指结婚做寿，白指丧事，并到一起说就是红白喜事。","source":{"text":"居家不易是长安，俭约持躬稍自宽；最怕人情红白事，知单一到便为难。","book":"清·杨静亭《都门杂咏·时尚门·知单》"},"example":{"text":"我可能也还要为～奔走，只要是和人民大众有关的～也就是我的现实。","book":"郭沫若《新缪司九神礼赞》"},"similar":["婚丧喜事"],"usage":"作主语、宾语、定语；用于口语"},{"id":36137,"word":"红粉青楼","pinyin":"hóng fěn qīng lóu","abbr":"hfql","explanation":"红粉：原指红色的铅粉，为女子化妆用品，后借指美女；青楼：妓院。泛称有女色或可寻欢的场合。","source":{"text":"若舞衫歌扇，转瞬皆非，红粉青楼，当场即幻，还讲甚么情呢？","book":"清·魏秀仁《花月痕》第一回"},"example":{"text":"我们不能接近～。"},"usage":"作宾语；指歌楼妓院"},{"id":36138,"word":"红粉青蛾","pinyin":"hóng fěn qīng é","abbr":"hfqe","explanation":"红粉：原指红色的铅粉，为女子化妆用品，后借指美女；青蛾：青色蛾眉。指美人。","source":{"text":"红粉青蛾映楚云，桃花马上石榴裙。","book":"唐·杜审言《戏赠赵使君美人》诗"},"usage":"作主语、宾语、定语；用于女性"},{"id":36139,"word":"红紫乱朱","pinyin":"hóng zǐ luàn zhū","abbr":"hzlz","explanation":"古以朱为正色，紫为杂色。红紫乱朱指杂色混乱正色。比喻邪道取代正道。","source":{"text":"正涂壅底，仁义荒怠，佞伪驰骋，红紫乱朱。","book":"《论语·阳货》：“子曰：恶紫之夺朱也。”《孟子注疏·赵岐·题辞》"},"similar":["红紫夺朱"],"usage":"作宾语、定语；用于比喻句"},{"id":36140,"word":"红紫夺朱","pinyin":"hóng zǐ duó zhū","abbr":"hzdz","explanation":"夺：强取；朱：朱红，正红色。用间色的紫色取代正色的朱红。比喻以邪夺正。","source":{"text":"恶紫之夺朱也，恶郑声之乱雅乐也。","book":"春秋·鲁·孔丘《论语·阳货》"},"similar":["红紫乱朱"],"usage":"作宾语、定语；用于比喻句"},{"id":36141,"word":"红红火火","pinyin":"hóng hóng huǒ huǒ","abbr":"hhhh","explanation":"形容旺盛或经济优裕的生活。","source":{"text":"把事办得红红火火，热热闹闹！没钱？借！","book":"路遥《平凡的世界》第二卷第30章"},"example":{"text":"祝你们的小日子过得～。"},"usage":"作定语、状语；用于口语"},{"id":36142,"word":"红绳系足","pinyin":"hóng shéng jì zú","abbr":"hsjz","explanation":"旧指男女双方经由媒人介绍而成亲。","source":{"text":"固问囊中何物，曰：‘赤绳子耳！以系夫妻之足，及其生则潜用相系，虽仇敌之家，贵贱悬隔，天涯从宦，吴楚异乡，此绳一系，终不可绾。’","book":"唐·李复言《续玄怪录》"},"similar":["赤绳系足"],"usage":"作宾语、定语；指男女结成婚姻","story":["古代杜陵少年韦固，一天在路上遇到一个靠着红布囊席地而坐的老人，觉得奇怪，就去问老人。老人说他是主管天下婚姻的，囊中的红绳是用来将夫妻的脚系在一起的，不管他们两人相隔多远，终究会走到一起的，如果断裂就夫妻离散"]},{"id":36143,"word":"红羊劫年","pinyin":"hóng yáng jié nián","abbr":"hyjn","explanation":"红羊：古时迷信，认为丁未年是容易发生灾祸的年份，丁属火，未属羊，故称红羊。指国家或个人遭受灾难的岁月。","source":{"text":"太平从此销兵甲，记取红羊换劫年。","book":"唐·殷尧藩《李节度平虏诗》"},"example":{"text":"一年几度见明月，况值红羊换劫年。万里河山方破碎，一家儿女共团圆。","book":"清·丘逢甲《题仲迟月中课读图》诗"}},{"id":36144,"word":"红脸赤颈","pinyin":"hóng liǎn chì jǐng","abbr":"hlcj","explanation":"形容十分激动。","source":{"text":"红脸赤颈的宋旺也嚷嚷：他不是汉奸的家属，一直在仗势欺人吗！","book":"孔厥《新儿女英雄续传》"},"example":{"text":"他们为此事争得～。"},"similar":["脸红脖子粗"],"usage":"作定语、状语；形容十分激动"},{"id":36145,"word":"红腐贯朽","pinyin":"hóng fǔ guàn xiǔ","abbr":"hfgx","explanation":"红腐：米粟经久腐坏，色变红赤；贯朽：贯钱绳索朽烂。形容钱粮之多。","source":{"text":"太仓之粟红腐而不可食，都内之钱贯朽而不可挍。","book":"《汉书·贾捐之传》"},"example":{"text":"如仓库无～之积，军士无超距投石之勇，只是旋收旋支，或鼓或罢，终是不成头绪。","book":"宋·朱熹《与刘子澄》"},"similar":["贯朽粟红"],"usage":"作宾语、定语；指人很富有"},{"id":36146,"word":"红衰翠减","pinyin":"hóng shuāi cuì jiǎn","abbr":"hscj","explanation":"红：指花；翠：指绿叶。红花衰败，绿叶减少。形容春尽花残或初秋百花凋谢的景象。","source":{"text":"渐霜风凄紧，关河冷落，残照当楼，是处红衰翠减，苒苒物华休。","book":"宋·柳永《八声甘州》"},"usage":"作定语、谓语；指秋天的景象"},{"id":36147,"word":"红袖添香","pinyin":"hóng xiù tiān xiāng","abbr":"hxtx","explanation":"红袖：借指年轻貌美的女子；添：增加。旧指有美女伴读。","source":{"text":"从此绿鬟视草，红袖添香；眷属疑仙，文章华国。","book":"清·魏子安《花月痕》第三十一回"},"usage":"作宾语、定语；用于书面语"},{"id":36148,"word":"红装素裹","pinyin":"hóng zhuāng sù guǒ","abbr":"hzsg","explanation":"指衣着淡雅的妇女。也形容雪后天晴，红日和白雪相映衬的景色。","source":{"text":"须晴日，看红装素裹，分外妖娆。","book":"毛泽东《沁园春·雪》词"}},{"id":36149,"word":"红豆相思","pinyin":"hóng dòu xiāng sī","abbr":"hdxs","explanation":"红豆：植物名，又叫相思子，古人常用以象征爱情。比喻男女相思。","source":{"text":"红豆生南国，春来发几枝，愿君多采撷，此物最相思。","book":"唐·王维《相思》诗"},"example":{"text":"说甚～，故人轻别。","book":"清·吴焯《琵琶仙·补华楼听钱德协琵琶》"},"similar":["朝思暮想"],"usage":"作宾语、定语；比喻男女相思"},{"id":36150,"word":"红颜暗老","pinyin":"hóng yán àn lǎo","abbr":"hyal","explanation":"青春焕发的容貌在不知不觉中消逝。比喻年龄增大，容颜衰老。","source":{"text":"上阳人，红颜暗老白发新。","book":"唐·白居易《上阳白发人》"}},{"id":36151,"word":"红颜白发","pinyin":"hóng yán bái fà","abbr":"hybf","explanation":"颜：面容，脸色。头发花白，面色红润。形容老年人身体健康。指红颜少女和白发老翁。","source":{"text":"看了这红颜白发老风流，觑的那今来古往似蜉蝣。","book":"明·张伯纯《收江南·寿康对山太史》曲"},"example":{"text":"有些主人自己收婢作妾的；但～，也只空断送了她的一生！","book":"朱自清《温州的踪迹》"},"usage":"作宾语、定语；用于老年人等"},{"id":36152,"word":"红颜绿鬓","pinyin":"hóng yán lǜ bìn","abbr":"hylb","explanation":"绿鬓：乌黑发亮的鬓角。形容女子正处于青春年少时。","source":{"text":"但见它虽则随常装束，却是红颜绿鬓，俏丽动人。","book":"清·文康《儿女英雄传》第七回"},"usage":"作宾语、定语；多用于女性"},{"id":36153,"word":"红颜薄命","pinyin":"hóng yán bó mìng","abbr":"hybm","explanation":"红颜：美女的容颜；薄命：命运不好。旧时指女子容貌美丽但遭遇不好（多指早死、寡居或丈夫不好）。","source":{"text":"总则我红颜薄命。","book":"《汉书·孝成许皇后传》：“其余诚太迫急，奈何？妾薄命，端遇竟宁前。”元·无名氏《鸳鸯被》第三折"},"example":{"text":"这都是刘四妈这个花嘴，哄我落坑堕堑，致有今日，自古～，亦未必如我之甚。","book":"明·冯梦龙《醒世恒言》卷三"},"similar":["桃花薄命"],"usage":"作宾语、定语；指女子容貌美丽但遭遇不好"},{"id":36154,"word":"红飞翠舞","pinyin":"hóng fēi cuì wǔ","abbr":"hfcw","explanation":"红、翠：指服装的色彩，泛指各种颜色。形容妇女们穿着各种颜色的漂亮衣服，尽兴嬉戏，热闹非凡的情景。","source":{"text":"呼三喝四，喊七叫八，满厅中红飞翠舞，玉动珠摇，真是十分热闹。","book":"清·曹雪芹《红楼梦》第六十二回"},"usage":"作谓语、定语；用于比喻句"},{"id":36155,"word":"红鸾天喜","pinyin":"hóng luán tiān xǐ","abbr":"hltx","explanation":"红鸾：三时传说天上有红鸾星，主管人间的婚姻喜事。比喻婚姻喜事。","source":{"text":"孩儿，你可曾算我两个的八字，红鸾天喜几时到命哩？","book":"元·关汉卿《窦娥冤》第二折"}},{"id":36156,"word":"纤介不遗","pinyin":"xiān jiè bù yí","abbr":"xjby","explanation":"纤介：细微详尽；遗：遗漏。一点都没有遗漏。","source":{"text":"蒲鱼荷芡之利，皆日计月课，纤悉无遗，遂致泊旁之人，无所衣食。","book":"宋·李光《论王子献等札子》"},"similar":["纤悉无遗"],"usage":"作谓语、定语；指一点儿都没有遗漏"},{"id":36157,"word":"纤介之失","pinyin":"xiān jiè zhī shī","abbr":"xjzs","explanation":"纤介：细微。很小的过失。","source":{"text":"春秋记纤介之失。","book":"汉·董仲舒《春秋繁露·王道》"}},{"id":36158,"word":"纤介之疾","pinyin":"xiān jiè zhī jí","abbr":"xjzj","explanation":"纤介：细微。 比喻不必在意的小毛病。","source":{"text":"苟无系于社稷之存亡，则四方之劳扰，民生之憔悴，虽有诚臣，亦以为纤芥之疾也。","book":"清·黄宗羲《明夷待访录·原臣》"}},{"id":36159,"word":"纤介之祸","pinyin":"xiān jiè zhī huò","abbr":"xjzh","explanation":"形容很轻的灾害。","source":{"text":"孟尝君为相数十年，无纤介之祸者，冯谖之计也。","book":"《战国策·齐策四》"},"usage":"作宾语；形容很轻的灾害"},{"id":36160,"word":"纤介之间","pinyin":"xiān jiè zhī jiān","abbr":"xjzj","explanation":"极细微的间隙。","source":{"text":"肃宗亦孝性淳笃，恩性天至，母子慈爱，始终无纤介之间。","book":"《后汉书·马皇后纪》"},"example":{"text":"并～，一朝陨覆。","book":"《北史·古弼等传论》"}},{"id":36161,"word":"纤尘不染","pinyin":"xiān chén bù rǎn","abbr":"xcbr","explanation":"原指佛教徒修行时，排除物欲，保持心地洁净。现泛指丝毫不受坏习惯，坏风气的影响。也用来形容非常清洁、干净。","source":{"text":"一尘不染香到骨，姑射仙人风露身。","book":"唐·释道世《法苑珠林》：“若菩萨在乾土山中经行，土不著足，随岚风来，吹破土山，令散为尘，乃至一尘不著佛身。”宋·张耒《腊月小雪后圃梅开》"},"example":{"text":"书桌笔砚精良，～。","book":"明·冯梦龙《醒世恒言》卷十五"},"similar":["一尘不染"],"usage":"作谓语；指一尘不染"},{"id":36162,"word":"纤悉不苟","pinyin":"xiān xī bù gǒu","abbr":"xxbg","explanation":"苟：随便、马虎。形容对事情十分认真，丝毫也不马虎。","source":{"text":"公至则布以诚信，示之法式，纤悉不苟，宽柔而有威。","book":"唐·李宗闵《马公家庙碑》"},"example":{"text":"镇纸者则笔墨端凝，力透纸背，～，有泰山岩岩严重难独之象。","book":"清·邵梅臣《画耕偶录》"},"similar":["一丝不苟"],"opposite":["粗枝大叶"],"usage":"作谓语、定语、状语；用于处事"},{"id":36163,"word":"纤悉必具","pinyin":"xiān xī bì jù","abbr":"xxbj","explanation":"纤悉：细微详尽。细微详尽，全都载明。","source":{"text":"律于发冢之条，如知情买卖器物砖石、薰猩平园之类，纤悉必具。","book":"明·归有光《上宋明府书》"},"example":{"text":"凡促织之态貌性情，～。","book":"明·袁宏道《蓄促织》"},"usage":"作谓语、定语；用于书面语"},{"id":36164,"word":"纤悉无遗","pinyin":"xiān xī wú yí","abbr":"xxwy","explanation":"纤悉：细微详尽；遗：遗漏。一点都没有遗漏。","source":{"text":"自婴疾至于捐馆，谈笑语言，宴居自若，口占理命，纤悉无遗。","book":"唐·李珏《唐丞相太子少师牛僧孺神道碑铭序》"},"example":{"text":"日计月课，～。","book":"宋·李光《论王子献等札子》"},"similar":["滴水不漏","纤介不遗"],"usage":"作谓语、定语；指一点儿都没有遗漏"},{"id":36165,"word":"纤毫不爽","pinyin":"xiān háo bù shuǎng","abbr":"xhbs","explanation":"纤毫：细小的毫毛；爽：差错。极细微的地方也没有差错。比喻一点差错都没有。","source":{"text":"凡此四蚀，皆与臣法符同，纤毫不爽。而法兴所据，顿差十度。","book":"《宋书·律历志下》"},"example":{"text":"古人取义命名，～，如前所云以“蟠龙”名髻、乌云为发之类是也。","book":"清·李渔《闲情偶寄·声容部·鞋袜》"},"similar":["纤毫无爽","纤芥无爽","丝毫不爽"],"opposite":["天差地别"],"usage":"作谓语、定语；用于书面语"},{"id":36166,"word":"纤毫无爽","pinyin":"xiān háo wú shuǎng","abbr":"xhws","explanation":"纤毫：细小的毫毛；爽：差错。极细微的地方也没有差错。比喻一点差错都没有。","source":{"text":"至于夕伏晨见，纤毫无爽。","book":"《魏书·律历志下》"},"similar":["纤毫不爽","纤芥无爽","丝毫不爽"],"opposite":["天差地别"],"usage":"作谓语、定语；用于书面语"},{"id":36167,"word":"纤毫无犯","pinyin":"xiān háo wú fàn","abbr":"xhwf","explanation":"形容军纪严明，丝毫不加侵犯。","source":{"text":"累居显职，纤毫无犯。性慎密，寡嗜好。","book":"《梁书·孔休源传》"},"example":{"text":"文宣闻之，遣使推检，唯景安～。","book":"《北史·元景安传》"},"similar":["秋毫无犯"],"usage":"作谓语、定语；指军纪严明"},{"id":36168,"word":"纤毫毕现","pinyin":"xiān háo bì xiàn","abbr":"xhbx","explanation":"纤毫：细小的毫毛，比喻极细小的东西；毕：全。比喻极细微的东西都显现了出来。"},{"id":36169,"word":"纤纤弱质","pinyin":"xiān xiān ruò zhì","abbr":"xxrz","explanation":"纤纤：细巧。形容女子身材纤细，体质虚弱。","source":{"text":"琴仙再看第六方仙女，纤纤弱质，□辕舞凌风，有掌上轻盈之态，头上戴着金步摇，题曰：纤纤花史金仙。","book":"清·陈森《品花宝鉴》第六十回"}},{"id":36170,"word":"纤腰楚楚","pinyin":"xiān yiāo chǔ chǔ","abbr":"xycc","explanation":"楚楚：鲜明整洁的样子。形容女子身材苗条。","source":{"text":"纤腰之楚楚兮，风回雪舞；耀珠翠之的的兮，鸭绿鹅黄。","book":"清·曹雪芹《红楼梦》第五回"},"example":{"text":"校书虽为北地胭脂，面似梨花，身如杨柳，莲步盈盈，～，真个是多愁多病，令人魂消。","book":"张恨水《春明外史》第七十八回"},"usage":"作谓语、定语；多用于女性"},{"id":36171,"word":"纤芥之失","pinyin":"xiān jiè zhī shī","abbr":"xjzs","explanation":"纤芥：细微；失：过失。形容极小的过错。","source":{"text":"春秋纪纤芥之失。","book":"汉·董仲舒《春秋繁露·王道》"},"usage":"作宾语；用于书面语"},{"id":36172,"word":"纤芥之疾","pinyin":"xiān jiè zhī jí","abbr":"xjzj","explanation":"比喻不必在意的小毛病。","source":{"text":"苟无系于社稷之存亡，则四方之劳扰，民生之憔悴，虽有诚臣，亦以为纤芥之疾也。","book":"明·黄宗羲《明夷待访录·原臣》"},"example":{"text":"就是～，我们也不能大意"},"similar":["癣疥之疾"],"usage":"作主语、宾语；用于书面语"},{"id":36173,"word":"纤芥无爽","pinyin":"xiān jiè wú shuǎng","abbr":"xjws","explanation":"纤介：细微；爽：差错。极细微的地方也没有差错。比喻一点差错都没有。","source":{"text":"必使盈缩得衰，间限数合，周日小分不殊锱铢，阳历阴历纤芥无爽，损益之数验之交会，日所居度考之月蚀，上推下减，先定众条，然后历元可求，犹甲子难值。","book":"《魏书·律历志下》"},"similar":["纤毫无爽","纤毫不爽","丝毫不爽"],"opposite":["天差地别"],"usage":"作谓语、定语；用于书面语"},{"id":36174,"word":"纥字不识","pinyin":"hé zì bù shí","abbr":"gzbs","explanation":"纥：人名。连“纥”字也不认识。指文盲。","source":{"text":"臧武仲，名纥，音恨发切。唐时有误读为核者。萧颖士曰：‘汝纥字也不识耶！’俗言瞎字不识，又纥字之讹。","book":"清·翟灏《通俗编·文字》引《懒真子》"},"similar":["目不识丁"],"usage":"作谓语、定语；指人不识字"},{"id":36175,"word":"约定俗成","pinyin":"yuè dìng sú chéng","abbr":"ydsc","explanation":"约定：共同制定；俗成：大家都这样，习惯上一直沿用。指事物的名称或社会习惯往往是由人民群众经过长期社会实践而确定或形成的。","source":{"text":"名无固宜，约之以命，约定俗成谓之宜，异于约则谓之不宜。","book":"《荀子·正名》"},"example":{"text":"通行既久，居然～了。","book":"朱自清《经典常谈·四书第七》"},"similar":["蔚然成风","相沿成习","蔚成风气"],"usage":"作谓语、定语、宾语；指风俗等"},{"id":36176,"word":"约己爱民","pinyin":"yuè jǐ ài mín","abbr":"yjam","explanation":"约束自己，爱护百姓。","source":{"text":"伏愿陛下：清心寡欲，约己爱民；达孝道于先皇，布仁恩于宇下；提拔幽隐，以进贤良；屏斥奸邪，以厚风俗。","book":"明·罗贯中《三国演义》第一百四回"}},{"id":36177,"word":"约法三章","pinyin":"yuè fǎ sān zhāng","abbr":"yfsz","explanation":"原指订立法律与人民相约遵守。后泛指订立简单的条款。","source":{"text":"高祖初入关，约法三章。","book":"《史记·高祖本纪》：“与父老约，法三章耳；杀人者死，伤人及盗抵罪。”《汉书·刑法志》"},"example":{"text":"我们很郑重地和工头～，什么时候交稿，什么时候看校，什么时候拼版。","book":"邹韬奋《经历·种种尴尬》"},"usage":"作谓语、宾语；指事先约定","story":["秦末，刘邦带领义军驻军霸上，秦王子婴向刘邦投降，刘邦攻占咸阳。为了得到百姓的支持，他又退守霸上，召集关中一带的领袖开会，宣布废除秦朝的酷刑，为了维护地方安定，同时与他们约法三章：“杀人者死，伤人及盗抵罪”"]},{"id":36178,"word":"约车治装","pinyin":"yuè chē zhì zhuāng","abbr":"yczz","explanation":"约车：将马系在车前。准备车马，整理行装。泛指做出发的准备。","source":{"text":"于是约车治装，载券契而行。","book":"《战国策·齐策四》"},"usage":"作谓语、定语；用于书面语"},{"id":36179,"word":"纨扇之捐","pinyin":"wán shàn zhī juān","abbr":"wszj","explanation":"捐：弃。秋凉以后，扇子就被抛在一边不用了。旧时比喻妇女遭丈夫遗弃。","source":{"text":"裁为合欢扇，团团似月明，出入君怀袖，动摇微风发。常恐秋节至，凉飙夺炎热，弃捐箧笥中，恩情中道绝。","book":"汉·班婕妤《怨歌行》诗"},"example":{"text":"今时所重，皆在彼而不在此，即欲不为纨扇之捐，其可得乎？","book":"清·李渔《闲情偶寄·贵显浅》"}},{"id":36180,"word":"纨绔子弟","pinyin":"wán kù zǐ dì","abbr":"wkzd","explanation":"纨裤：细绢裤。衣着华美的年轻人。旧时指官僚、地主等有钱有势人家成天吃喝玩乐、不务正业的子弟。","source":{"text":"馆阁育天下英才，岂纨绔子弟得以恩泽处耶？","book":"《汉书·叙传上》：“出与王、许子弟为群，在于绮襦纨裤之间，非其好也。”《宋史·鲁宗道传》"},"example":{"text":"钱正兴在他眼底中，不过是一个～，同世界上一切～一样的。","book":"柔石《二月》六"},"similar":["膏粱子弟","花花公子"],"opposite":["发奋图强"],"usage":"作主语、宾语；指花花公子"},{"id":36181,"word":"纨绔膏粱","pinyin":"wán kù gāo liáng","abbr":"wkgl","explanation":"膏粱：精美的食品。精美的衣食。借指只知享受，什么事也不能干的富贵人家子弟。","source":{"text":"你是个纨绔膏粱，这也无怪你不知。","book":"清·文康《儿女英雄传》第八回"},"similar":["纨绔子弟"],"usage":"作宾语、定语；多用于比喻句"},{"id":36182,"word":"纨绮子弟","pinyin":"wán qǐ zǐ dì","abbr":"wqzd","explanation":"指官僚、地主等有钱有势人家成天吃喝玩乐、不务正业的子弟。","source":{"text":"然人无贤愚，皆向往河发，纨绮子弟或请纳交附河发为重。","book":"清·戴名世《汪河发墓志铭》"},"similar":["纨绔子弟"],"usage":"作主语、宾语；指花花公子"},{"id":36183,"word":"纨袴子弟","pinyin":"wán kǔ zǐ dì","abbr":"wkzd","explanation":"纨袴：细绢做成的裤子，泛指华丽衣着。旧称浮华的富贵人家子弟。","source":{"text":"馆阁育天下英才，岂纨绔子弟得以恩泽处耶？","book":"《汉书·叙传上》：“出与王、许子弟为群，在于绮襦纨裤之间，非其好也。”《宋史·鲁宗道传》"},"example":{"text":"钱正兴在他眼底中，不过是一个～，同世界上一切～一样的。","book":"柔石《二月》六"},"similar":["纨绮子弟","纨绔子弟"],"usage":"作主语、宾语；指花花公子"},{"id":36184,"word":"纨袴膏梁","pinyin":"wán kù gāo liáng","abbr":"wkgl","explanation":"纨：细绢；膏：油脂；梁：精米；膏梁：泛指富家精美的食品。华丽的服饰，精美的食品。比喻富贵人家的子弟。","source":{"text":"此犹曰纨袴膏梁之习，奈何过隆栋为朝廷重臣，以诗礼侍从朝廷，乃溺爱不明，竟以赫赫岩岩之势，公然逼臣于戌所！","book":"明·明教中人《好逑传》第十七回"},"example":{"text":"你是个～，这也无怪你不知。","book":"清·文康《儿女英雄传》第八回"}},{"id":36185,"word":"纨袴膏粱","pinyin":"wán kù gāo liáng","abbr":"wkgl","explanation":"纨绔：细绢做的裤子；膏梁：肥肉和细粮。指精美的衣食。借指富贵人家的子弟。","source":{"text":"纨绔：细绢做的裤子；膏梁：肥肉和细粮。指精美的衣食。借指富贵人家的子弟。"}},{"id":36186,"word":"纨裦子弟","pinyin":"wán kǔ zǐ dì","abbr":"wkzd","explanation":"纨裦细绢做成的裤子，泛指华丽衣着。旧称浮华的富贵人家子弟。"},{"id":36187,"word":"纨裦膏粱","pinyin":"wán kù gāo liáng","abbr":"wkgl","explanation":"纨绔细绢做的裤子；膏梁肥肉和细粮。指精美的衣食。借指富贵人家的子弟。","source":{"text":"第三回天下无能第一，古今不肖无双。寄言纨裦与膏粱莫效此儿形状。","book":"清·曹雪芹《红楼梦》"}},{"id":36188,"word":"纪渻木鸡","pinyin":"jì shěng mù jī","abbr":"jsmj","explanation":"纪渻：人名。纪渻养的斗鸡，看上去就象一只木鸡。比喻一个人的修养超过了一般人的境界。","source":{"text":"纪渻子为王养斗鸡，……几矣。鸡虽有鸣者，已无变矣，望之似木鸡矣，其德全矣；异鸡无敢应者，反走矣。","book":"《庄子·达生》"},"example":{"text":"峥嵘已介季氏甲，更以黄金饰两戈，虽有英心甘斗死，其如～何？","book":"宋·黄庭坚《养斗鸡》诗"}},{"id":36189,"word":"纪纲人伦","pinyin":"jì gāng rén lún","abbr":"jgrl","explanation":"纪纲：纲法，制度；人伦：人与人之间的关系及行为准则。封建社会中应遵守的法度纲常、行为准则。","source":{"text":"二千石官长纪纲人伦，将何以佐朕烛幽隐，劝元元，厉蒸庶，崇乡党之训哉？","book":"《汉书·武帝纪》"},"usage":"作主语、宾语、定语；指道德规范"},{"id":36190,"word":"纪纲人论","pinyin":"jì gāng rén lún","abbr":"jgrl","explanation":"纪纲：纲法，制度；人伦：人与人之间的关系及行为准则。封建社会中应遵守的法度纲常、行为准则。","source":{"text":"二千石官长纪纲人伦，将何以佐朕烛幽隐，劝元元，厉蒸庶，崇乡党之训哉？","book":"《汉书·武帝纪》"}},{"id":36191,"word":"纪群之交","pinyin":"jì qún zhī jiāo","abbr":"jqzj","explanation":"纪、群：人名，陈纪是陈群的父亲。比喻累世之交情。","source":{"text":"鲁国孔融，高才倨傲，年在纪、群之间，先与纪友，后与群交，更为纪拜，由是显名。","book":"《三国志·魏书·陈群传》"},"example":{"text":"放心，我与他家是～，关系不比寻常。"},"usage":"作宾语；用于交往等"},{"id":36192,"word":"纬地经天","pinyin":"wěi dì jīng tiān","abbr":"wdjt","explanation":"经、纬：织物的竖线叫“经”，横线叫“纬”，比喻规划。规划天地。形容人的才能极大，能做非常伟大的事业。","source":{"text":"天六地五，数之常也。经之以天，纬之以地。","book":"《左传·昭公二十八年》：“经纬天地曰文。”《国语·周语》"},"example":{"text":"开物成务，～，则齐中书监尚书令太尉南昌文献公其人也。","book":"唐·李翰《凤阁王侍郎传论赞》"},"similar":["经天纬地"],"usage":"作谓语、定语；用于人的才能"},{"id":36193,"word":"纬武经文","pinyin":"wěi wǔ jīng wén","abbr":"wwjw","explanation":"指有文有武，有治理国家的才能。","source":{"text":"彼美齐献，卓尔不群，自家刑国，纬武经文。","book":"《晋书·文六王传赞》"},"example":{"text":"建功立业争先赴，～大有为。","book":"《太平天国·天情道理书》"},"similar":["经文纬武"],"usage":"作谓语、定语；指治理国家"},{"id":36194,"word":"纯一不杂","pinyin":"chún yī bù zá","abbr":"cybz","explanation":"纯：纯粹；一：单一；杂：驳杂，不纯洁。形容纯粹、单一，没有杂质。","source":{"text":"东林党也有小人，古今来无纯一不杂的君子群。","book":"鲁迅《“题未定”草》"},"usage":"作谓语、定语；形容纯洁"},{"id":36195,"word":"纯属骗局","pinyin":"chún shú piàn jú","abbr":"cspj","explanation":"纯粹是一个骗局。","example":{"text":"他的这种做法纯属骗局。"},"usage":"作谓语、宾语；指骗人","story":["春秋战国时一个卫国人对燕王说他能在棘刺的尖上刻一只猕猴，燕王大喜，给他高薪厚待。燕王急于要看猕猴，卫国人提出燕王不与妃嫔睡觉等苛刻条件才能看得见。燕王听信郑国铁匠的意见，提出要看卫国人的刻刀，卫国人只好潜逃"]},{"id":36196,"word":"纯正无邪","pinyin":"chún zhèng wú xié","abbr":"czwx","explanation":"邪：不正当。纯洁真挚，没有一点邪念。","example":{"text":"她是一个～的女孩。"},"similar":["纯真无邪"],"usage":"作谓语、定语；多用于小孩和女性"},{"id":36197,"word":"纲举目张","pinyin":"gāng jǔ mù zhāng","abbr":"gjmz","explanation":"纲：鱼网上的总绳；举：提起。把大绳子一提起来，一个个网眼就都张开。比喻抓住事物的关键，带动其他环节。也比喻文章条理分明。","source":{"text":"举一纲而万目张，解一卷而众篇明。","book":"汉·班固《白虎通·三纲六纪》：“若罗网之有纪纲而万目张也。”汉·郑玄《诗谱序》"},"example":{"text":"有句古语，“～”。拿起纲，目才能张，纲就是主题。","book":"毛泽东《善于农业互助合作的两次谈话》"},"similar":["提纲挈领"],"opposite":["轻重倒置"],"usage":"作主语、补语、分句；比喻条理清楚"},{"id":36198,"word":"纲常名教","pinyin":"gāng cháng míng jiào","abbr":"gcmj","explanation":"纲常：三纲五常；名教：以正名分为中主心的封建礼教。旧时为维护和加强封建制度而对人们思想行为而设置的一整套规范。","source":{"text":"因思臣一身、一女之事小，而纲常名教之事大，故正色拒之，因触其怒，而疏请斩臣矣。","book":"明·明教中人《好逑传》第十七回"},"example":{"text":"吴佩孚张嘴闭嘴所抱守的～……不能拿到二十世纪的民主国里害人。","book":"冯玉祥《我的生活》第三十五章"},"usage":"作主语、宾语、定语；指封建礼教"},{"id":36199,"word":"纲常扫地","pinyin":"gāng cháng sào dì","abbr":"gcsd","explanation":"纲常：三纲五常。指纲纪、人伦等封建伦理道德衰败不振。","source":{"text":"世降道斁，纲常扫地。堂帘不隔，君臣交戏。","book":"明·冯梦龙《东周列国志》第十七回"},"similar":["纲常废弛"],"usage":"作宾语、定语；用于社会风气等"},{"id":36200,"word":"纲挈目张","pinyin":"gāng qiè mù zhāng","abbr":"gqmz","explanation":"指撒网时，举起网上的大绳，所有网眼都张开。比喻抓住主要环节，以带动其余；或抓住要领，条理分明。同“纲举目张”。","source":{"text":"于是南北并举，纲挈目张。","book":"清·魏源《道光丙戌海运记》"},"similar":["纲举目张"],"usage":"作主语、补语、分句；比喻条理清楚"},{"id":36201,"word":"纲提领挈","pinyin":"gāng tí lǐng qiè","abbr":"gtlq","explanation":"提起网纲，挈住裘领。比喻抓住要领。","source":{"text":"一览之顷，纲提领挈，不待注释而其大旨焕然昭明矣。","book":"明·宋濂《〈杜诗举隅〉序》"},"similar":["提纲挈领"],"usage":"作谓语、状语、补语；指简明扼要"},{"id":36202,"word":"纲目不疏","pinyin":"gāng mù bù shū","abbr":"gmbs","explanation":"比喻法令细密。","source":{"text":"刘公幹以失敬罹罪，文帝问曰：‘卿何以不谨于文宪？’桢答曰：‘臣诚庸短，亦由阶下纲目不疏。’","book":"南朝·宋·刘义庆《世说新语·言语》"},"usage":"作谓语、定语；用于政策等"},{"id":36203,"word":"纲纪四方","pinyin":"gāng jì sì fāng","abbr":"gjsf","explanation":"纲纪：政纲和法纪。用政策和法制治理天下。","source":{"text":"勉勉我王，纲纪四方。","book":"《诗经·大雅·棫朴》"},"usage":"作谓语、宾语；用于书面语"},{"id":36204,"word":"纲纪废弛","pinyin":"gāng jì fèi chí","abbr":"gjfc","explanation":"纲：政纲；纪：法纪；废弛：颓废松弛。国家的政纲、法纪、秩序松弛不振。","source":{"text":"朝政崩坏，纲纪废弛，危亡之祸，不隧如发。","book":"《汉书·王莽传》"},"example":{"text":"刘曜耽嗜麯蘖，～，虽据关中，济得甚事。","book":"明·无名氏《玉镜台记·石勒称王》"},"usage":"作宾语、定语；用于社会风气等"},{"id":36205,"word":"纳叛招亡","pinyin":"nà pàn zhāo wáng","abbr":"npzw","explanation":"招收逃亡的人，接纳敌方叛变、归顺的人。","source":{"text":"高祖起丰、沛以来，罔罗豪桀，招亡纳叛，亦已多矣。","book":"《资治通鉴·汉纪·太祖高皇帝中五年》"},"example":{"text":"靳直～，屯留洋海，赝符伪札，布满江湖，应照大逆之条，凌迟不枉。（清·夏敬渠《野叟曝言》第三十四回）"}},{"id":36206,"word":"纳垢藏污","pinyin":"nà gòu cáng wū","abbr":"ngcw","explanation":"垢、污：肮脏的东西。比喻隐藏或包容坏人坏事。","source":{"text":"川泽纳污，山薮藏疾。","book":"《左传·宣公十五年》"},"example":{"text":"受人钱甘心～。","book":"明·陈汝元《金莲记·构畔》"},"similar":["藏污纳垢","纳污藏垢"],"usage":"作谓语、定语；用于坏人聚积的场所"},{"id":36207,"word":"纳士招贤","pinyin":"nà shì zhāo xián","abbr":"nszx","explanation":"招：招收；贤：有德有才的人；纳：接受；士：指读书人。招收贤士，接纳书生。指网罗人才。","source":{"text":"早则是泽及黎民，又待要招贤纳士礼殷勤，币帛降玄纁。","book":"《战国策·燕策一》：“燕昭王即位，卑身厚币以招贤者。”元·马致远《陈抟高卧》第二折"},"example":{"text":"贤士有如此博学广文，高才大德，见如今圣人～，何不进取功名。","book":"明·无名氏《薛苞认母》第四折"},"similar":["招贤纳士"],"usage":"作谓语、宾语、定语；指网罗人才"},{"id":36208,"word":"纳头便拜","pinyin":"nà tóu biàn bài","abbr":"ntbb","explanation":"纳头；低头。一见面就低头行下拜礼。形容人谦虚有礼貌。","source":{"text":"武松当下推金山，倒玉柱，纳头便拜。","book":"明·施耐庵《水浒全传》第二十三回"},"example":{"text":"进了大门，二层厅上立定，万中书～。","book":"清·吴敬梓《儒林外史》第五十回"},"usage":"作谓语；指行礼"},{"id":36209,"word":"纳奇录异","pinyin":"nà qí lù yì","abbr":"nqly","explanation":"纳：接纳；录：录用。接纳录用有奇异才能的人。","source":{"text":"今主人亲贤贵士，纳奇录异，且吾闻先哲秘论，承运代刘氏者，必兴于东南，推步事势，当其历数，终构帝基，以协天符，是烈士攀龙附凤驰骛之秋。","book":"《三国志·吴志·鲁肃传》"},"example":{"text":"今吾孙将军亲贤礼士，～，世所罕有。","book":"明·罗贯中《三国演义》第二十九回"},"usage":"作谓语、定语；用于选拔人才"},{"id":36210,"word":"纳履决踵","pinyin":"nà lǚ jué zhǒng","abbr":"nljz","explanation":"纳：穿；履:鞋；决：破裂；踵：脚后跟。穿鞋而后跟即破。比喻穷困、窘迫。","source":{"text":"曾子捉襟见肘，纳履决踵，贫不胜言。","book":"明·程登吉《幼学琼林·贫富》"}},{"id":36211,"word":"纳履踵决","pinyin":"nà lǚ zhǒng jué","abbr":"nlzj","explanation":"纳：穿；履：鞋；踵：脚后跟；决：破裂。提上鞋，鞋的脚后跟处却破裂。形容处境困难。","source":{"text":"［原宪］楮冠黎杖而应门，正冠则缨绝，振襟则肘见，纳履则踵决。","book":"汉·韩婴《韩诗外传》卷一"},"similar":["纳屦踵决"],"usage":"作定语；指生活贫困"},{"id":36212,"word":"纳屦踵决","pinyin":"nà jù zhǒng jué","abbr":"njzj","explanation":"纳：穿；屦：鞋；踵：脚后跟；决：破裂。穿上鞋子，破了后跟。形容衣着褴褛。","source":{"text":"三日不举火，十年不制衣，正冠而缨绝，捉衿而肘见，纳屦而踵决。","book":"《庄子·让王》"},"similar":["捉襟见肘","纳履踵决"],"usage":"作定语；指生活贫困"},{"id":36213,"word":"纳忠效信","pinyin":"nà zhōng xiào xìn","abbr":"nzxx","explanation":"纳；献纳；效：献出。献出忠心和诤言。","source":{"text":"上之不能纳忠效信，有奇策材力之誉，自结明主。","book":"西汉·司马迁《报任安书》"},"usage":"作谓语、宾语；用于忠臣等"},{"id":36214,"word":"纳新吐故","pinyin":"nà xīn tǔ gù","abbr":"nxtg","explanation":"原指人呼吸时，吐出浊气，吸进新鲜空气。现多用来比喻扬弃旧的、不好的，吸收新的，好的。","source":{"text":"吹呴呼吸，吐故纳新。","book":"《庄子·刻意》"},"example":{"text":"夜夜朝朝，～，潜收静处功夫。","book":"明·陆采《明珠记·买药》"},"similar":["吐故纳新"],"usage":"作谓语、宾语；指新陈代谢"},{"id":36215,"word":"纳民轨物","pinyin":"nà mín guǐ wù","abbr":"nmgw","explanation":"纳：容纳；民：老百姓；轨：法度；物：器物。指将百姓纳入遵守法度、惜用器物的正道。","source":{"text":"群将纳民于轨物者也。","book":"《左传·隐公五年》"},"example":{"text":"～，驱时仁寿，神化隆平，生灵熙阜。","book":"《隋书·卢思道传》"}},{"id":36216,"word":"纳污含垢","pinyin":"nà wū hán gòu","abbr":"nwhg","explanation":"纳：接受；垢：污秽。包藏容纳污秽的东西。","source":{"text":"川泽纳污，山薮藏疾，瑾瑜匿瑕，国君含垢，天之道也。","book":"春秋·鲁·左丘明《左传·宣公十五年》"},"example":{"text":"日本蕞尔小国尔，尚知发奋为雄。独我大国，将～以终古哉！","book":"清·冯桂芬《上制洋器议》"},"similar":["纳污藏垢"],"usage":"作谓语、定语；用于书面语"},{"id":36217,"word":"纳污藏垢","pinyin":"nà wū cáng gòu","abbr":"nwcg","explanation":"纳：容纳；垢：污秽。比喻包容坏人坏事。","source":{"text":"所最可痛者，旧病未去，新病复来，日积月涂，纳污藏垢，驯至良医束手，岌岌待亡。","book":"梁启超《中国积弱溯源论》第四节"},"example":{"text":"我不想去那～的地方。"},"similar":["纳垢藏污","纳污藏秽"],"usage":"作谓语、定语；用于坏人聚积的场所"},{"id":36218,"word":"纳污藏疾","pinyin":"nà wū cáng jí","abbr":"nwcj","explanation":"污、疾：肮脏的东西。比喻隐藏或包容坏人坏事。","source":{"text":"川泽纳污，山薮藏疾，瑾瑜匿瑕，国君含垢，天之道也。","book":"《左传·宣公十五年》"},"example":{"text":"五岳陵霄，四海亘地，～，无损高深。","book":"《资治通鉴·唐纪·太宗贞观十九年》"},"usage":"作谓语、定语；用于书面语"},{"id":36219,"word":"纳污藏秽","pinyin":"nà wū cáng huì","abbr":"nwch","explanation":"纳：容纳；秽：肮脏，污秽。包藏容纳污浊肮脏的东西。比喻包容坏人坏事。","source":{"text":"故大川浅不胜舟，而小者纳污藏秽，流泉不来，感为疠疫，民之病此，积四五十年矣。","book":"宋·叶适《东嘉开河记》"},"example":{"text":"遂使首善贤士之关，翻为～之府。","book":"明·谢肇淛《五杂俎·事部》"},"similar":["纳污藏垢"],"usage":"作谓语、定语；用于坏人聚积的场所"},{"id":36220,"word":"纳谏如流","pinyin":"nà jiàn rú liú","abbr":"njrl","explanation":"纳：采纳，接受；谏：旧指规劝君主或尊长，使改正错误；如流：迅速。接受劝谏就像流水那样自然。形容非常乐意听取别人意见。","source":{"text":"豁达大度，纳谏如流，为宗而罢刑肉。","book":"元·金仁杰《追韩信》第三折"},"example":{"text":"玄德公纳谏如流，敬贤礼士。","book":"明·无名氏《庞掠四郡》第四折"},"opposite":["拒谏饰非"],"usage":"作谓语；指虚心听取谏议"},{"id":36221,"word":"纳贡称臣","pinyin":"nà gòng chēng chén","abbr":"ngcc","explanation":"缴纳贡品，自称为臣下。后来也用以比喻心悦诚服，甘拜下风。","source":{"text":"陈柳虽然大卖私盐，谁知这久惯盐徒都与这巡盐的民壮结成一伙，四时八节都与那巡役纳贡称臣，所以任凭那盐徒四处横行，壅阻盐法。","book":"清·西周生《醒世姻缘传》第四十八回"},"example":{"text":"宜要其～，以黄河为界。","book":"柯劭忞《清史稿·太宗本纪》"},"similar":["称臣纳贡"],"usage":"作谓语、宾语、定语；指投降"},{"id":36222,"word":"纵兵追击","pinyin":"zòng bīng zhuī jī","abbr":"zbzj","explanation":"纵：发，放。派出军队追击敌人","source":{"text":"诸侯军救巨鹿下者十余壁，莫敢纵兵。","book":"西汉·司马迁《史记·项羽本纪》"},"usage":"作谓语、宾语；用于战争等"},{"id":36223,"word":"纵壑之鱼","pinyin":"zòng hè zhī yú","abbr":"zhzy","explanation":"纵：任意地。壑：深沟。自由地在大壑间游泳的鱼。比喻自得其乐","source":{"text":"千载一会，论说无疑，翼乎如鸿毛遇顺风，沛乎若巨鱼纵大壑。","book":"汉·王褒《圣主得贤臣颂》"},"usage":"作宾语；用于书面语"},{"id":36224,"word":"纵情恣欲","pinyin":"zòng qíng zì yù","abbr":"zqzy","explanation":"纵：放纵。放纵心情，顺遂欲念。指不能自我约束","source":{"text":"若欲纵情恣欲，不能节宣，则伐年命。","book":"晋·葛洪《抱朴子·微旨》"},"similar":["纵情遂欲"],"usage":"作谓语、定语、宾语；用于处事"},{"id":36225,"word":"纵情欢乐","pinyin":"zòng qíng huān lè","abbr":"zqhl","explanation":"纵：放纵，听任。放纵心情，寻欢作乐。","example":{"text":"马上就要放假，我们可以～了。"},"similar":["尽情欢乐"],"usage":"作谓语、宾语；指放纵自己"},{"id":36226,"word":"纵情遂欲","pinyin":"zòng qíng suì yù","abbr":"zqsy","explanation":"放纵心怀、情，顺遂欲念。指不自抑止。","source":{"text":"亲用谗邪，放逐忠贤，纵情遂欲，不顾礼度。","book":"汉·荀悦《汉纪·昭帝纪十六》"},"similar":["纵情恣欲"],"usage":"作谓语、定语、宾语；用于处事"},{"id":36227,"word":"纵情酒色","pinyin":"zòng qíng jiǔ sè","abbr":"zqjs","explanation":"酒色：酒和女色。指沉迷于花天酒地和色欲之中。","source":{"text":"武弁则纵情酒色，文吏则惟事空言。","book":"《剪灯余话·秋夕访琵琶亭记》"},"example":{"text":"我们不能～。"},"similar":["纵情声色"],"usage":"作谓语、宾语；指放纵自己"},{"id":36228,"word":"纵曲枉直","pinyin":"zòng qǔ wǎng zhí","abbr":"zqwz","explanation":"指纵容有错误的人却冤枉正直的人。形容不主持正义。","source":{"text":"纵曲枉直，废公为私，刑加无辜。","book":"《抱朴子·内篇·微旨》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":36229,"word":"纵横交贯","pinyin":"zòng héng jiāo guàn","abbr":"zhjg","explanation":"横的竖的交叉在一起。也形容情况复杂。","source":{"text":"陪朱泗之席者入耳皆德音，纵横交错。","book":"宋·吕祖谦《东莱博议》卷一"},"example":{"text":"见《万法归宗》中载有是符，其画～，略如小篆。","book":"清·纪昀《阅微草堂笔记》卷十七"},"similar":["纵横交错"],"usage":"作谓语、定语；形容事物非常复杂"},{"id":36230,"word":"纵横交错","pinyin":"zòng héng jiāo cuò","abbr":"zhjc","explanation":"横的竖的交叉在一起。也形容情况复杂。","source":{"text":"见《万法归宗》中载有是符，其画纵横交贯，略如小篆。","book":"清·纪昀《阅微草堂笔记》卷十七"},"example":{"text":"我国是一个多山之国，山脉～。"},"similar":["犬牙交错"],"opposite":["井井有条","有条不紊"],"usage":"作谓语、定语；形容事物非常复杂"},{"id":36231,"word":"纵横决荡","pinyin":"zòng héng jué dàng","abbr":"zhjd","explanation":"纵横：奔放，不受拘束；荡：冲杀。纵横驰骋，冲杀突击","source":{"text":"难道你又不更远一点想到，这样枝枝叶叶靠紧团结，力求上进的白杨树，宛然象征了今天在华北平原纵横决荡、用血写出新中国历史的那种精神和意志？","book":"茅盾《白杨礼赞》"},"usage":"作谓语、定语；用于书面语"},{"id":36232,"word":"纵横四海","pinyin":"zòng héng sì hǎi","abbr":"zhsh","explanation":"纵横：奔驰无阻。在天下任意往来，没有阻挡。比喻无敌于世","source":{"text":"得志则纵横四海。","book":"《三国志通俗演义·青梅煮酒论英雄》"},"similar":["纵横天下"],"usage":"作谓语、定语；用于书面语"},{"id":36233,"word":"纵横天下","pinyin":"zòng héng tiān xià","abbr":"zhtx","explanation":"在天下任意往来，没有阻挡。","source":{"text":"黄巢纵横天下，朝中文武并不以社稷为重。","book":"元·陈以仁《存孝打虎》第一折"},"example":{"text":"健儿掷杯砍案曰：吾～三十年矣，未逢敌手，有能取我腰间物者，当叩首降之。","book":"清·李渔《秦淮健儿传》"},"usage":"作谓语、定语；用于书面语"},{"id":36234,"word":"纵横开合","pinyin":"zòng héng kāi hé","abbr":"zhkh","explanation":"指操纵自如。同“纵横开阖”。","source":{"text":"这些文学的核心是迫切的现实感，而笔锋所至，纵横开合，娓娓而谈，从历史掌故……直至民间说唱与绘画。","book":"柯灵《向拓荒者致敬》"},"similar":["纵横开阖"],"usage":"作谓语、定语；用于书面语"},{"id":36235,"word":"纵横开阖","pinyin":"zòng héng kāi hé","abbr":"zhkh","explanation":"指操纵自如。","source":{"text":"繇是而寓于术，纵横开阖，无所施而不宜，岂若专门独学者之劳且陋哉！","book":"明·方孝孺《赠王时中序》"},"similar":["纵横开合"],"usage":"作谓语、定语；用于书面语"},{"id":36236,"word":"纵横捭阖","pinyin":"zòng héng bǎi hé","abbr":"zhbh","explanation":"纵横：合纵连横；捭阖：开合，战国时策士游说的一种方法。指在政治或外交上运用手段进行分化或拉拢。","source":{"text":"捭之者，开也，言也，阳也；阖之者，闭也，默也，阴也。","book":"汉·刘向《战国策序》：“苏秦为从，张仪为横，横则秦帝，从则楚王，所在国重，所去国轻。”《鬼谷子·捭阖》"},"example":{"text":"政客错实力以自雄，军人假名流以为重，～，各戴一尊。","book":"蔡东藩、许厪父《民国通俗演义》第一百三十五回"},"similar":["兵不厌诈","远交近攻"],"usage":"作宾语、定语；指外交手段","story":["战国时期，各诸侯国之间都想对付秦国，但是他们的态度分为两派，以张仪为首的一帮人到处游说服从秦的领导，支持秦国统一六国，这一派叫横；以苏秦为首的鼓吹六国联合起来对付秦国的叫纵，但他们各自为政，最终被秦所灭"]},{"id":36237,"word":"纵横驰骋","pinyin":"zòng héng chí chěng","abbr":"zhcc","explanation":"纵：南北方向；横：东西方向；驰骋：纵马疾驰。不受阻挡地往来奔驰。形容英勇战斗，所向无敌。也比喻写作上才思奔放，意到笔随。","source":{"text":"以至唐末诸诗人，雕肝琢肺，求工于一言一字间，在于人力固可以无恨，而概之前数公纵横驰骋之才，则又有间矣。","book":"宋·谢尧仁《张于湖先生集序》"},"example":{"text":"作家应当有自在翱翔、～的广阔天地。","book":"柯灵《香雪海·题材问题一解》"},"similar":["南征北战","天马行空"],"usage":"作谓语、定语；指人勇敢"},{"id":36238,"word":"纵理入口","pinyin":"zòng lǐ rù kǒu","abbr":"zlrk","explanation":"纵理：嘴两角的横纹。迷信说法，认为嘴两角的横纹进入口里，是饿死的相貌","source":{"text":"许负指其口曰：‘有纵理入口，此饿死法也。’","book":"汉·司马迁《史记·绛侯周勃世家》"},"usage":"作宾语、定语；用于书面语"},{"id":36239,"word":"纵目远望","pinyin":"zòng mù yuǎn wàng","abbr":"zmyw","explanation":"纵目：放眼远望。放眼向远处眺望","source":{"text":"东郡趋庭日，南楼纵目初。","book":"唐·杜甫《登充州城楼》诗"},"usage":"作谓语、定语；用于书面语"},{"id":36240,"word":"纵虎出匣","pinyin":"zòng hǔ chū xiá","abbr":"zhcx","explanation":"放虎出笼。比喻放走强有力的敌人，贻患无穷。同“纵虎出柙”。","source":{"text":"若乘月黑潮满之夜，驾船冲出港门，及扛船随处下海……是纵虎出匣，祸岂胜言。","book":"明·唐顺之《咨总督都御史胡牌》"},"similar":["纵虎出柙"],"usage":"作谓语、定语、宾语；用于处事"},{"id":36241,"word":"纵虎出柙","pinyin":"zòng hǔ chū xiá","abbr":"zhcx","explanation":"放虎出笼。比喻放走强有力的敌人，贻患无穷。","source":{"text":"辽王托克托，乘国有隙，诛屠骨肉……如令归藩，臂之纵虎出柙。","book":"《续资治通鉴·元泰定帝泰定元年》"},"example":{"text":"禄贞武烈过人，倘资之兵使去，是～也，一旦有变，不可复絷矣。","book":"钱基博《吴禄贞传》"},"similar":["纵虎出匣"],"usage":"作谓语、定语、宾语；用于处事"},{"id":36242,"word":"纵虎归山","pinyin":"zòng hǔ guī shān","abbr":"zhgs","explanation":"把老虎放回山去。比喻把坏人放回老巢，留下祸根。","source":{"text":"璋遣法正迎刘备，巴谏曰：‘备，雄人也，入必为害，不可内也。’既入，巴复谏曰：‘若使备讨张鲁，是放虎于山林也。’璋不听。","book":"晋·司马彪《零陵先贤传》"},"example":{"text":"今刘备釜中之鱼，阱中之虎；若不就此时擒捉，如放鱼入海，～矣。","book":"明·罗贯中《三国演义》第四十二回"},"similar":["养虎遗患","养痈贻患","后患无穷"],"opposite":["斩草除根","斩尽杀绝","除恶务尽"],"usage":"作谓语、宾语；指把敌人放走","story":["东汉末年，刘备处境艰难就去投奔曹操。曹操的谋士程昱知道刘备不是等闲之辈，劝曹操尽早除掉刘备。刘备为麻痹曹操，装做种菜不问政治。曹操灭了吕布后，刘备请求带兵攻打袁术，曹操给了五万军马，刘备离开曹操自立旗号"]},{"id":36243,"word":"纵风止燎","pinyin":"zòng fēng zhǐ liáo","abbr":"zfzl","explanation":"用鼓风的方法灭火。比喻本欲消弭其事，却反而助长其声势。","source":{"text":"真君、建德之事，适足推波助澜，纵风止燎尔。","book":"隋·王通《中说·问易》"},"example":{"text":"幽平而后，有如宣王者出，则礼乐征伐不自诸侯，而《雅》《颂》未可知也。奈何推波助澜，～乎！","book":"宋·欧阳修《王国风解》"},"similar":["抱薪救火"],"usage":"作宾语、定语；用于比喻句"},{"id":36244,"word":"纵马横刀","pinyin":"zòng mǎ héng dāo","abbr":"zmhd","explanation":"比喻勇敢、慓悍。","source":{"text":"我与你纵马横刀去战敌，杀气腾腾映日起，助阵鼓凯春雷。","book":"元·郑德辉《老君堂》第二折"},"usage":"作定语、状语；用于书面语"},{"id":36245,"word":"纶巾羽扇","pinyin":"guān jīn yǔ shàn","abbr":"gjys","explanation":"拿着羽毛扇子，戴着青丝绶的头巾。形容态度从容。","source":{"text":"羽扇纶巾谈笑间，樯橹灰飞烟灭。","book":"宋·苏轼《念奴娇·赤壁怀古》词"},"similar":["羽扇纶巾"],"usage":"联合式；作宾语、状语；形容飘逸潇洒或儒雅风流的风度"},{"id":36246,"word":"纶言如汗","pinyin":"lún yán rú hàn","abbr":"lyrh","explanation":"指皇帝的话，一说出来就像汗流出后不能收回。","source":{"text":"王言如丝，其出如纶，王言如纶，其出如綍。","book":"《礼记·缁衣》"},"example":{"text":"高宗在这个悲情瞬间忘记了治罪两位妇人是他的诏令，忘记了君无戏言纶言如汗的帝王之规。","book":"苏童《后宫》"}},{"id":36247,"word":"纶音佛语","pinyin":"lún yīn fó yǔ","abbr":"lyfy","explanation":"比喻不由得不服从的话。","source":{"text":"凤姐悄悄道：‘放尊重着，别叫丫头们看了笑话。’贾瑞如听纶音佛语一般，忙往后退。","book":"清·曹雪芹《红楼梦》第十二回"}},{"id":36248,"word":"纷乱如麻","pinyin":"fēn luàn rú má","abbr":"flrm","explanation":"麻：麻团。交错杂乱像一团乱麻。","example":{"text":"我此刻的心情～，请不要再添乱了。"},"usage":"作宾语、状语、定语；用于人的心绪等"},{"id":36249,"word":"纷华靡丽","pinyin":"fēn huá mǐ lì","abbr":"fhml","explanation":"纷华：指繁华富丽；靡丽：奢侈豪华。形容讲究排场，追逐华丽。","source":{"text":"嫁聚送终，纷华靡丽。","book":"《后汉书·安帝纪》"},"example":{"text":"～之心，如何入见道德而说呢。","book":"清·李绿园《歧路灯》第三十八回"},"usage":"作谓语、定语；用于繁华场面"},{"id":36250,"word":"纷红骇绿","pinyin":"fēn hóng hài lǜ","abbr":"fhhl","explanation":"纷：纷披；红：指红花；骇：散乱；绿：指绿叶。纷披散乱的红花绿叶。形容花草树木随风摆动。","source":{"text":"每风自四山而下，振动大木，掩苒众草，给红骇绿，蓊郁香气。","book":"唐·柳宗元《袁空渴记》"},"example":{"text":"～，掩苒何穷，劈柳鸣条，萧骚无际。","book":"清·蒲松龄《聊斋志异·绛妃》"},"usage":"作谓语、宾语；形容花草树木随风摆动"},{"id":36251,"word":"纷纭杂沓","pinyin":"fēn yún zá tà","abbr":"fyzt","explanation":"纷纭：交错；沓：重复。多而且杂乱。","source":{"text":"虽然纷纭杂沓，仍自严肃整齐，只此一室之中，随从何止百数。","book":"明·凌濛初《二刻拍案惊奇》卷三十七"},"similar":["纷纷攘攘"],"usage":"作谓语；指多而且杂乱"},{"id":36252,"word":"纷纷不一","pinyin":"fēn fēn bù yī","abbr":"ffby","explanation":"纷纷：多又杂乱。意见多而且各不相同。","source":{"text":"有说为两个人的，有说为两件事的，有说为两处田的，纷纷不一。","book":"清·吴敬梓《儒林外史》第六回"},"example":{"text":"这时部队的干部有的要打，有的要回，意见～。","book":"《星火燎原·三战三捷》"},"similar":["众说纷纭"],"usage":"作谓语、定语；指意见不一"},{"id":36253,"word":"纷纷扬扬","pinyin":"fēn fēn yáng yáng","abbr":"ffyy","explanation":"纷纷：众多；扬扬：飘荡的样子。形容雪花飘落的样子。","source":{"text":"今日遇着暮冬天道，纷纷扬扬，下着如此这般大雪。","book":"元·无名氏《渔樵记》第一折"},"example":{"text":"只见四下彤云密布，又见～，飞来一天瑞雪来。","book":"明·兰陵笑笑生《金瓶梅词话》第二回"},"similar":["纷纷洋洋"],"usage":"作谓语、定语、状语；形容雪、花、传闻等"},{"id":36254,"word":"纷纷扰扰","pinyin":"fēn fēn rǎo rǎo","abbr":"ffrr","explanation":"凌乱的样子。也形容思绪纷乱。","source":{"text":"使上自朝廷，下及田野，内起京师，外周四海，士、吏、兵、农、工、商、僧、道，无一人得袭故而守常者，纷纷扰扰，莫安其属。","book":"宋·司马光《与王安石书》"},"example":{"text":"邸中～。","book":"清·纪昀《阅微草堂笔记·姑妄听之一》"},"similar":["纷纷籍籍","纷纷穰穰","纷纷攘攘"],"usage":"作谓语、定语；指杂乱"},{"id":36255,"word":"纷纷拥拥","pinyin":"fēn fēn yōng yōng","abbr":"ffyy","explanation":"指纷乱拥挤。","source":{"text":"左弓右矢护车行，纷纷拥拥离京阙。","book":"《天雨花》第二八回"},"example":{"text":"就像赶庙会一样，～地都赶到隅庄来看。","book":"峻青《黎明的河边·老水牛爷爷》"},"usage":"作定语、状语；用于纷乱的场面"},{"id":36256,"word":"纷纷攘攘","pinyin":"fēn fēn rǎng rǎng","abbr":"ffrr","explanation":"纷纷：众多；攘攘：杂乱的样子。众多且杂乱。形容人群杂乱。","source":{"text":"杨八老看见乡村百姓，纷纷攘攘，都来城中逃难。","book":"明·冯梦龙《喻世明言》第十卷"},"example":{"text":"……地里出出律律～奏边书，急得个上上下下都无措。","book":"清·洪昇《长生殿·弹词》"},"similar":["熙熙攘攘","纷纷扰扰"],"usage":"作谓语、定语；指杂乱"},{"id":36257,"word":"纷纷洋洋","pinyin":"fēn fēn yáng yáng","abbr":"ffyy","explanation":"形容雪花或似雪花般散片细物纷乱飘扬。同“纷纷扬扬”。","source":{"text":"是夜刮起东北风，浓云密布，纷纷洋洋，降下一天大雪。","book":"明·施耐庵《水浒传》第九十三回"},"similar":["纷纷扬扬"],"usage":"作谓语、定语、状语；形容雪、花、传闻等"},{"id":36258,"word":"纷纷穰穰","pinyin":"fēn fēn rǎng rǎng","abbr":"ffrr","explanation":"纷纷：众多；穰穰：纷乱的样子。形容众多而杂乱的样子","source":{"text":"孔明端坐于帐上，只见蛮兵纷纷穰穰，解到无数。","book":"明·罗贯中《三国演义》第87回"},"similar":["纷纷攘攘","纷纷籍籍","纷纷扰扰"],"usage":"作谓语、定语；指杂乱"},{"id":36259,"word":"纷纷籍籍","pinyin":"fēn fēn jí jí","abbr":"ffjj","explanation":"纷纷：众多；籍籍：杂乱的样子。形容众多而且杂乱的样子。","source":{"text":"周之衰，好事者各以其说干时君，纷纷籍籍相乱，六经与百家之说错杂。","book":"唐·韩愈《读荀子》"},"example":{"text":"诸弟子之后，或流而为荀卿，或流而为庄周、禽滑厘，～，皆异学也。","book":"清·汪琬《辨公孙龙子》"},"similar":["纷纷攘攘","纷纷穰穰"],"usage":"作谓语、定语；指杂乱"},{"id":36260,"word":"纷纷议论","pinyin":"fēn fēn yì lùn","abbr":"ffyl","explanation":"纷纷：众多杂乱的样子。形容很多人谈论的情景。","source":{"text":"这里李纨等纷纷议论，便传唤看园子的一干人来，叫把园门锁上。","book":"清·曹雪芹《红楼梦》第94回"},"example":{"text":"大家就～，以为尚未出兵，先就伤人，一定是凶多吉少。","book":"方志敏《我从事革命斗争的略述》"},"similar":["议论纷纷"],"usage":"作谓语、定语；指意见不统一"},{"id":36261,"word":"纷至沓来","pinyin":"fēn zhì tà lái","abbr":"fztl","explanation":"纷：众多，杂乱；沓：多，重复。形容接连不断的到来。","source":{"text":"夫其心俨然肃然，常若有所事，则虽事物纷至而沓来，岂足以乱吾之知思。","book":"宋·朱熹《答何叔京》六"},"example":{"text":"贴出布告以后，自己在招募公所坐镇，只见应募的小伙子，～，应接不暇。","book":"高阳《清宫外史》下册"},"similar":["接踵而至","络绎不绝","车水马龙"],"opposite":["门可罗雀","路断人稀"],"usage":"作谓语、定语；用于书面语","story":["南宋时期，金兵南侵骚扰边境，龙图阁待制王刚镇守四川。由于战事频繁，各种文书纷至沓来，他从容不迫将文件分轻重缓急妥善加以处理。他曾亲自督战，安排部将吴璘和张正彦夹击金兵取得大胜，而他自己毫不居功自傲"]},{"id":36262,"word":"纷至踏来","pinyin":"fēn zhì tà lái","abbr":"fztl","explanation":"形容接连不断的到来。"},{"id":36263,"word":"纸上空言","pinyin":"zhǐ shàng kōng yán","abbr":"zsky","explanation":"指停留在书本上的、未经实践检验的空洞言论。","source":{"text":"臣尝谈《无逸》一书，盖周公晚岁所作，字字真实，吐自肺肝，非徒纸上空言而已。","book":"宋·袁甫《蒙斋集·秘书少监上殿第一札子》"},"example":{"text":"毋徒～搪塞，竟成挂之虚文，则庶乎其可矣！（明·王阳明《申谕十家牌法》）"}},{"id":36264,"word":"纸上空谈","pinyin":"zhǐ shàng kōng tán","abbr":"zskt","explanation":"指不切实际的空论。","source":{"text":"上头究竟圣明不过，晓得立宪这椿事不能凭着纸上空谈的，必须要有人曾经考察过的。","book":"清·李宝嘉《文明小史》第六十回"},"example":{"text":"这位钦差年纪又轻，不过上了几个条陈，究竟是个‘～’，并未见他办过实事，怎么就好叫他独当一面，去办这个大事呢！","book":"清·吴研人《二十年目睹之怪现状》第十六回"},"similar":["纸上谈兵"],"usage":"作宾语、定语；指空谈"},{"id":36265,"word":"纸上谈兵","pinyin":"zhǐ shàng tán bīng","abbr":"zstb","explanation":"在纸面上谈论打仗。比喻空谈理论，不能解决实际问题。也比喻空谈不能成为现实。","source":{"text":"《史记·廉颇蔺相如列传》记载：战国时赵国名将赵奢之子赵括，年轻时学兵法，谈起兵事来父亲也难不倒他。后来他接替廉颇为赵将，在长平之战中。只知道根据兵书办，不知道变通，结果被秦军大败。"},"example":{"text":"新近有个大挑知县上了一个条陈，其中有些话都是窒碍难行，毕竟书生之见，全是～。","book":"清·李宝嘉《官场现形记》第三十一回"},"similar":["坐而论道","华而不实","画饼充饥"],"opposite":["埋头苦干","脚踏实地"],"usage":"作谓语、宾语、定语；指空谈","story":["战国时期，战国名将赵奢的儿子赵括饱读兵书，能健谈用兵之道，连父亲也难不倒他，自认为是天下无敌。赵奢认为他是纸上谈兵不知变通。后来赵奢死了，赵括顶替廉颇带兵，蔺相如等人极力反对，赵王坚持，赵括在长平之战损兵40万"]},{"id":36266,"word":"纸上谭兵","pinyin":"zhǐ shàng tán bīng","abbr":"zstb","explanation":"在纸面上谈论打仗。比喻空谈理论，不能解决实际问题。也比喻空谈不能成为现实。同“纸上谈兵”。","source":{"text":"今日动笑纸上谭兵，不知纸上之功，即有深浅，有一二分之见，有六七分之见，有十分之见。","book":"清·魏源《圣武记》卷十三"},"similar":["纸上谈兵"],"usage":"作宾语、定语；指空谈"},{"id":36267,"word":"纸上跃然","pinyin":"zhǐ shàng yuè rán","abbr":"zsyr","explanation":"跃然：生动形象地呈现。生动形象地呈现在纸上。形容文学作品叙述描写真实生动。","source":{"text":"如此体会，则诗神诗旨，跃然纸上。","book":"清·薛雪《一瓢诗话》卷三十三"},"example":{"text":"夫是书作于旅美华工，以旅美之人述旅美之事，固宜情真语切，～，非凭空结撰者比。（《反美华工禁约文学集·苦社会·叙》）"}},{"id":36268,"word":"纸包不住火","pinyin":"zhǐ bāo bù zhù huǒ","abbr":"zbbzh","explanation":"比喻事实是掩盖不了的。","source":{"text":"他知道纸是包不住火的，瞒过初一也瞒不过十五。","book":"从维熙《第十个弹孔》"},"example":{"text":"～，你一手遮天是长久不了的。"},"opposite":["瞒天过海"],"usage":"作宾语、定语；指事实是掩盖不了"},{"id":36269,"word":"纸田墨稼","pinyin":"zhǐ tián mò jià","abbr":"ztmj","explanation":"墨：笔墨；稼：庄稼。把纸当作田地，把书写当作种庄稼。比喻从事写作。","source":{"text":"蔡洪赴洛，人问关口旧业。曰：‘纸为良田，墨为稼穑，义理为丰年。’","book":"宋·谢维新《古今合壁事类备要》"},"usage":"作宾语、定语；用于书面语"},{"id":36270,"word":"纸短情长","pinyin":"zhǐ duǎn qíng cháng","abbr":"zdqc","explanation":"简短的信纸无法写完深长的情意。形容情意深长。","source":{"text":"言尽于此，愿君之勿忘也。芳兰两种，割爱相赠，此花尚非俗品，一名小荷，一名一品，病中得此，足慰岑寂，且可为养心之一助焉。临颖神驰，书不成字，纸短情长，伏惟珍重。","book":"徐枕亚《玉梨魂》第八章"},"example":{"text":"～，还是下次再叙吧。"},"usage":"作宾语、分句；用于书信结尾"},{"id":36271,"word":"纸笔喉舌","pinyin":"zhǐ bǐ hóu shé","abbr":"zbhs","explanation":"比喻社会舆论。","source":{"text":"真所谓‘事实胜于雄辩’，又何待于纸笔喉舌的批评。","book":"鲁迅《〈热风〉题记》"},"usage":"作宾语、定语；指社会舆论"},{"id":36272,"word":"纸糊老虎","pinyin":"zhǐ hú lǎo hǔ","abbr":"zhlh","explanation":"用纸糊的老虎。比喻看似吓人，实际上不堪一击。","source":{"text":"闲常时只如鸟嘴，卖弄杀好拳棒。急上场时，便没些用。见个纸虎，也赫一交。","book":"明·施耐庵《水浒全传》第二十五回"},"example":{"text":"闲人闪开，～来了。（清·沈起凤《伏虎韬》第四折）"}},{"id":36273,"word":"纸老虎","pinyin":"zhǐ lǎo hǔ","abbr":"zlh","explanation":"指表面强大而无实际本事的东西。","source":{"text":"对于帝国主义的论述，毛泽东同志有发展，例如关于帝国主义是纸老虎的论断。","book":"邓小平《正确地宣传毛泽东思想》"},"example":{"text":"帝国主义只是～而已。"},"usage":"作主语、宾语、定语；指表面强大的东西"},{"id":36274,"word":"纸落云烟","pinyin":"zhǐ luò yún yān","abbr":"zlyy","explanation":"形容落笔轻捷，挥洒自如。","source":{"text":"翰动若飞，纸落如云。","book":"晋·潘岳《杨荆州诔》"},"example":{"text":"～供醉后，诗成珠玉看朝还。","book":"宋·苏轼《次韵答满思复》"},"usage":"作谓语、定语；指人的文笔"},{"id":36275,"word":"纸贵洛城","pinyin":"zhǐ guì luò chéng","abbr":"zglc","explanation":"形容著作风行一时，流传甚广。同“纸贵洛阳”。","source":{"text":"金悬秦市，杨子见而无言；纸贵洛城，陆生闻而罢笑。","book":"唐·卢照邻《双槿树赋》序"},"similar":["纸贵洛阳"],"usage":"作谓语、定语；形容作品"},{"id":36276,"word":"纸贵洛阳","pinyin":"zhǐ guì luò yáng","abbr":"zgly","explanation":"比喻著作有价值，流传广。","source":{"text":"于是豪贵之家竞相传写，洛阳为之纸贵。","book":"《晋书·左思传》"},"example":{"text":"金悬秦市，杨子见而无言，～，陆生闻而罢笑。","book":"唐·卢照邻《双槿树赋并序·同崔少监作》"},"similar":["洛阳纸贵","纸贵洛城"],"usage":"作谓语、定语；形容作品"},{"id":36277,"word":"纸醉金迷","pinyin":"zhǐ zuì jīn mí","abbr":"zzjm","explanation":"原意是让闪光的金纸把人弄迷糊了。形容叫人沉迷的奢侈繁华环境。","source":{"text":"（痈医孟斧）有一小室，窗牖焕明，器皆金饰，纸光莹白，金彩夺目，所亲见之，归语人曰：‘此室暂憩，令人金迷纸醉。’","book":"宋·陶穀《清异录·居室》"},"example":{"text":"我来到日本不久，听的不多，见的不广，但在五光十色、～的纷乱生活中，有些事物给我的刺激特别深。","book":"杨朔《樱花雨》"},"similar":["灯红酒绿","醉生梦死","花天酒地"],"opposite":["粗茶淡饭","质朴无华"],"usage":"作谓语、定语；指奢华糜烂的生活","story":["唐朝末年，朝廷十分腐败，皇帝过着奢华的生活，给昭宗治病的御医孟斧经常出入皇宫，见识了皇宫的豪华。战乱时，孟斧流浪到四川居住，把他的屋子内所有家具都贴上金纸，人们说到他的房间休息就会金迷纸醉"]},{"id":36278,"word":"纸里包不住火","pinyin":"zhǐ lǐ bāo bù zhù huǒ","abbr":"zlbbzh","explanation":"形容事实真相是无法掩藏的。","example":{"text":"我还有心思算卦！今天的事，～，多田总会知道的。（李英儒《野火春风斗古城》第九章）"}},{"id":36279,"word":"纹丝不动","pinyin":"wén sī bù dòng","abbr":"wsbd","explanation":"一点儿也不动。形容没有丝毫改变。","source":{"text":"金莲坐在床上，纹丝儿不动，把脸儿沉着。","book":"明·兰陵笑笑生《金瓶梅词话》第38回"},"example":{"text":"但是由于调皮骡子长久没有摊上任务，求战心切，仍然～地聚精会神地伏在草丛里。","book":"魏巍《东方》第五部第六章"},"similar":["岿然不动","稳如泰山","文风不动"],"opposite":["闻风而起"],"usage":"作谓语、状语；用于人或物"},{"id":36280,"word":"纹丝没动","pinyin":"wén sī méi dòng","abbr":"wsmd","explanation":"非常稳，一点儿也不动。","source":{"text":"包兴道：‘方才看见了，纹丝没动。’","book":"清·石玉昆《三侠五义》第51回"},"similar":["文丝不动","纹丝不动"],"usage":"作谓语、定语；形容稳固"},{"id":36281,"word":"纹风不动","pinyin":"wén fēng bù dòng","abbr":"wfbd","explanation":"一点儿也不动。形容没有丝毫损坏或改变。","source":{"text":"一点儿也不动。形容没有丝毫损坏或改变。"},"example":{"text":"一点儿也不动。形容没有丝毫损坏或改变。"},"similar":["文风不动"],"usage":"作谓语、定语；用于口语"},{"id":36282,"word":"线抽傀儡","pinyin":"xiàn chōu kuǐ lěi","abbr":"xckl","explanation":"傀儡：木偶戏中的木头人。比喻任人操纵控制的人。","source":{"text":"那淮南江水左右官军，被奸妇驾云踏水，叫住就住，叫行就行，恰似线抽傀儡一般。","book":"清·魏秀仁《花月痕》第48回"},"usage":"作宾语、定语；指受人操纵的人"},{"id":36283,"word":"线断风筝","pinyin":"xiàn duàn fēng zhēng","abbr":"xdfz","explanation":"象放上天断了线的风筝一样。比喻一去不回来的人或东西。","source":{"text":"掴着手分开云雨，腾的似线断风筝。","book":"元·关汉卿《金线池》第三折"},"example":{"text":"明·冯梦龙《醒世恒言》第22卷：“却似石沉沧海，～，不见回来。”"},"similar":["断线风筝"],"usage":"作宾语、定语；比喻不回来的事物"},{"id":36284,"word":"练兵秣马","pinyin":"liàn bīng mò mǎ","abbr":"lbmm","explanation":"训练士兵，喂饱战马。指作好战斗准备。","source":{"text":"将遂练兵秣马以出于实，实而与之战，破之易尔。","book":"宋·苏洵《几策·审敌》"},"similar":["厉兵秣马"],"usage":"作谓语；指作好战斗准备"},{"id":36285,"word":"练达老成","pinyin":"liàn dá lǎo chéng","abbr":"ldlc","explanation":"老练稳重。","source":{"text":"当那进退维谷的时候，便是个练达老成人也只得如此，何况于你？","book":"清·文康《儿女英雄传》第12回"},"example":{"text":"他处理事情时十分～。"},"similar":["老成练达"],"usage":"作谓语、定语；指人老成"},{"id":36286,"word":"细不容发","pinyin":"xǐ bù róng fà","abbr":"xbrf","explanation":"发：头发。比喻十分细小。","source":{"text":"留情迹之变，乃惟佐隶……其大径寻，细不容发。","book":"《晋书·卫瓘传》"},"similar":["细入毫芒"],"usage":"作定语；用于书面语"},{"id":36287,"word":"细入毫芒","pinyin":"xì rù háo máng","abbr":"xrhm","explanation":"毫芒：指极细微。形容细微到极点。","source":{"text":"唐初虽有山水，然尚精工。如李思训、王摩诘之笔，皆细入毫芒。","book":"明·谢肇淛《五杂俎·人部》"},"example":{"text":"事迹新奇，笔意酣恣，描写既～，点染又曲中筋节。","book":"清·俞樾《序》"},"similar":["细不容发"],"usage":"作定语；用于书面语"},{"id":36288,"word":"细嚼慢咽","pinyin":"xì jiáo màn yàn","abbr":"xjmy","explanation":"本指慢慢地吃东西。引申慢慢去体味。","example":{"text":"这道菜只有～才能品味出独特的味道。"},"opposite":["狼吞虎咽"],"usage":"作宾语、定语；指慢慢去体会"},{"id":36289,"word":"细嚼烂咽","pinyin":"xì jiáo làn yàn","abbr":"xjly","explanation":"指吃东西嚼得很烂才咽下去。形容吃得很慢且少。","source":{"text":"休要细嚼乱咽，饿的瘦了。","book":"清·李绿园《歧路灯》第一百二回"},"example":{"text":"这当然需要时间，可是～总比囫囵吞枣强得多。","book":"老舍《谈读书》"}},{"id":36290,"word":"细声细气","pinyin":"xì shēng xì qì","abbr":"xsxq","explanation":"形容声音柔软轻细。","source":{"text":"就听里面细声细气地说：‘闻贤弟，你焉能知道两个人的来意？这是为御猫而来。","book":"清·石玉昆《小五义》第24回"},"example":{"text":"南星～，学着猫的腔调。","book":"老舍《小坡的生日》"},"opposite":["粗声粗气"],"usage":"作谓语、定语、状语；用于说话"},{"id":36291,"word":"细大不捐","pinyin":"xì dà bù juān","abbr":"xdbj","explanation":"细：微，小；捐：舍弃。小的大的都不抛弃。形容包罗一切，没有选择。","source":{"text":"贪多务得，细大不捐。","book":"唐·韩愈《进学解》"},"example":{"text":"戴升还问人家要门包，也有两吊的，也有一吊的，真正是～，积少成多，合算起来也着实不少。","book":"清·李宝嘉《官场现形记》第四回"},"similar":["细大无遗"],"usage":"作谓语、宾语、定语；形容包罗一切"},{"id":36292,"word":"细大不逾","pinyin":"xì dà bù yú","abbr":"xdby","explanation":"逾：超过。大小方面都不超过。","source":{"text":"物得其常乐极，极之所集曰声，声应相保曰和，细大不逾曰平。","book":"春秋·鲁·左丘明《国语·周语下》"},"usage":"作谓语、定语；指大小合适"},{"id":36293,"word":"细大无遗","pinyin":"xì dà wú yí","abbr":"xdwy","explanation":"细：微，小；遗：抛弃。小的大的都不抛弃。形容包罗一切，没有选择。","source":{"text":"我扶我翼，共处穷羁，锄荒补漏，细大无遗。","book":"宋·曾巩《祭亡妻晁氏文》"},"similar":["细大不捐"],"usage":"作谓语、宾语、定语；形容包罗一切"},{"id":36294,"word":"细微末节","pinyin":"xì wēi mò jié","abbr":"xwmj","explanation":"末节：小事情，小节。无关紧要的小事情，小问题。","source":{"text":"为这些细微末节的事,张志诚感到伤脑筋。","book":"古立高《初恋》"},"similar":["细枝末节"],"usage":"作主语、宾语、定语；指细小问题"},{"id":36295,"word":"细批薄抹","pinyin":"xì pī bó mǒ","abbr":"xpbm","explanation":"细：仔细抹，删除；批：批改；薄：略微地。略微地推敲批改，缌地斟酌删除。形容为调谐韵，选词改字而吟咏诗词。","source":{"text":"薄批明月，细抹清风。","book":"宋·释道原《景德传灯录》"},"example":{"text":"履舄交错，兰麝香沉，～，低唱浅斟。","book":"清·蒲松龄《聊斋志异·八大王》"}},{"id":36296,"word":"细枝末节","pinyin":"xì zhī mò jié","abbr":"xzmj","explanation":"末节：小事情，小节。细小的树枝，策末的环节。比喻事情或问题的细小而无关紧要的部分。","source":{"text":"以升降为礼者，礼之末节也。","book":"西汉·戴圣《礼记·乐记》"},"example":{"text":"只须使其符合于总的抗战国策，而不必作～的限制，更不能随时解散。","book":"邹韬奋《抗战以来》"},"similar":["无足轻重","无关紧要"],"opposite":["非同小可","举足轻重"],"usage":"作主语、宾语、定语；指细小的事情"},{"id":36297,"word":"细水长流","pinyin":"xì shuǐ cháng liú","abbr":"xscl","explanation":"比喻节约使用财物，使经常不缺用。也比喻一点一滴不间断地做某件事。","source":{"text":"汝等常勤精进，譬如小水常流，则能穿石。","book":"清·翟灏《通俗编·地理》引《教经》"},"example":{"text":"告诉老王说，要多吃野菜树皮，少吃米面，～呀！","book":"梁斌《红旗谱》四十六"},"similar":["持之以恒","精打细算"],"opposite":["虎头蛇尾","大手大脚"],"usage":"作谓语、定语、分句；指长期做某件事"},{"id":36298,"word":"细皮嫩肉","pinyin":"xì pí nèn ròu","abbr":"xpnr","explanation":"形容保养得好，皮肤细腻白嫩。","source":{"text":"老人家更要作急回去，这些妖怪常说后生的细皮嫩肉，腹饥得快，不如老头儿皮坚骨硬，有些咬嚼，专要吃老的。","book":"明·清溪道人《禅真逸史》第十四回"},"example":{"text":"余华《活着》：“家珍是城里小姐出生，～的，看着她干粗活，我自然心疼。”"},"usage":"作宾语、定语；用于口语等"},{"id":36299,"word":"细皮白肉","pinyin":"xì pí bái ròu","abbr":"xpbr","explanation":"形容保养得好，皮肤细腻白嫩。","source":{"text":"老人家更要作急回去，这些妖怪常说后生的细皮嫩肉，腹饥得快，不如老头儿皮坚骨硬，有些咬嚼，专要吃老的。","book":"明·清溪道人《禅真逸史》第十四回"},"example":{"text":"丈母老太太出过天花，脸上有些缺点的，令夫人却种的是牛痘，所以～。","book":"鲁迅《华盖集·这个与那个》"}},{"id":36300,"word":"细针密线","pinyin":"xì zhēn mì xiàn","abbr":"xzmx","explanation":"针线细密。比喻工作细致或处理事情周到。","source":{"text":"这位姑娘虽是细针密缕的一个心思，却是海阔天空的一个性气。","book":"清·文康《儿女英雄传》第二十六回"},"similar":["细针密缕"],"usage":"作宾语、定语；多用于比喻句"},{"id":36301,"word":"细针密缕","pinyin":"xì zhēn mì lǚ","abbr":"xzml","explanation":"缕：线。针线细密。比喻工作细致或处理事情周到。","source":{"text":"这位姑娘虽是细针密缕的一个心思，却是海阔天空的一个性气。","book":"清·文康《儿女英雄传》第二十六回"},"example":{"text":"中华也是诞生～人物的所在，有时真能够想得入微。","book":"鲁迅《准风月谈·华德保粹优劣论》"},"similar":["细针密线","见缝插针"],"opposite":["大刀阔斧","粗枝大叶"],"usage":"作宾语、定语；指人很细致"},{"id":36302,"word":"细雨和风","pinyin":"xì yǔ hé fēng","abbr":"xyhf","explanation":"细雨：小雨；和风：春天的微风。温和的风，细小的雨。比喻方式方法温和而不粗暴。","source":{"text":"乱云如兽出山前，细雨和风满渭川。","book":"前蜀·韦庄《登咸阳县楼望雨》诗"},"example":{"text":"～经白鹿，拨云开雾见青天。","book":"朱德《和毛泽东》"},"similar":["和风细雨"],"opposite":["暴风骤雨"],"usage":"作主语、宾语、定语；指人的态度"},{"id":36303,"word":"细雨斜风","pinyin":"xì yǔ xié fēng","abbr":"xyxf","explanation":"形容微风夹着毛毛雨的天气。也比喻用温和舒缓的语气批评别人。","source":{"text":"青箬笠，绿蓑衣，斜风细雨不须归。","book":"唐·张志和《渔歌子》"},"example":{"text":"～作小寒，淡烟疏柳媚晴滩，入淮清洛渐漫漫。","book":"宋·苏轼《浣溪沙》词"},"similar":["斜风细雨"],"usage":"作主语、宾语；形容微风细雨的天气"},{"id":36304,"word":"细高挑儿","pinyin":"xì gāo tiǎo ér","abbr":"xgte","explanation":"形容身材又瘦又高。","example":{"text":"他的身材～。"},"similar":["细高条儿"],"usage":"作谓语、定语；形容人的身材"},{"id":36305,"word":"织当访婢","pinyin":"zhī dāng fǎng bì","abbr":"zdfb","explanation":"比喻办事应该向内行请教。","source":{"text":"治国如治家，耕当问奴，织当访婢。陛下今欲伐国，而与白面书生谋之，事何由济？","book":"《宋书·沈庆之传》"},"similar":["耕当问奴"],"usage":"作宾语、定语；指向内行请教","story":["南北朝时期，宋文帝要向北方扩展疆土，派王云谟等人督师北伐，沈庆之一再向文帝规劝，力陈以前北伐失败的教训，文帝很扫兴，便叫几个文官与他争辩出兵事宜。沈庆之说治国与治家一样，耕当问奴，织当访婢，跟白面书生说这些没有用的"]},{"id":36306,"word":"织楚成门","pinyin":"zhī chǔ chéng mén","abbr":"zccm","explanation":"形容房屋简陋。","source":{"text":"织宿楚以成门，籍外扉而为户。","book":"南朝梁·沈约《郊居赋》"},"usage":"作定语；用于书面语"},{"id":36307,"word":"织白守黑","pinyin":"zhī bái shǒu hēi","abbr":"zbsh","explanation":"意思是对是非黑白，虽然明白，还当保持暗昧，如无所见。这是道家的消极处世态度。"},{"id":36308,"word":"织锦回文","pinyin":"zhī jǐn huí wén","abbr":"zjhw","explanation":"绣在锦缎上的回文诗。指情诗或书信。","source":{"text":"则为你彩笔题诗，织锦回文；送得人卧枕着床，忘餐废寝。","book":"元·王实甫《西厢记》第三本第四折"},"example":{"text":"清·李汝珍《镜花缘》第40回：“太后因见苏蕙～《璇玑图》，甚为喜爱，时刻翻阅。”"},"similar":["锦字回文"],"usage":"作宾语、定语；指情诗","story":["前秦时期，秦州刺史窦滔因得罪了苻坚的手下大官被流放到流沙县。夫妻天各一方，他的妻子苏蕙特地在一块锦缎上绣上840个字，纵横29个字的方图，可以任意地读，共能读出3752首诗，表达了她对丈夫的思念与关心之"]},{"id":36309,"word":"终其天年","pinyin":"zhōng qí tiān nián","abbr":"zqtn","explanation":"终：竟，尽。天年：指自然的寿数。过完应有的寿数。指寿长而善终。","source":{"text":"虽情心郁殪， 形性屈竭，犹不得已自强也。故莫能终其天年。","book":"《庄子·山木》：“此木以不材得终其天年。”《淮南子·精神训》"},"similar":["寿终正寝","终养天年"],"opposite":["不得善终"],"usage":"作谓语、定语；用于书面语"},{"id":36310,"word":"终养天年","pinyin":"zhōng yǎng tiān nián","abbr":"zytn","explanation":"养：供养，赡养；天年：人的自然寿命。指赡养老人，为其养老送终。","source":{"text":"乌鸟私情，愿乞终养。","book":"晋·李密《陈情表》"},"example":{"text":"我希望你能够～"},"similar":["终其天年"],"opposite":["不得善终"],"usage":"作谓语、定语；用于书面语"},{"id":36311,"word":"终南捷径","pinyin":"zhōng nán jié jìng","abbr":"znjj","explanation":"指求名利的最近便是门路。也比喻达到目的的便捷途径。","source":{"text":"《新唐书·卢藏用传》记载：卢藏用想入朝作官，隐居在京城长安附近的终南山，借此得到很大的名声，终于达到了作官的目的。"},"example":{"text":"借此认识了几位当道，又结交了几家富贾豪商，自以为～，即在此小小酒馆之中，因此十分高兴。","book":"清·李宝嘉《文明小史》第四十四回"},"usage":"作宾语、定语；指快捷方式","story":["唐朝进士卢藏用没有官职，他来到京城长安附近的终南山隐居以扩大影响，朝廷终于让他出来做官。想退隐天台山的司马承对卢藏用向他推荐隐居终南山说：“终南山的确是通向官场的便捷之道。”卢藏用深敢羞愧"]},{"id":36312,"word":"终天之思","pinyin":"zhōng tiān zhī sī","abbr":"ztzs","explanation":"终天：终身。到死还存在的思慕之情。","source":{"text":"今夫农夫泞耕，红女寒织，……，探珊象，生死出入，童年皓发，以获赢余者，岂不顾父母，拊妻子，慰终天之思，邀须臾之乐哉？","book":"清·王夫之《黄书·大正》"},"example":{"text":"他抱着～而离去"},"similar":["终天之恨","终天之戚"],"usage":"作宾语；用于死丧不幸的事"},{"id":36313,"word":"终天之恨","pinyin":"zhōng tiān zhī hèn","abbr":"ztzh","explanation":"终天：终身。到死的时候都清除不了的悔恨或不称心的事情。","source":{"text":"卑人空怀罔极之思，徒抱终天之恨。","book":"明·高则诚《琵琶记·一门旌奖》"},"example":{"text":"万一尚得相见，免得～，事在不疑。","book":"《醒世姻缘》第七十六回"},"similar":["终天之憾","终天之痛"],"usage":"作宾语；用于死丧不幸的事"},{"id":36314,"word":"终天之慕","pinyin":"zhōng tiān zhī mù","abbr":"ztzm","explanation":"终生思慕之情。","source":{"text":"终天之慕，不续于短年，欷报之诚，思隆于永劫。","book":"南朝·梁·沈约《为齐竟陵王解讲疏》"},"usage":"作宾语；用于书面语"},{"id":36315,"word":"终天之戚","pinyin":"zhōng tiān zhī qī","abbr":"ztzq","explanation":"终天：终身。旧指因父母去世而一辈子感到悲痛。现指因做错某事而后悔一辈子。","example":{"text":"他不会有～，因为他努力过"},"similar":["终天之恨","终天之思"],"usage":"作宾语；用于死丧不幸的事"},{"id":36316,"word":"终天报恨","pinyin":"zhōng tiān bào hèn","abbr":"ztbh","explanation":"终天：终身。到死的时候都清除不了的悔恨或不称心的事情。","source":{"text":"可怜他三百口亲丁尽不存，着谁来雪这终天恨。","book":"元·纪君祥《赵氏孤儿》第一折"}},{"id":36317,"word":"终天抱恨","pinyin":"zhōng tiān bào hèn","abbr":"ztbh","explanation":"终天：终生；抱：胸怀；抱恨：含恨。终生抱有遗恨。","source":{"text":"只怕从前玉玦无凭，真成薄命，也落得个不亏名行，泪盈盈，料此身终天抱恨幽冥。","book":"明·胡文焕《群音类选·玉玦记·自经反魂》"},"similar":["抱恨终天"],"usage":"作谓语、定语；形容无法弥补的遗憾"},{"id":36318,"word":"终始一贯","pinyin":"zhōng shǐ yī guàn","abbr":"zsyg","explanation":"贯：贯通。从开始到结束都是坚持同一宗旨。","source":{"text":"终始一以贯之，而谓备矣。","book":"《汉书·王莽传》"},"example":{"text":"自创业以至今日，～，奉公不懈，深堪嘉慰。（刘德桂《宣统皇帝》六）"}},{"id":36319,"word":"终始不渝","pinyin":"zhōng shǐ bù yú","abbr":"zsby","explanation":"自始至终，一直不变。","source":{"text":"卿早荷朝恩，委任斯重。居中作相，弘益已多；防边训兵，心力俱尽。岁寒无改，终始不渝。","book":"《旧唐书·姚（王寿）传》"},"similar":["始终不易","始终不渝","终始弗渝"],"usage":"作谓语、定语、状语；指守信用"},{"id":36320,"word":"终始参差","pinyin":"zhōng shǐ cēn cī","abbr":"zscc","explanation":"终：结束。结束时与开始时不一致。形容前后不一样。","source":{"text":"岂期终始参差，仓黄翻覆，泪翟子之悲，恸朱公之哭；乍回迹以心染，或先贞而后黩，何其谬哉！","book":"南朝·宋·孔稚珪《北山移文》"},"example":{"text":"一春多少伤心事，著情疼热，痛口嗟咨。往来迢递，～。（元·张可久《套数·梁州》曲）"}},{"id":36321,"word":"终始如一","pinyin":"zhōng shǐ rú yī","abbr":"zsry","explanation":"终：结束；始：开始。自始自终一个样子。自始至终，一直不变。","source":{"text":"虑必先事，而申之以敬，慎终如始，终始如一。","book":"《荀子·议兵》"},"similar":["始终若一"],"opposite":["反复无常"],"usage":"作谓语、定语；指自始自终一个样子"},{"id":36322,"word":"终始弗渝","pinyin":"zhōng shǐ fú yú","abbr":"zsfy","explanation":"渝：变。自始自终一直不变。","source":{"text":"俭约朴素，终始弗渝。","book":"《新唐书·魏征传》"},"similar":["终始不渝","终身不渝","始终不易"],"usage":"作谓语、定语、状语；用于书面语"},{"id":36323,"word":"终始若一","pinyin":"zhōng shǐ ruò yī","abbr":"zsry","explanation":"自始至终都不改变。","source":{"text":"故君子敬始而慎终，终始若一，是君子之道。” 又“然后皆有衣衾多少厚薄之数，皆有翣菨文章之等，以敬饰之，使生死终始若一。","book":"《荀子·礼论》"},"example":{"text":"他抱着～的态度来处理此事"},"similar":["终始如一"],"opposite":["半途而废"],"usage":"作谓语、定语；指自始自终一个样子"},{"id":36324,"word":"终成泡影","pinyin":"zhōng chéng pào yǐng","abbr":"zcpy","explanation":"结果一场空，一无所有。","example":{"text":"希特勒妄想称霸全世界，他逆历史潮流而动，一切诡计～，落得个自取灭亡的下场。"},"usage":"作谓语、定语；用于计划等"},{"id":36325,"word":"终无了局","pinyin":"zhōng wú liǎo jú","abbr":"zwlj","explanation":"了局：结局。终归不是长久之计。","source":{"text":"依小弟看起来，这绿林中买卖，终无了局。","book":"清·钱彩《说岳全传》第三十三回"},"example":{"text":"杨过知道一灯决不会跟她用强，郭襄是小孩儿家，说出话来瑛姑也不重视，自己再不干预，此事～。（金庸《神雕侠侣》第三十四回）"},"similar":["终非了局"],"usage":"作谓语、定语；用于书面语"},{"id":36326,"word":"终日不倦","pinyin":"zhōng rì bù juàn","abbr":"zrbj","explanation":"整天不知厌倦。指埋头学习","source":{"text":"吾闻可以为人终日不倦者，其惟学焉。","book":"《孔子家语·致思》"},"usage":"作谓语、状语；用于书面语"},{"id":36327,"word":"终日终夜","pinyin":"zhōng rì zhōng yè","abbr":"zrzy","explanation":"指整天整夜。","source":{"text":"吾尝终日不食，终夜不寝，以思，无益，不如学也。","book":"《论语·卫灵公》"},"example":{"text":"但是～躲在床上的人，睡眠是不会不够的。（张恨水《金粉世家》第九十三回）"},"similar":["整天整夜"],"usage":"作定语、状语；用于书面语"},{"id":36328,"word":"终日而思","pinyin":"zhōng rì ér sī","abbr":"zres","explanation":"整天思考","source":{"text":"吾尝终日而思矣，不如须臾之所学也；吾尝歧而望矣，不如登高之博见也。","book":"战国·赵·荀况《荀子·劝学》"},"usage":"作谓语；用于处事"},{"id":36329,"word":"终焉之志","pinyin":"zhōng yān zhī zhì","abbr":"zyzz","explanation":"在此安身终老的想法。","source":{"text":"义熙初，年四十，始为孟昶建威将军，员外散骑侍郎。坐辞兼，免。复为会稽征虏参军。家在上虞，及东归，便有终焉之志。","book":"南朝梁·沈约《宋书·傅隆传》"},"example":{"text":"羲之雅好服食养性，不乐在京师，初渡浙江，便有～。（《晋书·王羲之传》）"},"usage":"作宾语；用于书面语"},{"id":36330,"word":"终老隐居","pinyin":"zhōng lǎo yǐn jū","abbr":"zlyj","explanation":"终老：直到老死。直到老死，都过着隐居生活。","source":{"text":"爚从熹武夷山讲道读书，怡然自适。筑云庄山房，为终老隐居之计。","book":"《宋史·刘爚传》"},"usage":"作谓语、定语；用于书面语"},{"id":36331,"word":"终而复始","pinyin":"zhōng ér fù shǐ","abbr":"zefs","explanation":"不断地循环往复。","source":{"text":"通于学者若车轴，转毂之中，不运于己，与之致千里，终而复始，转无穷之源。","book":"《淮南子·说山训》"},"example":{"text":"西汉·司马迁《史记·高祖本纪》：“王道之道若循环，～。”"},"similar":["周而复始"],"opposite":["断断续续"],"usage":"作谓语、状语、定语；用于书面语"},{"id":36332,"word":"终虚所望","pinyin":"zhōng xū suǒ wàng","abbr":"zxsw","explanation":"终：最终；虚：虚空。最终愿望也无法实现。","source":{"text":"仙姑所见固是，小仙看来，既使所载竟是巾帼，设或无缘，不能一见，岂非‘镜花水月’，终虚所望么？","book":"清·李汝珍《镜花缘》第一回"},"usage":"作谓语、定语；用于书面语"},{"id":36333,"word":"终身不渝","pinyin":"zhōng shēn bù yú","abbr":"zsby","explanation":"渝：变。一生自始自终一直不变。","example":{"text":"我们的爱情将～。"},"similar":["始终不易","始终不渝","终始弗渝"],"usage":"作谓语、定语、状语；用于处事"},{"id":36334,"word":"终身不齿","pinyin":"zhōng shēn bù chǐ","abbr":"zsbc","explanation":"齿：录用。一辈子都不被录用。","source":{"text":"屏之远方，终身不齿。","book":"《礼记·王制》"},"example":{"text":"下则斥之远方，～，岂可犹畀祠禄，使尘班列哉？（《宋史·卫肤敏传》）"},"usage":"作谓语、定语；用于书面语"},{"id":36335,"word":"终身之丑","pinyin":"zhōng shēn zhī chǒu","abbr":"zszc","explanation":"一辈子的丑事。","source":{"text":"惠以欢为惊，终身之丑。","book":"《庄子·外物》"},"similar":["终身之恶"],"usage":"作宾语；用于书面语"},{"id":36336,"word":"终身之忧","pinyin":"zhōng shēn zhī yōu","abbr":"zszy","explanation":"指一生的忧虑。","source":{"text":"君子有终身之忧，而无一朝之患。故忌日不乐。","book":"西汉·戴圣《礼记·檀弓上》"},"example":{"text":"这事是我的～。"},"usage":"作宾语；指永久的忧虑"},{"id":36337,"word":"终身之恶","pinyin":"zhōng shēn zhī è","abbr":"zsze","explanation":"恶：坏事。一生受其影响的坏事。","source":{"text":"孔林父违穆子之戒，故陷终身之恶。","book":"《后汉书·冯衍传》"},"similar":["终身之丑"],"usage":"作宾语；用于书面语"},{"id":36338,"word":"终身之计，莫如树人","pinyin":"zhōng shēn zhī jì，mò rú shù rén","abbr":"zszjmrsr","explanation":"一生最重要的计划，莫过于培育人才。","source":{"text":"一年之计，莫如树谷；十年之计，莫如树木，终身之计，莫如树人。","book":"《管子·权修》"},"usage":"作宾语、定语；用于书面语"},{"id":36339,"word":"终身大事","pinyin":"zhōng shēn dà shì","abbr":"zsds","explanation":"终身：一生。关系一辈子的大事情，多指婚姻。","source":{"text":"一时间凭着两局赌赛，偶尔亏输，便要认起真来，草草送了终身大事，岂不可羞。","book":"明·凌濛初《二刻拍案惊奇》卷二"},"example":{"text":"但～ ，一生至一死，非同儿戏。","book":"清·曹雪芹《红楼梦》第六十五回"},"similar":["男婚女嫁"],"usage":"作谓语、定语；多指婚姻"},{"id":36340,"word":"终身让路，不枉百步","pinyin":"zhōng shēn ràng lù，bù wǎng bǎi bù","abbr":"zsrlbwbb","explanation":"枉：冤枉。一生给他人让路，加起来，走的冤枉路不会超过百步。比喻对人谦让，不会有害处。","source":{"text":"终身让路，不枉百步；终身让畔，不失一段。","book":"《新唐书·朱敬则传》"},"usage":"作宾语、定语；用于书面语"},{"id":36341,"word":"终非了局","pinyin":"zhōng fēi liǎo jú","abbr":"zflj","explanation":"了局：结局。终归不是长久之计。","source":{"text":"先兄弃世已三载，家嫂寡居，终非了局，弟常劝其改嫁。","book":"明·罗贯中《三国演义》第五十二回"},"example":{"text":"你孩子家不知道，在此地～。（清·曹雪芹《红楼梦》第八十二回）"},"similar":["终无了局"],"usage":"作谓语、定语；用于书面语"},{"id":36342,"word":"终非池中物","pinyin":"zhōng fēi chí zhōng wù","abbr":"zfczw","explanation":"终究不是池中的东西。指池塘中的蛟龙得云雨必然飞去。比喻总有一天要出人头地。","source":{"text":"今猥割土地以资业之，聚此三人，俱在疆场，恐蛟龙得云雨，终非池中物也。","book":"《三国志·吴志·周瑜传》"},"example":{"text":"今若纵之，恐蛟龙得云雨，～也。愿明公熟思之。（明·罗贯中《三国演义》第五十五回）"},"usage":"作谓语、定语；用于书面语"},{"id":36343,"word":"终食之间","pinyin":"zhōng shí zhī jiān","abbr":"zszj","explanation":"终：完成。吃完一顿饭的时间。形容时间很短。","source":{"text":"贫与贱，是人之恶也；不以其道得之，不去也。君子去仁，恶者成名？君子无终食之间违仁，造次必於是，颠沛必于是。","book":"《论语·里仁》"},"usage":"作宾语；用于书面语"},{"id":36344,"word":"绊手绊脚","pinyin":"bàn shǒu bàn jiǎo","abbr":"bsbj","explanation":"碍事。","source":{"text":"对自己的男人，要经常教育呢，免得他们绊手绊脚!","book":"王汶石《新结识的伙伴》"},"example":{"text":"路遥《平凡的世界》第一卷第21章：“那只黑猫～地紧撵着老汉。”"},"similar":["碍手碍脚"],"opposite":["无拘无束"],"usage":"作状语、定语；指不顺利"},{"id":36345,"word":"绊绊磕磕","pinyin":"bàn bàn kē kē","abbr":"bbkk","explanation":"形容路不好走或腿脚不灵。","source":{"text":"一人拖拉一双，在烂席片炕上绊绊磕磕跑着，高兴得呜呜直喊叫。","book":"路遥《平凡的世界》第一卷第21章"},"example":{"text":"她一路～地走过来了。"},"similar":["磕磕绊绊"],"opposite":["顺顺利利"],"usage":"作谓语、状语；指不顺畅"},{"id":36346,"word":"绊脚石","pinyin":"bàn jiǎo shí","abbr":"bjs","explanation":"绊脚的石头，比喻阻碍前进的东西。","source":{"text":"至于蒋介石呢，他消极抗战，积极反共，是人民抗战的绊脚石。","book":"毛泽东《抗日战争胜利后的时局和我们的方针》"},"example":{"text":"踢开～，好好干吧。"},"opposite":["垫脚石"],"usage":"作宾语；指不利的东西"},{"id":36347,"word":"绍休圣绪","pinyin":"shào xiū shèng xù","abbr":"sxsx","explanation":"绍：继续，接续。指继承祖先圣哲的美好事业。","source":{"text":"故旅耆老，复孝敬，选豪俊，讲文学，稽参政事，祈进民心，深诏执事，兴廉举孝，庶几成风，绍休圣绪。","book":"《汉书·武帝纪》"},"usage":"作谓语、宾语；指继承前人的事业"},{"id":36348,"word":"经一事，长一智","pinyin":"jīng yī shì，zhǎng yī zhì","abbr":"jyszyz","explanation":"亲身经历了某件事情，就能增长关于这方面的知识。","source":{"text":"人有常言：‘遭一蹶者得一便，经一事者长一智。’","book":"《新编五代史平话·汉史》"},"example":{"text":"然而‘～’，二十世纪已过了四分之一。","book":"鲁迅《华盖集续编·一点比喻》"},"similar":["吃一堑，长一智"],"usage":"作宾语、定语、分句；指亲身经历就能长知识"},{"id":36349,"word":"经一失，长一智","pinyin":"jīng yī shī，zhǎng yī zhì","abbr":"jyszyz","explanation":"经：经历；智：智慧，聪明。亲身经历了某件事情，就能增长关于这方面的知识。","source":{"text":"吾辈切记，不可轻易说人笑人，正所谓经一失，长一智耳。","book":"明·冯梦龙《警世通言》第三卷"},"similar":["经一事，长一智"],"usage":"作宾语、定语、分句；指亲身经历就能长知识"},{"id":36350,"word":"经世之才","pinyin":"jīng shì zhī cái","abbr":"jszc","explanation":"经世：经济、济民。称治国安民的才能。","source":{"text":"古来经济才，何事独罕有。","book":"唐·杜甫《舟中上水遗怀》"},"example":{"text":"某所荐者已百有余人，皆～，其在中外。","book":"明·陶宗仪《辍耕录·御史举荐》"},"similar":["经济之才","经国之才"],"opposite":["凡夫俗子"],"usage":"作主语、宾语；指治国安民的才能"},{"id":36351,"word":"经丘寻壑","pinyin":"jīng qiū xún hè","abbr":"jqxh","explanation":"指游览山水。","source":{"text":"既窈窕以寻壑，亦崎岖而经丘。","book":"晋·陶潜《归去来辞》"},"example":{"text":"游览自娱，曰得～之乐。","book":"宋·胡继宗《书言故事·地理类》"},"similar":["游山玩水"],"usage":"作宾语、定语；用于书面语"},{"id":36352,"word":"经久不息","pinyin":"jīng jiǔ bù xī","abbr":"jjbx","explanation":"经过长时间停不下来。","source":{"text":"人群沸腾起来，掌声和欢呼声经久不息。","book":"刘坚《草地晚餐》"},"example":{"text":"会场响起～的掌声。"},"similar":["响遏行云","余音绕梁"],"opposite":["万马齐喑","屏声静气","一朝一夕"],"usage":"作谓语、定语、状语；多指掌声和欢呼声"},{"id":36353,"word":"经久不衰","pinyin":"jīng jiǔ bù shuāi","abbr":"jjbs","explanation":"精神饱满的状态，身体健壮的外表。","example":{"text":"年轻人的耐力～，能够适应长久的训练。"},"similar":["经久不息"],"usage":"作谓语、定语；指持久"},{"id":36354,"word":"经史子集","pinyin":"jīng shǐ zǐ jí","abbr":"jszj","explanation":"经：经书，指儒家经典著作；史：史书，即正史；子：先秦百家著作；集：文集，即诗词汇编。泛指我国古代典籍。","source":{"text":"两都各聚书四部，以甲乙丙丁为次，列经史子集四库。","book":"《新唐书·艺文志一》"},"example":{"text":"就从妹子说一句书，无论～，大家都顶针续麻依次接下去。","book":"清·李汝珍《镜花缘》第七十八回"},"usage":"作主语、宾语、定语；指文献等"},{"id":36355,"word":"经史百子","pinyin":"jīng shǐ bǎi zǐ","abbr":"jsbz","explanation":"经：经学，经书，儒家经典著作；史：史学，史书；百子：诸子百家之学。旧指各个方面的很需要学问。","source":{"text":"子厚少精敏，无不通达……议论证据古今，出入经史百子。","book":"唐·韩愈《柳子厚墓志铭》"},"similar":["经史百家"],"usage":"作宾语、定语；指各方面的学问"},{"id":36356,"word":"经史百家","pinyin":"jīng shǐ bǎi jiā","abbr":"jsbj","explanation":"经：经学，经书，儒家经典著作；史：史学，史书；百家：诸子百家之学。旧指各个方面的很需要学问。","source":{"text":"子厚少精敏，无不通达……俊杰廉悍，议论证据今古，出入经史百子，踔厉风发，率常屈其座人，名声大振，一时皆慕与之交。","book":"唐·韩愈《柳子厚墓志铭》"},"example":{"text":"读～则虽不见一诗，而诗在其中。","book":"清·黄宗羲《〈南雷诗历〉题辞》"},"similar":["经史百子"],"usage":"作宾语、定语；指各方面的学问"},{"id":36357,"word":"经国之才","pinyin":"jīng guó zhī cái","abbr":"jgzc","explanation":"经：治理。有治理国家的才能。形容才能卓著。","source":{"text":"一时莫伦，有经国之才。","book":"晋·葛洪《抱朴子·外篇·自叙》"},"example":{"text":"祖迈，有～，为相国参军、散骑常侍。","book":"《晋书·刘坤传》"},"similar":["经世之才"],"usage":"作宾语；指治理国家的才干"},{"id":36358,"word":"经国大业","pinyin":"jīng guó dà yè","abbr":"jgdy","explanation":"经国：治理国家；大业：伟大的事业。极言文章有重要作用。","source":{"text":"盖文章经国之大业，不朽之盛事。","book":"三国·魏·曹丕《典论·论文》"},"usage":"作宾语、定语；用于文章等"},{"id":36359,"word":"经多见广","pinyin":"jīng duō jiàn guǎng","abbr":"jdjg","explanation":"经历的多，知道的广。形容阅历深，经验多。","source":{"text":"还是大家宝眷，见多识广，比男子汉眼力到胜十倍。","book":"明·冯梦龙《古今小说》卷一"},"example":{"text":"闯王虽然平日事事留心，特别对制造兵器的知识很丰富，可说是～，却一时认不出这是什么筋条。","book":"姚雪垠《李自成》第一卷二十七章"},"similar":["见多识广"],"usage":"作谓语、定语、宾语；指人的见识"},{"id":36360,"word":"经天纬地","pinyin":"jīng tiān wěi dì","abbr":"jtwd","explanation":"经、纬：织物的竖线叫“经”，横线叫“纬”，比喻规划。规划天地。形容人的才能极大，能做非常伟大的事业。","source":{"text":"天六地五，数之常也。经之以天，纬之以地。","book":"《左传·昭公二十八年》：“经纬天地曰文。”《国语·周语》"},"example":{"text":"想先生意中，必以为这一篇～的妙文，定能使《新青年》诸记者拜服得五体投地。","book":"刘半农《奉答王敬轩先生》"},"similar":["治国安民","经纬天下"],"opposite":["无所作为","才疏学浅"],"usage":"作谓语、定语；指人的才能"},{"id":36361,"word":"经始大业","pinyin":"jīng shǐ dà yè","abbr":"jsdy","explanation":"经始：原指开始测量营建，后泛指开创事业。指开基立国的重大事业。","source":{"text":"经始大业，造创帝基。畏天之命，于时保之。","book":"《乐府诗集·宣皇帝登歌》"},"usage":"作主语、宾语、定语；用于书面语"},{"id":36362,"word":"经官动府","pinyin":"jīng guān dòng fǔ","abbr":"jgdf","explanation":"谓惊动官府，引起官府干涉。","source":{"text":"自亲骨肉虽是一时有些不是处，只宜好好宽解，不可便经官动府，坏了和气，失了体面。","book":"明·凌濛初《初刻拍案惊奇》卷十六"},"example":{"text":"［我］私自与他成其伉俪……望姑娘笃念骨肉之亲，成了此事，岂不美乎！免去～，玷辱山门，有辱姑娘清规。","book":"明·无名氏《女真观》第三折"},"usage":"作谓语、定语、宾语；用于处事"},{"id":36363,"word":"经岁之储","pinyin":"jīng suì zhī chǔ","abbr":"jszc","explanation":"岁：一年。够一年用的储蓄。","source":{"text":"生民废业，饥馑流亡，公家无经岁之储，百姓无安固之志，难以持久。","book":"《三国志·魏志·毛玠传》"}},{"id":36364,"word":"经师人师","pinyin":"jīng shī rén shī","abbr":"jsrs","explanation":"经师：研究或传授儒家经典的学者；人师：教人如何做人的师表。指教授经典学术的学者和培养人才品德的老师。","source":{"text":"盖闻经师易遇，人师难遭，故欲以卖丝之质，附近朱蓝耳。","book":"晋·袁宏《后汉记·灵帝纪上》"},"example":{"text":"师之与儒殆如后世所称～。","book":"清·章太炎《国学讲演录·诸子略说》"}},{"id":36365,"word":"经师易遇，人师难遭","pinyin":"jīng shī yì yù，rén shī nán zāo","abbr":"jsyyrsnz","explanation":"经师：古代教官；人师：为人师表的人；遭：遇到。单纯传授知识的老师容易遇到，为人师表的人不容易的人难遇到。","source":{"text":"昭曰：‘盖闻经师易遇，人师难遭。’","book":"晋·袁宏《后汉纪·灵帝纪》"},"example":{"text":"～，愿在左右，供给洒扫。","book":"宋·司马光《资治通鉴·汉纪·桓帝延熹七年》"},"usage":"作宾语、定语；用于慨叹","story":["汉灵帝时期，博学多才而又为人正直的郭泰深受人们的爱戴，魏昭儿时多次去拜访他，表示愿意做他的随从帮他打扫庭院，郭泰问他为什么不去读诗书而给他当佣人，魏昭回到道：“经师易遇，人师难遭。”，郭泰十分欣赏他"]},{"id":36366,"word":"经帮纬国","pinyin":"jīng bāng wěi guó","abbr":"jbwg","explanation":"经、纬：本指丝织物的纵线和横线，引申为治理、规划；邦：国家。指治理国家。","source":{"text":"是以经邦纬国必俟曹之勋，燮理阴阳允归锺华之望。","book":"唐·李世民《授长孙无忌司徒诏》"}},{"id":36367,"word":"经年累月","pinyin":"jīng nián lěi yuè","abbr":"jnly","explanation":"经：经历。指经过很久的时间；长时间。","source":{"text":"幸有章子前去，可以无虞，教俺不须记挂，但虽则如此，千山万水，经年累月，好是悬悬。","book":"明·孙仁孺《东郭记·为衣服》"},"example":{"text":"不要说十日半月，即～，也是烦难。","book":"清·夏敬渠《野叟曝言》第一○八回"},"similar":["经年累稔","连年累岁","长年累月"],"usage":"作定语、状语；形容经历的时间很长久"},{"id":36368,"word":"经文纬武","pinyin":"jīng wén wěi wǔ","abbr":"jwww","explanation":"治理国家的本领，文的武的都具备。","source":{"text":"早复圣迹神功，不可得而窥测，经文纬武，敢有寄于名言。","book":"唐·许敬宗《定宗庙乐议》"},"example":{"text":"（伍子胥）有扛鼎拔山之勇，～之才。","book":"明·冯梦龙《东周列国志》第七十二回"},"similar":["经武纬文"],"usage":"作谓语、宾语；用于治理国家"},{"id":36369,"word":"经明行修","pinyin":"jīng míng xíng xiū","abbr":"jmxx","explanation":"旧指通晓经学，品行端正。","source":{"text":"左曹陈咸荐骏贤父子，经明行修，宜显以厉俗。","book":"《汉书·王吉传》"},"example":{"text":"今博士皆～，一国清选。","book":"《三国志·魏书·高柔传》"},"usage":"作谓语、宾语；指通晓经学，品行端正"},{"id":36370,"word":"经武纬文","pinyin":"jīng wǔ wěi wén","abbr":"jwww","explanation":"经：丝织品的直线；武：武功；纬：丝织品的横线；文：文治。以武功和文德治理国家。","source":{"text":"若夫入神造极之灵，经武纬文之德，故可与和乐等妙。","book":"南朝·梁·沈约《棋品序》"},"usage":"作宾语、定语；用于书面语"},{"id":36371,"word":"经济之才","pinyin":"jīng jì zhī cái","abbr":"jjzc","explanation":"指治国安民的才能。","source":{"text":"古来经济才，何事独罕有。","book":"唐·杜甫《上水遣怀》诗"},"example":{"text":"此人察风云以辨天时，望气色而观地理，有～，安天下之手。","book":"元·郑光祖《伊尹耕莘》第二折"},"usage":"作宾语；指治国安民的才能"},{"id":36372,"word":"经纬万端","pinyin":"jīng wěi wàn duān","abbr":"jwwd","explanation":"比喻头绪极多。","source":{"text":"神心恍惚，经续万方。","book":"汉·扬雄《法言·问神》"},"example":{"text":"国基初定，～，相与有成，期我益友，嗣后凡大计所关，务望遇事指陈，以匡不逮。","book":"蔡东藩、许廑父《民国通俗演义》第三十六回"},"usage":"作宾语、定语；比喻头绪极多"},{"id":36373,"word":"经纬天下","pinyin":"jīng wěi tiān xià","abbr":"jwtx","explanation":"经，纬：治理。指治理国家。","source":{"text":"普施明法，经纬天下，永为仪则。","book":"《史记·秦始皇本纪》"},"example":{"text":"今功未可期，而遗黎歼尽，劳役无已，征求日重，以区区吴越，～十分之九，不亡何待？","book":"蔡东藩《两晋演义》第五十五回"},"usage":"作谓语、定语；指治理国家"},{"id":36374,"word":"经纬天地","pinyin":"jīng wěi tiān dì","abbr":"jwtd","explanation":"本指以天地为法度。后谓经营天下，治理国政。亦形容政治才识卓越不凡。","source":{"text":"经纬天地而材官万物，制割大理，而宇宙里（理）矣。","book":"《左传·昭公二十八年》：“经纬天地曰文。”《荀子·解蔽》"},"similar":["经天纬地"],"usage":"作谓语、定语；指人的才能"},{"id":36375,"word":"经纶天下","pinyin":"jīng lún tiān xià","abbr":"jltx","explanation":"经纶：整理丝缕；天下；国家。治理国家。","source":{"text":"言君子法此屯象有为之时，以经纶天下。","book":"《周易·屯》：“君子以经纶。”孔颖达疏"},"example":{"text":"岳与高祖～，家有私兵，并畜戎器。","book":"《北齐书·清河王岳列传》"},"usage":"作谓语、宾语；指治理国家"},{"id":36376,"word":"经纶济世","pinyin":"jing lun ji shi","abbr":"jljs","explanation":"指具有治理国家，经世济民的才能。经纶：整理丝缕，引申为处理国家大事。济世：救世。","source":{"text":"哥哥，想你学成经纶济世之策，立国安邦之谋，若列朝纲……可不强如耕种为活也。","book":"元·郑光祖《伊尹耕莘》第二折"},"example":{"text":"关、张、赵云，皆万人敌，惜无善用之之人。若孙乾、糜竺辈，乃白面书生，非～之才也。","book":"明·罗贯中《三国演义》第三十五回"},"usage":"作宾语、定语；指治理国家"},{"id":36377,"word":"经纶满腹","pinyin":"jīng lún mǎn fù","abbr":"jlmf","explanation":"经纶：整理丝缕，引申为人的才学、本领。形容人极有才干和智谋。","source":{"text":"云雷屯，君子以经纶。","book":"《周易·屯》"},"example":{"text":"我看其人博古通今，年逾五旬，～，诚可为令婿楷模。","book":"清·李绿园《歧路灯》第五十五回"},"similar":["满腹经纶","满腹长才"],"opposite":["才疏学浅"],"usage":"作谓语；形容人很有学问"},{"id":36378,"word":"经营惨淡","pinyin":"jīng yíng cǎn dàn","abbr":"jycd","explanation":"经营：筹划营谋；惨淡：思虑深至的样子。苦心经营。指对艺术创作的苦心构思。","source":{"text":"然不运则已，一运则经营惨淡，坐起不宁，其累有不可胜言者。","book":"清·李渔《闲情偶寄·颐养·富人行乐之法》"},"similar":["经营惨澹","惨淡经营"],"usage":"作谓语、定语；形容艰苦地筹划与工作"},{"id":36379,"word":"经营惨澹","pinyin":"jīng yíng cǎn dàn","abbr":"jycd","explanation":"经营：筹划营谋；惨澹：思虑深至的样子。苦心经营。指对艺术创作的苦心构思。","source":{"text":"花余歌舞欢娱外，诗在经营惨澹中。","book":"宋·辛弃疾《鹧鸪天·和昌父》词"},"example":{"text":"全国民族亦遂不得不～，跋涉苦辛，相率而就于过渡之道。","book":"梁启超《过渡时代论》"},"similar":["经营惨淡"],"usage":"作谓语、定语；形容艰苦地筹划与工作"},{"id":36380,"word":"经营擘划","pinyin":"jīng yíng bò huà","abbr":"jybh","explanation":"擘划：处置，安排。指经营筹划。","source":{"text":"经他的经营擘划，倒也安顿得井井有条，大家都好像是很愉快的。","book":"郭沫若《洪波曲》第十二章"},"similar":["经营策划"],"usage":"作宾语、定语；用于处事"},{"id":36381,"word":"经达权变","pinyin":"jīng dá quán biàn","abbr":"jdqb","explanation":"达：通晓，懂得；权、变：权宜，变通。做理能适应客观情况的变化，懂得变通，不死守常规。","source":{"text":"荀彧清秀通雅，有王佐之风，然机鉴先识，未能充其志也。荀攸、贾诩，庶乎算无遗策，经达权变，其良、平之亚欤!","book":"《三国志·魏志·荀彧攸贾诩传》"}},{"id":36382,"word":"经邦纬国","pinyin":"jīng bāng wěi guó","abbr":"jbwg","explanation":"经、纬：本指丝织物的纵线和横线，引申为治理、规划。邦：国家。指治理国家。","source":{"text":"是以经邦纬国必俟曹之勋，燮理阴阳允归锺华之望。","book":"李世民《授长孙无忌司徒诏》"},"similar":["治国安邦"],"usage":"作宾语；指治理国家"},{"id":36383,"word":"经邦论道","pinyin":"jīng bāng lùn dào","abbr":"jbld","explanation":"指治理国家，谈论治国之道。比喻位居高层。","source":{"text":"臣日薄桑榆，位高轩冕，经邦论道，自顾缺然。","book":"《隋书·李穆传》"},"example":{"text":"今朝喜得登廊庙，佐明君～，这都是辛苦中博来荣耀。","book":"《群音类选·》"},"usage":"作谓语；指治理国家"},{"id":36384,"word":"经风雨见世面","pinyin":"jīng fēng yǔ jiàn shì miàn","abbr":"jfyxsm","explanation":"比喻在实际生活、实际斗争中锻炼。","example":{"text":"我已经是一个～的男人了。"}},{"id":36385,"word":"经风雨，见世面","pinyin":"jīng fēng yǔ，jiàn shì miàn","abbr":"jfyxsm","explanation":"经过许多磨难，见多识广。形容人的生活阅历丰富。","source":{"text":"我们共产党员应该经风雨，见世面；这个风雨，就是群众斗争的大风雨，这个世面，就是群众斗争的大世面。","book":"毛泽东《组织起来》"},"example":{"text":"几位激进派坚持要～，要到大风大浪中去锻炼。","book":"肖复兴《捉奸》十三"},"usage":"作谓语、定语；用于人生"},{"id":36386,"word":"经验主义","pinyin":"jīng yàn zhǔ yì","abbr":"jyzy","explanation":"指凭自己的经验来处事的世界观。","source":{"text":"这种恶劣的经验主义，使我们遭受了严重的损害。","book":"邓小平《贯彻执行中共中央关于土改与整党工作的指示》"},"similar":["主观主义"],"usage":"作主语、宾语、定语；用于处事"},{"id":36387,"word":"经验之谈","pinyin":"jīng yàn zhī tán","abbr":"jyzt","explanation":"言谈有实践作为根据、切实、可靠。","source":{"text":"‘钟老这是经验之谈啊！’小潘大声笑着说。","book":"巴金《寒夜》"},"example":{"text":"他的这番话是～，值得参考。"},"opposite":["滑稽之谈"],"usage":"作宾语；指经验"},{"id":36388,"word":"经验教训","pinyin":"jīng yàn jiào xùn","abbr":"jyjx","explanation":"从多次实践中得到的知识或技能和从错误或挫折中得到的经验。","source":{"text":"历史经验教训说明，不开放不行。","book":"邓小平《在中央顾问委员会第三次全体会议上的讲话》"},"usage":"作主语、宾语、定语；用于口语等"},{"id":36389,"word":"结不解缘","pinyin":"jié bù jiě yuán","abbr":"jbjy","explanation":"缘：缘分。形容男女热恋，不能分开。也指两者有不可分开的缘分。","source":{"text":"文彩双鸳鸯，裁为合欢被，著以长相思，缘以结不解。","book":"《古诗十九首》"},"usage":"作谓语；用于口语"},{"id":36390,"word":"结党聚群","pinyin":"jié dǎng jù qún","abbr":"jdjq","explanation":"结：勾结，结交；党：朋辈，党羽；聚：聚合，纠集。勾结党羽和徒众。指聚众成势。","source":{"text":"或轻死重气，结党聚群；或勇冠乡邦，剑客驰逐。","book":"《宋书·谢灵运传》"},"example":{"text":"乃嫌迹愈兴，祸图兹构，收容亡命，～。","book":"《南齐书·王敬则传》"},"similar":["结党连群"],"usage":"作谓语、宾语、定语；用于处事"},{"id":36391,"word":"结党营私","pinyin":"jié dǎng yíng sī","abbr":"jdys","explanation":"党：集团；营：谋求。坏人集结在一起，谋求私利，专干坏事。","source":{"text":"宰相植党营私，孤负任使。","book":"宋·朱熹《朱文公文集》十一"},"example":{"text":"但昔日既与叛逆结盟，究非安分之辈。今名登黄榜，将来出仕，恐不免～。","book":"清·李汝珍《镜花缘》第七回"},"similar":["营私舞弊","拉帮结派"],"opposite":["两袖清风"],"usage":"作谓语、定语、宾语；指拉帮结派"},{"id":36392,"word":"结党连群","pinyin":"jié dǎng lián qún","abbr":"jdlq","explanation":"结合同党，连成群体。","source":{"text":"轻死重气，结党连群，实蕃有徒，其从如云。","book":"汉·张衡《西京赋》"},"example":{"text":"若乃富商大贾，豪宗恶少，轻死重义，～，喑鸣则弯弓，睚眦则挺剑。","book":"《旧唐书·崔融传》"},"similar":["结党聚群"],"usage":"作谓语、宾语、定语；用于处事"},{"id":36393,"word":"结发夫妻","pinyin":"jié fà fū qī","abbr":"jffq","explanation":"结发：束发，意即年轻时。年轻时结成的夫妻。指原配夫妻。","source":{"text":"结发为夫妻，恩爱两不疑。","book":"汉·苏武《诗四首》三"},"example":{"text":"官人，我与你～，苦乐同受。","book":"明·冯梦龙《醒世恒言》卷九"},"similar":["元配夫妻","儿女夫妻"],"opposite":["再婚夫妻"],"usage":"作宾语；指第一次结婚的夫妻"},{"id":36394,"word":"结结实实","pinyin":"jiē jiē shí shí","abbr":"jjss","explanation":"很稳健、牢固、严实。","source":{"text":"家里又唤打竹家伙的，做一个结结实实的大竹篮。","book":"明·冯梦龙《醒世恒言》第38卷"},"example":{"text":"我们～地把他绑到派出所。"},"similar":["敦敦实实"],"usage":"作定语、状语；用于人或物体"},{"id":36395,"word":"结结巴巴","pinyin":"jiē jiē bā bā","abbr":"jjbb","explanation":"形容说话不流利。也比喻凑合，勉强。","source":{"text":"结结巴巴的，他把昨夜晚的事说了一遍，虽然费力，可是说的不算不完全。","book":"老舍《骆驼祥子》十三"},"example":{"text":"他说话总是～的。"},"similar":["吞吞吐吐"],"opposite":["出口成章"],"usage":"作谓语、宾语；形容说话不连贯流畅"},{"id":36396,"word":"结绳而治","pinyin":"jié shéng ér zhì","abbr":"jsez","explanation":"原指上古没有文字，用结绳记事的方法治理天下。后也指社会清平，不用法律治国的空想。","source":{"text":"上古结绳而治，后世圣人易之以书契。","book":"《周易·系辞下》"},"example":{"text":"曹蜍、李志虽见在，厌厌如九泉下人，人皆如此，便可～。","book":"南朝·宋·刘义庆《世说新语·品藻》"},"usage":"作谓语、宾语；指原始管理方法"},{"id":36397,"word":"结缨伏剑","pinyin":"jié yīng fú jiàn","abbr":"jyfj","explanation":"结缨：系好帽子上的带子。系好帽带，以身伏剑。比喻从容就义。","source":{"text":"常欲结缨伏剑，少谢万一。","book":"《左传·哀公十五年》：“子路曰：‘君子死，冠不免。’结缨而死。”南朝·梁·江淹《狱中上建平王书》"},"example":{"text":"南朝·梁·江淹《狱中上建平王书》：“常欲～，少射万一。”"},"usage":"作谓语、宾语、状语；用于处事"},{"id":36398,"word":"结舌杜口","pinyin":"jié shé dù kǒu","abbr":"jsdk","explanation":"结舌：舌头像打了结子，动弹不得。杜：堵塞。保持缄默，闭口不言。形容因恐惧而不敢说话。","source":{"text":"天下莫不望风而靡，自尚书近臣皆结舌杜口，骨肉亲属莫不股栗。","book":"东汉·班固《汉书·杜周传》"},"example":{"text":"故爱身之士，自为己计，莫不～，孰肯冒忌干主哉！","book":"《宋书·彭城王义康传》"},"similar":["杜口结舌","结舌钳口"],"usage":"作谓语、宾语；指无言以对"},{"id":36399,"word":"结舌钳口","pinyin":"jié shé qián kǒu","abbr":"jsqk","explanation":"结舌：不敢讲话；钳：夹。闭着嘴说不出话来。形容理屈词穷，无言以对或指内心恐惧。","source":{"text":"今子奋身寒苦，遭世隆昌，历金门，上玉堂，载笔螭坳，日侍清光，曾不能结舌钳口，循默自守。","book":"宋·李纲《答宾劳》"},"similar":["结舌杜口"],"usage":"作谓语、宾语；指无言以对"},{"id":36400,"word":"结草之固","pinyin":"jié cǎo zhī gù","abbr":"jczg","explanation":"结草：用草扎结而成。形容很不牢固，就象草扎的一样。","source":{"text":"方岳无钧石之镇，关门无结草之固。","book":"晋·干宝《晋记·总论》"},"example":{"text":"国政迭移于乱人，禁兵外散于四方，方岳无钧石之镇，关门无～。","book":"《资治通鉴·晋纪十一》"}},{"id":36401,"word":"结草衔环","pinyin":"jié cǎo xián huán","abbr":"jcxh","explanation":"结草：把草结成绳子，搭救恩人；衔环：嘴里衔着玉环。旧时比喻感恩报德，至死不忘。","source":{"text":"莫学衔环雀，崎岖谩报恩。","book":"《左传·宣公十五年》：“及辅氏之役，颗见老人结草以亢杜回，杜回踬而颠，故获之。”唐·白居易《赎鸡》诗"},"example":{"text":"俺田家祖上一百世的祖宗，做鬼都感激二位爷的恩典，～，一定会报答你二位的。","book":"清·刘鹗《老残游记》第十四回"},"similar":["感恩报德","饮水思源"],"opposite":["以德报怨","忘恩负义"],"usage":"作谓语、宾语、定语、状语；比喻感恩戴德","story":["春秋时期，晋国大夫魏颗没有按照父亲的遗愿让小老婆陪葬而让她改嫁他人，小老婆的父亲的灵魂在战场上把草打结绊倒秦国大将杜回帮助魏颗取胜来报答。东汉人杨宝救了一只受伤的小黄雀，小黄雀伤好后叼来四个玉环来报答杨宝救命之恩"]},{"id":36402,"word":"结驷列骑","pinyin":"jié sì liè qí","abbr":"jslq","explanation":"驷：套着四匹马的车；骑：一人一马的合称。高车骏马连接成队。形容高贵显赫。","source":{"text":"楚欲以我为相。今日相，即结驷列骑，食方丈于前，如何？","book":"西汉·韩婴《韩诗外传》第九卷"},"similar":["结驷连骑","结驷连镳"],"usage":"作宾语、定语；形容排场阔绰"},{"id":36403,"word":"结驷连镳","pinyin":"jié sì lián biāo","abbr":"jslb","explanation":"驷：套着四匹马的车；镳：马勒。高车骏马连接成队。形容高贵显赫。","source":{"text":"结驷连镳之游，侈袂执圭之贵。","book":"南朝·梁·萧统《序》"},"similar":["结驷连骑","结驷列骑"],"usage":"作宾语、定语；形容排场阔绰"},{"id":36404,"word":"结驷连骑","pinyin":"jié sì lián qí","abbr":"jslq","explanation":"驷：古时一乘车所套的四匹马；骑：骑马的人。随从、车马众多。形容排场阔绰。","source":{"text":"子贡相卫，而结驷连骑，排藜藿，入穷阎，过谢原宪。","book":"《史记·仲尼弟子列传》"},"example":{"text":"今日为相，明日～，食方于前。","book":"明·李贽《初潭集·夫妇二》"},"similar":["结驷列骑","结驷连镳"],"usage":"作宾语、定语；形容排场阔绰"},{"id":36405,"word":"绕梁三日","pinyin":"rào liáng sān rì","abbr":"rlsr","explanation":"形容音乐高昂激荡，虽过了很长时间，好像仍在回响。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"},"example":{"text":"参见“余音绕梁”。"},"similar":["余音绕梁","娓娓动听"],"opposite":["不堪入耳","鬼哭狼嚎"],"usage":"作谓语、定语；用于声音或音乐","story":["传说古代有个善于唱歌的韩娥路过齐国，钱花完后就只好在雍门卖唱，她的歌喉清脆圆润，婉转动人。很多人跑到她住宿的旅店要求再唱，被他们的诚意打动，韩娥再唱一次。过了两三天，人们还觉得歌唱的余音袅袅，在屋梁间回绕飘荡"]},{"id":36406,"word":"绕梁之音","pinyin":"rào liáng zhī yīn","abbr":"rlzy","explanation":"形容歌声美妙动听。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"},"example":{"text":"～，实萦弦所思。","book":"晋·陆机《演连珠》"},"similar":["余音绕梁"],"usage":"作主语、宾语；用于音乐等"},{"id":36407,"word":"绕梁遏云","pinyin":"rào liáng è yún","abbr":"rley","explanation":"绕梁：绕着屋梁，形容歌声保留时间长久；遏云：形容歌声嘹亮高入云端。余声嘹亮，响彻云霄。形容歌声十分动听。","source":{"text":"昔韩娥东之齐，匮粮，过雍门，鬻歌假食，既去而余音绕梁，三日不绝，左右以其人弗去。","book":"《列子·汤问》"}},{"id":36408,"word":"绕脖子","pinyin":"rào bó zǐ","abbr":"rbz","explanation":"说话、做事绕弯子。形容言语、事情折费思索。","source":{"text":"算了，我不和你绕脖子了。","book":"冯骥才《铺花的歧路》"},"usage":"作谓语、宾语、定语；用于口语"},{"id":36409,"word":"绘事后素","pinyin":"huì shì hòu sù","abbr":"hshs","explanation":"后素：在有了白色底子以后。指先有白色底子，才能进行彩绘。比喻礼乐产生于仁义之后。也比喻做事应先从简单做起，然后逐步深入。","source":{"text":"子曰：‘绘事后素。’","book":"《论语·八佾》"},"example":{"text":"夫～，既谓之文，岂苟简而已哉。","book":"唐·皇甫湜《答李生第二书》"},"usage":"作宾语、定语；用于书面语"},{"id":36410,"word":"绘声写影","pinyin":"huì shēng xiě yǐng","abbr":"hsxy","explanation":"绘：描绘，描摹。形容叙述或描写生动逼真。","source":{"text":"凡扬州十日之屠，嘉定万家之惨，以及虏酋丑类之慆淫，烈士遗民之忠荩，皆绘声写影，倾筐倒箧而出之。","book":"柳亚子《二十世纪大舞台发刊词》"},"similar":["绘声绘影","绘声绘形","绘影绘声"],"usage":"作谓语、定语、状语；形容叙述或描写生动"},{"id":36411,"word":"绘声状物","pinyin":"huì shēng zhuàng wù","abbr":"hszw","explanation":"绘：描摹，形容；状：描摹。对事物的描绘。","source":{"text":"《三侠五义》及其续书，绘声状物，甚有平话习气。","book":"鲁迅《中国小说史略》第27篇"},"usage":"作谓语、宾语；用于写作等"},{"id":36412,"word":"绘声绘形","pinyin":"huì shēng huì xíng","abbr":"hshx","explanation":"绘：描绘，描摹。形容叙述或描写生动逼真。","source":{"text":"有些爱情的描写，虽是竭力绘声绘形，实在没有什么美的新意在其中。","book":"孙犁《澹定集·读作品记》"},"example":{"text":"这28个字～地刻画出一幅古代美人图。"},"similar":["绘声绘色","绘声写影"],"usage":"作谓语、定语、状语；用于演讲等"},{"id":36413,"word":"绘声绘影","pinyin":"huì shēng huì yǐng","abbr":"hshy","explanation":"形容叙述或描写生动逼真。","source":{"text":"《春燕词》四首，绘声绘影，珠惭体物之工；宜雅宜风，聊寄缘情之感。","book":"清·捧花生《秦淮画舫录》卷下·征题·抑山《忆燕词序》"},"example":{"text":"～样翻新，描写秋娘事事真。","book":"清·萧山湘灵子《轩亭冤》题词"},"similar":["绘声绘色","绘影绘声"],"usage":"作谓语、定语、状语；形容叙述或描写生动"},{"id":36414,"word":"绘声绘色","pinyin":"huì shēng huì sè","abbr":"hshs","explanation":"把人物的声音、神色都描绘出来了。形容叙述或描写生动逼真。","source":{"text":"必使山情水性，因绘声绘色而曲得其真；务期天巧地灵，借人工人第而华传其妙。","book":"清·朱庭珍《筱园诗话》卷一"},"example":{"text":"尤其是谈她自己的儿女，那真是～，细致入微，没完没了。","book":"冯德英《迎春花》第九章"},"similar":["有声有色","活龙活现","栩栩如生"],"opposite":["平淡无奇","枯燥无味"],"usage":"作谓语、定语、状语；用于演讲等"},{"id":36415,"word":"绘影绘声","pinyin":"huì yǐng huì shēng","abbr":"hyhs","explanation":"形容叙述或描写生动逼真。","source":{"text":"《桃花扇》笔意疏爽，写南朝人物，字字绘影绘声。","book":"清·梁廷枬《曲话》三"},"example":{"text":"从头到尾，指手画脚，～地说一阵。","book":"李六如《六十年的变迁》"},"similar":["绘声绘色","绘声绘影"],"usage":"作谓语、定语、状语；形容叙述或描写生动"},{"id":36416,"word":"绚丽多姿","pinyin":"xuàn lì duō zī","abbr":"xldz","explanation":"绚：绚烂，有文采的样子。绚烂艳丽，样式丰富多彩。形容五彩缤纷，非常好看。","similar":["五彩缤纷"],"usage":"多用于褒义。"},{"id":36417,"word":"绚丽多彩","pinyin":"xuàn lì duō cǎi","abbr":"xldc","explanation":"形容色彩华丽。","source":{"text":"荧光染色剂把蔚蓝色的海水染成翠绿色，像一条数百米长的锦带漂浮在洋面上，绚丽多彩，好看极了。","book":"《飞向太平洋》"},"example":{"text":"我希望有～的生活。"},"similar":["五彩缤纷"],"usage":"作谓语、定语；指色彩丰富"},{"id":36418,"word":"络绎不绝","pinyin":"luò yì bù jué","abbr":"lybj","explanation":"形容行人车马来来往往，接连不断。","source":{"text":"窜逃入塞者络绎不绝。","book":"《后汉书·南匈奴传》"},"example":{"text":"我梦里所到的地方，竟是一片康庄大道，马来车往，～。","book":"清·李宝嘉《官场现形记》第六十回"},"similar":["连绵不断","川流不息","源源不断"],"opposite":["七零八落"],"usage":"作谓语、定语、状语；指人多"},{"id":36419,"word":"络驿不绝","pinyin":"luò yì bù jué","abbr":"lybj","explanation":"络绎不绝，形容人、马等连续不断。","source":{"text":"逢侯部众饥穷又为鲜卑所击，无所归，窜逃入塞者络驿不绝。","book":"南朝·宋·范晔《后汉书·南匈奴传》"},"example":{"text":"我梦里所到的地方，竟是一片康庄大道，马来车往，～。","book":"清·李宝嘉《官场现形记》第60回"},"similar":["骆驿不绝","络绎不绝"],"usage":"作谓语、定语、状语；形容多"},{"id":36420,"word":"绝不护短","pinyin":"jué bù hù duǎn","abbr":"jbhd","explanation":"护短：自讳过失。指丝毫不护着自己的短处或过失。","source":{"text":"我决定对子女的教育～。"},"example":{"text":"我决定对子女的教育～"},"usage":"作谓语、定语；指敢于承认缺点","story":["明朝初期，开国皇帝朱元璋从多宝寺请来一个老秀才给太子当老师。这个秀才教书特别严格，太子特别顽皮，不听教诲而且不把老师放在眼里。秀才动手教训他被朱元璋看见，要求放他一马。皇后马娘娘立即制止朱元璋的行为，绝不护短"]},{"id":36421,"word":"绝不轻饶","pinyin":"jué bù qīng ráo","abbr":"jbqr","explanation":"指对违背意志的事情或行为不轻易放过。","example":{"text":"我们对那些损人利己的行为～。"},"usage":"作谓语；指态度坚决","story":["东汉末年，曹操用计打败了吕布，占领徐州。吕布败走下邳城，闭门不战，曹操施行大水淹城。吕布发誓戒酒色，并对下属喝酒者绝不轻饶，迫使守将侯成等投奔曹操，手下全都献城投降，吕布被俘。曹操立即处死了他"]},{"id":36422,"word":"绝世佳人","pinyin":"jué shì jiā rén","abbr":"jsjr","explanation":"绝世：当世独一无二；佳人：美人。当代最美的女人。","source":{"text":"北方有佳人，绝世而独立。","book":"《汉书·外戚传》载李延年歌"},"example":{"text":"虽居富贵，不爱铅华。敢夸～，自许朝天素面。","book":"清·洪昇《长生殿·幸恩》"},"similar":["绝色佳人","绝代佳人"],"usage":"作主语、宾语；用于女性","story":["汉朝中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":36423,"word":"绝世出尘","pinyin":"jué shì chū chén","abbr":"jscc","explanation":"指超绝尘世之外，不同凡俗。","source":{"text":"遂鼓《御风曲》，其声泠泠，有绝世出尘之意。","book":"清·蒲松龄《聊斋志异·局诈》"},"similar":["绝俗离世"],"usage":"作谓语、定语；用于书面语"},{"id":36424,"word":"绝世无伦","pinyin":"jué shì wú lún","abbr":"jswl","explanation":"绝世：当世所没有，指冠绝当世。冠绝当世，超过同辈。","source":{"text":"颖川陈君，绝世超伦，大位未跻，惭于臧文窃位之负，故时人高其德，重乎公相之位也。","book":"汉·蔡邕《陈太丘碑文》"},"example":{"text":"其第三子名玉斧，长名翙，字道翔。道德淳莹，～。","book":"宋·张君房《云笈七签》卷四"},"similar":["绝世超伦"],"usage":"作谓语、宾语；形容非凡的成就"},{"id":36425,"word":"绝世无双","pinyin":"jué shì wú shuāng","abbr":"jsws","explanation":"绝世：冠绝当代；无双：独一无二。姿才超众，天下无与伦比。","source":{"text":"我看此女妖娆艳冶，绝世无双。","book":"元·李好古《张生煮海》一"},"example":{"text":"英姿～，用之将帅，必能扶弱鼎于安澜。","book":"明·吾丘瑞《远甓记·师阃宾贤》"},"similar":["盖世无双"],"usage":"作谓语、定语；指独一无二"},{"id":36426,"word":"绝世独立","pinyin":"jué shì dú lì","abbr":"jsdl","explanation":"绝世：当代独一无二。当世无双，卓然而立。多用来形容不同凡俗的美貌女子。","source":{"text":"北方有佳人，绝世而独立，一顾倾人城，再顾倾人国。","book":"东汉·班固《汉书·孝武李夫人传》"},"example":{"text":"据古守经，盖～。","book":"宋·陆游《贺谢提举启》"},"similar":["倾国倾城"],"usage":"作谓语、定语；用于女性","story":["汉朝中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝世佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":36427,"word":"绝世超伦","pinyin":"jué shì chāo lún","abbr":"jscl","explanation":"绝世：当世所没有，指冠绝当世；超伦：超过同辈的人。冠绝当世，超过同辈。","source":{"text":"颖川陈君，绝世超伦，大位未跻，惭于臧文窃位之负，故时人高其德，重乎公相之位也。","book":"汉·蔡邕《陈太卫碑文》"},"example":{"text":"王羲之的书法～。"},"similar":["绝无仅有","绝世无伦"],"opposite":["碌碌无为"],"usage":"作谓语、宾语；形容非凡的成就"},{"id":36428,"word":"绝人事","pinyin":"jue ren shi","abbr":"jrs","explanation":"不与亲朋交往。"},{"id":36429,"word":"绝仁弃义","pinyin":"jué rén qì yì","abbr":"jrqy","explanation":"绝、弃：放弃。指放弃世俗倡导的仁义，回复到人的本性。这是老子无为而治的思想。","source":{"text":"绝圣弃智，民利百倍，绝仁弃义，民复孝德。","book":"《老子》第十九章"},"usage":"作宾语、定语；指无为而治"},{"id":36430,"word":"绝代佳人","pinyin":"jué dài jiā rén","abbr":"jdjr","explanation":"绝代：当代独一无二；佳人：美人。当代最美的女人。","source":{"text":"北方有佳人，绝世而独立。","book":"《汉书·外戚传》载李延年歌"},"example":{"text":"～曾一笑，倾城倾国。","book":"宋·辛弃疾《满江红》词"},"similar":["如花似玉","出水芙蓉"],"opposite":["青面獠牙"],"usage":"作主语、宾语；形容女子极为美貌","story":["汉朝中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝代佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":36431,"word":"绝伦超群","pinyin":"jué lún chāo qún","abbr":"jlcq","explanation":"伦：类；绝伦：特异，超过同辈。超出众人，没有可以相比的。","source":{"text":"因思天下之大，仁兆之众，安能必其无绝伦超群之人。","book":"清·刘献廷《广阳杂记》第三卷"},"example":{"text":"这事非～者不能胜任。"},"similar":["绝伦逸群"],"usage":"作谓语、定语；指盖世无双"},{"id":36432,"word":"绝伦逸群","pinyin":"jué lún yì qún","abbr":"jlyq","explanation":"伦：类；逸：超过。超出众人，没有可以相比的。","source":{"text":"当与翼德并驱争先，犹未及髯公绝伦逸群也。","book":"三国·蜀·诸葛亮《答关云长书》"},"example":{"text":"况贤弟未尝晤接，而才识～，笔则笔，削则削。","book":"明·朱之渝《答安东守约书三十首》"},"similar":["绝伦超群"],"usage":"作谓语、定语；指盖世无双"},{"id":36433,"word":"绝俗离世","pinyin":"jué sú lí shì","abbr":"jsls","explanation":"指远离世俗尘世。","source":{"text":"何必偃卬离信若彭祖，呴嘘呼吸如侨、松，眇然绝俗离世哉。","book":"《汉书·王褒传》"},"similar":["绝世出尘"],"usage":"作谓语、定语；用于书面语"},{"id":36434,"word":"绝其本根","pinyin":"jué qí běn gēn","abbr":"jqbg","explanation":"本：草木的根。从根本上予以解决。","source":{"text":"为国家者，见恶如农夫之务去草焉，芟夷蕴崇之，绝其本根，勿使能殖，则善者信矣。","book":"《左传·隐公六年》"},"example":{"text":"取此种子芟夷蕴崇之，～而勿使能殖也。","book":"清·梁启超《论进步》"},"similar":["釜底抽薪"],"usage":"作谓语；指从根本上予以解决"},{"id":36435,"word":"绝口不提","pinyin":"jué kǒu bù tí","abbr":"jkbt","explanation":"绝口：始终不开口；提：举出。指闭口不说话。","source":{"text":"记得在闲谈中，鲁迅先生还讲起一些他和青年交往的故事，至于自己怎样尽心竭力，克己为人，却绝口不提。","book":"唐弢《琐忆》"},"example":{"text":"钱钟书《围城》：“苏小姐初到家，开口闭口都是方鸿渐，第五天后忽然～。”"},"similar":["绝口不道"],"opposite":["喋喋不休"],"usage":"作谓语、宾语；指闭口不说话"},{"id":36436,"word":"绝口不道","pinyin":"jué kǒu bù dào","abbr":"jkbd","explanation":"绝口：闭口。指闭口不谈。","source":{"text":"吉为人深厚，不伐善，自曾孙遭遇，绝口不道前恩，故朝廷莫能明其功也。","book":"《汉书·丙吉传》"},"example":{"text":"无如当放逐之余，～。","book":"清·无名氏《杜诗言志》卷十"},"similar":["缄口不言","只字不提"],"opposite":["津津乐道","喋喋不休"],"usage":"作谓语、宾语；指闭口不说话"},{"id":36437,"word":"绝后光前","pinyin":"jué hòu guāng qián","abbr":"jhgq","explanation":"绝：断绝；光：光大，扩充。扩充了前人所不及的事，做出了后人难以做到的事。形容功业伟大或成就卓著。","source":{"text":"而堤文友拔超峻，光前绝后，以柳视之，殆犹碔砄之美玉也。","book":"宋·洪迈《容斋四笔·蓝田丞壁记》"},"example":{"text":"相王格论，～。","book":"唐·温大雅《大唐创业起居注》三"},"similar":["光前绝后","空前绝后"],"usage":"作谓语、定语；指人的功劳或成就"},{"id":36438,"word":"绝后空前","pinyin":"jué hòu kōng qián","abbr":"jhkq","explanation":"从前没有过，今后也不会再有。形容独一无二的成就或不平常的盛况。","source":{"text":"盖偏至之诣，至于绝后空前，亦令人望而却步，其年亦人杰矣哉！","book":"清·陈廷焯《白雨斋词话》第三卷"},"similar":["空前绝后","绝后光前"],"usage":"作谓语、定语；形容极不寻常的盛况"},{"id":36439,"word":"绝国殊俗","pinyin":"jué guó shū sú","abbr":"jgss","explanation":"不同国家的地方有不同的风俗习惯。","source":{"text":"天下莫不仰上之德，象主之旨，绝国殊俗，莫不重译而至，非家至而人见之也。","book":"《文子·精诚》"},"example":{"text":"～、 僻远幽间之处，不能被德承泽，故立诸侯以教诲之。","book":"《淮南子·修务训》"},"similar":["绝域殊方","绝域异方"],"usage":"作宾语、定语；用于书面语"},{"id":36440,"word":"绝圣弃智","pinyin":"jué shèng qì zhì","abbr":"jsqz","explanation":"《老子》第十九章：“绝圣弃智，民利百倍；绝仁弃义，民复孝慈；绿色通巧弃利，盗贼无有。”","source":{"text":"绝圣弃智，民利百倍；绝仁弃义，民复孝慈；绿色通巧弃利，盗贼无有。","book":"《老子》第十九章"},"example":{"text":"恶盈善退，～家之是非也。","book":"明·袁宏道《广庄·齐物论》"},"similar":["绝圣弃知"],"usage":"作谓语；指摒弃聪明智巧"},{"id":36441,"word":"绝圣弃知","pinyin":"jué shèng qì zhī","abbr":"jsqz","explanation":"绝：断绝；圣：智慧；弃：舍去，抛开；知：通“智”，智慧。指摒弃聪明智巧，回归天真纯朴。","source":{"text":"故绝圣弃知，大盗乃止，擿玉毁珠，小盗不起。","book":"战国·宋·庄周《庄子·胠箧》"},"similar":["绝圣弃智"],"usage":"作谓语；指摒弃聪明智巧"},{"id":36442,"word":"绝地天通","pinyin":"jué dì tiān tōng","abbr":"jdtt","explanation":"绝：断绝。断绝天神降落地上，地神升到天上。指使天地各得其所，人于其间建立固定的秩序纪纲。","source":{"text":"乃命重黎，绝地天通，罔有降格。","book":"《尚书·吕刑》"},"example":{"text":"然则～，非欤？","book":"清·龚自珍《五经大义终始论》"},"usage":"作宾语、定语；用于书面语"},{"id":36443,"word":"绝域异方","pinyin":"jué yù yì fāng","abbr":"jyyf","explanation":"绝域：极其遥远的地方；异方：异地他乡。指边远偏僻的地方。","source":{"text":"故虽有峻山巨海之隔，绝域殊方之迥，登峰诡曲之因，皆可得举而定者。","book":"晋·裴秀《禹贡九州地域图论》"},"example":{"text":"朝廷置灵武于度内，几百年矣，议者以为～，曾不敢近，而况于取之乎。","book":"宋·苏轼《御试制科策一道》"},"similar":["绝域殊方","异域殊方"],"usage":"作宾语、定语；用于书面语"},{"id":36444,"word":"绝域殊方","pinyin":"jué yù shū fāng","abbr":"jysf","explanation":"指边远偏僻的地方。","source":{"text":"故虽有峻山巨海之隔，绝域殊方之迥，登峰诡曲之因，皆可得举而定者。","book":"《晋书·裴秀传》"},"similar":["绝域异方","绝国殊俗","异域殊方"],"usage":"作宾语、定语；用于书面语"},{"id":36445,"word":"绝壁悬崖","pinyin":"jué bì xuán yá","abbr":"jbxy","explanation":"绝壁：险绝的石壁。形容山势险峻。","source":{"text":"悬崖绝壁几千丈，绿萝袅袅不可攀。","book":"唐·刘长卿《望龙山怀道士许法棱》"},"example":{"text":"其地多筑坚碉于～上，官军屡攻弗克。","book":"清·昭梿《啸亭杂录》卷二"}},{"id":36446,"word":"绝处逢生","pinyin":"jué chù féng shēng","abbr":"jcfs","explanation":"绝处：死路。形容在最危险的时候得到生路。","source":{"text":"李庆安绝处幸逢生。","book":"元·关汉卿《钱大尹知勘绯衣梦·正名》"},"example":{"text":"常言“吉人天相，绝处逢生。”","book":"明·冯梦龙《警世通言·桂员外途穷忏悔》"},"similar":["起死回生","死里逃生","转危为安"],"opposite":["束手就擒","坐以待毙","走投无路"],"usage":"作谓语、定语、状语；形容生命攸关"},{"id":36447,"word":"绝妙好词","pinyin":"jué miào hǎo cí","abbr":"jmhc","explanation":"绝：极，最。指极其美妙的文辞。","source":{"text":"待使君绝妙好词成，须弹压。","book":"元·张雨《满江红·玉簪》词"},"example":{"text":"凡读传奇而有令人费解，或初阅不见其佳，深思而后得其意之所在者，便非～。","book":"清·李渔《闲情偶寄·词曲·词采》"},"similar":["绝妙好辞"],"usage":"作宾语；指极其美妙的文辞"},{"id":36448,"word":"绝妙好辞","pinyin":"jué miào hǎo cí","abbr":"jmhc","explanation":"辞：同“词”，文辞。用以指极其美妙的文辞。","source":{"text":"黄绢，色丝也，于字为绝。幼妇，少女也，于字为妙。外孙，女子也，于字为好。蒱臼，受辛也，于字为辞。所谓绝妙好辞也。","book":"南朝·宋·刘义庆《世说新语·捷悟》"},"example":{"text":"文人笔端有口，能就现前真景，抒写成篇，即是～。","book":"清·许印芳《与李生论诗》"},"similar":["绝妙好词"],"usage":"作宾语；指极其美妙的文辞","story":["三国时期，魏武帝曹操曾经从曹娥碑下经过，见碑上有“黄绢幼妇，外孙齑臼”八字问杨修是什么意思，杨修回答知道，曹操止住不让说，自己一路琢磨，走了三十里后重于猜到是“绝妙好辞”，并自认为才能不如杨修"]},{"id":36449,"word":"绝子绝孙","pinyin":"jué zǐ jué sūn","abbr":"jzjs","explanation":"指断绝子孙。","source":{"text":"等他绝子绝孙之后，他祖宗的香烟都要断了，还充那一门孝子？","book":"清·李宝嘉《官场现形记》第22回"},"example":{"text":"～是骂人的话。"},"similar":["断子绝孙"],"usage":"作谓语；用于诅咒别人"},{"id":36450,"word":"绝少分甘","pinyin":"jué shǎo fēn gān","abbr":"jsfg","explanation":"好吃的东西让给人家，不多的东西与人共享。形容自己刻苦，待人优厚。","source":{"text":"母之于子也，鞠养殷勤，推燥央湿，绝少分甘。","book":"汉·司马迁《报任少卿书》：“愚以为李陵素与士大夫绝甘分少，能得人之死力，虽古名将不过也。”《孝经援神契》"},"example":{"text":"平生～处，身要从师万事忘。霜雁叫群倾半枕，梦回兄弟彩衣行。","book":"宋·黄庭坚《次韵答少章闻雁听鸡二首》其一"},"similar":["绝甘分少"],"usage":"作谓语；指自己不图享受，待人优厚"},{"id":36451,"word":"绝尘拔俗","pinyin":"jué chén bá sú","abbr":"jcbs","explanation":"绝尘：冠绝尘世；拔俗：不同凡俗。超出尘世，不同凡俗。","source":{"text":"有绝尘拔俗之逸韵，其文尤长于论事。","book":"宋·杨万里《朝请大夫将作少监赵公行状》"},"similar":["超群出众"],"usage":"作谓语、定语；用于人的品行等"},{"id":36452,"word":"绝德至行","pinyin":"jué dé zhì xíng","abbr":"jdzx","explanation":"绝、至：极，尽。极为高尚的道德品行。","source":{"text":"然绝德至行，九州四海所共矜式。","book":"宋·王安石《上宋相公书》"}},{"id":36453,"word":"绝无仅有","pinyin":"jué wú jǐn yǒu","abbr":"jwjy","explanation":"只有一个，再没有别的。形容非常少有。","source":{"text":"改过不吝，从善如流，此尧舜禹汤之所勉强而力行，秦汉以来之所绝无而仅有。","book":"宋·苏轼《上皇帝书》"},"example":{"text":"新的一辈继他们的父亲或者母亲之后成为作家的，可以说～。","book":"秦牧《两代人》"},"similar":["绝世超伦","举世无双","空前绝后"],"opposite":["举不胜举","多如牛毛"],"usage":"作谓语、宾语、定语；形容稀少事物"},{"id":36454,"word":"绝渡逢舟","pinyin":"jué dù féng zhōu","abbr":"jdfz","explanation":"比喻在绝路上有了出路或办法。","source":{"text":"天幸遇着相公，如暗室逢灯，绝渡逢舟，从此读书作文，俱可望有门径矣。","book":"清·夏敬渠《野叟曝言》第十回"},"similar":["绝处逢生"],"usage":"作宾语、定语；用于困境时"},{"id":36455,"word":"绝甘分少","pinyin":"jué gān fēn shǎo","abbr":"jgfs","explanation":"绝：拒绝，引伸为不享受；甘：好吃的。好吃的东西让给人家，不多的东西与人共享。形容自己刻苦，待人优厚。","source":{"text":"母之于子也，鞠养殷勤，推燥央湿，绝少分甘。","book":"汉·司马迁《报任少卿书》：“愚以为李陵素与士大夫绝甘分少，能得人之死力，虽古名将不过也。”《孝经援神契》"},"example":{"text":"故汉、唐之将，率不以严厉为能，唯捬循士卒、～者称焉。","book":"章炳麟《军人贵贱论》"},"similar":["绝少分甘"],"usage":"作谓语；形容自己不图享受，待人优厚"},{"id":36456,"word":"绝类离伦","pinyin":"jué lèi lí lún","abbr":"jlll","explanation":"绝：超越；类：同类；伦：类。形容超群出众。","source":{"text":"绝类离伦，优入圣城。","book":"唐·韩愈《进学解》"},"similar":["超群出众"],"usage":"作谓语、定语；用于人品或文章等"},{"id":36457,"word":"绝类离群","pinyin":"jué lèi lí qún","abbr":"jllq","explanation":"绝：越过，越出；类：同类。形容超群出众。指与人群隔绝，脱离尘俗。","source":{"text":"笃生异人，绝类离群，奋挺大呼，从者如云。","book":"宋·苏轼《表忠观碑》"},"example":{"text":"闻山东李先生向往甚切，有～之意。","book":"明·李贽《复焦弱侯书》"},"similar":["出类拔萃","绝群拔类"],"opposite":["比比皆是"],"usage":"作谓语、定语；用于书面语"},{"id":36458,"word":"绝群拔类","pinyin":"jué qún bá lèi","abbr":"jqbl","explanation":"绝：越过，越出；类：同类。形容超群出众。","source":{"text":"杜子美、李太白，诗人之绝群拔类者也。","book":"明·方孝孺《畸亭记》"},"similar":["绝类离群"],"usage":"作谓语、定语；用于书面语"},{"id":36459,"word":"绝色佳人","pinyin":"jué sè jiā rén","abbr":"jsjr","explanation":"绝色：绝顶美丽；佳人：美人。当代最美的女人。","source":{"text":"北方有佳人，绝世而独立。","book":"《汉书·外戚传》载李延年歌"},"example":{"text":"见一个庞眉老叟行在前面，见一个～次着后肩。","book":"元·谷子敬《城南柳》第三折"},"similar":["绝代佳人"],"usage":"作主语、宾语；用于女性","story":["汉朝中山李氏兄妹三人到京城长安发展，李延年进入皇宫乐府，他向汉武帝推荐他妹妹是绝色佳人，一见倾城，再顾倾国。汉武帝十分高兴就召见李延年的妹妹并封她为夫人，生下昌邑王刘贺，汉武帝十分宠爱这个绝色夫人"]},{"id":36460,"word":"绝薪止火","pinyin":"jué xīn zhǐ huǒ","abbr":"jxzh","explanation":"绝：断绝；薪：柴草。断绝柴草，使火停止燃烧。比喻从根本上彻底解决问题。","source":{"text":"一人饮之，百人扬之，无益也，不如绝薪止火而已。","book":"《吕氏春秋·尽数》：“扬汤止沸，沸愈不止，去火则止矣。” 汉·枚乘《上书谏吴书》"},"similar":["绝其本根"],"opposite":["抱薪救火"],"usage":"作谓语；指从根本上解决"},{"id":36461,"word":"绝裙而去","pinyin":"jué jū ér qù","abbr":"jqeq","explanation":"绝裾：扯断衣襟。形容离去的态度十分坚决。"},{"id":36462,"word":"绝裾而去","pinyin":"jué jū ér qù","abbr":"jjeq","explanation":"绝裾：扯断衣襟。形容离去的态度十分坚决。","source":{"text":"温公初受刘司空使劝进。母崔氏固驻之，峤绝裾而去。","book":"南朝·宋·刘义庆《世说新语·尤悔》"},"example":{"text":"至于荆轲，力不足以谋无道秦，遂使～，自取灭亡。","book":"清·蒲松龄《聊斋志异·聂政》"},"similar":["拂袖而去"],"usage":"作谓语；形容离去的态度十分坚决"},{"id":36463,"word":"绝路逢生","pinyin":"jué lù féng shēng","abbr":"jlfs","explanation":"形容在最危险的时候得到生路。","source":{"text":"常言‘吉人天相，绝处逢生。’","book":"明·冯梦龙《警世通言·桂员外途穷忏悔》"},"similar":["绝处逢生"],"usage":"作谓语、定语、状语；形容生命攸关"},{"id":36464,"word":"绝长继短","pinyin":"jué cháng jì duǎn","abbr":"jcjd","explanation":"绝：截断。截取长的，补充短的。比喻用长处补短处。","source":{"text":"古者汤封于亳，绝长继短，方地百里，与其百姓兼相爱，交相利，移则分。","book":"《墨子·非命上》"},"example":{"text":"汤武以百里王，桀纣以天下亡，今楚虽小，～，以千里数，岂特百里哉！","book":"汉·刘向《新序·杂事二》"},"similar":["绝长补短"],"usage":"作谓语、定语、宾语；比喻用长处补短处"},{"id":36465,"word":"绝长续短","pinyin":"jué cháng xù duǎn","abbr":"jcxd","explanation":"绝：截断。截取长的，补充短的。比喻用长处补短处。","source":{"text":"今楚国虽小，绝长续短，犹以数千里。","book":"《战国策·楚策四》"},"similar":["绝长继短"],"usage":"作谓语、定语、宾语；比喻用长处补短处"},{"id":36466,"word":"绝长补短","pinyin":"jué cháng bǔ duǎn","abbr":"jcbd","explanation":"绝：截断。截取长的，补充短的。比喻用长处补短处。","source":{"text":"今滕，绝长补短，将五十里也，犹可以为善国。","book":"战国·邹·孟轲《孟子·滕文公上》"},"example":{"text":"而比新昌、萧山相去不远，～，两县当六县四分之一。","book":"宋·朱熹《奏救荒事宜状》"},"similar":["断短续长","截长补短","裒多益寡"],"usage":"作谓语、宾语；比喻用长处补短处","story":["战国时期，滕文公从楚国路经宋国时会见孟子，孟子给他讲一些人性本是善良的道理，勉励他要以尧舜之道治理天下，还要他截长补短，发挥地区优势，以仁政来治理天下，滕国可以成为一个强国。滕文公听了孟子的言论未置可否，只是微笑应付"]},{"id":36467,"word":"绝顶聪明","pinyin":"jué dǐng cōng míng","abbr":"jdcm","explanation":"绝顶：极端。形容异常聪明。","source":{"text":"庄子是绝顶聪明的人，他的门徒大约也是些～的人。","book":"郭沫若《庄子的批判》"},"example":{"text":"郭沫若《庄子的批判》：“庄子是～的人，他的门徒大约也是些绝顶聪明的人。”"},"similar":["聪明绝顶"],"usage":"作谓语、定语；用于口语"},{"id":36468,"word":"绞尽脑汁","pinyin":"jiǎo jìn nǎo zhī","abbr":"jjnz","explanation":"费尽脑筋。","source":{"text":"唯其如此，他才更能显出绞尽脑汁的样子，替她思索。","book":"老舍《四世同堂·偷生》三七"},"example":{"text":"所以～也想不到战略、战术和个人应当如何参加战斗。","book":"巴金《后记》"},"similar":["千方百计","挖空心思"],"usage":"作谓语、定语、宾语、状语；指用尽了心机"},{"id":36469,"word":"统一口径","pinyin":"tǒng yī kǒu jìng","abbr":"tykj","explanation":"比喻大家对待问题采取一致的态度。","example":{"text":"我们在这个问题上要～。"},"similar":["统一战线","步调一致"],"usage":"作主语、宾语、定语；指一致"},{"id":36470,"word":"统一战线","pinyin":"tǒng yī zhàn xiàn","abbr":"tyzx","explanation":"比喻在某些问题上抱同样态度。","source":{"text":"目前的时局，要求我们勇敢地抛弃关门主义，采取广泛的统一战线，防止冒险主义。","book":"毛泽东《论反对日本帝国主义的策略》"},"example":{"text":"我们要结成～。"},"usage":"作宾语、定语；指共同防线"},{"id":36471,"word":"统筹兼顾","pinyin":"tǒng chóu jiān gù","abbr":"tcjg","explanation":"统筹：通盘筹划；兼：本义为一手执两禾，引伸为同时进行几桩事情或占有几样东西；顾：照顾。统一筹划，全面照顾。","source":{"text":"不是这样统筹兼顾，天京一定难保。","book":"欧阳予倩《忠王李秀成》第一幕"},"example":{"text":"我们要有～的处理问题能力。"},"opposite":["挂一漏万"],"usage":"作谓语、定语；指全局考虑"},{"id":36472,"word":"统筹统支","pinyin":"tǒng chóu tǒng zhī","abbr":"tctz","explanation":"指统一筹集统一开支。","source":{"text":"我们很早就实行了以县为单位统筹统支的办法，规定村无派款权，改革了这个病政。","book":"邓小平《太行区的经济建设》"},"similar":["统收统支"],"usage":"作谓语、宾语、定语；用于经济等"},{"id":36473,"word":"统而言之","pinyin":"tǒng ér yán zhī","abbr":"teyz","explanation":"总的说起来。","source":{"text":"皆是皇居帝里，相去不远，可得统而言之。","book":"《魏书·李平传》"},"example":{"text":"行仁义者为君子，不行仁义者为小人，此～也。","book":"二月河《乾隆皇帝》五"}},{"id":36474,"word":"统购统销","pinyin":"tǒng gòu tǒng xiāo","abbr":"tgtx","explanation":"国家对某些有关国计民生的重要物资实行有计划的统一收购和销售。","example":{"text":"～的年代已经远去了。"},"usage":"作宾语、定语；用于公有制经济"},{"id":36475,"word":"绠短汲深","pinyin":"gěng duǎn jí shēn","abbr":"gdjs","explanation":"绠：汲水用的绳子；汲：从井里打水。吊桶的绳子短，打不了深井里的水。比喻能力薄弱，难以担任艰巨的任务。","source":{"text":"褚小者不可以怀大，绠短者不可以汲深。","book":"《庄子·至乐》"},"example":{"text":"诚智小谋大，～。","book":"唐·萧颖士《赠韦斯业书》"},"similar":["短绠汲深","绠短绝泉"],"opposite":["游刃有余"],"usage":"作宾语、定语；指力小任重的谦辞","story":["春秋时期，孔子的弟子颜渊从鲁国到齐国去，准备与齐国的国君谈治理国家的大道理。孔子不放心，子贡问何故，孔子说：“我想起管子的一句话‘褚小者不可以怀大，绠短者不可以汲深’，对待具体问题要具体分析，颜渊难以做到。”"]},{"id":36476,"word":"绠短绝泉","pinyin":"gěng duǎn jué quán","abbr":"gdjq","explanation":"犹绠短汲深。比喻能力薄弱，难以担任艰巨的任务。","source":{"text":"柱小倾大，绠短绝泉。","book":"南朝·宋·谢灵运《陇西行》"},"similar":["绠短汲深"],"usage":"作宾语、定语；指力小任重的谦辞"},{"id":36477,"word":"绣佛长斋","pinyin":"xiù fó cháng zhāi","abbr":"xfcz","explanation":"绣佛：刺绣的佛像；长斋：终年吃素。形容修行信佛。","source":{"text":"君来，固可图白头偕老，否则，绣佛长斋以了余生。","book":"清·百一居士《壶天录》中卷"},"similar":["长斋绣佛"],"usage":"作谓语、宾语；形容修行信佛"},{"id":36478,"word":"绣口锦心","pinyin":"xiù kǒu jǐn xīn","abbr":"xkjx","explanation":"锦、绣：精美鲜艳的丝织品。形容文思优美，词藻华丽。","source":{"text":"骈四骊六，锦心绣口，宫沉羽振，笙簧触手。","book":"唐·柳宗元《乞巧文》"},"example":{"text":"俺小姐花容月貌，王解元～，正是一对夫妻。","book":"明·陆采《明珠记·送愁》"},"similar":["锦心绣口"],"usage":"作谓语、定语、宾语；形容文思优美"},{"id":36479,"word":"绣斧之诛","pinyin":"xiù fǔ zhī zhū","abbr":"xfzz","explanation":"绣斧：指皇帝指派、掌有生杀大权的巡察官员。指皇帝特派官员对某人的诛罚。","source":{"text":"遗直指使者暴胜之等，在绣前，杖斧，分部逐捕，刺史郡守以下皆伏诛。","book":"《汉书·武帝纪》"},"example":{"text":"周经以正褒贬，则一字所嘉，有同华衮之赠，一言所黜，无异～。","book":"唐·孔颖达《春秋正义序》"}},{"id":36480,"word":"绣花枕头","pinyin":"xiù huā zhěn tóu","abbr":"xhzt","explanation":"比喻徒有外表而无学识才能的人。","source":{"text":"顶冠束带，居然官宦人家，谁敢说他是个绣花枕头，外面绣得五色灿烂，里面却包着一包稻草？","book":"清·彭养欧《黑籍冤魂》第六回"},"example":{"text":"我才明白了我自己——空空洞洞的～——对吧？","book":"杨沫《青春之歌》第二部第二章"},"similar":["华而不实"],"opposite":["真才实学"],"usage":"作宾语、定语；指无真才实学的人"},{"id":36481,"word":"绣虎雕龙","pinyin":"xiù hǔ diāo lóng","abbr":"xhdl","explanation":"比喻文章的辞藻华丽。","source":{"text":"谈天衍，雕龙奭，留炙过髡。","book":"宋·曾慥《类说》卷四引《玉箱杂记》：“曹植七步成章，号绣虎。”《史记·孟子荀卿列传》"},"example":{"text":"学富三余，才雄七步，休夸～，那值时危国破。","book":"明国。　单本《蕉帕记·寻春》"},"usage":"作宾语、定语；用于比喻句"},{"id":36482,"word":"绣闼雕甍","pinyin":"xiù tà diāo méng","abbr":"xtdm","explanation":"闼：门楼上的小屋；甍：屋脊。五彩绘画的门楼，经过雕刻的屋脊。形容建筑物的精巧、雄伟。","source":{"text":"披绣闼，俯雕甍。","book":"唐·王勃《滕王阁序》"},"example":{"text":"云飞雨散今如此，～作荒谷。","book":"唐·贯休《行路难》"},"usage":"作宾语、定语；用于书面语"},{"id":36483,"word":"绣阁香闺","pinyin":"xiù gé xiāng guī","abbr":"xgxg","explanation":"闺、阁：旧指女子的住处。指富贵人家青年女子的住处。","source":{"text":"膝多绵，性少血；气难伸，腰易折。在绣阁香闺，令人羞绝。","book":"清·西周生《醒世姻缘传》第九十一回"},"usage":"作宾语、定语；指女子卧室"},{"id":36484,"word":"继世而理","pinyin":"jì shì ér lǐ","abbr":"jsel","explanation":"继：继承；理：治理，统治。代代相传，行使统治。","source":{"text":"继世而理者，上果贤呼？下果不肖呼？","book":"唐·柳宗元《封建论》"}},{"id":36485,"word":"继之以死","pinyin":"jì zhī yǐ sǐ","abbr":"jzys","explanation":"不惜一死来把某事继续下去。形容决心很大。","source":{"text":"臣敢竭股肱之力，效忠贞之节，继之以死。","book":"晋·陈寿《三国志·蜀志·诸葛亮传》"},"usage":"作谓语、状语；指决心大"},{"id":36486,"word":"继古开今","pinyin":"jì gǔ kāi jīn","abbr":"jgkj","explanation":"指继往开来。","source":{"text":"先生如离开北平，亦大可惜，因北平究为文化旧都，继古开今之事，尚大有可为者在也。","book":"鲁迅《书信集·致郑振铎》"},"similar":["继往开来"],"usage":"作定语、分句；同“继往开来”"},{"id":36487,"word":"继天立极","pinyin":"jì tiān lì jí","abbr":"jtlj","explanation":"继：继承；天、极：指皇帝。继承天子的皇位。","source":{"text":"天必命之以为亿兆之君师，使之治而教之，以复其性，此伏羲、神农、黄帝、尧舜，所以继天立极。","book":"宋·朱熹《〈大学章句〉序》"},"example":{"text":"想祈大开恻隐，怜～之圣君，拯无辜被毒之性命，早施雨露，以慰倒悬。","book":"明·许仲琳《封神演义》第八十一回"},"usage":"作谓语、定语；用于书面语"},{"id":36488,"word":"继往开来","pinyin":"jì wǎng kāi lái","abbr":"jwkl","explanation":"继：继承；开：开辟。继承前人的事业，开辟未来的道路。","source":{"text":"所以继往圣，开来学，而大有功于斯世也。","book":"宋·朱熹《朱子全书·周子书》"},"example":{"text":"将来昌明圣教，～，舍我其谁？","book":"清·李宝嘉《官场现形记》第一回"},"similar":["承上启下"],"opposite":["空前绝后"],"usage":"作谓语、定语；指循环"},{"id":36489,"word":"继志述事","pinyin":"jì zhì shù shì","abbr":"jzss","explanation":"继：继承；志：志向；述：叙述。继承先哲的志向来言事理政。","source":{"text":"独江左有吴皓者，擅五十九年之业，一旦用王濬，唾手可得，故天下始一于晋。夫可谓继志述事之主。","book":"宋·赵佶《宣和书谱》卷一"},"example":{"text":"君臣协心，～，尽遵先王之政。四方附庸之国，皆行朝贡西土。二百镇诸侯，皆率王化。","book":"明·许仲琳《封神演义》第二十九回"},"usage":"作谓语、定语；用于书面语"},{"id":36490,"word":"继承衣钵","pinyin":"jì chéng yī bō","abbr":"jcyb","explanation":"衣钵：佛教用语，指法衣和食钵。泛指继承某人的思想体系，学术知识或技巧技能。","source":{"text":"我已是将近六十的人，虽说这庵里也有七八个徒弟，可是没有一个可以继承衣钵的，我常常为此操心。","book":"姚雪垠《李自成》第五卷第二十七章"}},{"id":36491,"word":"继晷焚膏","pinyin":"jì guǐ fén gāo","abbr":"jgfg","explanation":"继：继续，接替；晷：日光；膏：油脂，指灯烛。点燃蜡烛或油灯接替日光照明。形容夜以继日地勤奋学习或工作。","source":{"text":"焚膏油以继晷，恒兀兀以穷年。","book":"唐·韩愈《进学解》"},"example":{"text":"青云梦杳，且就学趋庭，～。","book":"明·邵璨《香囊记·庆寿》"},"similar":["夜以继日"],"usage":"作谓语、状语；指不停地工作或学习"},{"id":36492,"word":"继绝兴亡","pinyin":"jì jué xīng wáng","abbr":"jjxw","explanation":"绝：断绝；亡：灭亡。恢复已灭亡的国家，延续断绝了的世家。","source":{"text":"如蒙录召，继绝兴亡，则陛下更生之恩，望古无二。","book":"《晋书·刘琨传》"},"similar":["继绝存亡"],"usage":"作定语、宾语；指复国"},{"id":36493,"word":"继绝存亡","pinyin":"jì jué cún wáng","abbr":"jjcw","explanation":"恢复灭亡的国家，延续断绝了的贵族世家。","source":{"text":"桓公尝有继绝存亡之功，故君子为之讳也。","book":"《论语·尧曰》：“兴灭国，继绝世，举逸民，天下之民归心焉。”《公羊传·僖公十七年》"},"example":{"text":"本朝传世十六，正统相承，自治冠带之族，～，仁恩遐被。","book":"清·蔡东藩《清史演义》第十四回"},"similar":["存亡继绝","继绝兴亡"],"usage":"作定语、宾语；指复国"},{"id":36494,"word":"继绝扶倾","pinyin":"jì jué fú qīng","abbr":"jjfq","explanation":"绝：绝境；扶：挽救；倾：倾覆。挽救处于绝境和倾覆状态的弱小者。","source":{"text":"将军若欲为伊、霍，继绝扶倾，吾虽老，犹愿尽力；如为莽、卓，乘危迫险，则仆耄矣，无能为也。","book":"《新唐书·徐旷传》"},"usage":"作宾语、定语；用于管理"},{"id":36495,"word":"继继存存","pinyin":"jì jì cún cún","abbr":"jjcc","explanation":"指前后相承，延续不断。同“继继承承”。","source":{"text":"只见电影中继继存存陆续相衔的影像，而实质上却是一个一个独立的影片。","book":"瞿秋白《〈赤都心史〉序》"},"similar":["继继承承","继继绳绳"],"usage":"作定语、状语；用于人或事物"},{"id":36496,"word":"继继承承","pinyin":"jì jì chéng chéng","abbr":"jjcc","explanation":"指前后相承，延续不断。","source":{"text":"圣子神孙，继继承承，于千万年，敬戒不怠。","book":"唐·韩愈《平淮西碑》"},"example":{"text":"则日日生者，实日日死也。天曰生生，性曰存存，～，运以不停。","book":"清·谭嗣同《仁学》十六"},"similar":["继继绳绳"],"usage":"作定语、状语；用于人或事物"},{"id":36497,"word":"继继绳绳","pinyin":"jì jì mǐn mǐn","abbr":"jjss","explanation":"指前后相承，延续不断。同“继继承承”。","source":{"text":"自时厥后，继继绳绳，予知未有艾也。","book":"明·宋濂《吴公墓碣铭》"},"example":{"text":"而我中华者，屹然独立，～，增长光大，以屹今日。","book":"梁启超《中国学术思想变迁之大势·总论》"},"similar":["继继存存","继继承承"],"usage":"作定语、状语；用于人或事物"},{"id":36498,"word":"继踵接武","pinyin":"jì zhǒng jiē wǔ","abbr":"jzjw","explanation":"踵：脚后跟；武：足迹。脚后跟接脚后跟，足迹挨足迹。形容人数众多而拥挤不堪或接连不断。","source":{"text":"士大夫登朝著与其居于乡者，继踵接武。","book":"明·归有光《送张子忠之任南昌序》"},"usage":"作谓语、定语；指人多"},{"id":36499,"word":"继踵而至","pinyin":"jì zhǒng ér zhì","abbr":"jzez","explanation":"踵：脚后跟；接踵：足跟相接；至：到，来。指人们前脚跟着后脚，接连不断地来。形容来者很多，络绎不绝。","source":{"text":"由是四方雄俊继踵而至，故能世为强国，吞灭诸侯，奄有天下。","book":"《晋书·段灼传》"},"similar":["接踵而至"],"usage":"作谓语、定语；用于书面语"},{"id":36500,"word":"绨袍之义","pinyin":"tí páo zhī yì","abbr":"tpzy","explanation":"绨袍：粗绨做的袍子。比喻不忘旧日的交情。","source":{"text":"尚有绨袍赠，应念范叔寒。","book":"《史记·范雎蔡泽列传》载；唐·高适《咏史》诗"},"example":{"text":"彼行虽贱，而祖德朱斩；且与君为故人，亦宜有～。","book":"清·蒲松龄《聊斋志异·阿霞》"},"similar":["绨袍恋恋"],"usage":"作宾语；指不忘旧恩","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相。范雎含冤被打伤，改名张禄逃到秦国当上宰相。后来须贾出使秦国，范雎扮作穷人去见他。须贾见状就送他一件绨袍，待发现他是秦相时吓得一再谢罪。范雎没有杀他"]},{"id":36501,"word":"绨袍之赠","pinyin":"tí páo zhī zèng","abbr":"tpzz","explanation":"绨袍：粗绨做的袍子。比喻不忘旧日的交情。","source":{"text":"尚有绨袍赠，应念范叔寒。","book":"《史记·范雎蔡泽列传》载；唐·高适《咏史》诗"}},{"id":36502,"word":"绨袍恋恋","pinyin":"tí páo liàn liàn","abbr":"tpll","explanation":"绨袍：粗丝绢袍子；恋恋：留恋。指不忘旧情。","source":{"text":"汝所以不得死者，以绨袍恋恋，尚有故人之情。","book":"明·冯梦龙《东周列国志》第97回"},"similar":["绨袍之义"],"usage":"作宾语、定语；指念旧情","story":["范雎随魏国中大夫须贾出使齐国，须贾怀疑他通齐，回国后报告魏相。范雎含冤被打伤，改名张禄逃到秦国当上宰相。后来须贾出使秦国，范雎扮作穷人去见他。须贾见状就送他一件绨袍，待发现他是秦相时吓得一再谢罪。范雎没有杀他"]},{"id":36503,"word":"绩学之士","pinyin":"jì xué zhī shì","abbr":"jxzs","explanation":"指学问渊博的人；学者。","source":{"text":"古今绩学之士，磨弗以勤政者。","book":"明胡应麟《少室山房笔丛·华阳博议下》"},"example":{"text":"～，读书必有札记，以记所得著所疑。","book":"徐特立《国文教授之研究》第一章"},"similar":["饱学之士"],"usage":"作主语、宾语；指学者"},{"id":36504,"word":"绫罗绸缎","pinyin":"líng luó chóu duàn","abbr":"llcd","explanation":"泛指各种精美的丝织品。","source":{"text":"金子是黄的，银子是白的。绫罗绸缎是红的绿的。","book":"清·文康《儿女英雄传》第三十二回"},"example":{"text":"虽然他的主要的生意是布匹，他可是也有个看得过眼的内柜，陈列着～。","book":"老舍《四世同堂》五十九"},"usage":"作宾语、主语、定语；泛指丝织品"},{"id":36505,"word":"续凫截鹤","pinyin":"xù fú jié hè","abbr":"xfjh","explanation":"比喻违失事物本性，欲益反损。","source":{"text":"长者不为有余，短者不为不足。是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"语出《庄子·骈拇》"},"example":{"text":"若矫其肆任之性，以徇刑政之端，是～，亏其全矣。","book":"唐独孤及《对诏策》"},"similar":["续凫断鹤","续鹜短鹤"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":36506,"word":"续凫断鹤","pinyin":"xù fú duàn hè","abbr":"xfdh","explanation":"比喻违失事物本性，欲益反损。","source":{"text":"长者不为有余，短者不为不足。是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"《庄子·骈拇》"},"example":{"text":"～，截足以适履，犹以为工未至也，如是则宁复有诗哉？","book":"清钱谦益《题》"},"similar":["断鹤续凫"],"usage":"作谓语、定语；比喻行事违反自然规律","story":["传说古代有个愚蠢而善良的人看到郊外一群群野鸭子和白鹤在水里啄食嬉戏。他发现鹤腿长，野鸭的脚杆很短。他想这样一起走路不路不方便，就把他们捉来，砍下鹤的一截腿杆接到野鸭的脚上，这样他们都不能走路了"]},{"id":36507,"word":"续鹜短鹤","pinyin":"xù wù duǎn hè","abbr":"xwdh","explanation":"比喻违失事物本性，欲益反损。","source":{"text":"长者不为有余，短者不为不足。是故凫胫虽短，续之则忧；鹤胫虽长，断之则悲。","book":"语出《庄子·骈拇》"},"example":{"text":"小大相形，是～之论也。","book":"明李贽《念佛答问》"},"similar":["续凫截鹤","续凫断鹤"],"usage":"作谓语、定语、宾语；用于比喻句"},{"id":36508,"word":"绮孺纨绔","pinyin":"qǐ rú wán kù","abbr":"qrwk","explanation":"纨绔：富家子弟用细绢做的裤子。泛指富贵子弟。","source":{"text":"出与王、许子弟为群，在于绮孺纨绔之间。","book":"《汉书·叙传上》"}},{"id":36509,"word":"绮纨之岁","pinyin":"qǐ wán zhī suì","abbr":"qwzs","explanation":"指少年时代。","source":{"text":"岐嶷表羁贯之年，通礼称绮纨之岁。","book":"北周·庾信《慕容宁神道碑》"},"usage":"作宾语；指少年时代"},{"id":36510,"word":"绮罗粉黛","pinyin":"qǐ luó fěn dài","abbr":"qlfd","explanation":"绮罗：有花纹的丝织品；粉黛：搽脸的白粉与画眉的黛墨，是妇女的化妆品。泛指年轻女子。","source":{"text":"不减少君德耀，绝无绮罗粉黛之态。","book":"明·徐复祚《红梨记·诉衷》"},"usage":"作主语、宾语、定语；用于女性"},{"id":36511,"word":"绮襦纨绔","pinyin":"qǐ rú wán kù","abbr":"qrwk","explanation":"绮：素地起花的丝织品；襦：短袄；纨绔：富家子弟用细绢做的裤子。泛指富贵子弟。","source":{"text":"出与王、许子弟为群，在于绮孺纨绔之间。","book":"《汉书·叙传上》"},"example":{"text":"晋·葛洪《抱朴子·疾谬》：“举口不离～之侧，游步不去势利酒客之门。”"},"usage":"作宾语、定语；用于书面语"},{"id":36512,"word":"绰有余妍","pinyin":"chuò yǒu yú yán","abbr":"cyyy","explanation":"妍：美丽。形容女子或字画等丰姿秀逸，很有魅力。","source":{"text":"独倚小桃斜柯伫立，而意属殊厚，娇姿媚态，绰有余妍。","book":"唐·孟棨《本事诗·情感·博陵崔护》"},"example":{"text":"玫有超父之艺，尤精写貌及画妇人，铅华姿态，～，议者比之张萱之俦也。","book":"宋·黄休复《益州名画录·张玫》"}},{"id":36513,"word":"绰有余暇","pinyin":"chuò yǒu yú xiá","abbr":"cyyx","explanation":"绰：宽，缓；暇：空闲。形容态度从容，不慌不忙的样子。","source":{"text":"我绰有余暇，山立不动。","book":"《北史·魏收传》"},"similar":["绰然有余"],"usage":"作谓语、定语、状语；用于人力或事物等"},{"id":36514,"word":"绰有余裕","pinyin":"chuò yǒu yú yù","abbr":"cyyy","explanation":"形容态度从容，不慌不忙的样子。后也指能力、财力足够而有剩余。","source":{"text":"我无官守，我无言责也，则吾进退岂不绰绰然有余裕哉？","book":"《孟子·公孙丑下》"},"example":{"text":"马路上自然～，不像那样拥挤了。","book":"李大钊《新的！旧的！》"},"similar":["绰绰有余"],"opposite":["捉襟见肘"],"usage":"作谓语、定语；形容态度从容、不慌不忙"},{"id":36515,"word":"绰然有余","pinyin":"chuò rán yǒu yú","abbr":"cryy","explanation":"绰然：宽裕的样子。形容非常宽裕，态度从容，不慌不忙。","source":{"text":"驰骋游说，言固不虚。唯兹壹公，绰然有余。","book":"南朝·宋·刘义庆《世说新语·言语》：“道壹道人好整饰音辞。”南朝·梁·刘孝标注"},"example":{"text":"余夫妇乔寓扬州时，曾仿此法，屋仅两椽，上下卧房，厨灶客座皆越绝，而～。","book":"清·沈复《浮生六记·闲情记趣》"},"similar":["绰绰有余"],"usage":"作谓语、定语、状语；用于人力或事物等"},{"id":36516,"word":"绰约多姿","pinyin":"chuò yuē duō zī","abbr":"cydz","explanation":"绰约：姿态优美的样子。形容女子体态的美。","source":{"text":"年可四十余，绰约多姿，谈笑甚媚。","book":"《庄子·逍遥游》：“肌肤若冰雪，绰约若处子。”唐·蒋防《霍小玉传》"},"example":{"text":"年可四十余，～，谈笑甚媚。","book":"唐·蒋防《霍小玉传》"},"similar":["婀娜多姿"],"usage":"作谓语、补语；形容女子体态的美"},{"id":36517,"word":"绰绰有余","pinyin":"chuò chuò yǒu yú","abbr":"ccyy","explanation":"绰绰：宽裕的样子。形容房屋或钱财非常宽裕，用不完。","source":{"text":"此令兄弟，绰绰有裕。","book":"《诗经·小雅·角弓》"},"example":{"text":"这寓所起先原是两人同住的，今去了魏撰之，房舍尽有，就安寓那闻俊卿主仆三人，还～。","book":"明·凌濛初《二刻拍案惊奇》卷十七"},"similar":["绰有余裕","恢恢有余"],"opposite":["入不敷出","捉襟见肘"],"usage":"作谓语、定语、状语；用于人力或事物等","story":["战国时期，齐国大夫坻蛙辞去灵丘县令到国都担任谏官，几个月没有向齐王劝谏过。孟子鼓动他去进谏，他多次进谏没有被采纳，只好辞官回家。孟子的学生问孟子为什么会这样。孟子说自己不为官，不依靠官府，是走是留自己定夺已经是绰绰有余"]},{"id":36518,"word":"绰绰有裕","pinyin":"chuò chuò yǒu yù","abbr":"ccyy","explanation":"绰绰：宽裕舒缓的样子；裕：宽绰，宽缓。形容态度从容，不慌不忙的样子。","source":{"text":"此令兄弟，绰绰有裕。","book":"《诗经·小雅·角弓》"},"example":{"text":"猗欤汝阴，～。","book":"晋·陆机《汉高祖功臣颂》"},"similar":["绰绰有余"],"opposite":["捉襟见肘"],"usage":"作谓语、定语、状语；用于人力等很宽恕"},{"id":36519,"word":"绳一戒百","pinyin":"shéng yī jiè bǎi","abbr":"syjb","explanation":"指惩罚一人以警戒众人。","source":{"text":"依条按法，想绳一戒百谁不怕。","book":"元·柯丹邱《荆钗记·遗音》"},"similar":["杀一警百"],"usage":"作谓语、宾语；指警戒别人"},{"id":36520,"word":"绳之以法","pinyin":"shéng zhī yǐ fǎ","abbr":"szyf","explanation":"根据法律制裁。","source":{"text":"以文帝之明，而魏尚之忠，绳之以法则为罪，施之以德则为功。","book":"《后汉书·冯衍传》"},"example":{"text":"对于那些目无法纪的人，必须～，才能维护社会的正常秩序。"},"similar":["依法从事"],"opposite":["逍遥法外"],"usage":"作谓语、宾语；指用法律来制裁"},{"id":36521,"word":"绳先启后","pinyin":"shéng xiān qǐ hòu","abbr":"sxqh","explanation":"即承前启后。指继承前人事业，为后人开辟道路。","source":{"text":"至德显忠，绳先启后。","book":"宋·岳飞《题许虎侯像》"},"similar":["承先启后"],"usage":"作定语；用于书面语"},{"id":36522,"word":"绳其祖武","pinyin":"shéng qí zǔ wǔ","abbr":"sqzw","explanation":"绳：继续；武：足迹。踏着祖先的足迹继续前进。比喻继承祖业。","source":{"text":"昭兹来许，绳其祖武。","book":"《诗经·大雅·下武》"},"example":{"text":"而辩护古人，也就是辩护自己。况且我们是神州华胄，敢不“～”么？","book":"鲁迅《华盖集·忽然想到》"},"similar":["绳厥祖武"],"usage":"作谓语、定语；比喻继承祖辈事业"},{"id":36523,"word":"绳厥祖武","pinyin":"shéng jué zǔ wǔ","abbr":"sjzw","explanation":"绳：继续；武：足迹。踏着祖先的足迹继续前进。比喻继承祖业。","source":{"text":"昭兹来许，绳其祖武。","book":"《诗经·大雅·下武》"},"example":{"text":"他志在青云，料非身终白屋，倘能～，庶几不负慈恩。","book":"明·汪廷讷《狮吼记·抚儿》"},"similar":["绳其祖武"],"usage":"作谓语、定语；比喻继承祖辈事业"},{"id":36524,"word":"绳墨之言","pinyin":"shéng mò zhī yán","abbr":"smzy","explanation":"可作为准绳、合乎道德圣智的言论。","source":{"text":"未达人心，而强以仁义绳墨之言，术暴人之前者，是以人恶有其美也。","book":"《庄子·人间世》"},"usage":"作宾语；用于书面语"},{"id":36525,"word":"绳床瓦灶","pinyin":"shéng chuáng wǎ zào","abbr":"scwz","explanation":"绳床：即交椅，也叫胡床；瓦灶：土坯炉灶。指简陋的生活用具。形容非常贫穷。","source":{"text":"所以蓬牖茅椽，绳床瓦灶，并不足妨我襟怀。","book":"清·曹雪芹《红楼梦》第一回"},"similar":["穷困潦倒","粗茶淡饭"],"opposite":["锦衣玉食","堆金积玉"],"usage":"作谓语、分句；形容家境贫寒"},{"id":36526,"word":"绳愆纠缪","pinyin":"shéng qiān jiū miù","abbr":"sqjm","explanation":"改正过失，纠正错误。同“绳愆纠谬”。","source":{"text":"上曰：‘贞观之前，从联经营天下，玄龄之功也。贞观以来，绳愆纠缪，魏徵之功也。","book":"《资治通鉴·唐太宗贞观十二年》"},"similar":["绳愆纠谬","绳愆纠违"],"usage":"作谓语、定语；指纠正过失"},{"id":36527,"word":"绳愆纠谬","pinyin":"shéng qiān jiū miù","abbr":"sqjm","explanation":"绳：纠正；愆：过失；谬：错误。指纠正过失。","source":{"text":"惟予一人无良，实赖左右前后有位之士，匡其不及，绳愆纠谬，格其非心，俾克绍先烈。","book":"《书·冏命》"},"example":{"text":"～，臣道为先；罚罪赏功，乾纲不替。","book":"明·王世贞《鸣凤记》第四十一出"},"similar":["绳愆纠缪","绳愆纠违"],"usage":"作谓语、定语；指举发过失，纠正错误"},{"id":36528,"word":"绳愆纠违","pinyin":"shéng qiān jiū wéi","abbr":"sqjw","explanation":"改正过失，纠正错误。同“绳愆纠谬”。","source":{"text":"中丞之职，非徒绳愆纠违，亦当顾国家大体。","book":"《续资治通鉴·宋真宗景德二年》"},"similar":["绳愆纠谬","绳愆纠缪"],"usage":"作谓语、定语；指举发过失，纠正错误"},{"id":36529,"word":"绳捆索绑","pinyin":"shéng kǔn suǒ bǎng","abbr":"sksb","explanation":"用绳索捆绑。","source":{"text":"你这样～是束缚不了她的心的。"},"example":{"text":"你这样～是束缚不了她的心的"},"usage":"作宾语、定语；指抓人"},{"id":36530,"word":"绳枢之士","pinyin":"shéng shū zhī shì","abbr":"sszs","explanation":"枢：门上的转轴；绳枢：用绳子系枢轴，形容贫穷。指贫家子弟。","source":{"text":"陈涉，瓮牖绳枢之子。","book":"汉·贾谊《新书·过秦上》：“然而陈涉，瓮牖绳枢之子，氓隶之人，而迁徙之徒也。”《史记·秦始皇本纪》"},"example":{"text":"则有穷巷之宾，～，冀宵烛之末光，邀润屋之微泽。","book":"南朝·梁·刘孝标《广绝交论》"},"similar":["绳枢之子"],"usage":"作宾语；用于书面语"},{"id":36531,"word":"绳枢之子","pinyin":"shéng shū zhī zǐ","abbr":"sszz","explanation":"枢：门上的转轴；绳枢：用绳子系枢轴，形容贫穷。指贫家子弟。","source":{"text":"陈涉，瓮牖绳枢之子。","book":"《史记·秦始皇本纪》"},"similar":["绳枢之士"],"usage":"作宾语；用于书面语"},{"id":36532,"word":"绳枢瓮牖","pinyin":"shéng shū wèng yǒu","abbr":"sswy","explanation":"绳枢：用绳子系门，来代替转轴。形容住房条件十分简陋。多指贫穷人家。亦作“瓮牖绳枢”。","source":{"text":"绳枢瓮牖之室，华门圭窦之堂，尚不然矣。","book":"《魏书·逸士传·李谧》"},"similar":["蓬门筚户"],"usage":"作宾语、定语；用于生活"},{"id":36533,"word":"绳趋尺步","pinyin":"shéng qū chǐ bù","abbr":"sqcb","explanation":"绳、尺：木工校曲直、量长短的工具，引申为法度；趋：快走；步：行走。指举动符合规矩，毫不随便。","source":{"text":"而绳趋尺步，华言华服者，往往反摈弃不用。","book":"宋·苏洵《广士》"},"example":{"text":"方是时，士之～，稍以儒名者，无所容其身。","book":"《宋史·朱熹传》"},"similar":["循规蹈矩"],"usage":"作谓语、定语；指循规蹈矩","story":["南宋时期，朝廷内部在朱熹倡导的“道学”上分为两派，权臣韩侂胄极力排斥朱熹，认为道学为伪学，道学代表结为死党，目的是想篡位。在这种情况下，道学代表们小心翼翼、一举一动都绳趋尺步。有人建议朱熹解散学堂，朱熹总是笑而不答"]},{"id":36534,"word":"绳锯木断","pinyin":"shéng jù mù duàn","abbr":"sjmd","explanation":"用绳当锯子，也能把木头锯断。比喻力量虽小，只要坚持下去，事情就能成功。","source":{"text":"一日一钱，千日一千，绳锯木断，水滴石穿。","book":"宋·罗大经《鹤林玉露》第十卷"},"example":{"text":"谚曰：‘～，水滴石穿。’夫绳非木之锯，水非石之钻也，盖积渐使然耳。","book":"明·朱舜水《与奥村德辉书八首》"},"similar":["持之以恒","锲而不舍"],"opposite":["虎头蛇尾","有头无尾"],"usage":"作宾语、分句；指坚持就会胜利","story":["宋朝崇阳县令张乖崖为官清廉，铁面无私。一次见县衙管理铁库的库吏从钱库里偷了一文钱，张乖崖认为数量虽小但性质严重，必须严惩。该官吏不服，张乖崖判他死刑并在判决书上写道：“一日一钱，千日一千；绳锯木断，水滴石穿。”"]},{"id":36535,"word":"维妙维肖","pinyin":"wéi miào wéi xiào","abbr":"wmwx","explanation":"肖：相似。形容描写或模仿非常逼真传神","source":{"text":"形容维妙维肖，仿佛《水经注》造语。","book":"清·冯镇峦《读聊斋杂说》"},"example":{"text":"钱钟书《围城》：“高松年直跳起来，假惊异的表情做得～。”"},"similar":["惟妙惟肖","栩栩如生"],"opposite":["画虎类犬"],"usage":"作谓语、定语、补语；指非常逼真"},{"id":36536,"word":"绵力薄材","pinyin":"mián lì bó cái","abbr":"mlbc","explanation":"力量小，没有什么才能。","source":{"text":"越人绵力薄材，不能陆战。","book":"东汉·班固《汉书·严助传》"},"example":{"text":"臣～，孱躯病质。","book":"明·李东阳《奏为自陈休致事》"},"usage":"作宾语；常用作谦词"},{"id":36537,"word":"绵延不断","pinyin":"mián yán bù duàn","abbr":"mybd","explanation":"形容相同的自然景观一个接一个不间断地出现。","source":{"text":"涓涓不雍，终为江河；绵绵不绝，或成网罗。","book":"《孔子家语·观周》"},"example":{"text":"～的游行队伍正往这边涌来。"},"similar":["纷至沓来","连续不断"],"opposite":["昙花一现"],"usage":"作谓语、定语；指连续不断"},{"id":36538,"word":"绵延不绝","pinyin":"mián yán bù jué","abbr":"mybj","explanation":"绵延：延续不断的样子。延续不断的样子。","source":{"text":"涓涓不壅，终为江河，绵绵不绝，或成网罗。","book":"《孔子家语·观周》"},"example":{"text":"我知道生命无处不在，我知道生命～。","book":"巴金《怀念·悼范兄》"},"similar":["绵延不断"],"opposite":["断断续续"],"usage":"作谓语、定语；指延续"},{"id":36539,"word":"绵延起伏","pinyin":"mián yán qǐ fú","abbr":"myqf","explanation":"形容山势高下延伸不绝。","source":{"text":"加上绵延起伏的群山，错落隐现的胜迹，足够教你流连忘返。","book":"朱自清《〈燕知草〉序》"},"usage":"作谓语、定语；指高低起伏延续不断"},{"id":36540,"word":"绵绵不息","pinyin":"mián mián bù xī","abbr":"mmbx","explanation":"绵绵：连续不断的样子。延续不断。","source":{"text":"涓涓不壅，终为江河，绵绵不绝，或成网罗。","book":"《孔子家语·观周》"},"example":{"text":"我激荡在这～、滂沱四方的生命洪流中。","book":"巴金《无题·做一个战士》"},"similar":["绵绵不绝"],"opposite":["断断续续","一刀两断"],"usage":"作谓语、定语、状语；指连续不断"},{"id":36541,"word":"绵绵不断","pinyin":"mián mián bù duàn","abbr":"mmbd","explanation":"绵绵：延续不绝的样子。接连不断，一直延续下去。亦作“绵绵不息”、“绵绵不绝”、“绵延不绝”。","source":{"text":"涓涓不壅，终为江河，绵绵不绝，或成网罗。","book":"《孔子家语·观周》"},"example":{"text":"天色灰蒙蒙的，弥漫的云雾遮盖着山峦，那种无尽无休的贵州式的细雨～。","book":"魏巍《地球的红飘带》二十"},"similar":["连续不断"],"opposite":["断断续续"],"usage":"作定语、状语；用于口语"},{"id":36542,"word":"绵绵不绝","pinyin":"mián mián bù jué","abbr":"mmbj","explanation":"绵绵：连续不断的样子。形容多，连续不断。","source":{"text":"涓涓不壅，终为江河，绵绵不绝，或成网罗。","book":"三国·魏·王肃《孔子家语·观周》"},"example":{"text":"正是清明时节，少不得天公应时，催花雨下，那阵雨下得～。","book":"《警世通言·白娘子永镇雷峰塔》"},"similar":["接连不断","连绵不断"],"opposite":["断断续续","一刀两断"],"usage":"作谓语、定语、状语；指连续不断"},{"id":36543,"word":"绵绵不绝，缦缦奈何","pinyin":"mián mián bù jué，màn màn nài hé","abbr":"mmbjmmnh","explanation":"缦：通“蔓”。事端在微小的时候如不杜绝，蔓延起来怎么办？形容错误或坏事在其萌芽状态时就要根除，不让其发展下去，赞成祸患。","source":{"text":"绵绵不绝，缦缦奈何；毫毛不拔，将成斧柯。","book":"《战国策·魏策一》"}},{"id":36544,"word":"绵绵瓜瓞","pinyin":"mián mián guā dié","abbr":"mmgd","explanation":"绵绵：延续不断的样子；瓞：小瓜。如同一根连绵不断的藤上结了许多大大小小的瓜一样。引用为祝颂子孙昌盛。","source":{"text":"绵绵瓜瓞，民之初生，自土沮漆。","book":"《诗经·大雅·绵》"},"example":{"text":"夏殷既袭，宗周继祀，～，六国互峙。","book":"晋·潘岳《为贾谧作赠陆机》诗"},"usage":"作宾语、定语；指子孙昌盛"},{"id":36545,"word":"绵绵缗缗","pinyin":"mián mián mín mín","abbr":"mmmm","explanation":"绵绵：连绵不断的样子。连绵不断的样子。","source":{"text":"其东南万屋沉沉，炊烟如人立，各有所企，微风绕之，左引右挹。绵绵缗缗。","book":"清·梅曾亮《盋山余霞阁记》"},"usage":"作定语、状语；用于书面语"},{"id":36546,"word":"绵裹秤锤","pinyin":"mián guǒ chèng chuí","abbr":"mgcc","explanation":"丝绵里裹着秤锤。比喻深藏不露。","source":{"text":"兴化道：‘我逢人则不出，出则便为人，又作么生？’师曰：‘绵裹秤锤。’","book":"宋·释普济《五灯会元·大沩果禅师法嗣》"},"similar":["深藏不露"],"usage":"作宾语、定语；指为人城府很深"},{"id":36547,"word":"绵言细语","pinyin":"mián yán xì yǔ","abbr":"myxy","explanation":"绵：柔软。绵言：柔和的语言。细语：低细的语句。指说话时声音柔和细微，使人容易接受。","example":{"text":"朱老忠拈着胡子，挪动板凳向运涛跟前凑了凑，～儿说：“去吧，孩子！去吧！……”","book":"梁斌《红旗谱》十四"}},{"id":36548,"word":"绵里薄材","pinyin":"mián lǐ bó cái","abbr":"mlbc","explanation":"力量小，没有什么才能。常用作谦词。","source":{"text":"且越人绵里薄材，不能陆战。","book":"《汉书·严助传》"},"example":{"text":"在昔之懋勋明德，尚莫敢居，如臣之～，岂宜非据。","book":"宋·王安石《乞免使相充观察使第二表》"}},{"id":36549,"word":"绵里藏针","pinyin":"mián lǐ cáng zhēn","abbr":"mlcz","explanation":"绵：丝棉。棉絮里面藏着针。比喻外貌和善，内心刻毒；也比喻柔中有刚","source":{"text":"当日说知心，绵里藏针。","book":"清·西周生《醒世姻缘传》"},"example":{"text":"王朔《玩儿的就是心跳》：“好好我认真，我是～，肚里容珠。”"},"similar":["笑里藏刀","口蜜腹剑"],"opposite":["剑拔弩张"],"usage":"作谓语、定语、状语；指人心很刻毒"},{"id":36550,"word":"绵里裹铁","pinyin":"mián lǐ guǒ tiě","abbr":"mlgt","explanation":"丝绵里包裹着铁。比喻书法或诗文作品柔中有刚或平缓中含着锐气。","source":{"text":"元·赵孟頫《松雪斋》:“余观此帖潇洒纵横，虽肥而无墨猪之状，外柔内刚，真所谓绵里裹铁也。”"},"example":{"text":"画奇创，字有～意，律诗清古。","book":"清·蓝瑛《图绘宝鉴续集·僧石溪》"}},{"id":36551,"word":"绵里针","pinyin":"mián lǐ zhēn","abbr":"mlz","explanation":"绵：丝棉。棉絮里面藏着针。形容柔中有刚。也比喻外貌和善，内心刻毒。","source":{"text":"笑你个风魔的翰林，无处问佳音，向简帖儿上计禀。得了个纸条儿恁般绵里针，若见玉天仙怎生软厮禁？俺那小姐忘恩，赤紧的偻人负心。","book":"元·王实甫《西厢记》第三本第四折"},"example":{"text":"笑里刀，剐皮割肉；～，剔髓挑觔。","book":"元·石君宝《曲池柳》第二折"},"similar":["绵里藏针"],"usage":"作宾语、定语；用于比喻句"},{"id":36552,"word":"绷巴吊拷","pinyin":"bēng bā diào kǎo","abbr":"bbdk","explanation":"强行脱去衣服，捆绑并吊起来拷打。同“绷扒吊拷”。","source":{"text":"好女婿呀！这早晚还不起来谢亲，又不到师父处报喜，还在这里卖解儿耍子哩！咄！你娘呢？你老婆呢？好个绷巴吊拷的女婿呀！","book":"明·吴承恩《西游记》第二十四回"},"example":{"text":"我们不搞～的刑事逼供。"},"similar":["绷扒吊拷"],"usage":"作宾语、定语；指古代刑罚"},{"id":36553,"word":"绷扒吊拷","pinyin":"bēng bā diào kǎo","abbr":"bbdk","explanation":"古代的一种刑罚。强行脱去衣服，捆绑并吊起来拷打。绷：捆绑。扒：脱掉。","source":{"text":"并无聪明正直的心腹，尽都是那绷扒吊拷的招状。","book":"元·李行道《灰阑记》第二折：“你若经官发落，这绷扒吊拷要桩桩儿捱过。”元·王仲文《救孝子》第三折"},"example":{"text":"他把～般般用，情节根由细细穷，那其间枯皮朽骨难禁痛，少不得从实攀供。","book":"元·纪君祥《赵氏孤儿》第二折"},"similar":["棚扒吊拷","绷爬吊拷"],"usage":"作宾语、定语；指古代刑罚"},{"id":36554,"word":"绷爬吊拷","pinyin":"bēng pá diào kǎo","abbr":"bpdk","explanation":"强行脱去衣服，捆绑并吊起来拷打。同“绷扒吊拷”。","source":{"text":"押下司理院，绷爬吊拷，一一勘正。","book":"明·冯梦龙《警世通言·万秀娘仇报山亭儿》"},"example":{"text":"～的审问方式是刑事逼供。"},"similar":["绷扒吊拷"],"usage":"作宾语、定语；指古代刑罚"},{"id":36555,"word":"绸缪帐扆","pinyin":"chóu móu zhàng yǐ","abbr":"cmzy","explanation":"绸缪：绵密的样子；帐：帐幕；扆：屏风。指运筹帷幄，在军营帐幕之中谋划军国大事。","source":{"text":"夙蒙眷知，惟在诚直，绸缪帐扆，一纪于兹。","book":"唐·陆贽《论裴延龄奸蠹书》"},"similar":["绸缪帷帐"],"usage":"作谓语；指运筹帷幄"},{"id":36556,"word":"绸缪帷帐","pinyin":"chóu móu wéi zhàng","abbr":"cmwz","explanation":"绸缪：绵密的样子；帷：帐幕。指运筹帷幄，在军营帐幕之中谋划军国大事。","source":{"text":"或材推栋梁，谋猷经远，绸缪帷帐，经纶霸图。","book":"《旧唐书·长孙无忌传》"},"similar":["绸缪帷幄","绸缪帐扆"],"usage":"作谓语；指运筹帷幄"},{"id":36557,"word":"绸缪帷幄","pinyin":"chóu móu wéi wò","abbr":"cmww","explanation":"指运筹帷幄，在军营帐幕之中谋划军国大事。","source":{"text":"或宣哲协规，绸缪帷幄；或披荆汗马。","book":"《陈书·世祖纪》"},"example":{"text":"元康以智能才干，委质霸朝，～，任寄为重。","book":"《北齐书·孙搴陈元康等传论》"},"similar":["运筹帷幄","绸缪帷帐"],"usage":"作谓语；指运筹帷幄"},{"id":36558,"word":"绸缪未雨","pinyin":"chóu móu wèi yǔ","abbr":"cmwy","explanation":"绸缪：紧密缠缚。在没有下雨前，就要修缮好门窗。比喻事先做好准备工作，防患未然。","source":{"text":"迨天之未阴雨，彻彼桑土，绸缪牖户。","book":"《诗经·豳风·鸱鸮》"},"example":{"text":"当此～之时，为兴学育才之事，若追亡救火之急，犹恐其不能以立国也。","book":"康有为《请废八股试帖楷法试士改用策论折》"},"similar":["未雨绸缪","绸缪牖户"],"usage":"作谓语、定语；形容事先准备"},{"id":36559,"word":"绸缪束薪","pinyin":"chóu móu shù xīn","abbr":"cmsx","explanation":"绸缪：紧紧缠绕。紧紧地把柴草捆扎成捆儿。古代束薪比喻婚姻的结合。","source":{"text":"绸缪束薪，三星在天。","book":"《诗经·唐风·绸缪》"},"usage":"作谓语；比喻婚姻的结合"},{"id":36560,"word":"绸缪桑土","pinyin":"chóu móu sāng tǔ","abbr":"cmst","explanation":"绸缪：紧密缠缚；土：同“杜”，树根。比喻事前做好准备工作。","source":{"text":"迨天之未阴雨，彻彼桑土，绸缪牖户。","book":"《诗经·豳风·鸱鸮》"},"example":{"text":"吾邑富庶，百倍于巢，愿为～之思。","book":"清·钱谦益《输丁议》"},"similar":["未雨绸缪","防患未然"],"usage":"作谓语、定语；指作准备"},{"id":36561,"word":"绸缪牖户","pinyin":"chóu móu yǒu hù","abbr":"cmyh","explanation":"绸缪：紧紧缠绕；牖户：门窗。在下雨之前缠缚好门窗。","source":{"text":"迨天之未阴雨，彻彼桑土，绸缪牖户。","book":"《诗经·豳风·鸱鸮》"},"example":{"text":"一老～，几人颠倒衣裳。","book":"宋·范成大《枕上六言》诗"},"similar":["未雨绸缪"],"usage":"作谓语、定语；形容事先准备"},{"id":36562,"word":"综核名实","pinyin":"zōng hé míng shí","abbr":"zhms","explanation":"综：综合；核：考核；名：名声；实：实绩。全面考核事物的称说是不是与实际相符。","source":{"text":"孝宣之治，信赏必罚，综核名实。","book":"《汉书·宣帝纪赞》"},"example":{"text":"世宗在位的时候，～，凡是不急之务，一概停罢，除了海防、海塘以外，没有什么“大工”。","book":"高阳《玉座珠帘》下册"},"usage":"作谓语；指考核"},{"id":36563,"word":"绾角兄弟","pinyin":"wǎn jiǎo xiōng dì","abbr":"wjxd","explanation":"绾：把长条形的东西盘绕起来打成结；绾角：古代儿童束发，指年幼时；兄弟：此指亲如兄弟的朋友。幼年时结交的好朋友。","source":{"text":"随何也咱是你绾角兄弟，怎生来汉王不把咱钦敬。","book":"元·无名氏《气英布》第二回"}},{"id":36564,"word":"绾黄纡紫","pinyin":"wǎn huáng yū zǐ","abbr":"whyz","explanation":"绾、纡：系结。黄：指金印。紫：指紫色的拴在印纽上的丝带。挂着金印，系着紫色的绶带。比喻身为高官，地位显贵。","source":{"text":"有将、相，有卿，尹，有刺史、守、令，或绾黄纡紫，或揽辔褰帷。","book":"清·周容《芋老人传》"}},{"id":36565,"word":"绿叶成荫","pinyin":"lǜ yè chéng yīn","abbr":"lycy","explanation":"比喻绿叶繁茂覆盖成荫。同“绿叶成阴”。","source":{"text":"我已经过了绿叶成荫的时节，现在是走飘落的路了。","book":"巴金《谈秋》"},"example":{"text":"当年种的小树苗，如今已是～了。"},"similar":["绿叶成阴"],"usage":"作谓语、定语；指绿叶繁茂覆盖成荫"},{"id":36566,"word":"绿叶成阴","pinyin":"lǜ yè chéng yīn","abbr":"lycy","explanation":"指女子出嫁生了子女。也比喻绿叶繁茂覆盖成荫。","source":{"text":"自是寻春去较迟，不须惆怅怨芳时。狂风落尽深红色，绿叶成阴子满枝。","book":"宋·计有功《唐诗纪事·杜牧》"},"example":{"text":"红英扫地风尺晓，～雨洗春。","book":"宋·苏轼《寒食与器之游南塔寺寂照堂》诗"},"similar":["绿树成荫"],"usage":"作谓语、定语；指绿叶繁茂覆盖成荫","story":["唐朝时期，诗人杜牧在湖州游览，见一老婆婆带一个十二三岁的姑娘，那姑娘生得十分漂亮，杜牧对她动了情，向老婆婆下了聘礼，约定10年内娶她。14年后杜牧任湖州刺史时，那姑娘已经嫁人生子，杜牧遗憾作叹花诗：“狂风落尽深红色，绿叶成阴子满枝"]},{"id":36567,"word":"绿女红男","pinyin":"lǜ nǚ hóng nán","abbr":"lnhn","explanation":"服装艳丽的青年男女。","source":{"text":"游人甚多，绿女红男，联蹁道路。","book":"清·富察敦崇《燕京岁时记·万寿寺》"},"similar":["红男绿女"],"usage":"作主语、宾语；指年轻人"},{"id":36568,"word":"绿惨红愁","pinyin":"lǜ cǎn hóng chóu","abbr":"lchc","explanation":"指妇女的种种愁恨。绿、红，指黑鬓红颜。","source":{"text":"讲鬼怪令羽士心寒胆战；论闺怨遗佳人绿惨红愁。","book":"宋·罗烨《醉翁谈录·小说开辟》"},"example":{"text":"宋·罗烨《醉翁谈录·小说开辟》：“讲鬼怪令羽士心寒胆战；论闺怨遗佳人绿惨红愁。”"},"similar":["绿惨红销"],"usage":"作谓语、定语；用于书面语"},{"id":36569,"word":"绿惨红销","pinyin":"lǜ cǎn hóng xiāo","abbr":"lchx","explanation":"指妇女的种种愁恨。同“绿惨红愁”。","source":{"text":"心憔，难听他绿惨红销。","book":"明·汤显祖《紫钗记·醉侠闲评》"},"similar":["绿惨红愁"],"usage":"作谓语、定语；用于书面语"},{"id":36570,"word":"绿暗红稀","pinyin":"lǜ àn hóng xī","abbr":"lahx","explanation":"形容暮春时绿廕幽暗、红花凋谢的景象。","source":{"text":"绿暗红稀出凤城，暮云楼阁古今情。","book":"唐·韩琮《暮春滻水送别》"},"example":{"text":"～起暝烟，独将幽恨小庭前。","book":"明·冯梦龙《警世通言·蒋淑真刎颈鸳鸯会》"},"usage":"作主语；形容暮春景象"},{"id":36571,"word":"绿林大盗","pinyin":"lù lín dà dào","abbr":"lldd","explanation":"指聚集山林的强盗。","source":{"text":"既作绿林大盗，便与那偷猫盗狗的不同。","book":"清·文康《儿女英雄传》第11回"},"example":{"text":"我们要狠狠打击～。"},"similar":["绿林强盗"],"usage":"作宾语、定语；指强盗"},{"id":36572,"word":"绿林好汉","pinyin":"lù lín hǎo hàn","abbr":"llhh","explanation":"指聚集山林反抗封建统治阶级的人们。旧时也指聚众行劫的群盗股匪。","source":{"text":"王莽末，南方饥馑，人庶群入野泽，掘凫芘而食之，更相侵夺。……于是诸亡命马武、王常、成丹等往从之；共攻离乡聚，臧于绿林中，数月间至七八千人。","book":"《后汉书·刘玄传》"},"example":{"text":"收了无数的～，查拿海寇。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["杀富济贫","绿林豪客"],"opposite":["打家劫舍"],"usage":"作主语、宾语、定语；指造反英雄"},{"id":36573,"word":"绿林强盗","pinyin":"lù lín qiáng dào","abbr":"llqd","explanation":"指山林的强盗。","source":{"text":"试看绿林强盗，怎样不惜钱财以买盒子炮，就可知道。","book":"鲁迅《书信集·致赵家璧》"},"similar":["绿林大盗"],"usage":"作宾语、定语；指强盗"},{"id":36574,"word":"绿林豪士","pinyin":"lù lín háo shì","abbr":"llhs","explanation":"指绿林中本领出众的人物。","source":{"text":"其同乡许振鹏……去之宁波，由王金发介绍，因得入大岚山，连结绿林豪士。","book":"陶成章《浙案纪略》上卷第四章第二节"},"similar":["绿林豪杰"],"usage":"作宾语、定语；指强盗头目"},{"id":36575,"word":"绿林豪客","pinyin":"lù lín háo kè","abbr":"llhk","explanation":"绿林：西汉王匡、王凤为首的“绿林军”。指聚集山林、反抗官府的武装力量指伤害人民的群盗股匪。","source":{"text":"暮雨潇潇江上村，绿林豪客夜知闻。","book":"唐·李涉《井栏砂宿遇夜客》诗"},"example":{"text":"那并不是普通的～，而且，那里面各种各样的人都有。","book":"郭沫若《孔雀胆》第三幕"},"similar":["绿林豪杰"],"usage":"作宾语、定语；指强盗头目"},{"id":36576,"word":"绿林豪杰","pinyin":"lù lín háo jié","abbr":"llhj","explanation":"指绿林中出众的人物。","source":{"text":"有谁人道我的不是，又喜得有两个绿林豪杰率众来归，要助我力图大事。","book":"清·李渔《玉搔头·逼氛》"},"example":{"text":"他幻想成为～。"},"similar":["绿林豪客","绿林好汉"],"usage":"作宾语、定语；指强盗头目"},{"id":36577,"word":"绿水青山","pinyin":"lǜ shuǐ qīng shān","abbr":"lsqs","explanation":"泛称美好山河。","source":{"text":"问：‘牛头未见四祖时如何？’师曰：‘青山绿水。’曰：‘见后如何？’师曰：‘绿水青山。’","book":"宋·释普济《五灯会元》"},"example":{"text":"九重天，二十年，龙楼凤阁都曾见，～任自然。","book":"元·马致远《拨不断》"},"similar":["山清水秀"],"opposite":["不毛之地"],"usage":"作宾语；泛称美好的山河"},{"id":36578,"word":"绿珠坠楼","pinyin":"lǜ zhū zhuì lóu","abbr":"lzzl","explanation":"绿珠：古代人名，歌女。歌女绿珠跳楼自杀保节。","source":{"text":"盖一婢子，不知书而能感主恩，愤不顾身。其志烈懔懔，诚足使后人仰慕歌咏也。","book":"宋·乐史《绿珠传》"},"example":{"text":"～的故事在当今社会时有发生。"},"usage":"作宾语、定语；指跳楼自杀","story":["西晋时期，渤海大富翁石崇非常富有，他建一座金谷园别墅，专门供他喜欢的歌女绿珠使用。他被罢官在家，终日守着绿珠。中书令孙秀偶然见到十分有名的绿珠就动了心，向石崇索取未果，就派兵强取。绿珠死活不从，就跳楼而死"]},{"id":36579,"word":"绿肥红瘦","pinyin":"lǜ féi hóng shòu","abbr":"lfhs","explanation":"绿叶茂盛，花渐凋谢。指暮春时节。也形容春残的景象。","source":{"text":"知否？知否？应是绿肥红瘦。","book":"宋·李清照《如梦令》词"},"example":{"text":"这春花老残，～，怎能惹起她那么深切的悲感呢？","book":"庐隐《窗外的春光》"},"similar":["红瘦绿肥"],"usage":"作主语、宾语、定语；指暮春景色"},{"id":36580,"word":"绿草如茵","pinyin":"lǜ cǎo rú yīn","abbr":"lcry","explanation":"绿油油的草好像地上铺的褥子。常指可供临时休憩的草地。亦作“碧草如茵”。","source":{"text":"世贞环目四看……只见天然幽静，如出凡尘。花园内曲廊透逸通幽，假山堆叠如屏列。满坝苔痕乱点，绿草如茵；数株古松葱笼茂密，斜遮雨凤。","book":"郭戈《金瓶梅传奇》第三回"},"example":{"text":"梅轩利随着聋耳陈走上运头角山。半山腰里，一片开阔的空地，～，开满了早春的野花。","book":"霍达《补天裂》第十三章"}},{"id":36581,"word":"绿蓑青笠","pinyin":"lǜ suō qīng lì","abbr":"lsql","explanation":"绿草编的蓑衣，青竹编的斗笠。形容渔翁的打扮。","source":{"text":"西塞山前白鹭飞，桃花流水鳜鱼肥。青箬笠，绿蓑衣，斜风细雨不须归。","book":"唐·张志和《渔父歌》"},"example":{"text":"～随时看，胜挂朝中紫绶衣。","book":"明·吴承恩《西游记》第九回"},"usage":"作宾语、定语；形容渔翁的打扮"},{"id":36582,"word":"绿衣使者","pinyin":"lǜ yī shǐ zhě","abbr":"lysz","explanation":"原指鹦鹉。近代称邮递员。","source":{"text":"其时仆妾辈并无所觉，惟有鹦鹉一只在堂前架上。……封鹦鹉为‘绿衣使者’。","book":"五代·王仁裕《开元天宝遗事·鹦鹉告事》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“无肠公子，螃蟹之名；～，鹦鹉之号。”"},"similar":["青鸟使者"],"usage":"作宾语；指邮递员","story":["唐玄宗李隆基时期，长安富翁杨崇义养了一只红嘴绿毛鹦鹉，它十分聪明伶俐，很会学人说话。杨崇义被妻子刘氏与李俨通奸合谋杀死，万年县令根据鹦鹉提供的信息破案。唐玄宗封这只鹦鹉为绿衣使者，学者张说特写《绿衣使者传》纪念"]},{"id":36583,"word":"绿衣黄里","pinyin":"lǜ yī huáng lǐ","abbr":"lyhl","explanation":"绿、黄：古时以黄色为正色，绿为闲色。以绿色为衣，用黄色为里。旧喻尊卑反置，贵贱颠倒。","source":{"text":"绿兮衣兮，绿衣黄里。心之忧矣，曷维其已。","book":"《诗经·邶风·绿衣》"},"example":{"text":"与前妻为寇仇，宠丫环如蜜甘，将亲儿热女途人看，～颠倒用。","book":"明·无名氏《渔樵闲话》第二折"},"usage":"作宾语；指贵贱颠倒"},{"id":36584,"word":"绿酒红灯","pinyin":"lǜ jiǔ hóng dēng","abbr":"ljhd","explanation":"形容奢侈豪华的享乐生活。","source":{"text":"绿酒红灯如此夜，青衫翠鬓可怜人。","book":"清·魏子安《花月痕》第二十七回"},"example":{"text":"新年时节，正好尽情娱乐，～，清歌妙舞。","book":"翦伯赞《塞上行·行纪·沉静了的绥边》"},"similar":["灯红酒绿"],"usage":"作宾语、定语；指糜烂的生活"},{"id":36585,"word":"绿马仰秣","pinyin":"lù mǎ yǎng mò","abbr":"lmym","explanation":"绿马：即绿耳，古代骏马名；仰：脸向上；秣：喂马的饲料。面对着饲料的马都仰起头来不吃。形容乐声美妙，连马也停食倾听。","source":{"text":"绿马仰秣，丹鱼耸鳞。","book":"唐·王勣《伯牙弹琴对仲子期赞》"}},{"id":36586,"word":"绿鬓朱颜","pinyin":"lǜ bìn zhū yán","abbr":"lbzy","explanation":"形容年轻美好的容颜，借指年轻女子。","source":{"text":"绿鬓朱颜，道家装束，长似少年时。","book":"宋·晏殊《少年游》词"},"example":{"text":"～，便不可无温柔之奇货。","book":"《西湖佳话·西泠韵迹》"},"similar":["绿鬓红颜"],"usage":"作宾语；指年轻人"},{"id":36587,"word":"绿鬓红颜","pinyin":"lǜ bìn hóng yán","abbr":"lbhy","explanation":"指年轻女子。同“绿鬓朱颜”。","source":{"text":"霎时绿鬓红颜都成孤寡，并不劳挨门搜括。","book":"清·洪楝园《后南柯·檀谋》"},"similar":["绿鬓朱颜"],"usage":"作宾语；指年轻人"},{"id":36588,"word":"缀文之士","pinyin":"zhuī wén zhī shì","abbr":"zwzs","explanation":"缀文：作文。指从事写作的人。","source":{"text":"自孔子后，缀文之士众矣，唯孟轲、孙况、董仲舒、司马迁、刘向、杨雄，此数公者，皆博物洽闻，通达古今，其言有补于世。","book":"《汉书·楚元王传赞》"},"example":{"text":"～，奕代继作；因并触类，广其辞义。","book":"晋·陶渊明《闲情赋》"},"usage":"作主语、宾语；用于书面语"},{"id":36589,"word":"缀玉联珠","pinyin":"zhuī yù lián zhū","abbr":"zylz","explanation":"缀：连结，拼合。形容诗词作品文辞意境的完美。也形容完美的诗词作品。","source":{"text":"白乐天去世，大中皇帝以诗吊之曰：‘缀玉连珠六十年，谁教冥路作诗篇？’","book":"五代·王定宝《唐摭言·杂记》"},"usage":"作谓语、定语；用于比喻句"},{"id":36590,"word":"缀辞之士","pinyin":"zhuì cí zhī shì","abbr":"zczs","explanation":"缀辞：写书作文。指著书立说的人。","source":{"text":"慷慨非死而死者，缀辞之士，未之或遗也。","book":"晋·潘岳《马开督玮》"},"similar":["缀文之士"],"usage":"作主语、宾语；指著作家"},{"id":36591,"word":"缄口不言","pinyin":"jiān kǒu bù yán","abbr":"jkby","explanation":"缄：封闭。封住嘴巴，不开口说话。","source":{"text":"正德间，给事、御史挟势凌人，趋权择便，凡朝廷大阙失，群臣大奸恶，缄口不言。","book":"《明史·何遵传》"},"example":{"text":"商民工匠，见诸官绅，皆～，恐犯当道之怒，祸生不测云。","book":"清·郑观应《盛世危言·商务》"},"similar":["缄口无言"],"opposite":["口若悬河"],"usage":"作谓语；形容沉默不语"},{"id":36592,"word":"缄口如瓶","pinyin":"jiān kǒu rú píng","abbr":"jkrp","explanation":"缄口：闭口不言。指说话谨慎，严守秘密。","source":{"text":"想你掩耳偷铃，为你缄口如瓶。","book":"明·胡文焕《群音类选·无名氏》"},"similar":["守口如瓶","守瓶缄口"],"usage":"作谓语、定语；形容说话谨慎"},{"id":36593,"word":"缄口无言","pinyin":"jiān kǒu wú yán","abbr":"jkwy","explanation":"缄口：闭着嘴。闭着嘴，不说话。","source":{"text":"师云：‘汝若不会，老僧即缄口无言。’","book":"宋·释道原《景德传灯录》卷十二"},"similar":["缄口不言","哑口无言"],"usage":"作谓语、定语、状语；用于处事"},{"id":36594,"word":"缄口结舌","pinyin":"jiān kǒu jié shé","abbr":"jkjs","explanation":"缄：封，闭；结舌：指不敢说话。闭口不说话。形容理屈词穷说不出话来。也指慑于淫威不敢讲话。","source":{"text":"此智士所以钳口结舌，挌囊共默而已者也。","book":"汉·王充《潜夫论》"},"example":{"text":"思想之自由几绝，聪明英特之士，虽摘发新理，怀抱所见，而束于教令，胥～而不敢言。","book":"鲁迅《坟·文化偏至论》"},"similar":["缄口不言"],"opposite":["口若悬河"],"usage":"作谓语；形容沉默不语"},{"id":36595,"word":"缄舌闭口","pinyin":"jiān shé bì kǒu","abbr":"jsbk","explanation":"说不出话来。","source":{"text":"看别人苫眼铺眉，笑自己缄舌闭口。","book":"元·亢文苑《一枝花·为玉叶儿作》曲"},"similar":["缄口结舌"],"usage":"作谓语、宾语；指闭着嘴不说话"},{"id":36596,"word":"缊袍不耻","pinyin":"yùn páo bù chǐ","abbr":"ypbc","explanation":"缊袍：以乱麻、乱棉絮成的袍子，指古代贫者之衣；耻：丢脸。虽然穿得很破，而不认为丢脸。形容人穷志不穷。","source":{"text":"衣敝缊袍，与衣狐貉者立，而不耻者，其由也与。","book":"《论语·子罕》"},"example":{"text":"服之不衰，身之灾也；～，志独超欤。（明·程登吉《幼学琼林·衣服》）"},"usage":"作宾语、定语；用于书面语"},{"id":36597,"word":"缊褐瓢箪","pinyin":"yùn hè piáo dān","abbr":"yhpd","explanation":"缊：旧棉花，乱麻。褐：粗布衣服。瓢：饮水用具。箪：盛饭的竹器。身上穿粗布衣服。饮食用的是瓢、箪。形容生活非常清苦。","source":{"text":"冬无缊褐，夏渴瓢箪。","book":"晋·陶潜《祭从弟敬远文》"},"usage":"作宾语、定语；用于书面语"},{"id":36598,"word":"缓不济急","pinyin":"huǎn bù jì jí","abbr":"hbjj","explanation":"缓：慢；济：救助。缓慢的行动适应不了紧急的需要。","source":{"text":"正愁缓不济急，恰好有现任杭州织造的富周三爷，是门生的大舅子，他有托门生带京一万银子。","book":"清·文康《儿女英雄传》第十三回"},"example":{"text":"看看还差个八百多两银子，没有法子想，要变卖东西，却又～。","book":"清·吴趼人《糊涂世界》第六回"},"similar":["远水不救近火"],"opposite":["缓急相济"],"usage":"作宾语、谓语；指缓慢的行动不适应"},{"id":36599,"word":"缓兵之计","pinyin":"huǎn bīng zhī jì","abbr":"hbzj","explanation":"延缓对方进攻的计策。指拖延时间，然后再想办法。","source":{"text":"孔明用缓兵之计，渐退汉中，都督何故怀疑，不早追之？","book":"明·罗贯中《三国演义》第九十九回"},"example":{"text":"话大决意要杀陶三，监生恐闹出事来，原为～。","book":"清·刘鹗《老残游记》第七十二回"},"similar":["权宜之计"],"opposite":["速战速决","兵贵神速"],"usage":"作主语、宾语；指拖延时间，然后再想办法","story":["三国时期，孔明与司马懿在祁山作战。蜀军消灭了魏军大将郭淮、孙礼，占领了武都、阳平。张郃、戴陵等率军前去救援，被孔明打败。双方对峙了半月。孔明见司马懿不敢出战，用撤军的缓兵之计，诱使司马懿驱兵追赶，司马懿中计大败"]},{"id":36600,"word":"缓带轻裘","pinyin":"huǎn dài qīng qiú","abbr":"hdqq","explanation":"宽松的衣带，轻暖的皮衣。形容从容儒雅的风度。","source":{"text":"明日王缓带轻裘而进，令张彦之卒擐甲执兵，翼马而从。","book":"《资治通鉴·后梁均王贞明元年》"},"example":{"text":"～多暇，燕寝森严兵卫，香篆几徘徊。","book":"宋·张孝祥《水调歌头》词"},"similar":["轻裘缓带"],"usage":"作谓语、定语、状语；形容从容闲适","story":["晋朝时期，羊祜字叔子，作为荆州军队主帅，经常身不披甲，穿着轻软的裘皮大衣，坐着豪华的马车，游山玩水，被人称为“斯文主将”"]},{"id":36601,"word":"缓急相济","pinyin":"huǎn jí xiāng jì","abbr":"hjxj","explanation":"缓：和缓，舒缓；急：危急，急迫。不论在平时还是在紧急之时都给予帮助。","source":{"text":"朋友本来有通财之义，何况我们世交，这缓急相济，理是平常的事了。","book":"清·吴趼人《二十年目睹之怪现状》第65回"},"example":{"text":"处理问题时要做到～。"},"opposite":["缓不济急"],"usage":"作主语、宾语、定语；指帮助"},{"id":36602,"word":"缓急轻重","pinyin":"huǎn jí qīng zhòng","abbr":"hjqz","explanation":"指各种事情中有主要的和次要的，有急于要办的和可以慢一点办的。","source":{"text":"古之人有至于张空弮、罗雀鼠而民无二志者，非上之信有以结其心乎？此又权于缓急轻重之间而为不得已之计也。","book":"清·顾炎武《日知录》卷七"},"example":{"text":"分别～，争取男女老幼和游民分子一律参加生产。","book":"毛泽东《开展根据地的减租、生产和拥政爱民运动》"},"similar":["轻重缓急"],"usage":"作宾语、定语；指事情的重要程度"},{"id":36603,"word":"缓歌慢舞","pinyin":"huǎn gē màn wǔ","abbr":"hgmw","explanation":"柔和的歌声和舒缓的舞姿。同“缓歌缦舞”。","source":{"text":"缓歌慢舞凝丝竹，尽日君王看不足。","book":"唐·白居易《长恨歌》"},"similar":["轻歌慢舞","缓歌缦舞"],"usage":"作谓语、宾语；指轻快的音乐和柔美的舞蹈"},{"id":36604,"word":"缓歌缦舞","pinyin":"huǎn gē màn wǔ","abbr":"hgmw","explanation":"柔美的歌声和舞姿。","source":{"text":"缓歌缦舞凝丝竹，尽日君王看不足。","book":"唐·白居易《长恨歌》"},"similar":["缓歌慢舞","轻歌慢舞"],"usage":"作谓语、宾语；指轻快的音乐和柔美的舞蹈"},{"id":36605,"word":"缓步代车","pinyin":"huǎn bù dài chē","abbr":"hbdc","explanation":"缓：舒缓不急切。慢步行走以代乘车。","source":{"text":"玩文史以恰神，阅鱼鸟以散虑，观省野物，登临园沼，缓步代车，无事为责。","book":"唐·魏徴《隋书·刘炫传自赞》"},"similar":["安步当车","缓步当车"],"usage":"作谓语、宾语；指慢步行走以代乘车"},{"id":36606,"word":"缓步当车","pinyin":"huǎn bù dāng chē","abbr":"hbdc","explanation":"缓：慢；步：步行。慢步行走以代乘车。","source":{"text":"乃缓步以当车，复谢崇而慕闲。","book":"明·方孝孺《友筠轩赋》"},"similar":["缓步代车"],"usage":"作谓语、宾语；指慢步行走以代乘车"},{"id":36607,"word":"缓辔而行","pinyin":"huǎn pèi ér xíng","abbr":"hpex","explanation":"辔：驾驭牲口的嚼子的缰绳。信马由缰地慢走。","example":{"text":"面对如此美妙的环境，我～，充分享受一下大自然的恩赐。"},"similar":["缓辔徐行"],"usage":"作谓语、定语；用于骑马"},{"id":36608,"word":"缕析条分","pinyin":"lǚ xī tiáo fēn","abbr":"lxtf","explanation":"缕：线；析：剖析。有条有理地细细分析。","source":{"text":"淘为先朝名笔，非晚世效颦可到。缕析条分，总成就澹然、三子禅真一事。","book":"明·清溪道人《禅真逸史·凡例》"}},{"id":36609,"word":"缘名失实","pinyin":"yuán míng shī shí","abbr":"ymss","explanation":"光有空名，实际上并不是那样。","source":{"text":"汉明以察为明，而梁武以弱为仁，皆缘名失实，去佛远甚。","book":"宋·苏轼《震奎阁碑》"},"usage":"作谓语、定语；用于书面语"},{"id":36610,"word":"缘山求鱼","pinyin":"yuán shān qiú yú","abbr":"ysqy","explanation":"缘山：爬山。爬到山上去找鱼。比喻方向或办法不对头，不可能达到目的。","source":{"text":"以若所为，求若所欲，犹缘木而求鱼也。","book":"《孟子·梁惠王上》"}},{"id":36611,"word":"缘悭一面","pinyin":"yuán qiān yī miàn","abbr":"yqym","explanation":"悭：欠缺。缺乏缘份，没有和对方会面一次的机会","source":{"text":"我和茅盾先生虽相识，和我们的鲁迅先生竟缘悭一面。","book":"郭沫若《鬼苗的检阅》"},"usage":"作谓语、定语；用于交往等"},{"id":36612,"word":"缘悭分浅","pinyin":"yuán qiān fèn qiǎn","abbr":"yqfq","explanation":"缺少缘分。","source":{"text":"只为缘悭分浅，遇不着一个知己。","book":"清·吴敬梓《儒林外史》第30回"},"example":{"text":"只怪我们～，今生无法再成夫妻了。"},"similar":["缘薄分浅"],"usage":"作谓语、定语；用于书面语"},{"id":36613,"word":"缘悭命蹇","pinyin":"yuán qiān mìng jiǎn","abbr":"yqmj","explanation":"缘：缘分。悭：吝俭，欠缺。蹇：不顺利。缘分浅薄，命运不好，","source":{"text":"何时得见郎，恨缘悭命蹇。","book":"明·胡文焕《群音类选·余庆记·深闺幽思》"},"usage":"作谓语、定语；用于书面语"},{"id":36614,"word":"缘情体物","pinyin":"yuán qíng tǐ wù","abbr":"yqtw","explanation":"缘：因；体：描写。抒发感情，描写事物。","source":{"text":"诗缘情而绮靡，赋体物而浏亮。","book":"晋·陆机《文赋》"},"example":{"text":"僧问：“举子入门时为何？”师曰：“～事作么生？”","book":"宋·释普济《五灯会元》卷十四"},"usage":"作谓语、宾语；指作文"},{"id":36615,"word":"缘情肖物","pinyin":"yuán qíng xiāo wù","abbr":"yqxw","explanation":"缘：因；肖：描写。抒发感情，描写事物。","source":{"text":"诗缘情而绮靡，赋体物而浏亮。","book":"晋·陆机《文赋》"},"example":{"text":"大抵诗以言志，情贵富境，～，各极其致，乃为佳也。","book":"清·宋珏《与邦衡书》"}},{"id":36616,"word":"缘文生义","pinyin":"yuán wén shēng yì","abbr":"ywsy","explanation":"文：文字，指字面。只根据字面理解内容，牵强附会，不求甚解。亦作“望文生义”。","source":{"text":"素隐曰：‘距来者，谓弩势劲利，足以距于来敌也。’……念孙案：小司马缘文生义，非也。距来，当为距黍。黍、来隶书相近，故黍讹为来。","book":"清·王念孙《读书杂志·史记四》“距来”"},"example":{"text":"清·王念孙《读书杂志·史记》：“念孙案：小司马～，非也。”"},"usage":"作谓语、宾语、定语；用于文章等"},{"id":36617,"word":"缘木希鱼","pinyin":"yuán mù xī yú","abbr":"ymxy","explanation":"缘木：爬树。爬到树上去找鱼。比喻方向或办法不对头，不可能达到目的。同“缘木求鱼”。","source":{"text":"陛下所行，但务其华，不循其实，犹缘木希鱼，却行求全，","book":"《后汉书·周举传》"},"similar":["缘木求鱼"],"usage":"作谓语、宾语；指方法不对头"},{"id":36618,"word":"缘木求鱼","pinyin":"yuán mù qiú yú","abbr":"ymqy","explanation":"缘木：爬树。爬到树上去找鱼。比喻方向或办法不对头，不可能达到目的。","source":{"text":"以若所为，求若所欲，犹缘木而求鱼也。","book":"《孟子·梁惠王上》"},"example":{"text":"若想善出此关，大王乃～，非徒无益，而又害之也。","book":"明·许仲琳《封神演义》第三十三回"},"similar":["水中捞月","缘山求鱼","竹篮打水"],"opposite":["探囊取物","瓮中捉鳖"],"usage":"作谓语、宾语；指方法不对头","story":["战国时期，梁惠王企图通过战争来扩张领土，称霸诸侯。孟子不赞同他的这种思想，问他扩张的企图是为了什么，梁惠王说想满足自己最大的欲望。孟子说通过打仗而结下仇恨，诸侯们不可能服从于你，你这样做只能像爬到树上去找鱼一样"]},{"id":36619,"word":"缘波讨源","pinyin":"yuán bō tǎo yuán","abbr":"ybty","explanation":"缘波：顺着水流；讨源：探索源头。循着水流寻找源头。原比喻作文时由次要的写到主要的，最后点出主题。后比喻探讨事物的本末。","source":{"text":"或因枝以振叶，或沿波而讨源。","book":"晋·陆机《文赋》"}},{"id":36620,"word":"缘薄分浅","pinyin":"yuán bó fèn qiǎn","abbr":"ybfq","explanation":"指缘分浅薄。","source":{"text":"想的人心似刀割，肉似锤剜，也是我缘薄分浅，不能勾永久团圆。","book":"明·胡文焕《群音类选·无名氏〈点绛唇·相思〉》"},"similar":["缘悭分浅"],"usage":"作谓语、定语；用于书面语"},{"id":36621,"word":"缘鹄饰玉","pinyin":"yuán hú shì yù","abbr":"ygsy","explanation":"缘鹄：因某种机缘把鹄鸟做成羹，献给对方吃；饰玉：修饰玉鼎，造成美观的效果，让对方看了高兴。指因缘时会而登上高位","source":{"text":"缘鹄饰玉，后帝是飨。","book":"战国·楚·屈原《楚辞·天问》"},"usage":"作宾语、定语；用于书面语"},{"id":36622,"word":"缙绅之士","pinyin":"jìn shēn zhī shì","abbr":"jszs","explanation":"绅：大带。指做过官的大人先生。","source":{"text":"其在于诗书礼乐间者，邹鲁之士，缙绅先生多能明之。","book":"《庄子·天下》"},"example":{"text":"若其不事异姓，躬自引决，～，殆无一人焉。","book":"清·章炳麟《驳康有为论革命书》"},"similar":["搢绅之士"],"usage":"作主语、宾语；指旧时大官"},{"id":36623,"word":"缙绅先生","pinyin":"jìn shēn xiān shēng","abbr":"jsxs","explanation":"绅：大带。指做过官的大人先生。","source":{"text":"海内自缙绅先生山林风雅之士，见者未尝不……","book":"清·侯方域《新迁颜鲁公碑记》"},"example":{"text":"～尚持天动地静之说。","book":"李大钊《民彝与政治》"},"similar":["搢绅先生"],"usage":"作主语、宾语、定语；指旧时大官"},{"id":36624,"word":"缚舌交唇","pinyin":"fù shé jiāo chún","abbr":"fsjc","explanation":"缚：用绳缠束。闭着嘴，不敢说话。","source":{"text":"复有司马安者，攘义盗仁，缚舌交唇，柔声婉颜，狐媚当权。","book":"唐·孙樵《逐痁鬼文》"},"usage":"作谓语、状语；用于表恭顺"},{"id":36625,"word":"缚鸡之力","pinyin":"fù jī zhī lì","abbr":"fjzl","explanation":"捆鸡的力量。比喻体弱无力。","source":{"text":"那韩信手无缚鸡之力。","book":"元·《赚蒯通》第一折"},"example":{"text":"平日只会读书写字，刺绣描花，手无～。","book":"明·天然痴叟《石点头·侯官县烈女歼仇》"},"similar":["绵力薄才","力不能支"],"opposite":["拔鼎之力","拔山扛鼎","回天之力"],"usage":"作主语、宾语；常与“手无”连用"},{"id":36626,"word":"缚鸡弄丸","pinyin":"fù jī nòng wán","abbr":"fjnw","explanation":"缚：捆绑；弄丸：耍弄弹丸。比喻轻而易举。","source":{"text":"即至淫篡之吕武，至为无道，而其才术控制天下，有若缚鸡弄丸。","book":"康有为《大同书》戊部第一章"},"similar":["轻而易举"],"usage":"作宾语、定语；指很简单"},{"id":36627,"word":"缛礼烦仪","pinyin":"rù lǐ fán yí","abbr":"rlfy","explanation":"指烦琐的礼仪。","source":{"text":"其于尘俗奔走、缛礼烦仪之事，既以其溷扰而独避之。","book":"明·唐顺之《与王尧衢书》"},"usage":"作主语、宾语、定语；指礼节繁琐"},{"id":36628,"word":"缝衣浅带","pinyin":"féng yī qiǎn dài","abbr":"fyqd","explanation":"先秦·庄周《庄子·盗跖》：“今子修文武之道，掌天下之辩，以教后世，缝衣浅带，矫言伪行，以迷惑天下之主。”","source":{"text":"贤豪毕萃，升降有序，～，十有五人。 ★唐·李白《冬夜裴郎中薛侍御宴集序》"},"example":{"text":"唐·李白《冬夜裴郎中薛侍御宴集序》：“贤豪毕萃，升降有序，～，十有五人。”"},"similar":["逢衣浅带"],"usage":"作宾语；指儒者"},{"id":36629,"word":"缟纻之交","pinyin":"gāo zhù zhī jiāo","abbr":"gzzj","explanation":"缟纻：缟带和纻衣。缟带指用白色绢制成的大带。纻衣指用苎麻纤维织成的衣服。指交情笃深。","source":{"text":"吴地贵缟，郑地贵纻，故各献己所贵，示损己而不为彼货利。","book":"《左传·襄公二十九年》：“（吴之公子札）聘于郑，见子产，如旧相识，与之缟带，子产献纻衣焉”。晋·杜预注"},"usage":"作主语、宾语；用于交往等"},{"id":36630,"word":"缠夹不清","pinyin":"chán jiā bù qīng","abbr":"cjbq","explanation":"缠夹：纠缠夹杂。杂七杂八搅在一起，弄不清楚。","source":{"text":"凡有一件事，总是永远缠夹不清的，大约莫过于我们中国了。","book":"鲁迅《不懂的音译》"},"example":{"text":"她把事情搅得～了。"},"similar":["纠缠不清"],"opposite":["一刀两断"],"usage":"作谓语、宾语、状语；指混乱"},{"id":36631,"word":"缠绵幽怨","pinyin":"chán mián yōu yuàn","abbr":"cmyy","explanation":"缠绵：心绪郁结；幽怨：隐藏内心的怨恨。形容萦绕在内心的怨恨。","source":{"text":"不大愿意我有这种缠绵幽怨的调子。","book":"茅盾《从牯岭到东京》"},"usage":"作谓语、定语；用于人的感情"},{"id":36632,"word":"缠绵床第","pinyin":"chán mián chuáng dì","abbr":"cmcd","explanation":"缠绵：情意深厚；第：床上的席子。指沉溺于两性之事。","source":{"text":"弱冠而后，则又缠绵床第，以耗其精力。","book":"梁启超《新民说》第17节"},"example":{"text":"年轻人要有大志，不能～。"},"similar":["缠绵床褥"],"opposite":["不近女色"],"usage":"作谓语、宾语、定语；用于人好色"},{"id":36633,"word":"缠绵床褥","pinyin":"chán mián chuáng rù","abbr":"cmcr","explanation":"缠绵：纠缠不已，无法解脱。形容身患重病，卧床不起。也指沉溺于男女之事。","source":{"text":"偏李妃生起病来，缠绵床褥，一病不起，竟尔去世。","book":"《宋宫十八朝演义》第20回"},"example":{"text":"他很喜欢～。"},"similar":["缠绵床第"],"opposite":["不近女色"],"usage":"作谓语、宾语；指贪恋女色"},{"id":36634,"word":"缠绵悱恻","pinyin":"chán mián fěi cè","abbr":"cmfc","explanation":"悱恻：悲苦的样子。旧时形容内心痛苦难以排解。也指文章感情婉转凄凉。","source":{"text":"思缠绵以瞀乱兮，心摧伤以怆恻。","book":"晋·潘岳《寡妇赋》"},"example":{"text":"他是个忠臣，而且是个～的忠臣。","book":"朱自清《经典常谈·辞赋》"},"similar":["悱恻缠绵","缠绵凄怆"],"opposite":["超然物外"],"usage":"作谓语、定语、状语；形容十分悲痛而不能发"},{"id":36635,"word":"缠绵缱绻","pinyin":"chán mián qiǎn quǎn","abbr":"cmqq","explanation":"缠绵：心绪郁结；缱绻：难舍难分。形容感情深厚，难舍难分。","source":{"text":"以后对饮对唱，缠绵缱绻。","book":"清·曹雪芹《红楼梦》第93回"},"example":{"text":"我不忍看到我们分别时～的镜头。"},"similar":["难舍难分"],"usage":"作谓语、定语、状语；用于人的感情"},{"id":36636,"word":"缠绵蕴藉","pinyin":"chán mián yùn jiè","abbr":"cmyj","explanation":"蕴藉：含蓄而不直露。形容风格情调委婉细腻，含蓄而有节制。","source":{"text":"观彼所制，圆溜潇洒，缠绵蕴藉，于此事固若有别材也。","book":"清·刘熙载《艺概·词曲概》"},"usage":"作谓语、定语；指作品的风格情调"},{"id":36637,"word":"缧绁","pinyin":"lei xie","abbr":"lx","explanation":"缚犯人的绳索，这里借指监狱。"},{"id":36638,"word":"缧绁之厄","pinyin":"léi xiè zhī è","abbr":"lxze","explanation":"缧绁：拘押犯人的绳索，引申为囚禁。指牢狱之灾厄。","source":{"text":"我也自这般寻思。若不是贤兄如此周全，宋江定遭缧绁之厄。","book":"明·施耐庵《水浒传》第22回"},"similar":["缧绁之灾"],"usage":"作主语、宾语；用于被囚"},{"id":36639,"word":"缧绁之忧","pinyin":"léi xiè zhī yōu","abbr":"lxzy","explanation":"缧绁：捆绑犯人的绳子。引申为囚禁。被囚禁的忧虑。指有坐牢的危险。","source":{"text":"此是他人之难，与尔何预，即日还有缧绁之忧，犹虑死生难定。","book":"明·清溪道人《禅真后史》第三回"},"example":{"text":"逃掉了五色旗下的“铁窗斧钺风味”，而在青天白日之下又有“～”了。","book":"鲁迅《通信》"},"similar":["牢狱之灾"],"usage":"作宾语；指有坐牢的危险"},{"id":36640,"word":"缧绁之苦","pinyin":"léi xiè zhī kǔ","abbr":"lxzk","explanation":"缧绁：拘押犯人的绳索，引申为囚禁。指牢狱之苦。","source":{"text":"听说你要脱离缧绁之苦了，可喜可贺！","book":"罗广斌《红岩》第十章"},"usage":"作主语、宾语；用于被囚"},{"id":36641,"word":"缨緌之徒","pinyin":"yīng ruí zhī tú","abbr":"yrzt","explanation":"缨緌：古代帽子下垂的结带。带帽子的人，指社会上层人士。","source":{"text":"于时缨緌之徒，绅佩之士，望形表而影附。","book":"汉·蔡邕《郭有道碑文》"},"usage":"作宾语；指上层人士"},{"id":36642,"word":"缩地补天","pinyin":"suō dì bǔ tiān","abbr":"sdbt","explanation":"指改造天地宇宙。比喻做非凡之事。","source":{"text":"高祖缩地补天，重张区宇；反魂肉骨，再造生灵。","book":"《旧唐书·音乐志一》"},"example":{"text":"所以无人再逢者，当由过去生中原未受恩，故不肯竭尽心力～耳。","book":"清·纪昀《阅微草堂笔记·槐西杂志四》"},"usage":"作谓语、定语；比喻改革国政"},{"id":36643,"word":"缩头缩脑","pinyin":"suō tóu suō nǎo","abbr":"stsn","explanation":"形容畏缩不前，或胆小不敢出头。","source":{"text":"但是我也说明了几句我所以来校的理由，并要求学校当局今天缩头缩脑办法的解答。","book":"鲁迅《华盖集·“碰壁”之后》"},"example":{"text":"我不喜欢～的人。"},"similar":["缩手缩脚","胆小慎微"],"opposite":["放荡不羁"],"usage":"作谓语、宾语、状语；指胆小怕事"},{"id":36644,"word":"缩头缩脚","pinyin":"suō tóu suō jiǎo","abbr":"stsj","explanation":"形容畏缩、躲闪。","source":{"text":"你想这样缩头缩脚，反让金人耀武扬威，还能成为个国度吗？","book":"清·觉佛《女英雄》"},"example":{"text":"你不要～，得大胆行动。"},"similar":["缩头缩脑"],"opposite":["大大方方"],"usage":"作谓语、状语、定语；指放不开"},{"id":36645,"word":"缩头缩颈","pinyin":"suō tóu suō jǐng","abbr":"stsj","explanation":"形容畏缩不前，或胆小不敢出头。同“缩头缩脑”。","source":{"text":"远远一条长街只看见三四个人，蹀躞着，缩头缩颈歪斜着走。","book":"瞿秋白《饿乡纪程》十三"},"similar":["缩头缩脑"],"opposite":["放荡不羁"],"usage":"作谓语、宾语、状语；指胆小怕事"},{"id":36646,"word":"缩屋称贞","pinyin":"suō wū chēng zhēn","abbr":"swcz","explanation":"古时传说：颜叔子于风雨之夜，接纳因风而屋倒之邻家寡妇，使妇执烛，薪尽，又析取屋木以继。颂扬在妇女危难时不加侵犯。","source":{"text":"颜子缩屋称贞，柳下妪而不乱，未若此翁白首不娶者也。","book":"《北齐书·废帝纪》"},"similar":["坐怀不乱"],"usage":"作宾语、定语；用于为人处事","story":["传说古代时候，颜叔子在一个风雨之夜，接纳了一位因暴风而房屋倒塌的邻家寡妇，因自己的房屋也不宽敞，孤男寡女独处一室。他让寡妇手执火烛取暖，后来柴草用光了，他就折取房屋的木料来烧火取暖，始终没有性侵犯她"]},{"id":36647,"word":"缩成一团","pinyin":"suō chéng yī tuán","abbr":"scyt","explanation":"因寒冷、紧张、恐惧而蜷缩身体。","source":{"text":"自己坐在床沿上盯着凤霞看，二喜的身体都缩成一团了。","book":"余华《活着》"},"example":{"text":"天气格外寒冷，小狗冻得～。"},"usage":"作谓语、状语；指蜷缩身体"},{"id":36648,"word":"缩手旁观","pinyin":"suō shǒu páng guān","abbr":"sspg","explanation":"把手缩在袖子里，在一旁观看。比喻置身事外，既不过问，也不协助别人。","source":{"text":"不善为斫，血指汗颜，巧匠旁观，缩手袖间。","book":"唐·韩愈《祭柳子厚文》"},"similar":["袖手旁观","束手旁观"],"usage":"作谓语、宾语、定语；指不过问"},{"id":36649,"word":"缩手缩脚","pinyin":"suō shǒu suō jiǎo","abbr":"sssj","explanation":"由于寒冷而四肢不能舒展的样子。也形容做事胆小，顾虑多，不敢放手。","source":{"text":"喊了许久，店家方拿了一盏灯，缩手缩脚的进来，嘴里还喊道：‘好冷呀！’","book":"清·刘鹗《老残游记》第六回"},"example":{"text":"因而使得他们在社会矛盾面前～，处于被动地位。","book":"毛泽东《关于正确处理人民内部矛盾的问题》"},"similar":["束手束脚","缩头缩脑"],"opposite":["无拘无束","大手大脚","大义凛然"],"usage":"作谓语、宾语、状语、补语；指胆小"},{"id":36650,"word":"缩衣啬食","pinyin":"suō yī sè shí","abbr":"syss","explanation":"指省吃省穿，生活节俭。","source":{"text":"母缩衣啬食，区画综理，未尝使大人忧。","book":"清·梅曾亮《崔恭人墓志铭》"},"similar":["节衣缩食","缩衣节口","缩衣节食"],"opposite":["铺张浪费","挥金如土"],"usage":"作谓语、宾语、定语、状语；形容节俭"},{"id":36651,"word":"缩衣节口","pinyin":"suō yī jié kǒu","abbr":"syjk","explanation":"指省吃省穿，生活节俭。","source":{"text":"农民之家，量入为出，缩衣节口，虽贫亦足。","book":"宋·苏轼《乞不给散青苗钱斛状》"},"example":{"text":"～的日子真难熬"},"similar":["节衣缩食","缩衣啬食","缩衣节食"],"usage":"作谓语、宾语、定语、状语；形容节俭"},{"id":36652,"word":"缩衣节食","pinyin":"suō yī jié shí","abbr":"syjs","explanation":"省吃省穿。泛指生活节俭。","source":{"text":"我愿邻曲谨盖藏，缩衣节食勤耕桑。","book":"宋·陆游《剑南诗稿·秋获歌》"},"example":{"text":"快到床头金尽的日子，我只好～了。"},"similar":["节衣缩食","缩衣节口"],"usage":"作谓语、定语；指生活节俭"},{"id":36653,"word":"缪异之端","pinyin":"miù yì zhī duān","abbr":"myzd","explanation":"错误的异端的说法。","source":{"text":"缪异之端，称物假类。","book":"《淮南子·缪称训注》"}},{"id":36654,"word":"缪种流传","pinyin":"miù zhǒng liú chuán","abbr":"mzlc","explanation":"荒谬错误的东西流传下去。","source":{"text":"所取之士既不精，数年之后，复俾之主文，是非颠倒逾甚，时谓之缪流传。","book":"《宋史·选举志二》"},"example":{"text":"论古则判唐选为鸿沟，言今则别中盛如河汉，～，俗学沉锢，昧者视舟壑之密移，愚人求津剑之已逝，此可为叹息者也。","book":"清陈田《明诗纪事己签·李攀龙》"},"similar":["谬种流传"],"opposite":["流芳百世"],"usage":"作宾语、分句；指荒谬的东西流传下去","story":["宋朝时期，何澹见当时科举考试制度不严，考场上贿赂成风，致使没有真才实学的人投机取得功名，他向朝廷上奏折，指出先科考试的种种弊端与危害。如果考试不严，所选人才质量就不高，隔几年由他们主持考试，那么就会让谬误的根子代代相传"]},{"id":36655,"word":"缮甲厉兵","pinyin":"shàn jiǎ lì bīng","abbr":"sjlb","explanation":"《史记·张仪列传》：“敝邑恐惧慑伏，缮甲厉兵，饰车骑，习驰射。”","source":{"text":"敝邑恐惧慑伏，缮甲厉兵，饰车骑，习驰射。","book":"西汉·司马迁《史记·张仪列传》"},"similar":["缮甲治兵"],"usage":"作谓语、宾语；指作军事准备"},{"id":36656,"word":"缮甲治兵","pinyin":"shàn jiǎ zhì bīng","abbr":"sjzb","explanation":"缮甲：修治铠甲。比喻作军事准备。亦作“缮甲厉兵”。","source":{"text":"叔处于京，缮甲治兵，以出于田。","book":"《诗·郑风·叔于田序》"},"example":{"text":"今陛下天赐勇智，意在富强，即位以来，～，伺候邻国。","book":"宋·苏轼《代张方平谏用兵书》"},"similar":["缮甲厉兵"],"usage":"作谓语、宾语；指作军事准备"},{"id":36657,"word":"缱绻羡爱","pinyin":"qiǎn quǎn xiàn ài","abbr":"qqxa","explanation":"缱绻：缠绵。形容情意缠绵，互相爱慕。","source":{"text":"如今秦宝二人一来了，见了他两也不免缱绻羡爱。","book":"清·曹雪芹《红楼梦》第九回"},"usage":"作谓语；用于男女之间"},{"id":36658,"word":"缺一不可","pinyin":"quē yī bù kě","abbr":"qybk","explanation":"少一样也不行。","source":{"text":"林冲道：‘只今番克敌制胜，便见得先生妙法。正是鼎分三足，缺一不可，先生不必推却。’","book":"明·施耐庵《水浒传》第二十回"},"example":{"text":"每个学生都要德智体全面发展，三者～。"},"similar":["必不可少"],"opposite":["可有可无"],"usage":"作谓语、定语、状语；指十分必需","story":["梁山好汉林冲见王伦容不下晁盖等七位好汉，就火并了王伦，众人推举晁盖作首领。吴用担任军师，排第二位，林冲推举公孙胜统率军权说：“今番克敌制胜，谁人及得先生良法。正是鼎分三足，缺一不可。先生不必推却。”，公孙胜排第三位，林冲排第四"]},{"id":36659,"word":"缺三短四","pinyin":"quē sān duǎn sì","abbr":"qsds","explanation":"形容物品残缺不全。","example":{"text":"～的活，我们没法干。"},"similar":["残缺不全"],"opposite":["一应俱全"],"usage":"作谓语、定语；指残缺不全"},{"id":36660,"word":"缺口镊子","pinyin":"quē kǒu niè zi","abbr":"qknz","explanation":"镊子用以拔毛，缺口镊子则不能。故用以比喻一毛不拔的吝啬鬼。","source":{"text":"彼不相知者，视仆之饥饱，如观越人之肥瘠耳。乡谚有云‘缺口镊子’者，公识之。","book":"宋苏轼《与陈季常书》之十二"},"usage":"作宾语、定语；用于人"},{"id":36661,"word":"缺吃少穿","pinyin":"quē chī xhǎo chuān","abbr":"qcsc","explanation":"指衣食困乏。亦作“缺吃短穿”。","source":{"text":"那时候，他的父亲死去了，母亲领着他过日子，经常缺吃少穿。","book":"李凯《五亿农民的方向》"},"example":{"text":"我们不能忘记过去～的日子。"},"similar":["缺吃短穿","少吃缺穿"],"opposite":["丰衣足食"],"usage":"作谓语、定语；指衣食缺乏"},{"id":36662,"word":"缺吃短穿","pinyin":"quē chī duǎn chuān","abbr":"qcdc","explanation":"指衣食困乏。同“缺吃少穿”。","source":{"text":"赤贫户缺吃短穿，多分粮食和衣裳，还得分劈硬实的牲口。","book":"周立波《暴风骤雨》第一部二三"},"similar":["缺吃少穿"],"usage":"作谓语、定语；指衣食缺乏"},{"id":36663,"word":"缺头少尾","pinyin":"quē tóu shǎo wěi","abbr":"qtsw","explanation":"形容残缺不全或办事不周到。","source":{"text":"这是王贤弟你办的事，少头没尾的。","book":"清·李绿园《歧路灯》第十六回"}},{"id":36664,"word":"缺心少肺","pinyin":"quē xīn shǎo fèi","abbr":"qxsf","explanation":"心：心眼。缺少智谋。","example":{"text":"他～，容易被人利用。"},"similar":["缺心眼儿"],"opposite":["足智多谋"],"usage":"作谓语、定语；指人少心眼"},{"id":36665,"word":"缺心眼儿","pinyin":"quē xīn yǎn ér","abbr":"qxye","explanation":"缺乏心计或机智，尤指智力发育不健全。","source":{"text":"但是她那份逞能劲儿，也常常做出缺心眼儿的事体来。","book":"林海音《婚姻的故事》"},"example":{"text":"她～，容易上别人的当。"},"similar":["缺心少肺"],"opposite":["诡计多端"],"usage":"作谓语、定语；用于口语"},{"id":36666,"word":"缺斤短两","pinyin":"quē jīn duǎn liǎng","abbr":"qjdl","explanation":"做买卖时货物短缺分量。","source":{"text":"人家来转转，你们就吆喝着非拉着人家买，人家真买了就缺斤短两坑人家。","book":"王朔《我是你爸爸》"},"example":{"text":"做买卖要诚实，不能～。"},"similar":["短斤缺两","缺斤少两"],"opposite":["童叟无欺"],"usage":"作谓语、宾语、定语；指分量不足"},{"id":36667,"word":"缺月再圆","pinyin":"quē yuè zài yuán","abbr":"qyzy","explanation":"比喻夫妻离散后又团圆。","source":{"text":"他既断弦再续，俺也缺月再圆。","book":"明·无名氏《南牢记》第一折"},"example":{"text":"他在等待～的那一天。"},"similar":["破镜重圆"],"opposite":["离鸾别凤"],"usage":"作谓语、定语；用于夫妻等"},{"id":36668,"word":"缺月重圆","pinyin":"quē yuè chóng yuán","abbr":"qycy","explanation":"比喻夫妻离散后又重新团圆。","source":{"text":"两下相别，双双下舟。真个似缺月重圆，断弦再续，大喜不胜。","book":"明·冯梦龙《喻世明言》卷二十三"},"example":{"text":"～真情独笑，群珠紧守离恨谁怜。","book":"清·陈森《品花宝鉴》第二十九回"}},{"id":36669,"word":"缺衣少食","pinyin":"quē yī shǎo shí","abbr":"qyss","explanation":"衣食不足。指贫穷。亦作“缺食无衣”。","source":{"text":"则缺衣少食之烦恼不言而知也。","book":"明·李贽《复李渐老书》"},"example":{"text":"他过着～的日子。"},"similar":["缺吃少穿"],"opposite":["丰衣足食"],"usage":"作谓语、定语；指贫困"},{"id":36670,"word":"缺衣无食","pinyin":"quē yī wú shí","abbr":"qyws","explanation":"缺乏衣食。形容非常贫困。","source":{"text":"先主在独树楼桑受困危，织履编席，缺衣无食，到处寻觅。","book":"明·无名氏《贫富兴衰》第一折"}},{"id":36671,"word":"缺食无衣","pinyin":"quē shí wú yī","abbr":"qswy","explanation":"缺少吃的和穿的。形容饥寒交迫的生活。","source":{"text":"先主在独树楼桑受困危，织履编席，缺食无衣，到处寻觅，挽菜挑虀。","book":"明·无名氏《贫富兴衰》第一折"},"example":{"text":"～的日子真难过"},"similar":["缺衣少食"],"opposite":["丰衣足食"],"usage":"作谓语、定语；指贫困"},{"id":36672,"word":"罄其所有","pinyin":"qìng qí suǒ yǒu","abbr":"qqsy","explanation":"罄：尽，完。比喻把所有的东西全部拿出来。","source":{"text":"陛下不闻乎？博者输钱欲尽，乃磬所有出之，谓之孤注。","book":"《宋史·寇准传》"}},{"id":36673,"word":"罄山采木","pinyin":"qìng shān cǎi mù","abbr":"qscm","explanation":"罄：完，尽。把山上的树木全部采光。比喻残酷剥削。","source":{"text":"若使罄山采木，竭泽求渔，则地官之教化不行，国本之伤残益甚，取怨黔首，是黩皇风。","book":"《旧五代史·唐书·张延朗传》"},"usage":"作宾语、定语；用于处事"},{"id":36674,"word":"罄竹难书","pinyin":"qìng zhú nán shū","abbr":"qzns","explanation":"罄：尽，完；竹：古时用来写字的竹简。形容事实多得写不完。","source":{"text":"磬南山之竹，书罪未穷；决东海之波，流恶难尽。","book":"《旧唐书·李密传》"},"example":{"text":"沦陷区的同胞在抗战中所表现的奇迹，真是所谓～。","book":"邹韬奋《抗战以来》"},"similar":["罪大恶极","数不胜数"],"opposite":["微乎其微"],"usage":"作谓语、宾语、定语；用于事情等","story":["隋朝末年，隋炀帝杨广残暴统治，荒淫无道，大兴土木，造成民不聊生，迫使农民揭竿而起，越国公杨玄的手下李密参加瓦岗起义军，取得了领导权，他在讨伐杨广的檄文中称：“即使用尽南山所有竹子制成的竹简也写不完杨广的罪过。”"]},{"id":36675,"word":"罄竹难穷","pinyin":"qìng zhú nán qióng","abbr":"qznq","explanation":"罄：尽，完；竹：竹子。砍完所有的竹子做成书简也难以写完。形容事情多得写不完。","source":{"text":"盖暴其罪状，罄竹难穷。","book":"《三元里人民抗英斗争史料》"},"similar":["罄竹难书"],"usage":"作谓语、宾语、定语；用于事情"},{"id":36676,"word":"罄笔难书","pinyin":"qìng bǐ nán shū","abbr":"qbns","explanation":"罄：尽，完。砍完所有的竹子做成书简也难以写完。形容事情多得写不完。","source":{"text":"他们分发到战区以后，所经历的各种艰难困苦，那真是罄笔难书。","book":"郭沫若《洪波曲》第八章"},"similar":["罄竹难书","罄竹难穷"],"usage":"作谓语、宾语、定语；用于事情"},{"id":36677,"word":"网之一目","pinyin":"wǎng zhī yī mù","abbr":"wzym","explanation":"目：孔、眼儿。网和一个眼。比喻离开整体，孤立的一个不起作用。","source":{"text":"有鸟将来，张罗而待之，得鸟者，罗之一目也。今为一目之罗，则无时得鸟矣。","book":"《淮南子·说山训》"},"example":{"text":"得鸟者～，不可以一目为网；治国者功在一人，不可以一人为国。","book":"《增广文钞·复永嘉某居士书二》"}},{"id":36678,"word":"网开一面","pinyin":"wǎng kāi yī miàn","abbr":"wkym","explanation":"把捕禽的网撤去三面，只留一面。比喻采取宽大态度，给人一条出路。","source":{"text":"汤出，见野张网四面，祝曰：‘自天下四方，皆入吾网。’汤曰：‘嘻，尽之矣！’乃去其三面。","book":"《史记·殷本纪》"},"example":{"text":"插翅难飞，体上天好生之德，～，谕令尔等速速投降，免遭杀戮。","book":"姚雪垠《李自成》第一卷第十二章"},"similar":["宽大为怀","宽宏大量"],"opposite":["小肚鸡肠","心胸狭窄"],"usage":"作谓语、宾语；用于人","story":["商朝初年，商汤外出，见野外有人张四面网网动物，他对天而祷告：“自天下四方，皆入吾网。”商汤笑着说：“可以了。”就命人去掉三面网，说：“想左就左，想右就右，一切都入网。”诸侯们听说后称赞商汤德行很高能自动网罗一切"]},{"id":36679,"word":"网开三面","pinyin":"wǎng kāi sān miàn","abbr":"wksm","explanation":"把捕禽的网撤去三面。比喻采取宽大态度，给人一条出路。","source":{"text":"汤出，见野张网四面，祝曰：‘自天下四方，皆入吾网。’汤曰：‘嘻，尽之矣！’乃去其三面。","book":"《史记·殷本纪》"},"example":{"text":"再说当年，如邓芝龙、郭婆等，带这班大盗，闹得那翻江倒海，尚且～。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["网开一面"],"usage":"作谓语、宾语；用于人","story":["商朝初年，商汤外出，见野外有人张四面网网动物，他对天而祷告：“自天下四方，皆入吾网。”商汤笑着说：“可以了。”就命人去掉三面网，说：“想左就左，想右就右，一切都入网。”诸侯们听说后称赞商汤德行很高能自动网罗一切"]},{"id":36680,"word":"网漏吞舟","pinyin":"wǎng lòu tūn zhōu","abbr":"wltz","explanation":"网：渔网，比喻法网；吞舟：吞舟的大鱼，比喻大奸。网里漏掉吞舟大鱼。比喻法律太宽，使重大的罪犯也能漏网。","source":{"text":"网漏于吞舟之鱼，而吏治烝烝，不至于奸，黎民艾安。","book":"西汉·司马迁《史记·酷吏列传序》"},"example":{"text":"今外则～，内则桃僵李代。","book":"明·刘若愚《自序》"},"usage":"作宾语、定语；指法律等"},{"id":36681,"word":"网漏吞舟之鱼","pinyin":"wǎng lòu tūn zhōu zhī yú","abbr":"wltzzy","explanation":"网：渔网，比喻法网；吞舟：吞舟的大鱼，比喻大奸。网里漏掉吞舟大鱼。比喻法律太宽，使重大的罪犯也能漏网。","source":{"text":"网漏于吞舟之鱼，而吏治烝烝，不至于奸，黎民艾安。","book":"《史记·酷吏列传序》"},"example":{"text":"夫明哲之君，～，然后三光明于上，人物悦于下。","book":"《后汉书·王畅传》"}},{"id":36682,"word":"网目不疏","pinyin":"wǎng mù bù shū","abbr":"wmbs","explanation":"网目：指法网；疏：疏漏。比喻法令法规细致周密。","source":{"text":"文帝问曰：‘卿何不谨于文宪？’桢答曰：‘臣诚庸短，亦由陛下网目不疏。’","book":"南朝·宋·刘义庆《世说新语·言语》"}},{"id":36683,"word":"罔上虐下","pinyin":"wǎng shàng nüè xià","abbr":"wsnx","explanation":"罔：欺骗；虐：侵害。指瞒上欺下。","source":{"text":"此贪利之徒，罔上虐下，为害甚大。","book":"明·宋濂《元史·耶律楚材传》"},"similar":["瞒上欺下"],"usage":"作谓语、宾语、定语；指欺骗","story":["元朝时期，忠君爱民的大臣野律楚材深受皇帝的器重，他反对由官府核计征税额，招商人抵押承包的征税方法，他认为出价越高的人对百姓盘剥的就越多，因为他们罔上虐下才会有利可图。但皇帝认为制度由来已久不能更改"]},{"id":36684,"word":"罔所顾忌","pinyin":"wǎng suǒ gù jì","abbr":"wsgj","explanation":"罔：无，没有；顾：顾虑；忌：忌惮。没有什么顾虑、畏惧。","source":{"text":"自迩以来，凌纵滋甚，悖言怼容，罔所顾忌，险谋潜计，睥睨两宫。","book":"《宋书·刘湛传》"}},{"id":36685,"word":"罔有孑遗","pinyin":"wǎng yǒu jié yí","abbr":"wyjy","explanation":"汉·陈琳《檄吴将校部曲文》：“然皆伏鈇婴钺，首腰分离，云散原燎，罔有孑遗。”","source":{"text":"方是时，以数州之地盗名字者不可胜数，既覆其族，延及于无辜之民，～。 ★明·张岱《钱王祠》"}},{"id":36686,"word":"罔极之哀","pinyin":"wǎng jí zhī āi","abbr":"wjza","explanation":"罔：无，没有；极：尽头；哀：悲哀。哀伤以了极点，没有更悲哀的了。指失去父母的悲哀。","source":{"text":"远慕《鹿鸣》君臣之宴，中咏《棠棣》匪他之诫，下思《伐木》友生之义，终怀《蓼莪》罔极之哀。","book":"三国·魏·曹植《求通亲亲表》"},"example":{"text":"少遭～，未受过庭之训。","book":"唐·陈子昂《唐故袁州参军李府君妻清河张氏墓志铭》"}},{"id":36687,"word":"罔极之恩","pinyin":"wǎng jí zhī ēn","abbr":"wjze","explanation":"罔：无，没有；极：尽头。旧时用以颂扬父母养育子女的无穷无尽的恩德。","source":{"text":"缅维罔极之恩，思崇永锡之道","book":"《诗经·小雅·蓼莪》：“父兮生我，母兮鞠我。拊我畜我，长我育我，顾我复我，出入腹我。欲报之德，昊天罔极！”唐·陈子昂《唐故朝议大夫梓州长史杨府君碑》"},"example":{"text":"是故孝子之服勤其亲也，～，至于当大事，夫亦何所吝。","book":"清·全祖望《记李烈妇素》"}},{"id":36688,"word":"罔水行舟","pinyin":"wǎng shuǐ xíng zhōu","abbr":"wsxz","explanation":"罔水：无水。没有水而在陆地上行船。比喻行为违背常理。","source":{"text":"罔昼夜頟頟，罔水行舟。朋淫于家，用殄厥世。","book":"《尚书·益稷》"},"example":{"text":"河、汴自寇难以来，不复穿治，崩岸灭木，所在廞淤，涉泗千里，如～。","book":"《新唐书·刘晏传》"},"similar":["推舟于陆"],"usage":"作谓语、宾语、定语；用于比喻句"},{"id":36689,"word":"罔知所措","pinyin":"wǎng zhī suǒ cuò","abbr":"wzsc","explanation":"面临窘危，茫然无所适从。形容不知道该怎么办才好。","source":{"text":"生惶惑发狂，罔知所措。","book":"唐·白行简《李娃传》"},"example":{"text":"四方混杀，人人束手，个个归心。定安国舅气的目睁口呆，～。与众等侍郎束手被擒。","book":"明·施耐庵《水浒传》第八十五回"},"similar":["不知所措"],"usage":"作谓语、定语、状语；指不知怎么办"},{"id":36690,"word":"罕言寡语","pinyin":"hǎn yán guǎ yǔ","abbr":"hygy","explanation":"罕、寡：少。很少开口说话。形容沉默寡言。","source":{"text":"罕言寡语，人谓装愚；安分随时，自云守拙。","book":"清·曹雪芹《红楼梦》第八回"},"example":{"text":"他就是～的性格。"},"similar":["沉默寡言"],"usage":"作谓语、定语；形容人沉默寡言"},{"id":36691,"word":"罕譬而喻","pinyin":"hǎn pì ér yù","abbr":"hpey","explanation":"说话用不着多比方，都能听懂。形容话说得非常明白。","source":{"text":"其言也约而达，微而臧，罕譬而喻。","book":"《礼记·学记》"},"similar":["言简意赅"],"usage":"作谓语、状语；指文辞精练"},{"id":36692,"word":"罕闻寡见","pinyin":"hǎn wán guǎ jiàn","abbr":"hwgj","explanation":"罕、寡：少。见识不广，知识有限。"},{"id":36693,"word":"罗之一目","pinyin":"luó zhī yī mù","abbr":"lzym","explanation":"网之一孔。比喻局部在整体中才能起其作用；脱离了整体，局部便不起作用。","source":{"text":"有鸟将来，张罗而待之，得鸟者罗之一目也。今非昔比为一目之罗，则无时得鸟矣。","book":"《淮南子·说山训》"},"example":{"text":"一目之罗，不能得鸟，得鸟者～耳。","book":"隋·智顗《摩诃止观》卷五"},"usage":"作宾语；用于整体与局部的关系","story":["从前有一个人看到别人布网捕鸟，发现被捕的鸟每只鸟头才钻一个网眼，心想既然如此，何必结网呢？他回家便剪断长绳做成一个个圈圈，别人问他作什么用，他笑而不答并庆幸自己一孔之见，就找了一个没人的地方安好这一洞之网，结果一只鸟儿也没捕上"]},{"id":36694,"word":"罗天大醮","pinyin":"luó tiān dà jiào","abbr":"ltdj","explanation":"醮：一种祷神的祭礼。本指道教的一种隆重的祭天神的仪式。后泛指各种消灾求福的善举。","source":{"text":"其下曰祈谷福时坛，凡星位一千二百，为罗天大醮，法物仪范，降中坛一等。","book":"宋·张君房《云笈七签》卷一百三"},"example":{"text":"主人可怜见众人，留了这条性命回乡去，强似做～。","book":"明·施耐庵《水浒全传》第六十一回"}},{"id":36695,"word":"罗掘一空","pinyin":"luó jué yī kōng","abbr":"ljyk","explanation":"罗：用网捕鸟；掘：指挖掘老鼠洞找粮食。用尽一切办法，搜括财物殚尽。","source":{"text":"是时宁城已罗掘一空，急切不得巨款，没奈何任他所为。","book":"蔡东藩、许廑父《民国通俗演义》第三十回"},"usage":"作谓语；指贪婪"},{"id":36696,"word":"罗掘俱穷","pinyin":"luó jué jù qióng","abbr":"ljjq","explanation":"罗雀掘鼠，而雀鼠已近；比喻无法筹到款项。","example":{"text":"公司的财务危机已到～的地步，他却仍不轻言放弃。"}},{"id":36697,"word":"罗敷有夫","pinyin":"luó fū yǒu fū","abbr":"lfyf","explanation":"旧指女子已有丈夫。","source":{"text":"使君自有妇，罗敷自有夫。","book":"汉·无名氏《陌上桑》诗"},"example":{"text":"鸳鸯梦好两欢娱，记否罗敷自有夫。","book":"清·纪昀《阅微草堂笔记》卷三"},"usage":"作宾语、定语；用于书面语"},{"id":36698,"word":"罗曼蒂克","pinyin":"luó màn dì kè","abbr":"lmdk","explanation":"浪漫，具有强烈的个人感情、高度的个人爱慕之情。","source":{"text":"他，农民孙玉厚的儿子，一个漂泊的揽工汉，岂敢一味地沉醉在一种罗曼蒂克的情调中？","book":"路遥《平凡的世界》第四卷第53章"},"example":{"text":"她很喜欢～的男人。"},"similar":["天真烂漫"],"usage":"作谓语、定语；指人很浪漫"},{"id":36699,"word":"罗织构陷","pinyin":"luò zhī gòu xiàn","abbr":"lzgx","explanation":"罗织：收集编造；构陷：用虚构的罪名去陷诬人。形容千方百计地陷害别人。","source":{"text":"王圣等惧有后祸，遂与丰京其构陷太子，太子坐废为济阴王。","book":"《后汉书·顺帝纪》"},"usage":"作谓语、定语、宾语；用于处事"},{"id":36700,"word":"罗织罪名","pinyin":"luó zhī zuì míng","abbr":"lzzm","explanation":"指捏造罪名，陷害无辜的人。","source":{"text":"又造《罗织经》一卷，其意旨皆网罗前人，织成反罪。海内震惊，道路以目。","book":"《唐会要·酷吏》"},"example":{"text":"于是～，捕古土布·阿兰入狱。","book":"张承志《心灵史》第三章"},"similar":["故入人罪"],"usage":"作谓语、宾语、定语；指陷害人"},{"id":36701,"word":"罗缕纪存","pinyin":"luó lǚ jì cún","abbr":"lljc","explanation":"罗缕：详细；纪存：纪录保存。指详细记录并保存。","source":{"text":"悔当时不将嫛堄情状，罗缕纪存。","book":"清·袁枚《祭妹文》"},"usage":"作谓语；指记录事件等"},{"id":36702,"word":"罗钳吉网","pinyin":"luó qián jí wǎng","abbr":"lqjw","explanation":"用以指酷虐诬陷。","source":{"text":"李林甫欲除不附己者，重用酷吏罗希奭、吉温，二人皆随林甫所欲深浅，锻炼成狱，无能自脱者，时人谓之‘罗钳吉网’。","book":"《资治通鉴·唐玄宗天宝四载》"},"example":{"text":"堪伤！那些儿公道天开？端的是～。","book":"明·沈鲸《双珠记·僧榻传音》"},"similar":["吉网罗钳"],"usage":"作宾语、定语；指酷吏","story":["唐玄宗时期，酷吏吉温与罗希奭善于拍马奉承，得到右丞相李林甫的赏识，让他们掌管刑狱，他们两人办案均根据李林甫的旨意行事，搞“欲加之罪，何患无辞”，帮助李林甫排斥与打击异己，落入他们手中如同被钳夹住或落入网中一样"]},{"id":36703,"word":"罗雀掘鼠","pinyin":"luó què jué shǔ","abbr":"lqjs","explanation":"原指张网捉麻雀、挖洞捉老鼠来充饥的窘困情况，后比喻想尽办法筹措财物。","source":{"text":"至罗雀掘鼠，煮铠弩以食。","book":"《新唐书·张巡传》"},"example":{"text":"快饿死者，～，粮食罄尽，转为沟瘠是也。","book":"严复《有如三保》"},"usage":"作谓语；比喻想尽办法筹措财物","story":["唐玄宗时期爆发了安史之乱。757年，安禄山的儿子安庆绪派手下大将尹子奇围攻睢阳城。睢阳城守将张巡誓死抵抗，在南霁云搬不到救兵及城里粮食断绝的情况下，他们张网捉鸟雀吃，挖掘老鼠洞寻找残粮，艰苦抵抗守城达3个多月"]},{"id":36704,"word":"罚一劝百","pinyin":"fá yī quàn bǎi","abbr":"fyqb","explanation":"处罚一个人以惩戒众人。","source":{"text":"牡如晦问政，子曰：‘赏一以劝百，罚一以惩众。’","book":"唐·韩愈《谁氏子》：“罚一劝百政之经，不从而诛不晚耳。”李汉注引《中说》"},"example":{"text":"臣知已事不诤，然异时或有此比，要须有司论报，～，孰不甘心。","book":"宋·欧阳修《新唐书》"},"similar":["杀一儆百"],"usage":"作宾语、定语；指杀一儆百"},{"id":36705,"word":"罚不及众","pinyin":"fá bù jí zhòng","abbr":"fbjz","explanation":"罚：惩罚；及：到达；众：大众。指处罚只对小部分人，不会处罚大众。","example":{"text":"人们都知道～，因此出现现今的局面。"},"similar":["法不责众"],"usage":"作宾语、定语；用于处事"},{"id":36706,"word":"罚不及嗣","pinyin":"fá bù jí sì","abbr":"fbjs","explanation":"罚：惩罚；及：连累；嗣：后世，子孙。惩罚有罪的人，不株连他的子孙。","source":{"text":"临下以简，御众以宽，罚弗及嗣，赏廷于世。","book":"《尚书·大禹漠》"},"similar":["罚弗及嗣"],"usage":"作宾语、定语；用于处罚等"},{"id":36707,"word":"罚不当罪","pinyin":"fá bù dāng zuì","abbr":"fbdz","explanation":"当：相当，抵挡。处罚和罪行不相当。","source":{"text":"夫德不称位，能不称官，赏不当功，罚不当罪不祥莫大焉。","book":"《荀子·正论》"},"example":{"text":"谁个惩办要严，谁个处罚从轻，农民都有极明白的计算，～的极少。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["罪大恶极","罪不容诛"],"opposite":["赏罚分明","罚当其罪"],"usage":"作谓语、宾语；指处罚和所犯罪行不相称","story":["战国时期赵国思想家荀况在他的作品《荀子》中强调刑罚必须严明，犯罪的应根据罪行大小给予相应的处罚。如果杀人的不偿命，伤人的不判刑，那就会纵容犯罪，扰乱社会，因为犯罪的人得不到应有的惩罚，犯罪行为不会停止"]},{"id":36708,"word":"罚不责众","pinyin":"fá bù zé zhòng","abbr":"fbzz","explanation":"罚：惩罚；责：责罚；众：多数人。指某种行为即使应片惩罚，但很多人都那样干，也就不好采取惩罚的办法去处理了。","source":{"text":"况罚不责众，如果主意都不承旨，谅那世主亦难遽将群芳尽废。","book":"清·李汝珍《镜花缘》第四回"},"similar":["法不责众"],"usage":"作宾语、定语；用于口语"},{"id":36709,"word":"罚弗及嗣","pinyin":"fá fú jí sì","abbr":"ffjs","explanation":"罚：惩罚；弗及：不连累；嗣：后世，子孙。惩罚有罪的人，不株连他的子孙。","source":{"text":"临下以简，御众以宽，罚弗及嗣，赏廷于世。","book":"《尚书·大禹漠》"},"similar":["罚不及嗣"],"usage":"作宾语、定语；用于处罚等"},{"id":36710,"word":"罚当其罪","pinyin":"fá dāng qí zuì","abbr":"fdqz","explanation":"罚：处罚，惩罚。所作处罚和所犯罪行相当。","source":{"text":"赏当其劳，无功者自退；罚当其罪，为恶者戒惧。","book":"唐·王方庆《魏郑公谏录·对百官应有堪用者》"},"opposite":["罚不当罪"],"usage":"作谓语、宾语；指处罚和所犯罪行相称"},{"id":36711,"word":"罚薄不慈","pinyin":"fá bó bù cí","abbr":"fbbc","explanation":"薄：轻；慈：仁慈。刑罚轻并不算仁慈。指刑罚轻重宽严要根据实情决定，不能一概从轻从宽。","source":{"text":"故罚薄不为慈，诛严不为厉戾，称俗而行也。","book":"《韩非子·五蠹》"}},{"id":36712,"word":"罢于奔命","pinyin":"pí yú bēn mìng","abbr":"bybm","explanation":"罢：通“疲”，疲乏；奔命：奉命奔走。指忙于奔走应付，弄得非常疲乏。","source":{"text":"余必使尔罢于奔命以死。","book":"春秋·鲁·左丘明《左传·成公七年》"},"example":{"text":"四百余州，腥膻遍地，汉民～。","book":"汤增璧《崇侠篇》"},"similar":["疲于奔命"],"usage":"作谓语、定语；指非常疲乏"},{"id":36713,"word":"罢战息兵","pinyin":"bà zhàn xī bīng","abbr":"bzxb","explanation":"停止或结束战争。","source":{"text":"宋朝南渡以后，绍兴、淳熙年间息兵罢战，君相自谓太平，纵情佚乐，士大夫赏玩湖山，无复恢复中原之志。","book":"明·冯梦龙《喻世明言》卷二十二"},"example":{"text":"也亏他这等迅雷猛雨的时候，还两下里鸣金擂鼓大杀了一场，方才～。","book":"清·西周生《醒世姻缘传》第二十九回"}},{"id":36714,"word":"罢马不畏鞭箠","pinyin":"pí mǎ bù wèi biān chuí","abbr":"bmbwbc","explanation":"罢：同“疲”；箠：鞭子，这里指鞭打。非常疲乏的马，就是用鞭子抽打也不会走动。比喻极端穷困的人并不害怕严厉的法律和刑罚。","source":{"text":"罢马不畏鞭箠，罢民不畏刑法。","book":"汉·桓宽《盐铁论·诏圣》"}},{"id":36715,"word":"罢黜百家","pinyin":"bā chù bǎi jiā","abbr":"bcbj","explanation":"罢黜：废弃不用。原指排除诸子杂说，专门推行儒家学说。也比喻只要一种形式，不要其他形式。","source":{"text":"孝武初立，卓然罢黜百家，表章《六经》。","book":"《汉书·武帝纪赞》"},"example":{"text":"……只认朗诵词和诗。笔者却不能够赞成这“～”的作风","book":"朱自清《论朗诵诗》"},"opposite":["百家争鸣"],"usage":"作谓语、定语；指只要一种方式"},{"id":36716,"word":"罪上加罪","pinyin":"zuì shàng jiā zuì","abbr":"zsjz","explanation":"指罪恶更为严重。","source":{"text":"丢掉官是小事，他老人家一定要气死的，岂不是罪上加罪。","book":"清·李宝嘉《官场现形记》第16回"},"example":{"text":"战争贩子拒不认罪就是～。"},"similar":["罪加一等"],"usage":"作谓语、宾语、定语；指罪恶更为严重"},{"id":36717,"word":"罪不及孥","pinyin":"zuì bù jí nú","abbr":"zbjn","explanation":"孥：妻子与儿女的统称。治罪止于本人，不累及妻和子女","source":{"text":"虽然罪不及孥，只是我死之后，无路可投。","book":"明·凌濛初《初刻拍案惊奇》第20卷"},"similar":["罪人不孥"],"usage":"作宾语、定语；用于处事"},{"id":36718,"word":"罪不可逭","pinyin":"zuì bù kě huàn","abbr":"zbkh","explanation":"罪责不可逃避。","source":{"text":"某等不能速来归顺，罪不可逭。","book":"明·施耐庵《水浒全传》第九十七回"},"example":{"text":"高阳《胡雪岩全传·红顶商人》：“眼下饷绝援穷，危在旦夕，辜负圣恩，～。”"},"similar":["罪不可赦"],"usage":"作谓语、定语；用于书面语"},{"id":36719,"word":"罪不容死","pinyin":"zuì bù róng sǐ","abbr":"zbrs","explanation":"罪恶极大，处死也抵不了所犯的罪恶","source":{"text":"此所谓率土地而食人肉，罪不容于死。","book":"战国·邹·孟轲《孟子·离娄》"},"example":{"text":"《平鬼传》第一回：“倘有恶贯满盈，～的，生擒前来，再以阴间刑法治之。”"},"similar":["罪不容诛","罪不胜诛"],"usage":"作谓语、宾语；指罪恶极大"},{"id":36720,"word":"罪不容诛","pinyin":"zuì bù róng zhū","abbr":"zbrz","explanation":"诛：把罪人杀死。罪恶极大，杀了也抵不了所犯的罪恶。","source":{"text":"况于郭解之伦，以匹夫之细，窃杀生之权，其罪已不容诛矣。","book":"《汉书·游侠传序》"},"example":{"text":"这厮若论着五刑发落，可便～。","book":"元·秦简夫《东堂老》第三折"},"similar":["罪大恶极","罪该万死","十恶不赦"],"opposite":["大慈大悲"],"usage":"作谓语、宾语；指罪恶极大","story":["西汉时期，河内人郭解成为无恶不作的地方一霸，他非常狡猾，敢于请人出面抗拒皇上的命令。汉武帝对此十分不满，下令把他逮捕归案，办案的官员纷纷维护他。御史大夫公孙弘认为他罪不容诛，理应处死，终于汉武帝把他满门操斩"]},{"id":36721,"word":"罪不胜诛","pinyin":"zuì bù shèng zhū","abbr":"zbsz","explanation":"指罪大恶极，处死犹不足抵偿。","source":{"text":"以上见各家记述中者，什仅得一二。修史之卤莽，罪不胜诛矣。","book":"明·沈德符《野获编·词林·鼎甲常为庶常》"},"similar":["罪不容诛","罪不容死"],"usage":"作谓语、宾语；指罪恶极大"},{"id":36722,"word":"罪业深重","pinyin":"zuì yè shēn zhòng","abbr":"zysz","explanation":"指做了很大的坏事，犯了很大的罪。","source":{"text":"某罪逆深重，不自死灭。","book":"宋·欧阳修《与十四弟书》"},"example":{"text":"如此作贱，真是～。","book":"明·凌濛初《二刻拍案惊奇》卷一"},"similar":["罪逆深重","罪恶深重","罪孽深重"],"usage":"作谓语、定语；用于书面语"},{"id":36723,"word":"罪人不孥","pinyin":"zuì rén bù nú","abbr":"zrbn","explanation":"孥：妻与子女的统称。谓治罪止于本人，不累及妻和子女。","source":{"text":"泽梁无禁，罪人不孥。","book":"《孟子·梁惠王》"},"example":{"text":"臣闻先王之政，敬老慈幼，～，鳏寡孤独，时时矜恤。","book":"清·禇人获《隋唐演义》第十五回"},"similar":["罪不及孥"],"opposite":["株连九族"],"usage":"作宾语、定语；用于处事"},{"id":36724,"word":"罪以功除","pinyin":"zuì yǐ gōng chú","abbr":"zygc","explanation":"所犯的罪行可以用功劳来抵除。指将功折罪","source":{"text":"臣闻《春秋》之义，罪以功除；圣王之祀，臣有五义。","book":"南朝·宋·范晔《后汉书·马援传》"},"similar":["将功折罪"],"usage":"作宾语、定语；用于处事"},{"id":36725,"word":"罪加一等","pinyin":"zuì jiā yī děng","abbr":"zjyd","explanation":"指对罪犯加重处罚。","source":{"text":"你为着吃烟，这才犯法，我们来拿你，倒来吃你的烟，本官知道，办起来罪加一等。","book":"清·彭养鸥《黑籍冤魂》第五回"},"example":{"text":"旗人当汉奸，～。","book":"老舍《茶馆·第一幕》"},"similar":["罪上加罪"],"usage":"作谓语、宾语；指加重处罚"},{"id":36726,"word":"罪合万死","pinyin":"zuì hé wàn sǐ","abbr":"zhws","explanation":"万死：死一万次。形容罪恶极大","source":{"text":"臣既小人，备荷驱使，缘百口在南，致拒皇略，罪合万死。","book":"《魏书·房法寿传》"},"similar":["罪该万死"],"usage":"作谓语、定语；指罪恶极大"},{"id":36727,"word":"罪在不赦","pinyin":"zuì zài bù shè","abbr":"zzbs","explanation":"赦：赦免。指罪行极重，不能得到赦免","source":{"text":"论之科刑，罪在不赦。","book":"萧纲《答张灒谢示集书》"},"example":{"text":"清·黄宗羲《蒋氏三世传》：“直～。”"},"usage":"作谓语、定语；用于书面语"},{"id":36728,"word":"罪大弥天","pinyin":"zuì dà mí tiān","abbr":"zdmt","explanation":"弥天：满天。形容极大的罪恶。","source":{"text":"虞臣计有弥天罪，今将草命献王前。","book":"《敦煌变文集·李陵变文》"},"example":{"text":"从来～，不是牵犁拽耙，便是鼎镬油煎。","book":"宋·释晓莹《罗湖野录·湖州何山辩禅师》"}},{"id":36729,"word":"罪大恶极","pinyin":"zuì dà è jí","abbr":"zdej","explanation":"罪恶大到了极点。","source":{"text":"矧如（秦）桧者，密奉虏谋，胁君误国，罪大恶极 ，岂可赦乎。","book":"宋·欧阳修《纵囚论》：“刑入于死者，乃罪大恶极。”宋·罗大经《鹤林玉露》卷五"},"example":{"text":"倘不如命地“帮忙”，当然，～了。先将忘恩负义之罪，布告于天下。","book":"鲁迅《而已集·新时代的放债法》"},"similar":["罪贯满盈","罪恶昭著","十恶不赦"],"opposite":["功德无量","功盖天地"],"usage":"作谓语、定语；指人的罪大"},{"id":36730,"word":"罪孽深重","pinyin":"zuì niè shēn zhòng","abbr":"znsz","explanation":"孽：罪恶。指做了很大的坏事，犯了很大的罪。","source":{"text":"罪孽深重，死无归所。","book":"清·蒲松龄《聊斋志异·鲁公女》"},"example":{"text":"这个汉奸自知～，难逃惩处，而自尽身亡。"},"similar":["罪不容诛","罪大恶极","罪恶滔天"],"usage":"作谓语、宾语；指罪恶深重"},{"id":36731,"word":"罪己责躬","pinyin":"zuì jǐ zé gōng","abbr":"zjzg","explanation":"罪己：归罪于己；躬：自己。责备并归罪于自己","source":{"text":"罪己责躬不可无，然亦不当长留在心胸为悔。","book":"宋·朱熹《朱子语类》第29卷"},"usage":"作谓语、定语；用于处事"},{"id":36732,"word":"罪应万死","pinyin":"zuì yīng wàn sǐ","abbr":"zyws","explanation":"形容罪恶极大。","source":{"text":"弟冲不识义方，孤背国恩，臣罪应万死。","book":"《晋书·苻坚载记下》"},"example":{"text":"法北望陵庙，无涕可挥。身蹈大戮，～。所以不即从先帝者，实惟社稷之故。","book":"明·史可法《复多尔衮书》"},"similar":["罪当万死","罪该万死"],"usage":"作谓语、定语；指罪恶极大"},{"id":36733,"word":"罪当万死","pinyin":"zuì dāng wàn sǐ","abbr":"zdws","explanation":"形容罪恶极大。","source":{"text":"粪土愚臣，忘生触死，逆盛意，犯隆指，罪当万死。","book":"《汉书·东方朔传》"},"example":{"text":"臣既犯天宪，～。臣死之日，必见叔陵，愿宣明诏，责之于九泉之下。","book":"宋·司马光《资治通鉴》卷第一百七十五"},"similar":["罪该万死","罪大恶极","罪应万死"],"opposite":["劳苦功高"],"usage":"作谓语、定语；指罪恶极大"},{"id":36734,"word":"罪恶如山","pinyin":"zuì è rú shān","abbr":"zers","explanation":"形容罪恶多而重。","source":{"text":"俊臣诬杀忠良，罪恶如山，国蟊贼也，尚何惜。","book":"《新唐书·吉顼传》"},"example":{"text":"明·冯梦龙《喻世明言》第40卷：“只为严嵩父子恃宠贪虐，～，引出一个忠臣来，……留下一段轰轰烈烈的话柄。”"},"usage":"作谓语、定语；用于书面语"},{"id":36735,"word":"罪恶昭彰","pinyin":"zuì è zhāo zhāng","abbr":"zezz","explanation":"昭彰：明显。罪恶非常明显，人所共见。","source":{"text":"虽纵欲以害民，怙势而贪利，罪恶昭著，无从上达。","book":"宋·赵善括《严赏罚奏议》"},"example":{"text":"日本战犯东条英机等人～，死有余辜。"},"similar":["罪恶昭著"],"usage":"作谓语、定语；指人的罪很明显"},{"id":36736,"word":"罪恶昭著","pinyin":"zuì è zhāo zhù","abbr":"zezz","explanation":"昭著：明显。罪恶十分明显，人所共知。","source":{"text":"虽纵欲以害民，怙势而贪利，罪恶昭著，无从上达。","book":"宋·赵善括《严赏罚奏议》"},"example":{"text":"土豪劣绅中～的，农民不是要驱逐，而是要捉他们，或杀他们。","book":"毛泽东《湖南农民运动考察报告》"},"similar":["罪大恶极","罪恶昭彰"],"usage":"作谓语、定语；指罪恶非常明显"},{"id":36737,"word":"罪恶深重","pinyin":"zuì è shēn zhòng","abbr":"zesz","explanation":"指做了很大的坏事，犯了很大的罪。","source":{"text":"某罪逆深重，不自死灭。","book":"宋·欧阳修《与十四弟书》"},"example":{"text":"上以其～，非他盗比，磔于西市。","book":"明·朱国桢《涌幢小品·流贼》"},"similar":["罪逆深重","罪业深重","罪孽深重"],"usage":"作谓语、定语；用于书面语"},{"id":36738,"word":"罪恶滔天","pinyin":"zuì è tāo tiān","abbr":"zett","explanation":"滔天：漫天，弥天。形容罪恶极大。","source":{"text":"今开庆误国之人，罪恶滔天。","book":"宋·周密《齐东野语》卷十七"},"example":{"text":"若是高俅在内，必然阻住，此贼累辱朝廷，～。","book":"明·施耐庵《水浒全传》第七十五回"},"similar":["罪大恶极","罪恶迷天"],"usage":"作谓语、定语；指罪恶极大"},{"id":36739,"word":"罪恶贯盈","pinyin":"zuì è guàn yíng","abbr":"zegy","explanation":"犹言恶贯满盈。","source":{"text":"李义府作相。罪恶贯盈。","book":"语出《书·泰誓上》：“商罪贯盈，天命诛之。”宋·孔平仲《续世说·黜免》"},"example":{"text":"昔日公说布使杀丁建阳而投董卓；今卓上欺天子，下虐生灵，～，人神共愤。","book":"明·罗贯中《三国演义》第九回"},"similar":["恶贯满盈"],"usage":"作谓语、定语；形容人很坏"},{"id":36740,"word":"罪恶迷天","pinyin":"zuì è mí tiān","abbr":"zemt","explanation":"迷：迷漫。形容罪恶极大","source":{"text":"文面小吏，罪恶迷天，曲辱贵人到此，接待不及，望乞恕罪。","book":"明·施耐庵《水浒传》第75回"},"similar":["罪恶滔天","迷天大罪"],"usage":"作谓语、定语；指罪恶极大"},{"id":36741,"word":"罪有应得","pinyin":"zuì yǒu yīng dé","abbr":"zyyd","explanation":"应：应该。按罪恶或错误的性质，理应得到这样的惩罚。","source":{"text":"今日卑职故违大人禁令，自知罪有应得。","book":"清·李宝嘉《官场现形记》第二十回"},"example":{"text":"这个人以权谋私，贪污公款，受到法律的制裁，真是～。"},"similar":["咎由自取","自食其果","自讨苦吃"],"opposite":["罚不当罪"],"usage":"作谓语、宾语；指应该受惩罚"},{"id":36742,"word":"罪有攸归","pinyin":"zuì yǒu yōu guī","abbr":"zyyg","explanation":"攸：所。罪责有所归属。指罪犯必受惩治。","source":{"text":"赐尔姬昌等节钺，便宜行事，往惩其忤，毋得宽纵，罪有攸归。","book":"明·陈仲琳《封神演义》第二回"},"example":{"text":"清平之世，何出此逛诞之言？请敕下山西巡抚方辂查奏。如果臣言不谬，自应～。","book":"清·李百川《绿野仙踪》第三回"},"usage":"作宾语、定语；用于书面语"},{"id":36743,"word":"罪疑从轻","pinyin":"zuì yí cóng qīng","abbr":"zycq","explanation":"疑：不能确定。罪行轻重有可疑之处，只应从轻判处","source":{"text":"其决疑平法，务在哀鳏寡，罪疑从轻，加审慎之心。","book":"东汉·班固《汉书·于定国传》"},"similar":["罪疑惟轻"],"usage":"作宾语、定语；用于处事"},{"id":36744,"word":"罪疑惟轻","pinyin":"zuì yí wéi qīng","abbr":"zywq","explanation":"疑：不能确定；惟：同“唯”，只有。罪行轻重有可疑之处，只应从轻判处","source":{"text":"罪疑惟轻，功疑惟重。","book":"《尚书·大禹谟》"},"example":{"text":"清·黄宗羲《明司马澹若张公传》：“～，则冥途有重返之魄；罚当其咎，则单门无连染之人。”"},"similar":["罪疑从轻"],"usage":"作宾语、定语；用于处事"},{"id":36745,"word":"罪盈恶满","pinyin":"zuì yíng è mǎn","abbr":"zyem","explanation":"盈：充满。罪恶已经到头了。形容罪大恶极","source":{"text":"害命杀牲，造下无边之孽，罪盈恶满，致有地狱之灾。","book":"明·吴承恩《西游记》第98回"},"similar":["恶贯满盈","罪大恶极"],"usage":"作谓语、定语；用于书面语"},{"id":36746,"word":"罪莫大焉","pinyin":"zuì mò dà yān","abbr":"zmdy","explanation":"指罪恶之重无过于此。","source":{"text":"竖牛祸叔孙氏，使乱大从，杀適立庶，又披其色，将以敕罪，罪莫大焉。","book":"《左传·昭公五年》"},"example":{"text":"《晋书·温峤传》：“术辈首乱，～。”"},"similar":["罪大恶极"],"usage":"作谓语、定语；用于书面语"},{"id":36747,"word":"罪该万死","pinyin":"zuì gāi wàn sǐ","abbr":"zgws","explanation":"尤死：处一万次死刑。形容罪恶极大。","source":{"text":"娘娘道此怪物，不可容留，随命侍者领去，弃之沟渎。婢子罪该万死。","book":"明·冯梦龙《东周列国志》第一回"},"example":{"text":"他是一个作恶多端，民愤极大，～的罪犯。"},"similar":["罪大恶极","罪恶滔天","罪恶昭著"],"opposite":["劳苦功高","功德无量","功垂竹帛"],"usage":"作谓语、定语；指罪恶极大"},{"id":36748,"word":"罪责难逃","pinyin":"zuì zé nán táo","abbr":"zznt","explanation":"指不能逃避犯罪所应负的责任，一定要受到惩处。","source":{"text":"若其因循玩愒，隳绩废事，非独自败坏，抑且罪责难逃。","book":"明·王守仁《批右江道移置凤化县南丹卫事宜呈》"},"usage":"作谓语、定语；用于书面语"},{"id":36749,"word":"罪逆深重","pinyin":"zuì nì shēn zhòng","abbr":"znsz","explanation":"指做了很大的坏事，犯了很大的罪。同“罪孽深重”。","source":{"text":"某罪逆深重，不自死灭。","book":"宋·欧阳修《与十四弟书》"},"similar":["罪恶深重","罪业深重","罪孽深重"],"usage":"作谓语、定语；用于书面语"},{"id":36750,"word":"罪魁祸首","pinyin":"zuì kuí huò shǒu","abbr":"zkhs","explanation":"魁：为首的。作恶犯罪的头子。","source":{"text":"虽是虔婆杀我，娟奴是祸首罪魁，追了他去。","book":"明·郑若庸《玉玦记·索命》"},"example":{"text":"这场空难事故的～竟然是一只在机场上空飞翔的鸽子。"},"similar":["元凶巨恶","祸首罪魁"],"usage":"作主语、宾语；指坏头目"},{"id":36751,"word":"置之不理","pinyin":"zhì zhī bù lǐ","abbr":"zzbl","explanation":"之：代词，它；理：理睬。放在一边，不理不睬。","source":{"text":"各人听了，反不以为是，就有说他是嫌钱多的，又有说他是愿贫不愿富的，邓仪卿种种置之不理而已。","book":"清·黄小配《廿载繁华梦》第十六回"},"example":{"text":"老师批评他，他～。"},"similar":["置若罔闻","束之高阁","置之度外"],"opposite":["另眼相看","刮目相看"],"usage":"作谓语、宾语；指不理睬"},{"id":36752,"word":"置之不论","pinyin":"zhì zhī bù lùn","abbr":"zzbl","explanation":"之：代词，它。放在一边，不理不睬。形容毫不关心。","source":{"text":"论古文无师说二十九篇之古方说亦参差不合多不可据古文尚书之名旧矣，今止以今文二十九篇为断，古文置之不论，其说似乎骇俗，不知真古文之亡久矣。","book":"清·皮锡瑞《经学通论》上部"},"example":{"text":"虽说激将，难道～？帝师不必亲临，只须青白炁丸儿，找取首级来便是。（清·吕熊《女仙外史》第九十回）"},"similar":["置之不理","置之不顾","置之不问"],"usage":"作谓语、宾语、定语；指不关心"},{"id":36753,"word":"置之不问","pinyin":"zhì zhī bù wùn","abbr":"zzbw","explanation":"之：代词，它。放在一边，不管不问。形容毫不关心。","source":{"text":"仁杰犹置之不问，复授之张柬之，俟其恶稔而后取。","book":"宋·苏辙《历代论四·狄仁杰》"},"example":{"text":"知湖州苏轼，本无学术，偶中异科，初腾沮毁之论，陛下犹～。（清·毕沅《续资治通鉴》卷七十四）"},"similar":["置之不理","置之不顾","置之弗论"],"usage":"作谓语、宾语、定语；指不关心"},{"id":36754,"word":"置之不顾","pinyin":"zhì zhī bù gù","abbr":"zzbg","explanation":"置：放着；之：代词；顾：照管。放在那儿不管。","source":{"text":"那薛蟠得了宝蟾，如获珍宝，一概都置之不顾。","book":"清·曹雪芹《红楼梦》第80回"},"example":{"text":"所以我的应时的浅薄的文字，也应该～，一任其消灭的。","book":"鲁迅《题记》"},"similar":["不屑一顾","置若罔闻"],"opposite":["三复斯言"],"usage":"作谓语、宾语；指不关心"},{"id":36755,"word":"置之度外","pinyin":"zhì zhī dù wài","abbr":"zzdw","explanation":"度：考虑。放在考虑之外。指不把个人的生死利害等放在心上。","source":{"text":"帝积苦兵间，以嚣子内侍，公孙述远据边陲，乃谓诸将曰：‘且当置此两子于度外耳。’","book":"《后汉书·隗嚣传》"},"example":{"text":"七十老翁，死生早～，由他去吧。","book":"清·曾朴《孽海花》第二十七回"},"similar":["置之不理","置若罔闻","漠然置之"],"opposite":["耿耿于怀","念念不忘"],"usage":"作谓语；指不放在心上","story":["东汉初年，光武帝刘秀建立政权，他搜罗人才，争取民心，先后把刘永、李宪、卢芳、彭宠、张步、董宪等势力给消灭掉，五郡大将军窦融归附他，只剩下西州大将军隗嚣和蜀中公孙述。他对他们不放在心上，因为他们不能阻止他统一中国"]},{"id":36756,"word":"置之弗论","pinyin":"zhì zhī fú lùn","abbr":"zzfl","explanation":"之：代词，它；弗：不。放在一边，不理不睬。形容毫不关心。","source":{"text":"论古文无师说二十九篇之古方说亦参差不合多不可据古文尚书之名旧矣，今止以今文二十九篇为断，古文置之不论，其说似乎骇俗，不知真古文之亡久矣。","book":"清·皮锡瑞《经学通论》上部"},"example":{"text":"鬼神之事，难言之矣，只得姑且～。（鲁迅《朝花夕拾·无常》）"},"similar":["置之不论","置之不理","置之不顾"],"usage":"作谓语、宾语、定语；指不关心"},{"id":36757,"word":"置之死地","pinyin":"zhì zhī sǐ dì","abbr":"zzsd","explanation":"有意使人处于无法生存下去的境地。","source":{"text":"投之亡地然后存，陷之死地然后生。","book":"《孙子·九地》"},"example":{"text":"我和你都要留心，若还寻着此人，定要～。","book":"元·宋子桢《中书耶律公神道缘·悟诈》"},"usage":"作谓语、定语；指害人","story":["西汉时期，刘邦派大将韩信和张耳率军攻打赵国，赵王刘歇和大将陈余率20万大军在井陉口迎战。陈余不听谋士李左车的建议，与韩信硬拼，韩信用计故意置之死地在河边列阵，士兵们背水一战，越战越勇，然后派兵轻取赵军大营，杀死陈余，活捉刘歇"]},{"id":36758,"word":"置之死地而后已","pinyin":"zhì zhī sǐ dì ér hòu yǐ","abbr":"zzsdehy","explanation":"已：结束。把他人害死才算结束。","source":{"text":"天哪！人快要死了，还时时提防他会开小差，难道真要‘置之死地而后已’吗？","book":"《上饶集中营·集中营生活散记》"},"example":{"text":"复以威吓应谓能诬赵、洪则其罪决不至死，且能以巨资相赠，若直供不讳必～。（丁中江《北洋军阀史话》四十八）"},"usage":"作宾语、定语；用于处事"},{"id":36759,"word":"置之死地而后快","pinyin":"zhì zhī sǐ dì ér hòu kuài","abbr":"zzsdehk","explanation":"快：痛快。恨不得把人弄死才痛快。形容心肠狠毒。","source":{"text":"被废之后，喧然未已，更欲置之死地然后为快。","book":"宋·苏舜钦《答韩持国书》"},"example":{"text":"且以朕为难儿，遇事掣肘，故在朝如黄道周之忠纯，何楷之梗直，莫不欲～。（清·浴日生《海国英雄记》卷下）"},"usage":"作宾语、定语、分句；指害人"},{"id":36760,"word":"置之死地而后生","pinyin":"zhì zhī sǐ dì ér hòu shēng","abbr":"zzsdehs","explanation":"原指作战把军队布置在无法退却、只有战死的境地，兵士就会奋勇前进，杀敌取胜。后比喻事先断绝退路，就能下决心，取得成功。","source":{"text":"投之亡地而后存，陷之死地然后生。","book":"《孙子·九地》"},"example":{"text":"若我不先发制人，终必为人所制，～，等死耳，不如速发难。","book":"孙中山《训练革命军人之演讲》"},"similar":["背水一战"],"usage":"作宾语、定语、分句；用于军事或决策","story":["西汉时期，刘邦派大将韩信和张耳率军攻打赵国，赵王刘歇和大将陈余率20万大军在井陉口迎战。陈余不听谋士李左车的建议，与韩信硬拼，韩信故意置之死地而后生在河边列阵，士兵们背水一战，越战越勇，然后派兵轻取赵军大营，杀死陈余，活捉刘歇"]},{"id":36761,"word":"置之脑后","pinyin":"zhì zhī nǎo hòu","abbr":"zznh","explanation":"放在一边不再想起。","source":{"text":"孔黄二人自问无愧，遂亦置之脑后。","book":"清·李宝嘉《文明小史》第六回"},"example":{"text":"你不能把长辈的忠告～。"},"similar":["置身事外","置之不理"],"opposite":["言犹在耳","念念不忘"],"usage":"作谓语；指不放在心上"},{"id":36762,"word":"置之高阁","pinyin":"zhì zhī gāo gé","abbr":"zzgg","explanation":"高阁：储藏器物的高架。捆起来以后放在高高的架子上。比喻放着不用。","source":{"text":"此辈宜束之高阁，俟天下太平，然后议其任耳。","book":"《晋书·庾翼传》"},"example":{"text":"行者在凹里见师父果然做了将军，取经一事，～，心中大乱，无可奈何。","book":"明·董说《西游补》第十五回"},"similar":["束之高阁"],"usage":"作谓语、宾语、定语；指放着不用"},{"id":36763,"word":"置予于怀","pinyin":"zhì yù yú huái","abbr":"zyyh","explanation":"予：给予；怀：心怀。把人或事情放在心中，始终不忘。","source":{"text":"将恐将惧，置予于怀。","book":"《诗经·小雅·谷风》"}},{"id":36764,"word":"置于死地","pinyin":"zhì yú sǐ dì","abbr":"zysd","explanation":"置：安放；死地：无处可走的地方。把对方置于灭亡的境地。比喻彻底击败对方","source":{"text":"投之亡地然后存，陷之死地而后生。","book":"春秋·齐·孙武《孙子·九地篇》"},"usage":"作谓语、定语；用于书面语"},{"id":36765,"word":"置棋不定","pinyin":"zhì qí bù dìng","abbr":"zqbd","explanation":"置：放。指下棋时不知怎样下子才好。比喻遇事犹疑不决","source":{"text":"譬犹奕者，置棋不定，不足以胜敌。","book":"宋·李纲《议责成》"},"similar":["举棋不定"],"opposite":["斩钉截铁"],"usage":"作谓语、宾语、定语；指犹豫不决"},{"id":36766,"word":"置水不漏","pinyin":"zhì shuǐ bù lòu","abbr":"zsbl","explanation":"置：安放。放着的水一滴也不漏掉。形容说话行事缜密，毫无差错","source":{"text":"今有学者在某门者，其于考理，非不精当，说得来置水不漏，真是理会得好。","book":"宋·朱熹《朱子语录》第114卷"},"similar":["滴水不漏"],"usage":"作定语、状语；用于书面语"},{"id":36767,"word":"置水之情","pinyin":"zhì shuǐ zhī qíng","abbr":"zszq","explanation":"表示人民对官吏公正清廉的期望。","source":{"text":"棠不与言，但以薤一大本，水一盂，置户屏前，自抱孙儿伏于户下。主簿白以为倨。参思其微意，良久曰：‘棠是欲晓太守也。水者，欲吾清也。’","book":"南朝·宋·范晔《后汉书·庞参传》"},"example":{"text":"今任棠～，弘郭係待期之信。","book":"南朝·梁·沈约《齐故安陆昭王碑文》"},"similar":["置水之清"],"usage":"作宾语；指人民的期望","story":["汉朝时期，汉阳太守庞参听说本地隐士任棠有才能，想请他出山辅佐。庞参到任棠的门前等候并说明来意，任棠不说话，拿出一筐薤菜及一盆水放到门前，自己抱着孙子埋伏在旁边。庞参的手下以为他在傲慢待客，庞参立刻明白了他的意思"]},{"id":36768,"word":"置水之清","pinyin":"zhì shuǐ zhī qīng","abbr":"zszq","explanation":"表示人民对官吏公正清廉的期望。","source":{"text":"棠不与言，但以薤一大本，水一盂，置户屏前，自抱孙儿伏于户下。主簿白以为倨。参思其微意，良久曰：‘棠是欲晓太守也。水者，欲吾清也。’","book":"《后汉书·庞参传》"},"example":{"text":"～必励，则人知敬，此政之本也。（唐·刘禹锡《答饶州元使君书》）"},"similar":["置水之情"],"usage":"作宾语；指人民的期望"},{"id":36769,"word":"置而不问","pinyin":"zhì ér bù wèn","abbr":"zebw","explanation":"宋·苏轼《汉文帝之行事有可疑者三》：“上林令吏之不材，而虎圈啬夫，才之过人者也，才者遗而不录，不才者而不问，则事之不废坏者有几？”","source":{"text":"上林令吏之不材，而虎圈啬夫，才之过人者也，才者遗而不录，不才者置而不问，则事之不废坏者有几？","book":"宋·苏轼《汉文帝之行事有可疑者三》"},"similar":["置之不理"],"usage":"作谓语、定语；用于处事"},{"id":36770,"word":"置若罔闻","pinyin":"zhì ruò wǎng wén","abbr":"zrww","explanation":"置：放，摆；若：好象；罔：没有。放在一边，好像没有听见似的。指不予理睬。","source":{"text":"当中书言时，沈宜厉声力折，只因心中恼他，置若罔闻。推其微意，谓便做也得。","book":"明·朱国桢《涌幢小品·阁臣相构》"},"example":{"text":"宁荣两府上下内外人等，莫不～，独有宝玉～。","book":"清·曹雪芹《红楼梦》第十六回"},"similar":["置之不理","置之度外","熟视无睹"],"opposite":["如雷灌耳","刮目相看","聚精会神"],"usage":"作谓语、宾语；指不予理睬"},{"id":36771,"word":"置诸度外","pinyin":"zhì zhū dù wài","abbr":"zzdw","explanation":"置：放；度：考虑。放在考虑之外。指不把个人的生死利害等放在心上。","source":{"text":"帝积苦兵间，以嚣子内侍，公孙述远据边陲，乃谓诸将曰：‘且当置此两子于度外耳。’","book":"《后汉书·隗嚣传》"},"example":{"text":"倒是我这个海外孤臣，萍飘梗泛，祖宗邱墓，～，今番听见航公这番话说，不禁感触。（清李宝嘉《文明小史》第四十六回）"},"similar":["置之度外"],"usage":"作谓语；指不放在心上"},{"id":36772,"word":"置诸高阁","pinyin":"zhì zhū gāo gé","abbr":"zzgg","explanation":"捆起来以后放在高高的架子上。比喻放着不用。","source":{"text":"当时兄弟以为这种书干燥无味，太没意趣，所以不甚当心，遂置诸高阁。","book":"廖仲恺《作事必须有恒心》"},"example":{"text":"他早就把此事～了。"},"similar":["置之高阁","束之高阁"],"usage":"作谓语；指不理睬"},{"id":36773,"word":"置身事外","pinyin":"zhì shēn shì wài","abbr":"zssw","explanation":"身：自身。把自己放在事情之外，毫不关心。","source":{"text":"这彭仲翔却在背后袖手旁观，置身事外。","book":"清·李宝嘉《文明小史》第三十五回"},"example":{"text":"悲观的由来，是在～不辩是非，而偏要关心于文坛，或者竟是自己坐在没落的营盘里。","book":"鲁迅《准风月谈·“中国文坛的悲观”》"},"similar":["袖手旁观","事不关己","漠不关心"],"opposite":["责无旁贷","置身其中"],"usage":"作谓语、定语、分句；指不关心"},{"id":36774,"word":"置身其中","pinyin":"zhì shēn qí zhōng","abbr":"zsqz","explanation":"置：放置。把自己放在事情之中。形容对人对事能设身处地的关心、帮助。"},{"id":36775,"word":"置酒高会","pinyin":"zhì jiǔ gāo huì","abbr":"zjgh","explanation":"置：设置。设酒宴办盛会。","source":{"text":"四月，汉皆已入彭城，收其货宝美人，日置酒高会。","book":"《史记·项羽本纪》"},"example":{"text":"御营司都统制范琼将至襄阳，李孝忠闻之，率兵犯荆南府，人其郛，～。（清·毕沅《续资治通鉴》卷九十九）"},"usage":"作谓语、定语；用于书面语"},{"id":36776,"word":"置锥之地","pinyin":"zhì zhuī zhī dì","abbr":"zzzd","explanation":"插锥尖的一点地方。形容极小的一块地方。也指极小的安身之处。","source":{"text":"尧舜有天下，子孙无置锥之地。","book":"《庄子·盗跖》"},"example":{"text":"宋·陈亮《酌古论·桑维翰》：“且昔者汉高帝尝创业矣，倡义草莽，无～。”"},"similar":["立锥之地"],"usage":"作宾语；多用于否定句"},{"id":36777,"word":"羁旅之臣","pinyin":"jī lǚ zhī chén","abbr":"jlzc","explanation":"羁旅：寄居在外。指寄居在外的官员。","source":{"text":"羁旅之臣，幸得免负担。","book":"《左传·庄公二十二年》：“羁旅之臣，幸若获宥。”《史记·陈杞世家》"}},{"id":36778,"word":"羁旅异乡","pinyin":"jī lǚ yì xiāng","abbr":"jlyx","explanation":"羁旅：寄居作客；异乡：他乡。在他乡寄居作客。","source":{"text":"今诸道发兵各二三千人，势力单弱，羁旅异乡，与贼不相谙委，望风慑惧。","book":"《资治通鉴·唐纪》"}},{"id":36779,"word":"羊体嵇心","pinyin":"yáng tǐ jí xīn","abbr":"ytjx","explanation":"羊：南朝宋羊盖；嵇：南朝宋嵇元荣。指精于琴艺，深得琴师心法和技巧。","source":{"text":"卿巧越嵇心，妙臻羊体。","book":"《南史·柳恽传》"},"example":{"text":"雅擅潘文乐旨，妙参～。","book":"清·吴伟业《偶成》"},"usage":"作宾语、定语；指精于琴艺","story":["南朝宋国人嵇元荣和羊盖两人都擅长弹琴，技艺相当高超。他们都能传戴安道琴法，柳恽跟从他们二人学琴，曲尽其妙。齐国竟陵王萧子良称赞他说：“卿巧越嵇心，妙臻羊体。”","柳恽后来也成为一代琴师"]},{"id":36780,"word":"羊入虎口","pinyin":"yáng rù hǔ kǒu","abbr":"yrhk","explanation":"羊落在虎口里。比喻弱者陷入险恶的境地，面临被残害的处境。","source":{"text":"俺们是不怕他的，明日恐怕他们来寻你们，你们却是弄他不过，那时羊入虎口，怎生是好？","book":"明·罗贯中《粉妆楼》第七回"},"example":{"text":"再劝三位，莫上青城。～，有死无生。","book":"金庸《天龙八部》第三回"},"similar":["羊落虎口","羊入虎群"],"usage":"作宾语、定语；用于比喻句"},{"id":36781,"word":"羊入虎群","pinyin":"yáng rù hǔ qún","abbr":"yrhq","explanation":"比喻好人落入坏人的手中，处境极端危险。","source":{"text":"窃意羊入虎群，狼藉已不堪矣。","book":"清·蒲松龄《聊斋志异·邵九娘》"},"similar":["羊落虎口","羊入虎口"],"usage":"作宾语、定语；指处境极端危险"},{"id":36782,"word":"羊公之鹤","pinyin":"yáng gōng zhī hè","abbr":"ygzh","explanation":"羊公：指晋朝征南大将军羊祜。原指羊公不舞之鹤。现比喻名不副实。","source":{"text":"庾失小望，遂名之为羊公鹤。昔羊叔子有鹤善舞，尝向客称之。客试使驱来，氃氋而不肯舞，故称比之。","book":"南朝·宋·刘义庆《世说新语·排调》"}},{"id":36783,"word":"羊公鹤","pinyin":"yáng gōng hè","abbr":"ygh","explanation":"比喻名不副实。","source":{"text":"庾失小望，遂名之为羊公鹤。昔羊叔子有鹤善舞，尝向客称之。客试使驱来，氃氋而不肯舞，故称比之。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"恰似～，可怜生氃氋。","book":"唐·寒山《诗》"},"usage":"作宾语、定语；用于比喻句"},{"id":36784,"word":"羊头狗肉","pinyin":"yáng tóu gǒu ròu","abbr":"ytgr","explanation":"比喻表里不一，明一套暗一套。","source":{"text":"《晏子春秋》：‘悬羊头于门，而卖马肉于内。’世祖赐丁邯诏曰：‘悬牛头，卖马脯；盗跖行，孔子语。’今俗语小变，以羊狗易牛马，意仍不异也，","book":"清·钱大昕《恒言录》卷六"},"example":{"text":"在我们凡百事情都是～的中国，一切原则都要生出例外。","book":"郭沫若《文艺论集·太戈尔来华的我见》"},"similar":["挂羊头，卖狗肉"],"usage":"作宾语、定语；用于比喻句"},{"id":36785,"word":"羊头马脯","pinyin":"yáng tóu mǎ fǔ","abbr":"ytmp","explanation":"挂着招揽生意的是羊头，而实际上卖的是马肉。比喻用假货欺骗人。","source":{"text":"悬牛头，卖马脯，盗跖行，孔子语。","book":"《晏子春秋·内篇杂下》：“君使服之于内，而禁之于外，犹悬牛首于门，而卖马肉于内也。”《后汉书·百官志》"}},{"id":36786,"word":"羊左之交","pinyin":"yáng zuǒ zhī jiāo","abbr":"yzzj","explanation":"羊左：羊角哀与左伯桃，春秋时期燕国人。像羊角哀与左伯桃那样的交情。比喻生死之交的朋友。","source":{"text":"六国时，羊角哀与左伯桃为友，闻楚王贤，俱往仕，至梁山，逢雪，粮尽，度不两全，遂并粮与角哀。角哀至楚，楚用为上卿，后来收葬伯桃。","book":"汉·刘向《列士传》"}},{"id":36787,"word":"羊很狼贪","pinyin":"yáng hěn láng tān","abbr":"yhlt","explanation":"比喻狠毒贪婪 。","source":{"text":"因下令军中曰：‘猛如虎，很如羊，贪如狼，强不可使者，皆斩之。’","book":"语出《史记·项羽本纪》"},"example":{"text":"孰为邦蟊，节根之螟；～，以口覆城。","book":"唐·韩愈《郓州谿堂诗》"},"similar":["羊狠狼贪"],"usage":"作谓语、定语；指贪婪"},{"id":36788,"word":"羊撞篱笆","pinyin":"yáng zhuàng lí bā","abbr":"yzlb","explanation":"比喻进退两难。","source":{"text":"羝羊触藩，羸其角。不能退，不能遂。","book":"《周易·大壮》"}},{"id":36789,"word":"羊枣昌歜","pinyin":"yáng zǎo chāng chù","abbr":"yzcc","explanation":"曾晳嗜羊枣，楚文王嗜昌歜。比喻人之癖好。","source":{"text":"吾辈若不叛孔子，即博涉此书，为羊枣昌歜，有何不可？","book":"明·吕坤《答孙月峰书》"},"example":{"text":"诗文六艺与博杂记问，昔尝强力好之，近始觉其～之嗜。","book":"明·唐顺之《与王尧衢书》"},"similar":["昌歜羊枣"],"usage":"作宾语、定语；用于个人所好"},{"id":36790,"word":"羊歧忘返","pinyin":"yáng qí wàng fǎn","abbr":"yqwf","explanation":"羊歧：歧路。在歧途上忘记了返回。比喻因辨不清正确方向而误入歧途。","source":{"text":"豹管闲窥，羊歧忘返。","book":"唐·陆龟蒙《幽居赋》"}},{"id":36791,"word":"羊毛出在羊身上","pinyin":"yáng máo chū zài yáng shēn shàng","abbr":"ymczyss","explanation":"比喻表面上给了人家好处，但实际上这好处已附加在人家付出的代价里。","source":{"text":"稍稍借贷度日，有收之年送还田主。谚所谓‘羊毛出在羊身上’。","book":"明·唐顺之《公移·牌》"},"example":{"text":"俗话说‘～’。","book":"邹韬奋《萍踪忆语》"},"usage":"作宾语、分句；用于口语"},{"id":36792,"word":"羊毛尘量","pinyin":"yáng máo chén liàng","abbr":"ymcl","explanation":"羊毛尖上尘土的重量。比喻微不足道的东西。","source":{"text":"积七兔毛尘，为一羊毛尘量。","book":"《俱舍论·分别世品》"}},{"id":36793,"word":"羊狠狼贪","pinyin":"yáng hěn láng tān","abbr":"yhlt","explanation":"狠：凶狠。原指为人凶狠，争夺权势。后比喻贪官污吏的残酷剥削。","source":{"text":"因下令军中曰：‘ 猛如虎，很如羊，贪如狼，强不可使者，皆斩之。’","book":"西汉·司马迁《史记·项羽本纪》"},"example":{"text":"～，竟玷人臣之节。","book":"清·蒲松龄《聊斋志异·席方平》"},"similar":["羊很狼贪","贪得无厌"],"opposite":["廉洁奉公"],"usage":"作谓语、定语；指贪婪","story":["秦朝末年，赵歇屯兵巨鹿称王，秦王派兵攻打他，赵歇向楚怀王求救，怀王派宋义、项羽、范增率军救援，宋义命令士兵驻守安阳，让他们两军对垒，待两败俱伤时再去坐收渔利，命令士兵进攻时要羊狠狼贪一般"]},{"id":36794,"word":"羊真孔草","pinyin":"yáng zhēn kǒng cǎo","abbr":"yzkc","explanation":"南朝宋羊欣擅长隶书，孔琳之草书，名重一时，并称为“羊真孔草”。","source":{"text":"羊真孔草，萧行范篆，各一时绝妙。","book":"唐·张彦远《书法要录》卷二"},"example":{"text":"清·李渔《意中缘·画遇》：“若要古人的，有～，萧行范篆。”"},"usage":"作宾语、定语；用于书法"},{"id":36795,"word":"羊破菜园","pinyin":"yáng pò cài yuán","abbr":"ypcy","explanation":"平时常吃疏菜，偶然猛食羊肉，好像被羊踏破肚皮一样。比喻偶贪荤食而致腹疾。","source":{"text":"有人常食菜蔬，忽食羊，梦五藏神曰：‘羊踏破菜园。’","book":"隋·侯白《启颜录》"}},{"id":36796,"word":"羊碑犹泣","pinyin":"yáng bēi yóu qì","abbr":"ybyq","explanation":"晋朝羊祜都督荆州诸军事长达十年，死后，州人为之罢市巷泣，其部属为其建碑立庙，每年祭祀，见碑者莫不流泪。比喻对死者的怀念。","source":{"text":"召棠且思，羊碑犹泣。","book":"南朝·梁·刘孝绰《栖隐寺碑铭》"}},{"id":36797,"word":"羊续悬鱼","pinyin":"yáng xù xuán yú","abbr":"yxxy","explanation":"羊续，汉时官吏。羊续把生鱼悬于庭。形容为官清廉，拒受贿赂。","source":{"text":"续为南阳太守……时权豪之家多尚奢丽，续深疾之，常敝衣薄食，车马羸败。府丞尝献其生鱼，续受而悬于庭；丞后又进之，续乃出所悬者，以杜其意。","book":"《后汉书·羊续传》"},"example":{"text":"不见裴宽瘗鹿，且看～。","book":"清·蒲松龄《官吏听许财物》"},"similar":["前庭悬鱼"],"usage":"作宾语、定语；指清正廉洁","story":["东汉时期，汉灵帝派羊续担任南阳太守。羊续只带一名随从前往，微服私访后上任。他决心以自己的清廉树立官场榜样，府丞焦俭送来一条他爱吃的鲜鲤鱼，推辞不掉，就只好让仆人将鱼挂在屋外，晒成鱼干，从此就没人敢给他送礼了"]},{"id":36798,"word":"羊羔美酒","pinyin":"yán gāo měi jiǔ","abbr":"ygmj","explanation":"羊羔：酒名，因酿制材料中有羊肉，故名。味儿醇厚的好酒。","source":{"text":"陶谷学士，尝买得党太尉家故妓……，妓曰：‘彼粗人也，安有此景，但能销金暖帐下，浅斟低唱，饮羊羔美酒耳。’谷愧其言。","book":"宋·无名氏《湘湖近事》"},"example":{"text":"我虽比他尊贵，但绫锦纱罗，也不过裹了我这枯株朽木，～，也不过填了我这粪窟泥沟。","book":"清·曹雪芹《红楼梦》第七回"},"similar":["琼浆玉液","青州从事"],"opposite":["平原督邮"],"usage":"作宾语、定语；指美酒"},{"id":36799,"word":"羊群里头出骆驼","pinyin":"yáng qún lǐ tóu chū luò tuó","abbr":"yqltclt","explanation":"比喻在普通的地方里出了有名的人或事物。","source":{"text":"如今你还了得，羊群里跑出骆驼来了。就只你大，你又会做文章了。","book":"清·曹雪芹《红楼梦》第八十八回"}},{"id":36800,"word":"羊群里跑出骆驼来","pinyin":"yáng qún lǐ pǎo chū luò tuó lái","abbr":"yqlpcltl","explanation":"比喻在普通的地方里出了有名的人或事物。","source":{"text":"如今你还了得，羊群里跑出骆驼来了。就只你大，你又会做文章了。","book":"清·曹雪芹《红楼梦》第八十八回"},"usage":"作宾语、定语；用于比喻句"},{"id":36801,"word":"羊肠九曲","pinyin":"yáng cháng jiǔ qǔ","abbr":"ycjq","explanation":"羊肠：像羊肠一样崎岖曲折的小路。九曲：有许多曲折的地方，指河道曲折。形容崎岖曲折的小径和弯弯曲曲的河道。也指道路的艰难。"},{"id":36802,"word":"羊肠小径","pinyin":"yáng cháng xiǎo jìng","abbr":"ycxj","explanation":"形容曲折崎岖的小路。同“羊肠小道”。","source":{"text":"说毕，往前一望，见白石崚嶒，或如鬼怪，或如猛兽，纵横拱立，上面苔藓成斑，藤萝掩映，其中微露羊肠小径。","book":"清·曹雪芹《红楼梦》第十七回"},"example":{"text":"进了这道门，他们即发现一条～躺在竹林中间。","book":"巴金《家》十四"},"similar":["羊肠小道"],"usage":"作主语、宾语；用于山路等"},{"id":36803,"word":"羊肠小道","pinyin":"yáng cháng xiǎo dào","abbr":"ycxd","explanation":"曲折而极窄的路（多指山路）。","source":{"text":"火龙明鸟道，铁骑绕羊肠。","book":"唐玄宗《早登太行山中言志》诗"},"example":{"text":"前面弯弯曲曲，尽是～，岔路甚多，甚难分辨。","book":"清·李汝珍《镜花缘》第四十九回"},"similar":["崎岖小道","羊肠小径"],"opposite":["康庄大道","阳关大道","通衢大道"],"usage":"作主语、宾语；用于山路等"},{"id":36804,"word":"羊肠鸟道","pinyin":"yáng cháng niǎo dào","abbr":"ycnd","explanation":"形容山路狭窄，曲折而险峻。","source":{"text":"火龙明鸟道，铁骑绕羊肠。","book":"唐玄宗《早登太行山中言志》诗"},"example":{"text":"千崖万壑供野宿，～笑津迷。","book":"陈毅《乐安宜黄道中闻捷》"},"similar":["羊肠小道"],"opposite":["康庄大道"],"usage":"作主语、宾语、定语；用于山路等"},{"id":36805,"word":"羊落虎口","pinyin":"yáng luò hǔ kǒu","abbr":"ylhk","explanation":"比喻处于险境，有死无生。","source":{"text":"俺家姓杨，被番兵陷在虎口交牙峪里。这个叫做羊落虎口，正犯了兵家所忌。","book":"元·朱凯《昊天塔》第一折"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“郁四一死，必定难制，托以孤儿寡妇，会变成～。”"},"similar":["羊入虎口"],"usage":"作宾语、定语；用于比喻句"},{"id":36806,"word":"羊裘垂钓","pinyin":"yáng qiú chuí diào","abbr":"yqcd","explanation":"汉代严光和与刘秀一起游学，刘秀即帝位，严光变名披羊裘隐钓济中。比喻隐居生活。","source":{"text":"《汉书·严光传》"},"usage":"作宾语、定语；用于书面语","story":["汉朝时期，严光少年时期与汉光武帝刘秀是同学，刘秀即位后，严光不愿当官，改名隐居起来，刘秀亲自到他的住所请他出山，他委婉谢绝。严光经常与渔人住在一起，经常穿着羊皮衣去钓鱼，自得其乐"]},{"id":36807,"word":"羊触藩篱","pinyin":"yáng chù fān lí","abbr":"ycfl","explanation":"羊角勾挂在篱笆上。形容既不能进，也不能退。","source":{"text":"前无所往，退无所归，羊触藩篱，进退两难。","book":"明·许仲琳《封神演义》第三十一回"},"example":{"text":"明·许仲琳《封神演义》第31回：“前无所往，退无所归，～，进退两难。”"},"similar":["羝羊触藩"],"usage":"作谓语、宾语、定语；比喻进退两难"},{"id":36808,"word":"羊质虎形","pinyin":"yáng zhì hǔ xíng","abbr":"yzhx","explanation":"质：本性。羊虽然披上虎皮，还是见到草就喜欢，碰到豺狼就怕得发抖，它的本性没有变。比喻外表装作强大而实际上很胆小。","source":{"text":"羊质而虎皮，见草而悦，见豺而战，忘其皮之虎矣。","book":"汉·扬雄《法言·吾子》"},"example":{"text":"看似新机勃发，政局昌明，其实是徒袭皮毛，未得精髓，～，济什么事？","book":"蔡东藩《慈禧太后演义》第十三回"},"similar":["羊质虎皮"],"usage":"作宾语、定语；指外强中干"},{"id":36809,"word":"羊质虎皮","pinyin":"yáng zhì hǔ pí","abbr":"yzhp","explanation":"质：本性。羊虽然披上虎皮，还是见到草就喜欢，碰到豺狼就怕得发抖，它的本性没有变。比喻外表装作强大而实际上很胆小。","source":{"text":"羊质而虎皮，见草而悦，见豺而战，忘其皮之虎矣。","book":"汉·扬雄《法言·吾子》"},"example":{"text":"～功不就，凤毛鸡胆事难成。","book":"明·罗贯中《三国演义》第三十二回"},"similar":["外强中干","羊质虎形"],"usage":"作宾语、定语；指外强中干","story":["北魏龙骧将军羊祉的儿子羊侃身材高大魁梧，十几岁就随父出征，立下赫赫战功。北魏皇帝召他入朝，故意说他是羊质虎皮，让他学老虎的样子，羊侃的手指在地板上抓了十个洞，真的像老虎那样，北魏皇帝称他是真正的壮士"]},{"id":36810,"word":"羊贪狼狠","pinyin":"yáng tān láng hěn","abbr":"ytlh","explanation":"狠：凶狠。原指为人凶狠，争夺权势。后比喻贪官污吏的残酷剥削。","source":{"text":"因下令军中曰：‘猛如虎，很如羊，贪如狼，强不可使者，皆斩之。’","book":"《史记·项羽本纪》"},"example":{"text":"见良人终身有托，要脱离风月排场。老虔婆～，逼令他改嫁茶商。","book":"元·马致远《青衫泪》第四折"}},{"id":36811,"word":"羊踏菜园","pinyin":"yáng tà cài yuán","abbr":"ytcy","explanation":"喻惯吃蔬菜的人偶食荤腥美食。","source":{"text":"有人常食蔬茹，忽食羊肉，梦五藏神曰：‘羊踏菜园！’","book":"三国·魏·邯郸淳《笑林》"},"example":{"text":"二哥在山中，已是长素，忽寄若干肉至，得无～乎？然不欲虚妹一片至情，为妹一饱食，然后复素。","book":"清·韩廷锡《山中答孟韩妹书》"},"usage":"作宾语、定语；指人的饮食","story":["从前有一个人平时都是吃蔬菜，有一天他遇到一个朋友请他上餐馆，美美地吃了一顿羊肉，感觉舒服极了，就连晚上做梦也忘记不了，梦见五脏神告诉他：“羊踏破菜园了。”他在梦中急忙跑去菜园去抓羊来杀"]},{"id":36812,"word":"羊鹤不舞","pinyin":"yáng hè bù wǔ","abbr":"yhbw","explanation":"比喻虽然训练有素，但临场表现失常。","source":{"text":"庾失小望，遂名之为羊公鹤。昔羊叔子有鹤善舞，尝向客称之。客试使驱来，氃氋而不肯舞，故称比之。","book":"南朝·宋·刘义庆《世说新语·排调》"},"example":{"text":"目前固不必急急速求奇效，徒乱人心，制器则画虎不成，临阵则～。","book":"清·金安清《洋务宜遵祖训安内攘外自有成效说》"}},{"id":36813,"word":"羌无故实","pinyin":"qiāng wú gù shí","abbr":"qwgs","explanation":"羌：语助词，无义；故实：典故。指不用典故或没有出处。","source":{"text":"‘清晨登陇首’，羌无故实；‘明月照积雪’，讵出经史？","book":"南朝·梁·钟嵘《诗品序》"},"example":{"text":"不知皆纸上空文，～。","book":"清·梁启超《论立法权》"},"usage":"作谓语、定语；指没有根据"},{"id":36814,"word":"美不胜收","pinyin":"měi bù shèng shōu","abbr":"mbss","explanation":"胜：尽。美好的东西很多，一时看不过来。","source":{"text":"惟鱼之一物，美不胜收。","book":"清·钱泳《履园丛话·艺能·治庖》"},"example":{"text":"展览馆里展出的各种工艺品琳琅满目，～。"},"similar":["琳琅满目"],"opposite":["不堪入目"],"usage":"作谓语、定语、补语；指好东西很多"},{"id":36815,"word":"美中不足","pinyin":"měi zhōng bù zú","abbr":"mzbz","explanation":"大体很好，但还有不足。","source":{"text":"破镜重圆，离而复合，固是好事；但王夫人所遭不幸，失身为妾，又不曾根究奸人，报仇雪恨，尚为美中不足。","book":"明·凌濛初《初刻拍案惊奇》卷二十七"},"example":{"text":"叹人间，～今方信，纵然是齐眉举案，到底意难平。","book":"清·曹雪芹《红楼梦》第五回"},"similar":["白璧微瑕"],"opposite":["十全十美"],"usage":"作宾语、定语；指大体很好"},{"id":36816,"word":"美人计","pinyin":"měi rén jì","abbr":"mrj","explanation":"三十六计之一，用美人引诱人上当。","source":{"text":"野人闻言不信，以为大王乃英明之主，雄长东南，霸业方成，岂有识不破仇人所献的美人计，甘受蛊惑之理呢！","book":"丁寅生《孔子演义》第75回"},"example":{"text":"我不会中你的～的。"},"similar":["美女计"],"usage":"作主语、宾语、定语；用于计谋"},{"id":36817,"word":"美人迟暮","pinyin":"měi rén chí mù","abbr":"mrcm","explanation":"原意是有作为的人也将逐渐衰老。比喻因日趋衰落而感到悲伤怨恨。","source":{"text":"惟草木之零落兮，恐美人之迟暮。","book":"战国·楚·屈原《离骚》"},"example":{"text":"远道荒寒，婉娩流年，望望～。","book":"元·彭元逊《解珮环》词"},"usage":"作宾语；指流光易逝，盛年难再"},{"id":36818,"word":"美人香草","pinyin":"měi rén xiāng cǎo","abbr":"mrxc","explanation":"旧时诗文中用以象征忠君爱国的思想。","source":{"text":"《离骚》之文，依《诗》取兴，引类譬谕，故善鸟、香草、以配忠贞，……灵修、美人，以譬于君。","book":"汉·王逸《离骚序》"},"example":{"text":"“～”从此便成为政治的譬喻，影响后来解诗作诗的人很大。","book":"朱自清《经典常谈·辞赋》"},"usage":"作宾语；象征忠君爱国思想"},{"id":36819,"word":"美其名曰","pinyin":"měi qí míng yuē","abbr":"mqmy","explanation":"给予一个好听的名字(名称)叫做……。","source":{"text":"美其名曰‘富士山’。","book":"鲁迅《藤野先生》"},"example":{"text":"章诒和《往事并不如烟·最后的贵族》：“中国自古是礼仪之邦，现在却连同城而居的好朋友都不能见面，还～文化大革命，一点文化也没有。”"},"usage":"作谓语；指假以美名"},{"id":36820,"word":"美味佳肴","pinyin":"měi wèi jiā yáo","abbr":"mwjy","explanation":"指上等的、第一流的食品，精致可口的饭菜或味道鲜美的食品。","source":{"text":"当马锐看到父亲饱餐了一顿美味佳肴，脸上所露出的满足和惬意，那种货真价实的幸福感，才恍然大悟。","book":"王朔《我是你爸爸》"},"example":{"text":"我们望着面前的～，还是没有食欲。"},"similar":["佳肴美味","佳肴美馔"],"opposite":["粗茶淡饭","清汤寡水"],"usage":"作主语、宾语、定语；指精美的食物"},{"id":36821,"word":"美奂美轮","pinyin":"měi huàn měi lún","abbr":"mhml","explanation":"奂：众多；轮：高大。形容房屋的高大和众多。","source":{"text":"美奂美轮，礼称屋宇之高华；肯构肯堂，书言父子之同志。","book":"明·程登吉《幼学琼林》第三卷"},"similar":["美轮美奂"],"usage":"作谓语、定语；形容房屋的高大和众多"},{"id":36822,"word":"美女破舌","pinyin":"měi nǚ pò shé","abbr":"mnps","explanation":"破：毁坏。美女用美貌迷惑君主，使谏臣的话不被君主听信。","source":{"text":"夫晋献公欲伐郭，而惮舟之侨存。荀息曰：‘《周书》有言：美女破舌。’乃遗之女乐，以乱其政。舟之侨谏而不听，遂去。","book":"西汉·刘向《战国策·秦策》"},"usage":"作宾语、定语；用于劝诫人"},{"id":36823,"word":"美女簪花","pinyin":"měi nǚ zān huā","abbr":"mnzh","explanation":"簪：插戴。形容书法娟秀。也比喻诗文清新秀丽。","source":{"text":"卫常书，如插花美人，舞笑镜台。","book":"南朝·梁·袁昂《古今书评》"},"example":{"text":"南朝·梁·袁昂《古今书评》：“卫常书，如插花美人，舞笑镜台。”"},"usage":"作宾语；形容书法或诗文的清新娟秀"},{"id":36824,"word":"美女者丑妇之仇","pinyin":"měi nǚ zhě chǒu fù zhī chóu","abbr":"mnzcfzc","explanation":"美女是丑妇的仇人。旧时比喻贤臣是奸臣的仇敌。","source":{"text":"美女者丑妇之仇也，盛德之士，乱世所疏也；正直之行，邪枉所憎也。","book":"汉·刘高《说苑·尊贤》"}},{"id":36825,"word":"美如冠玉","pinyin":"měi rú guān yù","abbr":"mrgy","explanation":"冠：帽子。原比喻只是外表好看。后形容男子长相漂亮。","source":{"text":"平虽美大夫，如冠玉耳，其中未必有也。","book":"《史记·陈丞相世家》"},"example":{"text":"曾有一个道士，有长生不老之术，自说已经百余岁了，看去却“～”，象二十左右一样。","book":"鲁迅《准风月谈·青年与老子》"},"usage":"作谓语；形容男子长相漂亮","story":["秦末汉初，美如冠玉的陈平在张负的资助下从师学习，他先后投奔魏王咎与项羽，因他们不能采纳他的建议就去投奔刘邦。刘邦认为他是个人才，就封他为曲逆侯，他先后6次用计使刘邦转危为安，为汉王朝的稳定和巩固作出巨大的贡献"]},{"id":36826,"word":"美意延年","pinyin":"měi yì yán nián","abbr":"myyn","explanation":"美意：乐意；延年：处长寿命。对一切乐观的人，能够健康长寿。","source":{"text":"得众动天，美意延年。","book":"战国·赵·荀况《荀子·致士》"},"example":{"text":"为人当乐观，当笑则不妨一笑，须知～的道理。","book":"《文摘周报》"},"similar":["延年益寿"],"usage":"作谓语、定语；指一切乐观的人能够健康长寿"},{"id":36827,"word":"美景良辰","pinyin":"měi jǐng liáng chén","abbr":"mjlc","explanation":"良：美好；辰：时辰。美好的时光和景物。","source":{"text":"天下良辰、美景、赏心、乐事，四者难并。","book":"南朝·宋·谢灵运《拟魏太子邺中集诗序》"},"example":{"text":"想人生，～堪惜。","book":"宋·聂冠卿《多丽·李艮定公席上赋》"},"similar":["良辰美景"],"usage":"作宾语、定语；指美好的时光和景物"},{"id":36828,"word":"美玉无瑕","pinyin":"měi yù wú xiá","abbr":"mywx","explanation":"瑕：玉斑。美玉上面没有一点小斑。比喻人或事物完美的无缺点。","source":{"text":"他是个娇滴滴美玉无瑕，粉脸生春，云鬓堆鸦。","book":"元·王实甫《西厢记》第三本第三折"},"example":{"text":"一个是阆苑仙葩，一个是～。","book":"《红楼梦》第五回"},"similar":["白璧无瑕"],"usage":"作谓语、定语；比喻人或事物十全十美"},{"id":36829,"word":"美男破老","pinyin":"měi nán pò lǎo","abbr":"mnpl","explanation":"美男：年轻的男宠；老：老成人。比喻用年轻的男宠谗毁老成人。","source":{"text":"美男破老，美女破舌。","book":"《逸周书·武称解》"},"usage":"作宾语、定语；用于政治等"},{"id":36830,"word":"美疢不如恶石","pinyin":"měi chèn bù rú è shí","abbr":"mcbres","explanation":"疢：病；石：砭石，古代用以治病的石针。美言疾病，不如用砭石去治疗疾病。比喻明知有害而一味顺从，不如严厉批评。","source":{"text":"季孙之爱我，疾疢世。孟孙之恶我，药石也。美疢不如恶石。夫石犹生我，疢之美，其毒滋多。","book":"《左传·襄公二十三年》"},"example":{"text":"～。坚不禁起舞道：“与朕共定天下，独卿一人。余子碌碌，何足与谋！”","book":"蔡东藩《两晋演义》第六十六回"}},{"id":36831,"word":"美疢药石","pinyin":"měi chèn yào shí","abbr":"mcys","explanation":"疢：病；药石：古时指药和治病的石针。比喻虚伪的逢迎不如严厉的批评。","source":{"text":"季孙之爱我，疾疢世。孟孙之恶我，药石也。美疢不如恶石。夫石犹生我，疢之美，其毒滋多。","book":"《左传·襄公二十三年》"}},{"id":36832,"word":"美益求美","pinyin":"měi yì qiú měi","abbr":"myqm","explanation":"好上要求好。","source":{"text":"一切陆军、海军、政治、工艺，无不美益求美，精益求精。","book":"清·陈天华《警世钟》"},"similar":["精益求精"],"usage":"作谓语、宾语、定语；同“精益求精”"},{"id":36833,"word":"美芹之献","pinyin":"měi qín zhī xiàn","abbr":"mqzx","explanation":"用以自谦所献菲薄，不足当意。","source":{"text":"昔人有美戎菽，甘苔茎、芹萍子者，对乡豪称之。乡豪取而尝之，蜇于口，惨于腹。众哂而怨之，其人大惭。","book":"《列子·杨朱》"},"example":{"text":"所提数条意见，为～，仅供参考。"},"usage":"作宾语；用于自谦"},{"id":36834,"word":"美行加人","pinyin":"měi xíng jiā rén","abbr":"mxjr","explanation":"美行：优美的行为；加人：超越众人。指行为高尚，超出一般人。","source":{"text":"美言可以市尊，美行可以加人。","book":"《老子》第六十二章"}},{"id":36835,"word":"美衣玉食","pinyin":"měi yī yù shí","abbr":"myys","explanation":"形容衣食奢华。","source":{"text":"其徒美衣玉食,几二万人。","book":"《宋史·林灵素传》"},"example":{"text":"所谓君者，受尊号，享荣名，～，崇阶华宫，乘高车，驾上驷，府库充盈，使令满前。","book":"明·冯梦龙《东周列国志》第六十五回"},"similar":["锦衣玉食"],"opposite":["粗衣粝食"],"usage":"作宾语、定语；指奢华的生活"},{"id":36836,"word":"美言不信","pinyin":"měi yán bù xìn","abbr":"mybx","explanation":"信：真实。指词藻华盖的言辞、文章，内容往往不真实。","source":{"text":"信言不美，美言不信。","book":"《老子》第六十八章"},"example":{"text":"若～，玩物丧志，其赋亦不可已乎。","book":"清·刘熙载《艺概·赋概》"},"usage":"作宾语、定语；用于书面语"},{"id":36837,"word":"美言不文","pinyin":"měi yán bù wén","abbr":"mybw","explanation":"文：饰。美善的言辞，不需要修饰。","source":{"text":"良玉不雕，美言不文。","book":"汉·扬雄《法言·寡见》"},"usage":"作宾语、定语；用于劝诫人"},{"id":36838,"word":"美言市尊","pinyin":"měi yán shì zūn","abbr":"mysz","explanation":"市尊：博取尊敬。优美动听的话可以博取尊敬。","source":{"text":"美言可以市尊，美行可以加人。","book":"《老子》第六十二章"}},{"id":36839,"word":"美语甜言","pinyin":"měi yǔ tián yán","abbr":"myty","explanation":"说话像蜜糖一样甜。比喻为了骗人而说得动听的话。","source":{"text":"撺情掇趣，不是花，定然是酒。美语甜言笑口，偏有许多引诱。","book":"清·褚人获《隋唐演义》第40回"},"similar":["甜言蜜语"],"usage":"作主语、宾语；指骗人开心的话"},{"id":36840,"word":"美轮美奂","pinyin":"měi lún měi huàn","abbr":"mlmh","explanation":"轮：高大；奂：众多。形容房屋高大华丽。","source":{"text":"晋献文子成室，晋大夫发焉。张老曰：‘美哉轮焉，美哉奂焉。’","book":"《礼记·檀弓下》"},"example":{"text":"我们经过一个～的宏丽华厦的区域，开车的告诉我们说这是西人和本地富翁的住宅区域。","book":"邹韬奋《萍踪寄语初集·惊涛骇浪后》"},"similar":["美奂美轮"],"usage":"作谓语、定语；形容房屋的高大和众多","story":["晋文子赵武家里新落成一所房屋，晋国大夫张老去祝贺说：“美哉轮焉，美哉奂焉！歌于斯，哭于斯，聚国族于斯！”旁人十分惊讶。晋文子接上：“武也得歌于斯，哭于斯，聚国族于斯，是全腰领以从先大夫于九原也！”人称晋文子善颂善祷"]},{"id":36841,"word":"美酒佳肴","pinyin":"měi jiǔ jiā yáo","abbr":"mjjy","explanation":"肴：下酒的饭菜。指好酒好菜。","source":{"text":"须臾茶毕，早已设下杯盘那美酒佳肴，自不必说。","book":"清·曹雪芹《红楼梦》第一回"},"example":{"text":"下余二十两，置办肥肉大鱼，～，叙饮庆功。","book":"清·吴趼人《九命奇冤》第七回"},"similar":["美味佳肴"],"usage":"作主语、宾语、定语；指好酒好菜"},{"id":36842,"word":"美酒嘉肴","pinyin":"měi jiǔ jiā yáo","abbr":"mjjy","explanation":"嘉：美好；肴：下酒的饭菜。指好酒好菜。","source":{"text":"是日同衙门官摆着公会筵席，特贺到任，美酒嘉肴，珍羞百味。","book":"明·凌濛初《二刻拍案惊奇》第19卷"},"similar":["美酒佳肴"],"usage":"作主语、宾语、定语；指好酒好菜"},{"id":36843,"word":"美锦学制","pinyin":"měi jǐn xué zhì","abbr":"mjxz","explanation":"制：剪裁。把好绸缎用来学剪裁。比喻把官职交给才能低下的人。","source":{"text":"子有美锦，不使人学制焉。大官、大邑，身之所庇也，而使学者制焉。其为美锦，不亦多乎？","book":"《左传·襄公三十一年》"}},{"id":36844,"word":"美雨欧风","pinyin":"měi yǔ ōu fēng","abbr":"myof","explanation":"欧：欧洲。比喻来自欧美的思想文化等方面的侵袭。","source":{"text":"美雨欧风，顿起沉疴宿疾。","book":"清·秋瑾《精卫石》第五回"},"similar":["欧风美雨"],"usage":"作宾语、定语；指欧美的侵略"},{"id":36845,"word":"美须豪眉","pinyin":"měi xū háo méi","abbr":"mxhm","explanation":"美丽的须髯，浓浓的眉毛。形容男子英俊豪迈。","source":{"text":"赵壹字无叔，汉阳西县人也，体貌魁梧，身长九尺，美须豪眉，望之甚伟。","book":"《后汉书·赵壹传》"}},{"id":36846,"word":"美食甘寝","pinyin":"měi shí gān qǐn","abbr":"msgq","explanation":"甘寝：安睡。吃得好，睡得好。形容生活安逸。","source":{"text":"江官为酂丞，家累巨产。发言不胜呜咽。媪不之异，又久困寒饿，得美食甘寝，不复言。","book":"唐·陈翰《异闻集·庐江冯媪》"},"example":{"text":"现在的少年个个～，无忧无虑"},"usage":"作宾语、定语；用于生活"},{"id":36847,"word":"羔羊之义","pinyin":"gāo yáng zhī yì","abbr":"gyzy","explanation":"旧时指为人或为官清白，有节操。","source":{"text":"故洛阳令王涣，秉清修之节，蹈羔羊之义。","book":"《后汉书·王涣传》"}},{"id":36848,"word":"羔羊素丝","pinyin":"gāo yáng sù sī","abbr":"gyss","explanation":"羔羊：小羊羔，此指小羊羔的皮；素：白。用小羊羔的皮毛缝制衣服，用素丝作为装饰。旧时称赞士大夫正直节俭，品德与仪表一样美。","source":{"text":"羔羊之皮，素丝五；退食自公，委蛇委蛇。","book":"《诗经·召南·羔羊》"}},{"id":36849,"word":"羚羊挂角","pinyin":"líng yáng guà jiǎo","abbr":"lygj","explanation":"羚羊夜宿，挂角于树，脚不着地，以避祸患。旧时多比喻诗的意境超脱。","source":{"text":"盛唐诸人，唯在兴趣，羚羊挂角，无迹可求。故其妙处，透澈玲珑，不可凑泊。","book":"宋·严羽《沧浪诗话·诗辨》"},"example":{"text":"她的作品有～之妙。"},"usage":"作宾语；比喻意境超脱，不着形迹"},{"id":36850,"word":"羝羊絓棘","pinyin":"dī yáng guà jí","abbr":"dygj","explanation":"羝羊：公羊；絓：绊住。公羊的角被荆棘绊住，进退不得。比喻进退两难。","source":{"text":"进退道穷，羝羊絓棘。","book":"章炳麟《哀陆军学生》"},"similar":["羝羊触藩","羊触藩篱"],"usage":"作谓语、宾语、定语；比喻进退两难"},{"id":36851,"word":"羝羊触藩","pinyin":"dī yáng chù fān","abbr":"dycf","explanation":"羝羊：公羊；触：抵撞；藩：篱笆。公羊的角缠在篱笆上，进退不得。比喻进退两难。","source":{"text":"羝羊触藩，羸其角。不能退，不能遂。","book":"《周易·大壮》"},"example":{"text":"纣王沉吟不语，心下煎熬，似～，进退两难。","book":"明·许仲琳《封神演义》第七回"},"similar":["进退维谷","进退两难"],"usage":"作谓语、宾语；比喻进退两难"},{"id":36852,"word":"羞与为伍","pinyin":"xiū yǔ wéi wǔ","abbr":"xyww","explanation":"羞：感到羞耻；与：跟；为伍：作伙伴。比喻把跟某人在一起认为是可耻的事。","source":{"text":"逮桓灵之间，主荒政谬，国命委于阉寺，士子羞与为伍。","book":"南朝·宋·范晔《后汉书·党锢列传》"},"example":{"text":"有一批是盗名的，因此使别一批～，觉得和‘熟人的名字并列得厌倦’，决计逃走了。","book":"鲁迅《且介亭杂文二集·逃名》"},"similar":["羞与哙伍"],"opposite":["引以为荣"],"usage":"作谓语、定语；指耻与为伴","story":["刘邦建立西汉后，封曾经在鸿门宴上立功的樊哙为“舞阳侯”，由于担心大将军韩信握兵自重，削其兵权改为楚王，接着又降为淮阴侯。一次韩信从樊哙门前走过，樊哙跪迎韩信。事后韩信后悔自己竟与樊哙这样的人为伍而感到羞愧"]},{"id":36853,"word":"羞与哙伍","pinyin":"xiū yǔ kuài wǔ","abbr":"xykw","explanation":"哙：樊哙。韩信鄙视樊哙，不屑与他同为列侯。泛指以跟某人在一起为可耻。","source":{"text":"信尝过樊将军哙，哙跪拜送迎，言称臣，曰：‘大王乃肯临臣！’信出门，笑曰：‘生乃与哙等为伍。’","book":"西汉·司马迁《史记·淮阴侯列传》"},"similar":["羞与为伍"],"opposite":["引以为荣"],"usage":"作谓语、定语；指耻与为伴","story":["刘邦建立西汉后，封曾经在鸿门宴上立功的樊哙为“舞阳侯”，由于担心大将军韩信握兵自重，削其兵权改为楚王，接着又降为淮阴侯。一次韩信从樊哙门前走过，樊哙跪迎韩信。事后韩信后悔自己竟与樊哙这样的人为伍而感到羞愧"]},{"id":36854,"word":"羞人答答","pinyin":"xiū rén dā dā","abbr":"xrdd","explanation":"答答：害羞的样子。形容自己感觉难为情。","source":{"text":"这小贱人倒会放刁，羞人答答的，怎生去。","book":"元·王实甫《西厢记》第四本楔子"},"example":{"text":"一时被你娘们说上几句，～的，怎好相见？","book":"明·兰陵笑笑生《金瓶梅词话》第78回"},"usage":"作谓语、定语；指不好意思，用于口语"},{"id":36855,"word":"羞以牛后","pinyin":"xiū yǐ niú hòu","abbr":"xynh","explanation":"牛后：牛的肛门，比喻从属的地位。指不愿处在从属地位，为人牵制。","source":{"text":"昔苏秦说韩，羞以牛后，韩王按剑，作色而怒。","book":"汉·阮禹《为曹公作书与孙权》"},"usage":"作谓语、定语；用于处事"},{"id":36856,"word":"羞口羞脚","pinyin":"xiū kǒu xiū jiǎo","abbr":"xkxj","explanation":"形容害羞不敢说话，忸忸怩怩的情态。","source":{"text":"合族中虽有许多妯娌，也有言语钝拙的，也有举止轻浮的，也有羞口羞脚不惯见人的，也有惧贵怯官的，越显得凤姐洒爽风流，典则俊雅。","book":"清·曹雪芹《红楼梦》第十四回"},"usage":"作定语、状语；用于书面语"},{"id":36857,"word":"羞恶之心，人皆有之","pinyin":"xiū wù zhī xīn，rén jiē yǒu zhī","abbr":"xwzxrjyz","explanation":"指做了错事、坏事而感到羞耻、憎恶的心情，人人都是有的。","source":{"text":"恻隐之心，人皆有之；羞恶之心，人皆有之。","book":"《孟子·告子上》"},"example":{"text":"～，某虽为盗，良心岂尽丧乎？","book":"明·熊大木《杨家府演义》第二回"},"usage":"作宾语、定语；用于书面语"},{"id":36858,"word":"羞恼成怒","pinyin":"xiū nǎo chéng nù","abbr":"xncn","explanation":"恼：忿恨。由于羞愧到了极点，下不了台而发怒。","source":{"text":"这婆子一则吃了酒，二则被这丫头揭着弊病，便羞恼成怒了。","book":"清·曹雪芹《红楼梦》第七十一回"},"example":{"text":"不想合安公子一时话不投机，惹动他一冲的性儿，～，还不曾红丝暗系，先弄得白刃相加。","book":"清·文康《儿女英雄传》第十回"},"similar":["恼羞成怒"],"usage":"作谓语、定语、状语；指发怒"},{"id":36859,"word":"羞惭满面","pinyin":"xiū cán mǎn miàn","abbr":"xcmm","explanation":"满脸都表现出羞耻和惭愧的表情。形容因做错事而内疚和惭愧。","source":{"text":"赵范羞惭满面，答曰：‘我好意相待，如何这般无礼！’","book":"明·罗贯中《三国演义》第五十二回"},"example":{"text":"公子因是前日不听其言，今荒凉光景了，～。","book":"明·凌濛初《二刻拍案惊奇》卷二十二"},"similar":["满面羞惭"],"usage":"作宾语、定语、状语；用于处事"},{"id":36860,"word":"羞愧满面","pinyin":"xiū kuì mǎn miàn","abbr":"xkmm","explanation":"羞愧：感到羞耻和惭愧。满脸都表现出羞耻和惭愧的表情。形容因做错事而内疚和惭愧。","source":{"text":"成然满面羞愧，缩颈而退。","book":"明·冯梦龙《东周列国志》第六十九回"},"example":{"text":"贾珍见贾琏进来，不觉～。","book":"清·曹雪芹《红楼梦》第六十五回"}},{"id":36861,"word":"羞愧难当","pinyin":"xiū kuì nán dāng","abbr":"xknd","explanation":"当：承受。指感到十分羞愧内疚。","source":{"text":"那婆子羞愧难当，一言不发。","book":"清·曹雪芹《红楼梦》第58回"},"example":{"text":"这事让我～。"},"similar":["愧悔无地"],"usage":"作宾语；指感到十分羞愧内疚","story":["西汉时期，已经投降匈奴的汉朝大将李陵奉单于之命去劝苏武投降，李陵列举苏武的两个兄弟忠心汉朝没有得到好报，希望他能归顺匈奴，苏武义正严辞地拒绝。苏武终于盼到回去的那天，李陵为他送行，自己感到羞愧难当"]},{"id":36862,"word":"羞手羞脚","pinyin":"xiū shǒu xiū jiǎo","abbr":"xsxj","explanation":"形容拘谨、畏缩，不敢上前的样子。","source":{"text":"更有羞手羞脚，不惯见人，不敢来的。","book":"清·曹雪芹《红楼梦》第五十三回"},"example":{"text":"更兼他天生得落落大方，不似那～的小家气象。","book":"清·文康《儿女英雄传》第二十九回"}},{"id":36863,"word":"羞羞答答","pinyin":"xiū xiū dā dā","abbr":"xxdd","explanation":"答答：羞愧的样子。形容难为情，不好意思。","source":{"text":"羞羞答答的，怎生去！","book":"元·王实甫《西厢记》第四本楔子"},"example":{"text":"我最喜欢她～的样子。"},"similar":["忸忸怩怩"],"opposite":["大大方方"],"usage":"作谓语、定语、状语；形容含羞的样子"},{"id":36864,"word":"羞花闭月","pinyin":"xiū huā bì yuè","abbr":"xhby","explanation":"形容女子貌美，使花亦羞愧，月亦隐藏。","source":{"text":"不堤防沉鱼落雁鸟惊喧，则怕的羞花闭月花愁颤。","book":"明·汤显祖《牡丹亭》第十出"},"example":{"text":"适才已见夫人面，真是～容。","book":"明·蘅芜室主人《再生缘》第二六回"},"similar":["闭月羞花"],"usage":"作谓语、定语；形容女子的容貌美"},{"id":36865,"word":"羞面见人","pinyin":"xiū miàn jiàn rén","abbr":"xmjr","explanation":"因感到羞耻而怕见人。","source":{"text":"司徒禇渊入朝，以腰扇鄣日。祥从侧过，曰：‘作如此举止，羞面见人，扇鄣何益？’","book":"《南齐书·刘祥传》"},"usage":"作谓语、定语；指感到羞耻"},{"id":36866,"word":"群分类聚","pinyin":"qún fēn lèi jù","abbr":"qflj","explanation":"聚：聚集。指同类的事物聚合在一起，不同的事物以类区分。","source":{"text":"可谓类聚群分，杂而不越，文质彬彬，最可得而论也。","book":"《周易·系辞上》：“方以类聚，物以群分，吉凶生矣。”《北史·江式传》"},"example":{"text":"而荀勖、李充、王俭、任昉、祖恆，皆达学多闻，历世整比，～，递相祖述。","book":"《旧唐书·经籍上》"},"similar":["物以类聚，人以群分"],"usage":"作宾语、定语；用于事理"},{"id":36867,"word":"群口啾唧","pinyin":"qún kōng jiū jī","abbr":"qkjj","explanation":"啾唧：细小而杂碎的声音。形容一班小人在暗地里搬弄是非。","source":{"text":"一身但得贬，群口息啾唧。","book":"宋·欧阳修《班班林间鸠寄内》"}},{"id":36868,"word":"群口铄金","pinyin":"qún kǒu shuò jīn","abbr":"qksj","explanation":"铄：熔化。众口一词能够把金属熔化。指舆论可以混淆是非。","source":{"text":"众心成城，众口铄金。","book":"《国语·周语下》"},"example":{"text":"陛下察其心于～之际，薄其罪于众人欲杀之时。","book":"宋·李纲《谢亲笔劄子》"},"similar":["众口铄金"],"usage":"作谓语、定语；用于谎言等"},{"id":36869,"word":"群威群胆","pinyin":"qún wēi qún dǎn","abbr":"qwqd","explanation":"形容大家团结一致英勇战斗时表现出来的力量和勇敢精神。","source":{"text":"大家出力量，不怕牺牲，克服物质条件的困难，群威群胆，英勇杀敌。","book":"毛泽东《评西北大捷兼论解放军的新式整军运动》"},"example":{"text":"他们紧密配合，～，迅速完成这项工作。"},"similar":["同仇敌忾","同心协力"],"opposite":["孤家寡人"],"usage":"作谓语；指团结一致"},{"id":36870,"word":"群居和一","pinyin":"qún jū hé yī","abbr":"qjhy","explanation":"指和谐相处，协调一致。","source":{"text":"故先王案为之制礼义以分之，使有贵贱之等，长幼之差，知愚能不能之分，皆使人载其事而各得其宜，然后使悫禄多少厚薄之称，是夫群居和一之道也。","book":"《荀子·荣辱》"},"usage":"作谓语、定语；用于书面语"},{"id":36871,"word":"群居穴处","pinyin":"qún jū xué chǔ","abbr":"qjxc","explanation":"上古之人聚群而居，宿于山洞之中。比喻粗野无知，见闻不广。","source":{"text":"王之将吏，群居穴处之徒，人人抵掌，欲为不善之计。","book":"《后汉书·隗嚣传》"},"usage":"作谓语、定语；用于远古时代的人"},{"id":36872,"word":"群居终日，言不及义","pinyin":"qún jū zhōng rì，yán bù jí yì","abbr":"qjzrybjy","explanation":"比喻整天成群地聚在一起，不讲正经事。","source":{"text":"群居终日，言不及义，好行小慧，难矣哉。","book":"《论语·卫灵公》"},"example":{"text":"有的是“饱食终日，无所用心”，有的是“～”。","book":"鲁迅《在小钟楼上》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":36873,"word":"群山万壑","pinyin":"qún shān wàn hè","abbr":"qswh","explanation":"壑：山谷。形容山峦绵延起伏，高低重叠。","source":{"text":"群山万壑赴荆门，生长明妃尚有村。","book":"唐·杜甫《咏怀古迹五首》"}},{"id":36874,"word":"群山四应","pinyin":"qún shān sì yìng","abbr":"qssy","explanation":"应：应和。四面群山纷纷响应。比喻一声号召，人们群起响应。","source":{"text":"为的是‘发聋振聩’，是‘群山四应’，是人民的觉醒与起来。","book":"朱自清《论标语口号》"},"example":{"text":"“喂，你们快坑诩给我滚蛋，别来罗索！”这一声呼喝，～，威势惊人。","book":"金庸《鹿鼎记》第十八回"},"usage":"作宾语、定语；用于响应"},{"id":36875,"word":"群情欢洽","pinyin":"qún qíng huān qià","abbr":"qqhq","explanation":"洽：和睦。形容众人的情绪十分喜悦、融洽。"},{"id":36876,"word":"群情激昂","pinyin":"qún qíng jī áng","abbr":"qqja","explanation":"大家的情绪都很激动和高昂。","example":{"text":"在这～的时候，我们要好好加以引导。"},"usage":"作谓语、定语；指人的情绪"},{"id":36877,"word":"群情鼎沸","pinyin":"qún qíng dǐng fèi","abbr":"qqdf","explanation":"形容群众的情绪异常激动，平静不下来。","example":{"text":"忽遘此变，～，副总统及各督军、省长，驰电督责。","book":"丁中江《北洋军阀史话》一一七"},"usage":"作谓语、定语；用于书面语"},{"id":36878,"word":"群方咸遂","pinyin":"qún fāng xián suì","abbr":"qfxs","explanation":"群方：万方；咸：都；遂：成功，顺利。比喻事事都如意顺利。","source":{"text":"群方咸遂，志士怀仁，,斯固所谓‘举逸民天下归心’者乎！","book":"《后汉书·逸民传序》"}},{"id":36879,"word":"群枉之门","pinyin":"qún wǎng zhī mén","abbr":"qwzm","explanation":"枉：奸邪。指各种歪门邪道。","source":{"text":"夫狐疑之心者，来谗贼之口；持不断之意者，开群枉之门。","book":"东汉·班固《汉书·刘向传》"},"usage":"作宾语；指歪门邪道"},{"id":36880,"word":"群犬吠所怪","pinyin":"qún quǎn fèi suǒ guài","abbr":"qqfsg","explanation":"形容一些坏人和不懂道理的人结伙诽谤好人。","source":{"text":"邑犬群吠兮，吠所怪也。","book":"战国·楚·屈原《九章·怀沙》"}},{"id":36881,"word":"群疑满腹","pinyin":"qún yí mǎn fù","abbr":"qymf","explanation":"群：多；疑：疑问，困惑。形容猜疑心重。","source":{"text":"群疑满腹，众难塞于胸中。","book":"三国·蜀·诸葛亮《后出师表》"},"usage":"作宾语、定语、状语；用于疑问"},{"id":36882,"word":"群盲摸象","pinyin":"qún máng mō xiàng","abbr":"qmmx","explanation":"比喻对事物只凭片面的了解或局部的经验，就乱加猜测，想做出全面的判断。","source":{"text":"其触牙者即言象形如芦菔根，其触耳者言象如箕，其触头者言象如石，其触鼻者言象如杵，其触脚者言象如木臼，其触脊者言象如床，其触腹者言象如甕，其触尾者言象如绳。","book":"《大般涅槃经》三二"}},{"id":36883,"word":"群空冀北","pinyin":"qún kōng jì běi","abbr":"qkjb","explanation":"比喻有才能的人遇到知己而得到提拔。","source":{"text":"伯乐一过冀北之野，而马群遂空。","book":"唐·韩愈《送温处士赴河阳军序》"},"similar":["马空冀北"],"usage":"作定语；指善用人才"},{"id":36884,"word":"群策群力","pinyin":"qún cè qún lì","abbr":"qcql","explanation":"群：大家，集体；策：谋划，主意。指发挥集体的作用，大家一起来想办法，贡献力量。","source":{"text":"汉屈群策，群策屈群力。","book":"汉·扬雄《法言·重黎》"},"example":{"text":"至于自强之道，求其在我，祸福无门，唯人自召。～，庶有成功。","book":"蔡东藩、许廑父《民国通俗演义》第四十四回"},"similar":["同心协力","集思广益","齐心协力"],"opposite":["独断独行","离心离德","三心二意"],"usage":"作谓语、状语；指发挥集体的作用","story":["西汉哲学家扬雄模仿孔子的《论语》写出了一部《法言》，在《法言·重黎》中论述了汉王刘邦与西楚霸王项羽争夺天下胜负的原因。他认为汉王刘邦善于采纳大家的计策，大家的计策又增强了众人的力量，所以他就得天下"]},{"id":36885,"word":"群而不党","pinyin":"qún ér bù dǎng","abbr":"qebd","explanation":"群：合群。与众合群，不结私党。","source":{"text":"君子矜而不争，群而不党。","book":"《论语·卫灵公》"},"example":{"text":"公所枢柅，喜士容物，～。","book":"唐·权德舆《唐丞相太保致仕岐国公杜公墓志铭》"},"usage":"作谓语、定语；指不结私党"},{"id":36886,"word":"群芳争艳","pinyin":"qún fāng zhēng yàn","abbr":"qfzy","explanation":"各种美丽、芳香的花草在比美、斗妍。","source":{"text":"时值仲春，群芳竞艳，百卉争妍。","book":"明·赵弼《青城隐者记》"},"example":{"text":"在这～的季节里，我们要充分把握机会争取冒尖。"},"similar":["百花争艳"],"usage":"作谓语、定语；用于女性及花草等"},{"id":36887,"word":"群芳竞艳","pinyin":"qún fāng jìng yàn","abbr":"qfjy","explanation":"竞：竞争，互相争胜。艳：艳丽。各种花争相开放，互相竞美。","source":{"text":"时值仲春，群芳竞艳，百卉争妍。","book":"《效颦集·青城隐者记》"},"similar":["群芳争艳"],"usage":"作谓语、定语；用于女性及花草等"},{"id":36888,"word":"群英会","pinyin":"qún yīng huì","abbr":"qyh","explanation":"借指英雄人物或先进人物的集会。","source":{"text":"此皆江东之英杰。今日此会，可名‘群英会’。","book":"明·罗贯中《三国演义》第45回"},"example":{"text":"希望全国职工群众用丰硕的成果来迎接新长征中第一次盛大的～。","book":"邓小平《工人阶级要为实现四个现代化作出优异贡献》"},"similar":["群英荟萃"],"usage":"作宾语、定语；指先进人物的集会"},{"id":36889,"word":"群英荟萃","pinyin":"qún yīng huì cuì","abbr":"qyhc","explanation":"英：才能出众的人；荟萃：聚集。许多才能出众的人聚集在一起。","example":{"text":"在这～的时刻，我真是喜不自禁。"},"usage":"作宾语、定语；用于人才辈出"},{"id":36890,"word":"群蚁溃堤","pinyin":"qún yǐ kuì dī","abbr":"qykd","explanation":"溃：溃决。细小的蚁洞可以溃决堤防。比喻细小的漏洞可酿成大的灾难。","source":{"text":"千丈之堤，以蝼蚁之穴溃。","book":"《韩非子·喻志》"},"example":{"text":"始皇虽神圣，国民即微小，准诸足寒伤心，民怨伤国之理，能无～之日耶？","book":"清·陈天华《中国革命史论》"},"usage":"作宾语、定语；用于比喻句"},{"id":36891,"word":"群蚁趋膻","pinyin":"qún yǐ qū shān","abbr":"qyqs","explanation":"膻：羊臊气。比喻许多臭味相投的人聚集在一起。","source":{"text":"国人之慕西风，若群蚁之趋膻。","book":"梁启超《说国风》"},"similar":["群蚁附膻"],"usage":"作宾语、定语；用于臭味相投的人"},{"id":36892,"word":"群蚁附膻","pinyin":"qún yǐ fù shān","abbr":"qyfs","explanation":"附：依附；膻：羊肉的气味。许多蚂蚁趋附羊肉。比喻许多臭味相投的人追求不好的事物。","source":{"text":"羊肉不慕蚁，蚁慕羊肉，羊肉膻也。","book":"《庄子·徐无鬼》"},"example":{"text":"明·程登吉《幼学琼林》第四卷：“鄙众趋利，曰～；谦己爱儿，曰老牛舐犊。”"},"similar":["臭味相投","群蚁趋膻"],"usage":"作宾语、定语；指臭味相投的人"},{"id":36893,"word":"群言堂","pinyin":"qún yán táng","abbr":"qyt","explanation":"能发扬民主作风，让人讲话，倾听群众意见的场所。","example":{"text":"我们这儿是～，不搞一言堂，有意见尽管提。"},"opposite":["一言堂"],"usage":"作宾语、定语；用于口语"},{"id":36894,"word":"群贤毕至","pinyin":"qún xián bì zhì","abbr":"qxbz","explanation":"指贤能者齐集，济济一堂。","source":{"text":"群贤毕至，少长咸集，此地有崇山峻岭，茂林修竹。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"好了！～，少长咸集，快来接着玩咱们的吧！","book":"端木蕻良《曹雪芹》"},"similar":["群贤毕集"],"usage":"作宾语、定语；用于聚会"},{"id":36895,"word":"群贤毕至，少长咸集","pinyin":"qún xián bì zhì，shào zhǎng xián jí","abbr":"qxbzszxj","explanation":"毕：全。各种贤人、老少聚集在一起。","source":{"text":"群贤毕至，少长咸集，此地有崇山峻岭，茂林修竹。","book":"晋·王羲之《兰亭集序》"},"example":{"text":"好了！～，快来接着玩咱们的吧！","book":"端木蕻良《曹雪芹》"},"similar":["群贤毕至"],"usage":"作宾语、定语；用于聚会"},{"id":36896,"word":"群贤毕集","pinyin":"qún xián bì jí","abbr":"qxbj","explanation":"毕：全。各种贤人聚集在一起。","source":{"text":"今日群贤毕集，正当‘所言公则公言之’。","book":"清·李绿园《歧路灯》第五回"},"similar":["群贤毕至"],"usage":"作宾语、定语；用于聚会"},{"id":36897,"word":"群起攻之","pinyin":"qún qǐ gōng zhī","abbr":"qqgz","explanation":"群：众人；攻：攻击。大家都起来攻击它，反对它。","source":{"text":"非吾徒也，小子鸣鼓而攻之可也。","book":"《论语·先进》"},"example":{"text":"不多两日，杨愕的回信来，说是这其中一定有人播弄，务要探听明白，～，方是正办。","book":"清·吴趼人《糊涂世界》第十一回"}},{"id":36898,"word":"群起攻击","pinyin":"qún qǐ gōng jī","abbr":"qqgj","explanation":"很多人一起反对、指责。","source":{"text":"若其大臣而有假制诏以为护符者耶，则举国群起而攻之。","book":"梁启超《违制论》"},"example":{"text":"对于这种坏人坏事，我们要～。"},"similar":["群起而攻之"],"usage":"作谓语、定语、宾语；指集体反对"},{"id":36899,"word":"群起效尤","pinyin":"qún qǐ xiào yóu","abbr":"qqxy","explanation":"大家一起向坏的学习。","source":{"text":"恐此子效尤，干那结交权党，势压班僚，丧失名节的事，岂不辱我一门清白？","book":"《二度梅全传》"},"example":{"text":"这些坏作风应该根除，以免群起效尤。"},"usage":"作谓语、宾语；用于处事"},{"id":36900,"word":"群起而攻之","pinyin":"qún qǐ ér gōng zhī","abbr":"qqegz","explanation":"大家都起来攻击它，反对它。","source":{"text":"非吾徒也，小子鸣鼓而攻之可也。","book":"《论语·先进》"},"example":{"text":"他品行恶劣，难怪大家会～，他这是咎由自取。"},"similar":["群起攻击"],"usage":"作宾语、分句；指集体反对"},{"id":36901,"word":"群轻折轴","pinyin":"qún qīng zhé zhóu","abbr":"qqzz","explanation":"轻的东西积多了，也能压断车轴。比喻听任小的坏事发展下去，也能造成严重后果。","source":{"text":"臣闻积羽沉舟，群轻折轴，众口铄金，故愿大王之熟计之也。","book":"《战国策·魏策一》"},"example":{"text":"～，下沈黄泉，众毛飞骨，上凌青天。","book":"唐·李白《雪谗诗赠友人》"},"similar":["积羽沉舟"],"usage":"作宾语；比喻小患会酿成大祸"},{"id":36902,"word":"群雄逐鹿","pinyin":"qún xióng zhú lù","abbr":"qxzl","explanation":"群雄：旧指许多有军事势力的人。逐鹿：比喻争夺帝王之位。形容各派势力争夺最高统治地位。","source":{"text":"秦失其鹿，天下共逐之。","book":"西汉·司马迁《史记·淮阴侯列传》"},"example":{"text":"福建形成了～的混乱局面。","book":"陶菊隐《北洋军阀统治时期史话》第58章"},"usage":"作宾语、定语；用于斗争"},{"id":36903,"word":"群雌粥粥","pinyin":"qún cí yù yù","abbr":"qcyy","explanation":"原形容鸟儿相和而鸣。后形容在场的妇女众多，声音嘈杂。","source":{"text":"当东而西，当啄而飞。随飞随啄，群雌粥粥。","book":"唐·韩愈《琴操·雉朝飞》"},"example":{"text":"今虽充位之臣，～，而寸心许可者，卒无一人。","book":"清·袁枚《与书巢书》"},"usage":"作谓语、补语；形容在场的妇女众多"},{"id":36904,"word":"群魔乱舞","pinyin":"qún mó luàn wǔ","abbr":"qmlw","explanation":"成群的魔鬼乱跳乱蹦。比喻一批坏人在政治舞台上猖狂活动。","source":{"text":"在乌云密布群魔乱舞的日子里，为了纯朴的老农，昂首挺立，用自己的行动为人们谱写了一首悲壮的正气之歌！","book":"穆青《为了周总理的嘱托》"},"example":{"text":"社会动荡，～的时代一去不复返了。"},"similar":["牛鬼蛇神","胡作非为"],"opposite":["乐善好施"],"usage":"作谓语、定语；用于政治舞台"},{"id":36905,"word":"群鸿戏海","pinyin":"qún hóng xì hǎi","abbr":"qhxh","explanation":"鸿：鸿雁；海：指大湖。象许多飞鸿在大湖里游戏一样。形容书法遒劲灵活。","source":{"text":"钟繇书如云鹄游天，群鸿戏海。","book":"南朝·梁·萧衍《古今书人优劣评》"},"example":{"text":"王羲之书如～。","book":"唐·张彦远《法书要录》"},"usage":"作宾语、定语；用于书法等"},{"id":36906,"word":"群龙无首","pinyin":"qún lóng wú shǒu","abbr":"qlws","explanation":"一群龙没有领头的。比喻没有领头的，无法统一行动。","source":{"text":"用九，见群龙无首，吉。","book":"《易·乾》"},"example":{"text":"可是～，成不了大气候。","book":"姚雪垠《李自成》第一卷第三十一章"},"similar":["各自为政","乌合之众"],"opposite":["一呼百应"],"usage":"作谓语、定语、补语；指乌合之众"},{"id":36907,"word":"羯鼓催花","pinyin":"jié gǔ cuī huā","abbr":"jgch","explanation":"羯鼓：两面蒙皮，腰部较细的一种鼓。敲击羯鼓，使杏花早开。","source":{"text":"此一事，不唤我作天公可乎？","book":"唐·南卓《羯鼓录》载：唐玄宗喜好羯鼓，曾经在内庭击鼓，并且自己做了一曲《春光好》。当时正赶上庭中杏花开放，唐玄宗笑着说"},"example":{"text":"惟将～，赐得貂裘拖地。","book":"明·陆采《明珠记·巡陵》"},"usage":"作宾语、定语；用于书面语","story":["唐朝人南卓写的《羯鼓录》中记载：唐玄宗十分喜好羯鼓，一次在内庭击鼓作乐，并且自己做了一曲《春光好》。当时正赶上庭中杏花开放，唐玄宗笑着说：“此一事，不唤我作天公可乎？”"]},{"id":36908,"word":"羯鼓解秽","pinyin":"jié gǔ jiě huì","abbr":"jgjh","explanation":"羯鼓：两面蒙皮，腰部较细的一种鼓；解秽：除去脏物。敲击羯鼓，以解除不快。指用自己喜欢的事物来解除不快的情绪。","source":{"text":"速召花奴，将羯鼓来，为我解秽。","book":"唐·南卓《羯鼓录》"},"example":{"text":"我也要掉句文哩，耘老听着，竟是洗盏更酌，浇浇我的块垒，强似那～。","book":"清·李绿园《歧路灯》第三十九回"}},{"id":36909,"word":"羲皇上人","pinyin":"xī huáng shàng rén","abbr":"xhsr","explanation":"羲皇：传说中的古帝王伏羲氏。伏羲氏以前的人，即太古的人。比喻无忧无虑，生活闲适的人。","source":{"text":"常言五六月中，北窗下卧，遇凉风暂至，自谓是羲皇上人。","book":"晋·陶潜《与子俨等疏》"},"example":{"text":"他们和外界毫无交涉，也不受别民族的影响，还是原始的状态，真不愧所谓“～”。","book":"鲁迅《热风·人心很古》"},"usage":"作宾语；指无忧无虑的人"},{"id":36910,"word":"羸形垢面","pinyin":"léi xíng gòu miàn","abbr":"lxgm","explanation":"羸：瘦弱；形：身体；垢：肮脏。瘦弱的身体，肮脏的外表。形容穷苦不堪的样子。","source":{"text":"羸形垢面，躬负薪莸。","book":"《南岳弥陀和尚碑》"},"similar":["蓬头垢面"],"usage":"作谓语、定语、宾语；指人贫穷"},{"id":36911,"word":"羹墙之思","pinyin":"gēng qiáng zhī sī","abbr":"gqzs","explanation":"羮：羮汤；墙：墙壁；思：思念。从墙壁上，从羮汤中能看到所思慕人的影子。比喻对先贤的思慕。","source":{"text":"昔尧殂之后，舜仰慕三年，坐则见尧于墙，食则睹尧于羹。斯所谓聿追来孝，不失臣子之节也。","book":"《后汉书·李固传》"},"example":{"text":"而奏书之速，不淹三时，上足以慰～，下足以厌荐绅之望，非独此数人者毕精竭思之力也。","book":"宋·陆游《除修史上殿札子》"}},{"id":36912,"word":"羹藜含糗","pinyin":"gēng lí hán qiǔ","abbr":"glhq","explanation":"藜：野菜。泛指饮食粗劣。","source":{"text":"越公以《食经》遗子，子不受，曰：‘羹藜含糗，无所用也。’","book":"隋·王通《中说·王道》"},"example":{"text":"明·程登吉《幼学琼林》第三卷：“甘脆肥脓，命曰腐肠之药；～难语太牢之滋。”"},"similar":["羹藜唅糗"],"opposite":["山珍海味"],"usage":"作宾语、定语；指饮食粗劣"},{"id":36913,"word":"羹藜唅糗","pinyin":"gēng lí hán qiǔ","abbr":"glhq","explanation":"藜，野菜；唅，食也。泛指饮食粗劣。亦作“羹藜含糗”。","source":{"text":"羹藜唅糗者，不足与论太牢之滋味。","book":"《文选·王褒〈圣主得贤臣颂〉》"},"example":{"text":"越公以《食经》遗子，子不受，曰：“羹藜含糗，无所用也。”","book":"隋王通《中说·王道》"},"similar":["羹藜含糗"],"opposite":["山珍海味"],"usage":"作宾语、定语；指饮食粗劣"},{"id":36914,"word":"羽化登仙","pinyin":"yǔ huà dēng xiān","abbr":"yhdx","explanation":"变成神仙而升天了。指人死了。也比喻飘洒脱俗。","source":{"text":"浩浩乎如冯虚御风，而不知其所止；飘飘乎如遗世独立，羽化而登仙。","book":"宋·苏轼《前赤壁赋》"},"example":{"text":"后来召忻、高粱都～，其族盛于天下。","book":"清·俞万春《荡寇志》第一百三十回"},"similar":["羽化飞天"],"usage":"作谓语、定语；用于书面语"},{"id":36915,"word":"羽化飞天","pinyin":"yǔ huà fēi tiān","abbr":"yhft","explanation":"指化仙而升天。也比喻飘洒脱俗。","source":{"text":"至于化金销玉，行符敕水，奇方妙术，万等千条，上云羽化飞天，次称消灾灭祸。","book":"《魏书·释老志》"},"similar":["羽化登仙"],"usage":"作谓语、定语；用于书面语"},{"id":36916,"word":"羽扇纶巾","pinyin":"yǔ shàn guān jīn","abbr":"ysgj","explanation":"羽扇：羽毛扇子；纶巾：古代一种配有青丝带的头巾。拿着羽毛扇子，戴着青丝绶的头巾。形容态度从容。","source":{"text":"武侯与宣王泊兵，将战，宣王戎服莅事，使人密觇武侯，乃乘素舆葛巾，持白羽扇指麾，三军随其进止。","book":"南朝·梁·殷芸《小说》"},"example":{"text":"～谈笑间，樯橹灰飞烟灭。","book":"宋·苏轼《念奴娇·赤壁怀古》词"},"similar":["纶巾羽扇"],"usage":"作宾语、定语；形容态度从容"},{"id":36917,"word":"羽换宫移","pinyin":"yǔ huàn gōng yí","abbr":"yhgy","explanation":"羽、宫：古代五声音阶的第五第一音级。指乐曲变调。也指事物的内容已经发生变化。","source":{"text":"知音见说无双，解移宫换羽，未怕周郎。","book":"宋·周邦彦《意难忘·美人》词"}},{"id":36918,"word":"羽旄之美","pinyin":"yǔ máo zhī měi","abbr":"ymzm","explanation":"装饰着羽毛的旗子飘动的状观景象。","source":{"text":"百姓闻王车马之声，见羽旄之美。","book":"战国·邹·孟轲《孟子·梁惠王下》"},"usage":"作宾语；指场面大"},{"id":36919,"word":"羽檄交驰","pinyin":"yǔ xǐ jiāo chí","abbr":"yxjc","explanation":"羽檄：插上鸟羽的紧急文书。比喻军情紧急。","source":{"text":"于羽檄交驰之际，不敢忘学，学成而兵有功，治有绩，则余安得不为立言，以劝夫为政而不知学者耶。","book":"宋·张孝祥《衡州新学记》"},"similar":["羽檄飞驰"],"usage":"作宾语、定语；用于书面语"},{"id":36920,"word":"羽檄飞驰","pinyin":"yǔ xǐ fēi chí","abbr":"yxfc","explanation":"羽檄：插上鸟羽的紧急文书。比喻军情紧急。","source":{"text":"贺兰山下阵如云，羽檄交驰日夕闻。","book":"《三国志·蜀志·费祎传》：“于时羽檄交驰，人马擐甲，严驾已讫。”唐·王维《老将行》"},"example":{"text":"虽曰今暂无事，未也，安知其不一日～，以济王为辞，以讨君侧之恶为名？","book":"《宋史·邓若水传》"},"similar":["羽檄交驰"],"usage":"作宾语、定语；用于书面语"},{"id":36921,"word":"羽毛丰满","pinyin":"yǔ máo fēng mǎn","abbr":"ymfm","explanation":"小鸟的羽毛已经长全。比喻已经成熟或实力已强大。","source":{"text":"而彼林木丛杂中，有羽毛丰满而栖于奥援者，令人可望而不可即。","book":"清·无名氏《杜诗言志》卷十二"},"example":{"text":"倘若河洛不保，坐看李自成～，以后的事就不堪设想了。","book":"姚雪垠《李自成》第二卷第五十一章"},"similar":["孔武有力","兵强马壮","人多势众"],"opposite":["羽毛未丰","乳臭未干","少不更事"],"usage":"作谓语、定语、宾语；指成熟","story":["西汉时期，刘邦当上皇帝后立吕后的儿子刘盈为太子，因为宠幸戚夫人而想改立刘如意为太子。吕后请张良出主意，张良让太子刘盈请出商山四位贤士。刘邦看到太子有商山四贤辅佐，羽翼已成，也就打消另立太子的念头"]},{"id":36922,"word":"羽毛已丰","pinyin":"yǔ máo yǐ fēng","abbr":"ymyf","explanation":"小鸟的羽毛已经长全。比喻已经成熟或实力已强大。","source":{"text":"形体肥大，羽毛丰茂。","book":"《管子·水池》"}},{"id":36923,"word":"羽毛未丰","pinyin":"yǔ máo wèi fēng","abbr":"ymwf","explanation":"丰：丰满。指小鸟没长成，身上的毛还很稀疏。比喻年纪轻，经历少，不成熟或力量还不够强大。","source":{"text":"寡人闻之，毛羽不丰满者不可以高飞。","book":"《战国策·秦策一》"},"example":{"text":"但这好像“中日亲善，同存共荣”之说，从～的无产者看来，是一种欺骗。","book":"鲁迅《二心集·“硬译”与“文学的阶级性”》"},"similar":["乳臭未干","少不更事","涉世不深"],"opposite":["羽毛丰满","兵强马壮","国富民强"],"usage":"作谓语、定语、补语；指未成熟","story":["战国时期，洛阳人苏秦曾向鬼谷子学习辩术与谋略，他周游列国，游说他的政治观点。他到秦国游说秦王，希望他与六国联盟。秦惠王有吞并六国的野心，根本不接受他的观点，说苏秦是一个羽毛未丰的小鸟，是不能成大事的"]},{"id":36924,"word":"羽翮已就","pinyin":"yǔ hé yǐ jiù","abbr":"yhyj","explanation":"比喻已得到辅佐之人，势力已壮大。","source":{"text":"鸿鹄高飞，一举千里，羽翮已就，横绝四海。","book":"《史记·留侯世家》"},"similar":["羽毛丰满","羽翼已成"],"usage":"作谓语、定语；用于书面语"},{"id":36925,"word":"羽翮飞肉","pinyin":"yǔ hé fēi ròu","abbr":"yhfr","explanation":"指鸟羽扇翼而使身体飞翔。比喻集轻微之力可撼举重物。","source":{"text":"丛轻折轴，羽翮飞肉。","book":"《汉书·景十三王传》"},"usage":"作宾语、定语；用于比喻句"},{"id":36926,"word":"羽翼丰满","pinyin":"yǔ yì fēng mǎn","abbr":"yyfm","explanation":"小鸟的羽毛已经长全。比喻已经成熟或实力已强大。","source":{"text":"形体肥大，羽毛丰茂。","book":"《管子·水池》"},"example":{"text":"待～以后，再甩开他们干也不是不可以。","book":"毕淑敏《预约财富》"},"similar":["羽毛丰满"],"usage":"作谓语、定语、宾语；指成熟"},{"id":36927,"word":"羽翼已成","pinyin":"yǔ yì yǐ chéng","abbr":"yyyc","explanation":"羽翼：鸟的翅膀。鸟的羽毛和翅膀已长全。比喻力量已经巩固。","source":{"text":"多欲易之，彼四人辅之。羽翼已成，难动也。","book":"《史记·留侯世家》"},"example":{"text":"今数省大寇，环聚二三百里，～，将有不可言者。","book":"明·张岱《石匮书后集·中原群盗列传》"},"similar":["羽毛丰满"],"opposite":["羽毛未丰"],"usage":"作谓语、定语；比喻力量已经具备","story":["西汉时期，刘邦当上皇帝后立吕后的儿子刘盈为太子，因为宠幸戚夫人而想改立刘如意为太子。吕后请张良出主意，张良让太子刘盈请出商山四位贤士。刘邦看到太子有商山四贤辅佐，羽翼已成，也就打消另立太子的念头"]},{"id":36928,"word":"羽翼既成","pinyin":"yǔ yì jì chéng","abbr":"yyjc","explanation":"小鸟的羽毛已经长成了。比喻势力已经强大起来。","source":{"text":"我欲易之，彼四人辅之。羽翼已成，难动矣。","book":"《史记·留侯世家》"},"example":{"text":"党与既立，～，是以敢肆狂言，以动朝听。","book":"宋·苏辙《论西事状》"},"similar":["羽翼已成"],"usage":"作谓语、定语；比喻力量已经具备"},{"id":36929,"word":"羽衣蹁跹","pinyin":"yǔ yī piān xiān","abbr":"yypx","explanation":"羽衣：羽毛织成的衣服；蹁跹：舞姿美妙。身穿羽毛绣衣，举步轻盈飘逸。指道士或神仙赶路的神态。也形容舞姿优美。","source":{"text":"梦一道士，羽衣蹁跹，过临皋之下，揖予而言。","book":"宋·苏轼《后赤壁赋》"},"example":{"text":"那白鹤～，扶摇直上，长足在风中飘扬。","book":"余光中《焚鹤人》"},"usage":"作谓语、定语；用于书面语"},{"id":36930,"word":"羽觞随波","pinyin":"yǔ shāng suí bō","abbr":"yssb","explanation":"羽觞：鸟雀形状的酒器。用鸟雀形的酒杯装满了酒在水上随波漂流。比喻人的闲情逸致。","source":{"text":"昔周公城洛邑，因流水以泛酒，故逸诗云‘羽觞随波’。","book":"《晋书·束晳传》"},"example":{"text":"《晋书·束晳传》：“昔周公城洛邑，因流水以泛酒，故逸诗云‘羽觞随波’。”"}},{"id":36931,"word":"羽蹈烈火","pinyin":"yǔ dǎo liè huǒ","abbr":"ydlh","explanation":"比喻不自量力而自取灾祸。","source":{"text":"若以桀诈尧，譬之若以卵投石，若以指绕沸，入则焦没耳。","book":"汉·刘向《新序·杂事三》"},"usage":"作宾语、定语；用于比喻句"},{"id":36932,"word":"羿射九日","pinyin":"yì shè jiǔ rì","abbr":"ysjr","explanation":"形容为民除害的英勇行为。","source":{"text":"羿射九日。","book":"西汉·刘安《淮南子》"},"example":{"text":"神话中的许多变化，例如《山海经》中所说的‘夸父追日’，《淮南子》中所说的‘～’，……","book":"毛泽东《矛盾论》"},"similar":["后羿射日"],"usage":"作宾语、定语；指为民除害","story":["传说古代尧帝统治时期，天上有十个太阳轮流出来。由于太阳之间发生了矛盾，他们同时出来，地上的树木庄稼都晒色了，老百姓都快要饿死。尧帝让嫦娥的丈夫后羿用弓箭去射太阳。后羿使出浑身的力气，射掉了其中9个，只留下现在的一个太阳"]},{"id":36933,"word":"羿氏舛射","pinyin":"yì shì chuǎn shè","abbr":"yscs","explanation":"羿氏：夏代有穷国的君主，善于射箭；舛：差错。羿射箭出来差错。指有才华的人也会有失误","source":{"text":"帝羿有穷氏从吴贺北游。驾使羿射雀左目，误中右目。羿俯首而愧，终身不忘。","book":"晋·皇甫谧《帝王世纪》"},"example":{"text":"南朝·梁·刘勰《文心雕龙·指瑕》：“～，东野败驾，虽有隽才，谬则多谢。”"},"usage":"作宾语、定语；用于书面语"},{"id":36934,"word":"翔鸾翥凤","pinyin":"xiáng luán zhù fèng","abbr":"xlzf","explanation":"鸾：传说中凤凰一类的鸟；翥：飞举。凤凰展翅高飞。比喻富丽的文辞。","source":{"text":"有志客，必取文章价，翔鸾翥凤人终爱，黄金白璧时终在。","book":"明·孙柚《琴心记·相偕抵舍》"},"usage":"作宾语、定语；用于比喻句"},{"id":36935,"word":"翔鸾舞凤","pinyin":"xiáng luán wǔ fèng","abbr":"xlwf","explanation":"鸾：传说中凤凰一类的鸟。凤凰翩翩起舞。比喻书画用笔生动矫健。","source":{"text":"字画飞动如翔鸾舞凤，非世间笔也。","book":"宋·周紫芝《竹坡诗话》第三卷"},"usage":"作宾语、定语；用于比喻句"},{"id":36936,"word":"翘尾巴","pinyin":"qiào wěi bā","abbr":"qwb","explanation":"翘：向上昂起。比喻骄傲或自鸣得意。","source":{"text":"一万年也不要骄傲，永远不要翘尾巴。","book":"毛泽东《关于中华人民共和国宪法草案》"},"example":{"text":"王朔《千万别把我当人》：“我现在更担心的是唐元豹～。”"},"similar":["骄傲自满"],"usage":"作谓语、宾语；指自鸣得意"},{"id":36937,"word":"翘足企首","pinyin":"qiáo zú qǐ shǒu","abbr":"qzqs","explanation":"翘足：抬起脚。抬起脚仰着头。形容殷切盼望。","source":{"text":"吾见憾者方在燕市，而庆者已翘足企首相望江淮之间矣。","book":"清·汪琬《送王进士之任扬州序》"},"similar":["翘首企足"],"usage":"作谓语、状语；用于期盼"},{"id":36938,"word":"翘足可待","pinyin":"qiào zú kě dài","abbr":"qzkd","explanation":"翘足：抬起脚。一举足的时间内即可等到。比喻很快就能实现。","source":{"text":"种种危亡，翘足可待，又安有扫荡廓清之日。","book":"清·夏燮《中西纪事·庚申换约之役》"},"similar":["翘足而待","翘首可待"],"usage":"作谓语；比喻很快就能实现"},{"id":36939,"word":"翘足引领","pinyin":"qiáo zú yǐn lǐng","abbr":"qzyl","explanation":"踮塌郐，伸长脖子。形容盼望殷切。","source":{"text":"是以立功之士，莫不翘足引领，望内响应。","book":"三国魏·陈琳《檄吴将校部曲文》"},"similar":["翘首引领"],"usage":"作谓语；形容盼望殷切"},{"id":36940,"word":"翘足而待","pinyin":"qiáo zú ér dài","abbr":"qzed","explanation":"踮起脚等待。比喻很快就能实现。","source":{"text":"大臣内叛，诸侯外反，亡，可翘足而待也。","book":"《史记·高祖本纪》"},"example":{"text":"政出圣主，天下太平，可～也。","book":"《后汉书·陈球传》"},"similar":["转瞬之间","翘足可待"],"usage":"作谓语；比喻很快就能实现"},{"id":36941,"word":"翘辫子","pinyin":"qiào biàn zǐ","abbr":"qbz","explanation":"清代男人也梳辫子，刽子手杀人时要把辫子提起，翘辫子指杀头。借指死亡。","example":{"text":"等她～时，子女们就会争夺财产了。"},"similar":["呜呼哀哉"],"usage":"作谓语、定语；指杀头，用于口语"},{"id":36942,"word":"翘首以待","pinyin":"qiáo shǒu yǐ dài","abbr":"qsyd","explanation":"翘首：抬起头。形容殷切盼望。","source":{"text":"李缅宁赶到公共汽车站，车已停稳，开了前后车门上下客。他挤在人堆里翘首以待。","book":"王朔《无人喝彩》"},"example":{"text":"我们～她的好消息吧。"},"similar":["翘首跂踵","翘首引领"],"usage":"作谓语、状语；用于期盼"},{"id":36943,"word":"翘首企足","pinyin":"qiáo shǒu qǐ zú","abbr":"qsqz","explanation":"仰起头，踮起脚。形容盼望殷切。","source":{"text":"是以立功之士，莫不翘足引领，望内响应。","book":"三国·魏·陈琳《檄吴将校部曲文》"},"example":{"text":"但～，以待结褵之期，不计其他也。","book":"明·瞿佑《剪灯新话·秋香亭记》"},"similar":["翘首以待","翘足企首"],"usage":"作谓语、状语；用于期盼"},{"id":36944,"word":"翘首引领","pinyin":"qiáo shǒu yǐn lǐng","abbr":"qsyl","explanation":"仰起头，伸长脖子。形容盼望殷切。","source":{"text":"廆虽限以山海，隔以羯寇，翘首引领，系心京师。","book":"三国·魏·陈琳《檄吴将校部曲文》：“是以立功之士，莫不翘足引领，望内响应。”晋·封抽《上疏陶侃府请封慕容廆为燕王》"},"similar":["翘首以待","翘足引领"],"usage":"作谓语、定语、状语；用于处事"},{"id":36945,"word":"翘首跂踵","pinyin":"qiáo shǒu qǐ zhǒng","abbr":"qsqz","explanation":"翘首：抬起头。抬起头踮起脚。形容殷切盼望。","source":{"text":"天下之士翘首跂踵，冀阁下日以忠言摩上，不谓若今之为起居舍人者，止司记录而已也。","book":"宋·王明清《挥麈三录》第一家"},"similar":["翘首以待","翘首企足"],"usage":"作谓语、状语；用于期盼"},{"id":36946,"word":"翠围珠绕","pinyin":"cuì wéi zhū rào","abbr":"cwzr","explanation":"翠：翡翠；珠：珍珠。形容富家女子的华丽装饰。亦比喻随从侍女众多。","source":{"text":"听一派凤管鸾箫，见一簇翠围珠绕。","book":"明·兰陵笑笑生《金瓶梅词话》第四十六回"},"similar":["翠围珠裹","翠绕珠围"],"usage":"作谓语、定语；形容富家女子的华丽装饰"},{"id":36947,"word":"翠围珠裹","pinyin":"cuì wéi zhū guǒ","abbr":"cwzg","explanation":"形容富家女子的华丽装饰。亦比喻随从侍女众多。同“翠绕珠围”。","source":{"text":"这西门口一带地方，有多少翠围珠裹，身娇肉贵的姑娘，却偏偏都没有长好，单单何家一个丫头，长得这么好，好得出奇。","book":"欧阳山《苦斗》四二"},"similar":["翠围珠绕"],"usage":"作谓语、定语；形容富家女子的华丽装饰"},{"id":36948,"word":"翠尘珠坱","pinyin":"cuì chén zhū yǎng","abbr":"cczy","explanation":"指珠翠落于尘土。比喻人才被湮没。","source":{"text":"彩凤晓衔丹诏往，青鸾远降赐戎王。一霎宫闱，万端悲怆，忍使翠尘珠坱。","book":"明·陈与郊《昭君出塞》"},"similar":["埋没人才"],"usage":"作谓语、宾语；指埋没人才"},{"id":36949,"word":"翠消红减","pinyin":"cuì xiāo hóng jiǎn","abbr":"cxhj","explanation":"形容女子姿容减退。","source":{"text":"对潇潇暮雨洒江天，一番洗清秋。渐霜风凄紧，关河冷落，残照当楼。是处红衰翠减，苒苒物华休。惟有长江水，无语东流。","book":"宋·柳永《八声甘州》词"},"example":{"text":"～乱如麻，隔妆台慵梳掠，掩菱花。","book":"元·李子昌《梁州令》"},"opposite":["风华正茂"],"usage":"作谓语、定语；指女性"},{"id":36950,"word":"翠竹黄花","pinyin":"cuì zhú huáng huā","abbr":"czhh","explanation":"指眼前境物。","source":{"text":"迷人不知法身无象，应物现形，遂唤青青翠竹，总是法身；郁郁黄华，无非般若。黄华若是般若，般若即同无情；翠竹若是法身，法身即同草木。","book":"宋·释道原《景德传灯录·慧海禅师》"}},{"id":36951,"word":"翠纶桂饵","pinyin":"cuì lún guì ěr","abbr":"clge","explanation":"翠纶：用翡翠鸟毛做的钓鱼线；桂饵：用桂花做的鱼食。比喻过分追求华美，收不到应有的效果，而适得其反。","source":{"text":"鱼人有好钓者，以桂为饵，黄金之钩，错以银碧，垂翡翠之纶，其持竿处位即是，然其得命不几矣。故曰钓之务不在芳饰，事之急不在辩言。","book":"《阙子》"},"example":{"text":"固知～，反所以失鱼。","book":"南朝·梁·刘勰《文心雕龙·情采》"},"usage":"作宾语、定语；用于处事","story":["传说古代鲁国有一个特别喜欢钓鱼的人，他用桂花做鱼饵，他的钓竿用黄金做鱼钩，用白银做鱼漂和坠子，用翡翠鸟的羽毛做钓线，钓竿十分奢华，可是拿到水里去钓鱼，一天也钓不上一条鱼"]},{"id":36952,"word":"翠绕珠围","pinyin":"cuì rào zhū wéi","abbr":"crzw","explanation":"珠：珍珠；翠：翡翠。形容妇女妆饰华丽。也形容富贵人家随侍的女子众多。","source":{"text":"金妆锦砌，翠绕珠围，卧铺绣褥酿春光。","book":"元·曾瑞《哨遍·麈腰》套曲"},"example":{"text":"身本是，～一宦家。","book":"清·嬴宗季女《六月霜·负笈》"},"similar":["翠围珠绕","翠围珠裹"],"usage":"作谓语、定语；形容富家女子的华丽装饰"},{"id":36953,"word":"翠羽明垱","pinyin":"cuì yǔ míng dàng","abbr":"cymd","explanation":"泛指珍贵的饰物。同“翠羽明珠”。","source":{"text":"十娘叫公子抽第一层来看，只见翠羽明垱，瑶簪宝珥，充牣于中，约值数百金。","book":"明·冯梦龙《警世通言》第三十二卷"},"example":{"text":"～，唤醒钧天之梦；清歌妙舞，招还祖国之魂：美洲三色之旗，其飘飘出现于梨园革命军乎！","book":"柳亚子《〈二十世纪大舞台〉发刊词》"}},{"id":36954,"word":"翠羽明珠","pinyin":"cuì yǔ míng zhū","abbr":"cymz","explanation":"泛指珍贵的饰物。","source":{"text":"聚翠羽明珠三市满，楼观涌、参差金碧。","book":"宋·张孝祥《二郎神·七夕》词"},"similar":["翠羽明珰"],"usage":"作主语、宾语、定语；用于生活"},{"id":36955,"word":"翠羽明珰","pinyin":"cuì yǔ míng dāng","abbr":"cymd","explanation":"翠羽：翡翠鸟的羽毛；珰：耳饰。比喻珍贵的物品或富家女子的华丽饰品。","source":{"text":"十娘叫公子抽第一层来看，只见翠羽明珰，瑶簪宝珥，充牣于中，约值数百金。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"example":{"text":"～，唤醒钧天之梦；清歌妙舞，招还祖国之魂。","book":"柳亚子《发刊词》"},"similar":["翠羽明珠"],"usage":"作主语、宾语、定语；用于生活"},{"id":36956,"word":"翠色欲流","pinyin":"cui se yu liu","abbr":"csyl","explanation":"颜色非常苍翠郁郁葱葱像水一样要流出来一般。 (也称“翠色欲滴”) 欲：像要；几乎；好象。形容颜色鲜绿，如同林间小溪一样似乎要流动起来的样子。"},{"id":36957,"word":"翠袖红裙","pinyin":"cuì xiù hóng qún","abbr":"cxhq","explanation":"泛指妇女的服装。亦用为妇女的代称。","source":{"text":"总然你富才华，高名分，谁不爱翠袖红裙。","book":"元·戴善夫《风光好》第三折"},"usage":"作宾语、定语；借指妇女"},{"id":36958,"word":"翠被豹舄","pinyin":"cuì pī bào xì","abbr":"cbbx","explanation":"以翡翠羽为背帔，以豹皮为履。指生活奢侈。被，同“帔”。","source":{"text":"王皮冠，秦复陶，翠被，豹舄。","book":"《左传·昭公十二年》"},"example":{"text":"楚之兴也，筚路蓝缕；其衰也，～。国家之兴衰，视其俭侈而已。","book":"宋·王应麟《困学纪闻·左氏》"},"opposite":["筚路蓝缕"],"usage":"作宾语、定语；用于生活"},{"id":36959,"word":"翥凤翔鸾","pinyin":"zhù fèng xiáng luán","abbr":"zfxl","explanation":"盘旋飞举的凤凰。常比喻美妙的舞姿。","source":{"text":"舞所以导人沉滞，故春风起于筵上，夜有聚于楼头，古有翥凤翔鸾，萦尘集羽，折腰翘袖，《激楚》《阳阿》，俱要俯仰应声，抑扬合节。","book":"明梁辰鱼《浣纱记·演舞》"},"usage":"作宾语、定语；指舞姿"},{"id":36960,"word":"翦爪断发","pinyin":"jiǎn zhǎo duàn fà","abbr":"jzdf","explanation":"翦：同“剪”。原指古人占卜祭祀时剪掉头发，断掉脚趾来代替身体作牺牲品。后用以表示用极为虔诚的方法祈雨。","source":{"text":"汤乃剪爪断发，自以为牲，而祷于桑林之社，而雨大至，方数千里。","book":"《尚书大传》卷二"}},{"id":36961,"word":"翦纸招魂","pinyin":"jiǎn zhǐ zhāo hún","abbr":"jzzh","explanation":"翦：同“剪”。剪纸为幡，为受惊者、病人或死去的人召唤魂灵。这是一种迷信习俗。","source":{"text":"暖汤濯我足，剪纸招我魂。","book":"唐·杜甫《彭衙行》"},"example":{"text":"～，采蘅设祭。","book":"清·颐道居士《湘烟小录·紫湘诔》"}},{"id":36962,"word":"翦草除根","pinyin":"jiǎn cǎo chú gēn","abbr":"jccg","explanation":"翦：“剪”的异体字，割断。割草要把草根彻底除掉。比喻除去祸根，不留后患。","source":{"text":"抽薪止沸，剪草除根。","book":"北齐·魏收《为侯景叛移梁潮文》"},"example":{"text":"他若不来，你却莫怪，他若来了，定与你～。","book":"明·吴承恩《西游记》第18回"},"similar":["剪草除根","斩尽杀绝"],"opposite":["放虎归山"],"usage":"作谓语；比喻除去祸根，不留后患"},{"id":36963,"word":"翩翩公子","pinyin":"piān piān gōng zǐ","abbr":"ppgz","explanation":"旧时对风流而有文采的富贵子弟的誉称。","source":{"text":"齐人进奇乐，歌者出西秦，翩翩我公子，机巧忽若神。","book":"三国·魏·曹植《侍太子坐》诗"},"example":{"text":"到了次日，北侠扮作个赳赳的武夫，智化扮作个～，各自佩了利刃一把，找了个买卖渡船。","book":"清·石玉昆《三侠五义》第一百十二回"},"similar":["翩翩少年"],"usage":"作宾语、定语；用于书面语"},{"id":36964,"word":"翩翩少年","pinyin":"piān piān shào nián","abbr":"ppsn","explanation":"翩翩：形容举止洒脱。形容言谈举止洒脱的青年男子。","source":{"text":"平原君翩翩浊世之佳公子也。","book":"《史记·平原君虞卿列传》"},"example":{"text":"对面突然来了两个～，她一时手足无措"},"usage":"作宾语、定语；用于书面语"},{"id":36965,"word":"翩翩年少","pinyin":"piān piān nián shǎo","abbr":"ppns","explanation":"比喻男子年少俊秀，文采风流。","example":{"text":"回想当年他～，不知有多少女孩子为他倾倒。"}},{"id":36966,"word":"翩翩自乐","pinyin":"piān piān zì lè","abbr":"ppzl","explanation":"翩：唐书地飞；翩翩：轻快地跳舞。形容欣喜自得的样子。","source":{"text":"翩翩然有以自乐也。","book":"晋·张华《鹪鹩赋》"}},{"id":36967,"word":"翩翩起舞","pinyin":"piān piān qǐ wǔ","abbr":"ppqw","explanation":"形容轻快地跳起舞来。","source":{"text":"翩翩舞广袖，似鸟海东来。","book":"唐·李白《高句骊》"},"example":{"text":"舞池内一对对情侣在～。"},"similar":["载歌载舞","手舞足蹈"],"usage":"作谓语、定语；用于描写舞姿"},{"id":36968,"word":"翩翩跹跹","pinyin":"piān piān xiān xiān","abbr":"ppxx","explanation":"形容轻快地旋转舞动的样子。","source":{"text":"只看众女子绛绡彩袖，翩翩跹跹，从绿柳丛中行过，一个个觉得风流可爱。","book":"清·褚人获《隋唐演义》第40回"},"usage":"作定语、状语；用于书面语"},{"id":36969,"word":"翩翩风度","pinyin":"piān piān fēng dù","abbr":"ppfd","explanation":"翩翩：形容举止潇洒超脱。风度：美好的举止姿态。形容人的举止言谈超逸洒脱。","source":{"text":"早有那般世谊同年，见他翩翩丰度，蔼然可亲，都愿和他亲近进来了。","book":"清·文康《儿女英雄传》第三十八回"},"example":{"text":"周恩来这样惊人的酒量，偶尔也有喝醉的时候。不过，他再醉也不会有伤大雅，始终保持着他那与生俱来的～。","book":"权延赤《走下圣坛的周恩来·周恩来与酒》"}},{"id":36970,"word":"翩若惊鸿","pinyin":"piān ruò jīng hóng","abbr":"prjh","explanation":"比喻美女的体态轻盈。","source":{"text":"（洛神）其形也，翩若惊鸿，婉若游龙。","book":"三国魏·曹植《洛神赋》"},"example":{"text":"正在绳子忽低忽昂的走来走去，大有娇若游龙，～之势。","book":"清·曾朴《孽海花》第六回"},"usage":"作谓语、状语；形容女子的体态轻盈"},{"id":36971,"word":"翩跹而舞","pinyin":"piān xiān ér wǔ","abbr":"pxew","explanation":"翩跹：轻扬飘逸的样子。常用以形容轻快旋转的舞姿。","source":{"text":"梦一道士，羽衣翩跹，过临皋之下。","book":"宋·苏轼《后赤壁赋》"}},{"id":36972,"word":"翫其碛砾不窥玉渊","pinyin":"wán qí qì lì bù kuī yù yuān","abbr":"wqqlbkyy","explanation":"晋·左思《吴都赋》：“翫其碛砾而不窥玉渊者，未知骊龙之所蟠也。”"},{"id":36973,"word":"翰飞戾天","pinyin":"hàn fēi lì tiān","abbr":"hflt","explanation":"飞到高空。比喻仕宦的飞黄腾达。","example":{"text":"他盼望有～的一天。"},"usage":"作谓语、定语；指人地位显赫"},{"id":36974,"word":"翳桑饿人","pinyin":"yì sāng è rén","abbr":"yser","explanation":"翳桑：在桑树荫下。在桑树荫下挨饿的人。比喻不忘他人恩惠，并有所回报。","source":{"text":"翳桑之饿人也。","book":"《左传·宣公二年》载：春秋时，晋国灵辄于翳桑挨饿，赵盾给他食物并接济其母。后灵公欲杀赵盾，得一甲士相助，才免于难。问何故，对曰"},"example":{"text":"相国不记翳桑之饿人乎？则我灵辄便是。","book":"明·冯梦龙《东周列国志》第五十回"}},{"id":36975,"word":"翻云覆雨","pinyin":"fān yún fù yǔ","abbr":"fyfy","explanation":"形容人反复无常或惯于耍手段。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"唐·杜甫《贫交行》"},"example":{"text":"你不合打凤牢龙，～，陷人坑阱。","book":"元·乔孟符《扬州梦》第四折"},"similar":["反复无常","朝三暮四"],"opposite":["始终不渝","始终如一"],"usage":"作谓语、定语；指玩弄手段","story":["唐朝时期，诗人杜甫处于盛唐走向衰弱的时期，他深切体会到上层社会的世态炎凉，人情淡薄，看到的都是尔虞我诈，不禁想起了春秋时期的管鲍之交的真情友谊。于是抚今思古即兴作《贫交行》：“翻手作云覆手雨，纷纷轻薄何须数。”"]},{"id":36976,"word":"翻唇弄舌","pinyin":"fān chún nòng shé","abbr":"fcns","explanation":"比喻搬弄是非。","source":{"text":"第一要才学，第二就要人品了，又要好相处，没些说是说非，翻唇弄舌，这就好了。","book":"明·兰陵笑笑生《金瓶梅词话》第56回"},"example":{"text":"这是一个～的小人。"},"similar":["搬唇递舌"],"usage":"作宾语、定语；指传是非"},{"id":36977,"word":"翻复无常","pinyin":"fān fù wú cháng","abbr":"ffwc","explanation":"变化无常，说变就变。","source":{"text":"当年翻复无常定，薄命为女何必粗。","book":"南朝·梁·吴均《行路难》"},"example":{"text":"他就是～的性格。"},"similar":["反复无常"],"opposite":["一成不变"],"usage":"作谓语、定语；指变化无常"},{"id":36978,"word":"翻天作地","pinyin":"fān tiān zuò dì","abbr":"ftzd","explanation":"犹言翻天覆地。形容闹得很凶。","source":{"text":"李雄见打得这般光景，暴躁如雷，翻天作地，闹将起来。","book":"明·冯梦龙《醒世恒言》第二十七卷"},"similar":["翻天覆地"],"usage":"作谓语、定语、状语；用于吵架"},{"id":36979,"word":"翻天覆地","pinyin":"fān tiān fù dì","abbr":"ftfd","explanation":"覆：翻过来。形容变化巨大而彻底。也指闹得很凶。","source":{"text":"天翻地覆谁得知，如今正南看北斗。","book":"唐·刘商《胡茄十八拍》诗"},"example":{"text":"真象～的变动就快要临头了。","book":"沙汀《兽道》"},"similar":["天翻地覆","沧海桑田"],"opposite":["一成不变"],"usage":"作定语、宾语、状语；形容社会变化很大"},{"id":36980,"word":"翻天蹙地","pinyin":"fān tiān cù dì","abbr":"ftcd","explanation":"翻：反转；蹙：同“蹴”，踢，踩。形容迅猛势盛。","source":{"text":"五月之间，白帝之下，洪涛塞峡，不见滟滪，翻天蹙地，霆吼雷怒。","book":"唐·独孤及《招北客文》"},"usage":"作谓语、定语；用于书面语"},{"id":36981,"word":"翻山涉水","pinyin":"fān shān shè shuǐ","abbr":"fsss","explanation":"山：山岭；涉：趟水；水：大河。翻山越岭，趟水过河。形容路途奔波之苦。","source":{"text":"可是这会，红军就要和我们分手了，他们要翻山涉水地远征了……","book":"王愿坚《粮食的故事》"},"similar":["翻山越水","跋山涉水"],"usage":"作谓语、状语；用于翻山过海走长路"},{"id":36982,"word":"翻山越岭","pinyin":"fān shān yuè lǐng","abbr":"fsyl","explanation":"翻：翻过；越：过；岭：山岭。翻越不少山头。形容野外工作或旅途的辛苦。","source":{"text":"他的腿脚好，只要肚子里填饱了瓤子，翻山越岭，跟年轻人一样。","book":"姚雪垠《李自成》第一卷第六章"},"example":{"text":"李准《马小翠的故事》：“想贴个春联，往往要跑几十里，～到山下请人写。”"},"similar":["跋山涉水","梯山航海"],"usage":"作谓语、定语、宾语；形容长途跋涉的辛苦"},{"id":36983,"word":"翻山越水","pinyin":"fān shān yuè shuǐ","abbr":"fsys","explanation":"山：山岭；水：大河。翻山越岭，趟水过河。形容路途奔波之苦。","example":{"text":"我们一路～，饱经风雨。"},"similar":["跋山涉水"],"usage":"作谓语、状语；用于翻山过海走长路"},{"id":36984,"word":"翻手为云","pinyin":"fān shǒu wéi yún","abbr":"fswy","explanation":"翻：反转。形容人反复无常或惯于玩弄权术。","source":{"text":"翻手为云，造物等儿戏。","book":"宋·陈亮《祝英台近》词"},"example":{"text":"猴子虽然有手，却不会制造工具；至于‘～，覆手为雨’，猴子更不会。","book":"茅盾《手的故事》一"},"similar":["翻手为云覆手雨"],"usage":"作宾语、定语、分句；形容人变化无常"},{"id":36985,"word":"翻手为云覆手雨","pinyin":"fān shǒu wéi yún fù shǒu yǔ","abbr":"fswyfsy","explanation":"翻：反转；覆：反覆。形容人反复无常或惯于玩弄权术。","source":{"text":"翻手为云覆手雨，当面论心背后笑。","book":"宋·王安石《老人行》"},"similar":["翻手为云，覆手为雨"],"usage":"作谓语、宾语、定语、分句；形容人变化无常"},{"id":36986,"word":"翻手为云，覆手为雨","pinyin":"fān shǒu wéi yún，fù shǒu wéi yǔ","abbr":"fswyfswy","explanation":"形容人反复无常或惯于耍手段。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"唐·杜甫《贫交行》"},"example":{"text":"猴子虽然有手，却不会制造工具，至于“～”，猴子更不会。","book":"茅盾《手的故事》"},"similar":["翻云覆雨"],"usage":"作谓语、宾语、定语、分句；形容人变化无常","story":["唐朝时期，诗人杜甫处于盛唐走向衰弱的时期，他深切体会到上层社会的世态炎凉，人情淡薄，看到的都是尔虞我诈，不禁想起了春秋时期的管鲍之交的真情友谊。于是抚今思古即兴作《贫交行》：“翻手作云覆手雨，纷纷轻薄何须数。”"]},{"id":36987,"word":"翻手云覆手雨","pinyin":"fān shǒu yún fù shǒu yǔ","abbr":"fsyfsy","explanation":"比喻反覆无常或玩弄手段。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"语出唐杜甫《贫交行》"},"example":{"text":"他～，没定止性儿难据。","book":"明·李唐宾《梧桐叶》第二折"}},{"id":36988,"word":"翻手作云覆手雨","pinyin":"fān shǒu zuò yún fù shǒu yǔ","abbr":"fszyfsy","explanation":"翻：反转；覆：反覆。形容人反复无常或惯于玩弄权术。","source":{"text":"翻手作云覆手雨，纷纷轻薄何须数。","book":"唐·杜甫《贫交行》"},"similar":["翻手为云覆手雨"],"usage":"作谓语、宾语、定语、分句；形容人变化无常"},{"id":36989,"word":"翻手是雨，合手是云","pinyin":"fān shǒu shì yǔ，fù shǒu shì yún","abbr":"fssyhssy","explanation":"翻：反转；覆：反覆。形容人反复无常或惯于玩弄权术。","source":{"text":"咱人翻手是雨，合手是云，那尘埃中埋没杀多才俊。","book":"元·张国宾《合汗衫》第一折"},"example":{"text":"俺娘～，常则是恶硍硍紧掿着条黄桑棍，端的待打杀卧麒麟。","book":"明·贾仲名《对玉梳》第一折"},"similar":["翻手为云，覆手为雨"],"usage":"作谓语、宾语、定语、分句；形容人变化无常"},{"id":36990,"word":"翻来复去","pinyin":"fān lái fù qù","abbr":"flfq","explanation":"翻：翻转。形容做事多次重复","source":{"text":"横说世如此，竖说也如此。翻来复去说都如此。","book":"宋·朱熹《朱子全书性理·理》"},"example":{"text":"鲁彦周《彩虹坪》：“他早饭也没吃，把自己关在房里，～考虑该怎么办，一时竟找不出主意。”"},"similar":["翻来覆去","番来复去"],"usage":"作谓语、状语；指人的动作与思维反复"},{"id":36991,"word":"翻来覆去","pinyin":"fān lái fù qù","abbr":"flfq","explanation":"翻：翻转。形容做事多次重复。","source":{"text":"横说世如此，竖说也如此。翻来复去说都如此。","book":"宋·朱熹《朱子全书性理·理》"},"example":{"text":"他早饭也没吃，把自己关在房里，～考虑该怎么办，一时竟找不出主意。","book":"鲁彦周《彩虹坪》"},"similar":["辗转反侧","辗转不寐"],"usage":"作谓语、状语；指人的动作与思维反复"},{"id":36992,"word":"翻江倒海","pinyin":"fān jiāng dǎo hǎi","abbr":"fjdh","explanation":"原形容雨势大，后形容力量或声势非常壮大。","source":{"text":"五更颠风吹急雨，倒海翻江洗残暑。","book":"唐·李筌《太白阴经·祭风伯文》：“鼓怒而走石飞沙，翻江倒海。”宋·陆游《夜宿阳山矶》诗"},"example":{"text":"且说薛姨妈家中被金桂搅得～，看见婆子回来，说起岫烟的事，宝钗母女二人不免滴下泪来。","book":"清·曹雪芹《红楼梦》第九十回"},"similar":["排山倒海","移山倒海"],"opposite":["风平浪静","销声匿迹"],"usage":"作定语、状语、补语；形容水势浩大"},{"id":36993,"word":"翻江搅海","pinyin":"fān jiāng jiǎo hǎi","abbr":"fjjh","explanation":"形容水势浩大。多喻力量或声势非常壮大。也形容吵闹得很凶或事情搞得乱七八糟。","source":{"text":"指挥说地谈天口，来诱翻江搅海人。","book":"明·吴承恩《西游记》第二十三回：“龙能喷云暧雾，播土扬沙。有巴山捎岭的手段，有翻江搅海的神通。”明·施耐庵《水浒传》第十四回"},"example":{"text":"那船顺风吹去，就是乌雅快马也赶他不上。越刮越大，真是～，十分利害。","book":"清·李汝珍《镜花缘》第三十九回"},"similar":["翻江倒海"],"usage":"作定语、状语、补语；形容水势浩大"},{"id":36994,"word":"翻然悔悟","pinyin":"fān rán huǐ wù","abbr":"frhw","explanation":"悔：悔恨；悟：觉悟。很快地醒悟过来。形容转变得很快。指思想完全转变，彻底醒悟。","source":{"text":"今则释然悟，翻然悔曰：‘其邈也，乃所以怒其来之不继也；其悄也，乃所以示其意也。’","book":"唐·韩愈《与陈给事书》"},"example":{"text":"虽始行不端，而能～，改弦易辙，以善其修，斯其意固可嘉，而其功诚不可泯。","book":"鲁迅《中国小说史略·元明传来之讲史（下）》"},"similar":["翻然悔改","回心转意"],"opposite":["执迷不悟","死不改悔"],"usage":"作谓语、宾语、定语；用于犯错误的人","story":["明朝时期，海瑞以刚直公正而闻名，他巧妙地惩治总督胡宪宗的儿子，让这个骄奢的人哑巴吃黄连。明世宗长年深居西苑，念经求佛，祈求得道成仙，长生不老。海瑞冒死斗胆上书，希望明世宗翻然悔悟、重振朝纲，结果被打入大牢"]},{"id":36995,"word":"翻然悔过","pinyin":"fān rán huǐ guò","abbr":"frhg","explanation":"翻然：回飞的样子，形容转变很快；悔：悔恨。形容很快认识到过错而悔改。","source":{"text":"李怀光若能翻然悔过，束身赴朝，念其尝有大勋，必当终始全护。","book":"唐·陆贽《贞元改元在赦制》"},"similar":["翻然改悔","翻然改悟"],"usage":"作谓语、宾语、定语；用于犯错误的人"},{"id":36996,"word":"翻然改图","pinyin":"fān rán gǎi tú","abbr":"frgt","explanation":"图：计划，打算。比喻很快转变过来。另作打算。","source":{"text":"何图凶险谗慝之人，造饰无端，诱导奸利，至今将军翻然改图，忘孝友之仁，听豺狼之谋，诬先公废立之言。","book":"汉·审配《献书袁谭》"},"example":{"text":"将军若能～，易迹更步，古人不难追，鄙土何足宰哉？（《三国志·蜀志·吕凯传》）"},"similar":["回心转意"],"usage":"作谓语、宾语；比喻很快转变过来","story":["三国时期，蜀主刘备病死，他的大臣雍闿投降吴国，吴国派他担任永昌太守，他走马上任。永昌郡守将吕凯忠于蜀国，不肯放雍闿进城，特地给雍闿回了一封文书，希望他能回心转意，将会有所作为的，再大的官都可以做"]},{"id":36997,"word":"翻然改悔","pinyin":"fān rán gǎi huǐ","abbr":"frgh","explanation":"翻然：回飞的样子，形容转变很快；悔：悔恨。形容很快认识到过错而悔改。","source":{"text":"一旦翻然改悔，而欲为善，顾亦何所不可。","book":"宋·黄榦《答梁宁翁书》"},"similar":["翻然改悟","翻然悔过","翻然悔悟"],"usage":"作谓语、宾语、定语；用于犯重大错误的人"},{"id":36998,"word":"翻然改悟","pinyin":"fān rán gǎi wù","abbr":"frgw","explanation":"翻然：回飞的样子，形容转变很快；悟：醒悟。形容很快认识到过错而悔改醒悟。","source":{"text":"一旦犹子翻然改悟，斥逐奴隶，引咎谢过，则前日之嫌便可销释。","book":"《金史·完颜匡传》"},"similar":["翻然改悔","翻然悔悟"],"usage":"作谓语、宾语、定语；用于犯重大错误的人"},{"id":36999,"word":"翻然改进","pinyin":"fān rán gǎi jìn","abbr":"frgj","explanation":"翻然：变动的样子。形容很快转变，有所进步。","source":{"text":"汤三使往聘之，既而幡然改曰：‘与我处畎亩之中，由是以乐尧舜之道。’","book":"《孟子·万章下》"},"example":{"text":"……不是采取排斥态度，而是采取规劝态度，使之～，弃旧图新。","book":"毛泽东《中国共产党在民族战争中的地位》"},"similar":["翻然悔悟"],"opposite":["执迷不悟"],"usage":"作谓语、宾语、定语；形容很快进步"},{"id":37000,"word":"翻空出奇","pinyin":"fān kōng chū qí","abbr":"fkcq","explanation":"形容诗文、字画等一反前人窠臼，以独特的想象取胜。","source":{"text":"意翻空而易奇。","book":"南朝·梁·刘勰《文心雕龙·神思》"},"example":{"text":"柳州本以《史记》为主，特借《吕览》为文之波澜，～耳。","book":"清·平步青《霞外捃屑》卷七"},"usage":"作定语、补语；指文章构思奇特"},{"id":37001,"word":"翻箱倒柜","pinyin":"fān xiāng dǎo guì","abbr":"fxdg","explanation":"翻：倒，反转。把箱子柜子都翻倒过来。形容彻底翻检。","source":{"text":"闹了大半天，毫无影响，甚至翻箱倒柜，实在没处去找。","book":"清·曹雪芹《红楼梦》第九十四回"},"example":{"text":"朱培德派来的一营兵就把省农协围住，将我的卧房～的检查。","book":"方志敏《我从事革命斗争的略述》十"},"similar":["倾肠倒笼","翻箱倒箧"],"usage":"作谓语、定语、宾语；形容彻底翻检"},{"id":37002,"word":"翻箱倒笼","pinyin":"fān xiāng dǎo lǒng","abbr":"fxdl","explanation":"翻：反转；笼：大的竹箱。形容彻底搜寻、查检。","source":{"text":"翻箱倒笼，满屋寻一个遍，那有些影儿。","book":"明·冯梦龙《警世通言》第15卷"},"example":{"text":"闹了大半天，毫无影响，甚至～，实在没处去找，便疑到方才这些人进来，不知谁捡了去了。","book":"清·曹雪芹《红楼梦》第93回"},"similar":["翻箱倒柜"],"usage":"作谓语、宾语、状语；形容彻底搜寻","story":["贾宝玉从贾母那里回来后，十分得意，因为他与贾环、贾兰比试诗文胜出。在更换衣服时，袭人见他脖子上的那块通灵宝玉不见了，就问宝玉。宝玉随便扯个理由搪塞，袭人就问丫鬟麝月，麝月觉得此事非同儿戏，就与大家翻箱倒笼地找，结果一无所获"]},{"id":37003,"word":"翻箱倒箧","pinyin":"fān xiāng dǎo qiè","abbr":"fxdq","explanation":"翻：倒，反转；箧：小箱子。把箱子柜子都翻倒过来。形容彻底翻检。","source":{"text":"船上买办又仗着洋人势力，硬来翻箱倒箧的搜了一遍。","book":"清·吴趼人《二十年目睹之怪现状》第四回"},"example":{"text":"但还是～的寻了一通，果然无踪无影。","book":"鲁迅《序言》"},"similar":["翻箱倒柜"],"usage":"作谓语、定语、宾语；形容彻底翻检"},{"id":37004,"word":"翻翻覆覆","pinyin":"fān fān fù fù","abbr":"ffff","explanation":"反复颠倒位置。形容一次又一次。","source":{"text":"床上卧了两个多月，翻翻覆覆只是不愈。","book":"明·冯梦龙《喻世明言·蒋兴哥重会珍珠衫》"},"example":{"text":"清·褚人获《隋唐演义》第七回：“秋宵耿耿，且是难得成梦，～，睡得一觉。”"},"similar":["反反复复","反反覆覆"],"usage":"作定语、状语；用于处事或事物等"},{"id":37005,"word":"翻肠倒肚","pinyin":"fān cháng dǎo dù","abbr":"fcdd","explanation":"苦思苦想，搜索枯肠。","example":{"text":"她～，十分难受。"},"similar":["冥思苦想"],"usage":"作谓语；用于口语"},{"id":37006,"word":"翻肠搅肚","pinyin":"fān cháng jiǎo dù","abbr":"fcjd","explanation":"形容内心极度思念或感到非常不安。","source":{"text":"不过也怪，自从部队逼近下花园，百岁忽然翻肠搅肚的想念起爹爹来了。","book":"杨朔《雪花飘飘》"},"example":{"text":"在他正～久久沉思的当儿，听见梁永生又叫了一声‘秦大哥’。","book":"郭澄清《大刀记》第二章"},"usage":"作定语、状语；形容心情不安"},{"id":37007,"word":"翻脸不认人","pinyin":"fān liǎn bù rèn rén","abbr":"flbrr","explanation":"比喻不从长远考虑，稍有矛盾，立刻翻脸。","source":{"text":"黄抚台外号‘黄阎罗’，翻脸不认人是出名的，这件事要好好铺排一下。","book":"高阳《胡雪岩全传·平步青云》上册"},"example":{"text":"小心他～。"},"similar":["翻脸无情"],"usage":"作谓语、定语、宾语；指变脸快"},{"id":37008,"word":"翻脸无情","pinyin":"fān liǎn wú qíng","abbr":"flwq","explanation":"突然改变脸色，不讲一点情义。","source":{"text":"好小子，翻脸无情，这等可恶。","book":"清·石玉昆《三侠五义》第九十四回"},"example":{"text":"高阳《胡雪岩全传·平步青云》上册：“黄宗汉一听他识窍，立刻就端茶送客，真个～，想想也不免寒心。”"},"similar":["翻脸不认人"],"usage":"作谓语、宾语、定语；用于处世"},{"id":37009,"word":"翻衾倒枕","pinyin":"fān qīn dǎo zhěn","abbr":"fqdz","explanation":"衾：被子。形容翻来倒去不能入睡。","source":{"text":"翻衾倒枕全无定，急得个，睡不多时又起身。","book":"清·陈瑞生《再生缘》第43回"},"similar":["搥床捣枕"],"usage":"作谓语、宾语、状语；指难以入睡"},{"id":37010,"word":"翻陈出新","pinyin":"fān chén chū xīn","abbr":"fccx","explanation":"陈：陈旧。从旧的翻造出新的。","source":{"text":"题古迹能翻陈出新最妙。","book":"清·袁枚《随园诗话》第四卷"},"example":{"text":"日稽考于古人之所已知，推求乎今人之所不逮，～，开世人无限之灵机，阐天地无穷之奥理。","book":"孙中山《上李鸿章书》"},"similar":["推陈出新"],"opposite":["因循守旧"],"usage":"作谓语、定语；指新陈代谢"},{"id":37011,"word":"翻风滚雨","pinyin":"fān fēng gǔn yǔ","abbr":"ffgy","explanation":"兴风作浪。","example":{"text":"这样～，让她十分难堪。"},"similar":["兴风作浪"],"usage":"作宾语、定语；指兴风作浪"},{"id":37012,"word":"翻黄倒皁","pinyin":"fān huáng dǎo yí","abbr":"fhdz","explanation":"犹言颠倒黑白。比喻歪曲事实，混淆是非。"},{"id":37013,"word":"翻黄倒皂","pinyin":"fān huáng dǎo zào","abbr":"fhdz","explanation":"犹言颠倒黑白。","source":{"text":"眉来眼去，唇三口四，泥烂油滑，翻黄倒皂，呼风唤雨，搦雾抟沙。","book":"明·康海《鲍老儿·秋日闲情》套曲"},"similar":["颠倒黑白"],"usage":"作宾语、定语；用于处事"},{"id":37014,"word":"翼翼小心","pinyin":"yì yì xiǎo xīn","abbr":"yyxx","explanation":"形容恭敬小心，丝毫不敢疏忽懈怠。","source":{"text":"越王是日立政，翼翼小心，出不敢奢，入不敢侈。","book":"汉·赵晔《吴越春秋·勾践归国外传》"},"example":{"text":"皇帝入承大统，醇亲王奕譞谦卑谨慎，～，十余年来，殚竭心力，恪恭尽职。","book":"《清史稿·醇亲王奕譞传》"},"similar":["小心翼翼"],"opposite":["粗心大意"],"usage":"作谓语、定语、状语；指为人谨慎"},{"id":37015,"word":"翼翼飞鸾","pinyin":"yì yì fēi luán","abbr":"yyfl","explanation":"指飞翔的样子。","source":{"text":"翼翼飞鸾，载飞载东。","book":"三国·魏·王粲《赠蔡子笃》诗"}},{"id":37016,"word":"翾风回雪","pinyin":"xuān fēng huí xuě","abbr":"xfhx","explanation":"翾：飞翔。回风飞雪。形容舞姿轻盈美妙。","source":{"text":"逸态横生，浓姿百出。宛若翾风回雪，恍如飞燕游龙，真独擅千秋矣。","book":"清·洪昇《长生殿·舞盘》"}},{"id":37017,"word":"耀武扬威","pinyin":"yào wǔ yáng wēi","abbr":"ywyw","explanation":"耀：显扬。炫耀武力，显示威风。","source":{"text":"你这般耀武扬威待怎么！","book":"元·乔孟符《两世姻缘》第三折"},"example":{"text":"共涛、吞珪船到岛边，～，统兵上岸。童威、童猛谨守寨栅，不与交战。","book":"清·陈忱《水浒后传》第十二回"},"similar":["张牙舞爪","飞扬跋扈","作威作福"],"opposite":["弃甲曳兵","丢盔弃甲","平易近人"],"usage":"作谓语、定语、状语；指炫耀武力，显示威风"},{"id":37018,"word":"耀目晶光","pinyin":"yào mù jīng guāng","abbr":"ymjg","explanation":"形容器物闪闪发亮，使人眼花缭乱。","source":{"text":"等到行礼完毕，署院举目一看，见他二人都是穿的簇新袍褂，手指头上耀目晶光，也不晓得是些什么东西，便知他二人是阔少出身。","book":"清·李宝嘉《官场现形记》第十九回"}},{"id":37019,"word":"耀眼争光","pinyin":"yào yǎn zèng guāng","abbr":"yyzg","explanation":"形容器物闪闪发亮，使人眼花缭乱。","source":{"text":"当下绊在坐架上，使了水银，那消顿饭之间，都净磨的耀眼争光。","book":"明·兰陵笑笑生《金瓶梅词话》第五十八回"},"example":{"text":"又钻出一个妖精程大姐来，梳了一个～的间，扭黑的头发。","book":"清·西周生《醒世姻缘传》第七十三回"}},{"id":37020,"word":"耀眼锃光","pinyin":"yào yǎn zèng guāng","abbr":"yyzg","explanation":"形容器物闪闪发亮，使人眼花缭乱。","source":{"text":"当下绊在坐架上，使了水银，那消顿饭之间，都净磨的耀眼争光。","book":"明·兰陵笑笑生《金瓶梅词话》第五十八回"}},{"id":37021,"word":"耀祖光宗","pinyin":"yào zǔ guāng zōng","abbr":"yzgz","explanation":"耀：显耀；祖：祖先；光：有面子；宗：宗族。为宗族争光，使祖先显耀","source":{"text":"照世俗的眼光，自然希望他传宗接代、耀祖光宗。","book":"清·无垢道人《八仙全传》第13回"},"similar":["光宗耀祖"],"usage":"作谓语、宾语；指为祖先争光"},{"id":37022,"word":"耀祖荣宗","pinyin":"yào zǔ róng zōng","abbr":"yzrz","explanation":"为祖先增添光荣。旧指光耀门庭。","source":{"text":"今幸得一举登科，荣宗耀祖。","book":"元·石君宝《曲江池》第四折"},"example":{"text":"今日喜得贤侄功成名遂，～，老夫若再不言，是埋没令先君一段苦心也。","book":"明·凌濛初《初刻拍案惊奇》卷二十"},"similar":["荣宗耀祖"],"usage":"作谓语、定语；指光耀门庭"},{"id":37023,"word":"老不晓事","pinyin":"lǎo bù xiǎo shì","abbr":"lbxs","explanation":"指年老而昏昧。","source":{"text":"老不晓事，强著一书，悔其少作。","book":"晋·陈寿《三国志·魏志·陈思王传》：“植益内不自安”注"},"example":{"text":"虽少好读书，无谢高凤而～，有类扬雄。","book":"唐·骆宾王《上吏部侍郎帝京篇启》"},"usage":"作谓语、定语；用于责骂人等"},{"id":37024,"word":"老之将至","pinyin":"lǎo zhī jiāng zhì","abbr":"lzjz","explanation":"多用作自称衰老之语。","source":{"text":"叶公问孔子于子路，子路不对。子曰‘女奚不曰：其为人也，发愤忘食，乐以忘忧，不知老之将至云尔。’","book":"《论语·述而》"},"example":{"text":"少不如人，所向墙壁；～，乃罣网罗。","book":"宋·陈亮《谢胡参政启》"},"usage":"作宾语、定语；多用作自称衰老之语","story":["春秋时期，孔子带领学生周游列国讲学，来到楚国叶邑，叶公沈诸梁接待了他，他对孔子不怎么了解，就悄悄地问子路，子路一时不知怎么回答他。孔子事后得知就对子路说以后就说：“其为人也，发愤忘食，乐以忘忧，不知老之将至。”"]},{"id":37025,"word":"老于世故","pinyin":"lǎo yú shì gù","abbr":"lysg","explanation":"老：老练，富有经验；世故：处世经验。指对社会上的一切有很深的阅历。","source":{"text":"中朝大官老于事。","book":"唐·韩愈《石鼓歌》"},"example":{"text":"他们～，许多人现在隐蔽着。","book":"毛泽东《在省市自治区党委书记会议上的讲话》"},"similar":["老谋深算"],"opposite":["乳臭未干","涉世未深"],"usage":"作谓语、宾语；指为人处世"},{"id":37026,"word":"老僧入定","pinyin":"lǎo sēng rù dìng","abbr":"lsrd","explanation":"和尚静坐，使心定于一处，不起杂念，叫入定。形容人静静地端坐着。","source":{"text":"看时，却是个黑瘦老者，危然端坐，彷彿老僧入定一样。","book":"清·曾朴《孽海花》第二十回"},"example":{"text":"华池置无用之乡，谬说～；蛮洞乃不毛之地，遂使眇帅称戈。","book":"清·蒲松龄《聊斋志异·黄九郎》"},"usage":"作宾语；形容人静静地端坐着"},{"id":37027,"word":"老八辈子","pinyin":"lǎo bā bèi zǐ","abbr":"lbbz","explanation":"极为古老、陈旧的。","example":{"text":"那是～的东西，如今可不时兴了。"},"usage":"作宾语、定语；用于口语"},{"id":37028,"word":"老医少卜","pinyin":"lǎo yī shào bǔ","abbr":"lysb","explanation":"指医者以年老有经验为贵，卜者以年轻敢于决断为贵。","source":{"text":"语曰：‘老医少卜，盖老医更病多矣，尧故使之。’","book":"《鹖冠子·世贤》：“不任所爱，必使旧医。”注"},"example":{"text":"常言老医少卜，或者这医人有些效验，也未可知。","book":"明·冯梦龙《醒世恒言》卷二十八"},"usage":"作宾语、定语；用于处事"},{"id":37029,"word":"老古板","pinyin":"lǎo gǔ bǎn","abbr":"lgb","explanation":"指守旧的人。","source":{"text":"前人制台是个老古板，见面之后，问了几句话。","book":"清·李宝嘉《官场现形记》第54回"},"example":{"text":"当然，他现在不会再按～种地。","book":"路遥《平凡的世界》第五卷第21章"},"similar":["老古董"],"usage":"作宾语、定语；用于口语"},{"id":37030,"word":"老古董","pinyin":"lǎo gǔ dǒng","abbr":"lgd","explanation":"古老的或过时的东西，也指思想陈腐或生活习惯陈旧的人。","source":{"text":"你近三十岁的人了，自己该有分寸，照理用不到我们背时的老古董来多嘴。","book":"钱钟书《围城》"},"example":{"text":"这是一件～。"},"similar":["老古板"],"usage":"作主语、宾语、定语；指守旧的人"},{"id":37031,"word":"老吏断狱","pinyin":"lǎo lì duàn yù","abbr":"lldy","explanation":"吏：司法官；狱：案件。老司法官判断案件。形容有丰富经验的人，判断是非又快又准。","source":{"text":"老吏断狱着着争先，捕快查赃头头是道。","book":"清·李宝嘉《官场现形记》第十五回"},"example":{"text":"因此，一向不大肯说题外之话的他，覆奏措词，如～，犀利无比。","book":"高阳《李鸿章》第一章"}},{"id":37032,"word":"老吾老以及人之老","pinyin":"lǎo wǔ lǎo yǐ jí rén zhī lǎo","abbr":"lwlyjrzl","explanation":"老：敬爱。尊敬我家里的长辈，从而推广到尊敬别人家里的长辈。","source":{"text":"老吾老以及人之老，幼吾幼以及人之幼","book":"战国·邹·孟轲《孟子·梁惠王上》"},"usage":"作谓语、宾语、定语；用于书面语"},{"id":37033,"word":"老吾老，以及人之老","pinyin":"lǎo wú lǎo，yǐ jí rén zhī lǎo","abbr":"lwlyjrzl","explanation":"前一“老”：敬老。尊敬自己家族的长辈，从而推广到尊敬别人家族的长辈。","source":{"text":"老吾老，以及人之老；幼吾幼，以及人之幼。天下可运于掌。","book":"《孟子·梁惠王下》"},"example":{"text":"那么，我就根据“～”的恻隐之心，把她褒扬一番罢。","book":"冯雪峰《一个父母官怎样大动恻隐之心的故事》"}},{"id":37034,"word":"老大徒伤","pinyin":"lǎo dà tú shāng","abbr":"ldts","explanation":"老大：年纪大；徒：徒然。年老了还一事无成只好悲伤而已。","source":{"text":"百川东到海，何时复西归。少壮不努力，老大徒伤悲。","book":"南宋·郭茂倩《乐府诗集·长歌行》"},"example":{"text":"你请到他，这一定是高明的了，真是后生可畏！……我们是～的了。","book":"清·吴趼人《二十年目睹之怪现状》"},"similar":["老大徒伤悲"],"usage":"作宾语、定语；指年老人","story":["古代《乐府诗集》中有一首《长歌行》，作者借园中葵来揭示人生该如何度过青年这黄金时代，诗文如下：“青青园中葵，朝露待日睎。阳春布德泽，万物生光晖。常恐秋节至，睎黄华叶衰。百川东到海，何时复西归。少壮不努力，老大徒伤悲。”"]},{"id":37035,"word":"老大徒伤悲","pinyin":"lǎo dà tú shāng bēi","abbr":"ldtsb","explanation":"老大：年纪大；徒：徒然。年老了还一事无成只好悲伤而已。","source":{"text":"百川东到海，何时复西归。少壮不努力，老大徒伤悲。","book":"南宋·郭茂倩《乐府诗集·长歌行》"},"similar":["老大徒伤"],"usage":"作宾语、定语；用于劝诫人","story":["古代《乐府诗集》中有一首《长歌行》，作者借园中葵来揭示人生该如何度过青年这黄金时代，诗文如下：“青青园中葵，朝露待日睎。阳春布德泽，万物生光晖。常恐秋节至，睎黄华叶衰。百川东到海，何时复西归。少壮不努力，老大徒伤悲。”"]},{"id":37036,"word":"老大无成","pinyin":"lǎo dà wú chéng","abbr":"ldwc","explanation":"老大：年老。年纪已老，无所成就。","source":{"text":"寡母又怜他是个独根孤种，未免溺爱纵容些，遂致老大无成。","book":"清·曹雪芹《红楼梦》第四回"},"example":{"text":"既不能显亲扬名，又不能兴邦定业，碌碌人世，殊愧～。","book":"清·李汝珍《镜花缘》第十回"},"similar":["老大徒伤悲"],"opposite":["年少有为"],"usage":"作谓语、定语；指没有作为","story":["薛宝钗的哥哥薛蟠是个地地道道的浪荡公子，他不认真上学，终日斗鸡走狗，到了成人之年，什么事也不会做，虽然继承父业做皇商，可他不谙世事，被地方的商人把他的财产骗了精光，无奈之下，只好带着母亲和妹妹去投奔贾府"]},{"id":37037,"word":"老天拔地","pinyin":"lǎo tiān bá dì","abbr":"ltbd","explanation":"形容老年人动作不灵活。","source":{"text":"既这么着，你老人家老天拔地的，跑什么呢，带着他去瞧了叫他进来就是了。","book":"清·曹雪芹《红楼梦》第二十九回"},"example":{"text":"我哪里知道你这些事！我～的也操不了这心了。","book":"二月河《乾隆皇帝》八"},"similar":["老态龙钟"],"usage":"作宾语；用于老年人"},{"id":37038,"word":"老女归宗","pinyin":"lǎo nǚ guī zōng","abbr":"lngz","explanation":"旧时称出嫁的妇女被遗弃或因其他原因返回娘家。","source":{"text":"你就办我个老女归宗。","book":"清·李绿园《歧路灯》第八十二回"},"example":{"text":"您家不要我了，说明白送我个～，不过只争一张休书。","book":"清·李绿园《歧路灯》第八十五回"},"usage":"作宾语、定语；用于女性"},{"id":37039,"word":"老奸巨滑","pinyin":"lǎo jiān jù huá","abbr":"ljjh","explanation":"老：有经验的，老练的；奸：奸诈。形容阅历深而手段极其奸诈狡猾的人","source":{"text":"虽老奸巨猾，无能逃于其术者。","book":"宋·司马光《资治通鉴·唐玄宗开元二十四年》"},"example":{"text":"高阳《胡雪岩全传·平步青云》下册：“这见得朱福年不是什么～。”"},"similar":["老奸巨猾"],"opposite":["老老实实"],"usage":"作谓语、定语；指奸诈狡猾的人"},{"id":37040,"word":"老奸巨猾","pinyin":"lǎo jiān jù huá","abbr":"ljjh","explanation":"猾：狡诈。指非常阴险狡诈的人。","source":{"text":"虽老奸巨滑，无能逃于其术者。","book":"宋·司马光《资治通鉴·唐玄宗开元二十四年》"},"example":{"text":"阿瞒～，安知其尸实不在此七十二冢之内乎。","book":"鲁迅《花边文学·清明时节》"},"similar":["诡计多端","老谋深算","巨奸大猾"],"opposite":["诚心诚意","忠诚老实","肝胆相照"],"usage":"作谓语、定语；指奸诈狡猾的人","story":["唐玄宗时期，宰相李林甫是一个老奸巨猾而又阴险毒辣的人，他表面上装得十分忠厚和善，说话总是甜言蜜语，经常是暗藏毒计，被他陷害的人还认为他够义气。凡是唐玄宗信任的人，他总是去巴结、离间，背后进行打击报复"]},{"id":37041,"word":"老妪能解","pinyin":"lǎo yù néng jiě","abbr":"lynj","explanation":"妪：老年妇女。相传唐朝诗人白居易每作一首诗就念给老年妇女听，不懂就改，力求做到她们能懂。形容诗文明白易懂。","source":{"text":"白乐天每作诗，问曰解否？妪曰解，则录之；不解，则易之。","book":"宋·惠洪《冷斋夜话》卷一"},"example":{"text":"居易急求人知，意陈于词，遂令～。","book":"清·王闿运《湘绮楼论唐诗》"},"similar":["通俗易懂"],"usage":"作谓语、定语；形容通俗易懂","story":["唐朝大诗人白居易28岁中进士当官，官越来越大，但因为得罪了权贵，被贬到江州做司马。他的诗作风格和语言深入浅出，平易通俗，让人一看就懂。著名的《母别子》就是根据他家老保姆的见闻而写的，最终是她能听懂才定稿的"]},{"id":37042,"word":"老婆当军","pinyin":"lǎo pó dāng jūn","abbr":"lpdj","explanation":"比喻毫无用处，只是充数而已。","source":{"text":"俺们说话不中听，老婆当军，充数罢了。","book":"明·兰陵笑笑生《金瓶梅词话》第26回"},"example":{"text":"我要这混帐儿子做甚么？～，没的充数哩！","book":"清·西周生《醒世姻缘传》第五回"},"similar":["滥竽充数"],"usage":"作谓语、宾语；指充数"},{"id":37043,"word":"老婆舌头","pinyin":"lǎo pó shé tóu","abbr":"lpst","explanation":"指长于花言巧语，搬弄是非。","source":{"text":"那厮是能言巧辩之士，口里含着一堆的老婆舌头。","book":"元·无名氏《气英布》第一折"},"example":{"text":"那个猪八戒，尖着嘴，有些会说～，你怎听他？","book":"明·吴承恩《西游记》第31回"},"usage":"作宾语、定语；用于是非场所"},{"id":37044,"word":"老子天下第一","pinyin":"lǎo zǐ tiān xià dì yī","abbr":"lztxdy","explanation":"老子：不谦虚的人的自称。自以为是天下第一号人物。","source":{"text":"自以为是，老子天下第一。","book":"毛泽东《反对自由主义》"},"similar":["妄自尊大"],"usage":"作定语、宾语；指人很狂妄"},{"id":37045,"word":"老子婆娑","pinyin":"lǎo zǐ pó suō","abbr":"lzps","explanation":"婆娑：放逸不羁的样子。指男子自夸襟怀豪放。","source":{"text":"将出府门，顾谓愆期曰：‘老子婆娑，正坐诸君辈。’","book":"《晋书·陶侃传》"},"example":{"text":"徘徊久，问人间谁似，～。","book":"宋·辛弃疾《沁园春·弄溪赋》"},"usage":"作宾语、定语；用于口语"},{"id":37046,"word":"老子长孙","pinyin":"lǎo zǐ zhǎng sūn","abbr":"lzzs","explanation":"养育子孙，使之长大成人。","source":{"text":"人在战地，各自为家，养生送死，老子长孙，未尝有阙。","book":"宋·叶適《安集两淮申省状》"},"usage":"作谓语、定语；用于家庭责任"},{"id":37047,"word":"老实巴交","pinyin":"lǎo shí bā jiāo","abbr":"lsbj","explanation":"形容人规规矩矩，谨慎胆小的样子。","source":{"text":"一个一个心慈面善，全是老实巴交的。","book":"徐光耀《平原烈火》"},"example":{"text":"他这种～的人是不能干大事的。"},"similar":["老实巴脚"],"opposite":["老奸巨猾"],"usage":"作谓语、定语；指人憨厚"},{"id":37048,"word":"老实巴脚","pinyin":"lǎo shí bā jiǎo","abbr":"lsbj","explanation":"谨慎小心，平庸厚道的样子。","source":{"text":"他的哥哥，那个至今还在当生产队长的老实巴脚的人。","book":"邹志安《土地》"},"example":{"text":"路遥《平凡的世界》第五卷第五章：“一个个～，都拉着一窝儿女，根本不可能照顾他们。”"},"similar":["老实巴交"],"opposite":["老奸巨猾"],"usage":"作谓语、定语；指人憨厚"},{"id":37049,"word":"老实疙瘩","pinyin":"lǎo shí gē dā","abbr":"lsgd","explanation":"忠厚老实的人。","source":{"text":"我发现他其实是个愚木懦弱净存着侥幸心理指望别人帮他走运的老实疙瘩。","book":"王朔《玩儿的就是心跳》"},"example":{"text":"她这个～真是没治了。"},"similar":["老实巴交"],"opposite":["老奸巨猾"],"usage":"作宾语、定语；指老实人"},{"id":37050,"word":"老将出马，一个顶俩","pinyin":"lǎo jiāng chū mǎ，yī gè dǐng liǎ","abbr":"ljcmygdl","explanation":"老年人经验丰富，做起事来，一个能顶得上两个人。"},{"id":37051,"word":"老少无欺","pinyin":"lǎo shào wú qī","abbr":"lswq","explanation":"对小孩和老人都不欺骗。","source":{"text":"这是你一向做落的定价，划一不二，老少无欺。","book":"清·俞万春《荡寇志》第一百四回"},"example":{"text":"我的豆腐却关系不大，这东西十方圆通，～。","book":"林斤澜《豆腐》"}},{"id":37052,"word":"老师宿儒","pinyin":"lǎo shī sù rú","abbr":"lsxr","explanation":"年纪大而学问渊博的人。","source":{"text":"炀帝召天下儒官集东都，诏国子秘书学士与论议，颖达为冠，又年最少，老师宿儒耻出其下，阴遣客刺之，匿杨玄感家得免。","book":"《新唐书·孔颖达传》"},"example":{"text":"高文大册，或托之不得其人；～，有死而莫见于世。","book":"宋·陆游《贺周参政启》"},"similar":["老手宿儒"],"usage":"作主语、宾语；用于书面语"},{"id":37053,"word":"老师糜饷","pinyin":"lǎo shī mí xiǎng","abbr":"lsmx","explanation":"老师：使军队长期劳困力量衰减；糜：糜废。劳累军队，浪费军饷。","source":{"text":"何至久延岁月，老师糜饷为哉？","book":"《明史·杨嗣昌传》"},"example":{"text":"～，克捷无期。","book":"清·梁章钜《归田琐记·讷亲》"}},{"id":37054,"word":"老弱妇孺","pinyin":"lǎo ruò fù rú","abbr":"lrfr","explanation":"年老体弱的妇女和年幼的儿童。指没有生活能力而需要别人扶持照顾的人。","example":{"text":"此贼近一年来迭经痛剿，疲于奔命，所余可战之贼不过数千，其余尽皆～。","book":"姚雪垠《李自成》第一卷第五章"}},{"id":37055,"word":"老弱残兵","pinyin":"lǎo ruò cán bīng","abbr":"lrcb","explanation":"原指年老没有作战能力的士兵。现多比喻因年老体弱以及其他原因而工作能力较差的人。","source":{"text":"城中无粮，可发老弱残兵并妇人出降；彼必不为备，我既以兵继百姓之后出攻之。","book":"明·罗贯中《三国演义》第三十二回"},"example":{"text":"以前，他不肯抢别人的买卖，特别是对于那些～；以他的身体，以他的车，去和他们争座儿，还能有他们的份？","book":"老舍《骆驼祥子》五"},"similar":["枯木朽株","残兵败将"],"opposite":["兵强马壮","精兵猛将"],"usage":"作主语、宾语；指能力较差的人","story":["东汉末年，袁尚进攻平原，审配与陈琳留守冀州，曹操趁机围困冀州。袁尚派主簿李孚扮作曹军去攻冀州，审配见是李孚，就与他商定先用妇幼与老弱残兵假降曹操，主力部队混出城与曹操决战，被曹操识破，曹操将计就计取了冀州"]},{"id":37056,"word":"老弱病残","pinyin":"lǎo ruò cán bìng","abbr":"lrbc","explanation":"老：老人；弱：弱小的幼童；病：病人；残：残疾人。泛指弱势群体。","source":{"text":"科研人员美国有一百二十万，苏联九十万，我们只有二十多万，还包括老弱病残，真正顶用的不很多。","book":"邓小平《尊重知识，尊重人才》"},"example":{"text":"章诒和《往事并不如烟·斯人寂寞》：“对个～来说，在一千多天的日子里，什么情况都可能发生。”"},"opposite":["身强力壮"],"usage":"作主语、宾语、定语；用于弱势群体"},{"id":37057,"word":"老当益壮","pinyin":"lǎo dāng yì zhuàng","abbr":"ldyz","explanation":"当：应该；益：更加；壮：雄壮。年纪虽老而志气更旺盛，干劲更足。","source":{"text":"丈夫为志，穷当益坚，老当益壮。","book":"《后汉书·马援传》"},"example":{"text":"剑波朝着这两位坚守职务的老森铁员工，伸了一下大拇指头，“真英雄，～。”","book":"曲波《林海雪原》一六"},"similar":["老骥伏枥","衰当益壮"],"opposite":["未老先衰"],"usage":"作谓语、定语；用于老年人","story":["西汉末年扶风郡马援知书达理，武功高强，他哥哥死后，他侍奉嫂子与养育哥哥的儿女。他私自放走可怜的囚犯而只好逃到北方牧羊为生，他成为当地有名的富农之后，经常施舍附近的穷人，他的名言是“大丈夫要老当益壮。”"]},{"id":37058,"word":"老态龙钟","pinyin":"lǎo tài lóng zhōng","abbr":"ltlz","explanation":"龙钟：行动不灵便的样子。形容年老体衰，行动不灵便。","source":{"text":"交结渐时辈，龙钟似老翁。","book":"唐·李端《赠谢戴》"},"example":{"text":"有一位～的工兵营营长吴某到站台迎接，并且报告锦州形势混乱，火车不能开过。","book":"陶菊隐《北洋军阀统治时期史话》第六十九回"},"similar":["老气横秋"],"opposite":["返老还童","老当益壮","生气勃勃"],"usage":"作谓语、状语、定语；用于人等","story":["宋朝时期，陆游年老时病魔缠身，不能清闲安静地渡过晚年生活。夜晚，天下起了大雨，听着这萧萧的暮雨声，感慨自己的身世和遭遇，作《听雨》诗：“老态龙钟疾未平，更堪俗事败幽情。纱橱笛覃差堪乐，且听萧萧暮雨声。”"]},{"id":37059,"word":"老成之见","pinyin":"lǎo chéng zhī jiàn","abbr":"lczj","explanation":"老成：阅历多而练达世事。老练而周到的见解。","source":{"text":"不想今日原从这个，可见了老成之见，大略相同。","book":"明·冯梦龙《醒世恒言》卷十七"},"example":{"text":"足下所言，实是～。","book":"明·凌濛初《二刻拍案惊奇》卷三十二"},"usage":"作宾语；用于观点等"},{"id":37060,"word":"老成典型","pinyin":"lǎo chéng diǎn xíng","abbr":"lcdx","explanation":"指年老有德，深孚重望，堪为人师表。","source":{"text":"及余归柳浪，而念公适至，老成典型，居然在目。","book":"明·袁宏道《书念公碑文后》"},"example":{"text":"这数家之～，六七十岁的，英年时隽这二三十岁的，走价相约，公同一日道喜。","book":"清·李绿园《歧路灯》第一百六回"}},{"id":37061,"word":"老成凋谢","pinyin":"lǎo chéng diāo xiè","abbr":"lcdx","explanation":"年高而有德的人去世了。多用作挽词。","source":{"text":"山门前后皆长松，参天蔽日，相传以为中峰手植，岁久，浸淫为寺僧剪伐，什不存一，见之辄有老成凋谢之感。","book":"明·张岱《西湖梦寻·云居庵》"},"example":{"text":"饿死的饿死，～，继起无人，于是乞丐一业逐渐衰微。","book":"梁实秋《乞丐》"}},{"id":37062,"word":"老成历练","pinyin":"lǎo chéng lì liàn","abbr":"lcll","explanation":"老成：阅历多；历练：长久从事而有经验。指阅历丰富，练达世事。","source":{"text":"太常正卿白玄，老成历练，大有才气。若充迎请上皇之使，定当不辱君命。","book":"清·荑荻散人《玉娇梨》第三回"},"similar":["历练老成"],"usage":"作谓语、定语；用于人的阅历"},{"id":37063,"word":"老成持重","pinyin":"lǎo chéng chí zhòng","abbr":"lccz","explanation":"老成：阅历多而练达世事；持重：做事谨慎。办事老练稳重，不轻举妄动。","source":{"text":"师中老成持重，为时名将。","book":"《汉书·韦元成传》：“守正持重，不及父贤，而文采过之。”《宋史·种师中传》"},"example":{"text":"我们只要看举了～的汤蛰山先生做都督，就可以知道是不会流血的了。","book":"鲁迅《南腔北调集·谣言世家》"},"similar":["深思远虑","少年老成"],"opposite":["初出茅庐","操之过急","轻举妄动"],"usage":"作谓语、定语；指人老道","story":["宋朝时期，金兵入侵中原，种师中奉诏迎敌，乘胜收复寿阳、榆次等地。金兵故意分散兵力，前方侦探上报朝廷认为是上好的出兵机会，老成持重的种师中认为这是敌人的阴谋，可君命难违，只好出兵，结果中了敌人的埋伏，全军覆没"]},{"id":37064,"word":"老成炼达","pinyin":"lǎo chéng liàn dá","abbr":"lcld","explanation":"形容人稳重老练，通达事理。","source":{"text":"朕今添封殿前正副赍奏官二员，职同天将，专理进本事务，令表们选举老成炼达元臣保封。","book":"太平天国·洪秀全《设赍奏官诏》"},"similar":["老成练达"],"opposite":["冒冒失失"],"usage":"作谓语、定语；指人老练"},{"id":37065,"word":"老成练达","pinyin":"lǎo chéng liàn dá","abbr":"lcld","explanation":"练达：指阅历多而通达人情。形容人稳重老练，通达事理。","source":{"text":"杜预为人，老成练达，好学不倦，最喜欢读左秋明《春秋传》。","book":"明·罗贯中《三国演义》第一百二十回"},"example":{"text":"我如今～，计出万全，不是从前卤（鲁）莽了。","book":"清·李渔《怜香伴·随车》"},"similar":["老成炼达"],"opposite":["冒冒失失"],"usage":"作谓语、定语；指人老练","story":["三国时期，羊祜听说吴主孙皓罢免陆抗的兵权，就向司马炎上表伐吴。司马炎不同意，羊祜再次上朝面谏，提议如果不趁此机会就很难灭吴。司马炎让他率军攻吴，他称病不能胜任，就推荐老成练达的杜预担此大任"]},{"id":37066,"word":"老成见到","pinyin":"lǎo chéng jiàn dào","abbr":"lcjd","explanation":"见到：见识周到。阅历丰富，见解高明。","source":{"text":"有理，有理！老成见到之言，句句合着鄙意。","book":"清·孔尚任《桃花扇》第32出"},"example":{"text":"她一向～，有自己的见解。"},"similar":["老成练达"],"usage":"作谓语、定语；指人见解独特"},{"id":37067,"word":"老手宿儒","pinyin":"lǎo shǒu xiǔ rú","abbr":"lssr","explanation":"宿儒：长期研究儒家经典的人。指年辈大的老师或知识渊博的学者。","source":{"text":"三百篇之诗，有出于妇人女子，而后世老师宿儒，且不能注释得分明，岂其智有所不若。","book":"宋·陆九渊《语录》"},"similar":["老手宿儒"],"usage":"作主语、宾语；用于书面语"},{"id":37068,"word":"老有所终","pinyin":"lǎo yǒu suǒ zhōng","abbr":"lysz","explanation":"年老者能有个合适的归宿。","source":{"text":"故人不独亲其亲，不独子其子，使老有所终，壮有所用，幼有所长。","book":"西汉·戴圣《礼记·礼运》"},"example":{"text":"使生有所养，～，死有所送也。","book":"唐·白居易《策林四·养老》"},"similar":["老有所养"],"opposite":["流离失所"],"usage":"作宾语；指养老"},{"id":37069,"word":"老朽无能","pinyin":"lǎo xiǔ wú néng","abbr":"lxwn","explanation":"老朽：衰老陈腐。形容人衰老不能做什么事情。","source":{"text":"以耽沈之利欲，役老朽之筋骸。","book":"郑愚《潭州大沩山同庆寺大圆禅师碑铭序》"},"example":{"text":"我们这一辈子的人都是～了，“英雄出少年”，倒是……可以做一番事业。","book":"清·李宝嘉《官场现形记》第五十回"},"usage":"作谓语、定语；用于自谦"},{"id":37070,"word":"老来俏","pinyin":"lǎo lái qiào","abbr":"llq","explanation":"衣着打扮如青年人的中老年人。","source":{"text":"这个老狐狸头上并无一根黑发，还闹这些花样，倒是一个‘老来俏’。","book":"清·李汝珍《镜花缘》第99回"},"example":{"text":"双眼明亮，身材苗条，是个‘～’。","book":"高阳《胡雪岩全传·烟消云散》"},"usage":"作宾语、定语；多用于口语"},{"id":37071,"word":"老来有喜","pinyin":"lǎo lái yǒu xǐ","abbr":"llyx","explanation":"指老年有喜事。","example":{"text":"他们～，喜结良缘。"},"similar":["老蚌生珠","老来得子"],"usage":"作谓语；指老年有喜事","story":["元始天尊命昆仑山学道的72岁的姜子牙下山辅佐周武王登基，姜子牙收拾行装来到了京城朝歌投奔好友宋异人。宋异人见他至今还是孤身一人，就去马家庄找马老爷给姜子牙说媒，将马老爷68岁的黄花女儿许配给姜子牙。两位老来有喜"]},{"id":37072,"word":"老死不相往来","pinyin":"lǎo sǐ bù xiāng wǎng lái","abbr":"lsbxwl","explanation":"指彼此不联系，不交流情况。","source":{"text":"邻国相望，鸡犬之声相闻，民至老死，不相往来。","book":"春秋·楚·李耳《老子》"},"example":{"text":"盖在太古，民物未繁，原可闭关统治，～。","book":"清·薛福成《英吉利用商务辟荒地说》"},"similar":["互不来往"],"opposite":["你来我往"],"usage":"作谓语、定语；形容彼此一直不发生联系","story":["春秋时期，思想家老子认为相邻的两个国家彼此可以望见，两国鸡狗的叫声都可以听见，各自吃自己的国家丰富的食物，穿自己的衣服，按照自己的风俗生活，直到老死都不互相往来。司马迁认为这种老死不相往来的思想行不通"]},{"id":37073,"word":"老死沟壑","pinyin":"lǎo sǐ gōu hè","abbr":"lsgh","explanation":"沟壑：溪谷。老死于山谷之中。指平庸地死去。","source":{"text":"为社稷长久之计，以上安二宫朝夕之养，下以济四方亿兆之命，则臣虽老死沟壑，瞑目於地下矣！","book":"宋·苏轼《代张方平谏用兵书》"},"usage":"作谓语、定语；用于自谦"},{"id":37074,"word":"老死牖下","pinyin":"lǎo sǐ yǒu xià","abbr":"lsyx","explanation":"形容终其天年。","source":{"text":"疾时处北牖下，死而迁之当牖下。","book":"《仪礼·士丧礼》：“死于适室，幠用敛衾。”郑玄注"},"example":{"text":"假若误出误入，那有罪的～，无罪的却命绝了囹圄刀锯之间。","book":"明·凌濛初《初刻拍案惊奇》卷十一"},"usage":"作谓语、定语；用于书面语"},{"id":37075,"word":"老气横秋","pinyin":"lǎo qì héng qiū","abbr":"lqhq","explanation":"老气：老年人的气派；横：充满。形容老练而自负的神态。现形容自高自大，摆老资格。也形容缺乏朝气。","source":{"text":"风情张日，霜气横秋。","book":"南朝·齐·孔稚珪《北山移文》"},"example":{"text":"众人取笑了一回，见新人～的那个样子，便纷纷散去。","book":"清·吴趼人《二十年目睹之怪现状》第七十回"},"similar":["老态龙钟"],"opposite":["老成持重","老当益壮"],"usage":"作谓语、定语、状语；形容老练而自负的神态","story":["南朝时期，齐国的孔稚珪是一个风韵清雅的隐士，当他得知曾经隐居于钟山的周彦伦要出任海盐县令时，觉得周彦伦不是真正的隐士，远不及巢父及许由有志气，于是作《北山移文》：“风情张日，霜气横秋。”"]},{"id":37076,"word":"老江湖","pinyin":"lǎo jiāng hú","abbr":"ljh","explanation":"指在外多年，很有阅历，非常世故的人。","source":{"text":"须知我也是个老江湖，岂肯上你的当？","book":"清·吴趼人《二十年目睹之怪现状》第50回"},"example":{"text":"他是一个十足的～。"},"similar":["江湖骗子"],"usage":"作主语、宾语、定语；指很有阅历"},{"id":37077,"word":"老油子","pinyin":"lǎo yóu zǐ","abbr":"lyz","explanation":"指老于算计的人。","source":{"text":"看他也不象习于行旅，相当难缠的‘老油子’，因而答应容留。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["老油条"],"usage":"作宾语、定语；用于口语"},{"id":37078,"word":"老油条","pinyin":"lǎo yóu tiáo","abbr":"lyt","explanation":"比喻处世经验丰富而油滑的人，或者是老毛病总是改不掉的人。","source":{"text":"那匹菊花青，正是这样一个马中的‘老油条’。","book":"高阳《胡雪岩全传·烟消云散》"},"example":{"text":"她可算是～了，你的批评她会丝毫不在乎的。"},"similar":["老油子"],"usage":"作宾语、定语；用于口语"},{"id":37079,"word":"老泪纵横","pinyin":"lǎo lèi zòng héng","abbr":"llzh","explanation":"纵横：交错。老人泪流满面，形容极度悲伤或激动。","source":{"text":"请为父老歌，艰难愧深情。歌罢仰天叹，四座泪纵横。","book":"唐·杜甫《羌村三首》"},"example":{"text":"他的儿子在前线光荣牺牲，听到这个消息，他不禁～。"},"similar":["满面泪痕","泪如雨下"],"opposite":["笑逐颜开","眉开眼笑"],"usage":"作谓语、定语；常与“泣不成声”连用","story":["公元757年，杜甫得到唐肃宗的许可回家探亲，在回家途中亲眼看到安史之乱所造成的种种惨境。邻居问他战争何时才能结束，并诉说家乡的苦难：地没有耕种，孩子们被逼去打仗……说到伤心处，乡亲们老泪纵横，杜甫只好仰天长叹"]},{"id":37080,"word":"老熊当道","pinyin":"lǎo xióng dāng dào","abbr":"lxdd","explanation":"当道：把路挡住。比喻猛将镇守要塞。","source":{"text":"老熊当道踞津门，一旅师如万骑屯。","book":"清·钱谦益《元日杂题长句八首》之五"},"similar":["老罴当道"],"usage":"作宾语；指猛将镇守要塞"},{"id":37081,"word":"老牛拉破车","pinyin":"lǎo niú lā pò chē","abbr":"lnlpc","explanation":"形容人做事就像老牛拉破车，慢慢吞吞，不讲究效率。","example":{"text":"我这是～，勉强维持罢了。"},"similar":["老牛破车"],"usage":"作谓语、定语；指做事效率低"},{"id":37082,"word":"老牛破车","pinyin":"lǎo niú pò chē","abbr":"lnpc","explanation":"老牛拉破车。比喻做事慢吞吞，一点不利落。也比喻才能低。","source":{"text":"常乘赢牛笨车，逢峻卤簿，即屏往道侧。","book":"《宋书·颜延之传》"},"example":{"text":"七月七刚过去，～的故事不知又被说过多少次。","book":"老舍《我怎样写》"},"similar":["慢条斯理","蜗行牛步"],"opposite":["急若流星","光阴似箭","日月如梭"],"usage":"作谓语、定语；指做事效率低"},{"id":37083,"word":"老牛舐犊","pinyin":"lǎo niú shì dú","abbr":"lnsd","explanation":"舐：舔；犊：小牛。老牛舔小牛。比喻父母疼爱子女。","source":{"text":"愧无日磾先见之明，犹怀老牛舐犊之爱。","book":"《后汉书·杨彪传》"},"example":{"text":"～，情所难禁。","book":"清·李绿园《歧路灯》第七十七回"},"similar":["望子成龙","爱子心切"],"opposite":["掩鼻而过","深恶痛绝"],"usage":"作主语、宾语；指父母怜爱子女","story":["东汉末年，曹操进攻刘备，在斜谷界口驻扎，陷于进退两难境地，部将夏侯淳询问夜间口令，曹操随口说鸡肋。杨修认为是曹操退兵的意思，叫士兵打点行装，曹操借口杀了杨修。后见到骨瘦如柴的杨修父亲杨彪，问为何？杨彪说有舐犊之爱"]},{"id":37084,"word":"老物可憎","pinyin":"lǎo wù kě zēng","abbr":"lwkz","explanation":"老物：骂人的话；憎：十分可恶。指令人憎恶的人。","source":{"text":"帝尝卧疾，后往省病。帝曰：‘老物可憎，何烦出也。’","book":"《晋书·宣穆张皇后传》"}},{"id":37085,"word":"老王卖瓜","pinyin":"lǎo wáng mài guā","abbr":"lwmg","explanation":"比喻自己称赞自己的货色好或本领高强。","source":{"text":"这是我出的大字报呵！那不成了老王卖瓜，自卖自夸了吗？","book":"杨啸《大字报》"},"example":{"text":"他最爱～了。"},"similar":["王婆卖瓜"],"usage":"作宾语；指自我吹嘘"},{"id":37086,"word":"老生常谈","pinyin":"lǎo shēng cháng tán","abbr":"lsct","explanation":"老书生经常说的话。比喻人们听惯了的没有新鲜意思的话。","source":{"text":"此老生之常谈。","book":"《三国志·魏书·管辂传》"},"example":{"text":"功名富贵无凭据，费尽心机，总把流光误。浊酒三杯沉醉去，水流花谢知何处？这一首词，也是个～。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["陈词滥调","老调重弹"],"opposite":["标新立异","真知灼见"],"usage":"作谓语、宾语；指没有新意的话","story":["三国时期，魏国术士管辂精通《易经》，尚书何晏和邓煬请管辂为他们算命何时才能升到三公之位。管辂不敢得罪他们，看了卦相，他讲大道理，请何晏忠于职守、体察民情、广施恩德，才能位列三公。邓煬很不高兴地说这是老生常谈的东西"]},{"id":37087,"word":"老生常谭","pinyin":"lǎo shēng cháng tán","abbr":"lsct","explanation":"谭：同“谈”。指年老书生的平凡议论。比喻人们听惯了的没有新意的话。","source":{"text":"此老生之常谭。","book":"晋·陈寿《三国志·魏志·管辂传》"},"similar":["老生常谈"],"usage":"作谓语、宾语；指没有新意的话","story":["三国时期，魏国术士管辂精通《易经》，尚书何晏和邓煬请管辂为他们算命何时才能升到三公之位。管辂不敢得罪他们，看了卦相，他讲大道理，请何晏忠于职守、体察民情、广施恩德，才能位列三公。邓煬很不高兴地说这是老生常谈的东西"]},{"id":37088,"word":"老皇历","pinyin":"lǎo huáng lì","abbr":"lhl","explanation":"比喻过时的老规矩。","source":{"text":"既然社会的变化已经成为铁的事实，那么聪敏人就不应该再抱着一本老皇历念到头。","book":"路遥《平凡的世界》第三卷第16章"},"example":{"text":"我们不能再照～办事了。"},"similar":["老黄历"],"usage":"作宾语、定语；用于口语"},{"id":37089,"word":"老着脸皮","pinyin":"lǎo zhe liǎn pí","abbr":"lzlp","explanation":"形容不顾羞耻。多用于向人求情、讨好、借债等等使人感到难堪的事情。","source":{"text":"那白长吉昔日把遐叔何等奚落，及至中了，却又老着脸皮，备了厚礼也来称贺。","book":"明·冯梦龙《醒世恒言》卷二十五"},"example":{"text":"周炳也没法儿，只好～向校长林开泰预借十块钱明年的薪水。","book":"欧阳山《苦斗》十八"},"usage":"作谓语、定语；用于口语"},{"id":37090,"word":"老着面皮","pinyin":"lǎo zhe miàn pí","abbr":"lzmp","explanation":"形容不顾羞耻。多用于向人求情、讨好、借债等等使人感到难堪的事情。","source":{"text":"唐卿便老着面皮谢女子道：‘昨日感卿包容，不然小生面目难施了。’","book":"明·凌濛初《初刻拍案惊奇》卷三十二"}},{"id":37091,"word":"老练通达","pinyin":"lǎo liàn tōng dá","abbr":"lltd","explanation":"老成干练，通晓事理。","example":{"text":"德公～，深谋远虑，啥事体都有自己的一套办法。","book":"周而复《上海的早晨》二十九"}},{"id":37092,"word":"老罴当道","pinyin":"lǎo pí dāng dào","abbr":"lpdd","explanation":"比喻猛将镇守要塞。","source":{"text":"罴除华州剌史……便袒身露髻徒跣，持一白棒，大呼而出，谓曰：‘老罴当道卧，貉子那得过！’敌见，惊退。","book":"《北史·王罴传》"},"example":{"text":"老熊当道踞津门，一旅师如万骑屯。","book":"清·钱谦益《元日杂题长句八首》之五"},"similar":["老熊当道"],"usage":"作宾语；指猛将镇守要塞","story":["南北朝时期，王罴任华州刺史，修筑城墙加强防御。神武派韩轨、司马子如率军前去偷袭华州，王罴丝毫也没有发觉，敌人爬上城墙时他还在睡觉。见有动静，王罴赤身裸体拿起大棒迎敌，大声喝道：“老罴当道卧，貉子那得过！”"]},{"id":37093,"word":"老羞变怒","pinyin":"lǎo xiū biàn nù","abbr":"lxbn","explanation":"老：很。因羞愧恼恨而发怒。","source":{"text":"想因却奁一事，太激烈了，故此老羞变怒耳。","book":"清·孔尚任《桃花扇·辞院》"},"example":{"text":"危素～，恐要和我计较起来。","book":"清·吴敬梓《儒林外史》第一回"},"similar":["老羞成怒"],"opposite":["兴高采烈"],"usage":"作谓语、定语；指因羞愧恼恨而发怒"},{"id":37094,"word":"老羞成怒","pinyin":"lǎo xiū chéng nù","abbr":"lxcn","explanation":"由于羞愧到了极点，下不了台而发怒。","source":{"text":"乌额拉布见田小辫子说出这样的话来，便也恼羞成怒。","book":"清·李宝嘉《官场现形记》第三十一回"},"example":{"text":"那家伙～，逼着她往前走。","book":"梁斌十三《红旗谱》"},"similar":["恼羞成怒","老羞变怒"],"opposite":["兴高采烈"],"usage":"作谓语、定语；指因羞愧恼恨而发怒","story":["十三妹何玉凤的父亲何杞在纪献唐手下作中军副将，纪献唐想把何玉凤给二儿子纪多文作填房。何杞不愿这门亲事，就对媒人说：“虎女不能配犬子。”纪献唐听后老羞成怒，立即把何杞革职拿问投入牢狱，不久就把他处死"]},{"id":37095,"word":"老老大大","pinyin":"lǎo lǎo dà dà","abbr":"lldd","explanation":"指年事已高。","source":{"text":"师曰：‘老老大大汉，住处也不知。’","book":"宋·释道原《景德传灯录》第十卷"},"example":{"text":"颖叔～，不能以前辈自居，尚何求哉。","book":"宋·朱弁《曲洧旧闻》第八卷"},"usage":"作谓语、定语；用于老人"},{"id":37096,"word":"老老实实","pinyin":"lǎo lǎo shí shí","abbr":"llss","explanation":"指为人诚实、本份。","source":{"text":"你既要在这里，那边去老老实实的坐着，咱们说话儿。","book":"清·曹雪芹《红楼梦》第19回"},"example":{"text":"从这个上面规定我们的方针，不是一般地反对游击主义，而是～地承认红军的游击性。","book":"毛泽东《中国革命战争的战略问题》"},"similar":["实实在在"],"opposite":["老奸巨猾"],"usage":"作谓语、定语、状语；用于人的性格"},{"id":37097,"word":"老老少少","pinyin":"lǎo lǎo shào shào","abbr":"llss","explanation":"指老人与小孩。","source":{"text":"此时众百姓闻得有人揭榜，登时四方轰动，老老少少，无数百姓，都围著观看。","book":"清·李汝珍《镜花缘》第35回"},"example":{"text":"一家～都依靠和指望着他，他怎么能这样胡思乱想呢？","book":"路遥《平凡的世界》第一卷第23章"},"similar":["七老八小"],"usage":"作主语、宾语、定语；用于口语"},{"id":37098,"word":"老而不死","pinyin":"lǎo ér bù sǐ","abbr":"lebs","explanation":"本是孙子骂旧友原壤年老无德可称术的话，后亦指年老而不利于社会国家或拖累后辈。","source":{"text":"幼而不孙弟，长而无述焉，老而不死是为贼！","book":"春秋·鲁·孔丘《论语·宪问》"},"example":{"text":"你道俺～是为贼，俺若不死成何济。","book":"元·无名氏《盆儿鬼》第三折"},"similar":["老而不死是为贼"],"usage":"作谓语、定语；用于老年人","story":["春秋时期，原壤的母亲病故，他并不痛苦反而唱歌。老友孔子认为他不懂礼法。后来他双腿伸长坐在席上等孔子到来，孔子责备他：少时不逊顺恭敬，长大没有可以称道的事情，到年老还不死就会变成害人的东西"]},{"id":37099,"word":"老而不死是为贼","pinyin":"lǎo ér bù sǐ shì wéi zéi","abbr":"lebsswz","explanation":"责骂老而无德行者的话。","source":{"text":"子曰：‘幼而不孙弟，长而无述焉，老而不死是为贼。","book":"《论语·宪问》"},"example":{"text":"常言道：～。正是你这样人！","book":"元·无名氏《盆儿鬼》第三折"},"similar":["老而不死"],"usage":"作宾语、定语；指无德的人","story":["春秋时期，原壤的母亲病故，他并不痛苦反而唱歌。老友孔子认为他不懂礼法。后来他双腿伸长坐在席上等孔子到来，孔子责备他：少时不逊顺恭敬，长大没有可以称道的事情，到年老还不死就会变成害人的东西"]},{"id":37100,"word":"老而弥坚","pinyin":"lǎo ér mí jiān","abbr":"lemj","explanation":"弥：更加。人虽已老，但志向却更加坚定。","source":{"text":"因却不允。吾不知其一介不取之心，至老而弥坚也。","book":"清·钱湘《续刻荡寇志序》"}},{"id":37101,"word":"老而弥笃","pinyin":"lǎo ér mí dǔ","abbr":"lemd","explanation":"弥：更加；笃：深厚。人越老对某种事物的感情越深。","source":{"text":"天真高洁，老而弥笃。玄虚静素，有夷，皓之节。宜蒙征命，以励风俗。","book":"《三国志·魏志·管宁传》"},"example":{"text":"近日因病，然经降旨慰问，该大学士力疾从公，忠靖之忱，～。","book":"丁中江《北洋军阀史话》十六"},"usage":"作谓语、定语；用于处事"},{"id":37102,"word":"老而益壮","pinyin":"lǎo ér yì zhuàng","abbr":"leyz","explanation":"老：老年；益：更加；壮：强壮，雄壮。年纪虽老而志气更强壮。","source":{"text":"丈夫为志，穷当益坚，老当益壮。","book":"南朝·宋·范晔《后汉书·马援传》"},"similar":["老当益壮"],"opposite":["未老螲衰"],"usage":"作谓语、定语；用于老年人"},{"id":37103,"word":"老莱娱亲","pinyin":"lǎo lái yú qīn","abbr":"llyq","explanation":"表示孝顺父母。","source":{"text":"老莱子孝养二亲，行年七十，婴儿自娱，着五色彩衣，尝取浆上堂，跌仆，因卧地为小儿蹄，或美鸟鸟于亲侧。","book":"西汉·刘向《列女传》"},"example":{"text":"其中最使我不解，甚至于发生反感的，是‘～’和‘郭巨埋儿’两件事。","book":"鲁迅《朝花夕拾·》"},"similar":["彩衣娱亲"],"usage":"作宾语、定语；指孝敬父母","story":["春秋时期，楚国隐士老莱子非常孝顺父母，想尽一切办法讨父母的欢心，使他们健康长寿。他70岁时父母还健在，为了不让父母见他有白发而伤感，他做一套五彩斑斓的衣服穿在身上，走路时装成小儿跳舞的样子使父母高兴"]},{"id":37104,"word":"老虎借猪，相公借书","pinyin":"lǎo hǔ jiè zhū，xiàng gōng jiè shū","abbr":"lhjzxgjs","explanation":"相公：旧指读书人。比喻东西正合自己的心愿，到手后就据为己有。也比喻各有各的爱好。"},{"id":37105,"word":"老虎头上扑苍蝇","pinyin":"lǎo hǔ tóu shàng pū cāng yíng","abbr":"lhtspcy","explanation":"比喻自己找死。","source":{"text":"老虎头上扑苍蝇，怎的？落得做好好先生。","book":"清·吴敬梓《儒林外史》第六回"},"example":{"text":"他敢～。"},"similar":["老虎头上打苍蝇"],"usage":"作宾语、分句；指胆大妄为"},{"id":37106,"word":"老虎头上打苍蝇","pinyin":"lǎo hǔ tóu shàng dǎ cāng yíng","abbr":"lhtsdcy","explanation":"比喻自己找死。","source":{"text":"谁敢在老虎头上打苍蝇，三爷有的是孙子们孝敬的银子！","book":"清·刘鹗《老残游记》第二十回"},"similar":["老虎头上扑苍蝇"],"usage":"作宾语、分句；指胆大妄为"},{"id":37107,"word":"老虎头上搔痒","pinyin":"lǎo hǔ tóu shàng sāo yǎng","abbr":"lhtssy","explanation":"比喻不自量力。","example":{"text":"今严嵩父子，威焰薰天，一百个仇鸾，尚敌不过他，～，无补国家，转取祸戾，何苦何苦！","book":"蔡东藩《明史演义》第六十三回"},"similar":["老虎嘴中拔牙"],"usage":"作宾语、定语、分句；用于比喻句"},{"id":37108,"word":"老虎屁股","pinyin":"lǎo hǔ pì gǔ","abbr":"lhpg","explanation":"形容十分棘手的事情或危险的处境。","source":{"text":"不许人讲话，老虎屁股摸不得，凡是采取这种态度的人，十个就有十个要失败。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"example":{"text":"现在，在干部中有一个主要问题，就是怕，不敢摸～。","book":"邓小平《当前钢铁工业必须解决的几个问题》"},"usage":"作主语、宾语、定语；多用于比喻句"},{"id":37109,"word":"老虎屁股摸不得","pinyin":"lǎo hǔ pì gu mō bù dé","abbr":"lhpgmbd","explanation":"比喻自以为是了不起，听不得批评意见，一触即跳。","source":{"text":"不许人讲话，老虎屁股摸不得，凡是采取这种态度的人，十个就有十个要失败。","book":"毛泽东《在扩大的中央工作会议上的讲话》"},"example":{"text":"有的单位，个别人长期闹派性，有恃无恐，～。","book":"邓小平《在中央军委全体会议上的讲话》"},"usage":"作宾语、定语、分句；用于口语"},{"id":37110,"word":"老蚌珠胎","pinyin":"lǎo bàng zhū tāi","abbr":"lbzt","explanation":"指老妇人得子。","source":{"text":"金环乘穴真堪信，老蚌珠胎倍可欣。","book":"清·姚鼐《香亭得雄于其去岁所失小郎有再生之征一诗为贺兼以识异》"},"example":{"text":"她万万没想到～，老年得子。"},"similar":["老蚌生珠"],"usage":"作谓语、宾语；指老年得子"},{"id":37111,"word":"老蚌生珠","pinyin":"lǎo bàng shēng zhū","abbr":"lbsz","explanation":"原比喻年老有贤子。后指老年得子。","source":{"text":"吾以卿老蚌遂出明珠。","book":"汉·孔融《与韦端书》：“不意双珠近出老蚌，甚珍贵之。”《北齐书·陆卬传》"},"example":{"text":"已见熊罴入梦，行看～。","book":"明·赵弼《蓬莱先生传》"},"similar":["老蚌珠胎"],"usage":"作谓语、宾语；指老年得子","story":["东汉末年，韦端的儿子元将与仲将先后慕名登门拜访建安七子的孔融。孔融十分喜爱他们。他给韦端写信，认为他的大儿子才学渊博，态度风雅，可以建功立业，小儿子有真才实学，可以持家守业，并夸他老蚌生双珠"]},{"id":37112,"word":"老蚕作茧","pinyin":"lǎo cán zuò jiǎn","abbr":"lczj","explanation":"老蚕吐丝作茧，把自己包在里面。比喻自己束缚自己。","source":{"text":"老蚕作茧何时脱？梦想至人空激烈。","book":"宋·苏轼《石芝》"},"example":{"text":"我这是～——自己害自己。"},"similar":["作茧自缚"],"usage":"作宾语；指自我束缚"},{"id":37113,"word":"老街旧邻","pinyin":"lǎo jiē jiù lín","abbr":"ljjl","explanation":"老街坊，旧邻居。指相处多年的左邻右舍或老乡亲。","example":{"text":"想起～，想起千里堤上的白杨树，想起滹沱河里的流水，心上就象蒙上一层愁。","book":"梁斌《红旗谱》三"}},{"id":37114,"word":"老调重弹","pinyin":"lǎo diào zhòng dàn","abbr":"ldzd","explanation":"比喻把说过多次的理论、主张重新搬出来。也比喻把搁置很久的技艺重新做起来。亦作“旧调重弹”、“重弹老调”。","source":{"text":"如今不过是略换花样，实际是老调重弹罢了。","book":"邹韬奋《无政府与民主政治》"},"example":{"text":"这不是～吗？"},"similar":["故技重演","旧病复发","故态复萌"],"opposite":["推陈出新","焕然一新","破旧立新"],"usage":"作谓语、宾语；指没有新意"},{"id":37115,"word":"老调重谈","pinyin":"lǎo diào chóng tán","abbr":"ldct","explanation":"又弹起陈旧的老调子。比喻把说过多次的理论、主张重新搬出来。也比喻把搁置很久的技艺重新做起来。","source":{"text":"如今不过是略搬花样，实际是老调重谈罢了。","book":"邹韬奋《无政府与民主政治》"},"similar":["旧调重弹"],"opposite":["改弦易张","改弦易辙"],"usage":"作谓语、宾语；指缺乏新意"},{"id":37116,"word":"老谋深算","pinyin":"lǎo móu shēn suàn","abbr":"lmss","explanation":"周密的筹划，深远的打算。形容人办事精明老练。","source":{"text":"沉毅哉！老谋深算，革命军之军事家。","book":"清·曾朴《孽海花》第二十九回"},"example":{"text":"现在他颇有点后悔刚才的“失恋”，他的～走了这么一个方面。","book":"茅盾《子夜》第四章"},"similar":["老奸巨猾","足智多谋","深谋远虑"],"opposite":["入世不深","初出茅庐"],"usage":"作谓语、定语、宾语；指精明老练","story":["春秋时期，晋献公到小国翟祖打猎时很想把它吞并，以至寝食不安。老谋深算的大臣唂叔虎看出晋献公的心思，于是给大夫士蒍出谋划策，让他出面请战，两人奉献公之命率军攻打翟祖国，经过大家的奋力拼杀终于取得胜利"]},{"id":37117,"word":"老身长子","pinyin":"lǎo shēn zhǎng zǐ","abbr":"lscz","explanation":"自己老了，儿子也长大了。","source":{"text":"而狂惑戆陋之人，乃始率其群徒，辩其谈说，明其辟称，老身长子，不知恶也。","book":"《荀子·儒效》"},"example":{"text":"～知无憾，泛宅浮家苦未能。","book":"宋·陆游《书志》诗"},"usage":"作定语、状语；用于书面语"},{"id":37118,"word":"老迈龙钟","pinyin":"lǎo mài lóng zhōng","abbr":"lmlz","explanation":"形容年老体衰，行动不便。","source":{"text":"当日来时是何等样精力强壮，那知如今老迈龙钟，如同一场春梦。","book":"清·李汝珍《镜花缘》第99回"},"example":{"text":"他已经进入～的年代。"},"similar":["老态龙钟","老气横秋"],"opposite":["生机勃勃"],"usage":"作谓语、定语；指老年人"},{"id":37119,"word":"老马为驹","pinyin":"lǎo mǎ wéi jū","abbr":"lmwj","explanation":"比喻老人被当作孩童一样地轻慢。也比喻年老而壮心不已。","source":{"text":"老马反为驹，不顾其后。","book":"《诗经·小雅·角弓》"},"example":{"text":"～信不虚，当时得意况深眷。","book":"唐·杜甫《病后过王倚饮赠歌》"},"usage":"作宾语、定语；用于处事等"},{"id":37120,"word":"老马嘶风","pinyin":"lǎo mǎ sī fēng","abbr":"lmsf","explanation":"嘶：马叫。马老了但雄风犹在，鸣叫的声音还很雄壮。","source":{"text":"这位舅太太也算就得个‘老马嘶风，英心未退’了！","book":"清·文康《儿女英雄传》第27回"},"example":{"text":"他还有当年～的雄风。"},"similar":["老骥嘶风"],"usage":"作宾语、定语；用于老年人","story":["安学海想把十三妹何玉凤嫁给自己的儿子安骥。何玉凤因父亲得罪纪献唐而被处死，她心灰意冷，只想寄身空门。安学海让安骥的舅母（何玉凤的干娘）去劝说，因为她算是“老马嘶风，英心未退”，在何玉凤为父母守孝期间成就了好事"]},{"id":37121,"word":"老马恋栈","pinyin":"lǎo mǎ liàn zhàn","abbr":"lmlz","explanation":"恋：留恋；栈：马栈。老马不妒忌离开马栈。比喻老年人恋念旧情。也指年老还贪恋官位。","source":{"text":"驽马恋栈豆。","book":"《晋书·宣帝纪》"},"usage":"作宾语、定语；用于比喻句"},{"id":37122,"word":"老马识途","pinyin":"lǎo mǎ shí tú","abbr":"lmst","explanation":"老马认识路。比喻有经验的人对事情比较熟悉。","source":{"text":"管仲、隰朋从于桓公伐孤竹，春往冬返，迷惑失道。管仲曰：‘老马之智可用也。’乃放老马而随之。遂得道。","book":"《韩非子·说林上》"},"example":{"text":"～添病骨，穷猿投树择深枝。","book":"清·黄仲则《立秋后二日》"},"similar":["识途老马","驾轻就熟","轻车熟路"],"opposite":["不知所以","乳臭未干"],"usage":"作宾语、定语；指年纪大的人富有经验","story":["春秋时期，齐桓公率兵攻打山戎，山戎首领密庐投奔孤竹。孤竹国君答里呵听从宰相兀律的建议，杀掉密庐假降齐军，并把齐军引向旱海沙漠。齐桓公采纳管仲的建议，挑选几匹漠北的老马给齐军带路，走出沙漠，乘机攻占孤竹，杀死答里呵"]},{"id":37123,"word":"老骥伏枥","pinyin":"lǎo jì fú lì","abbr":"ljfl","explanation":"骥：良马，千里马；枥：马槽，养马的地方。比喻有志向的人虽然年老，仍有雄心壮志。","source":{"text":"老骥伏枥，志在千里。","book":"三国·魏·曹操《步出夏门行》诗"},"example":{"text":"用飞龙在天，对～。","book":"宋·陆游《老学庵笔记》卷一"},"similar":["老当益壮","壮志凌云"],"opposite":["老气横秋","老态龙钟"],"usage":"作谓语、定语、宾语、分句；用于老年人","story":["东汉末年，曹操率军先后消灭董卓、黄巾军、吕布、袁术、袁绍、刘表等地方势力，控制北方领土。袁绍的儿子投奔北方的乌桓，53岁的曹操亲率大军彻底征服20万乌桓人，凯旋后作《步出夏门行》：“老骥伏枥，志在千里。烈士暮年，壮心不已。”"]},{"id":37124,"word":"老骥伏枥，志在千里","pinyin":"lǎo jì fú lì，zhì zà qiān lǐ","abbr":"ljflzzql","explanation":"骥：良马，千里马；枥：马槽，养马的地方。比喻有志向的人虽然年老，仍有雄心壮志。","source":{"text":"老骥伏枥，志在千里。","book":"三国·魏·曹操《步出夏门行》诗"},"example":{"text":"高阳《胡雪岩全传·平步青云》中册：“‘～’，四哥，你果有此心，眼前倒有个机会，可以做一番事业。”"},"similar":["烈士暮年，壮心不已"],"usage":"作定语、宾语、分句；用于老年人","story":["东汉末年，曹操率军先后消灭董卓、黄巾军、吕布、袁术、袁绍、刘表等地方势力，控制北方领土。袁绍的儿子投奔北方的乌桓，53岁的曹操亲率大军彻底征服20万乌桓人，凯旋后作《步出夏门行》：“老骥伏枥，志在千里。烈士暮年，壮心不已。”"]},{"id":37125,"word":"老骥嘶风","pinyin":"lǎo jì sī fēng","abbr":"ljsf","explanation":"嘶：马叫。马老了但雄风犹在，鸣叫的声音还很雄壮。","source":{"text":"‘老骥嘶风，英心不退’，年富力强的青、壮、少年又当如何！","book":"《光明日报》1980.8.18"},"similar":["老马嘶风"],"usage":"作宾语、定语；用于老年人"},{"id":37126,"word":"老鱼跳波","pinyin":"lǎo yú tiào bō","abbr":"lytb","explanation":"鱼随着乐声跳跃。比喻音律精妙绝伦。","source":{"text":"梦入神仙教神妪，老鱼跳波瘦蛟舞。","book":"唐·李贺《李凭箜篌引》"},"usage":"作宾语、定语；用于音乐等"},{"id":37127,"word":"老鸹窝里出凤凰","pinyin":"lǎo guā wō lǐ chū fèng huáng","abbr":"lgwlcfh","explanation":"老鸹：乌鸦。比喻在卑微的环境中产生杰出的人物。","source":{"text":"三姑娘的混名儿叫‘玫瑰花儿’：又红又香，无人不爱，只是有刺扎手。可惜不是太太养的，‘老鸹窝里出凤凰’。","book":"清·曹雪芹《红楼梦》第六十五回"},"example":{"text":"咱马家祖宗八代没出过排场人，轮到你捞到印把子，这就叫粪堆上生棵灵芝草，～。","book":"姚雪垠《李自成》第二卷第二章"},"similar":["鸡窝飞出金凤凰"],"usage":"作宾语、定语；用于口语"},{"id":37128,"word":"老鹤乘轩","pinyin":"lǎo hè chéng xuān","abbr":"lhcx","explanation":"轩：古代官员坐的车。老鹤也坐上了官车。比喻滥居官位。","source":{"text":"冬十二月，狄人伐卫。卫懿公好鹤，鹤有乘轩者。将战，国人受甲者皆曰：‘使鹤，鹤实有禄位，余焉能战。’","book":"《左传·闵公二年》"},"example":{"text":"羝羊触蕃，～，不我知者犹谓乎郎官贵而郡守尊也。","book":"宋·王禹偁《三黜赋》"},"similar":["爱鹤失众"],"usage":"作宾语、定语；用于处事","story":["公元前668年，卫惠公的儿子姬赤成为卫懿公后，不思富国强兵之道，整天喜欢养鹤，甚至荒唐到给鹤封官位，享官禄，鹤穿官服坐豪华马车，百姓怨声载道。北方狄国借机出兵攻打卫国，卫国士兵根本不抵抗就逃散，卫懿公被狄兵所杀"]},{"id":37129,"word":"老黄牛","pinyin":"lǎo huáng niú","abbr":"lhn","explanation":"比喻老老实实、勤勤恳恳工作的人。","example":{"text":"他是我们单位典型的～。"},"usage":"作宾语、定语；用于口语"},{"id":37130,"word":"老鼠尾巴","pinyin":"lǎo shǔ wěi bā","abbr":"lswb","explanation":"比喻条件很差，力量很小。","example":{"text":"我跟着你呀，一辈子也是个～长不大。"},"usage":"作宾语、定语；用于比喻句"},{"id":37131,"word":"老鼠搬姜","pinyin":"lǎo shǔ bān jiāng","abbr":"lsbj","explanation":"比喻劳而无用。","source":{"text":"吾犹老鼠搬生姜，劳而无用也。","book":"明·朱国桢《涌幢小品·竹轩》"}},{"id":37132,"word":"老鼠见猫","pinyin":"lǎo shǔ jiàn māo","abbr":"lsjm","explanation":"比喻十分惧怕。","source":{"text":"月英见了焦氏，犹如老鼠见猫，胆丧心惊，不敢不跟着他走。","book":"明·冯梦龙《醒世恒言》卷二十七"},"example":{"text":"这公子见了大奶奶，如～，贼人遇捕，由他拖扯进房。","book":"清·夏敬渠《野叟曝言》第二十八回"},"usage":"作宾语、定语；指人胆小"},{"id":37133,"word":"老鼠过街","pinyin":"lǎo shǔ guò jiē","abbr":"lsgj","explanation":"比喻害人的东西，人人痛恨。亦作“老鼠过街，人人喊打”。","source":{"text":"弄得这两个怪物原形毕露，‘老鼠过街，人人喊打’，这两个怪物也就容易消灭了。","book":"毛泽东《反对党八股》"},"usage":"作宾语、定语；常与“人人喊打”连用"},{"id":37134,"word":"老鼠过街，人人喊打","pinyin":"lǎo shǔ guò jiē，rén rén hǎn dǎ","abbr":"lsgjrrhd","explanation":"比喻害人的东西，大家一致痛恨。","source":{"text":"弄得这两个怪物原形毕露，‘老鼠过街，人人喊打’，这两个怪物也就容易消灭了。","book":"毛泽东《反对党八股》"},"example":{"text":"犯罪分子是～。"},"similar":["抱头鼠窜","落荒而逃","逃之夭夭"],"opposite":["明目张胆"],"usage":"作宾语、分句；指对待坏人坏事"},{"id":37135,"word":"老龟刳肠","pinyin":"lǎo guī kū cháng","abbr":"lgkc","explanation":"神龟明知有难也不能渡过。比喻难不能避，祸不能免。","source":{"text":"神龟能见梦于元君，而不能避余且之网，知能七十二钻而无遗筴，不能避刳肠之患。如是，则知有所困，神有所不及也。","book":"《庄子·外物》"},"example":{"text":"老龟被刳肠，不如无神灵。","book":"唐·白居易《答〈桐花〉》"},"usage":"作宾语、定语；指祸难","story":["春秋时期，宋元君梦到神龟说渔人余且要捕杀他。第二天，宋元君就找人占卜并真的找到余且。余且说他捕到一个大海龟，费了九牛二虎之力才把它破开取出它的内脏。孔子听说后就感慨道：神龟虽然知道有杀身之祸，但还是不能避免"]},{"id":37136,"word":"老龟烹不烂，移祸于枯桑","pinyin":"lǎo guī pēng bù làn，yí huò yú kū sāng","abbr":"lgpblyhyks","explanation":"比喻有罪过的人安然无事，转祸于无辜的人。","source":{"text":"南朝·宋·刘敬叔《异苑》载：三国时有人献大龟给孙权，孙权命人煮它，烧了一万车柴都煮不烂。诸葛恪建议砍老桑树来煮，结果一煮就烂了。"},"example":{"text":"谁知人心不同，到挑动了家长的一个机括，险些儿送了秀童的性命。正是：～。","book":"明·冯梦龙《警世通言》卷十五"}},{"id":37137,"word":"老龟煮不烂，移祸于枯桑","pinyin":"lǎo guī zhǔ bù làn，yí huò yú kū sāng","abbr":"lgzblyhyks","explanation":"移祸：嫁祸。把祸患转嫁给别人。比喻有罪过的人安然无事，嫁祸于无辜的人。","source":{"text":"险些儿送了秀童的性命。正是：老龟煮不烂，移祸于枯桑。","book":"明·冯梦龙《警世通言》第15卷"},"usage":"作宾语、定语；用于处事","story":["三国时期，有人献只大龟给孙权，孙权让人煮了吃，烧了一万车柴都没有煮烂。孙权大怒，怨厨子的水平太差。诸葛恪立即上前建议砍伐院门外的那棵千年老桑树来煮，孙权同意砍伐。结果用桑树烧火一煮就烂了"]},{"id":37138,"word":"考名责实","pinyin":"kǎo míng zé shí","abbr":"kmzs","explanation":"考核名称与实际是否相符。","source":{"text":"巨细毕载，芜累甚多，而惧榜之以略。考名责实，奚其丧欤？","book":"唐·刘知几《史通·题目》"},"similar":["核名责实"],"usage":"作宾语、定语；用于处事"},{"id":37139,"word":"考绩幽明","pinyin":"kǎo jì yōu míng","abbr":"kjym","explanation":"考绩：考核官吏政绩；幽：昏暗；明：清白。指考核官吏政绩得失。","source":{"text":"三载考绩，三考黜陟幽明。","book":"《尚书·舜典》"},"example":{"text":"吾贱且辱，不得与～之说。","book":"唐·柳宗元《宋薛存义序》"},"usage":"作定语；指考核官吏"},{"id":37140,"word":"考绩黜陟","pinyin":"kǎo jì chù zhì","abbr":"kjcz","explanation":"考核官吏，按其政绩好坏以定升降。","source":{"text":"古诸侯皆义其位，视民如子，爱国如家，于是建诸侯之贤者以为牧，故以考绩黜陟，不统其政，不御其民。","book":"汉·荀悦《汉纪·哀帝纪上》"},"example":{"text":"知人知事，自古为难，故～，察其善恶。","book":"唐·吴兢《贞观政要》"},"usage":"作谓语、宾语；用于官场等"},{"id":37141,"word":"者也之乎","pinyin":"zhě yě zhī hū","abbr":"zyzh","explanation":"者、也、之、乎都是古汉语里常用的虚词。指讲话或写文章咬文嚼字。含讽刺意。","source":{"text":"问黄金谁买《长门赋》，好不直钱也者也之乎。","book":"元·马致远《荐福碑》第一折"},"example":{"text":"见那诗云子曰、～的人，他就摇首闭目，只与云锷颖臭味相投。","book":"明·刘璋《凤凰池》第一回"},"similar":["之乎者也"],"usage":"作定语、宾语；用于书面语"},{"id":37142,"word":"耆儒硕德","pinyin":"qí rú shuò dé","abbr":"qrsd","explanation":"耆：六十岁以上的人。指年高德重的儒者。","source":{"text":"必使耆儒硕德，为之师保。","book":"汉·扬雄《剧秦美新》：“是以耆儒硕老抢其书而远逊。”唐·张九龄《论教皇太子状》"},"example":{"text":"耆儒硕德奇材异能之士，茅拔茹连致无虚月，逮今三十年闲。","book":"元·释念常《佛祖通载》卷二十一"},"similar":["耆儒硕老","耆儒硕望"],"usage":"作主语、宾语；指德高的老年人"},{"id":37143,"word":"耆儒硕望","pinyin":"qí rú shuò wàng","abbr":"qrsw","explanation":"耆：六十岁以上的人。指年高德重的儒者。","source":{"text":"是以耆儒硕老抢其书而远逊。","book":"汉·扬雄《剧秦美新》"},"example":{"text":"四曰翰苑亦颂阿合马功德，宜博访南北～，以重此选。","book":"《元史·崔彧传》"},"similar":["耆儒硕德","耆儒硕老"],"usage":"作主语、宾语；指德高的老年人"},{"id":37144,"word":"耆儒硕老","pinyin":"qí rú shuò lǎo","abbr":"qrsl","explanation":"年高德劭的儒者。","source":{"text":"是以耆儒硕老抢其书而远逊。","book":"汉·扬雄《剧秦美新》"},"similar":["耆儒硕德","耆儒硕望"],"usage":"作主语、宾语；指德高的老年人"},{"id":37145,"word":"耆宿大贤","pinyin":"qí sù dà xián","abbr":"qsdx","explanation":"耆：老。指有名望有学问的老年人。","source":{"text":"耆宿大贤，多见废弁。","book":"南朝·宋·范晔《后汉书·樊儵传》"},"usage":"作主语、宾语、定语；用于老年人"},{"id":37146,"word":"耆年硕德","pinyin":"qí nián shuò dé","abbr":"qnsd","explanation":"耆：古称六十岁为“耆”，指年高。指年老而德高望众。","source":{"text":"耆年硕德，德侔尚父。","book":"《晋书·苻生载记》"},"example":{"text":"至于统一进行，如何公开会议，如何确定制度，当由全国之～，政治名流，共同讨论。","book":"蔡东蕃、许廑父《民国通俗演义》第一三一回"},"similar":["耆德硕老"],"usage":"作主语、宾语；指德高的老年人"},{"id":37147,"word":"耆德硕老","pinyin":"qí dé shuò lǎo","abbr":"qdsl","explanation":"盛德高年的人。","source":{"text":"其后以南省事疏，乃带平章之号，然非耆德硕老有嘉名者，莫得居之焉。","book":"唐·李翱《卓异记·三拜左仆射》"},"similar":["耆儒硕老","耆年硕德"],"usage":"作主语、宾语；指德高的老年人"},{"id":37148,"word":"耆老久次","pinyin":"qí lǎo jiǔ cì","abbr":"qljc","explanation":"耆：老；次：第二。年老有德的人久居低位。","source":{"text":"以耆老久次，转为大夫，恬于势利乃如是。","book":"《汉书·扬雄传赞》"},"example":{"text":"自非～，悃愊无华，则枢机之任，不以轻授。","book":"宋·苏轼《赐新除依前中散大夫充枢密直学士签书枢密院事赵瞻辞免恩命不允诏》"},"usage":"作宾语、定语；用于老年人"},{"id":37149,"word":"而今而后","pinyin":"ér jīn ér hòu","abbr":"ejeh","explanation":"而：语助词。从今以后。","source":{"text":"而今而后，焚蓍龟，毁律历，废六合，斥五行，浩然清虑，则将奚若？","book":"《吕氏春秋·恃君览·长利》：“臣而今而后知吾先君周公之不若太公望封之知也。”《旧唐书·卢藏用传》"},"example":{"text":"孔曰成仁，孟曰取义，惟其义尽，所以仁至。读圣贤书，所学何事？～，庶几无愧！","book":"宋·文天祥《衣带赞》诗"},"usage":"作状语、分句；指从今以后"},{"id":37150,"word":"而立之年","pinyin":"ér lì zhī nián","abbr":"elzn","explanation":"人到三十岁可以自立的年龄。后为三十岁的代称。","source":{"text":"吾十有五而志于学，三十而立，四十而不惑。","book":"《论语·为政》"},"example":{"text":"凡自以为识路者，总过了～，灰色可拘了。","book":"鲁迅《导师》"},"similar":["三十而立"],"usage":"作定语、宾语；指30岁，用于男性","story":["春秋时期，孔子在鲁国政坛受排挤后，带领弟子们周游列国，经历卫、郑、陈、晋等地碰壁后，在蔡国闲居，孔子与弟子们谈起自己的经历，说他从30岁开始立志弘道，到现在快七十岁没能推销出仁政，感慨万千……宰予立即过来安慰孔子"]},{"id":37151,"word":"耍两面派","pinyin":"shuǎ liǎng miàn pài","abbr":"slmp","explanation":"耍两面手法，表里不一，指对斗争双方都采取敷衍的行为。","example":{"text":"我希望你不要～。"},"similar":["两面三刀"],"opposite":["言行一致"],"usage":"作谓语、宾语、定语；指两面三刀"},{"id":37152,"word":"耍嘴皮子","pinyin":"shuǎ zuǐ pí zi","abbr":"szpz","explanation":"指光说不做。也指卖弄口才（含贬义）。","example":{"text":"他只有～的本事。"},"similar":["耍舌头"],"usage":"作谓语、宾语、定语；指卖弄口才"},{"id":37153,"word":"耍心眼儿","pinyin":"shuǎ xīn yǎn ér","abbr":"sxye","explanation":"为个人的利益而对人施展小聪明。","example":{"text":"他老～，得防着点他。"},"similar":["耍手段"],"usage":"作谓语、宾语；指自作聪明"},{"id":37154,"word":"耍手腕","pinyin":"shuǎ shǒu wàn","abbr":"ssw","explanation":"指为达到预想目的而使用手段。","example":{"text":"他一心要向上爬，时常都要～。"},"similar":["耍手段"],"usage":"作谓语、宾语、定语；用于口语"},{"id":37155,"word":"耍滑头","pinyin":"shuǎ huá tóu","abbr":"sht","explanation":"指耍弄手段使自己少出力或不担责任。","source":{"text":"万一老狐狸金俊山耍滑头，这事归根结底还得他来办。","book":"路遥《平凡的世界》第一卷第八章"},"similar":["耍花样","偷奸耍滑"],"usage":"作谓语、定语、宾语；用于口语"},{"id":37156,"word":"耍笔杆子","pinyin":"shuǎ bǐ gǎn zǐ","abbr":"sbgz","explanation":"用笔写作，玩弄文字。","example":{"text":"这个人只会～玩弄人。"},"similar":["玩弄词藻","舞文弄墨"],"usage":"作谓语、定语、宾语；指文痞"},{"id":37157,"word":"耍花枪","pinyin":"shuǎ huā qiāng","abbr":"shq","explanation":"武术中的欺骗对手的假动作。比喻卖弄小聪明的欺骗行为。","source":{"text":"明明是原棉问题，你还有另外一个看法，想耍什么花枪？","book":"周而复《上海的早晨》"},"example":{"text":"也怪我自己不好，～耍得自己扎伤了自己。","book":"高阳《胡雪岩全传·平步青云》中册"},"similar":["耍花腔","耍花招"],"usage":"作谓语、定语；用于口语等"},{"id":37158,"word":"耍花腔","pinyin":"shuǎ huā qiāng","abbr":"shq","explanation":"用虚假而动听的话骗人。","example":{"text":"你不要在我面前～。"},"similar":["耍花样"],"usage":"作谓语、宾语、定语；指欺骗人"},{"id":37159,"word":"耍贫嘴","pinyin":"shuǎ pín zuǐ","abbr":"spz","explanation":"没完没了地跟人说废话或玩笑话。","source":{"text":"你不要～了，我们不相信。"},"example":{"text":"你不要～了，我们不相信"},"similar":["耍嘴皮子"],"usage":"作谓语、宾语、定语；用于口语"},{"id":37160,"word":"耐人咀嚼","pinyin":"nài rén jǔ jué","abbr":"nrjj","explanation":"指耐人寻味。","source":{"text":"坦易者多触景生情，因事起意，眼前景，口头语，自能沁人心脾，耐人咀嚼。","book":"清·赵翼《瓯北诗话·白香山诗一》"},"similar":["耐人寻味"],"usage":"作谓语、定语；指耐人寻味"},{"id":37161,"word":"耐人寻味","pinyin":"nài rén xún wèi","abbr":"nrxw","explanation":"耐：禁得起；寻味：探索体味。意味深长，值得人仔细体会琢磨。","source":{"text":"其所作如《少府画障歌》、《崔少府高齐观三川水涨》诸诗，句句字字追琢入妙，耐人寻味。","book":"清·无名氏《杜诗言志》卷三"},"example":{"text":"这个故事的结尾留下了一个悬念，～。"},"similar":["回味无穷","引人入胜"],"opposite":["枯燥无味","索然无味"],"usage":"作谓语、宾语、定语；形容意味深长"},{"id":37162,"word":"耐人玩味","pinyin":"nài rén wán wèi","abbr":"nrww","explanation":"耐：禁得起；玩味：鉴赏体味。意味深长，值得人仔细体会琢磨。","source":{"text":"《浣溪沙》结句贵情余言外，含蓄不尽。如吴梦窗之‘东风临夜冷于秋’，贺方回之‘行云可是渡江难’，皆耐人玩味。","book":"清·陈廷棹《白雨斋词话》卷一"}},{"id":37163,"word":"耐霜熬寒","pinyin":"nài shuāng áo hán","abbr":"nsah","explanation":"耐：禁得起、受得住；熬：忍受。禁受住严霜酷寒。比喻能经受住严酷的考验。","source":{"text":"疏发应成素，青松独耐霜。","book":"唐·皇甫曾《寄刘员外长卿》"}},{"id":37164,"word":"耒耜之勤","pinyin":"lěi sì zhī qín","abbr":"lszq","explanation":"耒耜：农具。指农事活动。","source":{"text":"王者八政，以食为本，故古者急耕稼之业，致耒耜之勤。","book":"南朝·宋·范晔《后汉书·肃宗孝章帝纪》"},"usage":"作主语、宾语；指农事活动"},{"id":37165,"word":"耒耨之利","pinyin":"lěi nòu zhī lì","abbr":"lnzl","explanation":"耒耨：农具。比喻耕作所得的利益。","source":{"text":"斫木为耜，揉木为耒，耒耨之利，以教天下。","book":"《周易·系辞下》"},"example":{"text":"～，丝枲所生，散于数万里之外。","book":"《新唐书·突厥传》"},"usage":"作宾语；指农事"},{"id":37166,"word":"耒耨之教","pinyin":"lěi nòu zhī jiào","abbr":"lnzj","explanation":"耒耨：农具。农事耕作方法的传授。指教民务农。","source":{"text":"斫木为耜，揉木为耒，耒耨之利，以教天下。","book":"《周易·系辞下》"},"example":{"text":"依神农～，导生民之利。","book":"明·徐光启《农政全书》第三卷"},"usage":"作宾语；指教民务农"},{"id":37167,"word":"耕三余一","pinyin":"gēng sān yú yī","abbr":"gsyy","explanation":"耕种三年，节余一年的粮食。","source":{"text":"三年耕，必有一年之食；九年耕，必有三年之食。","book":"《礼记·王制》"}},{"id":37168,"word":"耕云播雨","pinyin":"gēng yún bō yǔ","abbr":"gyby","explanation":"指控制降雨，改造自然。比喻辛勤劳动。","source":{"text":"唇红齿白，口舌生香；能吐芝兰之芬馥，堪效百鸟之宛转；嘤嘤动听，如抹蜜糖；耕云播雨，扬是传非……","book":"王朔《你不是一个俗人》"},"example":{"text":"她为幼儿教育事业～。"},"usage":"作谓语、宾语；用于文化等方面"},{"id":37169,"word":"耕当问奴","pinyin":"gēng dāng wèn nú","abbr":"gdwn","explanation":"比喻办事应该向内行请教。","source":{"text":"治国如治家。耕当问奴，织当访婢。","book":"《宋书·沈庆之传》"},"similar":["织当访婢"],"usage":"作宾语、定语；指办事应该向内行请教","story":["南北朝时期，宋文帝要向北方扩展疆土，派王云谟等人督师北伐，沈庆之一再向文帝规劝，力陈以前北伐失败的教训，文帝很扫兴，便叫几个文官与他争辩出兵事宜。沈庆之说治国与治家一样，耕当问奴，织当访婢，跟白面书生说这些没有用的"]},{"id":37170,"word":"耕当问奴，织当访婢","pinyin":"gēng dāng wèn nú，zhī dāng fǎng bì","abbr":"gdwnzdfb","explanation":"耕：耕田种地；奴：男仆；织：纺织；访：询问；婢：女仆。耕田的事情要问奴，纺织的事情要问婢。比喻办事应该向内行请教。","source":{"text":"治国如治家，耕当问奴，织当访婢。陛下今欲伐国，而与白面书生谋之，事何由济？","book":"《宋书·沈庆之传》"}},{"id":37171,"word":"耕稼陶渔","pinyin":"gēng jià táo yú","abbr":"gjty","explanation":"耕地、种田、制瓦、打鱼。指古时的各种生产劳动。","source":{"text":"自耕稼陶渔以至为帝，无非取于人者。","book":"《孟子·公孙丑上》"}},{"id":37172,"word":"耕者有其田","pinyin":"gēng zhě yǒu qí tián","abbr":"gzyqt","explanation":"使种田的人有耕种的田地。","source":{"text":"在土地问题上，孙先生主张‘耕者有其田’。","book":"毛泽东《论联合政府》"},"usage":"作宾语、定语；用于社会分配"},{"id":37173,"word":"耕者让畔，行者让路","pinyin":"gēng zhě ràng pàn，xíng zhě ràng lù","abbr":"gzrpxzrl","explanation":"畔：田界。种田的人把田界让给对方，走路的人让开路让别人先走。形容礼让成为社会风气。","source":{"text":"男女异路，市无二价，耕者让畔，行者让路。","book":"《史记·五帝本纪》：“舜耕历山，历山之人皆让畔。”汉·五充《论衡·是应篇》"},"example":{"text":"清·李汝珍《镜花缘》第11回：“刚才我们一路看来，那些‘～’光景，已是不争之意。”"},"similar":["耕者让畔，讼者让田"],"usage":"作宾语、定语、分句；用于社会局面"},{"id":37174,"word":"耕者让畔，讼者让田","pinyin":"gēng zhě ràng pàn，sòng zhě ràng tián","abbr":"gzrpszrt","explanation":"畔：田界。耕田的人把田界所占的地面让给对方，有纠纷的给对方让田。形容礼让已成为社会风气。","source":{"text":"古者政化之成也，则公卿让于朝，士庶人让于都，于鄙，耕者让畔，讼者让田。","book":"清·汪琬《新修至德庙碑》"},"similar":["耕者让畔，行者让路"],"usage":"作宾语、定语、分句；用于社会局面"},{"id":37175,"word":"耕耘树艺","pinyin":"gēng yún shù yì","abbr":"gysy","explanation":"耘：锄草，树：栽植；艺：播种。耕田、锄草、植树、播种。泛指各种农业生产劳动。","source":{"text":"夙兴夜寐，耕耘树艺，手足胼胝，以养其身。","book":"《荀子·子道》"},"usage":"作主语、宾语、定语；指耕作"},{"id":37176,"word":"耗子尾巴","pinyin":"hào zǐ wěi bā","abbr":"hzwb","explanation":"耗子尾巴没有肉。比喻没有多大好处，不值得重视。","example":{"text":"他连～也都不放过，甚至连飞过的苍蝇也要抓一把。"},"usage":"作主语、宾语、定语；用于不值钱的东西"},{"id":37177,"word":"耦俱无猜","pinyin":"ǒu jù wú cāi","abbr":"ojwc","explanation":"耦：两者；猜：猜忌。两方面都不至于猜忌。","source":{"text":"公家之利，知无不为，忠也，送往事居，耦俱无猜，贞也。","book":"《左传·僖公九年》"},"example":{"text":"荷兰专治市舶，不敛田赋，与流氏的～。","book":"清·魏源《圣武记》卷八"},"usage":"作谓语；用于处事"},{"id":37178,"word":"耦居无猜","pinyin":"ǒu jū wú cāi","abbr":"ojwc","explanation":"耦：通“偶”。住在一起，关系融洽，没有猜忌。","source":{"text":"得与云、山、书、史耦居无猜，不可谓非人生之幸。","book":"清·袁枚《小仓山房尺牍》"},"example":{"text":"于亲族朋友间，果能以诚相待与，～否？","book":"清·周安世《文昌帝君阴骘文广义节录》卷下"},"usage":"作谓语、定语；指关系融洽"},{"id":37179,"word":"耳不忍闻","pinyin":"ěr bù rěn wén","abbr":"ebrw","explanation":"不忍心听，形容情景十分凄惨。","source":{"text":"想其时，陈言为之祸，必有出于目不忍见，耳不忍闻者。","book":"清·叶燮《原诗·内篇》"},"example":{"text":"其启行也，数日前号泣震地，～。","book":"《中国的西北角·贺兰山的四边》"},"similar":["惨不忍闻"],"usage":"作宾语、定语；用于凄惨的场面"},{"id":37180,"word":"耳不旁听","pinyin":"ěr bù páng tīng","abbr":"ebpt","explanation":"两耳不往旁边听。形容神情十分专注的样子。","source":{"text":"因见他姐妹们说笑，便自己走到阶下竹前，挖心搜胆的耳不旁听，目不别视。","book":"清·曹雪芹《红楼梦》第四十八回"},"similar":["目不斜视"],"usage":"作谓语、定语、状语；指人专心"},{"id":37181,"word":"耳不离腮","pinyin":"ěr bù lí sāi","abbr":"ebls","explanation":"两种关系十分接近、亲密。","source":{"text":"别人说他俩是耳不离腮，影不离形，好的活像一个人。","book":"李文元《婚事》"},"similar":["亲密无间","唇齿相依"],"usage":"作宾语、定语；用于口语"},{"id":37182,"word":"耳习目染","pinyin":"ěr xí mù rǎn","abbr":"exmr","explanation":"染：沾染。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"老人自幼生长在北平，耳习目染的和旗籍人学了许多规矩礼路。","book":"老舍《四世同堂》"},"similar":["耳濡目染","耳濡目击","耳濡目及"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37183,"word":"耳后生风","pinyin":"ěr hòu shēng fēng","abbr":"ehsf","explanation":"像耳后刮风一样。形容激烈、迅速运动时耳后根产生的感觉。","source":{"text":"景宗谓所亲曰：‘我昔日在乡里，骑快马如龙，与年少辈数十骑，……觉耳后生风，鼻头出火，此乐使人忘死，不知老之将至。","book":"《梁书·曹景宗传》"},"similar":["耳后风生"],"usage":"作宾语、状语；指迅速运动时耳后根的感觉"},{"id":37184,"word":"耳后风生","pinyin":"ěr hòu fēng shēng","abbr":"ehfs","explanation":"形容驰驱迅速。","source":{"text":"觉耳后风生，鼻头出火，此乐使人忘死，不知老之将至。","book":"《梁书·曹景宗传》"},"similar":["耳后生风"],"usage":"作宾语、定语；用于形容速度快"},{"id":37185,"word":"耳听为虚，眼见为实","pinyin":"ěr tīng wéi xū，yǎn jiàn wéi shí","abbr":"etwxyjws","explanation":"听来的传闻是靠不住的，亲眼看到才算是真实的。","source":{"text":"夫耳闻之，不如目见之；目见之，不如足践之。","book":"汉·刘向《说苑·政理》"},"example":{"text":"她想：～，我何不自己走一趟，找到那王琦瑶，倘若真是这样，程先生也好死心了。","book":"王安忆《长恨歌》第一部四"}},{"id":37186,"word":"耳听八方","pinyin":"ěr tīng bā fāng","abbr":"etbf","explanation":"耳朵同时察听各方面来的声音。形容人很机警。","source":{"text":"为将之道：身临战场，务要眼观四处，耳听八方。","book":"明·许仲琳《封神演义》第53回"},"example":{"text":"要是没有一种眼观六路，～，到处显出精明强干的能力。","book":"老舍《赵子曰》第四"},"similar":["眼观六路"],"opposite":["不闻不问"],"usage":"作宾语、定语；形容人很机警"},{"id":37187,"word":"耳听心受","pinyin":"ěr tīng xīn shòu","abbr":"etxs","explanation":"用耳朵听，并记在心里。","example":{"text":"长辈们的谆谆教导，晚辈们当耳听心受。"},"usage":"作谓语、宾语；用于口语"},{"id":37188,"word":"耳听是虚，眼见为实","pinyin":"ěr tīng shì xū，yǎn jiàn wéi shí","abbr":"etsxyjws","explanation":"虚：虚假。听到的不足信，亲眼看到的才真实可靠。","source":{"text":"那时我还缺乏理解，但是也晓得大部分同志习惯于‘耳听是虚，眼见为实’，‘不怕不识货，就怕货比货’。","book":"《星火燎原·跨上新的高度》"},"similar":["耳听是虚，眼见是实"],"usage":"作宾语、定语；用于口语"},{"id":37189,"word":"耳听是虚，眼见是实","pinyin":"ěr tīng shì xū，yǎn jiàn shì shí","abbr":"etsxyjss","explanation":"虚：虚假。听到的不足信，亲眼看到的才真实可靠。","source":{"text":"有道是耳听是虚，眼见是实。千岁莫要屈赖好人。","book":"京剧《串龙珠》第十场"},"similar":["耳听是虚，眼见为实"],"usage":"作宾语、定语；用于口语"},{"id":37190,"word":"耳报神","pinyin":"ě bào shén","abbr":"ebs","explanation":"指暗中通风报信的人。","source":{"text":"这又是谁的耳报神这么快？","book":"清·曹雪芹《红楼梦》第71回"},"example":{"text":"遍地都是他的～，他岂有不知之理。","book":"清·文康《儿女英雄传》"},"usage":"作宾语、定语；用于口语"},{"id":37191,"word":"耳提面命","pinyin":"ěr tí miàn mìng","abbr":"etmm","explanation":"不仅是当面告诉他，而且是提着他的耳朵向他讲。形容长辈教导热心恳切。","source":{"text":"匪面命之，言提其耳。","book":"《诗经·大雅·抑》"},"example":{"text":"有一种文字，即有一种文字之法脉准绳，载之于书者，不异～。","book":"清·李渔《曲话·结构》"},"similar":["谆谆告诫","苦口婆心"],"opposite":["旁敲侧击"],"usage":"作谓语、定语、状语；用于长辈对晚辈"},{"id":37192,"word":"耳提面训","pinyin":"ěr tí miàn xùn","abbr":"etmx","explanation":"不仅是当面告诉他，而且是提着他的耳朵向他讲。形容长辈教导热心恳切。","source":{"text":"匪面命之，言提其耳。","book":"《诗经·大雅·抑》"}},{"id":37193,"word":"耳旁风","pinyin":"ěr páng fēng","abbr":"epf","explanation":"同“耳边风”。在耳边吹过的风。比喻听了不放在心上的话。","source":{"text":"比不得你，拿着我的话当耳旁风，夜里说了，早起就忘了。","book":"清·曹雪芹《红楼梦》第21回"},"example":{"text":"他总是把夫人的话当～。"},"similar":["耳边风"],"usage":"作宾语；比喻听到后不放在心上的话"},{"id":37194,"word":"耳染目濡","pinyin":"ěr rǎn mù rǔ","abbr":"ermr","explanation":"染：沾染；濡：沾湿。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"一来也是秉赋了浇漓的薄气，二来又离了忠厚的祖宗，耳染目濡，习就了那轻薄的态度。","book":"清·西周生《醒世姻缘传》第27回"},"similar":["耳濡目染","耳濡目击"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37195,"word":"耳根清净","pinyin":"ěr gēn qīng jìng","abbr":"egqj","explanation":"耳边无事噪聒。指无事打扰。","source":{"text":"何等耳根？谓四大种所造，耳识所依清静色。","book":"《集论》卷一"},"example":{"text":"张海棠也，自从嫁了员外，好～也呵。","book":"元·李行道《灰阑记》第一折"},"usage":"作宾语、补语；指不闻闲是闲非"},{"id":37196,"word":"耳满鼻满","pinyin":"ěr mǎn bí mǎn","abbr":"embm","explanation":"满耳朵满鼻子都是。形容听得烂熟。","source":{"text":"你在南京时，人说你周舍名字，说的我耳满鼻满的，则是不曾见你。","book":"元·关汉卿《救风尘》第三折"},"usage":"作谓语、状语；用于口语"},{"id":37197,"word":"耳濡目击","pinyin":"ěr rǔ mù jī","abbr":"ermj","explanation":"濡：沾湿。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"古者重世臣将家，盖其韬略技艺，耳濡目击，有不习而能者。","book":"明·李东阳《刘公神道碑铭》"},"similar":["耳濡目染","耳染目濡","耳习目染"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37198,"word":"耳濡目及","pinyin":"ěr rǔ mù jí","abbr":"ermj","explanation":"濡：沾湿。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"凡此诸条，耳濡目及，默化阴孚，匪言可悉。","book":"明·吴承恩《开府介川毛公德政颂》"},"similar":["耳濡目击","耳濡目染","耳习目染"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37199,"word":"耳濡目染","pinyin":"ěr rǔ mù rǎn","abbr":"ermr","explanation":"濡：沾湿；染：沾染。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"目濡耳染，不学以能。","book":"唐·韩愈《清河郡公房公墓碣铭》"},"example":{"text":"她完全没有读过书，但她单凭～，也认得一些字，而且能够暗诵得好些唐诗。","book":"郭沫若《少年时代·我的童年》"},"similar":["耳闻目睹","耳熟能详","潜移默化"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37200,"word":"耳热眼花","pinyin":"ěr rè yǎn huā","abbr":"eryh","explanation":"眼睛发花，耳朵发热。形容饮酒微有醉意，精神兴奋的感觉。","source":{"text":"耳热眼花之娱，千金万年之寿。","book":"南朝·梁·简文帝《筝赋》"},"similar":["眼花耳热"],"usage":"作谓语、状语；用于书面语"},{"id":37201,"word":"耳热眼跳","pinyin":"ěr rè yǎn tiào","abbr":"eryt","explanation":"耳根发热，眼皮跳动。迷信的人认为是不祥之兆。","source":{"text":"且不言八戒在此睡觉，却说长老在那林间，耳热眼跳，身心不安。","book":"明·吴承恩《西游记》第二十八回"},"example":{"text":"两个正饮间，秉中自觉～，心惊肉战，欠身求退。","book":"明·冯梦龙《警世通言》卷三十八"}},{"id":37202,"word":"耳熏目染","pinyin":"ěr xūn mù rǎn","abbr":"exmr","explanation":"指见闻熏染多了就能不自觉受影响。","source":{"text":"她在此终日～，不学自会三分。"},"example":{"text":"她在此终日～，不学自会三分"},"similar":["耳濡目染","潜移默化"],"usage":"作谓语、定语；指潜移默化"},{"id":37203,"word":"耳熟能详","pinyin":"ěr shú néng xiáng","abbr":"esnx","explanation":"指听得多了，能够说得很清楚、很详细。","source":{"text":"吾耳熟焉，故能详也。","book":"宋·欧阳修《泷冈阡表》"},"example":{"text":"《死去了的阿Q时代》是大家～的作品。","book":"柯灵《向拓荒者致敬》"},"similar":["耳闻则诵","熟能生巧"],"opposite":["浅尝辄止","寡闻少见"],"usage":"作谓语、定语；指听得多了"},{"id":37204,"word":"耳目一新","pinyin":"ěr mù yī xīn","abbr":"emyx","explanation":"耳目：指见闻。听到的、看到的跟以前完全不同，使人感到新鲜。","source":{"text":"关塞之气色，龙潭之景象，香山之泉石，石楼之风月，与往来者耳目一时而新。","book":"唐·白居易《修香山寺记》"},"example":{"text":"如今一上船，便觉得另是一番风味，～。","book":"清·文康《儿女英雄传》第二十二回"},"similar":["焕然一新"],"opposite":["依然如故"],"usage":"作宾语、定语；指感到新鲜"},{"id":37205,"word":"耳目之欲","pinyin":"ěr mù zhī yù","abbr":"emzy","explanation":"欲：欲望。满足声色享乐的欲望。","source":{"text":"务快耳目之欲，以苟容为度。","book":"汉·东方朔《非有先生论》"},"usage":"作宾语；用于书面语"},{"id":37206,"word":"耳目众多","pinyin":"ěr mù zhòng duō","abbr":"emzd","explanation":"耳目：指为别人打探消息的人。周围注意的人很多。也指为刺探情报的人很多。","source":{"text":"只是目下耳目众多，恐有泄漏，实属不便。","book":"清·石昆玉《三侠五义》第十六回"},"example":{"text":"谭相公要回去，须从我后门出去。街上～，怕人看透行藏，便有谣言风波。","book":"清·李绿园《歧路灯》第五十二回"},"usage":"作谓语；指为刺探情报的人很多"},{"id":37207,"word":"耳目喉舌","pinyin":"ěr mù hóu shé","abbr":"emhs","explanation":"喉舌：泛指说话的器官，比喻代言人。起到耳目喉舌的作用。比喻作为搜集、了解情况和宣传方针政策的工具。","source":{"text":"报纸是党的耳目喉舌，是党联系广大人民群众的纽带。","book":"田流《我上的第一堂党的新闻课》"},"example":{"text":"《人民日报》起到党的～的作用。"},"usage":"作宾语、定语；多用于比喻句"},{"id":37208,"word":"耳目导心","pinyin":"ěr mù dǎo xīn","abbr":"emdx","explanation":"耳目：视听。耳目的熏染，可以启发人心的善恶。","source":{"text":"君子以心导耳目，立义以为勇，小人以耳目导心，不逊以为勇。","book":"《孔子家语·好生》"}},{"id":37209,"word":"耳目心腹","pinyin":"ěr mù xīn fù","abbr":"emxf","explanation":"耳目：指侦探消息的人。指辅佐帝王的重臣。比喻得力助手与亲信。","source":{"text":"如善其便捷，任以耳目心腹，未有不倒持干戈，授人以柄者。","book":"清·纪昀《阅微草堂笔记·如是我闻》"},"similar":["耳目股肱","股肱腹心","股肱心腹"],"usage":"作宾语、定语；指助手与亲信"},{"id":37210,"word":"耳目昭彰","pinyin":"ěr mù zhāo zhāng","abbr":"emzz","explanation":"昭彰：十分明显，人所共见。众人已听到和看到，十分明显。形容被众人了解得清清楚楚，无法藏匿。","source":{"text":"却说刑部审问过，见耳目昭彰，料难隐瞒，十分为过学士不安，只得会同礼臣复奏一本。","book":"清·名教中人《好逑传》第十七回"},"example":{"text":"现在是～，你不必掩饰了。"},"usage":"作宾语；指清清楚楚，无法藏匿"},{"id":37211,"word":"耳目股肱","pinyin":"ěr mù gǔ gōng","abbr":"emgg","explanation":"股：大腿；肱：手臂从肘到腕的部分。起到耳朵、眼睛、手臂的作用。比喻辅佐帝王的重臣。也比喻十分亲近且办事得力的人。","source":{"text":"然耳目股肱，寄于卿辈……事有不安，可极言勿隐。","book":"唐·吴兢《贞观政要·政体》"},"example":{"text":"你就是我的～。"},"similar":["股肱耳目","得力干将"],"usage":"作宾语、定语；指助手与亲信"},{"id":37212,"word":"耳目闭塞","pinyin":"ěr mù bì sāi","abbr":"embs","explanation":"比喻少见寡闻，对于世事情况了解甚少。","example":{"text":"住在边远地区的居民～，文化落后，当地的经济、文化建设刻不容缓。"}},{"id":37213,"word":"耳目非是","pinyin":"ěr mù fēi shì","abbr":"emfs","explanation":"指声色不同于平常。","source":{"text":"嘉见耳目非是，即趋出。","book":"《汉书·南粤王传》"}},{"id":37214,"word":"耳红面赤","pinyin":"ěr hóng miàn chì","abbr":"ehmc","explanation":"耳朵和面部都红了。形容过于用力、情绪激动或羞愧时的脸色。","source":{"text":"忽见禁子走来，轻轻的向倪完耳边说了几句。倪完吃了一惊，不觉耳红面赤。","book":"清·钱彩《说岳全传》第61回"},"example":{"text":"他急得～，无话可说。"},"similar":["面红耳赤"],"opposite":["镇定自若"],"usage":"作宾语、状语；用于人的情绪"},{"id":37215,"word":"耳聋眼瞎","pinyin":"ěr lóng yǎn xiā","abbr":"elyx","explanation":"指因突然遭到强烈刺激而耳朵变聋，眼睛变瞎。","source":{"text":"那个昏大官人就像耳聋眼瞎的一般。","book":"清·西周生《醒世姻缘传》第六回"},"example":{"text":"清·韩邦庆《海上花列传》第29回：“这赵朴斋母亲洪氏，年仅五十，～，柔懦无能。”"},"similar":["耳聋眼黑"],"usage":"作谓语、定语、状语；用于人受刺激时"},{"id":37216,"word":"耳聋眼花","pinyin":"ěr lóng yǎn huā","abbr":"elyh","explanation":"年老体衰者听力和视力都不好。也形容人对事物的知觉极为迟钝。","source":{"text":"晁夫人又不头疼脑热，又不耳聋眼花。","book":"清·西周生《醒世姻缘传》第九十回"},"similar":["耳聋眼瞎"],"opposite":["耳聪目明"],"usage":"作谓语、定语；多用于老年人"},{"id":37217,"word":"耳聋眼黑","pinyin":"ěr lóng yǎn hēi","abbr":"elyh","explanation":"人糊涂，昏聩。","source":{"text":"那个昏大官人就象耳聋眼瞎的一般。","book":"清·西周生《醒世姻缘传》第六回"},"example":{"text":"《传灯录》，百丈被马祖一喝，直得三日～。","book":"清·翟灏《通俗编·身体·耳聋眼黑》"},"similar":["耳聋眼瞎"],"usage":"作谓语、定语、状语；用于人受刺激时"},{"id":37218,"word":"耳聪目明","pinyin":"ěr cōng mù míng","abbr":"ecmm","explanation":"聪：听觉灵敏；明：眼力敏锐。听得清楚，看得明白。形容头脑清楚，眼光敏锐。","source":{"text":"巽而，耳目聪明，柔进而上行。","book":"《周易·鼎》"},"example":{"text":"此时服了朱草，只觉～，谁知回想幼年所读经书，不但丝毫不忘，就是平时所作诗文，也都如在目前。","book":"清·李汝珍《镜花缘》第九回"},"similar":["心明眼亮"],"opposite":["昏聩胡涂"],"usage":"作谓语、定语、宾语；形容头脑清楚"},{"id":37219,"word":"耳视目听","pinyin":"ěr shì mù tīng","abbr":"esmt","explanation":"用耳朵看，用眼睛听。三代道家荒唐地认为视听由精神主宰，可以不受器官限制。","source":{"text":"老聃之弟子有亢仓子者，得聃之道，能以耳视而目听。","book":"战国·郑·列御寇《列子·仲尼》"},"example":{"text":"～的人是难以置信的。"},"opposite":["各尽其责"],"usage":"作谓语、定语；指精神主宰可以不受器官限制","story":["春秋时期，亢仓子拜道家祖师老子为师，修行得道，视听可以由精神主宰，不受感官限制。人们传说他能耳视目听。鲁国国君请他到宫廷表演耳视目听，亢仓子回答他不能耳视目听，谁也不能调换耳朵和眼睛的功能"]},{"id":37220,"word":"耳视目食","pinyin":"ěr shì mù shí","abbr":"esms","explanation":"用耳朵看，用眼睛吃。比喻颠倒错乱。","source":{"text":"世之人不以耳视而目食者，鲜矣。","book":"宋·司马光《迂书·官失》"},"similar":["目食耳视"],"usage":"作宾语、定语；用于书面语"},{"id":37221,"word":"耳软心活","pinyin":"ěr ruǎn xīn huó","abbr":"erxh","explanation":"比喻自己没有一点主见，就是相信别人的话。","source":{"text":"那司棋也曾求了迎春，实指望能救，只是迎春语言迟慢，耳软心活，是不能做主的。","book":"清·曹雪芹《红楼梦》第77回"},"example":{"text":"他是一个～的人。"},"similar":["人云亦云","随波逐流"],"opposite":["立场坚定"],"usage":"作谓语、定语；指没主见","story":["大观园内发现有男女性爱的图腾手袋，王夫人派王熙凤及管家周瑞的妻子等率团搜查，结果在迎春的丫鬟司棋房内发现大量男性用品。王熙凤盛怒要赶司棋出园子，迎春是个耳软心活的人，司棋也是白求了她，结果还是被清除出门"]},{"id":37222,"word":"耳边之风","pinyin":"ěr biān zhī fēng","abbr":"ebzf","explanation":"耳旁之风，一吹而过。比喻不重视，听了不放在心上的话。","source":{"text":"玉姐听说，只当耳边之风。","book":"明·冯梦龙《警世通言》第24卷"},"example":{"text":"谁知相主事拿定主意，只是不理，凭他撒骚放屁，只当～。","book":"清·西周生《醒世姻缘传》第77回"},"similar":["耳边风"],"usage":"作宾语；比喻听到后不放在心上的话"},{"id":37223,"word":"耳边风","pinyin":"ěr biān fēng","abbr":"ebf","explanation":"在耳边吹过的风。比喻听了不放在心上的话。","source":{"text":"百岁有涯头上雪，万般无染耳边风。","book":"唐·杜荀鹤《赠题兜率寺闲上人院》诗"},"example":{"text":"我平日和你说的，全当～，怎么他说了你就依，比圣旨还快呢？","book":"清·曹雪芹《红楼梦》第八回"},"similar":["耳旁风","置之脑后","充耳不闻"],"opposite":["郑重其事"],"usage":"作宾语；比喻听到后不放在心上的话"},{"id":37224,"word":"耳闻不如目见","pinyin":"ěr wén bù rú mù jiàn","abbr":"ewbrmj","explanation":"听到的不如看到的真实可靠。比喻实际经验的重要。","source":{"text":"汉·刘向《说苑·政理》"},"example":{"text":"就行也不是话，再住也不是话，口说无凭，～，我背了马，且请师父亲去看看。","book":"明·吴承恩《西游记》第四十八回"},"similar":["眼见为实","耳听为虚"],"opposite":["道听途说"],"usage":"作宾语、定语、分句；比喻实际经验的重要"},{"id":37225,"word":"耳闻不如眼见","pinyin":"ěr wén bù rú yǎn jiàn","abbr":"ewbryj","explanation":"听到的不如看到的真实可靠。比喻亲身感受比传闻可靠。","source":{"text":"臣尝以为古之用度不时，爵赏不当，破家亡国者，口说不如身逢，耳闻不如眼见。","book":"《旧唐书·辛替否传》"},"example":{"text":"口说无凭，～。我背了马，且请师父亲去看看。","book":"明·吴承恩《西游记》第48回"},"similar":["耳闻不如目见"],"usage":"作宾语、定语、分句；比喻实际经验的重要"},{"id":37226,"word":"耳闻不如面见","pinyin":"ěr wén bù rú miàn jiàn","abbr":"ewbrmj","explanation":"听到的不如看到的真实可靠。比喻实际经验的重要。","source":{"text":"夫耳闻之，不如目见之；目见之，不如足践之。","book":"汉·刘向《说苑·政理》"}},{"id":37227,"word":"耳闻则诵","pinyin":"ěr wén zé sòng","abbr":"ewzs","explanation":"听过就能背出来。形容记忆力强。","source":{"text":"融聪辩明慧，下笔成章，至于谈玄论道，虽道安无以出之。耳闻则诵，过目不忘，时人拟之王粲。","book":"《晋书·苻融载记》"},"example":{"text":"我希望有～的本事。"},"similar":["过目成诵"],"usage":"作谓语、定语；指记忆力好"},{"id":37228,"word":"耳闻是虚，眼观为实","pinyin":"ěr wén shì xū，yǎn guān wéi shí","abbr":"ewsxygws","explanation":"亲自听到的还不足为信，只有亲眼看到的才是真实可靠的。","source":{"text":"‘耳闻是虚，眼观为实’，叔叔此时，且不要过于取笑侄女，请再去一访，……那时再来取笑侄女，却也未迟。","book":"清·名教中人《好逑传》第九回"},"example":{"text":"“～”在现代社会里也不十分准确。"},"similar":["耳听是虚，眼见为实"],"usage":"作宾语、定语、分句；指要亲眼所见"},{"id":37229,"word":"耳闻目击","pinyin":"ěr wén mù jī","abbr":"ewmj","explanation":"击：接触。亲自听说，亲眼看见。","source":{"text":"耳闻目击，不忍民之失所也，故随其所遇，尽力而为之。","book":"明·王廷相《慎言·作圣》"},"example":{"text":"这类素材，显然和他在狱中～的事情有密切的关联。","book":"秦牧《花蜜与蜂刺》"},"similar":["耳闻目见","耳闻目睹"],"opposite":["道听途说"],"usage":"作宾语、定语；指所见所闻"},{"id":37230,"word":"耳闻目染","pinyin":"ěr wén mù rǎn","abbr":"ewmr","explanation":"染：沾染。耳朵经常听到，眼睛经常看到，不知不觉地受到影响。","source":{"text":"由于他小时候在巴黎耳闻目染的结果，爱情比同龄的年轻人要早醒得多。","book":"丛维熙《北国草》第一章"},"example":{"text":"她的改变是因为和我朝夕相处、～的结果。"},"similar":["耳濡目染"],"usage":"作谓语、定语、分句；指不知不觉地改变"},{"id":37231,"word":"耳闻目睹","pinyin":"ěr wén mù dǔ","abbr":"ewmd","explanation":"闻：听见；睹：看见。亲耳听到，亲眼看见。","source":{"text":"口说不如身逢，耳闻不如目睹。","book":"《资治通鉴·唐纪睿宗景云二年》"},"example":{"text":"我从乡下跑京城里，一转眼已经六年了，其间～的所谓国家大事，算起来也很不少。","book":"鲁迅《呐喊·一件小事》"},"similar":["耳濡目染"],"opposite":["闭目塞听"],"usage":"作谓语、定语、宾语；用于亲眼所见"},{"id":37232,"word":"耳闻目见","pinyin":"ěr wén mù jiàn","abbr":"ewmj","explanation":"亲自听见和亲眼看见的。","source":{"text":"夫信谤之徵，有如影响；耳闻目见，其事已多，或乃精诚不深，业缘未感，时傥差阑，终当或报耳。","book":"北齐·颜之推《颜氏家训·归心》"},"example":{"text":"或游于京，或任于朝，凡高，在庙谋疆事，一一皆～。","book":"清·赵翼《廿二史札记·金史》"},"similar":["耳闻目击","耳闻目睹","耳闻目览"],"opposite":["道听途说"],"usage":"作宾语、定语；指所见所闻"},{"id":37233,"word":"耳闻目览","pinyin":"ěr wén mù lǎn","abbr":"ewml","explanation":"亲自听见和亲眼看见的。","source":{"text":"宝及晡方寤，耳闻目览，恍然如在。","book":"唐·孙揆《灵应传》"},"similar":["耳闻目见","耳闻目击","耳闻目睹"],"usage":"作宾语、定语；指所见所闻"},{"id":37234,"word":"耳闻眼睹","pinyin":"ěr wén yǎn dǔ","abbr":"ewyd","explanation":"闻：听见；睹：看见。亲耳听到，亲眼看见。","source":{"text":"老夫耳闻眼睹，非止一端，因而忧闷成疾。","book":"元·秦简夫《东堂老》楔子"},"similar":["耳闻目睹"],"usage":"作谓语、定语；用于亲眼所见"},{"id":37235,"word":"耳闻眼见","pinyin":"ěr wén yǎn jiàn","abbr":"ewyj","explanation":"亲自听见和亲眼看见的。","source":{"text":"翁言野父何分别，耳闻眼见为君说。","book":"唐·元稹《连昌宫词》"},"similar":["耳闻目见","耳闻眼睹","耳闻目击"],"usage":"作谓语、定语；用于亲眼所见"},{"id":37236,"word":"耳顺之年","pinyin":"ér shùn zhī nián","abbr":"eszn","explanation":"六十岁时听别人言语便可判断是非真假。指60岁的代称。","source":{"text":"吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲。","book":"先秦·孔子《论语·为政》"},"example":{"text":"至乎～，履折冲之位，号至将军。","book":"东汉·班固《汉书·萧望之传》"},"similar":["花甲之年"],"usage":"作宾语；指60岁"},{"id":37237,"word":"耳食不化","pinyin":"ěr shí bù huà","abbr":"esbh","explanation":"指没有经过思考，轻信听来的话。","source":{"text":"学者牵于所闻，见秦在帝位日浅，不察其始终，因举而笑之，不敢道，此与以耳食无异。","book":"《史记·六国年表序》"}},{"id":37238,"word":"耳食之徒","pinyin":"ěr shí zhī tú","abbr":"eszt","explanation":"指全凭道听途说，人云亦云的人。","source":{"text":"学者牵于所闻，见秦在帝位日浅，不察其始终，因举而笑之，不敢道，此与以耳食无异。","book":"《史记·六国年表序》"},"example":{"text":"但此后示黠者，伪作半印，以欺～，皆出苏人与徽人伎俩。","book":"明·沈德符《万历野获编·籍没古玩》"}},{"id":37239,"word":"耳食之言","pinyin":"ěr shí zhī yán","abbr":"eszy","explanation":"耳食：耳朵吃饭。指没有确凿的根据，未经思考分析的传闻。","source":{"text":"不察其始终因举而笑之，不敢道，此与以耳食无异。","book":"西汉·司马迁《史记·六国年表序》"},"example":{"text":"虽然偶有些‘～’，又大抵是无关大体的事。","book":"鲁迅《不是信》"},"similar":["流言蜚语","耳食之谈","耳食之论"],"usage":"作宾语；指流言"},{"id":37240,"word":"耳食之论","pinyin":"ěr shí zhī lùn","abbr":"eszl","explanation":"耳食：以耳吃食，指不加审察，轻信传闻。指听来的没有根据的话。","source":{"text":"学者牵于所闻，见秦在帝位日浅，不察其始终，因举而笑之，不敢道，此与以耳食无异。","book":"《史记·六国年表序》"},"example":{"text":"今人动谓新书过旧书远甚，此～也。","book":"清·赵翼《廿二史札记·旧唐书前半全用实录国史旧本》"},"similar":["耳食之谈","无稽之谈"],"usage":"作主语、宾语；指无稽之谈"},{"id":37241,"word":"耳食之谈","pinyin":"ěr shí zhī tán","abbr":"eszt","explanation":"耳食：以耳吃食，指不加审察，轻信传闻。指听来的没有根据的话。","source":{"text":"学者牵于所闻，见秦在帝位日浅，不察其始终，因举而笑之，不敢道，此与以耳食无异。","book":"《史记·六国年表序》"},"example":{"text":"此～，引经断狱，当不如是。","book":"清·阮葵生《茶余客话》卷六"},"similar":["无稽之谈","耳食之论","耳食之言"],"usage":"作宾语；指没有根据的话"},{"id":37242,"word":"耳食目论","pinyin":"ěr shí mù lùn","abbr":"esml","explanation":"耳食：轻信听来的话。像用耳朵吃饭而不知食物味道，像眼睛能看见细毛而不见睫毛。比喻轻信他人的话，缺乏确凿根据。","source":{"text":"吾不贵其用智之如目，见豪毛而不见其睫也。今王知晋之失计，而不自知越之过，是目论也。","book":"《史记·越王勾践世家》"},"example":{"text":"此真～之士也，虽多，奚足贵哉。","book":"清·王韬《淞隐漫录·药娘》"}},{"id":37243,"word":"耳鬓厮磨","pinyin":"ěr bìn sī mó","abbr":"ebsm","explanation":"鬓：鬓发；厮：互相；磨：擦。耳与鬓发互相摩擦。形容相处亲密。","source":{"text":"咱们从小耳鬓厮磨，你不曾拿我当外人待，我也不敢怠慢了你。","book":"清·曹雪芹《红楼梦》第72回"},"example":{"text":"自此～，亲同形影。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["青梅竹马"],"opposite":["天各一方"],"usage":"作谓语、定语、状语；形容男女相恋"},{"id":37244,"word":"耳鬓撕磨","pinyin":"ěr bìn sī mó","abbr":"ebsm","explanation":"鬓：面颊两旁近耳的头发；撕：同“厮”，互相。形容亲密相处。","source":{"text":"顺手拉了彩云的手，耳鬓撕磨的端相的不了，不知不觉两股热泪，从眼眶中直滚下来。","book":"清·曾朴《孽海花》第八回"},"example":{"text":"我回想起我们～的日子，心中泛起幸福的暖流。"},"similar":["耳鬓厮磨"],"usage":"作谓语、定语、状语；形容男女相恋"},{"id":37245,"word":"耳鬓斯磨","pinyin":"ěr bìn sī mó","abbr":"ebsm","explanation":"鬓：面颊两旁近耳的头发；厮：互相。形容亲密相处的情景（多指小儿女）。","source":{"text":"宝玉思及当时姊妹耳鬓斯磨，从今一别，纵得相逢，比不得似先前这等亲热了。","book":"清·曹雪芹《红楼梦》第七十九回"},"example":{"text":"你们老弟兄们，～的在一块。这一散，也怪觉得没趣的。","book":"清·文康《儿女英雄传》第二十一回"},"similar":["耳鬓厮磨"],"usage":"作谓语、定语、状语；多指小儿女"},{"id":37246,"word":"耳鬓相磨","pinyin":"ěr bìn xiāng mó","abbr":"ebxm","explanation":"鬓：鬓发；相：互相；磨：擦。耳与鬓发互相摩擦。形容相处亲密。","source":{"text":"自此耳鬓相磨，亲同形影。","book":"清·沈复《浮生六记·闺房记乐》"},"similar":["耳鬓厮磨"],"usage":"作谓语、定语、状语；形容男女相恋"},{"id":37247,"word":"耳鸣目眩","pinyin":"ěr míng mù xuàn","abbr":"emmx","explanation":"眩：眩晕。双耳作响，两眼眩晕。","source":{"text":"忽觉耳鸣目眩，支持不住。","book":"蔡东藩《民国通俗演义》第78回"},"example":{"text":"这儿的声音太嘈杂，让我～。"},"similar":["头晕目眩"],"usage":"作谓语、宾语、定语；用于人"},{"id":37248,"word":"耸人听闻","pinyin":"sǒng rén tīng wén","abbr":"srtw","explanation":"耸：惊动。夸大或捏造事实，使人听了感到惊异或震动。","source":{"text":"比较那史册上的朱云请剑，李膺破柱，更足耸人听闻。","book":"清·夏敬渠《野叟曝言》第三十五回"},"example":{"text":"闲官之挫折，无足轻重，不足～。（清·汪师韩《诗学纂闻·刘随州别严士元诗》）"},"similar":["骇人听闻","危言耸听"],"opposite":["本来面目","不偏不倚"],"usage":"作谓语、定语；指夸大或捏造事实"},{"id":37249,"word":"耸入云霄","pinyin":"sǒng rù yún xiāo","abbr":"sryx","explanation":"形容山或建筑物很高，都进了云端。","example":{"text":"尖峰岭～，十分壮观。"},"similar":["高耸入云"],"usage":"作谓语、定语；形容十分高大"},{"id":37250,"word":"耸动听闻","pinyin":"sǒng dòng tīng wén","abbr":"sdtw","explanation":"耸：通“悚”，惊动。夸大或捏造事实，使人听了感到惊异或震动。","source":{"text":"‘职臣在宪府，不惟不能奉承大臣风旨，亦不敢奉承陛下风旨。’固已耸动听闻矣。","book":"宋·周密《齐东野语·洪君畴》"},"similar":["耸人听闻"],"usage":"作谓语、定语；指夸大或捏造事实"},{"id":37251,"word":"耸壑凌霄","pinyin":"sǒng hè líng xiāo","abbr":"shlx","explanation":"出于幽谷，高入云霄。比喻成就比别人高。","source":{"text":"仆阅人多矣，未见如此郎者。必成伟器，但恨不睹其耸壑凌霄耳。","book":"《旧唐书·房玄龄传》"},"similar":["耸壑昂霄"],"usage":"作谓语、定语；比喻成就比别人高"},{"id":37252,"word":"耸壑昂霄","pinyin":"sǒng hè áng xiāo","abbr":"shax","explanation":"跳越溪谷，直入云霄。比喻出人头地。","source":{"text":"及吾未老，当见汝耸壑昂霄时耳。","book":"金·元好问《刘景玄墓铭》"},"example":{"text":"当为国器，但恨不见其～。","book":"《新唐书·房玄龄传》"},"similar":["耸壑昂霄","出人头地"],"usage":"作谓语、定语；比喻成就比别人高"},{"id":37253,"word":"耸肩曲背","pinyin":"sǒng jiān qū bèi","abbr":"sjqb","explanation":"耸起两肩，弯曲背脊。形容衰老或寒酸貌。","source":{"text":"那些请来帮阅卷的，又都是些耸肩曲背的，酸的怕人。","book":"清·吴趼人《二十年目睹之怪现状》第43回"},"example":{"text":"只见四铭就在她面前～的狠命掏着布马褂底下的袍子的大襟后面的口袋。","book":"鲁迅《彷徨·肥皂》"},"similar":["耸肩缩背"],"usage":"作谓语、定语；指衰老或寒酸貌"},{"id":37254,"word":"耸肩缩背","pinyin":"sǒng jiān suō bèi","abbr":"sjsb","explanation":"两肩耸起，背脊弯曲。形容衰老的状态。也形容因怕冷而缩做一团的样子。","source":{"text":"又是风雪，地下踏着寒冰，冻得耸肩缩背，战战兢兢。","book":"明·兰陵笑笑生《金瓶梅词话》第93回"},"similar":["耸肩曲背"],"usage":"作谓语、定语；指衰老"},{"id":37255,"word":"耸肩缩颈","pinyin":"sǒng jiān suō jǐng","abbr":"sjsj","explanation":"形容因恐惧或寒冷而耸着肩膀缩着脖子。","source":{"text":"毛发尽竖，竦肩缩颈。","book":"唐·韩愈《送穷文》"},"example":{"text":"～仍呵手，无策能温两脚顽。","book":"宋·杨万里《过胡骆坑》"}},{"id":37256,"word":"耸膊成山","pinyin":"sǒng bó chéng shān","abbr":"sbcs","explanation":"肩膀耸起成了一个“山”字。形容人耸肩缩颈的相貌。也形容人体瘦削的样子。","source":{"text":"耸膊成山字，埋肩不出头。论证家麟角上，画此一狝猴。","book":"唐·长孙无忌《嘲欧阳洵》诗"},"example":{"text":"捉襟见肘贫无敌，～瘦可知。","book":"宋·陆游《衰疾》诗"},"usage":"作定语；用于比喻句","story":["唐朝时期，唐太宗设宴招待身边的大臣，君臣玩得尽欢，互相戏谑与嘲笑。欧阳率更因为长得很瘦削，被赵公无忌作诗讥笑为：“耸髆成山字，埋肩不出头。谁家麟阁上，画此一猕猴。”"]},{"id":37257,"word":"耻与为伍","pinyin":"chǐ yǔ wéi wǔ","abbr":"cyww","explanation":"耻：感到羞耻；与：跟；为伍：作伙伴。比喻把跟某人在一起认为是可耻的事。","source":{"text":"士信耻与为伍，率所部千余人奔于谷州。","book":"《后汉书·党锢传》：“逮桓灵之间，主政荒谬，国命委于阉寺，士子羞与为伍。”《旧唐书·罗士信传》"},"example":{"text":"重胤出于列校，以承璀一牒代之，窃恐河南、北诸侯闻之，无不愤怒，～。","book":"《资治通鉴·唐纪·宪宗元和五年》"}},{"id":37258,"word":"耻与哙伍","pinyin":"chǐ yú kuài wǔ","abbr":"cykw","explanation":"指不愿与粗鄙庸碌之人为伍。","source":{"text":"汉初，韩信由楚王降封为淮阴侯，日夜怨望。有一次，他顺便去看望樊哙，樊哙跪拜送迎。出来后，韩信笑着说：‘生乃与哙等为伍。’","book":"《史记淮阴侯列传》"},"example":{"text":"生平～行，杜门养拙安天常。","book":"元耶律楚材《用前韵感事》之一"},"similar":["耻与为伍","羞与哙伍"],"usage":"作谓语；用于为人","story":["刘邦建立西汉后，封曾经在鸿门宴上立功的樊哙为“舞阳侯”，担心大将军韩信握兵自重，削其兵权改为楚王，后降为淮阴侯。一次韩信从樊哙门前走过，出身于杀狗之家的樊哙跪迎韩信。事后韩信后悔自己竟与樊哙这样的人为伍而感到羞愧"]},{"id":37259,"word":"耻居人下","pinyin":"chǐ jū rén xià","abbr":"cjrx","explanation":"以地位在人之下为耻。","source":{"text":"伏念某本无他长，耻居人下。常想英豪之行事，堕乃尘凡；颇知圣贤之用心，杂之泥滓。","book":"宋陈亮《谢曾察院启》"},"example":{"text":"围乃共王之庶子，年齿最长，桀骜不恭，～，恃其才器，阴畜不臣之志。","book":"《东周列国志》第六七回"},"similar":["不甘人后"],"opposite":["自甘堕落"],"usage":"作谓语、定语；指人有志"},{"id":37260,"word":"耻居王后","pinyin":"chǐ jū wáng hòu","abbr":"cjwh","explanation":"指在文名上耻于处在不及己者之后。","source":{"text":"《新唐书·文艺传上·王勃》：“勃与杨炯、卢照邻、骆宾王皆以文章齐名，天下称‘王、杨、卢、骆’，号‘四杰’。炯尝曰：‘吾愧在卢前，耻居王后。’"},"example":{"text":"河岳精灵绝代夸，～论诗家。","book":"清金农《游午亭山邨陈文贞公居里》诗"},"usage":"作谓语、定语；用于人的志向等","story":["唐朝时期，文学作品多以诗歌为主，当时文坛上有王勃、杨炯、卢照邻、骆宾王四人最为出名，被人誉为“初唐四杰”，他们都是以诗词著称，人们按“王、杨、卢、骆”的次序排列，杨炯知道后感慨地说：“吾愧在卢前，耻居王后。”"]},{"id":37261,"word":"耻言人过","pinyin":"chǐ yán rén guò","abbr":"cyrg","explanation":"以议论别人的过错为可耻。以议论别人的过错为可耻。","source":{"text":"汉文好黄老，而公卿耻言人过。举盛德则仪形著矣，焉用察察缺缺以恟生人哉！","book":"唐李华《御史中丞壁记》"},"example":{"text":"薄夫鄙人皆洗心易虑，务为忠厚，人人自重，～。","book":"宋苏轼《司马温公神道碑》"},"usage":"作谓语；用于为人"},{"id":37262,"word":"耽惊受怕","pinyin":"dān jīng shòu pà","abbr":"djsp","explanation":"担受惊吓。","source":{"text":"受官差在旅途，耽惊受怕过朝暮，受了五十四站风波苦。","book":"元·刘致《端正好·上高监司》"},"example":{"text":"休听那算命的胡说，撇了海阔一个家业，～，去虎穴龙潭里做买卖！","book":"明·施耐庵《水浒传》第61回"},"similar":["担惊受怕"],"usage":"作谓语、宾语、定语；指担受惊吓"},{"id":37263,"word":"耽耽虎视","pinyin":"dān dān hǔ shì","abbr":"ddhs","explanation":"眈眈：注视的样子。象老虎那样凶狠地盯着。形容心怀不善，伺机攫取。","source":{"text":"虎视耽耽，其欲逐逐。","book":"《周易·颐》"}},{"id":37264,"word":"耽耽逐逐","pinyin":"dān dān zhú zhú","abbr":"ddzz","explanation":"眈眈：注视的样子，也形容贪婪地注视。瞪着眼睛逼视而急欲掠取。形容贪婪追逐的样子。","source":{"text":"虎视耽耽，其欲逐逐。","book":"《周易·颐》"},"example":{"text":"哭哭啼啼，假慈悲善瞒老鼠；～，借声势巧胜妖狐。","book":"明·陈汝元《金莲记·构衅》"}},{"id":37265,"word":"耾耾雷声，回穴错迕","pinyin":"hóng hóng léi shēng，huí xué cuò wǔ","abbr":"hhlshxcw","explanation":"耾耾：隆隆的雷鸣声；错迕：倒转。本用以形容风声很大，如同隆隆作响的雷声。现用来形容前进的力量如滚滚洪流，不可阻挡。","source":{"text":"耾雷雷声，回穴错迕，蹶石伐木，梢杀林莽。","book":"战国·楚·宋玉《风赋》"}},{"id":37266,"word":"耿介之士","pinyin":"gěng jiè zhī shì","abbr":"gjzs","explanation":"耿介：正直、不同于流俗。指正直的人。","source":{"text":"人主不除此五蠹之民，不养耿介之士，则海内虽有破亡之国，削灭之朝，亦勿怪矣。","book":"战国·韩·韩非《韩非子·五蠹》"},"usage":"作主语、宾语；指正直的人"},{"id":37267,"word":"耿耿于心","pinyin":"gěng gěng yú xīn","abbr":"ggyx","explanation":"耿耿：有所悬念而不能忘怀。不能忘怀，牵萦于心。","source":{"text":"耿耿不寐，如有隐忧。","book":"《诗经·邶风·柏舟》"},"example":{"text":"所惜者，幼为奴隶学问所误，于国民责任，未有分毫之尽，以是～，不能自解。","book":"清·陈天华《狮子吼》第五回"},"similar":["耿耿于怀","耿耿在心","耿耿在怀"],"usage":"作谓语、定语；指不能忘怀的事"},{"id":37268,"word":"耿耿于怀","pinyin":"gěng gěng yú huái","abbr":"ggyh","explanation":"耿耿：有心事的样子。不能忘怀，牵萦于心。","source":{"text":"耿耿不寐，如有隐忧。","book":"《诗经·邶风·柏舟》"},"example":{"text":"同学之间应团结互助，绝不能因一点小事就～。"},"similar":["牵肠挂肚","念念不忘","铭心镂骨"],"opposite":["无介于怀","若无其事"],"usage":"作谓语、定语；指不能忘怀的事"},{"id":37269,"word":"耿耿在心","pinyin":"gěng gěng zài xīn","abbr":"ggzx","explanation":"耿耿：有所悬念而不能忘怀。不能忘怀，牵萦于心。","source":{"text":"耿耿不寐，如有隐忧。","book":"《诗经·邶风·柏舟》"},"example":{"text":"孤常念孔子称文王之德，此言～。","book":"明·罗贯中《三国演义》第五十六回"},"similar":["耿耿于心","耿耿在怀","耿耿于怀"],"usage":"作谓语、定语；指不能忘怀的事"},{"id":37270,"word":"耿耿在怀","pinyin":"gěng gěng zài huái","abbr":"ggzh","explanation":"耿耿：形容有心事；怀：心怀。老放在心里，不能忘怀，牵萦回绕。","source":{"text":"在日本时我也曾替他题过画，当时是更加没有把握，记得有一张《瞿塘图》，我题的特别拙劣，至今犹耿耿在怀。","book":"郭沫若《题画记》"},"similar":["耿耿于怀","耿耿在心","耿耿于心"],"usage":"作谓语、定语；指不能忘怀的事"},{"id":37271,"word":"耿耿寸心","pinyin":"gěng gěng cùn xīn","abbr":"ggcx","explanation":"耿耿：形容忠诚。形容至忠至诚。","source":{"text":"寒江才把一书开，耿耿此心不易灰。","book":"清·黄宗羲《感旧》"},"example":{"text":"～，愿盟息壤，凡百君子，其敬听之。","book":"蔡东藩、许廑父《民国通俗演义》第九十二回"},"similar":["耿耿此心"],"usage":"作主语、宾语；指人忠诚"},{"id":37272,"word":"耿耿此心","pinyin":"gěng gěng cǐ xīn","abbr":"ggcx","explanation":"耿耿：形容忠诚。这颗心至忠至诚。","source":{"text":"寒江才把一书开，耿耿此心不易灰。","book":"清·黄宗羲《感旧》"},"example":{"text":"～，惟有天知。","book":"《柳荫记》第六场"},"similar":["耿耿寸心"],"usage":"作主语、宾语；指人忠诚"},{"id":37273,"word":"聆音察理","pinyin":"líng yīn chá lǐ","abbr":"lycl","explanation":"听到声音就能明察事理。指善于分析。","source":{"text":"我老孙，颇有降龙伏虎的手段，翻江搅海的神通；见貌辨色，聆音察理。","book":"明·吴承恩《西游记》第14回"},"example":{"text":"要多思多想，一窍通，百窍通，～，随机应变。","book":"包蕾《猪八戒学本领》"},"similar":["观颜察色"],"usage":"作谓语、宾语；指善于分析"},{"id":37274,"word":"聊以卒岁","pinyin":"liáo yǐ zú suì","abbr":"lyzs","explanation":"聊：勉强；卒：终；岁：年。勉强地度过一年。","source":{"text":"优哉游哉，聊以卒岁。","book":"《左传·襄公二十一年》"},"example":{"text":"于艰难竭蹶之中，存～之想。","book":"毛泽东《中国社会各阶级的分析》"},"similar":["得过且过"],"usage":"作谓语、定语；指混日子","story":["春秋时期，晋国贵族之间权力斗争十分激烈，范宣子赶跑了他的外孙栾盈，并杀了他的同党羊舌虎，将羊舌虎的哥哥叔向囚禁起来。叔向认为自己能够优哉游哉地坐牢、聊以卒岁很幸福了。大夫祁奚说服范宣子，向晋平公求情，释放了叔向，任他为太傅"]},{"id":37275,"word":"聊以塞命","pinyin":"liáo yǐ sè mìng","abbr":"lysm","explanation":"聊：姑且；塞命：搪塞责任。姑且应付一下，算是交代了责任。","source":{"text":"辄以昔所闻者，务笺释于所问目之下，聊以塞命耳。","book":"宋·李侗《答问上》"}},{"id":37276,"word":"聊以塞责","pinyin":"liáo yǐ sè zé","abbr":"lysz","explanation":"聊：姑且；塞责：搪塞责任。姑且应付一下，算是交代了责任。","source":{"text":"韩侘胄当国，言官不敢言事，但泛论君德、时事，或问之，则愧谢曰：‘聊以塞责。’","book":"宋·袁枢《通鉴纪事本末》"},"example":{"text":"我素乏捷才，且不长于吟咏，姐妹辈素所深知；今夜～，不负斯景而已。","book":"清·曹雪芹《红楼梦》第十八回"},"similar":["因循苟且","马马虎虎"],"opposite":["任劳任怨"],"usage":"作谓语、定语；指姑且应付一下，算是尽了责"},{"id":37277,"word":"聊以慰藉","pinyin":"liáo yǐ wèi jiè","abbr":"lywj","explanation":"聊：姑且；慰藉：安慰自己。姑且用来自我安慰。","source":{"text":"有时候乃不免呐喊几声，聊以慰藉那在寂寞里奔驰的猛士，使他不惮于前驱。","book":"鲁迅《“呐喊”自序》"},"similar":["聊以自慰"],"usage":"作谓语、定语；指姑且用来自我安慰"},{"id":37278,"word":"聊以自况","pinyin":"liáo yǐ zì kuàng","abbr":"lyzk","explanation":"自况：以某种人来比喻自己。姑且借助值得效法的人及其行为来比拟自己。","source":{"text":"潜少有高趣，尝著《五柳先生传》以自况。","book":"《宋书·陶潜传》"},"example":{"text":"然观古之达人，亦多有好是者，故备录之～，且以自警。","book":"明·何良俊《四友斋丛说·娱老·一》"}},{"id":37279,"word":"聊以自娱","pinyin":"liáo yǐ zì yú","abbr":"lyzy","explanation":"聊：姑且。姑且用以自我娱乐宽慰。","source":{"text":"西北有长沙，其半蛮夷，亦称王。老夫故敢妄窃帝号，聊以自娱。","book":"《汉书·南粤王赵佗传》"},"example":{"text":"弹琴鼓瑟，～。","book":"《宋书·乐志四》"},"similar":["聊以自慰"],"usage":"作谓语、定语；指自我欣赏"},{"id":37280,"word":"聊以自慰","pinyin":"liáo yǐ zì wèi","abbr":"lyzw","explanation":"聊：姑且。姑且用来安慰自己。","source":{"text":"南寓衡阳，避祁寒也……余五十之年，忽焉已至，永言身事，慨然其多绪，乃为之赋，聊以自慰。","book":"汉·张衡《鸿赋序》"},"example":{"text":"遇见强者，不敢反抗，便以“中庸”这些话来粉饰，～。","book":"鲁迅《华盖集·通讯》"},"similar":["望梅止渴","画饼充饥","聊以解嘲"],"opposite":["若有所失","怅然若失"],"usage":"作谓语、宾语；指姑且用来自我安慰"},{"id":37281,"word":"聊以解嘲","pinyin":"liáo yǐ jiě cháo","abbr":"lyjc","explanation":"解：消除；嘲：嘲笑。姑且用来解脱被人嘲笑的事情。","source":{"text":"汉·扬雄《解嘲》：“人有嘲雄以玄之尚白，雄解之，号曰解嘲。”宋·胡仔《苕溪渔隐诗话前集》卷三：“子美困顿于山川，盖为不知者诟病，以为拙于生事，又往往讥议宗文、宗武失学，故聊解嘲耳。"},"example":{"text":"这只可算是～的举动。","book":"清·吴趼人《二十年目睹之怪现状》第六十一回"},"usage":"作谓语、宾语；指姑且用来掩盖或粉饰别人的"},{"id":37282,"word":"聊博一笑","pinyin":"liáo bó yī xiào","abbr":"lbyx","explanation":"姑且取得别人一笑。比喻自己言行虽无可取，但亦能令人快乐一时。","source":{"text":"言之浅陋，阅者解颐，以期雅俗共赏，聊博大雅一笑云尔。","book":"清·李静山《增补都门杂咏·序》"}},{"id":37283,"word":"聊备一格","pinyin":"liáo bèi yī gé","abbr":"lbyg","explanation":"姑且备为一种风格或格式。","source":{"text":"余于别集中求其措语无害大雅者择录一二，非赏其工也，聊备一格而已。","book":"清·陈廷焯《白雨斋词话》第五卷"},"example":{"text":"但是以为谈论文艺，思想、生活问题应该大谈特谈，谈技巧则只宜‘～’，否则就有些不妙。","book":"秦牧《跋》"},"usage":"作谓语；指姑且备为一种风格或格式"},{"id":37284,"word":"聊复尔尔","pinyin":"liáo fù ěr ěr","abbr":"lfee","explanation":"姑且如此而已。同“聊复尔耳”。","source":{"text":"那万生舞罢了，轻轻放在匣里，神色自若。那些看的人没一个不喝采。云生也大叫道：‘神乎技矣！’万生答道：‘未能免俗，聊复尔尔。’","book":"明·刘璋《凤凰池》第一回"},"similar":["聊复尔耳"],"usage":"作分句、状语；指姑且如此而已"},{"id":37285,"word":"聊复尔耳","pinyin":"liáo fù ěr ěr","abbr":"lfee","explanation":"聊：姑且；尔：如此；耳：而已，罢了。姑且如此而已。","source":{"text":"未能免俗，聊复尔耳。","book":"《晋书·阮咸传》"},"example":{"text":"殊不尔，～，尔犹言如此也。","book":"清·陆以湉《冷庐杂识·世说新语里谚》"},"similar":["聊复尔尔"],"usage":"作分句、状语；指姑且如此而已"},{"id":37286,"word":"聊胜一筹","pinyin":"liáo shèng yī chóu","abbr":"lsyc","explanation":"略微高出一点。","source":{"text":"较之第四节所言‘污蔑原作的演出’，自觉聊胜一筹。","book":"洪深《戏剧导演的初步知识》"},"example":{"text":"我比你～。"},"similar":["略胜一筹"],"usage":"作补语、定语；指略微高出一点"},{"id":37287,"word":"聊胜于无","pinyin":"liáo shèng yú wú","abbr":"lsyw","explanation":"聊：略微。比没有要好一点。","source":{"text":"弱女虽非男，慰情聊胜无。","book":"晋·陶潜《和刘柴桑》诗"},"example":{"text":"王二瞎子一听仍是衙门里的人，就是声光比账房差些，尚属慰情～。","book":"清·李宝嘉《官场现形记》第四十五回"},"similar":["微乎其微","屈指可数"],"opposite":["不胜枚举","不计其数"],"usage":"作谓语、定语、分句；指比完全没有要好一点"},{"id":37288,"word":"聊表寸心","pinyin":"liáo biǎo cùn xīn","abbr":"lbcx","explanation":"聊：略微；寸心：微薄的心意。略微表示一下心意。","source":{"text":"早间曾以小匣托渔人奉致，聊表寸心，从此不复相见矣。","book":"明·冯梦龙《警世通言·杜十娘怒沉百宝箱》"},"example":{"text":"送上一些小礼品，～，请笑纳。"},"similar":["略表寸心"],"usage":"作谓语；用于自谦"},{"id":37289,"word":"聋者之歌","pinyin":"lóng zhě zhī gē","abbr":"lzzg","explanation":"聋者学人唱歌，却听不到歌声，无以自乐。形容模仿别人的行为，实际上並不了解其中真义。","source":{"text":"夫内不开于中，而强学问者，不入于耳而不着于心，此何以异于聋者之歌也，效人为之而无以自乐也，声出于口则越而散矣。","book":"《淮南子·原道》"}},{"id":37290,"word":"职务繁杂","pinyin":"zhí wù fán zá","abbr":"zwfz","explanation":"指担任的事务烦琐杂乱。","source":{"text":"笃志于学，虽职务繁杂，卷不释手。","book":"《隋书·牛弘传》"},"usage":"作谓语、宾语；指职务多"},{"id":37291,"word":"职名早投","pinyin":"zhí míng zǎo tóu","abbr":"zmzt","explanation":"职名：官员的履历。把官员的履历早些呈上。指新皇帝嗣位后，官员们呈上职名，等待封赏。比喻企求升官","source":{"text":"他说马中丞当先出头，众公卿认肯逗留。职名早投，大家去上书陈表，拥入皇州。","book":"清·孔尚任《桃花扇·迎驾》"},"usage":"作谓语、定语；用于书面语"},{"id":37292,"word":"聒聒噪噪","pinyin":"guō guō zào zào","abbr":"ggzz","explanation":"吵吵闹闹。","source":{"text":"走到一个土冈子上，丛丛杂杂，有些树木，就林子里睡到天明，心中忧闷，只听得树枝上喜雀聒聒噪噪。","book":"明·施耐庵《水浒传》第62回"},"example":{"text":"明·郭勋《英烈传》第36回：“载了芦荻，置了火药，趁着上风，把火～的直放下来。”"},"similar":["吵吵闹闹"],"usage":"作谓语、定语、状语；用于声响等"},{"id":37293,"word":"联床风雨","pinyin":"lián chuáng fēng yǔ","abbr":"lcfy","explanation":"指朋友或兄弟相聚，倾心交谈。","source":{"text":"忆昔联床风雨，叹今彼各天涯。","book":"元·王实甫《西厢记》第二本楔子"}},{"id":37294,"word":"联篇累牍","pinyin":"lián piān lěi dú","abbr":"lpld","explanation":"形容文字冗长而繁琐。","source":{"text":"友人周海庐与之昵，赠以诗，不啻联篇累牍。","book":"清·俞蛟《潮嘉风月记·丽品》"},"similar":["连篇累牍"],"opposite":["简明扼要"],"usage":"作定语、状语；指文字冗长"},{"id":37295,"word":"联翩而至","pinyin":"lián piān ér zhì","abbr":"lpez","explanation":"联翩：鸟联着翅膀疾飞的样子。形容人接连来到。","source":{"text":"滔藻联翩。","book":"晋·陆机《文赋》"},"example":{"text":"不到半个时辰，张、罗二人，～。","book":"高阳《草莽英雄》第二十章"}},{"id":37296,"word":"联袂而至","pinyin":"lián mèi ér zhì","abbr":"lmez","explanation":"比喻一同来到。","source":{"text":"即如阮大铖、袁宏勋、徐复阳辈，联袂而至，岂可概加录用乎？","book":"《清史稿·魏琯传》"},"example":{"text":"徐海、叶麻、黄侃、王亚六～，少不得又对罗龙文的书法赞叹一番。","book":"高阳《草莽英雄》第十九章"}},{"id":37297,"word":"聚众滋事","pinyin":"jù zhòng zī shì","abbr":"jzzs","explanation":"聚集一帮人到处惹事，制造纠纷。","source":{"text":"我生平最恨的就是这班刁民！动不动聚众滋事，挟制官长！","book":"清·李宝嘉《官场现形记》第53回"},"example":{"text":"他们爱聚众滋事，影响极坏。"},"similar":["聚众闹事"],"usage":"作谓语、定语、宾语；指闹事"},{"id":37298,"word":"聚少成多","pinyin":"jù shǎo chéng duō","abbr":"jscd","explanation":"聚：集合，会合。一点一滴的积累，就会由少变多。","source":{"text":"众少成多，积小致巨。","book":"东汉·班固《汉书·董仲舒传》"},"example":{"text":"每顿饭我们节省下一调羹米，～。","book":"《朝鲜风云》第一场"},"similar":["积少成多"],"usage":"作谓语、定语、宾语；指由小积累"},{"id":37299,"word":"聚敛无厌","pinyin":"jù liǎn wú yàn","abbr":"jlwy","explanation":"聚敛：搜刮，盘剥。厌：饱，满足。尽力收刮钱财，永远也不满足。形容非常贪婪。","source":{"text":"王夷甫妇郭泰宁女，才拙而性刚，聚敛无厌，干豫人事，夷甫患之而不能禁。","book":"南朝·宋·刘义庆《世说新语·规箴》"},"example":{"text":"数人皆以小吏起家，不达大体，督责苛碎，～。","book":"蔡东藩《南北史演义》第八十二回"},"similar":["贪得无厌"],"usage":"作谓语、定语；指非常贪婪"},{"id":37300,"word":"聚散浮生","pinyin":"jù sàn fú shēng","abbr":"jsfs","explanation":"旧指人之聚散无常，人的一生就象水上的浮萍一样漂浮不定。","example":{"text":"如今才晓得“～”四字，古人说了，不曾提醒一个。","book":"清·曹雪芹《红楼梦》第一百十八回"}},{"id":37301,"word":"聚族而居","pinyin":"jù zú ér jū","abbr":"jzej","explanation":"聚：聚集；族：家族。同族人聚集一起居住。","source":{"text":"我们多年聚族而居的老屋，已经公同卖给别姓了。","book":"鲁迅《故乡》"},"usage":"作谓语、定语；指大家族"},{"id":37302,"word":"聚沙之年","pinyin":"jù shā zhī nián","abbr":"jszn","explanation":"儿童喜玩泥沙，因此用“聚沙之年”来称儿童时代。","source":{"text":"乃至童子戏，聚沙为佛塔。","book":"《妙法莲华经·方便品》"},"example":{"text":"奇阙之岁，霞轩月举，～，兰薰桂馥。","book":"唐·于志宁《大唐西域记序》"},"usage":"作主语、宾语；用于书面语"},{"id":37303,"word":"聚沙成塔","pinyin":"jù shā chéng tǎ","abbr":"jsct","explanation":"聚细沙成宝塔。原指儿童堆塔游戏。后比喻积少成多。","source":{"text":"乃至童子戏，聚沙为佛塔。","book":"《妙法莲华经·方便品》"},"example":{"text":"‘渺小’是从个人的角度来看的，‘～，集腋成裘’，党是永远重视群众的力量的。","book":"冰心《再寄小读者》"},"similar":["集腋成裘","积少成多"],"opposite":["杯水车薪","狗熊掰棒子"],"usage":"作宾语、定语、分句；指积少成多"},{"id":37304,"word":"聚米为山","pinyin":"jù mǐ wéi shān","abbr":"jmws","explanation":"东汉马援堆米成山，以代地形模型，给皇帝分析军事形势、进军计划，讲得十分明了。指形象地陈述军事形势，险要的地形。","source":{"text":"援因说隗嚣将帅有土崩之势，兵进有必破之状。又于帝前聚米为山谷，指画形势，开示众军所从道径往来，分析曲折，昭然可晓。","book":"《后汉书·马援传》"},"example":{"text":"又在帝前～，指划形势，详陈路径，何处可攻，何处可守，说得明明白白，昭然可晓。","book":"蔡东藩《后汉演义》第十八回"},"similar":["聚米为谷"],"usage":"作谓语；指谋划事情","story":["东汉初年，光武帝刘秀统一了中原，西部的隗嚣拥兵自重，与刘秀势不两立。刘秀准备派兵攻打，但还有些犹豫不决，刚投奔过来的大将马援认为隗嚣将帅不合，出兵必胜，他用米堆积成西部地形，指画进兵线路。刘秀顿时感觉胜利在望"]},{"id":37305,"word":"聚米为谷","pinyin":"jù mǐ wéi gǔ","abbr":"jmwg","explanation":"比喻指划形势，运筹决策。","source":{"text":"援因说隗嚣将帅有土崩之势，兵进有必破之状。又于帝前聚米为山谷，指画形势，开示众军所从道径往来，分析曲折，昭然可晓。","book":"南朝·宋·范晔《后汉书·马援传》"},"example":{"text":"是以～，贼虏之虚实可知；画地成图，山川之形势易悉。","book":"唐·刘知幾《史通·点烦》"},"similar":["聚米为山"],"usage":"作谓语；指谋划事情","story":["东汉初年，光武帝刘秀统一了中原，西部的隗嚣拥兵自重，与刘秀势不两立。刘秀准备派兵攻打，但还有些犹豫不决，大将马援认为隗嚣将帅不合，出兵必胜，他用米堆积成西部地形，指画进兵线路。刘秀顿时感觉胜利在望"]},{"id":37306,"word":"聚精会神","pinyin":"jù jīng huì shén","abbr":"jjhs","explanation":"会：集中。原指君臣协力，集思广益。后形容精神高度集中。","source":{"text":"聚精会神，相得益（章）彰。","book":"汉·王褒《圣主得贤臣颂》"},"example":{"text":"看校样时的～，就和在写作的时候一样，因为我的目的要使它没有一个错字。","book":"邹韬奋《经历·一个小小的过街楼》"},"similar":["目不转睛","专心致志","全神贯注"],"opposite":["心不在焉","神不守舍","心神不定"],"usage":"作主语、谓语、定语、状语；指人的注意力"},{"id":37307,"word":"聚精凝神","pinyin":"jù jīng níng shén","abbr":"jjns","explanation":"聚：集合，会集。形容专心致志，注意力高度集中。","source":{"text":"忆起昨夜那些小孩子，接过礼物攒三集五，聚精凝神，一层层打开包裹的光景。","book":"冰心《寄小读者》"},"similar":["聚精会神"],"opposite":["心神不定"],"usage":"作谓语、定语、状语；指人的注意力"},{"id":37308,"word":"聚而歼之","pinyin":"jù ér jiān zhī","abbr":"jejz","explanation":"聚：会集，包围；歼：消灭。把敌人包围起来消灭。","source":{"text":"社仑凶狡有权变，月余，乃释匹候跋，归其诸子，欲聚而歼之。","book":"《魏书·蠕蠕传》"},"example":{"text":"不敢举行本来有利的向敌人后方打去的进攻，也不敢大胆放手诱敌深入，～。","book":"毛泽东《中国革命战争的战略问题》"},"usage":"作谓语；用于战争"},{"id":37309,"word":"聚萤映雪","pinyin":"jù yíng yìng xuě","abbr":"jyyx","explanation":"聚萤：晋代人车胤收集萤火虫读书；映雪：晋代人孙康映雪读书。形容刻苦攻读，勤学上进。","source":{"text":"未尝聚萤映雪悬头刺股，读《论》唯取一篇，披《庄》不过盈尺。","book":"《北史·崔赜传》"},"similar":["集萤映雪","聚萤积雪","积雪囊萤"],"usage":"作宾语、定语；用于求学等","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":37310,"word":"聚萤积雪","pinyin":"jù yíng jī xuě","abbr":"jyjx","explanation":"聚萤：晋代人车胤收集萤火虫读书；积雪：晋代人孙康映雪读书。形容刻苦攻读，勤学上进。","source":{"text":"守着那聚萤积雪看书窗，几时得出为破虏三将军，入为治国头厅相？","book":"元·关汉卿《玉镜台》第一折"},"similar":["集萤映雪","聚萤映雪","积雪囊萤"],"usage":"作宾语、定语；用于求学等","story":["晋代时期，车胤从小就好学不倦，因家贫没钱买灯油供他晚上读书，在夏夜他见室外飞舞着萤火虫，就用白纱布袋把捉来的萤火虫吊在书本上方，借着微弱的光线进行读书。同朝的孙康因为家贫，雪夜里借着窗外映来的雪光进行读书"]},{"id":37311,"word":"聚蚊成雷","pinyin":"jù wén chéng léi","abbr":"jwcl","explanation":"许多蚊子聚到一起，声音会象雷声那样大。比喻说坏话的人多了，会使人受到很大的损害。","source":{"text":"夫众煦漂山，聚蚊成雷。","book":"《汉书·中山靖王传》"},"example":{"text":"～，封狐千里。","book":"《南史·武陵王纪传》"},"similar":["众口铄金"],"usage":"作谓语；比喻众口诋毁，积少可以成大","story":["西汉时期，吴楚七王叛乱之后，汉武帝采取种种限制诸侯的措施，官府的权力大过诸侯。他为了平衡诸侯王之间的关系，请他们在一块喝酒作乐，席间奏幽微哀伤的乐曲，中山靖王刘胜哀伤地倾诉，希望不要听信谗言，聚蚊成雷会使流言影响兄弟之间关系"]},{"id":37312,"word":"聚讼纷然","pinyin":"jù sòng fēn rán","abbr":"jsfr","explanation":"聚：集中；讼：争辩。言论多而杂乱，看法不一致。","source":{"text":"此其义后贤聚讼纷然，谓其徒尚有形之利，而不数无形之利。","book":"梁启超《生计学学说沿革小史》"},"similar":["聚讼纷纭"],"opposite":["众口一词"],"usage":"作谓语、宾语、状语；指看法不一致"},{"id":37313,"word":"聚讼纷纭","pinyin":"jù sòng fēn yún","abbr":"jsfy","explanation":"聚讼：众中争辩；纷纭：多而杂乱。许多人在一起对某一问题议论纷纷，不能决定哪种意见是正确的。","source":{"text":"聚讼纷纭，几为士林一大疑案。","book":"清·张元济《跋》"},"example":{"text":"有一位大名鼎鼎的诗人兼批评家蒲伯，算不算古典主义这一派，到现在也还～，没有定论。","book":"茅盾《夜读偶记》"},"similar":["聚讼纷然"],"opposite":["异口同声","众口一词","如出一口"],"usage":"作谓语、宾语、状语；指看法不一致"},{"id":37314,"word":"聚铁铸错","pinyin":"jù tiě zhù cuò","abbr":"jtzc","explanation":"聚集大量的铁，铸造一个错误。形容失误无可挽救。","source":{"text":"聚六州四十二县铁，铸一个错不成。","book":"《五代史》"}},{"id":37315,"word":"聪明一世","pinyin":"cōng míng yī shì","abbr":"cmys","explanation":"表示一个人一辈子聪明。","source":{"text":"若我断不出此事，枉自聪明一世。每日退堂，便将画图展玩，千思万想。","book":"明·冯梦龙《古今小说·滕大尹鬼断家私》"},"example":{"text":"六十九岁的人了，反倒～，糊涂一时，教一群猴儿王八蛋给吃了。","book":"老舍《骆驼祥子》十四"},"similar":["聪明一世，糊涂一时"],"usage":"作谓语、宾语；常与“糊涂一时”连用"},{"id":37316,"word":"聪明一世，懵懂一时","pinyin":"cōng míng yī shì，měng dǒng yī shí","abbr":"cmysmdys","explanation":"懵懂：头脑不清楚或不能明辨事物。人一辈子都很精明，但有时一下子糊涂。指聪明人也会犯错误。","source":{"text":"懵懂：头脑不清楚或不能明辨事物。人一辈子都很精明，但有时一下子糊涂。指聪明人也会犯错误。"},"example":{"text":"雪公！你真正是～。","book":"高阳《胡雪岩全传·平步青云》上册"},"similar":["聪明一世，糊涂一时"],"usage":"作宾语、定语、分句；指聪明人也会犯错误"},{"id":37317,"word":"聪明一世，糊涂一时","pinyin":"cōng míng yī shì，hú tú yī shí","abbr":"cmyshtys","explanation":"聪明一辈子，临时却糊涂起来。指一向聪明的人，偶尔在某件事上犯糊涂。","source":{"text":"如今且说一个人，古来第一聪明的，他聪明了一世，懞懂在一时。留下花锦缎般一段话文，传与后生小子。","book":"明·冯梦龙《警世通言》卷三"},"example":{"text":"六十九岁的人了，反倒～，教一群猴儿王八蛋给吃了。","book":"老舍《骆驼祥子》十四"},"similar":["聪明一世","聪明一世，懵懂一时"],"usage":"作宾语、定语、分句；指聪明人也会犯错误"},{"id":37318,"word":"聪明伶俐","pinyin":"cōng míng líng lì","abbr":"cmll","explanation":"聪明：智力发达，天资高。伶俐：灵活、乖巧。形容小孩头脑机灵，活泼且乖巧。","source":{"text":"原来这乐和是一个聪明伶俐的人；诸般乐品学着便会；作事道头知尾；说起枪棒武艺，如糖似蜜价爱。","book":"明·施耐庵《水浒全传》第四十九回"},"example":{"text":"这个人真是～；她东问西找，竟然到了我们这里。","book":"吴强《红日》第八章"},"similar":["聪明智慧","聪明才智"],"opposite":["蠢如鹿豕","冥顽不灵"],"usage":"作谓语、定语；形容头脑机灵"},{"id":37319,"word":"聪明出众","pinyin":"cōng míng chū zhòng","abbr":"cmcz","explanation":"聪明：智力发达，天资高；出从：超众。指智力超过一般的人。","source":{"text":"那些南革的首领……都是聪明出众的人才。","book":"清·刘鹗《老残游记》第十一回"},"similar":["聪明绝世"],"usage":"作谓语、定语；用于夸奖人"},{"id":37320,"word":"聪明反被聪明误","pinyin":"cōng míng fǎn bèi cōng míng wù","abbr":"cmfbcmw","explanation":"自以为聪明反而被聪明耽误或妨害了。","source":{"text":"人皆养子望聪明，我被聪明误一生。","book":"宋·苏轼《东坡续集·洗儿》"},"example":{"text":"今若仍为所迷，岂不是～了吗？","book":"清·醉月山人《狐狸缘全传》第五回"},"similar":["聪明反被聪明害"],"usage":"作宾语、分句；指自作聪明"},{"id":37321,"word":"聪明才智","pinyin":"cōng míng cái zhì","abbr":"cmcz","explanation":"指有丰富敏捷的智力和显著的才能。","source":{"text":"如有聪明才智，识达古今，正当辅佐君子，助其不足。","book":"北齐·颜之推《颜氏家训·治家》"},"example":{"text":"因思姊姊同妹妹，～岂输男。","book":"清·秋谨《精卫石》第二回"},"similar":["聪明智慧"],"opposite":["冥顽不灵"],"usage":"作谓语、定语、补语；形容智力发达"},{"id":37322,"word":"聪明智慧","pinyin":"cōng míng zhì huì","abbr":"cmzh","explanation":"智力过人，心思敏锐。","source":{"text":"不觉魏鹏渐渐长大……聪明智慧，熟于经史。","book":"明·周楫《西湖二集·洒雪堂巧结良缘》"},"example":{"text":"要论这小姐的模样儿，～，根基家当，倒也配的过。","book":"清·曹雪芹《红楼梦》第二十九回"},"similar":["聪明才智"],"usage":"作宾语；指人的智力过人"},{"id":37323,"word":"聪明智能","pinyin":"cōng míng zhì néng","abbr":"cmzn","explanation":"指智力过人，心思敏锐。","source":{"text":"明·周楫《西湖二集·洒雪堂巧结良缘》：“不觉魏鹏渐渐长大……聪明智能，熟于经史。"},"example":{"text":"要论这小姐的模样儿，～，根基家当，倒也配的过。","book":"清·曹雪芹《红楼梦》第二十九回"}},{"id":37324,"word":"聪明正直","pinyin":"cōng míng zhèng zhí","abbr":"cmzz","explanation":"头脑聪明，行为正直无私。形容词人的品质优秀。","source":{"text":"神聪明正直而壹者也。","book":"《左传·庄公三十二年》"},"example":{"text":"那包爷（拯）自小～，做知县时，便能剖人间暧昧之情，断天下狐疑之狱。","book":"明·冯梦龙《警世通言·三现身包龙图断冤》"},"usage":"作谓语、定语；指行为正直无私"},{"id":37325,"word":"聪明睿智","pinyin":"cōng míng ruì zhì","abbr":"cmrz","explanation":"指聪颖明智。","source":{"text":"聪明睿智，守之以愚。","book":"《孔子家语·三恕》"},"example":{"text":"则全地～之士，日尽其心思才力以思创新。","book":"康有为《大同书》六辛部第十一章"},"similar":["聪明睿达","聪明睿知"],"usage":"作谓语、定语、宾语；用于夸奖人"},{"id":37326,"word":"聪明睿知","pinyin":"cōng míng ruì zhī","abbr":"cmrz","explanation":"聪明：聪敏有智慧。形容洞察力强，见识卓越。","source":{"text":"古之聪明睿知，神武而不杀者夫。","book":"《周易·系辞》"},"similar":["聪明睿智"],"usage":"作谓语、定语、宾语；用于夸奖人"},{"id":37327,"word":"聪明睿达","pinyin":"cōng míng ruì dá","abbr":"cmrd","explanation":"聪明：聪敏有智慧。形容洞察力强，见识卓越。","example":{"text":"她是一个～的人。"},"similar":["聪明睿智"],"usage":"作谓语、定语；用于夸奖人"},{"id":37328,"word":"聪明绝世","pinyin":"cōng míng jué shì","abbr":"cmjs","explanation":"聪明到了极点，无人能与之相比。","source":{"text":"为人孤峭，寡言语，不轻与人交接，而聪明绝世，至于词曲及笙笛箫管之属，咸能通习。","book":"《画学·画中人》"},"similar":["聪明出众","聪明绝顶"],"usage":"作谓语、定语；用于夸奖人"},{"id":37329,"word":"聪明绝顶","pinyin":"cōng míng jué dǐng","abbr":"cmjd","explanation":"聪明：聪敏有智慧；绝：冠绝。形容极其聪明，无人能比","source":{"text":"他本是夙根极好、聪明绝顶的人，当时都已领会。","book":"清·无垢道人《八仙全传》第五回"},"similar":["聪明绝世"],"usage":"作谓语、定语；用于夸奖人"},{"id":37330,"word":"聪明能干","pinyin":"cōng míng néng gàn","abbr":"cmng","explanation":"天资高记忆和理解力强而又有能力会做事。","source":{"text":"圣人说，人生少时，心思才力，样样聪明能干，实在是可怕的。","book":"清·曹雪芹《红楼梦》第82回"},"example":{"text":"她是一个～的女孩。"},"similar":["精明能干"],"opposite":["笨头笨脑"],"usage":"作谓语、定语；用于夸奖人"},{"id":37331,"word":"聪明英毅","pinyin":"cōng míng yīng yì","abbr":"cmyy","explanation":"聪明：智力高，天资好；毅：坚定而有决断。智力超人，英明果断。","source":{"text":"高宗以公天下之心，择太祖之后而立之，乃得孝宗之贤，聪明英毅，卓然为南渡诸帝之称首。","book":"《宋史·孝宗纪》"}},{"id":37332,"word":"聪明过人","pinyin":"cōng míng guò rén","abbr":"cmgr","explanation":"智力超过一般的人。","source":{"text":"余在京师时，见盛甫山舍人之三弦，程香谷礼部之鼓礼鼓板，席子远、陈石士两编修能唱大小喉咙，俱妙，亦其聪明过人之一端。","book":"清·钱泳《履园丛话·艺能·度曲》"}},{"id":37333,"word":"聱牙佶屈","pinyin":"áo yá jí qū","abbr":"ayjq","explanation":"聱牙：不顺口；佶屈：曲折。指文章读起来不顺口。","source":{"text":"周浩殷盘，佶屈聱牙。","book":"唐·韩愈《进学解》"},"example":{"text":"我今赠君亦无物，但有～村田诗。","book":"元·戴元表《剡源集·寿陈贵白"},"similar":["佶屈聱牙"],"usage":"作谓语、定语、补语；用于书面语"},{"id":37334,"word":"聱牙戟口","pinyin":"áo yá jǐ kǒu","abbr":"ayjk","explanation":"形容文词艰涩，拗口难读。","source":{"text":"所拟乐府，或更古数字为己作，文则聱牙戟口，读者至不能终篇。","book":"《明史·文苑传三·李攀龙》"},"example":{"text":"而不知只从形式上着眼，就必然走上～的道路。","book":"郭绍虞《中国文学批评史》"},"similar":["聱牙诘曲"],"opposite":["琅琅上口"],"usage":"作谓语、定语；用于文章等"},{"id":37335,"word":"聱牙诎曲","pinyin":"áo yá qū qū","abbr":"ayqq","explanation":"形容文辞艰涩难读。","source":{"text":"推公之意，其必以聱牙诎曲不识字句者为古耶？","book":"清·钱谦益《题归太仆文集》"},"similar":["聱牙诘曲"],"usage":"作谓语、定语；用于文辞方面"},{"id":37336,"word":"聱牙诘屈","pinyin":"áo yá jié qū","abbr":"ayjq","explanation":"聱牙：不顺口；诘屈：曲折。形容文辞艰涩难读。","source":{"text":"为诗好为聱牙诘屈之语，多不自解。","book":"清·周亮工《书影》第二卷"},"similar":["聱牙诘曲"],"opposite":["琅琅上口"],"usage":"作谓语、定语；用于文辞等"},{"id":37337,"word":"聱牙诘曲","pinyin":"áo yá jié qū","abbr":"ayjq","explanation":"聱牙：不顺口；诘曲：曲折。指文章读起来不顺口。","source":{"text":"有荐伏生工《尚书》，上诏中大夫晁错至其家，从七岁好口授书文，聱牙诘曲。","book":"清·郑相如《汉林四传·开明君传》"},"similar":["聱牙诘屈"],"opposite":["琅琅上口"],"usage":"作谓语、定语、状语；用于文辞方面"},{"id":37338,"word":"肃杀之气","pinyin":"sù shā zhī qì","abbr":"sszq","explanation":"酷烈肃索的秋气。形容秋天草木凋零的气氛。","source":{"text":"肃杀之气，亦只是生气？","book":"《汉书·礼乐志》：“西颢沆砀，秋气肃杀。”宋·朱熹《朱子语类》卷六"},"example":{"text":"茅屋中本来一团～，霎时间尽化为浓情密意。","book":"金庸《神雕侠侣》第十五回"}},{"id":37339,"word":"肃然危坐","pinyin":"sù rán wēi zuò","abbr":"srwz","explanation":"肃然：十分恭敬、肃穆的样子；危：端正。十分肃穆而端正地坐着。","source":{"text":"趁着这明月清风，天空地净，真令人烦心顿解，万虑齐除，都肃然危坐，默默相赏。","book":"清·曹雪芹《红楼梦》第七十六回"}},{"id":37340,"word":"肃然生敬","pinyin":"sù rán shēng jìng","abbr":"srsj","explanation":"形容产生严肃敬仰的感情。同“肃然起敬”。","source":{"text":"鲁直专学子美，然子美诗读之使人凛然兴起，肃然生敬。","book":"宋·张戒《岁寒堂诗话》卷上"},"similar":["肃然起敬","竦然起敬"],"usage":"作谓语、定语；指尊敬的心情"},{"id":37341,"word":"肃然起敬","pinyin":"sù rán qǐ jìng","abbr":"srqj","explanation":"肃然：恭敬的样子；起敬：产生敬佩的心情。形容产生严肃敬仰的感情。","source":{"text":"弟子中或有惰者，远公曰；‘桑榆之光，理无远照，但原朝阳之晖，与时并明耳。’执经登坐，讽诵朗暢，词色甚苦。高足之徒，皆肃然增敬。","book":"南朝宋·刘义庆《世说新语·规箴》"},"example":{"text":"衍举眼观看仲连，神清骨爽，飘飘乎有神仙之度，不觉～。","book":"明·冯梦龙《东周列国志》第一百回"},"similar":["奉若神明","肃然生敬"],"opposite":["漠然置之","恨之入骨"],"usage":"作谓语、定语；指尊敬的心情"},{"id":37342,"word":"肆口而食","pinyin":"sì kǒu ér shí","abbr":"skes","explanation":"随意而吃。比喻一点也不拘束。","source":{"text":"放身而居，体逸则安，肆口而食，属厌则充。","book":"晋·陆机《演连珠》"}},{"id":37343,"word":"肆奸植党","pinyin":"sì jiān zhí dǎng","abbr":"sjzd","explanation":"放肆胡为，培植党羽势力。","source":{"text":"宗铠与同官孙应奎复言，鋐肆奸植党，擅主威福，巧庇龙等，上格明诏，下负公论，且纵二子为奸利。","book":"《明史·冯恩传》"},"usage":"作谓语、宾语、定语；用于处事"},{"id":37344,"word":"肆应之才","pinyin":"sì yìng zhī cái","abbr":"syzc","explanation":"肆应：应对。形容人善于应对。","source":{"text":"是故响不肆应，而影不一没呼叫仿佛，默然自得。","book":"《淮南子·原道训》"},"example":{"text":"为牧令者，即有～，亦难治理。","book":"《清世宗宪皇帝实录》卷二十四"}},{"id":37345,"word":"肆意为虐","pinyin":"sì yì wéi nüè","abbr":"sywn","explanation":"肆意：任意，随意；为：做；虐：残暴。指随意行凶作恶，任意地进行残害。"},{"id":37346,"word":"肆意妄为","pinyin":"sì yì wàng wéi","abbr":"syww","explanation":"毫无顾忌地胡作非为。","source":{"text":"然又怕他因小过不戒，而驯之大过，故令大媳管事，督做女工之事，非纵之使毫无忌惮，肆意妄为也。","book":"清·夏敬渠《野叟曝言》第六十回"},"similar":["肆意妄行"],"usage":"作谓语、定语、状语；用于处事"},{"id":37347,"word":"肆意妄行","pinyin":"sì yì wàng xíng","abbr":"sywx","explanation":"妄：胡乱。毫无顾忌地胡作非为。","source":{"text":"然又怕他因小过不戒，而驯之大过，故令大媳管事，督做女工之事，非纵之使毫无忌惮，肆意妄为也。","book":"清·夏敬渠《野叟曝言》第六十回"},"example":{"text":"一或得志，即～，君不君，臣不臣，父不父，子不子，铤而走险，虽夷虏犹尊亲也。","book":"蔡东藩《五代史演义》自序"},"similar":["肆意妄为"],"usage":"作谓语、定语、状语；用于处事"},{"id":37348,"word":"肆意横行","pinyin":"sì yì héng xíng","abbr":"syhx","explanation":"肆意：任意残杀或迫害。横行：仗势作恶，蛮横凶暴。随心所欲地为非作歹。亦作“肆虐横行”。","source":{"text":"数千里内，杀人放火，肆意横行，入州入县，如入无人之境。","book":"宋·欧阳修《再论置兵御贼札子》"},"example":{"text":"他赤手空拳的打下‘天下’，所以在作着官的时候，他便是～的小皇帝。","book":"老舍《四世同堂》五三"}},{"id":37349,"word":"肆无忌惮","pinyin":"sì wú jì dàn","abbr":"swjd","explanation":"肆：放肆；忌：顾忌；惮：害怕。非常放肆，一点没有顾忌。","source":{"text":"小人之（反）中庸也，小人而无忌惮也。","book":"《礼记·中庸》"},"example":{"text":"她们都是横冲直撞，真真是～。","book":"郭沫若《黄河与扬子江对话》"},"similar":["肆意妄为"],"opposite":["规行矩步","循规蹈矩"],"usage":"作谓语、定语、状语；指一点没有顾忌"},{"id":37350,"word":"肆虐横行","pinyin":"sì nüè héng xíng","abbr":"snhx","explanation":"肆虐：任意残杀或迫害。横行：仗势作恶，蛮横凶暴。随心所欲地为非作歹。","source":{"text":"中官毕贞，逆濠党也。至自江西，声势翕赫，拥从牙士五百余人，肆行残贼，人人自危。","book":"明·冯梦龙《智囊全集·迎刃·留志淑》"},"example":{"text":"那时侯，暴风雪还在这草原上～，大庆的石油也还在地层深处埋伏。","book":"《离不开你》"}},{"id":37351,"word":"肆虐逞威","pinyin":"sì nüè chěng wēi","abbr":"sncw","explanation":"肆：放肆；虐：残暴狠毒；逞：显示；威：威力。指肆意残暴，显示威力。形容恶人任意为非作歹。也用来形容狂风暴雨的无情。"},{"id":37352,"word":"肆行不轨","pinyin":"sì xíng bù guǐ","abbr":"sxbg","explanation":"轨：指行动应遵循的规则。任意横行，不守规则，违法乱纪。","source":{"text":"今高贵乡公肆行不轨，几危社稷，自取倾覆，人神所绝。","book":"《三国志·魏志·高贵乡公传》"},"example":{"text":"既至成都，～，无所忌惮。","book":"《旧唐书·郭英乂传》"}},{"id":37353,"word":"肆行无忌","pinyin":"sì xíng wú jì","abbr":"sxwj","explanation":"恣意横行，无所顾忌。","source":{"text":"因劾亨招权纳赇，肆行无忌，与术士邹叔彝等私讲天文，妄谈休咎，宜置重典。","book":"《明史·石亨传》"},"example":{"text":"湖南军政，以谘议局绅之把持煸动，形势险恶，焦达峰处之坦然，煸动者尤～。","book":"邹鲁《中国国民党史稿》第三骗"},"similar":["横行无忌"],"usage":"作谓语、定语、状语；用于处事"},{"id":37354,"word":"肆行非度","pinyin":"sì xíng fēi dù","abbr":"sxfd","explanation":"肆：放纵；度：限制。肆意横行，不顾礼法。","source":{"text":"肆行非度，无所还忌。","book":"《左传·昭公十二年》"},"example":{"text":"帝遂依译议，译因此衔之。帝后～，昏虑日甚。","book":"《北史·斛斯徵传》"}},{"id":37355,"word":"肆言如狂","pinyin":"sì yán rú kuáng","abbr":"syrk","explanation":"肆：放肆；狂：疯狂。胡言乱语，如同发疯了一样。","source":{"text":"京师太一宫张灯，观者塞道。二人坠于池，宫率急拯之，不肯上，肆言如狂。","book":"宋·洪迈《夷坚丙志·河北道士》"},"usage":"作谓语、定语；用于处事"},{"id":37356,"word":"肆言无忌","pinyin":"sì yán wú jì","abbr":"sywj","explanation":"肆：放肆。毫无顾忌地胡乱说。","source":{"text":"子仁盖女真之能文者，故敢肆言无惮如此。","book":"宋·周密《齐东野语·纥石烈子仁词》"},"example":{"text":"乃谓臣等留一皇字以觇陛下，又谓“百皇字不足当父子之名”，何～至此。","book":"《明史·吴一鹏传》"},"similar":["肆言无惮"],"usage":"作谓语；指毫无顾忌地胡说"},{"id":37357,"word":"肆言无惮","pinyin":"sì yán wú dàn","abbr":"sywd","explanation":"毫无顾忌地胡乱说。","source":{"text":"子仁盖女真之能文者，故敢肆言无惮如此。","book":"宋·周密《齐东野语》"},"example":{"text":"他就会肆无忌惮地对你～。"},"similar":["随口乱说","肆言无忌"],"usage":"作谓语；指毫无顾忌地胡说"},{"id":37358,"word":"肆言詈辱","pinyin":"sì yán lì rǔ","abbr":"sylr","explanation":"肆：任意妄为，放肆。詈：骂。辱：侮辱。毫无畏惧地侮辱谩骂。","source":{"text":"且迈远置辞，无乃侵慢，民作符檄，肆言詈辱，放笔出手，即就齑粉。","book":"《南齐书·丘巨源传》"},"example":{"text":"每当入道场，辄引鸡汁数杯，云可以助声气，或得酬谢不满怠，辄～。","book":"宋·洪迈《夷坚丙志·奉阇梨》"},"usage":"作谓语、定语；用于处事","story":["宋朝时期，宜黄县疏山寺僧奉阇梨擅长操办水陆道场及颂咒偈，经常为人做道场。到老年患有喉疾，说话声音不清晰，因此进入道场前要喝几杯鸡汤润喉助气。有些人不清楚他的这个爱好，没有给他鸡汤或者招待不周，就会得到他的肆言詈辱"]},{"id":37359,"word":"肉中刺","pinyin":"ròu zhōng cì","abbr":"rzc","explanation":"比喻最痛恨而急于除掉的东西。","source":{"text":"快叫个人牙子来，多少卖几两银子，拔去肉中刺，眼中钉，大家过太平日子。","book":"元·无名氏《陈州粜米》：“小衙门云：我见了那穷汉似眼中疔，肉中刺。”清·曹雪芹《红楼梦》第八十回"},"example":{"text":"那晓得这位黎小姐相貌虽丑，性情却是极其凶悍。看着伍琼芳这四个小孩子，真是眼中钉，～。","book":"清·吴趼人《糊涂世界》第三回"},"similar":["眼中钉"],"usage":"作宾语；与“眼中钉”连用"},{"id":37360,"word":"肉中刺，眼中钉","pinyin":"ròu zhōng cì，yǎn zhōng dīng","abbr":"rzcyzd","explanation":"比喻心中最厌恶、最痛恨的人。","source":{"text":"我见了那穷汉，似眼中疔，肉中刺。","book":"元·无名氏《陈州粜米》第一折"},"example":{"text":"多少卖几两银子，拔去肉中刺、眼中钉，大家过太平日子！","book":"清·曹雪芹《红楼梦》第八十回"}},{"id":37361,"word":"肉圃酒池","pinyin":"ròu pǔ jiǔ chí","abbr":"rpjc","explanation":"指酒肉极多。形容极端奢侈豪华的生活。","source":{"text":"纣为肉圃酒池。","book":"西汉·刘安《淮南子·本经训》"},"similar":["肉林酒池","酒池肉林"],"usage":"作宾语、定语；用于比喻句"},{"id":37362,"word":"肉山脯林","pinyin":"ròu shān fǔ lín","abbr":"rspl","explanation":"积肉如山，列脯如林。形容穷奢极侈。","source":{"text":"以人架车，肉山脯林，以酒为池，一鼓而牛饮者三千余人。","book":"晋·皇甫谧《帝王世纪·夏》"},"similar":["穷奢极侈"],"usage":"作宾语、定语；指极度奢侈","story":["商朝末年，商纣王荒淫无道，甚至用酒装满池子，把肉挂在树林里，叫做酒池肉林，让不穿衣服的男女互相追逐嬉戏，还让乐师作淫声伴奏，以供他取乐。他的同族人比干劝谏他，被他所杀，还残忍地将比干的心挖了出来"]},{"id":37363,"word":"肉山酒海","pinyin":"ròu shān jiǔ hǎi","abbr":"rsjh","explanation":"极言酒肉饮食之丰。","source":{"text":"原举泰山以为肉，倾东海以为酒。","book":"三国·魏·曹植《与吴季重书》"},"example":{"text":"厅前大吹大擂，虽无炮龙烹凤，端的是～。","book":"明·施耐庵《水浒传》第八十二回"},"similar":["酒池肉林"],"usage":"作宾语、定语；用于比喻句"},{"id":37364,"word":"肉搏战","pinyin":"ròu bó zhàn","abbr":"rbz","explanation":"交战双方徒手或用短兵器格斗。指直接对抗。","example":{"text":"敌我双方展开了～，战争相当惨烈。"},"usage":"作宾语、定语；用于战争等"},{"id":37365,"word":"肉林酒池","pinyin":"ròu lín jiǔ chí","abbr":"rljc","explanation":"古代传说，殷纣以酒为池，以肉为林，为长夜之饮。原指荒淫腐化、极端奢侈的生活，后也形容酒肉极多。","source":{"text":"行赏赐，酒池肉林。","book":"《史记·殷本纪》：“大聚乐戏于沙丘，以酒为池，悬肉为林，使男女倮相逐其间，为长夜之饮。”《汉书·张骞传》"},"similar":["酒池肉林","肉圃酒池"],"usage":"作宾语、定语；形容极端奢侈豪华的生活"},{"id":37366,"word":"肉眼凡夫","pinyin":"ròu yǎn fán fū","abbr":"ryff","explanation":"肉眼：佛经中说有，天、肉慧、法佛五眼，肉眼为肉身之眼，也泛指俗眼；凡夫：指凡人。指尘世平常的人。","source":{"text":"这都是神仙骨，不似你肉眼凡夫。","book":"元·范子安《竹叶舟》第一折"},"example":{"text":"明·冯梦龙《醒世恒言》第40卷：“勃乃三尺童稚，一介寒儒，～，冒渎尊神，请勿见罪！”"},"similar":["肉眼凡胎","凡夫俗子"],"usage":"作主语、宾语、定语；指凡夫俗子"},{"id":37367,"word":"肉眼凡胎","pinyin":"ròu yǎn fán tāi","abbr":"ryft","explanation":"肉眼：佛经中说有，天、肉慧、法佛五眼，肉眼为肉身之眼，也泛指俗眼；凡胎：指凡人的身体。指尘世平常的人。","source":{"text":"这都是神仙骨，不似你肉眼凡夫。","book":"元·范子安《竹叶舟》第一折"},"example":{"text":"孤先见列位时，只以为唐朝远来的行脚僧，其实肉眼凡胎，多致轻亵。（明·吴承恩《西游记》第八十八回）"},"similar":["肉眼凡夫","凡夫俗子"],"usage":"作主语、宾语、定语；指凡夫俗子"},{"id":37368,"word":"肉眼惠眉","pinyin":"ròu yǎn huì méi","abbr":"ryhm","explanation":"比喻见识浅陋。"},{"id":37369,"word":"肉眼愚眉","pinyin":"ròu yǎn yú méi","abbr":"ryym","explanation":"比喻见识浅陋。","source":{"text":"畅道天理难欺，人心怎昧，则他这肉眼愚眉，把一个黑旋风爹爹敢来也认不得。","book":"元·高文秀《黑旋风》第三折"},"example":{"text":"景色奇，士女齐，满街衢游人如蚁。大多来～。","book":"明·凌濛初《二刻拍案惊奇》第40卷"},"similar":["孤陋寡闻"],"usage":"作谓语；比喻没见过世面"},{"id":37370,"word":"肉眼无珠","pinyin":"ròu yǎn wú zhū","abbr":"rywz","explanation":"珠：眼珠。没长眼珠子。用来责骂人瞎了眼，看不见某人或某事物的伟大或重要。","source":{"text":"常言道，贤者自贤，愚者自愚，就似那薰莸般各别难同处，怎比你有眼却无珠。","book":"元·无名氏《举案齐眉》第一折"},"example":{"text":"肉眼无珠，有屈殿下，收为义子，罪该万死，折福难当矣。","book":"《后宋慈云走国传》第十八回"}},{"id":37371,"word":"肉竹嘈杂","pinyin":"ròu zhū cáo zá","abbr":"rzcz","explanation":"竹：管乐；肉竹：泛指音乐；嘈杂：声音喧闹，杂乱。形容音乐杂乱无章。","source":{"text":"一言甫毕，旱雷聒耳，肉竹嘈杂，不复可闻言笑。","book":"清·蒲松龄《聊斋志异·西湖主》"},"usage":"作宾语、定语；用于书面语"},{"id":37372,"word":"肉绽皮开","pinyin":"ròu zhàn pí kāi","abbr":"rzpk","explanation":"绽：裂开。皮肉都裂开了。形容伤势严重。多指受残酷拷打。","source":{"text":"他、他、他打的来如砍瓜，似劈柴。棒子着处，血忽淋剌，肉绽皮开。","book":"元·无名氏《争报恩》第二折"},"example":{"text":"只见府尹喝叫：“把黄妙修拖翻，加力行杖。”打得～，看看气绝。","book":"明·凌濛初《初刻拍案惊奇》卷十七"}},{"id":37373,"word":"肉腐出虫","pinyin":"ròu fǔ chū chóng","abbr":"rfcc","explanation":"肉腐烂了，就会生出蛆虫。比喻事物本身不健全，祸患自然就发生。也比喻国家不安定，外侮就会乘虚而入。","source":{"text":"肉腐出虫，鱼枯生蠹。","book":"《荀子·劝学》"}},{"id":37374,"word":"肉腰刀","pinyin":"ròu yāo dāo","abbr":"ryd","explanation":"用肉做的腰刀。形容用软刀子杀人，即用阴谋来陷害别人。","source":{"text":"李林甫妒贤嫉能，不协群议，每奏御之际，多所陷人，众谓林甫为肉腰刀。","book":"五代·王仁裕《开元天宝遗事·肉偠刀》"}},{"id":37375,"word":"肉薄骨并","pinyin":"ròu bó gǔ bìng","abbr":"rbgb","explanation":"肉和肉相迫，骨和骨相并。形容战斗的激烈。","source":{"text":"肉薄骨并而拔之，则彼破壁孤城而去。","book":"《元史·郝经传》"},"usage":"作谓语、状语；形容战斗的激烈"},{"id":37376,"word":"肉袒牵羊","pinyin":"ròu tǎn qiān yáng","abbr":"rtqy","explanation":"牵羊：牵着羊，表示犒劳军队。古代战败投降的仪式。","source":{"text":"郑伯肉袒牵羊以逆，曰：‘孤不天，不能事君，使君怀怒以及敝邑，孤之罪也。’","book":"《左传·宣公十二年》"},"example":{"text":"行至逵路，郑襄公～，以迎楚师。","book":"明·冯梦龙《东周列国志》第五十三回"},"usage":"作谓语、定语；指投降","story":["公元前597年，楚庄王率军攻打郑国，占领郑国的首都，郑襄公光着膀子牵着羊向楚庄王跪地求和，答应郑国土地可以划给楚国，郑人做楚人的奴隶，只恳求给一块不毛之地度过余生。楚庄王见郑襄公真诚悔过，就答应了他的求和要求"]},{"id":37377,"word":"肉袒膝行","pinyin":"ròu tǎn xī xíng","abbr":"rtxx","explanation":"肉袒：光着身子；膝行：双腿跪着向前挪动。脱衣裸体，双腿跪着向前挪动，以示顺从降服或认罪。","source":{"text":"宁王大喜，依了他计，相约次日早朝，肉袒膝行，请罪道：‘蒙皇上赐宴，力不胜酒，失错触了妃履，臣出无心，罪该万死。’","book":"清·褚人获《隋唐演义》第79回"},"similar":["肉袒负荆","负荆请罪"],"usage":"作谓语、定语、状语；形容顺从投降"},{"id":37378,"word":"肉袒负荆","pinyin":"ròu tǎn fù jīng","abbr":"rtfj","explanation":"肉袒：光着身子；负荆：背负荆条。赤裸上身，背着荆条请罪，愿受责罚。","source":{"text":"廉颇闻之，肉袒负荆，因宾客至蔺相如门谢罪。","book":"西汉·司马迁《史记·廉颇蔺相如列传》"},"similar":["负荆请罪","肉袒面缚"],"usage":"作谓语、定语；指愿受责罚","story":["战国时期，赵国有两位重臣蔺相如与廉颇，因蔺相如多次立功，赵王封他为相国，廉颇不服气，认为自己的武功盖过他的嘴，蔺相如为了社稷，对廉颇多次避让。廉颇得知他的良苦用心后惭愧不已，便赤身裸体背负荆条向蔺相如请罪"]},{"id":37379,"word":"肉袒面缚","pinyin":"ròu tǎn miàn fù","abbr":"rtmf","explanation":"肉袒：去衣露体，表示愿受责罚；面缚：两手反绑面对胜利者，表示放弃抵抗。脱去上衣，反缚着手。形容顺从投降。","source":{"text":"微子乃持其祭器造于军门，肉袒面缚，左牵羊，右把茅，膝行而前以告。","book":"西汉·司马迁《史记·宋微子世家》"},"example":{"text":"即平北贼，仍事南征，～，归首阙庭，即为申闻。","book":"南朝·陈·徐陵《为陈武帝作相时与岭南酋豪书》"},"similar":["负荆请罪","肉袒负荆","肉袒膝行"],"usage":"作谓语、状语；形容顺从投降","story":["商朝末年，周武王率军伐纣克殷，即将胜利时。商朝权臣微子肉袒面缚到周军军营，左手牵羊，右手拿茅，膝行到周武王面前，献上商朝的祭器，口称谢罪。周武王看他诚心投诚，就下令释放微子，官复其位"]},{"id":37380,"word":"肉跳心惊","pinyin":"ròu tiào xīn jīng","abbr":"rtxj","explanation":"心里吃惊，身上肉跳。形容担心祸事临头或遇到非常可怕的事，十分害怕不安。","source":{"text":"不知怎么，这一会儿心惊肉战，这一双好小脚儿再走也走不动了。","book":"元·无名氏《争报恩》第三折"},"example":{"text":"冤家，真个无差。好些时～，这场兜答。（明·汤显祖《紫钗记·哭收钗燕》）"},"similar":["心惊肉跳","心惊肉战"],"usage":"作谓语、状语；指非常害怕"},{"id":37381,"word":"肉跳神惊","pinyin":"ròu tiào shén jīng","abbr":"rtsj","explanation":"形容担心祸事临头或遇到非常可怕的事，十分害怕不安。同“肉跳心惊”。","source":{"text":"知县肉跳神惊坐立不安。","book":"老舍《神拳》第三幕"},"similar":["心惊肉跳","肉颤心惊"],"usage":"作谓语、宾语、状语；形容人极度惊惧恐慌"},{"id":37382,"word":"肉颤心惊","pinyin":"ròu chàn xīn jīng","abbr":"rcxj","explanation":"形容担心祸事临头或遇到非常可怕的事，十分害怕不安。同“肉跳心惊”。","source":{"text":"吾近日肉颤心惊，恐非吉兆。","book":"《三国演义》第九回"},"similar":["肉跳神惊","心惊肉跳"],"usage":"作谓语、宾语、状语；形容人极度惊惧恐慌"},{"id":37383,"word":"肉食者鄙","pinyin":"ròu shí zhě bǐ","abbr":"rszb","explanation":"肉食者：吃肉的人，引伸为有权位的人；鄙：鄙陋。旧时指身居高位、俸禄丰厚的人眼光短浅。","source":{"text":"肉食者鄙，未能远谋。","book":"《左传·庄公十年》"},"example":{"text":"彼唯有见于近而无见于远，有察于寡而无察于多，～，端推此辈。","book":"严复《救亡决论》"},"usage":"作宾语、分句；指眼光短浅的当权者"},{"id":37384,"word":"肉麻当有趣","pinyin":"ròu má dāng yǒu qù","abbr":"rmdyq","explanation":"比喻去欣赏一些无聊的事。","source":{"text":"可是竟又会有‘肉麻当有趣’，述说得津津有味的，天下事真是千奇百怪。","book":"鲁迅《古书与白话》"},"example":{"text":"她在台上做了不少无聊的动作引起哄堂大笑，真是～。"},"usage":"作宾语、定语；用于口语"},{"id":37385,"word":"肌劈理解","pinyin":"jī pī lǐ jiě","abbr":"jplj","explanation":"比喻立论精辟，析义翔实。","source":{"text":"古者‘六经’之学，专门名家，各守师说。圣贤之微言大义，纲举目张，肌劈理解，权衡尺度，凿凿乎指定于胸中，然后出而从事于史。","book":"清钱谦益《汲古阁毛氏新刻十七史序》"},"example":{"text":"[郑君]有志于左氏、太史公、班固之书，久之而其学大成，～，浸渍演逸，虽通人大儒，未能或之先也。","book":"《序》"},"usage":"作谓语；指文章"},{"id":37386,"word":"肌擘理分","pinyin":"jī bò lǐ fēn","abbr":"jblf","explanation":"擘：分开；理：肌肤的纹理。比喻分析事理十分细致。","source":{"text":"剖析毫厘，擘肌分理。","book":"汉·张衡《西京赋》"}},{"id":37387,"word":"肌无完肤","pinyin":"jī wú wán fū","abbr":"jwwf","explanation":"全身的皮肤没有一块好的。形容遍体都是伤。也比喻理由全部被驳倒，或被批评、责骂得很厉害。","source":{"text":"健及少遇祸乱，久从战阵，矢石所中，肌无完肤。","book":"《旧五代史·唐书·李健及传》"},"example":{"text":"他被人打得～。"},"similar":["体无完肤"],"usage":"作谓语、状语；用于被打或驳斥等"},{"id":37388,"word":"肌肉玉雪","pinyin":"jī ròu yù xuě","abbr":"jryx","explanation":"肌：肌肤。形容皮肤洁白细嫩，如雪如玉。","source":{"text":"姆抱幼子立侧，眉眼如画，发漆黑，肌肉玉雪，可念殿中君也。","book":"唐·韩愈《殿中少监马君墓志》"},"usage":"作定语；多用于女性"},{"id":37389,"word":"肘胁之患","pinyin":"zhǒu xié zhī huàn","abbr":"zxzh","explanation":"近在身边的祸患。同“肘腋之患”。","source":{"text":"明张差之事，殷鉴犹存，吾见上时必当极力言之，以除肘胁之患。","book":"清·昭梿《啸亭杂录·王文端》"},"similar":["肘腋之患","肘腋之忧"],"usage":"作主语、宾语；用于书面语"},{"id":37390,"word":"肘腋之下","pinyin":"zhǒu yè zhī xià","abbr":"zyzx","explanation":"肘腋：胳膊肘与胳肢窝。比喻切近的地方","source":{"text":"亮答曰：‘主公之在公安在，北畏曹公之疆，东惮孙权之逼，近则惧孙夫人生变于肘腋之下，正当斯这时，进退狼跋。","book":"晋·陈寿《三国志·蜀志·法正传》"},"usage":"作宾语；用于书面语"},{"id":37391,"word":"肘腋之变","pinyin":"zhǒu yè zhī biàn","abbr":"zyzb","explanation":"肘腋：胳膊肘和夹肢窝，比喻极近的地方。比喻产生于身边的祸患。","source":{"text":"近则惧孙夫人生变于肘腋之下。","book":"《三国志·蜀志·法正传》"},"example":{"text":"那共涛是个奸邪险恶的人，长防～。（清·陈忱《水浒后传》第十三回）"},"similar":["肘腋之患","肘腋之忧","肘胁之患"],"usage":"作主语、宾语；用于书面语"},{"id":37392,"word":"肘腋之忧","pinyin":"zhǒu yè zhī yōu","abbr":"zyzy","explanation":"肘腋：胳膊肘和夹肢窝，比喻极近的地方。比喻产生于身边的祸患。","source":{"text":"近则惧孙夫人生变于肘腋之下。","book":"《三国志·蜀志·法正传》"},"example":{"text":"倘此例他日踵行，亦～。","book":"明·沈德符《万历野获编·内臣兼掌印厂》"},"similar":["肘腋之患","肘胁之患","肘腋之变"],"usage":"作主语、宾语；用于书面语"},{"id":37393,"word":"肘腋之患","pinyin":"zhǒu yè zhī huàn","abbr":"zyzh","explanation":"肘腋：胳膊肘和夹肢窝，比喻极近的地方。产生于身边的祸患。","source":{"text":"近则惧孙夫人生变于肘腋之下。","book":"《三国志·蜀志·法正传》"},"example":{"text":"这是～，不若我们先下手驱除了他。","book":"清·陈忱《水浒后传》第五回"},"similar":["心腹之患","肘腋之忧"],"opposite":["疥癣之疾"],"usage":"作主语、宾语；形容产生于身旁的祸患"},{"id":37394,"word":"肘行膝步","pinyin":"zhǒu xíng xī bù","abbr":"zxxb","explanation":"匍匐前行，表示虔诚或哀戚。","source":{"text":"时有军卒，断左臂于佛前，以手执之，一步一礼，血流洒地，至于肘行膝步，啮指截发，不可算数。","book":"唐·苏鹗《杜阳杂编》卷下"},"example":{"text":"既葬，芦墓，日三时号泣，～，负土成坟。","book":"宋·王辟之《渑水燕谈录·忠孝》"},"usage":"作谓语、定语；用于书面语"},{"id":37395,"word":"肘见踵决","pinyin":"zhǒu xiàn zhǒng jué","abbr":"zjzj","explanation":"踵：脚后跟，伢指鞋后跟；决：裂开。整一整衣襟，胳臂肘露了出来，拔一拔鞋，脚后跟露了出来。形容非常贫穷。","source":{"text":"三日不举火，十年不制衣，正冠而缨绝，捉衿而肘见，纳屦而踵决。","book":"《庄子·让王》"},"example":{"text":"清·李绿园《歧路灯》第81回：“要之，鸡鱼降而为蔬，此即米珠薪桂之渐也；绸帛降而为布，那～之状，也就不远了。”"},"similar":["踵决肘见"],"usage":"作谓语、定语；指非常贫穷"},{"id":37396,"word":"肚束三篾","pinyin":"dù shù sān miè","abbr":"dssm","explanation":"篾：薄竹片，可编制成席子。用三根篾条勒住肚子。指勒紧腰带。比喻忍受饥饿，安于贫困。","source":{"text":"子之所得，可谓协于心体，布于四肢，既然如是，将三条篾束取肚皮，随处住山去。","book":"宋·释普济《五灯会元·药山维俨禅师》"}},{"id":37397,"word":"肚里打稿","pinyin":"dù lǐ dǎ gǎo","abbr":"dldg","explanation":"指心里暗算计，心里打算盘。","source":{"text":"谁知桂迁自见了施小官人之后，却也腹中打稿，要厚赠他母子回去。","book":"明·冯梦龙《警世通言》卷二十五"},"example":{"text":"王小二虽说秦客人住着好，～：见那几件行李，值不多银子，有一匹马，又是张口货。","book":"清·禇人获《隋唐演义》第七回"}},{"id":37398,"word":"肚里泪下","pinyin":"dù lǐ lèi xià","abbr":"dllx","explanation":"眼泪往肚里流。形容有苦说不出。","source":{"text":"每遇天日清美，侍上宴集，才一思之，肚里泪下。","book":"宋·叶绍翁《四朝见闻录》"},"example":{"text":"他只好在家～，忍气吞声了。"},"similar":["有苦难言"],"opposite":["一吐为快"],"usage":"作谓语、宾语；指有苦说不出"},{"id":37399,"word":"肚里生荆棘","pinyin":"dù lǐ shēng jīng jí","abbr":"dlsjj","explanation":"肚子里面生出荆棘。比喻心藏恶意或产生憎恶的情绪。","source":{"text":"虽笑未必和，虽哭未必戚，面结口头交，肚里生荆棘。","book":"唐·孟郊《择友》"}},{"id":37400,"word":"肚里蛔虫","pinyin":"dù lǐ huí chóng","abbr":"dlhc","explanation":"蛔虫因寄生在人的肠胃中，故用以比喻对别人的心里活动知道得十分清楚。","example":{"text":"她号称他的～，他的一举一动都不能瞒过她。"},"usage":"作宾语、定语；用于口语"},{"id":37401,"word":"肝心涂地","pinyin":"gān xīn tú dì","abbr":"gxtd","explanation":"犹言肝脑涂地。形容竭尽忠诚，任何牺牲都在所不惜","source":{"text":"臣万死骷骨，垂配蒙荣，载战载殒，肝心涂地。","book":"唐·陈子昂《谢衣表》"},"similar":["肝脑涂地"],"usage":"作谓语、定语；指人很忠心"},{"id":37402,"word":"肝心若裂","pinyin":"gān xīn ruò liè","abbr":"gxrl","explanation":"比喻极痛心。","source":{"text":"腾用伤悼，肝心若裂。","book":"《三国志·蜀书·诸葛亮传》"},"similar":["肝肠欲断"],"usage":"作谓语；指极痛心"},{"id":37403,"word":"肝肠寸断","pinyin":"gān cháng cùn duàn","abbr":"gccd","explanation":"肝肠一寸寸断开。比喻伤心到极点。","source":{"text":"吾要且死，子肠亦且寸绝。","book":"《战国策·燕策三》"},"example":{"text":"一时想起碑中记中薄命之话，再看看书香、秀英诸人前车之鉴，不由不毛骨悚然，～。","book":"清·李汝珍《镜花缘》第九十九回"},"similar":["心如刀割","五内如焚"],"opposite":["心花怒放","喜气洋洋"],"usage":"作谓语、定语；形容极其悲痛","story":["公元346年，晋将桓温率军上溯长江攻打蜀国，船进入三峡时，部将捉到一只小猿放到船上，母猿看到后心急如焚，沿岸奔跑，奋不顾身，跟着船队跑了100多里，在巫峡时竭尽全力跳到船上气绝身亡，剖开母猿，见其肝肠寸断，十分感"]},{"id":37404,"word":"肝肠寸裂","pinyin":"gān cháng cùn liè","abbr":"gccl","explanation":"肝脏与肠子好像被一寸一寸地断裂一样。形容万分悲痛。","source":{"text":"王英玛努埃闻之，肝肠寸裂，痛哭不食者三日。","book":"梁启超《意大利建国三杰传》第25节"},"similar":["肝肠寸断"],"usage":"作谓语、定语；形容极其悲痛"},{"id":37405,"word":"肝肠断绝","pinyin":"gān cháng duàn jué","abbr":"gcdj","explanation":"断绝：折断。肝脏与肠子好像被一寸一寸地断裂一样。形容万分悲痛。","source":{"text":"陇头流水，鸣声呜咽，遥望秦川，肝肠断绝。","book":"《古乐府·陇头歌辞》"},"similar":["肝肠寸断","肝肠寸裂"],"usage":"作谓语、定语；形容极其悲痛"},{"id":37406,"word":"肝胆披沥","pinyin":"gān dǎn pī lì","abbr":"gdpl","explanation":"犹言披肝沥胆。比喻极尽忠诚。","source":{"text":"食人之禄，不顾其患，非志士所忍出；当其发难，则亦慷慨悲歌，顾盼生姿，自谓肝胆披沥，不忘平生一诺。","book":"汤增璧《崇侠论》"},"similar":["披肝沥胆"],"usage":"作谓语、状语；指非常忠诚"},{"id":37407,"word":"肝胆楚越","pinyin":"gān dǎn chǔ yuè","abbr":"gdcy","explanation":"肝胆：比喻关系密切；楚越：春秋时两个诸侯国，虽土地相连，但关系不好。比喻有着密切关系的双方，变得互不关心或互相敌对。","source":{"text":"自其异者视之，肝胆楚越也。","book":"《庄子·德充符》"},"example":{"text":"爰造异论，～；惟同大观，万殊一辙。","book":"晋·卢谌《赠刘琨》"},"similar":["肝胆秦越"],"usage":"作谓语、定语；指虽近犹远"},{"id":37408,"word":"肝胆欲碎","pinyin":"gān dǎn yù suì","abbr":"gdys","explanation":"欲：将要。肝和胆将要破碎了。形容极度悲痛或非常生气。","example":{"text":"这事来得太突然，简直让她痛苦得～。"},"similar":["肝胆欲裂"],"usage":"作谓语、定语、状语；用于人的情绪"},{"id":37409,"word":"肝胆涂地","pinyin":"gān dǎn tú dì","abbr":"gdtd","explanation":"形容惨死。也形容竭尽忠诚，任何牺牲都在所不惜。同“肝脑涂地”。","source":{"text":"使食肉者一旦失计于庙堂之上，若臣等之藿食者宁得无肝胆涂地于中原之野？","book":"汉·刘向《说苑·善说》"},"example":{"text":"臣先殿上绝缨者也，当时宜以～，负日久矣。","book":"《韩诗外传》卷七"},"similar":["肝脑涂地"],"usage":"作谓语、定语；指人很忠心"},{"id":37410,"word":"肝胆照人","pinyin":"gān dǎn zhào rén","abbr":"gdzr","explanation":"肝胆：比喻真心诚意。比喻以真心相见。","source":{"text":"臣愿披腹心，输肝胆，效愚计，恐足下不能用也。","book":"《史记·淮阴侯列传》"},"example":{"text":"你又怎保得住你那东人父子，一定也象你这等肝胆相照人，一心向热地。","book":"清·文康《儿女英雄传》第十九回"},"similar":["肝胆相照"],"usage":"作谓语、宾语；指真心待人"},{"id":37411,"word":"肝胆相向","pinyin":"gān dǎn xiāng xiàng","abbr":"gdxx","explanation":"肝胆：比喻真诚的心。比喻对人忠诚，以真心相待。","source":{"text":"豪杰遇豪杰，自然话得投机，顷刻间肝胆相向。","book":"清·褚人获《隋唐演义》第37回"},"example":{"text":"清·荻岸山人《平山冷燕》第11回：“今日尔我既成至交，～，若再如前隐晦，便不是相知了。”"},"similar":["肝胆相见","肝胆相照"],"usage":"作谓语、定语；用于真诚相处"},{"id":37412,"word":"肝胆相照","pinyin":"gān dǎn xiāng zhào","abbr":"gdxz","explanation":"肝胆：比喻真心诚意。比喻以真心相见。","source":{"text":"同心相亲，照心照胆寿千春。","book":"《史记·淮阴侯列传》：“臣愿披腹心，输肝胆，效愚计，恐足下不能用也。”宋·赵令畸《侯鲭录》"},"example":{"text":"弟与公子以～，互相知心，故敢以实言相告。","book":"姚雪垠《李自成》第二卷第十八章"},"similar":["披肝沥胆"],"opposite":["勾心斗角","尔虞我诈"],"usage":"作谓语、定语；用于真诚相处"},{"id":37413,"word":"肝胆相见","pinyin":"gān dǎn xiāng jiàn","abbr":"gdxj","explanation":"肝胆：比喻真诚的心。比喻对人忠诚，以真心相待。","source":{"text":"大丈夫肝胆相见，脑袋也可以奉送。","book":"陆士谔《续孽海花》第34回"},"similar":["肝胆相照","肝胆相向"],"usage":"作谓语、定语；用于真诚相处"},{"id":37414,"word":"肝胆秦越","pinyin":"gān dǎn qín yuè","abbr":"gdqy","explanation":"肝胆：比喻亲近；秦越：秦国与越国，比喻对立或疏远。比喻虽近犹远，虽亲犹疏。","source":{"text":"我数百年来荡析离居、肝胆秦越之父子兄弟，今乃得以代议士之名誉，集兹一堂。","book":"梁启超《意大利建国三杰传》第26节"},"similar":["肝胆楚越","肝胆胡越"],"usage":"作谓语、定语；指虽近犹远"},{"id":37415,"word":"肝胆胡越","pinyin":"gān dǎn hú yuè","abbr":"gdhy","explanation":"犹言肝胆楚越。胡地在北，越地在南，比喻远隔。肝胆，比喻近。","source":{"text":"是故自其异者视之，肝胆胡越；自其同者视之，万物一圈也。","book":"《淮南子·俶真训》"},"similar":["肝胆楚越","肝胆秦越"],"usage":"作谓语、定语、宾语；指虽近犹远"},{"id":37416,"word":"肝胆轮囷","pinyin":"gān dǎn lún qūn","abbr":"gdlq","explanation":"轮囷：高大的样子。形容勇气过人，气魄雄大。","source":{"text":"穷途致感谢，肝胆还轮囷。","book":"唐·韩愈《赠别元十八协律六首》其四"},"example":{"text":"～，忠义奋发，挺孤身于百万虎狼之中，意定神闲，夷然无惧。","book":"宋·刘克庄《祭社于畊尚书文》"}},{"id":37417,"word":"肝胆过人","pinyin":"gān dǎn guò rén","abbr":"gdgr","explanation":"胆量超过一般人。比喻有勇气，有血性。","example":{"text":"他小小年纪就～，让人佩服。"},"usage":"作谓语、定语；用于夸奖人"},{"id":37418,"word":"肝脑涂地","pinyin":"gān nǎo tú dì","abbr":"gntd","explanation":"涂地：涂抹在地上。形容惨死。也形容竭尽忠诚，任何牺牲都在所不惜。","source":{"text":"大战七十，小战四十，使天下之民肝脑涂地，父子暴骨中野。","book":"《史记·刘敬书孙通列传》"},"example":{"text":"今得相随，大称平生，虽～，无恨矣。","book":"明·罗贯中《三国演义》第二十八回"},"similar":["马革裹尸","粉身碎骨","肝心涂地"],"usage":"作谓语、定语；指人很忠心","story":["汉高祖时，娄敬直截了当问刘邦在洛阳建都是不是想与周朝比一比盛况。刘邦点头应允。娄敬说：“你起兵丰沛，经历大小战争100多场，天下百姓肝脑涂地，尸横疆场，在洛阳建都是不合适的。建都长安则是易守难攻，百姓欢迎的。”"]},{"id":37419,"word":"肝髓流野","pinyin":"gān suǐ liú yě","abbr":"gsly","explanation":"形容战斗激烈残酷、尸横遍野。","source":{"text":"上奔播六年，中原之人，与贼肝髓流野，得复宗庙，遗老残民闻舆马音，流涕相欢。","book":"《旧唐书·萧瑀传》"}},{"id":37420,"word":"肠回气荡","pinyin":"cháng huí qì dàng","abbr":"chqd","explanation":"回：曲折，迂回；荡：摇荡。形容好的音乐、文章缠绵悱恻，感人极深的样子。","source":{"text":"这一首真是心颤魂飞、肠回气荡时做出来的好诗。","book":"苏雪林《玉溪诗谜》"},"similar":["荡气回肠"],"usage":"作谓语、定语；用于音乐、文章等"},{"id":37421,"word":"肠慌腹热","pinyin":"cháng huāng fù rè","abbr":"chfr","explanation":"形容焦急、慌乱。","source":{"text":"请法师唤太医疾快走，将俺养家儿搭救，则教我肠慌腹热。","book":"元·白朴《墙头马上》第三折：“魄散魂消，肠慌腹热，手脚獐狂去不迭。”元·郑廷玉《冤家债主》第二折"},"example":{"text":"唬得人胆战心摇，唬得人胆战心摇，～，魂飞魄散，早惊破月明花粲。","book":"清·洪昇《长生殿·惊变》"}},{"id":37422,"word":"肠肥脑满","pinyin":"cháng féi nǎo mǎn","abbr":"cfnm","explanation":"肠肥：指身体胖，肚子大；脑满：指肥头大耳。形容不劳而食的人吃得饱饱的，养得胖胖的。","source":{"text":"琅邪王年少，肠肥脑满，轻为举措。","book":"《北齐书·琅邪王俨传》"},"example":{"text":"有的又阔双矮，使你想起那些～的商人。","book":"叶圣陶《书的夜话》"},"similar":["养尊处优","脑满肠肥"],"usage":"作定语、状语；指不劳而获，无所用心","story":["南北朝时期，北齐武成帝高湛的三儿子琅邪王高俨企图夺取帝位，后主高纬便调兵捉拿，将军替高俨开脱说：“琅邪王年少，肠肥脑满，轻为举措，长大自不复然，愿宽其罪。”后主当场释放了高俨，不久就派人暗杀了他"]},{"id":37423,"word":"股战而栗","pinyin":"gǔ zhàn ér lì","abbr":"gzel","explanation":"战：怕；栗：发抖。两腿发抖，不停地哆嗦。形容恐惧异常。","source":{"text":"（魏勃）因退立，股战而栗，恐不能言者，终无它语。","book":"西汉·司马迁《史记·齐悼惠王世家》"},"example":{"text":"因退立，～。","book":"东汉·班固《汉书·高五王传》"},"similar":["胆战心惊","不寒而栗"],"usage":"作谓语；形容恐惧异常"},{"id":37424,"word":"股战胁息","pinyin":"gǔ zhàn xié xī","abbr":"gzxx","explanation":"战：发抖；胁：从腋下到腰上的部分。两腿发抖，屏住呼吸。形容恐惧异常。","source":{"text":"股战胁息，安敢妄攀。","book":"战国·楚·宋玉《高唐赋》"}},{"id":37425,"word":"股掌之上","pinyin":"gǔ zhǎng zhī shàng","abbr":"gzzs","explanation":"在大腿和手掌上面。比喻在操纵、控制的范围之内。","source":{"text":"大夫种勇而善谋，将还玩吴国于股掌之上，以得其志。","book":"《国语·吴语》"},"example":{"text":"救民水火之中，玩敌～。","book":"宋·葛胜仲《丹阳集·贺收复燕山府表》"},"similar":["股掌之间"],"usage":"作宾语；比喻在操纵控制范围之内"},{"id":37426,"word":"股掌之间","pinyin":"gǔ zhǎng zhī jiān","abbr":"gzzj","explanation":"在大腿和手掌之间。比喻在操纵、控制的范围之内。","source":{"text":"大夫种勇而善谋，将还玩吴国于股掌之上，以得其志。","book":"《国语·吴语》"},"example":{"text":"若以我之同类，何以独被人玩弄于～，宁不欲一申其自由耶？","book":"清·吴趼人《俏皮话·松鼠》"},"similar":["股掌之上"],"usage":"作宾语；比喻在操纵控制范围之内"},{"id":37427,"word":"股肱之力","pinyin":"gǔ gōng zhī lì","abbr":"ggzl","explanation":"股肱：大腿和胳膊。自己的所有力量。形容做事已竭尽全力。","source":{"text":"臣竭其股肱之力，加之以忠贞。其济，君之灵也；不济：则以死继之。","book":"春秋·鲁·左丘明《左传·僖公九年》"},"example":{"text":"今也卿大夫之所以竭～，殚其思虑之知。","book":"梁启超《墨学微》第一章"},"usage":"作宾语；形容做事已竭尽全力"},{"id":37428,"word":"股肱之臣","pinyin":"gǔ gōng zhī chén","abbr":"ggzc","explanation":"股：大腿；肱：手臂从肘到腕的部分。指辅佐帝王的重臣。比喻得力助手与亲信。","source":{"text":"但叔詹乃吾股肱之臣，岂可去孤左右？","book":"明·冯梦龙《东周列国志》第44回"},"similar":["股肱心腹","耳目心腹","股肱心膂"],"usage":"作宾语、定语；指助手与亲信"},{"id":37429,"word":"股肱心腹","pinyin":"gǔ gōng xīn fù","abbr":"ggxf","explanation":"股：大腿；肱：手臂从肘到腕的部分；心腹：亲信。指辅佐帝王的重臣。比喻得力助手与亲信。","source":{"text":"先生乃吾之股肱心腹，倘有疏虞，如之奈何？","book":"明·罗贯中《三国演义》第65回"},"similar":["耳目心腹","股肱心膂","股肱之臣"],"usage":"作宾语、定语；指助手与亲信"},{"id":37430,"word":"股肱心膂","pinyin":"gǔ gōng xīn lǚ","abbr":"ggxl","explanation":"股：大腿；肱：手臂从肘到腕的部分；心膂：亲信。指辅佐帝王的重臣。比喻得力助手与亲信。","source":{"text":"今命尔予翼，作股肱心膂。","book":"《尚书·君乐》"},"similar":["股肱心腹","股肱之臣","耳目心腹"],"usage":"作宾语、定语；指助手与亲信"},{"id":37431,"word":"股肱耳目","pinyin":"gǔ gōng ěr mù","abbr":"ggem","explanation":"股：大腿；肱：手臂。旧时指鼎力辅佐帝王的大臣。现比喻十分亲近的办事得力的人。","source":{"text":"臣作朕股肱耳目。","book":"《尚书·益稷》"},"example":{"text":"明公以～之重臣，膺兹简命。","book":"明·归有光《论御倭书》"},"similar":["得力助手"],"usage":"作主语、宾语；指得力助手"},{"id":37432,"word":"股肱腹心","pinyin":"gǔ gōng fù xīn","abbr":"ggfx","explanation":"股：大腿；肱：手臂从肘到腕的部分。指辅佐帝王的重臣。比喻得力助手与亲信。","source":{"text":"倘国法、官体、狱情必应如此，则一下吏为之有余，何必老大人为股肱腹心耶？","book":"清·名教中人《好逑传》第14回"},"similar":["股肱心腹","耳目心腹","股肱心膂"],"usage":"作宾语、定语；指助手与亲信"},{"id":37433,"word":"肤不生毛","pinyin":"fū bù shēng máo","abbr":"fbsm","explanation":"皮肤上长满了茧，连毛也长不出来。形容十分劳苦。","source":{"text":"心烦于虑，而身亲其劳。躬腠胝无胈，肤不生毛。","book":"汉·司马相如《难蜀父老文》"},"example":{"text":"劳动者经常是～，浑身长满了老茧"},"usage":"作谓语、定语；用于劳动者"},{"id":37434,"word":"肤受之愬","pinyin":"fū shòu zhī xiāng","abbr":"fszs","explanation":"指谗言。肤受，指浮泛不实，或指利害切身。","source":{"text":"浸润之谮，肤受之愬，不行焉，可谓远也已矣。","book":"春秋·鲁·孔丘《论语·颜渊》"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第十回：“你想外国人又不是包龙图，况且又不懂中国话，自然中了他的‘～’了。”"},"similar":["肤受之诉"],"usage":"作宾语、定语；用于书面语"},{"id":37435,"word":"肤受之言","pinyin":"fū shòu zhī yán","abbr":"fszy","explanation":"肤：肤浅；受：感受。指肤浅的，使人感受不深的言论。也指不切合实际的言辞。","source":{"text":"风景之赏未甄，肤受之言互及。","book":"《后汉书·杨璇传论》"},"usage":"作主语、宾语；用于说话"},{"id":37436,"word":"肤受之诉","pinyin":"fū shòu zhī sù","abbr":"fszs","explanation":"比喻被人说了有关切身利益的坏话。","source":{"text":"浸润之谮，肤受之诉，不行焉，可谓远也已矣。","book":"《论语·颜渊》"},"example":{"text":"你想外国人又不是包龙图，况且又不懂中国话，自然中了他的“～”了。","book":"清·吴趼人《二十年目睹之怪现状》第十回"},"similar":["肤受之愬"],"usage":"作宾语、定语；用于书面语"},{"id":37437,"word":"肤如凝脂","pinyin":"fū rú níng zhī","abbr":"frnz","explanation":"皮肤象凝固的脂。形容皮肤洁白且细腻。","source":{"text":"手如柔荑，肤如凝脂。","book":"《诗经·卫风·硕人》"},"usage":"作谓语、定语；多用于女性"},{"id":37438,"word":"肤寸之地","pinyin":"fū cùn zhī dì","abbr":"fczd","explanation":"肤寸：古代长度单位，1肤＝4寸。指面积狭小的土地。","source":{"text":"肤寸之地无得者，岂齐不欲地哉？形弗能有也。","book":"西汉·刘向《战国策·秦策》"},"similar":["尺寸之地"],"usage":"作主语、宾语；指面积狭小的土地"},{"id":37439,"word":"肤寸而合","pinyin":"fū cùn ér hé","abbr":"fceh","explanation":"肤寸：古代长度单位，一指的宽度为寸，一肤等于四寸。形容云气密集。","source":{"text":"触石而出，肤寸而合，不崇朝而遍雨乎天下者，唯泰山尔。","book":"《公羊传·僖公三十一年》"},"example":{"text":"俄而云气上蒸，～，比至日中，大雨总至，溪涧盈溢。","book":"宋·李昉《太平御览》"},"usage":"作谓语；用于天气等"},{"id":37440,"word":"肤末支离","pinyin":"fū mò zhī lí","abbr":"fmzl","explanation":"肤浅琐碎。","source":{"text":"彼言涉于道，多肤末支离，而无所归宿。","book":"清·方苞《书柳文后》"},"example":{"text":"这是我的～的看法，希望能得以重视。"},"usage":"作谓语、定语；指肤浅琐碎"},{"id":37441,"word":"肤泛不切","pinyin":"fū fàn bù qiè","abbr":"ffbq","explanation":"肤：肤浅；泛：一般；不切：不切合实际。指文章或言论没有深刻切实的内容。"},{"id":37442,"word":"肤浅末学","pinyin":"fū qiǎn mò xué","abbr":"fqmx","explanation":"肤浅：浅薄；末学：学无根底。指学识浅薄。","source":{"text":"释《谷梁传》者，虽近十家，皆肤浅末学，不经师匠。","book":"晋·范宁《春秋梁传集解序》"},"similar":["末学肤受"],"usage":"作宾语、定语；指学识浅薄"},{"id":37443,"word":"肤皮潦草","pinyin":"fū pǐ liǎo cǎo","abbr":"fplc","explanation":"形容不扎实，不仔细。","example":{"text":"我们不喜欢他的这种～的办事作风。"},"similar":["浮皮潦草"],"usage":"作谓语、定语；指不认真"},{"id":37444,"word":"肤粟股栗","pinyin":"fū sù gǔ lì","abbr":"fsgl","explanation":"皮肤上起疙瘩，大腿发抖。形容非常恐惧。","source":{"text":"夫至以行恶为荣，则洪水猛兽，足喻斯惨耶？君子念此，肤粟股栗矣。","book":"梁启超《新民说·论私德》"},"usage":"作谓语、定语、状语；用于恐惧时"},{"id":37445,"word":"肤见謭识","pinyin":"fū jiàn guǎng shí","abbr":"fjjs","explanation":"浅陋的见识。"},{"id":37446,"word":"肤见谫识","pinyin":"fū jiàn jiǎn shí","abbr":"fjjs","explanation":"浅陋的见识。","source":{"text":"明·李东阳《〈琼台吟稿〉序》；“彼肤见谫识，管窥蠡测，岂复能尽其妙哉？”"},"similar":["一孔之见","门户之见"],"opposite":["远见卓识"],"usage":"作主语、宾语、定语；用于自谦等"},{"id":37447,"word":"肥冬瘦年","pinyin":"féi dōng shòu nián","abbr":"fdsn","explanation":"南宋吴地风俗多重冬至而略岁节，冬至时家家互送节物，有“肥冬瘦年”之谚。见宋无名氏《豹隐纪谈》、宋范成大《吴郡志·风俗》。"},{"id":37448,"word":"肥吃肥喝","pinyin":"féi chī féi hē","abbr":"fcfh","explanation":"放肆地大吃大喝。","example":{"text":"～对身体健康不利。"},"similar":["湖吃海喝"],"usage":"作主语、宾语、定语；指大吃大喝"},{"id":37449,"word":"肥头大耳","pinyin":"féi tóu dà ěr","abbr":"ftde","explanation":"一个肥胖的脑袋，两只大耳朵。形容体态肥胖，有时指小孩可爱。","source":{"text":"看上去有七八岁光景，倒生的肥头大耳。","book":"清·李宝嘉《官场现形记》第22回"},"example":{"text":"猪八戒～，贪吃贪睡。"},"similar":["憨态可居","肥头胖耳"],"opposite":["瘦小干枯","尖嘴猴腮"],"usage":"作定语、宾语；指人的长相"},{"id":37450,"word":"肥头大面","pinyin":"féi tóu dà miàn","abbr":"ftdm","explanation":"形容体态肥胖，有时指小孩可爱。同“肥头大耳”。","source":{"text":"汝肥头大面，不识今古。噇，食无意智，不作宰相而何！","book":"《太平广记》卷二百六十引隋·侯白《启颜录·殷安》"},"similar":["肥头大耳","肥头胖耳"],"usage":"作定语、宾语；指人的长相"},{"id":37451,"word":"肥头胖耳","pinyin":"féi tóu pàng ěr","abbr":"ftpe","explanation":"形容体态肥胖，有时指小孩可爱。同“肥头大耳”。","source":{"text":"识宝太师的女儿，叫做畔方小姐，生得肥头胖耳，粗手大脚。","book":"《何典》第八回"},"example":{"text":"钱钟书《围城》：“做诗的人似乎不宜～，诗怕不会好。”"},"similar":["肥头大面","肥头大耳"],"usage":"作定语、宾语；指人的长相"},{"id":37452,"word":"肥水不落外人田","pinyin":"féi shuǐ bù luò wài rén tián","abbr":"fsblwrt","explanation":"肥水：借指好处。指不让别人得到好处。","source":{"text":"那天他同我谈，说要开药店。原来‘肥水不落外人田’。","book":"高阳《胡雪岩全传·灯火楼台》"},"example":{"text":"～，他是典型的自私鬼。"},"similar":["自私自利","肥水不落旁人田"],"usage":"作宾语、定语、分句；指人自私"},{"id":37453,"word":"肥水不落旁人田","pinyin":"féi shuǐ bù luò páng rén tián","abbr":"fsblprt","explanation":"肥水：借指好处。指不让别人得到好处。","example":{"text":"俗话说：～，他够抠门的了。"},"similar":["肥水不落外人田"],"usage":"作宾语、定语、分句；指人自私"},{"id":37454,"word":"肥甘轻暖","pinyin":"féi gān qīng nuǎn","abbr":"fgqn","explanation":"指生活优裕。","source":{"text":"为肥甘不足於口与？轻暖不足於体与？","book":"语出《孟子·梁惠王上》"},"example":{"text":"如梁襄王，算定天下不能一，便只向～中了一生。","book":"清·王夫之《读四书大全说·孟子·梁惠王上篇十四》"},"usage":"作宾语、定语；用于生活"},{"id":37455,"word":"肥田沃地","pinyin":"féi tián wò dì","abbr":"ftwd","explanation":"肥沃的土地。","source":{"text":"在这个广大的领土之上，有广大的肥田沃地，给我们以衣食之源。","book":"毛泽东《中国革命和中国共产党》"},"opposite":["不毛之地"],"usage":"作主语、宾语、定语；用于农业等"},{"id":37456,"word":"肥皂泡","pinyin":"féi zào pāo","abbr":"fzp","explanation":"指肥皂水吹起的气泡。比喻一触即破的事物或经不起推敲的东西。","source":{"text":"承那王主任笔下吹嘘，自己也被吹成一个大肥皂泡，未破时五光十色，经不起人一搠就不知去向。","book":"钱钟书《围城》"},"usage":"作宾语、定语；多用于比喻句"},{"id":37457,"word":"肥肉厚酒","pinyin":"féi ròu hòu jiǔ","abbr":"frhj","explanation":"厚：浓味，指淳正。肥美的肉，味浓淳正的酒。比喻美好丰盛的饮食。","source":{"text":"肥肉厚酒，务以相强。","book":"《吕氏春秋·本生》"},"similar":["肥肉大酒","大鱼大肉","厚酒肥肉"],"usage":"作主语、宾语、定语；用于生活"},{"id":37458,"word":"肥肉大酒","pinyin":"féi ròu dà jiǔ","abbr":"frdj","explanation":"肥：富饶，富足；大酒：美酒。指美好丰盛的饮食。","source":{"text":"费心姑息是一役，肥肉大酒徒相要。","book":"唐·杜甫《严氏溪放歌》"},"similar":["肥肉厚酒","肥鱼大肉","大鱼大肉"],"usage":"作主语、宾语、定语；用于生活"},{"id":37459,"word":"肥肠满脑","pinyin":"féi cháng mǎn nǎo","abbr":"fcmn","explanation":"形容不劳而食的人吃得很饱，养得很胖。同“脑满肠肥”。","source":{"text":"酒楼废而茶园兴，岂肥肠满脑者，餍饫既深，亦思乞灵于七碗耶？","book":"清·捧花生《画舫馀谭》"},"similar":["脑满肠肥"],"opposite":["骨瘦如柴"],"usage":"作谓语、定语、补语；指人肥胖丑陋的形象"},{"id":37460,"word":"肥遁鸣高","pinyin":"féi dùn míng gāo","abbr":"fdmg","explanation":"退隐不做官，自以为清高。","source":{"text":"上九，肥遁，无不利。","book":"《周易·遁》"},"example":{"text":"昨儿听先生鄙薄那～的人，说道：天地生才有限，不宜妄自菲薄。","book":"清·刘鹗《老残游记》第六回"},"similar":["自命清高"],"usage":"作谓语；指自命清高"},{"id":37461,"word":"肥遯鸣高","pinyin":"féi dùn míng gāo","abbr":"fdmg","explanation":"退隐避世，自鸣清高。"},{"id":37462,"word":"肥醲甘脆","pinyin":"féi nóng gān cuì","abbr":"fngc","explanation":"醲：指酒性浓烈；甘脆：美味。味美的食物。泛指美好的酒食。","source":{"text":"肥醲甘脆，非不美也，然民有糟糠、菽、粟不接于口者，则明主弗甘也。","book":"西汉·刘安《淮南子·主术训》"},"similar":["甘脆肥醲"],"usage":"作谓语、定语；用于生活"},{"id":37463,"word":"肥马轻裘","pinyin":"féi mǎ qīng qiú","abbr":"fmqq","explanation":"裘：皮衣。骑肥壮的马，穿轻暖的皮衣。形容阔绰。","source":{"text":"赤之适齐也，乘肥马，衣轻裘。","book":"《论语·雍也》"},"example":{"text":"家业家私，待你六亲；～，待你一身，倒贴了奁房和你为眷姻。","book":"元·关汉卿《救风尘杂剧》第三折"},"similar":["腰缠万贯","积玉堆金","富埒王侯"],"opposite":["家徒四壁","一贫如洗","衣衫褴褛"],"usage":"作谓语、定语；指有钱人"},{"id":37464,"word":"肥鱼大肉","pinyin":"féi yú dà ròu","abbr":"fydr","explanation":"指丰盛的鱼肉菜肴。","source":{"text":"黄通理果然叫他妻子办了两席家常便饭，免不得肥鱼大肉，十分丰盛。","book":"清·颐琐《黄绣球》第一回"},"example":{"text":"清·吴趼人《二十年目睹之怪现状》第19回：“登时叫人调排桌椅，摆了八席，让众人坐下，暖上酒来，～的都搬上来。”"},"similar":["肥肉厚酒","大鱼大肉"],"usage":"作主语、宾语、定语；用于生活"},{"id":37465,"word":"肩不能挑，手不能提","pinyin":"jiān bù néng tiāo，shǒu bù néng tí","abbr":"jbntsbnt","explanation":"不会挑担子，也拿不动什么东西。形容缺乏劳动锻炼的人。","source":{"text":"那老者定睛把子路上下一看道：‘客官，我看你：肩不能挑，手不能提，识不得芝麻，辨不得菉豆。谁是你的夫子！'","book":"清·李汝珍《镜花缘》第八十三回"},"example":{"text":"［吴定］年岁渐长，奈何家业日逐凋零，只因他命里注定是个乞儿。如何撑架得住？到了二十余岁，～，只得奉了母亲往他乡外府。","book":"《豆棚闲话·小乞儿真心孝义》"}},{"id":37466,"word":"肩从齿序","pinyin":"jiān cóng chǐ xù","abbr":"jccx","explanation":"并肩相从，依年齿以序长幼。指僚友交游。","source":{"text":"修本愚无似，固不足以希执友之游；然而群居平日，幸得肩从齿序，跪拜起居，窃兄弟行。","book":"宋·欧阳修《与员外书》"},"usage":"作宾语、定语；用于书面语"},{"id":37467,"word":"肩劳任怨","pinyin":"jiān láo rèn yuàn","abbr":"jlry","explanation":"犹任劳任怨。不怕吃苦，也不怕招怨。"},{"id":37468,"word":"肩摩毂击","pinyin":"jiān mó gǔ jī","abbr":"jmgj","explanation":"肩膀和肩膀相摩，车轮和车轮相撞。形容行人车辆往来拥挤。","source":{"text":"临淄之途，车毂击，人肩摩。","book":"《战国策·齐策一》"},"example":{"text":"只见这弄堂里面，熙来攘往，～，那出进的轿子，更觉络绎不绝。","book":"清·李宝嘉《官场现形记》第八回"},"similar":["肩摩毂接"],"usage":"作宾语、定语；形容行人车辆往来拥挤"},{"id":37469,"word":"肩摩毂接","pinyin":"jiān mó gū jiē","abbr":"jmgj","explanation":"肩相摩，毂相接。本形容行人车辆拥挤，后亦借指人才辈出，络绎不绝。","source":{"text":"梁自武帝好学，诸子彬彬继之，故博洽之士弥众……肩摩毂接，竞爽一时，殆古今所罕也。","book":"明·胡应麟《少室山房笔丛·华阳博议上》"},"similar":["肩摩毂击"],"usage":"作宾语、定语；形容行人车辆往来拥挤"},{"id":37470,"word":"肩摩袂接","pinyin":"jiān mó mèi jiē","abbr":"jmmj","explanation":"人肩相摩，衣袖相接。形容人多拥挤。","source":{"text":"余自近岁以来，为求文者肩摩袂接而至，一切谢绝已久。","book":"明·宋濂《赠传神陈德颜序》"},"similar":["肩摩踵接"],"usage":"作谓语、定语；用于人多"},{"id":37471,"word":"肩摩踵接","pinyin":"jiān mó zhǒng jiē","abbr":"jmzj","explanation":"肩碰肩，脚连脚。形容人很多，很拥挤。","source":{"text":"入城，宣布德意，不戮一人，中原归附者踵接。","book":"《战国策·齐策一》：“临淄之途，车毂击，人肩摩。”《宋史·李显忠传》"},"example":{"text":"平常是异常清静的街面，到这时候两边的街檐便成为～的市场了。","book":"郭沫若《少年时代·我的童年》"},"similar":["挨肩接踵","踵接肩摩"],"opposite":["地广人稀"],"usage":"作宾语、定语；形容行人拥挤"},{"id":37472,"word":"肩背相望","pinyin":"jiān bèi xiāng wàng","abbr":"jbxw","explanation":"指相继而起，连续不断。","source":{"text":"今夫旦中之医，弟与悔木标榜而起，贵邑中不乏肩背相望。","book":"清·黄宗羲《与李杲堂陈介眉书》"},"example":{"text":"窃怪二千年来，通人大儒，～，而咸为瞀惑，无一人焉发奸露覆，雪先圣之沉冤，出诸儒于云雾者。","book":"康有为《〈新学伪经考〉序》"},"usage":"作谓语、定语；用于比喻句"},{"id":37473,"word":"肩背难望","pinyin":"jiān bèi nán wàng","abbr":"jbnw","explanation":"指难以相比，难以企及。","source":{"text":"则尤簪缨世胄，肩背难望者矣！","book":"清·陈康祺《郎潜纪闻》第七卷"},"usage":"作定语；指难以相比"},{"id":37474,"word":"肩负重任","pinyin":"jiān fù zhòng rèn","abbr":"jfzr","explanation":"担当重要工作或任务。","example":{"text":"青年人～。"},"usage":"作谓语、定语；指人的使命等"},{"id":37475,"word":"肮肮脏脏","pinyin":"āng āng zāng zāng","abbr":"aazz","explanation":"不干净。比喻卑鄙、丑恶","source":{"text":"而且黑颜料染得很不均匀，给人一种肮肮脏脏的感觉。","book":"路遥《平凡的世界》第一卷第一章"},"opposite":["干干净净"],"usage":"作定语、状语；用于口语"},{"id":37476,"word":"肯堂肯构","pinyin":"kěn táng kěn gòu","abbr":"ktkg","explanation":"堂：立堂基；构：盖屋。原意是儿子连房屋的地基都不肯做，哪里还谈得上肯盖房子。后反其意而用之，比喻儿子能继承父亲的事业。","source":{"text":"以作室喻治政也。父已致法，子乃不肯为堂基，况肯构主屋乎？","book":"《尚书·大诰》"},"example":{"text":"祖父遗书读未成，～夫何有？（清·查慎行《传经堂歌卓次厚属赋》）"},"similar":["肯构肯堂"],"usage":"作谓语、宾语；比喻子能继承父业"},{"id":37477,"word":"肯构肯堂","pinyin":"kěn gòu kěn táng","abbr":"kgkt","explanation":"堂：立堂基；构：盖屋。原意是儿子连房屋的地基都不肯做，哪里还谈得上肯盖房子。后反其意而用之，比喻儿子能继承父亲的事业。","source":{"text":"以作室喻治政也。父已致法，子乃不肯为堂基，况肯构主屋乎？","book":"《尚书·大诰》"},"example":{"text":"家有严君，斯多贤子。～，流誉奕世。","book":"明·东鲁古狂生《醉醒石》第七回"},"similar":["肯堂肯构"],"usage":"作谓语、宾语；比喻子能继承父业"},{"id":37478,"word":"肺石风清","pinyin":"fèi shí fēng qīng","abbr":"fsfq","explanation":"百姓可以站在上面控诉地方官。比喻法庭裁判公正。","source":{"text":"凡远近惸独老幼之欲有复于上而其长弗达者，立于肺石三日，士听其辞，以告于上而罪其长。","book":"《周礼·秋官·大司寇》"},"example":{"text":"下无冤枉之民，～。","book":"《成语故事考·讼狱》"},"usage":"作宾语；指裁判公正"},{"id":37479,"word":"肺肝如见","pinyin":"fèi gān rú jiàn","abbr":"fgrj","explanation":"肺肝：指内心思想或打算；如见：象看到一样。象看到内心打算一样。比喻心思和谋略全部被别人看出。","source":{"text":"当时之攻心法者，其肺肝如见矣。","book":"清·梁启超《王荆公传》第十章"},"example":{"text":"殊不知～，事实俱在，欲盖弥彰。","book":"蔡东藩、许廑父《民国通俗演义》第一百三十一回"},"similar":["如见肺肝"],"usage":"作宾语；用于心机等"},{"id":37480,"word":"肺腑之言","pinyin":"fèi fǔ zhī yán","abbr":"ffzy","explanation":"肺腑：指内心。出于内心的真诚的话。","source":{"text":"肺腑都无隔，形骸两不羁。","book":"唐·白居易《代书诗一百韵寄微之》"},"example":{"text":"他了他这一番～，使我们陷入了沉思之中。"},"similar":["由衷之言"],"opposite":["违心而论"],"usage":"作主语、宾语；与“一番”连用"},{"id":37481,"word":"肺腑之谈","pinyin":"fèi fǔ zhī tán","abbr":"ffzt","explanation":"肺腑：内心。发自内心的真诚的话。","source":{"text":"我东人曾说，倘得见面，命我……替他竭诚拜谢，还有许多肺腑之谈。","book":"清·文康《儿女英雄传》第17回"},"similar":["肺腑之言"],"usage":"作主语、宾语；用于口语"},{"id":37482,"word":"胁不沾席","pinyin":"xié bù zhān xí","abbr":"xbzx","explanation":"形容佛教徒勤苦修行。","source":{"text":"语出波栗湿缚尊者（胁尊者）勤修苦行，终不以胁至席的故事。见唐玄奘《大唐西域记·健驮逻国》。"},"usage":"作宾语、定语；用于书面语"},{"id":37483,"word":"胁从罔治","pinyin":"xié cóng wǎng zhì","abbr":"xcwz","explanation":"罔治：不治罪。被迫跟从别人犯罪的，可以不予处治。","source":{"text":"歼厥渠魁，胁从罔治。","book":"《尚书·胤征》"},"usage":"作宾语、定语；用于处事"},{"id":37484,"word":"胁肩低眉","pinyin":"xié jiān dī méi","abbr":"xjdm","explanation":"缩着肩膀，低着眉头。形容在人面前卑下的神情。","source":{"text":"虽器不益于旦夕之用，才不周于立朝之俊，不亦愈于胁肩低眉，谄媚权右。","book":"《抱朴子·逸民》"},"similar":["胁肩谄笑","胁肩低首"],"opposite":["刚正不阿"],"usage":"作谓语、定语；指逢迎的样子"},{"id":37485,"word":"胁肩低首","pinyin":"xié jiān dī shǒu","abbr":"xjds","explanation":"形容在人面前卑下的神情。同“胁肩低眉”。","source":{"text":"功义如此，尚见疑于上，胁肩低首，累足抚衿。","book":"宋·司马光《资治通鉴·汉景帝前三年》"},"similar":["胁肩低眉"],"usage":"作谓语、定语；指逢迎的样子"},{"id":37486,"word":"胁肩累足","pinyin":"xié jiān lěi zú","abbr":"xjlz","explanation":"胁肩：耸起肩膀；累足：并着双脚。缩着肩膀，重迭着脚（不敢正立）。形容恐惧的样子。","source":{"text":"尝患见疑，无以自白。今胁肩累足，犹惧不见释。","book":"《史记·吴王濞传》"},"example":{"text":"～，犹惧不见释。","book":"《资治通鉴·汉纪·景帝三年》"},"usage":"作谓语、定语；指恐惧"},{"id":37487,"word":"胁肩絫足","pinyin":"xié jiān lèi zú","abbr":"xjlz","explanation":"形容恐惧的样子。同“胁肩累足”。"},{"id":37488,"word":"胁肩谄笑","pinyin":"xié jiān chǎn xiào","abbr":"xjcx","explanation":"胁肩：耸起双肩做出恭谨的样子；谄笑：装出奉承的笑容。为了奉承人，缩起肩膀装出笑脸。形容巴结人的丑态。","source":{"text":"胁肩谄笑，病于夏畦。","book":"《孟子·滕文公下》"},"example":{"text":"那些人让他是个现任刺史，～随他怠慢。","book":"明·凌濛初《初刻拍案惊奇》卷二十二"},"similar":["摇尾乞怜","曲意逢迎"],"opposite":["刚正不阿","守正不挠"],"usage":"作谓语、定语；指逢迎的样子"},{"id":37489,"word":"胆丧心惊","pinyin":"dǎn sàng xīn jīng","abbr":"dsxj","explanation":"形容内心盐分惊慌恐惧。","source":{"text":"袁绍父子胆丧心惊，奔入旧寨。","book":"明·罗贯中《三国演义》第三十一回"},"example":{"text":"北兵因高平一败，～。","book":"清·吴璿《飞龙全传》第四十八回"}},{"id":37490,"word":"胆丧魂惊","pinyin":"dǎn sàng hún jīng","abbr":"dshj","explanation":"形容极度害怕、恐慌。","source":{"text":"任你铜筋铁骨的好汉，到此也胆丧魂惊，不知断送了多少忠臣义士！","book":"《醒世恒言·李汧公穷邸遇侠客》"},"similar":["胆裂魂飞"],"opposite":["神色自若"],"usage":"作状语；指害怕"},{"id":37491,"word":"胆丧魂消","pinyin":"dǎn sàng hún xiāo","abbr":"dshx","explanation":"形容极度害怕、恐慌。","source":{"text":"雄威纠纠杀金酋，已教胆丧魂消，他弃甲潜逃，从此边疆不再无忧。","book":"明·无名氏《精忠记·班师》"},"example":{"text":"明·无名氏《杨家将演义》第七卷：“及见侬王被围，营营～。”"},"similar":["魂飞魄散","胆丧魂惊"],"opposite":["神色不惊","镇定自若"],"usage":"作谓语、定语；指十分害怕"},{"id":37492,"word":"胆壮心雄","pinyin":"dǎn zhuàng xīn xióng","abbr":"dzxx","explanation":"形容胆子大，有雄心，做事无所畏惧。","source":{"text":"十七十八正年青，当兵就要当红军，胆壮心雄志愿大，红军到处受欢迎。","book":"《中国歌谣资料·当兵要当红军》"},"similar":["胆大心雄"],"usage":"作谓语、定语；形容做事无所畏惧"},{"id":37493,"word":"胆壮气粗","pinyin":"dǎn zhuàng qì cū","abbr":"dzqc","explanation":"形容胆大气盛，无所畏惧。","source":{"text":"我们师长是一位优秀的指挥员，有他指挥我们打仗，我们心里特别踏实，胆壮气粗。","book":"袁静《不可战胜的力量》"},"similar":["胆粗气壮"],"usage":"作谓语、定语、状语；指胆大"},{"id":37494,"word":"胆大于身","pinyin":"dǎn dà yú shēn","abbr":"ddys","explanation":"犹言胆大如斗。指无所忌惮。","source":{"text":"臣观其胆，乃大于身，鼻息所冲，上拂云汉。","book":"语出《旧唐书·李昭德传》载丘愔劾奏李昭德语"},"similar":["胆大包天"],"opposite":["胆小如鼠"],"usage":"作谓语、定语；用于人的胆识"},{"id":37495,"word":"胆大包天","pinyin":"dǎn dà bāo tiān","abbr":"ddbt","explanation":"包：包容。形容胆子极大。","source":{"text":"因此上胆大包天，一铁锺，几乎把秦王断送。","book":"清·杨潮观《吟风阁杂剧·黄石婆授计逃关》"},"example":{"text":"我虽年幼，～，小小秦庭，何足道哉。","book":"欧阳予倩《荆轲》第四幕"},"similar":["胆大包身","肆无忌惮","胆大妄为"],"opposite":["胆小如鼠","胆小怕事"],"usage":"作谓语、宾语、定语；形容胆子极大"},{"id":37496,"word":"胆大包身","pinyin":"dǎn dà bāo shēn","abbr":"ddbs","explanation":"胆比整个身体都大。形容胆量极大，无所畏惧。","source":{"text":"臣观其胆，乃大于身，鼻息所冲，上拂云汉。","book":"《旧唐书·李昭德传》"},"example":{"text":"你口快便施恩，则除是胆大自包身。我其实精皮肤捱不过那批头棍。","book":"元·郑庭玉《包龙图智勘后花园》第一折"}},{"id":37497,"word":"胆大如斗","pinyin":"dǎn dà rú dǒu","abbr":"ddrd","explanation":"斗：旧时的一种量器，容量为十升。胆子象斗一样大。形容胆量极大。","source":{"text":"维死时见剖，胆如斗大。","book":"《三国志·蜀志·姜维传》：“维妻子皆伏诛。”裴松之注引《世语》"},"example":{"text":"张拥兵海上，一夕大风雨，张舟覆，翌年获尸，棺殓焚化，～不能焚，诸军憾恸。","book":"清·阮葵生《茶余客话》卷二十一"},"similar":["胆大包天"],"opposite":["胆小怕事","胆小如鼠"],"usage":"作谓语、状语；指胆大","story":["三国时期，魏军大举进攻蜀国，姜维放弃阴平而退守剑阁，钟会劝姜维投降。姜维坚决拒绝。蜀亡后，钟会暗地里谋划背叛魏国。姜维认为这是复兴汉室的机会，为他出谋划策，事败被魏军所杀，剖开其肚，见其胆大如斗"]},{"id":37498,"word":"胆大妄为","pinyin":"dǎn dà wàng wéi","abbr":"ddww","explanation":"妄为：胡搞，乱做。毫无顾忌地干坏事。","source":{"text":"这种人要在敝国，是早已明正典刑，哪里容他们如此胆大妄为呢。","book":"清·曾朴《孽海花》第十回"},"example":{"text":"说他擅卖矿产，～，请旨拿交刑部治罪。","book":"清·李宝嘉《官场现形记》第五十三回"},"similar":["胆大包天","无所顾忌","为所欲为"],"opposite":["胆小如鼠","胆小怕事","缩手缩脚"],"usage":"作主语、谓语、状语；指毫无顾忌地干坏事"},{"id":37499,"word":"胆大心小","pinyin":"dǎn dà xīn xiǎo","abbr":"ddxx","explanation":"形容办事果断，考虑周密。","source":{"text":"胆欲大而心欲小，智欲圆而行欲方。","book":"《旧唐书·孙思邈传》"},"similar":["胆大心细"],"usage":"作谓语、定语；用于办事"},{"id":37500,"word":"胆大心粗","pinyin":"dǎn dā xīn cū","abbr":"ddxc","explanation":"做事胆子在，但心粗。考虑不周全。","source":{"text":"扑咚咚阶下升衙鼓，唬得我手忙脚乱，使不得胆大心粗。","book":"元·关汉卿《蝴蝶梦》第二折"},"example":{"text":"兀的是谁家一个匹夫，畅好是～。","book":"元·石德玉《秋胡戏妻》第三折"},"opposite":["胆大心细"],"usage":"作谓语、定语；指做事不周全"}]
