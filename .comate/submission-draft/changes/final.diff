diff --git a/feature/goods/src/main/ets/component/GoodsCommentItem.ets b/feature/goods/src/main/ets/component/GoodsCommentItem.ets
new file mode 100644
index 0000000000000000000000000000000000000000..c05b599740ec7e2f70258248e5255008b5631d69
--- /dev/null
+++ b/feature/goods/src/main/ets/component/GoodsCommentItem.ets
@@ -0,0 +1,170 @@
+import { P100, SpaceHorizontalMedium, SpaceVerticalXSmall } from "designsystem";
+import { Comment } from "model";
+import { NetWorkImage } from "ui";
+
+/**
+ * 评价缩略图尺寸（vp）
+ */
+const THUMB_SIZE: number = 72;
+/**
+ * 最大星级
+ */
+const MAX_STAR: number = 5;
+
+/**
+ * @file 商品评价条目组件
+ */
+@ComponentV2
+export struct GoodsCommentItem {
+  /**
+   * 评价数据
+   */
+  @Param
+  comment: Comment = new Comment();
+  /**
+   * 条目序号（用于生成稳定 id）
+   */
+  @Param
+  index: number = 0;
+  /**
+   * 评价图片点击回调
+   */
+  @Param
+  onImageClick: (pics: string[]) => void = (pics: string[]): void => {
+  };
+
+  /**
+   * 构建评价条目
+   * @returns {void} 无返回值
+   */
+  build(): void {
+    Row() {
+      Column() {
+        this.Nickname();
+        SpaceVerticalXSmall();
+        this.StarRating();
+        if (this.comment.content) {
+          SpaceVerticalXSmall();
+          Text(this.comment.content)
+            .id(`goods_comment_content_${this.index}`)
+            .fontSize($r("app.float.body_medium"))
+            .fontColor($r("app.color.text_secondary"))
+            .maxLines(3)
+            .textOverflow({ overflow: TextOverflow.Ellipsis });
+        }
+      }
+      .layoutWeight(1)
+      .alignItems(HorizontalAlign.Start);
+
+      if (this.getPics().length > 0) {
+        SpaceHorizontalMedium();
+        this.Thumbnail();
+      }
+    }
+    .id(`goods_comment_item_${this.index}`)
+    .width(P100)
+    .alignItems(VerticalAlign.Top);
+  }
+
+  /**
+   * 买家昵称
+   * @returns {void} 无返回值
+   */
+  @Builder
+  private Nickname(): void {
+    Text(this.getNickName())
+      .id(`goods_comment_nickname_${this.index}`)
+      .fontSize($r("app.float.body_large"))
+      .fontColor($r("app.color.text_primary"))
+      .maxLines(1)
+      .textOverflow({ overflow: TextOverflow.Ellipsis });
+  }
+
+  /**
+   * 星级（只读）
+   * @returns {void} 无返回值
+   */
+  @Builder
+  private StarRating(): void {
+    Rating({ rating: this.getStarCount(), indicator: true })
+      .id(`goods_comment_rating_${this.index}`)
+      .stars(MAX_STAR)
+      .stepSize(1)
+      .height(16)
+      .width(16 * MAX_STAR);
+  }
+
+  /**
+   * 第一张图片缩略图及剩余数量标记
+   * @returns {void} 无返回值
+   */
+  @Builder
+  private Thumbnail(): void {
+    Stack({ alignContent: Alignment.BottomEnd }) {
+      NetWorkImage({
+        model: this.getPics()[0],
+        sizeValue: THUMB_SIZE,
+        imageFit: ImageFit.Cover,
+        showBackground: true,
+        cornerRadius: $r("app.float.radius_small")
+      });
+
+      if (this.getPics().length > 1) {
+        Text(`+${this.getPics().length - 1}`)
+          .id(`goods_comment_thumb_count_${this.index}`)
+          .fontSize($r("app.float.body_medium"))
+          .fontColor($r("app.color.text_white"))
+          .backgroundColor($r("app.color.mask"))
+          .padding({
+            left: $r("app.float.space_padding_small"),
+            right: $r("app.float.space_padding_small"),
+            top: $r("app.float.space_padding_small_x"),
+            bottom: $r("app.float.space_padding_small_x")
+          })
+          .borderRadius({
+            topLeft: $r("app.float.radius_small"),
+            bottomRight: $r("app.float.radius_small")
+          });
+      }
+    }
+    .id(`goods_comment_thumb_${this.index}`)
+    .width(THUMB_SIZE)
+    .height(THUMB_SIZE)
+    .onClick((): void => {
+      this.onImageClick(this.getPics());
+    });
+  }
+
+  /**
+   * 获取有效评价图片（过滤空地址）
+   * @returns {string[]} 图片地址列表
+   */
+  private getPics(): string[] {
+    const pics: string[] | null | undefined = this.comment.pics;
+    if (!pics || pics.length === 0) {
+      return [];
+    }
+    return pics.filter((pic: string): boolean => !!pic && pic.trim().length > 0);
+  }
+
+  /**
+   * 获取展示昵称，为空时显示匿名用户
+   * @returns {string | Resource} 昵称
+   */
+  private getNickName(): string | Resource {
+    const nickName: string = this.comment.nickName?.trim() ?? "";
+    return nickName.length > 0 ? (this.comment.nickName as string) : $r("app.string.anonymous_user");
+  }
+
+  /**
+   * 获取星级，限制在 0～5 之间
+   * @returns {number} 星级
+   */
+  private getStarCount(): number {
+    const starCount: number = Number(this.comment.starCount ?? MAX_STAR);
+    if (isNaN(starCount)) {
+      return MAX_STAR;
+    }
+    return Math.min(Math.max(starCount, 0), MAX_STAR);
+  }
+}
diff --git a/feature/goods/src/main/ets/component/GoodsDetailImage.ets b/feature/goods/src/main/ets/component/GoodsDetailImage.ets
new file mode 100644
index 0000000000000000000000000000000000000000..336877ae2faba9426fe113f2c825b8d4c17e009c
--- /dev/null
+++ b/feature/goods/src/main/ets/component/GoodsDetailImage.ets
@@ -0,0 +1,77 @@
+import { P100 } from "designsystem";
+
+/**
+ * 无法得知图片尺寸时的占位宽高比
+ */
+const DEFAULT_ASPECT_RATIO: number = 1;
+
+/**
+ * @file 商品详情图片组件
+ */
+@ComponentV2
+export struct GoodsDetailImage {
+  /**
+   * 图片地址
+   */
+  @Param
+  url: string = "";
+  /**
+   * 图片序号（用于生成稳定 id）
+   */
+  @Param
+  index: number = 0;
+  /**
+   * 图片加载完成后的真实宽高比
+   */
+  @Local
+  private loadedRatio: number = 0;
+
+  /**
+   * 构建商品详情图片
+   * @returns {void} 无返回值
+   */
+  build(): void {
+    Stack() {
+      Column()
+        .width(P100)
+        .height(P100)
+        .backgroundColor($r("app.color.bg_content"));
+
+      Image(this.url)
+        .id(`goods_detail_image_${this.index}`)
+        .width(P100)
+        .height(P100)
+        .objectFit(ImageFit.Auto)
+        .onComplete((event): void => {
+          if (event && event.width > 0 && event.height > 0) {
+            this.loadedRatio = event.width / event.height;
+          }
+        });
+    }
+    .width(P100)
+    .aspectRatio(this.getAspectRatio());
+  }
+
+  /**
+   * 获取占位宽高比：优先使用加载结果，其次使用地址中的 w/h 参数
+   * @returns {number} 宽高比
+   */
+  private getAspectRatio(): number {
+    if (this.loadedRatio > 0) {
+      return this.loadedRatio;
+    }
+    const width: number = this.getUrlParam("w");
+    const height: number = this.getUrlParam("h");
+    return width > 0 && height > 0 ? width / height : DEFAULT_ASPECT_RATIO;
+  }
+
+  /**
+   * 读取地址中的数字参数
+   * @param {string} name - 参数名
+   * @returns {number} 参数值，不存在时为 0
+   */
+  private getUrlParam(name: string): number {
+    const match: RegExpMatchArray | null = this.url.match(new RegExp(`[?&]${name}=(\\d+)`));
+    return match ? Number(match[1]) : 0;
+  }
+}
