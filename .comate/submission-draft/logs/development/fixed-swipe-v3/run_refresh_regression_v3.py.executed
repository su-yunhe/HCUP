"""Fixed-coordinate regression with short non-pull moves near the retained top."""
import sys
import unittest

from hypium_tests.observation import ObservedGoodsCase
from hypium_tests.pagination import FixedPaginationChecks


class FixedRefreshRegressionV3(FixedPaginationChecks, ObservedGoodsCase):
    def test_01_grid(self):
        self.pagination_refresh("grid")

    def test_02_list(self):
        self.pagination_refresh("list")


if __name__ == "__main__":
    FixedRefreshRegressionV3.device_sn = "127.0.0.1:11241"
    result = unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(FixedRefreshRegressionV3))
    sys.exit(not result.wasSuccessful())
