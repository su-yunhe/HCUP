+    def read_status_bytes(self):
+        """Only retry the specified Windows errors on this read-only IPC file."""
+        path = self.runtime / "status.json"
+        started = time.monotonic()
+        # Leave scheduling/logging margin inside the approved 0.5-second limit.
+        deadline = started + .45
