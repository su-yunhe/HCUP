/**
 * 收藏夹列表中的一条展示项：类型名 + 摘要 + 可选副摘要 + 详情页路由。
 */
export class BookmarkItem {
  key: string;
  id: string;
  title: Resource;
  content: string | null;
  sub: string | null;
  subSuffix: string;
  route: string;
  bookmarkable_id: number;

  constructor(entity: BookmarkEntity, title: Resource, content: string | null, route: string,
    sub: string | null = null, subSuffix: string = '') {
    this.key = `${entity.bookmarkable_model}_${entity.bookmarkable_id}_${entity.id}`;
    this.id = `bookmark_item_${entity.bookmarkable_model}_${entity.bookmarkable_id}`;
    this.title = title;
    this.content = content;
    this.sub = sub;
    this.subSuffix = subSuffix;
    this.route = route;
    this.bookmarkable_id = entity.bookmarkable_id;
  }
}

class WritingTitle {
  Content: string = '';
}

function parseWritingTitle(raw: string | null): string | null {
  if (raw == null) {
    return null;
  }
  try {
    let title = JSON.parse(raw) as WritingTitle;
    return title?.Content ?? raw;
  } catch (error) {
    return raw;
  }
}

