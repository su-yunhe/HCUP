    Column() {
      BlockTitle({ title: this.item.title })
      if (this.item.content) {
        Text(this.item.content)
          .id(`${this.item.id}_title`)
          .width('100%')
          .padding(ThemeConst.P_X16_Y8)
          .maxLines(2)
         