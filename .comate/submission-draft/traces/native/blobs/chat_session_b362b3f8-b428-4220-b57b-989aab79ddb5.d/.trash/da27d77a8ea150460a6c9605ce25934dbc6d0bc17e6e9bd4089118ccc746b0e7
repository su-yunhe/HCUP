import sys
import time

from hypium import BY, UiDriver
from hypium.model import KeyCode

BUNDLE = "com.joker.coolmall"
d = UiDriver.connect(device_sn="127.0.0.1:5555")
d.stop_app(BUNDLE)
d.start_app(BUNDLE, wait_time=3)


def find(by, timeout=10):
    end = time.time() + timeout
    while time.time() < end:
        c = d.find_component(by)
        if c is not None:
            return c
        time.sleep(0.5)
    return None


