import { P100, rowCenter, size, SpaceHorizontalSmall } from "designsystem";
import { IBestDialog } from "ibestui";
import { GoodsSearchKeyword } from "model";
import { AppNavDestination } from "ui";
import GoodsSearchViewModel from "../viewmodel/GoodsSearchViewModel";

/**
 * 搜索输入框组件 ID
 */
const SEARCH_INPUT_ID: string = "goods_search_input";

/**
 * @file 商品搜索页面视图
 * @author Joker.X
 */
@ComponentV2
export struct GoodsSearchPage {
  /**
   * 商品搜索页面 ViewModel
   */
  @Local
  private vm: GoodsSearchViewModel = new GoodsSearchViewModel();

  /**
   * 构建商品搜索页面
   * @returns {void} 无返回值
   */
  build() {
    AppNavDestination({
      title: "商品搜索",
      viewModel: this.vm
    }) {
      this.GoodsSearchContent();

      IBestDialog({
        visible: this.vm.showClearDialog,
        message: $r("app.string.search_history_clear_message"),
        showCancelButton: true,
        confirmButtonText: $r("app.string.search_history_clear_confirm"),
        cancelButtonText: $r("app.string.cancel"),
        closeOnClickOverlay: true,
        closeOnBackPress: true,
        onConfirm: (): void => this.vm.confirmClearHistory(),
        onCancel: (): void => this.vm.hideClearDialogModal(),
        onClose: (): void => this.vm.hideClearDialogModal()
      });
    }
  }

  /**
   * 商品搜索页面内容视图
   * @returns {void} 无返回值
   */
  @Builder
  private GoodsSearchContent() {
    Column() {
      this.SearchBar();

      Scroll() {
        Column() {
          if (this.vm.historyList.length > 0) {
            this.HistorySection();
          }

          this.RecommendSection();
        }
        .width(P100)
        .alignItems(HorizontalAlign.Start);
      }
      .width(P100)
      .layoutWeight(1)
      .align(Alignment.Top)
      .scrollBar(BarState.Off)
      .edgeEffect(EdgeEffect.None);
    }
    .width(P100)
    .height(P100);
  }

  /**
   * 搜索栏：输入框 + 右侧搜索按钮
   * @returns {void} 无返回值
   */
  @Builder
  private SearchBar() {
    Row() {
      Row() {
        Image($r("app.media.ic_search"))
          .fillColor($r("app.color.text_tertiary"))
          .attributeModifier(size(18));

        TextInput({ text: this.vm.keyword, placeholder: $r("app.string.search_hint") })
          .id(SEARCH_INPUT_ID)
          .layoutWeight(1)
          .height(P100)
          .padding({ left: 6, right: 6 })
          .fontSize($r("app.float.body_medium"))
          .backgroundColor(Color.Transparent)
          .borderRadius(0)
          .enterKeyType(EnterKeyType.Search)
          .defaultFocus(true)
          .onAppear((): void => this.requestInputFocus())
          .onChange((value: string): void => this.vm.updateKeyword(value))
          .onSubmit((enterKey: EnterKeyType, event: SubmitEvent): void => {
            if (!this.vm.searchByInput()) {
              // 内容为空时不搜索，保持输入框编辑状态
              event.keepEditableState();
            }
          });
      }
      .attributeModifier(rowCenter())
      .layoutWeight(1)
      .height(38)
      .padding({ left: $r("app.float.space_horizontal_medium") })
      .backgroundColor($r("app.color.bg_white"))
      .borderRadius($r("app.float.radius_medium"));

      SpaceHorizontalSmall();

      Text($r("app.string.search"))
        .id("goods_search_button")
        .fontSize($r("app.float.body_medium"))
        .fontColor($r("app.color.primary"))
        .height(38)
        .padding({ left: 8, right: 8 })
        .onClick((): void => {
          this.vm.searchByInput();
        });
    }
    .attributeModifier(rowCenter())
    .width(P100)
    .padding({
      left: $r("app.float.space_horizontal_medium"),
      right: $r("app.float.space_horizontal_medium"),
      top: 8,
      bottom: 8
    });
  }

  /**
   * 搜索历史区域：标题 + 删除图标 + 历史标签
   * @returns {void} 无返回值
   */
  @Builder
  private HistorySection() {
    Column() {
      Row() {
        Text($r("app.string.search_history"))
          .fontSize($r("app.float.title_small"))
          .fontWeight(FontWeight.Medium)
          .fontColor($r("app.color.text_primary"));

        Blank();

        Image($r("app.media.ic_delete"))
          .id("search_history_clear")
          .fillColor($r("app.color.text_tertiary"))
          .attributeModifier(size(20))
          .onClick((): void => this.vm.showClearDialogModal());
      }
      .width(P100)
      .height(32);

      Flex({ wrap: FlexWrap.Wrap }) {
        ForEach(this.vm.historyList, (item: string, index: number): void => {
          this.KeywordTag(item, `search_history_tag_${index}`);
        }, (item: string, index: number): string => `${index}_${item}`);
      }
      .width(P100)
      .margin({ top: 8 });
    }
    .id("search_history_section")
    .width(P100)
    .padding({
      left: $r("app.float.space_horizontal_medium"),
      right: $r("app.float.space_horizontal_medium"),
      top: 8,
      bottom: 8
    });
  }

  /**
   * 推荐搜索区域：标题 + 服务端推荐关键词标签
   * @returns {void} 无返回值
   */
  @Builder
  private RecommendSection() {
    Column() {
      Row() {
        Text($r("app.string.recommended_search"))
          .fontSize($r("app.float.title_small"))
          .fontWeight(FontWeight.Medium)
          .fontColor($r("app.color.text_primary"));
      }
      .width(P100)
      .height(32);

      Flex({ wrap: FlexWrap.Wrap }) {