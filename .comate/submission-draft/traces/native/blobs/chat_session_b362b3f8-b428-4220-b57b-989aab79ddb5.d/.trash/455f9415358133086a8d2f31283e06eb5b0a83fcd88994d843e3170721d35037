"""场景三：清空历史（删除图标 → 确认框 → 取消 / 确认 / 返回键）。"""
from hypium import BY

from hypium_tests.search_helpers import (
    HISTORY_CLEAR, HISTORY_SECTION, RECOMMEND_SECTION, TEXT_CANCEL, TEXT_CLEAR_MESSAGE, TEXT_CONFIRM,
    TEXT_HISTORY, TEXT_RECOMMEND, SearchTestCase,
)


class TestScenario3Clear(SearchTestCase):

    def seed(self, *words: str) -> None:
        self.open_search()
        for w in words:
            self.search_and_back(w)
        self.assertEqual(self.wait_history(words[-1]), list(reversed(words)))

    def open_dialog(self):
        self.driver.click(self.require_component(BY.key(HISTORY_CLEAR), "删除图标不存在"))
        return self.require_text(TEXT_CLEAR_MESSAGE, "点删除图标后未弹出确认框", timeout=5)

    def test_a27_trash_icon_right_of_title(self):
        """A27：历史标题右侧显示删除图标。"""
        self.seed("手机")
        title = self.require_text(TEXT_HISTORY, "搜索历史标题不存在")
        icon = self.require_component(BY.key(HISTORY_CLEAR), "删除图标不存在")
        self.assertTrue(icon.isClickable(), "删除图标应可点击")
        self.assertGreater(icon.getBounds().left, title.getBounds().right, "删除图标应在标题右侧")
        self.assertTrue(self.same_row(icon, title), "删除图标应与标题同一行")

    def test_a28_a29_a30_dialog_and_cancel(self):
        """A28-A30：弹出确认框（文案、取消/确认按钮在下方）；点取消关框且历史不变。"""
        self.seed("苹果", "香蕉")
        message = self.open_dialog()
        cancel = self.require_text(TEXT_CANCEL, "确认框缺少“取消”")
        confirm = self.require_text(TEXT_CONFIRM, "确认框缺少“确认”")
        self.assertGreater(cancel.getBounds().top, message.getBounds().top, "取消按钮应在提示下方")
        self.assertGreater(confirm.getBounds().top, message.getBounds().top, "确认按钮应在提示下方")
        self.assertEqual(len(self.driver.find_all_components(BY.text(TEXT_CLEAR_MESSAGE)) or []), 1)
        self.driver.click(cancel)
        self.driver.wait(1)
