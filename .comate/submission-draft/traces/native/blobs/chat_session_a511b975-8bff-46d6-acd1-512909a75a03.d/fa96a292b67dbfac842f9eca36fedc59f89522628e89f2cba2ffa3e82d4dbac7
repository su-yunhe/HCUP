   262→  syncClassicalLiteratureClassicPoem(page: number) {
   263→    this.classicalliteratureClassicpoemLoading = true;
   264→    DatasetViewModel.getClassicalLiteratureClassicPoemList(this.classicalliteratureClassicpoemRemoteVersion, page)
   265→      .then((wrapper: DataWrapper<ClassicPoem>) => {
   266→        wrapper.data.map((obj: ClassicPoem) => {
   267→          DatasetViewModel.insertClassicalLiteratureClassicPoemToDb(obj);
   268→          this.classicalliteratureClassicpoemCount++;
   269→        })
   270→        if (wrapper.next_page) {
   271→          this.syncClassicalLiteratureClassicPoem(wrapper.next_page);
   272→        }
   273→        if (!wrapper.next_page) {
   274→          PrefUtil.saveClassicalLiteratureClassicPoemVersion(this.classicalliteratureClassicpoemRemoteVersion)
   275→          this.classicalliteratureClassicpoemLoading = false;
   276→        }
   277→      }).catch((error: BusinessError) => {
   278→      this.classicalliteratureClassicpoemLoadingError = `code = ${error.code}, msg = ${error.message}`;
   279→      logger.error(`syncClassicalLiteratureClassicPoem, code = ${error.code}, msg = ${error.message}`);
   280→      this.classicalliteratureClassicpoemLoading = false;
   281→    })
   282→  }
