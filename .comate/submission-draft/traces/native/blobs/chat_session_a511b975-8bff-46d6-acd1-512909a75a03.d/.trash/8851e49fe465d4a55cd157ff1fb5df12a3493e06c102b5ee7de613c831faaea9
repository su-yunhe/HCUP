import { String, ThemeConst } from 'constants';
import { Idiom, searchIdioms } from '../model/Idiom';
import { ensureIdiomData } from '../model/IdiomSeeder';

const DEBOUNCE_DELAY: number = 300;

@Builder
export function IdiomSearchPageBuilder() {
  IdiomSearchPage();
}

@ComponentV2
export struct IdiomSearchPage {
  @Consumer('NavPathStack') pageStack: NavPathStack = new NavPathStack();
  @Local keyword: string = '';
  @Local searching: boolean = false;
  @Local searched: boolean = false;
  @Local results: Idiom[] = [];
  private searchToken: number = 0;
  private timerId: number = -1;

  aboutToDisappear(): void {
    this.clearTimer()
  }

  build() {
    NavDestination() {
      Column() {
        Search({ value: this.keyword, placeholder: '输入成语、拼音或首字母' })
          .id('idiom_search_input')
          .width('100%')
          .margin({
            left: 16,
            top: 8,
            right: 16,
            bottom: 8
          })
          .searchButton(String.search)
          .defaultFocus(true)
          .onChange((value: string) => {
            this.keyword = value
            this.scheduleSearch()
          })
          .onSubmit((value: string) => {
            this.keyword = value
            this.clearTimer()
            this.search()
          })
        if (this.searching) {
          Column() {
            LoadingProgress()
              .width(48)
              .height(48)
              .color(Color.Gray)
          }
          .width('100%')
          .padding(48)
        } else if (this.results.length > 0) {
          List() {
            ForEach(this.results, (item: Idiom) => {
              ListItem() {
                ResultItem({
                  idiom: item,
                  action: () => {
                    this.pageStack.pushPathByName('IdiomDetailPage', item.id)
                  }
                })
              }
            }, (item: Idiom) => item.id.toString())
          }
          .id('idiom_search_result')
          .width('100%')
          .layoutWeight(1)
          .divider({ strokeWidth: 1, color: '#fff1f3f5' })
          .edgeEffect(EdgeEffect.Spring)
        } else {
          Text(this.hintText())
            .width('100%')
            .padding(48)
            .textAlign(TextAlign.Center)
            .fontColor(Color.Gray)
            .fontSize(ThemeConst.FontSize_14)
        }
      }
      .width('100%')
      .height('100%')
    }
    .title(String.chinese_idiom_search)
    .onReady((ctx: NavDestinationContext) => {
      this.pageStack = ctx.pathStack
    })
  }

  hintText(): string {
    if (this.keyword.trim().length === 0) {
      return '输入关键字后开始搜索'
    }
    if (this.searched) {
      return `未找到与「${this.keyword.trim()}」相关的成语`
    }

    return '输入关键字后开始搜索'
  }

  scheduleSearch() {
    this.clearTimer()
    if (this.keyword.trim().length === 0) {
      this.searchToken++
      this.results = []
      this.searching = false
      this.searched = false
      return
    }
    this.timerId = setTimeout(() => {
      this.timerId = -1
      this.search()
    }, DEBOUNCE_DELAY)
  }

  clearTimer() {
    if (this.timerId !== -1) {
      clearTimeout(this.timerId)
      this.timerId = -1
    }
  }

