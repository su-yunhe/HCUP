    97→async function convertSize(size: number): Promise<number> {
    98→  if (size < 0) {
    99→    throw new Error("输入值不能为负数");
   100→  }
   101→  const mb = size / 1024 / 1024;
   102→  return parseFloat(mb.toFixed(2));
   103→}
