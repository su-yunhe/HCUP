"""cm-spec26 自测：商品详情新增买家评价与详情长图（含评价图片全屏查看器）。

入口沿用应用正常流程：冷启动 → 首页商品卡片 → 商品详情页。
评价与详情图数据来自公共服务 page/goodsDetail，测试会在主机侧请求同一接口做逐字对照，
主机取不到数据时只做结构断言，不把环境问题算作功能通过。
"""
from __future__ import annotations

import json
import re
import time
import urllib.request

from hypium import BY  # type: ignore[import-not-found]

from harness.app import restart_app
from harness.driver import HarnessTestCase

BUNDLE = "com.joker.coolmall"
API_DETAIL = "https://mall.dusksnow.top/app/page/goodsDetail?goodsId={}"
HOST = "mall.dusksnow.top"

# 首页限时精选第一个商品：前两条评价各 2 张图，第 3～5 条各 1 张
GOODS_TWO_PICS = ("Xiaomi 17T Pro", 830001)
# 首页限时精选第二个商品：前两条评价各 3 张图
GOODS_THREE_PICS = ("Xiaomi 15S Pro", 1)
# 首页推荐商品：5 条评价全部无图，第 2 条为 4 星
GOODS_NO_PICS = ("REDMI Note 17 Pro", 830016)

LIST_KEY = "goods_detail_list"
VIEWER_KEY = "comment_image_viewer"
INDICATOR_KEY = "comment_image_viewer_indicator"
CLOSE_KEY = "comment_image_viewer_close"


def fetch_detail(goods_id: int) -> dict | None:
    """主机侧请求与应用相同的详情接口；失败返回 None。"""
    try:
        with urllib.request.urlopen(API_DETAIL.format(goods_id), timeout=10) as resp:
            body = json.loads(resp.read().decode("utf-8"))
        return body.get("data")
    except Exception:  # noqa: BLE001 - 环境网络问题统一视为无数据
        return None


def rect(component) -> tuple[int, int, int, int]:
    b = component.getBounds()
    return b.left, b.top, b.right, b.bottom


class GoodsDetailCase(HarnessTestCase):
    """导航、滚动、查看器操作等公共步骤。"""

    def setUp(self) -> None:
        self.driver.shell("hilog -Q pidoff; hilog -Q domainoff")

    def tearDown(self) -> None:
        self.driver.shell("hilog -Q pidon; hilog -Q domainon")

    # ---------- 环境与导航 ----------

    def wait_network(self, timeout: float = 90) -> None:
        """模拟器 DNS 偶发失败（baseline-notes 第 7 节），等到能解析服务地址再启动应用。"""
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if "bytes from" in self.driver.shell(f"ping -c 1 -W 3 {HOST}"):
                return
            time.sleep(3)
        self.skipTest("环境网络不可用：模拟器无法解析服务地址（环境失败，非功能失败）")

    def launch_home(self, wait_text: str = "Xiaomi 17T Pro") -> None:
        for _ in range(3):
            self.wait_network()
            restart_app(self.driver, BUNDLE, wait_time=2)
            if self.find_or_none(BY.text(wait_text), timeout=15) is not None:
                return
        self.skipTest("首页数据加载失败（网络异常），环境失败，非功能失败")

    def open_detail(self, goods: tuple[str, int] = GOODS_TWO_PICS) -> None:
        title = goods[0]
        self.launch_home()
        card = self.driver.find_component(BY.text(title))
        if card is None:
            card = self.driver.find_component(BY.text(title), scroll_target=BY.type("List"))
        self.assertIsNotNone(card, f"首页找不到商品入口 {title}")
        self.driver.click(card)
        self.require_component(BY.key(LIST_KEY), "未进入商品详情页")
        self.require_text("发货与服务", "详情页基础内容未加载")
        self.require_text(title, "详情页商品标题未显示")

    def list_rect(self) -> tuple[int, int, int, int]:
        return rect(self.require_component(BY.key(LIST_KEY), "详情 List 不存在"))

    def scroll_find(self, by, message: str):
        """在详情 List 中滚动查找；先直接找，找不到再 scrollSearch，最后手动上滑兜底。"""
        found = self.driver.find_component(by)
        if found is not None:
            return found
        found = self.driver.find_component(by, scroll_target=BY.key(LIST_KEY))
        if found is not None:
            return found
        for _ in range(8):
            self.swipe_list_up(40)
            found = self.driver.find_component(by)
            if found is not None:
                return found
        self.fail(message)

    def swipe_list_up(self, distance: int = 40) -> None:
        self.driver.swipe("UP", distance=distance, area=BY.key(LIST_KEY), swipe_time=0.6)
        self.driver.wait(0.8)

    def bring_into_view(self, by, message: str):
        """滚动到目标完整处于 List 可视区内（不被底部操作栏和状态栏遮挡）。"""
        comp = self.scroll_find(by, message)
        _, ltop, _, lbottom = self.list_rect()
        for _ in range(5):
            _, top, _, bottom = rect(comp)
            if top >= ltop and bottom <= lbottom - 10:
                return comp
            self.swipe_list_up(15)
            comp = self.require_component(by, message, timeout=3)
        return comp

    # ---------- 查看器 ----------

    def open_viewer(self, by, message: str = "未找到评价缩略图"):
        target = self.bring_into_view(by, message)
        self.driver.click(target)
        return self.require_component(BY.key(INDICATOR_KEY), "点击缩略图后未弹出全屏查看器", timeout=8)

    def indicator_text(self) -> str:
        comp = self.require_component(BY.key(INDICATOR_KEY), "查看器页码不存在", timeout=5)
        return comp.getText()

    def swipe_viewer(self, direction: str) -> None:
        self.driver.swipe(direction, distance=70, area=BY.key("comment_image_viewer_swiper"), swipe_time=0.4)
        self.driver.wait(1.2)

    def close_viewer(self) -> None:
        self.driver.click(self.require_component(BY.text("关闭"), "查看器没有'关闭'按钮", timeout=5))
        self.driver.wait(1.2)

    def assert_viewer_closed(self) -> None:
        self.assertIsNone(self.find_or_none(BY.key(VIEWER_KEY), timeout=2), "查看器未退出")
        self.assertIsNone(self.driver.find_component(BY.key(INDICATOR_KEY)), "页码仍残留在页面上")

    # ---------- 网络日志 ----------

    def clear_log(self) -> None:
        self.driver.shell("hilog -r")

    def detail_request_count(self) -> int:
        log = self.driver.shell("hilog -x -T NetLog", timeout=30)
        return len([ln for ln in log.splitlines() if "Request" in ln and "goodsDetail" in ln])

    def comment_page_request_count(self) -> int:
        log = self.driver.shell("hilog -x -T NetLog", timeout=30)
        return len([ln for ln in log.splitlines() if "comment/page" in ln])


class TestCommentSection(GoodsDetailCase):
    """场景一、二：商品评价区域、星级、缩略图与 +N 标记。"""

    def test_01_comment_section_after_service(self) -> None:
        """A1/A3/A4：从首页入口进入，'商品评价'位于发货与服务之后，可滚动到达。"""
        self.open_detail()
        service = self.require_text("服务", "服务行不存在")
        title = self.scroll_find(BY.text("商品评价"), "滚动后找不到'商品评价'")
        self.assertEqual(len(self.driver.find_all_components(BY.text("商品评价")) or []), 1, "'商品评价'不唯一")
        self.assertGreater(rect(title)[1], rect(service)[1], "'商品评价'不在服务信息之后")
        _, ltop, _, lbottom = self.list_rect()
        self.assertTrue(ltop <= rect(title)[1] < lbottom, "'商品评价'不在详情 List 可视区内")

    def test_02_nickname_rating_content_match_api(self) -> None:
        """A2/A5/A6/A7/A8：每条评价显示昵称、星级和正文，与接口顺序、内容一致。"""
        data = fetch_detail(GOODS_TWO_PICS[1])
        self.open_detail()
        self.scroll_find(BY.text("商品评价"), "找不到'商品评价'")
        comments = (data or {}).get("comment") or []
        count = len(comments) if comments else 5
        for i in range(count):
            content = self.bring_into_view(BY.key(f"goods_comment_content_{i}"), f"第 {i} 条评价正文不存在")
            nickname = self.require_component(BY.key(f"goods_comment_nickname_{i}"), f"第 {i} 条昵称不存在", 3)
            rating = self.require_component(BY.key(f"goods_comment_rating_{i}"), f"第 {i} 条星级不存在", 3)
            self.assertEqual(rating.getType(), "Rating")
            self.assertLess(rect(nickname)[1], rect(content)[1], "昵称应在正文上方")
            if comments:
                c = comments[i]
                self.assertEqual(nickname.getText(), c["nickName"], f"第 {i} 条昵称与接口不一致")
                self.assertEqual(content.getText(), c["content"], f"第 {i} 条正文与接口不一致")
                self.assertAlmostEqual(float(rating.getText()), float(c["starCount"]), msg=f"第 {i} 条星级不一致")
        self.assertIsNone(self.driver.find_component(BY.key(f"goods_comment_item_{count}")), "评价条数多于接口返回")

    def test_03_thumbnail_and_plus_one(self) -> None:
        """A11/A12/A14：两图评价右侧显示缩略图和'+1'，单图评价只有缩略图。"""
        self.open_detail()
        plus = self.bring_into_view(BY.text("+1"), "找不到'+1'数量标记")
        thumb = self.require_component(BY.key("goods_comment_thumb_0"), "第 0 条评价没有缩略图", 3)
        content = self.require_component(BY.key("goods_comment_content_0"), "第 0 条正文不存在", 3)
        tl, tt, tr, tb = rect(thumb)
        pl, pt, pr, pb = rect(plus)
        self.assertTrue(tl <= pl and pr <= tr and tt <= pt and pb <= tb, "'+1'不在第一条两图评价的缩略图上")
        self.assertGreaterEqual(tl, rect(content)[2], "缩略图不在评价条目右侧")
        self.assertTrue(thumb.isClickable(), "缩略图不可点击")
        self.bring_into_view(BY.key("goods_comment_thumb_2"), "单图评价没有缩略图")
        self.assertIsNone(self.driver.find_component(BY.key("goods_comment_thumb_count_2")), "单图评价不应显示数量标记")
        self.assertIsNone(self.driver.find_component(BY.text("+0")), "出现了'+0'")

    def test_04_three_pics_show_plus_two(self) -> None:
        """A13：三张图片的评价显示'+2'。"""
        self.open_detail(GOODS_THREE_PICS)
        plus = self.bring_into_view(BY.key("goods_comment_thumb_count_0"), "三图评价没有数量标记")
        self.assertEqual(plus.getText(), "+2")

    def test_05_no_pic_comments_have_no_thumbnail(self) -> None:
        """A15：评价全部无图的商品不显示缩略图和数量标记，星级 4 星正确显示。"""
        data = fetch_detail(GOODS_NO_PICS[1])
        self.launch_home()
        card = self.driver.find_component(BY.text(GOODS_NO_PICS[0]), scroll_target=BY.type("List"))
        self.require_precondition(card is not None, f"首页找不到 {GOODS_NO_PICS[0]}")
        self.driver.click(card)
        self.require_text("发货与服务", "详情页未加载")
        self.scroll_find(BY.text("商品评价"), "找不到'商品评价'")
        for i in range(5):
            self.bring_into_view(BY.key(f"goods_comment_content_{i}"), f"第 {i} 条评价不存在")
            self.assertIsNone(self.driver.find_component(BY.key(f"goods_comment_thumb_{i}")), f"第 {i} 条无图评价出现缩略图")
        if data:
            self.bring_into_view(BY.key("goods_comment_rating_1"), "第 1 条星级不存在")
            rating = self.require_component(BY.key("goods_comment_rating_1"), "第 1 条星级不存在", 3)
            self.assertAlmostEqual(float(rating.getText()), float(data["comment"][1]["starCount"]))


class TestDetailImages(GoodsDetailCase):
    """场景三：'商品详情'分隔标题与详情长图。"""

    def test_06_detail_title_after_comments(self) -> None:
        """A16：'商品详情'标题位于评价区域之后，且唯一。"""
        self.open_detail()
        self.bring_into_view(BY.key("goods_comment_item_4"), "最后一条评价不存在")
        last = rect(self.require_component(BY.key("goods_comment_item_4"), "最后一条评价不存在", 3))
        title = self.scroll_find(BY.text("商品详情"), "滚动后找不到'商品详情'")
        self.assertGreater(rect(title)[1], last[3] - 1, "'商品详情'不在评价区域之后")
        self.assertEqual(len(self.driver.find_all_components(BY.text("商品详情")) or []), 1, "'商品详情'不唯一")

    def test_07_detail_images_in_server_order(self) -> None:
        """A17/A18/A19：标题下方按顺序渲染全宽详情图，占位高度按图片比例且非 0。"""
        data = fetch_detail(GOODS_TWO_PICS[1])
        self.open_detail()
        title = self.bring_into_view(BY.text("商品详情"), "找不到'商品详情'")
        title_bottom = rect(title)[3]
        lleft, _, lright, _ = self.list_rect()
        first = self.require_component(BY.key("goods_detail_image_0"), "标题下方没有详情图片")
        self.assertEqual(first.getType(), "Image")
        fl, ft, fr, fb = rect(first)
        self.assertGreaterEqual(ft, title_bottom, "第一张详情图不在标题下方")
        self.assertEqual((fl, fr), (lleft, lright), "详情图不是全宽")
        self.assertGreater(fb - ft, 0, "详情图高度为 0")
        prev_top = ft
        for i in (1, 2):
            img = self.bring_into_view(BY.key(f"goods_detail_image_{i}"), f"第 {i} 张详情图不存在")
            l, t, r, b = rect(img)
            self.assertEqual((l, r), (lleft, lright), f"第 {i} 张详情图不是全宽")
            self.assertGreater(b - t, 0)
            pics = (data or {}).get("goodsInfo", {}).get("contentPics") or []
            m = re.search(r"[?&]w=(\d+)&h=(\d+)", pics[i]) if len(pics) > i else None
            if m:
                expect = (r - l) * int(m.group(2)) / int(m.group(1))
                self.assertAlmostEqual(b - t, expect, delta=expect * 0.05, msg=f"第 {i} 张详情图高度与比例不符")
            self.assertGreater(t, prev_top - 1 if i > 1 else -1)
            prev_top = t

    def test_08_scroll_to_last_detail_image(self) -> None:
        """A20：可以一直滚动到最后一张详情图，最后一张不被底部操作栏遮挡。"""
        data = fetch_detail(GOODS_TWO_PICS[1])
        pics = (data or {}).get("goodsInfo", {}).get("contentPics") or []
        self.require_precondition(len(pics) > 0, "主机取不到 contentPics，无法确定最后一张序号")
        self.open_detail()
        lst = self.require_component(BY.key(LIST_KEY), "详情 List 不存在")
        last_key = f"goods_detail_image_{len(pics) - 1}"
        for _ in range(6):
            lst.scrollToBottom()
            self.driver.wait(1.5)
            if self.driver.find_component(BY.key(last_key)) is not None:
                break
        last = self.require_component(BY.key(last_key), "滚到底部后看不到最后一张详情图", 5)
        _, _, _, lbottom = self.list_rect()
        bar = self.require_text("操作栏", "底部操作栏不存在", 3)
        self.assertLessEqual(rect(last)[3], rect(bar)[1], "最后一张详情图被底部操作栏遮挡")
        self.assertLessEqual(rect(last)[3], lbottom)
        self.assertIsNone(self.driver.find_component(BY.key(f"goods_detail_image_{len(pics)}")), "详情图多于接口返回")


