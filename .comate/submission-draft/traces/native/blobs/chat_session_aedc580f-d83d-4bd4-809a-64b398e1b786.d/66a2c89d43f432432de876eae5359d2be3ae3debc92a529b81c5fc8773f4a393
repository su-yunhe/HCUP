   100→export async function batchInsertIdiom(context: Context, objs: Idiom[]): Promise<void> {
   101→  let store: relationalStore.RdbStore = await relationalStore.getRdbStore(context, DbConfigConst.STORE_CONFIG);
   102→  let logger: Logger = new Logger('Idiom#batchInsertIdiom');
   103→
   104→  let valuesBuckets: relationalStore.ValuesBucket[] = []
   105→
   106→  objs.forEach((obj: Idiom) => {
   107→    valuesBuckets.push(
   108→      {
   109→        'id': obj.id,
   110→        'word': obj.word,
   111→        'pinyin': obj.pinyin,
   112→        'abbr': obj.abbr,
   113→        'explanation': obj.explanation,
   114→        'source': JSON.stringify(obj.source),
   115→        'quote': JSON.stringify(obj.quote),
   116→        'example': JSON.stringify(obj.example),
   117→        'similar': JSON.stringify(obj.similar),
   118→        'opposite': JSON.stringify(obj.opposite),
   119→        'usage': obj.usage,
   120→        'story': JSON.stringify(obj.story),
   121→        'notice': obj.notice,
   122→      }
   123→    )
   124→  })
   125→
   126→  try {
   127→    await store.batchInsertWithConflictResolution(
   128→      DbTableConst.CHINESE_IDIOM_TABLE,
   129→      valuesBuckets,
   130→      relationalStore.ConflictResolution.ON_CONFLICT_REPLACE
   131→    ).then((value: number) => {
   132→      logger.info(`insert rows = ${value}`)
   133→    }).catch((err: BusinessError) => {
   134→      logger.error(`batchInsertWithConflictResolution failed, code is ${err.code}, message is ${err.message}`);
   135→    })
   136→  } catch (error) {
   137→    const err = error as BusinessError;
   138→    logger.error(`batchInsertCharacter failed, code is ${err.code}, message is ${err.message}`);
   139→  }
   140→}
