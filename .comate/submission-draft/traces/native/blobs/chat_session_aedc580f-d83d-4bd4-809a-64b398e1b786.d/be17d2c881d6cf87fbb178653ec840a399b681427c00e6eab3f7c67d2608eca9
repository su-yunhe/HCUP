   325→@Concurrent
   326→export async function search(context: Context, query: string): Promise<Array<relationalStore.ValuesBucket>> {
   327→  let store: relationalStore.RdbStore = await relationalStore.getRdbStore(context, DbConfigConst.STORE_CONFIG);
   328→  let logger: Logger = new Logger('Writing#search');
   329→
   330→  // 查询所有数据
   331→  let resultSet = await store.querySql(DbCRUDConst.SEARCH_CLASSICALLITERATURE_WRITING, [`${query}`]);
   332→  console.info(`Query data successfully! row count:${resultSet.rowCount}`);
   333→  let index = 0;
   334→  let result = new Array<relationalStore.ValuesBucket>(resultSet.rowCount);
   335→  resultSet.goToFirstRow();
   336→  do {
   337→    result[index++] = resultSet.getRow();
   338→  } while (resultSet.goToNextRow());
   339→  resultSet.close();
   340→  return result;
   341→}
