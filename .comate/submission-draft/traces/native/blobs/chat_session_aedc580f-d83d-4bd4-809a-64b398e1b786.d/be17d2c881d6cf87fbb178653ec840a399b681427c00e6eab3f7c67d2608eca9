   185→@Concurrent
   186→export async function batchInsertWriting(context: Context, objs: Writing[]): Promise<void> {
   187→  let store: relationalStore.RdbStore = await relationalStore.getRdbStore(context, DbConfigConst.STORE_CONFIG);
   188→  let logger: Logger = new Logger('Writing#batchInsertWriting');
   189→
   190→  let valueBuckets: relationalStore.ValuesBucket[] = []
   191→
   192→  objs.forEach((obj: Writing) => {
   193→    valueBuckets.push(
   194→      {
   195→        'id': obj.Id,
   196→        'group_index': obj.GroupIndex,
   197→        'classes': JSON.stringify(obj.Classes),
   198→        'froms': JSON.stringify(obj.Froms),
   199→        'allusions': JSON.stringify(obj.Allusions),
   200→        'pictures': JSON.stringify(obj.Pictures),
   201→        'dynasty': obj.Dynasty,
   202→        'author': obj.Author,
   203→        'author_id': obj.AuthorId,
   204→        'author_date': obj.AuthorDate,
   205→        'author_years': obj.AuthorYears,
   206→        'author_place': obj.AuthorPlace,
   207→        'type': obj.Type,
   208→        'type_detail': obj.TypeDetail,
   209→        'rhyme': obj.Rhyme,
   210→        'first_clause_rhyme': obj.FirstClauseRhyme,
   211→        'title': JSON.stringify(obj.Title),
   212→        'subtitle': JSON.stringify(obj.SubTitle),
   213→        'tune_id': JSON.stringify(obj.TuneId),
   214→        'preface': obj.Preface,
   215→        'clauses': JSON.stringify(obj.Clauses),
   216→        'note': obj.Note,
   217→        'comments': JSON.stringify(obj.Comments),
   218→      }
   219→    )
   220→  })
   221→
   222→  try {
   223→    await store.batchInsertWithConflictResolution(
   224→      DbTableConst.CLASSICALLITERATURE_WRITING_TABLE,
   225→      valueBuckets,
   226→      relationalStore.ConflictResolution.ON_CONFLICT_REPLACE
   227→    ).then((value: number) => {
   228→      logger.info(`insert rows = ${value}`)
   229→    }).catch((err: BusinessError) => {
   230→      logger.error(`batchInsertWithConflictResolution failed, code is ${err.code}, message is ${err.message}`);
   231→    })
   232→  } catch (error) {
   233→    const err = error as BusinessError;
   234→    logger.error(`batchInsertCharacter failed, code is ${err.code}, message is ${err.message}`);
   235→  }
   236→}
