   274→export async function getWriting(id: number): Promise<Writing | undefined> {
   275→  let obj: Writing | undefined;
   276→
   277→  let predicates = new relationalStore.RdbPredicates(DbTableConst.CLASSICALLITERATURE_WRITING_TABLE)
   278→  predicates.equalTo('id', id)
   279→
   280→  await DbUtil.objectiveRDB?.query(predicates)
   281→    .then((resultSet: relationalStore.ResultSet) => {
   282→      try {
   283→        while (resultSet.goToNextRow()) {
   284→          obj = parse(resultSet)
   285→        }
   286→        resultSet.close()
   287→      } catch (error) {
   288→        let err = error as BusinessError
   289→        logger.error(`Query is failed, code is ${err.code},message is ${err.message}`)
   290→      }
   291→    })
   292→    .catch((err: BusinessError) => {
   293→      logger.error(`Query is failed, code is ${err.code},message is ${err.message}`)
   294→    })
   295→
   296→  return obj;
   297→}
