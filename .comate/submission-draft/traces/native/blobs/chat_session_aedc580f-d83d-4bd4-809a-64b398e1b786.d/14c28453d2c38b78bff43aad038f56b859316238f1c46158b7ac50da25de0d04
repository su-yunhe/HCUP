"""Print the current Comate session's engine sessionUuid and IDE sidebar session ID.

Read-only: only reads the hook log and opens the IDE state DB with mode=ro.

Usage (two separate tool calls, in this order):
  python3 session_ids.py --stamp                      # prints a stamp, e.g. 1792229464123
  python3 session_ids.py <workspace_path> --after <stamp> [--json]

Why two steps: a command's own PostToolUse hook entry is written only after the command
finishes, so a single run cannot see itself. The first call's entry is written right after it
returns; the second call looks for the first entry for this workspace logged after the stamp,
which belongs to the calling conversation. Picking "the latest entry for the workspace" instead
is wrong whenever another session in the same workspace made a tool call more recently.
"""
import json
import os
import sqlite3
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlparse

HOOK_LOG = Path.home() / ".comate" / "builtin-hook-state" / "notify-dispatcher.log"
TAIL_BYTES = 8 * 1024 * 1024  # the log grows large; recent entries are all we need
MATCH_WINDOW_SEC = 120  # stamp -> first call's PostToolUse entry; generous for slow hosts
AMBIGUITY_WINDOW_SEC = 15  # other sessions' entries this close to the match make it ambiguous