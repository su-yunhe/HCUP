def storage_roots():
    home = Path.home()
    candidates = [
        home / "Library" / "Application Support" / "Comate" / "User" / "workspaceStorage",  # macOS
        home / ".config" / "Comate" / "User" / "workspaceStorage",  # Linux
    ]
    appdata = os.environ.get("APPDATA")
    if appdata:
        candidates.append(Path(appdata) / "Comate" / "User" / "workspaceStorage")  # Windows
    return [p for p in candidates if p.is_dir()]


def parse_time(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return None


