#!/usr/bin/env python3
"""Print the current Comate session's engine sessionUuid and IDE sidebar session ID.

Read-only: only reads the hook log and opens the IDE state DB with mode=ro.

Usage (two separate tool calls, in this order):
  python3 session_ids.py --stamp                      # prints a stamp, e.g. 1792229464123
  python3 session_ids.py <workspace_path> --after <stamp> [--json]

Why two steps: a command's own PostToolUse hook entry is written only after the command
finishes, so a single run cannot see itself. The first call's entry is written right after it
returns; the second call looks for the first entry for this workspace logged after the stamp,
which belongs to the calling conversation. Picking "the latest entry for the workspace" instead
is wrong whenever another session in the same workspace made a tool call more recently.
"""
import json
import os
import sqlite3
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlparse

HOOK_LOG = Path.home() / ".comate" / "builtin-hook-state" / "notify-dispatcher.log"
TAIL_BYTES = 8 * 1024 * 1024  # the log grows large; recent entries are all we need
MATCH_WINDOW_SEC = 120  # stamp -> first call's PostToolUse entry; generous for slow hosts
AMBIGUITY_WINDOW_SEC = 15  # other sessions' entries this close to the match make it ambiguous


def storage_roots():
    home = Path.home()
    candidates = [
        home / "Library" / "Application Support" / "Comate" / "User" / "workspaceStorage",  # macOS
        home / ".config" / "Comate" / "User" / "workspaceStorage",  # Linux
    ]
    appdata = os.environ.get("APPDATA")
    if appdata:
        candidates.append(Path(appdata) / "Comate" / "User" / "workspaceStorage")  # Windows
    return [p for p in candidates if p.is_dir()]


def parse_time(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return None


def read_hook_events(workspace):
    """Return [(ts, conversationId, cwd, toolName, skillName)] for PostToolUse events in this workspace."""
    if not HOOK_LOG.is_file():
        return None
    size = HOOK_LOG.stat().st_size
    with HOOK_LOG.open("rb") as f:
        if size > TAIL_BYTES:
            f.seek(size - TAIL_BYTES)
            f.readline()  # drop partial line
        lines = f.read().decode("utf-8", errors="replace").splitlines()

    events, cur = [], None
    for line in lines:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        msg, data = rec.get("message"), rec.get("data") or {}
        if msg == "start" and data.get("event") == "PostToolUse" and data.get("conversationId"):
            if cur:
                events.append(cur)
            cur = {"ts": parse_time(rec.get("time")), "id": data["conversationId"], "cwd": None,
                   "tool": None, "skill": None}
        elif cur and msg == "loadWatch":
            cur["cwd"] = data.get("cwd")
        elif cur and msg == "record":
            cur["tool"], cur["skill"] = data.get("toolName"), data.get("skillName")
    if cur:
        events.append(cur)

    ws = os.path.realpath(workspace)
    return [e for e in events if e["cwd"] and os.path.realpath(e["cwd"]) == ws]


def engine_session(workspace, stamp):
    if stamp is None:
        return {"error": "missing --after <stamp>; run `session_ids.py --stamp` as a separate tool call first"}
    events = read_hook_events(workspace)
    if events is None:
        return {"error": f"hook log not found: {HOOK_LOG}"}

    # The --stamp call is a run_command; its PostToolUse entry is the first one for this
    # workspace logged after the stamp. Never fall back to "latest entry": that is how
    # another session's ID gets reported.
    after = [e for e in events if e["ts"] and stamp <= e["ts"] <= stamp + MATCH_WINDOW_SEC]
    cmd = [e for e in after if e["tool"] in (None, "run_command")]
    if not cmd:
        return {"error": "no PostToolUse entry for this workspace after the stamp "
                         "(hook may be slow or disabled); retry step 2 once, then report not found"}
    chosen = cmd[0]
    near = {e["id"] for e in after if abs(e["ts"] - chosen["ts"]) <= AMBIGUITY_WINDOW_SEC}
    others = sorted(near - {chosen["id"]})
    return {
        "sessionUuid": chosen["id"],
        "ambiguous": bool(others),
        "eventTime": datetime.fromtimestamp(chosen["ts"], timezone.utc).isoformat(),
        "lagSec": round(chosen["ts"] - stamp, 1),
        "otherIdsInWindow": others,
    }


def find_workspace_db(workspace):
    ws = os.path.realpath(workspace)
    for root in storage_roots():
        for wj in root.glob("*/workspace.json"):
            try:
                folder = json.loads(wj.read_text()).get("folder", "")
            except (ValueError, OSError):
                continue
            path = unquote(urlparse(folder).path)
            if path and os.path.realpath(path) == ws:
                db = wj.parent / "state.vscdb"
                if db.is_file():
                    return db
    return None


def sidebar_sessions(workspace):
    db = find_workspace_db(workspace)
    if not db:
        return {"error": "workspaceStorage entry for this workspace not found"}
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    try:
        rows = con.execute(
            "select value from ItemTable where key like 'comateAgentEditor.session.%'").fetchall()
    finally:
        con.close()
    sessions = []
    for (val,) in rows:
        try:
            s = json.loads(val)
        except ValueError:
            continue
        sessions.append({
            "sessionId": s.get("sessionId"),
            "title": " ".join((s.get("title") or "").replace("\xa0", " ").split()),
            "iconStatus": s.get("iconStatus"),
            "updatedAt": datetime.fromtimestamp(s["updatedAt"] / 1000, timezone.utc).isoformat()
            if s.get("updatedAt") else None,
        })
    sessions.sort(key=lambda x: x["updatedAt"] or "", reverse=True)
    generating = [s for s in sessions if s["iconStatus"] == "generating"]
    current = generating[0] if len(generating) == 1 else None
    return {"db": str(db), "current": current, "generatingCount": len(generating), "all": sessions}


def main():
    argv = sys.argv[1:]
    if "--stamp" in argv:
        # Step 1: emit a stamp. This call's PostToolUse entry is what step 2 looks for.
        print(int(time.time() * 1000))
        return

    stamp = None
    if "--after" in argv:
        i = argv.index("--after")
        try:
            stamp = int(argv[i + 1]) / 1000
        except (IndexError, ValueError):
            sys.exit("--after needs the integer printed by --stamp")
        del argv[i:i + 2]
    args = [a for a in argv if not a.startswith("--")]
    workspace = args[0] if args else os.getcwd()
    result = {"workspace": os.path.realpath(workspace),
              "engine": engine_session(workspace, stamp),
              "sidebar": sidebar_sessions(workspace)}
    if "--json" in argv:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return

    eng, side = result["engine"], result["sidebar"]
    print(f"workspace: {result['workspace']}")
    if "error" in eng:
        print(f"engine sessionUuid: NOT FOUND ({eng['error']})")
    else:
        print(f"engine sessionUuid: {eng['sessionUuid']}  [hook entry {eng['lagSec']}s after stamp]")
        if eng["ambiguous"]:
            print(f"  WARNING other sessions logged tool calls in the same window: {eng['otherIdsInWindow']}")
    if "error" in side:
        print(f"sidebar session ID: NOT FOUND ({side['error']})")
    else:
        cur = side["current"]
        if cur:
            print(f"sidebar session ID: {cur['sessionId']}  title=\"{cur['title']}\" status={cur['iconStatus']}")
        else:
            print(f"sidebar session ID: UNDETERMINED (generating sessions: {side['generatingCount']}); candidates:")
        for s in side["all"]:
            print(f"  - {s['sessionId']}  status={s['iconStatus']}  updated={s['updatedAt']}  title=\"{s['title']}\"")


if __name__ == "__main__":
    main()
