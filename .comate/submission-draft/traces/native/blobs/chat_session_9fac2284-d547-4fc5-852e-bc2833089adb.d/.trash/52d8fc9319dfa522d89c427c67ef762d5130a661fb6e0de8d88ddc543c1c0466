"""Temporary helper: dump current UI layout of the emulator and print nodes with text/id."""
import json
import subprocess
import sys

HDC = "/Applications/DevEco-Studio.app/Contents/sdk/default/openharmony/toolchains/hdc"
DEV = "127.0.0.1:5555"


def hdc(*args):
    return subprocess.run([HDC, "-t", DEV, *args], capture_output=True, text=True).stdout


def dump(name="l"):
    remote = f"/data/local/tmp/{name}.json"
    local = f"/tmp/cml_{name}.json"
    hdc("shell", f"uitest dumpLayout -p {remote}")
    hdc("file", "recv", remote, local)
    return json.load(open(local))


