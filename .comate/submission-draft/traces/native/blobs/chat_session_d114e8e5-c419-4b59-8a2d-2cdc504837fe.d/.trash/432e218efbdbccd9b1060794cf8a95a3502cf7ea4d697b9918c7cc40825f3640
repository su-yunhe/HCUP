def to_sec(text: str) -> int:
    m, s = text.split(":")
    return int(m) * 60 + int(s)


def api_requests(path: str, since: float) -> int | None:
    """统计本地 API 容器自 since（unix 秒）以来收到的 path 请求数；拿不到日志时返回 None。"""
    if shutil.which("docker") is None:
        return None
    try:
        out = subprocess.run(["docker", "logs", "--since", str(int(since)), API_CONTAINER],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return sum(1 for line in (out.stdout + out.stderr).splitlines() if path in line)


class PlayerTestCase(HarnessTestCase):
    """提供：冷启动、搜索、从面板播放、读取迷你栏/播放页状态等步骤。"""

    def exists(self, key: str, timeout: float = 0) -> bool:
        """不经隐式等待判断 id 是否在当前 UI 树中；timeout>0 时轮询等待出现。"""
        self.driver.set_implicit_wait_time(0)
        try:
            deadline = time.monotonic() + timeout
            while True:
                if self.driver.find_component(BY.key(key)) is not None:
                    return True
                if time.monotonic() >= deadline:
                    return False
                self.driver.wait(0.3)
        finally:
            self.driver.set_implicit_wait_time(5)

    def gone(self, key: str, timeout: float = 5) -> bool:
        """轮询等待 id 从 UI 树中消失。"""
        deadline = time.monotonic() + timeout
        while self.exists(key):
            if time.monotonic() >= deadline:
                return False
            self.driver.wait(0.3)
        return True

