import sys, time
from hypium import UiDriver, BY
d = UiDriver.connect(device_sn="127.0.0.1:5555")
d.set_implicit_wait_time(3)
B = "cc.chenlvin.cloudmusic"
def t(k):
    c = d.find_component(BY.key(k))
    return None if c is None else (c.getText(), c.getBounds())
step = sys.argv[1] if len(sys.argv) > 1 else "all"
if step in ("all", "play"):
    d.stop_app(B); d.start_app(B, wait_time=3)
    print("mini at start:", t("mini_player"))
    d.input_text(BY.key("search_input"), "晴天")
    d.click(BY.key("search_button"))
    d.wait(3)
    first = d.find_component(BY.text("晴天(深情版)"))
    print("first", first and first.getBounds())
    d.click(first); d.wait(1.5)
 