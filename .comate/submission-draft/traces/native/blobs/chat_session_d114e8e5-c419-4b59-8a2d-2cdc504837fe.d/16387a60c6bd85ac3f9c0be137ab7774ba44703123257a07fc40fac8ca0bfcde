def api_requests(path: str, since: float) -> int | None:
    """统计本地 API 容器自 since（unix 秒）以来收到的 path 请求数；拿不到日志时返回 None。

    注意：NeteaseCloudMusicApi 对相同 URL 有 2 分钟的 apicache（响应头 cache-control: max-age=120），
    命中缓存的请求不会打印日志。断言请求次数前要先调用 wait_api_cache_expired()。
    """
    lines = _api_log_lines(since)
    return None if lines is None else sum(1 for line in lines if path in line)


def _api_log_lines(since: float, timestamps: bool = False) -> list[str] | None:
    if shutil.which("docker") is None:
        return None
    cmd = ["docker", "logs", "--since", str(int(since)), API_CONTAINER]
    if timestamps:
        cmd.insert(2, "--timestamps")
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return (out.stdout + out.stderr).splitlines()


def wait_api_cache_expired(path: str, window: float = 125) -> bool:
    """等到 window 秒内服务端没有收到过 path（含 query）的请求，保证下一次同 URL 请求会真正到达并留下日志。"""
    lines = _api_log_lines(time.time() - window)
    if lines is None:
        return False
    hits = [line for line in lines if path in line]
    if hits:
        # 最近一次命中后再等满 window 秒（保守地按"刚刚发生"处理）
        last = _api_log_lines(time.time() - window, timestamps=True) or []
        stamps = [line.split(" ", 1)[0] for line in last if path in line]
        wait = window
        if stamps:
            import datetime as _dt
            ts = _dt.datetime.fromisoformat(stamps[-1][:26].rstrip("Z") + "+00:00").timestamp()
            wait = max(0.0, ts + window - time.time())
        time.sleep(wait)
    return True