   135→    def gone(self, key: str, timeout: float = 5) -> bool:
   136→        """轮询等待 id 从 UI 树中消失。"""
   137→        deadline = time.monotonic() + timeout
   138→        while self.exists(key):
   139→            if time.monotonic() >= deadline:
   140→                return False
   141→            self.driver.wait(0.3)
