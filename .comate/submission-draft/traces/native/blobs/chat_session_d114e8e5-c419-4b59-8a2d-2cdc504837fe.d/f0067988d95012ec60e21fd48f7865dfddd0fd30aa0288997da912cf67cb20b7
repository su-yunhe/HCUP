   184→    def wait_playing(self, key: str = "mini_player_time", min_sec: int = 1, timeout: float = 20) -> int:
   185→        """等到进度时间 ≥ min_sec 秒（确认音频真的在播），返回当时读数；超时记为前置不满足。"""
   186→        deadline = time.monotonic() + timeout
   187→        sec = 0
   188→        while time.monotonic() < deadline:
   189→            sec = self.time_of(key)
   190→            if sec >= min_sec:
   191→                return sec
   192→            self.driver.wait(1)
   193→        self.require_precondition(False, f"{timeout}s 内进度未走动（{key}={sec}s），音频流可能拉不到")
   194→        return sec
