   121→    def exists(self, key: str, timeout: float = 0) -> bool:
   122→        """不经隐式等待判断 id 是否在当前 UI 树中；timeout>0 时轮询等待出现。"""
   123→        self.driver.set_implicit_wait_time(0)
   124→        try:
   125→            deadline = time.monotonic() + timeout
   126→            while True:
   127→                if self.driver.find_component(BY.key(key)) is not None:
   128→                    return True
   129→                if time.monotonic() >= deadline:
   130→                    return False
   131→                self.driver.wait(0.3)
   132→        finally:
   133→            self.driver.set_implicit_wait_time(5)
