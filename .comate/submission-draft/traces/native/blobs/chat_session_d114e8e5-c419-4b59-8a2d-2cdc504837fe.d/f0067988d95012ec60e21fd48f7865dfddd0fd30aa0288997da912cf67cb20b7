   175→    def wait_title(self, key: str, song: str, timeout: float = 10) -> bool:
   176→        deadline = time.monotonic() + timeout
   177→        while time.monotonic() < deadline:
   178→            c = self.driver.find_component(BY.key(key))
   179→            if c is not None and c.getText() == song:
   180→                return True
   181→            self.driver.wait(0.5)
   182→        return False
