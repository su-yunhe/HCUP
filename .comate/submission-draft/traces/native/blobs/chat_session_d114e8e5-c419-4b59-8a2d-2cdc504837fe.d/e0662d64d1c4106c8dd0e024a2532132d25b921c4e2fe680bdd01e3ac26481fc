"""本题（底部播放控制栏与播放页关联）自测的公共步骤。

前置：应用"设置 → 自定义API服务器地址"已指向可用的 NeteaseCloudMusicApi（本地 http://10.0.2.2:3000），
模拟器能拉到音频流。自测歌曲用完整版 `晴天(深情版)`（非试听片段）。
"""
from __future__ import annotations

import json
import re
import shutil
import subprocess
import time
import urllib.parse
import urllib.request

from hypium import BY

from harness.app import restart_app
from harness.driver import HarnessTestCase

BUNDLE = "cc.chenlvin.cloudmusic"
KEYWORD = "晴天"
SONG = "晴天(深情版)"
ARTIST = "Lucky小爱"
API_CONTAINER = "netease_cloud_music_api"
HOST_API = "http://127.0.0.1:3000"  # 宿主机访问本地 API（应用内填的是 10.0.2.2:3000）
TIME_RE = re.compile(r"^\d+:\d{2}$")


def playable_songs(keyword: str = KEYWORD) -> list[str] | None:
    """按与应用相同的搜索接口查出能拿到播放地址的歌名（歌名在结果中唯一）；服务不可达时返回 None。"""
    try:
        q = urllib.parse.quote(keyword)
        with urllib.request.urlopen(f"{HOST_API}/search?keywords={q}", timeout=15) as r:
            songs = json.load(r)["result"]["songs"]
        ids = ",".join(str(s["id"]) for s in songs)
        with urllib.request.urlopen(f"{HOST_API}/song/url/v1?id={ids}&level=standard", timeout=15) as r:
            ok = {d["id"] for d in json.load(r)["data"] if d.get("url")}
    except (OSError, ValueError, KeyError):
        return None
    names = [s["name"] for s in songs]
    return [s["name"] for s in songs if s["id"] in ok and names.count(s["name"]) == 1]


def to_sec(text: str) -> int:
    m, s = text.split(":")
    return int(m) * 60 + int(s)


def api_requests(path: str, since: float) -> int | None:
    """统计本地 API 容器自 since（unix 秒）以来收到的 path 请求数；拿不到日志时返回 None。"""
    if shutil.which("docker") is None:
        return None
    try:
        out = subprocess.run(["docker", "logs", "--since", str(int(since)), API_CONTAINER],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return sum(1 for line in (out.stdout + out.stderr).splitlines() if path in line)


class PlayerTestCase(HarnessTestCase):
    """提供：冷启动、搜索、从面板播放、读取迷你栏/播放页状态等步骤。"""

    def exists(self, key: str, timeout: float = 0) -> bool:
        """不经隐式等待判断 id 是否在当前 UI 树中；timeout>0 时轮询等待出现。"""
        self.driver.set_implicit_wait_time(0)
        try:
            deadline = time.monotonic() + timeout
            while True:
                if self.driver.find_component(BY.key(key)) is not None:
                    return True
                if time.monotonic() >= deadline:
                    return False
                self.driver.wait(0.3)
        finally:
            self.driver.set_implicit_wait_time(5)

    def gone(self, key: str, timeout: float = 5) -> bool:
        """轮询等待 id 从 UI 树中消失。"""
        deadline = time.monotonic() + timeout
        while self.exists(key):
            if time.monotonic() >= deadline:
                return False
            self.driver.wait(0.3)
        return True

    def text_of(self, key: str) -> str:
        return self.require_component(BY.key(key), f"未找到组件 {key}", timeout=8).getText()

    def time_of(self, key: str) -> int:
        text = self.text_of(key)
        self.assertRegex(text, TIME_RE, f"{key} 时间格式不是 m:ss: {text!r}")
        return to_sec(text)

    def center(self, key: str) -> tuple[int, int]:
        b = self.require_component(BY.key(key), f"未找到组件 {key}").getBounds()
        return (b.left + b.right) // 2, (b.top + b.bottom) // 2

    def restart(self, clean_cache: bool = False) -> None:
        """冷启动应用。clean_cache=True 时先清应用缓存（基线 HTTP 请求开了 usingCache，
        不清的话重复的同一请求可能直接命中缓存、不到达服务端）；偏好设置（API 地址）不受影响。"""
        if clean_cache:
            self.driver.stop_app(BUNDLE)
            self.driver.shell(f"bm clean -n {BUNDLE} -c")
        restart_app(self.driver, BUNDLE, wait_time=2)
        self.require_component(BY.key("search_input"), "冷启动后未进入首页", timeout=20)

    def search(self, keyword: str = KEYWORD) -> None:
        self.driver.input_text(BY.key("search_input"), keyword)
        self.driver.click(BY.key("search_button"))
        self.require_text(f'"{keyword}" 的搜索结果', "未进入搜索结果页", timeout=20)

    def open_sheet(self, song: str = SONG) -> None:
        self.driver.click(self.require_text(song, f"搜索结果中没有 {song}", timeout=20))
        self.require_component(BY.key("song_sheet_play"), "点击歌曲后未弹出操作面板", timeout=8)

    def play_from_sheet(self, song: str = SONG) -> None:
        self.open_sheet(song)
        self.driver.click(BY.key("song_sheet_play"))
        self.assertTrue(self.exists("mini_player", timeout=15), "点击播放后底部未出现迷你播放器")
        self.assertTrue(self.wait_title("mini_player_title", song), "迷你播放器标题不是当前歌曲")

    def wait_title(self, key: str, song: str, timeout: float = 10) -> bool:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            c = self.driver.find_component(BY.key(key))
            if c is not None and c.getText() == song:
                return True
            self.driver.wait(0.5)
        return False

    def wait_playing(self, key: str = "mini_player_time", min_sec: int = 1, timeout: float = 20) -> int:
        """等到进度时间 ≥ min_sec 秒（确认音频真的在播），返回当时读数；超时记为前置不满足。"""
        deadline = time.monotonic() + timeout
        sec = 0
        while time.monotonic() < deadline:
            sec = self.time_of(key)
            if sec >= min_sec:
                return sec
            self.driver.wait(1)
        self.require_precondition(False, f"{timeout}s 内进度未走动（{key}={sec}s），音频流可能拉不到")
        return sec

    def start_playing(self) -> None:
        """冷启动 → 搜索 → 面板播放 → 确认在播。"""
        self.restart()
        self.search()
        self.play_from_sheet()
        self.wait_playing()

    def open_play_page(self, via: str = "mini_player_cover") -> None:
        if via == "mini_player":
            self.driver.click(self.center("mini_player"))
        else:
            self.driver.click(BY.key(via))
        self.assertTrue(self.exists("play_page", timeout=8), f"点击 {via} 未进入播放页")
        self.driver.wait(0.8)  # 等入场转场结束

    def close_play_page(self) -> None:
        self.driver.click(BY.key("play_page_down"))
        self.assertTrue(self.gone("play_page", timeout=8), "点击向下箭头后播放页未关闭")
        self.assertTrue(self.exists("mini_player", timeout=8), "收起播放页后迷你播放器未显示")
