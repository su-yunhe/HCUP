)}`)\n    17→    }\n    18→  }\n    19→\n    20→  // 新增数据\n    21→  async putPreferenceValue(name: string, key: string, value: preferences.ValueType) {\n    22→    if(!this.preferencesMap.has(name)) {\n    23→      LogUtil.error(TAG + `Preference ${name} 尚未初始化`)\n    24→      return\n    25→    }\n    26→    try {\n    27→      const preference = this.preferencesMap.get(name)\n    28→      await preference?.put(key, value)\n    29→      await preference?.flush()\n    30→      LogUtil.info(TAG + `保存 Preference ${name} 成功`)\n    31→    } catch (e) {\n    32→      LogUtil.error(TAG + `保存 Preference ${name} 失败: ${JSON.stringify(e)}`)\n    33→    }\n    34→  }\n    35→\n    36→  // 读取数据\n    37→  async getPreferenceValue<T extends preferences.ValueType>(name: string, key: string, defaultValue: T): Promise<T> {\n    38→    if (!this.preferencesMap.has(name)) {\n    39→      throw new Error(TAG + `Preference ${name} 尚未初始化`);\n    40→    }\n    41→    try {\n    42→      const preference = this.preferencesMap.get(name);\n    43→      const value = await preference?.get(key, defaultValue);\n    44→      LogUtil.info(TAG + `读取 Preference ${name}.${key}=${JSON.stringify(value)} 成功`);\n    45→      return value as T;\n    46→    } catch (e) {\n    47→      LogUtil.error(TAG + `读取 Preference ${name} 失败: ${JSON.stringify(e)}`);\n    48→      throw new Error(TAG + `无法读取 Preference ${name}.${key}`);\n    49→    }\n    50→  }\n    51→\n    52→\n    53→  // 删除数据\n    54→  async delPreferenceValue(name: string, key: string) {\n    55→    if(!this.preferencesMap.has(name)) {\n    56→      LogUtil.error(TAG + `Preference ${name} 尚未初始化`)\n    57→      return\n    58→    }\n    59→    try {\n    60→      const preference = this.preferencesMap.get(name)\n    61→      await preference?.delete(key)\n    62→      await preference?.flush()\n    63→      LogUtil.info(TAG + `删除 Preference ${name}.${key} 成功`)\n    64→    } catch (e) {\n    65→      LogUtil.error(TAG + `删除 Preference ${name} 失败: $