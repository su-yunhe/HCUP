\n     1→\"\"\"基线走查第三轮（临时脚本，跑完删除）：纯空格搜索落点、Web 组件在 UI 树中的类型。\"\"\"\n     2→import json, subprocess\n     3→from hypium import BY, UiDriver\n     4→\n     5→SN = \"127.0.0.1:5555\"\n     6→BUNDLE = \"cc.chenlvin.cloudmusic\"\n     7→OUT = \"/tmp/cmu114_walk\"\n     8→d = UiDriver.connect(device_sn=SN)\n     9→\n    10→\n    11→def types(tag):\n    12→    subprocess.run([\"hdc\", \"-t\", SN, \"shell\", \"uitest dumpLayout -p /data/local/tmp/l.json\"], capture_output=True)\n    13→    subprocess.run([\"hdc\", \"-t\", SN, \"file\", \"recv\", \"/data/local/tmp/l.json\", f\"{OUT}/{tag}.json\"], capture_output=True)\n    14→    acc = []\n    15→    def walk(n):\n    16→        a = n.get(\"attributes\", {})\n    17→        if a.get(\"bundleName\", BUNDLE) == BUNDLE and a.get(\"type\") in (\"Web\", \"LoadingProgress\", \"Text\", \"TextInput\", \"Button\"):\n    18→            acc.append((a.get(\"type\"), a.get(\"text\"), a.get(\"bounds\")))\n    19→        for c in n.get(\"children\", []):\n    20→            walk(c)\n    21→    walk(json.load(open(f\"{OUT}/{tag}.json\")))\n    22→    print(f\"===== {tag} current_app={d.current_app()}\")\n    23→    for x in acc:\n    24→        if x[1] not in (\"01\", \"02\", \"03\", \"32\", \"33\", \"34\", \"35\", \":\", \"100\"):\n    25→            print(\"   \", x)\n    26→    d.capture_screen(f\"{OUT}/{tag}.jpeg\")\n    27→\n    28→\n    29→d.stop_app(BUNDLE); d.start_app(BUNDLE); d.wait(3)\n    30→inp = d.find_component(BY.type(\"TextInput\"))\n    31→ib = inp.getBounds()\n    32→btn = [b for b in d.find_all_components(BY.type(\"Button\"))\n    33→       if b.getBounds().left > ib.right and b.getBounds().top >= ib.top - 5][0]\n    34→print(\"search btn\", btn.getBounds())\n    35→d.input_text(inp, \"   \")\n    36→d.start_listen_toast()\n    37→d.click(btn)\n    38→print(\"toast(spaces):\", repr(d.get_latest_toast(timeout=3)))\n    39→d.wait(5)\n    40→types(\"21_space_search_page\")\n    41→d.press_back(); d.wait(1.5)\n    42→types(\"