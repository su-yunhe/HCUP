    55→export async function getSongUrl(songId: number, quality:QualityType, isLogged:boolean): Promise<SongPlay> {
    56→  const rootUrl = await getApiUrl()
    57→  const url:string = `${rootUrl}/song/url/v1?id=${songId}&level=${quality}`
    58→  const request = new HttpRequest(url)
    59→  try {
    60→    const data = await request.Request()
    61→    if(data.result["code"] == 200) {
    62→      const dataGot: SongPlay = data.result as SongPlay
    63→      return dataGot
    64→    } else {
    65→      throw new Error(`${data.result["code"]} - ${data.result["message"]}`)
    66→    }
    67→  } catch (e) {
    68→    LogUtil.error(TAG + '获取播放url失败: ' + e)
    69→    throw new Error(e)
    70→  }
    71→}
