    36→  const request = new HttpRequest(url)
    37→  await request.Request().then((data) => {
    38→    const dataGot: SongsData = data.result as SongsData
    39→    hasMore = dataGot.result.hasMore
    40→    songCount = dataGot.result.songCount
    41→    list = dataGot.result.songs
    42→  })
    43→  let searchReturn:SearchReturn = {
    44→    list: list,
    45→    hasMore: hasMore,
    46→    songCount: songCount
    47→  }
    48→
