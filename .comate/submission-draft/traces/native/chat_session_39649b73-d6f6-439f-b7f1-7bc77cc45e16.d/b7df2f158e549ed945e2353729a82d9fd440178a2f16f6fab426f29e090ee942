    96→export async function changeSettings(name: string, value: number | boolean) {
    97→  try {
    98→    await PreferencesUtils.putPreferenceValue(StorageConstants.SET_PERF, name, value)
    99→    AppStorage.setOrCreate(name, value)
   100→  } catch (e) {
   101→    ToastUtil.showToast('更改设置失败')
   102→    LogUtil.error(TAG + 'Error while changing settings: ' + e.message)
   103→  }
   104→}
