    33→export async function getPlayLists(offset:number): Promise<PlayListsResult> {
    34→  let list:Array<PlayList> = new Array()
    35→  let hasMore:boolean = false
    36→  const user = await PreferencesUtils.getPreferenceValue<User>(StorageConstants.USER_PREF,'user',UserClass)
    37→  const rootUrl = await getApiUrl()
    38→  const url:string = `${rootUrl}/user/playlist?uid=${user.data.account.id}&limit=10&offset=${offset}&timestamp=${new Date().getTime()}`
    39→  const request = new HttpRequest(url)
    40→  await request.RequestInStream().then((data) => {
    41→    const dataGot:PlayListsResult = data.result as PlayListsResult
    42→    hasMore = dataGot.more
    43→    list = dataGot.playlist
    44→    AppStorage.setOrCreate(StorageConstants.USER_PLAYLISTS, list)
    45→    PreferencesUtils.putPreferenceValue(StorageConstants.USER_PREF, StorageConstants.USER_PLAYLISTS, list)
    46→  })
    47→
    48→  const result: PlayListsResult = {
    49→    more: hasMore,
    50→    playlist: list
    51→  }
    52→  return result
    53→}
