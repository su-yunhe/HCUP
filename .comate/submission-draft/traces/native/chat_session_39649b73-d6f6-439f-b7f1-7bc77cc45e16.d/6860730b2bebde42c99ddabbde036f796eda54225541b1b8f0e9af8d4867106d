   182→    const dataGot: PlayListOperationRes = data.result as PlayListOperationRes
   183→    LogUtil.info(TAG + 'data result: ' + JSON.stringify(data.result))
   184→    if(dataGot.body.code === 200) {
   185→      return true
   186→    }
   187→    else {
   188→      LogUtil.error(TAG + `Error code: ${dataGot.body.code}, Message: ${dataGot.body.message}`)
   189→      ToastUtil.showToast(`${dataGot.body.message}`)
   190→      return false
   191→    }
   192→  }).catch((err: Error) => {
   193→    LogUtil.error(TAG + 'Operation failed: ' + err.message)
   194→    return false
   195→  })
