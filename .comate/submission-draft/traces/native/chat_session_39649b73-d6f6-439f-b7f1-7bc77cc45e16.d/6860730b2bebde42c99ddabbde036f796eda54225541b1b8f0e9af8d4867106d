    91→/**
    92→ * 将歌单歌曲添加至播放列表
    93→ * @param listId - 歌单ID
    94→ * @param trackCount - 歌单歌曲总数
    95→ * @returns void
    96→ */
    97→export async function putPlayListInQueue(listId: number, trackCount: number, limit: number, offset: number = 0, first: boolean = true): Promise<void> {
    98→  const rootUrl = await getApiUrl()
    99→  let tempQueue:Array<PlayQueue> = []
   100→  while(offset < trackCount) {
   101→    const url: string = `${rootUrl}/playlist/track/all?id=${listId}&limit=${limit}&offset=${offset}&timestamp=${new Date().getTime()}`
   102→    const request = new HttpRequest(url)
   103→    let data = await request.RequestInStream()
   104→    let dataResult: PlayListSongs = data.result as PlayListSongs
   105→    for (let item of dataResult.songs) {
   106→      let artists = await getArtists(item.ar)
   107→      tempQueue.push({
   108→        playmode: 1,
   109→        song: {
   110→          id: item.id,
   111→          name: item.name,
   112→          artists: item.ar,
   113→          duration: item.dt,
   114→          alias: [],
   115→          fee: item.fee
   116→        },
   117→        artists: artists,
   118→        fileName: '',
   119→        picUrl: item.al.picUrl ?? $r('app.media.ic_public_music')
   120→      })
   121→    }
   122→    if(first) {
   123→      await PlayQueueUtils.cleanQueue()
   124→      first = false
   125→    }
   126→    await PlayQueueUtils.queueAdd_array(tempQueue)
   127→    tempQueue = []
   128→    offset += limit
   129→  }
   130→}
