  /**
   * 添加歌曲至播放列表
   */
  async queueAdd(playmode:number, song:Song = SongClass, artists: string = '', fileName: string = '', picUrl: string | ResourceStr = '') {
    try {
      this.queue.splice(this.currentQueueIndex + 1 , 0 ,{
        playmode: playmode,
        song: song,
        artists: artists,
        fileName: fileName,
        picUrl: picUrl
      })
      await this.syncQueueToStorage()
    } catch (e) {
      LogUtil.error(TAG + '添加失败 add queue element error: ' + e.message())
    }
  }

