"""私人FM 自测公共方法（cmu-spec34）。

约定：
- 每个用例自己通过 restart_app 冷启动，不依赖其他用例留下的状态；
- 依赖本地 NeteaseCloudMusicApi（应用内 API 地址 http://10.0.2.2:3000），未登录即可；
- 组件优先用 .id() 定位（BY.key），文案断言用 BY.text 精确匹配。
"""
from __future__ import annotations

import re
import time

from hypium import BY

from harness.app import restart_app

BUNDLE = "cc.chenlvin.cloudmusic"
API_URL = "http://10.0.2.2:3000"
NET_TIMEOUT = 25

SONG_A = "外婆桥"  # 搜索结果第 1 首（任然，fee=8 可播放）
SONG_B = "摇到外婆桥（摇啊摇）(童声合唱版)"  # 搜索结果第 2 首（fee=8 可播放）


def find(driver, key: str):
    return driver.find_component(BY.key(key))


def text_of(driver, key: str):
    c = find(driver, key)
    return None if c is None else c.getText()


def wait_for(cond, timeout: float = NET_TIMEOUT, interval: float = 0.5):
    """轮询 cond()，返回第一个真值；超时返回 None。"""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = cond()
        if value:
            return value
        time.sleep(interval)
    return None


def wait_key(driver, key: str, timeout: float = NET_TIMEOUT):
    return wait_for(lambda: find(driver, key), timeout)


def wait_gone(driver, key: str, timeout: float = 10) -> bool:
    return bool(wait_for(lambda: find(driver, key) is None, timeout))


def click_key(driver, key: str, timeout: float = 10):
    c = wait_key(driver, key, timeout)
    if c is None:
        raise AssertionError(f"未找到组件 id={key}")
    driver.click(c)
    return c


def launch(driver):
    """冷启动并等待发现页私人FM卡片出现。"""
    restart_app(driver, BUNDLE, wait_time=3)
    if wait_key(driver, "fm_card", 20) is None:
        raise AssertionError("冷启动后发现页未出现私人FM卡片")
    time.sleep(1.5)


def bottom_song(driver):
    return text_of(driver, "bottom_bar_song_name")


def wait_song_change(driver, old: str | None, key: str = "bottom_bar_song_name", timeout: float = NET_TIMEOUT):
    def changed():
        t = text_of(driver, key)
        return t if t and t != old and t != "暂无播放" else None
    return wait_for(changed, timeout)


def is_fm(driver) -> bool:
    return find(driver, "fm_badge_bottom") is not None


def open_queue_from_bottom(driver):
    click_key(driver, "bottom_bar_queue_btn")
    if wait_key(driver, "queue_title", 8) is None:
        raise AssertionError("播放列表面板未打开")
    time.sleep(1)


def close_overlay(driver):
    driver.press_back()
    time.sleep(1.2)


def queue_count(driver) -> int | None:
    t = text_of(driver, "queue_title")
    if not t:
        return None
    m = re.search(r"\((\d+)\)", t)
    return int(m.group(1)) if m else None


def queue_names(driver, limit: int = 8) -> list[str]:
    names = []
    for i in range(limit):
        t = text_of(driver, f"queue_item_{i}")
        if t is None:
            break
        names.append(t)
    return names


def exit_fm_if_needed(driver):
    """处于私人FM时，从底部栏打开播放列表点“退出FM”。"""
    if not is_fm(driver):
        return
    open_queue_from_bottom(driver)
    click_key(driver, "fm_exit_btn")
    wait_gone(driver, "fm_exit_btn")
    close_overlay(driver)
    if not wait_gone(driver, "fm_badge_bottom"):
        raise AssertionError("退出FM后底部栏仍显示私人FM标识")


def enter_fm(driver) -> str:
    """点击私人FM卡片，等待标识出现、底部栏歌曲换成 FM 推荐，返回歌名。"""
    old = bottom_song(driver)
    click_key(driver, "fm_card")
    if wait_key(driver, "fm_badge_bottom") is None:
        raise AssertionError("点击私人FM卡片后底部栏没有出现私人FM标识")
    song = wait_song_change(driver, old)
    if song is None:
        # 进入前正在播放的歌恰好被推荐时歌名可能不变
        song = bottom_song(driver)
    return song


