  private play(index: number) {
    if (!this.player) {
      LogUtil.error(TAG + '播放控制未注册')
      return
    }
    this.player.play(index)
    this.prefetch()
  }

  /**
   * 当前歌曲已是队尾时预取下一首，失败不提示
   */
  private prefetch() {
    if (!this.active || this.fetching) return
    if (PlayQueueUtils.currentQueueIndex < PlayQueueUtils.getQueueLength() - 1) return
    this.fetchMore()
  }