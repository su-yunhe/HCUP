    26→export async function playMusicByUrl(song: Song, artists: string, isLogged: boolean, picUrl: string | ResourceStr = '') {
    27→  try {
    28→    isThisSongLiked(song.id)
    29→    const quality:number | undefined = await AppStorage.get(StorageConstants.PLAY_QUALITY)
    30→    const songPlay:SongPlay = await getSongUrl(song.id, quality ? PlayConstants.QUALITY[quality] : "standard", isLogged)
    31→    setPlayData(1, song, artists)
    32→    let localPath: string = ''
    33→    let tempArtists: string = artists
    34→    try {
    35→      if(song.name.length + artists.length >= 103) {
    36→        try { tempArtists = artists.slice(0, 100 - song.name.length) }
    37→        catch (e) { artists = '未知' }
    38→      }
    39→      localPath = await FileUtils.accessLocalFile(sanitizeFileName(`${tempArtists} - ${song.name}`))
    40→    } catch (e) {}
    41→
    42→    if(localPath != '') { // 是否存在本地文件
    43→      AppStorage.setOrCreate(StorageConstants.PLAY_IS_LOCALFILE, true)
    44→      await AVPlayerUtils.setUrl(localPath)
    45→    } else if(songPlay.data[0].url) {
    46→      AppStorage.setOrCreate(StorageConstants.PLAY_IS_LOCALFILE, false)
    47→      await AVPlayerUtils.setUrl(songPlay.data[0].url)
    48→    } else {
    49→      ToastUtil.showToast('获取播放资源失败')
    50→      playNext()
    51→    }
    52→    if(!picUrl) {
    53→      picUrl = await getSongPicUrl(song.id)
    54→    }
    55→    setPicUrl(picUrl)
    56→    LyricUtils.setLyric(song).then(() => {
    57→      AVSessionUtils.setMetadata(song, artists, picUrl)
    58→      AVSessionUtils.activate()
    59→    })
    60→    saveCurrentSongInfo(1, song, artists, picUrl)
    61→  } catch (e) {
    62→    LogUtil.error(TAG + '播放Url出错: ' + e)
    63→    playNext()
    64→  }
    65→}
