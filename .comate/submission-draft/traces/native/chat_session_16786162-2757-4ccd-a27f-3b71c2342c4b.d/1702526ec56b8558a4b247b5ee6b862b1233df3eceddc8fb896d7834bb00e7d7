    67→export async function playMusicWithFile(song: Song, fileName: string) {
    68→  try {
    69→    AppStorage.setOrCreate(StorageConstants.ISLIKED, true)
    70→    const filesDir = FileUtils.getFilesDir()
    71→    const fileUrl = filesDir + `/${fileName}`
    72→    let file = await fileIo.open(fileUrl)
    73→    let fdPath = 'fd://' + file.fd
    74→    const metadata = await fetchMetadata(fileUrl)
    75→    if(metadata) {
    76→      song.duration = (metadata.duration) ? parseInt(metadata.duration) : 0
    77→    }
    78→    if(FileUtil.accessSync(fileUrl)) {
    79→      setPlayData(0, song, song.artists[0].name, fileName)
    80→      let picUrl = song.id == 0 ? $r('app.media.ic_files_audio') : `file://${filesDir}/pic/${song.id}.jpg`
    81→      setPicUrl(picUrl)
    82→      await AVPlayerUtils.setUrl(fdPath)
    83→      // Lyric
    84→      if(song.id != 0) {
    85→        let lyricString = await LyricUtils.readLyric(song.id.toString())
    86→        LyricUtils.setLyricString(lyricString)
    87→      } else {
    88→        LyricUtils.setLyricString('')
    89→      }
    90→      // AVSession
    91→      AVSessionUtils.setMetadata(song,song.artists[0].name, picUrl)
    92→      AVSessionUtils.activate()
    93→      saveCurrentSongInfo(0, song, song.artists[0].name, picUrl)
    94→      EmitterUtil.post(EmitterConstants.EMITTER_LYRIC_UPDATE, 'Lyric Updated')
    95→    } else {
    96→      ToastUtil.showToast('未找到文件')
    97→      playNext()
    98→    }
    99→  } catch (e) {
   100→    LogUtil.error(TAG + '播放File出错: ' + JSON.stringify(e))
   101→    playNext()
   102→  }
   103→}
