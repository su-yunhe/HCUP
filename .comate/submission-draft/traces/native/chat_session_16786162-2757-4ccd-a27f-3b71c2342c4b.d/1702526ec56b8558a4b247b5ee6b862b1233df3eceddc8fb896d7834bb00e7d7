   127→export async function playQueue(index: number) {
   128→  const queue = PlayQueueUtils.getQueue()
   129→  const playqueue = queue[index]
   130→  PlayQueueUtils.setIndex(index)
   131→  if(playqueue.playmode == 0) { // Play with file
   132→    playMusicWithFile(playqueue.song, playqueue.fileName)
   133→  } else { // Play with url
   134→    const isLogged: boolean | undefined = AppStorage.get(StorageConstants.IS_LOGGED)
   135→    playMusicByUrl(playqueue.song, playqueue.artists, isLogged ? true : false, playqueue.picUrl)
   136→  }
   137→}
