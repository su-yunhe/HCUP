   139→export async function playPre() {
   140→  let isLogged: boolean | undefined = await AppStorage.get(StorageConstants.IS_LOGGED)
   141→  let cycleMode = await getCycleMode()
   142→  if(PlayQueueUtils.pre()) {
   143→    const res = PlayQueueUtils.getQueueElement(PlayQueueUtils.currentQueueIndex)
   144→    if(res.playmode == 0) {
   145→      playMusicWithFile(res.song, res.fileName)
   146→    } else {
   147→      playMusicByUrl(res.song, res.artists, isLogged ? isLogged : false, res.picUrl)
   148→    }
   149→  } else {
   150→    if(cycleMode == 2) { playQueue(PlayQueueUtils.getQueueLength() - 1) }
   151→    else { ToastUtil.showToast('没有上一首了~') }
   152→  }
   153→}
   154→
   155→/**
   156→ * 播放下一首
   157→ */
   158→export async function playNext() {
   159→  let isLogged:boolean | undefined = await AppStorage.get(StorageConstants.IS_LOGGED)
   160→  let cycleMode = await getCycleMode()
   161→  if(cycleMode == 3) {
   162→    let queueLength = PlayQueueUtils.getQueueLength()
   163→    let randomIndex = RandomUtil.getRandomInt(0, queueLength - 1)
   164→    playQueue(randomIndex)
   165→  }
   166→  // 存在下一首歌曲
   167→  else if(PlayQueueUtils.next()) {
   168→    const res = PlayQueueUtils.getQueueElement(PlayQueueUtils.currentQueueIndex)
   169→    if(res.playmode == 0) {
   170→      playMusicWithFile(res.song, res.fileName)
   171→    } else {
   172→      playMusicByUrl(res.song, res.artists, isLogged ? isLogged:false, res.picUrl)
   173→    }
   174→  } else {
   175→    if(cycleMode == 2) { playQueue(0) }
   176→    else { ToastUtil.showToast('没有下一首了~') }
   177→  }
   178→}
