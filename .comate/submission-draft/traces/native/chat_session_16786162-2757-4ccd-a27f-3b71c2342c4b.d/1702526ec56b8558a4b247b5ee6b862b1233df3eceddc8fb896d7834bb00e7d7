   180→/**
   181→ * 本首歌曲播放完成后的操作
   182→ */
   183→export async function completeDo() {
   184→  let cycleMode = await getCycleMode()
   185→  // 顺序播放 & 顺序循环
   186→  if(cycleMode == 0 || cycleMode == 2) {
   187→    playNext()
   188→  }
   189→  // 单曲循环
   190→  else if(cycleMode == 1) {
   191→    let currentQueueIndex = PlayQueueUtils.currentQueueIndex
   192→    playQueue(currentQueueIndex)
   193→  }
   194→  // 随机播放
   195→  else if(cycleMode == 3) {
   196→    let queueLength = PlayQueueUtils.getQueueLength()
   197→    let randomIndex = RandomUtil.getRandomInt(0, queueLength - 1)
   198→    playQueue(randomIndex)
   199→  }
   200→}
