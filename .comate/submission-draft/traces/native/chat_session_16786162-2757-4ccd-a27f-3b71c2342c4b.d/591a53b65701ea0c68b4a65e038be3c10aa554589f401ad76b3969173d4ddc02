        song = fm.text_of(self.driver, "player_song_name")
        mark = fm.mark(self.driver)
        btn = fm.find(self.driver, "fm_dislike_btn")
        for _ in range(3):
            self.driver.click(btn)
            time.sleep(0.1)
        self.assertIsNotNone(fm.wait_song_change(self.driver, song, "player_song_name"))
        time.sleep(4)
        self.assertEqual(fm.count_since(self.driver, mark, fm.LOG_E2), 1, "快速连点不喜欢应只上报 1 次")