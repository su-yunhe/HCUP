   199→  /**
   200→   * 不喜欢当前歌曲：上报服务端、加入本地黑名单，并切到下一首
   201→   */
   202→  async dislike() {
   203→    if (!this.active || this.dislikeInFlight) return
   204→    const index = PlayQueueUtils.currentQueueIndex
   205→    const current = PlayQueueUtils.getQueueElement(index)
   206→    if (!current) return
   207→    const sid = current.song.id
   208→    this.dislikeInFlight = true
   209→    const report: Promise<boolean> = trashFM(sid).catch((e: Error) => {
   210→      LogUtil.error(TAG + '不喜欢上报失败: ' + JSON.stringify(e))
   211→      return false
   212→    })
   213→    if (!this.blacklist.includes(sid)) {
   214→      this.blacklist.push(sid)
   215→    }
   216→    // 队列中尚未播放的同一首歌也移除
   217→    const queue = PlayQueueUtils.getQueue()
   218→    const filtered = queue.filter((item: PlayQueue, i: number) => i <= index || item.song.id != sid)
   219→    if (filtered.length != queue.length) {
   220→      PlayQueueUtils.replaceQueue(filtered, index)
   221→    }
   222→    this.persist()
   223→    try {
   224→      // 新歌真正开始播放（或播放失败）前，再点“不喜欢”都忽略
   225→      const settled = this.waitPlaySettled(DISLIKE_LOCK_TIMEOUT)
   226→      await this.next('dislike')
   227→      if (PlayQueueUtils.currentQueueIndex != index) {
   228→        await settled
   229→      }
   230→      await report
   231→    } finally {
   232→      this.dislikeInFlight = false
   233→    }
   234→  }
