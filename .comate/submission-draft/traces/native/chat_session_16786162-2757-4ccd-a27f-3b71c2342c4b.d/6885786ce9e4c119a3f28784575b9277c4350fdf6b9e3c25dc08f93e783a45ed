   143→  async next(source: string = 'user') {
   144→    if (!this.active) return
   145→    const index = PlayQueueUtils.currentQueueIndex
   146→    LogUtil.info(TAG + `next(${source}): index ${index}, length ${PlayQueueUtils.getQueueLength()}, fetching ${this.fetching != null}`)
   147→    if (index + 1 < PlayQueueUtils.getQueueLength()) {
   148→      this.play(index + 1)
   149→      return
   150→    }
   151→    if (this.loading) return
   152→
   153→    const seq = this.reqSeq
   154→    this.setLoading(true)
   155→    const ok = await this.fetchMore()
   156→    if (seq != this.reqSeq) return
   157→    this.setLoading(false)
   158→    const current = PlayQueueUtils.currentQueueIndex
   159→    if (ok && current + 1 < PlayQueueUtils.getQueueLength()) {
   160→      this.play(current + 1)
   161→    } else {
   162→      ToastUtil.showToast('获取推荐歌曲失败')
   163→    }
   164→  }
