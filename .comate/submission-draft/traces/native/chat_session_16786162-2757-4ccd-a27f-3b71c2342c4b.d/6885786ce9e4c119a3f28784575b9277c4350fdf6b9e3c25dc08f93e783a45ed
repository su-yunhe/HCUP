   187→  /**
   188→   * 歌曲播放完成：实测同一首歌会连续收到两次 completed，只处理一次，否则会跳过下一首
   189→   */
   190→  onCompleted() {
   191→    if (this.startedSongId != 0 && this.startedSongId == this.completedSongId) {
   192→      LogUtil.info(TAG + 'ignore repeated completed: ' + this.startedSongId)
   193→      return
   194→    }
   195→    this.completedSongId = this.startedSongId
   196→    this.next('complete')
