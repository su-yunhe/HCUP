   236→  /**
   237→   * 等待下一次 onPlayStarted / onPlayFailed，超时也返回
   238→   */
   239→  private waitPlaySettled(timeout: number): Promise<void> {
   240→    return new Promise<void>((resolve: () => void) => {
   241→      let timer: number = -1
   242→      const done = (): void => {
   243→        clearTimeout(timer)
   244→        if (this.playSettled === done) this.playSettled = null
   245→        resolve()
   246→      }
   247→      timer = setTimeout(done, timeout)
   248→      this.playSettled = done
   249→    })
