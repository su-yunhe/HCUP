  @State imgColor: Color | ResourceStr = $r('app.color.reverse')
  btnId: string = ''

  build() {
    Button(){
      Image($r('app.media.ic_public_view_list_filled'))
        .width(this.imgWidth)
        .fillColor(this.imgColor)
        .draggable(false)
    }
    .id(this.btnId)
    .stateEffect(false)