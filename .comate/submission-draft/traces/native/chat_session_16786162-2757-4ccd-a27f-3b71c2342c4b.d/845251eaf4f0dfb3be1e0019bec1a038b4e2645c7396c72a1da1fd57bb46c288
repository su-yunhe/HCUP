# hilog 中的请求日志（songApi.ets 在发出请求前打印）
LOG_E1 = "Request personal fm"
LOG_E2 = "Request fm trash"
# 推荐结果全部被黑名单/去重过滤时 FMUtils 会补请求一次，这次补请求属于同一次操作
LOG_E1_RETRY = "Retry personal fm"


def log_count(driver, pattern: str) -> int:
    """应用日志域 0x1010 中包含 pattern 的行数，用来统计真实发出的网络请求。"""
    out = driver.shell("hilog -x -D 0x1010")
    return sum(1 for line in out.splitlines() if pattern in line)


def e1_ops(driver, pattern: str = LOG_E1) -> int:
    """推荐请求的“操作次数”：请求行数减去过滤后补请求的次数。"""
    out = driver.shell("hilog -x -D 0x1010").splitlines()
    return sum(1 for line in out if pattern in line) - sum(1 for line in out if LOG_E1_RETRY in line)