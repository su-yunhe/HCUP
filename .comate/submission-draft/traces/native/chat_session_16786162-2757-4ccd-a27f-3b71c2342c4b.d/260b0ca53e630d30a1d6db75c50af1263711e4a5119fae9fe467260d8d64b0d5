import { LogUtil, ToastUtil } from '@pura/harmony-utils'
import { getPersonalFM, trashFM } from '../../../api/songApi'
import { StorageConstants } from '../../constants/StorageConstants'
import { FMMode } from '../../entities/PersonalFM'
import { PlayQueue } from '../../entities/PlayQueue'
import { Song } from '../../entities/SongsResult'
import { playQueue, resumeMusic } from '../../functions/play/playControl'
import PreferencesUtils from '../data/PreferencesUtils'
import AVPlayerUtils from './AVPlayerUtils'
import PlayQueueUtils from './PlayQueueUtils'

/**
 * 私人FM 工具
 * FM 队列直接使用 PlayQueueUtils 的播放列表，进入时备份手动维护的播放列表，退出时还原
 */
const TAG = '[FMUtils] '
const pref = StorageConstants.QUEUE_PREF
const MAX_PLAY_FAIL = 3

class FMUtils {
  active: boolean = false
  mode: FMMode = 'DEFAULT'
  loading: boolean = false
  private backupQueue: Array<PlayQueue> = []
  private backupIndex: number = -1
  private blacklist: Array<number> = []
  // 请求序号，序号变化后到达的响应直接丢弃
  private reqSeq: number = 0
  // 正在进行的续拉请求（含预取）
  private fetching: Promise<boolean> | null = null
  private dislikeInFlight: boolean = false
  private playFailCount: number = 0

  /**
   * 冷启动时恢复私人FM状态（不自动请求、不自动播放）
   */
  async init() {
    try {
      this.active = await PreferencesUtils.getPreferenceValue<boolean>(pref, 'fmActive', false)
      const mode = await PreferencesUtils.getPreferenceValue<string>(pref, 'fmMode', 'DEFAULT')
      this.mode = (mode == 'FAMILIAR' || mode == 'EXPLORE') ? mode : 'DEFAULT'
      this.backupQueue = await PreferencesUtils.getPreferenceValue<Array<PlayQueue>>(pref, 'fmBackupQueue', [])
      this.backupIndex = await PreferencesUtils.getPreferenceValue<number>(pref, 'fmBackupIndex', -1)
      this.blacklist = await PreferencesUtils.getPreferenceValue<Array<number>>(pref, 'fmBlacklist', [])
    } catch (e) {
      LogUtil.error(TAG + '初始化私人FM失败: ' + e.message)
    }
    AppStorage.setOrCreate(StorageConstants.FM_ACTIVE, this.active)
    AppStorage.setOrCreate(StorageConstants.FM_MODE, this.mode)
    AppStorage.setOrCreate(StorageConstants.FM_LOADING, false)
  }

  /**
   * 点击私人FM卡片
   */
  async enter() {
    if (this.loading) {
      ToastUtil.showToast('正在加载, 请稍后')
      return
    }
    // 已在私人FM中且有当前歌曲：不重新请求，未播放/暂停时继续播放
    if (this.active && PlayQueueUtils.getQueueElement(PlayQueueUtils.currentQueueIndex)) {
      const isPlaying: boolean | undefined = AppStorage.get(StorageConstants.IS_PLAYING)
      const isPaused: boolean | undefined = AppStorage.get(StorageConstants.IS_PAUSED)
      if (!isPlaying) {
        this.play(PlayQueueUtils.currentQueueIndex)
      } else if (isPaused) {
        resumeMusic()
      }
      return
    }

    const seq = ++this.reqSeq
    this.fetching = null
    this.setLoading(true)
    let list: Array<PlayQueue> = []
    try {
      list = await this.request(this.mode, [])
    } catch (e) {
      LogUtil.error(TAG + '获取私人FM失败: ' + JSON.stringify(e))
    }
    if (seq != this.reqSeq) return
    this.setLoading(false)

    // 请求结束（无论成败）才进入私人FM并备份手动播放列表
    if (!this.active) {
      this.backupQueue = PlayQueueUtils.getQueue().slice()
      this.backupIndex = PlayQueueUtils.currentQueueIndex
      this.setActive(true)
    }
    this.playFailCount = 0
    if (list.length > 0) {
      PlayQueueUtils.replaceQueue(list, 0)
      this.play(0)
    } else {
      PlayQueueUtils.replaceQueue([], -1)
      ToastUtil.showToast('获取推荐歌曲失败')
    }
    await this.persist()
  }

  /**
   * 私人FM 下一首：队列中已有下一首直接播放，否则续拉推荐
   */
  async next() {
    if (!this.active) return
    const index = PlayQueueUtils.currentQueueIndex
    if (index + 1 < PlayQueueUtils.getQueueLength()) {
      this.play(index + 1)
      return
    }
    if (this.loading) return

    const seq = this.reqSeq
    this.setLoading(true)
    const ok = await this.fetchMore()
    if (seq != this.reqSeq) return
    this.setLoading(false)
    const current = PlayQueueUtils.currentQueueIndex
    if (ok && current + 1 < PlayQueueUtils.getQueueLength()) {
      this.play(current + 1)
    } else {
      ToastUtil.showToast('获取推荐歌曲失败')
    }
  }

  /**
   * 私人FM 中歌曲播放失败（如无播放地址），连续失败超过上限则停止
   */
  onPlayFailed() {
    this.playFailCount++
    if (this.playFailCount >= MAX_PLAY_FAIL) {
      this.playFailCount = 0
      ToastUtil.showToast('获取推荐歌曲失败')
      return
    }
    this.next()
  }

  onPlayStarted() {
    this.playFailCount = 0
  }

  /**
   * 不喜欢当前歌曲：上报服务端、加入本地黑名单，并切到下一首
   */
  async dislike() {
    if (!this.active || this.dislikeInFlight) return
    const index = PlayQueueUtils.currentQueueIndex
    const current = PlayQueueUtils.getQueueElement(index)
    if (!current) return
    const sid = current.song.id
    this.dislikeInFlight = true
    const report: Promise<boolean> = trashFM(sid).catch((e: Error) => {
      LogUtil.error(TAG + '不喜欢上报失败: ' + JSON.stringify(e))
      return false
    })
    if (!this.blacklist.includes(sid)) {
      this.blacklist.push(sid)
    }
    // 队列中尚未播放的同一首歌也移除
    const queue = PlayQueueUtils.getQueue()
    const filtered = queue.filter((item: PlayQueue, i: number) => i <= index || item.song.id != sid)
    if (filtered.length != queue.length) {
      PlayQueueUtils.replaceQueue(filtered, index)
    }
    this.persist()
    try {
      await this.next()
      await report
    } finally {
      this.dislikeInFlight = false
    }
  }

  /**
   * 切换私人FM模式并重新加载推荐队列
   */
  async switchMode(mode: FMMode) {
    if (!this.active || mode == this.mode || this.loading) return
    const seq = ++this.reqSeq
    this.fetching = null
    const hasOldQueue = PlayQueueUtils.getQueueLength() > 0
    this.setLoading(true)
    let list: Array<PlayQueue> = []
    try {
      list = await this.request(mode, [])
    } catch (e) {
      LogUtil.error(TAG + '切换私人FM模式失败: ' + JSON.stringify(e))
    }
    if (seq != this.reqSeq) return
    this.setLoading(false)
    if (list.length > 0) {
      this.setMode(mode)
      this.playFailCount = 0
      PlayQueueUtils.replaceQueue(list, 0)
      this.play(0)
    } else {
      // 有旧队列时保持原模式；没有旧队列时保留新模式
      if (!hasOldQueue) {
        this.setMode(mode)
      }
      ToastUtil.showToast('切换模式失败')
    }
    await this.persist()
  }

  /**
   * 退出私人FM：还原手动播放列表并播放进入前的那首
   */
  async exit() {
    if (!this.active) return
    const queue = this.backupQueue
    let index = this.backupIndex
    this.restore()
    if (queue.length > 0) {
      if (index < 0 || index >= queue.length) index = 0
      PlayQueueUtils.setIndex(index)
      // 先更新显示，再请求播放地址
      const item = queue[index]
      AppStorage.setOrCreate(StorageConstants.PLAY_MODE, item.playmode)
      AppStorage.setOrCreate(StorageConstants.PLAY_SONG, item.song)
      AppStorage.setOrCreate(StorageConstants.PLAY_ARTISTS, item.artists)
      if (item.playmode == 1 && item.picUrl) {
        AppStorage.setOrCreate(StorageConstants.PIC_URL, item.picUrl)
      }
      playQueue(index)
    } else {
      await this.stopAndClear()
    }
    await this.persist()
  }

  /**
   * 其他入口修改播放列表前调用：处于私人FM时先还原手动播放列表（不播放），并作废在途请求
   */
  onExternalQueueChange() {
    if (this.active) {
      this.restore()
      this.persist()
    } else if (this.loading) {
      this.reqSeq++
      this.setLoading(false)
    }
  }

  /**
   * 还原手动播放列表并退出私人FM（同步部分）
   */
  private restore() {
    this.reqSeq++
    this.fetching = null
    this.setLoading(false)
    this.setActive(false)
    let index = this.backupIndex
    if (index >= this.backupQueue.length) index = this.backupQueue.length - 1
    PlayQueueUtils.replaceQueue(this.backupQueue, index)
    this.backupQueue = []
    this.backupIndex = -1
  }

  private play(index: number) {
    playQueue(index)
    this.prefetch()
  }

  /**
   * 当前歌曲已是队尾时预取下一首，失败不提示
   */
  private prefetch() {
    if (!this.active || this.fetching) return
    if (PlayQueueUtils.currentQueueIndex < PlayQueueUtils.getQueueLength() - 1) return
    this.fetchMore()
  }

  /**
   * 续拉推荐并追加到队列，同一时间只有一个续拉请求
   */
  private fetchMore(): Promise<boolean> {
    if (this.fetching) return this.fetching
    const seq = this.reqSeq
    const mode = this.mode
    const task = async (): Promise<boolean> => {
      try {
        const list = await this.request(mode, PlayQueueUtils.getQueue())
        if (seq != this.reqSeq || !this.active || list.length == 0) return false
        PlayQueueUtils.replaceQueue(PlayQueueUtils.getQueue().concat(list), PlayQueueUtils.currentQueueIndex)
        return true
      } catch (e) {
        LogUtil.error(TAG + '续拉私人FM失败: ' + JSON.stringify(e))
        return false
      }
    }
    const promise = task()
    this.fetching = promise
    promise.finally(() => {
      if (this.fetching === promise) this.fetching = null
    })
    return promise
  }

  /**
   * 请求推荐：过滤黑名单和已在队列中的歌曲，过滤后为空时再请求一次
   */
  private async request(mode: FMMode, exclude: Array<PlayQueue>): Promise<Array<PlayQueue>> {
    for (let i = 0; i < 2; i++) {
      const list = await getPersonalFM(mode)
      if (list.length == 0) return []
      let result: Array<PlayQueue> = []
      for (let item of list) {
        const id = item.song.id
        if (this.blacklist.includes(id)) continue
        if (exclude.some((e: PlayQueue) => e.song.id == id)) continue
        if (result.some((e: PlayQueue) => e.song.id == id)) continue
        result.push(item)
      }
      if (result.length > 0) return result
    }
    return []
  }

  /**
   * 停止播放并显示“暂无播放”
   */
  private async stopAndClear() {
    try {
      await AVPlayerUtils.stop()
    } catch (e) {
      LogUtil.error(TAG + '停止播放失败: ' + JSON.stringify(e))
    }
    const song: Song = {
      id: 0,
      name: '暂无播放',
      artists: [],
      duration: 0,
      alias: [],
      fee: 0
    }
    AppStorage.setOrCreate(StorageConstants.IS_PLAYING, false)
    AppStorage.setOrCreate(StorageConstants.IS_PAUSED, true)
    AppStorage.setOrCreate(StorageConstants.PLAY_TIME, 0)
    AppStorage.setOrCreate(StorageConstants.PLAY_MODE, 0)
    AppStorage.setOrCreate(StorageConstants.PLAY_SONG, song)
    AppStorage.setOrCreate(StorageConstants.PLAY_ARTISTS, '选择一首歌曲播放吧')
    AppStorage.setOrCreate(StorageConstants.PIC_URL, '')
    AppStorage.setOrCreate('player-currentLyric', '')
    await PreferencesUtils.putPreferenceValue(pref, 'hasCurrentSong', false)
  }

  private setActive(active: boolean) {
    this.active = active
    AppStorage.setOrCreate(StorageConstants.FM_ACTIVE, active)
  }

  private setMode(mode: FMMode) {
    this.mode = mode
    AppStorage.setOrCreate(StorageConstants.FM_MODE, mode)
  }

  private setLoading(loading: boolean) {
    this.loading = loading
    AppStorage.setOrCreate(StorageConstants.FM_LOADING, loading)
  }

  private async persist() {
    await PreferencesUtils.putPreferenceValue(pref, 'fmActive', this.active)
    await PreferencesUtils.putPreferenceValue(pref, 'fmMode', this.mode)
    await PreferencesUtils.putPreferenceValue(pref, 'fmBackupQueue', this.backupQueue)
    await PreferencesUtils.putPreferenceValue(pref, 'fmBackupIndex', this.backupIndex)
    await PreferencesUtils.putPreferenceValue(pref, 'fmBlacklist', this.blacklist)
  }
}

const fmUtils: FMUtils = new FMUtils()
export default fmUtils as FMUtils
