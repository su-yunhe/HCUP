    13→const TAG = '[HTTPRequest]'
    14→
    15→export class HttpRequest {
    16→  private url: string = ''
    17→  private usingCache:boolean = true
    18→
    19→  constructor(url: string, usingCache?:boolean) {
    20→    this.url = url
