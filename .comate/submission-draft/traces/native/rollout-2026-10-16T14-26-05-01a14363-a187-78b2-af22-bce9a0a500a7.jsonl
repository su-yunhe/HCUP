nd.txt\\nlogs\\\\do-validation\\\\runner-v10.log\\nlogs\\\\do-validation\\\\runner-v10.json\\nlogs\\\\do-validation\\\\runner-v10.exit.txt\\nlogs\\\\do-validation\\\\runner-v10.command.txt\\nlogs\\\\do-validation\\\\runner-v1.log\\nlogs\\\\do-validation\\\\runner-v1.json\\nlogs\\\\do-validation\\\\runner-v1.exit.txt\\nlogs\\\\do-validation\\\\runner-v1.command.txt\\nlogs\\\\do-validation\\\\run-tests.ps1\\nlogs\\\\do-validation\\\\run-selected.py\\nlogs\\\\do-validation\\\\preparation-manifest.json\\nlogs\\\\do-validation\\\\preclean-ui-summary.json\\nlogs\\\\do-validation\\\\owned-hypium-ports.json\\nlogs\\\\reports\\\\2026-10-16-12-03-35\\\\task_log.log\\nlogs\\\\do-validation\\\\runner-v8.command.txt\\nlogs\\\\do-validation\\\\runner-v7.log\\nlogs\\\\do-validation\\\\runner-v7.command.txt\\nlogs\\\\do-validation\\\\runner-v6.log\\nlogs\\\\do-validation\\\\runner-v6.json\\nlogs\\\\do-validation\\\\runner-v6.exit.txt\\nlogs\\\\do-validation\\\\runner-v6.command.txt\\nlogs\\\\do-validation\\\\runner-v5.log\\nlogs\\\\do-validation\\\\runner-v5.json\\nlogs\\\\do-validation\\\\runner-v5.exit.txt\\nlogs\\\\do-validation\\\\runner-v5.command.txt\\nlogs\\\\do-validation\\\\runner-v4.log\\nlogs\\\\do-validation\\\\runner-v4.command.txt\\nlogs\\\\do-validation\\\\runner-v3.log\\nsystem-config\\\\do-stage\\\\agents\\\\harmony_verification.toml\\nsystem-config\\\\do-stage\\\\agents\\\\harmony_requirements.toml\\nsystem-config\\\\do-stage\\\\agents\\\\harmony_implementation.toml\\nsystem-config\\\\do-stage\\\\agents\\\\harmony_design.toml\\nlogs\\\\reports\\\\2026-10-16-11-50-32\\\\task_log.log\\nlogs\\\\do-validation\\\\offline-exit-code.txt\\nlogs\\\\do-validation\\\\offline-command.txt\\nlogs\\\\do-validation\\\\offline-final-exit-code.txt\\nlogs\\\\do-validation\\\\offline-smoke.log\\nlogs\\\\do-validation\\\\offline-smoke-final.log\\nlogs\\\\do-validation\\\\offline-smoke.py\\n\"}}\n{\"i\":1,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"eb9dde\",\"wall_time_seconds\":0.3233894,\"exit_code\":0,\"original_token_count\":1376,\"output\":\"# test-harness：通用自测框架\\r\\n\\r\\n目标：为每道题提供**统一**的设备连接、环境校验、Hypium 封装和测试运行/报告方式；\\r\\n各题自己的测试点（断言逻辑）单独编写，放在各题工程的 `hypium_tests/` 下，不属于本框架。\\r\\n\\r\\n本框架不是官方评测器，只用于本地自测，帮助在提交前用同款工具链（Hypium + hdc）验证功能，\\r\\n降低\\\"本地通过、正式评测翻车\\\"的概率。官方评测环境规格（Pura 90 Pro Max 模拟器、HarmonyOS 6.1.0 / API 23、\\r\\n1308 × 2880 / 560 dpi）已内置在 `harness/env_check.py` 中。\\r\\n\\r\\n## 目录结构\\r\\n\\r\\n```\\r\\ntest-harness/\\r\\n├── README.md                本文件\\r\\n├── requirements.txt         框架自身的 Python 依赖（hypium==6.1.0.210）\\r\\n└── harness/                 通用库，与赛题无关\\r\\n    ├── __init__.py\\r\\n    ├── device.py             设备发现、选择、连接（封装 hdc / UiDriver.connect）\\r\\n    ├── env_check.py          环境校验：对照官方模拟器规格，检查屏幕分辨率/dpi/系统版本\\r\\n    ├── driver.py             HarnessTestCase：带超时重试的查找/等待/断言辅助方法\\r\\n    ├── window.py             按窗口名从 hidumper 读取 [x y w h]（悬浮窗等不在 UI 树里的窗口）\\r\\n    ├── app.py                应用生命周期与导航：restart_app、click_text_path\\r\\n    ├── runner.py             测试运行器：发现并执行某道题工程下的测试文件，汇总报告\\r\\n    └── report.py             统一的结果报告：pass / fail / error / skip 分开统计，skip 不算通过\\r\\n```\\r\\n\\r\\n## 使用方式\\r\\n\\r\\n以下命令中 `COMMON` 指工作区的 `common/` 绝对路径，在题目工程目录里可用 `COMMON=\\\"$(cd ../common && pwd)\\\"` 得到。\\r\\n需要 `hdc` 在 PATH 中（DevEco 的 `sdk/default/openharmony/toolchains`）。\\r\\n\\r\\n### 1. 环境（每台机器建一次）\\r\\n\\r\\n`$COMMON/.venv` 不进仓库，按 `requirements.txt` 在本机创建：\\r\\n\\r\\n```bash\\r\\npython3 -m venv \\\"$COMMON/.venv\\\"\\r\\n\\\"$COMMON/.venv/bin/python\\\" -m pip install -r \\\"$COMMON/test-harness/requirements.txt\\\" \\\\\\r\\n    --index-url https://repo.huaweicloud.com/repository/pypi/simple\\r\\n```\\r\\n\\r\\n### 2. 校验模拟器是否匹配官方规格\\r\\n\\r\\n```bash\\r\\nPYTHONPATH=\\\"$COMMON/test-harness\\\" \\\"$COMMON/.venv/bin/python\\\" -m harness.env_check\\r\\n```\\r\\n\\r\\n不一致会给出告警，但不阻塞自测。\\r\\n\\r\\n### 3. 跑某道题的测试\\r\\n\\r\\n**先安装本题刚构建的 HAP。** 同一上游项目的多道题共用同一个 bundleName，\\r\\n模拟器上装的可能是别的题的产物，直接跑会测错对象。\\r\\n\\r\\n```bash\\r\\ncd <本题工程目录>/logs        # Hypium 会在当前目录生成 reports/，在 logs/ 下运行避免污染工程根目录\\r\\nPYTHONPATH=\\\"$COMMON/test-harness\\\" \\\"$COMMON/.venv/bin/python\\\" -m harness.runner \\\\\\r\\n    --project \\\"$(cd .. && pwd)\\\" --device <设备序列号> --json \\\"$PWD/selftest.json\\\"\\r\\n```\\r\\n\\r\\n`runner` 会：\\r\\n1. 调用 `env_check` 做一次环境校验并记录在报告头部（不阻塞；`--skip-env-check` 可跳过）\\r\\n2. 自动发现 `<project>/hypium_tests/test_*.py` 下的所有测试\\r\\n3. 执行并输出统一格式的通过/失败报告（终端 + 可选 JSON 文件）\\r\\n\\r\\n### 4. 给本题写测试点\\r\\n\\r\\n1. 在本题工程下建 `hypium_tests/__init__.py` 与 `hypium_tests/test_<场景>.py`\\r\\n2. 测试类继承 `harness.driver.HarnessTestCase`，可直接使用：\\r\\n   `self.driver`、`self.find_or_none()`、`self.require_component()`、`self.require_text()`、\\r\\n   `self.require_type()`、`self.require_precondition()`（前置不满足记为 skip，不算通过）\\r\\n3. 只写本题 Spec 描述的断言逻辑，不用关心设备连接、重试、报告格式\\r\\n\\r\\n建议在被测组件上设置稳定的 `.id()`，测试里用 `BY.key(\\\"<id>\\\")` 定位，比按文本或类型+顺序定位更稳。\\r\\n# Hypium 版本须与 docs/development.md 的官方参考版本一致：6.1.0.210\\r\\nhypium==6.1.0.210\\r\\n{\\r\\n  \\\"task_id\\\": \\\"vg-spec14\\\",\\r\\n  \\\"prepared_at\\\": \\\"2026-10-16T02:59:40.696733+00:00\\\",\\r\\n  \\\"project_root\\\": \\\"D:\\\\\\\\HCUP\\\\\\\\vg-spec14\\\",\\r\\n  \\\"branch\\\": \\\"vg-spec14\\\",\\r\\n  \\\"base_commit\\\": \\\"88db8789e28333c7b7dcc8db078f394a262b73c3\\\",\\r\\n  \\\"baseline_prepare\\\": {\\r\\n    \\\"result\\\": \\\"pass\\\",\\r\\n    \\\"log\\\": \\\"logs/prepare-baseline.log\\\"\\r\\n  },\\r\\n  \\\"ohpm_install\\\": {\\r\\n    \\\"result\\\": \\\"pass\\\",\\r\\n    \\\"log\\\": \\\"logs/ohpm-install.log\\\"\\r\\n  },\\r\\n  \\\"baseline_build\\\": {\\r\\n    \\\"result\\\": \\\"pass\\\",\\r\\n    \\\"exit_code\\\": 0,\\r\\n    \\\"command\\\": \\\"hvigorw assembleHap --mode module -p product=default -p buildMode=debug --no-daemon\\\",\\r\\n    \\\"log\\\": \\\"logs/baseline-build.log\\\",\\r\\n    \\\"warnings_recorded\\\": true,\\r\\n    \\\"warning_file_diagnostics\\\": 759,\\r\\n    \\\"sdk_declarations