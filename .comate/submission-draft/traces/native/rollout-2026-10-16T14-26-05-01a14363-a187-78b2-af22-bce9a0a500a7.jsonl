r\\n  \\\"baseline_source_warnings\\\": 759,\\r\\n  \\\"current_source_warnings\\\": 756,\\r\\n  \\\"same\\\": 724,\\r\\n  \\\"relocated\\\": 32,\\r\\n  \\\"removed\\\": [\\r\\n    {\\r\\n      \\\"file\\\": \\\"entry/src/main/ets/pages/settings/SettingsSyncSection.ets\\\",\\r\\n      \\\"line\\\": 301,\\r\\n      \\\"column\\\": 22,\\r\\n      \\\"category\\\": \\\"P1-deprecated-api\\\",\\r\\n      \\\"message\\\": \\\"'showToast' has been deprecated.\\\"\\r\\n    },\\r\\n    {\\r\\n      \\\"file\\\": \\\"entry/src/main/ets/pages/settings/SettingsSyncSection.ets\\\",\\r\\n      \\\"line\\\": 314,\\r\\n      \\\"column\\\": 7,\\r\\n      \\\"category\\\": \\\"P2-exception-handling\\\",\\r\\n      \\\"message\\\": \\\"Function may throw exceptions. Special handling is required.\\\"\\r\\n    },\\r\\n    {\\r\\n      \\\"file\\\": \\\"entry/src/main/ets/pages/settings/SettingsSyncSection.ets\\\",\\r\\n      \\\"line\\\": 314,\\r\\n      \\\"column\\\": 20,\\r\\n      \\\"category\\\": \\\"P1-deprecated-api\\\",\\r\\n      \\\"message\\\": \\\"'showToast' has been deprecated.\\\"\\r\\n    }\\r\\n  ],\\r\\n  \\\"added\\\": null,\\r\\n  \\\"signing_warnings\\\": null\\r\\n}\\r\\n\"}}\n{\"i\":2,\"status\":\"fulfilled\",\"value\":{\"chunk_id\":\"528502\",\"wall_time_seconds\":0.3818781,\"exit_code\":0,\"original_token_count\":4021,\"output\":\"\\\"\\\"\\\"Observable vg-spec14 checks, executed only after source/device handoff.\\r\\n\\r\\nRun from logs/ with common's harness.runner. The wrapper must install the freshly\\r\\nbuilt HAP, create rport 18164, set VG14_TEST_AUTHORIZED=1 and freeze production.\\r\\nNo device operation happens during import or offline discovery.\\r\\n\\\"\\\"\\\"\\r\\nfrom __future__ import annotations\\r\\n\\r\\nimport hashlib\\r\\nimport json\\r\\nimport os\\r\\nimport re\\r\\nimport subprocess\\r\\nimport threading\\r\\nimport time\\r\\nfrom pathlib import Path\\r\\n\\r\\nfrom hypium import BY\\r\\nfrom hypium.model.basic_data_type import InputTextMode\\r\\nfrom harness.driver import HarnessTestCase\\r\\n\\r\\nfrom .webdav_fixture import WebDavFixture, utc\\r\\n\\r\\nROOT = Path(__file__).resolve().parents[1]\\r\\nBUNDLE = \\\"io.qzz.weiyu\\\"\\r\\nIDS = {\\r\\n    \\\"home\\\": \\\"home_settings_entry\\\", \\\"entry\\\": \\\"settings_webdav_entry\\\",\\r\\n    \\\"page\\\": \\\"webdav_config_page\\\", \\\"endpoint\\\": \\\"webdav_endpoint_input\\\",\\r\\n    \\\"username\\\": \\\"webdav_username_input\\\", \\\"password\\\": \\\"webdav_password_input\\\",\\r\\n    \\\"sync_password\\\": \\\"webdav_sync_password_input\\\", \\\"remote\\\": \\\"webdav_remote_root_input\\\",\\r\\n    \\\"sync\\\": \\\"webdav_sync_now_button\\\", \\\"loading\\\": \\\"webdav_sync_loading\\\",\\r\\n    \\\"result\\\": \\\"webdav_action_result\\\", \\\"back\\\": \\\"settings_back_button\\\",\\r\\n    \\\"test\\\": \\\"webdav_test_button\\\", \\\"auto\\\": \\\"webdav_auto_sync_toggle\\\",\\r\\n    \\\"save\\\": \\\"webdav_save_button\\\",\\r\\n}\\r\\n\\r\\n\\r\\ndef source_fingerprint() -> dict[str, str]:\\r\\n    names = subprocess.check_output([\\\"git\\\", \\\"ls-files\\\", \\\"-z\\\"], cwd=ROOT).decode().split(\\\"\\\\0\\\")\\r\\n    paths = {p for p in names if p.startswith((\\\"entry/src/\\\", \\\"AppScope/\\\"))\\r\\n             or p.endswith((\\\".json5\\\", \\\"hvigorfile.ts\\\"))}\\r\\n    for path in (ROOT / \\\"entry/src\\\").rglob(\\\"*\\\"):\\r\\n        if path.is_file():\\r\\n            paths.add(path.relative_to(ROOT).as_posix())\\r\\n    return {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest()\\r\\n            for name in sorted(paths) if (ROOT / name).is_file()}\\r\\n\\r\\n\\r\\nclass WebDavSyncTests(HarnessTestCase):\\r\\n    @classmethod\\r\\n    def setUpClass(cls) -> None:\\r\\n        if os.environ.get(\\\"VG14_TEST_AUTHORIZED\\\") != \\\"1\\\":\\r\\n            raise RuntimeError(\\\"Source freeze and device handoff required: VG14_TEST_AUTHORIZED=1\\\")\\r\\n        cls.evidence = Path(os.environ.get(\\\"VG14_EVIDENCE\\\", ROOT / \\\"logs/do-validation/device-run-v1\\\"))\\r\\n        cls.evidence.mkdir(parents=True, exist_ok=True)\\r\\n        cls.before = source_fingerprint()\\r\\n        cls.first_launch_ready = False\\r\\n        (cls.evidence / \\\"source-before.json\\\").write_text(json.dumps(cls.before, indent=2), encoding=\\\"utf-8\\\")\\r\\n        cls.fixture = WebDavFixture(cls.evidence)\\r\\n        try:\\r\\n            super().setUpClass()\\r\\n            cls.driver.set_implicit_wait_time(0.1)\\r\\n        except BaseException:\\r\\n            cls.fixture.close()\\r\\n            raise\\r\\n\\r\\n    @classmethod\\r\\n    def tearDownClass(cls) -> None:\\r\\n        cls.fixture.close()\\r\\n        after = source_fingerprint()\\r\\n        (cls.evidence / \\\"source-after.json\\\").write_text(json.dumps(after, indent=2), encoding=\\\"utf-8\\\")\\r\\n        if cls.before != after:\\r\\n            raise AssertionError(\\\"Production fingerprint changed; affected evidence is invalid\\\")\\r\\n\\r\\n    def setUp(self) -> None:\\r\\n        self.assertEqual(self.before, source_fingerprint(), \\\"Source changed before test\\\")\\r\\n        self.fixture.release_all()\\r\\n        try:\\r\\n            self.driver.stop_app(BUNDLE)\\r\\n            self.driver.start_app(BUNDLE, page_name=\\\"EntryAbility\\\", wait_time=2)\\r\\n            if not self.__class__.first_launch_ready:\\r\\n                # Initial policy content loads asynchronously after the home entry.\\r\\n                consent = self.find_or_none(BY.text(\\\"同意并进入\\\"), timeout=6)\\r\\n                if consent is not None:\\r\\n                    self.event(\\\"first_launch_consent\\\", text=\\\"同意并进入\\\")\\r\\n                    self.driver.click(consent)\\r\\n                onboarding = self.find_or_none(BY.text(\\\"跳过\\\"), timeout=3)\\r\\n                if onboarding is not None:\\r\\n                    self.event(\\\"first_launch_onboarding\\\", text=\\\"跳过\\\")\\r\\n                    self.driver.click(onboarding)\\r\\n            self.enter_from_home()\\r\\n            self.__class__.first_launch_ready = True\\r\\n        except BaseException:\\r\\n            self.capture(\\\"setup-failed\\\")\\r\\n            raise\\r\\n\\r\\n    def tearDown(self) -> None:\\r\\n        try:\\r\\n            self.fixture.release_all()\\r\\n            self.capture(\\\"teardown\\\", screenshot=False)\\r\\n            self.assertEqual(self.before, source_fingerprint(), \\\"Source changed; invalidate evidence\\\")\\r\\n        finally:\\r\\n            self.fixture.release_all()\\r\\n\\r\\n    def event(self, event: str, **values) -> dict:\\r\\n        record = {\\\"utc\\\": utc(), \\\"monotonic_ns\\\": time.monotonic_ns(),\\r\\n                  \\\"test\\\": self._testMethodName, \\\"event\\\": event, **values}\\r\\n        with (self.evidence / \\\"ui-events.jsonl\\\").open(\\\"a\\\", encoding=\\\"utf-8\\\") as stream:\\r\\n            stream.write(json.dumps(record, ensure_ascii=False) + \\\"\\\\n\\\")\\r\\n        return record\\r\\n\\r\\n    def hdc(self, *arguments: str) -> str:\\r\\n        args = [\\\"hdc\\\", \\\"-t\\\", self.device_sn or os.environ[\\\"HDC_DEVICE\\\"], *arguments]\\r\\n        start = utc()\\r\\n        result = subprocess.run(args, capture_output=True, text=True, encoding=\\\"utf-8\\\", errors=\\\"replace\\\", timeout=35)\\r\\n        self.event(\\\"command\\\", start=start, argv=args, exit_code=result.returncode,\\r\\n                   stdout=result.stdout, stderr=result.stderr)\\r\\n        self.assertEqual(result.returncode, 0, str(args) + result.stderr)\\r\\n        self.assertNotRegex(result.stdout + result.stderr, r\\\"(?i)\\\\[fail\\\\]|error:\\\", \\\"hdc failed despite zero exit\\\")\\r\\n        return result.stdout\\r\\n\\r\\n    def component(self, name: str, scroll: bool = False):\\r\\n        by = BY.key(IDS[name])\\r\\n        if scroll:\\r\\n            found = self.driver.find_component(by)\\r\\n            if found is not None:\\r\\n                return found\\r\\n            # Use the documented gesture for the known form/action regions first;\\r\\n            # retain the exact stable selector and native scrollSearch fallback.\\r\\n            direction = \\\"DOWN\\\" if name in (\\\"endpoint\\\", \\\"username\\\", \\\"password\\\", \\\"sync_password\\\", \\\"remote\\\") else \\\"UP\\\"\\r\\n            self.driver.swipe(direction, distance=80, area=BY.type(\\\"Scroll\\\"), swipe_time=0.3)\\r\\n            found = self.driver.find_component(by)\\r\\n            if found is not None:\\r\\n                return found\\r\\n            found = self.driver.find_component(by, scroll_target=BY.type(\\\"Scroll\\\"))\\r\\n            if found is not None:\\r\\n                return found\\r\\n        return self.require_component(by, f\\\"Missing selector {IDS[name]}\\\", timeout=8)\\r\\n\\r\\n    def enter_from_home(self) -> None:\\r\\n        self.driver.click(self.component(\\\"home\\\"))\\r\\n        self.driver.click(self.component(\\\"entry\\\", scroll=True))\\r\\n        self.component(\\\"page\\\")\\r\\n\\r\\n    def configure(self, path: str = \\\"endpoint-a\\\", overrides: dict | None = None) -> None:\\r\\n        values = {\\\"endpoint\\\": f\\\"http://127.0.0.1:18164/{path}\\\", \\\"username\\\": \\\"vg14-local\\\",\\r\\n                  \\\"password\\\": \\\"fixture-only\\\", \\\"sync_password\\\": \\\"fixture-sync-14\\\", \\\"remote\\\": \\\"/sync\\\"}\\r\\n        values.update(overrides or {})\\r\\n        for name, value in values.items():\\r\\n            comp = self.component(name, scroll=True)\\r\\n            if value == \\\"\\\":\\r\\n                self.driver.clear_text(comp)\\r\\n            else:\\r\\n                self.driver.input_text(comp, value, mode=InputTextMode().paste(True))\\r\\n                self.driver.go_back()  # nonempty input uses the verified IME path\\r\\n            self.component(\\\"page\\\")\\r\\n        toggle = self.component(\\\"auto\\\", scroll=True)\\r\\n        if toggle.isChecked():\\r\\n            self.driver.click(toggle)\\r\\n        self.assertEqual(self.component(\\\"sync\\\", scroll=True).getText(), \\\"立即同步\\\")\\r\\n        self.event(\\\"configuration_ready\\\", endpoint=values[\\\"endpoint\\\"],\\r\\n                   username_present=bool(values[\\\"username\\\"].strip()), remote=values[\\\"remote\\\"],\\r\\n                   password_present=bool(values[\\\"password\\\"]), sync_password_present=bool(values[\\\"sync_password\\\"]))\\r\\n\\r\\n    def capture(self, label: str, screenshot: bool = True) -> dict:\\r\\n        stamp = str(time.monotonic_ns())\\r\\n        stem = f\\\"{self._testMethodName}-{label}-{stamp}\\\"\\r\\n        device_path = f\\\"/data/local/tmp/vg14-{stamp}.json\\\"\\r\\n        start = self.event(\\\"capture_start\\\", label=label)\\r\\n        self.hdc(\\\"shell\\\", \\\"uitest\\\", \\\"dumpLayout\\\", \\\"-p\\\", device_path)\\r\\n        target = self.evidence / f\\\"{stem}.json\\\"\\r\\n        self.hdc(\\\"file\\\", \\\"recv\\\", device_path, str(target))\\r\\n        tree = json.loads(target.read_text(encoding=\\\"utf-8-sig\\\"))\\r\\n        nodes: list[dict] = []\\r\\n\\r\\n        def visit(node):\\r\\n            if \\\"attributes\\\" in node:\\r\\n                nodes.append(node[\\\"attributes\\\"])\\r\\n            for child in node.get(\\\"children\\\", []):\\r\\n                visit(child)\\r\\n\\\"\\\"\\\"测试运行器：发现并执行某道题目录下的测试文件，汇总统一格式的报告。\\r\\n\\r\\n用法：\\r\\n    python -m harness.runner --project <本题工程目录> [--device <序列号>] [--json out.json]\\r\\n\\r\\n约定：被测项目目录下的 `hypium_tests/test_*.py` 为该题的测试文件，\\r\\n其中的测试类应继承 `harness.driver.HarnessTestCase`。\\r\\n\\\"\\\"\\\"\\r\\nfrom __future__ import annotations\\r\\n\\r\\nimport argparse\\r\\nimport sys\\r\\nimport unittest\\r\\nfrom pathlib import Path\\r\\n\\r\\nfrom . import device as device_mod\\r\\nfrom . import env_check\\r\\nfrom .report import RecordingResult, RunReport\\r\\n\\r\\n\\r\\ndef discover(project_dir: Path) -> unittest.TestSuite:\\r\\n    tests_dir = project_dir / \\\"hypium_tests\\\"\\r\\n    if not tests_dir.is_dir():\\r\\n        raise FileNotFoundError(\\r\\n            f\\\"未找到测试目录: {tests_dir}；请在该题工作目录下创建 hypium_tests/test_*.py\\\"\\r\\n        )\\r\\n    loader = unittest.TestLoader()\\r\\n    return loader.discover(start_dir=str(tests_dir), pattern=\\\"test_*.py\\\", top_level_dir=str(project_dir))\\r\\n\\r\\n\\r\\ndef _collect_case_names(suite: unittest.TestSuite) -> list[str]:\\r\\n    names = []\\r\\n    for test in suite:\\r\\n        if isinstance(test, unittest.TestSuite):\\r\\n            names.extend(_collect_case_names(test))\\r\\n        else:\\r\\n            names.append(str(test))\\r\\n    return names\\r\\n\\r\\n\\r\\ndef _inject_device_sn(suite: unittest.TestSuite, device_sn: str) -> None:\\r\\n    \\\"\\\"\\\"把设备序列号注入每个 HarnessTestCase 子类，供 setUpClass 使用。\\\"\\\"\\\"\\r\\n    for test in suite:\\r\\n        if isinstance(test, unittest.TestSuite):\\r\\n            _inject_device_sn(test, device_sn)\\r\\n        else:\\r\\n            test.__class__.device_sn = device_sn\\r\\n\\r\\n\\r\\ndef main(argv: list[str] | None = None) -> int:\\r\\n    parser = argparse.ArgumentParser(description=__doc__)\\r\\n    parser.add_argument(\\\"--project\\\", required=True, help=\\\"本题工程目录（绝对路径）\\\")\\r\\n    parser.add_argument(\\\"--device\\\", default=None, help=\\\"设备序列号，省略则要求唯一在线设备\\\")\\r\\n    parser.add_argument(\\\"--json\\\", default=None, help=\\\"将报告另存为 JSON 文件的路径\\\")\\r\\n    parser.add_argument(\\\"--skip-env-check\\\", action=\\\"store_true\\\", help=\\\"跳过环境规格校验\\\")\\r\\n    args = parser.parse_args(argv)\\r\\n\\r\\n    project_dir = Path(args.project).resolve()\\r\\n    device_sn = device_mod.select_device(args.device)\\r\\n\\r\\n    env_warnings: list[str] = []\\r\\n    if not args.skip_env_check:\\r\\n        env_warnings = env_check.check(device_sn).warnings\\r\\n\\r\\n    suite = discover(project_dir)\\r\\n    case_names = _collect_case_names(suite)\\r\\n    _inject_device_sn(suite, device_sn)\\r\\n\\r\\n    runner = unittest.TextTestRunner(verbosity=2, resultclass=RecordingResult)\\r\\n    result = runner.run(suite)\\r\\n\\r\\n    report = RunReport(\\r\\n        project=str(project_dir),\\r\\n        device_sn=device_sn,\\r\\n        env_warnings=env_warnings,\\r\\n        cases=result.to_cases(case_names),\\r\\n    )\\r\\n    report.print_summary()\\r\\n\\r\\n    if args.json:\\r\\n        Path(args.json).write_text(report.to_json(), encoding=\\\"utf-8\\\")\\r\\n        print(f\\\"\\\\n报告已保存: {args.json}\\\")\\r\\n\\r\\n    return 0 if report.failed == 0 else 1\\r\\n\\r\\n\\r\\nif __name__ == \\\"__main__\\\":\\r\\n    sys.exit(main())\\r\\n\\\"\\\"\\\"环境校验：对照 docs/development.md 中\\\"正式评测与自测模拟器配置\\\"一节，\\r\\n检查当前连接设备的系统版本、屏幕参数是否与官方评测环境一致。\\r\\n\\r\\n校验结果仅用于提示偏差，不阻塞测试执行——\\r\\n文档原文强调\\\"本地自测通过不代表正式测试通过\\\"，环境校验的作用是降低偏差，不是替代正式评测。\\r\\n\\\"\\\"\\\"\\r\\nfrom __future__ import annotations\\r\\n\\r\\nimport argparse\\r\\nimport re\\r\\nfrom dataclasses import dataclass\\r\\n\\r\\nfrom . import device\\r\\n\\r\\n# 官方评测环境规格，来源：docs/development.md 第93-103行\\\"正式评测与自测模拟器配置\\\"\\r\\nOFFICIAL_SPEC = {\\r\\n    \\\"model\\\": \\\"Pura 90 Pro Max\\\",\\r\\n    \\\"config\\\": \\\"PHEMU-FD00\\\",\\r\\n    \\\"os_version\\\": \\\"6.1.0\\\",\\r\\n    \\\"api_version\\\": \\\"23\\\",\\r\\n    \\\"image_version\\\": \\\"6.1.0.115\\\",\\r\\n    \\\"resolution\\\": (1308, 2880),\\r\\n    \\\"dpi\\\": 560,\\r\\n}\\r\\n\\r\\n\\r\\n@dataclass\\r\\nclass EnvCheckResult:\\r\\n    device_sn: str\\r\\n    software_version: str | None\\r\\n    resolution: tuple[int, int] | None\\r\\n    warnings: list[str]\\r\\n\\r\\n    @property\\r\\n    def matches_official(self) -> bool:\\r\\n        return not self.warnings\\r\\n\\r\\n\\r\\ndef _get_software_version(device_sn: str) -> str | None:\\r\\n    try:\\r\\n        out = device.shell(\\r\\n            device_sn, \\\"param\\\", \\\"get\\\", \\\"const.product.software.version\\\"\\r\\n        )\\r\\n    except Exception:\\r\\n        return None\\r\\n    return out.strip() or None\\r\\n\\r\\n\\r\\ndef _get_resolution(device_sn: str) -> tuple[int, int] | None:\\r\\n    \\\"\\\"\\\"从 hidumper 的窗口信息里解析屏幕分辨率（取 SCBDesktop/桌面窗口的 w/h）。\\\"\\\"\\\"\\r\\n    try:\\r\\n        out = device.shell(\\r\\n            device_sn, \\\"hidumper\\\", \\\"-s\\\", \\\"WindowManagerService\\\", \\\"-a\\\", \\\"-a\\\"\\r\\n        )\\r\\n    except Exception:\\r\\n        return None\\r\\n    # 形如: \\\"...[ 0    0    1308 2880 ] [ ... ]\\\"，取第一条分辨率合理的记录\\r\\n    for match in re.finditer(r\\\"\\\\[\\\\s*\\\\d+\\\\s+\\\\d+\\\\s+(\\\\d+)\\\\s+(\\\\d+)\\\\s*\\\\]\\\", out):\\r\\n        w, h = int(match.group(1)), int(match.group(2))\\r\\n        if w > 0 and h > 0:\\r\\n            return (w, h)\\r\\n    return None\\r\\n\\r\\n\\r\\ndef check(device_sn: str) -> EnvCheckResult:\\r\\n    warnings: list[str] = []\\r\\n\\r\\n    software_version = _get_software_version(device_sn)\\r\\n    if software_version is None:\\r\\n        warnings.append(\\\"无法读取设备系统版本（const.product.software.version）。\\\")\\r\\n    elif OFFICIAL_SPEC[\\\"image_version\\\"] not in software_version:\\r\\n        warnings.append(\\r\\n            f\\\"系统镜像版本为 {software_version!r}，\\\"\\r\\n            f\\\"官方评测使用 {OFFICIAL_SPEC['image_version']}（API {OFFICIAL_SPEC['api_version']}）。\\\"\\r\\n        )\\r\\n\\r\\n    resolution = _get_resolution(device_sn)\\r\\n    if resolution is None:\\r\\n        warnings.append(\\\"无法读取设备屏幕分辨率。\\\")\\r\\n    elif resolution != OFFICIAL_SPEC[\\\"resolution\\\"]:\\r\\n        warnings.append(\\r\\n            f\\\"屏幕分辨率为 {resolution}，官方评测使用 \\\"\\r\\n            f\\\"{OFFICIAL_SPEC['resolution']}（{OFFICIAL_SPEC['model']} / \\\"\\r\\n            f\\\"{OFFICIAL_SPEC['config']}）。请在 DevEco Studio Device Manager 中确认模拟器机型。\\\"\\r\\n        )\\r\\n\\r\\n    return EnvCheckResult(\\r\\n        device_sn=device_sn,\\r\\n        software_version=software_version,\\r\\n        resolution=resolution,\\r\\n        warnings=warnings,\\r\\n    )\\r\\n\\r\\n\\r\\ndef _main() -> None:\\r\\n    parser = argparse.ArgumentParser(description=__doc__)\\r\\n    parser.add_argument(\\\"--device\\\", default=None, help=\\\"设备序列号，省略则要求唯一在线设备\\\")\\r\\n    args = parser.parse_args()\\r\\n\\r\\n    device_sn = device.select_device(args.device)\\r\\n    result = check(device_sn)\\r\\n\\r\\n    print(f\\\"设备: {result.device_sn}\\\")\\r\\n    print(f\\\"系统版本: {result.software_version}\\\")\\r\\n    print(f\\\"屏幕分辨率: {result.resolution}\\\")\\r\\n    print(\\r\\n        f\\\"官方评测环境: {OFFICIAL_SPEC['model']} / {OFFICIAL_SPEC['config']} / \\\"\\r\\n        f\\\"HarmonyOS {OFFICIAL_SPEC['os_version']}（API {OFFICIAL_SPEC['api_version']}）/ \\\"\\r\\n        f\\\"镜像 {OFFICIAL_SPEC['image_version']} / {OFFICIAL_SPEC['resolution']} @ {OFFICIAL_SPEC['dpi']}dpi\\\"\\r\\n    )\\r\\n    if result.matches_official:\\r\\n        print(\\\"✓ 环境与官方评测规格一致。\\\")\\r\\n    else:\\r\\n        print(\\\"⚠ 发现以下偏差（不阻塞测试，仅供参考）：\\\")\\r\\n        for w in result.warnings:\\r\\n            print(f\\\"  - {w}\\\")\\r\\n\\r\\n\\r\\nif __name__ == \\\"__main__\\\":\\r\\n    _main()\\r\\n\"}}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a14363-a241-75f3-b411-259387245257","create_time":1792132062.8066664}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
