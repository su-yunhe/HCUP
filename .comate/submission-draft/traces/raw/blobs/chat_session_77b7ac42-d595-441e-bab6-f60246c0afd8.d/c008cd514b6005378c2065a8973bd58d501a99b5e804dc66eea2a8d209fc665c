   283→  private getSortedList(list: LocalSong[]): LocalSong[] {
   284→    return this.isSorted ?
   285→    [...list].sort((a, b) => a.songFile.localeCompare(b.songFile)) :
   286→    this.originalOrderList.filter(f => list.some(l => l.songFile === f.songFile))
   287→  }
