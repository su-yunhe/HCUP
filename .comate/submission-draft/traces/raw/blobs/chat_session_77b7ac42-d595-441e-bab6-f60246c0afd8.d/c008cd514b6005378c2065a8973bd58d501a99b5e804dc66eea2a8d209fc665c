   244→  private handelSearch() {
   245→    try {
   246→      this.selectedSongs = []
   247→      if (!this.searchKeyword) {
   248→        this.dataSourceFiltered.setData([])
   249→      }
   250→      const keyword = this.searchKeyword.trim().toLowerCase()
   251→      this.dataSourceFiltered.setData(this.localSongs.filter((item: LocalSong) => {
   252→        return item.songFile.toString().toLowerCase().includes(keyword)
   253→      }))
   254→    } catch (e) {
   255→      ToastUtil.showToast('搜索时出错')
   256→      LogUtil.error(TAG, 'Error while handelSearch: ' + e.message)
   257→    }
   258→  }
