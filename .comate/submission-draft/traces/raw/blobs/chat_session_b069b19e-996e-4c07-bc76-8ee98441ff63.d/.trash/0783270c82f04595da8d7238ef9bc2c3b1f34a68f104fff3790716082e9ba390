class SymTestCase(HarnessTestCase):
    """每个用例前强制停止并冷启动，用例之间互不影响。"""

    def setUp(self) -> None:
        restart_app(self.driver, BUNDLE, wait_time=2)
        self.require_component(BY.key("symbol_grid"), "冷启动后未出现符号网格")

    # ---------- 定位 ----------
    def key(self, key: str, timeout: float = 5):
        return self.require_component(BY.key(key), f"未找到组件 id={key}", timeout=timeout)

    def key_or_none(self, key: str, timeout: float = 1.5):
        return self.find_or_none(BY.key(key), timeout=timeout)

    def text_of(self, key: str) -> str:
        return self.key(key).getText()

    def tap(self, key: str, wait: float = 0.5) -> None:
        self.driver.click(self.key(key))
        self.driver.wait(wait)

    def bounds(self, key: str):
        b = self.key(key).getBounds()
        return (b.left, b.top, b.right, b.bottom)

    # ---------- 操作 ----------
    def open_panel(self) -> None:
        self.tap("ops_toggle", wait=0.8)
        self.key("ops_panel")

    def pick(self, group: str, name: str) -> None:
        self.tap(f"color_dot_{group}_{name}")

    def pick_strategy(self, name: str) -> None:
        seg = self.key("strategy_segment")
        texts = self.driver.find_all_components(BY.text(name)) or []
        sb = seg.getBounds()
        for t in texts:
            b = t.getBounds()
            if sb.top <= b.top and b.bottom <= sb.bottom:
                self.driver.click(t)
                self.driver.wait(0.8)
                return
        self.fail(f"SegmentButton 中未找到段 {name}")

