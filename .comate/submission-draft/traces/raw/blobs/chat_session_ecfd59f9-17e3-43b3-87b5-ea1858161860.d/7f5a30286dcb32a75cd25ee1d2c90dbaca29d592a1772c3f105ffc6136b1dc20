   137→    if (currentTime - this.lastRefreshTime < this.refreshCooldown) {
   138→      ToastUtil.showToast('操作过于频繁，请5秒后再试')
   139→    } else {
   140→      try {
   141→        Promise.all([
   142→          this.topList = await getTopList(),
   143→          this.personalizedList = await getPersonalizedList(),
   144→        ])
   145→        this.lastRefreshTime = currentTime
   146→        ToastUtil.showToast('刷新成功')
   147→      } catch (e) {
   148→        ToastUtil.showToast('内容刷新失败: ' + e.message)
   149→      }
   150→    }
   151→    this.isRefreshing = false
   152→  }
