   399→  private getGreeting(hour: number): string {
   400→    if (hour >= 5 && hour < 7) return '清晨好'
   401→    if (hour >= 7 && hour < 9) return '早上好'
   402→    if (hour >= 9 && hour < 11) return '上午好'
   403→    if (hour >= 11 && hour < 13) return '中午好'
   404→    if (hour >= 13 && hour < 18) return '下午好'
   405→    if (hour >= 18 && hour < 24) return '晚上好'
   406→    if (hour >= 0 && hour < 5) return '夜已深, 注意休息'
   407→    return '探索您喜爱的内容'
   408→  }
   409→}
