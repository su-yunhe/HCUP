@@ -0,0 +1 @@
+{"total": 2162, "data": [{"id": 3, "content": "十年生死两茫茫，不思量，自难忘。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 7, "content": "只愿君心似我心，定不负相思意。", "from": "李之仪《卜算子·我住长江头》", "poem_id": 432}, {"id": 19, "content": "身无彩凤双飞翼，心有灵犀一点通。", "from": "李商隐《无题·昨夜星辰昨夜风》", "poem_id": 207}, {"id": 27, "content": "此情可待成追忆？只是当时已惘然。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 28, "content": "自在飞花轻似梦，无边丝雨细如愁。", "from": "秦观《浣溪沙·漠漠轻寒上小楼》", "poem_id": 411}, {"id": 50, "content": "天涯地角有穷时，只有相思无尽处。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 51, "content": "夜月一帘幽梦，春风十里柔情。", "from": "秦观《八六子·倚危亭》", "poem_id": 406}, {"id": 52, "content": "落花人独立，微雨燕双飞。", "from": "晏几道《临江仙·梦后楼台高锁》", "poem_id": 374}, {"id": 54, "content": "行到水穷处，坐看云起时。", "from": "王维《终南别业》", "poem_id": 118}, {"id": 56, "content": "空山新雨后，天气晚来秋。", "from": "王维《山居秋暝》", "poem_id": 111}, {"id": 61, "content": "凤凰台上凤凰游，凤去台空江自流。", "from": "李白《登金陵凤凰台》", "poem_id": 171}, {"id": 63, "content": "红酥手，黄縢酒，满城春色宫墙柳。", "from": "陆游《钗头凤·红酥手》", "poem_id": 507}, {"id": 64, "content": "直道相思了无益，未妨惆怅是清狂。", "from": "李商隐《无题·重帏深下莫愁堂》", "poem_id": 215}, {"id": 67, "content": "劝君莫惜金缕衣，劝君惜取少年时。", "from": "杜秋娘《金缕衣》", "poem_id": 318}, {"id": 68, "content": "同是天涯沦落人，相逢何必曾相识！", "from": "白居易《琵琶行》", "poem_id": 68}, {"id": 77, "content": "春蚕到死丝方尽，蜡炬成灰泪始干。", "from": "李商隐《无题·相见时难别亦难》", "poem_id": 212}, {"id": 80, "content": "寂寞空庭春欲晚，梨花满地不开门。", "from": "刘方平《春怨》", "poem_id": 274}, {"id": 81, "content": "多情自古伤离别，更那堪冷落清秋节！", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 82, "content": "夜来幽梦忽还乡。小轩窗。正梳妆。相顾无言，惟有泪千行。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 83, "content": "海上生明月，天涯共此时。", "from": "张九龄《望月怀远》", "poem_id": 86}, {"id": 93, "content": "心似双丝网，中有千千结。", "from": "张先《千秋岁·数声鶗鴂》", "poem_id": 325}, {"id": 95, "content": "东风夜放花千树。更吹落、星如雨。", "from": "辛弃疾《青玉案·元夕》", "poem_id": 523}, {"id": 98, "content": "日日思君不见君，共饮长江水。", "from": "李之仪《卜算子·我住长江头》", "poem_id": 432}, {"id": 100, "content": "二十四桥明月夜，玉人何处教吹箫？", "from": "杜牧《寄扬州韩绰判官》", "poem_id": 290}, {"id": 103, "content": "锦瑟无端五十弦，一弦一柱思华年。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 108, "content": "美人卷珠帘，深坐颦蛾眉。", "from": "李白《怨情》", "poem_id": 232}, {"id": 111, "content": "泪眼问花花不语，乱红飞过秋千去。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 117, "content": "大江东去，浪淘尽，千古风流人物。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 122, "content": "白日放歌须纵酒，青春作伴好还乡。", "from": "杜甫《闻官军收河南河北》", "poem_id": 182}, {"id": 123, "content": "无可奈何花落去，似曾相识燕归来。", "from": "晏殊《浣溪沙·一曲新词酒一杯》", "poem_id": 333}, {"id": 131, "content": "天长地久有时尽，此恨绵绵无绝期。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 132, "content": "露从今夜白，月是故乡明。", "from": "杜甫《月夜忆舍弟》", "poem_id": 104}, {"id": 133, "content": "把酒祝东风。且共从容。", "from": "欧阳修《浪淘沙·把酒祝东风》", "poem_id": 355}, {"id": 135, "content": "酒入愁肠，化作相思泪。", "from": "范仲淹《苏幕遮·怀旧》", "poem_id": 323}, {"id": 142, "content": "相见时难别亦难，东风无力百花残。", "from": "李商隐《无题·相见时难别亦难》", "poem_id": 212}, {"id": 143, "content": "春心莫共花争发，一寸相思一寸灰！", "from": "李商隐《无题·飒飒东风细雨来》", "poem_id": 210}, {"id": 148, "content": "花无人戴，酒无人劝，醉也无人管。", "from": "黄公绍《青玉案·年年社日停针线》", "poem_id": 595}, {"id": 151, "content": "无边落木萧萧下，不尽长江滚滚来。", "from": "杜甫《登高》", "poem_id": 183}, {"id": 152, "content": "寻寻觅觅，冷冷清清，凄凄惨惨戚戚。", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 159, "content": "渐行渐远渐无书，水阔鱼沉何处问。", "from": "欧阳修《玉楼春·别后不知君远近》", "poem_id": 352}, {"id": 160, "content": "落叶他乡树，寒灯独夜人。", "from": "马戴《灞上秋居》", "poem_id": 157}, {"id": 161, "content": "旧时王谢堂前燕，飞入寻常百姓家。", "from": "刘禹锡《乌衣巷》", "poem_id": 278}, {"id": 165, "content": "洛阳亲友如相问，一片冰心在玉壶。", "from": "王昌龄《芙蓉楼送辛渐》", "poem_id": 262}, {"id": 166, "content": "无情不似多情苦，一寸还成千万缕。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 170, "content": "会当凌绝顶，一览众山小。", "from": "杜甫《望岳》", "poem_id": 6}, {"id": 186, "content": "劝君更尽一杯酒，西出阳关无故人。", "from": "王维《送元二使安西》", "poem_id": 310}, {"id": 189, "content": "沧海月明珠有泪，蓝田日暖玉生烟。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 190, "content": "多情只有春庭月，犹为离人照落花。", "from": "张泌《寄人》", "poem_id": 308}, {"id": 192, "content": "晚来天欲雪，能饮一杯无？", "from": "白居易《问刘十九》", "poem_id": 244}, {"id": 211, "content": "故人西辞黄鹤楼，烟花三月下扬州。", "from": "李白《黄鹤楼送孟浩然之广陵》", "poem_id": 266}, {"id": 214, "content": "青枫江上秋帆远，白帝城边古木疏。", "from": "高适《送李少府贬峡中王少府贬长沙》", "poem_id": 172}, {"id": 218, "content": "出师未捷身先死，长使英雄泪满襟。", "from": "杜甫《蜀相》", "poem_id": 179}, {"id": 221, "content": "商女不知亡国恨，隔江犹唱后庭花。", "from": "杜牧《泊秦淮》", "poem_id": 289}, {"id": 224, "content": "昨夜星辰昨夜风，画楼西畔桂堂东。", "from": "李商隐《无题·昨夜星辰昨夜风》", "poem_id": 207}, {"id": 225, "content": "绿蚁新醅酒，红泥小火炉。", "from": "白居易《问刘十九》", "poem_id": 244}, {"id": 232, "content": "近乡情更怯，不敢问来人。", "from": "宋之问《渡汉江》", "poem_id": 248}, {"id": 235, "content": "君问归期未有期，巴山夜雨涨秋池。", "from": "李商隐《夜雨寄北》", "poem_id": 296}, {"id": 237, "content": "十年一觉扬州梦，赢得青楼薄幸名。", "from": "杜牧《遣怀》", "poem_id": 291}, {"id": 238, "content": "天生我材必有用，千金散尽还复来。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 239, "content": "我住长江头，君住长江尾。", "from": "李之仪《卜算子·我住长江头》", "poem_id": 432}, {"id": 242, "content": "执手相看泪眼，竟无语凝噎。", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 246, "content": "明月松间照，清泉石上流。", "from": "王维《山居秋暝》", "poem_id": 111}, {"id": 248, "content": "忽见陌头杨柳色，悔教夫婿觅封侯。", "from": "王昌龄《闺怨》", "poem_id": 263}, {"id": 256, "content": "满目山河空念远，落花风雨更伤春。", "from": "晏殊《浣溪沙·一向年光有限身》", "poem_id": 334}, {"id": 264, "content": "去年花里逢君别，今日花开已一年。", "from": "韦应物《寄李儋元锡》", "poem_id": 196}, {"id": 274, "content": "绿杨烟外晓寒轻，红杏枝头春意闹。", "from": "宋祁《玉楼春·春景》", "poem_id": 345}, {"id": 281, "content": "嫦娥应悔偷灵药，碧海青天夜夜心。", "from": "李商隐《嫦娥》", "poem_id": 301}, {"id": 289, "content": "老来情味减，对别酒、怯流年。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 294, "content": "情人怨遥夜，竟夕起相思。", "from": "张九龄《望月怀远》", "poem_id": 86}, {"id": 297, "content": "似花还似非花，也无人惜从教坠。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 298, "content": "舞低杨柳楼心月，歌尽桃花扇底风。", "from": "晏几道《鹧鸪天·彩袖殷勤捧玉钟》", "poem_id": 377}, {"id": 301, "content": "春潮带雨晚来急，野渡无人舟自横。", "from": "韦应物《滁州西涧》", "poem_id": 270}, {"id": 312, "content": "当君怀归日，是妾断肠时。", "from": "李白《春思》", "poem_id": 5}, {"id": 313, "content": "天阶夜色凉如水，卧看牵牛织女星。", "from": "杜牧《秋夕》", "poem_id": 292}, {"id": 319, "content": "忽如一夜春风来，千树万树梨花开。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 323, "content": "红豆生南国，春来发几枝。", "from": "王维《相思》", "poem_id": 225}, {"id": 326, "content": "千金纵买相如赋，脉脉此情谁诉。", "from": "辛弃疾《摸鱼儿·更能消几番风雨》", "poem_id": 519}, {"id": 327, "content": "红颜未老恩先断，斜倚薰笼坐到明。", "from": "白居易《后宫词》", "poem_id": 280}, {"id": 328, "content": "缺月挂疏桐，漏断人初静。", "from": "苏轼《卜算子·黄州定慧院寓居作》", "poem_id": 396}, {"id": 334, "content": "想当年，金戈铁马，气吞万里如虎。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 339, "content": "当时明月在，曾照彩云归。", "from": "晏几道《临江仙·梦后楼台高锁》", "poem_id": 374}, {"id": 340, "content": "今宵酒醒何处？杨柳岸，晓风残月。", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 341, "content": "莫道不销魂，帘卷西风，人比黄花瘦。", "from": "李清照《醉花阴·薄雾浓云愁永昼》", "poem_id": 627}, {"id": 344, "content": "云母屏风烛影深，长河渐落晓星沉。", "from": "李商隐《嫦娥》", "poem_id": 301}, {"id": 359, "content": "感时花溅泪，恨别鸟惊心。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 360, "content": "千山鸟飞绝，万径人踪灭。", "from": "柳宗元《江雪》", "poem_id": 242}, {"id": 373, "content": "孤舟蓑笠翁，独钓寒江雪。", "from": "柳宗元《江雪》", "poem_id": 242}, {"id": 384, "content": "鸟宿池边树，僧敲月下门。", "from": "贾岛《题李凝幽居》", "poem_id": 165}, {"id": 387, "content": "风吹柳花满店香，吴姬压酒唤客尝。", "from": "李白《金陵酒肆留别》", "poem_id": 51}, {"id": 388, "content": "人生得意须尽欢，莫使金樽空对月。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 391, "content": "星垂平野阔，月涌大江流。", "from": "杜甫《旅夜书怀》", "poem_id": 108}, {"id": 396, "content": "梧桐叶上三更雨，叶叶声声是别离。", "from": "周紫芝《鹧鸪天·一点残红欲尽时》", "poem_id": 480}, {"id": 403, "content": "国破山河在，城春草木深。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 408, "content": "人世几回伤往事，山形依旧枕寒流。", "from": "刘禹锡《西塞山怀古》", "poem_id": 201}, {"id": 419, "content": "愿君多采撷，此物最相思。", "from": "王维《相思》", "poem_id": 225}, {"id": 432, "content": "浮生只合尊前老。雪满长安道。", "from": "舒亶《虞美人·寄公度》", "poem_id": 424}, {"id": 436, "content": "殷勤花下同携手。更尽杯中酒。美人不用敛蛾眉。", "from": "叶梦得《虞美人·雨后同干誉才卿置酒来禽花下作》", "poem_id": 471}, {"id": 445, "content": "遥想公瑾当年，小乔初嫁了，雄姿英发。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 448, "content": "明月出天山，苍茫云海间。", "from": "李白《关山月》", "poem_id": 36}, {"id": 453, "content": "众里寻他千百度。蓦然回首，那人却在，灯火阑珊处。", "from": "辛弃疾《青玉案·元夕》", "poem_id": 523}, {"id": 468, "content": "野旷天低树，江清月近人。", "from": "孟浩然《宿建德江》", "poem_id": 229}, {"id": 470, "content": "烟笼寒水月笼沙，夜泊秦淮近酒家。", "from": "杜牧《泊秦淮》", "poem_id": 289}, {"id": 479, "content": "青山隐隐水迢迢，秋尽江南草未凋。", "from": "杜牧《寄扬州韩绰判官》", "poem_id": 290}, {"id": 492, "content": "春未绿，鬓先丝。人间别久不成悲。", "from": "姜夔《鹧鸪天·元夕有所梦》", "poem_id": 527}, {"id": 493, "content": "醉别西楼醒不记。春梦秋云，聚散真容易。", "from": "晏几道《蝶恋花·醉别西楼醒不记》", "poem_id": 376}, {"id": 501, "content": "零落成泥碾作尘，只有香如故。", "from": "陆游《卜算子·咏梅》", "poem_id": 504}, {"id": 504, "content": "海日生残夜，江春入旧年。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 516, "content": "一向年光有限身。等闲离别易销魂。酒筵歌席莫辞频。", "from": "晏殊《浣溪沙·一向年光有限身》", "poem_id": 334}, {"id": 520, "content": "驿外断桥边，寂寞开无主。", "from": "陆游《卜算子·咏梅》", "poem_id": 504}, {"id": 522, "content": "衣带渐宽终不悔，为伊消得人憔悴。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 528, "content": "白日依山尽，黄河入海流。", "from": "王之涣《登鹳雀楼》", "poem_id": 234}, {"id": 539, "content": "两鬓可怜青，只为相思老。", "from": "晏几道《生查子·关山魂梦长》", "poem_id": 380}, {"id": 542, "content": "总为浮云能蔽日，长安不见使人愁。", "from": "李白《登金陵凤凰台》", "poem_id": 171}, {"id": 549, "content": "琵琶弦上说相思。当时明月在，曾照彩云归。", "from": "晏几道《临江仙·梦后楼台高锁》", "poem_id": 374}, {"id": 552, "content": "山随平野尽，江入大荒流。", "from": "李白《渡荆门送别》", "poem_id": 96}, {"id": 556, "content": "白发悲花落，青云羡鸟飞。", "from": "岑参《寄左省杜拾遗》", "poem_id": 94}, {"id": 557, "content": "东风不与周郎便，铜雀春深锁二乔。", "from": "杜牧《赤壁》", "poem_id": 288}, {"id": 559, "content": "银烛秋光冷画屏，轻罗小扇扑流萤。", "from": "杜牧《秋夕》", "poem_id": 292}, {"id": 561, "content": "谁教岁岁红莲夜，两处沉吟各自知。", "from": "姜夔《鹧鸪天·元夕有所梦》", "poem_id": 527}, {"id": 563, "content": "高楼目尽欲黄昏，梧桐叶上萧萧雨。", "from": "晏殊《踏莎行·碧海无波》", "poem_id": 342}, {"id": 565, "content": "此去经年，应是良辰好景虚设。", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 572, "content": "云横秦岭家何在？雪拥蓝关马不前。", "from": "韩愈《左迁至蓝关示侄孙湘》", "poem_id": 174}, {"id": 585, "content": "愁肠已断无由醉，酒未到，先成泪。", "from": "范仲淹《御街行·秋日怀旧》", "poem_id": 324}, {"id": 586, "content": "浮云游子意，落日故人情。", "from": "李白《送友人》", "poem_id": 97}, {"id": 592, "content": "郁孤台下清江水，中间多少行人泪？", "from": "辛弃疾《菩萨蛮·书江西造口壁》", "poem_id": 525}, {"id": 599, "content": "二十余年如一梦，此身虽在堪惊。", "from": "陈与义《临江仙·夜登小阁忆洛中旧游》", "poem_id": 477}, {"id": 603, "content": "明月楼高休独倚。酒入愁肠，化作相思泪。", "from": "范仲淹《苏幕遮·怀旧》", "poem_id": 323}, {"id": 606, "content": "沙上并禽池上暝。云破月来花弄影。", "from": "张先《天仙子·水调数声持酒听》", "poem_id": 329}, {"id": 617, "content": "谁谓伤心画不成，画人心逐世人情。", "from": "韦庄《金陵图》", "poem_id": 306}, {"id": 629, "content": "相思本是无凭语，莫向花笺费泪行。", "from": "晏几道《鹧鸪天·醉拍春衫惜旧香》", "poem_id": 378}, {"id": 632, "content": "仍怜故乡水，万里送行舟。", "from": "李白《渡荆门送别》", "poem_id": 96}, {"id": 645, "content": "登高壮观天地间，大江茫茫去不还。", "from": "李白《庐山谣寄卢侍御虚舟》", "poem_id": 49}, {"id": 649, "content": "当时轻别意中人，山长水远知何处。", "from": "晏殊《踏莎行·碧海无波》", "poem_id": 342}, {"id": 652, "content": "千古江山，英雄无觅，孙仲谋处。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 663, "content": "昨夜雨疏风骤，浓睡不消残酒。", "from": "李清照《如梦令·昨夜雨疏风骤》", "poem_id": 625}, {"id": 673, "content": "待到重阳日，还来就菊花。", "from": "孟浩然《过故人庄》", "poem_id": 123}, {"id": 677, "content": "一曲新词酒一杯，去年天气旧亭台。", "from": "晏殊《浣溪沙·一曲新词酒一杯》", "poem_id": 333}, {"id": 678, "content": "晚年唯好静，万事不关心。", "from": "王维《酬张少府》", "poem_id": 114}, {"id": 687, "content": "客路青山外，行舟绿水前。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 688, "content": "空山不见人，但闻人语响。", "from": "王维《鹿柴》", "poem_id": 222}, {"id": 689, "content": "青山遮不住，毕竟东流去。", "from": "辛弃疾《菩萨蛮·书江西造口壁》", "poem_id": 525}, {"id": 696, "content": "东篱把酒黄昏后，有暗香盈袖。", "from": "李清照《醉花阴·薄雾浓云愁永昼》", "poem_id": 627}, {"id": 706, "content": "独坐幽篁里，弹琴复长啸。", "from": "王维《竹里馆》", "poem_id": 223}, {"id": 708, "content": "移舟泊烟渚，日暮客愁新。", "from": "孟浩然《宿建德江》", "poem_id": 229}, {"id": 711, "content": "孤帆远影碧空尽，唯见长江天际流。", "from": "李白《黄鹤楼送孟浩然之广陵》", "poem_id": 266}, {"id": 714, "content": "寒雨连江夜入吴，平明送客楚山孤。", "from": "王昌龄《芙蓉楼送辛渐》", "poem_id": 262}, {"id": 715, "content": "万壑树参天，千山响杜鹃。", "from": "王维《送梓州李使君》", "poem_id": 116}, {"id": 719, "content": "月下飞天镜，云生结海楼。", "from": "李白《渡荆门送别》", "poem_id": 96}, {"id": 731, "content": "深林人不知，明月来相照。", "from": "王维《竹里馆》", "poem_id": 223}, {"id": 736, "content": "绿杨芳草长亭路。年少抛人容易去。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 740, "content": "明日隔山岳，世事两茫茫。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 746, "content": "不知何处吹芦管，一夜征人尽望乡。", "from": "李益《夜上受降城闻笛》", "poem_id": 277}, {"id": 747, "content": "世事茫茫难自料，春愁黯黯独成眠。", "from": "韦应物《寄李儋元锡》", "poem_id": 196}, {"id": 749, "content": "庭院深深深几许，杨柳堆烟，帘幕无重数。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 752, "content": "飘飘何所似，天地一沙鸥。", "from": "杜甫《旅夜书怀》", "poem_id": 108}, {"id": 756, "content": "瀚海阑干百丈冰，愁云惨淡万里凝。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 758, "content": "这次第，怎一个愁字了得！", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 761, "content": "山回路转不见君，雪上空留马行处。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 765, "content": "蜀江水碧蜀山青，圣主朝朝暮暮情。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 769, "content": "竹外一枝斜，想佳人，天寒日暮。", "from": "曹组《蓦山溪·梅》", "poem_id": 487}, {"id": 772, "content": "欲穷千里目，更上一层楼。", "from": "王之涣《登鹳雀楼》", "poem_id": 234}, {"id": 793, "content": "别后不知君远近。触目凄凉多少闷。", "from": "欧阳修《玉楼春·别后不知君远近》", "poem_id": 352}, {"id": 799, "content": "扣舷独啸，不知今夕何夕。", "from": "张孝祥《念奴娇·过洞庭》", "poem_id": 497}, {"id": 801, "content": "忆昔午桥桥上饮，坐中多是豪英。", "from": "陈与义《临江仙·夜登小阁忆洛中旧游》", "poem_id": 477}, {"id": 802, "content": "绿酒初尝人易醉。一枕小窗浓睡。", "from": "晏殊《清平乐·金风细细》", "poem_id": 336}, {"id": 807, "content": "为君持酒劝斜阳，且向花间留晚照。", "from": "宋祁《玉楼春·春景》", "poem_id": 345}, {"id": 819, "content": "离愁渐远渐无穷，迢迢不断如春水。", "from": "欧阳修《踏莎行·候馆梅残》", "poem_id": 348}, {"id": 822, "content": "风暖鸟声碎，日高花影重。", "from": "杜荀鹤《春宫怨》", "poem_id": 162}, {"id": 823, "content": "春宵苦短日高起，从此君王不早朝。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 844, "content": "白头宫女在，闲坐说玄宗。", "from": "元稹《行宫》", "poem_id": 243}, {"id": 849, "content": "独怜幽草涧边生，上有黄鹂深树鸣。", "from": "韦应物《滁州西涧》", "poem_id": 270}, {"id": 852, "content": "断送一生憔悴，只销几个黄昏。", "from": "赵令畤《清平乐·春风依旧》", "poem_id": 417}, {"id": 856, "content": "过眼年华，动人幽意，相逢几番春换。", "from": "王沂孙《法曲献仙音·聚景亭梅次草窗韵》", "poem_id": 620}, {"id": 859, "content": "楼头残梦五更钟，花底离情三月雨。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 863, "content": "请君试问东流水，别意与之谁短长。", "from": "李白《金陵酒肆留别》", "poem_id": 51}, {"id": 865, "content": "绿树村边合，青山郭外斜。", "from": "孟浩然《过故人庄》", "poem_id": 123}, {"id": 886, "content": "荷风送香气，竹露滴清响。", "from": "孟浩然《夏日南亭怀辛大》", "poem_id": 17}, {"id": 893, "content": "终南阴岭秀，积雪浮云端。", "from": "祖咏《终南望余雪》", "poem_id": 228}, {"id": 901, "content": "欸乃一声山水绿。回看天际下中流，岩上无心云相逐。", "from": "柳宗元《渔翁》", "poem_id": 66}, {"id": 904, "content": "闺中少妇不知愁，春日凝妆上翠楼。", "from": "王昌龄《闺怨》", "poem_id": 263}, {"id": 909, "content": "故人江海别，几度隔山川。", "from": "司空曙《云阳馆与韩绅宿别》", "poem_id": 142}, {"id": 915, "content": "故园东望路漫漫，双袖龙钟泪不干。", "from": "岑参《逢入京使》", "poem_id": 268}, {"id": 926, "content": "玉容寂寞泪阑干，梨花一枝春带雨。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 933, "content": "欲为圣明除弊事，肯将衰朽惜残年。", "from": "韩愈《左迁至蓝关示侄孙湘》", "poem_id": 174}, {"id": 937, "content": "卧龙跃马终黄土，人事音书漫寂寥。", "from": "杜甫《阁夜》", "poem_id": 186}, {"id": 942, "content": "唯有长江水，无语东流。", "from": "柳永《八声甘州·对潇潇暮雨洒江天》", "poem_id": 367}, {"id": 945, "content": "西北望长安，可怜无数山。", "from": "辛弃疾《菩萨蛮·书江西造口壁》", "poem_id": 525}, {"id": 947, "content": "青山横北郭，白水绕东城。", "from": "李白《送友人》", "poem_id": 97}, {"id": 952, "content": "潮平两岸阔，风正一帆悬。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 956, "content": "黄河之水天上来，奔流到海不复回。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 957, "content": "寒蝉凄切，对长亭晚，骤雨初歇。", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 962, "content": "年年陌上生秋草，日日楼中到夕阳。", "from": "晏几道《鹧鸪天·醉拍春衫惜旧香》", "poem_id": 378}, {"id": 971, "content": "北风卷地白草折，胡天八月即飞雪。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 973, "content": "回首向来萧瑟处，归去，也无风雨也无晴。", "from": "苏轼《定风波·莫听穿林打叶声》", "poem_id": 399}, {"id": 977, "content": "苦恨年年压金线，为他人作嫁衣裳。", "from": "秦韬玉《贫女》", "poem_id": 220}, {"id": 978, "content": "昔别君未婚，儿女忽成行。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 984, "content": "载酒买花年少事，浑不似，旧心情。", "from": "卢祖皋《江城子·画楼帘暮卷新晴》", "poem_id": 562}, {"id": 985, "content": "夜雨剪春韭，新炊间黄粱。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 992, "content": "冰簟银床梦不成，碧天如水夜云轻。", "from": "温庭筠《瑶瑟怨》", "poem_id": 303}, {"id": 993, "content": "群芳过后西湖好，狼籍残红。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 994, "content": "人生有情泪沾臆，江水江花岂终极！", "from": "杜甫《哀江头》", "poem_id": 84}, {"id": 996, "content": "休说鲈鱼堪脍，尽西风，季鹰归未？", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 998, "content": "人生如梦，一尊还酹江月。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 1000, "content": "江晚正愁余，山深闻鹧鸪。", "from": "辛弃疾《菩萨蛮·书江西造口壁》", "poem_id": 525}, {"id": 1002, "content": "漠漠轻寒上小楼。晓阴无赖似穷秋。淡烟流水画屏幽。", "from": "秦观《浣溪沙·漠漠轻寒上小楼》", "poem_id": 411}, {"id": 1008, "content": "开轩面场圃，把酒话桑麻。", "from": "孟浩然《过故人庄》", "poem_id": 123}, {"id": 1017, "content": "落絮无声春堕泪，行云有影月含羞。", "from": "吴文英《浣溪沙·门隔花深梦旧游》", "poem_id": 573}, {"id": 1018, "content": "春如旧。人空瘦。泪痕红浥鲛绡透。", "from": "陆游《钗头凤·红酥手》", "poem_id": 507}, {"id": 1025, "content": "一蓑烟雨任平生。", "from": "苏轼《定风波·莫听穿林打叶声》", "poem_id": 399}, {"id": 1026, "content": "知否，知否？应是绿肥红瘦。", "from": "李清照《如梦令·昨夜雨疏风骤》", "poem_id": 625}, {"id": 1038, "content": "欲黄昏。雨打梨花深闭门。", "from": "李重元《忆王孙·春词》", "poem_id": 483}, {"id": 1039, "content": "惊起却回头，有恨无人省。", "from": "苏轼《卜算子·黄州定慧院寓居作》", "poem_id": 396}, {"id": 1041, "content": "相顾无言，惟有泪千行。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 1042, "content": "剑外忽传收蓟北，初闻涕泪满衣裳。", "from": "杜甫《闻官军收河南河北》", "poem_id": 182}, {"id": 1044, "content": "金陵津渡小山楼，一宿行人自可愁。", "from": "张祜《题金陵渡》", "poem_id": 284}, {"id": 1045, "content": "一场愁梦酒醒时，斜阳却照深深院。", "from": "晏殊《踏莎行·小径红稀》", "poem_id": 341}, {"id": 1047, "content": "寄语东阳沽酒市，拼一醉，而今乐事他年泪。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 1055, "content": "挥手自兹去，萧萧班马鸣。", "from": "李白《送友人》", "poem_id": 97}, {"id": 1057, "content": "行尽江南，不与离人遇。", "from": "晏几道《蝶恋花·梦入江南烟水路》", "poem_id": 375}, {"id": 1061, "content": "不见又思量，见了还依旧。", "from": "李之仪《谢池春·残寒销尽》", "poem_id": 431}, {"id": 1062, "content": "写不成书，只寄得、相思一点。", "from": "张炎《解连环·孤雁》", "poem_id": 611}, {"id": 1069, "content": "楚天千里清秋，水随天去秋无际。", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 1071, "content": "昔闻洞庭水，今上岳阳楼。", "from": "杜甫《登岳阳楼》", "poem_id": 109}, {"id": 1072, "content": "三山半落青天外，二水中分白鹭洲。", "from": "李白《登金陵凤凰台》", "poem_id": 171}, {"id": 1076, "content": "蓬山此去无多路，青鸟殷勤为探看。", "from": "李商隐《无题·相见时难别亦难》", "poem_id": 212}, {"id": 1099, "content": "翠叶藏莺，朱帘隔燕。", "from": "晏殊《踏莎行·小径红稀》", "poem_id": 341}, {"id": 1121, "content": "可堪孤馆闭春寒，杜鹃声里斜阳暮。", "from": "秦观《踏莎行·郴州旅舍》", "poem_id": 410}, {"id": 1122, "content": "笙歌散尽游人去，始觉春空。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 1129, "content": "荒城临古渡，落日满秋山。", "from": "王维《归嵩山作》", "poem_id": 112}, {"id": 1134, "content": "锦江春色来天地，玉垒浮云变古今。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 1135, "content": "岱宗夫如何？齐鲁青未了。", "from": "杜甫《望岳》", "poem_id": 6}, {"id": 1140, "content": "平芜尽处是春山，行人更在春山外。", "from": "欧阳修《踏莎行·候馆梅残》", "poem_id": 348}, {"id": 1141, "content": "寒山转苍翠，秋水日潺湲。", "from": "王维《辋川闲居赠裴秀才迪》", "poem_id": 110}, {"id": 1154, "content": "鸿雁在云鱼在水。惆怅此情难寄。", "from": "晏殊《清平乐·红笺小字》", "poem_id": 335}, {"id": 1156, "content": "吴宫花草埋幽径，晋代衣冠成古丘。", "from": "李白《登金陵凤凰台》", "poem_id": 171}, {"id": 1161, "content": "纱窗日落渐黄昏，金屋无人见泪痕。", "from": "刘方平《春怨》", "poem_id": 274}, {"id": 1162, "content": "正是江南好风景，落花时节又逢君。", "from": "杜甫《江南逢李龟年》", "poem_id": 269}, {"id": 1165, "content": "狎兴生疏，酒徒萧索，不似少年时。", "from": "柳永《少年游·长安古道马迟迟》", "poem_id": 363}, {"id": 1168, "content": "嗟余听鼓应官去，走马兰台类转蓬。", "from": "李商隐《无题·昨夜星辰昨夜风》", "poem_id": 207}, {"id": 1169, "content": "雁声远过潇湘去，十二楼中月自明。", "from": "温庭筠《瑶瑟怨》", "poem_id": 303}, {"id": 1181, "content": "男儿西北有神州，莫滴水西桥畔泪。", "from": "刘克庄《玉楼春·戏林推》", "poem_id": 561}, {"id": 1183, "content": "艰难苦恨繁霜鬓，潦倒新停浊酒杯。", "from": "杜甫《登高》", "poem_id": 183}, {"id": 1185, "content": "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。", "from": "苏轼《定风波·莫听穿林打叶声》", "poem_id": 399}, {"id": 1190, "content": "晓镜但愁云鬓改，夜吟应觉月光寒。", "from": "李商隐《无题·相见时难别亦难》", "poem_id": 212}, {"id": 1197, "content": "君看六幅南朝事，老木寒云满故城。", "from": "韦庄《金陵图》", "poem_id": 306}, {"id": 1205, "content": "午醉醒来愁未醒。送春春去几时回。", "from": "张先《天仙子·水调数声持酒听》", "poem_id": 329}, {"id": 1225, "content": "伫倚危楼风细细。望极春愁，黯黯生天际。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 1227, "content": "风急天高猿啸哀，渚清沙白鸟飞回。", "from": "杜甫《登高》", "poem_id": 183}, {"id": 1228, "content": "晚风庭院落梅初。淡云来往月疏疏。", "from": "李清照《浣溪沙·髻子伤春慵更梳》", "poem_id": 631}, {"id": 1234, "content": "秋草独寻人去后，寒林空见日斜时。", "from": "刘长卿《长沙过贾谊宅》", "poem_id": 193}, {"id": 1238, "content": "春风不解禁杨花，濛濛乱扑行人面。", "from": "晏殊《踏莎行·小径红稀》", "poem_id": 341}, {"id": 1253, "content": "风波不信菱枝弱，月露谁教桂叶香。", "from": "李商隐《无题·重帏深下莫愁堂》", "poem_id": 215}, {"id": 1254, "content": "水风轻，蘋花渐老，月露冷、梧叶飘黄。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 1264, "content": "我本楚狂人，凤歌笑孔丘。", "from": "李白《庐山谣寄卢侍御虚舟》", "poem_id": 49}, {"id": 1265, "content": "人生不相见，动如参与商。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 1268, "content": "柳外轻雷池上雨，雨声滴碎荷声。小楼西角断虹明。", "from": "欧阳修《临江仙·柳外轻雷池上雨》", "poem_id": 353}, {"id": 1274, "content": "水晶帘不下，云母屏开，冷浸佳人淡脂粉。", "from": "晁补之《洞仙歌·泗州中秋作》", "poem_id": 422}, {"id": 1279, "content": "年年今夜，月华如练，长是人千里。", "from": "范仲淹《御街行·秋日怀旧》", "poem_id": 324}, {"id": 1283, "content": "长于春梦几多时，散似秋云无觅处。", "from": "晏殊《木兰花·燕鸿过后莺归去》", "poem_id": 337}, {"id": 1285, "content": "戍鼓断人行，边秋一雁声。", "from": "杜甫《月夜忆舍弟》", "poem_id": 104}, {"id": 1286, "content": "秋晚莼鲈江上，夜深儿女灯前。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 1295, "content": "春已归来，看美人头上，袅袅春幡。", "from": "辛弃疾《汉宫春·立春日》", "poem_id": 516}, {"id": 1298, "content": "相思难表，梦魂无据，惟有归来是。", "from": "欧阳修《青玉案·一年春事都来几》", "poem_id": 356}, {"id": 1304, "content": "长风几万里，吹度玉门关。", "from": "李白《关山月》", "poem_id": 36}, {"id": 1313, "content": "而今灯漫挂。不是暗尘明月，那时元夜。", "from": "蒋捷《女冠子·元夕》", "poem_id": 608}, {"id": 1316, "content": "却看妻子愁何在，漫卷诗书喜欲狂。", "from": "杜甫《闻官军收河南河北》", "poem_id": 182}, {"id": 1317, "content": "在天愿作比翼鸟，在地愿为连理枝。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 1336, "content": "酒已都醒，如何消夜永！", "from": "周邦彦《关河令·秋阴时晴渐向暝》", "poem_id": 448}, {"id": 1341, "content": "何当共剪西窗烛，却话巴山夜雨时。", "from": "李商隐《夜雨寄北》", "poem_id": 296}, {"id": 1344, "content": "三杯两盏淡酒，怎敌他、晚来风急？", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 1353, "content": "燕草如碧丝，秦桑低绿枝。", "from": "李白《春思》", "poem_id": 5}, {"id": 1361, "content": "清秋幕府井梧寒，独宿江城蜡炬残。", "from": "杜甫《宿府》", "poem_id": 185}, {"id": 1365, "content": "烽火连三月，家书抵万金。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 1367, "content": "隔座送钩春酒暖，分曹射覆蜡灯红。", "from": "李商隐《无题·昨夜星辰昨夜风》", "poem_id": 207}, {"id": 1382, "content": "繁华事散逐香尘，流水无情草自春。", "from": "杜牧《金谷园》", "poem_id": 295}, {"id": 1413, "content": "旧游无处不堪寻。无寻处，惟有少年心。", "from": "章良能《小重山·柳暗花明春事深》", "poem_id": 543}, {"id": 1419, "content": "易挑锦妇机中字。难得玉人心下事。", "from": "刘克庄《玉楼春·戏林推》", "poem_id": 561}, {"id": 1428, "content": "夜雪初霁，荠麦弥望。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 1437, "content": "回乐峰前沙似雪，受降城外月如霜。", "from": "李益《夜上受降城闻笛》", "poem_id": 277}, {"id": 1438, "content": "日暮东风怨啼鸟，落花犹似堕楼人。", "from": "杜牧《金谷园》", "poem_id": 295}, {"id": 1440, "content": "香非在蕊，香非在萼，骨中香彻。", "from": "晁补之《盐角儿·亳社观梅》", "poem_id": 420}, {"id": 1442, "content": "孤灯寒照雨，湿竹暗浮烟。", "from": "司空曙《云阳馆与韩绅宿别》", "poem_id": 142}, {"id": 1445, "content": "一字无题外，落叶都愁。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 1449, "content": "神女生涯原是梦，小姑居处本无郎。", "from": "李商隐《无题·重帏深下莫愁堂》", "poem_id": 215}, {"id": 1463, "content": "怅卧新春白袷衣，白门寥落意多违。", "from": "李商隐《春雨》", "poem_id": 213}, {"id": 1474, "content": "落日熔金，暮云合璧，人在何处。", "from": "李清照《永遇乐·落日熔金》", "poem_id": 630}, {"id": 1482, "content": "岁暮阴阳催短景，天涯霜雪霁寒宵。", "from": "杜甫《阁夜》", "poem_id": 186}, {"id": 1491, "content": "山光忽西落，池月渐东上。", "from": "孟浩然《夏日南亭怀辛大》", "poem_id": 17}, {"id": 1501, "content": "故人早晚上高台。赠我江南春色、一枝梅。", "from": "舒亶《虞美人·寄公度》", "poem_id": 424}, {"id": 1504, "content": "红楼隔雨相望冷，珠箔飘灯独自归。", "from": "李商隐《春雨》", "poem_id": 213}, {"id": 1505, "content": "细草微风岸，危樯独夜舟。", "from": "杜甫《旅夜书怀》", "poem_id": 108}, {"id": 1514, "content": "花径不曾缘客扫，蓬门今始为君开。", "from": "杜甫《客至》", "poem_id": 180}, {"id": 1516, "content": "庄生晓梦迷蝴蝶，望帝春心托杜鹃。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 1541, "content": "玉珰缄札何由达，万里云罗一雁飞。", "from": "李商隐《春雨》", "poem_id": 213}, {"id": 1548, "content": "呼儿将出换美酒，与尔同销万古愁。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 1554, "content": "但见泪痕湿，不知心恨谁。", "from": "李白《怨情》", "poem_id": 232}, {"id": 1556, "content": "重帏深下莫愁堂，卧后清宵细细长。", "from": "李商隐《无题·重帏深下莫愁堂》", "poem_id": 215}, {"id": 1558, "content": "心断新丰酒，销愁斗几千。", "from": "李商隐《风雨》", "poem_id": 152}, {"id": 1559, "content": "红莲相倚浑如醉，白鸟无言定自愁。", "from": "辛弃疾《鹧鸪天·鹅湖归病起作》", "poem_id": 524}, {"id": 1562, "content": "雨横风狂三月暮，门掩黄昏，无计留春住。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 1568, "content": "故国神游，多情应笑我，早生华发。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 1572, "content": "亲朋无一字，老病有孤舟。", "from": "杜甫《登岳阳楼》", "poem_id": 109}, {"id": 1573, "content": "万里悲秋常作客，百年多病独登台。", "from": "杜甫《登高》", "poem_id": 183}, {"id": 1577, "content": "望君烟水阔，挥手泪沾巾。", "from": "刘长卿《饯别王十一南游》", "poem_id": 130}, {"id": 1580, "content": "别来不寄一行书。寻常相见了，犹道不如初。", "from": "晁冲之《临江仙·忆昔西池池上饮》", "poem_id": 423}, {"id": 1581, "content": "长安故人问我，道寻常、泥酒只依然。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 1584, "content": "山抹微云，天连衰草，画角声断谯门。", "from": "秦观《满庭芳·山抹微云》", "poem_id": 407}, {"id": 1586, "content": "惟有楼前流水，应念我、终日凝眸。", "from": "李清照《凤凰台上忆吹箫·香冷金猊》", "poem_id": 626}, {"id": 1587, "content": "水调数声持酒听。午醉醒来愁未醒。", "from": "张先《天仙子·水调数声持酒听》", "poem_id": 329}, {"id": 1588, "content": "却下水晶帘，玲珑望秋月。", "from": "李白《玉阶怨》", "poem_id": 253}, {"id": 1590, "content": "黄云万里动风色，白波九道流雪山。", "from": "李白《庐山谣寄卢侍御虚舟》", "poem_id": 49}, {"id": 1594, "content": "白云回望合，青霭入看无。", "from": "王维《终南山》", "poem_id": 113}, {"id": 1596, "content": "山中一夜雨，树杪百重泉。", "from": "王维《送梓州李使君》", "poem_id": 116}, {"id": 1607, "content": "桂魄初生秋露微，轻罗已薄未更衣。", "from": "王维《秋夜曲》", "poem_id": 311}, {"id": 1617, "content": "乍见翻疑梦，相悲各问年。", "from": "司空曙《云阳馆与韩绅宿别》", "poem_id": 142}, {"id": 1622, "content": "北斗七星高，哥舒夜带刀。", "from": "西鄙人《哥舒歌》", "poem_id": 250}, {"id": 1626, "content": "桃花落。闲池阁。山盟虽在，锦书难托。", "from": "陆游《钗头凤·红酥手》", "poem_id": 507}, {"id": 1639, "content": "雾失楼台，月迷津渡。", "from": "秦观《踏莎行·郴州旅舍》", "poem_id": 410}, {"id": 1649, "content": "灞原风雨定，晚见雁行频。", "from": "马戴《灞上秋居》", "poem_id": 157}, {"id": 1660, "content": "萋萋芳草忆王孙。柳外楼高空断魂。", "from": "李重元《忆王孙·春词》", "poem_id": 483}, {"id": 1661, "content": "渡头杨柳青青。枝枝叶叶离情。", "from": "晏几道《清平乐·留人不住》", "poem_id": 383}, {"id": 1666, "content": "迟迟钟鼓初长夜，耿耿星河欲曙天。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 1685, "content": "柳外轻雷池上雨，雨声滴碎荷声。", "from": "欧阳修《临江仙·柳外轻雷池上雨》", "poem_id": 353}, {"id": 1691, "content": "休问梁园旧宾客，茂陵秋雨病相如。", "from": "李商隐《寄令狐郎中》", "poem_id": 297}, {"id": 1697, "content": "长记曾携手处，千树压、西湖寒碧。", "from": "姜夔《暗香·旧时月色》", "poem_id": 537}, {"id": 1715, "content": "斜阳外，寒鸦万点，流水绕孤村。", "from": "秦观《满庭芳·山抹微云》", "poem_id": 407}, {"id": 1721, "content": "桃花尽日随流水，洞在清溪何处边。", "from": "张旭《桃花溪》", "poem_id": 260}, {"id": 1727, "content": "古台摇落后，秋日望乡心。", "from": "刘长卿《秋日登吴公台上寺远眺》", "poem_id": 128}, {"id": 1728, "content": "故人具鸡黍，邀我至田家。", "from": "孟浩然《过故人庄》", "poem_id": 123}, {"id": 1729, "content": "尊前故人如在，想念我、最关情。", "from": "周邦彦《绮寮怨·上马人扶残醉》", "poem_id": 449}, {"id": 1736, "content": "春眠不觉晓，处处闻啼鸟。", "from": "孟浩然《春晓》", "poem_id": 230}, {"id": 1738, "content": "夜来风雨声，花落知多少。", "from": "孟浩然《春晓》", "poem_id": 230}, {"id": 1746, "content": "小轩窗。正梳妆。相顾无言，惟有泪千行。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 1748, "content": "夜深风竹敲秋韵。万叶千声皆是恨。", "from": "欧阳修《玉楼春·别后不知君远近》", "poem_id": 352}, {"id": 1749, "content": "玉勒雕鞍游冶处，楼高不见章台路。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 1753, "content": "空自觉、围羞带减，影怯灯孤。", "from": "张炎《渡江云·山阴久客一再逢春回忆西杭渺然愁思》", "poem_id": 614}, {"id": 1761, "content": "可惜一片清歌，都付与黄昏。", "from": "黄孝迈《湘春夜月·近清明》", "poem_id": 593}, {"id": 1792, "content": "田夫荷锄至，相见语依依。", "from": "王维《渭川田家》", "poem_id": 14}, {"id": 1793, "content": "江村独归处，寂寞养残生。", "from": "杜甫《奉济驿重送严公四韵》", "poem_id": 106}, {"id": 1794, "content": "一帘鸠外雨，几处闲田，隔水动春锄。", "from": "张炎《渡江云·山阴久客一再逢春回忆西杭渺然愁思》", "poem_id": 614}, {"id": 1801, "content": "催促年光，旧来流水知何处。", "from": "廖世美《烛影摇红·题安陆浮云楼》", "poem_id": 489}, {"id": 1806, "content": "阳月南飞雁，传闻至此回。", "from": "宋之问《题大庾岭北驿》", "poem_id": 91}, {"id": 1809, "content": "听风听雨过清明。愁草瘗花铭。", "from": "吴文英《风入松·听风听雨过清明》", "poem_id": 579}, {"id": 1822, "content": "对酒当歌，强乐还无味。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 1825, "content": "见梨花初带夜月，海棠半含朝雨。", "from": "万俟咏《三台·清明应制》", "poem_id": 484}, {"id": 1829, "content": "一川烟草，满城风絮，梅子黄时雨。", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 1834, "content": "已是黄昏独自愁，更著风和雨。", "from": "陆游《卜算子·咏梅》", "poem_id": 504}, {"id": 1838, "content": "薄雾浓云愁永昼，瑞脑销金兽。", "from": "李清照《醉花阴·薄雾浓云愁永昼》", "poem_id": 627}, {"id": 1840, "content": "万事一身伤老矣，戎葵凝笑墙东。", "from": "陈与义《临江仙·高咏楚词酬午日》", "poem_id": 476}, {"id": 1842, "content": "恋树湿花飞不起，愁无比，和春付与东流水。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 1850, "content": "如今风雨西楼夜，不听清歌也泪垂。", "from": "周紫芝《鹧鸪天·一点残红欲尽时》", "poem_id": 480}, {"id": 1858, "content": "满地黄花堆积。憔悴损，如今有谁堪摘？", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 1866, "content": "远送从此别，青山空复情。", "from": "杜甫《奉济驿重送严公四韵》", "poem_id": 106}, {"id": 1867, "content": "乡书何处达？归雁洛阳边。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 1869, "content": "故人何在，烟水茫茫。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 1870, "content": "细看来，不是杨花，点点是离人泪。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 1877, "content": "远梦归侵晓，家书到隔年。", "from": "杜牧《旅宿》", "poem_id": 148}, {"id": 1895, "content": "海阔山遥，未知何处是潇湘。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 1897, "content": "舍南舍北皆春水，但见群鸥日日来。", "from": "杜甫《客至》", "poem_id": 180}, {"id": 1900, "content": "剑河风急雪片阔，沙口石冻马蹄脱。", "from": "岑参《轮台歌奉送封大夫出师西征》", "poem_id": 53}, {"id": 1903, "content": "纷纷暮雪下辕门，风掣红旗冻不翻。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 1909, "content": "造化钟神秀，阴阳割昏晓。", "from": "杜甫《望岳》", "poem_id": 6}, {"id": 1926, "content": "春风桃李花开日，秋雨梧桐叶落时。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 1934, "content": "鸡鸣紫陌曙光寒，莺啭皇州春色阑。", "from": "岑参《奉和中书舍人贾至早朝大明宫》", "poem_id": 173}, {"id": 1939, "content": "堤上游人逐画船，拍堤春水四垂天。", "from": "欧阳修《浣溪沙·堤上游人逐画船》", "poem_id": 354}, {"id": 1941, "content": "映阶碧草自春色，隔叶黄鹂空好音。", "from": "杜甫《蜀相》", "poem_id": 179}, {"id": 1949, "content": "彩袖殷勤捧玉钟。当年拚却醉颜红。", "from": "晏几道《鹧鸪天·彩袖殷勤捧玉钟》", "poem_id": 377}, {"id": 1953, "content": "春风不解禁杨花，蒙蒙乱扑行人面。", "from": "晏殊《踏莎行·小径红稀》", "poem_id": 341}, {"id": 1954, "content": "四十三年，望中犹记，烽火扬州路。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 1964, "content": "遥怜小儿女，未解忆长安。", "from": "杜甫《月夜》", "poem_id": 101}, {"id": 1966, "content": "竹喧归浣女，莲动下渔舟。", "from": "王维《山居秋暝》", "poem_id": 111}, {"id": 1968, "content": "长歌吟松风，曲尽河星稀。", "from": "李白《下终南山过斛斯山人宿置酒》", "poem_id": 3}, {"id": 1978, "content": "纷纷坠叶飘香砌。夜寂静，寒声碎。", "from": "范仲淹《御街行·秋日怀旧》", "poem_id": 324}, {"id": 1989, "content": "渔舟逐水爱山春，两岸桃花夹古津。", "from": "王维《桃源行》", "poem_id": 74}, {"id": 1990, "content": "床前明月光，疑是地上霜。", "from": "李白《静夜思》", "poem_id": 231}, {"id": 1999, "content": "从别后，忆相逢，几回魂梦与君同。", "from": "晏几道《鹧鸪天·彩袖殷勤捧玉钟》", "poem_id": 377}, {"id": 2003, "content": "朱雀桥边野草花，乌衣巷口夕阳斜。", "from": "刘禹锡《乌衣巷》", "poem_id": 278}, {"id": 2022, "content": "雨中黄叶树，灯下白头人。", "from": "司空曙《喜外弟卢纶见宿》", "poem_id": 143}, {"id": 2023, "content": "岐王宅里寻常见，崔九堂前几度闻。", "from": "杜甫《江南逢李龟年》", "poem_id": 269}, {"id": 2027, "content": "可惜明年花更好，知与谁同？", "from": "欧阳修《浪淘沙·把酒祝东风》", "poem_id": 355}, {"id": 2028, "content": "前不见古人，后不见来者。", "from": "陈子昂《登幽州台歌》", "poem_id": 42}, {"id": 2042, "content": "风鸣两岸叶，月照一孤舟。", "from": "孟浩然《宿桐庐江寄广陵旧游》", "poem_id": 125}, {"id": 2053, "content": "候馆梅残，溪桥柳细。", "from": "欧阳修《踏莎行·候馆梅残》", "poem_id": 348}, {"id": 2059, "content": "芙蓉如面柳如眉，对此如何不泪垂。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 2062, "content": "落叶人何在，寒云路几层。", "from": "李商隐《北青萝》", "poem_id": 155}, {"id": 2068, "content": "绿竹入幽径，青萝拂行衣。", "from": "李白《下终南山过斛斯山人宿置酒》", "poem_id": 3}, {"id": 2081, "content": "长亭路，年去岁来，应折柔条过千尺。", "from": "周邦彦《兰陵王·柳》", "poem_id": 435}, {"id": 2082, "content": "当年燕子知何处，但苔深韦曲，草暗斜川。", "from": "张炎《高阳台·西湖春感》", "poem_id": 609}, {"id": 2094, "content": "云里帝城双凤阙，雨中春树万人家。", "from": "王维《奉和圣制从蓬莱向兴庆阁道中留春雨中春望之作应制》", "poem_id": 177}, {"id": 2105, "content": "明日巴陵道，秋山又几重。", "from": "李益《喜见外弟又言别》", "poem_id": 141}, {"id": 2107, "content": "今逢四海为家日，故垒萧萧芦荻秋。", "from": "刘禹锡《西塞山怀古》", "poem_id": 201}, {"id": 2127, "content": "小雨纤纤风细细，万家杨柳青烟里。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 2132, "content": "嵩云秦树久离居，双鲤迢迢一纸书。", "from": "李商隐《寄令狐郎中》", "poem_id": 297}, {"id": 2142, "content": "江流石不转，遗恨失吞吴。", "from": "杜甫《八阵图》", "poem_id": 233}, {"id": 2146, "content": "况屈指中秋，十分好月，不照人圆。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 2147, "content": "西山白雪三城戍，南浦清江万里桥。", "from": "杜甫《野望》", "poem_id": 181}, {"id": 2151, "content": "郴江幸自绕郴山，为谁流下潇湘去。", "from": "秦观《踏莎行·郴州旅舍》", "poem_id": 410}, {"id": 2152, "content": "斜阳独倚西楼。遥山恰对帘钩。", "from": "晏殊《清平乐·红笺小字》", "poem_id": 335}, {"id": 2166, "content": "今夜鄜州月，闺中只独看。", "from": "杜甫《月夜》", "poem_id": 101}, {"id": 2177, "content": "相思休问定何如。情知春去后，管得落花无。", "from": "晁冲之《临江仙·忆昔西池池上饮》", "poem_id": 423}, {"id": 2178, "content": "明朝且做莫思量，如何过得今宵去。", "from": "周紫芝《踏莎行·情似游丝》", "poem_id": 481}, {"id": 2183, "content": "身多疾病思田里，邑有流亡愧俸钱。", "from": "韦应物《寄李儋元锡》", "poem_id": 196}, {"id": 2189, "content": "三湘愁鬓逢秋色，万里归心对月明。", "from": "卢纶《晚次鄂州》", "poem_id": 199}, {"id": 2202, "content": "都缘自有离恨，故画作远山长。", "from": "欧阳修《诉衷情·眉意》", "poem_id": 347}, {"id": 2205, "content": "云霞出海曙，梅柳渡江春。", "from": "杜审言《和晋陵陆丞早春游望》", "poem_id": 89}, {"id": 2214, "content": "以我独沉久，愧君相见频。", "from": "司空曙《喜外弟卢纶见宿》", "poem_id": 143}, {"id": 2220, "content": "时见幽人独往来，缥缈孤鸿影。", "from": "苏轼《卜算子·黄州定慧院寓居作》", "poem_id": 396}, {"id": 2224, "content": "这次第，算人间没个并刀，剪断心上愁痕。", "from": "黄孝迈《湘春夜月·近清明》", "poem_id": 593}, {"id": 2228, "content": "泪弹不尽临窗滴。就砚旋研墨。", "from": "晏几道《思远人·红叶黄花秋意晚》", "poem_id": 390}, {"id": 2230, "content": "永丰柳，无人尽日飞花雪。", "from": "张先《千秋岁·数声鶗鴂》", "poem_id": 325}, {"id": 2249, "content": "五更疏欲断，一树碧无情。", "from": "李商隐《蝉》", "poem_id": 151}, {"id": 2250, "content": "倩何人唤取，红巾翠袖，揾英雄泪！", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 2254, "content": "二十四桥仍在，波心荡、冷月无声。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 2257, "content": "战士军前半死生，美人帐下犹歌舞。", "from": "高适《燕歌行》", "poem_id": 70}, {"id": 2262, "content": "若对黄花孤负酒，怕黄花、也笑人岑寂。", "from": "刘克庄《贺新郎·九日》", "poem_id": 560}, {"id": 2267, "content": "雁过斜阳，草迷烟渚。", "from": "周紫芝《踏莎行·情似游丝》", "poem_id": 481}, {"id": 2270, "content": "晚春盘马踏青苔，曾傍绿阴深驻。", "from": "晏几道《御街行·街南绿树春饶絮》", "poem_id": 387}, {"id": 2272, "content": "江上月明胡雁过，淮南木落楚山多。", "from": "刘长卿《江州重别薛六柳八二员外》", "poem_id": 192}, {"id": 2290, "content": "隐隐飞桥隔野烟，石矶西畔问渔船。", "from": "张旭《桃花溪》", "poem_id": 260}, {"id": 2293, "content": "数丛沙草群鸥散，万顷江田一鹭飞。", "from": "温庭筠《利州南渡》", "poem_id": 216}, {"id": 2294, "content": "斜阳照墟落，穷巷牛羊归。", "from": "王维《渭川田家》", "poem_id": 14}, {"id": 2300, "content": "过桥分野色，移石动云根。", "from": "贾岛《题李凝幽居》", "poem_id": 165}, {"id": 2305, "content": "迢递嵩高下，归来且闭关。", "from": "王维《归嵩山作》", "poem_id": 112}, {"id": 2320, "content": "不是暗尘明月，那时元夜。", "from": "蒋捷《女冠子·元夕》", "poem_id": 608}, {"id": 2326, "content": "接叶巢莺，平波卷絮，断桥斜日归船。", "from": "张炎《高阳台·西湖春感》", "poem_id": 609}, {"id": 2337, "content": "黄衫飞白马，日日青楼下。", "from": "陈克《菩萨蛮·赤阑桥尽香街直》", "poem_id": 427}, {"id": 2358, "content": "回眸一笑百媚生，六宫粉黛无颜色。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 2374, "content": "不枉东风吹客泪。相思难表，梦魂无据，惟有归来是。", "from": "欧阳修《青玉案·一年春事都来几》", "poem_id": 356}, {"id": 2380, "content": "残灯明灭枕头欹，谙尽孤眠滋味。", "from": "范仲淹《御街行·秋日怀旧》", "poem_id": 324}, {"id": 2382, "content": "独敲初夜磬，闲倚一枝藤。", "from": "李商隐《北青萝》", "poem_id": 155}, {"id": 2403, "content": "过春风十里。尽荠麦青青。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 2415, "content": "欲祭疑君在，天涯哭此时。", "from": "张籍《没蕃故人》", "poem_id": 146}, {"id": 2419, "content": "芳草已云暮，故人殊未来。", "from": "韦庄《章台夜思》", "poem_id": 163}, {"id": 2443, "content": "庐山秀出南斗傍，屏风九叠云锦张。", "from": "李白《庐山谣寄卢侍御虚舟》", "poem_id": 49}, {"id": 2445, "content": "君宠益娇态，君怜无是非。", "from": "王维《西施咏》", "poem_id": 15}, {"id": 2457, "content": "戎马关山北，凭轩涕泗流。", "from": "杜甫《登岳阳楼》", "poem_id": 109}, {"id": 2478, "content": "牵衣顿足拦道哭，哭声直上干云霄。", "from": "杜甫《兵车行》", "poem_id": 81}, {"id": 2485, "content": "沙场烽火连胡月，海畔云山拥蓟城。", "from": "祖咏《望蓟门》", "poem_id": 169}, {"id": 2489, "content": "沧江好烟月，门系钓鱼船。", "from": "杜牧《旅宿》", "poem_id": 148}, {"id": 2494, "content": "金风细细。叶叶梧桐坠。", "from": "晏殊《清平乐·金风细细》", "poem_id": 336}, {"id": 2506, "content": "枕簟溪堂冷欲秋。断云依水晚来收。", "from": "辛弃疾《鹧鸪天·鹅湖归病起作》", "poem_id": 524}, {"id": 2519, "content": "风老莺雏，雨肥梅子，午阴嘉树清圆。", "from": "周邦彦《满庭芳·夏日溧水无想山作》", "poem_id": 439}, {"id": 2535, "content": "微雨霭芳原，春鸠鸣何处。", "from": "韦应物《东郊》", "poem_id": 30}, {"id": 2540, "content": "一棹碧涛春水路。过尽晓莺啼处。", "from": "晏几道《清平乐·留人不住》", "poem_id": 383}, {"id": 2543, "content": "朱颜空自改，向年年、芳意长新。", "from": "韩缜《凤箫吟·锁离愁》", "poem_id": 344}, {"id": 2550, "content": "怡然敬父执，问我来何方？问答乃未已，驱儿罗酒浆。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 2563, "content": "竹怜新雨后，山爱夕阳时。", "from": "钱起《谷口书斋寄杨补阙》", "poem_id": 134}, {"id": 2573, "content": "飞絮濛濛。垂柳阑干尽日风。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 2585, "content": "临砌影，寒香乱、冻梅藏韵。", "from": "吴文英《花犯·郭希道送水仙索赋》", "poem_id": 572}, {"id": 2588, "content": "春来遍是桃花水，不辨仙源何处寻。", "from": "王维《桃源行》", "poem_id": 74}, {"id": 2593, "content": "昨夜风开露井桃，未央前殿月轮高。", "from": "王昌龄《春宫曲》", "poem_id": 264}, {"id": 2598, "content": "醉月频中圣，迷花不事君。", "from": "李白《赠孟浩然》", "poem_id": 95}, {"id": 2600, "content": "月华如练，长是人千里。", "from": "范仲淹《御街行·秋日怀旧》", "poem_id": 324}, {"id": 2620, "content": "暮从碧山下，山月随人归。", "from": "李白《下终南山过斛斯山人宿置酒》", "poem_id": 3}, {"id": 2621, "content": "碧云天，黄叶地。", "from": "范仲淹《苏幕遮·怀旧》", "poem_id": 323}, {"id": 2629, "content": "世界微尘里，吾宁爱与憎。", "from": "李商隐《北青萝》", "poem_id": 155}, {"id": 2630, "content": "可怜夜半虚前席，不问苍生问鬼神。", "from": "李商隐《贾生》", "poem_id": 302}, {"id": 2631, "content": "更深月色半人家，北斗阑干南斗斜。", "from": "刘方平《月夜》", "poem_id": 273}, {"id": 2639, "content": "杏花疏影里，吹笛到天明。", "from": "陈与义《临江仙·夜登小阁忆洛中旧游》", "poem_id": 477}, {"id": 2649, "content": "欲买桂花同载酒，终不似，少年游。", "from": "刘过《唐多令·芦叶满汀洲》", "poem_id": 544}, {"id": 2666, "content": "上穷碧落下黄泉，两处茫茫皆不见。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 2673, "content": "春色三分，二分尘土，一分流水。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 2675, "content": "莫听穿林打叶声，何妨吟啸且徐行。", "from": "苏轼《定风波·莫听穿林打叶声》", "poem_id": 399}, {"id": 2683, "content": "早知潮有信，嫁与弄潮儿。", "from": "李益《江南曲》", "poem_id": 258}, {"id": 2700, "content": "云来气接巫峡长，月出寒通雪山白。", "from": "杜甫《古柏行》", "poem_id": 60}, {"id": 2738, "content": "朝为越溪女，暮作吴宫妃。", "from": "王维《西施咏》", "poem_id": 15}, {"id": 2754, "content": "笑绿鬟邻女，倚窗犹唱，夕阳西下。", "from": "蒋捷《女冠子·元夕》", "poem_id": 608}, {"id": 2760, "content": "忆昔西池池上饮，年年多少欢娱。", "from": "晁冲之《临江仙·忆昔西池池上饮》", "poem_id": 423}, {"id": 2761, "content": "可惜流年，忧愁风雨，树犹如此！", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 2762, "content": "已忍伶俜十年事，强移栖息一枝安。", "from": "杜甫《宿府》", "poem_id": 185}, {"id": 2763, "content": "凄凉宝剑篇，羁泊欲穷年。", "from": "李商隐《风雨》", "poem_id": 152}, {"id": 2766, "content": "任是春风吹不展。困倚危楼。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 2767, "content": "清露晨流，新桐初引，多少游春意。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 2775, "content": "满地残红宫锦污，昨夜南园风雨。", "from": "王安国《清平乐·春晚》", "poem_id": 373}, {"id": 2789, "content": "登舟望秋月，空忆谢将军。", "from": "李白《夜泊牛渚怀古》", "poem_id": 99}, {"id": 2793, "content": "鸿雁几时到，江湖秋水多。", "from": "杜甫《天末怀李白》", "poem_id": 105}, {"id": 2819, "content": "惆怅南朝事，长江独至今。", "from": "刘长卿《秋日登吴公台上寺远眺》", "poem_id": 128}, {"id": 2822, "content": "东风渐绿西湖柳，雁已还、人未南归。", "from": "周密《高阳台·送陈君衡被召》", "poem_id": 601}, {"id": 2861, "content": "隋堤上、曾见几番，拂水飘绵送行色。", "from": "周邦彦《兰陵王·柳》", "poem_id": 435}, {"id": 2863, "content": "北极朝廷终不改，西山寇盗莫相侵。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 2867, "content": "二分尘土，一分流水。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 2879, "content": "最关情，折尽梅花，难寄相思。", "from": "周密《高阳台·送陈君衡被召》", "poem_id": 601}, {"id": 2888, "content": "肥水东流无尽期。当初不合种相思。", "from": "姜夔《鹧鸪天·元夕有所梦》", "poem_id": 527}, {"id": 2895, "content": "寒灯思旧事，断雁警愁眠。", "from": "杜牧《旅宿》", "poem_id": 148}, {"id": 2896, "content": "不忍登高临远，望故乡渺邈，归思难收。", "from": "柳永《八声甘州·对潇潇暮雨洒江天》", "poem_id": 367}, {"id": 2900, "content": "岭外音书断，经冬复历春。", "from": "宋之问《渡汉江》", "poem_id": 248}, {"id": 2906, "content": "年年跃马长安市。客舍似家家似寄。", "from": "刘克庄《玉楼春·戏林推》", "poem_id": 561}, {"id": 2911, "content": "家童扫萝径，昨与故人期。", "from": "钱起《谷口书斋寄杨补阙》", "poem_id": 134}, {"id": 2923, "content": "飒飒东风细雨来，芙蓉塘外有轻雷。", "from": "李商隐《无题·飒飒东风细雨来》", "poem_id": 210}, {"id": 2949, "content": "歌声未尽处，先泪零。", "from": "周邦彦《绮寮怨·上马人扶残醉》", "poem_id": 449}, {"id": 2962, "content": "偷弹清泪寄烟波，见江头故人，为言憔悴如许。", "from": "袁去华《剑器近·夜来雨》", "poem_id": 501}, {"id": 2977, "content": "去意徊徨，别语愁难听。", "from": "周邦彦《蝶恋花·早行》", "poem_id": 445}, {"id": 2979, "content": "无一语，对芳尊。安排肠断到黄昏。", "from": "秦观《鹧鸪天·枝上流莺和泪闻》", "poem_id": 413}, {"id": 2982, "content": "无人知此意，歌罢满帘风。", "from": "陈与义《临江仙·高咏楚词酬午日》", "poem_id": 476}, {"id": 2983, "content": "枝上流莺和泪闻，新啼痕间旧啼痕。", "from": "秦观《鹧鸪天·枝上流莺和泪闻》", "poem_id": 413}, {"id": 2989, "content": "今为羌笛出塞声，使我三军泪如雨。", "from": "李颀《古意》", "poem_id": 43}, {"id": 2990, "content": "伤情处，高城望断，灯火已黄昏。", "from": "秦观《满庭芳·山抹微云》", "poem_id": 407}, {"id": 2992, "content": "蓬门未识绮罗香，拟托良媒益自伤。", "from": "秦韬玉《贫女》", "poem_id": 220}, {"id": 2993, "content": "困倚危楼。过尽飞鸿字字愁。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 2995, "content": "是他春带愁来，春归何处。", "from": "辛弃疾《祝英台近·晚春》", "poem_id": 522}, {"id": 3005, "content": "望极春愁，黯黯生天际。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 3009, "content": "问姓惊初见，称名忆旧容。", "from": "李益《喜见外弟又言别》", "poem_id": 141}, {"id": 3026, "content": "惟有两行低雁，知人倚、画楼月。", "from": "范成大《霜天晓角·梅》", "poem_id": 512}, {"id": 3035, "content": "花隐掖垣暮，啾啾栖鸟过。", "from": "杜甫《春宿左省》", "poem_id": 102}, {"id": 3036, "content": "飞鸟没何处，青山空向人。", "from": "刘长卿《饯别王十一南游》", "poem_id": 130}, {"id": 3044, "content": "第四桥边，拟共天随住。", "from": "姜夔《点绛唇·丁未冬过吴松作》", "poem_id": 526}, {"id": 3058, "content": "柳下系舟犹未稳，能几日、又中秋。", "from": "刘过《唐多令·芦叶满汀洲》", "poem_id": 544}, {"id": 3074, "content": "将军角弓不得控，都护铁衣冷难着。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 3077, "content": "生事且弥漫，愿为持竿叟。", "from": "綦毋潜《春泛若耶溪》", "poem_id": 21}, {"id": 3091, "content": "锦瑟华年谁与度？", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 3098, "content": "应念岭表经年，孤光自照，肝胆皆冰雪。", "from": "张孝祥《念奴娇·过洞庭》", "poem_id": 497}, {"id": 3110, "content": "独立小桥风满袖，平林新月人归后。", "from": "冯延巳《鹊踏枝·谁道闲情抛掷久》", "poem_id": 350}, {"id": 3139, "content": "寄书长不达，况乃未休兵。", "from": "杜甫《月夜忆舍弟》", "poem_id": 104}, {"id": 3147, "content": "少小虽非投笔吏，论功还欲请长缨。", "from": "祖咏《望蓟门》", "poem_id": 169}, {"id": 3151, "content": "燕雁无心，太湖西畔随云去。", "from": "姜夔《点绛唇·丁未冬过吴松作》", "poem_id": 526}, {"id": 3153, "content": "佳节又重阳，玉枕纱厨，半夜凉初透。", "from": "李清照《醉花阴·薄雾浓云愁永昼》", "poem_id": 627}, {"id": 3164, "content": "又酒趁哀弦，灯照离席。梨花榆火催寒食。", "from": "周邦彦《兰陵王·柳》", "poem_id": 435}, {"id": 3166, "content": "残杏枝头花几许。啼红正恨清明雨。", "from": "赵令畤《蝶恋花·欲减罗衣寒未去》", "poem_id": 415}, {"id": 3174, "content": "元宵佳节，融和天气，次第岂无风雨。", "from": "李清照《永遇乐·落日熔金》", "poem_id": 630}, {"id": 3177, "content": "梦中未比丹青见，暗里忽惊山鸟啼。", "from": "姜夔《鹧鸪天·元夕有所梦》", "poem_id": 527}, {"id": 3180, "content": "甚时跃马归来，认得迎门轻笑。", "from": "时彦《青门饮·寄宠人》", "poem_id": 430}, {"id": 3193, "content": "照野旌旗，朝天车马，平沙万里天低。", "from": "周密《高阳台·送陈君衡被召》", "poem_id": 601}, {"id": 3195, "content": "生怕见花开花落，朝来塞雁先还。", "from": "辛弃疾《汉宫春·立春日》", "poem_id": 516}, {"id": 3218, "content": "欢言得所憩，美酒聊共挥。", "from": "李白《下终南山过斛斯山人宿置酒》", "poem_id": 3}, {"id": 3245, "content": "萧条庭院，又斜风细雨，重门须闭。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 3262, "content": "恼乱横波秋一寸。斜阳只与黄昏近。", "from": "赵令畤《蝶恋花·卷絮风头寒欲尽》", "poem_id": 416}, {"id": 3270, "content": "深院锁黄昏，阵阵芭蕉雨。", "from": "欧阳修《生查子·含羞整翠鬟》", "poem_id": 332}, {"id": 3288, "content": "宫粉雕痕，仙云堕影，无人野水荒湾。", "from": "吴文英《高阳台·落梅》", "poem_id": 582}, {"id": 3297, "content": "为问元戎窦车骑，何时返旆勒燕然。", "from": "皇甫冉《春思》", "poem_id": 198}, {"id": 3299, "content": "睡里消魂无说处。觉来惆怅消魂误。", "from": "晏几道《蝶恋花·梦入江南烟水路》", "poem_id": 375}, {"id": 3310, "content": "江山留胜迹，我辈复登临。", "from": "孟浩然《与诸子登岘山》", "poem_id": 120}, {"id": 3326, "content": "别离在今晨，见尔当何秋。", "from": "韦应物《送杨氏女》", "poem_id": 31}, {"id": 3327, "content": "锁离愁，连绵无际，来时陌上初熏。", "from": "韩缜《凤箫吟·锁离愁》", "poem_id": 344}, {"id": 3328, "content": "金陵子弟来相送，欲行不行各尽觞。", "from": "李白《金陵酒肆留别》", "poem_id": 51}, {"id": 3335, "content": "嗟万事难忘，惟是轻别。", "from": "周邦彦《浪淘沙慢·晓阴重》", "poem_id": 453}, {"id": 3339, "content": "蕃汉断消息，死生长别离。", "from": "张籍《没蕃故人》", "poem_id": 146}, {"id": 3341, "content": "料因循误了，残毡拥雪，故人心眼。", "from": "张炎《解连环·孤雁》", "poem_id": 611}, {"id": 3348, "content": "我行殊未已，何日复归来。", "from": "宋之问《题大庾岭北驿》", "poem_id": 91}, {"id": 3349, "content": "他乡生白发，旧国见青山。", "from": "司空曙《贼平后送人北归》", "poem_id": 144}, {"id": 3354, "content": "抛家傍路，思量却是，无情有思。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 3356, "content": "春思远，谁叹赏、国香风味。", "from": "周密《绣鸾凤花犯·赋水仙》", "poem_id": 605}, {"id": 3361, "content": "家住层城临汉苑，心随明月到胡天。", "from": "皇甫冉《春思》", "poem_id": 198}, {"id": 3362, "content": "谁见汀洲上，相思愁白蘋.。", "from": "刘长卿《饯别王十一南游》", "poem_id": 130}, {"id": 3364, "content": "汀洲无浪复无烟，楚客相思益渺然。", "from": "刘长卿《自夏口至鹦鹉洲夕望岳阳寄源中丞》", "poem_id": 194}, {"id": 3391, "content": "山映斜阳天接水。芳草无情，更在斜阳外。", "from": "范仲淹《苏幕遮·怀旧》", "poem_id": 323}, {"id": 3392, "content": "轮台东门送君去，去时雪满天山路。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 3415, "content": "一点残红欲尽时。乍凉秋气满屏帏。", "from": "周紫芝《鹧鸪天·一点残红欲尽时》", "poem_id": 480}, {"id": 3437, "content": "对潇潇暮雨洒江天，一番洗清秋。", "from": "柳永《八声甘州·对潇潇暮雨洒江天》", "poem_id": 367}, {"id": 3442, "content": "春游之盛，西湖未能过也。", "from": "姜夔《琵琶仙·双桨来时》", "poem_id": 531}, {"id": 3455, "content": "目断秋霄落雁，醉来时响空弦。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 3464, "content": "夕阳鸟外，秋风原上，目断四天垂。", "from": "柳永《少年游·长安古道马迟迟》", "poem_id": 363}, {"id": 3481, "content": "不肯画堂朱户，春风自在杨花。", "from": "王安国《清平乐·春晚》", "poem_id": 373}, {"id": 3488, "content": "长江一帆远，落日五湖春。", "from": "刘长卿《饯别王十一南游》", "poem_id": 130}, {"id": 3489, "content": "莺啼燕语报新年，马邑龙堆路几千。", "from": "皇甫冉《春思》", "poem_id": 198}, {"id": 3503, "content": "闹花深处层楼，画帘半卷东风软。", "from": "陈亮《水龙吟·春恨》", "poem_id": 508}, {"id": 3529, "content": "相携及田家，童稚开荆扉。", "from": "李白《下终南山过斛斯山人宿置酒》", "poem_id": 3}, {"id": 3539, "content": "承恩不在貌，教妾若为容。", "from": "杜荀鹤《春宫怨》", "poem_id": 162}, {"id": 3541, "content": "辽东小妇年十五，惯弹琵琶解歌舞。", "from": "李颀《古意》", "poem_id": 43}, {"id": 3549, "content": "谁爱风流高格调，共怜时世俭梳妆。", "from": "秦韬玉《贫女》", "poem_id": 220}, {"id": 3564, "content": "楼前绿暗分携路，一丝柳、一寸柔情。", "from": "吴文英《风入松·听风听雨过清明》", "poem_id": 579}, {"id": 3576, "content": "柳下桃蹊，乱分春色到人家。", "from": "秦观《望海潮·洛阳怀古》", "poem_id": 405}, {"id": 3578, "content": "画阁朱楼尽相望，红桃绿柳垂檐向。", "from": "王维《洛阳女儿行》", "poem_id": 72}, {"id": 3580, "content": "日高烟敛，更看今日晴未。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 3584, "content": "胡马嘶风，汉旗翻雪，彤云又吐，一竿残照。", "from": "时彦《青门饮·寄宠人》", "poem_id": 430}, {"id": 3587, "content": "任宝奁尘满，日上帘钩。", "from": "李清照《凤凰台上忆吹箫·香冷金猊》", "poem_id": 626}, {"id": 3595, "content": "升堂坐阶新雨足，芭蕉叶大栀子肥。", "from": "韩愈《山石》", "poem_id": 65}, {"id": 3613, "content": "红颜弃轩冕，白首卧松云。", "from": "李白《赠孟浩然》", "poem_id": 95}, {"id": 3616, "content": "人事有代谢，往来成古今。", "from": "孟浩然《与诸子登岘山》", "poem_id": 120}, {"id": 3617, "content": "烹羊宰牛且为乐，会须一饮三百杯。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 3619, "content": "花近高楼伤客心，万方多难此登临。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 3620, "content": "功盖三分国，名成八阵图。", "from": "杜甫《八阵图》", "poem_id": 233}, {"id": 3621, "content": "绝代有佳人，幽居在空谷。", "from": "杜甫《佳人》", "poem_id": 8}, {"id": 3622, "content": "三月三日天气新，长安水边多丽人。", "from": "杜甫《丽人行》", "poem_id": 82}, {"id": 3623, "content": "花迎剑珮星初落，柳拂旌旗露未干。", "from": "岑参《奉和中书舍人贾至早朝大明宫》", "poem_id": 173}, {"id": 3626, "content": "渡远荆门外，来从楚国游。", "from": "李白《渡荆门送别》", "poem_id": 96}, {"id": 3627, "content": "料得年年肠断处，明月夜，短松冈。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 3628, "content": "千里孤坟，无处话凄凉。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 3632, "content": "关山魂梦长，鱼雁音尘少。", "from": "晏几道《生查子·关山魂梦长》", "poem_id": 380}, {"id": 3633, "content": "把酒祝东风，且共从容。", "from": "欧阳修《浪淘沙·把酒祝东风》", "poem_id": 355}, {"id": 3635, "content": "草色烟光残照里，无言谁会凭阑意。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 3646, "content": "折戟沉沙铁未销，自将磨洗认前朝。", "from": "杜牧《赤壁》", "poem_id": 288}, {"id": 3688, "content": "凤箫声动，玉壶光转，一夜鱼龙舞。", "from": "辛弃疾《青玉案·元夕》", "poem_id": 523}, {"id": 3689, "content": "洞庭青草，近中秋，更无一点风色。", "from": "张孝祥《念奴娇·过洞庭》", "poem_id": 497}, {"id": 3691, "content": "念桥边红药，年年知为谁生。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 3721, "content": "刘郎已恨蓬山远，更隔蓬山一万重！", "from": "李商隐《无题·来是空言去绝踪》", "poem_id": 209}, {"id": 3730, "content": "昨夜裙带解，今朝蟢子飞。", "from": "权德舆《玉台体》", "poem_id": 241}, {"id": 3739, "content": "长亭长在眼，更重重、远水孤云。", "from": "韩缜《凤箫吟·锁离愁》", "poem_id": 344}, {"id": 3741, "content": "自胡马窥江去后，废池乔木，犹厌言兵。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 3743, "content": "遥岑远目，献愁供恨，玉簪螺髻。", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 3748, "content": "试问卷帘人，却道海棠依旧。", "from": "李清照《如梦令·昨夜雨疏风骤》", "poem_id": 625}, {"id": 3756, "content": "可堪回首，佛狸祠下，一片神鸦社鼓。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 3757, "content": "斜阳草树，寻常巷陌，人道寄奴曾住。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 3761, "content": "君知否？乱鸦啼后，归兴浓于酒。", "from": "汪藻《点绛唇·新月娟娟》", "poem_id": 472}, {"id": 3764, "content": "梅英疏淡，冰澌溶泄，东风暗换年华。", "from": "秦观《望海潮·洛阳怀古》", "poem_id": 405}, {"id": 3847, "content": "何用别寻方外去，人间亦自有丹丘。", "from": "韩翃《同题仙游观》", "poem_id": 197}, {"id": 3848, "content": "时有落花至，远随流水香。", "from": "刘昚虚《阙题》", "poem_id": 138}, {"id": 3849, "content": "别来沧海事，语罢暮天钟。", "from": "李益《喜见外弟又言别》", "poem_id": 141}, {"id": 3853, "content": "知汝远来应有意，好收吾骨瘴江边。", "from": "韩愈《左迁至蓝关示侄孙湘》", "poem_id": 174}, {"id": 3859, "content": "天地英雄气，千秋尚凛然。", "from": "刘禹锡《蜀先主庙》", "poem_id": 145}, {"id": 3872, "content": "高阁客竟去，小园花乱飞。", "from": "李商隐《落花》", "poem_id": 153}, {"id": 3873, "content": "烦君最相警，我亦举家清。", "from": "李商隐《蝉》", "poem_id": 151}, {"id": 3876, "content": "曾是寂寥金烬暗，断无消息石榴红。", "from": "李商隐《无题·凤尾香罗薄几重》", "poem_id": 214}, {"id": 3877, "content": "斑骓只系垂杨岸，何处西南任好风。", "from": "李商隐《无题·凤尾香罗薄几重》", "poem_id": 214}, {"id": 3879, "content": "云鬓花颜金步摇，芙蓉帐暖度春宵。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 3884, "content": "此情可待成追忆，只是当时已惘然。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 3887, "content": "斜拔玉钗灯影畔，剔开红焰救飞蛾。", "from": "张祜《赠内人》", "poem_id": 281}, {"id": 3893, "content": "有花堪折直须折，莫待无花空折枝。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 3905, "content": "人面不知何处，绿波依旧东流。", "from": "晏殊《清平乐·红笺小字》", "poem_id": 335}, {"id": 3906, "content": "无情不似多情苦，一寸还成千万缕。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 3914, "content": "羽扇纶巾，谈笑间，樯橹灰飞烟灭。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 3915, "content": "冰肌玉骨，自清凉无汗。", "from": "苏轼《洞仙歌·冰肌玉骨》", "poem_id": 395}, {"id": 3924, "content": "身当恩遇常轻敌，力尽关山未解围。", "from": "高适《燕歌行》", "poem_id": 70}, {"id": 3925, "content": "今夕复何夕，共此灯烛光。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 3929, "content": "但见新人笑，那闻旧人哭。", "from": "杜甫《佳人》", "poem_id": 8}, {"id": 3930, "content": "霍如羿射九日落，矫如群帝骖龙翔。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 3931, "content": "来如雷霆收震怒，罢如江海凝清光。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 3932, "content": "永夜角声悲自语，中天月色好谁看。", "from": "杜甫《宿府》", "poem_id": 185}, {"id": 3934, "content": "即从巴峡穿巫峡，便下襄阳向洛阳。", "from": "杜甫《闻官军收河南河北》", "poem_id": 182}, {"id": 3935, "content": "白头搔更短，浑欲不胜簪。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 3936, "content": "凉风起天末，君子意如何。", "from": "杜甫《天末怀李白》", "poem_id": 105}, {"id": 3937, "content": "三顾频烦天下计，两朝开济老臣心。", "from": "杜甫《蜀相》", "poem_id": 179}, {"id": 3945, "content": "吾爱孟夫子，风流天下闻。", "from": "李白《赠孟浩然》", "poem_id": 95}, {"id": 3950, "content": "独有宦游人，偏惊物候新。", "from": "杜审言《和晋陵陆丞早春游望》", "poem_id": 89}, {"id": 3953, "content": "泉声咽危石，日色冷青松。", "from": "王维《过香积寺》", "poem_id": 115}, {"id": 3954, "content": "莫嫌旧日云中守，犹堪一战取功勋。", "from": "王维《老将行》", "poem_id": 73}, {"id": 3955, "content": "倚杖柴门外，临风听暮蝉。", "from": "王维《辋川闲居赠裴秀才迪》", "poem_id": 110}, {"id": 3970, "content": "乱石穿空，惊涛拍岸，卷起千堆雪。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 3994, "content": "多谢梅花，伴我微吟。", "from": "韩疁《高阳台·除夜》", "poem_id": 474}, {"id": 3998, "content": "江头宫殿锁千门，细柳新蒲为谁绿？", "from": "杜甫《哀江头》", "poem_id": 84}, {"id": 3999, "content": "一溪烟柳万丝垂，无因系得兰舟住。", "from": "周紫芝《踏莎行·情似游丝》", "poem_id": 481}, {"id": 4001, "content": "赤阑桥尽香街直，笼街细柳娇无力。", "from": "陈克《菩萨蛮·赤阑桥尽香街直》", "poem_id": 427}, {"id": 4006, "content": "雪云散尽，放晓晴池院。杨柳于人便青眼。", "from": "李元膺《洞仙歌·雪云散尽》", "poem_id": 429}, {"id": 4012, "content": "杨柳散和风，青山澹吾虑。", "from": "韦应物《东郊》", "poem_id": 30}, {"id": 4013, "content": "西宫南内多秋草，落叶满阶红不扫。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 4016, "content": "春风依旧。著意随堤柳。", "from": "赵令畤《清平乐·春风依旧》", "poem_id": 417}, {"id": 4022, "content": "嫁得瞿塘贾，朝朝误妾期。", "from": "李益《江南曲》", "poem_id": 258}, {"id": 4024, "content": "晓月过残垒，繁星宿故关。", "from": "司空曙《贼平后送人北归》", "poem_id": 144}, {"id": 4051, "content": "落叶满空山，何处寻行迹。", "from": "韦应物《寄全椒山中道士》", "poem_id": 27}, {"id": 4053, "content": "明朝挂帆席，枫叶落纷纷。", "from": "李白《夜泊牛渚怀古》", "poem_id": 99}, {"id": 4054, "content": "黄叶仍风雨，青楼自管弦。", "from": "李商隐《风雨》", "poem_id": 152}, {"id": 4062, "content": "荒戍落黄叶，浩然离故关。", "from": "温庭筠《送人东游》", "poem_id": 156}, {"id": 4072, "content": "凭栏久，黄芦苦竹，拟泛九江船。", "from": "周邦彦《满庭芳·夏日溧水无想山作》", "poem_id": 439}, {"id": 4078, "content": "野老念牧童，倚杖候荆扉。", "from": "王维《渭川田家》", "poem_id": 14}, {"id": 4098, "content": "回日楼台非甲帐，去时冠剑是丁年。", "from": "温庭筠《苏武庙》", "poem_id": 217}, {"id": 4100, "content": "献赋十年犹未遇，羞将白发对华簪。", "from": "钱起《赠阙下裴舍人》", "poem_id": 195}, {"id": 4105, "content": "年年社日停针线。怎忍见、双飞燕。", "from": "黄公绍《青玉案·年年社日停针线》", "poem_id": 595}, {"id": 4106, "content": "归云一去无踪迹，何处是前期？", "from": "柳永《少年游·长安古道马迟迟》", "poem_id": 363}, {"id": 4107, "content": "一襟余恨宫魂断，年年翠阴庭树。", "from": "王沂孙《齐天乐·蝉》", "poem_id": 617}, {"id": 4111, "content": "街南绿树春饶絮。雪满游春路。", "from": "晏几道《御街行·街南绿树春饶絮》", "poem_id": 387}, {"id": 4121, "content": "残日东风，不放岁华去。", "from": "吴文英《祝英台近·除夜立春》", "poem_id": 577}, {"id": 4123, "content": "楼上几日春寒，帘垂四面，玉阑干慵倚。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 4124, "content": "柳暝河桥，莺晴台苑，短策频惹春香。", "from": "吴文英《夜合花·自鹤江入京泊葑门外有感》", "poem_id": 568}, {"id": 4132, "content": "二月黄莺飞上林，春城紫禁晓阴阴。", "from": "钱起《赠阙下裴舍人》", "poem_id": 195}, {"id": 4145, "content": "鸳鸯密语同倾盖，且莫与、浣纱人说。", "from": "张炎《疏影·咏荷叶》", "poem_id": 612}, {"id": 4149, "content": "调角断清秋，征人倚戍楼。", "from": "张乔《书边事》", "poem_id": 159}, {"id": 4150, "content": "空园白露滴，孤壁野僧邻。", "from": "马戴《灞上秋居》", "poem_id": 157}, {"id": 4162, "content": "醉里秋波，梦中朝雨，都是醒时烦恼。", "from": "时彦《青门饮·寄宠人》", "poem_id": 430}, {"id": 4166, "content": "汉口夕阳斜渡鸟，洞庭秋水远连天。", "from": "刘长卿《自夏口至鹦鹉洲夕望岳阳寄源中丞》", "poem_id": 194}, {"id": 4192, "content": "不知香积寺，数里入云峰。", "from": "王维《过香积寺》", "poem_id": 115}, {"id": 4194, "content": "云开远见汉阳城，犹是孤帆一日程。", "from": "卢纶《晚次鄂州》", "poem_id": 199}, {"id": 4195, "content": "行宫见月伤心色，夜雨闻铃肠断声。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 4197, "content": "垂下帘栊。双燕归来细雨中。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 4201, "content": "骊宫高处入青云，仙乐风飘处处闻。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 4240, "content": "太乙近天都，连山接海隅。", "from": "王维《终南山》", "poem_id": 113}, {"id": 4252, "content": "应难奈，故人天际，望彻淮山，相思无雁足。", "from": "史达祖《八归·秋江带雨》", "poem_id": 557}, {"id": 4256, "content": "料黛眉重锁隋堤，芳心还动梁苑。", "from": "卢祖皋《宴清都·初春》", "poem_id": 563}, {"id": 4258, "content": "还始觉、留情缘眼，宽带因春。", "from": "吴文英《渡江云三犯·西湖清明》", "poem_id": 567}, {"id": 4259, "content": "但怪得、当年梦缘能短。", "from": "吴文英《三姝媚·过都城旧居有感》", "poem_id": 584}, {"id": 4267, "content": "绮席凝尘，香闺掩雾。", "from": "晏殊《踏莎行·碧海无波》", "poem_id": 342}, {"id": 4275, "content": "十二楼中尽晓妆，望仙楼上望君王。", "from": "薛逢《宫词》", "poem_id": 219}, {"id": 4277, "content": "新知遭薄俗，旧好隔良缘。", "from": "李商隐《风雨》", "poem_id": 152}, {"id": 4281, "content": "高山安可仰，徒此揖清芬。", "from": "李白《赠孟浩然》", "poem_id": 95}, {"id": 4294, "content": "料有牵情处，忍思量、耳边曾道。", "from": "时彦《青门饮·寄宠人》", "poem_id": 430}, {"id": 4300, "content": "忽闻歌古调，归思欲沾巾。", "from": "杜审言《和晋陵陆丞早春游望》", "poem_id": 89}, {"id": 4301, "content": "红叶黄花秋意晚，千里念行客。", "from": "晏几道《思远人·红叶黄花秋意晚》", "poem_id": 390}, {"id": 4308, "content": "明朝望乡处，应见陇头梅。", "from": "宋之问《题大庾岭北驿》", "poem_id": 91}, {"id": 4318, "content": "还将两行泪，遥寄海西头。", "from": "孟浩然《宿桐庐江寄广陵旧游》", "poem_id": 125}, {"id": 4319, "content": "乡心新岁切，天畔独潸然。", "from": "刘长卿《新年作》", "poem_id": 132}, {"id": 4330, "content": "伤心故人去后，冷落新诗。", "from": "李邴《汉宫春·梅》", "poem_id": 475}, {"id": 4332, "content": "前年伐月支，城上没全师。", "from": "张籍《没蕃故人》", "poem_id": 146}, {"id": 4333, "content": "感此怀故人，中宵劳梦想。", "from": "孟浩然《夏日南亭怀辛大》", "poem_id": 17}, {"id": 4334, "content": "十年离乱后，长大一相逢。", "from": "李益《喜见外弟又言别》", "poem_id": 141}, {"id": 4337, "content": "翠娥执手送临歧，轧轧开朱户。", "from": "柳永《采莲令·月华收》", "poem_id": 360}, {"id": 4340, "content": "举头望明月，低头思故乡。", "from": "李白《静夜思》", "poem_id": 231}, {"id": 4351, "content": "江上几人在，天涯孤棹还。", "from": "温庭筠《送人东游》", "poem_id": 156}, {"id": 4358, "content": "何当重相见，尊酒慰离颜。", "from": "温庭筠《送人东游》", "poem_id": 156}, {"id": 4366, "content": "燕燕飞来，问春何在，唯有池塘自碧。", "from": "姜夔《淡黄柳·空城晓角》", "poem_id": 536}, {"id": 4397, "content": "春风不相识，何事入罗帏。", "from": "李白《春思》", "poem_id": 5}, {"id": 4409, "content": "甚独抱清高，顿成凄楚。", "from": "王沂孙《齐天乐·蝉》", "poem_id": 617}, {"id": 4423, "content": "只匆匆眺远，早觉闲愁挂乔木。", "from": "史达祖《八归·秋江带雨》", "poem_id": 557}, {"id": 4427, "content": "楚江湄，湘娥乍见，无言洒清泪。", "from": "周密《绣鸾凤花犯·赋水仙》", "poem_id": 605}, {"id": 4436, "content": "秋江带雨，寒沙萦水，人瞰画阁愁独。", "from": "史达祖《八归·秋江带雨》", "poem_id": 557}, {"id": 4439, "content": "机中锦字论长恨，楼上花枝笑独眠。", "from": "皇甫冉《春思》", "poem_id": 198}, {"id": 4444, "content": "想文君望久，倚竹愁生步罗袜。", "from": "姜夔《八归·湘中送胡德华》", "poem_id": 532}, {"id": 4453, "content": "春衫著破谁针线。点点行行泪痕满。", "from": "黄公绍《青玉案·年年社日停针线》", "poem_id": 595}, {"id": 4457, "content": "愁损翠黛双蛾，日日画阑独凭。", "from": "史达祖《双双燕·咏燕》", "poem_id": 550}, {"id": 4468, "content": "短梦依然江表，老泪洒西州。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 4471, "content": "断肠片片飞红，都无人管，倩谁唤、流莺声住。", "from": "辛弃疾《祝英台近·晚春》", "poem_id": 522}, {"id": 4472, "content": "情似游丝，人如飞絮。泪珠阁定空相觑。", "from": "周紫芝《踏莎行·情似游丝》", "poem_id": 481}, {"id": 4473, "content": "坠粉飘香，日日唤愁生。", "from": "卢祖皋《江城子·画楼帘暮卷新晴》", "poem_id": 562}, {"id": 4479, "content": "断肠何必更残阳，极目伤平楚。", "from": "廖世美《烛影摇红·题安陆浮云楼》", "poem_id": 489}, {"id": 4490, "content": "欲共柳花低诉，怕柳花轻薄，不解伤春。", "from": "黄孝迈《湘春夜月·近清明》", "poem_id": 593}, {"id": 4501, "content": "髻子伤春慵更梳。晚风庭院落梅初。", "from": "李清照《浣溪沙·髻子伤春慵更梳》", "poem_id": 631}, {"id": 4511, "content": "山暝闻猿愁，沧江急夜流。", "from": "孟浩然《宿桐庐江寄广陵旧游》", "poem_id": 125}, {"id": 4526, "content": "香雾云鬟湿，清辉玉臂寒。", "from": "杜甫《月夜》", "poem_id": 101}, {"id": 4527, "content": "吴楚东南坼，乾坤日夜浮。", "from": "杜甫《登岳阳楼》", "poem_id": 109}, {"id": 4529, "content": "此地一为别，孤蓬万里征。", "from": "李白《送友人》", "poem_id": 97}, {"id": 4535, "content": "马上相逢无纸笔，凭君传语报平安。", "from": "岑参《逢入京使》", "poem_id": 268}, {"id": 4538, "content": "欲持一瓢酒，远慰风雨夕。", "from": "韦应物《寄全椒山中道士》", "poem_id": 27}, {"id": 4540, "content": "盘飧市远无兼味，樽酒家贫只旧醅。", "from": "杜甫《客至》", "poem_id": 180}, {"id": 4544, "content": "险韵诗成，扶头酒醒，别是闲滋味。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 4572, "content": "曲岸持觞，垂杨系马，此地曾经别。", "from": "辛弃疾《念奴娇·书东流村壁》", "poem_id": 515}, {"id": 4573, "content": "傍枯林古道，长河饮马，此意悠悠。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 4580, "content": "至今窥牧马，不敢过临洮。", "from": "西鄙人《哥舒歌》", "poem_id": 250}, {"id": 4598, "content": "试浇桥下水，今夕到湘中。", "from": "陈与义《临江仙·高咏楚词酬午日》", "poem_id": 476}, {"id": 4599, "content": "一身犹在，乱山深处，寂寞溪桥畔。", "from": "黄公绍《青玉案·年年社日停针线》", "poem_id": 595}, {"id": 4601, "content": "野棠花落，又匆匆过了，清明时节。", "from": "辛弃疾《念奴娇·书东流村壁》", "poem_id": 515}, {"id": 4622, "content": "云边雁断胡天月，陇上羊归塞草烟。", "from": "温庭筠《苏武庙》", "poem_id": 217}, {"id": 4630, "content": "犹记得、当年深隐，门掩两三株。", "from": "张炎《渡江云·山阴久客一再逢春回忆西杭渺然愁思》", "poem_id": 614}, {"id": 4632, "content": "念去来、岁月如流，徘徊久、叹息愁思盈。", "from": "周邦彦《绮寮怨·上马人扶残醉》", "poem_id": 449}, {"id": 4633, "content": "纵收香藏镜，他年重到，人面桃花在否。", "from": "袁去华《瑞鹤仙·郊原初过雨》", "poem_id": 500}, {"id": 4635, "content": "暗数十年湖上路，能几度，著娉婷。", "from": "卢祖皋《江城子·画楼帘暮卷新晴》", "poem_id": 562}, {"id": 4643, "content": "闲门向山路，深柳读书堂。", "from": "刘昚虚《阙题》", "poem_id": 138}, {"id": 4660, "content": "人生如此自可乐，岂必局束为人鞿？", "from": "韩愈《山石》", "poem_id": 65}, {"id": 4666, "content": "月台花榭，琐窗朱户，只有春知处。", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 4675, "content": "谁道闲情抛掷久？", "from": "冯延巳《鹊踏枝·谁道闲情抛掷久》", "poem_id": 350}, {"id": 4687, "content": "复值接舆醉，狂歌五柳前。", "from": "王维《辋川闲居赠裴秀才迪》", "poem_id": 110}, {"id": 4688, "content": "拟把疏狂图一醉，对酒当歌，强乐还无味。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 4703, "content": "凌波不过横塘路，但目送、芳尘去。", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 4705, "content": "长门事，准拟佳期又误。", "from": "辛弃疾《摸鱼儿·更能消几番风雨》", "poem_id": 519}, {"id": 4722, "content": "剑阁峥嵘而崔嵬，一夫当关，万夫莫开。", "from": "李白《蜀道难》", "poem_id": 75}, {"id": 4726, "content": "钟鼓馔玉不足贵，但愿长醉不复醒。", "from": "李白《将进酒》", "poem_id": 80}, {"id": 4728, "content": "人扶醉，月依墙，是当初、谁敢疏狂！", "from": "史达祖《夜合花·柳锁莺魂》", "poem_id": 555}, {"id": 4770, "content": "每到春来，惆怅还依旧。", "from": "冯延巳《鹊踏枝·谁道闲情抛掷久》", "poem_id": 350}, {"id": 4780, "content": "折芦花赠远，零落一身秋。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 4797, "content": "多情自古伤离别，更那堪，冷落清秋节！", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 4798, "content": "一身转战三千里，一剑曾当百万师。", "from": "王维《老将行》", "poem_id": 73}, {"id": 4801, "content": "夕阳西下几时回？", "from": "晏殊《浣溪沙·一曲新词酒一杯》", "poem_id": 333}, {"id": 4804, "content": "天不老，人未偶。", "from": "李之仪《谢池春·残寒销尽》", "poem_id": 431}, {"id": 4805, "content": "求田问舍，怕应羞见，刘郎才气。", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 4808, "content": "夜已三更，金波淡，玉绳低转。", "from": "苏轼《洞仙歌·冰肌玉骨》", "poem_id": 395}, {"id": 4811, "content": "月桥花院，琐窗朱户，只有春知处。", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 4812, "content": "试问闲情都几许？", "from": "贺铸《青玉案·凌波不过横塘路》", "poem_id": 457}, {"id": 4816, "content": "我来正逢秋雨节，阴气晦昧无清风。", "from": "韩愈《谒衡岳庙遂宿岳寺题门楼》", "poem_id": 63}, {"id": 4826, "content": "一望关河萧索，千里清秋，忍凝眸？", "from": "柳永《曲玉管·陇首云飞》", "poem_id": 357}, {"id": 4866, "content": "念月榭携手，露桥闻笛。", "from": "周邦彦《兰陵王·柳》", "poem_id": 435}, {"id": 4886, "content": "朱颜那有年年好，逞艳游、赢取如今。", "from": "韩疁《高阳台·除夜》", "poem_id": 474}, {"id": 4895, "content": "雁过也，正伤心，却是旧时相识。", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 4903, "content": "淑气催黄鸟，晴光转绿蘋。", "from": "杜审言《和晋陵陆丞早春游望》", "poem_id": 89}, {"id": 4912, "content": "绿杯红袖趁重阳。人情似故乡。", "from": "晏几道《阮郎归·天边金掌露成霜》", "poem_id": 385}, {"id": 4923, "content": "忆得盈盈拾翠侣，共携赏、凤城寒食。", "from": "李甲《帝台春·芳草碧色》", "poem_id": 482}, {"id": 4953, "content": "人归山郭暗，雁下芦洲白。", "from": "韦应物《夕次盱眙县》", "poem_id": 29}, {"id": 4965, "content": "来相召、香车宝马，谢他酒朋诗侣。", "from": "李清照《永遇乐·落日熔金》", "poem_id": 630}, {"id": 4982, "content": "未羞他、双燕归来，画帘半卷。", "from": "张炎《解连环·孤雁》", "poem_id": 611}, {"id": 4983, "content": "无情燕子，怕春寒、轻失花期。", "from": "李邴《汉宫春·梅》", "poem_id": 475}, {"id": 4994, "content": "风日薄、度墙啼鸟声乱。", "from": "卢祖皋《宴清都·初春》", "poem_id": 563}, {"id": 5018, "content": "天明独去无道路，出入高下穷烟霏。", "from": "韩愈《山石》", "poem_id": 65}, {"id": 5031, "content": "山暝闻猿愁，沧江急夜流。", "from": "孟浩然《宿桐庐江寄广陵旧游》", "poem_id": 125}, {"id": 5039, "content": "繁华事散逐香尘，流水无情草自春。", "from": "杜牧《金谷园》", "poem_id": 295}, {"id": 5051, "content": "想佩环、月夜归来，化作此花幽独。", "from": "姜夔《疏影·苔枝缀玉》", "poem_id": 538}, {"id": 5070, "content": "楼头残梦五更钟，花底离情三月雨。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 5073, "content": "不知何处吹芦管，一夜征人尽望乡。", "from": "李益《夜上受降城闻笛》", "poem_id": 277}, {"id": 5100, "content": "连歌数阕，皆清真词。", "from": "吴文英《惜黄花慢·送客吴皋》", "poem_id": 581}, {"id": 5105, "content": "觉客程劳，年光晚。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 5110, "content": "弟子韩干早入室，亦能画马穷殊相。", "from": "杜甫《丹青引赠曹将军霸》", "poem_id": 58}, {"id": 5132, "content": "元嘉草草，封狼居胥，赢得仓皇北顾。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 5153, "content": "石鼓之歌止于此，呜呼吾意其蹉跎。", "from": "韩愈《石鼓歌》", "poem_id": 64}, {"id": 5154, "content": "寄卧郊扉久，何年致此身。", "from": "马戴《灞上秋居》", "poem_id": 157}, {"id": 5168, "content": "乍咽凉柯，还移暗叶，重把离愁深诉。", "from": "王沂孙《齐天乐·蝉》", "poem_id": 617}, {"id": 5179, "content": "采幽香，巡古苑，竹冷翠微路。", "from": "吴文英《祝英台近·春日客龟溪游废园》", "poem_id": 576}, {"id": 5190, "content": "起来搔首，梅影横窗瘦。", "from": "汪藻《点绛唇·新月娟娟》", "poem_id": 472}, {"id": 5196, "content": "料黛眉重锁隋堤，芳心还动梁苑。", "from": "卢祖皋《宴清都·初春》", "poem_id": 563}, {"id": 5208, "content": "独怜幽草涧边生，上有黄鹂深树鸣。", "from": "韦应物《滁州西涧》", "poem_id": 270}, {"id": 5209, "content": "旧时王谢堂前燕，飞入寻常百姓家。", "from": "刘禹锡《乌衣巷》", "poem_id": 278}, {"id": 5212, "content": "春窗曙灭九微火，九微片片飞花琐。", "from": "王维《洛阳女儿行》", "poem_id": 72}, {"id": 5221, "content": "空自觉、围羞带减，影怯灯孤。", "from": "张炎《渡江云·山阴久客一再逢春回忆西杭渺然愁思》", "poem_id": 614}, {"id": 5243, "content": "云澹星疏楚山晓。", "from": "吴文英《夜游宫·人去西楼雁杳》", "poem_id": 589}, {"id": 5269, "content": "小窗愁黛淡秋山。", "from": "吴文英《鹧鸪天·化度寺作》", "poem_id": 588}, {"id": 5270, "content": "杨柳散和风，青山澹吾虑。", "from": "韦应物《东郊》", "poem_id": 30}, {"id": 5278, "content": "丽谯吹罢小单于。", "from": "秦观《阮郎归·湘天风雨破寒初》", "poem_id": 412}, {"id": 5279, "content": "长门事，准拟佳期又误。", "from": "辛弃疾《摸鱼儿·更能消几番风雨》", "poem_id": 519}, {"id": 5292, "content": "画帘开、束衣纨扇，午风清暑。", "from": "刘克庄《贺新郎·端午》", "poem_id": 559}, {"id": 5296, "content": "敛兵卫、阊阖门开，住传宣、又还休务。", "from": "万俟咏《三台·清明应制》", "poem_id": 484}, {"id": 5301, "content": "凭谁为歌长恨？暗殿锁、秋灯夜语。", "from": "吴文英《宴清都·连理海棠》", "poem_id": 570}, {"id": 5319, "content": "心期切处，更有多少凄凉，殷勤留与归时说。", "from": "张元干《石州慢·寒水依痕》", "poem_id": 468}, {"id": 5321, "content": "翦红情，裁绿意，花信上钗股。", "from": "吴文英《祝英台近·除夜立春》", "poem_id": 577}, {"id": 5328, "content": "校尉羽书飞瀚海，单于猎火照狼山。", "from": "高适《燕歌行》", "poem_id": 70}, {"id": 5329, "content": "情人怨遥夜，竟夕起相思。", "from": "张九龄《望月怀远》", "poem_id": 86}, {"id": 5332, "content": "玉勒雕鞍游冶处，楼高不见章台路。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 5341, "content": "楚天晚，白苹烟尽处，红蓼水边头。", "from": "张耒《风流子·木叶亭皋下》", "poem_id": 418}, {"id": 5353, "content": "不据山河据平地，长戈利矛日可麾。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 5373, "content": "异乡风物，忍萧索、当愁眼。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 5374, "content": "九十光阴能有几？金龟解尽留无计。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 5377, "content": "使臣将王命，岂不如贼焉？", "from": "元结《贼退示官吏》", "poem_id": 24}, {"id": 5411, "content": "又片片、吹尽也，几时见得？", "from": "姜夔《暗香·旧时月色》", "poem_id": 537}, {"id": 5419, "content": "绣圈犹带脂香浅。", "from": "吴文英《踏莎行·润玉笼绡》", "poem_id": 586}, {"id": 5425, "content": "露从今夜白，月是故乡明。", "from": "杜甫《月夜忆舍弟》", "poem_id": 104}, {"id": 5431, "content": "床前明月光，疑是地上霜。", "from": "李白《静夜思》", "poem_id": 231}, {"id": 5438, "content": "绿杯红袖趁重阳。人情似故乡。", "from": "晏几道《阮郎归·天边金掌露成霜》", "poem_id": 385}, {"id": 5439, "content": "此恨难平君知否，似琼台、涌起弹棋局。", "from": "蒋捷《贺新郎·梦冷黄金屋》", "poem_id": 607}, {"id": 5462, "content": "飘然快拂花梢，翠尾分开红影。", "from": "史达祖《双双燕·咏燕》", "poem_id": 550}, {"id": 5473, "content": "浑未辨，黄柑荐酒，更传青韭堆盘？", "from": "辛弃疾《汉宫春·立春日》", "poem_id": 516}, {"id": 5476, "content": "欲尽此情书尺素，浮雁沉鱼，终了无凭据。", "from": "晏几道《蝶恋花·梦入江南烟水路》", "poem_id": 375}, {"id": 5481, "content": "青山隐隐水迢迢，秋尽江南草未凋。", "from": "杜牧《寄扬州韩绰判官》", "poem_id": 290}, {"id": 5493, "content": "客路青山外，行舟绿水前。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 5499, "content": "试拂铁衣如雪色，聊持宝剑动星文。", "from": "王维《老将行》", "poem_id": 73}, {"id": 5503, "content": "薄暮空潭曲，安禅制毒龙。", "from": "王维《过香积寺》", "poem_id": 115}, {"id": 5508, "content": "云霞出海曙，梅柳渡江春。", "from": "杜审言《和晋陵陆丞早春游望》", "poem_id": 89}, {"id": 5524, "content": "望天不尽，背城渐杳，离亭黯黯，恨永迢迢。", "from": "吴文英《惜黄花慢·送客吴皋》", "poem_id": 581}, {"id": 5531, "content": "银烛秋光冷画屏，轻罗小扇扑流萤。", "from": "杜牧《秋夕》", "poem_id": 292}, {"id": 5541, "content": "晚春盘马踏青苔，曾傍绿阴深驻。", "from": "晏几道《御街行·街南绿树春饶絮》", "poem_id": 387}, {"id": 5560, "content": "云澹星疏楚山晓。", "from": "吴文英《夜游宫·人去西楼雁杳》", "poem_id": 589}, {"id": 5572, "content": "闻道汉家天子使，九华帐里梦魂惊。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 5588, "content": "居人匹马映林嘶，行人去棹依波转。", "from": "晏殊《踏莎行·祖席离歌》", "poem_id": 340}, {"id": 5615, "content": "翠玉楼前，惟是有、一波湘水，摇荡湘云。", "from": "黄孝迈《湘春夜月·近清明》", "poem_id": 593}, {"id": 5627, "content": "半壶秋水荐黄花，香噀西风雨。", "from": "吴文英《霜叶飞·重九》", "poem_id": 569}, {"id": 5634, "content": "悄无人、舟横野渡。", "from": "廖世美《烛影摇红·题安陆浮云楼》", "poem_id": 489}, {"id": 5638, "content": "道由白云尽，春与青溪长。", "from": "刘昚虚《阙题》", "poem_id": 138}, {"id": 5658, "content": "道人庭宇静，苔色连深竹。", "from": "柳宗元《晨诣超师院读禅经》", "poem_id": 32}, {"id": 5665, "content": "把酒祝东风，且共从容。", "from": "欧阳修《浪淘沙·把酒祝东风》", "poem_id": 355}, {"id": 5681, "content": "被冷香消新梦觉，不许愁人不起。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 5693, "content": "旧游无处不堪寻。无寻处，惟有少年心。", "from": "章良能《小重山·柳暗花明春事深》", "poem_id": 543}, {"id": 5708, "content": "约何时再，正春浓酒困，人闲昼永无聊赖。", "from": "贺铸《薄幸·淡妆多态》", "poem_id": 459}, {"id": 5709, "content": "天不老，情难绝。", "from": "张先《千秋岁·数声鶗鴂》", "poem_id": 325}, {"id": 5736, "content": "偷弹清泪寄烟波，见江头故人，为言憔悴如许。", "from": "袁去华《剑器近·夜来雨》", "poem_id": 501}, {"id": 5744, "content": "花近高楼伤客心，万方多难此登临。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 5756, "content": "旧赏轻抛，到此成游宦。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 5761, "content": "中军置酒饮归客，胡琴琵琶与羌笛。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 5763, "content": "轻衫未揽，犹将泪点偷藏。", "from": "史达祖《夜合花·柳锁莺魂》", "poem_id": 555}, {"id": 5765, "content": "东厢月，一天风露，杏花如雪。", "from": "范成大《秦楼月·楼阴缺》", "poem_id": 509}, {"id": 5767, "content": "流红千浪，缺月孤楼，总难留燕。", "from": "吴文英《瑞鹤仙·晴丝牵绪乱》", "poem_id": 587}, {"id": 5768, "content": "啼到春归无寻处，苦恨芳菲都歇。", "from": "辛弃疾《贺新郎·别茂嘉十二弟》", "poem_id": 514}, {"id": 5772, "content": "夜夜除非，好梦留人睡。", "from": "范仲淹《苏幕遮·怀旧》", "poem_id": 323}, {"id": 5802, "content": "今彼征敛者，迫之如火煎。", "from": "元结《贼退示官吏》", "poem_id": 24}, {"id": 5824, "content": "嗟万事难忘，惟是轻别。", "from": "周邦彦《浪淘沙慢·晓阴重》", "poem_id": 453}, {"id": 5829, "content": "笙歌散尽游人去，始觉春空。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 5842, "content": "老夫不知其所往，足茧荒山转愁疾。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 5843, "content": "禁门宫树月痕过，媚眼惟看宿鹭窠。", "from": "张祜《赠内人》", "poem_id": 281}, {"id": 5902, "content": "土花庭甃，虫网阑干。", "from": "史达祖《玉蝴蝶·晚雨未摧宫树》", "poem_id": 556}, {"id": 5918, "content": "多情只有春庭月，犹为离人照落花。", "from": "张泌《寄人》", "poem_id": 308}, {"id": 5928, "content": "愿书万本诵万遍，口角流沫右手胝。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 5938, "content": "白日放歌须纵酒，青春作伴好还乡。", "from": "杜甫《闻官军收河南河北》", "poem_id": 182}, {"id": 5958, "content": "谁解乘舟寻范蠡，五湖烟水独忘机。", "from": "温庭筠《利州南渡》", "poem_id": 216}, {"id": 6034, "content": "乱石穿空，惊涛拍岸，卷起千堆雪。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 6059, "content": "少陵无人谪仙死，才薄将奈石鼓何。", "from": "韩愈《石鼓歌》", "poem_id": 64}, {"id": 6113, "content": "羽扇纶巾，谈笑间，樯橹灰飞烟灭。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 6116, "content": "散入珠帘湿罗幕，狐裘不暖锦衾薄。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 6131, "content": "雨馀风软碎鸣禽。", "from": "章良能《小重山·柳暗花明春事深》", "poem_id": 543}, {"id": 6160, "content": "宝带金章，尊前茸帽风欹。", "from": "周密《高阳台·送陈君衡被召》", "poem_id": 601}, {"id": 6177, "content": "趁残鸦、飞过苍茫。", "from": "吴文英《夜合花·自鹤江入京泊葑门外有感》", "poem_id": 568}, {"id": 6217, "content": "路旁时卖故侯瓜，门前学种先生柳。", "from": "王维《老将行》", "poem_id": 73}, {"id": 6219, "content": "雁柱十三弦，一一春莺语。", "from": "欧阳修《生查子·含羞整翠鬟》", "poem_id": 332}, {"id": 6223, "content": "空相对，残红无寐，满村社鼓。", "from": "刘辰翁《永遇乐·璧月初晴》", "poem_id": 598}, {"id": 6227, "content": "造化钟神秀，阴阳割昏晓。", "from": "杜甫《望岳》", "poem_id": 6}, {"id": 6232, "content": "晚来天欲雪，能饮一杯无？", "from": "白居易《问刘十九》", "poem_id": 244}, {"id": 6242, "content": "春风桃李花开日，秋雨梧桐叶落时。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 6273, "content": "入蔡缚贼献太庙，功无与让恩不訾。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 6282, "content": "玉勒雕鞍游冶处，楼高不见章台路。", "from": "欧阳修《蝶恋花·庭院深深深几许》", "poem_id": 349}, {"id": 6330, "content": "海阔山遥，未知何处是潇湘。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 6357, "content": "又还是、宫烛分烟，奈愁里、匆匆换时节。", "from": "姜夔《琵琶仙·双桨来时》", "poem_id": 531}, {"id": 6374, "content": "叹神游故国，花记前度。", "from": "刘辰翁《兰陵王·丙子送春》", "poem_id": 597}, {"id": 6375, "content": "香冷金猊，被翻红浪，起来人未梳头。", "from": "李清照《凤凰台上忆吹箫·香冷金猊》", "poem_id": 626}, {"id": 6400, "content": "短景归秋，吟思又接愁边。", "from": "史达祖《玉蝴蝶·晚雨未摧宫树》", "poem_id": 556}, {"id": 6402, "content": "向晚骤、宝马雕鞍，醉襟惹、乱花飞絮。", "from": "万俟咏《三台·清明应制》", "poem_id": 484}, {"id": 6455, "content": "中有一人字太真，雪肤花貌参差是。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 6456, "content": "槛菊萧疏，井梧零乱，惹残烟。", "from": "柳永《戚氏·晚秋天》", "poem_id": 364}, {"id": 6462, "content": "起来携素手，庭户无声，时见疏星渡河汉。", "from": "苏轼《洞仙歌·冰肌玉骨》", "poem_id": 395}, {"id": 6463, "content": "山回路转不见君，雪上空留马行处。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 6464, "content": "酒酣应对燕山雪，正冰河月冻，晓陇云飞。", "from": "周密《高阳台·送陈君衡被召》", "poem_id": 601}, {"id": 6469, "content": "但茫茫暮霭，目断武陵溪，往事难追。", "from": "韩元吉《六州歌头·东风著意》", "poem_id": 498}, {"id": 6477, "content": "欲为圣明除弊事，肯将衰朽惜残年。", "from": "韩愈《左迁至蓝关示侄孙湘》", "poem_id": 174}, {"id": 6486, "content": "斑骓只系垂杨岸，何处西南任好风。", "from": "李商隐《无题·凤尾香罗薄几重》", "poem_id": 214}, {"id": 6492, "content": "浙江轻浪去悠悠，望海楼吹望海愁。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 6498, "content": "高帝子孙尽隆准，龙种自与常人殊。", "from": "杜甫《哀王孙》", "poem_id": 83}, {"id": 6522, "content": "江山留胜迹，我辈复登临。", "from": "孟浩然《与诸子登岘山》", "poem_id": 120}, {"id": 6545, "content": "借问苦心爱者谁，后有韦讽前支遁。", "from": "杜甫《韦讽录事宅观曹将军画马图》", "poem_id": 57}, {"id": 6548, "content": "山川萧条极边土，胡骑凭陵杂风雨。", "from": "高适《燕歌行》", "poem_id": 70}, {"id": 6549, "content": "是处红衰翠减，苒苒物华休。", "from": "柳永《八声甘州·对潇潇暮雨洒江天》", "poem_id": 367}, {"id": 6554, "content": "又入铜驼，遍旧家门巷，首询声价。", "from": "史达祖《三姝媚·烟光摇缥瓦》", "poem_id": 553}, {"id": 6585, "content": "金粟堆前木已拱，瞿唐石城草萧瑟。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 6588, "content": "噫吁嚱，危乎高哉！", "from": "李白《蜀道难》", "poem_id": 75}, {"id": 6590, "content": "朝云信断知何处？应作襄王春梦去。", "from": "晏几道《木兰花·秋千院落重帘暮》", "poem_id": 382}, {"id": 6597, "content": "文章憎命达，魑魅喜人过。", "from": "杜甫《天末怀李白》", "poem_id": 105}, {"id": 6604, "content": "尽挹西江，细斟北斗，万象为宾客。", "from": "张孝祥《念奴娇·过洞庭》", "poem_id": 497}, {"id": 6618, "content": "前年伐月支，城上没全师。", "from": "张籍《没蕃故人》", "poem_id": 146}, {"id": 6632, "content": "何用别寻方外去，人间亦自有丹丘。", "from": "韩翃《同题仙游观》", "poem_id": 197}, {"id": 6633, "content": "牛渚西江夜，青天无片云。", "from": "李白《夜泊牛渚怀古》", "poem_id": 99}, {"id": 6637, "content": "铁衣远戍辛勤久，玉箸应啼别离后。", "from": "高适《燕歌行》", "poem_id": 70}, {"id": 6638, "content": "寒窗梦里，犹记经行旧时路。", "from": "张炎《月下笛·万里孤云》", "poem_id": 613}, {"id": 6649, "content": "高山安可仰，徒此揖清芬。", "from": "李白《赠孟浩然》", "poem_id": 95}, {"id": 6655, "content": "寄书长不达，况乃未休兵。", "from": "杜甫《月夜忆舍弟》", "poem_id": 104}, {"id": 6668, "content": "孤灯寒照雨，深竹暗浮烟。", "from": "司空曙《云阳馆与韩绅宿别》", "poem_id": 142}, {"id": 6714, "content": "与余问答既有以，感时抚事增惋伤。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 6741, "content": "记玉关踏雪事清游，寒气脆貂裘。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 6742, "content": "蜀道之难,难于上青天，侧身西望长咨嗟！", "from": "李白《蜀道难》", "poem_id": 75}, {"id": 6754, "content": "情人怨遥夜，竟夕起相思。", "from": "张九龄《望月怀远》", "poem_id": 86}, {"id": 6761, "content": "强整帽檐欹侧，曾经向、天涯搔首。", "from": "潘希白《大有·九日》", "poem_id": 594}, {"id": 6771, "content": "天生丽质难自弃，一朝选在君王侧。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 6778, "content": "少壮能几时，鬓发各已苍。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 6784, "content": "楚天晚，白苹烟尽处，红蓼水边头。", "from": "张耒《风流子·木叶亭皋下》", "poem_id": 418}, {"id": 6798, "content": "高楼目尽欲黄昏，梧桐叶上萧萧雨。", "from": "晏殊《踏莎行·碧海无波》", "poem_id": 342}, {"id": 6809, "content": "飞絮濛濛。垂柳阑干尽日风。", "from": "欧阳修《采桑子·群芳过后西湖好》", "poem_id": 346}, {"id": 6811, "content": "红杏香中箫鼓，绿杨影里秋千。", "from": "俞国宝《风入松·一春长费买花钱》", "poem_id": 546}, {"id": 6818, "content": "一鞭南陌，几篙官渡，赖有歌眉舒绿。", "from": "史达祖《八归·秋江带雨》", "poem_id": 557}, {"id": 6823, "content": "当时轻别意中人，山长水远知何处。", "from": "晏殊《踏莎行·碧海无波》", "poem_id": 342}, {"id": 6872, "content": "料得年年肠断处，明月夜，短松冈。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 6880, "content": "金鞭断折九马死，骨肉不得同驰驱。", "from": "杜甫《哀王孙》", "poem_id": 83}, {"id": 6881, "content": "不枉东风吹客泪。相思难表，梦魂无据，惟有归来是。", "from": "欧阳修《青玉案·一年春事都来几》", "poem_id": 356}, {"id": 6946, "content": "仍怜故乡水，万里送行舟。", "from": "李白《渡荆门送别》", "poem_id": 96}, {"id": 6953, "content": "又说是、蛟馋龙怒。", "from": "刘克庄《贺新郎·端午》", "poem_id": 559}, {"id": 6960, "content": "如今风雨西楼夜，不听清歌也泪垂。", "from": "周紫芝《鹧鸪天·一点残红欲尽时》", "poem_id": 480}, {"id": 6964, "content": "眼想心思梦里惊，无人知我此时情。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 6971, "content": "日暮，青盖亭亭，情人不见，争忍凌波去？", "from": "姜夔《念奴娇·闹红一舸》", "poem_id": 533}, {"id": 6973, "content": "元嘉草草，封狼居胥，赢得仓皇北顾。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 6981, "content": "欲为圣明除弊事，肯将衰朽惜残年。", "from": "韩愈《左迁至蓝关示侄孙湘》", "poem_id": 174}, {"id": 6987, "content": "翠叶吹凉，玉容消酒，更洒菇蒲雨。", "from": "姜夔《念奴娇·闹红一舸》", "poem_id": 533}, {"id": 7005, "content": "水月通禅寂，鱼龙听梵声。", "from": "钱起《送僧归日本》", "poem_id": 133}, {"id": 7007, "content": "永夜闲阶卧桂影。", "from": "晁补之《洞仙歌·泗州中秋作》", "poem_id": 422}, {"id": 7008, "content": "采幽香，巡古苑，竹冷翠微路。", "from": "吴文英《祝英台近·春日客龟溪游废园》", "poem_id": 576}, {"id": 7026, "content": "向河梁、回头万里，故人长绝。", "from": "辛弃疾《贺新郎·别茂嘉十二弟》", "poem_id": 514}, {"id": 7028, "content": "泛画鹢、翩翩过南浦。", "from": "柳永《夜半乐·冻云黯淡天气》", "poem_id": 365}, {"id": 7051, "content": "背飞双燕贴云寒，独向小楼东畔、倚阑看。", "from": "舒亶《虞美人·寄公度》", "poem_id": 424}, {"id": 7052, "content": "纵豆蔻词工，青楼梦好，难赋深情。", "from": "姜夔《扬州慢·淮左名都》", "poem_id": 534}, {"id": 7079, "content": "唯柳色夹道，依依可怜。", "from": "姜夔《淡黄柳·空城晓角》", "poem_id": 536}, {"id": 7088, "content": "聊对旧节传杯，尘笺蠹管，断阕经岁慵赋。", "from": "吴文英《霜叶飞·重九》", "poem_id": 569}, {"id": 7117, "content": "岭猿同旦暮，江柳共风烟。", "from": "刘长卿《新年作》", "poem_id": 132}, {"id": 7127, "content": "孤城暮角，引胡笳怨。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 7137, "content": "居人匹马映林嘶，行人去棹依波转。", "from": "晏殊《踏莎行·祖席离歌》", "poem_id": 340}, {"id": 7138, "content": "金陵路、莺吟燕舞。", "from": "姜夔《杏花天影·绿丝低拂鸳鸯浦》", "poem_id": 540}, {"id": 7142, "content": "晚来翠眉宫样，巧把远山学。", "from": "晏几道《六幺令·绿阴春尽》", "poem_id": 386}, {"id": 7144, "content": "昨者州前捶大鼓，嗣皇继圣登夔皋。", "from": "韩愈《八月十五夜赠张功曹》", "poem_id": 62}, {"id": 7179, "content": "乍见翻疑梦，相悲各问年。", "from": "司空曙《云阳馆与韩绅宿别》", "poem_id": 142}, {"id": 7186, "content": "晚春盘马踏青苔，曾傍绿荫深驻。", "from": "晏几道《御街行·街南绿树春饶絮》", "poem_id": 387}, {"id": 7193, "content": "都门帐饮无绪，留恋处，兰舟催发。", "from": "柳永《雨霖铃·寒蝉凄切》", "poem_id": 358}, {"id": 7209, "content": "主称会面难，一举累十觞。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 7211, "content": "朱雀桥边野草花，乌衣巷口夕阳斜。", "from": "刘禹锡《乌衣巷》", "poem_id": 278}, {"id": 7223, "content": "伤情处，高城望断，灯火已黄昏。", "from": "秦观《满庭芳·山抹微云》", "poem_id": 407}, {"id": 7230, "content": "空掩袖，倚寒竹。", "from": "蒋捷《贺新郎·梦冷黄金屋》", "poem_id": 607}, {"id": 7243, "content": "是处红衰翠减，苒苒物华休。", "from": "柳永《八声甘州·对潇潇暮雨洒江天》", "poem_id": 367}, {"id": 7245, "content": "记玉关踏雪事清游，寒气脆貂裘。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 7257, "content": "夕殿萤飞思悄然，孤灯挑尽未成眠。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 7265, "content": "睡里消魂无说处，觉来惆怅消魂误。", "from": "晏几道《蝶恋花·梦入江南烟水路》", "poem_id": 375}, {"id": 7270, "content": "也应惊问：近来多少华发？", "from": "辛弃疾《念奴娇·书东流村壁》", "poem_id": 515}, {"id": 7297, "content": "念秦楼也拟人归，应剪菖蒲自酌。", "from": "吴文英《澡兰香·淮安重午》", "poem_id": 578}, {"id": 7306, "content": "被冷香消新梦觉，不许愁人不起。", "from": "李清照《念奴娇·春情》", "poem_id": 629}, {"id": 7315, "content": "因度此阕，以纾客怀。", "from": "姜夔《淡黄柳·空城晓角》", "poem_id": 536}, {"id": 7390, "content": "甚时跃马归来，认得迎门轻笑。", "from": "时彦《青门饮·寄宠人》", "poem_id": 430}, {"id": 7412, "content": "玉骢惯识西湖路，骄嘶过、沽酒楼前。", "from": "俞国宝《风入松·一春长费买花钱》", "poem_id": 546}, {"id": 7433, "content": "归来视幼女，零泪缘缨流。", "from": "韦应物《送杨氏女》", "poem_id": 31}, {"id": 7460, "content": "向南楼、一声归雁。", "from": "陈亮《水龙吟·春恨》", "poem_id": 508}, {"id": 7473, "content": "谁教岁岁红莲夜，两处沉吟各自知。", "from": "姜夔《鹧鸪天·元夕有所梦》", "poem_id": 527}, {"id": 7486, "content": "莫道不销魂，帘卷西风，人比黄花瘦。", "from": "李清照《醉花阴·薄雾浓云愁永昼》", "poem_id": 627}, {"id": 7496, "content": "相将共、岁寒伴侣，小窗净、沉烟熏翠袂。", "from": "周密《绣鸾凤花犯·赋水仙》", "poem_id": 605}, {"id": 7502, "content": "苏堤尽日风和雨。", "from": "刘辰翁《兰陵王·丙子送春》", "poem_id": 597}, {"id": 7533, "content": "有华灯碍月，飞盖妨花。", "from": "秦观《望海潮·洛阳怀古》", "poem_id": 405}, {"id": 7538, "content": "这次第，怎一个愁字了得！", "from": "李清照《声声慢·寻寻觅觅》", "poem_id": 628}, {"id": 7568, "content": "待得归鞍到时，只怕春深。", "from": "姜夔《一萼红·古城阴》", "poem_id": 541}, {"id": 7576, "content": "见梨花初带夜月，海棠半含朝雨。", "from": "万俟咏《三台·清明应制》", "poem_id": 484}, {"id": 7577, "content": "临别殷勤重寄词，词中有誓两心知。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 7641, "content": "香雾云鬟湿，清辉玉臂寒。", "from": "杜甫《月夜》", "poem_id": 101}, {"id": 7668, "content": "飒飒东风细雨来，芙蓉塘外有轻雷。", "from": "李商隐《无题·飒飒东风细雨来》", "poem_id": 210}, {"id": 7701, "content": "试细听、莺啼燕语。", "from": "袁去华《剑器近·夜来雨》", "poem_id": 501}, {"id": 7703, "content": "黄昏胡骑尘满城，欲往城南望城北。", "from": "杜甫《哀江头》", "poem_id": 84}, {"id": 7712, "content": "听风听雨过清明。愁草瘗花铭。", "from": "吴文英《风入松·听风听雨过清明》", "poem_id": 579}, {"id": 7740, "content": "今日龙钟人共弃，愧君犹遣慎风波。", "from": "刘长卿《江州重别薛六柳八二员外》", "poem_id": 192}, {"id": 7751, "content": "马上单衣寒恻恻。", "from": "姜夔《淡黄柳·空城晓角》", "poem_id": 536}, {"id": 7760, "content": "昨夜雨疏风骤，浓睡不消残酒。", "from": "李清照《如梦令·昨夜雨疏风骤》", "poem_id": 625}, {"id": 7772, "content": "香尘暗陌，华灯明昼，长是懒携手去。", "from": "刘辰翁《永遇乐·璧月初晴》", "poem_id": 598}, {"id": 7774, "content": "薰风燕乳，暗雨梅黄，午镜澡兰帘幕。", "from": "吴文英《澡兰香·淮安重午》", "poem_id": 578}, {"id": 7775, "content": "白头搔更短，浑欲不胜簪。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 7800, "content": "睡里消魂无说处，觉来惆怅消魂误。", "from": "晏几道《蝶恋花·梦入江南烟水路》", "poem_id": 375}, {"id": 7812, "content": "九十光阴能有几？金龟解尽留无计。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 7821, "content": "帝里风光好，当年少日，暮宴朝欢。", "from": "柳永《戚氏·晚秋天》", "poem_id": 364}, {"id": 7828, "content": "休问梁园旧宾客，茂陵秋雨病相如。", "from": "李商隐《寄令狐郎中》", "poem_id": 297}, {"id": 7832, "content": "碧楼帘影不遮愁，还似去年今日意。", "from": "晏几道《玉楼春·东风又作无情计》", "poem_id": 381}, {"id": 7835, "content": "浮生长恨欢娱少。", "from": "宋祁《玉楼春·春景》", "poem_id": 345}, {"id": 7852, "content": "芙蓉如面柳如眉，对此如何不泪垂。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 7862, "content": "看浩荡、千崖秋色。", "from": "刘克庄《贺新郎·九日》", "poem_id": 560}, {"id": 7873, "content": "朝避猛虎，夕避长蛇；磨牙吮血，杀人如麻。", "from": "李白《蜀道难》", "poem_id": 75}, {"id": 7879, "content": "近寒食雨草萋萋，著麦苗风柳映堤。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 7892, "content": "花近高楼伤客心，万方多难此登临。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 7893, "content": "来相召、香车宝马，谢他酒朋诗侣。", "from": "李清照《永遇乐·落日熔金》", "poem_id": 630}, {"id": 7911, "content": "今宵剩把银釭照，犹恐相逢是梦中。", "from": "晏几道《鹧鸪天·彩袖殷勤捧玉钟》", "poem_id": 377}, {"id": 7917, "content": "叹神游故国，花记前度。", "from": "刘辰翁《兰陵王·丙子送春》", "poem_id": 597}, {"id": 7960, "content": "似花还似非花，也无人惜从教坠。", "from": "苏轼《水龙吟·次韵章质夫杨花词》", "poem_id": 392}, {"id": 7964, "content": "十二楼中尽晓妆，望仙楼上望君王。", "from": "薛逢《宫词》", "poem_id": 219}, {"id": 7981, "content": "自从献宝朝河宗，无复射蛟江水中。", "from": "杜甫《韦讽录事宅观曹将军画马图》", "poem_id": 57}, {"id": 7991, "content": "好为庐山谣，兴因庐山发。", "from": "李白《庐山谣寄卢侍御虚舟》", "poem_id": 49}, {"id": 8002, "content": "丹青不知老将至，富贵于我如浮云。", "from": "杜甫《丹青引赠曹将军霸》", "poem_id": 58}, {"id": 8029, "content": "怡然敬父执，问我来何方。", "from": "杜甫《赠卫八处士》", "poem_id": 7}, {"id": 8052, "content": "前度书多隐语，意浅愁难答。", "from": "晏几道《六幺令·绿阴春尽》", "poem_id": 386}, {"id": 8062, "content": "满地残红宫锦污，昨夜南园风雨。", "from": "王安国《清平乐·春晚》", "poem_id": 373}, {"id": 8097, "content": "辇前才人带弓箭，白马嚼啮黄金勒。", "from": "杜甫《哀江头》", "poem_id": 84}, {"id": 8106, "content": "千古江山，英雄无觅，孙仲谋处。", "from": "辛弃疾《永遇乐·京口北固亭怀古》", "poem_id": 520}, {"id": 8131, "content": "断鸿声里，立尽斜阳。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 8147, "content": "山光忽西落，池月渐东上。", "from": "孟浩然《夏日南亭怀辛大》", "poem_id": 17}, {"id": 8152, "content": "请君试问东流水，别意与之谁短长。", "from": "李白《金陵酒肆留别》", "poem_id": 51}, {"id": 8155, "content": "留人不住，醉解兰舟去。", "from": "晏几道《清平乐·留人不住》", "poem_id": 383}, {"id": 8157, "content": "料黛眉重锁隋堤，芳心还动梁苑。", "from": "卢祖皋《宴清都·初春》", "poem_id": 563}, {"id": 8166, "content": "海阔山遥，未知何处是潇湘。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 8177, "content": "卷絮风头寒欲尽。", "from": "赵令畤《蝶恋花·卷絮风头寒欲尽》", "poem_id": 416}, {"id": 8201, "content": "一寸狂心未说，已向横波觉。", "from": "晏几道《六幺令·绿阴春尽》", "poem_id": 386}, {"id": 8212, "content": "残日东风，不放岁华去。", "from": "吴文英《祝英台近·除夜立春》", "poem_id": 577}, {"id": 8213, "content": "困倚危楼，过尽飞鸿字字愁。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 8214, "content": "来往不逢人，长歌楚天碧。", "from": "柳宗元《溪居》", "poem_id": 33}, {"id": 8219, "content": "最可惜、一片江山，总付与啼鴂。", "from": "姜夔《八归·湘中送胡德华》", "poem_id": 532}, {"id": 8221, "content": "不知香积寺，数里入云峰。", "from": "王维《过香积寺》", "poem_id": 115}, {"id": 8226, "content": "长绳百尺拽碑倒，粗砂大石相磨治。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 8234, "content": "马上相逢无纸笔，凭君传语报平安。", "from": "岑参《逢入京使》", "poem_id": 268}, {"id": 8238, "content": "前度刘郎，几许风流地，花也应悲。", "from": "韩元吉《六州歌头·东风著意》", "poem_id": 498}, {"id": 8252, "content": "老来情味减，对别酒，怯流年。", "from": "辛弃疾《木兰花慢·滁州送范倅》", "poem_id": 521}, {"id": 8272, "content": "临行密密缝，意恐迟迟归。", "from": "孟郊《游子吟》", "poem_id": 41}, {"id": 8299, "content": "莫嫌旧日云中守，犹堪一战取功勋。", "from": "王维《老将行》", "poem_id": 73}, {"id": 8315, "content": "一襟幽事，砌蛩能说。", "from": "周密《玉京秋·烟水阔》", "poem_id": 603}, {"id": 8329, "content": "叹西园、已是花深无地，东风何事又恶？", "from": "周邦彦《瑞鹤仙·悄郊原带郭》", "poem_id": 452}, {"id": 8333, "content": "念上国，谁是、脍鲈江汉未归客。", "from": "史达祖《秋霁·江水苍苍》", "poem_id": 554}, {"id": 8362, "content": "云鬓花颜金步摇，芙蓉帐暖度春宵。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 8364, "content": "念去来、岁月如流，徘徊久、叹息愁思盈。", "from": "周邦彦《绮寮怨·上马人扶残醉》", "poem_id": 449}, {"id": 8366, "content": "忆昔西池池上饮，年年多少欢娱。", "from": "晁冲之《临江仙·忆昔西池池上饮》", "poem_id": 423}, {"id": 8368, "content": "天涯旧恨，试看几许消魂，长亭门外山重叠。", "from": "张元干《石州慢·寒水依痕》", "poem_id": 468}, {"id": 8395, "content": "归梦湖边，还迷镜中路。", "from": "吴文英《祝英台近·除夜立春》", "poem_id": 577}, {"id": 8441, "content": "困倚危楼，过尽飞鸿字字愁。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 8446, "content": "相顾无言，惟有泪千行。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 8455, "content": "渡头杨柳青青。枝枝叶叶离情。", "from": "晏几道《清平乐·留人不住》", "poem_id": 383}, {"id": 8461, "content": "山中一夜雨，树杪百重泉。", "from": "王维《送梓州李使君》", "poem_id": 116}, {"id": 8499, "content": "卧龙跃马终黄土，人事依依漫寂寥。", "from": "杜甫《阁夜》", "poem_id": 186}, {"id": 8519, "content": "买花载酒长安市，又争似、家山见桃李。", "from": "欧阳修《青玉案·一年春事都来几》", "poem_id": 356}, {"id": 8520, "content": "犹有遗簪，不展秋心，能卷几多炎热。", "from": "张炎《疏影·咏荷叶》", "poem_id": 612}, {"id": 8524, "content": "独敲初夜磬，闲倚一枝藤。", "from": "李商隐《北青萝》", "poem_id": 155}, {"id": 8532, "content": "可惜风流总闲却！", "from": "王安石《千秋岁引·秋景》", "poem_id": 372}, {"id": 8539, "content": "潜心默祷若有应，岂非正直能感通！", "from": "韩愈《谒衡岳庙遂宿岳寺题门楼》", "poem_id": 63}, {"id": 8545, "content": "箫鼓哀吟感鬼神，宾从杂遝实要津。", "from": "杜甫《丽人行》", "poem_id": 82}, {"id": 8556, "content": "东风里，朱门映柳，低按小秦筝。", "from": "秦观《满庭芳·晓色云开》", "poem_id": 408}, {"id": 8565, "content": "传之七十有二代，以为封禅玉检明堂基。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 8572, "content": "凄凄去亲爱，泛泛入烟雾。", "from": "韦应物《初发扬子寄元大校书》", "poem_id": 25}, {"id": 8575, "content": "长沟流月去无声。", "from": "陈与义《临江仙·夜登小阁忆洛中旧游》", "poem_id": 477}, {"id": 8581, "content": "绿阴春尽，飞絮绕香阁。", "from": "晏几道《六幺令·绿阴春尽》", "poem_id": 386}, {"id": 8591, "content": "今年花胜去年红。", "from": "欧阳修《浪淘沙·把酒祝东风》", "poem_id": 355}, {"id": 8599, "content": "晚来天欲雪，能饮一杯无？", "from": "白居易《问刘十九》", "poem_id": 244}, {"id": 8620, "content": "澹然离言说，悟悦心自足。", "from": "柳宗元《晨诣超师院读禅经》", "poem_id": 32}, {"id": 8625, "content": "绿树村边合，青山郭外斜。", "from": "孟浩然《过故人庄》", "poem_id": 123}, {"id": 8632, "content": "罗绶分香，翠绡对泪，几多幽怨。", "from": "陈亮《水龙吟·春恨》", "poem_id": 508}, {"id": 8670, "content": "禁火天、已是试新妆，岁华到、三分佳处。", "from": "万俟咏《三台·清明应制》", "poem_id": 484}, {"id": 8689, "content": "翠尊易泣，红萼无言耿相忆。", "from": "姜夔《暗香·旧时月色》", "poem_id": 537}, {"id": 8708, "content": "归棹洛阳人，残钟广陵树。", "from": "韦应物《初发扬子寄元大校书》", "poem_id": 25}, {"id": 8717, "content": "姊妹弟兄皆列土，可怜光彩生门户。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 8733, "content": "更好故溪飞雪，小窗深闭。", "from": "王沂孙《天香·咏龙涎香》", "poem_id": 615}, {"id": 8746, "content": "独有凤凰池上客，阳春一曲和皆难。", "from": "岑参《奉和中书舍人贾至早朝大明宫》", "poem_id": 173}, {"id": 8760, "content": "公从何处得纸本，毫发尽备无差讹。", "from": "韩愈《石鼓歌》", "poem_id": 64}, {"id": 8783, "content": "冠盖使，纷驰骛，若为情。", "from": "张孝祥《六州歌头·长淮望断》", "poem_id": 496}, {"id": 8791, "content": "天涯旧恨，独自凄凉人不问。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 8816, "content": "野哭几家闻战伐，夷歌数处起渔樵。", "from": "杜甫《阁夜》", "poem_id": 186}, {"id": 8823, "content": "北风卷地白草折，胡天八月即飞雪。", "from": "岑参《白雪歌送武判官归京》", "poem_id": 55}, {"id": 8837, "content": "念天地之悠悠，独怆然而涕下。", "from": "陈子昂《登幽州台歌》", "poem_id": 42}, {"id": 8841, "content": "侍儿扶起娇无力，始是新承恩泽时。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 8849, "content": "不洗残妆凭绣床，也同女伴绣鸳鸯。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 8856, "content": "落日熔金，暮云合璧，人在何处。", "from": "李清照《永遇乐·落日熔金》", "poem_id": 630}, {"id": 8860, "content": "日销月铄就埋没，六年西顾空吟哦。", "from": "韩愈《石鼓歌》", "poem_id": 64}, {"id": 8865, "content": "高帝子孙尽隆准，龙种自与常人殊。", "from": "杜甫《哀王孙》", "poem_id": 83}, {"id": 8872, "content": "汉女输橦布，巴人讼芋田。", "from": "王维《送梓州李使君》", "poem_id": 116}, {"id": 8875, "content": "那时同唱鹧鸪词。", "from": "周紫芝《鹧鸪天·一点残红欲尽时》", "poem_id": 480}, {"id": 8897, "content": "凌烟功臣少颜色，将军下笔开生面。", "from": "杜甫《丹青引赠曹将军霸》", "poem_id": 58}, {"id": 8899, "content": "同时辈流多上道，天路幽险难追攀。", "from": "韩愈《八月十五夜赠张功曹》", "poem_id": 62}, {"id": 8900, "content": "金风细细。叶叶梧桐坠。", "from": "晏殊《清平乐·金风细细》", "poem_id": 336}, {"id": 8906, "content": "缺月挂疏桐，漏断人初静。", "from": "苏轼《卜算子·黄州定慧院寓居作》", "poem_id": 396}, {"id": 8920, "content": "池塘水绿风微暖。", "from": "晏殊《木兰花·池塘水绿风微暖》", "poem_id": 338}, {"id": 8922, "content": "红楼隔雨相望冷，珠箔飘灯独自归。", "from": "李商隐《春雨》", "poem_id": 213}, {"id": 8928, "content": "一字无题处，落叶都愁。", "from": "张炎《八声甘州·记玉关踏雪事清游》", "poem_id": 610}, {"id": 8934, "content": "香尘已隔犹回面。", "from": "晏殊《踏莎行·祖席离歌》", "poem_id": 340}, {"id": 8940, "content": "绿酒初尝人易醉。一枕小窗浓睡。", "from": "晏殊《清平乐·金风细细》", "poem_id": 336}, {"id": 8942, "content": "恐凤靴，挑菜归来，万一灞桥相见。", "from": "史达祖《东风第一枝·咏春雪》", "poem_id": 551}, {"id": 8948, "content": "红颜未老恩先断，斜倚薰笼坐到明。", "from": "白居易《后宫词》", "poem_id": 280}, {"id": 8962, "content": "白发书生神州泪，尽凄凉、不向牛山滴。", "from": "刘克庄《贺新郎·九日》", "poem_id": 560}, {"id": 8966, "content": "天际遥山小，黛眉浅。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 8982, "content": "二十年重过南楼。", "from": "刘过《唐多令·芦叶满汀洲》", "poem_id": 544}, {"id": 8984, "content": "怕上层楼，十日九风雨。", "from": "辛弃疾《祝英台近·晚春》", "poem_id": 522}, {"id": 9001, "content": "落叶满空山，何处寻行迹。", "from": "韦应物《寄全椒山中道士》", "poem_id": 27}, {"id": 9015, "content": "天寒翠袖薄，日暮倚修竹。", "from": "杜甫《佳人》", "poem_id": 8}, {"id": 9027, "content": "榴花不似舞裙红。", "from": "陈与义《临江仙·高咏楚词酬午日》", "poem_id": 476}, {"id": 9042, "content": "相顾无言，惟有泪千行。", "from": "苏轼《江城子·乙卯正月二十日夜记梦》", "poem_id": 400}, {"id": 9044, "content": "着屐苍苔细石间，野兴横生。", "from": "姜夔《一萼红·古城阴》", "poem_id": 541}, {"id": 9049, "content": "褒公鄂公毛发动，英姿飒爽来酣战。", "from": "杜甫《丹青引赠曹将军霸》", "poem_id": 58}, {"id": 9050, "content": "风日薄、度墙啼鸟声乱。", "from": "卢祖皋《宴清都·初春》", "poem_id": 563}, {"id": 9064, "content": "对酒当歌，强乐还无味。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 9067, "content": "年年社日停针线。怎忍见、双飞燕。", "from": "黄公绍《青玉案·年年社日停针线》", "poem_id": 595}, {"id": 9087, "content": "困倚危楼。过尽飞鸿字字愁。", "from": "秦观《减字木兰花·天涯旧恨》", "poem_id": 409}, {"id": 9089, "content": "水茫茫，平沙雁、旋惊散。", "from": "柳永《迷神引·一叶扁舟轻帆卷》", "poem_id": 368}, {"id": 9091, "content": "小径红稀，芳郊绿遍。", "from": "晏殊《踏莎行·小径红稀》", "poem_id": 341}, {"id": 9098, "content": "岂力能制敌与？盖蒙其伤怜而已。", "from": "元结《贼退示官吏》", "poem_id": 24}, {"id": 9101, "content": "遥想公瑾当年，小乔初嫁了，雄姿英发。", "from": "苏轼《念奴娇·赤壁怀古》", "poem_id": 393}, {"id": 9103, "content": "昔日太宗拳毛騧，近时郭家狮子花。", "from": "杜甫《韦讽录事宅观曹将军画马图》", "poem_id": 57}, {"id": 9110, "content": "花钿委地无人收，翠翘金雀玉搔头。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 9178, "content": "持谢邻家子，效颦安可希。", "from": "王维《西施咏》", "poem_id": 15}, {"id": 9190, "content": "剜苔剔藓露节角，安置妥帖平不颇。", "from": "韩愈《石鼓歌》", "poem_id": 64}, {"id": 9225, "content": "迢递嵩高下，归来且闭关。", "from": "王维《归嵩山作》", "poem_id": 112}, {"id": 9235, "content": "联步趋丹陛，分曹限紫微。", "from": "岑参《寄左省杜拾遗》", "poem_id": 94}, {"id": 9242, "content": "宝帘闲挂小银钩。", "from": "秦观《浣溪沙·漠漠轻寒上小楼》", "poem_id": 411}, {"id": 9260, "content": "绿杨芳草长亭路。年少抛人容易去。", "from": "晏殊《玉楼春·春恨》", "poem_id": 339}, {"id": 9278, "content": "无人收废帐，归马识残旗。", "from": "张籍《没蕃故人》", "poem_id": 146}, {"id": 9279, "content": "感时花溅泪，恨别鸟惊心。", "from": "杜甫《春望》", "poem_id": 100}, {"id": 9283, "content": "闲寻旧踪迹，又酒趁哀弦，灯照离席。", "from": "周邦彦《兰陵王·柳》", "poem_id": 435}, {"id": 9289, "content": "空园白露滴，孤壁野僧邻。", "from": "马戴《灞上秋居》", "poem_id": 157}, {"id": 9313, "content": "清秋幕府井梧寒，独宿江城蜡炬残。", "from": "杜甫《宿府》", "poem_id": 185}, {"id": 9314, "content": "水调数声持酒听。午醉醒来愁未醒。", "from": "张先《天仙子·水调数声持酒听》", "poem_id": 329}, {"id": 9316, "content": "过桥分野色，移石动云根。", "from": "贾岛《题李凝幽居》", "poem_id": 165}, {"id": 9319, "content": "六朝旧事随流水，但寒烟衰草凝绿。", "from": "王安石《桂枝香·金陵怀古》", "poem_id": 371}, {"id": 9376, "content": "绿暗红嫣浑可事。", "from": "欧阳修《青玉案·一年春事都来几》", "poem_id": 356}, {"id": 9393, "content": "念名利，憔悴长萦绊。", "from": "柳永《戚氏·晚秋天》", "poem_id": 364}, {"id": 9399, "content": "能几番游，看花又是明年。", "from": "张炎《高阳台·西湖春感》", "poem_id": 609}, {"id": 9401, "content": "万里悲秋常作客，百年多病独登台。", "from": "杜甫《登高》", "poem_id": 183}, {"id": 9403, "content": "独坐幽篁里，弹琴复长啸。", "from": "王维《竹里馆》", "poem_id": 223}, {"id": 9404, "content": "道由白云尽，春与青溪长。", "from": "刘昚虚《阙题》", "poem_id": 138}, {"id": 9408, "content": "刘郎鬓如此，况桃花颜色。", "from": "晁补之《忆少年·别历下》", "poem_id": 421}, {"id": 9415, "content": "楚天千里清秋，水随天去秋无际。", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 9422, "content": "凌波路冷秋无际，香云随步起。", "from": "周密《绣鸾凤花犯·赋水仙》", "poem_id": 605}, {"id": 9441, "content": "平芜尽处是春山，行人更在春山外。", "from": "欧阳修《踏莎行·候馆梅残》", "poem_id": 348}, {"id": 9477, "content": "道人庭宇静，苔色连深竹。", "from": "柳宗元《晨诣超师院读禅经》", "poem_id": 32}, {"id": 9479, "content": "野棠花落，又匆匆过了，清明时节。", "from": "辛弃疾《念奴娇·书东流村壁》", "poem_id": 515}, {"id": 9483, "content": "北极朝廷终不改，西山寇盗莫相侵。", "from": "杜甫《登楼》", "poem_id": 184}, {"id": 9484, "content": "每到春来，惆怅还依旧。", "from": "冯延巳《鹊踏枝·谁道闲情抛掷久》", "poem_id": 350}, {"id": 9512, "content": "寄语东阳沽酒市，拼一醉，而今乐事他年泪。", "from": "朱服《渔家傲·小雨纤纤风细细》", "poem_id": 425}, {"id": 9516, "content": "约何时再，正春浓酒困，人闲昼永无聊赖。", "from": "贺铸《薄幸·淡妆多态》", "poem_id": 459}, {"id": 9522, "content": "金阙晓钟开万户，玉阶仙仗拥千官。", "from": "岑参《奉和中书舍人贾至早朝大明宫》", "poem_id": 173}, {"id": 9525, "content": "丙午人日，予客长沙别驾之观政堂。", "from": "姜夔《一萼红·古城阴》", "poem_id": 541}, {"id": 9530, "content": "庄生晓梦迷蝴蝶，望帝春心托杜鹃。", "from": "李商隐《锦瑟》", "poem_id": 206}, {"id": 9541, "content": "衣湿桐阴露冷，采凉花、时赋秋雪。", "from": "周密《玉京秋·烟水阔》", "poem_id": 603}, {"id": 9547, "content": "乡书何处达？归雁洛阳边。", "from": "王湾《次北固山下》", "poem_id": 92}, {"id": 9554, "content": "清瑟怨遥夜，绕弦风雨哀。", "from": "韦庄《章台夜思》", "poem_id": 163}, {"id": 9574, "content": "多谢梅花，伴我微吟。", "from": "韩疁《高阳台·除夜》", "poem_id": 474}, {"id": 9602, "content": "烟蓑散响惊诗思，还被乱鸥飞去，秀句难续。", "from": "史达祖《八归·秋江带雨》", "poem_id": 557}, {"id": 9620, "content": "望极春愁，黯黯生天际。", "from": "柳永《蝶恋花·伫倚危楼风细细》", "poem_id": 359}, {"id": 9645, "content": "依丛适自憩，缘涧还复去。", "from": "韦应物《东郊》", "poem_id": 30}, {"id": 9664, "content": "宣室求贤访逐臣，贾生才调更无伦。", "from": "李商隐《贾生》", "poem_id": 302}, {"id": 9710, "content": "返景入深林，复照青苔上。", "from": "王维《鹿柴》", "poem_id": 222}, {"id": 9744, "content": "洛阳亲友如相问，一片冰心在玉壶。", "from": "王昌龄《芙蓉楼送辛渐》", "poem_id": 262}, {"id": 9756, "content": "蚕丛及鱼凫，开国何茫然！", "from": "李白《蜀道难》", "poem_id": 75}, {"id": 9762, "content": "楚台风，庾楼月，宛如昨。", "from": "王安石《千秋岁引·秋景》", "poem_id": 372}, {"id": 9774, "content": "是以陷邻境，此州独见全。", "from": "元结《贼退示官吏》", "poem_id": 24}, {"id": 9795, "content": "排空驭气奔如电，升天入地求之遍。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 9798, "content": "但教心似金钿坚，天上人间会相见。", "from": "白居易《长恨歌》", "poem_id": 67}, {"id": 9832, "content": "碑高三丈字如斗，负以灵鳌蟠以螭。", "from": "李商隐《韩碑》", "poem_id": 69}, {"id": 9836, "content": "把破帽、年年拈出。", "from": "刘克庄《贺新郎·九日》", "poem_id": 560}, {"id": 9850, "content": "苔枝缀玉，有翠禽小小，枝上同宿。", "from": "姜夔《疏影·苔枝缀玉》", "poem_id": 538}, {"id": 9858, "content": "青天无云月如烛，露泣梨花白如玉。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 9864, "content": "趁残鸦、飞过苍茫。", "from": "吴文英《夜合花·自鹤江入京泊葑门外有感》", "poem_id": 568}, {"id": 9871, "content": "隔水高楼，望断双鱼信。", "from": "赵令畤《蝶恋花·卷絮风头寒欲尽》", "poem_id": 416}, {"id": 9878, "content": "新烟禁柳，想如今、绿到西湖。", "from": "张炎《渡江云·山阴久客一再逢春回忆西杭渺然愁思》", "poem_id": 614}, {"id": 9879, "content": "正过雨、荆桃如菽。", "from": "蒋捷《贺新郎·梦冷黄金屋》", "poem_id": 607}, {"id": 9884, "content": "干羽方怀远，静烽燧，且休兵。", "from": "张孝祥《六州歌头·长淮望断》", "poem_id": 496}, {"id": 9907, "content": "虽然舞袖何曾舞，常对春风裛泪痕。", "from": "无名氏《杂诗》", "poem_id": 309}, {"id": 9909, "content": "绣屋秦筝，傍海棠偏爱，夜深开宴。", "from": "吴文英《三姝媚·过都城旧居有感》", "poem_id": 584}, {"id": 9911, "content": "先帝侍女八千人，公孙剑器初第一。", "from": "杜甫《观公孙大娘弟子舞剑器行》", "poem_id": 61}, {"id": 9913, "content": "望处雨收云断，凭阑悄悄，目送秋光。", "from": "柳永《玉蝴蝶·望处雨收云断》", "poem_id": 366}, {"id": 9919, "content": "深林人不知，明月来相照。", "from": "王维《竹里馆》", "poem_id": 223}, {"id": 9922, "content": "寒水依痕，春意渐回，沙际烟阔。", "from": "张元干《石州慢·寒水依痕》", "poem_id": 468}, {"id": 9926, "content": "际夜转西壑，隔山望南斗。", "from": "綦毋潜《春泛若耶溪》", "poem_id": 21}, {"id": 9950, "content": "高柳垂阴，老鱼吹浪，留我花间住。", "from": "姜夔《念奴娇·闹红一舸》", "poem_id": 533}, {"id": 9952, "content": "闻道欲来相问讯，西楼望月几回圆。", "from": "韦应物《寄李儋元锡》", "poem_id": 196}, {"id": 9961, "content": "搓得鹅儿黄欲就，天气清明时候。", "from": "赵令畤《清平乐·春风依旧》", "poem_id": 417}, {"id": 9962, "content": "休说鲈鱼堪脍，尽西风，季鹰归未？", "from": "辛弃疾《水龙吟·登建康赏心亭》", "poem_id": 518}, {"id": 9966, "content": "嫣然摇动，冷香飞上诗句。", "from": "姜夔《念奴娇·闹红一舸》", "poem_id": 533}, {"id": 9973, "content": "四边伐鼓雪海涌，三军大呼阴山动。", "from": "岑参《轮台歌奉送封大夫出师西征》", "poem_id": 53}, {"id": 1, "content": "山有木兮木有枝，心悦君兮君不知。", "from": "佚名《越人歌》", "poem_id": 99999}, {"id": 2, "content": "人生若只如初见，何事秋风悲画扇。", "from": "纳兰性德《木兰词·拟古决绝词柬友》", "poem_id": 99999}, {"id": 4, "content": "曾经沧海难为水，除却巫山不是云。", "from": "元稹《离思五首·其四》", "poem_id": 99999}, {"id": 5, "content": "玲珑骰子安红豆，入骨相思知不知。", "from": "温庭筠《新添声杨柳枝词》", "poem_id": 99999}, {"id": 6, "content": "人生如逆旅，我亦是行人。", "from": "苏轼《临江仙·送钱穆父》", "poem_id": 99999}, {"id": 8, "content": "平生不会相思，才会相思，便害相思。", "from": "徐再思《折桂令·春情》", "poem_id": 99999}, {"id": 9, "content": "愿得一心人，白头不相离。", "from": "卓文君《白头吟》", "poem_id": 99999}, {"id": 10, "content": "山无陵，江水为竭。冬雷震震，夏雨雪。天地合，乃敢与君绝。", "from": "佚名《上邪》", "poem_id": 99999}, {"id": 11, "content": "两情若是久长时，又岂在朝朝暮暮。", "from": "秦观《鹊桥仙·纤云弄巧》", "poem_id": 99999}, {"id": 12, "content": "入我相思门，知我相思苦。", "from": "李白《三五七言 / 秋风词》", "poem_id": 99999}, {"id": 13, "content": "去年今日此门中，人面桃花相映红。", "from": "崔护《题都城南庄》", "poem_id": 99999}, {"id": 14, "content": "人生自是有情痴，此恨不关风与月。", "from": "欧阳修《玉楼春·尊前拟把归期说》", "poem_id": 99999}, {"id": 15, "content": "雨打梨花深闭门，忘了青春，误了青春。", "from": "唐寅《一剪梅·雨打梨花深闭门》", "poem_id": 99999}, {"id": 16, "content": "花自飘零水自流。一种相思，两处闲愁。", "from": "李清照《一剪梅·红藕香残玉簟秋》", "poem_id": 99999}, {"id": 17, "content": "一日不见兮，思之如狂。", "from": "司马相如《凤求凰 / 琴歌》", "poem_id": 99999}, {"id": 18, "content": "问世间，情为何物，直教生死相许？", "from": "元好问《摸鱼儿·雁丘词 / 迈陂塘》", "poem_id": 99999}, {"id": 20, "content": "世间无限丹青手，一片伤心画不成。", "from": "高蟾《金陵晚望》", "poem_id": 99999}, {"id": 21, "content": "少年不识愁滋味，爱上层楼。爱上层楼。为赋新词强说愁。", "from": "辛弃疾《丑奴儿·书博山道中壁》", "poem_id": 99999}, {"id": 22, "content": "执子之手，与子偕老。", "from": "佚名《击鼓》", "poem_id": 99999}, {"id": 23, "content": "滚滚长江东逝水，浪花淘尽英雄。", "from": "杨慎《临江仙·滚滚长江东逝水》", "poem_id": 99999}, {"id": 24, "content": "一往情深深几许？深山夕照深秋雨。", "from": "纳兰性德《蝶恋花·出塞》", "poem_id": 99999}, {"id": 25, "content": "林花谢了春红，太匆匆。无奈朝来寒雨，晚来风。", "from": "李煜《相见欢·林花谢了春红》", "poem_id": 99999}, {"id": 26, "content": "一生大笑能几回，斗酒相逢须醉倒。", "from": "岑参《凉州馆中与诸判官夜集》", "poem_id": 99999}, {"id": 29, "content": "思悠悠，恨悠悠，恨到归时方始休。", "from": "白居易《长相思·汴水流》", "poem_id": 99999}, {"id": 30, "content": "春风得意马蹄疾，一日看尽长安花。", "from": "孟郊《登科后》", "poem_id": 99999}, {"id": 31, "content": "一声梧叶一声秋，一点芭蕉一点愁，三更归梦三更后。", "from": "徐再思《水仙子·夜雨》", "poem_id": 99999}, {"id": 32, "content": "春宵一刻值千金，花有清香月有阴。", "from": "苏轼《春宵·春宵一刻值千金》", "poem_id": 99999}, {"id": 33, "content": "菩提本无树，明镜亦非台。", "from": "惠能《菩提偈》", "poem_id": 99999}, {"id": 34, "content": "人面不知何处去，桃花依旧笑春风。", "from": "崔护《题都城南庄》", "poem_id": 99999}, {"id": 35, "content": "时光只解催人老，不信多情，长恨离亭，泪滴春衫酒易醒。", "from": "晏殊《采桑子·时光只解催人老》", "poem_id": 99999}, {"id": 36, "content": "浮云一别后，流水十年间。", "from": "韦应物《淮上喜会梁州故人》", "poem_id": 99999}, {"id": 37, "content": "疏影横斜水清浅，暗香浮动月黄昏。", "from": "林逋《山园小梅·其一》", "poem_id": 99999}, {"id": 38, "content": "昨夜西风凋碧树。独上高楼，望尽天涯路。", "from": "晏殊《蝶恋花·槛菊愁烟兰泣露》", "poem_id": 99999}, {"id": 39, "content": "若是前生未有缘，待重结、来生愿。", "from": "乐婉《卜算子·答施》", "poem_id": 99999}, {"id": 40, "content": "抽刀断水水更流，举杯消愁愁更愁。", "from": "李白《宣州谢脁楼饯别校书叔云》", "poem_id": 99999}, {"id": 41, "content": "取次花丛懒回顾，半缘修道半缘君。", "from": "元稹《离思五首·其四》", "poem_id": 99999}, {"id": 42, "content": "怕相思，已相思，轮到相思没处辞，眉间露一丝。", "from": "俞彦《长相思·折花枝》", "poem_id": 99999}, {"id": 43, "content": "溪云初起日沉阁，山雨欲来风满楼。", "from": "许浑《咸阳城东楼》", "poem_id": 99999}, {"id": 44, "content": "似此星辰非昨夜，为谁风露立中宵。", "from": "黄景仁《绮怀》", "poem_id": 99999}, {"id": 45, "content": "近水楼台先得月，向阳花木易为春。", "from": "苏麟《断句》", "poem_id": 99999}, {"id": 46, "content": "还君明珠双泪垂，恨不相逢未嫁时。", "from": "张籍《节妇吟·寄东平李司空师道》", "poem_id": 99999}, {"id": 47, "content": "问君能有几多愁？恰似一江春水向东流。", "from": "李煜《虞美人·春花秋月何时了》", "poem_id": 99999}, {"id": 48, "content": "一骑红尘妃子笑，无人知是荔枝来。", "from": "杜牧《过华清宫绝句三首》", "poem_id": 99999}, {"id": 49, "content": "枯藤老树昏鸦，小桥流水人家，古道西风瘦马。", "from": "马致远《天净沙·秋思》", "poem_id": 99999}, {"id": 53, "content": "君埋泉下泥销骨，我寄人间雪满头。", "from": "白居易《梦微之》", "poem_id": 99999}, {"id": 55, "content": "仰天大笑出门去，我辈岂是蓬蒿人。", "from": "李白《南陵别儿童入京》", "poem_id": 99999}, {"id": 57, "content": "沾衣欲湿杏花雨，吹面不寒杨柳风。", "from": "志南《绝句》", "poem_id": 99999}, {"id": 58, "content": "今人不见古时月，今月曾经照古人。", "from": "李白《把酒问月·故人贾淳令予问之》", "poem_id": 99999}, {"id": 59, "content": "云想衣裳花想容，春风拂槛露华浓。", "from": "李白《清平调·其一》", "poem_id": 99999}, {"id": 60, "content": "休对故人思故国，且将新火试新茶。诗酒趁年华。", "from": "苏轼《望江南·超然台作》", "poem_id": 99999}, {"id": 62, "content": "黄沙百战穿金甲，不破楼兰终不还。", "from": "王昌龄《从军行七首·其四》", "poem_id": 99999}, {"id": 65, "content": "独立寒秋，湘江北去，橘子洲头。", "from": "毛泽东《沁园春·长沙》", "poem_id": 99999}, {"id": 66, "content": "宁可枝头抱香死，何曾吹落北风中。", "from": "郑思肖《画菊》", "poem_id": 99999}, {"id": 69, "content": "被酒莫惊春睡重，赌书消得泼茶香，当时只道是寻常。", "from": "纳兰性德《浣溪沙·谁念西风独自凉》", "poem_id": 99999}, {"id": 70, "content": "人言落日是天涯，望极天涯不见家。", "from": "李觏《乡思》", "poem_id": 99999}, {"id": 71, "content": "醉后不知天在水，满船清梦压星河。", "from": "唐温如《题龙阳县青草湖》", "poem_id": 99999}, {"id": 72, "content": "青山依旧在，几度夕阳红。", "from": "杨慎《临江仙·滚滚长江东逝水》", "poem_id": 99999}, {"id": 73, "content": "桃李春风一杯酒，江湖夜雨十年灯。", "from": "黄庭坚《寄黄几复》", "poem_id": 99999}, {"id": 74, "content": "桃之夭夭，灼灼其华。", "from": "佚名《桃夭》", "poem_id": 99999}, {"id": 75, "content": "小楼一夜听春雨，深巷明朝卖杏花。", "from": "宋·陆游《临安春雨初霁》", "poem_id": 99999}, {"id": 76, "content": "采得百花成蜜后，为谁辛苦为谁甜。", "from": "罗隐《蜂》", "poem_id": 99999}, {"id": 78, "content": "换我心，为你心，始知相忆深。", "from": "顾夐《诉衷情·永夜抛人何处去》", "poem_id": 99999}, {"id": 79, "content": "男儿何不带吴钩，收取关山五十州。", "from": "李贺《南园十三首·其五》", "poem_id": 99999}, {"id": 84, "content": "莫愁前路无知己，天下谁人不识君。", "from": "高适《别董大二首》", "poem_id": 99999}, {"id": 85, "content": "月上柳梢头，人约黄昏后。", "from": "欧阳修《生查子·元夕》", "poem_id": 99999}, {"id": 86, "content": "闻君有两意，故来相决绝。", "from": "卓文君《白头吟》", "poem_id": 99999}, {"id": 87, "content": "人间四月芳菲尽，山寺桃花始盛开。", "from": "白居易《大林寺桃花》", "poem_id": 99999}, {"id": 88, "content": "生当复来归，死当长相思。", "from": "佚名《留别妻》", "poem_id": 99999}, {"id": 89, "content": "江碧鸟逾白，山青花欲燃。", "from": "杜甫《绝句二首》", "poem_id": 99999}, {"id": 90, "content": "醉卧沙场君莫笑，古来征战几人回？", "from": "王翰《凉州词二首·其一》", "poem_id": 99999}, {"id": 91, "content": "当年不肯嫁春风，无端却被秋风误。", "from": "贺铸《芳心苦·杨柳回塘》", "poem_id": 99999}, {"id": 92, "content": "落霞与孤鹜齐飞，秋水共长天一色。", "from": "王勃《滕王阁序》", "poem_id": 99999}, {"id": 94, "content": "美人自刎乌江岸，战火曾烧赤壁山，将军空老玉门关。", "from": "张可久《卖花声·怀古》", "poem_id": 99999}, {"id": 96, "content": "不经一番寒彻骨，怎得梅花扑鼻香。", "from": "黄蘖禅师《上堂开示颂》", "poem_id": 99999}, {"id": 97, "content": "风萧萧兮易水寒，壮士一去兮不复还。", "from": "佚名《荆轲歌 / 渡易水歌》", "poem_id": 99999}, {"id": 99, "content": "月有盈亏花有开谢，想人生最苦离别。", "from": "张鸣善《普天乐·咏世》", "poem_id": 99999}, {"id": 101, "content": "落红不是无情物，化作春泥更护花。", "from": "龚自珍《己亥杂诗·其五》", "poem_id": 99999}, {"id": 102, "content": "世事漫随流水，算来一梦浮生。", "from": "李煜《乌夜啼·昨夜风兼雨》", "poem_id": 99999}, {"id": 104, "content": "人到情多情转薄，而今真个悔多情。", "from": "纳兰性德《山花子·风絮飘残已化萍》", "poem_id": 99999}, {"id": 105, "content": "渺万里层云，千山暮雪，只影向谁去？", "from": "元好问《摸鱼儿·雁丘词》", "poem_id": 99999}, {"id": 106, "content": "独自莫凭栏，无限江山，别时容易见时难。", "from": "李煜《浪淘沙令·帘外雨潺潺》", "poem_id": 99999}, {"id": 107, "content": "衰兰送客咸阳道，天若有情天亦老。", "from": "唐·李贺《金铜仙人辞汉歌》", "poem_id": 99999}, {"id": 109, "content": "万事到头都是梦，休休。明日黄花蝶也愁。", "from": "苏轼《南乡子·重九涵辉楼呈徐君猷》", "poem_id": 99999}, {"id": 110, "content": "时人不识凌云木，直待凌云始道高。", "from": "杜荀鹤《小松》", "poem_id": 99999}, {"id": 112, "content": "海水梦悠悠，君愁我亦愁。", "from": "佚名《西洲曲》", "poem_id": 99999}, {"id": 113, "content": "酒逢知己千杯少，话不投机半句多。", "from": "欧阳修《春日西湖寄谢法曹韵》", "poem_id": 99999}, {"id": 114, "content": "十年磨一剑，霜刃未曾试。", "from": "贾岛《剑客 / 述剑》", "poem_id": 99999}, {"id": 115, "content": "盈盈一水间，脉脉不得语。", "from": "佚名《迢迢牵牛星》", "poem_id": 99999}, {"id": 116, "content": "相思相见知何日？此时此夜难为情！", "from": "李白《三五七言 / 秋风词》", "poem_id": 99999}, {"id": 118, "content": "苟利国家生死以，岂因祸福避趋之！", "from": "林则徐《赴戍登程口占示家人·其二》", "poem_id": 99999}, {"id": 119, "content": "呜呼！楚虽三户能亡秦，岂有堂堂中国空无人！", "from": "陆游《金错刀行》", "poem_id": 99999}, {"id": 120, "content": "世人结交须黄金，黄金不多交不深。", "from": "张谓《题长安壁主人》", "poem_id": 99999}, {"id": 121, "content": "竹外桃花三两枝，春江水暖鸭先知。", "from": "苏轼《惠崇春江晚景》", "poem_id": 99999}, {"id": 124, "content": "射人先射马，擒贼先擒王。", "from": "杜甫《前出塞九首·其六》", "poem_id": 99999}, {"id": 125, "content": "夕阳无限好，只是近黄昏。", "from": "李商隐《乐游原 / 登乐游原》", "poem_id": 99999}, {"id": 126, "content": "梅须逊雪三分白，雪却输梅一段香。", "from": "卢梅坡《雪梅·其一》", "poem_id": 99999}, {"id": 127, "content": "待到秋来九月八，我花开后百花杀。", "from": "黄巢《不第后赋菊》", "poem_id": 99999}, {"id": 128, "content": "遇酒且呵呵，人生能几何！", "from": "韦庄《菩萨蛮·劝君今夜须沈醉》", "poem_id": 99999}, {"id": 129, "content": "纸上得来终觉浅，绝知此事要躬行。", "from": "陆游《冬夜读书示子聿》", "poem_id": 99999}, {"id": 130, "content": "长风破浪会有时，直挂云帆济沧海。", "from": "李白《行路难·其一》", "poem_id": 99999}, {"id": 134, "content": "物是人非事事休，欲语泪先流。", "from": "李清照《武陵春·春晚》", "poem_id": 99999}, {"id": 136, "content": "欲把相思说似谁，浅情人不知。", "from": "晏几道《长相思·长相思》", "poem_id": 99999}, {"id": 137, "content": "系我一生心，负你千行泪。", "from": "柳永《忆帝京·薄衾小枕凉天气》", "poem_id": 99999}, {"id": 138, "content": "沉舟侧畔千帆过，病树前头万木春。", "from": "刘禹锡《酬乐天扬州初逢席上见赠》", "poem_id": 99999}, {"id": 139, "content": "相思只在：丁香枝上，豆蔻梢头。", "from": "王雱《眼儿媚·杨柳丝丝弄轻柔》", "poem_id": 99999}, {"id": 140, "content": "山重水复疑无路，柳暗花明又一村。", "from": "陆游《游山西村》", "poem_id": 99999}, {"id": 141, "content": "晓看天色暮看云，行也思君，坐也思君。", "from": "唐寅《一剪梅·雨打梨花深闭门》", "poem_id": 99999}, {"id": 144, "content": "曾与美人桥上别，恨无消息到今朝。", "from": "刘禹锡《杨柳枝》", "poem_id": 99999}, {"id": 145, "content": "肠已断，泪难收。相思重上小红楼。", "from": "辛弃疾《鹧鸪天·晚日寒鸦一片愁》", "poem_id": 99999}, {"id": 146, "content": "山外青山楼外楼，西湖歌舞几时休？", "from": "林升《题临安邸》", "poem_id": 99999}, {"id": 147, "content": "伤心桥下春波绿，曾是惊鸿照影来。", "from": "陆游《沈园二首》", "poem_id": 99999}, {"id": 149, "content": "流水落花春去也，天上人间。", "from": "李煜《浪淘沙令·帘外雨潺潺》", "poem_id": 99999}, {"id": 150, "content": "山一程，水一程，身向榆关那畔行，夜深千帐灯。", "from": "纳兰性德《长相思·山一程》", "poem_id": 99999}, {"id": 153, "content": "兰有秀兮菊有芳，怀佳人兮不能忘。", "from": "刘彻《秋风辞》", "poem_id": 99999}, {"id": 154, "content": "少年易老学难成，一寸光阴不可轻。", "from": "朱熹《劝学诗》", "poem_id": 99999}, {"id": 155, "content": "读书不觉已春深，一寸光阴一寸金。", "from": "王贞白《白鹿洞二首·其一》", "poem_id": 99999}, {"id": 156, "content": "韶华不为少年留，恨悠悠，几时休？", "from": "秦观《江城子·西城杨柳弄春柔》", "poem_id": 99999}, {"id": 157, "content": "相思了无益，悔当初相见。", "from": "朱彝尊《忆少年·飞花时节》", "poem_id": 99999}, {"id": 158, "content": "力拔山兮气盖世。时不利兮骓不逝。", "from": "项羽《垓下歌》", "poem_id": 99999}, {"id": 162, "content": "明月几时有？把酒问青天。", "from": "苏轼《水调歌头·丙辰中秋》", "poem_id": 99999}, {"id": 163, "content": "思君如满月，夜夜减清辉。", "from": "张九龄《赋得自君之出矣》", "poem_id": 99999}, {"id": 164, "content": "悠悠天宇旷，切切故乡情。", "from": "张九龄《西江夜行》", "poem_id": 99999}, {"id": 167, "content": "窈窕淑女，君子好逑。", "from": "佚名《关雎》", "poem_id": 99999}, {"id": 168, "content": "结发为夫妻，恩爱两不疑。", "from": "佚名《留别妻》", "poem_id": 99999}, {"id": 169, "content": "慈母手中线，游子身上衣。", "from": "孟郊《游子吟 / 迎母漂上作》", "poem_id": 99999}, {"id": 171, "content": "试问岭南应不好，却道：此心安处是吾乡。", "from": "苏轼《少年游·南海归赠王定国侍人寓娘》", "poem_id": 99999}, {"id": 172, "content": "采菊东篱下，悠然见南山。", "from": "陶渊明《饮酒·其五》", "poem_id": 99999}, {"id": 173, "content": "天街小雨润如酥，草色遥看近却无。", "from": "韩愈《早春呈水部张十八员外二首·其一》", "poem_id": 99999}, {"id": 174, "content": "他年我若为青帝，报与桃花一处开。", "from": "黄巢《题菊花》", "poem_id": 99999}, {"id": 175, "content": "以色事他人，能得几时好。", "from": "李白《妾薄命》", "poem_id": 99999}, {"id": 176, "content": "人闲桂花落，夜静春山空。", "from": "王维《鸟鸣涧》", "poem_id": 99999}, {"id": 177, "content": "但愿人长久，千里共婵娟。", "from": "苏轼《水调歌头·丙辰中秋》", "poem_id": 99999}, {"id": 178, "content": "海内存知己，天涯若比邻。", "from": "王勃《送杜少府之任蜀州》", "poem_id": 99999}, {"id": 179, "content": "枝上柳绵吹又少，天涯何处无芳草。", "from": "苏轼《蝶恋花·春景》", "poem_id": 99999}, {"id": 180, "content": "夜阑卧听风吹雨，铁马冰河入梦来。", "from": "陆游《十一月四日风雨大作》", "poem_id": 99999}, {"id": 181, "content": "花间一壶酒，独酌无相亲。", "from": "李白《月下独酌四首·其一》", "poem_id": 99999}, {"id": 182, "content": "春风若有怜花意，可否需我在少年？", "from": "佚名《咏苍髯》", "poem_id": 99999}, {"id": 183, "content": "黑发不知勤学早，白首方悔读书迟。", "from": "颜真卿《劝学诗》", "poem_id": 99999}, {"id": 184, "content": "世事短如春梦，人情薄似秋云。", "from": "朱敦儒《西江月·世事短如春梦》", "poem_id": 99999}, {"id": 185, "content": "危楼高百尺，手可摘星辰。", "from": "李白《夜宿山寺》", "poem_id": 99999}, {"id": 187, "content": "咬定青山不放松，立根原在破岩中。", "from": "郑燮《竹石》", "poem_id": 99999}, {"id": 188, "content": "等闲识得东风面，万紫千红总是春。", "from": "朱熹《春日》", "poem_id": 99999}, {"id": 191, "content": "造物无言却有情，每于寒尽觉春生。", "from": "张维屏《新雷》", "poem_id": 99999}, {"id": 193, "content": "江南可采莲，莲叶何田田。", "from": "佚名《江南》", "poem_id": 99999}, {"id": 194, "content": "小荷才露尖尖角，早有蜻蜓立上头。", "from": "杨万里《小池》", "poem_id": 99999}, {"id": 195, "content": "人生亦有命，安能行叹复坐愁？", "from": "鲍照《拟行路难·其四》", "poem_id": 99999}, {"id": 196, "content": "云中谁寄锦书来，雁字回时，月满西楼。", "from": "李清照《一剪梅·红藕香残玉簟秋》", "poem_id": 99999}, {"id": 197, "content": "春江潮水连海平，海上明月共潮生。", "from": "张若虚《春江花月夜》", "poem_id": 99999}, {"id": 198, "content": "秦时明月汉时关，万里长征人未还。", "from": "王昌龄《出塞二首·其一》", "poem_id": 99999}, {"id": 199, "content": "昔去雪如花，今来花似雪。", "from": "范云《别诗》", "poem_id": 99999}, {"id": 200, "content": "朔风如解意，容易莫摧残。", "from": "崔道融《梅花》", "poem_id": 99999}, {"id": 201, "content": "大漠孤烟直，长河落日圆。", "from": "王维《使至塞上》", "poem_id": 99999}, {"id": 202, "content": "借问江潮与海水，何似君情与妾心？", "from": "白居易《浪淘沙·借问江潮与海水》", "poem_id": 99999}, {"id": 203, "content": "春风又绿江南岸，明月何时照我还？", "from": "王安石《泊船瓜洲》", "poem_id": 99999}, {"id": 204, "content": "兰陵美酒郁金香，玉碗盛来琥珀光。", "from": "李白《客中行》", "poem_id": 99999}, {"id": 205, "content": "七八个星天外，两三点雨山前。", "from": "辛弃疾《西江月·夜行黄沙道中》", "poem_id": 99999}, {"id": 206, "content": "水晶帘动微风起，满架蔷薇一院香。", "from": "高骈《山亭夏日》", "poem_id": 99999}, {"id": 207, "content": "春风十里扬州路，卷上珠帘总不如。", "from": "杜牧《赠别》", "poem_id": 99999}, {"id": 208, "content": "莫唱当年长恨歌，人间亦自有银河。", "from": "袁枚《马嵬》", "poem_id": 99999}, {"id": 209, "content": "宣父犹能畏后生，丈夫未可轻年少。", "from": "李白《上李邕》", "poem_id": 99999}, {"id": 210, "content": "伯牙鼓琴，志在高山", "from": "佚名《伯牙绝弦》", "poem_id": 99999}, {"id": 212, "content": "人生自古谁无死？留取丹心照汗青。", "from": "文天祥《过零丁洋》", "poem_id": 99999}, {"id": 213, "content": "欲买桂花同载酒，终不似、少年游。", "from": "南宋·刘过《唐多令·芦叶满汀洲》", "poem_id": 99999}, {"id": 215, "content": "毕竟西湖六月中，风光不与四时同。", "from": "杨万里《晓出净慈寺送林子方》", "poem_id": 99999}, {"id": 216, "content": "一寸柔肠情几许？薄衾孤枕，梦回人静，彻晓潇潇雨。", "from": "惠洪《青玉案·丝槐烟柳长亭路》", "poem_id": 99999}, {"id": 217, "content": "月色不可扫，客愁不可道。", "from": "李白《拟古》", "poem_id": 99999}, {"id": 219, "content": "劝君莫惜花前醉，今年花谢，明年花谢，白了人头。", "from": "赵秉文《青杏儿·风雨替花愁》", "poem_id": 99999}, {"id": 220, "content": "七夕今宵看碧霄，牵牛织女渡河桥。", "from": "林杰《乞巧》", "poem_id": 99999}, {"id": 222, "content": "两个黄鹂鸣翠柳，一行白鹭上青天。", "from": "杜甫《绝句》", "poem_id": 99999}, {"id": 223, "content": "弃我去者，昨日之日不可留；乱我心者，今日之日多烦忧。", "from": "唐·李白《宣州谢朓楼饯别校书叔云》", "poem_id": 99999}, {"id": 226, "content": "东边日出西边雨，道是无晴却有晴。", "from": "刘禹锡《竹枝词二首·其一》", "poem_id": 99999}, {"id": 227, "content": "谁家玉笛暗飞声，散入春风满洛城。", "from": "李白《春夜洛城闻笛 / 春夜洛阳城闻笛》", "poem_id": 99999}, {"id": 228, "content": "墙角数枝梅，凌寒独自开。", "from": "王安石《梅花 / 梅》", "poem_id": 99999}, {"id": 229, "content": "蝉噪林逾静，鸟鸣山更幽。", "from": "王籍《入若耶溪》", "poem_id": 99999}, {"id": 230, "content": "日色欲尽花含烟，月明欲素愁不眠。", "from": "李白《长相思·其二》", "poem_id": 99999}, {"id": 231, "content": "愿为西南风，长逝入君怀。", "from": "曹植《明月上高楼》", "poem_id": 99999}, {"id": 233, "content": "愿得此身长报国，何须生入玉门关。", "from": "戴叔伦《塞上曲二首·其二》", "poem_id": 99999}, {"id": 234, "content": "谁念西风独自凉，萧萧黄叶闭疏窗，沉思往事立残阳。", "from": "纳兰性德《浣溪沙·谁念西风独自凉》", "poem_id": 99999}, {"id": 236, "content": "江畔何人初见月？江月何年初照人？", "from": "张若虚《春江花月夜》", "poem_id": 99999}, {"id": 240, "content": "萧萧梧叶送寒声，江上秋风动客情。", "from": "叶绍翁《夜书所见》", "poem_id": 99999}, {"id": 241, "content": "相逢一醉是前缘，风雨散、飘然何处。", "from": "苏轼《鹊桥仙·七夕》", "poem_id": 99999}, {"id": 243, "content": "世情薄，人情恶，雨送黄昏花易落。", "from": "唐婉《钗头凤·世情薄》", "poem_id": 99999}, {"id": 244, "content": "南朝四百八十寺，多少楼台烟雨中。", "from": "杜牧《江南春》", "poem_id": 99999}, {"id": 245, "content": "盛年不重来，一日难再晨。", "from": "陶渊明《杂诗·人生无根蒂》", "poem_id": 99999}, {"id": 247, "content": "葡萄美酒夜光杯，欲饮琵琶马上催。", "from": "王翰《凉州词二首·其一》", "poem_id": 99999}, {"id": 249, "content": "相恨不如潮有信，相思始觉海非深。", "from": "白居易《浪淘沙·借问江潮与海水》", "poem_id": 99999}, {"id": 250, "content": "山不在高，有仙则名。水不在深，有龙则灵。", "from": "刘禹锡《陋室铭》", "poem_id": 99999}, {"id": 251, "content": "接天莲叶无穷碧，映日荷花别样红。", "from": "杨万里《晓出净慈寺送林子方》", "poem_id": 99999}, {"id": 252, "content": "墙外行人，墙里佳人笑。", "from": "苏轼《蝶恋花·春景》", "poem_id": 99999}, {"id": 253, "content": "松花酿酒，春水煎茶。", "from": "张可久《人月圆·山中书事》", "poem_id": 99999}, {"id": 254, "content": "江南几度梅花发，人在天涯鬓已斑。", "from": "刘著《鹧鸪天·雪照山城玉指寒》", "poem_id": 99999}, {"id": 255, "content": "大漠沙如雪，燕山月似钩。", "from": "李贺《马诗二十三首·其五》", "poem_id": 99999}, {"id": 257, "content": "若教眼底无离恨，不信人间有白头。", "from": "辛弃疾《鹧鸪天·晚日寒鸦一片愁》", "poem_id": 99999}, {"id": 258, "content": "红泪偷垂，满眼春风百事非。", "from": "纳兰性德《采桑子·当时错》", "poem_id": 99999}, {"id": 259, "content": "此情无计可消除，才下眉头，却上心头。", "from": "李清照《一剪梅·红藕香残玉簟秋》", "poem_id": 99999}, {"id": 260, "content": "好雨知时节，当春乃发生。", "from": "杜甫《春夜喜雨》", "poem_id": 99999}, {"id": 261, "content": "水光潋滟晴方好，山色空蒙雨亦奇。", "from": "苏轼《饮湖上初晴后雨二首·其二》", "poem_id": 99999}, {"id": 262, "content": "日出江花红胜火，春来江水绿如蓝。", "from": "白居易《忆江南·江南好》", "poem_id": 99999}, {"id": 263, "content": "易求无价宝，难得有情郎。", "from": "鱼玄机《赠邻女 / 寄李亿员外》", "poem_id": 99999}, {"id": 265, "content": "风一更，雪一更，聒碎乡心梦不成，故园无此声。", "from": "纳兰性德《长相思·山一程》", "poem_id": 99999}, {"id": 266, "content": "身既死兮神以灵，魂魄毅兮为鬼雄。", "from": "屈原《国殇》", "poem_id": 99999}, {"id": 267, "content": "八阵图名成卧龙，六韬书功在飞熊。", "from": "查德卿《蟾宫曲·怀古》", "poem_id": 99999}, {"id": 268, "content": "羌笛何须怨杨柳，春风不度玉门关。", "from": "王之涣《凉州词二首·其一》", "poem_id": 99999}, {"id": 269, "content": "数人世相逢，百年欢笑，能得几回又。", "from": "何梦桂《摸鱼儿·记年时人人何处》", "poem_id": 99999}, {"id": 270, "content": "青山绿水，白草红叶黄花。", "from": "白朴《天净沙·秋》", "poem_id": 99999}, {"id": 271, "content": "新竹高于旧竹枝，全凭老干为扶持。", "from": "郑燮《新竹》", "poem_id": 99999}, {"id": 272, "content": "秋阴不散霜飞晚，留得枯荷听雨声。", "from": "李商隐《宿骆氏亭寄怀崔雍崔衮》", "poem_id": 99999}, {"id": 273, "content": "南风知我意，吹梦到西洲。", "from": "佚名《西洲曲》", "poem_id": 99999}, {"id": 275, "content": "若待上林花似锦，出门俱是看花人。", "from": "杨巨源《城东早春》", "poem_id": 99999}, {"id": 276, "content": "平生不下泪，于此泣无穷。", "from": "李白《江夏别宋之悌》", "poem_id": 99999}, {"id": 277, "content": "金风玉露一相逢，便胜却人间无数。", "from": "秦观《鹊桥仙·纤云弄巧》", "poem_id": 99999}, {"id": 278, "content": "我居北海君南海，寄雁传书谢不能。", "from": "黄庭坚《寄黄几复》", "poem_id": 99999}, {"id": 279, "content": "柳庭风静人眠昼，昼眠人静风庭柳。", "from": "苏轼《菩萨蛮·回文夏闺怨》", "poem_id": 99999}, {"id": 280, "content": "离离原上草，一岁一枯荣。", "from": "白居易《草 / 赋得古原草送别》", "poem_id": 99999}, {"id": 282, "content": "月落乌啼霜满天，江枫渔火对愁眠。", "from": "张继《枫桥夜泊 / 夜泊枫江》", "poem_id": 99999}, {"id": 283, "content": "一道残阳铺水中，半江瑟瑟半江红。", "from": "白居易《暮江吟》", "poem_id": 99999}, {"id": 284, "content": "博观而约取，厚积而薄发", "from": "苏轼《稼说送张琥》", "poem_id": 99999}, {"id": 285, "content": "春水碧于天，画船听雨眠。", "from": "韦庄《菩萨蛮·人人尽说江南好》", "poem_id": 99999}, {"id": 286, "content": "孤灯不明思欲绝，卷帷望月空长叹。", "from": "李白《长相思·其一》", "poem_id": 99999}, {"id": 287, "content": "山远天高烟水寒，相思枫叶丹。", "from": "李煜《长相思·一重山》", "poem_id": 99999}, {"id": 288, "content": "江南无所有，聊赠一枝春。", "from": "陆凯《赠范晔诗》", "poem_id": 99999}, {"id": 290, "content": "宁不知倾城与倾国。佳人难再得。", "from": "李延年《李延年歌》", "poem_id": 99999}, {"id": 291, "content": "月儿弯弯照九州，几家欢乐几家愁。", "from": "佚名《月儿弯弯照九州》", "poem_id": 99999}, {"id": 292, "content": "不茶不饭，不言不语，一味供他憔悴。", "from": "蜀妓《鹊桥仙·说盟说誓》", "poem_id": 99999}, {"id": 293, "content": "相思一夜梅花发，忽到窗前疑是君。", "from": "卢仝《有所思》", "poem_id": 99999}, {"id": 295, "content": "不识庐山真面目，只缘身在此山中。", "from": "苏轼《题西林壁》", "poem_id": 99999}, {"id": 296, "content": "多情却被无情恼，今夜还如昨夜长。", "from": "元好问《鹧鸪天·候馆灯昏雨送凉》", "poem_id": 99999}, {"id": 299, "content": "莫笑贱贫夸富贵，共成枯骨两何如？", "from": "白居易《放言五首·其四》", "poem_id": 99999}, {"id": 300, "content": "若言琴上有琴声，放在匣中何不鸣？", "from": "苏轼《琴诗》", "poem_id": 99999}, {"id": 302, "content": "风淅淅，雨纤纤。难怪春愁细细添。", "from": "纳兰性德《赤枣子·风淅淅》", "poem_id": 99999}, {"id": 303, "content": "位卑未敢忘忧国，事定犹须待阖棺。", "from": "陆游《病起书怀》", "poem_id": 99999}, {"id": 304, "content": "悲莫悲生离别，乐莫乐新相识，儿女古今情。", "from": "辛弃疾《水调歌头·壬子三山被召陈端仁给事饮饯席上作》", "poem_id": 99999}, {"id": 305, "content": "水是眼波横，山是眉峰聚。", "from": "王观《卜算子·送鲍浩然之浙东》", "poem_id": 99999}, {"id": 306, "content": "试玉要烧三日满，辨材须待七年期。", "from": "白居易《放言五首·其三》", "poem_id": 99999}, {"id": 307, "content": "古人学问无遗力，少壮工夫老始成。", "from": "陆游《冬夜读书示子聿》", "poem_id": 99999}, {"id": 308, "content": "三更灯火五更鸡，正是男儿读书时。", "from": "颜真卿《劝学诗》", "poem_id": 99999}, {"id": 309, "content": "李白如今已仙去，月在青天几圆缺？", "from": "唐寅《把酒对月歌》", "poem_id": 99999}, {"id": 310, "content": "天平山上白云泉，云自无心水自闲。", "from": "白居易《白云泉》", "poem_id": 99999}, {"id": 311, "content": "相思相望不相亲，天为谁春。", "from": "纳兰性德《画堂春·一生一代一双人》", "poem_id": 99999}, {"id": 314, "content": "无情最是台城柳，依旧烟笼十里堤。", "from": "韦庄《台城》", "poem_id": 99999}, {"id": 315, "content": "无言独上西楼，月如钩。寂寞梧桐深院锁清秋。", "from": "李煜《相见欢·无言独上西楼》", "poem_id": 99999}, {"id": 316, "content": "西塞山前白鹭飞，桃花流水鳜鱼肥。", "from": "张志和《渔歌子·西塞山前白鹭飞》", "poem_id": 99999}, {"id": 317, "content": "汴水流，泗水流，流到瓜州古渡头。吴山点点愁。", "from": "白居易《长相思·汴水流》", "poem_id": 99999}, {"id": 318, "content": "小楼昨夜又东风，故国不堪回首月明中。", "from": "李煜《虞美人·春花秋月何时了》", "poem_id": 99999}, {"id": 320, "content": "松树千年终是朽，槿花一日自为荣。", "from": "白居易《放言五首·其五》", "poem_id": 99999}, {"id": 321, "content": "少年听雨歌楼上。红烛昏罗帐。", "from": "蒋捷《虞美人·听雨》", "poem_id": 99999}, {"id": 322, "content": "妆罢低声问夫婿，画眉深浅入时无。", "from": "朱庆馀《近试上张籍水部 / 近试上张水部 / 闺意献张水部》", "poem_id": 99999}, {"id": 324, "content": "迟日江山丽，春风花草香。", "from": "杜甫《绝句二首》", "poem_id": 99999}, {"id": 325, "content": "路漫漫其修远兮，吾将上下而求索。", "from": "屈原《离骚》", "poem_id": 99999}, {"id": 329, "content": "昔我往矣，杨柳依依。", "from": "佚名《采薇》", "poem_id": 99999}, {"id": 330, "content": "草木有本心，何求美人折！", "from": "张九龄《感遇十二首·其一》", "poem_id": 99999}, {"id": 331, "content": "欲寄彩笺兼尺素。山长水阔知何处。", "from": "晏殊《蝶恋花·槛菊愁烟兰泣露》", "poem_id": 99999}, {"id": 332, "content": "胜日寻芳泗水滨，无边光景一时新。", "from": "朱熹《春日》", "poem_id": 99999}, {"id": 333, "content": "此生谁料，心在天山，身老沧洲。", "from": "陆游《诉衷情·当年万里觅封侯》", "poem_id": 99999}, {"id": 335, "content": "庭前落尽梧桐，水边开彻芙蓉。", "from": "朱庭玉《天净沙·秋》", "poem_id": 99999}, {"id": 336, "content": "昆山玉碎凤凰叫，芙蓉泣露香兰笑。", "from": "李贺《李凭箜篌引》", "poem_id": 99999}, {"id": 337, "content": "一寸相思千万绪。人间没个安排处。", "from": "李冠《蝶恋花·春暮》", "poem_id": 99999}, {"id": 338, "content": "恰同学少年，风华正茂；书生意气，挥斥方遒。", "from": "毛泽东《沁园春·长沙》", "poem_id": 99999}, {"id": 342, "content": "千古兴亡多少事？悠悠。不尽长江滚滚流。", "from": "辛弃疾《南乡子·登京口北固亭有怀》", "poem_id": 99999}, {"id": 343, "content": "稻花香里说丰年。听取蛙声一片。", "from": "辛弃疾《西江月·夜行黄沙道中》", "poem_id": 99999}, {"id": 345, "content": "荷叶生时春恨生，荷叶枯时秋恨成。", "from": "李商隐《暮秋独游曲江》", "poem_id": 99999}, {"id": 346, "content": "思君如流水，何有穷已时。", "from": "徐干《室思》", "poem_id": 99999}, {"id": 347, "content": "少无适俗韵，性本爱丘山。", "from": "陶渊明《归园田居·其一》", "poem_id": 99999}, {"id": 348, "content": "功名万里外，心事一杯中。", "from": "高适《送李侍御赴安西》", "poem_id": 99999}, {"id": 349, "content": "有情芍药含春泪，无力蔷薇卧晓枝。", "from": "秦观《春日》", "poem_id": 99999}, {"id": 350, "content": "日啖荔枝三百颗，不辞长作岭南人。", "from": "苏轼《惠州一绝》", "poem_id": 99999}, {"id": 351, "content": "宁为百夫长，胜作一书生。", "from": "杨炯《从军行》", "poem_id": 99999}, {"id": 352, "content": "乱花渐欲迷人眼，浅草才能没马蹄。", "from": "白居易《钱塘湖春行》", "poem_id": 99999}, {"id": 353, "content": "少小离家老大回，乡音无改鬓毛衰。", "from": "贺知章《回乡偶书二首·其一》", "poem_id": 99999}, {"id": 354, "content": "枕上诗书闲处好，门前风景雨来佳。", "from": "李清照《摊破浣溪沙·病起萧萧两鬓华》", "poem_id": 99999}, {"id": 355, "content": "停车坐爱枫林晚，霜叶红于二月花。", "from": "杜牧《山行》", "poem_id": 99999}, {"id": 356, "content": "依旧，依旧，人与绿杨俱瘦。", "from": "秦观《如梦令·春景》", "poem_id": 99999}, {"id": 357, "content": "君为女萝草，妾作菟丝花。", "from": "李白《古意》", "poem_id": 99999}, {"id": 358, "content": "丈夫非无泪，不洒离别间。", "from": "陆龟蒙《别离》", "poem_id": 99999}, {"id": 361, "content": "花落花开自有时，总赖东君主。", "from": "严蕊《卜算子·不是爱风尘》", "poem_id": 99999}, {"id": 362, "content": "青山相待，白云相爱，梦不到紫罗袍共黄金带。", "from": "宋方壶《山坡羊·道情》", "poem_id": 99999}, {"id": 363, "content": "乱山残雪夜，孤烛异乡人。", "from": "崔涂《除夜 / 巴山道中除夜书怀 / 除夜有怀》", "poem_id": 99999}, {"id": 364, "content": "中秋谁与共孤光。把盏凄然北望。", "from": "苏轼《西江月·世事一场大梦》", "poem_id": 99999}, {"id": 365, "content": "清风明月无人管，并作南楼一味凉。", "from": "黄庭坚《鄂州南楼书事》", "poem_id": 99999}, {"id": 366, "content": "冰雪林中著此身，不同桃李混芳尘；", "from": "王冕《白梅》", "poem_id": 99999}, {"id": 367, "content": "柴门闻犬吠，风雪夜归人。", "from": "刘长卿《逢雪宿芙蓉山主人》", "poem_id": 99999}, {"id": 368, "content": "爆竹声中一岁除，春风送暖入屠苏。", "from": "王安石《元日》", "poem_id": 99999}, {"id": 369, "content": "离别家乡岁月多，近来人事半消磨。", "from": "贺知章《回乡偶书二首》", "poem_id": 99999}, {"id": 370, "content": "一别如斯，落尽梨花月又西。", "from": "纳兰性德《采桑子·当时错》", "poem_id": 99999}, {"id": 371, "content": "为谁醉倒为谁醒，到今犹恨轻离别。", "from": "吕本中《踏莎行·雪似梅花》", "poem_id": 99999}, {"id": 372, "content": "世间行乐亦如此，古来万事东流水。", "from": "李白《梦游天姥吟留别 / 别东鲁诸公》", "poem_id": 99999}, {"id": 374, "content": "何处望神州？满眼风光北固楼。", "from": "辛弃疾《南乡子·登京口北固亭有怀》", "poem_id": 99999}, {"id": 375, "content": "欲把西湖比西子，淡妆浓抹总相宜。", "from": "苏轼《饮湖上初晴后雨二首·其二》", "poem_id": 99999}, {"id": 376, "content": "我也不登天子船，我也不上长安眠。", "from": "唐寅《把酒对月歌》", "poem_id": 99999}, {"id": 377, "content": "儿童散学归来早，忙趁东风放纸鸢。", "from": "高鼎《村居》", "poem_id": 99999}, {"id": 378, "content": "衰兰送客咸阳道，天若有情天亦老。", "from": "李贺《金铜仙人辞汉歌》", "poem_id": 99999}, {"id": 379, "content": "一叫一回肠一断，三春三月忆三巴。", "from": "李白《宣城见杜鹃花 / 子规》", "poem_id": 99999}, {"id": 380, "content": "臣心一片磁针石，不指南方不肯休。", "from": "文天祥《扬子江》", "poem_id": 99999}, {"id": 381, "content": "青鸟不传云外信，丁香空结雨中愁。", "from": "李璟《摊破浣溪沙·手卷真珠上玉钩》", "poem_id": 99999}, {"id": 382, "content": "日暮苍山远，天寒白屋贫。", "from": "刘长卿《逢雪宿芙蓉山主人》", "poem_id": 99999}, {"id": 383, "content": "娶妻无媒毋须恨，书中有女颜如玉。", "from": "赵恒《劝学诗》", "poem_id": 99999}, {"id": 385, "content": "寒夜客来茶当酒，竹炉汤沸火初红。", "from": "杜耒《寒夜》", "poem_id": 99999}, {"id": 386, "content": "草长莺飞二月天，拂堤杨柳醉春烟。", "from": "高鼎《村居》", "poem_id": 99999}, {"id": 389, "content": "清明时节雨纷纷，路上行人欲断魂。", "from": "杜牧《清明》", "poem_id": 99999}, {"id": 390, "content": "卧看满天云不动，不知云与我俱东。", "from": "陈与义《襄邑道中》", "poem_id": 99999}, {"id": 392, "content": "秋风起兮白云飞，草木黄落兮雁南归。", "from": "刘彻《秋风辞》", "poem_id": 99999}, {"id": 393, "content": "我寄愁心与明月，随风直到夜郎西。", "from": "李白《闻王昌龄左迁龙标遥有此寄》", "poem_id": 99999}, {"id": 394, "content": "黄河远上白云间，一片孤城万仞山。", "from": "王之涣《凉州词二首·其一》", "poem_id": 99999}, {"id": 395, "content": "鹅湖山下稻粱肥，豚栅鸡栖半掩扉。", "from": "王驾《社日》", "poem_id": 99999}, {"id": 397, "content": "漠漠水田飞白鹭，阴阴夏木啭黄鹂。", "from": "王维《积雨辋川庄作 / 秋归辋川庄作》", "poem_id": 99999}, {"id": 398, "content": "南国有佳人，容华若桃李。", "from": "曹植《杂诗·南国有佳人》", "poem_id": 99999}, {"id": 399, "content": "千锤万凿出深山，烈火焚烧若等闲。", "from": "于谦《石灰吟》", "poem_id": 99999}, {"id": 400, "content": "恨君不似江楼月，南北东西，南北东西，只有相随无别离。", "from": "吕本中《采桑子·恨君不似江楼月》", "poem_id": 99999}, {"id": 401, "content": "感君缠绵意，系在红罗襦。", "from": "张籍《节妇吟·寄东平李司空师道》", "poem_id": 99999}, {"id": 402, "content": "谁料同心结不成，翻就相思结。", "from": "夏完淳《卜算子·秋色到空闺》", "poem_id": 99999}, {"id": 404, "content": "生当作人杰，死亦为鬼雄。", "from": "李清照《夏日绝句》", "poem_id": 99999}, {"id": 405, "content": "一壶酒，一竿身，快活如侬有几人。", "from": "李煜《渔父·浪花有意千里雪》", "poem_id": 99999}, {"id": 406, "content": "海棠未雨，梨花先雪，一半春休。", "from": "王雱《眼儿媚·杨柳丝丝弄轻柔》", "poem_id": 99999}, {"id": 407, "content": "随风潜入夜，润物细无声。", "from": "杜甫《春夜喜雨》", "poem_id": 99999}, {"id": 409, "content": "草木也知愁，韶华竟白头。", "from": "曹雪芹《唐多令·柳絮》", "poem_id": 99999}, {"id": 410, "content": "及时当勉励，岁月不待人。", "from": "陶渊明《杂诗·人生无根蒂》", "poem_id": 99999}, {"id": 411, "content": "春城无处不飞花，寒食东风御柳斜。", "from": "韩翃《寒食 / 寒食日即事》", "poem_id": 99999}, {"id": 412, "content": "壮心未与年俱老，死去犹能作鬼雄。", "from": "陆游《书愤五首·其二》", "poem_id": 99999}, {"id": 413, "content": "春色满园关不住，一枝红杏出墙来。", "from": "叶绍翁《游园不值》", "poem_id": 99999}, {"id": 414, "content": "看朱成碧思纷纷，憔悴支离为忆君。", "from": "武则天《如意娘》", "poem_id": 99999}, {"id": 415, "content": "日照香炉生紫烟，遥看瀑布挂前川。", "from": "李白《望庐山瀑布》", "poem_id": 99999}, {"id": 416, "content": "桃花潭水深千尺，不及汪伦送我情。", "from": "李白《赠汪伦》", "poem_id": 99999}, {"id": 417, "content": "但使龙城飞将在，不教胡马度阴山。", "from": "王昌龄《出塞二首》", "poem_id": 99999}, {"id": 418, "content": "举杯邀明月，对影成三人。", "from": "李白《月下独酌四首·其一》", "poem_id": 99999}, {"id": 420, "content": "长恨此身非我有，何时忘却营营。", "from": "苏轼《临江仙·夜饮东坡醒复醉》", "poem_id": 99999}, {"id": 421, "content": "纵被无情弃，不能羞。", "from": "韦庄《思帝乡·春日游》", "poem_id": 99999}, {"id": 422, "content": "晚日寒鸦一片愁。柳塘新绿却温柔。", "from": "辛弃疾《鹧鸪天·晚日寒鸦一片愁》", "poem_id": 99999}, {"id": 423, "content": "三十功名尘与土，八千里路云和月。", "from": "岳飞《满江红·写怀》", "poem_id": 99999}, {"id": 424, "content": "怒发冲冠，凭栏处、潇潇雨歇。", "from": "岳飞《满江红·写怀》", "poem_id": 99999}, {"id": 425, "content": "花褪残红青杏小。燕子飞时，绿水人家绕。", "from": "苏轼《蝶恋花·春景》", "poem_id": 99999}, {"id": 426, "content": "燕子来时新社，梨花落后清明。", "from": "晏殊《破阵子·春景》", "poem_id": 99999}, {"id": 427, "content": "自古逢秋悲寂寥，我言秋日胜春朝。", "from": "刘禹锡《秋词》", "poem_id": 99999}, {"id": 428, "content": "我欲穿花寻路，直入白云深处，浩气展虹霓。", "from": "黄庭坚《水调歌头·游览》", "poem_id": 99999}, {"id": 429, "content": "皑如山上雪，皎若云间月。", "from": "卓文君《白头吟》", "poem_id": 99999}, {"id": 430, "content": "江山代有才人出，各领风骚数百年。", "from": "赵翼《论诗五首·其二》", "poem_id": 99999}, {"id": 431, "content": "迢迢牵牛星，皎皎河汉女。", "from": "佚名《迢迢牵牛星》", "poem_id": 99999}, {"id": 433, "content": "峨眉山月半轮秋，影入平羌江水流。", "from": "李白《峨眉山月歌》", "poem_id": 99999}, {"id": 434, "content": "醉翁之意不在酒，在乎山水之间也。", "from": "欧阳修《醉翁亭记》", "poem_id": 99999}, {"id": 435, "content": "四十年来家国，三千里地山河。", "from": "李煜《破阵子·四十年来家国》", "poem_id": 99999}, {"id": 437, "content": "黑云翻墨未遮山，白雨跳珠乱入船。", "from": "苏轼《六月二十七日望湖楼醉书》", "poem_id": 99999}, {"id": 438, "content": "相看两不厌，只有敬亭山。", "from": "李白《独坐敬亭山》", "poem_id": 99999}, {"id": 439, "content": "一片春愁待酒浇。江上舟摇，楼上帘招。", "from": "蒋捷《一剪梅·舟过吴江》", "poem_id": 99999}, {"id": 440, "content": "只解沙场为国死，何须马革裹尸还。", "from": "徐锡麟《出塞》", "poem_id": 99999}, {"id": 441, "content": "野径云俱黑，江船火独明。", "from": "杜甫《春夜喜雨》", "poem_id": 99999}, {"id": 442, "content": "若似月轮终皎洁，不辞冰雪为卿热。", "from": "纳兰性德《蝶恋花·辛苦最怜天上月》", "poem_id": 99999}, {"id": 443, "content": "池上碧苔三四点，叶底黄鹂一两声。", "from": "晏殊《破阵子·春景》", "poem_id": 99999}, {"id": 444, "content": "袅袅城边柳，青青陌上桑。", "from": "张仲素《春闺思》", "poem_id": 99999}, {"id": 446, "content": "儿童急走追黄蝶，飞入菜花无处寻。", "from": "杨万里《宿新市徐公店》", "poem_id": 99999}, {"id": 447, "content": "了却君王天下事，赢得生前身后名。", "from": "辛弃疾《破阵子·为陈同甫赋壮词以寄之》", "poem_id": 99999}, {"id": 449, "content": "梅花雪，梨花月，总相思。", "from": "张惠言《相见欢·年年负却花期》", "poem_id": 99999}, {"id": 450, "content": "一别都门三改火，天涯踏尽红尘。", "from": "苏轼《临江仙·送钱穆父》", "poem_id": 99999}, {"id": 451, "content": "鸟向平芜远近，人随流水东西。", "from": "刘长卿《谪仙怨·晴川落日初低》", "poem_id": 99999}, {"id": 452, "content": "素衣莫起风尘叹，犹及清明可到家。", "from": "陆游《临安春雨初霁》", "poem_id": 99999}, {"id": 454, "content": "明月不谙离恨苦。斜光到晓穿朱户。", "from": "晏殊《蝶恋花·槛菊愁烟兰泣露》", "poem_id": 99999}, {"id": 455, "content": "羡青山有思，白鹤忘机。", "from": "汤恢《八声甘州·摘青梅荐酒》", "poem_id": 99999}, {"id": 456, "content": "远上寒山石径斜，白云生处有人家。", "from": "杜牧《山行》", "poem_id": 99999}, {"id": 457, "content": "家国兴亡自有时，吴人何苦怨西施。", "from": "罗隐《西施》", "poem_id": 99999}, {"id": 458, "content": "天下英雄谁敌手？曹刘。生子当如孙仲谋。", "from": "辛弃疾《南乡子·登京口北固亭有怀》", "poem_id": 99999}, {"id": 459, "content": "死去元知万事空，但悲不见九州同。", "from": "陆游《示儿》", "poem_id": 99999}, {"id": 460, "content": "众鸟高飞尽，孤云独去闲。", "from": "李白《独坐敬亭山》", "poem_id": 99999}, {"id": 461, "content": "黄鹤一去不复返，白云千载空悠悠。", "from": "崔颢《黄鹤楼 / 登黄鹤楼》", "poem_id": 99999}, {"id": 462, "content": "范增一去无谋主，韩信原来是逐臣。", "from": "严遂成《乌江项王庙》", "poem_id": 99999}, {"id": 463, "content": "风乍起，吹皱一池春水。", "from": "冯延巳《谒金门·风乍起》", "poem_id": 99999}, {"id": 464, "content": "花门楼前见秋草，岂能贫贱相看老。", "from": "岑参《凉州馆中与诸判官夜集》", "poem_id": 99999}, {"id": 465, "content": "暖风熏得游人醉，直把杭州作汴州。", "from": "林升《题临安邸》", "poem_id": 99999}, {"id": 466, "content": "不畏浮云遮望眼，只缘身在最高层。", "from": "王安石《登飞来峰》", "poem_id": 99999}, {"id": 467, "content": "北国风光，千里冰封，万里雪飘。", "from": "毛泽东《沁园春·雪》", "poem_id": 99999}, {"id": 469, "content": "相见争如不见，多情何似无情。", "from": "司马光《西江月·宝髻松松挽就》", "poem_id": 99999}, {"id": 471, "content": "唯有门前镜湖水，春风不改旧时波。", "from": "贺知章《回乡偶书二首》", "poem_id": 99999}, {"id": 472, "content": "忽忆故人今总老。贪梦好。茫然忘了邯郸道。", "from": "王安石《渔家傲·平岸小桥千嶂抱》", "poem_id": 99999}, {"id": 473, "content": "轻汗微微透碧纨，明朝端午浴芳兰。", "from": "苏轼《浣溪沙·端午》", "poem_id": 99999}, {"id": 474, "content": "年年岁岁花相似，岁岁年年人不同。", "from": "刘希夷《代悲白头翁 / 白头吟 / 有所思》", "poem_id": 99999}, {"id": 475, "content": "恰如灯下，故人万里，归来对影。", "from": "黄庭坚《品令·茶词》", "poem_id": 99999}, {"id": 476, "content": "昔时人已没，今日水犹寒。", "from": "骆宾王《于易水送人 / 于易水送别》", "poem_id": 99999}, {"id": 477, "content": "千里莺啼绿映红，水村山郭酒旗风。", "from": "杜牧《江南春》", "poem_id": 99999}, {"id": 478, "content": "谁道人生无再少？门前流水尚能西！休将白发唱黄鸡。", "from": "苏轼《浣溪沙·游蕲水清泉寺》", "poem_id": 99999}, {"id": 480, "content": "半生已分孤眠过，山枕檀痕涴。", "from": "纳兰性德《虞美人·曲阑深处重相见》", "poem_id": 99999}, {"id": 481, "content": "朝辞白帝彩云间，千里江陵一日还。", "from": "李白《早发白帝城 / 白帝下江陵》", "poem_id": 99999}, {"id": 482, "content": "连雨不知春去，一晴方觉夏深。", "from": "范成大《喜晴》", "poem_id": 99999}, {"id": 483, "content": "少壮不努力，老大徒伤悲！", "from": "佚名《长歌行》", "poem_id": 99999}, {"id": 484, "content": "有梅无雪不精神，有雪无诗俗了人。", "from": "卢梅坡《雪梅·其二》", "poem_id": 99999}, {"id": 485, "content": "风雨替花愁。风雨罢，花也应休。", "from": "赵秉文《青杏儿·风雨替花愁》", "poem_id": 99999}, {"id": 486, "content": "居高声自远，非是藉秋风。", "from": "虞世南《蝉》", "poem_id": 99999}, {"id": 487, "content": "黄梅时节家家雨，青草池塘处处蛙。", "from": "南宋·赵师秀《约客》", "poem_id": 99999}, {"id": 488, "content": "绿树阴浓夏日长，楼台倒影入池塘。", "from": "高骈《山亭夏日》", "poem_id": 99999}, {"id": 489, "content": "春日游，杏花吹满头。", "from": "韦庄《思帝乡·春日游》", "poem_id": 99999}, {"id": 490, "content": "一重山，两重山。山远天高烟水寒，相思枫叶丹。", "from": "李煜《长相思·一重山》", "poem_id": 99999}, {"id": 491, "content": "君若清路尘，妾若浊水泥；", "from": "曹植《明月上高楼》", "poem_id": 99999}, {"id": 494, "content": "朝看水东流，暮看日西坠。", "from": "钱福《明日歌》", "poem_id": 99999}, {"id": 495, "content": "几处早莺争暖树，谁家新燕啄春泥。", "from": "白居易《钱塘湖春行》", "poem_id": 99999}, {"id": 496, "content": "别来春半，触目柔肠断。", "from": "李煜《清平乐·别来春半》", "poem_id": 99999}, {"id": 497, "content": "欲将轻骑逐，大雪满弓刀。", "from": "卢纶《和张仆射塞下曲·其三》", "poem_id": 99999}, {"id": 498, "content": "此夜曲中闻折柳，何人不起故园情。", "from": "李白《春夜洛城闻笛 / 春夜洛阳城闻笛》", "poem_id": 99999}, {"id": 499, "content": "且就洞庭赊月色，将船买酒白云边。", "from": "李白《游洞庭湖五首·其二》", "poem_id": 99999}, {"id": 500, "content": "九州生气恃风雷，万马齐喑究可哀。", "from": "龚自珍《己亥杂诗·其二百二十》", "poem_id": 99999}, {"id": 502, "content": "青青园中葵，朝露待日晞。", "from": "佚名《长歌行》", "poem_id": 99999}, {"id": 503, "content": "千磨万击还坚劲，任尔东西南北风。", "from": "郑燮《竹石》", "poem_id": 99999}, {"id": 505, "content": "年年岁岁望中秋，岁岁年年雾雨愁。", "from": "曾几《癸未八月十四日至十六夜月色皆佳》", "poem_id": 99999}, {"id": 506, "content": "三分春色二分愁，更一分风雨。", "from": "叶清臣《贺圣朝·留别》", "poem_id": 99999}, {"id": 507, "content": "只有天在上，更无山与齐。", "from": "寇准《咏华山》", "poem_id": 99999}, {"id": 508, "content": "敕勒川，阴山下。天似穹庐，笼盖四野。", "from": "佚名《敕勒歌》", "poem_id": 99999}, {"id": 509, "content": "问渠哪得清如许？为有源头活水来。", "from": "朱熹《活水亭观书有感二首·其一》", "poem_id": 99999}, {"id": 510, "content": "诚知此恨人人有，贫贱夫妻百事哀。", "from": "元稹《遣悲怀三首·其二》", "poem_id": 99999}, {"id": 511, "content": "春草明年绿，王孙归不归？", "from": "王维《送别 / 山中送别 / 送友》", "poem_id": 99999}, {"id": 512, "content": "锄禾日当午，汗滴禾下土。", "from": "李绅《古风二首 / 悯农二首》", "poem_id": 99999}, {"id": 513, "content": "不是花中偏爱菊，此花开尽更无花。", "from": "元稹《菊花》", "poem_id": 99999}, {"id": 514, "content": "君不见走马川行雪海边，平沙莽莽黄入天。", "from": "岑参《走马川行奉送出师西征 / 走马川行奉送封大夫出师西征》", "poem_id": 99999}, {"id": 515, "content": "人间万事，毫发常重泰山轻。", "from": "辛弃疾《水调歌头·壬子三山被召陈端仁给事饮饯席上作》", "poem_id": 99999}, {"id": 517, "content": "一年将尽夜，万里未归人。", "from": "戴叔伦《除夜宿石头驿》", "poem_id": 99999}, {"id": 518, "content": "雪消门外千山绿，花发江边二月晴。", "from": "欧阳修《春日西湖寄谢法曹歌》", "poem_id": 99999}, {"id": 519, "content": "聚散匆匆，此恨年年有。", "from": "魏夫人《点绛唇·波上清风》", "poem_id": 99999}, {"id": 521, "content": "塞下秋来风景异，衡阳雁去无留意。", "from": "范仲淹《渔家傲·秋思》", "poem_id": 99999}, {"id": 523, "content": "碧玉妆成一树高，万条垂下绿丝绦。", "from": "贺知章《咏柳 / 柳枝词》", "poem_id": 99999}, {"id": 524, "content": "燕子不归春事晚，一汀烟雨杏花寒。", "from": "戴叔伦《苏溪亭》", "poem_id": 99999}, {"id": 525, "content": "酒贱常愁客少，月明多被云妨。", "from": "苏轼《西江月·世事一场大梦》", "poem_id": 99999}, {"id": 526, "content": "黄昏庭院柳啼鸦，记得那人，和月折梨花。", "from": "陈亮《虞美人·东风荡飏轻云缕》", "poem_id": 99999}, {"id": 527, "content": "一种相思，两处闲愁。", "from": "李清照《一剪梅·红藕香残玉簟秋》", "poem_id": 99999}, {"id": 529, "content": "窗含西岭千秋雪，门泊东吴万里船。", "from": "杜甫《绝句》", "poem_id": 99999}, {"id": 530, "content": "林暗草惊风，将军夜引弓。", "from": "卢纶《和张仆射塞下曲·其二》", "poem_id": 99999}, {"id": 531, "content": "山河破碎风飘絮，身世浮沉雨打萍。", "from": "文天祥《过零丁洋》", "poem_id": 99999}, {"id": 532, "content": "去年元夜时，花市灯如昼。", "from": "欧阳修《生查子·元夕》", "poem_id": 99999}, {"id": 533, "content": "暗暗淡淡紫，融融冶冶黄。", "from": "李商隐《菊花》", "poem_id": 99999}, {"id": 534, "content": "此生此夜不长好，明月明年何处看。", "from": "苏轼《阳关曲 / 中秋月》", "poem_id": 99999}, {"id": 535, "content": "浮云终日行，游子久不至。", "from": "杜甫《梦李白二首·其二》", "poem_id": 99999}, {"id": 536, "content": "难相见，易相别，又是玉楼花似雪。", "from": "韦庄《应天长·别来半岁音书绝》", "poem_id": 99999}, {"id": 537, "content": "九曲黄河万里沙，浪淘风簸自天涯。", "from": "刘禹锡《浪淘沙·九曲黄河万里沙》", "poem_id": 99999}, {"id": 538, "content": "忆君心似西江水，日夜东流无歇时。", "from": "鱼玄机《江陵愁望寄子安》", "poem_id": 99999}, {"id": 540, "content": "独自凄凉还自遣，自制离愁。", "from": "龚自珍《浪淘沙·写梦》", "poem_id": 99999}, {"id": 541, "content": "有情不管别离久。情在相逢终有。", "from": "晏几道《秋蕊香·池苑清阴欲就》", "poem_id": 99999}, {"id": 543, "content": "还卿一钵无情泪，恨不相逢未剃时。", "from": "苏曼殊《本事诗十首·选二》", "poem_id": 99999}, {"id": 544, "content": "欲写彩笺书别怨。泪痕早已先书满。", "from": "晏几道《蝶恋花·黄菊开时伤聚散》", "poem_id": 99999}, {"id": 545, "content": "青青子衿，悠悠我心。", "from": "佚名《子衿》", "poem_id": 99999}, {"id": 546, "content": "多情却似总无情，唯觉樽前笑不成。", "from": "杜牧《赠别》", "poem_id": 99999}, {"id": 547, "content": "家在梦中何日到，春来江上几人还？", "from": "卢纶《长安春望》", "poem_id": 99999}, {"id": 548, "content": "今夜月明人尽望，不知秋思落谁家。", "from": "王建《十五夜望月寄杜郎中》", "poem_id": 99999}, {"id": 550, "content": "相思似海深，旧事如天远。", "from": "乐婉《卜算子·答施》", "poem_id": 99999}, {"id": 551, "content": "惟将终夜常开眼，报答平生未展眉。", "from": "元稹《遣悲怀三首·其三》", "poem_id": 99999}, {"id": 553, "content": "平林漠漠烟如织，寒山一带伤心碧。", "from": "李白《菩萨蛮·平林漠漠烟如织》", "poem_id": 99999}, {"id": 554, "content": "千里黄云白日曛，北风吹雁雪纷纷。", "from": "高适《别董大二首》", "poem_id": 99999}, {"id": 555, "content": "云淡风轻近午天，傍花随柳过前川。", "from": "程颢《春日偶成·云淡风轻近午天》", "poem_id": 99999}, {"id": 558, "content": "最是一年春好处，绝胜烟柳满皇都。", "from": "韩愈《早春呈水部张十八员外 / 初春小雨 / 早春》", "poem_id": 99999}, {"id": 560, "content": "花似伊。柳似伊。花柳青春人别离。", "from": "欧阳修《长相思·花似伊》", "poem_id": 99999}, {"id": 562, "content": "知有儿童挑促织，夜深篱落一灯明。", "from": "叶绍翁《夜书所见》", "poem_id": 99999}, {"id": 564, "content": "一月不读书，耳目失精爽。", "from": "萧抡谓《读书有所见作》", "poem_id": 99999}, {"id": 566, "content": "沧浪之水清兮，可以濯我缨；", "from": "佚名《沧浪歌》", "poem_id": 99999}, {"id": 567, "content": "相寻梦里路，飞雨落花中。", "from": "晏几道《临江仙·斗草阶前初见》", "poem_id": 99999}, {"id": 568, "content": "垂死病中惊坐起，暗风吹雨入寒窗。", "from": "元稹《闻乐天授江州司马》", "poem_id": 99999}, {"id": 569, "content": "江涵秋影雁初飞，与客携壶上翠微。", "from": "杜牧《九日齐山登高》", "poem_id": 99999}, {"id": 570, "content": "西风多少恨，吹不散眉弯。", "from": "纳兰性德《临江仙·寒柳》", "poem_id": 99999}, {"id": 571, "content": "暮云收尽溢清寒。银汉无声转玉盘。", "from": "苏轼《阳关曲 / 中秋月》", "poem_id": 99999}, {"id": 573, "content": "寒雨连天夜入吴，平明送客楚山孤。", "from": "王昌龄《芙蓉楼送辛渐二首》", "poem_id": 99999}, {"id": 574, "content": "绿遍山原白满川，子规声里雨如烟。", "from": "翁卷《乡村四月》", "poem_id": 99999}, {"id": 575, "content": "风烟俱净，天山共色。", "from": "吴均《与朱元思书》", "poem_id": 99999}, {"id": 576, "content": "冰，水为之，而寒于水。", "from": "荀子《劝学》", "poem_id": 99999}, {"id": 577, "content": "洛阳城里春光好，洛阳才子他乡老。", "from": "韦庄《菩萨蛮》", "poem_id": 99999}, {"id": 578, "content": "日暮乡关何处是？烟波江上使人愁。", "from": "崔颢《黄鹤楼 / 登黄鹤楼》", "poem_id": 99999}, {"id": 579, "content": "柳条折尽花飞尽，借问行人归不归？", "from": "佚名《送别诗》", "poem_id": 99999}, {"id": 580, "content": "杜鹃再拜忧天泪，精卫无穷填海心。", "from": "黄遵宪《赠梁任父母同年 / 题梁任父同年》", "poem_id": 99999}, {"id": 581, "content": "冠盖满京华，斯人独憔悴。", "from": "杜甫《梦李白二首·其二》", "poem_id": 99999}, {"id": 582, "content": "晓看红湿处，花重锦官城。", "from": "杜甫《春夜喜雨》", "poem_id": 99999}, {"id": 583, "content": "移舟去。未成新句。一砚梨花雨。", "from": "周晋《点绛唇·访牟存叟南漪钓隐》", "poem_id": 99999}, {"id": 584, "content": "梅子金黄杏子肥，麦花雪白菜花稀。", "from": "范成大《四时田园杂兴·其二》", "poem_id": 99999}, {"id": 587, "content": "故人入我梦，明我长相忆。", "from": "杜甫《梦李白二首·其一》", "poem_id": 99999}, {"id": 588, "content": "唯愿当歌对酒时，月光长照金樽里。", "from": "李白《把酒问月·故人贾淳令予问之》", "poem_id": 99999}, {"id": 589, "content": "梧桐树，三更雨，不道离情正苦。", "from": "温庭筠《更漏子·玉炉香》", "poem_id": 99999}, {"id": 590, "content": "欲渡黄河冰塞川，将登太行雪满山。", "from": "李白《行路难·其一》", "poem_id": 99999}, {"id": 591, "content": "姑苏城外寒山寺，夜半钟声到客船。", "from": "张继《枫桥夜泊 / 夜泊枫江》", "poem_id": 99999}, {"id": 593, "content": "低头弄莲子，莲子清如水。", "from": "佚名《西洲曲》", "poem_id": 99999}, {"id": 594, "content": "三万里河东入海，五千仞岳上摩天。", "from": "陆游《秋夜将晓出篱门迎凉有感》", "poem_id": 99999}, {"id": 595, "content": "闲云潭影日悠悠，物换星移几度秋。", "from": "王勃《滕王阁序》", "poem_id": 99999}, {"id": 596, "content": "秋风萧瑟天气凉，草木摇落露为霜，群燕辞归鹄南翔。", "from": "曹丕《燕歌行二首·其一》", "poem_id": 99999}, {"id": 597, "content": "月黑见渔灯，孤光一点萤。", "from": "查慎行《舟夜书所见》", "poem_id": 99999}, {"id": 598, "content": "洛阳城东桃李花，飞来飞去落谁家？", "from": "刘希夷《代悲白头翁 / 白头吟 / 有所思》", "poem_id": 99999}, {"id": 600, "content": "彩线轻缠红玉臂，小符斜挂绿云鬟。佳人相见一千年。", "from": "苏轼《浣溪沙·端午》", "poem_id": 99999}, {"id": 601, "content": "桃花春色暖先开，明媚谁人不看来。", "from": "周朴《桃花》", "poem_id": 99999}, {"id": 602, "content": "一朵芙蕖，开过尚盈盈。", "from": "苏轼《江神子·江景》", "poem_id": 99999}, {"id": 604, "content": "一夜雨声凉到梦，万荷叶上送秋来。", "from": "陈文述《夏日杂诗》", "poem_id": 99999}, {"id": 605, "content": "东武望余杭，云海天涯两渺茫。", "from": "苏轼《南乡子·和杨元素时移守密州》", "poem_id": 99999}, {"id": 607, "content": "细雨鱼儿出，微风燕子斜。", "from": "杜甫《水槛遣心二首》", "poem_id": 99999}, {"id": 608, "content": "今我来思，雨雪霏霏。", "from": "佚名《采薇》", "poem_id": 99999}, {"id": 609, "content": "离多最是，东西流水，终解两相逢。", "from": "晏几道《少年游·离多最是》", "poem_id": 99999}, {"id": 610, "content": "深知身在情长在，怅望江头江水声。", "from": "李商隐《暮秋独游曲江》", "poem_id": 99999}, {"id": 611, "content": "江流天地外，山色有无中。", "from": "王维《汉江临泛 / 汉江临眺》", "poem_id": 99999}, {"id": 612, "content": "山不厌高，海不厌深。", "from": "曹操《短歌行》", "poem_id": 99999}, {"id": 613, "content": "两岸猿声啼不住，轻舟已过万重山。", "from": "李白《早发白帝城 / 白帝下江陵》", "poem_id": 99999}, {"id": 614, "content": "若有知音见采，不辞遍唱阳春。", "from": "晏殊《山亭柳·赠歌者》", "poem_id": 99999}, {"id": 615, "content": "凄凉别后两应同，最是不胜清怨月明中。", "from": "纳兰性德《虞美人·曲阑深处重相见》", "poem_id": 99999}, {"id": 616, "content": "杨花榆荚无才思，惟解漫天作雪飞。", "from": "韩愈《晚春》", "poem_id": 99999}, {"id": 618, "content": "三千丈清愁鬓发，五十年春梦繁华。", "from": "乔吉《折桂令·客窗清明》", "poem_id": 99999}, {"id": 619, "content": "渭城朝雨浥轻尘，客舍青青柳色新。", "from": "王维《渭城曲 / 送元二使安西》", "poem_id": 99999}, {"id": 620, "content": "读书破万卷，下笔如有神。", "from": "杜甫《奉赠韦左丞丈二十二韵》", "poem_id": 99999}, {"id": 621, "content": "十年无梦得还家，独立青峰野水涯。", "from": "谢枋得《武夷山中》", "poem_id": 99999}, {"id": 622, "content": "千里江山寒色远，芦花深处泊孤舟，笛在月明楼。", "from": "李煜《望江南·闲梦远》", "poem_id": 99999}, {"id": 623, "content": "王师北定中原日，家祭无忘告乃翁。", "from": "陆游《示儿》", "poem_id": 99999}, {"id": 624, "content": "悲欢离合总无情。一任阶前、点滴到天明。", "from": "蒋捷《虞美人·听雨》", "poem_id": 99999}, {"id": 625, "content": "扬子江头杨柳春，杨花愁杀渡江人。", "from": "郑谷《淮上与友人别》", "poem_id": 99999}, {"id": 626, "content": "两句三年得，一吟双泪流。", "from": "贾岛《题诗后》", "poem_id": 99999}, {"id": 627, "content": "浊酒一杯家万里，燕然未勒归无计。", "from": "范仲淹《渔家傲·秋思》", "poem_id": 99999}, {"id": 628, "content": "遥知兄弟登高处，遍插茱萸少一人。", "from": "王维《九月九日忆山东兄弟 / 九月九忆山东兄弟》", "poem_id": 99999}, {"id": 630, "content": "青海长云暗雪山，孤城遥望玉门关。", "from": "王昌龄《从军行七首·其四》", "poem_id": 99999}, {"id": 631, "content": "天门中断楚江开，碧水东流至此回。", "from": "李白《望天门山》", "poem_id": 99999}, {"id": 633, "content": "叶上初阳干宿雨、水面清圆，一一风荷举。", "from": "周邦彦《苏幕遮·燎沉香》", "poem_id": 99999}, {"id": 634, "content": "梅子留酸软齿牙，芭蕉分绿与窗纱。", "from": "杨万里《闲居初夏午睡起》", "poem_id": 99999}, {"id": 635, "content": "庭树不知人去尽，春来还发旧时花。", "from": "岑参《山房春事二首》", "poem_id": 99999}, {"id": 636, "content": "共眠一舸听秋雨，小簟轻衾各自寒。", "from": "朱彝尊《桂殿秋·思往事》", "poem_id": 99999}, {"id": 637, "content": "兴尽晚回舟，误入藕花深处。", "from": "李清照《如梦令·常记溪亭日暮》", "poem_id": 99999}, {"id": 638, "content": "清谈可以饱，梦想接无由。", "from": "韩愈《洞庭湖阻风赠张十一署·时自阳山徙掾江陵》", "poem_id": 99999}, {"id": 639, "content": "牧童归去横牛背，短笛无腔信口吹。", "from": "雷震《村晚》", "poem_id": 99999}, {"id": 640, "content": "蓬头稚子学垂纶，侧坐莓苔草映身。", "from": "胡令能《小儿垂钓》", "poem_id": 99999}, {"id": 641, "content": "牧童骑黄牛，歌声振林樾。", "from": "袁枚《所见》", "poem_id": 99999}, {"id": 642, "content": "残星几点雁横塞，长笛一声人倚楼。", "from": "赵嘏《长安晚秋 / 秋望 / 秋夕》", "poem_id": 99999}, {"id": 643, "content": "月出惊山鸟，时鸣春涧中。", "from": "王维《鸟鸣涧》", "poem_id": 99999}, {"id": 644, "content": "纸屏石枕竹方床，手倦抛书午梦长。", "from": "蔡确《夏日登车盖亭》", "poem_id": 99999}, {"id": 646, "content": "落木千山天远大，澄江一道月分明。", "from": "黄庭坚《登快阁》", "poem_id": 99999}, {"id": 647, "content": "别来半岁音书绝，一寸离肠千万结。", "from": "韦庄《应天长·别来半岁音书绝》", "poem_id": 99999}, {"id": 648, "content": "江南春尽离肠断，苹满汀洲人未归。", "from": "寇准《江南春·波渺渺》", "poem_id": 99999}, {"id": 650, "content": "梦回人远许多愁，只在梨花风雨处。", "from": "辛弃疾《玉楼春·风前欲劝春光住》", "poem_id": 99999}, {"id": 651, "content": "楼船夜雪瓜洲渡，铁马秋风大散关。", "from": "陆游《书愤五首·其一》", "poem_id": 99999}, {"id": 653, "content": "酒债寻常行处有，人生七十古来稀。", "from": "杜甫《曲江二首》", "poem_id": 99999}, {"id": 654, "content": "笑尽一杯酒，杀人都市中。", "from": "李白《结客少年场行》", "poem_id": 99999}, {"id": 655, "content": "宫女如花满春殿，只今惟有鹧鸪飞。", "from": "李白《越中览古》", "poem_id": 99999}, {"id": 656, "content": "都道无人愁似我，今夜雪，有梅花，似我愁。", "from": "蒋捷《梅花引·荆溪阻雪》", "poem_id": 99999}, {"id": 657, "content": "芳树无人花自落，春山一路鸟空啼。", "from": "李华《春行即兴》", "poem_id": 99999}, {"id": 658, "content": "日暮酒醒人已远，满天风雨下西楼。", "from": "许浑《谢亭送别》", "poem_id": 99999}, {"id": 659, "content": "春来秋去相思在，秋去春来信息稀。", "from": "鱼玄机《闺怨》", "poem_id": 99999}, {"id": 660, "content": "知君用心如日月，事夫誓拟同生死。", "from": "张籍《节妇吟·寄东平李司空师道》", "poem_id": 99999}, {"id": 661, "content": "斑竹枝，斑竹枝，泪痕点点寄相思。", "from": "刘禹锡《潇湘神·斑竹枝》", "poem_id": 99999}, {"id": 662, "content": "凉月如眉挂柳湾，越中山色镜中看。", "from": "戴叔伦《兰溪棹歌》", "poem_id": 99999}, {"id": 664, "content": "纤云弄巧，飞星传恨，银汉迢迢暗度。", "from": "秦观《鹊桥仙·纤云弄巧》", "poem_id": 99999}, {"id": 665, "content": "涉江采芙蓉，兰泽多芳草。", "from": "佚名《涉江采芙蓉》", "poem_id": 99999}, {"id": 666, "content": "杨柳阴阴细雨晴，残花落尽见流莺。", "from": "武元衡《春兴》", "poem_id": 99999}, {"id": 667, "content": "朱弦已为佳人绝，青眼聊因美酒横。", "from": "黄庭坚《登快阁》", "poem_id": 99999}, {"id": 668, "content": "人家见生男女好，不知男女催人老。", "from": "王建《短歌行》", "poem_id": 99999}, {"id": 669, "content": "令公桃李满天下，何用堂前更种花。", "from": "白居易《奉和令公绿野堂种花》", "poem_id": 99999}, {"id": 670, "content": "寻常一样窗前月，才有梅花便不同。", "from": "杜耒《寒夜》", "poem_id": 99999}, {"id": 671, "content": "殷勤昨夜三更雨，又得浮生一日凉。", "from": "苏轼《鹧鸪天·林断山明竹隐墙》", "poem_id": 99999}, {"id": 672, "content": "冰骨清寒瘦一枝。玉人初上木兰时。", "from": "吴文英《浣溪沙·题李中斋舟中梅屏》", "poem_id": 99999}, {"id": 674, "content": "小娃撑小艇，偷采白莲回。", "from": "白居易《池上》", "poem_id": 99999}, {"id": 675, "content": "十年种木，一年种谷，都付儿童。", "from": "元好问《人月圆·重冈已隔红尘断》", "poem_id": 99999}, {"id": 676, "content": "穷且益坚，不坠青云之志。", "from": "王勃《滕王阁序》", "poem_id": 99999}, {"id": 679, "content": "帘外雨潺潺，春意阑珊。", "from": "李煜《浪淘沙令·帘外雨潺潺》", "poem_id": 99999}, {"id": 680, "content": "未觉池塘春草梦，阶前梧叶已秋声。", "from": "朱熹《偶成》", "poem_id": 99999}, {"id": 681, "content": "春山烟欲收，天淡星稀小。", "from": "牛希济《生查子·春山烟欲收》", "poem_id": 99999}, {"id": 682, "content": "有三秋桂子，十里荷花。", "from": "柳永《望海潮·东南形胜》", "poem_id": 99999}, {"id": 683, "content": "尘世难逢开口笑，菊花须插满头归。", "from": "杜牧《九日齐山登高》", "poem_id": 99999}, {"id": 684, "content": "泰山不要欺毫末，颜子无心羡老彭。", "from": "白居易《放言五首·其五》", "poem_id": 99999}, {"id": 685, "content": "雪纷纷，掩重门，不由人不断魂，瘦损江梅韵。", "from": "关汉卿《大德歌·冬》", "poem_id": 99999}, {"id": 686, "content": "好风凭借力，送我上青云。", "from": "曹雪芹《临江仙·柳絮》", "poem_id": 99999}, {"id": 690, "content": "故不登高山，不知天之高也；不临深溪，不知地之厚也；", "from": "荀子《劝学》", "poem_id": 99999}, {"id": 691, "content": "相思一夜情多少，地角天涯未是长。", "from": "张仲素《燕子楼诗三首》", "poem_id": 99999}, {"id": 692, "content": "夜夜相思更漏残，伤心明月凭阑干，想君思我锦衾寒。", "from": "韦庄《浣溪沙·夜夜相思更漏残》", "poem_id": 99999}, {"id": 693, "content": "四海皆兄弟，谁为行路人。", "from": "佚名《旧题苏武诗 / 别诗四首·其一》", "poem_id": 99999}, {"id": 694, "content": "待浮花、浪蕊都尽，伴君幽独。", "from": "苏轼《贺新郎·夏景》", "poem_id": 99999}, {"id": 695, "content": "共看明月应垂泪，一夜乡心五处同。", "from": "白居易《望月有感》", "poem_id": 99999}, {"id": 697, "content": "江雨霏霏江草齐，六朝如梦鸟空啼。", "from": "韦庄《台城》", "poem_id": 99999}, {"id": 698, "content": "梦断香消四十年，沈园柳老不吹绵。", "from": "陆游《沈园二首》", "poem_id": 99999}, {"id": 699, "content": "历览前贤国与家，成由勤俭破由奢。", "from": "李商隐《咏史二首·其二》", "poem_id": 99999}, {"id": 700, "content": "富贵必从勤苦得，男儿须读五车书。", "from": "杜甫《柏学士茅屋》", "poem_id": 99999}, {"id": 701, "content": "鸡声茅店月，人迹板桥霜。", "from": "温庭筠《商山早行》", "poem_id": 99999}, {"id": 702, "content": "遥知湖上一樽酒，能忆天涯万里人。", "from": "欧阳修《春日西湖寄谢法曹歌》", "poem_id": 99999}, {"id": 703, "content": "对酒卷帘邀明月，风露透窗纱。", "from": "苏轼《少年游·润州作》", "poem_id": 99999}, {"id": 704, "content": "柳絮风轻，梨花雨细。", "from": "谢逸《踏莎行·柳絮风轻》", "poem_id": 99999}, {"id": 705, "content": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。", "from": "佚名《关雎》", "poem_id": 99999}, {"id": 707, "content": "不知细叶谁裁出，二月春风似剪刀。", "from": "贺知章《咏柳 / 柳枝词》", "poem_id": 99999}, {"id": 709, "content": "何日归家洗客袍？银字笙调，心字香烧。", "from": "蒋捷《一剪梅·舟过吴江》", "poem_id": 99999}, {"id": 710, "content": "君自故乡来，应知故乡事。", "from": "王维《杂诗三首·其二》", "poem_id": 99999}, {"id": 712, "content": "四月十七，正是去年今日，别君时。", "from": "韦庄《女冠子·四月十七》", "poem_id": 99999}, {"id": 713, "content": "孤山寺北贾亭西，水面初平云脚低。", "from": "白居易《钱塘湖春行》", "poem_id": 99999}, {"id": 716, "content": "招魂楚些何嗟及，山鬼暗啼风雨。", "from": "元好问《摸鱼儿·雁丘词 / 迈陂塘》", "poem_id": 99999}, {"id": 717, "content": "流水便随春远，行云终与谁同。", "from": "晏几道《临江仙·斗草阶前初见》", "poem_id": 99999}, {"id": 718, "content": "雨里鸡鸣一两家，竹溪村路板桥斜。", "from": "王建《雨过山村》", "poem_id": 99999}, {"id": 720, "content": "黑云压城城欲摧，甲光向日金鳞开。", "from": "李贺《雁门太守行》", "poem_id": 99999}, {"id": 721, "content": "野火烧不尽，春风吹又生。", "from": "白居易《草 / 赋得古原草送别》", "poem_id": 99999}, {"id": 722, "content": "不积小流，无以成江海。", "from": "荀子《劝学》", "poem_id": 99999}, {"id": 723, "content": "兰叶春葳蕤，桂华秋皎洁。", "from": "张九龄《感遇十二首·其一》", "poem_id": 99999}, {"id": 724, "content": "莫笑农家腊酒浑，丰年留客足鸡豚。", "from": "陆游《游山西村》", "poem_id": 99999}, {"id": 725, "content": "新丰美酒斗十千，咸阳游侠多少年。", "from": "王维《少年行四首》", "poem_id": 99999}, {"id": 726, "content": "假金方用真金镀，若是真金不镀金。", "from": "李绅《答章孝标》", "poem_id": 99999}, {"id": 727, "content": "童孙未解供耕织，也傍桑阴学种瓜。", "from": "范成大《夏日田园杂兴·其七》", "poem_id": 99999}, {"id": 728, "content": "独上江楼思渺然，月光如水水如天。", "from": "赵嘏《江楼旧感》", "poem_id": 99999}, {"id": 729, "content": "青女素娥俱耐冷，月中霜里斗婵娟。", "from": "李商隐《霜月》", "poem_id": 99999}, {"id": 730, "content": "月黑雁飞高，单于夜遁逃。", "from": "卢纶《和张仆射塞下曲·其三》", "poem_id": 99999}, {"id": 732, "content": "捐躯赴国难，视死忽如归！", "from": "曹植《白马篇》", "poem_id": 99999}, {"id": 733, "content": "少年易学老难成，一寸光阴不可轻。", "from": "朱熹《偶成》", "poem_id": 99999}, {"id": 734, "content": "今夜偏知春气暖，虫声新透绿窗纱。", "from": "刘方平《夜月 / 月夜》", "poem_id": 99999}, {"id": 735, "content": "一畦春韭绿，十里稻花香。", "from": "曹雪芹《菱荇鹅儿水》", "poem_id": 99999}, {"id": 737, "content": "满载一船秋色，平铺十里湖光。", "from": "张孝祥《西江月·阻风山峰下》", "poem_id": 99999}, {"id": 738, "content": "东风袅袅泛崇光，香雾空蒙月转廊。", "from": "苏轼《海棠·东风袅袅泛崇光》", "poem_id": 99999}, {"id": 739, "content": "春水满四泽，夏云多奇峰。", "from": "陶渊明《四时》", "poem_id": 99999}, {"id": 741, "content": "过尽千帆皆不是，斜晖脉脉水悠悠。", "from": "温庭筠《望江南·梳洗罢》", "poem_id": 99999}, {"id": 742, "content": "不论平地与山尖，无限风光尽被占。", "from": "罗隐《蜂》", "poem_id": 99999}, {"id": 743, "content": "忆昔花间相见后，只凭纤手，暗抛红豆。", "from": "欧阳炯《贺明朝·忆昔花间相见后》", "poem_id": 99999}, {"id": 744, "content": "怅恨不逢如意酒。寻思难值有情人。", "from": "晏几道《浣溪沙·闲弄筝弦懒系裙》", "poem_id": 99999}, {"id": 745, "content": "狂风吹我心，西挂咸阳树。", "from": "李白《金乡送韦八之西京》", "poem_id": 99999}, {"id": 748, "content": "羌管悠悠霜满地，人不寐，将军白发征夫泪。", "from": "范仲淹《渔家傲·秋思》", "poem_id": 99999}, {"id": 750, "content": "笑杀陶渊明，不饮杯中酒。", "from": "李白《嘲王历阳不肯饮酒》", "poem_id": 99999}, {"id": 751, "content": "胜败兵家事不期，包羞忍耻是男儿。", "from": "杜牧《题乌江亭》", "poem_id": 99999}, {"id": 753, "content": "揉蓝衫子杏黄裙，独倚玉阑无语点檀唇。", "from": "秦观《南歌子·香墨弯弯画》", "poem_id": 99999}, {"id": 754, "content": "白雪却嫌春色晚，故穿庭树作飞花。", "from": "韩愈《春雪》", "poem_id": 99999}, {"id": 755, "content": "留连戏蝶时时舞，自在娇莺恰恰啼。", "from": "杜甫《江畔独步寻花·其六》", "poem_id": 99999}, {"id": 757, "content": "槛菊愁烟兰泣露。罗幕轻寒，燕子双飞去。", "from": "晏殊《蝶恋花·槛菊愁烟兰泣露》", "poem_id": 99999}, {"id": 759, "content": "纸灰飞作白蝴蝶，泪血染成红杜鹃。", "from": "高翥《清明日对酒》", "poem_id": 99999}, {"id": 760, "content": "未收天子河湟地，不拟回头望故乡。", "from": "令狐楚《少年行四首·其三》", "poem_id": 99999}, {"id": 762, "content": "天与短因缘，聚散常容易。", "from": "晏几道《生查子·狂花顷刻香》", "poem_id": 99999}, {"id": 763, "content": "雁引愁心去，山衔好月来。", "from": "李白《与夏十二登岳阳楼》", "poem_id": 99999}, {"id": 764, "content": "黄师塔前江水东，春光懒困倚微风。", "from": "杜甫《江畔独步寻花·其五》", "poem_id": 99999}, {"id": 766, "content": "一枝红艳露凝香，云雨巫山枉断肠。", "from": "李白《清平调·其二》", "poem_id": 99999}, {"id": 767, "content": "白发渔樵江渚上，惯看秋月春风。", "from": "杨慎《临江仙·滚滚长江东逝水》", "poem_id": 99999}, {"id": 768, "content": "河海不择细流，故能就其深；", "from": "李斯《谏逐客书》", "poem_id": 99999}, {"id": 770, "content": "解落三秋叶，能开二月花。", "from": "李峤《风》", "poem_id": 99999}, {"id": 771, "content": "荷叶罗裙一色裁，芙蓉向脸两边开。", "from": "王昌龄《采莲曲》", "poem_id": 99999}, {"id": 773, "content": "摇落深知宋玉悲，风流儒雅亦吾师。", "from": "杜甫《咏怀古迹五首·其二》", "poem_id": 99999}, {"id": 774, "content": "双星何事今宵会，遗我庭前月一钩。", "from": "德容《七夕二首·其一》", "poem_id": 99999}, {"id": 775, "content": "常记溪亭日暮，沉醉不知归路。", "from": "李清照《如梦令·常记溪亭日暮》", "poem_id": 99999}, {"id": 776, "content": "白锦无纹香烂漫，玉树琼葩堆雪。", "from": "丘处机《无俗念·灵虚宫梨花词》", "poem_id": 99999}, {"id": 777, "content": "孤村落日残霞，轻烟老树寒鸦，一点飞鸿影下。", "from": "白朴《天净沙·秋》", "poem_id": 99999}, {"id": 778, "content": "长安一片月，万户捣衣声。", "from": "李白《子夜吴歌·秋歌》", "poem_id": 99999}, {"id": 779, "content": "横看成岭侧成峰，远近高低各不同。", "from": "苏轼《题西林壁》", "poem_id": 99999}, {"id": 780, "content": "青春须早为，岂能长少年。", "from": "孟郊《劝学》", "poem_id": 99999}, {"id": 781, "content": "想乌衣年少，芝兰秀发，戈戟云横。", "from": "叶梦得《八声甘州·寿阳楼八公山作》", "poem_id": 99999}, {"id": 782, "content": "更无柳絮因风起，惟有葵花向日倾。", "from": "司马光《客中初夏》", "poem_id": 99999}, {"id": 783, "content": "幸遇三杯酒好，况逢一朵花新。", "from": "朱敦儒《西江月·世事短如春梦》", "poem_id": 99999}, {"id": 784, "content": "笛中闻折柳，春色未曾看。", "from": "李白《塞下曲六首·其一》", "poem_id": 99999}, {"id": 785, "content": "春日宴，绿酒一杯歌一遍。", "from": "冯延巳《长命女·春日宴》", "poem_id": 99999}, {"id": 786, "content": "多少天涯未归客，尽借篱落看秋风。", "from": "唐寅《菊花》", "poem_id": 99999}, {"id": 787, "content": "青箬笠，绿蓑衣，斜风细雨不须归。", "from": "张志和《渔歌子·西塞山前白鹭飞》", "poem_id": 99999}, {"id": 788, "content": "明月别枝惊鹊，清风半夜鸣蝉。", "from": "辛弃疾《西江月·夜行黄沙道中》", "poem_id": 99999}, {"id": 789, "content": "此身合是诗人未？细雨骑驴入剑门。", "from": "陆游《剑门道中遇微雨》", "poem_id": 99999}, {"id": 790, "content": "不知近水花先发，疑是经冬雪未销。", "from": "张谓《早梅》", "poem_id": 99999}, {"id": 791, "content": "水急客舟疾，山花拂面香。", "from": "李白《秋浦歌十七首》", "poem_id": 99999}, {"id": 792, "content": "红豆不堪看，满眼相思泪。", "from": "牛希济《生查子·新月曲如眉》", "poem_id": 99999}, {"id": 794, "content": "最是仓皇辞庙日，教坊犹奏别离歌，垂泪对宫娥。", "from": "李煜《破阵子·四十年来家国》", "poem_id": 99999}, {"id": 795, "content": "惨惨柴门风雪夜，此时有子不如无。", "from": "黄景仁《别老母》", "poem_id": 99999}, {"id": 796, "content": "长记别伊时，和泪出门相送。", "from": "李存勖《如梦令·曾宴桃源深洞》", "poem_id": 99999}, {"id": 797, "content": "佳节清明桃李笑，野田荒冢只生愁。", "from": "黄庭坚《清明》", "poem_id": 99999}, {"id": 798, "content": "此花此叶常相映，翠减红衰愁杀人。", "from": "李商隐《赠荷花》", "poem_id": 99999}, {"id": 800, "content": "火树银花合，星桥铁锁开。", "from": "苏味道《正月十五夜》", "poem_id": 99999}, {"id": 803, "content": "疾风知劲草，板荡识诚臣。", "from": "李世民《赐萧瑀》", "poem_id": 99999}, {"id": 804, "content": "一年三百六十日，多是横戈马上行。", "from": "戚继光《马上作》", "poem_id": 99999}, {"id": 805, "content": "十里青山远，潮平路带沙。数声啼鸟怨年华。", "from": "仲殊《南柯子·十里青山远》", "poem_id": 99999}, {"id": 806, "content": "大鹏一日同风起，扶摇直上九万里。", "from": "李白《上李邕》", "poem_id": 99999}, {"id": 808, "content": "三更月。中庭恰照梨花雪。", "from": "贺铸《子夜歌·三更月》", "poem_id": 99999}, {"id": 809, "content": "古木阴中系短篷，杖藜扶我过桥东。", "from": "志南《绝句》", "poem_id": 99999}, {"id": 810, "content": "乡村四月闲人少，才了蚕桑又插田。", "from": "翁卷《乡村四月》", "poem_id": 99999}, {"id": 811, "content": "待何年归去，谈笑各争雄。", "from": "顾太清《高山流水·次夫子清风阁落成韵》", "poem_id": 99999}, {"id": 812, "content": "片云天共远，永夜月同孤。", "from": "杜甫《江汉》", "poem_id": 99999}, {"id": 813, "content": "惊回千里梦，已三更。起来独自绕阶行。", "from": "岳飞《小重山·昨夜寒蛩不住鸣》", "poem_id": 99999}, {"id": 814, "content": "十年花骨东风泪，几点螺香素壁尘。", "from": "史达祖《鹧鸪天·搭柳栏干倚伫频》", "poem_id": 99999}, {"id": 815, "content": "入则无法家拂士，出则无敌国外患者，国恒亡。", "from": "孟子及其弟子《生于忧患，死于安乐》", "poem_id": 99999}, {"id": 816, "content": "自别后遥山隐隐，更那堪远水粼粼。", "from": "王实甫《十二月过尧民歌·别情》", "poem_id": 99999}, {"id": 817, "content": "西北望乡何处是，东南见月几回圆。", "from": "白居易《八月十五日夜湓亭望月》", "poem_id": 99999}, {"id": 818, "content": "车遥遥兮马洋洋，追思君兮不可忘。", "from": "傅玄《车遥遥篇》", "poem_id": 99999}, {"id": 820, "content": "五月天山雪，无花只有寒。", "from": "李白《塞下曲六首·其一》", "poem_id": 99999}, {"id": 821, "content": "积土成山，风雨兴焉；积水成渊，蛟龙生焉；", "from": "荀子《劝学》", "poem_id": 99999}, {"id": 824, "content": "章台柳，章台柳，昔日青青今在否？", "from": "韩翃《章台柳·寄柳氏》", "poem_id": 99999}, {"id": 825, "content": "柳如眉，云似发，鲛绡雾縠笼香雪。", "from": "魏承班《渔歌子·柳如眉》", "poem_id": 99999}, {"id": 826, "content": "最是人间留不住，朱颜辞镜花辞树。", "from": "王国维《蝶恋花·阅尽天涯离别苦》", "poem_id": 99999}, {"id": 827, "content": "颠狂柳絮随风去，轻薄桃花逐水流。", "from": "杜甫《绝句漫兴九首·其五》", "poem_id": 99999}, {"id": 828, "content": "白日不到处，青春恰自来。", "from": "袁枚《苔》", "poem_id": 99999}, {"id": 829, "content": "当年万里觅封侯。匹马戍梁州。", "from": "陆游《诉衷情·当年万里觅封侯》", "poem_id": 99999}, {"id": 830, "content": "故国三千里，深宫二十年。", "from": "张祜《宫词·故国三千里》", "poem_id": 99999}, {"id": 831, "content": "问君何能尔？心远地自偏。", "from": "陶渊明《饮酒·其五》", "poem_id": 99999}, {"id": 832, "content": "芳菲歇去何须恨，夏木阴阴正可人。", "from": "秦观《三月晦日偶题》", "poem_id": 99999}, {"id": 833, "content": "云尽月如练，水凉风似秋。", "from": "欧阳詹《荆南夏夜水楼怀昭丘直上人云梦李莘》", "poem_id": 99999}, {"id": 834, "content": "细雨湿衣看不见，闲花落地听无声。", "from": "刘长卿《别严士元》", "poem_id": 99999}, {"id": 835, "content": "半亩方塘一鉴开，天光云影共徘徊。", "from": "朱熹《活水亭观书有感二首·其一》", "poem_id": 99999}, {"id": 836, "content": "音尘绝，西风残照，汉家陵阙。", "from": "李白《忆秦娥·箫声咽》", "poem_id": 99999}, {"id": 837, "content": "骊山语罢清宵半，泪雨霖铃终不怨。", "from": "纳兰性德《木兰词·拟古决绝词柬友》", "poem_id": 99999}, {"id": 838, "content": "别君去兮何时还？且放白鹿青崖间。须行即骑访名山。", "from": "李白《梦游天姥吟留别 / 别东鲁诸公》", "poem_id": 99999}, {"id": 839, "content": "君家何处住，妾住在横塘。", "from": "崔颢《长干行·君家何处住》", "poem_id": 99999}, {"id": 840, "content": "淮南皓月冷千山，冥冥归去无人管。", "from": "姜夔《踏莎行·自沔东来》", "poem_id": 99999}, {"id": 841, "content": "人归落雁后，思发在花前。", "from": "薛道衡《人日思归》", "poem_id": 99999}, {"id": 842, "content": "猿啼客散暮江头，人自伤心水自流。", "from": "刘长卿《重送裴郎中贬吉州》", "poem_id": 99999}, {"id": 843, "content": "英雄一去豪华尽，惟有青山似洛中。", "from": "许浑《金陵怀古》", "poem_id": 99999}, {"id": 845, "content": "愁云淡淡雨潇潇。暮暮复朝朝。", "from": "石孝友《眼儿媚·愁云淡淡雨潇潇》", "poem_id": 99999}, {"id": 846, "content": "年年负却花期！过春时，只合安排愁绪送春归。", "from": "张惠言《相见欢·年年负却花期》", "poem_id": 99999}, {"id": 847, "content": "一片花飞减却春，风飘万点正愁人。", "from": "杜甫《曲江二首》", "poem_id": 99999}, {"id": 848, "content": "孤雁不饮啄，飞鸣声念群。", "from": "杜甫《孤雁 / 后飞雁》", "poem_id": 99999}, {"id": 850, "content": "还似旧时游上苑，车如流水马如龙。", "from": "李煜《忆江南·多少恨》", "poem_id": 99999}, {"id": 851, "content": "我见青山多妩媚，料青山见我应如是。", "from": "辛弃疾《贺新郎·甚矣吾衰矣》", "poem_id": 99999}, {"id": 853, "content": "春风春雨花经眼，江北江南水拍天。", "from": "黄庭坚《次元明韵寄子由》", "poem_id": 99999}, {"id": 854, "content": "万里无人收白骨，家家城下招魂葬。", "from": "张籍《征妇怨》", "poem_id": 99999}, {"id": 855, "content": "唯有相思似春色，江南江北送君归。", "from": "王维《送沈子归江东 / 送沈子福之江东》", "poem_id": 99999}, {"id": 857, "content": "西窗下，风摇翠竹，疑是故人来。", "from": "秦观《满庭芳·碧水惊秋》", "poem_id": 99999}, {"id": 858, "content": "不才明主弃，多病故人疏。", "from": "孟浩然《岁暮归南山 / 归故园作 / 归终南山》", "poem_id": 99999}, {"id": 860, "content": "独在异乡为异客，每逢佳节倍思亲。", "from": "王维《九月九日忆山东兄弟 / 九月九忆山东兄弟》", "poem_id": 99999}, {"id": 861, "content": "不知何岁月，得与尔同归？", "from": "韦承庆《南中咏雁诗》", "poem_id": 99999}, {"id": 862, "content": "逢郎欲语低头笑，碧玉搔头落水中。", "from": "白居易《采莲曲》", "poem_id": 99999}, {"id": 864, "content": "古人今人若流水，共看明月皆如此。", "from": "李白《把酒问月·故人贾淳令予问之》", "poem_id": 99999}, {"id": 866, "content": "未能抛得杭州去，一半勾留是此湖。", "from": "白居易《春题湖上》", "poem_id": 99999}, {"id": 867, "content": "湘江两岸花木深，美人不见愁人心。", "from": "卢仝《有所思》", "poem_id": 99999}, {"id": 868, "content": "谁怜一片影，相失万重云？", "from": "杜甫《孤雁 / 后飞雁》", "poem_id": 99999}, {"id": 869, "content": "渭北春天树，江东日暮云。", "from": "杜甫《春日忆李白》", "poem_id": 99999}, {"id": 870, "content": "莺初解语，最是一年春好处。", "from": "苏轼《减字木兰花·莺初解语》", "poem_id": 99999}, {"id": 871, "content": "三五年时三五月，可怜杯酒不曾消。", "from": "黄景仁《绮怀》", "poem_id": 99999}, {"id": 872, "content": "一叶渔船两小童，收篙停棹坐船中。", "from": "杨万里《舟过安仁》", "poem_id": 99999}, {"id": 873, "content": "叶落当归根，云沉久必起。", "from": "钱嶫《悯黎咏》", "poem_id": 99999}, {"id": 874, "content": "可怜九月初三夜，露似真珠月似弓。", "from": "白居易《暮江吟》", "poem_id": 99999}, {"id": 875, "content": "参横斗转欲三更，苦雨终风也解晴。", "from": "苏轼《六月二十日夜渡海》", "poem_id": 99999}, {"id": 876, "content": "淡淡梅花香欲染，丝丝柳带露初干。", "from": "曹雪芹《香菱咏月·其二》", "poem_id": 99999}, {"id": 877, "content": "落叶聚还散，寒鸦栖复惊。", "from": "李白《三五七言 / 秋风词》", "poem_id": 99999}, {"id": 878, "content": "竹影和诗瘦，梅花入梦香。", "from": "王庭筠《绝句·竹影和诗瘦》", "poem_id": 99999}, {"id": 879, "content": "惟有绿荷红菡萏，卷舒开合任天真。", "from": "李商隐《赠荷花》", "poem_id": 99999}, {"id": 880, "content": "可惜一溪风月，莫教踏碎琼瑶。", "from": "苏轼《西江月·顷在黄州》", "poem_id": 99999}, {"id": 881, "content": "三军可夺帅也，匹夫不可夺志也。", "from": "佚名《论语十二章》", "poem_id": 99999}, {"id": 882, "content": "归志宁无五亩园，读书本意在元元。", "from": "陆游《读书》", "poem_id": 99999}, {"id": 883, "content": "朝真暮伪何人辨，古往今来底事无。", "from": "白居易《放言五首·其一》", "poem_id": 99999}, {"id": 884, "content": "人生如寄，何事辛苦怨斜晖。", "from": "朱熹《水调歌头·隐括杜牧之齐山诗》", "poem_id": 99999}, {"id": 885, "content": "子规夜半犹啼血，不信东风唤不回。", "from": "王令《送春》", "poem_id": 99999}, {"id": 887, "content": "月明船笛参差起，风定池莲自在香。", "from": "秦观《纳凉》", "poem_id": 99999}, {"id": 888, "content": "小扇引微凉，悠悠夏日长。", "from": "顾太清《菩萨蛮·端午日咏盆中菊》", "poem_id": 99999}, {"id": 889, "content": "冉冉秋光留不住，满阶红叶暮。", "from": "李煜《谢新恩·冉冉秋光留不住》", "poem_id": 99999}, {"id": 890, "content": "云散月明谁点缀？天容海色本澄清。", "from": "苏轼《六月二十日夜渡海》", "poem_id": 99999}, {"id": 891, "content": "细雨斜风作晓寒。淡烟疏柳媚晴滩。", "from": "苏轼《浣溪沙·元丰七年十二月二十四日从泗州刘倩叔游南山》", "poem_id": 99999}, {"id": 892, "content": "天苍苍，野茫茫。风吹草低见牛羊。", "from": "佚名《敕勒歌》", "poem_id": 99999}, {"id": 894, "content": "砌下落梅如雪乱，拂了一身还满。", "from": "李煜《清平乐·别来春半》", "poem_id": 99999}, {"id": 895, "content": "大雪压青松，青松挺且直。", "from": "陈毅《青松》", "poem_id": 99999}, {"id": 896, "content": "砧杵敲残深巷月，井梧摇落故园秋。", "from": "陆游《秋思》", "poem_id": 99999}, {"id": 897, "content": "江头未是风波恶，别有人间行路难！", "from": "辛弃疾《鹧鸪天·送人》", "poem_id": 99999}, {"id": 898, "content": "半卷红旗临易水，霜重鼓寒声不起。", "from": "李贺《雁门太守行》", "poem_id": 99999}, {"id": 899, "content": "杨柳青青江水平，闻郎江上踏歌声。", "from": "刘禹锡《竹枝词二首·其一》", "poem_id": 99999}, {"id": 900, "content": "遥望洞庭山水色，白银盘里一青螺。", "from": "刘禹锡《望洞庭》", "poem_id": 99999}, {"id": 902, "content": "只在此山中，云深不知处。", "from": "贾岛《寻隐者不遇 / 孙革访羊尊师诗》", "poem_id": 99999}, {"id": 903, "content": "亭亭山上松，瑟瑟谷中风。", "from": "刘桢《赠从弟》", "poem_id": 99999}, {"id": 905, "content": "小轩独坐相思处，情绪好无聊。", "from": "石孝友《眼儿媚·愁云淡淡雨潇潇》", "poem_id": 99999}, {"id": 906, "content": "一寸丹心图报国，两行清泪为思亲。", "from": "于谦《立春日感怀》", "poem_id": 99999}, {"id": 907, "content": "阳关万里道，不见一人归。", "from": "庾信《重别周尚书》", "poem_id": 99999}, {"id": 908, "content": "自是浮生无可说。人间第一耽离别。", "from": "王国维《蝶恋花·满地霜华浓似雪》", "poem_id": 99999}, {"id": 910, "content": "秋风吹到江村，正黄昏，寂寞梧桐夜雨不开门。", "from": "顾彩《相见欢·秋风吹到江村》", "poem_id": 99999}, {"id": 911, "content": "独出前门望野田，月明荞麦花如雪。", "from": "白居易《村夜》", "poem_id": 99999}, {"id": 912, "content": "操吴戈兮被犀甲，车错毂兮短兵接。", "from": "屈原《国殇》", "poem_id": 99999}, {"id": 913, "content": "狂风落尽深红色，绿叶成阴子满枝。", "from": "杜牧《怅诗》", "poem_id": 99999}, {"id": 914, "content": "菡萏香销翠叶残，西风愁起绿波间。", "from": "李璟《摊破浣溪沙·菡萏香销翠叶残》", "poem_id": 99999}, {"id": 916, "content": "知我者，谓我心忧；不知我者，谓我何求。", "from": "佚名《黍离》", "poem_id": 99999}, {"id": 917, "content": "梨花院落溶溶月，柳絮池塘淡淡风。", "from": "晏殊《无题·油壁香车不再逢》", "poem_id": 99999}, {"id": 918, "content": "粉堕百花洲，香残燕子楼。", "from": "曹雪芹《唐多令·柳絮》", "poem_id": 99999}, {"id": 919, "content": "书当快意读易尽，客有可人期不来。", "from": "陈师道《绝句·书当快意读易尽》", "poem_id": 99999}, {"id": 920, "content": "叹十年心事，休休莫莫。", "from": "吴潜《满江红·豫章滕王阁》", "poem_id": 99999}, {"id": 921, "content": "鱼书经岁绝，烛泪流残月。", "from": "徐灿《菩萨蛮·秋闺》", "poem_id": 99999}, {"id": 922, "content": "人间有味是清欢。", "from": "苏轼《浣溪沙·细雨斜风作晓寒》", "poem_id": 99999}, {"id": 923, "content": "老去悲秋强自宽，兴来今日尽君欢。", "from": "杜甫《九日蓝田崔氏庄》", "poem_id": 99999}, {"id": 924, "content": "柔情似水，佳期如梦，忍顾鹊桥归路。", "from": "秦观《鹊桥仙·纤云弄巧》", "poem_id": 99999}, {"id": 925, "content": "王孙莫把比蓬蒿，九日枝枝近鬓毛。", "from": "郑谷《菊》", "poem_id": 99999}, {"id": 927, "content": "今日斗酒会，明旦沟水头。", "from": "卓文君《白头吟》", "poem_id": 99999}, {"id": 928, "content": "只恐双溪舴艋舟，载不动许多愁。", "from": "李清照《武陵春·春晚》", "poem_id": 99999}, {"id": 929, "content": "不信比来长下泪，开箱验取石榴裙。", "from": "武则天《如意娘》", "poem_id": 99999}, {"id": 930, "content": "无处不伤心，轻尘在玉琴。", "from": "纳兰性德《菩萨蛮·萧萧几叶风兼雨》", "poem_id": 99999}, {"id": 931, "content": "风急桃花也似愁，点点飞红雨。", "from": "如晦《楚天遥过清江引·有意送春归》", "poem_id": 99999}, {"id": 932, "content": "细雨梦回鸡塞远，小楼吹彻玉笙寒。", "from": "李璟《摊破浣溪沙·菡萏香销翠叶残》", "poem_id": 99999}, {"id": 934, "content": "胡未灭，鬓先秋。泪空流。", "from": "陆游《诉衷情·当年万里觅封侯》", "poem_id": 99999}, {"id": 935, "content": "蜡烛有心还惜别，替人垂泪到天明。", "from": "杜牧《赠别》", "poem_id": 99999}, {"id": 936, "content": "不似秋光，只与离人照断肠。", "from": "苏轼《减字木兰花·春月》", "poem_id": 99999}, {"id": 938, "content": "春思乱，芳心碎。", "from": "惠洪《千秋岁·半身屏外》", "poem_id": 99999}, {"id": 939, "content": "君不见管鲍贫时交，此道今人弃如土。", "from": "杜甫《贫交行》", "poem_id": 99999}, {"id": 940, "content": "百啭千声随意移，山花红紫树高低。", "from": "欧阳修《画眉鸟》", "poem_id": 99999}, {"id": 941, "content": "山际见来烟，竹中窥落日。", "from": "吴均《山中杂诗》", "poem_id": 99999}, {"id": 943, "content": "穿花蛱蝶深深见，点水蜻蜓款款飞。", "from": "杜甫《曲江二首》", "poem_id": 99999}, {"id": 944, "content": "一水护田将绿绕，两山排闼送青来。", "from": "王安石《书湖阴先生壁》", "poem_id": 99999}, {"id": 946, "content": "飞流直下三千尺，疑是银河落九天。", "from": "李白《望庐山瀑布》", "poem_id": 99999}, {"id": 948, "content": "种豆南山下，草盛豆苗稀。", "from": "陶渊明《归园田居·其三》", "poem_id": 99999}, {"id": 949, "content": "泉眼无声惜细流，树阴照水爱晴柔。", "from": "杨万里《小池》", "poem_id": 99999}, {"id": 950, "content": "烟霏霏。雪霏霏。雪向梅花枝上堆。", "from": "吴淑姬《长相思令·烟霏霏》", "poem_id": 99999}, {"id": 951, "content": "玉碗冰寒滴露华，粉融香雪透轻纱。", "from": "晏殊《浣溪沙·玉碗冰寒滴露华》", "poem_id": 99999}, {"id": 953, "content": "飞花两岸照船红，百里榆堤半日风。", "from": "陈与义《襄邑道中》", "poem_id": 99999}, {"id": 954, "content": "西风吹老洞庭波，一夜湘君白发多。", "from": "唐温如《题龙阳县青草湖》", "poem_id": 99999}, {"id": 955, "content": "风絮飘残已化萍，泥莲刚倩藕丝萦。", "from": "纳兰性德《山花子·风絮飘残已化萍》", "poem_id": 99999}, {"id": 958, "content": "远书归梦两悠悠，只有空床敌素秋。", "from": "李商隐《端居》", "poem_id": 99999}, {"id": 959, "content": "深秋帘幕千家雨，落日楼台一笛风。", "from": "杜牧《题宣州开元寺水阁阁下宛溪夹溪居人》", "poem_id": 99999}, {"id": 960, "content": "人烟寒橘柚，秋色老梧桐。", "from": "李白《秋登宣城谢脁北楼》", "poem_id": 99999}, {"id": 961, "content": "一霎荷塘过雨，明朝便是秋声。", "from": "项鸿祚《清平乐·池上纳凉》", "poem_id": 99999}, {"id": 963, "content": "漠漠秋云起，稍稍夜寒生。", "from": "白居易《微雨夜行》", "poem_id": 99999}, {"id": 964, "content": "水流花谢两无情，送尽东风过楚城。", "from": "崔涂《春夕》", "poem_id": 99999}, {"id": 965, "content": "莫嫌举世无知己，未有庸人不忌才。", "from": "查慎行《三闾祠》", "poem_id": 99999}, {"id": 966, "content": "童子解吟长恨曲，胡儿能唱琵琶篇。", "from": "李忱《吊白居易》", "poem_id": 99999}, {"id": 967, "content": "何夜无月？何处无竹柏？但少闲人如吾两人者耳。", "from": "苏轼《记承天寺夜游 / 记承天夜游》", "poem_id": 99999}, {"id": 968, "content": "依旧桃花面，频低柳叶眉。", "from": "韦庄《女冠子·昨夜夜半》", "poem_id": 99999}, {"id": 969, "content": "戚姬髡发入舂市，万古共悲辛。", "from": "李白《中山孺子妾歌》", "poem_id": 99999}, {"id": 970, "content": "山城过雨百花尽，榕叶满庭莺乱啼。", "from": "柳宗元《柳州二月榕叶落尽偶题》", "poem_id": 99999}, {"id": 972, "content": "小舟从此逝，江海寄余生。", "from": "苏轼《临江仙·夜饮东坡醒复醉》", "poem_id": 99999}, {"id": 974, "content": "北方有佳人，绝世而独立。", "from": "李延年《李延年歌》", "poem_id": 99999}, {"id": 975, "content": "姑苏城外一茅屋，万树梅花月满天。", "from": "唐寅《把酒对月歌》", "poem_id": 99999}, {"id": 976, "content": "山远翠眉长。高处凄凉。菊花清瘦杜秋娘。", "from": "吴文英《浪淘沙·九日从吴见山觅酒》", "poem_id": 99999}, {"id": 979, "content": "松下问童子，言师采药去。", "from": "贾岛《寻隐者不遇 / 孙革访羊尊师诗》", "poem_id": 99999}, {"id": 980, "content": "壮志饥餐胡虏肉，笑谈渴饮匈奴血。", "from": "岳飞《满江红·写怀》", "poem_id": 99999}, {"id": 981, "content": "别有幽愁暗恨生，此时无声胜有声。", "from": "白居易《琵琶行 / 琵琶引》", "poem_id": 99999}, {"id": 982, "content": "行人莫问当年事，故国东来渭水流。", "from": "许浑《咸阳城东楼 / 咸阳城西楼晚眺 / 西门》", "poem_id": 99999}, {"id": 983, "content": "枕上十年事，江南二老忧，都到心头。", "from": "徐再思《水仙子·夜雨》", "poem_id": 99999}, {"id": 986, "content": "春风尔来为阿谁，蝴蝶忽然满芳草。", "from": "李白《山人劝酒》", "poem_id": 99999}, {"id": 987, "content": "树阴满地日当午，梦觉流莺时一声。", "from": "苏舜钦《夏意》", "poem_id": 99999}, {"id": 988, "content": "晴日暖风生麦气，绿阴幽草胜花时。", "from": "王安石《初夏即事》", "poem_id": 99999}, {"id": 989, "content": "江上春山远，山下暮云长。", "from": "葛长庚《水调歌头·江上春山远》", "poem_id": 99999}, {"id": 990, "content": "常恐秋风早，飘零君不知。", "from": "卢照邻《曲池荷》", "poem_id": 99999}, {"id": 991, "content": "饮马渡秋水，水寒风似刀。", "from": "王昌龄《塞下曲四首》", "poem_id": 99999}, {"id": 995, "content": "微微风簇浪，散作满河星。", "from": "查慎行《舟夜书所见》", "poem_id": 99999}, {"id": 997, "content": "遥知独听灯前雨，转忆同看雪后山。", "from": "纳兰性德《于中好·送梁汾南还为题小影》", "poem_id": 99999}, {"id": 999, "content": "燕子飞时，绿水人家绕。", "from": "苏轼《蝶恋花·春景》", "poem_id": 99999}, {"id": 1001, "content": "小山重叠金明灭，鬓云欲度香腮雪。", "from": "温庭筠《菩萨蛮·小山重叠金明灭》", "poem_id": 99999}, {"id": 1003, "content": "妇人依倚子与夫，同居贫贱心亦舒。", "from": "张籍《征妇怨》", "poem_id": 99999}, {"id": 1004, "content": "君安游兮西入秦，愿为影兮随君身。", "from": "傅玄《车遥遥篇》", "poem_id": 99999}, {"id": 1005, "content": "燕山雪花大如席，片片吹落轩辕台。", "from": "李白《北风行》", "poem_id": 99999}, {"id": 1006, "content": "不用思量今古，俯仰昔人非。", "from": "苏轼《八声甘州·寄参寥子》", "poem_id": 0}, {"id": 1007, "content": "不管烟波与风雨，载将离恨过江南。", "from": "郑文宝《柳枝词》", "poem_id": 0}, {"id": 1009, "content": "国亡身殒今何有，只留离骚在世间。", "from": "张耒《和端午》", "poem_id": 0}, {"id": 1010, "content": "我歌月徘徊，我舞影零乱。", "from": "李白《月下独酌四首·其一》", "poem_id": 0}, {"id": 1011, "content": "谁知万里客，怀古正踌蹰。", "from": "陈子昂《岘山怀古》", "poem_id": 0}, {"id": 1012, "content": "草树知春不久归，百般红紫斗芳菲。", "from": "韩愈《晚春》", "poem_id": 0}, {"id": 1013, "content": "饮酒莫辞醉，醉多适不愁。", "from": "高适《淇上送韦司仓往滑台》", "poem_id": 0}, {"id": 1014, "content": "不知何日始工愁。记取那回花下一低头。", "from": "王国维《虞美人·弄梅骑竹嬉游日》", "poem_id": 0}, {"id": 1015, "content": "形影忽不见，翩翩伤我心。", "from": "曹植《杂诗六首·其一》", "poem_id": 0}, {"id": 1016, "content": "忍泪佯低面，含羞半敛眉。", "from": "韦庄《女冠子·四月十七》", "poem_id": 0}, {"id": 1019, "content": "不惜千金买宝刀，貂裘换酒也堪豪。", "from": "秋瑾《对酒·不惜千金买宝刀》", "poem_id": 0}, {"id": 1020, "content": "半天凉月色，一笛酒人心。", "from": "袁枚《夜过借园见主人坐月下吹笛》", "poem_id": 0}, {"id": 1021, "content": "风雨梨花寒食过，几家坟上子孙来？", "from": "高启《送陈秀才还沙上省墓》", "poem_id": 0}, {"id": 1022, "content": "昼出耘田夜绩麻，村庄儿女各当家。", "from": "范成大《夏日田园杂兴·其七》", "poem_id": 0}, {"id": 1023, "content": "人间梦隔西风，算天上、年华一瞬。", "from": "吴文英《惜秋华·七夕》", "poem_id": 0}, {"id": 1024, "content": "人学始知道，不学非自然。", "from": "孟郊《劝学》", "poem_id": 0}, {"id": 1027, "content": "醉里挑灯看剑，梦回吹角连营。", "from": "辛弃疾《破阵子·为陈同甫赋壮词以寄之》", "poem_id": 0}, {"id": 1028, "content": "人似秋鸿来有信，事如春梦了无痕。", "from": "苏轼《正月二十日与潘郭二生出郊寻春忽记去年是日同至女王城作诗乃和前韵》", "poem_id": 0}, {"id": 1029, "content": "坑灰未冷山东乱，刘项原来不读书。", "from": "章碣《焚书坑》", "poem_id": 0}, {"id": 1030, "content": "登鸾车，侍轩辕，遨游青天中，其乐不可言。", "from": "李白《飞龙引二首·其一》", "poem_id": 0}, {"id": 1031, "content": "孰知不向边庭苦，纵死犹闻侠骨香。", "from": "王维《少年行四首》", "poem_id": 0}, {"id": 1032, "content": "伏波惟愿裹尸还，定远何须生入关。", "from": "李益《塞下曲》", "poem_id": 0}, {"id": 1033, "content": "南北山头多墓田，清明祭扫各纷然。", "from": "高翥《清明日对酒》", "poem_id": 0}, {"id": 1034, "content": "鸟飞反故乡兮，狐死必首丘。", "from": "屈原《九章》", "poem_id": 0}, {"id": 1035, "content": "人生有酒须当醉，一滴何曾到九泉。", "from": "高翥《清明日对酒》", "poem_id": 0}, {"id": 1036, "content": "无由持一碗，寄与爱茶人。", "from": "白居易《山泉煎茶有怀》", "poem_id": 0}, {"id": 1037, "content": "琴里知闻唯渌水，茶中故旧是蒙山。", "from": "白居易《琴茶》", "poem_id": 0}, {"id": 1040, "content": "芭蕉不展丁香结，同向春风各自愁。", "from": "李商隐《代赠二首·其一》", "poem_id": 0}, {"id": 1043, "content": "遗民泪尽胡尘里，南望王师又一年。", "from": "陆游《秋夜将晓出篱门迎凉有感》", "poem_id": 0}, {"id": 1046, "content": "一枝红杏出墙头，墙外行人正独愁。", "from": "吴融《途中见杏花》", "poem_id": 0}, {"id": 1048, "content": "把酒送春春不语。黄昏却下潇潇雨。", "from": "朱淑真《蝶恋花·送春》", "poem_id": 0}, {"id": 1049, "content": "低花树映小妆楼，春入眉心两点愁。", "from": "白居易《春词》", "poem_id": 0}, {"id": 1050, "content": "我当二十不得意，一心愁谢如枯兰。", "from": "李贺《开愁歌》", "poem_id": 0}, {"id": 1051, "content": "浊酒不销忧国泪，救时应仗出群才。", "from": "秋瑾《黄海舟中日人索句并见日俄战争地图》", "poem_id": 0}, {"id": 1052, "content": "雨暗残灯棋散后，酒醒孤枕雁来初。", "from": "杜牧《齐安郡晚秋》", "poem_id": 0}, {"id": 1053, "content": "古路无行客，寒山独见君。", "from": "刘长卿《碧涧别墅喜皇甫侍御相访》", "poem_id": 0}, {"id": 1054, "content": "故人相望若为情。别愁深夜雨，孤影小窗灯。", "from": "陈克《临江仙·四海十年兵不解》", "poem_id": 0}, {"id": 1056, "content": "当路谁相假，知音世所稀。", "from": "孟浩然《留别王侍御维 / 留别王维》", "poem_id": 0}, {"id": 1058, "content": "可怜今夕月，向何处、去悠悠。", "from": "辛弃疾《木兰花慢·中秋饮酒将旦客谓前人诗词有赋待月无送月者因用天问体赋》", "poem_id": 0}, {"id": 1059, "content": "寂寂竟何待，朝朝空自归。", "from": "孟浩然《留别王侍御维 / 留别王维》", "poem_id": 0}, {"id": 1060, "content": "离别一何久，七度过中秋。", "from": "苏辙《水调歌头·徐州中秋》", "poem_id": 0}, {"id": 1063, "content": "同穴窅冥何所望，他生缘会更难期。", "from": "元稹《遣悲怀三首·其三》", "poem_id": 0}, {"id": 1064, "content": "残月出门时，美人和泪辞。", "from": "韦庄《菩萨蛮·红楼别夜堪惆怅》", "poem_id": 0}, {"id": 1065, "content": "妾身悔作商人妇，妾命当逢薄幸夫。", "from": "徐再思《阳春曲·闺怨》", "poem_id": 0}, {"id": 1066, "content": "一语不入意，从君万曲梁尘飞。", "from": "李白《夜坐吟》", "poem_id": 0}, {"id": 1067, "content": "若得山花插满头，莫问奴归处。", "from": "严蕊《卜算子·不是爱风尘》", "poem_id": 0}, {"id": 1068, "content": "白日登山望烽火，黄昏饮马傍交河。", "from": "李颀《古从军行》", "poem_id": 0}, {"id": 1070, "content": "峰峦如聚，波涛如怒，山河表里潼关路。", "from": "张养浩《山坡羊·潼关怀古》", "poem_id": 0}, {"id": 1073, "content": "若非群玉山头见，会向瑶台月下逢。", "from": "李白《清平调·其一》", "poem_id": 0}, {"id": 1074, "content": "料峭春风吹酒醒，微冷，山头斜照却相迎。", "from": "苏轼《定风波·三月七日》", "poem_id": 0}, {"id": 1075, "content": "山光悦鸟性，潭影空人心。", "from": "常建《题破山寺后禅院》", "poem_id": 0}, {"id": 1077, "content": "巴山楚水凄凉地，二十三年弃置身。", "from": "刘禹锡《酬乐天扬州初逢席上见赠》", "poem_id": 0}, {"id": 1078, "content": "高楼送客不能醉，寂寂寒江明月心。", "from": "王昌龄《芙蓉楼送辛渐二首》", "poem_id": 0}, {"id": 1079, "content": "水晶帘外娟娟月，梨花枝上层层雪。", "from": "杨基《菩萨蛮·水晶帘外娟娟月》", "poem_id": 0}, {"id": 1080, "content": "风住尘香花已尽，日晚倦梳头。", "from": "李清照《武陵春·春晚》", "poem_id": 0}, {"id": 1081, "content": "春悄悄，夜迢迢。碧云天共楚宫遥。", "from": "晏几道《鹧鸪天·小令尊前见玉箫》", "poem_id": 0}, {"id": 1082, "content": "暖雨晴风初破冻，柳眼梅腮，已觉春心动。", "from": "李清照《蝶恋花·暖雨晴风初破冻》", "poem_id": 0}, {"id": 1083, "content": "怀君属秋夜，散步咏凉天。", "from": "韦应物《秋夜寄邱员外 / 秋夜寄丘二十二员外》", "poem_id": 0}, {"id": 1084, "content": "络纬秋啼金井阑，微霜凄凄簟色寒。", "from": "李白《长相思·其一》", "poem_id": 0}, {"id": 1085, "content": "丁丁漏水夜何长，漫漫轻云露月光。", "from": "张仲素《秋夜曲》", "poem_id": 0}, {"id": 1086, "content": "金井梧桐秋叶黄，珠帘不卷夜来霜。", "from": "王昌龄《长信怨》", "poem_id": 0}, {"id": 1087, "content": "红叶晚萧萧，长亭酒一瓢。", "from": "许浑《秋日赴阙题潼关驿楼 / 行次潼关逢魏扶东归》", "poem_id": 0}, {"id": 1088, "content": "午梦扁舟花底。香满两湖烟水。", "from": "杨万里《昭君怨·咏荷上雨》", "poem_id": 0}, {"id": 1089, "content": "未信此情难系绊，杨花犹有东风管。", "from": "苏轼《蝶恋花·蝶懒莺慵春过半》", "poem_id": 0}, {"id": 1090, "content": "律回岁晚冰霜少，春到人间草木知。", "from": "张栻《立春偶成》", "poem_id": 0}, {"id": 1091, "content": "深居俯夹城，春去夏犹清。", "from": "李商隐《晚晴》", "poem_id": 0}, {"id": 1092, "content": "彼此当年少，莫负好时光。", "from": "李隆基《好时光·宝髻偏宜宫样》", "poem_id": 0}, {"id": 1093, "content": "人恒过然后能改，困于心衡于虑而后作，征于色发于声而后喻。", "from": "孟子及其弟子《生于忧患，死于安乐》", "poem_id": 0}, {"id": 1094, "content": "季子正年少，匹马黑貂裘。", "from": "辛弃疾《水调歌头·舟次扬州和人韵》", "poem_id": 0}, {"id": 1095, "content": "借问酒家何处有？牧童遥指杏花村。", "from": "杜牧《清明》", "poem_id": 0}, {"id": 1096, "content": "啼时惊妾梦，不得到辽西。", "from": "金昌绪《春怨 / 伊州歌》", "poem_id": 0}, {"id": 1097, "content": "巧笑东邻女伴，采桑径里逢迎。", "from": "晏殊《破阵子·春景》", "poem_id": 0}, {"id": 1098, "content": "团扇，团扇，美人病来遮面。", "from": "王建《宫中调笑·团扇》", "poem_id": 0}, {"id": 1100, "content": "丛菊两开他日泪，孤舟一系故园心。", "from": "杜甫《秋兴八首·其一》", "poem_id": 0}, {"id": 1101, "content": "桃未芳菲杏未红，冲寒先喜笑东风。", "from": "曹雪芹《咏红梅花得“红”字》", "poem_id": 0}, {"id": 1102, "content": "雪虐风饕愈凛然，花中气节最高坚。", "from": "陆游《落梅》", "poem_id": 0}, {"id": 1103, "content": "江天一色无纤尘，皎皎空中孤月轮。", "from": "张若虚《春江花月夜》", "poem_id": 0}, {"id": 1104, "content": "水国蒹葭夜有霜，月寒山色共苍苍。", "from": "薛涛《送友人》", "poem_id": 0}, {"id": 1105, "content": "忆对中秋丹桂丛。花在杯中。月在杯中。", "from": "辛弃疾《一剪梅·中秋元月》", "poem_id": 0}, {"id": 1106, "content": "明月如霜，好风如水，清景无限。", "from": "苏轼《永遇乐·彭城夜宿燕子楼》", "poem_id": 0}, {"id": 1107, "content": "酒困路长惟欲睡，日高人渴漫思茶。", "from": "苏轼《浣溪沙·簌簌衣巾落枣花》", "poem_id": 0}, {"id": 1108, "content": "人有悲欢离合，月有阴晴圆缺，此事古难全。", "from": "苏轼《水调歌头·丙辰中秋》", "poem_id": 0}, {"id": 1109, "content": "小时不识月，呼作白玉盘。", "from": "李白《古朗月行》", "poem_id": 0}, {"id": 1110, "content": "静夜沉沉，浮光霭霭，冷浸溶溶月。", "from": "丘处机《无俗念·灵虚宫梨花词》", "poem_id": 0}, {"id": 1111, "content": "白云千里万里，明月前溪后溪。", "from": "刘长卿《谪仙怨·晴川落日初低》", "poem_id": 0}, {"id": 1112, "content": "桃花一簇开无主，可爱深红爱浅红。", "from": "杜甫《江畔独步寻花·其五》", "poem_id": 0}, {"id": 1113, "content": "河畔青芜堤上柳，为问新愁，何事年年有？", "from": "冯延巳《鹊踏枝·谁道闲情抛弃久》", "poem_id": 0}, {"id": 1114, "content": "遍身罗绮者，不是养蚕人。", "from": "张俞《蚕妇》", "poem_id": 0}, {"id": 1115, "content": "素娥惟与月，青女不饶霜。", "from": "李商隐《十一月中旬至扶风界见梅花》", "poem_id": 0}, {"id": 1116, "content": "月明星稀，乌鹊南飞。绕树三匝，何枝可依？", "from": "曹操《短歌行》", "poem_id": 0}, {"id": 1117, "content": "大儿锄豆溪东，中儿正织鸡笼。", "from": "辛弃疾《清平乐·村居》", "poem_id": 0}, {"id": 1118, "content": "哀哀父母，生我劳瘁。", "from": "佚名《蓼莪》", "poem_id": 0}, {"id": 1119, "content": "人生百年有几，念良辰美景，休放虚过。", "from": "元好问《骤雨打新荷》", "poem_id": 0}, {"id": 1120, "content": "庭轩寂寞近清明，残花中酒，又是去年病。", "from": "张先《青门引·春思》", "poem_id": 0}, {"id": 1123, "content": "最爱湖东行不足，绿杨阴里白沙堤。", "from": "白居易《钱塘湖春行》", "poem_id": 0}, {"id": 1124, "content": "长安白日照春空，绿杨结烟垂袅风。", "from": "李白《阳春歌》", "poem_id": 0}, {"id": 1125, "content": "风蒲猎猎小池塘。过雨荷花满院香。", "from": "李重元《忆王孙·夏词》", "poem_id": 0}, {"id": 1126, "content": "别院深深夏席清，石榴开遍透帘明。", "from": "苏舜钦《夏意》", "poem_id": 0}, {"id": 1127, "content": "湖光秋月两相和，潭面无风镜未磨。", "from": "刘禹锡《望洞庭》", "poem_id": 0}, {"id": 1128, "content": "长风万里送秋雁，对此可以酣高楼。", "from": "李白《宣州谢脁楼饯别校书叔云 / 陪侍御叔华登楼歌》", "poem_id": 0}, {"id": 1130, "content": "满园花菊郁金黄，中有孤丛色似霜。", "from": "白居易《重阳席上赋白菊》", "poem_id": 0}, {"id": 1131, "content": "云无心以出岫，鸟倦飞而知还。", "from": "陶渊明《归去来兮辞·并序》", "poem_id": 0}, {"id": 1132, "content": "浮云蔽白日，游子不顾返。", "from": "佚名《行行重行行》", "poem_id": 0}, {"id": 1133, "content": "泠泠七弦上，静听松风寒。", "from": "刘长卿《听弹琴》", "poem_id": 0}, {"id": 1136, "content": "梅雪争春未肯降，骚人搁笔费评章。", "from": "卢梅坡《雪梅·其一》", "poem_id": 0}, {"id": 1137, "content": "天将暮，雪乱舞，半梅花半飘柳絮。", "from": "马致远《寿阳曲·江天暮雪》", "poem_id": 0}, {"id": 1138, "content": "草枯鹰眼疾，雪尽马蹄轻。", "from": "王维《观猎》", "poem_id": 0}, {"id": 1139, "content": "中岁颇好道，晚家南山陲。", "from": "王维《终南别业 / 初至山中 / 入山寄城中故人》", "poem_id": 0}, {"id": 1142, "content": "淮水东边旧时月，夜深还过女墙来。", "from": "刘禹锡《金陵五题·石头城》", "poem_id": 0}, {"id": 1143, "content": "最是繁丝摇落后，转教人忆春山。", "from": "纳兰性德《临江仙·寒柳》", "poem_id": 0}, {"id": 1144, "content": "浮天水送无穷树，带雨云埋一半山。", "from": "辛弃疾《鹧鸪天·送人》", "poem_id": 0}, {"id": 1145, "content": "山寺月中寻桂子，郡亭枕上看潮头。", "from": "白居易《忆江南·江南忆》", "poem_id": 0}, {"id": 1146, "content": "重见金英人未见。相思一夜天涯远。", "from": "晏几道《蝶恋花·黄菊开时伤聚散》", "poem_id": 0}, {"id": 1147, "content": "闲坐悲君亦自悲，百年多是几多时。", "from": "元稹《遣悲怀三首·其三》", "poem_id": 0}, {"id": 1148, "content": "雁字无多，写得相思几许。", "from": "周密《扫花游·九日怀归》", "poem_id": 0}, {"id": 1149, "content": "明岁秋风知再会，暂时分手莫相思。", "from": "曹雪芹《残菊》", "poem_id": 0}, {"id": 1150, "content": "故乡今夜思千里，霜鬓明朝又一年。", "from": "高适《除夜作》", "poem_id": 0}, {"id": 1151, "content": "搴帷拜母河梁去，白发愁看泪眼枯。", "from": "黄景仁《别老母》", "poem_id": 0}, {"id": 1152, "content": "谁知江上酒，还与故人倾。", "from": "周紫芝《临江仙·送光州曾使君》", "poem_id": 0}, {"id": 1153, "content": "丈夫贫贱应未足，今日相逢无酒钱。", "from": "高适《别董大二首》", "poem_id": 0}, {"id": 1155, "content": "杀人亦有限，列国自有疆。", "from": "杜甫《前出塞九首·其六》", "poem_id": 0}, {"id": 1157, "content": "赏心乐事共谁论？花下销魂，月下销魂。", "from": "唐寅《一剪梅·雨打梨花深闭门》", "poem_id": 0}, {"id": 1158, "content": "含情欲说宫中事，鹦鹉前头不敢言。", "from": "朱庆馀《宫词 / 宫中词》", "poem_id": 0}, {"id": 1159, "content": "自春来、惨绿愁红，芳心是事可可。", "from": "柳永《定风波·自春来》", "poem_id": 0}, {"id": 1160, "content": "一上高城万里愁，蒹葭杨柳似汀洲。", "from": "许浑《咸阳城东楼 / 咸阳城西楼晚眺 / 西门》", "poem_id": 0}, {"id": 1163, "content": "千淘万漉虽辛苦，吹尽狂沙始到金。", "from": "刘禹锡《浪淘沙九首》", "poem_id": 0}, {"id": 1164, "content": "金樽清酒斗十千，玉盘珍羞直万钱。", "from": "李白《行路难·其一》", "poem_id": 0}, {"id": 1166, "content": "一杯酒，问何似，身后名？", "from": "辛弃疾《水调歌头·壬子三山被召陈端仁给事饮饯席上作》", "poem_id": 0}, {"id": 1167, "content": "万里中原烽火北，一尊浊酒戍楼东。", "from": "张孝祥《浣溪沙·霜日明霄水蘸空》", "poem_id": 0}, {"id": 1170, "content": "烟柳画桥，风帘翠幕，参差十万人家。", "from": "柳永《望海潮·东南形胜》", "poem_id": 0}, {"id": 1171, "content": "汉兵已略地，四方楚歌声。", "from": "虞姬《和项王歌》", "poem_id": 0}, {"id": 1172, "content": "陌上深深，依旧年时辙。", "from": "王国维《蝶恋花·满地霜华浓似雪》", "poem_id": 0}, {"id": 1173, "content": "有约不来过夜半，闲敲棋子落灯花。", "from": "南宋·赵师秀《约客》", "poem_id": 0}, {"id": 1174, "content": "流光容易把人抛，红了樱桃，绿了芭蕉。", "from": "蒋捷《一剪梅·舟过吴江》", "poem_id": 0}, {"id": 1175, "content": "天涯何处无芳草！墙里秋千墙外道。", "from": "苏轼《蝶恋花·春景》", "poem_id": 0}, {"id": 1176, "content": "粗缯大布裹生涯，腹有诗书气自华。", "from": "苏轼《和董传留别》", "poem_id": 0}, {"id": 1177, "content": "来岁花前。又是今年忆去年。", "from": "吕本中《减字木兰花·去年今夜》", "poem_id": 0}, {"id": 1178, "content": "流年莫虚掷，华发不相容。", "from": "方干《送从兄郜 / 韦郜 / 途中别孙璐》", "poem_id": 0}, {"id": 1179, "content": "当年得意如芳草。日日春风好。", "from": "辛弃疾《虞美人·赋虞美人草》", "poem_id": 0}, {"id": 1180, "content": "弱冠弄柔翰，卓荦观群书。", "from": "左思《咏史八首·其一》", "poem_id": 0}, {"id": 1182, "content": "马作的卢飞快，弓如霹雳弦惊。", "from": "辛弃疾《破阵子·为陈同甫赋壮词以寄之》", "poem_id": 0}, {"id": 1184, "content": "高情已逐晓云空。不与梨花同梦。", "from": "苏轼《西江月·梅花》", "poem_id": 0}, {"id": 1186, "content": "门外无人问落花，绿阴冉冉遍天涯。", "from": "曹豳《春暮·门外无人问落花》", "poem_id": 0}, {"id": 1187, "content": "而今识尽愁滋味，欲说还休。", "from": "辛弃疾《丑奴儿·书博山道中壁》", "poem_id": 0}, {"id": 1188, "content": "一声何满子，双泪落君前。", "from": "张祜《宫词·故国三千里》", "poem_id": 0}, {"id": 1189, "content": "日长篱落无人过，惟有蜻蜓蛱蝶飞。", "from": "范成大《四时田园杂兴·其二》", "poem_id": 0}, {"id": 1191, "content": "胡雁哀鸣夜夜飞，胡儿眼泪双双落。", "from": "李颀《古从军行》", "poem_id": 0}, {"id": 1192, "content": "昨风一吹无人会，今夜清光似往年。", "from": "白居易《八月十五日夜湓亭望月》", "poem_id": 0}, {"id": 1193, "content": "人老去西风白发，蝶愁来明日黄花。", "from": "张可久《折桂令·九日》", "poem_id": 0}, {"id": 1194, "content": "翠蛾轻敛意沉吟，沾襟，无人知此心。", "from": "孙光宪《河传·花落》", "poem_id": 0}, {"id": 1195, "content": "影孤怜夜永。永夜怜孤影。", "from": "苏轼《菩萨蛮·回文秋闺怨》", "poem_id": 0}, {"id": 1196, "content": "人去空流水，花飞半掩门。", "from": "秦观《南歌子·香墨弯弯画》", "poem_id": 0}, {"id": 1198, "content": "恰似春风相欺得，夜来吹折数枝花。", "from": "杜甫《绝句漫兴九首·其二》", "poem_id": 0}, {"id": 1199, "content": "春色恼人眠不得，月移花影上栏杆。", "from": "王安石《春夜》", "poem_id": 0}, {"id": 1200, "content": "春路雨添花，花动一山春色。", "from": "秦观《好事近·梦中作》", "poem_id": 0}, {"id": 1201, "content": "寄语洛城风日道，明年春色倍还人。", "from": "杜审言《春日京中有怀》", "poem_id": 0}, {"id": 1202, "content": "花开不并百花丛，独立疏篱趣未穷。", "from": "郑思肖《画菊》", "poem_id": 0}, {"id": 1203, "content": "不知来岁牡丹时，再相逢何处。", "from": "叶清臣《贺圣朝·留别》", "poem_id": 0}, {"id": 1204, "content": "君到姑苏见，人家尽枕河。", "from": "杜荀鹤《送人游吴》", "poem_id": 0}, {"id": 1206, "content": "明日相思莫上楼，楼上多风雨。", "from": "游次公《卜算子·风雨送人来》", "poem_id": 0}, {"id": 1207, "content": "望阙云遮眼，思乡雨滴心。", "from": "白居易《阴雨》", "poem_id": 0}, {"id": 1208, "content": "城上高楼接大荒，海天愁思正茫茫。", "from": "柳宗元《登柳州城楼寄漳汀封连四州》", "poem_id": 0}, {"id": 1209, "content": "四面边声连角起，千嶂里，长烟落日孤城闭。", "from": "范仲淹《渔家傲·秋思》", "poem_id": 0}, {"id": 1210, "content": "后夜相思，尘随马去，月逐舟行。", "from": "刘过《柳梢青·送卢梅坡》", "poem_id": 0}, {"id": 1211, "content": "晨起动征铎，客行悲故乡。", "from": "温庭筠《商山早行》", "poem_id": 0}, {"id": 1212, "content": "寄相思，寒雨灯窗，芙蓉旧院。", "from": "吴文英《宴清都·秋感》", "poem_id": 0}, {"id": 1213, "content": "天长路远魂飞苦，梦魂不到关山难。", "from": "李白《长相思·其一》", "poem_id": 0}, {"id": 1214, "content": "旋开旋落旋成空，白发多情人更惜。", "from": "司空图《酒泉子·买得杏花》", "poem_id": 0}, {"id": 1215, "content": "夜长争得薄情知，春初早被相思染。", "from": "姜夔《踏莎行·自沔东来》", "poem_id": 0}, {"id": 1216, "content": "三春白雪归青冢，万里黄河绕黑山。", "from": "柳中庸《征人怨 / 征怨》", "poem_id": 0}, {"id": 1217, "content": "莫遣只轮归海窟，仍留一箭射天山。", "from": "李益《塞下曲》", "poem_id": 0}, {"id": 1218, "content": "云收雨过波添，楼高水冷瓜甜，绿树阴垂画檐。", "from": "白朴《天净沙·夏》", "poem_id": 0}, {"id": 1219, "content": "京口瓜洲一水间，钟山只隔数重山。", "from": "王安石《泊船瓜洲》", "poem_id": 0}, {"id": 1220, "content": "万里赴戎机，关山度若飞。", "from": "佚名《木兰诗 / 木兰辞》", "poem_id": 0}, {"id": 1221, "content": "溪深难受雪，山冻不流云。", "from": "洪升《雪望》", "poem_id": 0}, {"id": 1222, "content": "长江悲已滞，万里念将归。", "from": "王勃《山中》", "poem_id": 0}, {"id": 1223, "content": "杨柳东风树，青青夹御河。", "from": "王之涣《送别》", "poem_id": 0}, {"id": 1224, "content": "溪深古雪在，石断寒泉流。", "from": "李白《寻高凤石门山中元丹丘》", "poem_id": 0}, {"id": 1226, "content": "大风起兮云飞扬。威加海内兮归故乡。安得猛士兮守四方！", "from": "刘邦《大风歌》", "poem_id": 0}, {"id": 1229, "content": "山黛远，月波长，暮云秋影蘸潇湘。", "from": "蔡松年《鹧鸪天·赏荷》", "poem_id": 0}, {"id": 1230, "content": "梅定妒，菊应羞。画阑开处冠中秋。", "from": "李清照《鹧鸪天·桂花》", "poem_id": 0}, {"id": 1231, "content": "黄菊枝头生晓寒。人生莫放酒杯干。", "from": "黄庭坚《鹧鸪天·坐中有眉山隐客史应之和前韵》", "poem_id": 0}, {"id": 1232, "content": "楼倚霜树外，镜天无一毫。", "from": "杜牧《长安秋望》", "poem_id": 0}, {"id": 1233, "content": "西风乱叶溪桥树。秋在黄花羞涩处。", "from": "张榘《青玉案·被檄出郊题陈氏山居》", "poem_id": 0}, {"id": 1235, "content": "荷花开后西湖好，载酒来时。", "from": "欧阳修《采桑子·荷花开后西湖好》", "poem_id": 0}, {"id": 1236, "content": "夜合花开香满庭，夜深微雨醉初醒。", "from": "窦叔向《夏夜宿表兄话旧》", "poem_id": 0}, {"id": 1237, "content": "报道先生归也，杏花春雨江南。", "from": "虞集《风入松·寄柯敬仲》", "poem_id": 0}, {"id": 1239, "content": "夜雨连明春水生，娇云浓暖弄阴晴。", "from": "苏舜钦《初晴游沧浪亭》", "poem_id": 0}, {"id": 1240, "content": "夜来南风起，小麦覆陇黄。", "from": "白居易《观刈麦》", "poem_id": 0}, {"id": 1241, "content": "亦知合被才名折，二十三年折太多。", "from": "白居易《醉赠刘二十八使君》", "poem_id": 0}, {"id": 1242, "content": "镜中已觉星星误。人不负春春自负。", "from": "辛弃疾《玉楼春·风前欲劝春光住》", "poem_id": 0}, {"id": 1243, "content": "爱子心无尽，归家喜及辰。", "from": "蒋士铨《岁暮到家》", "poem_id": 0}, {"id": 1244, "content": "读书不作儒生酸，跃马西入金城关。", "from": "谢逸《送董元达》", "poem_id": 0}, {"id": 1245, "content": "昨日邻家乞新火，晓窗分与读书灯。", "from": "王禹偁《清明》", "poem_id": 0}, {"id": 1246, "content": "休言女子非英物，夜夜龙泉壁上鸣。", "from": "秋瑾《鹧鸪天·祖国沉沦感不禁》", "poem_id": 0}, {"id": 1247, "content": "妾家高楼连苑起，良人执戟明光里。", "from": "张籍《节妇吟·寄东平李司空师道》", "poem_id": 0}, {"id": 1248, "content": "孤灯不明思欲绝，卷帷望月空长叹。美人如花隔云端！", "from": "李白《长相思·其一》", "poem_id": 0}, {"id": 1249, "content": "卢家少妇郁金堂，海燕双栖玳瑁梁。", "from": "沈佺期《古意呈补阙乔知之 / 古意 / 独不见》", "poem_id": 0}, {"id": 1250, "content": "劳歌一曲解行舟，红叶青山水急流。", "from": "许浑《谢亭送别》", "poem_id": 0}, {"id": 1251, "content": "千里稻花应秀色，五更桐叶最佳音。", "from": "曾几《苏秀道中》", "poem_id": 0}], "next_page": null}
