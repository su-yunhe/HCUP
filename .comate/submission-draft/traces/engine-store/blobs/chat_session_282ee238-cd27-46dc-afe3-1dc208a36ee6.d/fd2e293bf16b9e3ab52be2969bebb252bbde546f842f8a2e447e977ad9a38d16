     8	export async function httpRequestGet(url: string): Promise<ResponseResult> {
     9	  let httpRequest = http.createHttp();
    10	
    11	  //配置参考：https://developer.huawei.com/consumer/cn/doc/harmonyos-references/js-apis-http#httprequestoptions
    12	  const requestConfig: http.HttpRequestOptions = {
    13	    method: http.RequestMethod.GET,
    14	    readTimeout: NetworkConst.HTTP_READ_TIMEOUT,
    15	    connectTimeout: NetworkConst.HTTP_READ_TIMEOUT,
    16	    maxLimit: 100 * 1024 * 1024,
    17	    header: {
    18	      'Content-Type': 'application/json'
    19	    },
    20	    extraData: {}
    21	  }
    22	
    23	  let result = new ResponseResult()
    24	
    25	  return httpRequest.request(url, requestConfig).then((response: http.HttpResponse) => {
    26	    if (response.responseCode === NetworkConst.HTTP_CODE_200) {
    27	      result.data = `${response.result}`
    28	    } else {
    29	      result.msg = `${$r('app.string.http_error_message')}&${response.responseCode}`;
    30	      logger.info(result.msg)
    31	    }
    32	    httpRequest.destroy();
    33	    return result;
    34	  }).catch((error: BusinessError) => {
    35	    result.msg = `${$r('app.string.http_error_message')}} => ${error.message}`;
    36	    logger.info(result.msg)
    37	    httpRequest.destroy();
    38	    return result;
    39	  })
    40	}
