    def back(self) -> None:
        """标题栏返回按钮（与系统返回键一致）。"""
        self.driver.press_back()
        self.driver.wait(1)

    def title_back(self) -> None:
        self.driver.click(self.require_component(BY.key("__NavdestinationField__BackButton__Back__"),
                                                 "缺少标题栏返回按钮"))
        self.driver.wait(1)