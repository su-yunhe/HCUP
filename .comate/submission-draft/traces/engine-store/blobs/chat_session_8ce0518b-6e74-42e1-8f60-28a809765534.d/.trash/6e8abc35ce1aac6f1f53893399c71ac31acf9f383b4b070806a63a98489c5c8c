def load_fixture() -> dict[tuple[str, str], int]:
    """(content, from) -> poem_id；不在 fixture 中的名句 poem_id 为 null。"""
    data = json.loads(FIXTURE.read_text(encoding="utf-8"))["data"]
    return {(d["content"], d["from"]): d["poem_id"] for d in data}


def is_linked(poem_id: int | None) -> bool:
    return poem_id not in (None, 0, MISSING_POEM_ID)


class SentenceTestCase(HarnessTestCase):

    @classmethod
    def setUpClass(cls) -> None:
        super().setUpClass()
        # 判断"不存在"时不需要隐式等待，轮询由 find_or_none 负责
        cls.driver.set_implicit_wait_time(0)

    # ---------- 查找 ----------

    def by_key(self, key: str):
        return BY.key(key)

    def find_key(self, key: str, timeout: float = 10):
        return self.find_or_none(BY.key(key), timeout=timeout)

    def require_key(self, key: str, message: str, timeout: float = 10):
        return self.require_component(BY.key(key), message, timeout=timeout)

    def absent(self, by, settle: float = 1.0) -> bool:
        """等待页面稳定后确认组件不存在。"""
        self.driver.wait(settle)
        return self.driver.find_component(by) is None

    def text_of(self, key: str, timeout: float = 10) -> str:
        return self.require_key(key, f"未找到 {key}", timeout=timeout).getText()

    def label_of(self, key: str) -> str:
        """自建工具栏项内 Text 的文字。"""
        item = self.require_key(key, f"未找到工具栏项 {key}")
        text = self.driver.find_component(BY.type("Text").within(BY.key(key)))
        if text is not None:
            return text.getText()
        b = item.getBounds()
        for t in self.driver.find_all_components(BY.type("Text")) or []:
            tb = t.getBounds()
            if b.left <= tb.left and tb.right <= b.right and b.top <= tb.top and tb.bottom <= b.bottom:
                return t.getText()
        self.fail(f"工具栏项 {key} 内没有文字")

    def wait_label(self, key: str, expected: str, timeout: float = 5) -> str:
        deadline = time.monotonic() + timeout
        label = self.label_of(key)
        while label != expected and time.monotonic() < deadline:
            self.driver.wait(0.3)
            label = self.label_of(key)
        return label

    def title(self) -> str | None:
        """当前栈顶 NavDestination 标题。"""
        for key in ("__NavdestinationField__Text__MainTitle__",):
            c = self.driver.find_component(BY.key(key, MatchPattern.CONTAINS))
            if c is not None:
                return c.getText()
        return None

    def bookmark_item_keys(self) -> list[str]:
        items = self.driver.find_all_components(BY.key(K_BOOKMARKS_ITEM, MatchPattern.STARTS_WITH)) or []
        items.sort(key=lambda c: c.getBounds().top)
        return [self.driver.get_component_property(c, "key") if hasattr(self.driver, "get_component_property")
                else "" for c in items]

    def bookmark_items(self) -> list:
        items = self.driver.find_all_components(BY.key(K_BOOKMARKS_ITEM, MatchPattern.STARTS_WITH)) or []
        items.sort(key=lambda c: c.getBounds().top)
        return items

    def bookmark_item_texts(self) -> list[str]:
        """收藏列表各项的名句内容（每项第一行），按从上到下顺序。"""
        result = []
        for item in self.bookmark_items():
            b = item.getBounds()
            texts = [t for t in (self.driver.find_all_components(BY.type("Text")) or [])
                     if b.top <= t.getBounds().top and t.getBounds().bottom <= b.bottom]
            texts.sort(key=lambda t: t.getBounds().top)
            result.append(texts[0].getText() if texts else "")
        return result

