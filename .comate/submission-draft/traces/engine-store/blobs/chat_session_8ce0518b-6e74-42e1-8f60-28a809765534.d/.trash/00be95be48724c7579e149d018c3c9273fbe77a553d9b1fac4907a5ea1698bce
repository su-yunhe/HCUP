class TestScenario1Index(SentenceTestCase):

    def test_01_enter_from_home(self):
        """A1/A2：主页点击"诗文名句"进入首页，展示名句内容与出处。"""
        self.enter_index()
        self.assertEqual(self.wait_title("诗文名句"), "诗文名句", "首页标题不是“诗文名句”")
        self.assertIsNone(self.driver.find_component(BY.key(K_HOME_MENU)), "进入后主页格子仍可见")
        content, source = self.current()
        self.assertTrue(content.strip(), "名句内容为空")
        self.assertTrue(source.strip(), "出处为空")
        self.assertRegex(source, r"^.+《.+》$", "出处应原样显示 from 字段（作者《标题》）")
