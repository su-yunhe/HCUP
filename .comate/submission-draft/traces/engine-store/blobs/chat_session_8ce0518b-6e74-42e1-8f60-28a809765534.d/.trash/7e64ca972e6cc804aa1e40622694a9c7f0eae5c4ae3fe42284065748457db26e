/**
 * 名句关联的诗词：poem_id 非空非 0，且诗词表中存在该 id 时返回 poem_id，否则返回 null
 */
export async function readSentencePoemId(obj: Sentence): Promise<number | null> {
  if (obj.poem_id === null || obj.poem_id === 0) {
    return null;
  }
  let exists = false
  await DbUtil.objectiveRDB?.querySql(DbCRUDConst.READ_CLASSICALLITERATURE_CLASSICPOEM, [obj.poem_id])
    .then((resultSet: relationalStore.ResultSet) => {
      exists = resultSet.rowCount > 0
      resultSet.close()
    }).catch((err: BusinessError) => {
      logger.error(`Query is failed, code is ${err.code},message is ${err.message}`)
    });
  return exists ? obj.poem_id : null;
}

export async function isSentenceBookmarked(id: number): Promise<boolean> {
  let bookmarked = false
  await DbUtil.objectiveRDB?.querySql(DbCRUDConst.READ_BOOKMARK, [BOOKMARKABLE_MODEL, id])
    .then((resultSet: relationalStore.ResultSet) => {
      bookmarked = resultSet.rowCount > 0
      resultSet.close()
    }).catch((err: BusinessError) => {
      logger.error(`Query is failed, code is ${err.code},message is ${err.message}`)
    });
  return bookmarked;
}

/**
 * 收藏名句，已收藏时不重复写入
 * @returns 操作完成后是否为已收藏状态
 */
export async function bookmarkSentence(id: number): Promise<boolean> {
  if (await isSentenceBookmarked(id)) {
    return true;
  }
  const valuesBucket: relationalStore.ValuesBucket = {
    'bookmarkable_id': id,
    'bookmarkable_model': BOOKMARKABLE_MODEL,
  }
  await DbUtil.objectiveRDB?.insert(DbTableConst.BOOKMARKS_TABLE, valuesBucket)
    .then((rowId: number) => {
      logger.info(`Insert bookmark is successful, rowId = ${rowId}`)
    }).catch((err: BusinessError) => {
      logger.error(`Insert bookmark is failed, code is ${err.code},message is ${err.message}`)
    });
  return isSentenceBookmarked(id);
}

/**
 * 取消收藏名句
 * @returns 操作完成后是否为已收藏状态
 */
export async function unbookmarkSentence(id: number): Promise<boolean> {
  const predicates = new relationalStore.RdbPredicates(DbTableConst.BOOKMARKS_TABLE);
  predicates.equalTo('bookmarkable_model', BOOKMARKABLE_MODEL).and().equalTo('bookmarkable_id', id);
  await DbUtil.objectiveRDB?.delete(predicates)
    .then((rows: number) => {
      logger.info(`Delete bookmark is successful, rows = ${rows}`)
    }).catch((err: BusinessError) => {
      logger.error(`Delete bookmark is failed, code is ${err.code},message is ${err.message}`)
    });
  return isSentenceBookmarked(id);
}

