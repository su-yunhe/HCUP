def load_fixture() -> dict[tuple[str, str], int]:
    """(content, from) -> poem_id；不在 fixture 中的名句 poem_id 为 null。"""
    data = json.loads(FIXTURE.read_text(encoding="utf-8"))["data"]
    return {(d["content"], d["from"]): d["poem_id"] for d in data}


def is_linked(poem_id: int | None) -> bool:
    return poem_id not in (None, 0, MISSING_POEM_ID)


class SentenceTestCase(HarnessTestCase):

    @classmethod
    def setUpClass(cls) -> None:
        super().setUpClass()
        # 判断"不存在"时不需要隐式等待，轮询由 find_or_none 负责
        cls.driver.set_implicit_wait_time(0)

    # ---------- 查找 ----------

    def by_key(self, key: str):
        return BY.key(key)

    def find_key(self, key: str, timeout: float = 10):
        return self.find_or_none(BY.key(key), timeout=timeout)

    def require_key(self, key: str, message: str, timeout: float = 10):
        return self.require_component(BY.key(key), message, timeout=timeout)

    def absent(self, by, settle: float = 1.0) -> bool:
        """等待页面稳定后确认组件不存在。"""
        self.driver.wait(settle)
        return self.driver.find_component(by) is None

    def text_of(self, key: str, timeout: float = 10) -> str:
        return self.require_key(key, f"未找到 {key}", timeout=timeout).getText()

