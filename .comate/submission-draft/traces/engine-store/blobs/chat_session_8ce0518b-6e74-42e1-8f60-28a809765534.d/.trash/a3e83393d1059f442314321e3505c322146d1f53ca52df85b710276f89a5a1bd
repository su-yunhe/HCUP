  return obj;
}

/**
 * 随机读取一条 id 不等于 exceptId 的名句；表中只有 exceptId 一条时返回 null
 */
export async function readRandomSentenceExcept(exceptId: number): Promise<Sentence | null> {
  return querySentence(DbCRUDConst.READ_RANDOM_CLASSICALLITERATURE_SENTENCE_EXCEPT, [exceptId]);
}

export async function readSentence(id: number): Promise<Sentence | null> {
  return querySentence(DbCRUDConst.READ_CLASSICALLITERATURE_SENTENCE, [id]);
}

/**
 * 名句关联的诗词：poem_id 非空非 0，且诗词表中存在该 id 时返回 poem_id，否则返回 null
 */
export async function readSentencePoemId(obj: Sentence): Promise<number | null> {
  if (obj.poem_id === null || obj.poem_id === 0) {
    return null;
  }
  let exists = false
  await DbUtil.objectiveRDB?.querySql(DbCRUDConst.READ_CLASSICALLITERATURE_CLASSICPOEM, [obj.poem_id])
    .then((resultSet: relationalStore.ResultSet) => {
      exists = resultSet.rowCount > 0
      resultSet.close()
    }).catch((err: BusinessError) => {
      logger.error(`Query is failed, code is ${err.code},message is ${err.message}`)
    });
  return exists ? obj.poem_id : null;
}

